@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:QuantityDimensionless a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityLength a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:QuantityAngle a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:FailureClassFactorLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:node gs:QuantityDimensionless ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each failure-class lookup case must provide one flexural failure class factor with a dimensionless unit."
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gs:QuantityDimensionless ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each failure-class lookup case must provide one crushing failure class factor with a dimensionless unit."
    ] .

gs:BowSubregionCalculationCaseShape a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow subregion case must identify applicability to bow forms defined in I2.3.1(v)."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gs:QuantityLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable bow subregion case must provide the mid-length position."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:node gs:QuantityAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable bow subregion case must provide the waterline angle."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:node gs:FailureClassFactorLookupCaseShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable bow subregion case must link to its failure-class factor lookup case."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gs:QuantityDimensionless ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable bow subregion case must provide the externally computed bow shape coefficient."
    ] .

gs:I2_015_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gs:BowSubregionCalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide an applicable bow subregion calculation case for this requirement."
    ] ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:node gs:QuantityDimensionless ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide beta i prime with a dimensionless unit."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:node gs:QuantityLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the upper ice waterline length."
    ] .
