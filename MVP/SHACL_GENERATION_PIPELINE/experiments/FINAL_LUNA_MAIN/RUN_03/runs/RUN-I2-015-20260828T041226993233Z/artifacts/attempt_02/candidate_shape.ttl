@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:QuantityValueDimensionlessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:QuantityValueLengthShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:QuantityValueAngleShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:bowFormApplicabilityClassification ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:minCount 1 ;
        sh:message "An applicable bow-subregion case must be classified as the I2.3.1(v) bow form."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasBowSubregionCalculationCase
        ] ;
        sh:class nltl:ship ;
        sh:minCount 1 ;
        sh:message "An applicable bow-subregion case must be linked from a ship."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gen:QuantityValueLengthShape ;
        sh:minCount 1 ;
        sh:message "The applicable bow-subregion case must provide its mid-length position."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:node gen:QuantityValueAngleShape ;
        sh:minCount 1 ;
        sh:message "The applicable bow-subregion case must provide its waterline angle."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:flexuralFailureClassFactor ;
                sh:node gen:QuantityValueDimensionlessShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:crushingFailureClassFactor ;
                sh:node gen:QuantityValueDimensionlessShape ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The applicable bow-subregion case must provide its flexural and crushing failure class factors."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gen:QuantityValueDimensionlessShape ;
        sh:minCount 1 ;
        sh:message "The applicable bow-subregion case must provide the externally computed bow shape coefficient."
    ] ;
    sh:property [
        sh:path (
            [
                sh:inversePath nltl:hasBowSubregionCalculationCase
            ]
            nltl:upperIceWaterlineLengthLUI
        ) ;
        sh:node gen:QuantityValueLengthShape ;
        sh:minCount 1 ;
        sh:message "The linked ship must provide the upper ice waterline length."
    ] ;
    sh:property [
        sh:path (
            [
                sh:inversePath nltl:hasBowSubregionCalculationCase
            ]
            nltl:betaIPrime
        ) ;
        sh:node gen:QuantityValueDimensionlessShape ;
        sh:minCount 1 ;
        sh:message "The linked ship must provide beta i prime."
    ] .
