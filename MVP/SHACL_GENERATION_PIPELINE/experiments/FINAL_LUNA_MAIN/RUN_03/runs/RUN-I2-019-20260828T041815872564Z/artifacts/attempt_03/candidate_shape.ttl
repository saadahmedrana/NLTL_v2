@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:HullAreaFactorQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SpannedHullAreaShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:HullAreaFactorQuantityShape
    ] .

gen:ApplicableStructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:minCount 1 ;
        sh:node gen:SpannedHullAreaShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:HullAreaFactorQuantityShape
    ] ;
    sh:sparql [
        sh:message "selectedHullAreaFactor must equal the largest spanned hull area factor within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero, and no spanned factor may exceed it." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?area ;
                      nltl:selectedHullAreaFactor ?selectedQuantity .

                ?area nltl:hullAreaFactor ?factorQuantity .
                ?factorQuantity qudt:numericValue ?expected .
                ?selectedQuantity qudt:numericValue ?reported .

                FILTER NOT EXISTS {
                    $this nltl:hasSpannedHullArea ?otherArea .
                    ?otherArea nltl:hullAreaFactor ?otherFactorQuantity .
                    ?otherFactorQuantity qudt:numericValue ?other .
                    FILTER (?other > ?expected)
                }

                FILTER (
                    ?expected > ?reported ||
                    ?reported < (
                        ?expected -
                        IF(?expected > 0,
                           ?expected * 0.000001,
                           0.000001)
                    ) ||
                    ?reported > (
                        ?expected +
                        IF(?expected < 0,
                           (-?expected) * 0.000001,
                           IF(?expected > 0,
                              ?expected * 0.000001,
                              0.000001))
                    )
                )
            }
        """
    ] .

gen:NonApplicableStructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:maxCount 0
    ] .

gen:StructuralMemberShape
    a sh:NodeShape ;
    sh:or (
        gen:ApplicableStructuralMemberShape
        gen:NonApplicableStructuralMemberShape
    ) .

gen:HullAreaMaximumShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:StructuralMemberShape
    ] .
