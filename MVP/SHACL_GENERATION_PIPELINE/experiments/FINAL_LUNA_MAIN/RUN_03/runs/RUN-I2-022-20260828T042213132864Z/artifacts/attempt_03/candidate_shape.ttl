@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_022_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node gen:I2_022_PlatingReadinessShape
    ] .

gen:I2_022_PlatingReadinessShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicable transversely-framed bottom plating must provide the declared operands, required relationships, and externally computed net thickness result with the specified datatypes and units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:framingAngleOmega ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angleValue .
                FILTER (xsd:decimal(?angleValue) >= 70)

                $this nltl:platingHullAreaClassification ?area .
                FILTER (
                    ?area IN (
                        nltl:bowIntermediateBottomHullArea,
                        nltl:midbodyBottomHullArea,
                        nltl:sternBottomHullArea
                    )
                )

                ?ship nltl:hasPlating $this .

                FILTER NOT EXISTS {
                    $this nltl:framingAngleOmega ?requiredAngle .
                    ?requiredAngle qudt:numericValue ?requiredAngleValue ;
                                   qudt:unit qudt:DEG .
                    FILTER (datatype(?requiredAngleValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:platingHullAreaClassification ?requiredArea .
                    ?requiredArea rdf:type nltl:hullAreaValue .
                    FILTER (
                        ?requiredArea IN (
                            nltl:bowIntermediateBottomHullArea,
                            nltl:midbodyBottomHullArea,
                            nltl:sternBottomHullArea
                        )
                    )
                }

                FILTER NOT EXISTS {
                    ?ship nltl:loadPatchHeight ?loadPatchHeight .
                    ?loadPatchHeight qudt:numericValue ?loadPatchHeightValue ;
                                    qudt:unit qudt:M .
                    FILTER (datatype(?loadPatchHeightValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?ship nltl:peakPressureFactor ?peakPressureFactor .
                    ?peakPressureFactor qudt:numericValue ?peakPressureFactorValue ;
                                        qudt:unit qudt:UNITLESS .
                    FILTER (datatype(?peakPressureFactorValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?ship nltl:averageIcePressure ?averageIcePressure .
                    ?averageIcePressure qudt:numericValue ?averageIcePressureValue ;
                                        qudt:unit qudt:MegaPA .
                    FILTER (datatype(?averageIcePressureValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?ship nltl:yieldStrength ?yieldStrength .
                    ?yieldStrength qudt:numericValue ?yieldStrengthValue ;
                                   qudt:unit qudt:MegaPA .
                    FILTER (datatype(?yieldStrengthValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:iceLoadRequiredNetPlateThickness ?result .
                    ?result qudt:numericValue ?resultValue ;
                           qudt:unit qudt:MilliM .
                    FILTER (datatype(?resultValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:platingSupportedByStructuralMember ?member .
                    ?member rdf:type nltl:structuralMember .
                }

                FILTER NOT EXISTS {
                    $this nltl:platingSupportedByStructuralMember ?member .
                    FILTER NOT EXISTS {
                        ?member nltl:frameSpacing ?spacing .
                        ?spacing qudt:numericValue ?spacingValue ;
                                 qudt:unit qudt:M .
                        FILTER (datatype(?spacingValue) = xsd:decimal)
                    }
                }

                FILTER NOT EXISTS {
                    $this nltl:platingSupportedByStructuralMember ?member .
                    FILTER NOT EXISTS {
                        ?member nltl:selectedHullAreaFactor ?areaFactor .
                        ?areaFactor qudt:numericValue ?areaFactorValue ;
                                    qudt:unit qudt:UNITLESS .
                        FILTER (datatype(?areaFactorValue) = xsd:decimal)
                    }
                }
            }
        """
    ] .
