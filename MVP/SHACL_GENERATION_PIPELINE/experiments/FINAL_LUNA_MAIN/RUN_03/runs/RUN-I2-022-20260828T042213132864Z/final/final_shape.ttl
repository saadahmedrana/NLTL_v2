@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2_022_ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicable transversely framed plating must provide the declared ice-load calculation inputs, required net thickness result, and structural-member relationship with corresponding member inputs." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this ?plating
WHERE {
    $this a nltl:ship ;
          nltl:hasPlating ?plating .

    ?plating nltl:framingAngleOmega ?angleQuantity .
    ?angleQuantity qudt:numericValue ?angleValue ;
                    qudt:unit <http://qudt.org/vocab/unit/DEG> .
    FILTER (?angleValue >= 70)

    ?plating nltl:platingHullAreaClassification ?area .
    FILTER (
        ?area IN (
            nltl:bowIntermediateBottomHullArea,
            nltl:midbodyBottomHullArea,
            nltl:sternBottomHullArea
        )
    )

    FILTER (
        NOT EXISTS {
            $this nltl:loadPatchHeight ?loadPatchHeightQuantity .
            ?loadPatchHeightQuantity qudt:numericValue ?loadPatchHeightValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/M> .
        }
        ||
        NOT EXISTS {
            $this nltl:peakPressureFactor ?peakPressureFactorQuantity .
            ?peakPressureFactorQuantity qudt:numericValue ?peakPressureFactorValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        }
        ||
        NOT EXISTS {
            $this nltl:averageIcePressure ?averageIcePressureQuantity .
            ?averageIcePressureQuantity qudt:numericValue ?averageIcePressureValue ;
                                        qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
        }
        ||
        NOT EXISTS {
            $this nltl:yieldStrength ?yieldStrengthQuantity .
            ?yieldStrengthQuantity qudt:numericValue ?yieldStrengthValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
        }
        ||
        NOT EXISTS {
            ?plating nltl:iceLoadRequiredNetPlateThickness ?resultQuantity .
            ?resultQuantity qudt:numericValue ?resultValue ;
                            qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        }
        ||
        NOT EXISTS {
            ?plating nltl:platingSupportedByStructuralMember ?member .
        }
        ||
        NOT EXISTS {
            ?plating nltl:platingSupportedByStructuralMember ?memberWithoutInputs .
            FILTER (
                NOT EXISTS {
                    ?memberWithoutInputs nltl:frameSpacing ?frameSpacingQuantity .
                    ?frameSpacingQuantity qudt:numericValue ?frameSpacingValue ;
                                           qudt:unit <http://qudt.org/vocab/unit/M> .
                }
                ||
                NOT EXISTS {
                    ?memberWithoutInputs nltl:selectedHullAreaFactor ?selectedHullAreaFactorQuantity .
                    ?selectedHullAreaFactorQuantity qudt:numericValue ?selectedHullAreaFactorValue ;
                                                   qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                }
            )
        }
    )
}
""" ;
    ] .
