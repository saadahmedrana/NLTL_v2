@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-024-oblique-case-angle-shape>
    a sh:NodeShape ;
    sh:targetClass nltl:obliquePlatingInterpolationCase ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "An existing oblique-plating interpolation case must have exactly one framing angle in degrees."
    ] .

<urn:nltl:generated-shape:I2-024-applicable-case-readiness-shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable oblique-plating case with 20 degrees < framing angle < 70 degrees, exactly one lower and upper interpolation endpoint, exactly one coordinate and result per endpoint, and exactly one interpolated net plate thickness are required with the declared quantity structures." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?case
            WHERE {
                $this nltl:hasObliquePlatingInterpolationCase ?case .
                ?case nltl:framingAngle ?angle .
                ?angle qudt:numericValue ?angleValue .
                ?angle qudt:unit <http://qudt.org/vocab/unit/DEG> .
                FILTER(datatype(?angleValue) = xsd:decimal)
                FILTER(?angleValue > 20 && ?angleValue < 70)

                FILTER(
                    NOT EXISTS {
                        ?case nltl:interpolationLowerEndpoint ?lower .
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolationLowerEndpoint ?lower1 .
                        ?case nltl:interpolationLowerEndpoint ?lower2 .
                        FILTER(?lower1 != ?lower2)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:interpolationUpperEndpoint ?upper .
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolationUpperEndpoint ?upper1 .
                        ?case nltl:interpolationUpperEndpoint ?upper2 .
                        FILTER(?upper1 != ?upper2)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:interpolationLowerEndpoint ?lower .
                        ?lower nltl:interpolationPointCoordinate ?lowerCoordinate .
                        ?lowerCoordinate qudt:numericValue ?lowerCoordinateValue .
                        ?lowerCoordinate qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER(datatype(?lowerCoordinateValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolationLowerEndpoint ?lower .
                        ?lower nltl:interpolationPointCoordinate ?lowerCoordinate1 .
                        ?lower nltl:interpolationPointCoordinate ?lowerCoordinate2 .
                        FILTER(?lowerCoordinate1 != ?lowerCoordinate2)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:interpolationLowerEndpoint ?lower .
                        ?lower nltl:interpolationPointResult ?lowerResult .
                        ?lowerResult qudt:numericValue ?lowerResultValue .
                        FILTER(datatype(?lowerResultValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolationLowerEndpoint ?lower .
                        ?lower nltl:interpolationPointResult ?lowerResult1 .
                        ?lower nltl:interpolationPointResult ?lowerResult2 .
                        FILTER(?lowerResult1 != ?lowerResult2)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:interpolationUpperEndpoint ?upper .
                        ?upper nltl:interpolationPointCoordinate ?upperCoordinate .
                        ?upperCoordinate qudt:numericValue ?upperCoordinateValue .
                        ?upperCoordinate qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER(datatype(?upperCoordinateValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolationUpperEndpoint ?upper .
                        ?upper nltl:interpolationPointCoordinate ?upperCoordinate1 .
                        ?upper nltl:interpolationPointCoordinate ?upperCoordinate2 .
                        FILTER(?upperCoordinate1 != ?upperCoordinate2)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:interpolationUpperEndpoint ?upper .
                        ?upper nltl:interpolationPointResult ?upperResult .
                        ?upperResult qudt:numericValue ?upperResultValue .
                        FILTER(datatype(?upperResultValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolationUpperEndpoint ?upper .
                        ?upper nltl:interpolationPointResult ?upperResult1 .
                        ?upper nltl:interpolationPointResult ?upperResult2 .
                        FILTER(?upperResult1 != ?upperResult2)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:interpolatedNetPlateThickness ?thickness .
                        ?thickness qudt:numericValue ?thicknessValue .
                        ?thickness qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER(datatype(?thicknessValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?case nltl:interpolatedNetPlateThickness ?thickness1 .
                        ?case nltl:interpolatedNetPlateThickness ?thickness2 .
                        FILTER(?thickness1 != ?thickness2)
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-024-applicable-calculation-case-shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable oblique-plating case, the ship must provide at least one linked calculation case with exactly one longitudinal and one transverse framing net plate thickness, both in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasObliquePlatingInterpolationCase ?obliqueCase .
                ?obliqueCase nltl:framingAngle ?angle .
                ?angle qudt:numericValue ?angleValue .
                ?angle qudt:unit <http://qudt.org/vocab/unit/DEG> .
                FILTER(datatype(?angleValue) = xsd:decimal)
                FILTER(?angleValue > 20 && ?angleValue < 70)

                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?calculationCase .
                    ?calculationCase nltl:longitudinalFramingNetPlateThickness ?longitudinal .
                    ?longitudinal qudt:numericValue ?longitudinalValue .
                    ?longitudinal qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER(datatype(?longitudinalValue) = xsd:decimal)
                    ?calculationCase nltl:transverseFramingNetPlateThickness ?transverse .
                    ?transverse qudt:numericValue ?transverseValue .
                    ?transverse qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER(datatype(?transverseValue) = xsd:decimal)
                    FILTER NOT EXISTS {
                        ?calculationCase nltl:longitudinalFramingNetPlateThickness ?longitudinalOther .
                        FILTER(?longitudinalOther != ?longitudinal)
                    }
                    FILTER NOT EXISTS {
                        ?calculationCase nltl:transverseFramingNetPlateThickness ?transverseOther .
                        FILTER(?transverseOther != ?transverse)
                    }
                }
            }
        """
    ] .
