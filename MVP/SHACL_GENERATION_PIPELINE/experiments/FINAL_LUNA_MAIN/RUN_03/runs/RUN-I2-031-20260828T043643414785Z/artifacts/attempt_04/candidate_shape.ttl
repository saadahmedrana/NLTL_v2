@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:I2_031_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:message "The ship must provide a frame profile type." ;
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must identify the plastic collapse mechanism." ;
    ] ;
    sh:property [
        sh:path nltl:patchLoad ;
        sh:node nltlgen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide the patch load in kN." ;
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node nltlgen:I2_031_StructuralMemberShape ;
    ] .

nltlgen:I2_031_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:message "Each structural member must identify its structural location." ;
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:node nltlgen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each structural member must provide its midspan plastic collapse load." ;
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node nltlgen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each structural member must provide its plastic strength." ;
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:class nltl:loadCase ;
        sh:node nltlgen:I2_031_LoadCaseShape ;
        sh:minCount 1 ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:class nltl:structuralLocationValue ;
                sh:hasValue nltl:bottomStructureLocation ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:class nltl:loadCase ;
                sh:node nltlgen:I2_031_BottomLoadCaseShape ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:class nltl:structuralLocationValue ;
                sh:hasValue nltl:sideStructureLocation ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path nltl:transverseFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "The combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan collapse load within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMemberLoadCase ?loadCase .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                $this nltl:plasticStrength ?strength .
                ?strength qudt:numericValue ?strengthValue ;
                         qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                $this nltl:midspanPlasticCollapseLoad ?midspanLoad .
                ?midspanLoad qudt:numericValue ?midspanValue ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (
                    ?demandValue > ?strengthValue
                    ||
                    ABS(?strengthValue - ?midspanValue) >
                    (0.000001 * ABS(?midspanValue) + 0.000000001)
                )
            }
        """ ;
    ] .

nltlgen:I2_031_LoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node nltlgen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each load case must provide the combined shear and bending demand in kN." ;
    ] .

nltlgen:I2_031_BottomLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node nltlgen:I2_031_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchOrientation ;
        sh:class nltl:loadPatchOrientationValue ;
        sh:hasValue nltl:loadPatchHeightParallelToFrame ;
        sh:minCount 1 ;
        sh:message "For a bottom-structure member, the patch load dimension b must be parallel with the frame direction." ;
    ] .

nltlgen:I2_031_KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
