@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:I2_037_Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each web frame or load-carrying stringer must have a structural-member load case with the required combined-effect and application-location data, member capacity, ice-load patch, and confirmed capacity-minimization result." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this ?member
WHERE {
  $this nltl:hasStructuralMember ?member .
  ?member rdf:type ?memberType .
  FILTER (
    ?memberType IN (
      nltl:webFrame,
      nltl:loadCarryingStringer
    )
  )
  FILTER NOT EXISTS {
    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
    ?loadCase nltl:combinedShearBendingEffect ?combinedEffect ;
              nltl:loadPatchApplicationLocation ?location .
    FILTER (DATATYPE(?combinedEffect) = xsd:string)
    FILTER (DATATYPE(?location) = xsd:string)

    ?member nltl:memberCapacity ?capacity .
    ?capacity qudt:numericValue ?capacityValue ;
              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
    FILTER (DATATYPE(?capacityValue) = xsd:decimal)

    $this nltl:hasIceLoadPatch ?iceLoadPatch .
    ?iceLoadPatch rdf:type nltl:iceLoadPatch .

    $this nltl:hasIceLoadPatchDesignCase ?designCase .
    ?designCase rdf:type nltl:iceLoadPatchDesignCase ;
                nltl:memberCapacityMinimizationConfirmed ?confirmed .
    FILTER (
      DATATYPE(?confirmed) = xsd:boolean &&
      ?confirmed = true
    )
  }
}
""" ;
    ] .
