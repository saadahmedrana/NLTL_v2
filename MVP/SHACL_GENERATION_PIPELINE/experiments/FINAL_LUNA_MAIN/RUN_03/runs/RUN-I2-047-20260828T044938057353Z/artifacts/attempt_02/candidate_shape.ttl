@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_047_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasComponent nltl:iceStrengthenedStructureStatus ) ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "The linked hull structure must explicitly indicate that it is not ice strengthened when the renewal rule is non-applicable."
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:hasComponent nltl:iceStrengthenedStructureStatus ) ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "The linked hull structure must explicitly indicate that it is ice strengthened before applying the steel-renewal calculation."
            ] ;
            sh:property [
                sh:path nltl:gaugedThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:netThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:steelRenewalRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For an ice strengthened structure, steelRenewalRequired must be true exactly when gaugedThickness is less than netThickness plus 0.0005 m." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:hasComponent ?structure ;
                              nltl:gaugedThickness ?gaugedNode ;
                              nltl:netThickness ?netNode ;
                              nltl:steelRenewalRequired ?renewal .
                        ?structure nltl:iceStrengthenedStructureStatus true .
                        ?gaugedNode qudt:numericValue ?gauged .
                        ?netNode qudt:numericValue ?net .
                        FILTER (
                            ?renewal !=
                            (?gauged < (?net + "0.0005"^^xsd:decimal))
                        )
                    }
                """
            ]
        ]
    ) .
