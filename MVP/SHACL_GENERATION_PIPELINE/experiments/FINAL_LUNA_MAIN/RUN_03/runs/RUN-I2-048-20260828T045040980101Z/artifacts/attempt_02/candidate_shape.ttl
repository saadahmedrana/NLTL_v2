@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The selectors do not identify a supported Table 8 row, or the required grade result is missing, duplicated, or inconsistent with the selected row." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:asBuiltPlateThickness ?q ;
        nltl:steelMaterialClass ?mc ;
        nltl:steelStrengthCategory ?sc .
  ?q <http://qudt.org/schema/qudt/numericValue> ?t .
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  FILTER (
    (
      (
        ?t > 35 && ?t <= 40 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)
      )
      ||
      (
        ?t > 40 && ?t <= 45 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)
      )
      ||
      (
        ?t > 40 && ?t <= 45 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5)
      )
      ||
      (
        ?t > 45 && ?t <= 50 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (
          nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
          nltl:polarClassPc4, nltl:polarClassPc5
        )
      )
    )
    &&
    EXISTS { $this nltl:requiredHullStructuralSteelGrade ?badNa }
    ||
    (
      !(
        (
          ?t > 35 && ?t <= 40 &&
          ?mc = nltl:steelMaterialClassThree &&
          ?sc = nltl:normalStrengthSteelCategory &&
          ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)
        )
        ||
        (
          ?t > 40 && ?t <= 45 &&
          ?mc = nltl:steelMaterialClassThree &&
          ?sc = nltl:normalStrengthSteelCategory &&
          ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)
        )
        ||
        (
          ?t > 45 && ?t <= 50 &&
          ?mc = nltl:steelMaterialClassThree &&
          ?sc = nltl:normalStrengthSteelCategory &&
          ?pc IN (
            nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
            nltl:polarClassPc4, nltl:polarClassPc5
          )
        )
      )
      &&
      (
        !EXISTS { $this nltl:requiredHullStructuralSteelGrade ?r }
        ||
        EXISTS {
          $this nltl:requiredHullStructuralSteelGrade ?r1 ;
                nltl:requiredHullStructuralSteelGrade ?r2 .
          FILTER (?r1 != ?r2)
        }
        ||
        NOT EXISTS {
          $this nltl:requiredHullStructuralSteelGrade ?r .
          ?r a nltl:steelGradeValue ;
             nltl:steelGradeOrderRank ?rr .
          FILTER (
            (
              ?t <= 10 &&
              (
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeB)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeAh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeB)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeAh)
              )
            )
            ||
            (
              ?t > 10 && ?t <= 15 &&
              (
                (?mc = nltl:steelMaterialClassOne &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeB)
                ||
                (?mc = nltl:steelMaterialClassOne &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeAh)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeB)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeAh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
              )
            )
            ||
            (
              ?t > 15 && ?t <= 25 &&
              (
                (?mc = nltl:steelMaterialClassOne &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassOne &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeB)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeAh)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
              )
            )
            ||
            (
              ?t > 25 && ?t <= 35 &&
              (
                (?mc = nltl:steelMaterialClassOne &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassOne &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassOne &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeB)
                ||
                (?mc = nltl:steelMaterialClassOne &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeAh)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc = nltl:steelMaterialClassTwo &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
              )
            )
            ||
            (
              ?t > 35 && ?t <= 40 &&
              (
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeFh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6,
                         nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6,
                         nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
              )
            )
            ||
            (
              ?t > 40 && ?t <= 45 &&
              (
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeFh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeFh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
              )
            )
            ||
            (
              ?t > 45 && ?t <= 50 &&
              (
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeD)
                ||
                (?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeDh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
                         nltl:polarClassPc4, nltl:polarClassPc5) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeFh)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:normalStrengthSteelCategory &&
                 ?r = nltl:steelGradeE)
                ||
                (?mc = nltl:steelMaterialClassThree &&
                 ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                 ?sc = nltl:highTensileSteelCategory &&
                 ?r = nltl:steelGradeEh)
              )
            )
          )
        }
      )
    )
  )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual hull structural steel grade is not at least the selected required grade within the selected steel-strength family." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:asBuiltPlateThickness ?q ;
        nltl:steelMaterialClass ?mc ;
        nltl:steelStrengthCategory ?sc ;
        nltl:actualHullStructuralSteelGrade ?a ;
        nltl:requiredHullStructuralSteelGrade ?r .
  ?q <http://qudt.org/schema/qudt/numericValue> ?t .
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  ?a nltl:steelGradeOrderRank ?ar .
  ?r nltl:steelGradeOrderRank ?rr .
  FILTER (
    (
      ?sc = nltl:normalStrengthSteelCategory &&
      ?a NOT IN (
        nltl:steelGradeB,
        nltl:steelGradeD,
        nltl:steelGradeE
      )
    )
    ||
    (
      ?sc = nltl:highTensileSteelCategory &&
      ?a NOT IN (
        nltl:steelGradeAh,
        nltl:steelGradeDh,
        nltl:steelGradeEh,
        nltl:steelGradeFh
      )
    )
    ||
    ?ar < ?rr
  )
}
"""
    ] .
