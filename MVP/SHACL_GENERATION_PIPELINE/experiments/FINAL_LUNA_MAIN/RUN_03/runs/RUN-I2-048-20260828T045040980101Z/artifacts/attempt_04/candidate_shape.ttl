@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:node nltl:I2-048-CaseShape
    ] .

nltl:I2-048-CaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        )
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        )
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Unsupported Polar Class, thickness, material-class, or strength-category selector." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?m ;
                      nltl:steelStrengthCategory ?s .
                ?tv qudt:numericValue ?t ;
                    qudt:unit unit:MilliM .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                FILTER ( ! (
                    ?t > 0.0 &&
                    ?t <= 50.0 &&
                    ?m IN (
                        nltl:steelMaterialClassOne,
                        nltl:steelMaterialClassTwo,
                        nltl:steelMaterialClassThree
                    ) &&
                    ?s IN (
                        nltl:normalStrengthSteelCategory,
                        nltl:highTensileSteelCategory
                    ) &&
                    ?pc IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5,
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    )
                ) )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The required hull structural steel grade must exist exactly for applicable Table 8 rows and must be absent for NOT_APPLICABLE rows." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?m ;
                      nltl:steelStrengthCategory ?s .
                ?tv qudt:numericValue ?t ;
                    qudt:unit unit:MilliM .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                {
                    FILTER EXISTS {
                        $this nltl:requiredHullStructuralSteelGrade ?existingGrade
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:requiredHullStructuralSteelGrade ?missingGrade
                    }
                    FILTER ( ! (
                        (
                            ?t > 35.0 && ?t <= 40.0 &&
                            ?m = nltl:steelMaterialClassThree &&
                            ?s = nltl:normalStrengthSteelCategory &&
                            ?pc IN (
                                nltl:polarClassPc1,
                                nltl:polarClassPc2,
                                nltl:polarClassPc3
                            )
                        )
                        ||
                        (
                            ?t > 40.0 && ?t <= 50.0 &&
                            ?m = nltl:steelMaterialClassThree &&
                            ?s = nltl:normalStrengthSteelCategory &&
                            ?pc IN (
                                nltl:polarClassPc1,
                                nltl:polarClassPc2,
                                nltl:polarClassPc3,
                                nltl:polarClassPc4,
                                nltl:polarClassPc5
                            )
                        )
                    ) )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The required hull structural steel grade does not match the exact Table 8 selection." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?m ;
                      nltl:steelStrengthCategory ?s ;
                      nltl:requiredHullStructuralSteelGrade ?r .
                ?tv qudt:numericValue ?t ;
                    qudt:unit unit:MilliM .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                FILTER ( ! (
                    (
                        ?t > 0.0 && ?t <= 10.0 &&
                        (
                            (
                                ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeB) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeAh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeB) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeAh)
                                )
                            )
                        )
                    ) ||
                    (
                        ?t > 10.0 && ?t <= 15.0 &&
                        (
                            (
                                ?m = nltl:steelMaterialClassOne &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeB) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeAh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassTwo &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeB) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeAh)
                                )
                            )
                        )
                    ) ||
                    (
                        ?t > 15.0 && ?t <= 25.0 &&
                        (
                            (
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            ) ||
                            (
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeB) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeAh)
                                )
                            )
                        )
                    ) ||
                    (
                        ?t > 25.0 && ?t <= 35.0 &&
                        (
                            (
                                ?m = nltl:steelMaterialClassOne &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassTwo &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                (
                                    (
                                        ?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ) &&
                                        (
                                            (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                            (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                        )
                                    ) ||
                                    (
                                        ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                        (
                                            (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                            (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                        )
                                    )
                                )
                            ) ||
                            (
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            )
                        )
                    ) ||
                    (
                        ?t > 35.0 && ?t <= 40.0 &&
                        (
                            (
                                ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                ?pc IN (
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5,
                                    nltl:polarClassPc6,
                                    nltl:polarClassPc7
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3
                                ) &&
                                ?s = nltl:highTensileSteelCategory &&
                                ?r = nltl:steelGradeFh
                            )
                        )
                    ) ||
                    (
                        ?t > 40.0 && ?t <= 45.0 &&
                        (
                            (
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            )
                        )
                    ) ||
                    (
                        ?t > 45.0 && ?t <= 50.0 &&
                        (
                            (
                                ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            ) ||
                            (
                                ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeD) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeDh)
                                )
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                ?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ) &&
                                ?s = nltl:highTensileSteelCategory &&
                                ?r = nltl:steelGradeFh
                            ) ||
                            (
                                ?m = nltl:steelMaterialClassThree &&
                                ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
                                (
                                    (?s = nltl:normalStrengthSteelCategory && ?r = nltl:steelGradeE) ||
                                    (?s = nltl:highTensileSteelCategory && ?r = nltl:steelGradeEh)
                                )
                            )
                        )
                    )
                ) )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Actual and required steel grades must belong to the selected strength-category family and the actual rank must not be below the required rank." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:steelStrengthCategory ?s ;
                      nltl:actualHullStructuralSteelGrade ?a ;
                      nltl:requiredHullStructuralSteelGrade ?r .
                ?a nltl:steelGradeOrderRank ?ar .
                ?r nltl:steelGradeOrderRank ?rr .
                FILTER ( ! (
                    (
                        ?s = nltl:normalStrengthSteelCategory &&
                        ?a IN (
                            nltl:steelGradeB,
                            nltl:steelGradeD,
                            nltl:steelGradeE
                        ) &&
                        ?r IN (
                            nltl:steelGradeB,
                            nltl:steelGradeD,
                            nltl:steelGradeE
                        )
                    )
                    ||
                    (
                        ?s = nltl:highTensileSteelCategory &&
                        ?a IN (
                            nltl:steelGradeAh,
                            nltl:steelGradeDh,
                            nltl:steelGradeEh,
                            nltl:steelGradeFh
                        ) &&
                        ?r IN (
                            nltl:steelGradeAh,
                            nltl:steelGradeDh,
                            nltl:steelGradeEh,
                            nltl:steelGradeFh
                        )
                    )
                ) )
                FILTER (?ar < ?rr)
            }
        """
    ] .
