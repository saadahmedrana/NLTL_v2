@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_061_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:hasValue nltl:prescribedAnalyticalProcedure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The calculation case shall use the prescribed analytical procedure."
            ] ;
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:node [
                    sh:not [
                        sh:in ( nltl:directCalculationMethodValue )
                    ]
                ] ;
                sh:message "A direct calculation method shall not be used for this calculation case."
            ] ;
            sh:property [
                sh:path nltl:calculationCaseAssessedHullStructure ;
                sh:class nltl:hullStructure ;
                sh:node [
                    sh:or (
                        [ sh:class nltl:plating ]
                        [ sh:class nltl:structuralMember ]
                    ) ;
                    sh:property [
                        sh:path nltl:thickness ;
                        sh:nodeKind sh:IRI ;
                        sh:class qudt:QuantityValue ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:message "Thickness shall be expressed in metres."
                            ]
                        ]
                    ] ;
                    sh:message "The assessed hull structure shall be shell plating or a local-frame structural member governed by I2.4, I2.6, or I2.7."
                ] ;
                sh:minCount 1 ;
            ]
        ]
    ] .
