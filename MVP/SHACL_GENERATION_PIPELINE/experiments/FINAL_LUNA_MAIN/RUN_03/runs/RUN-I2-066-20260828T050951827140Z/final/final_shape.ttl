@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_066_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node gen:I2_066_WeldScopeShape
    ] .

gen:I2_066_WeldScopeShape
    a sh:NodeShape ;
    sh:or (
        gen:I2_066_ApplicableWeldShape
        gen:I2_066_NonApplicableWeldShape
    ) .

gen:I2_066_ApplicableWeldShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A weld in an ice-strengthened area must identify that applicability explicitly as true."
    ] ;
    sh:property [
        sh:path nltl:weldType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:doubleContinuousWeld ;
        sh:message "Welding within an ice-strengthened area must be of the double continuous type."
    ] .

gen:I2_066_NonApplicableWeldShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A weld outside an ice-strengthened area must identify that applicability explicitly as false."
    ] .
