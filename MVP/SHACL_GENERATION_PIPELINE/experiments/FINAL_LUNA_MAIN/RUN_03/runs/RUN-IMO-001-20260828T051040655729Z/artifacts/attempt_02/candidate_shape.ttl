@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_001_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its design ice condition."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the design ice condition is medium first-year ice with possible old-ice inclusions, shipCategory must be exactly Category A with no additional value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions .
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory
                            nltl:polarShipCategoryA .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (
                            ?category != nltl:polarShipCategoryA
                        )
                    }
                )
            }
        """
    ] .
