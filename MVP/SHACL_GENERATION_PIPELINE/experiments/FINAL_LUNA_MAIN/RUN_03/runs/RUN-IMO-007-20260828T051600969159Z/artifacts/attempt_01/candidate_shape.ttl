@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_007_StaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:class nltl:iceConditionValue ;
        sh:in (
            nltl:openWaterIceCondition
            nltl:iceConditionLessSevereThanCategoryAAndB
            nltl:iceFreeIceCondition
            nltl:mediumFirstYearIceWithPossibleOldIceInclusions
            nltl:otherWatersIceCondition
            nltl:thinFirstYearIceWithPossibleOldIceInclusions
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must declare one permitted ice condition classification."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:hasValue nltl:openWaterIceCondition
            ] ;
            sh:property [
                sh:path nltl:seaIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:maxExclusive "1.0"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "For open water, sea ice concentration must be a unitless decimal less than 1."
            ] ;
            sh:property [
                sh:path nltl:iceOfLandOriginPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "For open water, ice of land origin must be absent."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:in (
                    nltl:iceConditionLessSevereThanCategoryAAndB
                    nltl:iceFreeIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                    nltl:otherWatersIceCondition
                    nltl:thinFirstYearIceWithPossibleOldIceInclusions
                )
            ]
        ]
    ) .
