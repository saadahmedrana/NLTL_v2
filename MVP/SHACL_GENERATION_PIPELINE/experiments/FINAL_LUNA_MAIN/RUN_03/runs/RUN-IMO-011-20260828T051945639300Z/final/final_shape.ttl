@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DailyLowTemperatureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DataPeriodQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/YR> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DataPeriodAtLeastTenShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "10.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/YR> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DataPeriodBelowTenShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:maxExclusive "10.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/YR> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DailyLowTemperatureObservationShape
    a sh:NodeShape ;
    sh:class nltl:dailyLowTemperatureObservation ;
    sh:property [
        sh:path nltl:dailyTemperatureObservationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each daily low-temperature observation must have one calendar date."
    ] ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:node gen:DailyLowTemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each daily low-temperature observation must carry one daily low-temperature quantity in degrees Celsius."
    ] .

gen:IMO011ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDailyLowTemperatureObservation ;
        sh:node gen:DailyLowTemperatureObservationShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide dated daily low-temperature observations."
    ] ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:node gen:DataPeriodQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide one data period in years."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:node gen:DailyLowTemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the externally calculated mean daily low temperature in degrees Celsius."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node gen:DataPeriodAtLeastTenShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node gen:DataPeriodBelowTenShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A data period shorter than ten years requires an Administration-approved dataset."
            ]
        ]
    ) .
