@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO017ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:message "A ship must have a Polar Ship Certificate form."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node gen:IMO017SolasScheduleShape ;
        sh:message "A ship must have the applicable SOLAS certificate schedule."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:class nltl:polarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node gen:IMO017SupplementShape ;
        sh:message "A ship must have a Polar Certificate supplement."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Certificate supplement presence indicator must be true."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate validity dates must be recorded."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate survey dates must be recorded."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate endorsement dates must be recorded."
    ] ;
    sh:sparql [
        sh:message "Every Polar Ship Certificate validity, survey, and endorsement date must match a SOLAS schedule record of the corresponding category, and every SOLAS schedule record must match the corresponding Polar Ship Certificate date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                               nltl:certificateScheduleDateType nltl:validityDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                               nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                               nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                           nltl:certificateScheduleDateType nltl:validityDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?date
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                           nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?date
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                           nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?date
                    }
                }
            }
        """
    ] .

gen:IMO017SolasScheduleShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:class nltl:certificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO017DateRecordShape ;
        sh:message "The SOLAS certificate schedule must contain certificate schedule date records."
    ] .

gen:IMO017DateRecordShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Each certificate schedule date record must contain a date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue nltl:validityDateCategory
            ]
            [
                sh:hasValue nltl:surveyDateCategory
            ]
            [
                sh:hasValue nltl:endorsementDateCategory
            ]
        ) ;
        sh:message "Each certificate schedule date record must have exactly one permitted validity, survey, or endorsement category."
    ] .

gen:IMO017SupplementShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:message "The Polar Certificate supplement must contain required equipment records."
    ] .
