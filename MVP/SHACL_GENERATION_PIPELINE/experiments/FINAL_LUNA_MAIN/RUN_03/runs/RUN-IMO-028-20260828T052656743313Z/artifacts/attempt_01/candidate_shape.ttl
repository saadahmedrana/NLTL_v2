@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-028-PWOMProceduresShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:emergencyProviderContactProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The PWOM must include applicable emergency-provider contact procedures."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-028-IceStrengthenedBranch>
        <urn:nltl:generated-shape:IMO-028-NotIceStrengthenedBranch>
    ) .

<urn:nltl:generated-shape:IMO-028-IceStrengthenedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:prolongedEntrapmentProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Ice-strengthened ships must have PWOM procedures for life support and ship integrity during prolonged ice entrapment."
    ] .

<urn:nltl:generated-shape:IMO-028-NotIceStrengthenedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .
