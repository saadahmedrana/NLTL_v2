@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO032ApprovalABShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:message "The applicable scantling approval record must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1 ;
        sh:message "The category A or B scantling approval must identify an authorized approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:minCount 1 ;
        sh:message "The category A or B scantling approval must identify an acceptable or equivalent-safety standard."
    ] .

gen:IMO032ApprovalCShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:message "The applicable scantling approval record must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1 ;
        sh:message "The ice-strengthened category C scantling approval must identify an authorized approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "acceptable standard adequate for operating ice type and concentration"
        ) ;
        sh:minCount 1 ;
        sh:message "The ice-strengthened category C scantling approval must identify an acceptable standard adequate for the operating ice conditions."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ice-strengthened category C approval must specify the operating ice type."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:maxCount 1 ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ice-strengthened category C approval must specify operating ice concentration as a unitless quantity."
    ] .

gen:IMO032Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:message "The ship category must be provided as Category A, B, or C."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ice-strengthening status is required to determine Category C applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                )
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:class nltl:approvalRecord ;
                sh:node gen:IMO032ApprovalABShape ;
                sh:minCount 1 ;
                sh:message "A Category A or B ship must have a conforming scantling approval record."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:class nltl:approvalRecord ;
                sh:node gen:IMO032ApprovalCShape ;
                sh:minCount 1 ;
                sh:message "An ice-strengthened Category C ship must have a conforming scantling approval record with operating ice context."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue false
            ]
        ]
    ) .
