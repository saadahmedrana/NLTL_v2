@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_033_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or ( gen:IMO_033_NotLikelyShape gen:IMO_033_LikelyShape ) .

gen:IMO_033_NotLikelyShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IMO_033_LikelyShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:deckIcingAllowance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "30"^^xsd:decimal ;
                sh:maxInclusive "30"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:sideIcingAllowance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "7.5"^^xsd:decimal ;
                sh:maxInclusive "7.5"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:continuousSurfaceProjectedArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:discontinuousSurfaceProjectedArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:continuousSurfaceStaticMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:discontinuousSurfaceStaticMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Discontinuous surface projected area must equal continuous surface projected area multiplied by 1.05 within the permitted tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:continuousSurfaceProjectedArea ?continuousNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousNode .
                ?continuousNode qudt:numericValue ?continuous .
                ?discontinuousNode qudt:numericValue ?discontinuous .
                BIND((?continuous * 1.05) AS ?expected)
                FILTER (
                    (?expected >= 0.000001 &&
                     (?discontinuous < (?expected - (?expected * 0.000001)) ||
                      ?discontinuous > (?expected + (?expected * 0.000001)))) ||
                    (?expected <= -0.000001 &&
                     (?discontinuous < (?expected - ((0 - ?expected) * 0.000001)) ||
                      ?discontinuous > (?expected + ((0 - ?expected) * 0.000001)))) ||
                    (?expected > -0.000001 && ?expected < 0.000001 &&
                     (?discontinuous < (?expected - 0.000001) ||
                      ?discontinuous > (?expected + 0.000001)))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Discontinuous surface static moment must equal continuous surface static moment multiplied by 1.10 within the permitted tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:continuousSurfaceStaticMoment ?continuousNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousNode .
                ?continuousNode qudt:numericValue ?continuous .
                ?discontinuousNode qudt:numericValue ?discontinuous .
                BIND((?continuous * 1.10) AS ?expected)
                FILTER (
                    (?expected >= 0.000001 &&
                     (?discontinuous < (?expected - (?expected * 0.000001)) ||
                      ?discontinuous > (?expected + (?expected * 0.000001)))) ||
                    (?expected <= -0.000001 &&
                     (?discontinuous < (?expected - ((0 - ?expected) * 0.000001)) ||
                      ?discontinuous > (?expected + ((0 - ?expected) * 0.000001)))) ||
                    (?expected > -0.000001 && ?expected < 0.000001 &&
                     (?discontinuous < (?expected - 0.000001) ||
                      ?discontinuous > (?expected + 0.000001)))
                )
            }
        """
    ] .
