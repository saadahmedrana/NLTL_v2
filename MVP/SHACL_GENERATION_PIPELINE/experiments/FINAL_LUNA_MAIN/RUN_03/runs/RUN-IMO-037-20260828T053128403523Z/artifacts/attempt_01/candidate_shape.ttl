@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCategoryValue ;
        sh:message "A ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A construction date is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                )
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:node gen:IMO_037_LoadingConditionCaseShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:maxExclusive "2017-01-01"^^xsd:date
            ]
        ]
    ) ;
    sh:message "For a Category A or B ship constructed on or after 1 January 2017, each loading condition must satisfy the residual stability outcome or the permitted alternative-instrument outcome." .

gen:IMO_037_LoadingConditionCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadingConditionCase ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Each loading condition case requires an identifier."
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Each loading condition case requires the alternative-instrument applicability result."
    ] ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:minCount 1 ;
        sh:node gen:IMO_037_ResidualStabilityQuantityShape ;
        sh:message "Each loading condition case requires a dimensionless residual stability factor result."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each loading condition case requires evidence for its external result."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:residualStabilityFactorSI ;
                sh:node gen:IMO_037_ExactResidualStabilityQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "The permitted alternative-instrument residual stability outcome must be compliant."
            ]
        ]
    ) ;
    sh:message "A loading condition must have either residual stability factor s_i equal to one or a compliant permitted alternative-instrument outcome." .

gen:IMO_037_ResidualStabilityQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gen:IMO_037_ExactResidualStabilityQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "1"^^xsd:decimal ;
        sh:maxInclusive "1"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .
