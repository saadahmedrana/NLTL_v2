@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_041_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:openingActuationType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Opening actuation type is required to determine whether the hydraulic-fluid protection condition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships with hydraulically operated hatches or doors shall provide freezing or excessive-viscosity control for the hydraulic fluid." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:openingActuationType ?actuation .
                FILTER (STR(?actuation) = "hydraulic")
                FILTER NOT EXISTS {
                    $this nltl:hydraulicFluidFreezingOrViscosityControlPresent ?protection .
                    FILTER (
                        datatype(?protection) = xsd:boolean &&
                        ?protection = true
                    )
                }
            }
        """
    ] .
