@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_043_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node gen:IMO_043_MachineryInstallationShape ;
        sh:message "Each machinery installation must provide the applicable hazard, associated-equipment, and protection-evidence structure required by the rule."
    ] .

gen:IMO_043_MachineryInstallationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 1 ;
        sh:in (
            nltl:iceAccretionHazard
            nltl:snowAccumulationHazard
            nltl:seawaterIceIngestionHazard
            nltl:liquidFreezingOrViscosityIncreaseHazard
            nltl:seawaterIntakeTemperatureHazard
            nltl:snowIngestionHazard
        ) ;
        sh:message "The machinery installation must identify at least one applicable hazard from the permitted hazard alternatives."
    ] ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:class nltl:associatedEquipmentItem ;
        sh:node gen:IMO_043_AssociatedEquipmentShape ;
        sh:message "Each associated equipment item of the machinery installation must be represented."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The machinery installation must provide protection evidence."
    ] .

gen:IMO_043_AssociatedEquipmentShape
    a sh:NodeShape ;
    sh:class nltl:associatedEquipmentItem .
