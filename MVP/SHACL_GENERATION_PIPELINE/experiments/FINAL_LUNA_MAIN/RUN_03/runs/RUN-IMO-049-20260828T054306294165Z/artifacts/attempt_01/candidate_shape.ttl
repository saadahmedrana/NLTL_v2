@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO049_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        )
    ] ;
    sh:or (
        nltl:IMO049_CategoryAShape
        nltl:IMO049_CategoryBShape
        nltl:IMO049_IceStrengthenedCategoryCShape
        nltl:IMO049_NonIceStrengthenedCategoryCShape
    ) .

nltl:IMO049_CategoryAShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:hasValue nltl:polarShipCategoryA
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node nltl:IMO049_CategoryABComponentShape
    ] .

nltl:IMO049_CategoryBShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:hasValue nltl:polarShipCategoryB
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node nltl:IMO049_CategoryABComponentShape
    ] .

nltl:IMO049_IceStrengthenedCategoryCShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node nltl:IMO049_CategoryCComponentShape
    ] .

nltl:IMO049_NonIceStrengthenedCategoryCShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] .

nltl:IMO049_CategoryABComponentShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:node nltl:IMO049_CategoryABApprovalShape
    ] .

nltl:IMO049_CategoryCComponentShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:node nltl:IMO049_CategoryCApprovalShape
    ] .

nltl:IMO049_CategoryABApprovalShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        )
    ] .

nltl:IMO049_CategoryCApprovalShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:hasValue "acceptable standard adequate for operating ice type and concentration"
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:IMO049_IceConcentrationQuantityShape
    ] .

nltl:IMO049_IceConcentrationQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
