@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO052ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasRequiredAccessItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredAccessItem ;
        sh:node gen:IMO052RequiredAccessItemShape
    ] .

gen:IMO052RequiredAccessItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each required access item must have associated ice or snow removal or prevention means."
    ] .
