@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO_059_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node gs:IMO_059_FirefighterOutfitShape
    ] .

gs:IMO_059_FirefighterOutfitShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStorageLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:physicalStorageLocation ;
        sh:minCount 1 ;
        sh:node gs:IMO_059_StorageLocationShape ;
        sh:message "Each firefighter outfit shall have a storage location."
    ] .

gs:IMO_059_StorageLocationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:storageTemperatureClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:storageTemperatureClassValue ;
        sh:minCount 1 ;
        sh:hasValue nltl:warmStorageLocation ;
        sh:message "The storage location for each firefighter outfit shall be classified as warm."
    ] .
