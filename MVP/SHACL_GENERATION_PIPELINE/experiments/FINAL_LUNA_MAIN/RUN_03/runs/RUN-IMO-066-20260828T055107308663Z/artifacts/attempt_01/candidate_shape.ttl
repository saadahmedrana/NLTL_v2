@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Applicability must indicate that the ship is exposed to ice accretion."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066EscapeRouteItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed escape route must be represented as a protected item with ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066MusterStationItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A muster station must be represented as a protected item with ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066EmbarkationAreaItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "An embarkation area must be represented as a protected item with ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066SurvivalCraftItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A survival craft must be represented as a protected item with ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066LaunchingApplianceItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A launching appliance must be represented as a protected item with ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066SurvivalCraftAccessItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "Access to a survival craft must be represented as a protected item with ice or snow removal or prevention means."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Applicability must indicate that the ship is not exposed to ice accretion."
            ]
        ]
    ) .

gen:IMO066EscapeRouteItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:escapeRouteProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066MusterStationItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:musterStationProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066EmbarkationAreaItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:embarkationAreaProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066SurvivalCraftItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066LaunchingApplianceItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:launchingApplianceProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066SurvivalCraftAccessItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .
