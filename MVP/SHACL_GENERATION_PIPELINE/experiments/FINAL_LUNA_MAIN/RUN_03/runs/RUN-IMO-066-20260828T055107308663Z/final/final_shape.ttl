@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must record whether it is exposed to ice accretion."
    ] ;
    sh:or (
        gen:IMO066ApplicableShape
        gen:IMO066NotApplicableShape
    ) .

gen:IMO066ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:hasValue true
    ] ;
    sh:sparql [
        sh:message "Every represented escape route, muster station, embarkation area, survival craft, launching appliance, or survival-craft access item must have associated ice or snow removal or prevention means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT ?this
            WHERE {
                ?this nltl:hasProtectedItem ?item .
                ?item nltl:protectedItemCategory ?category .
                FILTER (
                    ?category IN (
                        nltl:escapeRouteProtectedItem,
                        nltl:musterStationProtectedItem,
                        nltl:embarkationAreaProtectedItem,
                        nltl:survivalCraftProtectedItem,
                        nltl:launchingApplianceProtectedItem,
                        nltl:survivalCraftAccessProtectedItem
                    )
                )
                FILTER NOT EXISTS {
                    ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                }
            }
        """
    ] .

gen:IMO066NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:hasValue false
    ] .
