@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-070-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A passenger ship must declare that assigned survival equipment is size-compatible."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:node <urn:nltl:generated-shape:IMO-070-PersonShape> ;
        sh:message "Each represented person on board must have a compliant survival-equipment assignment."
    ] .

<urn:nltl:generated-shape:IMO-070-PersonShape> a sh:NodeShape ;
    sh:class nltl:personOnBoardMember ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-070-AssignmentShape> ;
        sh:message "Each person on board must have one personal survival equipment assignment."
    ] .

<urn:nltl:generated-shape:IMO-070-AssignmentShape> a sh:NodeShape ;
    sh:class nltl:personalSurvivalEquipmentAssignment ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:class nltl:immersionSuitEquipment
            ]
            [
                sh:class nltl:thermalProtectiveAidEquipment
            ]
        ) ;
        sh:message "The assignment must provide one properly sized immersion suit or one thermal protective aid."
    ] .
