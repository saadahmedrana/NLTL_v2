@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_070_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a passenger ship, each linked person on board must have exactly one assignment to exactly one immersion suit or thermal protective aid, and size compatibility must be true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this rdf:type nltl:ship .
                $this rdf:type nltl:passengerShip .

                FILTER (
                    NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status
                    }
                    ||
                    EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status1 .
                        $this nltl:sizeCompatibilityStatus ?status2 .
                        FILTER ( ?status1 != ?status2 )
                    }
                    ||
                    EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status .
                        FILTER (
                            datatype(?status) != xsd:boolean
                            || ?status != true
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:hasPersonOnBoardMember ?person .
                        FILTER (
                            NOT EXISTS {
                                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment
                            }
                            ||
                            EXISTS {
                                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment1 .
                                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment2 .
                                FILTER ( ?assignment1 != ?assignment2 )
                            }
                            ||
                            EXISTS {
                                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                                FILTER (
                                    NOT EXISTS {
                                        ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment
                                    }
                                    ||
                                    EXISTS {
                                        ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment1 .
                                        ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment2 .
                                        FILTER ( ?equipment1 != ?equipment2 )
                                    }
                                    ||
                                    NOT EXISTS {
                                        ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                                        ?equipment rdf:type ?equipmentType .
                                        FILTER (
                                            ?equipmentType IN (
                                                nltl:immersionSuitEquipment,
                                                nltl:thermalProtectiveAidEquipment
                                            )
                                        )
                                    }
                                )
                            }
                        )
                    }
                )
            }
        """ ;
    ] .
