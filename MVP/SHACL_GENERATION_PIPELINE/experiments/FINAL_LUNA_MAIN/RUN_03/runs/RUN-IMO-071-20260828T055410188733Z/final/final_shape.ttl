@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-071-ImmersionSuitType>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:immersionSuitRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must specify whether immersion suits are required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:immersionSuitTypeClassification ;
                sh:hasValue nltl:insulatedImmersionSuit ;
                sh:maxCount 1 ;
                sh:message "Where immersion suits are required, their type must be insulated."
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:hasValue false
            ]
        ]
    ) .
