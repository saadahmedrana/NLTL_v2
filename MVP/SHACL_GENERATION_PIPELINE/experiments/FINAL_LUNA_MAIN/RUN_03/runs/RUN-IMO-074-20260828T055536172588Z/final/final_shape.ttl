@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-074-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The abandonment potential assessment must be recorded as false when the conditional requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The abandonment potential assessment must be recorded as true to select the applicable branch."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:groupSurvivalEquipmentCarried ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Group survival equipment must be carried when abandonment onto ice or land is identified."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                        sh:nodeKind sh:IRI ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:evidenceStateApproved ;
                        sh:message "Approved equivalent life-saving functionality must be recorded when group survival equipment is not the selected alternative."
                    ]
                ]
            )
        ]
    ) .
