@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-077> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:personsCapacityRequirement ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:additionalEquipmentCapacityRequirement ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:survivalCraftAvailableCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:launchingApplianceCapacity ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloGM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:loadedSurvivalCraftRequirement ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloGM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "When additional equipment is carried, survival-craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft ?carried .
                FILTER (?carried = true)
                FILTER NOT EXISTS {
                    $this nltl:personsCapacityRequirement ?persons ;
                         nltl:additionalEquipmentCapacityRequirement ?additional ;
                         nltl:survivalCraftAvailableCapacity ?available .
                    FILTER (
                        datatype(?persons) = xsd:integer &&
                        datatype(?additional) = xsd:integer &&
                        datatype(?available) = xsd:integer &&
                        ?available >= (?persons + ?additional)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When additional equipment is carried, launching-appliance capacity must be at least the loaded survival-craft requirement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:additionalEquipmentCarriedInSurvivalCraft ?carried .
                FILTER (?carried = true)
                FILTER NOT EXISTS {
                    $this nltl:launchingApplianceCapacity ?launching ;
                         nltl:loadedSurvivalCraftRequirement ?loaded .
                    ?launching qudt:numericValue ?launchingValue ;
                              qudt:unit unit:KiloGM .
                    ?loaded qudt:numericValue ?loadedValue ;
                            qudt:unit unit:KiloGM .
                    FILTER (
                        datatype(?launchingValue) = xsd:decimal &&
                        datatype(?loadedValue) = xsd:decimal &&
                        ?launchingValue >= ?loadedValue
                    )
                }
            }
        """
    ] .
