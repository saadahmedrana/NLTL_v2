@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-082_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall have SOLAS V/22.1.9.4 compliance status true."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:bridgeConfigurationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall specify its bridge configuration type."
    ] ;
    sh:sparql [
        sh:message "When the bridge configuration requires an astern view, clearViewAsternStatus shall be exactly true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                    nltl:asternViewRequiredBridgeConfiguration .
                FILTER (
                    NOT EXISTS {
                        $this nltl:clearViewAsternStatus ?status .
                        FILTER (?status = "true"^^xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?otherStatus .
                        FILTER (?otherStatus != "true"^^xsd:boolean)
                    }
                )
            }
        """
    ] .
