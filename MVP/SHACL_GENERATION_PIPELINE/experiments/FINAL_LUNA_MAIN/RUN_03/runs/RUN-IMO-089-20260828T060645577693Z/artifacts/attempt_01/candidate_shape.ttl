@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_089_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icebreakerEscortOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Icebreaker escort operation status is required to determine applicability."
    ] ;
    sh:or (
        gs:IMO_089_EscortApplicable
        gs:IMO_089_EscortNotApplicable
    ) .

gs:IMO_089_EscortApplicable
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:icebreakerEscortOperation ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:manuallyInitiatedFlashingRedStoppedLightPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable ship shall have a manually initiated flashing red stopped light."
    ] ;
    sh:property [
        sh:path nltl:lightVisibleFromAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The stopped light shall be visible from astern."
    ] ;
    sh:property [
        sh:path nltl:visibilityRange ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MI_N ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The stopped light visibility range shall be at least two nautical miles."
    ] ;
    sh:property [
        sh:path nltl:colregSternLightArcComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The light visibility arcs shall comply with the required stern-light specifications."
    ] .

gs:IMO_089_EscortNotApplicable
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:icebreakerEscortOperation ;
        sh:hasValue false
    ] .
