@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must indicate that it operates in low air temperature."
    ] ;
    sh:property [
        sh:path nltl:releasedRescueBoatOrLifeboat ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must indicate that a rescue boat or lifeboat is released for evacuation."
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
        sh:message "The ship must provide its lifeboat relationship and each linked lifeboat must carry the required distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:minCount 1 ;
        sh:message "The ship must provide the declared other-survival-craft relationship."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
        sh:message "The ship must provide the declared required rescue-boat or lifeboat relationship."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> ;
        sh:message "Each linked survival craft must carry the required communication devices."
    ] .

<urn:nltl:generated-shape:IMO-097-LifeboatShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable lifeboat must carry at least one ship-to-shore distress-alert device."
    ] .

<urn:nltl:generated-shape:IMO-097-SurvivalCraftShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must carry at least one on-scene transmit/receive communication device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must carry at least one ship-to-shore distress-alert device."
    ] .
