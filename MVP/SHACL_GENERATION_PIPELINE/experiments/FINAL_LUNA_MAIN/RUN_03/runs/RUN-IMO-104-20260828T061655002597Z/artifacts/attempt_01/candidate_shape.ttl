@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-104-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record completed PWOM familiarization status."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every assigned-duty PWOM procedure or equipment item must have a corresponding crew-member familiarization record." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasCrewMemberInventory ?crewMember .
                ?crewMember nltl:hasAssignedDuty ?assignedDuty .
                ?assignedDuty nltl:hasRelevantPolarWaterOperationalManualItem ?manualItem .
                FILTER NOT EXISTS {
                    ?crewMember nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?manualItem .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-104-CrewMemberShape>
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-104-AssignedDutyShape> ;
        sh:message "Each crew member must have an assigned duty linked to relevant PWOM procedures or equipment."
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-104-FamiliarizationRecordShape> ;
        sh:message "Each crew member must have a PWOM familiarization record."
    ] .

<urn:nltl:generated-shape:IMO-104-AssignedDutyShape>
    a sh:NodeShape ;
    sh:class nltl:assignedDuty ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:minCount 1 ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "Each assigned duty must identify the relevant PWOM procedure or equipment."
    ] .

<urn:nltl:generated-shape:IMO-104-FamiliarizationRecordShape>
    a sh:NodeShape ;
    sh:class nltl:familiarizationRecord ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:minCount 1 ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "Each familiarization record must identify the PWOM procedure or equipment covered."
    ] .
