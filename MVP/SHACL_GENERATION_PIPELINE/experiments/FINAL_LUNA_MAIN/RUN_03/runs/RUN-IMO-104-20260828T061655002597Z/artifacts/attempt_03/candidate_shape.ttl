@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_104_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record completed PWOM familiarization status."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:class nltl:crewMember ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_CrewMemberShape ;
        sh:message "The ship must identify its crew members through hasCrewMember."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:class nltl:crewMember ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_CrewMemberShape ;
        sh:message "The ship must identify applicable crew members through hasCrewMemberInventory."
    ] .

gen:IMO_104_CrewMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:class nltl:assignedDuty ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_AssignedDutyShape ;
        sh:message "Each crew member must have an assigned duty."
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:class nltl:familiarizationRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_FamiliarizationRecordShape ;
        sh:message "Each crew member must have a PWOM familiarization record."
    ] .

gen:IMO_104_AssignedDutyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:minCount 1 ;
        sh:message "Each assigned duty must identify relevant PWOM procedures or equipment."
    ] .

gen:IMO_104_FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:minCount 1 ;
        sh:message "Each familiarization record must identify the relevant PWOM item."
    ] .
