@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO106ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A ship must provide its discharged material classification."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dischargedMaterialClassification ;
                sh:in (
                    nltl:cleanBallastMaterial
                    nltl:segregatedBallastMaterial
                )
            ] ;
            sh:property [
                sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "For clean or segregated ballast, the paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:dischargedMaterialClassification ;
                sh:not [
                    sh:in (
                        nltl:cleanBallastMaterial
                        nltl:segregatedBallastMaterial
                    )
                ]
            ]
        ]
    ) .
