@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-116> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A sewage discharge type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:notComminutedOrDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The not-comminuted-or-disinfected applicability indicator is required."
    ] ;
    sh:sparql [
        sh:message "When sewage discharge is not comminuted or disinfected, MARPOL Annex IV regulation 11.1.1 compliance, a distance greater than 12 nautical miles from ice shelf or fast ice, nearby ice concentration exceeding 1/10, and the corresponding ice-area distance record are required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:sewageDischargeType ?dischargeType .
    FILTER (?dischargeType = "not_comminuted_or_disinfected"^^xsd:string)
    FILTER NOT EXISTS {
        $this nltl:notComminutedOrDisinfected ?notComminuted .
        FILTER (?notComminuted = true)

        $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?compliant .
        FILTER (?compliant = true)

        $this nltl:distanceToNearestIceShelfOrFastIce ?nearestDistance .
        ?nearestDistance qudt:numericValue ?nearestValue ;
                          qudt:unit <http://qudt.org/vocab/unit/MI_N> .
        FILTER (datatype(?nearestValue) = xsd:decimal)
        FILTER (?nearestValue > "12"^^xsd:decimal)

        $this nltl:nearbyIceConcentration ?nearbyConcentration .
        ?nearbyConcentration qudt:numericValue ?concentrationValue ;
                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (datatype(?concentrationValue) = xsd:decimal)
        FILTER (?concentrationValue > "0.1"^^xsd:decimal)

        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
        ?areaDistance qudt:numericValue ?areaDistanceValue ;
                      qudt:unit <http://qudt.org/vocab/unit/MI_N> .
        FILTER (datatype(?areaDistanceValue) = xsd:decimal)
    }
}
"""
    ] .
