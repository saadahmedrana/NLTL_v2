@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_116_StaticShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "When sewage discharge type is not_comminuted_or_disinfected, the ship must record not comminuted or disinfected status as true, MARPOL Annex IV regulation 11.1.1 compliance as true, a distance greater than 12 nautical miles from ice shelf or fast ice, nearby ice concentration greater than 0.1, and a distance record for areas exceeding 0.1 ice concentration." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType .
                FILTER (?dischargeType = "not_comminuted_or_disinfected")

                FILTER NOT EXISTS {
                    $this nltl:notComminutedOrDisinfected true ;
                          nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true ;
                          nltl:distanceToNearestIceShelfOrFastIce ?iceDistance ;
                          nltl:nearbyIceConcentration ?nearbyConcentration ;
                          nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .

                    ?iceDistance qudt:numericValue ?iceDistanceValue ;
                                 qudt:unit unit:MI_N .
                    FILTER (
                        datatype(?iceDistanceValue) = xsd:decimal &&
                        ?iceDistanceValue > 12
                    )

                    ?nearbyConcentration qudt:numericValue ?nearbyConcentrationValue ;
                                          qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?nearbyConcentrationValue) = xsd:decimal &&
                        ?nearbyConcentrationValue > 0.1
                    )

                    ?areaDistance qudt:numericValue ?areaDistanceValue ;
                                  qudt:unit unit:MI_N .
                    FILTER (datatype(?areaDistanceValue) = xsd:decimal)
                }
            }
        """
    ] .
