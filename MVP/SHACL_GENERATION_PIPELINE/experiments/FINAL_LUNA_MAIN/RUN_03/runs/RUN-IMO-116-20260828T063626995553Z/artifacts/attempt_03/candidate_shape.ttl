@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_116_Static_ConditionalShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A sewage discharge type is required to determine applicability of the conditional rule."
    ] ;
    sh:sparql [
        sh:message "When sewage discharge is not comminuted or disinfected, the ship must record notComminutedOrDisinfected=true, MARPOL Annex IV regulation 11.1.1 compliance=true, a distance greater than 12 nautical miles from ice shelf or fast ice, nearby ice concentration greater than 0.1, and a nautical-mile distance from an area with ice concentration above 0.1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType
                    "not_comminuted_or_disinfected"^^xsd:string .
                FILTER (
                    NOT EXISTS {
                        $this nltl:notComminutedOrDisinfected
                            "true"^^xsd:boolean
                    }
                    ||
                    NOT EXISTS {
                        $this
                            nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus
                            "true"^^xsd:boolean
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceToNearestIceShelfOrFastIce ?distance .
                        ?distance a qudt:QuantityValue ;
                            qudt:numericValue ?distanceValue ;
                            qudt:unit unit:MI_N .
                        FILTER (
                            datatype(?distanceValue) = xsd:decimal &&
                            ?distanceValue > "12"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nearbyIceConcentration ?concentration .
                        ?concentration a qudt:QuantityValue ;
                            qudt:numericValue ?concentrationValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?concentrationValue) = xsd:decimal &&
                            ?concentrationValue > "0.1"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this
                            nltl:distanceFromAreaWithIceConcentrationAboveOneTenth
                            ?areaDistance .
                        ?areaDistance a qudt:QuantityValue ;
                            qudt:numericValue ?areaDistanceValue ;
                            qudt:unit unit:MI_N .
                        FILTER (datatype(?areaDistanceValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
