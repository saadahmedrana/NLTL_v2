@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For a ship operating in Arctic_waters and discharging food waste to sea, the nearest land ice shelf or fast ice distance must be at least 12 nautical miles, and a nautical-mile distance from an area with nearby ice concentration above 0.1 must be recorded." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>

SELECT $this
WHERE {
    $this nltl:operatingArea ?area ;
          nltl:foodWasteDischargeToSea ?discharge .

    FILTER (
        datatype(?area) = <http://www.w3.org/2001/XMLSchema#string> &&
        STR(?area) = "Arctic_waters" &&
        datatype(?discharge) = <http://www.w3.org/2001/XMLSchema#boolean> &&
        ?discharge = true
    )

    FILTER (
        !EXISTS {
            $this nltl:distanceToNearestLandIceShelfOrFastIce ?nearest .
            ?nearest rdf:type qudt:QuantityValue ;
                     qudt:numericValue ?nearestValue ;
                     qudt:unit unit:MI_N .
            FILTER (?nearestValue >= 12)
        }
        ||
        EXISTS {
            $this nltl:distanceToNearestLandIceShelfOrFastIce ?nearestWithUnit .
            ?nearestWithUnit qudt:unit ?nearestUnit .
            FILTER (?nearestUnit != unit:MI_N)
        }
    )

    FILTER (
        !EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?recordedDistance .
            ?recordedDistance rdf:type qudt:QuantityValue ;
                              qudt:numericValue ?recordedValue ;
                              qudt:unit unit:MI_N .
        }
        ||
        EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?recordedWithUnit .
            ?recordedWithUnit qudt:unit ?recordedUnit .
            FILTER (?recordedUnit != unit:MI_N)
        }
    )

    FILTER (
        !EXISTS {
            $this nltl:nearbyIceConcentration ?nearby .
            ?nearby rdf:type qudt:QuantityValue ;
                    qudt:numericValue ?nearbyValue ;
                    qudt:unit unit:UNITLESS .
            FILTER (?nearbyValue > 0.1)
        }
        ||
        EXISTS {
            $this nltl:nearbyIceConcentration ?nearbyWithUnit .
            ?nearbyWithUnit qudt:unit ?nearbyUnit .
            FILTER (?nearbyUnit != unit:UNITLESS)
        }
    )
}
"""
    ] .
