@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_007_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO26_007_NotIceStrengthened
        gen:IMO26_007_IceStrengthenedBeforeEffectiveDate
        gen:IMO26_007_Applicable
    ) ;
    sh:message "The ship must be non-ice-strengthened, or be ice-strengthened and constructed before 2026-01-01, or satisfy an applicable echo-sounding equipment alternative." .

gen:IMO26_007_NotIceStrengthened a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:message "Ice-strengthening status must be explicitly false for this non-applicable branch."
    ] .

gen:IMO26_007_IceStrengthenedBeforeEffectiveDate a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Ice-strengthening status must be explicitly true for the pre-effective-date branch."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2026-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship in this branch must have a construction date before 2026-01-01."
    ] .

gen:IMO26_007_Applicable a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The applicable branch requires the ship to be ice-strengthened."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2026-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "The applicable branch requires a construction date on or after 2026-01-01."
    ] ;
    sh:or (
        gen:IMO26_007_TwoIndependentEchoSoundingDevices
        gen:IMO26_007_OneEchoSoundingDeviceTwoIndependentTransducers
        gen:IMO26_007_ApprovedEquivalentDevice
    ) ;
    sh:message "An applicable ice-strengthened ship must satisfy one permitted echo-sounding equipment alternative." .

gen:IMO26_007_TwoIndependentEchoSoundingDevices a sh:NodeShape ;
    sh:property [
        sh:path nltl:independentEchoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1
    ] .

gen:IMO26_007_OneEchoSoundingDeviceTwoIndependentTransducers a sh:NodeShape ;
    sh:property [
        sh:path nltl:echoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:independentTransducerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1
    ] .

gen:IMO26_007_ApprovedEquivalentDevice a sh:NodeShape ;
    sh:property [
        sh:path nltl:administrationApprovedEquivalentDepthSoundingDevicePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] .
