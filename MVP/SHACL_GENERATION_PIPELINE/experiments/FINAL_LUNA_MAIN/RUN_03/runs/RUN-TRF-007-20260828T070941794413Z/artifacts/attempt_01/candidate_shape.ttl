@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF007Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:TRF007NonApplicableShape
        gs:TRF007BeforeDeadlineShape
        gs:TRF007AfterDeadlineShape
    ) ;
    sh:message "The conditional ice-class compliance requirement is not established." .

gs:TRF007NonApplicableShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with ice class IA or IA Super and construction before 1 September 2003 must satisfy the applicable compliance branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (
                    ?ice NOT IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                    ||
                    EXISTS {
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (
                            YEAR(?constructionDate) > 2003
                            ||
                            (
                                YEAR(?constructionDate) = 2003
                                &&
                                (
                                    MONTH(?constructionDate) > 9
                                    ||
                                    (
                                        MONTH(?constructionDate) = 9
                                        &&
                                        DAY(?constructionDate) >= 1
                                    )
                                )
                            )
                        )
                    }
                )
            }
        """
    ] .

gs:TRF007BeforeDeadlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The assessment date must be before the 1 January deadline occurring twenty years after delivery for an applicable ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate .

                FILTER (
                    ?ice IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                )

                FILTER (
                    YEAR(?constructionDate) < 2003
                    ||
                    (
                        YEAR(?constructionDate) = 2003
                        &&
                        (
                            MONTH(?constructionDate) < 9
                            ||
                            (
                                MONTH(?constructionDate) = 9
                                &&
                                DAY(?constructionDate) < 1
                            )
                        )
                    )
                )

                FILTER (
                    YEAR(?assessmentDate) >= YEAR(?deliveryDate) + 20
                )
            }
        """
    ] .

gs:TRF007AfterDeadlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:engineOutputComplianceMethodValue ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "After the deadline, the ship must identify compliance with section 3.2.2 or 3.2.4 of the 2017 Ice Class Regulations."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship must be in the applicable IA or IA Super pre-1 September 2003 category and must be assessed on or after the twenty-year deadline." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate .

                FILTER (
                    ?ice NOT IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                    ||
                    !(
                        YEAR(?constructionDate) < 2003
                        ||
                        (
                            YEAR(?constructionDate) = 2003
                            &&
                            (
                                MONTH(?constructionDate) < 9
                                ||
                                (
                                    MONTH(?constructionDate) = 9
                                    &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                    ||
                    YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20
                )
            }
        """
    ] .
