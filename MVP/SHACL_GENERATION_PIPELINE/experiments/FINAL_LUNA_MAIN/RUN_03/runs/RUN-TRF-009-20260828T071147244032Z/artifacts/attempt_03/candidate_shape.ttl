@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-009> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An IA or IA Super ship must provide a valid construction stage date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA or IA Super ship must provide a construction stage date before 1 September 2003." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                $this nltl:constructionStageDate ?constructionDate .
                FILTER (datatype(?constructionDate) != xsd:date)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA or IA Super ship must provide an assessment date after the applicable construction date condition is established." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?assessmentDate .
                    FILTER (datatype(?assessmentDate) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The assessment date must be an xsd:date for an applicable IA or IA Super ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                $this nltl:assessmentDate ?assessmentDate .
                FILTER (datatype(?assessmentDate) != xsd:date)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA or IA Super ship must provide a delivery date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?deliveryDate .
                    FILTER (datatype(?deliveryDate) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The delivery date must be an xsd:date for an applicable IA or IA Super ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                $this nltl:deliveryDate ?deliveryDate .
                FILTER (datatype(?deliveryDate) != xsd:date)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "On or after 1 January in the year twenty years after delivery, the ship must specify one permitted 2017 Ice Class Regulations compliance method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                $this nltl:assessmentDate ?assessmentDate .
                $this nltl:deliveryDate ?deliveryDate .
                FILTER (datatype(?assessmentDate) = xsd:date)
                FILTER (datatype(?deliveryDate) = xsd:date)
                FILTER (
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        (
                            MONTH(?assessmentDate) > 1 ||
                            (
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) >= 1
                            )
                        )
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:engineOutputComplianceMethod ?method .
                    FILTER (
                        ?method = nltl:traficom2017Section3Point2Point2Method ||
                        ?method = nltl:traficom2017Section3Point2Point4Method
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "On or after the compliance deadline, engineOutputComplianceMethod must be one of the two permitted 2017 method values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                    FILTER (
                        YEAR(?constructionDate) < 2003 ||
                        (
                            YEAR(?constructionDate) = 2003 &&
                            (
                                MONTH(?constructionDate) < 9 ||
                                (
                                    MONTH(?constructionDate) = 9 &&
                                    DAY(?constructionDate) < 1
                                )
                            )
                        )
                    )
                }
                $this nltl:assessmentDate ?assessmentDate .
                $this nltl:deliveryDate ?deliveryDate .
                FILTER (datatype(?assessmentDate) = xsd:date)
                FILTER (datatype(?deliveryDate) = xsd:date)
                FILTER (
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        (
                            MONTH(?assessmentDate) > 1 ||
                            (
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) >= 1
                            )
                        )
                    )
                )
                $this nltl:engineOutputComplianceMethod ?method .
                FILTER (
                    ?method != nltl:traficom2017Section3Point2Point2Method &&
                    ?method != nltl:traficom2017Section3Point2Point4Method
                )
            }
        """
    ] .
