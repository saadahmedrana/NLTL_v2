@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:datatype qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:datatype qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:forwardDraught ;
                sh:datatype qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:datatype qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerHighestPointSubmerged ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasBallastTank ;
                sh:class nltl:ballastTank ;
                sh:node [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:situatedAboveLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:usedToReachLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:freezingPreventionPresent ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:situatedAboveLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:usedToReachLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue false
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:situatedAboveLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue false
                            ] ;
                            sh:property [
                                sh:path nltl:usedToReachLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:situatedAboveLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue false
                            ] ;
                            sh:property [
                                sh:path nltl:usedToReachLowerIceWaterline ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue false
                            ]
                        ]
                    )
                ]
            ] ;
            sh:sparql [
                sh:message "Draught amidships must be at least the LIWL draught amidships." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?draughtNode ;
                              nltl:liwlDraughtAmidships ?liwlNode .
                        ?draughtNode qudt:numericValue ?draught .
                        ?liwlNode qudt:numericValue ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                """
            ] ;
            sh:sparql [
                sh:message "A ballast tank situated above the LIWL and needed to reach the LIWL must have freezing prevention." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasBallastTank ?tank .
                        ?tank nltl:situatedAboveLowerIceWaterline true ;
                              nltl:usedToReachLowerIceWaterline true .
                        FILTER NOT EXISTS {
                            ?tank nltl:freezingPreventionPresent true .
                        }
                    }
                """
            ] ;
            sh:sparql [
                sh:message "Forward draught must satisfy the UIWL displacement and level ice thickness formula." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasUpperIceWaterline ?selectedWaterline ;
                              nltl:levelIceThickness ?iceNode ;
                              nltl:forwardDraught ?forwardNode .
                        ?selectedWaterline nltl:waterlineDisplacement ?selectedDisplacementNode .
                        ?selectedDisplacementNode qudt:numericValue ?delta .
                        ?iceNode qudt:numericValue ?hi .
                        ?forwardNode qudt:numericValue ?forward .
                        FILTER NOT EXISTS {
                            $this nltl:hasUpperIceWaterline ?otherWaterline .
                            ?otherWaterline nltl:waterlineDisplacement ?otherDisplacementNode .
                            ?otherDisplacementNode qudt:numericValue ?otherDelta .
                            FILTER (?otherDelta > ?delta)
                        }
                        BIND ((2 + (0.00025 * ?delta)) * ?hi AS ?formulaMinimum)
                        BIND (4 * ?hi AS ?formulaMaximum)
                        BIND (IF(?formulaMinimum < ?formulaMaximum, ?formulaMinimum, ?formulaMaximum) AS ?requiredForward)
                        FILTER (?forward < ?requiredForward)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue false
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-016-UIWL> a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasUpperIceWaterline ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:waterlineDisplacement ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
