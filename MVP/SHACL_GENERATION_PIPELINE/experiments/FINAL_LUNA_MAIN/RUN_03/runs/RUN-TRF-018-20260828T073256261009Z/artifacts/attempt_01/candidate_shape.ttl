@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF018StaticCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceClass must be one of IA Super, IA, IB, or IC."
    ] ;
    sh:property [
        sh:path nltl:calculatedRequiredPower ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "calculatedRequiredPower must be a single quantity value in kW."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "maximumContinuousRatingPower must be a single quantity value in kW."
    ] ;
    sh:sparql [
        sh:message "maximumContinuousRatingPower must be at least calculatedRequiredPower and at least 1000 kW for IA, IB, or IC, or at least 2800 kW for IA Super." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?ratingQuantity .

                ?calculatedQuantity qudt:numericValue ?calculatedPower ;
                                    qudt:unit qudt:KiloW .
                ?ratingQuantity qudt:numericValue ?ratingPower ;
                                qudt:unit qudt:KiloW .

                FILTER (
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        &&
                        (
                            ?ratingPower < 1000 ||
                            ?ratingPower < ?calculatedPower
                        )
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        &&
                        (
                            ?ratingPower < 2800 ||
                            ?ratingPower < ?calculatedPower
                        )
                    )
                )
            }
        """
    ] .
