@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF023ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:TRF023ApplicableShape>
        <urn:nltl:generated-shape:TRF023Edition2002Shape>
        <urn:nltl:generated-shape:TRF023Edition2008Shape>
        <urn:nltl:generated-shape:TRF023Edition2010Shape>
        <urn:nltl:generated-shape:TRF023Edition2017Shape>
        <urn:nltl:generated-shape:TRF023Edition2021Shape>
        <urn:nltl:generated-shape:TRF023IceClassIaShape>
        <urn:nltl:generated-shape:TRF023IceClassIaSuperShape>
        <urn:nltl:generated-shape:TRF023IceClassIiShape>
        <urn:nltl:generated-shape:TRF023IceClassIiiShape>
    ) .

<urn:nltl:generated-shape:TRF023ApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRuleEdition1985 ;
        sh:minCount 1 ;
        sh:message "The 1985 ice-class regulation edition must be identified when the rule applies."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:message "The applicable ice class must be IB or IC."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Maximum continuous rating power must be provided as a single kW quantity."
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Required minimum engine output must be provided as a single kW quantity."
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?mcrQuantity qudt:numericValue ?mcrValue .
                ?requiredQuantity qudt:numericValue ?requiredValue .
                FILTER (?mcrValue < ?requiredValue)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF023Edition2002Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2002 ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023Edition2008Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2008 ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023Edition2010Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2010 ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023Edition2017Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2017 ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023Edition2021Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2021 ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023IceClassIaShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIa ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023IceClassIaSuperShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023IceClassIiShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIi ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF023IceClassIiiShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIii ;
        sh:minCount 1
    ] .
