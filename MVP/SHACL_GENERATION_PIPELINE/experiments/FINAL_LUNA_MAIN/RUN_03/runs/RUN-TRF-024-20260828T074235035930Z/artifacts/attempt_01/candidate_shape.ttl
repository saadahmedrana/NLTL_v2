@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF024Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1 ;
                sh:message "The ship must have an ice class value to determine applicability of TRF-024."
            ] ;
            sh:sparql [
                sh:message "TRF-024 is non-applicable only when the ship's ice class is neither IA nor IA Super." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass NOT IN (
                                nltl:iceClassIa,
                                nltl:iceClassIaSuper
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A construction stage date is required to determine whether the pre-1 September 2003 applicability condition is met."
            ] ;
            sh:sparql [
                sh:message "TRF-024 is non-applicable when construction began on or after 1 September 2003." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        $this nltl:constructionStageDate ?constructionDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIa,
                                nltl:iceClassIaSuper
                            )
                        )
                        FILTER (
                            YEAR(?constructionDate) > 2003
                            ||
                            (
                                YEAR(?constructionDate) = 2003
                                && MONTH(?constructionDate) > 9
                            )
                            ||
                            (
                                YEAR(?constructionDate) = 2003
                                && MONTH(?constructionDate) = 9
                                && DAY(?constructionDate) >= 1
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A delivery date is required to calculate the twenty-year compliance deadline."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "An assessment date is required to evaluate the TRF-024 deadline."
            ] ;
            sh:property [
                sh:path nltl:engineOutputComplianceMethod ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:engineOutputComplianceMethodValue ;
                sh:hasValue nltl:traficom2017Section3Point2Point2Method ;
                sh:minCount 1 ;
                sh:message "A ship applicable to TRF-024 must demonstrate compliance using the section 3.2.2 method."
            ] ;
            sh:sparql [
                sh:message "For an applicable ship, section 3.2.2 compliance must be established no later than 1 January of the year twenty years after delivery." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        $this nltl:constructionStageDate ?constructionDate .
                        $this nltl:deliveryDate ?deliveryDate .
                        $this nltl:assessmentDate ?assessmentDate .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIa,
                                nltl:iceClassIaSuper
                            )
                        )
                        FILTER (
                            YEAR(?constructionDate) < 2003
                            ||
                            (
                                YEAR(?constructionDate) = 2003
                                && MONTH(?constructionDate) < 9
                            )
                            ||
                            (
                                YEAR(?constructionDate) = 2003
                                && MONTH(?constructionDate) = 9
                                && DAY(?constructionDate) < 1
                            )
                        )
                        FILTER (
                            YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                            ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                && MONTH(?assessmentDate) > 1
                            )
                            ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                && MONTH(?assessmentDate) = 1
                                && DAY(?assessmentDate) > 1
                            )
                        )
                    }
                """
            ]
        ]
    ) ;
    sh:message "The ship does not satisfy the applicable or non-applicable branch of TRF-024." .
