@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_028_QuantityValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF_028_ForceQuantityValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF_028_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or ( _:TRF028Branch1 _:TRF028Branch2 ) ;
    sh:message "If alternative Ke or RCH evidence is used, the ship must provide approved evidence, a non-revoked approval state, and the corresponding quantity value." .

_:TRF028Branch1
    sh:property _:TRF028EvidenceProperty1 .

_:TRF028EvidenceProperty1
    sh:path nltl:hasEvidence ;
    sh:node _:TRF028EvidenceNode1 .

_:TRF028EvidenceNode1
    sh:not _:TRF028ExcludedEvidence .

_:TRF028ExcludedEvidence
    sh:or ( _:TRF028AlternativeEvidence1 _:TRF028ModelEvidence1 ) .

_:TRF028AlternativeEvidence1
    sh:class nltl:alternativeCalculationEvidence .

_:TRF028ModelEvidence1
    sh:class nltl:modelTestEvidence .

_:TRF028Branch2
    sh:property _:TRF028EvidenceProperty2 ;
    sh:property _:TRF028ApprovalStatusProperty ;
    sh:property _:TRF028RevocationStatusProperty ;
    sh:or ( _:TRF028KeBranch _:TRF028RchBranch ) .

_:TRF028EvidenceProperty2
    sh:path nltl:hasEvidence ;
    sh:minCount 1 ;
    sh:node _:TRF028EvidenceNode2 .

_:TRF028EvidenceNode2
    sh:class nltl:evidenceArtifact ;
    sh:or ( _:TRF028AlternativeEvidence2 _:TRF028ModelEvidence2 ) .

_:TRF028AlternativeEvidence2
    sh:class nltl:alternativeCalculationEvidence .

_:TRF028ModelEvidence2
    sh:class nltl:modelTestEvidence .

_:TRF028ApprovalStatusProperty
    sh:path nltl:approvalStatus ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:minCount 1 ;
    sh:maxCount 1 .

_:TRF028RevocationStatusProperty
    sh:path nltl:approvalRevocationStatus ;
    sh:in ( nltl:evidenceStateApproved ) ;
    sh:minCount 1 ;
    sh:maxCount 1 .

_:TRF028KeBranch
    sh:property _:TRF028KeProperty .

_:TRF028KeProperty
    sh:path nltl:engineOutputCoefficientKe ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <urn:nltl:generated-shape:TRF_028_QuantityValueShape> .

_:TRF028RchBranch
    sh:property _:TRF028RchProperty .

_:TRF028RchProperty
    sh:path nltl:brashIceChannelResistanceRch ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <urn:nltl:generated-shape:TRF_028_ForceQuantityValueShape> .
