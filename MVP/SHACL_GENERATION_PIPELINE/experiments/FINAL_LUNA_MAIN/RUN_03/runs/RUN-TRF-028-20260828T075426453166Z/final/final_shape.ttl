@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF028_KeResult a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:maxCount 1 ;
        sh:minCount 1
    ] .

gen:TRF028_RchResult a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N> ;
        sh:maxCount 1 ;
        sh:minCount 1
    ] .

gen:TRF028_KeOnlyResults a sh:NodeShape ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:node gen:TRF028_KeResult ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceRch ;
        sh:maxCount 0
    ] .

gen:TRF028_RchOnlyResults a sh:NodeShape ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceRch ;
        sh:node gen:TRF028_RchResult ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF028_AlternativeCalculationEvidence a sh:NodeShape ;
    sh:class nltl:alternativeCalculationEvidence .

gen:TRF028_ModelTestEvidence a sh:NodeShape ;
    sh:class nltl:modelTestEvidence .

gen:TRF028_AlternativeCalculationBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:node gen:TRF028_AlternativeCalculationEvidence ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [ sh:node gen:TRF028_KeOnlyResults ]
        [ sh:node gen:TRF028_RchOnlyResults ]
    ) .

gen:TRF028_ModelTestBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:node gen:TRF028_ModelTestEvidence ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [ sh:node gen:TRF028_KeOnlyResults ]
        [ sh:node gen:TRF028_RchOnlyResults ]
    ) .

gen:TRF028_OrdinaryValuesBranch a sh:NodeShape ;
    sh:not [
        sh:property [
            sh:path nltl:hasEvidence ;
            sh:node [
                sh:or (
                    [ sh:class nltl:alternativeCalculationEvidence ]
                    [ sh:class nltl:modelTestEvidence ]
                )
            ]
        ]
    ] .

gen:TRF028_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [ sh:node gen:TRF028_OrdinaryValuesBranch ]
        [ sh:node gen:TRF028_AlternativeCalculationBranch ]
        [ sh:node gen:TRF028_ModelTestBranch ]
    ) .
