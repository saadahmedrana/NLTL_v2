@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-029_DirectAnalysisConditionalShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "directAnalysisUsed must be recorded to select the applicable procedure branch."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-029_DirectAnalysisNotUsedBranch>
        <urn:nltl:generated-shape:TRF-029_DirectAnalysisUsedBranch>
    ) .

<urn:nltl:generated-shape:TRF-029_DirectAnalysisNotUsedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:TRF-029_DirectAnalysisUsedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:prescribedProcedureApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "When direct analysis is used, prescribedProcedureApplicability must be false."
    ] ;
    sh:property [
        sh:path nltl:directAnalysisApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "When direct analysis is used, its approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:structuralArrangement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When direct analysis is used, the structural arrangement must be recorded."
    ] .
