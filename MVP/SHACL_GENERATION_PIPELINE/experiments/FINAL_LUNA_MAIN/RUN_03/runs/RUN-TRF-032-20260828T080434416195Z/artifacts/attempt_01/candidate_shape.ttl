@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF-032-ScantlingSelectionShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:regulationRequiredScantling ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:classificationSocietyRequiredScantling ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "When the regulation scantling is less than the classification society scantling, a valid selected design scantling equal to the classification society scantling is required." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false .
    $this nltl:regulationRequiredScantling ?regulationQuantity .
    ?regulationQuantity qudt:numericValue ?regulationValue .
    $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
    ?classificationQuantity qudt:numericValue ?classificationValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER NOT EXISTS {
        $this nltl:selectedDesignScantling ?selectedQuantity .
        ?selectedQuantity a qudt:QuantityValue .
        ?selectedQuantity qudt:numericValue ?selectedValue .
        FILTER (datatype(?selectedValue) = xsd:decimal)
    }
}
"""
            ] ;
            sh:sparql [
                sh:message "The selected design scantling must equal the classification society required scantling when the regulation scantling is lower." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false .
    $this nltl:regulationRequiredScantling ?regulationQuantity .
    ?regulationQuantity qudt:numericValue ?regulationValue .
    $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
    ?classificationQuantity qudt:numericValue ?classificationValue .
    $this nltl:selectedDesignScantling ?selectedQuantity .
    ?selectedQuantity a qudt:QuantityValue .
    ?selectedQuantity qudt:numericValue ?selectedValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER (?selectedValue != ?classificationValue)
}
"""
            ]
        ]
    ) .
