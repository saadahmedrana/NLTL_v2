@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF034EffectiveMemberCrossSectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The effective member cross section must have one section modulus expressed in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The effective member cross section must have one shear area expressed in square metres."
    ] ;
    sh:property [
        sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Any classification society section-property calculation evidence must be an evidence artifact."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasEffectiveMemberCrossSection
        ] ;
        sh:class nltl:hullStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:memberNormalToPlating ;
                sh:datatype xsd:boolean ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The effective member cross section must be linked from a hull structure with member-normal-to-plating information."
    ] ;
    sh:sparql [
        sh:message "When the member is not normal to the plating, classification society section-property calculation evidence is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?structure nltl:hasEffectiveMemberCrossSection $this ;
                           nltl:memberNormalToPlating ?normal .
                FILTER ( ?normal = false || ?normal = "false"^^xsd:boolean )
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] .
