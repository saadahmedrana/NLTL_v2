@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-036> a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:message "The ship linked to the ice-class design parameter set must have a permitted Finnish-Swedish ice class." ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:message "Level ice thickness must be a metre quantity." ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:message "Design ice load height must be a metre quantity." ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-036-IA-Super>
        <urn:nltl:generated-shape:TRF-036-IA>
        <urn:nltl:generated-shape:TRF-036-IB>
        <urn:nltl:generated-shape:TRF-036-IC>
    ) ;
    sh:sparql [
        sh:message "Level ice thickness and design ice load height do not satisfy the Table 4-1 values for the linked ship's ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasIceClassDesignParameterSet $this ;
                      nltl:iceClass ?class .
                $this nltl:levelIceThickness ?levelQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity .
                ?levelQuantity qudt:numericValue ?levelValue ;
                               qudt:unit unit:M .
                ?heightQuantity qudt:numericValue ?heightValue ;
                                qudt:unit unit:M .
                FILTER (
                    (
                        ?class = nltl:iceClassIaSuper &&
                        (?levelValue > 1.0 || ?heightValue != 0.35)
                    ) ||
                    (
                        ?class = nltl:iceClassIa &&
                        (?levelValue > 0.8 || ?heightValue != 0.30)
                    ) ||
                    (
                        ?class = nltl:iceClassIb &&
                        (?levelValue > 0.6 || ?heightValue != 0.25)
                    ) ||
                    (
                        ?class = nltl:iceClassIc &&
                        (?levelValue > 0.4 || ?heightValue != 0.22)
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-036-IA-Super> a sh:NodeShape ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive "1.0"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "0.35"^^xsd:decimal ;
                sh:maxInclusive "0.35"^^xsd:decimal
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-036-IA> a sh:NodeShape ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:hasValue nltl:iceClassIa ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive "0.8"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "0.30"^^xsd:decimal ;
                sh:maxInclusive "0.30"^^xsd:decimal
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-036-IB> a sh:NodeShape ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:hasValue nltl:iceClassIb ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive "0.6"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "0.25"^^xsd:decimal ;
                sh:maxInclusive "0.25"^^xsd:decimal
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-036-IC> a sh:NodeShape ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:hasValue nltl:iceClassIc ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive "0.4"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "0.22"^^xsd:decimal ;
                sh:maxInclusive "0.22"^^xsd:decimal
            ]
        ]
    ] .
