@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:DesignIceLoadHeightQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:SpacingQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:LongitudinalPlatingFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:CorrosionAbrasionAdditionQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:NormalCorrosionBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 2.0 ;
                sh:maxInclusive 2.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

nltlgen:ApprovedCoatedLowerCorrosionBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxExclusive 2.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:specialSurfaceCoatingMaintained ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:class nltl:evidenceState
    ] .

nltlgen:TRF042PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:DesignIceLoadHeightQuantityShape
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:SpacingQuantityShape
    ] ;
    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:LongitudinalPlatingFactorQuantityShape
    ] ;
    sh:or (
        nltlgen:NormalCorrosionBranch
        nltlgen:ApprovedCoatedLowerCorrosionBranch
    ) ;
    sh:sparql [
        sh:message "The longitudinal plating factor must be calculated from 0 < designIceLoadHeight/spacing <= 1.8 and must match the applicable piecewise formula within max(1e-6*ABS(expected),1e-12)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:spacing ?sNode .
                    ?sNode qudt:numericValue ?s .
                    FILTER (datatype(?s) = xsd:decimal)
                    FILTER (?s = 0)
                }
                UNION
                {
                    $this nltl:designIceLoadHeight ?hNode ;
                          nltl:spacing ?sNode .
                    ?hNode qudt:numericValue ?h .
                    ?sNode qudt:numericValue ?s .
                    FILTER (datatype(?h) = xsd:decimal)
                    FILTER (datatype(?s) = xsd:decimal)
                    FILTER (?s != 0)
                    BIND (?h / ?s AS ?ratio)
                    FILTER (?ratio <= 0 || ?ratio > 1.8)
                }
                UNION
                {
                    $this nltl:designIceLoadHeight ?hNode ;
                          nltl:spacing ?sNode ;
                          nltl:longitudinalPlatingFactorF2 ?f2Node .
                    ?hNode qudt:numericValue ?h .
                    ?sNode qudt:numericValue ?s .
                    ?f2Node qudt:numericValue ?actual .
                    FILTER (datatype(?h) = xsd:decimal)
                    FILTER (datatype(?s) = xsd:decimal)
                    FILTER (datatype(?actual) = xsd:decimal)
                    FILTER (?s != 0)
                    BIND (?h / ?s AS ?ratio)
                    FILTER (?ratio > 0 && ?ratio <= 1.8)
                    BIND (
                        IF(
                            ?ratio <= 1,
                            0.4 / ?ratio + 0.6,
                            1.4 - 0.4 * ?ratio
                        ) AS ?expected
                    )
                    BIND (
                        IF(
                            1e-6 * ABS(?expected) > 1e-12,
                            1e-6 * ABS(?expected),
                            1e-12
                        ) AS ?tolerance
                    )
                    FILTER (ABS(?actual - ?expected) > ?tolerance)
                }
            }
        """
    ] .
