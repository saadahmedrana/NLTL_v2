@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF046UpperEndAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame, nltl:intermediateIceFrame ;
    sh:property [
        sh:path (
            nltl:hasStrengthenedPart
            nltl:hasUpperEnd
            nltl:hasAttachedSupportingStructure
        ) ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class nltl:deckStructure ]
            [ sh:class nltl:tankBoundaryPlating ]
            [ sh:class nltl:iceStringer ]
        ) ;
        sh:message "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] .
