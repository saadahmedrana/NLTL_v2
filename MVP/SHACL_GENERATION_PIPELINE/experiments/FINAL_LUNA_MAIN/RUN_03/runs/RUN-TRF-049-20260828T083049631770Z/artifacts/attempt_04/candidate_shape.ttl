@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF049_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:minCount 1
            ] ;
            sh:sparql [
                sh:message "Each in-ice frame attachment must be effective and must identify a supporting structure linked from the frame." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasFrameAttachment ?attachment .
                        FILTER NOT EXISTS {
                            ?attachment a nltl:frameAttachment ;
                                nltl:effectiveAttachmentConfirmed true ;
                                nltl:hasAttachedSupportingStructure ?structure .
                            $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?structure .
                            ?structure a nltl:supportingStructure .
                        }
                    }
                """
            ] ;
            sh:sparql [
                sh:message "A frame running through a supporting structure must have a web plate side count of exactly 2." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:passesThroughSupportingStructure true .
                        FILTER NOT EXISTS {
                            $this nltl:webPlateConnectionSideCount 2 .
                        }
                    }
                """
            ] ;
            sh:sparql [
                sh:message "A longitudinal frame must have a bracketed attachment to every linked supporting web frame or bulkhead." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this a nltl:longitudinalFrame ;
                            nltl:hasFrameAttachment ?attachment .
                        $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?structure .
                        ?structure a nltl:supportingStructure .
                        FILTER NOT EXISTS {
                            ?structure nltl:hasSupportingStructureAttachment ?attachment .
                            ?attachment nltl:hasAttachedSupportingStructure ?structure ;
                                nltl:hasConnectionBracket ?bracket .
                            ?bracket a nltl:connectionBracket .
                        }
                    }
                """
            ] ;
            sh:sparql [
                sh:message "A terminating transverse frame must have either a connection bracket or a similar attachment construction." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this a nltl:transverseFrame ;
                            nltl:terminatesAtDeckOrIceStringer true ;
                            nltl:hasFrameAttachment ?attachment .
                        FILTER NOT EXISTS {
                            {
                                ?attachment nltl:hasConnectionBracket ?bracket .
                                ?bracket a nltl:connectionBracket .
                            }
                            UNION
                            {
                                ?attachment nltl:similarAttachmentConstructionPresent true .
                            }
                        }
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF049_TransverseFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF049_SupportingStructureShape>
    a sh:NodeShape ;
    sh:targetClass nltl:supportingStructure ;
    sh:sparql [
        sh:message "Each supporting structure linked from an applicable frame must link to the corresponding frame attachment, and that attachment must point back to the same supporting structure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?frame nltl:withinIceStrengthenedArea true ;
                    nltl:hasFrameAttachment ?attachment .
                ?frame (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) $this .
                FILTER NOT EXISTS {
                    $this nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment a nltl:frameAttachment ;
                        nltl:hasAttachedSupportingStructure $this .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF049_FrameAttachmentShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frameAttachment ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF049_ConnectionBracketShape>
    a sh:NodeShape ;
    sh:targetClass nltl:connectionBracket ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MilliM
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF049_FrameWebThicknessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MilliM
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "An installed connection bracket must be at least as thick as the web plate of its applicable frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                    nltl:hasFrameAttachment ?attachment ;
                    nltl:frameWebThickness ?frameThickness .
                ?attachment nltl:hasAttachedSupportingStructure ?structure ;
                    nltl:hasConnectionBracket ?bracket .
                $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?structure .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?frameThickness qudt:numericValue ?frameValue .
                ?bracketThickness qudt:numericValue ?bracketValue .
                FILTER (?bracketValue < ?frameValue)
            }
        """
    ] .
