@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-052> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        <urn:nltl:generated-shape:TRF-052-normal-arrangement>
        <urn:nltl:generated-shape:TRF-052-equivalent-arrangement>
    ) .

<urn:nltl:generated-shape:TRF-052-equivalent-arrangement> a sh:NodeShape ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An alternative support arrangement requires demonstrated equivalent support by direct calculation."
    ] .

<urn:nltl:generated-shape:TRF-052-normal-arrangement> a sh:NodeShape ;
    sh:and (
        <urn:nltl:generated-shape:TRF-052-tripping-applicability>
        <urn:nltl:generated-shape:TRF-052-span-scope>
    ) .

<urn:nltl:generated-shape:TRF-052-tripping-applicability> a sh:NodeShape ;
    sh:or (
        <urn:nltl:generated-shape:TRF-052-asymmetrical>
        <urn:nltl:generated-shape:TRF-052-right-angle>
        <urn:nltl:generated-shape:TRF-052-non-right-angle>
    ) .

<urn:nltl:generated-shape:TRF-052-asymmetrical> a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 0 ;
                sh:maxInclusive 1300
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "For an asymmetrical frame, antitripping support spacing must not exceed 1300 mm."
    ] .

<urn:nltl:generated-shape:TRF-052-right-angle> a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 90
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG>
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-052-non-right-angle> a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxExclusive 90
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 0 ;
                sh:maxInclusive 1300
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "For a frame web angle below 90 degrees, antitripping support spacing must not exceed 1300 mm."
    ] .

<urn:nltl:generated-shape:TRF-052-span-scope> a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-052-span-over-four>
        <urn:nltl:generated-shape:TRF-052-span-up-to-four>
    ) .

<urn:nltl:generated-shape:TRF-052-span-over-four> a sh:NodeShape ;
    sh:sparql [
        sh:message "For frames with spans greater than 4 m, the required all-region support scope must be established by the supplied support-region model." ;
        sh:select """
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#frameSpan> ?spanQuantity .
                ?spanQuantity qudt:numericValue ?spanValue .
                FILTER (datatype(?spanValue) = xsd:decimal)
                FILTER (?spanValue > 4)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-052-span-up-to-four> a sh:NodeShape ;
    sh:or (
        <urn:nltl:generated-shape:TRF-052-ia-super>
        <urn:nltl:generated-shape:TRF-052-ia>
        <urn:nltl:generated-shape:TRF-052-ib-ic>
        <urn:nltl:generated-shape:TRF-052-ii-iii>
    ) ;
    sh:sparql [
        sh:message "For frames with spans less than or equal to 4 m, the applicable ice-class support scope must be established." ;
        sh:select """
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#frameSpan> ?spanQuantity .
                ?spanQuantity qudt:numericValue ?spanValue .
                FILTER (datatype(?spanValue) = xsd:decimal)
                FILTER (?spanValue <= 4)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-052-ia-super> a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:hasValue nltl:iceClassIaSuper
    ] .

<urn:nltl:generated-shape:TRF-052-ia> a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:hasValue nltl:iceClassIa
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:minCount 1 ;
        sh:hasValue nltl:bowRegion
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:minCount 1 ;
        sh:hasValue nltl:midbodyRegion
    ] .

<urn:nltl:generated-shape:TRF-052-ib-ic> a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:in ( nltl:iceClassIb nltl:iceClassIc )
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:minCount 1 ;
        sh:hasValue nltl:bowRegion
    ] .

<urn:nltl:generated-shape:TRF-052-ii-iii> a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:in ( nltl:iceClassIi nltl:iceClassIii )
    ] .
