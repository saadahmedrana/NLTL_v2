@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The detached-strut applicability state must be recorded as one boolean value."
    ] ;
    sh:or (
        gen:TRF064DetachedStrutBranch
        gen:TRF064NormalEnclosureBranch
    ) .

gen:TRF064DetachedStrutBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:minCount 1 ;
        sh:node gen:TRF064DetachedStrutStructureShape ;
        sh:message "A detached strut structure with design, hull-attachment, and strength evidence is required when detached struts are used."
    ] .

gen:TRF064DetachedStrutStructureShape
    a sh:NodeShape ;
    sh:class nltl:detachedStrutStructure ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:node gen:TRF064StrutDesignEvidenceShape ;
        sh:message "Detached strut design evidence is required."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:node gen:TRF064StrutHullAttachmentEvidenceShape ;
        sh:message "Detached strut hull-attachment evidence is required."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:node gen:TRF064StrutStrengthEvidenceShape ;
        sh:message "Detached strut strength evidence is required."
    ] .

gen:TRF064StrutDesignEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:strutDesignEvidence .

gen:TRF064StrutHullAttachmentEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:strutHullAttachmentEvidence .

gen:TRF064StrutStrengthEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:strutStrengthEvidence .

gen:TRF064NormalEnclosureBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node gen:TRF064SidePropellerShaftingShape ;
        sh:message "Each recorded side-propeller shafting assembly must be enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node gen:TRF064SternTubeShape ;
        sh:message "Each recorded side-propeller stern tube must be enclosed within plated bossing."
    ] .

gen:TRF064SidePropellerShaftingShape
    a sh:NodeShape ;
    sh:class nltl:sidePropellerShaftingAssembly ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:node gen:TRF064PlatedBossingShape ;
        sh:message "The side-propeller shafting must have plated bossing enclosure."
    ] .

gen:TRF064SternTubeShape
    a sh:NodeShape ;
    sh:class nltl:sternTube ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:node gen:TRF064PlatedBossingShape ;
        sh:message "The stern tube must have plated bossing enclosure."
    ] .

gen:TRF064PlatedBossingShape
    a sh:NodeShape ;
    sh:class nltl:platedBossingStructure .
