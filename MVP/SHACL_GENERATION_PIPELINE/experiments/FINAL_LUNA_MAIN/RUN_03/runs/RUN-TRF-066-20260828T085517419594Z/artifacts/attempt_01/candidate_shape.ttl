@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-066-ArrangementIceKnifeShape>
    a sh:NodeShape ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue nltl:iceKnife ;
        sh:minCount 1 ;
        sh:message "The rudder protection arrangement shall be an ice knife."
    ] ;
    sh:property [
        sh:path nltl:extendsBelowLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice knife shall extend below the lower ice waterline."
    ] .

<urn:nltl:generated-shape:TRF-066-EquivalentMeansShape>
    a sh:NodeShape ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue nltl:equivalentRudderProtectionMeans ;
        sh:minCount 1 ;
        sh:message "An equivalent rudder protection means shall be provided when an ice knife is not practicable."
    ] .

<urn:nltl:generated-shape:TRF-066-IceKnifeBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( nltl:iceClassIa nltl:iceClassIaSuper )
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-066-ArrangementIceKnifeShape> ;
        sh:message "For ice class IA or IA Super, a practicable ice knife extending below the lower ice waterline shall protect the rudder."
    ] .

<urn:nltl:generated-shape:TRF-066-EquivalentBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( nltl:iceClassIa nltl:iceClassIaSuper )
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-066-EquivalentMeansShape> ;
        sh:message "For ice class IA or IA Super, an equivalent rudder protection means shall be provided when an ice knife is not practicable."
    ] .

<urn:nltl:generated-shape:TRF-066-NonApplicableBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

<urn:nltl:generated-shape:TRF-066-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:TRF-066-IceKnifeBranchShape>
        <urn:nltl:generated-shape:TRF-066-EquivalentBranchShape>
        <urn:nltl:generated-shape:TRF-066-NonApplicableBranchShape>
    ) .
