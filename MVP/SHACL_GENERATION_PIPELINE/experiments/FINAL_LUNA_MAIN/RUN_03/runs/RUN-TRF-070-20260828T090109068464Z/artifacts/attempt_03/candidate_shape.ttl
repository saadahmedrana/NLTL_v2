@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-070-ForceQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-070-PressureQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-070-DesignConditionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:designCondition ;
    sh:property [
        sh:path nltl:designConditionExpectedLoad ;
        sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each design condition must provide the expected thruster-body ice load in kN."
    ] ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each design condition must identify whether it represents normal operational conditions."
    ] .

<urn:nltl:generated-shape:TRF-070-ExtremeDesignConditionShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:designConditionLocalStrengthCapacity ;
        sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An extreme-load design condition must provide the externally assessed local-strength capacity in kN."
    ] .

<urn:nltl:generated-shape:TRF-070-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:in ( "azimuthing" "fixed" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify an azimuthing or fixed thruster type."
    ] ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify that the thruster is for main propulsion."
    ] ;
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the propeller/ice interaction load in kN."
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:node <urn:nltl:generated-shape:TRF-070-ForceQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the thruster-body/ice interaction load in kN."
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node <urn:nltl:generated-shape:TRF-070-PressureQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the local ice pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:class nltl:designCondition ;
        sh:node <urn:nltl:generated-shape:TRF-070-DesignConditionShape> ;
        sh:minCount 1 ;
        sh:message "The ship must provide its linked design condition."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extremeLoad ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:extremeLoad ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyLocalStrength ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "For an extreme-load design, the thruster-body local-strength assessment must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:node <urn:nltl:generated-shape:TRF-070-ExtremeDesignConditionShape> ;
                sh:minCount 1
            ]
        ]
    ) .
