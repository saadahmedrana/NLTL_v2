@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF075_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:minCount 1 ;
        sh:node gen:TRF075_LoadCaseShape ;
        sh:message "Each linked propeller blade load case must be structurally complete and select exactly one blade force."
    ] .

gen:TRF075_LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseBlade ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:propellerBlade
        ] ;
        sh:message "A propeller blade load case must link to its assessed propeller blade."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseIceBlock ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceBlock
        ] ;
        sh:message "A propeller blade load case must link to the involved ice block."
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:backwardBladeForce ;
                sh:minCount 1 ;
                sh:node gen:TRF075_ForceQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:forwardBladeForce ;
                sh:minCount 1 ;
                sh:node gen:TRF075_ForceQuantityShape
            ]
        ]
    ) .

gen:TRF075_ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .
