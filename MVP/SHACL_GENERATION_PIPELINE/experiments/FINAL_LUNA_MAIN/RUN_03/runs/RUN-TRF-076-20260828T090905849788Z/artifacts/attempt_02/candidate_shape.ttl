@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF076LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer
    ] .

gen:TRF076Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gen:TRF076LoadCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "CP"
            ] ;
            sh:sparql [
                sh:message "CP propellers must cover load cases 1 through 4." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c1 .
      ?c1 nltl:propellerBladeLoadCaseNumber ?n1 .
      FILTER (?n1 = 1)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c2 .
      ?c2 nltl:propellerBladeLoadCaseNumber ?n2 .
      FILTER (?n2 = 2)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c3 .
      ?c3 nltl:propellerBladeLoadCaseNumber ?n3 .
      FILTER (?n3 = 3)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c4 .
      ?c4 nltl:propellerBladeLoadCaseNumber ?n4 .
      FILTER (?n4 = 4)
    }
  )
}
"""
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "FP"
            ] ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ] ;
            sh:sparql [
                sh:message "Non-reversing FP propellers must cover load cases 1 through 4." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c1 .
      ?c1 nltl:propellerBladeLoadCaseNumber ?n1 .
      FILTER (?n1 = 1)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c2 .
      ?c2 nltl:propellerBladeLoadCaseNumber ?n2 .
      FILTER (?n2 = 2)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c3 .
      ?c3 nltl:propellerBladeLoadCaseNumber ?n3 .
      FILTER (?n3 = 3)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c4 .
      ?c4 nltl:propellerBladeLoadCaseNumber ?n4 .
      FILTER (?n4 = 4)
    }
  )
}
"""
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "FP"
            ] ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:sparql [
                sh:message "Reversing FP propellers must cover load cases 1 through 5." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c1 .
      ?c1 nltl:propellerBladeLoadCaseNumber ?n1 .
      FILTER (?n1 = 1)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c2 .
      ?c2 nltl:propellerBladeLoadCaseNumber ?n2 .
      FILTER (?n2 = 2)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c3 .
      ?c3 nltl:propellerBladeLoadCaseNumber ?n3 .
      FILTER (?n3 = 3)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c4 .
      ?c4 nltl:propellerBladeLoadCaseNumber ?n4 .
      FILTER (?n4 = 4)
    } ||
    NOT EXISTS {
      $this nltl:hasPropellerBladeLoadCase ?c5 .
      ?c5 nltl:propellerBladeLoadCaseNumber ?n5 .
      FILTER (?n5 = 5)
    }
  )
}
"""
            ]
        ]
        [
            sh:sparql [
                sh:message "Propeller types other than CP and FP are outside this load-case requirement." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:propellerType ?type .
  FILTER (STR(?type) = "CP" || STR(?type) = "FP")
}
"""
            ]
        ]
    ) .
