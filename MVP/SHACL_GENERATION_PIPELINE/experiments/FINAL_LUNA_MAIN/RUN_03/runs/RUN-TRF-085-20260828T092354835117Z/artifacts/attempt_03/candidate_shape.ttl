@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF085Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bollardPropellerSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PropellerSpeedQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:propellerDiameter ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PropellerDiameterQuantityShape
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF085TableLookupCaseShape
            ] ;
            sh:sparql [
                sh:message "When bollard propeller speed is unknown, the lookup case must use the ship's propeller diameter and produce its bollard MCR propeller speed." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?diameter ;
                              nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed ;
                              nltl:hasTableLookupCase ?case .
                        ?case nltl:lookupInputQuantity ?input ;
                              nltl:lookupResultQuantity ?result .
                        ?diameter qudt:numericValue ?diameterValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?input qudt:numericValue ?inputValue ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?speed qudt:numericValue ?speedValue ;
                               qudt:unit <http://qudt.org/vocab/unit/REV-PER-MIN> .
                        ?result qudt:numericValue ?resultValue ;
                                qudt:unit <http://qudt.org/vocab/unit/REV-PER-MIN> .
                        FILTER (
                            xsd:decimal(?inputValue) != xsd:decimal(?diameterValue) ||
                            xsd:decimal(?resultValue) != xsd:decimal(?speedValue)
                        )
                    }
                """
            ]
        ]
    ) .

gen:PropellerDiameterQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PropellerSpeedQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:REV-PER-MIN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF085TableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:lookupInputQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PropellerDiameterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:lookupResultQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PropellerSpeedQuantityShape
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash9
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] .
