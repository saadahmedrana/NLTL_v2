@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF086Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:datatype xsd:string ;
                sh:hasValue "CP" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrBollard ;
                sh:node gen:TRF086MetreDecimalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:datatype xsd:string ;
                sh:hasValue "CP" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrBollard ;
                sh:node gen:TRF086MetreDecimalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrFreeRunning ;
                sh:node gen:TRF086MetreDecimalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For a CP propeller with unknown pitch value, bollard pitch must equal 0.7 times free-running pitch within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?bollardQuantity .
                            ?bollardQuantity qudt:numericValue ?bollardValue .
                            $this nltl:propellerPitchAtMcrFreeRunning ?freeQuantity .
                            ?freeQuantity qudt:numericValue ?freeValue .
                            BIND(0.7 * ?freeValue AS ?expectedValue)
                            FILTER(
                                (
                                    ?expectedValue >= 0.001 &&
                                    ?bollardValue >= ?expectedValue * (1.0 - 0.000001) &&
                                    ?bollardValue <= ?expectedValue * (1.0 + 0.000001)
                                )
                                ||
                                (
                                    ?expectedValue < 0.001 &&
                                    ?bollardValue >= ?expectedValue - 0.000001 &&
                                    ?bollardValue <= ?expectedValue + 0.000001
                                )
                            )
                        }
                    }
                """
            ]
        ]
    ] .

gen:TRF086MetreDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
