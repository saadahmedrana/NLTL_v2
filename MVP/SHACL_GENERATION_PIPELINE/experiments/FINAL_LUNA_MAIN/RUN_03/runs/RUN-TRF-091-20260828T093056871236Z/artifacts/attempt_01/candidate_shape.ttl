@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:message "A ship shall identify the ice milling sequence case."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node gen:TRF091PropulsionLoadCaseShape ;
        sh:message "A ship shall identify a propulsion load case for the required strength evaluation."
    ] .

gen:TRF091PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in ( nltl:propulsionLineStrengthEvaluationPurpose ) ;
        sh:message "The propulsion load case shall be designated for propulsion line strength evaluation and not for stalling analysis."
    ] ;
    sh:not [
        sh:property [
            sh:path nltl:loadCasePurpose ;
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ]
    ] .
