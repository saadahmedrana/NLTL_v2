@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF101Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node gen:PropellerDiameterQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A propeller diameter quantity in metres is required."
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:node gen:BladeTipOffsetQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A blade tip offset quantity in metres is required."
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:node gen:BladeFailureLoadCase ;
        sh:minCount 1 ;
        sh:message "A blade-failure load case with the specified application conditions is required."
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:approvedNonlinearBladeStressAnalysis ;
                sh:class nltl:approvalRecord ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An approved nonlinear blade stress analysis is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:bladeChordLengthAtWeakestSection ;
                sh:node gen:BladeChordQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
                sh:node gen:BladeThicknessQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeCylindricalRootRadius ;
                sh:node gen:BladeRootRadiusQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeMinimumYieldStrength ;
                sh:node gen:BladeYieldStrengthQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeUltimateTensileStrength ;
                sh:node gen:BladeUltimateStrengthQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeReferenceStrength1 ;
                sh:node gen:BladeReferenceStrengthQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeFailureUltimateLoad ;
                sh:node gen:BladeUltimateLoadQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "The reported reference strength and blade failure load must match the declared calculation within an expected-result-scaled tolerance of 1e-6, with a 1e-6 absolute fallback near zero." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?dNode ;
                              nltl:bladeChordLengthAtWeakestSection ?cNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                              nltl:bladeCylindricalRootRadius ?rNode ;
                              nltl:bladeMinimumYieldStrength ?yieldNode ;
                              nltl:bladeUltimateTensileStrength ?ultimateNode ;
                              nltl:bladeReferenceStrength1 ?refNode ;
                              nltl:bladeFailureUltimateLoad ?loadNode .
                        ?dNode qudt:numericValue ?d ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?cNode qudt:numericValue ?c ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?tNode qudt:numericValue ?t ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?rNode qudt:numericValue ?r ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?yieldNode qudt:numericValue ?yield ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        ?ultimateNode qudt:numericValue ?ultimate ;
                                      qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        ?refNode qudt:numericValue ?ref ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        ?loadNode qudt:numericValue ?load ;
                                 qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedRef)
                        BIND ((300 * ?c * ?t * ?t * ?expectedRef) /
                              ((0.8 * ?d) - (2 * ?r)) AS ?expectedLoad)
                        BIND (IF(?expectedRef >= 0.001,
                                 0.000001 * ?expectedRef,
                                 0.000001) AS ?refTolerance)
                        BIND (IF(?expectedLoad >= 0.001,
                                 0.000001 * ?expectedLoad,
                                 0.000001) AS ?loadTolerance)
                        FILTER (
                            (?ref < (?expectedRef - ?refTolerance)) ||
                            (?ref > (?expectedRef + ?refTolerance)) ||
                            (?load < (?expectedLoad - ?loadTolerance)) ||
                            (?load > (?expectedLoad + ?loadTolerance))
                        )
                    }
                """
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Blade failure status must be true exactly when blade tip offset exceeds 10 percent of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?tipNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeFailureStatus ?status .
                ?tipNode qudt:numericValue ?tip ;
                         qudt:unit <http://qudt.org/vocab/unit/M> .
                ?diameterNode qudt:numericValue ?diameter ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    (?tip > (0.10 * ?diameter) && ?status = false) ||
                    (?tip <= (0.10 * ?diameter) && ?status = true)
                )
            }
        """
    ] .

gen:BladeFailureLoadCase
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:node gen:BladeFailureRadiusRatioQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gen:PropellerDiameterQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeTipOffsetQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeChordQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeThicknessQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeRootRadiusQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeYieldStrengthQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeUltimateStrengthQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeReferenceStrengthQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeUltimateLoadQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeFailureRadiusRatioQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.8 ;
        sh:maxInclusive 0.8
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
