@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-101-QuantityValue-M>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-QuantityValue-Unitless>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-QuantityValue-KiloN>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-LoadCase>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-Unitless> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-Ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:node <urn:nltl:generated-shape:TRF-101-LoadCase> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "bladeFailureStatus must indicate failure exactly when bladeTipOffset exceeds 10 percent of propellerDiameter" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeTipOffset ?offsetNode ;
                      nltl:bladeFailureStatus ?status .
                ?diameterNode qudt:numericValue ?diameter .
                ?offsetNode qudt:numericValue ?offset .
                FILTER (
                    (?offset > (0.10 * ?diameter) && ?status != true) ||
                    (?offset <= (0.10 * ?diameter) && ?status != false)
                )
            }
        """
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:approvedNonlinearBladeStressAnalysis ;
                sh:class nltl:approvalRecord ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An approved nonlinear blade stress analysis is required when the calculation branch is not used"
            ]
        ]
        [
            sh:property [
                sh:path nltl:bladeChordLengthAtWeakestSection ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeCylindricalRootRadius ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeMinimumYieldStrength ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeUltimateTensileStrength ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeReferenceStrength1 ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeFailureUltimateLoad ;
                sh:node <urn:nltl:generated-shape:TRF-101-QuantityValue-KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "bladeReferenceStrength1 and bladeFailureUltimateLoad must satisfy the declared blade failure load calculation within an expected-result-scaled tolerance" ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter ?diameterNode ;
                              nltl:bladeChordLengthAtWeakestSection ?chordNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?thicknessNode ;
                              nltl:bladeCylindricalRootRadius ?radiusNode ;
                              nltl:bladeMinimumYieldStrength ?yieldNode ;
                              nltl:bladeUltimateTensileStrength ?ultimateNode ;
                              nltl:bladeReferenceStrength1 ?referenceNode ;
                              nltl:bladeFailureUltimateLoad ?loadNode ;
                              nltl:hasLoadCase ?case .
                        ?diameterNode qudt:numericValue ?diameter .
                        ?chordNode qudt:numericValue ?chord .
                        ?thicknessNode qudt:numericValue ?thickness .
                        ?radiusNode qudt:numericValue ?radius .
                        ?yieldNode qudt:numericValue ?yield .
                        ?ultimateNode qudt:numericValue ?ultimate .
                        ?referenceNode qudt:numericValue ?reference .
                        ?loadNode qudt:numericValue ?reportedLoad .
                        ?case nltl:bladeFailureLoadApplicationRadiusRatio ?ratioNode .
                        ?ratioNode qudt:numericValue ?ratio .
                        BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                        BIND ((300 * ?chord * ?thickness * ?thickness * ?expectedReference) /
                              ((?ratio * ?diameter) - (2 * ?radius)) AS ?expectedLoad)
                        BIND (IF(?expectedLoad > 0.000001,
                                 ?expectedLoad * 0.000001,
                                 0.000001) AS ?tolerance)
                        FILTER (
                            (?reference < (?expectedReference - ?tolerance) ||
                             ?reference > (?expectedReference + ?tolerance)) ||
                            (?reportedLoad < (?expectedLoad - ?tolerance) ||
                             ?reportedLoad > (?expectedLoad + ?tolerance))
                        )
                    }
                """
            ]
        ]
    ) .
