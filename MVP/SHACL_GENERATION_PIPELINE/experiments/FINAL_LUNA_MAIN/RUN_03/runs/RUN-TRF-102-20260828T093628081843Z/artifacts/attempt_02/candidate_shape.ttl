@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-102> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeExpandedAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantity>
    ] ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantity>
    ] ;
    sh:property [
        sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantity>
    ] ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:ForceQuantity>
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorqueFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantity>
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TorqueQuantity>
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TorqueQuantity>
    ] ;
    sh:sparql [
        sh:message "The reported spindle-torque factor and torque results must match the prescribed formula within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bladeExpandedAreaRatio ?earQuantity ;
                      nltl:propellerBladeCount ?z ;
                      nltl:leadingEdgeChordPortionAtZeroPointEightRadius ?leQuantity ;
                      nltl:trailingEdgeChordPortionAtZeroPointEightRadius ?teQuantity ;
                      nltl:extremeIceForce ?forceQuantity ;
                      nltl:bladeFailureSpindleTorqueFactor ?factorQuantity ;
                      nltl:bladeFailureSpindleTorque ?failureTorqueQuantity ;
                      nltl:maximumSpindleTorque ?maximumTorqueQuantity .

                ?earQuantity qudt:numericValue ?ear .
                ?leQuantity qudt:numericValue ?le .
                ?teQuantity qudt:numericValue ?te .
                ?forceQuantity qudt:numericValue ?force .
                ?factorQuantity qudt:numericValue ?reportedFactor .
                ?failureTorqueQuantity qudt:numericValue ?reportedFailureTorque .
                ?maximumTorqueQuantity qudt:numericValue ?reportedMaximumTorque .

                BIND ((4.0 * ?ear) / ?z AS ?ratio)
                BIND (0.7 * (1.0 - (?ratio * ?ratio * ?ratio)) AS ?uncappedFactor)
                BIND (IF(?uncappedFactor < 0.3, 0.3, ?uncappedFactor) AS ?expectedFactor)
                BIND (IF(?le > (0.8 * ?te), ?le, (0.8 * ?te)) AS ?chordTerm)
                BIND (?chordTerm * ?expectedFactor * ?force AS ?expectedTorque)

                FILTER (
                    ABS(?reportedFactor - ?expectedFactor) >
                    (0.000000001 + (0.000001 * ABS(?expectedFactor)))
                    ||
                    ABS(?reportedFailureTorque - ?expectedTorque) >
                    (0.000000001 + (0.000001 * ABS(?expectedTorque)))
                    ||
                    ABS(?reportedMaximumTorque - ?expectedTorque) >
                    (0.000000001 + (0.000001 * ABS(?expectedTorque)))
                )
            }
        """
    ] .

<urn:nltl:generated-shape:DimensionlessQuantity> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:LengthQuantity> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:ForceQuantity> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TorqueQuantity> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
