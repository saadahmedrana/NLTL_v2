@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-111> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class nltl:shaftLineLoadCaseTypeValue ;
                            sh:hasValue nltl:extremeOperationalLoadCase
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:componentYieldSafetyFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive 1.3
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class nltl:shaftLineLoadCaseTypeValue ;
                            sh:hasValue nltl:fatigueLoadCase
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:componentYieldSafetyFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive 1.5
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class nltl:shaftLineLoadCaseTypeValue ;
                            sh:hasValue nltl:bladeFailureLoadCase
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:componentYieldSafetyFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive 1.0
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            )
        ]
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:class nltl:shipComponent
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:class nltl:propellerShaftLineComponent
    ] ;
    sh:sparql [
        sh:message "Each linked propeller shaft-line component must have exactly one decimal, unitless fatigue safety factor of at least 1.5 when a fatigue load case is applicable." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:hasComponent ?c .
                ?this nltl:hasPropellerShaftLineComponent ?c .
                ?this nltl:hasPropulsionLoadCase ?lc .
                ?lc nltl:shaftLineLoadCaseType nltl:fatigueLoadCase .

                {
                    SELECT ?c
                           (COUNT(?q) AS ?qCount)
                           (COUNT(?n) AS ?nCount)
                           (COUNT(?u) AS ?uCount)
                           (SUM(IF(BOUND(?n) && datatype(?n) = xsd:decimal, 1, 0)) AS ?decimalCount)
                           (SUM(IF(BOUND(?u) && ?u = qudt:UNITLESS, 1, 0)) AS ?unitlessCount)
                           (SUM(IF(BOUND(?n) && datatype(?n) = xsd:decimal && ?n >= 1.5, 1, 0)) AS ?acceptableCount)
                    WHERE {
                        OPTIONAL {
                            ?c nltl:fatigueSafetyFactor ?q .
                            OPTIONAL { ?q qudt:numericValue ?n . }
                            OPTIONAL { ?q qudt:unit ?u . }
                        }
                    }
                    GROUP BY ?c
                }

                FILTER (
                    ?qCount != 1 ||
                    ?nCount != 1 ||
                    ?uCount != 1 ||
                    ?decimalCount != 1 ||
                    ?unitlessCount != 1 ||
                    ?acceptableCount != 1
                )
            }
        """
    ] .
