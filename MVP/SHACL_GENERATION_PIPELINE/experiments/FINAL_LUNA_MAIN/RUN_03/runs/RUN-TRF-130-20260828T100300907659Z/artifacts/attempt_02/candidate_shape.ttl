@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF130_QuantityValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130_PowerQuantityShape a sh:NodeShape ;
    sh:node nltl:TRF130_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130_AreaQuantityShape a sh:NodeShape ;
    sh:node nltl:TRF130_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130_VolumeQuantityShape a sh:NodeShape ;
    sh:node nltl:TRF130_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130_RatioQuantityShape a sh:NodeShape ;
    sh:node nltl:TRF130_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minInclusive "4"^^xsd:decimal
    ] .

nltl:TRF130_ShipInputShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_PowerQuantityShape
    ] ;
    sh:property [
        sh:path nltl:totalRelevantEnginePower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_PowerQuantityShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:minCount 1 ;
                sh:node nltl:TRF130_StandardInletChestShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:minCount 2 ;
                sh:node nltl:TRF130_AlternativeInletChestShape
            ]
        ]
    ) .

nltl:TRF130_InletChestInputShape a sh:NodeShape ;
    sh:targetClass nltl:inletChest ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:nearCentrelineAndWellAftIfPossible ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceAccumulationSpaceAboveInlet ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_VolumeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_RatioQuantityShape
    ] .

nltl:TRF130_StandardInletChestShape a sh:NodeShape ;
    sh:node nltl:TRF130_InletChestInputShape ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130_VolumeQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The standard inlet chest volume shall be approximately total relevant engine power divided by 750, and its strainer open area shall be at least four times the inlet pipe area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:recommendedChestVolume ?recommendedNode .
                ?recommendedNode qudt:numericValue ?recommended .
                ?ship nltl:hasComponent $this ;
                      nltl:totalRelevantEnginePower ?powerNode .
                ?powerNode qudt:numericValue ?power .
                $this nltl:strainerOpenArea ?openNode ;
                      nltl:inletPipeArea ?pipeNode .
                ?openNode qudt:numericValue ?open .
                ?pipeNode qudt:numericValue ?pipe .
                BIND((?power / 750) AS ?expected)
                BIND((4 * ?pipe) AS ?minimumOpen)
                FILTER(
                    ABS(?recommended - ?expected) >
                    (0.000001 * IF(ABS(?expected) > 1, ABS(?expected), 1))
                    || ?open < ?minimumOpen
                )
            }
        """
    ] .

nltl:TRF130_AlternativeInletChestShape a sh:NodeShape ;
    sh:node nltl:TRF130_InletChestInputShape ;
    sh:property [
        sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
