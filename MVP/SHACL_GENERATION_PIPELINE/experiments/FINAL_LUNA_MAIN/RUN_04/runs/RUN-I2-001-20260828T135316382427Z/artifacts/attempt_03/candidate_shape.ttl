@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-001_ApplicabilityShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine UR I2 Rev.4 applicability." ;
        sh:or (
            [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2021-01-01"^^xsd:date ;
                sh:message "UR I2 Rev.4 applies to ships contracted for construction on or after 1 January 2021." 
            ]
            [
                sh:path nltl:constructionContractDate ;
                sh:maxExclusive "2021-01-01"^^xsd:date ;
                sh:message "Ships contracted for construction before 1 January 2021 are outside the UR I2 Rev.4 applicability date."
            ]
        )
    ] .
