@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_006_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "The ship's astern ice operation intent must be recorded as true when the aft section design basis is subject to the specified hull area requirements."
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "For astern ice operation, the aft section must use the Bow and Bow Intermediate hull area requirements as its design basis."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "For astern ice operation, the applicable hull area requirement set must be the Bow and Bow Intermediate hull area requirements."
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
    ) .
