@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ForceMegaNewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ForceKiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ShapeCoefficientQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.6"^^xsd:decimal ;
        sh:maxInclusive "0.6"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LoadPatchAspectRatioQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.3"^^xsd:decimal ;
        sh:maxInclusive "1.3"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ApplicableBowDesignForceShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable ship must record that its bulbous bow is present."
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:message "An applicable ship must have Polar Class PC6 or PC7."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:node gs:ForceMegaNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "The I2.3.2.1(iii) bow design force is required for an applicable ship."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:node gs:ForceMegaNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "The I2.3.2.1(iv) bow design force is required for an applicable ship."
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node gs:ShapeCoefficientQuantityShape ;
        sh:minCount 1 ;
        sh:message "The shape coefficient must be provided as 0.6 for the applicable calculation."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node gs:LoadPatchAspectRatioQuantityShape ;
        sh:minCount 1 ;
        sh:message "The load patch aspect ratio must be provided as 1.3 for the applicable calculation."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:node gs:ForceKiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "The bow design force is required for an applicable ship."
    ] ;
    sh:sparql [
        sh:message "The bow design force must equal the I2.3.2.1(iv) force within numerical tolerance and must not be less than the I2.3.2.1(iii) force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowDesignForce ?resultNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?partIiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?partIvNode .

                ?resultNode qudt:numericValue ?result ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?partIiiNode qudt:numericValue ?partIii ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?partIvNode qudt:numericValue ?partIv ;
                             qudt:unit <http://qudt.org/vocab/unit/MegaN> .

                BIND (?partIv * 1000 AS ?expectedResult)
                FILTER (
                    (?result < (?partIii * 1000)) ||
                    (ABS(?result - ?expectedResult) >
                        ((ABS(?expectedResult) * "0.000001"^^xsd:decimal) +
                         "0.000001"^^xsd:decimal))
                )
            }
        """
    ] .

gs:NonApplicableBulbousBowShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false
    ] .

gs:NonApplicablePolarClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
        ) ;
        sh:minCount 1
    ] .

gs:I2_011_BowDesignForceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:ApplicableBowDesignForceShape
        gs:NonApplicableBulbousBowShape
        gs:NonApplicablePolarClassShape
    ) .
