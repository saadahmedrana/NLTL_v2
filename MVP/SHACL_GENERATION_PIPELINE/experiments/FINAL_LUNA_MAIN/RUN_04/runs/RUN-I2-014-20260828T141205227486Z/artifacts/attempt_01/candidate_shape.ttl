@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must have one calculation evidence artifact."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report its midpoint position."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report its load patch aspect ratio."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:node gen:LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:node gen:LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the bow-region waterline length."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must be represented by four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gen:CaseShape ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:message "The ship must provide exactly four bow subregion calculation cases."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:node gen:LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The four bow subregion midpoints must be the midpoints of four equal-length subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lengthQuantity .
                ?lengthQuantity qudt:numericValue ?length .
                {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition ?midpointQuantity .
                    ?midpointQuantity qudt:numericValue ?midpoint .
                    FILTER (
                        ?midpoint != (?length / 8) &&
                        ?midpoint != (3 * ?length / 8) &&
                        ?midpoint != (5 * ?length / 8) &&
                        ?midpoint != (7 * ?length / 8)
                    )
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case1 .
                        ?case1 nltl:bowSubregionMidLengthPosition ?quantity1 .
                        ?quantity1 qudt:numericValue ?value1 .
                        FILTER (?value1 = (?length / 8))
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionMidLengthPosition ?quantity2 .
                        ?quantity2 qudt:numericValue ?value2 .
                        FILTER (?value2 = (3 * ?length / 8))
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case3 .
                        ?case3 nltl:bowSubregionMidLengthPosition ?quantity3 .
                        ?quantity3 qudt:numericValue ?value3 .
                        FILTER (?value3 = (5 * ?length / 8))
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case4 .
                        ?case4 nltl:bowSubregionMidLengthPosition ?quantity4 .
                        ?quantity4 qudt:numericValue ?value4 .
                        FILTER (?value4 = (7 * ?length / 8))
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must equal the maximum force reported for the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (?value > ?selected)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionCalculatedForce ?quantity2 .
                        ?quantity2 qudt:numericValue ?value2 .
                        FILTER (?value2 = ?selected)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must equal the maximum line load reported for the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedLineLoad ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (?value > ?selected)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionCalculatedLineLoad ?quantity2 .
                        ?quantity2 qudt:numericValue ?value2 .
                        FILTER (?value2 = ?selected)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must equal the maximum pressure reported for the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedPressure ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (?value > ?selected)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case2 .
                        ?case2 nltl:bowSubregionCalculatedPressure ?quantity2 .
                        ?quantity2 qudt:numericValue ?value2 .
                        FILTER (?value2 = ?selected)
                    }
                )
            }
        """
    ] .
