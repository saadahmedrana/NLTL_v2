@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_015_ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:property [
                sh:path nltl:bowFormApplicabilityClassification ;
                sh:class nltl:bowFormApplicabilityValue ;
                sh:hasValue nltl:i231vBowFormApplicability ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each bow subregion calculation case must identify the I2.3.1(v) bow-form applicability."
            ] ;
            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:node gen:I2_015_LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each applicable bow subregion calculation case must provide its mid-length position."
            ] ;
            sh:property [
                sh:path nltl:bowSubregionWaterlineAngle ;
                sh:node gen:I2_015_AngleQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each applicable bow subregion calculation case must provide its waterline angle."
            ] ;
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasBowSubregionCalculationCase ]
                    nltl:betaIPrime
                ) ;
                sh:node gen:I2_015_DimensionlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship associated with each applicable case must provide beta i prime."
            ] ;
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasBowSubregionCalculationCase ]
                    nltl:upperIceWaterlineLengthLUI
                ) ;
                sh:node gen:I2_015_LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship associated with each applicable case must provide the upper ice waterline length."
            ] ;
            sh:property [
                sh:path nltl:hasFailureClassFactorLookupCase ;
                sh:node [
                    sh:class nltl:tableLookupCase ;
                    sh:property [
                        sh:path nltl:flexuralFailureClassFactor ;
                        sh:node gen:I2_015_DimensionlessQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The failure-factor lookup case must provide the flexural failure class factor."
                    ] ;
                    sh:property [
                        sh:path nltl:crushingFailureClassFactor ;
                        sh:node gen:I2_015_DimensionlessQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The failure-factor lookup case must provide the crushing failure class factor."
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each applicable bow subregion calculation case must reference a failure-factor lookup case."
            ] ;
            sh:property [
                sh:path nltl:bowShapeCoefficient ;
                sh:node gen:I2_015_DimensionlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each applicable bow subregion calculation case must provide the externally computed bow shape coefficient."
            ]
        ]
    ] .

gen:I2_015_DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_015_LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_015_AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
