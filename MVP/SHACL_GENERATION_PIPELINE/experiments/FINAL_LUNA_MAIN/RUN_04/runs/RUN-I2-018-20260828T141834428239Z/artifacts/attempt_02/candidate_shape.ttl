@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:I2-018-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:class nltl:iceLoadPatch ;
        sh:minCount 1 ;
        sh:message "The ship must identify its design ice load patch."
    ] ;
    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:class nltl:peakPressureFactorLookupCase ;
        sh:minCount 1 ;
        sh:message "The ship must provide a peak pressure factor lookup case."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:message "The ship must provide the table lookup case used for the peak pressure factor."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceForce ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "averageIcePressure must equal iceForce converted from kN to MN divided by loadPatchHeight times loadPatchLength, within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:averageIcePressure ?averageQuantity ;
                      nltl:iceForce ?forceQuantity ;
                      nltl:loadPatchHeight ?heightQuantity ;
                      nltl:loadPatchLength ?lengthQuantity .

                ?averageQuantity qudt:numericValue ?reportedAverage .
                ?forceQuantity qudt:numericValue ?force .
                ?heightQuantity qudt:numericValue ?height .
                ?lengthQuantity qudt:numericValue ?length .

                BIND ((?force * 0.001) / (?height * ?length) AS ?expectedAverage)
                BIND (
                    IF (?expectedAverage > 0.000001,
                        ?expectedAverage * 0.000001,
                        0.000001)
                    AS ?tolerance
                )

                FILTER (
                    ?reportedAverage < (?expectedAverage - ?tolerance)
                    ||
                    ?reportedAverage > (?expectedAverage + ?tolerance)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-018-PeakLookupCaseShape>
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasPeakPressureFactorLookupCase ;
    sh:class nltl:peakPressureFactorLookupCase ;
    sh:property [
        sh:path nltl:localizedStructuralMemberCategory ;
        sh:class nltl:structuralMemberCategoryValue ;
        sh:in (
            nltl:bottomStructureFrameCategory
            nltl:longitudinallyFramedPlatingCategory
            nltl:stringerSideLongitudinalOrWebFrameCategory
            nltl:transverseFrameWithLoadDistributingStringersCategory
            nltl:transverseFrameWithoutLoadDistributingStringersCategory
            nltl:transverselyFramedPlatingCategory
        ) ;
        sh:minCount 1 ;
        sh:message "The peak pressure lookup case must identify a permitted localized structural-member category."
    ] ;
    sh:property [
        sh:path nltl:selectedPeakPressureFactor ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The peak pressure lookup case must provide the selected dimensionless peak pressure factor."
    ] .

<urn:nltl:generated-shape:I2-018-TableLookupCaseShape>
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasTableLookupCase ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:iacsUrI2Table3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The table lookup case must reference IACS UR I2 Table 3."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The table lookup case must provide evidence for the table selection."
    ] .
