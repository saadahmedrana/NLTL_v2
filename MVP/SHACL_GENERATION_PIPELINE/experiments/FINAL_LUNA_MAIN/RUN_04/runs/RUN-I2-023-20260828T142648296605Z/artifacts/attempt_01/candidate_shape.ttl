@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A pressure quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A pressure quantity must use MPa."
    ] .

gen:LengthMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A metre quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A length quantity must use metres."
    ] .

gen:LengthMillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A millimetre quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A net plate thickness quantity must use millimetres."
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An angle quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The framing angle must use degrees."
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dimensionless quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dimensionless quantity must use the unitless unit."
    ] .

gen:StructuralMemberReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each linked structural member must provide frame spacing."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each linked structural member must provide the selected hull area factor."
    ] .

gen:PlatingReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node gen:AngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each linked plating item must provide the framing angle."
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each linked plating item must provide the externally calculated required net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:StructuralMemberReadinessShape ;
        sh:minCount 1 ;
        sh:message "Each linked plating item must identify its supporting structural member."
    ] .

gen:ShipReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide average ice pressure."
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide frame span."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide load patch height."
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the peak pressure factor."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide yield strength."
    ] ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:class nltl:plating ;
        sh:node gen:PlatingReadinessShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify applicable plating for the readiness assessment."
    ] .
