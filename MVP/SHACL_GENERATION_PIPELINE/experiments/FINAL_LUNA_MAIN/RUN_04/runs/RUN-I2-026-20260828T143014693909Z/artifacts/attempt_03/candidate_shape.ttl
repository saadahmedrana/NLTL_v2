@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_026_StructuralMemberShape
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:node gen:I2_026_MemberSupportShape
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:frameSupportConditionValue ;
        sh:in (
            nltl:fixedFrameSupport
            nltl:simpleFrameSupport
        ) ;
        sh:message "Each structural member must specify either fixed or simple frame support."
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A structural member with continuity, a connection bracket, or demonstrated significant rotational restraint must specify fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    { $this nltl:continuousThroughSupport "true"^^xsd:boolean }
                    UNION
                    {
                        $this nltl:hasMemberSupport ?support .
                        ?support nltl:connectionBracketPresent "true"^^xsd:boolean
                    }
                    UNION
                    {
                        $this nltl:hasMemberSupport ?support .
                        ?support nltl:demonstratedRotationalRestraint "true"^^xsd:boolean .
                        $this nltl:significantRotationalRestraintEvidence ?evidence
                    }
                }
                FILTER NOT EXISTS {
                    $this nltl:frameSupportCondition nltl:fixedFrameSupport
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A structural member without qualifying fixity evidence must specify simple frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:continuousThroughSupport "true"^^xsd:boolean
                }
                FILTER NOT EXISTS {
                    $this nltl:hasMemberSupport ?support .
                    ?support nltl:connectionBracketPresent "true"^^xsd:boolean
                }
                FILTER NOT EXISTS {
                    $this nltl:hasMemberSupport ?support .
                    ?support nltl:demonstratedRotationalRestraint "true"^^xsd:boolean .
                    $this nltl:significantRotationalRestraintEvidence ?evidence
                }
                FILTER NOT EXISTS {
                    $this nltl:frameSupportCondition nltl:simpleFrameSupport
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Demonstrated rotational restraint must have significant rotational restraint evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:demonstratedRotationalRestraint "true"^^xsd:boolean .
                FILTER NOT EXISTS {
                    $this nltl:significantRotationalRestraintEvidence ?evidence
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A structural member terminating within an ice-strengthened area must specify fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:terminatesWithinIceStrengthenedArea "true"^^xsd:boolean .
                FILTER NOT EXISTS {
                    $this nltl:frameSupportCondition nltl:fixedFrameSupport
                }
            }
        """
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean
    ] .
