@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

g:I2_030_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node g:I2_030_CalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember ;
        sh:node g:I2_030_StructuralMemberShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an oblique framing angle strictly between 20 and 70 degrees, both interpolation endpoints, ordered coordinates, and paired interpolation results are required for the net effective plastic section modulus." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?cc .
                $this nltl:hasStructuralMember ?sm .
                ?sm nltl:hasLocalFrameSectionCalculationCase ?lc .
                ?lc nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?angleValue .
                ?angleValue qudt:numericValue ?angle .
                FILTER (?angle > 20 && ?angle < 70)
                FILTER NOT EXISTS {
                    ?cc nltl:interpolationLowerEndpoint ?lower .
                    ?cc nltl:interpolationUpperEndpoint ?upper .
                    ?lower nltl:interpolationPointCoordinate ?lowerCoordinateValue .
                    ?upper nltl:interpolationPointCoordinate ?upperCoordinateValue .
                    ?lowerCoordinateValue qudt:numericValue ?lowerCoordinate .
                    ?upperCoordinateValue qudt:numericValue ?upperCoordinate .
                    ?lower nltl:interpolationPointResult ?lowerResult .
                    ?upper nltl:interpolationPointResult ?upperResult .
                    ?sm nltl:netEffectivePlasticSectionModulus ?modulus .
                    FILTER (?lowerCoordinate < ?upperCoordinate)
                }
            }
        """
    ] .

g:I2_030_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:node g:I2_030_AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:node g:I2_030_WebHeightQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:node g:I2_030_NetWebThicknessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node g:I2_030_NetAttachedThicknessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node g:I2_030_FrameSpacingQuantityShape
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:node g:I2_030_FlangeHeightQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:node g:I2_030_WebAngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:node g:I2_030_DistanceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:node g:I2_030_SectionModulusQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:localFrameSectionCalculationCase ;
        sh:node g:I2_030_LocalFrameSectionCalculationCaseShape
    ] .

g:I2_030_LocalFrameSectionCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:class nltl:plating ;
        sh:node g:I2_030_PlatingShape
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember
    ] .

g:I2_030_PlatingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node g:I2_030_AngleQuantityShape
    ] .

g:I2_030_CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:node g:I2_030_NeutralAxisQuantityShape
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node g:I2_030_InterpolationPointShape
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node g:I2_030_InterpolationPointShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the local-frame area exceeds the attached-plate-flange area, the calculation case must provide the plastic neutral axis height and the linked structural member must provide the net effective plastic section modulus." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?sm .
                ?sm nltl:netLocalFrameFlangeArea ?areaValue .
                ?sm nltl:netAttachedShellPlateThickness ?thicknessValue .
                ?sm nltl:frameSpacing ?spacingValue .
                ?areaValue qudt:numericValue ?area .
                ?thicknessValue qudt:numericValue ?thickness .
                ?spacingValue qudt:numericValue ?spacing .
                FILTER (100 * ?area > 1000 * ?thickness * ?spacing)
                FILTER NOT EXISTS {
                    $this nltl:plasticNeutralAxisHeight ?neutralAxis
                }
                FILTER NOT EXISTS {
                    ?sm nltl:netEffectivePlasticSectionModulus ?modulus
                }
            }
        """
    ] .

g:I2_030_InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:node g:I2_030_InterpolationCoordinateShape
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1
    ] .

g:I2_030_QuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] .

g:I2_030_AreaQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_WebHeightQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_NetWebThicknessQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_NetAttachedThicknessQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_FrameSpacingQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_FlangeHeightQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_DistanceQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_AngleQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_NeutralAxisQuantityShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:I2_030_InterpolationCoordinateShape
    a sh:NodeShape ;
    sh:node g:I2_030_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
