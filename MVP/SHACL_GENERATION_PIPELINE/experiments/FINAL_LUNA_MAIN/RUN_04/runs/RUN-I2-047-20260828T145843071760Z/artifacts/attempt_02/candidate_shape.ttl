@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2_047>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The linked hull structure must be identified as ice strengthened."
            ] ;
            sh:property [
                sh:path nltl:gaugedThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue qudt:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:netThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue qudt:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:steelRenewalRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Steel renewal is required when gauged thickness is less than net thickness plus 0.0005 m."
            ] ;
            sh:sparql [
                sh:message "For an ice-strengthened structure, gauged thickness must be at least net thickness plus 0.0005 m unless steel renewal is required." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedQuantity ;
                              nltl:netThickness ?netQuantity ;
                              nltl:steelRenewalRequired ?renewal .

                        ?gaugedQuantity qudt:numericValue ?gaugedValue ;
                                         qudt:unit qudt:M .
                        ?netQuantity qudt:numericValue ?netValue ;
                                     qudt:unit qudt:M .

                        FILTER EXISTS {
                            $this nltl:hasPlating ?plating .
                            ?plating nltl:iceStrengthenedStructureStatus true .
                        }

                        FILTER (?gaugedValue < (?netValue + 0.0005))
                        FILTER (?renewal != true)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:hasPlating nltl:iceStrengthenedStructureStatus ) ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
