@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:I2_054_> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:LengthQuantityShape ;
        sh:message "The ship shall provide one upper ice waterline length L_UI in metres."
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:AngleQuantityShape ;
        sh:message "The ship shall provide one stem angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:ForceQuantityShape ;
        sh:message "The ship shall provide one design vertical ice force at the bow in meganewtons."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node nltlg:CalculationCaseShape ;
        sh:message "The ship shall provide a calculation case containing the interpolation structure."
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:minCount 1 ;
        sh:node nltlg:HullGirderCaseShape ;
        sh:message "The ship shall provide a hull-girder bending-moment calculation case."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The interpolation structure and hull-girder bending-moment result shall belong to the same linked calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                ?case a nltl:calculationCase .
                ?case a nltl:hullGirderBendingMomentCalculationCase .
                FILTER NOT EXISTS {
                    ?case nltl:hasInterpolationPoint ?point .
                }
            }
        """
    ] .

nltlg:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:LengthQuantityShape ;
        sh:message "The calculation case shall provide its hull-girder longitudinal position from aft in metres."
    ] ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:minCount 5 ;
        sh:node nltlg:InterpolationPointShape ;
        sh:message "The calculation case shall provide the five required interpolation anchors and any applicable intermediate points."
    ] .

nltlg:HullGirderCaseShape
    a sh:NodeShape ;
    sh:class nltl:hullGirderBendingMomentCalculationCase ;
    sh:property [
        sh:path nltl:caseBendingMomentDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:DimensionlessQuantityShape ;
        sh:message "The hull-girder calculation case shall provide C_m."
    ] ;
    sh:property [
        sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:LengthQuantityShape ;
        sh:message "The hull-girder calculation case shall provide its longitudinal position from aft in metres."
    ] ;
    sh:property [
        sh:path nltl:caseDesignVerticalIceBendingMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:TorqueQuantityShape ;
        sh:message "The hull-girder calculation case shall provide the externally calculated design vertical ice bending moment in MN m."
    ] .

nltlg:InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:NormalizedQuantityShape ;
        sh:message "Each interpolation point shall provide one normalized longitudinal coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:DecimalQuantityShape ;
        sh:message "Each interpolation point shall provide its C_m interpolation result."
    ] .

nltlg:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:TorqueQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:NormalizedQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:DecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:ShipShape
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The linked interpolation case shall contain exact inclusive anchors at normalized positions 0, 0.5, 0.7, 0.95, and 1 with C_m values 0, 1, 1, 0.3, and 0 respectively." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                FILTER (
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p0 .
                        ?p0 nltl:interpolationPointCoordinate ?q0 .
                        ?q0 qudt:numericValue "0.0"^^xsd:decimal .
                        ?p0 nltl:interpolationPointResult ?r0 .
                        ?r0 qudt:numericValue ?v0 .
                        FILTER (?v0 >= 0 && ?v0 <= 0)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p5 .
                        ?p5 nltl:interpolationPointCoordinate ?q5 .
                        ?q5 qudt:numericValue "0.5"^^xsd:decimal .
                        ?p5 nltl:interpolationPointResult ?r5 .
                        ?r5 qudt:numericValue ?v5 .
                        FILTER (?v5 >= 1 && ?v5 <= 1)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p7 .
                        ?p7 nltl:interpolationPointCoordinate ?q7 .
                        ?q7 qudt:numericValue "0.7"^^xsd:decimal .
                        ?p7 nltl:interpolationPointResult ?r7 .
                        ?r7 qudt:numericValue ?v7 .
                        FILTER (?v7 >= 1 && ?v7 <= 1)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p95 .
                        ?p95 nltl:interpolationPointCoordinate ?q95 .
                        ?q95 qudt:numericValue "0.95"^^xsd:decimal .
                        ?p95 nltl:interpolationPointResult ?r95 .
                        ?r95 qudt:numericValue ?v95 .
                        FILTER (?v95 >= 0.3 && ?v95 <= 0.3)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?p1 .
                        ?p1 nltl:interpolationPointCoordinate ?q1 .
                        ?q1 qudt:numericValue "1.0"^^xsd:decimal .
                        ?p1 nltl:interpolationPointResult ?r1 .
                        ?r1 qudt:numericValue ?v1 .
                        FILTER (?v1 >= 0 && ?v1 <= 0)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every interpolation point shall follow the stated piecewise-linear C_m envelope between the required anchors." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                ?case nltl:hasInterpolationPoint ?point .
                ?point nltl:interpolationPointCoordinate ?cq .
                ?cq qudt:numericValue ?c .
                ?point nltl:interpolationPointResult ?rq .
                ?rq qudt:numericValue ?r .
                BIND(
                    IF(?c >= 0.0 && ?c < 0.5,
                       2.0 * ?c,
                       IF(?c >= 0.5 && ?c <= 0.7,
                          1.0,
                          IF(?c > 0.7 && ?c < 0.95,
                             1.0 - 2.8 * (?c - 0.7),
                             IF(?c >= 0.95 && ?c <= 1.0,
                                0.3 - 6.0 * (?c - 0.95),
                                -1.0))))
                    AS ?expected
                )
                BIND(IF(?expected >= 0.0,
                        ?expected * 0.000001,
                        -?expected * 0.000001)
                     AS ?relativeTolerance)
                BIND(IF(?expected >= 0.0,
                        0.000001,
                        0.000001)
                     AS ?absoluteTolerance)
                FILTER(
                    ?c < 0.0 ||
                    ?c > 1.0 ||
                    ?r < ?expected - IF(?relativeTolerance > ?absoluteTolerance, ?relativeTolerance, ?absoluteTolerance) ||
                    ?r > ?expected + IF(?relativeTolerance > ?absoluteTolerance, ?relativeTolerance, ?absoluteTolerance)
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The hull-girder case position shall correspond to an interpolation point coordinate normalized by L_UI, and its C_m shall correspond to that point." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineLengthLUI ?lq .
                ?lq qudt:numericValue ?lui .
                $this nltl:hasCalculationCase ?case .
                $this nltl:hasHullGirderBendingMomentCalculationCase ?case .
                ?case nltl:hullGirderLongitudinalPositionFromAft ?pq .
                ?pq qudt:numericValue ?position .
                ?case nltl:caseBendingMomentDistributionFactor ?cmq .
                ?cmq qudt:numericValue ?cm .
                FILTER (
                    ?lui > 0.0 &&
                    NOT EXISTS {
                        ?case nltl:hasInterpolationPoint ?point .
                        ?point nltl:interpolationPointCoordinate ?cq .
                        ?cq qudt:numericValue ?coordinate .
                        ?point nltl:interpolationPointResult ?rq .
                        ?rq qudt:numericValue ?result .
                        BIND(?position / ?lui AS ?expectedCoordinate)
                        BIND(IF(?expectedCoordinate >= 0.0,
                                ?expectedCoordinate * 0.000001,
                                -?expectedCoordinate * 0.000001)
                             AS ?coordinateTolerance)
                        BIND(IF(?cm >= 0.0, ?cm * 0.000001, -?cm * 0.000001)
                             AS ?resultTolerance)
                        FILTER(
                            ?coordinate >= ?expectedCoordinate - IF(?coordinateTolerance > 0.000001, ?coordinateTolerance, 0.000001) &&
                            ?coordinate <= ?expectedCoordinate + IF(?coordinateTolerance > 0.000001, ?coordinateTolerance, 0.000001) &&
                            ?result >= ?cm - IF(?resultTolerance > 0.000001, ?resultTolerance, 0.000001) &&
                            ?result <= ?cm + IF(?resultTolerance > 0.000001, ?resultTolerance, 0.000001)
                        )
                    }
                )
            }
        """
    ] .
