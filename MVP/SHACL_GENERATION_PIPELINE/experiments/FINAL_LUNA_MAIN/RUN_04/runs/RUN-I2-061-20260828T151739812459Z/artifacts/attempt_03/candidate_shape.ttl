@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-061-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape>
    ] .

<urn:nltl:generated-shape:I2-061-CalculationCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationCaseAssessedHullStructure ;
        sh:nodeKind sh:IRI ;
        sh:or (
            [ sh:class nltl:hullStructure ]
            [ sh:class nltl:plating ]
            [ sh:class nltl:structuralMember ]
        ) ;
        sh:node <urn:nltl:generated-shape:I2-061-AssessedHullStructureShape>
    ] ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A direct calculation method shall not be used for a calculation case explicitly assessed against shell plating or a local-frame structural member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure a ?structureType .
                FILTER (
                    ?structureType IN (
                        nltl:plating,
                        nltl:structuralMember
                    )
                )
                $this nltl:calculationMethod
                    nltl:directCalculationMethodValue .
            }
        """
    ] .

<urn:nltl:generated-shape:I2-061-AssessedHullStructureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:thickness ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
