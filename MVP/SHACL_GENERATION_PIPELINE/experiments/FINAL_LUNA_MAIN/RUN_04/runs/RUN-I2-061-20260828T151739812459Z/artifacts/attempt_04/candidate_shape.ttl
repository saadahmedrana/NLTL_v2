@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node gen:CalculationCaseShape
    ] .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationCaseAssessedHullStructure ;
        sh:node [
            sh:nodeKind sh:IRI ;
            sh:class nltl:hullStructure ;
            sh:property [
                sh:path nltl:thickness ;
                sh:node gen:ThicknessQuantityShape
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:node [
            sh:nodeKind sh:IRI ;
            sh:class nltl:calculationMethodValue
        ]
    ] ;
    sh:sparql [
        sh:message "A shell-plating or local-frame calculation case must use the prescribed analytical procedure and must not use a direct calculation method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?structure .
                ?structure a ?applicableType .
                FILTER (?applicableType IN (nltl:plating, nltl:structuralMember))
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculationMethod nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        $this nltl:calculationMethod nltl:directCalculationMethodValue
                    }
                )
            }
        """
    ] .

gen:ThicknessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:maxCount 1
    ] .
