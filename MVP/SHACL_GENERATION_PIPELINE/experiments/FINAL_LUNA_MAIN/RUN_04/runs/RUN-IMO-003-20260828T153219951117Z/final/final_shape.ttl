@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_003_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:message "A ship must provide a design ice condition to determine applicability of the Category C rule."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:openWaterIceCondition
                    nltl:iceConditionLessSevereThanCategoryAAndB
                )
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1 ;
                sh:message "A ship designed for open water or ice conditions less severe than categories A and B shall have Polar Ship Category C."
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:nodeKind sh:IRI ;
                sh:not [
                    sh:in (
                        nltl:openWaterIceCondition
                        nltl:iceConditionLessSevereThanCategoryAAndB
                    )
                ]
            ]
        ]
    ) .
