@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_004_Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOriginType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:iceOriginValue
        ] ;
        sh:message "A ship must provide one ice origin value."
    ] ;
    sh:property [
        sh:path nltl:winterGrowthCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:maxInclusive 1 ;
        sh:message "Winter growth count must be an integer not greater than one."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0.3"^^xsd:decimal ;
                sh:maxInclusive "2.0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "Ice thickness must be between 0.3 m and 2.0 m inclusive."
    ] ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:iceTypeValue
        ]
    ] ;
    sh:sparql [
        sh:message "When the ice is sea ice, has no more than one winter growth, and is 0.3 m to 2.0 m thick, its classification must be exactly first-year ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growth ;
                       nltl:iceThickness ?thickness .
                ?thickness qudt:numericValue ?value ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    xsd:decimal(?growth) <= "1"^^xsd:decimal &&
                    ?value >= "0.3"^^xsd:decimal &&
                    ?value <= "2.0"^^xsd:decimal
                )
                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce .
                }
            }
        """
    ] .
