@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO004IceClassificationShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For sea ice with no more than one winter growth and thickness from 0.3 m through 2.0 m, the ice type classification must be present and exactly nltl:firstYearIce." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growth ;
                       nltl:iceThickness ?thicknessNode .

                FILTER (
                    datatype(?growth) = xsd:integer &&
                    ?growth <= 1
                )

                ?thicknessNode a qudt:QuantityValue ;
                                qudt:numericValue ?thickness ;
                                qudt:unit unit:M .

                FILTER (
                    datatype(?thickness) = xsd:decimal &&
                    ?thickness >= 0.3 &&
                    ?thickness <= 2.0
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:iceTypeClassification nltl:firstYearIce
                    } ||
                    EXISTS {
                        $this nltl:iceTypeClassification ?classification .
                        FILTER (?classification != nltl:firstYearIce)
                    }
                )
            }
        """ ;
    ] .
