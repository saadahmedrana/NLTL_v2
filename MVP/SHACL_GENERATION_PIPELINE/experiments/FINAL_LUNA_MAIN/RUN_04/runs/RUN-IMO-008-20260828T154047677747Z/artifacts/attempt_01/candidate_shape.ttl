@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-008> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceTypeValue
        ]
    ] ;
    sh:sparql [
        sh:message "When the ice type is thin first-year ice, ice thickness must be recorded as a metre quantity between 0.3 m and 0.7 m inclusive." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceTypeClassification nltl:thinFirstYearIce .
    FILTER (
        NOT EXISTS {
            $this nltl:iceThickness ?q .
            ?q a qudt:QuantityValue ;
               qudt:numericValue ?v ;
               qudt:unit unit:M .
            FILTER (
                datatype(?v) = xsd:decimal &&
                ?v >= 0.3 &&
                ?v <= 0.7
            )
        }
        ||
        EXISTS {
            $this nltl:iceThickness ?q .
            FILTER NOT EXISTS {
                ?q a qudt:QuantityValue ;
                   qudt:numericValue ?v ;
                   qudt:unit unit:M .
                FILTER (
                    datatype(?v) = xsd:decimal &&
                    ?v >= 0.3 &&
                    ?v <= 0.7
                )
            }
        }
    )
}
"""
    ] .
