@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO017ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:message "The ship shall have a Polar Ship Certificate form."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node gs:IMO017SolasScheduleShape ;
        sh:message "The ship shall have an applicable SOLAS certificate schedule."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:class nltl:polarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node gs:IMO017SupplementShape ;
        sh:message "The Polar Ship Certificate shall include a supplement."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate validity dates shall be recorded."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate survey dates shall be recorded."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate endorsement dates shall be recorded."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Certificate supplement shall be present."
    ] ;
    sh:sparql [
        sh:message "Each SOLAS certificate schedule date shall match the corresponding Polar Ship Certificate date category and date." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:hasSolasCertificateSchedule ?schedule .
  ?schedule nltl:hasCertificateScheduleDateRecord ?record .
  ?record nltl:certificateScheduleDate ?date ;
          nltl:certificateScheduleDateType ?category .
  FILTER (
    (?category = nltl:validityDateCategory &&
     NOT EXISTS { $this nltl:polarCertificateValidityDates ?date }) ||
    (?category = nltl:surveyDateCategory &&
     NOT EXISTS { $this nltl:surveyDates ?date }) ||
    (?category = nltl:endorsementDateCategory &&
     NOT EXISTS { $this nltl:endorsementDates ?date })
  )
}
"""
    ] ;
    sh:sparql [
        sh:message "Each Polar Ship Certificate validity date shall match a validity date in the applicable SOLAS certificate schedule." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:polarCertificateValidityDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each Polar Ship Certificate survey date shall match a survey date in the applicable SOLAS certificate schedule." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:surveyDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each Polar Ship Certificate endorsement date shall match an endorsement date in the applicable SOLAS certificate schedule." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
  $this nltl:endorsementDates ?date .
  FILTER NOT EXISTS {
    $this nltl:hasSolasCertificateSchedule ?schedule .
    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
    ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
            nltl:certificateScheduleDate ?date .
  }
}
"""
    ] .

gs:IMO017SolasScheduleShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:class nltl:certificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:node gs:IMO017DateRecordShape ;
        sh:message "The SOLAS certificate schedule shall contain certificate schedule date records."
    ] .

gs:IMO017DateRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A certificate schedule date record shall contain a calendar date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:minCount 1 ;
        sh:message "A certificate schedule date record shall identify a validity, survey, or endorsement date category."
    ] .

gs:IMO017SupplementShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:message "The Polar Certificate supplement shall record required equipment."
    ] .
