@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_031_MaterialApprovalShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:exposedStructureMaterial ;
        sh:datatype xsd:string ;
        sh:message "Each represented exposed-structure material must be a string."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"^^xsd:string
            "recognized organization accepted by the Administration"^^xsd:string
        ) ;
        sh:message "The approving authority must be the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"^^xsd:string
            "another standard offering an equivalent level of safety"^^xsd:string
        ) ;
        sh:message "The approval standard must be acceptable to the Organization or offer an equivalent level of safety."
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The material approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:polarServiceTemperature ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The polar service temperature basis must be a decimal quantity in degrees Celsius."
    ] ;
    sh:sparql [
        sh:message "Each represented exposed-structure material must have an approved status, an authorized approving authority, an authorized approval standard, and a polar service temperature basis." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:exposedStructureMaterial ?material .
                FILTER (
                    NOT EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            ?authority IN (
                                "Administration"^^xsd:string,
                                "recognized organization accepted by the Administration"^^xsd:string
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            ?standard IN (
                                "standard acceptable to the Organization"^^xsd:string,
                                "another standard offering an equivalent level of safety"^^xsd:string
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarServiceTemperature ?pst .
                    }
                )
            }
        """
    ] .
