@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_033_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_033_NotApplicable
        gen:IMO_033_Applicable
    ) .

gen:IMO_033_NotApplicable
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IMO_033_Applicable
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:deckIcingAllowance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "30"^^xsd:decimal ;
                sh:maxInclusive "30"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:sideIcingAllowance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "7.5"^^xsd:decimal ;
                sh:maxInclusive "7.5"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:continuousSurfaceProjectedArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:continuousSurfaceStaticMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:discontinuousSurfaceProjectedArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:discontinuousSurfaceStaticMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Discontinuous projected area must equal continuous projected area times 1.05, and discontinuous static moment must equal continuous static moment times 1.10, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:continuousSurfaceProjectedArea ?continuousAreaNode ;
                      nltl:continuousSurfaceStaticMoment ?continuousMomentNode ;
                      nltl:discontinuousSurfaceProjectedArea ?discontinuousAreaNode ;
                      nltl:discontinuousSurfaceStaticMoment ?discontinuousMomentNode .

                ?continuousAreaNode qudt:numericValue ?continuousArea .
                ?continuousMomentNode qudt:numericValue ?continuousMoment .
                ?discontinuousAreaNode qudt:numericValue ?discontinuousArea .
                ?discontinuousMomentNode qudt:numericValue ?discontinuousMoment .

                BIND((?continuousArea * 1.05) AS ?expectedArea)
                BIND((?continuousMoment * 1.10) AS ?expectedMoment)
                BIND(IF(ABS(?expectedArea) * 0.000001 > 0.000000001,
                        ABS(?expectedArea) * 0.000001,
                        0.000000001) AS ?areaTolerance)
                BIND(IF(ABS(?expectedMoment) * 0.000001 > 0.000000001,
                        ABS(?expectedMoment) * 0.000001,
                        0.000000001) AS ?momentTolerance)

                FILTER (
                    ?discontinuousArea < (?expectedArea - ?areaTolerance) ||
                    ?discontinuousArea > (?expectedArea + ?areaTolerance) ||
                    ?discontinuousMoment < (?expectedMoment - ?momentTolerance) ||
                    ?discontinuousMoment > (?expectedMoment + ?momentTolerance)
                )
            }
        """
    ] .
