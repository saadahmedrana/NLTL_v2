@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-048-ExposedMaterialApprovalShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:exposedMachineryOrFoundationMaterial ;
                sh:minCount 1 ;
                sh:datatype xsd:string
            ] ;
            sh:property [
                sh:path nltl:approvingAuthority ;
                sh:minCount 1 ;
                sh:datatype xsd:string ;
                sh:in (
                    "Administration"
                    "recognized organization accepted by the Administration"
                )
            ] ;
            sh:property [
                sh:path nltl:approvalStandard ;
                sh:minCount 1 ;
                sh:datatype xsd:string ;
                sh:in (
                    "standard acceptable to the Organization"
                    "another standard offering an equivalent level of safety"
                )
            ] ;
            sh:property [
                sh:path nltl:materialApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved
            ] ;
            sh:property [
                sh:path nltl:polarServiceTemperature ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:DEG_C
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:exposedMachineryOrFoundationMaterial ;
                sh:maxCount 0
            ]
        ]
    ) ;
    sh:message "When exposed machinery or foundation material is present, approved authority, accepted or equivalent-safety standard, approved status, and polar service temperature basis are required." .
