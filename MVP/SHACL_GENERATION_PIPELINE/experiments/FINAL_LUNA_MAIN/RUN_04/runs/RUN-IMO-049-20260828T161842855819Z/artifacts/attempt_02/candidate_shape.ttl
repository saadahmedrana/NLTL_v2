@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:IMO-049_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:datatype nltl:polarShipCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:message "The ship category must be recorded as Category A, B, or C."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-strengthened status required to select the Category C branch must be recorded."
    ] ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The machinery component type selector identifying applicable appendages must be recorded on the ship."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-049_CategoryABBranch>
        <urn:nltl:generated-shape:IMO-049_CategoryCStrengthenedBranch>
        <urn:nltl:generated-shape:IMO-049_CategoryCNonStrengthenedBranch>
    ) .

<urn:nltl:generated-shape:IMO-049_CategoryABBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked applicable approval record for a Category A or B ship must have approved status, an authorized authority, and an acceptable or equivalent-safety standard." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hasApprovalRecord ?record .
                FILTER NOT EXISTS {
                    ?record nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                            nltl:approvingAuthority ?authority ;
                            nltl:approvalStandard ?standard .
                    FILTER (
                        ?authority IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        )
                        &&
                        ?standard IN (
                            "standard acceptable to the Organization",
                            "another standard offering an equivalent level of safety"
                        )
                    )
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-049_CategoryCStrengthenedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:hasValue true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked applicable Category C approval record must be approved by an authorized authority, use an acceptable standard adequate for the operating ice type and concentration, and include that operating-ice context." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hasApprovalRecord ?record .
                FILTER NOT EXISTS {
                    ?record nltl:scantlingApprovalStatus nltl:evidenceStateApproved ;
                            nltl:approvingAuthority ?authority ;
                            nltl:approvalStandard "acceptable standard adequate for operating ice type and concentration" ;
                            nltl:operatingIceType ?iceType ;
                            nltl:operatingIceConcentration ?concentration .
                    FILTER (
                        ?authority IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        )
                    )
                    ?concentration qudt:numericValue ?numericValue ;
                                   qudt:unit unit:UNITLESS .
                    FILTER (datatype(?numericValue) = xsd:decimal)
                    FILTER (datatype(?iceType) = xsd:string)
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-049_CategoryCNonStrengthenedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:hasValue false
    ] .
