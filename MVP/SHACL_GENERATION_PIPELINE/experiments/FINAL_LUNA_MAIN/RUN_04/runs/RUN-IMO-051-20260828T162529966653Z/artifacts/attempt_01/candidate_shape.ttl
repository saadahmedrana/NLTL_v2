@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO051ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLocalControlItem ;
        sh:node [
            sh:class nltl:localControlItem ;
            sh:property [
                sh:path nltl:localControlProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Each linked local control item must have freezing, snow, and ice protection present."
            ] ;
            sh:property [
                sh:path nltl:localControlContinuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Each linked local control item must remain continuously accessible."
            ]
        ]
    ] .
