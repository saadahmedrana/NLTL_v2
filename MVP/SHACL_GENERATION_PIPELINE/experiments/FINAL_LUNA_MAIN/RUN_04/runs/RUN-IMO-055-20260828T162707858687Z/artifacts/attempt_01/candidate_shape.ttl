@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-055> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Valve exposure must be provided for this conditional requirement."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Valve type must be provided for this conditional requirement."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:in ( "isolating"^^xsd:string "pressure"^^xsd:string "vacuum"^^xsd:string )
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Exposed isolating, pressure, or vacuum valves shall be protected from ice accretion."
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Exposed isolating, pressure, or vacuum valves shall remain continuously accessible."
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveType ;
                sh:not [
                    sh:in ( "isolating"^^xsd:string "pressure"^^xsd:string "vacuum"^^xsd:string )
                ]
            ]
        ]
    ) .
