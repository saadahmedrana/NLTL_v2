@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_055_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "An exposed isolating, pressure, or vacuum valve must have ice accretion protection and remain continuously accessible; valve applicability evidence must be complete." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this a nltl:ship .
    FILTER (
        (
            EXISTS {
                $this nltl:valveExposed ?exposed .
                FILTER (?exposed = "true"^^xsd:boolean)
            }
            &&
            (
                NOT EXISTS {
                    $this nltl:valveType ?type
                }
                ||
                (
                    EXISTS {
                        $this nltl:valveType ?regulatedType .
                        FILTER (?regulatedType IN ("isolating", "pressure", "vacuum"))
                    }
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:iceAccretionProtectionPresent ?protected .
                            FILTER (?protected = "true"^^xsd:boolean)
                        }
                        ||
                        NOT EXISTS {
                            $this nltl:continuouslyAccessible ?accessible .
                            FILTER (?accessible = "true"^^xsd:boolean)
                        }
                    )
                )
            )
        )
        ||
        (
            EXISTS {
                $this nltl:valveType ?anyType
            }
            &&
            NOT EXISTS {
                $this nltl:valveExposed ?exposedTrue .
                FILTER (?exposedTrue = "true"^^xsd:boolean)
            }
            &&
            NOT EXISTS {
                $this nltl:valveExposed ?exposedFalse .
                FILTER (?exposedFalse = "false"^^xsd:boolean)
            }
        )
    )
}
"""
    ] .
