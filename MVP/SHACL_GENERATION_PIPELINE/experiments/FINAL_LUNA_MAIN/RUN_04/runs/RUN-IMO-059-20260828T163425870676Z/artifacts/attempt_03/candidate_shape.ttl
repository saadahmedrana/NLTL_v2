@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_059_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node gen:IMO_059_EquipmentItemShape ;
        sh:message "Each firefighter outfit must be represented as an equipment item with a warm storage location."
    ] .

gen:IMO_059_EquipmentItemShape
    a sh:NodeShape ;
    sh:class nltl:equipmentItem ;
    sh:property [
        sh:path nltl:hasStorageLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:physicalStorageLocation ;
        sh:minCount 1 ;
        sh:node gen:IMO_059_PhysicalStorageLocationShape ;
        sh:message "A firefighter outfit must have a storage location."
    ] .

gen:IMO_059_PhysicalStorageLocationShape
    a sh:NodeShape ;
    sh:class nltl:physicalStorageLocation ;
    sh:property [
        sh:path nltl:storageTemperatureClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:storageTemperatureClassValue ;
        sh:minCount 1 ;
        sh:hasValue nltl:warmStorageLocation ;
        sh:message "The firefighter outfit storage location must be classified as warm."
    ] .
