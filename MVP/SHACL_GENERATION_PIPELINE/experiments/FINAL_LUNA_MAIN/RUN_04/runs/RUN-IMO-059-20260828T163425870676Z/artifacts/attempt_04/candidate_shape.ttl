@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:ShipFirefighterOutfitShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:class nltl:equipmentItem ;
        sh:message "Each firefighter outfit must be represented as a firefighter outfit equipment item."
    ] ;
    sh:property [
        sh:path nltl:hasEquipmentItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:equipmentItem
    ] .

<urn:nltl:generated-shape:EquipmentItemStorageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:equipmentItem ;
    sh:property [
        sh:path nltl:hasStorageLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:physicalStorageLocation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each firefighter outfit equipment item must have one physical storage location."
    ] .

<urn:nltl:generated-shape:PhysicalStorageLocationTemperatureShape>
    a sh:NodeShape ;
    sh:targetClass nltl:physicalStorageLocation ;
    sh:property [
        sh:path nltl:storageTemperatureClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:storageTemperatureClassValue ;
        sh:hasValue nltl:warmStorageLocation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The storage location for each firefighter outfit must be classified as warm."
    ] .
