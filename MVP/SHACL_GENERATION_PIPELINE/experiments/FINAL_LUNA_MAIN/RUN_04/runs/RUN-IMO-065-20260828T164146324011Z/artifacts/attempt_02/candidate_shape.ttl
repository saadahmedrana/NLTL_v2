@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_065_SurvivalResourcesShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:abandonmentEnvironment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "At least one assessed abandonment environment must be recorded."
    ] ;
    sh:property [
        sh:path nltl:habitableEnvironmentPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A habitable environment must be provided."
    ] ;
    sh:property [
        sh:path nltl:weatherProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Protection from cold, wind, and sun must be provided."
    ] ;
    sh:property [
        sh:path nltl:accommodationSpacePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Accommodation space for persons with adequate thermal protection must be provided."
    ] ;
    sh:property [
        sh:path nltl:sustenanceMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Means to provide sustenance must be provided."
    ] ;
    sh:property [
        sh:path nltl:safeAccessExitPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Safe access and exit points must be provided."
    ] ;
    sh:property [
        sh:path nltl:rescueCommunicationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Means to communicate with rescue assets must be provided."
    ] ;
    sh:property [
        sh:path nltl:maximumExpectedRescueTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DAY>
            ]
        ] ;
        sh:message "Maximum expected rescue time must be supplied as a single quantity in days."
    ] ;
    sh:property [
        sh:path nltl:survivalSupportDuration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DAY>
            ]
        ] ;
        sh:message "Survival support duration must be supplied as a single quantity in days."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Survival support duration must be at least the maximum expected rescue time." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?supportDuration .
                ?supportDuration qudt:numericValue ?supportDays .
                $this nltl:maximumExpectedRescueTime ?rescueTime .
                ?rescueTime qudt:numericValue ?rescueDays .
                FILTER (?supportDays < ?rescueDays)
            }
        """
    ] .
