@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_066_ShipIceAccretionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's ice-accretion exposure status must be recorded as exactly one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:class nltl:protectedItem ;
                sh:qualifiedValueShape gen:IMO_066_EscapeRouteCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one escape route protected item with ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:class nltl:protectedItem ;
                sh:qualifiedValueShape gen:IMO_066_MusterStationCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one muster station protected item with ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:class nltl:protectedItem ;
                sh:qualifiedValueShape gen:IMO_066_EmbarkationAreaCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one embarkation area protected item with ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:class nltl:protectedItem ;
                sh:qualifiedValueShape gen:IMO_066_SurvivalCraftCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one survival craft protected item with ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:class nltl:protectedItem ;
                sh:qualifiedValueShape gen:IMO_066_LaunchingApplianceCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one launching appliance protected item with ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:class nltl:protectedItem ;
                sh:qualifiedValueShape gen:IMO_066_SurvivalCraftAccessCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one survival-craft access protected item with ice or snow removal or prevention means is required."
            ] ;
            sh:sparql [
                sh:message "Every represented required protected item must have associated ice or snow removal or prevention means." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasProtectedItem ?item .
                        ?item nltl:protectedItemCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:escapeRouteProtectedItem,
                                nltl:musterStationProtectedItem,
                                nltl:embarkationAreaProtectedItem,
                                nltl:survivalCraftProtectedItem,
                                nltl:launchingApplianceProtectedItem,
                                nltl:survivalCraftAccessProtectedItem
                            )
                        )
                        FILTER NOT EXISTS {
                            ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                        }
                    }
                """
            ]
        ]
    ) .

gen:IMO_066_EscapeRouteCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:escapeRouteProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO_066_MusterStationCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:musterStationProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

