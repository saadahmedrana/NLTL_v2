@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO071Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The immersion-suit applicability state must be recorded as false when the insulated-type condition is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The immersion-suit applicability state must be recorded as true when immersion suits are required."
            ] ;
            sh:property [
                sh:path nltl:immersionSuitTypeClassification ;
                sh:hasValue nltl:insulatedImmersionSuit ;
                sh:message "Where immersion suits are required, the immersion suit type must be insulated."
            ]
        ]
    ) .
