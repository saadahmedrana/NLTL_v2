@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO_072_SearchlightShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or ( _:darknessFalse _:darknessTrue ) .

_:darknessFalse
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

_:darknessTrue
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:class nltl:lifeboat ;
        sh:node g:IMO_072_LifeboatShape
    ] .

g:IMO_072_LifeboatShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:class nltl:searchlight ;
        sh:minCount 1 ;
        sh:node g:IMO_072_SearchlightSuitabilityShape
    ] .

g:IMO_072_SearchlightSuitabilityShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .
