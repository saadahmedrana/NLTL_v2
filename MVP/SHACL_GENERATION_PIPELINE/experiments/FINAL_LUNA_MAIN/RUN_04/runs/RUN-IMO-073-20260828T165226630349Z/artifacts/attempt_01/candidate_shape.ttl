@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-073-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:lifeboat ;
        sh:node [
            sh:property [
                sh:path nltl:lifeboatTypeClassification ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:lifeboatTypeValue ;
                sh:minCount 1 ;
                sh:in (
                    nltl:partiallyEnclosedLifeboat
                    nltl:totallyEnclosedLifeboat
                ) ;
                sh:message "Each lifeboat shall have a type classified as partially enclosed or totally enclosed."
            ]
        ]
    ] .
