@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-081-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-081-NotApplicableByDate>
        <urn:nltl:generated-shape:IMO-081-NotApplicableByIceStatus>
        <urn:nltl:generated-shape:IMO-081-Applicable>
    ) ;
    sh:message "For ships constructed on or after 1 January 2017 and ice strengthened, the required echo-sounding equipment topology must be provided." .

<urn:nltl:generated-shape:IMO-081-NotApplicableByDate> a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:IMO-081-NotApplicableByIceStatus> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:IMO-081-Applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-081-IndependentDevicesAlternative>
        <urn:nltl:generated-shape:IMO-081-DeviceWithTransducersAlternative>
    ) .

<urn:nltl:generated-shape:IMO-081-IndependentDevicesAlternative> a sh:NodeShape ;
    sh:property [
        sh:path nltl:independentEchoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:message "At least two independent echo-sounding devices are required." .

<urn:nltl:generated-shape:IMO-081-DeviceWithTransducersAlternative> a sh:NodeShape ;
    sh:property [
        sh:path nltl:echoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:independentTransducerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:message "At least one echo-sounding device with at least two independent transducers is required." .
