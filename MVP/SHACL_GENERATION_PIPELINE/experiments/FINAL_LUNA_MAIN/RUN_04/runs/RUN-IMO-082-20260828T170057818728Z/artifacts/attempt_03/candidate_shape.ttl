@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_082_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "SOLAS regulation V/22.1.9.4 compliance is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bridgeConfigurationType ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:hasValue nltl:asternViewRequiredBridgeConfiguration
            ] ;
            sh:property [
                sh:path nltl:clearViewAsternStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "A clear astern view status of true is required for the applicable bridge configuration."
            ] ;
            sh:sparql [
                sh:message "The clear astern view status must be exactly one distinct RDF value." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        {
                            SELECT $this (COUNT(DISTINCT ?status) AS ?distinctStatusCount)
                            WHERE {
                                $this nltl:clearViewAsternStatus ?status .
                            }
                            GROUP BY $this
                        }
                        FILTER (?distinctStatusCount != 1)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:bridgeConfigurationType ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:message "Bridge configuration is required to determine astern-view applicability."
            ] ;
            sh:sparql [
                sh:message "The astern-view-required bridge configuration requires a compliant clear astern view status." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:bridgeConfigurationType
                              nltl:asternViewRequiredBridgeConfiguration .
                    }
                """
            ]
        ]
    ) .
