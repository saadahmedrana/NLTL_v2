@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_088_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO_088_DaylightBranch
        gs:IMO_088_NonDaylightBranch
    ) .

gs:IMO_088_DaylightBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:IMO_088_NonDaylightBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:or (
        gs:IMO_088_SearchlightBranch
        gs:IMO_088_AlternativeMeansBranch
    ) .

gs:IMO_088_SearchlightBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:message "At least two bridge-controlled rotatable narrow-beam searchlights are required."
    ] ;
    sh:property [
        sh:path nltl:searchlightCoverageArc ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "360"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Searchlight coverage must be at least 360 degrees."
    ] .

gs:IMO_088_AlternativeMeansBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Approved alternative means for visual ice detection are required."
    ] .
