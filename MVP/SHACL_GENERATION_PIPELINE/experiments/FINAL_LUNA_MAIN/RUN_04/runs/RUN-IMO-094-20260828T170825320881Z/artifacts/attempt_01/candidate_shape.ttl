@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-094> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-094-not-applicable>
        <urn:nltl:generated-shape:IMO-094-applicable>
    ) .

<urn:nltl:generated-shape:IMO-094-not-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipProvidesIcebreakingEscort ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship's icebreaking escort applicability must be explicitly recorded as false when the escort-specific rule does not apply."
    ] .

<urn:nltl:generated-shape:IMO-094-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipProvidesIcebreakingEscort ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship providing icebreaking escort must explicitly record that applicability."
    ] ;
    sh:property [
        sh:path nltl:asternFacingSoundSignalingSystemPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship providing icebreaking escort must have an astern-facing sound signaling system."
    ] ;
    sh:property [
        sh:path nltl:internationalCodeOfSignalsComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The astern-facing sound signaling system must comply with the International Code of Signals."
    ] .
