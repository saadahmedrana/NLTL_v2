@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating applicability must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasLifeboat ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape>
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasOtherSurvivalCraft ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:IMO-097-OtherSurvivalCraftShape>
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-097-SurvivalCraftShape>
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-097-LifeboatShape> a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:equipmentItem ;
        sh:message "Each applicable lifeboat must carry at least one distress-alert device."
    ] .

<urn:nltl:generated-shape:IMO-097-OtherSurvivalCraftShape> a sh:NodeShape ;
    sh:class nltl:otherSurvivalCraft ;
    sh:message "Each applicable other survival craft must be represented as an other survival craft." .

<urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:message "Each applicable survival craft must have at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:locationSignalDevice ;
        sh:message "Each applicable survival craft must have at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:message "Each applicable survival craft must have at least one on-scene transmit/receive communication device."
    ] .
