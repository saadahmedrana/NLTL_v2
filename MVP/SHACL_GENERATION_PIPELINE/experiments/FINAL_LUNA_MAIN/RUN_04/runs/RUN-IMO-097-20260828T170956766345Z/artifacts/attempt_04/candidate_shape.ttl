@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The ship's low-air-temperature applicability must be recorded as false for the non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ship's low-air-temperature applicability must be recorded as true for this requirement to apply."
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
                sh:message "An applicable released rescue boat or lifeboat must be linked through the required-rescue-boat-or-lifeboat relationship."
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> ;
                sh:message "Applicable survival craft must be linked and carry the required communication devices."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasLifeboat ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:IMO-097-LifeboatShape> ;
                        sh:message "The applicable ship must link its lifeboat inventory."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasOtherSurvivalCraft ;
                        sh:minCount 1 ;
                        sh:node nltl:otherSurvivalCraft ;
                        sh:message "The applicable ship must link its other-survival-craft inventory."
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:IMO-097-LifeboatShape>
    a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:minCount 1 ;
        sh:node nltl:equipmentItem ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] .

<urn:nltl:generated-shape:IMO-097-SurvivalCraftShape>
    a sh:NodeShape ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:node nltl:shipToShoreDistressAlertDevice ;
        sh:message "Each applicable survival craft must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:node nltl:locationSignalDevice ;
        sh:message "Each applicable survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:node nltl:onSceneCommunicationDevice ;
        sh:message "Each applicable survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
