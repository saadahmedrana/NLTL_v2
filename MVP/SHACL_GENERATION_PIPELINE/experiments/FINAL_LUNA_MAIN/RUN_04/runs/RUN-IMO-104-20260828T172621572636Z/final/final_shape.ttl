@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO104ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall record completed PWOM familiarization." 
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:node gs:IMO104CrewMemberShape
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node gs:IMO104CrewMemberShape
    ] ;
    sh:sparql [
        sh:message "Each crew member's familiarization records shall cover every PWOM procedure or equipment item relevant to that crew member's assigned duties." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this (nltl:hasCrewMember|nltl:hasCrewMemberInventory) ?crew .
                ?crew nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    ?crew nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """
    ] .

gs:IMO104CrewMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:node gs:IMO104AssignedDutyShape
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:node gs:IMO104FamiliarizationRecordShape
    ] .

gs:IMO104AssignedDutyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:node gs:IMO104ManualItemShape
    ] .

gs:IMO104FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:node gs:IMO104ManualItemShape
    ] .

gs:IMO104ManualItemShape
    a sh:NodeShape .
