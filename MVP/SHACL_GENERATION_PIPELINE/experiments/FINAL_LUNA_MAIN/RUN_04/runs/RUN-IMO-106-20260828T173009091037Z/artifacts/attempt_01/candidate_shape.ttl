@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO106Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A discharged material classification is required to determine applicability of the oil-discharge prohibition exception."
    ] ;
    sh:property [
        sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For clean ballast or segregated ballast, the paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:dischargedMaterialClassification ?material .
    FILTER (?material IN (
        nltl:cleanBallastMaterial,
        nltl:segregatedBallastMaterial
    ))
    FILTER NOT EXISTS {
        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
        FILTER (?applicable = "false"^^xsd:boolean)
    }
}
"""
    ] .
