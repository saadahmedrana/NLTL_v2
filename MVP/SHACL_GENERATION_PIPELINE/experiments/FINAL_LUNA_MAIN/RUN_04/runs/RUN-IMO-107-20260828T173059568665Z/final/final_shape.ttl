@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_107_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:oilRecordBookPolarCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:manualPolarCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:pollutionEmergencyPlanPolarCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When the ship operates in polar waters, Oil Record Book, manual, and pollution emergency plan polar-operation coverage shall all be true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:shipOperatesInPolarWaters true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:oilRecordBookPolarCoverage true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:manualPolarCoverage true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:pollutionEmergencyPlanPolarCoverage true
                    }
                )
            }
        """
    ] .
