@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_110_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship category must be recorded as Category A, B, or C."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship type must be recorded."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The construction date must be recorded."
    ] ;
    sh:property [
        sh:path nltl:deadweight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:TON_Metric ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship deadweight must be recorded as a single metric-tonne quantity."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a Category A or B oil tanker of less than 5,000 tonnes deadweight constructed on or after 1 January 2017, both required cargo-tank protection statuses must be true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:shipType ?shipType ;
          nltl:constructionDate ?constructionDate ;
          nltl:deadweight ?deadweight .

    ?deadweight qudt:numericValue ?deadweightValue ;
                qudt:unit unit:TON_Metric .

    FILTER (?category IN (
        nltl:polarShipCategoryA,
        nltl:polarShipCategoryB
    ))
    FILTER (?shipType = "oil_tanker")
    FILTER EXISTS {
        $this a nltl:oilTanker
    }
    FILTER (?deadweightValue < 5000)
    FILTER (
        YEAR(?constructionDate) > 2017 ||
        (
            YEAR(?constructionDate) = 2017 &&
            (
                MONTH(?constructionDate) > 1 ||
                (
                    MONTH(?constructionDate) = 1 &&
                    DAY(?constructionDate) >= 1
                )
            )
        )
    )
    FILTER NOT EXISTS {
        $this nltl:entireCargoTankLengthDoubleBottomProtectionStatus ?doubleBottomStatus .
        FILTER (?doubleBottomStatus = true)
    }
    FILTER NOT EXISTS {
        $this nltl:wingTankProtectionStatus ?wingTankStatus .
        FILTER (?wingTankStatus = true)
    }
}
"""
    ] .
