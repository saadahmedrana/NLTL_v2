@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-111-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one permitted polar ship category."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:message "The construction date must be a single xsd:date value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "Every linked oil residue tank or oily bilge water holding tank on an applicable ship must have a valid capacity; if its individual capacity exceeds 30 m3, its outer-shell separation must be at least 0.76 m." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:hasComponent ?tank .
    ?tank a ?tankType .
    FILTER (
        ?tankType IN (
            nltl:oilResidueTank,
            nltl:oilyBilgeWaterHoldingTank
        )
    )
    FILTER (
        NOT EXISTS {
            ?tank nltl:individualTankCapacity ?capacity .
            ?capacity a qudt:QuantityValue ;
                qudt:numericValue ?capacityValue ;
                qudt:unit unit:M .
            FILTER (datatype(?capacityValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?tank nltl:individualTankCapacity ?largeCapacity .
            ?largeCapacity a qudt:QuantityValue ;
                qudt:numericValue ?largeCapacityValue ;
                qudt:unit unit:M .
            FILTER (
                datatype(?largeCapacityValue) = xsd:decimal &&
                ?largeCapacityValue > 30
            )
            FILTER NOT EXISTS {
                ?tank nltl:tankOuterShellSeparation ?separation .
                ?separation a qudt:QuantityValue ;
                    qudt:numericValue ?separationValue ;
                    qudt:unit unit:M .
                FILTER (
                    datatype(?separationValue) = xsd:decimal &&
                    ?separationValue >= 0.76
                )
            }
        }
    )
}
"""
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
