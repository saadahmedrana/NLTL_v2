@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO117ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO117ApplicableShape
        gen:IMO117SelectorFalseShape
        gen:IMO117SelectorMissingShape
    ) .

gen:IMO117ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The treatment-plant selector must be explicitly true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:sewageTreatmentPlantApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "An applicable ship must have an approved sewage treatment plant."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable ship must comply with MARPOL Annex IV regulation 11.1.2."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gen:IMO117DischargeDistanceRecordShape ;
        sh:minCount 1 ;
        sh:message "An applicable ship must have a discharge-distance record."
    ] .

gen:IMO117SelectorFalseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:IMO117SelectorMissingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:maxCount 0
    ] .

gen:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable discharge-distance record must record the distance to the nearest land, ice shelf, or fast ice in nautical miles."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable discharge-distance record must record the distance to an area with ice concentration greater than one tenth in nautical miles."
    ] .

gen:IMO117NauticalMileQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .
