@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO118Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO118CategoryApplicableShape
        gen:IMO118PassengerApplicableShape
        gen:IMO118Before2017Shape
    ) ;
    sh:message "The ship must provide the construction date and satisfy either the non-applicable date condition or an applicable category/passenger condition with a permitted sewage outcome." .

gen:IMO118CategoryApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:message "A construction date on or after 1 January 2017 is required for this applicability branch."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1 ;
        sh:message "An applicable ship must have Category A or Category B."
    ] ;
    sh:node gen:IMO118PermittedOutcomeShape .

gen:IMO118PassengerApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:message "A construction date on or after 1 January 2017 is required for this applicability branch."
    ] ;
    sh:class nltl:passengerShip ;
    sh:node gen:IMO118PermittedOutcomeShape ;
    sh:message "A passenger ship constructed on or after 1 January 2017 is subject to the sewage-discharge prohibition unless the permitted compliance exception applies." .

gen:IMO118Before2017Shape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:message "The construction date must be before 1 January 2017 for this non-applicable branch."
    ] .

gen:IMO118PermittedOutcomeShape a sh:NodeShape ;
    sh:or (
        gen:IMO118NoSewageDischargeShape
        gen:IMO118CompliantExceptionShape
    ) .

gen:IMO118NoSewageDischargeShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "Discharge of sewage into the sea must be recorded as false."
    ] .

gen:IMO118CompliantExceptionShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The sewage-discharge exception requires compliance with paragraph 4.2.1.3."
    ] .
