@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO119ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlgen:IMO119ApplicableShape
        nltlgen:IMO119NonApplicableShape
    ) .

nltlgen:IMO119ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "1"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:extendedPeriodOperation ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvedSewageTreatmentPlantUsed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:administrationDischargeApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:minCount 1
    ] .

nltlgen:IMO119NonApplicableShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicability branch must be established by at least one non-applicable condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:shipCategory ?category .
                    FILTER (?category NOT IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                FILTER NOT EXISTS {
                    $this nltl:iceConcentration ?quantity .
                    ?quantity qudt:numericValue ?value .
                    FILTER (?value <= 1)
                }
                FILTER NOT EXISTS {
                    $this nltl:extendedPeriodOperation false .
                }
                FILTER NOT EXISTS {
                    $this nltl:sewageDischargeOccurs false .
                }
            }
        """
    ] .
