@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_120_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:arcticWaters ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "When the ship operates in Arctic waters and discharges food waste to sea, a distance of at least 12 nautical miles, a nearby ice concentration above 0.1, and the recorded concentration-area distance are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                FILTER EXISTS {
                    ?this nltl:operatingArea ?area .
                    FILTER (?area = "Arctic_waters"^^xsd:string)
                }
                FILTER EXISTS {
                    ?this nltl:arcticWaters ?arctic .
                    FILTER (?arctic = "Arctic_waters"^^xsd:string)
                }
                FILTER EXISTS {
                    ?this nltl:foodWasteDischargeToSea ?discharge .
                    FILTER (?discharge = true)
                }
                FILTER (
                    NOT EXISTS {
                        ?this nltl:distanceToNearestLandIceShelfOrFastIce ?distance .
                        ?distance a qudt:QuantityValue ;
                            qudt:numericValue ?distanceValue ;
                            qudt:unit unit:MI_N .
                        FILTER (
                            datatype(?distanceValue) = xsd:decimal &&
                            ?distanceValue >= "12"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:nearbyIceConcentration ?nearby .
                        ?nearby a qudt:QuantityValue ;
                            qudt:numericValue ?nearbyValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?nearbyValue) = xsd:decimal &&
                            ?nearbyValue > "0.1"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?recordedDistance .
                        ?recordedDistance a qudt:QuantityValue ;
                            qudt:numericValue ?recordedValue ;
                            qudt:unit unit:MI_N .
                        FILTER (datatype(?recordedValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
