@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MI_N ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:nearbyIceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MI_N ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When operatingArea is Arctic_waters and food waste is discharged to sea, the 12 nautical-mile threshold and qualifying-ice concentration distance record must conform." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea ?discharge .
                FILTER (
                    ?area = "Arctic_waters"^^xsd:string &&
                    ?discharge = true
                )
                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestLandIceShelfOrFastIce ?thresholdNode ;
                          nltl:iceConcentration ?iceNode ;
                          nltl:nearbyIceConcentration ?nearbyNode ;
                          nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?resultNode .

                    ?thresholdNode qudt:numericValue ?thresholdValue ;
                                   qudt:unit unit:MI_N .
                    ?iceNode qudt:numericValue ?iceValue ;
                             qudt:unit unit:UNITLESS .
                    ?nearbyNode qudt:numericValue ?nearbyValue ;
                                qudt:unit unit:UNITLESS .
                    ?resultNode qudt:numericValue ?resultValue ;
                                qudt:unit unit:MI_N .

                    FILTER (
                        datatype(?thresholdValue) = xsd:decimal &&
                        datatype(?iceValue) = xsd:decimal &&
                        datatype(?nearbyValue) = xsd:decimal &&
                        datatype(?resultValue) = xsd:decimal &&
                        ?thresholdValue >= 12 &&
                        ?iceValue > 0.1 &&
                        ?nearbyValue > 0.1
                    )
                }
            }
        """
    ] .
