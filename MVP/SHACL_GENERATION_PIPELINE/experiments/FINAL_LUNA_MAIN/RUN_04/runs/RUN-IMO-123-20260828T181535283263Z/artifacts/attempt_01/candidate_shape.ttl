@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-123-NearestIceDistanceQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 12 ;
        sh:message "The nearest land, ice-shelf, or fast-ice distance must be at least 12 nautical miles."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The nearest ice distance must use nautical miles."
    ] .

<urn:nltl:generated-shape:IMO-123-IceConcentrationQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive 0.1 ;
        sh:message "The nearby ice concentration must exceed one tenth."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The nearby ice concentration must be unitless."
    ] .

<urn:nltl:generated-shape:IMO-123-DischargeDistanceRecordShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node <urn:nltl:generated-shape:IMO-123-NearestIceDistanceQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each discharge-distance record must include the nearest land, ice-shelf, or fast-ice distance."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each discharge-distance record must record the distance from an area with ice concentration exceeding one tenth."
    ] .

<urn:nltl:generated-shape:IMO-123-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:maxCount 0
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:residueNotRecoverableByCommonMethods ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:shipEnRoute ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:harmfulSubstancePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:departureAndDestinationWithinArctic ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:routeRemainsWithinArctic ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:adequateReceptionFacilitiesAvailable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:nearbyIceConcentration ;
                sh:node <urn:nltl:generated-shape:IMO-123-IceConcentrationQuantityShape> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The applicable discharge must identify nearby ice concentration exceeding one tenth."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-123-DischargeDistanceRecordShape> ;
                sh:message "An applicable cargo-residue discharge must have a complete discharge-distance record."
            ]
        ]
    ) ;
    sh:message "Cargo-residue discharge conditions are not satisfied."
    .
