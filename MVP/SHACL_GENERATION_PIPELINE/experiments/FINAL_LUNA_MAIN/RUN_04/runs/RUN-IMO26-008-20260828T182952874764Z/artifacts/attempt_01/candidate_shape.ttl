@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_008_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO26_008_SolasAndAsternBranch
        gen:IMO26_008_EquivalentArrangementBranch
    ) ;
    sh:message "The ship must have compliant SOLAS V/22.1.9.4 status and a clear view astern, or an Administration-approved equivalent visibility arrangement." .

gen:IMO26_008_SolasAndAsternBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:clearViewAsternStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] .

gen:IMO26_008_EquivalentArrangementBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:administrationApprovedEquivalentVisibilityArrangementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] .
