@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-010> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:requiredSensorProjectsBelowHull ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The below-hull sensor applicability state must be recorded as false or true."
            ]
        ]
        [
            sh:property [
                sh:path nltl:requiredSensorProjectsBelowHull ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The below-hull sensor applicability state must be recorded as true when applicable."
            ] ;
            sh:property [
                sh:path nltl:sensorIceProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Sensors projecting below the hull must be protected against ice."
            ]
        ]
    ) .
