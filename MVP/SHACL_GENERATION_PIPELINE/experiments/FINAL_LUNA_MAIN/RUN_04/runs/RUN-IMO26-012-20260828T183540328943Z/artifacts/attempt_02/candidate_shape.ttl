@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-012-QuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:IMO26-012-GrossTonnageAtLeast500Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 500
    ] .

<urn:nltl:generated-shape:IMO26-012-GrossTonnageBelow500Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:maxExclusive 500
    ] .

<urn:nltl:generated-shape:IMO26-012-HeadingMeansShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:independentFromHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:IMO26-012-ApplicableShipShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 2 ;
        sh:node <urn:nltl:generated-shape:IMO26-012-HeadingMeansShape>
    ] ;
    sh:sparql [
        sh:message "Each non-magnetic heading means must be independent from another distinct heading means of the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                    ?means nltl:independentFromHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO26-012-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node <urn:nltl:generated-shape:IMO26-012-QuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Gross tonnage is required as a single unitless decimal quantity to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node <urn:nltl:generated-shape:IMO26-012-GrossTonnageAtLeast500Shape> ;
                sh:minCount 1
            ] ;
            sh:node <urn:nltl:generated-shape:IMO26-012-ApplicableShipShape>
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node <urn:nltl:generated-shape:IMO26-012-GrossTonnageBelow500Shape> ;
                sh:minCount 1
            ]
        ]
    ) .
