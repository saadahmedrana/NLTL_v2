@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:Chapter11Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship operating-in-polar-waters status is required and must be a single boolean."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship type is required and must be a single string."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 11-1 applicability must be recorded as a single boolean."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:maxCount 1 ;
        sh:node gen:LengthOverallQuantityShape
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:maxCount 1 ;
        sh:node gen:GrossTonnageQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 11-1 applicability must be false for non-polar ships and must match the applicable fishing-vessel, pleasure-yacht, or cargo-ship threshold when the ship operates in polar waters." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?operates ;
                      nltl:shipType ?type ;
                      nltl:polarCodeChapter11Dash1Applicable ?app .

                FILTER (
                    (
                        ?operates = false &&
                        ?app != false
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type = "fishing_vessel" &&
                        (
                            (
                                ?app = true &&
                                NOT EXISTS {
                                    $this nltl:lengthOverall ?lengthNode .
                                    ?lengthNode qudt:numericValue ?lengthValue ;
                                                 qudt:unit qudt:M .
                                    FILTER (?lengthValue >= 24)
                                }
                            )
                            ||
                            (
                                ?app = false &&
                                (
                                    NOT EXISTS {
                                        $this nltl:lengthOverall ?lengthNode .
                                        ?lengthNode qudt:numericValue ?lengthValue ;
                                                     qudt:unit qudt:M .
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:lengthOverall ?lengthNode .
                                        ?lengthNode qudt:numericValue ?lengthValue ;
                                                     qudt:unit qudt:M .
                                        FILTER (?lengthValue >= 24)
                                    }
                                )
                            )
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type = "pleasure_yacht" &&
                        (
                            (
                                ?app = true &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?tonnageNode ;
                                          nltl:engagedInTrade ?trade .
                                    ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                 qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        ?tonnageValue >= 300 &&
                                        ?trade = false
                                    )
                                }
                            )
                            ||
                            (
                                ?app = false &&
                                (
                                    NOT EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode ;
                                              nltl:engagedInTrade ?trade .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode ;
                                              nltl:engagedInTrade ?trade .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                        FILTER (
                                            ?tonnageValue >= 300 &&
                                            ?trade = false
                                        )
                                    }
                                )
                            )
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type = "cargo_ship" &&
                        (
                            (
                                ?app = true &&
                                NOT EXISTS {
                                    $this nltl:grossTonnage ?tonnageNode .
                                    ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                 qudt:unit qudt:UNITLESS .
                                    FILTER (
                                        ?tonnageValue >= 300 &&
                                        ?tonnageValue < 500
                                    )
                                }
                            )
                            ||
                            (
                                ?app = false &&
                                (
                                    NOT EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:grossTonnage ?tonnageNode .
                                        ?tonnageNode qudt:numericValue ?tonnageValue ;
                                                     qudt:unit qudt:UNITLESS .
                                        FILTER (
                                            ?tonnageValue >= 300 &&
                                            ?tonnageValue < 500
                                        )
                                    }
                                )
                            )
                        )
                    )
                    ||
                    (
                        ?operates = true &&
                        ?type != "fishing_vessel" &&
                        ?type != "pleasure_yacht" &&
                        ?type != "cargo_ship" &&
                        ?app != false
                    )
                )
            }
        """
    ] .

gen:LengthOverallQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:GrossTonnageQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
