@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO26_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Chapter 11-1 applicability must be provided to select the applicable planning constraint."
    ] ;
    sh:or (
        gen:IMO26_018_ApplicableBranch
        gen:IMO26_018_NonApplicableBranch
    ) .

gen:IMO26_018_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When Chapter 11-1 is applicable, the route planning record must cover all clause 11-1.3 topics."
    ] ;
    sh:or (
        gen:IMO26_018_SafetyManagementImplementedBranch
        gen:IMO26_018_NoSafetyManagementBranch
    ) .

gen:IMO26_018_NonApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false
    ] .

gen:IMO26_018_SafetyManagementImplementedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] .

gen:IMO26_018_NoSafetyManagementBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:documentedPolarOperationProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When no safety management system is implemented, a documented polar operation procedure must be present."
    ] .
