@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF007ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ;
                sh:minCount 1 ;
                sh:message "A ship subject to the conditional rule must identify ice class IA Super or IA."
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:maxInclusive "2003-08-31"^^xsd:date ;
                sh:minCount 1 ;
                sh:message "The construction stage date is required to establish applicability of TRF-007."
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A delivery date is required for the twenty-year deadline calculation."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "An assessment date is required to verify the TRF-007 deadline."
            ] ;
            sh:property [
                sh:path nltl:engineOutputComplianceMethod ;
                sh:in (
                    nltl:traficom2017Section3Point2Point2Method
                    nltl:traficom2017Section3Point2Point4Method
                ) ;
                sh:minCount 1 ;
                sh:message "The applicable ship must identify compliance with section 3.2.2 or 3.2.4 of the 2017 Ice Class Regulations."
            ] ;
            sh:sparql [
                sh:message "The applicable ship must comply no later than 1 January of the year twenty years after delivery." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        FILTER (
                            YEAR(?assessment) < YEAR(?delivery) + 20
                            ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                &&
                                MONTH(?assessment) = 1
                                &&
                                DAY(?assessment) <= 1
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIaSuper nltl:iceClassIa ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2003-09-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:message "The construction stage date is required to establish non-applicability of TRF-007."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
                sh:minCount 1
            ]
        ]
    ) .
