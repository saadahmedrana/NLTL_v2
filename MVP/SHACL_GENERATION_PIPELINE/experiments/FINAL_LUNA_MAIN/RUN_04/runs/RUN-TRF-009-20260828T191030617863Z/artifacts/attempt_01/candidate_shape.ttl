@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF009Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF009NonApplicableBranch
        gen:TRF009ApplicableBranch
    ) .

gen:TRF009NonApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "Ice class is required to determine applicability of TRF-009."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction stage date is required to determine applicability of TRF-009."
    ] ;
    sh:sparql [
        sh:message "TRF-009 is applicable to IA or IA Super ships constructed before 1 September 2003." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .
                FILTER (
                    ?iceClass NOT IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                    ||
                    YEAR(?constructionDate) > 2003
                    ||
                    (
                        YEAR(?constructionDate) = 2003
                        &&
                        (
                            MONTH(?constructionDate) > 9
                            ||
                            (
                                MONTH(?constructionDate) = 9
                                &&
                                DAY(?constructionDate) >= 1
                            )
                        )
                    )
                )
            }
        """
    ] .

gen:TRF009ApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "Ice class is required to determine applicability of TRF-009."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction stage date is required for an applicable TRF-009 ship."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Delivery date is required to establish the TRF-009 deadline."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Assessment date is required to establish compliance with the TRF-009 deadline."
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:engineOutputComplianceMethodValue ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        ) ;
        sh:minCount 1 ;
        sh:message "An applicable TRF-009 ship shall comply through section 3.2.2 or section 3.2.4 of the 2017 Ice Class Regulations."
    ] ;
    sh:sparql [
        sh:message "The TRF-009 compliance deadline is 1 January of the year twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIa,
                        nltl:iceClassIaSuper
                    )
                )
                FILTER (
                    YEAR(?constructionDate) < 2003
                    ||
                    (
                        YEAR(?constructionDate) = 2003
                        &&
                        (
                            MONTH(?constructionDate) < 9
                            ||
                            (
                                MONTH(?constructionDate) = 9
                                &&
                                DAY(?constructionDate) < 1
                            )
                        )
                    )
                )
                FILTER (
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                    ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                        &&
                        (
                            MONTH(?assessmentDate) > 1
                            ||
                            (
                                MONTH(?assessmentDate) = 1
                                &&
                                DAY(?assessmentDate) > 1
                            )
                        )
                    )
                )
            }
        """
    ] .
