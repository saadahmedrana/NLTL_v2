@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF014ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:classCertificate ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtFore ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:TRF014LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:TRF014LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:TRF014LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtFore ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:TRF014LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:TRF014LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:TRF014LengthQuantityShape
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:iceDraughtRestrictionDocument
        ]
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        nltl:TRF014PostCutoffShape
        nltl:TRF014PreCutoffCompleteMarkingShape
        nltl:TRF014PreCutoffDeferredMarkingShape
    ) .

nltl:TRF014LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF014MarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF014LengthQuantityShape
    ] ;
    sh:sparql [
        sh:message "The ice-class draught mark amidships must equal the maximum ice-class draught amidships in the linked class certificate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasClassCertificate ?certificate ;
                       nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                ?certificate nltl:maximumIceClassDraughtAmidships ?certificateQuantity .
                ?markQuantity qudt:numericValue ?markValue ;
                              qudt:unit unit:M .
                ?certificateQuantity qudt:numericValue ?certificateValue ;
                                     qudt:unit unit:M .
                FILTER ( ?markValue != ?certificateValue )
            }
        """
    ] .

nltl:TRF014PostCutoffShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node nltl:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node nltl:TRF014LengthQuantityShape
    ] ;
    sh:sparql [
        sh:message "For a ship built on or after 1 July 2007, the summer load line fresh-water draught must be above the upper ice waterline draught for the marking rule to apply." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?summer ;
                       nltl:upperIceWaterlineDraught ?uiwl .
                ?summer qudt:numericValue ?summerValue ;
                        qudt:unit unit:M .
                ?uiwl qudt:numericValue ?uiwlValue ;
                      qudt:unit unit:M .
                FILTER ( ?summerValue <= ?uiwlValue )
            }
        """
    ] ;
    sh:node nltl:TRF014MarkingShape .

nltl:TRF014PreCutoffCompleteMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The pre-1 July 2007 marking condition requires the summer load line fresh-water draught to be above the upper ice waterline draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?summer ;
                       nltl:upperIceWaterlineDraught ?uiwl .
                ?summer qudt:numericValue ?summerValue ;
                        qudt:unit unit:M .
                ?uiwl qudt:numericValue ?uiwlValue ;
                      qudt:unit unit:M .
                FILTER ( ?summerValue <= ?uiwlValue )
            }
        """
    ] ;
    sh:node nltl:TRF014MarkingShape .

nltl:TRF014PreCutoffDeferredMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The deferred pre-1 July 2007 marking branch requires the first scheduled dry docking date to be after the supplied assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:firstScheduledDryDockingDate ?dryDocking ;
                       nltl:assessmentDate ?assessment .
                FILTER (
                    YEAR(?dryDocking) < YEAR(?assessment) ||
                    (
                        YEAR(?dryDocking) = YEAR(?assessment) &&
                        MONTH(?dryDocking) < MONTH(?assessment)
                    ) ||
                    (
                        YEAR(?dryDocking) = YEAR(?assessment) &&
                        MONTH(?dryDocking) = MONTH(?assessment) &&
                        DAY(?dryDocking) <= DAY(?assessment)
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The deferred pre-1 July 2007 marking rule applies only when the summer load line fresh-water draught is above the upper ice waterline draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?summer ;
                       nltl:upperIceWaterlineDraught ?uiwl .
                ?summer qudt:numericValue ?summerValue ;
                        qudt:unit unit:M .
                ?uiwl qudt:numericValue ?uiwlValue ;
                      qudt:unit unit:M .
                FILTER ( ?summerValue <= ?uiwlValue )
            }
        """
    ] ;
    sh:or (
        nltl:TRF014PreCutoffDeferredFutureShape
        nltl:TRF014PreCutoffDeferredDueShape
    ) .

nltl:TRF014PreCutoffDeferredFutureShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "The first scheduled dry docking date must be after the supplied assessment date for the non-marking deferred branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:firstScheduledDryDockingDate ?dryDocking ;
                       nltl:assessmentDate ?assessment .
                FILTER (
                    YEAR(?dryDocking) < YEAR(?assessment) ||
                    (
                        YEAR(?dryDocking) = YEAR(?assessment) &&
                        MONTH(?dryDocking) < MONTH(?assessment)
                    ) ||
                    (
                        YEAR(?dryDocking) = YEAR(?assessment) &&
                        MONTH(?dryDocking) = MONTH(?assessment) &&
                        DAY(?dryDocking) <= DAY(?assessment)
                    )
                )
            }
        """
    ] .

nltl:TRF014PreCutoffDeferredDueShape
    a sh:NodeShape ;
    sh:node nltl:TRF014MarkingShape ;
    sh:sparql [
        sh:message "The first scheduled dry docking date must be on or before the supplied assessment date when the marking obligation is due." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:firstScheduledDryDockingDate ?dryDocking ;
                       nltl:assessmentDate ?assessment .
                FILTER (
                    YEAR(?dryDocking) > YEAR(?assessment) ||
                    (
                        YEAR(?dryDocking) = YEAR(?assessment) &&
                        MONTH(?dryDocking) > MONTH(?assessment)
                    ) ||
                    (
                        YEAR(?dryDocking) = YEAR(?assessment) &&
                        MONTH(?dryDocking) = MONTH(?assessment) &&
                        DAY(?dryDocking) > DAY(?assessment)
                    )
                )
            }
        """
    ] .
