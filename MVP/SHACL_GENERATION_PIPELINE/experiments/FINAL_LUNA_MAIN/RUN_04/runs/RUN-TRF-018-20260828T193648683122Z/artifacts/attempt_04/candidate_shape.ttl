@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF018ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceClass is required to determine applicability of the engine-output requirement."
    ] ;
    sh:sparql [
        sh:message "An applicable ship must provide calculatedRequiredPower." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (
                    ?ice = nltl:iceClassIaSuper ||
                    ?ice IN (
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:calculatedRequiredPower ?calculatedQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable ship must provide maximumContinuousRatingPower." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (
                    ?ice = nltl:iceClassIaSuper ||
                    ?ice IN (
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?ratingQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "calculatedRequiredPower must contain an xsd:decimal numeric value in kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:iceClass ?ice ;
                          nltl:calculatedRequiredPower ?calculatedQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    FILTER NOT EXISTS {
                        ?calculatedQuantity qudt:numericValue ?calculatedValue .
                    }
                }
                UNION
                {
                    $this nltl:iceClass ?ice ;
                          nltl:calculatedRequiredPower ?calculatedQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    ?calculatedQuantity qudt:numericValue ?calculatedValue .
                    FILTER (datatype(?calculatedValue) != xsd:decimal)
                }
                UNION
                {
                    $this nltl:iceClass ?ice ;
                          nltl:calculatedRequiredPower ?calculatedQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    FILTER NOT EXISTS {
                        ?calculatedQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "maximumContinuousRatingPower must contain an xsd:decimal numeric value in kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:iceClass ?ice ;
                          nltl:maximumContinuousRatingPower ?ratingQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    FILTER NOT EXISTS {
                        ?ratingQuantity qudt:numericValue ?ratingValue .
                    }
                }
                UNION
                {
                    $this nltl:iceClass ?ice ;
                          nltl:maximumContinuousRatingPower ?ratingQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    ?ratingQuantity qudt:numericValue ?ratingValue .
                    FILTER (datatype(?ratingValue) != xsd:decimal)
                }
                UNION
                {
                    $this nltl:iceClass ?ice ;
                          nltl:maximumContinuousRatingPower ?ratingQuantity .
                    FILTER (
                        ?ice = nltl:iceClassIaSuper ||
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                    )
                    FILTER NOT EXISTS {
                        ?ratingQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be at least the calculated required power and the applicable minimum threshold." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?ratingQuantity .
                ?calculatedQuantity qudt:numericValue ?calculatedValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?ratingQuantity qudt:numericValue ?ratingValue ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                FILTER (
                    (
                        ?ice = nltl:iceClassIaSuper &&
                        (
                            ?ratingValue < ?calculatedValue ||
                            ?ratingValue < 2800
                        )
                    ) ||
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        ) &&
                        (
                            ?ratingValue < ?calculatedValue ||
                            ?ratingValue < 1000
                        )
                    )
                )
            }
        """
    ] .
