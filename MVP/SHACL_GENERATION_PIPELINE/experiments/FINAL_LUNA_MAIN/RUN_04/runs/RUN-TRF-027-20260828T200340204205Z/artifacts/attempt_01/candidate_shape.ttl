gen:ClampedHullGeometryTerm
    sh:path nltl:clampedHullGeometryTerm ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:datatype xsd:decimal
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:hasValue unit:UNITLESS
        ]
    ] .
