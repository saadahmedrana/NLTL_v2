@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-030-PressureQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-LengthQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-CommonCaseShape>
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:class nltl:loadPositionTypeValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:class nltl:loadPositionTypeValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-ArrangementDeterminedCaseShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-030-CommonCaseShape> .

<urn:nltl:generated-shape:TRF-030-ArrangementUndeterminedCaseShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-030-CommonCaseShape> ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node <urn:nltl:generated-shape:TRF-030-UnitlessQuantityShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:node <urn:nltl:generated-shape:TRF-030-PressureQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node <urn:nltl:generated-shape:TRF-030-PressureQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node <urn:nltl:generated-shape:TRF-030-LengthQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:minCount 3 ;
        sh:or (
            [
                sh:property [
                    sh:path nltl:loadLengthDeterminedFromArrangement ;
                    sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:minCount 1
                ]
            ]
            [
                sh:property [
                    sh:path nltl:loadLengthDeterminedFromArrangement ;
                    sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:minCount 1
                ]
            ]
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:minCount 3 ;
                sh:node <urn:nltl:generated-shape:TRF-030-ArrangementDeterminedCaseShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:minCount 3 ;
                sh:node <urn:nltl:generated-shape:TRF-030-ArrangementUndeterminedCaseShape>
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "At least one direct analysis case must be centred at the upper ice waterline and provide its upper ice waterline reference position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                          nltl:upperIceWaterlineReferencePosition ?reference .
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "At least one direct analysis case must be positioned 0.5h0 below the lower ice waterline and provide its lower ice waterline reference position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                          nltl:lowerIceWaterlineReferencePosition ?reference .
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "At least one direct analysis case must represent an intermediate vertical load position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition .
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "At least one direct analysis case must be centred at the mid-span or mid-spacing position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPositionType nltl:midSpanOrSpacingCenteredPosition .
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "Several horizontal direct analysis locations must include an other horizontal position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPositionType nltl:otherHorizontalPosition .
                }
            }
        """
    ] .
