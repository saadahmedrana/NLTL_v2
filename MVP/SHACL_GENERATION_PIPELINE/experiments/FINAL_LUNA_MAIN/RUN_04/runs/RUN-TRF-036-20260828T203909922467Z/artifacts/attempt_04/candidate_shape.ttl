@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-036-IceClassDesignParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Each ice-class design parameter set must be associated with a ship that has a permitted ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship a nltl:ship ;
                          nltl:hasIceClassDesignParameterSet $this ;
                          nltl:iceClass ?iceClass .
                    FILTER (?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The ice-class-specific design ice load height must equal the tabulated value, and level ice thickness must not exceed its tabulated inclusive upper bound." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasIceClassDesignParameterSet $this ;
                      nltl:iceClass ?iceClass .
                $this nltl:designIceLoadHeight ?heightQuantity ;
                       nltl:levelIceThickness ?thicknessQuantity .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    !(?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ))
                    ||
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        (?height != 0.35 || ?thickness > 1.0)
                    )
                    ||
                    (
                        ?iceClass = nltl:iceClassIa &&
                        (?height != 0.30 || ?thickness > 0.8)
                    )
                    ||
                    (
                        ?iceClass = nltl:iceClassIb &&
                        (?height != 0.25 || ?thickness > 0.6)
                    )
                    ||
                    (
                        ?iceClass = nltl:iceClassIc &&
                        (?height != 0.22 || ?thickness > 0.4)
                    )
                )
            }
        """
    ] .
