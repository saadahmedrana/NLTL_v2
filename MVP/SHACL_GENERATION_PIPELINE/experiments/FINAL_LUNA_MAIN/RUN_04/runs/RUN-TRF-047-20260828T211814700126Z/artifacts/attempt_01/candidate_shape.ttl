@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF_047_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A frame subject to this requirement shall identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:node nltl:TRF_047_LowerEndShape ;
        sh:message "A transverse frame shall identify its lower end."
    ] ;
    sh:property [
        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each lower end shall be attached to an allowed supporting structure, or shall use the permitted horizontal connection to an adjacent main frame with the same scantlings when the supporting structure is at or below the lower ice-belt limit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasLowerEnd ?end .
                FILTER (
                    (
                        NOT EXISTS {
                            ?end nltl:hasAttachedSupportingStructure ?attached .
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                            $this nltl:sameScantlingsAsMainFrame true .
                            ?end nltl:hasHorizontalConnectionMember ?member .
                            ?member nltl:connectsToAdjacentMainFrame ?mainFrame .
                        }
                    )
                    ||
                    EXISTS {
                        ?end nltl:hasHorizontalConnectionMember ?member .
                        FILTER (
                            NOT EXISTS {
                                $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:sameScantlingsAsMainFrame true .
                            }
                            ||
                            NOT EXISTS {
                                ?member nltl:connectsToAdjacentMainFrame ?mainFrame .
                            }
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Main frames below the lower edge of the ice belt shall be ice strengthened." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                FILTER NOT EXISTS {
                    $this nltl:mainFrameBelowIceBeltStrengthened true .
                }
            }
        """
    ] .

nltl:TRF_047_LowerEndShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node nltl:TRF_047_AttachedStructureShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasHorizontalConnectionMember ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node nltl:TRF_047_HorizontalMemberShape
            ]
        ]
    ) ;
    sh:message "The lower end shall have an attached supporting structure or a permitted horizontal connection member."
.

nltl:TRF_047_AttachedStructureShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:tankTop ]
        [ sh:class nltl:iceStringer ]
    ) .

nltl:TRF_047_HorizontalMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:minCount 1 ;
        sh:node nltl:TRF_047_MainFrameShape ;
        sh:message "A horizontal connection member shall connect to an adjacent main frame."
    ] .

nltl:TRF_047_MainFrameShape
    a sh:NodeShape ;
    sh:class nltl:mainFrame .
