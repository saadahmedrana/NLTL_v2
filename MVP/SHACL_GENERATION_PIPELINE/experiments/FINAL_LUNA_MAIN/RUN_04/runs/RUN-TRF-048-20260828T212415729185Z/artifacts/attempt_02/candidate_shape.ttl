@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:AreaCm2Shape
    a sh:NodeShape ;
    sh:node g:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

g:LengthMShape
    a sh:NodeShape ;
    sh:node g:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

g:PressureMPaShape
    a sh:NodeShape ;
    sh:node g:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

g:SectionModulusCm3Shape
    a sh:NodeShape ;
    sh:node g:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
    ] .

g:DimensionlessShape
    a sh:NodeShape ;
    sh:node g:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

g:ShearFactorShape
    a sh:NodeShape ;
    sh:node g:DimensionlessShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minInclusive 2.16 ;
        sh:maxInclusive 2.16
    ] .

g:LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ]
            [ sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition ]
            [ sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition ]
            [ sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition ]
            [ sh:hasValue nltl:twoDeckFrameCondition ]
        )
    ] ;

    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:node g:PressureMPaShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node g:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:node g:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:span ;
        sh:node g:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node g:PressureMPaShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node g:DimensionlessShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:node g:ShearFactorShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node g:DimensionlessShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node g:SectionModulusCm3Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node g:AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:node g:AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:bracketArea ;
        sh:node g:AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:node g:AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:sparql [
        sh:message "For continuous beam with brackets and no significantly different boundary conditions, frameMomentFactorM must equal 13.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType nltl:continuousBeamWithBracketsFrameCondition ;
                      nltl:significantlyDifferentBoundaryConditions false ;
                      nltl:frameMomentFactorM ?mNode .
                ?mNode qudt:numericValue ?m .
                FILTER (?m != 13.3)
            }
        """
    ] ;

    sh:sparql [
        sh:message "With significantly different boundary conditions, frameMomentFactorM must be strictly smaller than 13.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:significantlyDifferentBoundaryConditions true ;
                      nltl:frameMomentFactorM ?mNode .
                ?mNode qudt:numericValue ?m .
                FILTER (?m >= 13.3)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The longitudinal frame load distribution factor must equal 1 - 0.2 times height divided by spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?fNode .
                ?hNode qudt:numericValue ?h .
                ?sNode qudt:numericValue ?s .
                ?fNode qudt:numericValue ?f .
                BIND (1 - (0.2 * ?h / ?s) AS ?expected)
                FILTER (ABS(?f - ?expected) > (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] ;

    sh:sparql [
        sh:message "The section modulus must satisfy the declared frame formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?fNode ;
                      nltl:sectionModulus ?zNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?fNode qudt:numericValue ?f .
                ?zNode qudt:numericValue ?z .
                BIND (?f * ?p * ?h * ?l * ?l / (4 * ?m * ?sigma) * 1000000 AS ?expected)
                FILTER (ABS(?z - ?expected) > (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] ;

    sh:sparql [
        sh:message "The required shear area must satisfy the declared effective shear-area formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?fNode ;
                      nltl:longitudinalFrameShearFactorF5 ?f5Node ;
                      nltl:requiredShearArea ?aNode .
                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?sigmaNode qudt:numericValue ?sigma .
                ?fNode qudt:numericValue ?f .
                ?f5Node qudt:numericValue ?f5 .
                ?aNode qudt:numericValue ?a .
                BIND (1.7320508075688772 * ?f * ?f5 * ?p * ?h * ?l / (2 * ?sigma) * 10000 AS ?expected)
                FILTER (ABS(?a - ?expected) > (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] ;

    sh:sparql [
        sh:message "Actual frame shear area must exclude bracket area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea ?grossNode ;
                      nltl:bracketArea ?bracketNode ;
                      nltl:actualFrameShearArea ?actualNode .
                ?grossNode qudt:numericValue ?gross .
                ?bracketNode qudt:numericValue ?bracket .
                ?actualNode qudt:numericValue ?actual .
                BIND (?gross - ?bracket AS ?expected)
                FILTER (ABS(?actual - ?expected) > (ABS(?expected) * 0.000001 + 0.000000001))
            }
        """
    ] .
