@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-049_FrameShape> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame must be within the ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049_FrameAttachmentShape> ;
        sh:message "The frame must have an effective frame-attachment record."
    ] ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:datatype qudt:QuantityValue ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049_FrameWebThicknessShape>
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:class nltl:supportingStructure
    ] ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:class nltl:supportingStructure
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A longitudinal frame must be attached by a bracket to each represented frame attachment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this a nltl:longitudinalFrame .
                $this nltl:hasFrameAttachment ?attachment .
                FILTER NOT EXISTS {
                    ?attachment nltl:hasConnectionBracket ?bracket .
                    ?bracket a nltl:connectionBracket .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A transverse frame must provide termination information." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:transverseFrame .
                FILTER NOT EXISTS {
                    $this nltl:terminatesAtDeckOrIceStringer ?terminates .
                    FILTER (datatype(?terminates) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When a transverse frame terminates at a deck or ice stringer, each represented attachment must have a bracket or similar construction." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:transverseFrame ;
                    nltl:terminatesAtDeckOrIceStringer true ;
                    nltl:hasFrameAttachment ?attachment .
                FILTER NOT EXISTS {
                    ?attachment nltl:hasConnectionBracket ?bracket .
                    ?bracket a nltl:connectionBracket .
                }
                FILTER NOT EXISTS {
                    ?attachment nltl:similarAttachmentConstructionPresent true .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A frame running through a supporting structure must have both web-plate connection sides connected." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:passesThroughSupportingStructure true .
                FILTER NOT EXISTS {
                    $this nltl:webPlateConnectionSideCount ?count .
                    FILTER (
                        datatype(?count) = xsd:integer &&
                        ?count = 2
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The frame web thickness is required when a connection bracket is installed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket a nltl:connectionBracket .
                FILTER NOT EXISTS {
                    $this nltl:frameWebThickness ?webThickness .
                    ?webThickness qudt:numericValue ?webNumeric ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The connection-bracket thickness must be at least the frame web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment ;
                    nltl:frameWebThickness ?webThickness .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?webThickness qudt:numericValue ?webNumeric ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?bracketThickness qudt:numericValue ?bracketNumeric ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (
                    xsd:decimal(?bracketNumeric) < xsd:decimal(?webNumeric)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-049_FrameAttachmentShape> a sh:NodeShape ;
    sh:class nltl:frameAttachment ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be confirmed as effective."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node <urn:nltl:generated-shape:TRF-049_ConnectionBracketShape>
    ] ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-049_ConnectionBracketShape> a sh:NodeShape ;
    sh:class nltl:connectionBracket ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049_BracketThicknessShape> ;
        sh:message "An installed connection bracket must have a thickness."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened against buckling."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The connection bracket must have buckling stiffening."
    ] .

<urn:nltl:generated-shape:TRF-049_BracketThicknessShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

<urn:nltl:generated-shape:TRF-049_FrameWebThicknessShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
