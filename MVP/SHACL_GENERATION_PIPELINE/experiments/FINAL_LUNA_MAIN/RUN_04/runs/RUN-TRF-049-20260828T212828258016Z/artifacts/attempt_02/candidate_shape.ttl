@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF049_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:node nltl:TRF049_FrameAttachmentShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Within the ice-strengthened area, every represented supporting structure must have a corresponding effective frame attachment with the reverse attachment relationship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                {
                    $this nltl:hasSupportingWebFrame ?supporting .
                }
                UNION
                {
                    $this nltl:hasSupportingBulkhead ?supporting .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?supporting ;
                                nltl:effectiveAttachmentConfirmed true .
                    ?supporting nltl:hasSupportingStructureAttachment ?attachment .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A longitudinal frame must be attached by a bracket to each represented supporting web frame and bulkhead." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:longitudinalFrame .
                {
                    $this nltl:hasSupportingWebFrame ?supporting .
                }
                UNION
                {
                    $this nltl:hasSupportingBulkhead ?supporting .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?supporting ;
                                nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A terminating transverse frame must have a represented attachment fitted with either a connection bracket or a similar attachment construction." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:transverseFrame ;
                      nltl:terminatesAtDeckOrIceStringer true .
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    {
                        ?attachment nltl:hasConnectionBracket ?bracket .
                    }
                    UNION
                    {
                        ?attachment nltl:similarAttachmentConstructionPresent true .
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A frame running through a supporting structure must connect both sides of the web plate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:passesThroughSupportingStructure true .
                FILTER NOT EXISTS {
                    $this nltl:webPlateConnectionSideCount ?count .
                    FILTER (?count = 2)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The bracket thickness must be at least the thickness of the attached frame web." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER (
                    NOT EXISTS {
                        $this nltl:frameWebThickness ?frameThickness .
                        ?frameThickness qudt:numericValue ?frameValue ;
                                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?frameValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?bracket nltl:bracketThickness ?bracketThickness .
                        ?bracketThickness qudt:numericValue ?bracketValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?bracketValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:frameWebThickness ?frameThickness .
                        ?frameThickness qudt:numericValue ?frameValue ;
                                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        ?bracket nltl:bracketThickness ?bracketThickness .
                        ?bracketThickness qudt:numericValue ?bracketValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (
                            datatype(?frameValue) = xsd:decimal &&
                            datatype(?bracketValue) = xsd:decimal &&
                            ?bracketValue < ?frameValue
                        )
                    }
                )
            }
        """
    ] .

nltl:TRF049_FrameAttachmentShape
    a sh:NodeShape ;
    sh:class nltl:frameAttachmentRecord ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:class nltl:connectionBracket
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each frame attachment must be represented from its supporting structure by the corresponding reverse attachment relationship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasAttachedSupportingStructure ?supporting .
                FILTER NOT EXISTS {
                    ?supporting nltl:hasSupportingStructureAttachment $this .
                }
            }
        """
    ] .

nltl:TRF049_ConnectionBracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:node nltl:TRF049_BracketThicknessShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF049_BracketThicknessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
