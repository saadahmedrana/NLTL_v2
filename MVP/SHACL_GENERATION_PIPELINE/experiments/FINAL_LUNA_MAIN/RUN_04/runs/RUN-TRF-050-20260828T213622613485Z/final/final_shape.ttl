@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF050FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAttachment ;
        sh:minCount 1 ;
        sh:node gen:TRF050FrameAttachmentRecordShape ;
        sh:message "Each frame shall have a frame attachment record."
    ] .

gen:TRF050FrameAttachmentRecordShape
    a sh:NodeShape ;
    sh:targetClass nltl:frameAttachmentRecord ;
    sh:property [
        sh:path nltl:frameShellWeldType ;
        sh:minCount 1 ;
        sh:hasValue nltl:doubleContinuousWeld ;
        sh:message "The frame shall be attached to the shell by a double continuous weld."
    ] ;
    sh:or (
        gen:TRF050ButtCrossingShape
        gen:TRF050NoButtCrossingShape
    ) .

gen:TRF050ButtCrossingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shellPlateButtCrossing ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Shell plate butt-crossing applicability shall be recorded."
    ] .

gen:TRF050NoButtCrossingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shellPlateButtCrossing ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "Shell plate butt-crossing applicability shall be recorded."
    ] ;
    sh:property [
        sh:path nltl:scallopingPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "Scalloping is not allowed when shell plate butts are not crossed."
    ] .
