@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF076Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gen:TRF076LoadCaseShape ;
        sh:message "Each linked propeller blade load case must be a valid load case with exactly one integer case number."
    ] ;
    sh:or (
        gen:TRF076CPBranchShape
        gen:TRF076FPNonReversingBranchShape
        gen:TRF076FPReversingBranchShape
    ) .

gen:TRF076LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A propeller blade load case must have exactly one integer load case number."
    ] .

gen:TRF076CPBranchShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "CP"^^xsd:string ;
        sh:message "The propeller type must be CP for this applicability branch."
    ] ;
    sh:sparql [
        sh:message "For a CP propeller, load cases 1 through 4 must all be covered." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case1 .
                        ?case1 nltl:propellerBladeLoadCaseNumber "1"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case2 .
                        ?case2 nltl:propellerBladeLoadCaseNumber "2"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case3 .
                        ?case3 nltl:propellerBladeLoadCaseNumber "3"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case4 .
                        ?case4 nltl:propellerBladeLoadCaseNumber "4"^^xsd:integer .
                    }
                )
            }
        """
    ] .

gen:TRF076FPNonReversingBranchShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP"^^xsd:string ;
        sh:message "The propeller type must be FP for this applicability branch."
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A non-reversing FP propeller must record propeller reversing capability as false."
    ] ;
    sh:sparql [
        sh:message "For a non-reversing FP propeller, load cases 1 through 4 must all be covered." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case1 .
                        ?case1 nltl:propellerBladeLoadCaseNumber "1"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case2 .
                        ?case2 nltl:propellerBladeLoadCaseNumber "2"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case3 .
                        ?case3 nltl:propellerBladeLoadCaseNumber "3"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case4 .
                        ?case4 nltl:propellerBladeLoadCaseNumber "4"^^xsd:integer .
                    }
                )
            }
        """
    ] .

gen:TRF076FPReversingBranchShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP"^^xsd:string ;
        sh:message "The propeller type must be FP for this applicability branch."
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A reversing FP propeller must record propeller reversing capability as true."
    ] ;
    sh:sparql [
        sh:message "For a reversing FP propeller, load cases 1 through 5 must all be covered." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case1 .
                        ?case1 nltl:propellerBladeLoadCaseNumber "1"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case2 .
                        ?case2 nltl:propellerBladeLoadCaseNumber "2"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case3 .
                        ?case3 nltl:propellerBladeLoadCaseNumber "3"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case4 .
                        ?case4 nltl:propellerBladeLoadCaseNumber "4"^^xsd:integer .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case5 .
                        ?case5 nltl:propellerBladeLoadCaseNumber "5"^^xsd:integer .
                    }
                )
            }
        """
    ] .
