@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-082> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hydrodynamicBollardThrust ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When bollard thrust is known, the ship must provide hydrodynamic bollard thrust in kN."
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hydrodynamicBollardThrust ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When bollard thrust is not known, the ship must provide the hydrodynamic bollard thrust taken from the selected Table 6-8 lookup case."
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:node [
                    sh:class nltl:tableLookupCase ;
                    sh:property [
                        sh:path nltl:tableReference ;
                        sh:hasValue nltl:traficomTable6Dash8 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The not-known bollard-thrust branch must select TRAFICOM Table 6-8."
                    ] ;
                    sh:property [
                        sh:path nltl:tableLookupApplied ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:lookupSelectionEvidence ;
                        sh:class nltl:evidenceArtifact ;
                        sh:minCount 1 ;
                        sh:message "Evidence of the Table 6-8 lookup selection is required."
                    ]
                ] ;
                sh:minCount 1 ;
                sh:message "A Table 6-8 lookup case must provide the selected source for hydrodynamic bollard thrust."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The reported hydrodynamic bollard thrust must be represented together with the applied Table 6-8 lookup case when the thrust is not known." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bollardThrustKnown false .
                $this nltl:hydrodynamicBollardThrust ?thrust .
                ?thrust qudt:numericValue ?numericValue .
                ?thrust qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                $this nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash8 .
                ?case nltl:tableLookupApplied true .
            }
        """
    ] .
