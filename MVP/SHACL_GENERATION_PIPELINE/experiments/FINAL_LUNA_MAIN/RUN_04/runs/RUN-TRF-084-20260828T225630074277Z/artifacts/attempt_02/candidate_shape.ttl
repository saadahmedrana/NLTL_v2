@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-084> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:in ( true false ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must have exactly one boolean pitchValueKnown value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with known pitch, propellerPitchAtMcrBollard must be present exactly once as a metre quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:M .
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (?v1 != ?v2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:unit ?u1, ?u2 .
                        FILTER (?u1 != ?u2)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the specified tolerance; both quantities must be singular metre quantities." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false .

                FILTER (
                    NOT EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?b .
                        ?b qudt:numericValue ?bv ;
                           qudt:unit unit:M .
                        $this nltl:propellerPitchAtMcrFreeRunning ?f .
                        ?f qudt:numericValue ?fv ;
                           qudt:unit unit:M .
                        FILTER (
                            ABS(?bv - (0.7 * ?fv)) <=
                            (1e-6 * ABS(0.7 * ?fv))
                            ||
                            ABS(?bv - (0.7 * ?fv)) <= 1e-9
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (?v1 != ?v2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrBollard ?q .
                        ?q qudt:unit ?u1, ?u2 .
                        FILTER (?u1 != ?u2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrFreeRunning ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrFreeRunning ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (?v1 != ?v2)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerPitchAtMcrFreeRunning ?q .
                        ?q qudt:unit ?u1, ?u2 .
                        FILTER (?u1 != ?u2)
                    }
                )
            }
        """
    ] .
