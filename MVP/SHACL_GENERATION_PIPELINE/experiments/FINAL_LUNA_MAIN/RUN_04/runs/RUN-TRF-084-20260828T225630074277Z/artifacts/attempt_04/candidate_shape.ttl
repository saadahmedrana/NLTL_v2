@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF084MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use metres."
    ] .

gen:TRF084ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single propeller type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean pitch-value-known indicator is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "CP" ;
            ] ;
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrBollard ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF084MetreQuantityShape ;
                sh:message "For a CP propeller with known pitch, the bollard-condition MCR pitch is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "CP" ;
            ] ;
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:hasValue false ;
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrBollard ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF084MetreQuantityShape ;
                sh:message "For a CP propeller with unknown pitch, the bollard-condition MCR pitch is required."
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrFreeRunning ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF084MetreQuantityShape ;
                sh:message "For a CP propeller with unknown pitch, the free-running MCR pitch is required."
            ]
        ]
        [
            sh:not [
                sh:property [
                    sh:path nltl:propellerType ;
                    sh:hasValue "CP" ;
                ]
            ]
        ]
    ) .
