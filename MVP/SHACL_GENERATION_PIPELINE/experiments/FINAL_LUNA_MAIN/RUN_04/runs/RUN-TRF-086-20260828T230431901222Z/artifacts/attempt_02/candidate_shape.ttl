@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_086_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with a known pitch value, propellerPitchAtMcrBollard must be supplied as a decimal quantity in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP" ;
                      nltl:pitchValueKnown true .
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must be supplied as a decimal quantity in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP" ;
                      nltl:pitchValueKnown false .
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with an unknown pitch value, propellerPitchAtMcrFreeRunning must be supplied as a decimal quantity in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP" ;
                      nltl:pitchValueKnown false .
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrFreeRunning ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the permitted numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP" ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrBollard ?bollardQuantity ;
                      nltl:propellerPitchAtMcrFreeRunning ?freeRunningQuantity .

                ?bollardQuantity qudt:numericValue ?bollardValue ;
                                  qudt:unit unit:M .
                ?freeRunningQuantity qudt:numericValue ?freeRunningValue ;
                                      qudt:unit unit:M .

                FILTER (
                    datatype(?bollardValue) = xsd:decimal &&
                    datatype(?freeRunningValue) = xsd:decimal
                )

                BIND ((?freeRunningValue * 0.7) AS ?expected)
                BIND ((?expected * 0.000001 + 0.000000001) AS ?tol)

                FILTER (
                    ?bollardValue < (?expected - ?tol) ||
                    ?bollardValue > (?expected + ?tol)
                )
            }
        """
    ] .
