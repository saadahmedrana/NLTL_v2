@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-088-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque must use kN*m."
    ] .

<urn:nltl:generated-shape:TRF-088-MaximumEngineTorqueShape>
    a sh:PropertyShape ;
    sh:path nltl:maximumEngineTorque ;
    sh:node <urn:nltl:generated-shape:TRF-088-QuantityValueShape> ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Maximum engine torque must be recorded when evaluating TRF-088." .

<urn:nltl:generated-shape:TRF-088-TableLookupCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-10 lookup case must be marked as applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash10 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The lookup case must reference TRAFICOM Table 6-10."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The Table 6-10 lookup selection must have evidence."
    ] .

<urn:nltl:generated-shape:TRF-088-KnownBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The maximum engine torque known state must be explicitly true for the known-torque branch."
    ] ;
    sh:property <urn:nltl:generated-shape:TRF-088-MaximumEngineTorqueShape> .

<urn:nltl:generated-shape:TRF-088-UnknownBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The maximum engine torque known state must be explicitly false for the Table 6-10 branch."
    ] ;
    sh:property <urn:nltl:generated-shape:TRF-088-MaximumEngineTorqueShape> ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:node <urn:nltl:generated-shape:TRF-088-TableLookupCaseShape> ;
        sh:minCount 1 ;
        sh:message "When maximum engine torque is unknown, a Table 6-10 lookup case must be recorded."
    ] .

<urn:nltl:generated-shape:TRF-088-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:xone (
        <urn:nltl:generated-shape:TRF-088-KnownBranchShape>
        <urn:nltl:generated-shape:TRF-088-UnknownBranchShape>
    ) .
