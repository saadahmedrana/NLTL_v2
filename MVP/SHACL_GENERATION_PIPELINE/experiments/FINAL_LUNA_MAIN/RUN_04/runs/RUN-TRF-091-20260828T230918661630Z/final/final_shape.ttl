@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF_091_LoadCasePathShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceMillingSequenceCase ;
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                sh:minCount 1 ;
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:loadCasePurpose ;
                    sh:hasValue nltl:stallingAnalysisPurposeValue ;
                ]
            ]
        ] ;
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
    ] ;
    sh:sparql [
        sh:message "The ice-milling sequence case must be the same load case used for propulsion-line strength evaluation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?iceCase .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?iceCase .
                }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "Every propulsion load case represented for this requirement must be the ice-milling sequence case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?propulsionCase .
                FILTER NOT EXISTS {
                    $this nltl:hasIceMillingSequenceCase ?propulsionCase .
                }
            }
        """ ;
    ] .
