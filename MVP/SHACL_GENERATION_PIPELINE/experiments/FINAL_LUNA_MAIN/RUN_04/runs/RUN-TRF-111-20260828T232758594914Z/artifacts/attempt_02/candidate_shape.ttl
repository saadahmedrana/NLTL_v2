@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF111ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ExtremeIceForceQuantityShape ;
        sh:message "The ship shall provide one extreme ice force in kN."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node gs:TRF111LoadCaseShape ;
        sh:message "The ship shall provide an applicable propulsion load case with its load-case type and externally calculated yield safety factor."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node gs:TRF111ShaftLineComponentShape ;
        sh:message "The ship shall identify propeller shaft line components with their externally calculated fatigue safety factors."
    ] .

gs:ExtremeIceForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF111ShaftLineComponentShape
    a sh:NodeShape ;
    sh:class nltl:propellerShaftLineComponent ;
    sh:property [
        sh:path nltl:fatigueSafetyFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:FatigueSafetyFactorShape ;
        sh:message "Each propeller shaft line component shall have a fatigue safety factor of at least 1.5."
    ] .

gs:FatigueSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.5
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF111LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class nltl:shaftLineLoadCaseTypeValue ;
                    sh:hasValue nltl:extremeOperationalLoadCase
                ]
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ExtremeOperationalYieldSafetyFactorShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class nltl:shaftLineLoadCaseTypeValue ;
                    sh:hasValue nltl:fatigueLoadCase
                ]
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:FatigueLoadCaseYieldSafetyFactorShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class nltl:shaftLineLoadCaseTypeValue ;
                    sh:hasValue nltl:bladeFailureLoadCase
                ]
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:BladeFailureYieldSafetyFactorShape
            ]
        ]
    ) ;
    sh:message "The load case shall use an allowed shaft line load-case type and provide the corresponding externally calculated yield safety factor." .

gs:ExtremeOperationalYieldSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:FatigueLoadCaseYieldSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.5
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:BladeFailureYieldSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
