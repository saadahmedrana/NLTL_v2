@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF127Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:TRF127AdditionalPurposeBranch
        gs:TRF127StartingPurposeOnlyBranch
    ) .

gs:TRF127AdditionalPurposeBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:airReceiverCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:additionalPurposeRequiredAirCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "When the air receiver serves an additional purpose, its capacity must be at least the required additional-purpose capacity, with matching units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER NOT EXISTS {
    $this nltl:airReceiverCapacity ?capacityNode .
    ?capacityNode qudt:numericValue ?capacityValue ;
                  qudt:unit ?capacityUnit .
    $this nltl:additionalPurposeRequiredAirCapacity ?requiredNode .
    ?requiredNode qudt:numericValue ?requiredValue ;
                  qudt:unit ?requiredUnit .
    FILTER(?capacityUnit = ?requiredUnit)
    FILTER(?capacityValue >= ?requiredValue)
  }
}
"""
    ] .

gs:TRF127StartingPurposeOnlyBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
