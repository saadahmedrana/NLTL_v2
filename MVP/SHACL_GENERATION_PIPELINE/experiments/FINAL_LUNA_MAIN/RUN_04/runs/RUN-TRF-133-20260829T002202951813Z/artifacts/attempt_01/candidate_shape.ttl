@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF133MarkingShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one permitted ice class."
    ] ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Timber load line mark applicability must be explicitly recorded."
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node gen:IceClassDraughtMarkingShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one conforming ice-class draught marking."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:node gen:WarningTriangleMarkingShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one conforming warning-triangle marking."
    ] ;
    sh:or (
        gen:TimberLoadLineApplicableShape
        gen:TimberLoadLineNotApplicableShape
    ) .

gen:MarkingPlateThicknessShape a sh:PropertyShape ;
    sh:path nltl:markingPlateThickness ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minInclusive "5"^^xsd:decimal ;
            sh:maxInclusive "8"^^xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue unit:MilliM ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The marking plate thickness must be between 5 and 8 mm." .

gen:MarkingCommonShape a sh:NodeShape ;
    sh:property gen:MarkingPlateThicknessShape ;
    sh:property [
        sh:path nltl:markingWeldedToShipSide ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The marking must be welded to the ship side."
    ] ;
    sh:property [
        sh:path nltl:reflectingMarkingColour ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:redReflectingMarkingColour
            nltl:yellowReflectingMarkingColour
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The marking must have a red or yellow reflecting colour."
    ] ;
    sh:property [
        sh:path nltl:markingPlainlyVisibleInIceConditions ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The marking must be plainly visible in ice conditions."
    ] .

gen:IceClassDraughtMarkingShape a sh:NodeShape ;
    sh:node gen:MarkingCommonShape ;
    sh:property [
        sh:path nltl:draughtMarkAftOffset ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "540"^^xsd:decimal ;
                sh:maxInclusive "540"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-class draught mark must be 540 mm abaft its applicable reference point."
    ] ;
    sh:property [
        sh:path nltl:draughtMarkAftReferencePoint ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:loadLineRingCentreReference
            nltl:timberLoadLineVerticalReference
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:letterDimensionsEqualLoadLineMark ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-class draught-mark letters must have the same dimensions as the load line mark."
    ] .

gen:WarningTriangleMarkingShape a sh:NodeShape ;
    sh:node gen:MarkingCommonShape ;
    sh:property [
        sh:path nltl:warningTriangleSideLength ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "300"^^xsd:decimal ;
                sh:maxInclusive "300"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The warning triangle sides must be 300 mm long."
    ] ;
    sh:property [
        sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "1000"^^xsd:decimal ;
                sh:maxInclusive "1000"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The warning triangle upper edge must be 1000 mm above the summer fresh water load line."
    ] ;
    sh:property [
        sh:path nltl:markingAtOrBelowDeckLine ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The warning triangle must not be above the deck line."
    ] ;
    sh:property [
        sh:path nltl:warningTriangleUpperEdgeVerticallyAboveIceMark ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The warning triangle upper edge must be vertically above the ICE mark."
    ] .

gen:TimberLoadLineApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node [
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:hasValue nltl:timberLoadLineVerticalReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When the timber load line mark applies, the draught mark reference must be the timber load line vertical reference."
            ]
        ] ;
        sh:minCount 1
    ] .

gen:TimberLoadLineNotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node [
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:hasValue nltl:loadLineRingCentreReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When the timber load line mark does not apply, the draught mark reference must be the load line ring centre."
            ]
        ] ;
        sh:minCount 1
    ] .
