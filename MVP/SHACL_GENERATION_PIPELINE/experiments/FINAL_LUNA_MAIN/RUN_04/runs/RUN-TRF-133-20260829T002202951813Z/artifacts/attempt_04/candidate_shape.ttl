@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF133ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one permitted Finnish-Swedish ice class."
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:class nltl:iceClassDraughtMarking ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF133IceClassDraughtMarkingShape ;
        sh:message "The ship must have one conforming ice-class draught marking."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:class nltl:warningTriangleMarking ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF133WarningTriangleMarkingShape ;
        sh:message "The ship must have one conforming warning-triangle marking."
    ] ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Timber-load-line applicability must be explicitly recorded."
    ] ;
    sh:or (
        gen:TRF133TimberReferenceBranch
        gen:TRF133NonTimberReferenceBranch
    ) .

gen:TRF133IceClassDraughtMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:draughtMarkAftOffset ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "540"^^xsd:decimal ;
                sh:maxInclusive "540"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ice-class draught mark must be 540 mm abaft its applicable reference."
    ] ;
    sh:property [
        sh:path nltl:letterDimensionsEqualLoadLineMark ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-class draught-mark letters must have the same dimensions as the load-line mark."
    ] ;
    sh:property [
        sh:path nltl:draughtMarkAftReferencePoint ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF133WarningTriangleMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTriangleSideLength ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "300"^^xsd:decimal ;
                sh:maxInclusive "300"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The warning-triangle sides must be 300 mm long."
    ] ;
    sh:property [
        sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "1000"^^xsd:decimal ;
                sh:maxInclusive "1000"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The warning-triangle upper edge must be 1000 mm above the summer fresh-water load line."
    ] ;
    sh:property [
        sh:path nltl:markingAtOrBelowDeckLine ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The warning-triangle marking must not be above the deck line."
    ] ;
    sh:property [
        sh:path nltl:warningTriangleUpperEdgeVerticallyAboveIceMark ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The warning-triangle upper edge must be vertically above the ICE mark."
    ] .

gen:TRF133HullStructureShape
    a sh:NodeShape ;
    sh:targetClass nltl:hullStructure ;
    sh:property [
        sh:path nltl:markingPlateThickness ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "5"^^xsd:decimal ;
                sh:maxInclusive "8"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The marking plate thickness must be between 5 mm and 8 mm."
    ] ;
    sh:property [
        sh:path nltl:markingWeldedToShipSide ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The marks and figures must be welded to the ship side."
    ] ;
    sh:property [
        sh:path nltl:markingPlainlyVisibleInIceConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The marks and figures must be plainly visible in ice conditions."
    ] ;
    sh:property [
        sh:path nltl:reflectingMarkingColour ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:redReflectingMarkingColour
            nltl:yellowReflectingMarkingColour
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The marking must have a red or yellow reflecting colour."
    ] .

gen:TRF133TimberReferenceBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node [
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:hasValue nltl:timberLoadLineVerticalReference ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF133NonTimberReferenceBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node [
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:hasValue nltl:loadLineRingCentreReference ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
