@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A quantity value must contain exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A quantity value must contain exactly one unit."
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG
    ] .

gen:AspectRatioQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:message "The load patch aspect ratio must be exactly 3.6."
    ] .

gen:ApplicableBowFormShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable bow form, buttock angle must be greater than 0 and less than 80 degrees, and normal frame angle must be greater than 10 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:buttockAngle ?g ;
                      nltl:normalFrameAngle ?b .
                ?g qudt:numericValue ?gv ;
                   qudt:unit unit:DEG .
                ?b qudt:numericValue ?bv ;
                   qudt:unit unit:DEG .
                FILTER(
                    ?gv > 0 &&
                    ?gv < 80 &&
                    ?bv > 10
                )
            }
        """
    ] .

gen:NonApplicableBowFormShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A non-applicable bow form must provide angle evidence showing buttock angle is not between 0 and 80 degrees or normal frame angle is not greater than 10 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:buttockAngle ?g ;
                      nltl:normalFrameAngle ?b .
                ?g qudt:numericValue ?gv ;
                   qudt:unit unit:DEG .
                ?b qudt:numericValue ?bv ;
                   qudt:unit unit:DEG .
                FILTER(
                    ?gv <= 0 ||
                    ?gv >= 80 ||
                    ?bv <= 10
                )
            }
        """
    ] .

gen:HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:otherIceStrengthenedArea
            nltl:otherIceStrengthenedAreaValue
        ) ;
        sh:message "The hull area assignment must identify an allowed other ice-strengthened area alternative."
    ] .

gen:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:HullAreaAssignmentShape ;
        sh:message "The ship must have one hull area assignment following the declared assignment path."
    ] ;

    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityShape ;
        sh:message "Average ice pressure is required in MPa."
    ] ;

    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AspectRatioQuantityShape
    ] ;

    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape ;
        sh:message "Non-bow load patch height is required in metres."
    ] ;

    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape ;
        sh:message "Non-bow load patch length is required in metres."
    ] ;

    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        gen:ApplicableBowFormShape
        gen:NonApplicableBowFormShape
    ) .
