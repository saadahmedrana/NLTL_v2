@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_010_DirectStaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowDesignForceMethod ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:bowVerticalSideStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:verticalSidedBowForm ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship assigned Polar Class PC6 or PC7, the design force method, vertical-sided bow indications, and a normal frame angle from 0 to 10 degrees are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc .
                FILTER (
                    ?pc = nltl:polarClassPc6 ||
                    ?pc = nltl:polarClassPc7
                )

                OPTIONAL {
                    $this nltl:bowDesignForceMethod ?method .
                }
                OPTIONAL {
                    $this nltl:bowVerticalSideStatus ?status .
                }
                OPTIONAL {
                    $this nltl:verticalSidedBowForm ?form .
                }
                OPTIONAL {
                    $this nltl:normalFrameAngle ?angleNode .
                    ?angleNode qudt:numericValue ?angleValue .
                    ?angleNode qudt:unit ?angleUnit .
                }

                FILTER (
                    !BOUND(?method) ||
                    !BOUND(?status) ||
                    ?status != true ||
                    !BOUND(?form) ||
                    ?form != true ||
                    !BOUND(?angleNode) ||
                    !BOUND(?angleValue) ||
                    !BOUND(?angleUnit) ||
                    ?angleUnit != qudt:DEG ||
                    ?angleValue < 0 ||
                    ?angleValue > 10
                )
            }
        """
    ] .
