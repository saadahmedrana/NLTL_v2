@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-011> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "A ship must provide a valid Polar Class to determine applicability of I2.3.1(vii)."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "A ship must provide whether a bulbous bow is present to determine applicability of I2.3.1(vii)."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:I2-011-applicable>
        <urn:nltl:generated-shape:I2-011-not-applicable>
    ) .

<urn:nltl:generated-shape:I2-011-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.6"^^xsd:decimal ;
                sh:maxInclusive "0.6"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The shape coefficient used for I2.3.2.1(iii) must be 0.6 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.3"^^xsd:decimal ;
                sh:maxInclusive "1.3"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The load patch aspect ratio used for I2.3.2.1(iii) must be 1.3 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaN ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The I2.3.2.1(iii) bow design force must be supplied in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaN ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The I2.3.2.1(iv) bow design force must be supplied in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloN ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The bow design force must be supplied in kN."
    ] ;
    sh:sparql [
        sh:message "For an applicable PC6 or PC7 ship with a bulbous bow, the reported bow design force must equal the I2.3.2.1(iv) result within tolerance and must not be less than the I2.3.2.1(iii) result." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowDesignForce ?reportedNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?partIiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?partIvNode .

                ?reportedNode qudt:numericValue ?reported .
                ?partIiiNode qudt:numericValue ?partIii .
                ?partIvNode qudt:numericValue ?partIv .

                FILTER (
                    (?reported < ?partIii)
                    ||
                    !(
                        (?partIv > 0 &&
                         ?reported >= (?partIv - (?partIv * 0.000001)) &&
                         ?reported <= (?partIv + (?partIv * 0.000001)))
                        ||
                        (?partIv < 0 &&
                         ?reported >= (?partIv - ((0 - ?partIv) * 0.000001)) &&
                         ?reported <= (?partIv + ((0 - ?partIv) * 0.000001)))
                        ||
                        (?partIv = 0 &&
                         ?reported >= -0.000001 &&
                         ?reported <= 0.000001)
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-011-not-applicable> a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
    ) .
