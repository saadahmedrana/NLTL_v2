@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-011-BowDesignForce>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "polarClass must be recorded using a permitted Polar Class value."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "bulbousBowPresent must be recorded to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "bowDesignForce must be supplied as a single force quantity in kN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The I2.3.2.1(iii) bow-force operand must be supplied in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The I2.3.2.1(iv) bow-force operand must be supplied in MN."
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 0.6 ;
                sh:maxInclusive 0.6
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "shapeCoefficient must equal the required fa value of 0.6."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 1.3 ;
                sh:maxInclusive 1.3
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "loadPatchAspectRatio must equal the required AR value of 1.3."
    ] ;
    sh:sparql [
        sh:message "For PC6 or PC7 ships with bulbous bows, bowDesignForce must match the I2.3.2.1(iv) force within the permitted tolerance and must not be less than the I2.3.2.1(iii) force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:bulbousBowPresent true ;
                      nltl:bowDesignForce ?reportedNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?minimumNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?expectedNode .

                ?reportedNode qudt:numericValue ?reported ;
                              qudt:unit unit:KiloN .
                ?minimumNode qudt:numericValue ?minimum ;
                              qudt:unit unit:MegaN .
                ?expectedNode qudt:numericValue ?expected ;
                              qudt:unit unit:MegaN .

                FILTER (
                    ?polarClass IN (nltl:polarClassPc6, nltl:polarClassPc7)
                )

                FILTER (
                    (?reported < (?minimum * 1000))
                    ||
                    (
                        (?expected >= 1.0)
                        &&
                        (
                            ?reported < ((?expected * 1000) - ((?expected * 1000) * 0.000001))
                            ||
                            ?reported > ((?expected * 1000) + ((?expected * 1000) * 0.000001))
                        )
                    )
                    ||
                    (
                        (?expected < 1.0)
                        &&
                        (
                            ?reported < ((?expected * 1000) - 0.000001)
                            ||
                            ?reported > ((?expected * 1000) + 0.000001)
                        )
                    )
                )
            }
        """
    ] .
