@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:I2_019_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:or (
                nltlg:I2_019_ApplicableMemberShape
                nltlg:I2_019_NonApplicableMemberShape
            )
        ]
    ] .

nltlg:I2_019_ApplicableMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:minCount 1 ;
        sh:node nltlg:I2_019_HullAreaValueShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:I2_019_QuantityShape
    ] ;
    sh:sparql [
        sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor among the member's spanned hull areas within the permitted numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this (MAX(?factorValue) AS ?maximumFactor)
                    WHERE {
                        $this nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factor .
                        ?factor qudt:numericValue ?factorValue .
                    }
                    GROUP BY $this
                }
                $this nltl:selectedHullAreaFactor ?selectedFactor .
                ?selectedFactor qudt:numericValue ?selectedValue .
                FILTER (
                    ABS(?selectedValue - ?maximumFactor) >
                    (ABS(?maximumFactor) * 0.000001 + 0.000000000001)
                )
            }
        """
    ] .

nltlg:I2_019_NonApplicableMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:maxCount 0
    ] .

nltlg:I2_019_HullAreaValueShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:I2_019_QuantityShape
    ] .

nltlg:I2_019_QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
