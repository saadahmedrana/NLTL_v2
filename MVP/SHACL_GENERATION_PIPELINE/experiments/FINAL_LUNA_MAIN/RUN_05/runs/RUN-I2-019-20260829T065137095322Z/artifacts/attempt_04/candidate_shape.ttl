@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:HullAreaValueShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:I2_019_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasSpannedHullArea ;
                        sh:minCount 1 ;
                        sh:node gen:HullAreaValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:selectedHullAreaFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:sparql [
                        sh:message "selectedHullAreaFactor must equal the maximum hullAreaFactor over all spanned hull areas within relative tolerance 1e-6, with an absolute fallback of 1e-12." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                            SELECT $this
                            WHERE {
                                $this nltl:hasSpannedHullArea ?area ;
                                      nltl:selectedHullAreaFactor ?selected .
                                ?area nltl:hullAreaFactor ?factor .
                                ?factor qudt:numericValue ?expected .
                                ?selected qudt:numericValue ?actual .
                                FILTER NOT EXISTS {
                                    $this nltl:hasSpannedHullArea ?otherArea .
                                    ?otherArea nltl:hullAreaFactor ?otherFactor .
                                    ?otherFactor qudt:numericValue ?greater .
                                    FILTER (?greater > ?expected)
                                }
                                FILTER (
                                    ABS(?actual - ?expected) >
                                    IF(
                                        ABS(?expected) > "0"^^xsd:decimal,
                                        0.000001 * ABS(?expected),
                                        0.000000000001
                                    )
                                )
                            }
                        """
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasSpannedHullArea ;
                        sh:maxCount 0
                    ] ;
                    sh:property [
                        sh:path nltl:selectedHullAreaFactor ;
                        sh:maxCount 0
                    ]
                ]
            )
        ]
    ] .
