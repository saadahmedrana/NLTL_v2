@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:ShellPlateThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node nltlgen:PlatingThicknessShape
    ] .

nltlgen:PlatingThicknessShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAllowance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:thickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "thickness must equal (iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance) converted from millimetres to metres, within a relative tolerance of 1e-6 and an absolute fallback tolerance of 1e-9" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?tnetNode ;
                      nltl:corrosionAbrasionAllowance ?allowanceNode ;
                      nltl:thickness ?thicknessNode .

                ?tnetNode qudt:numericValue ?tnet ;
                           qudt:unit unit:MilliM .
                ?allowanceNode qudt:numericValue ?allowance ;
                               qudt:unit unit:MilliM .
                ?thicknessNode qudt:numericValue ?actual ;
                               qudt:unit unit:M .

                BIND((?tnet + ?allowance) / 1000 AS ?expected)
                BIND(ABS(?actual - ?expected) AS ?difference)

                FILTER (
                    ?difference > (0.000001 * ABS(?expected))
                    && ?difference > 0.000000001
                )
            }
        """
    ] .
