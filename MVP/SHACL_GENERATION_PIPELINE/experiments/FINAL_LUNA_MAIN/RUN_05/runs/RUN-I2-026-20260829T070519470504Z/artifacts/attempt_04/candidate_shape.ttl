@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_026_StructuralMemberShape
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:node gen:I2_026_MemberSupportShape
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:frameSupportConditionValue ;
        sh:or (
            [ sh:hasValue nltl:fixedFrameSupport ]
            [ sh:hasValue nltl:simpleFrameSupport ]
        ) ;
        sh:message "Each structural member must declare exactly one permitted frame support condition."
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Continuity through a support requires fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:continuousThroughSupport ?continuous ;
                      nltl:frameSupportCondition ?condition .
                FILTER (?continuous = true && ?condition != nltl:fixedFrameSupport)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A connection bracket at a support requires fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support ;
                      nltl:frameSupportCondition ?condition .
                ?support nltl:connectionBracketPresent ?bracket .
                FILTER (?bracket = true && ?condition != nltl:fixedFrameSupport)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A member terminating within an ice-strengthened area requires fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:terminatesWithinIceStrengthenedArea ?terminates ;
                      nltl:frameSupportCondition ?condition .
                FILTER (?terminates = true && ?condition != nltl:fixedFrameSupport)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Demonstrated significant rotational restraint requires fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support ;
                      nltl:frameSupportCondition ?condition .
                ?support nltl:demonstratedRotationalRestraint ?restraint .
                FILTER (?restraint = true && ?condition != nltl:fixedFrameSupport)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Demonstrated significant rotational restraint requires evidence on the structural member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:demonstratedRotationalRestraint ?restraint .
                FILTER (?restraint = true)
                FILTER NOT EXISTS {
                    $this nltl:significantRotationalRestraintEvidence ?evidence .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Simple frame support is required when no fixed-support condition applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameSupportCondition ?condition .
                FILTER (?condition != nltl:simpleFrameSupport)
                FILTER NOT EXISTS {
                    $this nltl:continuousThroughSupport ?continuous .
                    FILTER (?continuous = true)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasMemberSupport ?support .
                    ?support nltl:connectionBracketPresent ?bracket .
                    FILTER (?bracket = true)
                }
                FILTER NOT EXISTS {
                    $this nltl:hasMemberSupport ?support .
                    ?support nltl:demonstratedRotationalRestraint ?restraint .
                    FILTER (?restraint = true)
                }
                FILTER NOT EXISTS {
                    $this nltl:terminatesWithinIceStrengthenedArea ?terminates .
                    FILTER (?terminates = true)
                }
            }
        """
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:class nltl:memberSupport ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean
    ] .
