                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolationUpperEndpoint ;
                sh:class nltl:interpolationPoint ;
                sh:node [
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The local-frame calculation case must identify the same structural member reached from the ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCaseStructuralMember ?identifiedMember .
                FILTER (?identifiedMember != ?member)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The plastic neutral axis height is required when the local-frame area exceeds the attached-plate-flange area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:hasCalculationCase ?case .
                ?member nltl:netLocalFrameFlangeArea ?areaValue ;
                        nltl:netAttachedShellPlateThickness ?thicknessValue ;
                        nltl:frameSpacing ?spacingValue .
                ?areaValue qudt:numericValue ?area .
                ?thicknessValue qudt:numericValue ?thickness .
                ?spacingValue qudt:numericValue ?spacing .
                FILTER (
                    100 * ?area > 1000 * ?thickness * ?spacing &&
                    NOT EXISTS {
                        ?case nltl:plasticNeutralAxisHeight ?z
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Both interpolation endpoints are required for oblique framing angles strictly between 20 and 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:hasCalculationCase ?case .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?angleValue .
                ?angleValue qudt:numericValue ?angle .
                FILTER (
                    ?angle > 20 &&
                    ?angle < 70 &&
                    (
                        NOT EXISTS {
                            ?case nltl:interpolationLowerEndpoint ?lower
                        } ||
                        NOT EXISTS {
                            ?case nltl:interpolationUpperEndpoint ?upper
                        }
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Interpolation endpoints may be used only for oblique framing angles strictly between 20 and 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:hasCalculationCase ?case .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?angleValue .
                ?angleValue qudt:numericValue ?angle .
                ?case (nltl:interpolationLowerEndpoint|nltl:interpolationUpperEndpoint) ?endpoint .
                FILTER (?angle <= 20 || ?angle >= 70)
            }
        """
    ] .

<urn:nltl:generated-shape:I2-030-ComplexReadinessShape> a sh:NodeShape .
<urn:nltl:generated-shape:I2-030-ComplexReadinessShape> sh:targetClass nltl:ship .
<urn:nltl:generated-shape:I2-030-ComplexReadinessShape> sh:closed false .
<urn:nltl:generated-shape:I2-030-ComplexReadinessShape> sh:deactivated false .
<urn:nltl:generated-shape:I2-030-ComplexReadinessShape> sh:message "Complex readiness requirements for I2-030 are not satisfied." .
