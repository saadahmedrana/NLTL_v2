@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-031> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:message "The ship must identify its frame profile type."
    ] ;
    sh:property [
        sh:path nltl:patchLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide the patch load as a single kilonewton quantity."
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify the plastic collapse mechanism."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable local frame must have a structural-member load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation ?location .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    ?location = nltl:sideStructureLocation
                )
                FILTER NOT EXISTS {
                    ?member nltl:hasStructuralMemberLoadCase ?loadCase
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable local frame must provide plastic strength and the corresponding midspan plastic-collapse load as kilonewton quantities." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    ?location = nltl:sideStructureLocation
                )
                FILTER (
                    NOT EXISTS {
                        ?member nltl:plasticStrength ?strength .
                        ?strength qudt:numericValue ?strengthValue ;
                                 qudt:unit qudt:KiloN .
                        FILTER (datatype(?strengthValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?midspanLoad .
                        ?midspanLoad qudt:numericValue ?midspanValue ;
                                     qudt:unit qudt:KiloN .
                        FILTER (datatype(?midspanValue) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The patch-load orientation must be stated for each applicable load case; bottom members require the parallel orientation and side members require transverse-frame evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    ?location = nltl:sideStructureLocation
                )
                FILTER (
                    (
                        ?location = nltl:bottomStructureLocation &&
                        NOT EXISTS {
                            ?loadCase nltl:loadPatchOrientation
                                nltl:loadPatchHeightParallelToFrame
                        }
                    ) ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        (
                            NOT EXISTS {
                                ?member nltl:transverseFrameOrientation ?orientation
                            } ||
                            EXISTS {
                                ?member nltl:transverseFrameOrientation ?orientation
                                FILTER (?orientation != true)
                            }
                        )
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For each applicable member and its paired load case, combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan load within a relative tolerance of 1e-6 with an absolute fallback of 1e-9 kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase ;
                        nltl:plasticStrength ?strength ;
                        nltl:midspanPlasticCollapseLoad ?midspanLoad .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?strength qudt:numericValue ?strengthValue ;
                         qudt:unit qudt:KiloN .
                ?midspanLoad qudt:numericValue ?midspanValue ;
                             qudt:unit qudt:KiloN .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit qudt:KiloN .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    ?location = nltl:sideStructureLocation
                )
                FILTER (
                    ?demandValue > ?strengthValue ||
                    ABS(?strengthValue - ?midspanValue) >
                    IF(
                        ABS(?midspanValue) * 0.000001 > 0.000000001,
                        ABS(?midspanValue) * 0.000001,
                        0.000000001
                    )
                )
            }
        """
    ] .
