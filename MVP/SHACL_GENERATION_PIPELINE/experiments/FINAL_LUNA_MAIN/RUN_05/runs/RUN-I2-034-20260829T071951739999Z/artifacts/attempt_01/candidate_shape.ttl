@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-034-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-034-StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each represented structural member must provide its longitudinal-frame orientation."
    ] ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:message "Each represented structural member must provide its structural location."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:longitudinalFrameOrientation ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:hasValue nltl:sideStructureLocation
            ] ;
            sh:property [
                sh:path nltl:plasticStrength ;
                sh:node <urn:nltl:generated-shape:I2-034-KiloNewtonQuantityShape> ;
                sh:minCount 1 ;
                sh:message "An applicable longitudinal side frame must provide its plastic strength."
            ] ;
            sh:property [
                sh:path nltl:midspanPlasticCollapseLoad ;
                sh:node <urn:nltl:generated-shape:I2-034-KiloNewtonQuantityShape> ;
                sh:minCount 1 ;
                sh:message "An applicable longitudinal side frame must provide its midspan plastic-collapse load."
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:node <urn:nltl:generated-shape:I2-034-LoadCaseShape>
            ]
        ]
        [
            sh:sparql [
                sh:message "A structural member is applicable only when it is longitudinal and located in the side structure." ;
                sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#>\n\nSELECT $this\nWHERE {\n    $this nltl:longitudinalFrameOrientation ?orientation .\n    $this nltl:structuralLocation ?location .\n    FILTER (?orientation = false ||\n            ?location != nltl:sideStructureLocation)\n}\n"
            ]
        ]
    ) .

<urn:nltl:generated-shape:I2-034-LoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node <urn:nltl:generated-shape:I2-034-DemandQuantityShape> ;
        sh:minCount 1 ;
        sh:message "Each represented load case must provide the combined shear-and-bending demand."
    ] ;
    sh:sparql [
        sh:message "The combined shear-and-bending demand must not exceed the member plastic strength or midspan plastic-collapse load." ;
        sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#>\nPREFIX q: <http://qudt.org/schema/qudt/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT $this\nWHERE {\n    $this nltl:combinedShearAndBendingDemand ?demand .\n    ?demand q:numericValue ?demandValue .\n    FILTER (DATATYPE(?demandValue) = xsd:decimal)\n\n    ?member nltl:hasStructuralMemberLoadCase $this .\n    ?member nltl:plasticStrength ?strength .\n    ?strength q:numericValue ?strengthValue .\n    FILTER (DATATYPE(?strengthValue) = xsd:decimal)\n\n    ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .\n    ?collapseLoad q:numericValue ?collapseValue .\n    FILTER (DATATYPE(?collapseValue) = xsd:decimal)\n\n    FILTER (?demandValue > ?strengthValue ||\n            ?demandValue > ?collapseValue)\n}\n"
    ] .

<urn:nltl:generated-shape:I2-034-DemandQuantityShape>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The combined demand must have a decimal numeric value."
    ] .

<urn:nltl:generated-shape:I2-034-KiloNewtonQuantityShape>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The plastic-strength quantity must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The plastic-strength quantity must use kN as its unit."
    ] .
