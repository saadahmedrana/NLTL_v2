@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:steelGradeRequirementCasePlating ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:plating ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:tableReferenceValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iacsUrI2Table8
            ] ;
            sh:property [
                sh:path nltl:asBuiltPlateThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    a sh:NodeShape ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:nodeKind sh:IRI ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:steelMaterialClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelMaterialClassValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:steelMaterialClassOne
                    nltl:steelMaterialClassTwo
                    nltl:steelMaterialClassThree
                )
            ] ;
            sh:property [
                sh:path nltl:steelStrengthCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelStrengthCategoryValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:normalStrengthSteelCategory
                    nltl:highTensileSteelCategory
                )
            ] ;
            sh:property [
                sh:path nltl:actualHullStructuralSteelGrade ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelGradeValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:steelGradeAh
                    nltl:steelGradeB
                    nltl:steelGradeD
                    nltl:steelGradeDh
                    nltl:steelGradeE
                    nltl:steelGradeEh
                    nltl:steelGradeFh
                )
            ] ;
            sh:property [
                sh:path nltl:requiredHullStructuralSteelGrade ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelGradeValue ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:steelGradeAh
                    nltl:steelGradeB
                    nltl:steelGradeD
                    nltl:steelGradeDh
                    nltl:steelGradeE
                    nltl:steelGradeEh
                    nltl:steelGradeFh
                )
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The steel-grade table selection, applicability, grade family, or rank comparison is non-conforming." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?thicknessNode ;
        nltl:steelMaterialClass ?material ;
        nltl:steelStrengthCategory ?category ;
        nltl:actualHullStructuralSteelGrade ?actual .
  ?thicknessNode qudt:numericValue ?t ;
                 qudt:unit <http://qudt.org/vocab/unit/MilliM> .
  ?actual nltl:steelGradeOrderRank ?actualRank .

  OPTIONAL {
    $this nltl:requiredHullStructuralSteelGrade ?required .
    ?required nltl:steelGradeOrderRank ?requiredRank .
  }

  BIND(
    IF(?t <= 10,
      IF(?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo),
        1,
        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1)
      ),
      IF(?t <= 25,
        IF(?material = nltl:steelMaterialClassOne,
          1,
          IF(?material = nltl:steelMaterialClassTwo,
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2)
          )
        ),
        IF(?t <= 35,
          IF(?material = nltl:steelMaterialClassOne,
            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
            IF(?material = nltl:steelMaterialClassTwo,
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1)
            )
          ),
          IF(?t <= 45,
            IF(?material = nltl:steelMaterialClassOne,
              2,
              IF(?material = nltl:steelMaterialClassTwo,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3),
                  IF(?category = nltl:normalStrengthSteelCategory, 0, 4),
                  3
                )
              )
            ),
            IF(?t <= 50,
              IF(?material = nltl:steelMaterialClassOne,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                IF(?material = nltl:steelMaterialClassTwo,
                  IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                  IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
                    IF(?category = nltl:normalStrengthSteelCategory,
                      IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), 0, 0),
                      4
                    ),
                    3
                  )
                )
              ),
              0
            )
          )
        )
      )
    ) AS ?expectedRank
  )

  FILTER (
    ?t <= 0 ||
    ?t > 50 ||
    (?expectedRank = 0 && BOUND(?required)) ||
    (?expectedRank > 0 && (
      !BOUND(?required) ||
      ?requiredRank != ?expectedRank ||
      (
        ?category = nltl:normalStrengthSteelCategory &&
        (
          ?actual NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          ) ||
          ?required NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          )
        )
      ) ||
      (
        ?category = nltl:highTensileSteelCategory &&
        (
          ?actual NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          ) ||
          ?required NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          )
        )
      ) ||
      ?actualRank < ?requiredRank
    ))
  )
}
"""
            ]
        ]
    ] .
