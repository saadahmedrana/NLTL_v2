@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "The ship must have exactly one permitted Polar Class."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:class nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must identify exactly one plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-048-ThicknessQuantityShape> ;
        sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:message "Each case must specify exactly one permitted steel material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:message "Each case must specify exactly one permitted steel strength category."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:node <urn:nltl:generated-shape:I2-048-GradeValueShape> ;
        sh:message "Each case must provide exactly one permitted actual hull structural steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:node <urn:nltl:generated-shape:I2-048-GradeValueShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The exact Table 8 selection is missing, has an incorrect required grade, or supplies a grade for a NOT_APPLICABLE combination." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?thicknessNode ;
                      nltl:steelMaterialClass ?material ;
                      nltl:steelStrengthCategory ?category .
                ?thicknessNode qudt:numericValue ?t ;
                               qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                       nltl:polarClass ?polar .
                OPTIONAL { $this nltl:requiredHullStructuralSteelGrade ?req . }

                BIND(
                    IF(?category = nltl:highTensileSteelCategory,
                       nltl:steelGradeAh,
                       nltl:steelGradeB) AS ?gradeA
                )
                BIND(
                    IF(?category = nltl:highTensileSteelCategory,
                       nltl:steelGradeDh,
                       nltl:steelGradeD) AS ?gradeD
                )
                BIND(
                    IF(?category = nltl:highTensileSteelCategory,
                       nltl:steelGradeEh,
                       nltl:steelGradeE) AS ?gradeE
                )
                BIND(
                    (?polar IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3
                    )) AS ?pc13
                )
                BIND(
                    (?polar IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5
                    )) AS ?pc15
                )
                BIND(
                    (?material = nltl:steelMaterialClassThree &&
                     (
                       (?t > 35 && ?t <= 45 && ?pc13) ||
                       (?t > 45 && ?t <= 50 && ?pc15)
                     )) AS ?notApplicable
                )
                BIND(
                    IF(
                        ?notApplicable,
                        $this,
                        IF(
                            ?t <= 10,
                            IF(
                                ?material = nltl:steelMaterialClassThree && ?pc15,
                                ?gradeE,
                                IF(
                                    ?material = nltl:steelMaterialClassThree,
                                    ?gradeA,
                                    IF(
                                        ?category = nltl:highTensileSteelCategory,
                                        nltl:steelGradeAh,
                                        nltl:steelGradeB
                                    )
                                )
                            ),
                            IF(
                                ?t <= 25,
                                IF(
                                    ?material = nltl:steelMaterialClassThree && ?pc15,
                                    ?gradeE,
                                    IF(
                                        ?material = nltl:steelMaterialClassThree,
                                        ?gradeD,
                                        IF(
                                            ?pc15,
                                            ?gradeD,
                                            IF(
                                                ?category = nltl:highTensileSteelCategory,
                                                nltl:steelGradeAh,
                                                nltl:steelGradeB
                                            )
                                        )
                                    )
                                ),
                                IF(
                                    ?t <= 35,
                                    IF(
                                        ?material = nltl:steelMaterialClassOne,
                                        IF(
                                            ?pc15,
                                            ?gradeD,
                                            IF(
                                                ?category = nltl:highTensileSteelCategory,
                                                nltl:steelGradeAh,
                                                nltl:steelGradeB
                                            )
                                        ),
                                        ?gradeE
                                    ),
                                    IF(
                                        ?material = nltl:steelMaterialClassOne,
                                        ?gradeD,
                                        IF(
                                            ?material = nltl:steelMaterialClassTwo && ?pc15,
                                            ?gradeE,
                                            IF(
                                                ?material = nltl:steelMaterialClassTwo,
                                                ?gradeD,
                                                ?gradeE
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    ) AS ?expected
                )

                FILTER(
                    (?t > 50) ||
                    (?notApplicable && BOUND(?req)) ||
                    (!?notApplicable && !BOUND(?req)) ||
                    (!?notApplicable && BOUND(?req) && ?req != ?expected)
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual and required grades must belong to the selected steel strength category, and the actual grade rank must be at least the required grade rank." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualHullStructuralSteelGrade ?actual ;
                      nltl:requiredHullStructuralSteelGrade ?required ;
                      nltl:steelStrengthCategory ?category .
                ?actual nltl:steelGradeOrderRank ?actualRank .
                ?required nltl:steelGradeOrderRank ?requiredRank .

                FILTER(
                    (
                        ?category = nltl:normalStrengthSteelCategory &&
                        ?actual IN (
                            nltl:steelGradeAh,
                            nltl:steelGradeDh,
                            nltl:steelGradeEh,
                            nltl:steelGradeFh
                        )
                    ) ||
                    (
                        ?category = nltl:highTensileSteelCategory &&
                        ?actual IN (
                            nltl:steelGradeB,
                            nltl:steelGradeD,
                            nltl:steelGradeE
                        )
                    ) ||
                    (
                        ?actualRank < ?requiredRank
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-048-ThicknessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

<urn:nltl:generated-shape:I2-048-GradeValueShape>
    a sh:NodeShape ;
    sh:class nltl:steelGradeValue ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
