@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix urn: <urn:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

urn:nltl:generated-shape:I2_051_QuantityMN
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

urn:nltl:generated-shape:I2_051_QuantityKN
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

urn:nltl:generated-shape:I2_051_QuantityM
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

urn:nltl:generated-shape:I2_051_QuantityUnitless
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

urn:nltl:generated-shape:I2_051_CalculationCase
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node urn:nltl:generated-shape:I2_051_QuantityM
    ] ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node urn:nltl:generated-shape:I2_051_QuantityUnitless
    ] ;
    sh:property [
        sh:path nltl:shearForceDirection ;
        sh:hasValue nltl:positiveShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The longitudinal distribution factor must be 0.0 from the aft end through 0.6 LUI and 1.0 from 0.9 LUI through the forward end." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity ;
                      nltl:longitudinalDistributionFactor ?factorQuantity .
                ?positionQuantity qudt:numericValue ?position .
                ?factorQuantity qudt:numericValue ?factor .
                ?ship nltl:hasCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?lengthQuantity .
                ?lengthQuantity qudt:numericValue ?length .
                FILTER (
                    (?position >= 0 && ?position <= (0.6 * ?length) && ?factor != 0.0) ||
                    (?position >= (0.9 * ?length) && ?position <= ?length && ?factor != 1.0)
                )
            }
        """
    ] .

urn:nltl:generated-shape:I2_051_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node urn:nltl:generated-shape:I2_051_QuantityM
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node urn:nltl:generated-shape:I2_051_QuantityMN
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node urn:nltl:generated-shape:I2_051_QuantityKN
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node urn:nltl:generated-shape:I2_051_CalculationCase
    ] ;
    sh:sparql [
        sh:message "The design vertical ice shear force must equal the longitudinal distribution factor times the design vertical ice force at bow, with MN converted to kN and a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?bowQuantity ;
                      nltl:designVerticalIceShearForce ?shearQuantity ;
                      nltl:hasCalculationCase ?case .
                ?bowQuantity qudt:numericValue ?bowMN .
                ?shearQuantity qudt:numericValue ?shearKN .
                ?case nltl:longitudinalDistributionFactor ?factorQuantity .
                ?factorQuantity qudt:numericValue ?factor .
                BIND (?factor * ?bowMN * 1000.0 AS ?expectedKN)
                BIND (?shearKN - ?expectedKN AS ?difference)
                FILTER (
                    ABS(?difference) >
                    IF(
                        0.000001 > ABS(?expectedKN) * 0.000001,
                        0.000001,
                        ABS(?expectedKN) * 0.000001
                    )
                )
            }
        """
    ] .
