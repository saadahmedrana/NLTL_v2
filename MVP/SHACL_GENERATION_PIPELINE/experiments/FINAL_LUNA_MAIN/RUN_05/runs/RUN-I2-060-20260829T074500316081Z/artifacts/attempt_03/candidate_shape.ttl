@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:class nltl:cutout ;
                sh:message "A linked structural member must identify its cutout as a nltl:cutout."
            ] ;
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:datatype xsd:boolean
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:memberInstability ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER (
        NOT EXISTS {
            $this nltl:memberInstability ?instability .
            FILTER (
                datatype(?instability) = xsd:boolean &&
                ?instability = "false"^^xsd:boolean
            )
        }
        ||
        EXISTS {
            $this nltl:memberInstability ?instabilityTrue .
            FILTER (
                datatype(?instabilityTrue) = xsd:boolean &&
                ?instabilityTrue = "true"^^xsd:boolean
            )
        }
    )
}
""" ;
        sh:message "A member linked to a cutout requires exactly a non-contradictory explicitly typed false nltl:memberInstability value on the ship."
    ] ;
    sh:sparql [
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    ?member nltl:stiffeningNecessary ?necessary .
    FILTER (
        datatype(?necessary) = xsd:boolean &&
        ?necessary = "true"^^xsd:boolean
    )
    FILTER NOT EXISTS {
        $this nltl:structuralStiffening ?stiffening .
        FILTER (
            datatype(?stiffening) = xsd:string &&
            STRLEN(STR(?stiffening)) > 0
        )
    }
}
""" ;
        sh:message "When stiffening is necessary for a member in way of a cutout, the ship must provide a nonempty nltl:structuralStiffening value."
    ] .
