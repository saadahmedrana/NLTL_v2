@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:node gs:CalculationCaseShape ;
        sh:message "Each supplied calculation case must follow the prescribed analytical procedure model."
    ] .

gs:CalculationCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationCaseAssessedHullStructure ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:hullStructure ;
        sh:node gs:AssessedHullStructureShape ;
        sh:minCount 1 ;
        sh:message "A calculation case must identify its assessed hull structure."
    ] ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:prescribedAnalyticalProcedure ;
        sh:minCount 1 ;
        sh:message "An applicable calculation case must use the prescribed analytical procedure."
    ] ;
    sh:sparql [
        sh:message "Direct calculations must not be used as an alternative to the prescribed analytical procedure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:directCalculationMethodValue .
            }
        """
    ] .

gs:AssessedHullStructureShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:thickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:node gs:ThicknessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assessed hull structure must provide its thickness."
    ] .

gs:ThicknessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Thickness must be expressed in metres."
    ] .
