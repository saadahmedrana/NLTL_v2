@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gs:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:class nltl:calculationMethodValue ;
                sh:hasValue nltl:linearCalculationMethodValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:hasStructuralMemberWeb ;
                sh:node [
                    sh:class nltl:structuralMemberWeb
                ]
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMemberFlange ;
                sh:node [
                    sh:class nltl:structuralMemberFlange
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Nominal shear stress must be less than yield strength divided by sqrt(3) for the linear calculation method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                ?this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb ?web .
                ?web nltl:nominalShearStress ?shearQuantity .
                ?shearQuantity qudt:numericValue ?shearValue .
                FILTER (?shearValue >= (?yieldValue / 1.7320508075688772))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Nominal flange von Mises stress must be less than 1.15 times yield strength for the linear calculation method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                ?this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange ?flange .
                ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue .
                FILTER (?stressValue >= (1.15 * ?yieldValue))
            }
        """
    ] .

gs:StructuralMemberWebShape a sh:NodeShape ;
    sh:targetClass nltl:structuralMemberWeb ;
    sh:class nltl:hullStructure ;
    sh:property [
        sh:path nltl:nominalShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Applicable web structure must declare satisfied buckling criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb $this .
                ?ship nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:bucklingCriteriaSatisfied true
                }
            }
        """
    ] .

gs:StructuralMemberFlangeShape a sh:NodeShape ;
    sh:targetClass nltl:structuralMemberFlange ;
    sh:class nltl:hullStructure ;
    sh:property [
        sh:path nltl:nominalFlangeVonMisesStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Applicable flange structure must declare satisfied buckling criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange $this .
                ?ship nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:bucklingCriteriaSatisfied true
                }
            }
        """
    ] .
