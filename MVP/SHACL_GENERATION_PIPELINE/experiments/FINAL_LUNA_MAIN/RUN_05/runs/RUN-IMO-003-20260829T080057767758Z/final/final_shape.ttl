@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-003-ShipDesignIceConditionCategory>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its design ice condition so the Category C applicability branch can be determined."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship designed for open water or ice conditions less severe than categories A and B must have ship category C, with no conflicting category value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER (
                    ?condition = nltl:openWaterIceCondition ||
                    ?condition = nltl:iceConditionLessSevereThanCategoryAAndB
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    } ||
                    EXISTS {
                        $this nltl:shipCategory ?otherCategory .
                        FILTER (?otherCategory != nltl:polarShipCategoryC)
                    }
                )
            }
        """
    ] .
