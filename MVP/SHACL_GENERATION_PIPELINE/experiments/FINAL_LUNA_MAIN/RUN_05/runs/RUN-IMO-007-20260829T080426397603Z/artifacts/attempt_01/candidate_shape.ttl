@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_007_StaticShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide one ice condition classification to determine whether the open-water condition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the ice condition is open water, sea ice concentration must be a unitless decimal less than 1 and ice of land origin must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER (
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?quantity .
                        ?quantity qudt:numericValue ?concentration ;
                                  qudt:unit qudt:UNITLESS .
                        FILTER (
                            datatype(?concentration) = xsd:decimal &&
                            ?concentration < 1
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER (
                            datatype(?present) = xsd:boolean &&
                            ?present = "false"^^xsd:boolean
                        )
                    }
                )
            }
        """
    ] .
