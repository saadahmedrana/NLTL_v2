@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceOperationApplicable must be recorded as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Ice-operation safety monitoring procedures must be present when ice operation applies."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:independentOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Independent operation limits must be specified for independent operation."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:escortedOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Escorted operation limits must be specified for escorted operation."
                    ] ;
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Escort requirements must be recorded when escort or icebreaker assistance is applicable."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:escortedOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Escorted operation limits must be specified for escorted operation."
                    ] ;
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ]
                ]
            )
        ]
    ) .
