@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-031> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:exposedStructureMaterial ;
        sh:datatype xsd:string ;
        sh:message "Each represented exposed-structure material must be a string." ;
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:minCount 1 ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The represented exposed-structure material approval status must be Approved." ;
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"^^xsd:string
            "recognized organization accepted by the Administration"^^xsd:string
        ) ;
        sh:message "Approval must identify the Administration or a recognized organization accepted by the Administration." ;
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"^^xsd:string
            "another standard offering an equivalent level of safety"^^xsd:string
        ) ;
        sh:message "Approval must reference an Organization-acceptable standard or an equivalent-safety standard." ;
    ] ;
    sh:property [
        sh:path nltl:polarServiceTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG_C ;
            ] ;
        ] ;
        sh:message "The approval basis must preserve the polar service temperature in degrees Celsius." ;
    ] .
