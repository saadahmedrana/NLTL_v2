@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-045-machinery-seawater-supply>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machinerySeawaterSupply ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Machinery seawater supply applicability must be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceIngestionPreventionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Machinery seawater supply must have ice-ingestion prevention."
            ]
        ]
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "An alternative machinery seawater arrangement must have approved status."
            ]
        ]
    ) .
