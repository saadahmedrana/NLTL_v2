@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_047_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasEssentialEngine ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEssentialEngine ;
                sh:minCount 1 ;
                sh:class nltl:essentialEngine
            ] ;
            sh:property [
                sh:path nltl:combustionAirTemperatureControlPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Combustion air temperature control must be present and true for essential engines."
            ] ;
            sh:property [
                sh:path nltl:combustionAirTemperature ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG_C>
                    ]
                ] ;
                sh:message "Combustion air temperature must be recorded as a single degree-Celsius quantity."
            ] ;
            sh:property [
                sh:path nltl:manufacturerMinAirTemperature ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG_C>
                    ]
                ] ;
                sh:message "The manufacturer's minimum combustion-air temperature must be recorded as a single degree-Celsius quantity."
            ] ;
            sh:property [
                sh:path nltl:manufacturerMaxAirTemperature ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG_C>
                    ]
                ] ;
                sh:message "The manufacturer's maximum combustion-air temperature must be recorded as a single degree-Celsius quantity."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Combustion air temperature must be within the engine manufacturer's minimum and maximum criteria." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:combustionAirTemperature ?temperatureNode ;
        nltl:manufacturerMinAirTemperature ?minimumNode ;
        nltl:manufacturerMaxAirTemperature ?maximumNode .
  ?temperatureNode qudt:numericValue ?temperature ;
                   qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
  ?minimumNode qudt:numericValue ?minimum ;
               qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
  ?maximumNode qudt:numericValue ?maximum ;
               qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
  FILTER (?temperature < ?minimum || ?temperature > ?maximum)
}
"""
            ]
        ]
    ) .
