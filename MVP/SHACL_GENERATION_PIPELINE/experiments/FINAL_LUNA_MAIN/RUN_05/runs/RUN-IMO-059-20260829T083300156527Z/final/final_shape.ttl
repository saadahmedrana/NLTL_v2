@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_059_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:class nltl:firefighterOutfitItem , nltl:equipmentItem ;
            sh:property [
                sh:path nltl:hasStorageLocation ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:physicalStorageLocation ;
                sh:node [
                    sh:property [
                        sh:path nltl:storageTemperatureClass ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:storageTemperatureClassValue ;
                        sh:hasValue nltl:warmStorageLocation ;
                        sh:message "Each firefighter outfit storage location must have the warm storage temperature class."
                    ]
                ] ;
                sh:message "Each firefighter outfit must have a storage location classified as warm."
            ]
        ] ;
        sh:message "Each linked firefighter outfit must also be an equipment item."
    ] .
