@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066_EscapeRouteItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:escapeRouteProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each escape route must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066_MusterStationItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:musterStationProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each muster station must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066_EmbarkationAreaItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:embarkationAreaProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each embarkation area must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066_SurvivalCraftItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each survival craft must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066_LaunchingApplianceItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:launchingApplianceProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each launching appliance must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066_SurvivalCraftAccessItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Access to each survival craft must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066_ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:class nltl:protectedItem
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gen:IMO066_EscapeRouteItemShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gen:IMO066_MusterStationItemShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gen:IMO066_EmbarkationAreaItemShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gen:IMO066_SurvivalCraftItemShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gen:IMO066_LaunchingApplianceItemShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gen:IMO066_SurvivalCraftAccessItemShape ;
        sh:qualifiedMinCount 1
    ] .

gen:IMO066_NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1
    ] .

gen:IMO066_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:xone (
        gen:IMO066_ApplicableShape
        gen:IMO066_NotApplicableShape
    ) .
