@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-070> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Passenger ships shall record a true size compatibility status and provide exactly one compatible immersion suit or thermal protective aid assignment for each linked person on board." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:passengerShip .

                FILTER NOT EXISTS {
                    $this nltl:sizeCompatibilityStatus ?compatibility .
                    FILTER (datatype(?compatibility) = xsd:boolean && ?compatibility = true)
                }

                FILTER NOT EXISTS {
                    $this nltl:sizeCompatibilityStatus ?compatibility1 .
                    $this nltl:sizeCompatibilityStatus ?compatibility2 .
                    FILTER (?compatibility1 != ?compatibility2)
                }

                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .

                FILTER NOT EXISTS {
                    ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment1 .
                    ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment2 .
                    FILTER (?assignment1 != ?assignment2)
                }

                FILTER NOT EXISTS {
                    ?person nltl:hasPersonalSurvivalEquipmentAssignment ?personAssignment .
                    FILTER NOT EXISTS {
                        ?personAssignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                        ?equipment a ?equipmentType .
                        FILTER (
                            ?equipmentType IN (
                                nltl:immersionSuitEquipment,
                                nltl:thermalProtectiveAidEquipment
                            )
                        )
                    }
                }

                FILTER NOT EXISTS {
                    ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment1 .
                    ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment2 .
                    FILTER (?equipment1 != ?equipment2)
                }
            }
        """
    ] .
