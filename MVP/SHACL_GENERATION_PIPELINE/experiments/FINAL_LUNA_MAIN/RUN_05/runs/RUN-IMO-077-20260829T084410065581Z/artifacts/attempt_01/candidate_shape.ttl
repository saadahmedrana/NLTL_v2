@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO077Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO077NotApplicableShape
        gen:IMO077ApplicableShape
    ) .

gen:IMO077NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
        sh:datatype xsd:boolean ;
        sh:hasValue "false"^^xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The additional equipment carried in the survival craft indicator must be false when this capacity rule is not applicable."
    ] .

gen:IMO077ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
        sh:datatype xsd:boolean ;
        sh:hasValue "true"^^xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The additional equipment carried in the survival craft indicator must be true for the applicable capacity calculation."
    ] ;
    sh:property [
        sh:path nltl:personsCapacityRequirement ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:additionalEquipmentCapacityRequirement ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:survivalCraftAvailableCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:launchingApplianceCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadedSurvivalCraftRequirement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When additional equipment is carried in the survival craft, available survival-craft capacity must be at least the persons capacity requirement plus the additional equipment capacity requirement, and launching-appliance capacity must be at least the loaded survival-craft requirement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:survivalCraftAvailableCapacity ?availableNode .
                ?availableNode qudt:numericValue ?availableValue .
                $this nltl:personsCapacityRequirement ?persons .
                $this nltl:additionalEquipmentCapacityRequirement ?additionalEquipment .
                $this nltl:launchingApplianceCapacity ?launchingNode .
                ?launchingNode qudt:numericValue ?launchingValue .
                $this nltl:loadedSurvivalCraftRequirement ?loadedNode .
                ?loadedNode qudt:numericValue ?loadedValue .
                FILTER (
                    ?availableValue < (?persons + ?additionalEquipment)
                    || ?launchingValue < ?loadedValue
                )
            }
        """
    ] .
