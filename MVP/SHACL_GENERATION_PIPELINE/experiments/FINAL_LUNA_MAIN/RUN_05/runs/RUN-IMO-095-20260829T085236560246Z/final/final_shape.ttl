@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-095> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:searchAndRescueCommunicationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall declare search and rescue communication capability."
    ] ;
    sh:property [
        sh:path nltl:rescueCoordinationCentreVoiceOrData ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall provide voice or data communications with relevant rescue coordination centres."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-095-AircraftVoiceFrequencyQuantity> ;
        sh:message "The ship shall declare supported aircraft voice frequencies including 121.5 MHz and 123.1 MHz."
    ] ;
    sh:sparql [
        sh:message "Supported aircraft voice frequencies shall include both 121.5 MHz and 123.1 MHz." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:supportedAircraftVoiceFrequency ?frequency121 .
                ?frequency121 qudt:numericValue ?value121 .
                ?frequency121 qudt:unit unit:MegaHZ .
                FILTER (?value121 >= 121.5 && ?value121 <= 121.5)

                $this nltl:supportedAircraftVoiceFrequency ?frequency123 .
                ?frequency123 qudt:numericValue ?value123 .
                ?frequency123 qudt:unit unit:MegaHZ .
                FILTER (?value123 >= 123.1 && ?value123 <= 123.1)
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-095-AircraftVoiceFrequencyQuantity> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaHZ
    ] .
