@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-100> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:voyagePlanPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must have a voyage plan."
    ] ;
    sh:property [
        sh:path nltl:identifiedIntendedVoyageHazard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The intended-voyage hazard register must identify at least one hazard."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanHazardCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The voyage plan must address every identified intended-voyage hazard."
    ] .
