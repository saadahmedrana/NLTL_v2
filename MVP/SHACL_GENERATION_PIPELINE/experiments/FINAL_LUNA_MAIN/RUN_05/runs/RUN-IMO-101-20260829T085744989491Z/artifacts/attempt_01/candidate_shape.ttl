@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO101_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarRoutePlan ;
        sh:minCount 1 ;
        sh:class nltl:polarRoutePlan ;
        sh:node gen:IMO101_PolarRoutePlanShape ;
        sh:message "The ship must have a polar-route planning record covering the required voyage-planning topics."
    ] .

gen:IMO101_PolarRoutePlanShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The polar-route planning record must indicate complete coverage of the required voyage-planning topics."
    ] .
