@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO103Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The alternate-qualified-person condition must be explicitly false when the conditional requirements do not apply."
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The alternate-qualified-person condition must be explicitly true to invoke the conditional credential requirements."
            ] ;
            sh:property [
                sh:path nltl:administrationPermissionStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Administration permission must be approved for an alternate qualified person."
            ] ;
            sh:property [
                sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "STCW Convention regulation II/2 compliance is required."
            ] ;
            sh:property [
                sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "STCW Code section A-II/2 compliance is required."
            ] ;
            sh:property [
                sh:path nltl:advancedPolarTrainingStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Advanced polar training is required."
            ] ;
            sh:property [
                sh:path nltl:watchCoverageStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Sufficient trained watch coverage is required."
            ] ;
            sh:property [
                sh:path nltl:restComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Administration minimum rest requirements must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( "passenger ship" "tanker" "cargo ship other than tanker" ) ;
                sh:message "Ship type is required to select the applicable basic-training condition."
            ] ;
            sh:property [
                sh:path nltl:iceCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Operating ice condition is required to select the applicable basic-training condition."
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Ice concentration is required to select the cargo-ship basic-training condition."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:designatedOfficerBasicTrainingStatus ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Designated officers must meet the applicable basic-training requirements."
                    ] ;
                    sh:sparql [
                        sh:message "This branch applies only to passenger ships or tankers operating in waters other than open or bergy waters." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:shipType ?type ;
                                      nltl:iceCondition ?condition .
                                FILTER (
                                    ?type NOT IN ("passenger ship", "tanker") ||
                                    ?condition IN ("open waters", "bergy waters")
                                )
                            }
                        """
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "This branch applies only to passenger ships or tankers operating in open or bergy waters." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:shipType ?type ;
                                      nltl:iceCondition ?condition .
                                FILTER (
                                    ?type NOT IN ("passenger ship", "tanker") ||
                                    ?condition NOT IN ("open waters", "bergy waters")
                                )
                            }
                        """
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:designatedOfficerBasicTrainingStatus ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Designated officers must meet the applicable basic-training requirements."
                    ] ;
                    sh:sparql [
                        sh:message "This branch applies only to cargo ships other than tankers operating with ice concentration above 2/10." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            SELECT $this
                            WHERE {
                                $this nltl:shipType "cargo ship other than tanker" ;
                                      nltl:iceConcentration ?quantity .
                                ?quantity qudt:numericValue ?value .
                                FILTER (?value <= "0.2"^^xsd:decimal)
                            }
                        """
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "This branch applies only to cargo ships other than tankers operating with ice concentration at or below 2/10." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            SELECT $this
                            WHERE {
                                $this nltl:shipType ?type ;
                                      nltl:iceConcentration ?quantity .
                                ?quantity qudt:numericValue ?value .
                                FILTER (
                                    ?type != "cargo ship other than tanker" ||
                                    ?value > "0.2"^^xsd:decimal
                                )
                            }
                        """
                    ]
                ]
            )
        ]
    ) .
