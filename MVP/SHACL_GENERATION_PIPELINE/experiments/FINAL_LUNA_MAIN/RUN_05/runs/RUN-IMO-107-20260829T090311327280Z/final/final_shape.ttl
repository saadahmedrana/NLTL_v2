@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO107PolarOperationCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:oilRecordBookPolarCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:manualPolarCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:pollutionEmergencyPlanPolarCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:polarOperationCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When the ship operates in polar waters, polar-operation coverage must be recorded in the Oil Record Book, manuals, the applicable pollution emergency plan, and the declared polar-operation coverage indicator." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?applicability .
                FILTER (?applicability = "true"^^xsd:boolean)
                FILTER (
                    NOT EXISTS {
                        $this nltl:oilRecordBookPolarCoverage ?oilCoverage .
                        FILTER (?oilCoverage = "true"^^xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:manualPolarCoverage ?manualCoverage .
                        FILTER (?manualCoverage = "true"^^xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:pollutionEmergencyPlanPolarCoverage ?planCoverage .
                        FILTER (?planCoverage = "true"^^xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:polarOperationCoverage ?operationCoverage .
                        FILTER (?operationCoverage = "true"^^xsd:boolean)
                    }
                )
            }
        """
    ] .
