@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO111ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For a Category A or B ship constructed on or after 1 January 2017, every linked oil residue or oily bilge water holding tank with individual capacity greater than 30 m3 must have an outer-shell separation of at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:hasComponent ?tank .

                FILTER (?category IN (
                    nltl:polarShipCategoryA,
                    nltl:polarShipCategoryB
                ))
                FILTER (
                    ?constructionDate >= "2017-01-01"^^xsd:date
                )

                ?tank a ?tankType .
                FILTER (?tankType IN (
                    nltl:oilResidueTank,
                    nltl:oilyBilgeWaterHoldingTank
                ))

                FILTER (
                    NOT EXISTS {
                        $this nltl:individualTankCapacity ?anyCapacity .
                        ?anyCapacity a qudt:QuantityValue ;
                                     qudt:numericValue ?anyCapacityValue ;
                                     qudt:unit unit:M3 .
                    }
                    ||
                    EXISTS {
                        $this nltl:individualTankCapacity ?capacity .
                        ?capacity a qudt:QuantityValue ;
                                  qudt:numericValue ?capacityValue ;
                                  qudt:unit unit:M3 .
                        FILTER (?capacityValue > 30)

                        FILTER NOT EXISTS {
                            $this nltl:tankOuterShellSeparation ?separation .
                            ?separation a qudt:QuantityValue ;
                                        qudt:numericValue ?separationValue ;
                                        qudt:unit unit:M .
                            FILTER (?separationValue >= 0.76)
                        }
                    }
                )
            }
        """
    ] .
