@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_114_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:cargoTankType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For an applicable Category A or B ship constructed on or after 2017-01-01 carrying NLS requiring a type 3 tank in a type 3 cargo tank, Administration approval and the applicable certificate polar-operation entry are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                      nltl:cargoTankType ?cargoTankType .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    ?constructionDate >= "2017-01-01"^^xsd:date
                )
                FILTER (?requiresType3 = true)
                FILTER (?cargoTankType = "3"^^xsd:string)

                FILTER (
                    NOT EXISTS {
                        $this nltl:administrationCarriageApprovalStatus
                              nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:administrationCarriageApprovalStatus ?status .
                        FILTER (?status != nltl:evidenceStateApproved)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:applicableCertificatePolarOperationEntryPresent true
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableCertificatePolarOperationEntryPresent ?entry .
                        FILTER (?entry != true)
                    }
                )
            }
        """
    ] .
