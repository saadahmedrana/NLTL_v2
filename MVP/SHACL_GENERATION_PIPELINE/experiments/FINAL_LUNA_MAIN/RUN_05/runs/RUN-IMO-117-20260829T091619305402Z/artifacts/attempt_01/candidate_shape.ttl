@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO117Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The sewage treatment plant applicability status must be recorded as a boolean."
    ] ;
    sh:or (
        gen:IMO117NotUsingTreatmentPlant
        gen:IMO117UsingTreatmentPlant
    ) .

gen:IMO117NotUsingTreatmentPlant
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:hasValue false
    ] .

gen:IMO117UsingTreatmentPlant
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:sewageTreatmentPlantApprovalStatus ;
        sh:node [
            sh:hasValue nltl:evidenceStateApproved
        ] ;
        sh:minCount 1 ;
        sh:message "An applicable sewage treatment plant must have approved status."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:node [
            sh:hasValue nltl:evidenceStateApproved
        ] ;
        sh:minCount 1 ;
        sh:message "The applicable sewage treatment plant certification status must be approved."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Discharge must comply with MARPOL Annex IV regulation 11.1.2."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gen:IMO117DischargeDistanceRecordShape ;
        sh:minCount 1 ;
        sh:message "An applicable ship must record its discharge distances."
    ] .

gen:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:class nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:minCount 1 ;
        sh:message "The discharge distance to the nearest land, ice shelf, or fast ice must be recorded."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:minCount 1 ;
        sh:message "The discharge distance to an area with ice concentration greater than one tenth must be recorded."
    ] .

gen:IMO117NauticalMileQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
