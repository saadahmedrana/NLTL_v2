@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO117ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlgen:IMO117ApplicableShape
        nltlgen:IMO117NotApplicableShape
    ) .

nltlgen:IMO117NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The sewage treatment plant applicability value must be false for the non-applicable branch."
    ] .

nltlgen:IMO117ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The sewage treatment plant applicability value must be true for this applicable branch."
    ] ;
    sh:property [
        sh:path nltl:sewageTreatmentPlantApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The sewage treatment plant must have approved status."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:complianceStateCompliant ;
        sh:message "The MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status must be compliant."
    ] ;
    sh:property [
        sh:path nltl:marpolCertificationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:complianceStateCompliant ;
        sh:message "The MARPOL certification status must be compliant."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "MARPOL Annex IV regulation 11.1.2 discharge compliance must be true."
    ] ;
    sh:property [
        sh:path nltl:marpolDischargeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The MARPOL discharge status must be true."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:minCount 1 ;
        sh:node nltlgen:IMO117DischargeDistanceRecordShape ;
        sh:message "At least one discharge distance record with both required distances must be recorded."
    ] .

nltlgen:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:class nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:IMO117DistanceQuantityShape ;
        sh:message "A distance to the nearest land, ice shelf, or fast ice must be recorded."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:IMO117DistanceQuantityShape ;
        sh:message "A distance to an area with ice concentration greater than one tenth must be recorded."
    ] .

nltlgen:IMO117DistanceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The recorded distance must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
        sh:message "The recorded distance must use nautical miles."
    ] .
