@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qv: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:Chapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node gs:LengthOverallQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gs:GrossTonnageQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 9-1 applicability must equal the applicable ship-type, dimension, gross-tonnage, and trade-status conditions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qv: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?tonnageQuantity ;
                      nltl:engagedInTrade ?engagedInTrade ;
                      nltl:polarCodeChapter9Dash1Applicable ?actual .

                ?lengthQuantity qv:numericValue ?lengthValue .
                ?tonnageQuantity qv:numericValue ?tonnageValue .

                BIND(
                    IF(
                        (
                            ?shipType = "fishing_vessel"
                            && ?lengthValue >= 24
                        )
                        ||
                        (
                            ?shipType = "pleasure_yacht"
                            && ?tonnageValue >= 300
                            && ?engagedInTrade = false
                        )
                        ||
                        (
                            ?shipType = "cargo_ship"
                            && ?tonnageValue >= 300
                            && ?tonnageValue < 500
                        ),
                        true,
                        false
                    )
                    AS ?expected
                )

                FILTER(?actual != ?expected)
            }
        """
    ] .

gs:LengthOverallQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:GrossTonnageQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
