@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_007_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:IMO26_007_NotIceStrengthened
        gen:IMO26_007_ConstructedBeforeEffectiveDate
        gen:IMO26_007_TwoIndependentDevices
        gen:IMO26_007_DeviceWithIndependentTransducers
        gen:IMO26_007_ApprovedEquivalentDevice
    ) ;
    sh:message "An ice-strengthened ship constructed on or after 1 January 2026 must satisfy one permitted depth-sounding arrangement." .

gen:IMO26_007_NotIceStrengthened
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1
    ] .

gen:IMO26_007_ConstructedBeforeEffectiveDate
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2025-12-31"^^xsd:date ;
        sh:minCount 1
    ] .

gen:IMO26_007_TwoIndependentDevices
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2026-01-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:independentEchoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1
    ] .

gen:IMO26_007_DeviceWithIndependentTransducers
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2026-01-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:echoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:independentTransducerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1
    ] .

gen:IMO26_007_ApprovedEquivalentDevice
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2026-01-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:administrationApprovedEquivalentDepthSoundingDevicePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] .
