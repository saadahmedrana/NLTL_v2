@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:node [
                    sh:class nltl:navigationOrCommunicationAntenna ;
                    sh:property [
                        sh:path nltl:antennaIceAccumulationPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Each required navigation or communication antenna must have ice accumulation prevention." ;
                    ] ;
                ] ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false ;
            ] ;
        ]
    ) ;
    sh:message "iceAccretionLikely must be explicitly true or false; when true, every required navigation or communication antenna must have ice accumulation prevention." .
