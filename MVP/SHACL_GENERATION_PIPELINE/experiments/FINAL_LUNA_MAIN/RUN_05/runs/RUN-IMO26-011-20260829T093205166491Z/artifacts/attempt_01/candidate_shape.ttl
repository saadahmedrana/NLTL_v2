@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_011_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single valid polar ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single construction date is required to determine applicability."
    ] ;
    sh:or (
        gen:IMO26_011_CategoryC_Branch
        gen:IMO26_011_CategoryAB_Before2026_Branch
        gen:IMO26_011_CategoryAB_From2026_Branch
    ) .

gen:IMO26_011_CategoryC_Branch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC
    ] .

gen:IMO26_011_CategoryAB_Before2026_Branch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        )
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2026-01-01"^^xsd:date
    ] .

gen:IMO26_011_CategoryAB_From2026_Branch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        )
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2026-01-01"^^xsd:date
    ] ;
    sh:or (
        gen:IMO26_011_EnclosedWings_Alternative
        gen:IMO26_011_DesignedProtection_Alternative
        gen:IMO26_011_EquivalentProtection_Alternative
    ) .

gen:IMO26_011_EnclosedWings_Alternative
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeWingsEnclosed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bridge wings must be enclosed, or an approved alternative protection arrangement must be recorded."
    ] .

gen:IMO26_011_DesignedProtection_Alternative
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeWingProtectionDesignStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bridge wing protection design status must be approved, or another permitted protection alternative must be recorded."
    ] .

gen:IMO26_011_EquivalentProtection_Alternative
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Administration-approved equivalent bridge wing protection must be recorded, or another permitted protection alternative must be recorded."
    ] .
