@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_017_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Chapter 11-1 applicability state must be present as one boolean value."
    ] ;
    sh:property [
        sh:path nltl:intendedVoyageHazard ;
        sh:datatype xsd:string ;
        sh:message "Each intended voyage hazard must be represented as a string."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Voyage-plan presence must not contain contradictory boolean values."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanCoverage ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Voyage-plan coverage must not contain contradictory boolean values."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanPresent ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:voyagePlanCoverage ;
                sh:hasValue true ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:message "When Chapter 11-1 is applicable, a voyage plan must be present and cover every intended voyage hazard; contradictory applicability states are not permitted." .
