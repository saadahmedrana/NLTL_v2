@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO26_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Chapter 11-1 applicability shall be recorded as a boolean."
    ] ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Safety-management-system status shall be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:polarCodeChapter11Dash1Applicable ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:voyagePlanningTopicCoverage ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ]
            )
        ]
    ) ;
    sh:message "When chapter 11-1 is applicable, the route planning record shall cover all nine clause 11-1.3 topics." ;
    sh:or (
        [
            sh:property [
                sh:path nltl:safetyManagementSystemImplemented ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:safetyManagementSystemImplemented ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:documentedPolarOperationProcedurePresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ]
            )
        ]
    ) ;
    sh:message "If no safety management system is implemented, a documented procedure for operation in polar waters shall be present." .
