@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF002ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine applicability of the 2017 Ice Class Regulations."
    ] ;
    sh:or (
        gen:TRF002ApplicableShape
        gen:TRF002NotApplicableShape
    ) .

gen:TRF002ApplicableShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "For ships contracted on or after 1 January 2019 but before 5 July 2021, the applicable Ice Class Regulations edition must be 2017 and no contradictory additional edition may be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    ?date >= "2019-01-01"^^xsd:date &&
                    ?date < "2021-07-05"^^xsd:date
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                            nltl:iceClassRegulationEdition2017 .
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?otherEdition .
                        FILTER (
                            ?otherEdition !=
                            nltl:iceClassRegulationEdition2017
                        )
                    }
                )
            }
        """
    ] .

gen:TRF002NotApplicableShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "The 2017 Ice Class Regulations apply to ships contracted on or after 1 January 2019 but before 5 July 2021." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    ?date >= "2019-01-01"^^xsd:date &&
                    ?date < "2021-07-05"^^xsd:date
                )
            }
        """
    ] .
