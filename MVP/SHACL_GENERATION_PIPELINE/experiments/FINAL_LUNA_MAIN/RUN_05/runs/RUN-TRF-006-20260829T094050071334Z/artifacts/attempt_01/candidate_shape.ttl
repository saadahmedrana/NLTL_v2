@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date
    ] ;
    sh:or (
        gen:TRF006ApplicableCohortShape
        gen:TRF006NonApplicableCohortShape
    ) .

gen:TRF006ApplicableCohortShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1986-11-01"^^xsd:date ;
        sh:maxExclusive "2003-09-01"^^xsd:date
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iceClassRuleEdition1985 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ships in the specified construction-stage cohort must use the 1985 Ice Class Rules."
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:TRF006OwnerRequestedShape
        gen:TRF006OwnerNotRequestedShape
    ) .

gen:TRF006OwnerRequestedShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iceClassRegulationEdition2008 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The 2008 engine-output requirements require an affirmative owner request."
    ] .

gen:TRF006OwnerNotRequestedShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iceClassRuleEdition1985 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Without an owner request, engine output remains governed by the 1985 Ice Class Rules."
    ] .

gen:TRF006NonApplicableCohortShape a sh:NodeShape ;
    sh:sparql [
        sh:message "A ship with a construction-stage date must either be outside the specified cohort or satisfy the cohort requirements." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:constructionStageDate ?date .
                }
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?cohortDate .
                    FILTER (
                        ?cohortDate >= "1986-11-01"^^xsd:date &&
                        ?cohortDate < "2003-09-01"^^xsd:date
                    )
                }
            }
        """
    ] .
