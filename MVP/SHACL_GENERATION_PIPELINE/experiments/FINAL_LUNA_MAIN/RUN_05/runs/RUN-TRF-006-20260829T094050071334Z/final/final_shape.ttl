@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006_Static a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction-stage date is required to determine applicability of the ice-class regulation rule."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:maxInclusive "1986-10-31"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2003-09-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:message "Ships in the applicable construction-stage cohort must identify the 1985 ice-class rule edition."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
                sh:minCount 1 ;
                sh:message "An applicable ship must have an ice class from the permitted controlled values."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:iceClassRegulationEdition2008 ;
                        sh:minCount 1 ;
                        sh:message "When the owner requests the 2008 engine-output requirements, the engine-output edition must be 2008."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:iceClassRuleEdition1985 ;
                        sh:minCount 1 ;
                        sh:message "Without an owner request for the 2008 engine-output requirements, the engine-output edition must remain the 1985 rule edition."
                    ]
                ]
            )
        ]
    ) .
