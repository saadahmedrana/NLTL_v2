@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-009> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Applicable IA or IA Super ships must use a permitted 2017 method and have delivery and assessment dates no later than 1 January of the year twenty years after delivery." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceClass ?ice .
    FILTER (
        ?ice IN (
            nltl:iceClassIa,
            nltl:iceClassIaSuper
        )
    )

    $this nltl:constructionStageDate ?construction .
    FILTER (
        datatype(?construction) = xsd:date &&
        ?construction < "2003-09-01"^^xsd:date
    )

    OPTIONAL { $this nltl:deliveryDate ?delivery . }
    OPTIONAL { $this nltl:assessmentDate ?assessment . }
    OPTIONAL { $this nltl:engineOutputComplianceMethod ?method . }

    FILTER (
        !BOUND(?delivery) ||
        datatype(?delivery) != xsd:date ||
        !BOUND(?assessment) ||
        datatype(?assessment) != xsd:date ||
        !BOUND(?method) ||
        ?method NOT IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ) ||
        (
            datatype(?delivery) = xsd:date &&
            datatype(?assessment) = xsd:date &&
            (
                YEAR(?assessment) > YEAR(?delivery) + 20 ||
                (
                    YEAR(?assessment) = YEAR(?delivery) + 20 &&
                    (
                        MONTH(?assessment) > 1 ||
                        (
                            MONTH(?assessment) = 1 &&
                            DAY(?assessment) > 1
                        )
                    )
                )
            )
        )
    )
}
""" ;
    ] .
