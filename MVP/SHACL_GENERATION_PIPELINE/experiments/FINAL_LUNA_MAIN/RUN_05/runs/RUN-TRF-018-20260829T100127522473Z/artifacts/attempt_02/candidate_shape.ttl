@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-018> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceClass is required and must identify an ice-class value."
    ] ;
    sh:property [
        sh:path nltl:calculatedRequiredPower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "calculatedRequiredPower is required as a single kilowatt quantity with a decimal numeric value."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "maximumContinuousRatingPower is required as a single kilowatt quantity with a decimal numeric value."
    ] ;
    sh:sparql [
        sh:message "For ice class IA, IB, or IC, maximumContinuousRatingPower must be at least calculatedRequiredPower and 1000 kW; for IA Super, it must be at least calculatedRequiredPower and 2800 kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .

                ?calculatedQuantity qudt:numericValue ?calculatedPower .
                ?maximumQuantity qudt:numericValue ?maximumPower .

                FILTER (
                    (
                        (?ice = nltl:iceClassIa ||
                         ?ice = nltl:iceClassIb ||
                         ?ice = nltl:iceClassIc)
                        &&
                        (?maximumPower < ?calculatedPower ||
                         ?maximumPower < "1000.0"^^xsd:decimal)
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        &&
                        (?maximumPower < ?calculatedPower ||
                         ?maximumPower < "2800.0"^^xsd:decimal)
                    )
                )
            }
        """
    ] .
