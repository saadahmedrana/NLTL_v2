@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF020ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "2003-09-01"^^xsd:date ;
                sh:message "An applicable ship must have a construction stage date on or after 2003-09-01."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                ) ;
                sh:message "An applicable ship must have ice class IA Super, IA, IB, or IC."
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020DimensionlessQuantityShape ;
                sh:message "The applicable ship must provide engine-output coefficient Ke."
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020UnspecifiedUnitQuantityShape ;
                sh:message "The applicable ship must provide brash-ice resistance at the lower ice waterline."
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020UnspecifiedUnitQuantityShape ;
                sh:message "The applicable ship must provide brash-ice resistance at the upper ice waterline."
            ] ;
            sh:property [
                sh:path nltl:propellerDiameter ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020LengthQuantityShape ;
                sh:message "The applicable ship must provide propeller diameter."
            ] ;
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The applicable ship must provide propeller count."
            ] ;
            sh:property [
                sh:path nltl:propellerPitchControlType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:controllablePitch
                    nltl:fixedPitch
                ) ;
                sh:message "The applicable ship must identify fixed-pitch or controllable-pitch propulsion."
            ] ;
            sh:property [
                sh:path nltl:propulsionSystemType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:conventionalPropulsionSystem
                    nltl:electricPropulsionMachinery
                    nltl:hydraulicPropulsionMachinery
                ) ;
                sh:message "The applicable ship must identify its propulsion system type."
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:iceWaterline
                ] ;
                sh:message "The applicable ship must identify its lower ice waterline."
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:iceWaterline ;
                    sh:property [
                        sh:path nltl:upperIceWaterlineLength ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gen:TRF020LengthQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:upperIceWaterlineBreadth ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gen:TRF020LengthQuantityShape
                    ]
                ] ;
                sh:message "The applicable ship must identify its upper ice waterline with upper-waterline length and breadth."
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020PowerQuantityShape ;
                sh:message "The applicable ship must provide maximum continuous rating power."
            ] ;
            sh:property [
                sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020PowerQuantityShape ;
                sh:message "The applicable ship must provide the externally calculated minimum power at the lower ice waterline."
            ] ;
            sh:property [
                sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF020PowerQuantityShape ;
                sh:message "The applicable ship must provide the externally calculated minimum power at the upper ice waterline."
            ] ;
            sh:sparql [
                sh:message "Maximum continuous rating power must be at least both externally calculated minimum powers." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower/qudt:numericValue ?mcr .
                        $this nltl:minimumRequiredPowerAtLowerIceWaterline/qudt:numericValue ?lower .
                        $this nltl:minimumRequiredPowerAtUpperIceWaterline/qudt:numericValue ?upper .
                        FILTER (
                            (xsd:decimal(?mcr) < xsd:decimal(?lower)) ||
                            (xsd:decimal(?mcr) < xsd:decimal(?upper))
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A non-applicable ship must provide construction stage date evidence."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A non-applicable ship must provide ice-class evidence."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:constructionStageDate ;
                        sh:datatype xsd:date ;
                        sh:maxInclusive "2003-08-31"^^xsd:date
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "The ice class must provide evidence that the applicable ice-class condition is false." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            SELECT $this
                            WHERE {
                                $this nltl:iceClass ?iceClass .
                                FILTER (
                                    ?iceClass NOT IN (
                                        nltl:iceClassIaSuper,
                                        nltl:iceClassIa,
                                        nltl:iceClassIb,
                                        nltl:iceClassIc
                                    )
                                )
                            }
                        """
                    ]
                ]
            )
        ]
    ) .

gen:TRF020UnspecifiedUnitQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF020DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF020LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF020PowerQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
