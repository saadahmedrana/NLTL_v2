@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-023> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship retaining ice class IB or IC under the 1985 ice class regulations must have maximum continuous rating power at least equal to the required power under those rules, with both quantities in kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?mcrQuantity ;
                          nltl:requiredPowerUnder1985Rules ?requiredQuantity .

                    ?mcrQuantity qudt:numericValue ?mcrValue ;
                                  qudt:unit qudt:KiloW .

                    ?requiredQuantity qudt:numericValue ?requiredValue ;
                                      qudt:unit qudt:KiloW .

                    FILTER (
                        datatype(?mcrValue) = xsd:decimal &&
                        datatype(?requiredValue) = xsd:decimal &&
                        ?mcrValue >= ?requiredValue
                    )
                }
            }
        """
    ] .
