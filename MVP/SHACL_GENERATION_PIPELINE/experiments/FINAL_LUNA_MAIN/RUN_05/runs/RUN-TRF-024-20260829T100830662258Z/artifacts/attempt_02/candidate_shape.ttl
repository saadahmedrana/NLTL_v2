@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-024-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "Construction stage date must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:message "Delivery date must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:message "Assessment date must be an xsd:date."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper ;
                sh:or (
                    [
                        sh:property [
                            sh:path nltl:constructionStageDate ;
                            sh:minCount 1 ;
                            sh:datatype xsd:date
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:deliveryDate ;
                            sh:minCount 1 ;
                            sh:datatype xsd:date
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:assessmentDate ;
                            sh:minCount 1 ;
                            sh:datatype xsd:date
                        ]
                    ]
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                )
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:sparql [
                sh:message "For IA Super or IA ships constructed before 1 September 2003, the assessment date must be no later than 1 January in the year twenty years after delivery." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    $this nltl:constructionStageDate ?constructionDate .
    $this nltl:deliveryDate ?deliveryDate .
    $this nltl:assessmentDate ?assessmentDate .
    FILTER (
        datatype(?constructionDate) = xsd:date &&
        datatype(?deliveryDate) = xsd:date &&
        datatype(?assessmentDate) = xsd:date
    )
    FILTER (
        YEAR(?constructionDate) < 2003 ||
        (
            YEAR(?constructionDate) = 2003 &&
            (
                MONTH(?constructionDate) < 9 ||
                (MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1)
            )
        )
    )
    FILTER (
        YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
        (
            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
            (
                MONTH(?assessmentDate) > 1 ||
                (MONTH(?assessmentDate) = 1 && DAY(?assessmentDate) > 1)
            )
        )
    )
}
"""
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
    ) .
