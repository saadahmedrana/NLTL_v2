@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:KeQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:RchQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AlternativeEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:evidenceArtifact ;
    sh:or (
        [
            sh:class nltl:alternativeCalculationEvidence
        ]
        [
            sh:class nltl:modelTestEvidence
        ]
    ) .

gen:ApprovedStatusShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:RevokedStatusShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateRevoked ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF028Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:node gen:AlternativeEvidenceShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:node gen:KeQuantityValueShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceRch ;
        sh:node gen:RchQuantityValueShape ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:node gen:KeQuantityValueShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:node gen:RchQuantityValueShape ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:or (
        [
            sh:node gen:ApprovedStatusShape
        ]
        [
            sh:node gen:RevokedStatusShape
        ]
    ) .
