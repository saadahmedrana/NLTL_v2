@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-028> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact ;
            sh:or (
                [ sh:class nltl:alternativeCalculationEvidence ]
                [ sh:class nltl:modelTestEvidence ]
            )
        ] ;
        sh:message "The ship shall provide evidence that is an evidence artifact based on either a more precise calculation or a model test."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:approvalStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:approvalRevocationStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:evidenceStateApproved
                    nltl:evidenceStateDraft
                    nltl:evidenceStateExpired
                    nltl:evidenceStateRejected
                    nltl:evidenceStateRevoked
                    nltl:evidenceStateSubmitted
                    nltl:evidenceStateUnderReview
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:approvalStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:approvalRevocationStatus ;
                sh:hasValue nltl:evidenceStateRevoked ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:evidenceStateApproved
                    nltl:evidenceStateDraft
                    nltl:evidenceStateExpired
                    nltl:evidenceStateRejected
                    nltl:evidenceStateRevoked
                    nltl:evidenceStateSubmitted
                    nltl:evidenceStateUnderReview
                )
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/N> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-028> sh:message "The ship shall provide either an approved Ke value or an approved RCH value." .
