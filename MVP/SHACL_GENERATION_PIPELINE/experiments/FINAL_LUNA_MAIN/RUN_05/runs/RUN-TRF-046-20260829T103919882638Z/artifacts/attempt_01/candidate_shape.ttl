@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-046-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "The frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:node [
                    sh:or (
                        [ sh:class nltl:deckStructure ]
                        [ sh:class nltl:tankBoundaryPlating ]
                        [ sh:class nltl:iceStringer ]
                    )
                ] ;
                sh:message "The strengthened upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
            ]
        ] ;
        sh:message "The frame must identify an upper end with an eligible attached supporting structure."
    ] .
