@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF049FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:node gs:TRF049FrameWebThicknessShape ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:node gs:TRF049FrameAttachmentShape ;
                sh:minCount 1
            ] ;
            sh:or (
                [
                    sh:class nltl:longitudinalFrame ;
                    sh:property [
                        sh:path nltl:hasSupportingWebFrame ;
                        sh:node gs:TRF049SupportingStructureShape
                    ] ;
                    sh:property [
                        sh:path nltl:hasSupportingBulkhead ;
                        sh:node gs:TRF049SupportingStructureShape
                    ] ;
                    sh:property [
                        sh:path nltl:hasFrameAttachment ;
                        sh:node gs:TRF049LongitudinalAttachmentShape
                    ]
                ]
                [
                    sh:class nltl:transverseFrame ;
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:hasFrameAttachment ;
                        sh:node gs:TRF049TransverseAttachmentShape
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:hasFrameAttachment ;
                                sh:node gs:TRF049TerminatingAttachmentShape
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue false
                            ]
                        ]
                    ) ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:passesThroughSupportingStructure ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:webPlateConnectionSideCount ;
                                sh:datatype xsd:integer ;
                                sh:minInclusive 2 ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:passesThroughSupportingStructure ;
                                sh:hasValue false
                            ]
                        ]
                    )
                ]
                [
                    sh:not [ sh:class nltl:longitudinalFrame ] ;
                    sh:not [ sh:class nltl:transverseFrame ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A bracket requires a frame web thickness for comparison." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    $this nltl:frameWebThickness ?frameThickness .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Bracket thickness must be at least the frame web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                $this nltl:frameWebThickness ?frameThickness .
                ?frameThickness qudt:numericValue ?frameValue .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?bracketThickness qudt:numericValue ?bracketValue .
                FILTER (?bracketValue < ?frameValue)
            }
        """
    ] .

gs:TRF049FrameWebThicknessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF049FrameAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be effectively confirmed."
    ] .

gs:TRF049LongitudinalAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node gs:TRF049BracketShape ;
        sh:minCount 1
    ] .

gs:TRF049TransverseAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:TRF049TerminatingAttachmentShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:node gs:TRF049BracketShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

gs:TRF049BracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:node gs:TRF049BracketThicknessShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:TRF049BracketThicknessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF049SupportingStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:node gs:TRF049FrameAttachmentShape
    ] .
