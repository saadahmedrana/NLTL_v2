@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-049_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-strengthened-area applicability state must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-049_FrameAttachmentShape> ;
                sh:message "An applicable frame must have an effectively validated frame attachment."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path rdf:type ;
                        sh:hasValue nltl:longitudinalFrame
                    ] ;
                    sh:property [
                        sh:path nltl:hasSupportingWebFrame ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:TRF-049_SupportingStructureShape> ;
                        sh:message "A longitudinal frame must be attached to supporting web frames."
                    ] ;
                    sh:property [
                        sh:path nltl:hasSupportingBulkhead ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:TRF-049_SupportingStructureShape> ;
                        sh:message "A longitudinal frame must be attached to supporting bulkheads."
                    ]
                ]
                [
                    sh:property [
                        sh:path rdf:type ;
                        sh:hasValue nltl:transverseFrame
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:hasFrameAttachment ;
                                sh:minCount 1 ;
                                sh:node <urn:nltl:generated-shape:TRF-049_TerminatingAttachmentShape>
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue false
                            ]
                        ]
                    )
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049_FrameWebThicknessShape> ;
        sh:message "The frame web thickness must be supplied as a millimetre quantity."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every installed bracket must be at least as thick as the associated frame web." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                $this nltl:frameWebThickness ?frameQuantity .
                ?frameQuantity qudt:numericValue ?frameValue .
                ?bracket nltl:bracketThickness ?bracketQuantity .
                ?bracketQuantity qudt:numericValue ?bracketValue .
                FILTER (
                    datatype(?frameValue) = xsd:decimal &&
                    datatype(?bracketValue) = xsd:decimal &&
                    ?bracketValue < ?frameValue
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-049_FrameAttachmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each applicable frame attachment must be effectively confirmed."
    ] ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049_SupportingStructureShape> ;
        sh:message "Each frame attachment must identify its attached supporting structure."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-049_ConnectionBracketShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-049_TerminatingAttachmentShape>
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-049_ConnectionBracketShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-049_SupportingStructureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:minCount 1 ;
        sh:message "Each supporting structure must have an owner-correct frame attachment relationship."
    ] .

<urn:nltl:generated-shape:TRF-049_ConnectionBracketShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049_BracketThicknessShape> ;
        sh:message "Each installed bracket must have a millimetre thickness."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

<urn:nltl:generated-shape:TRF-049_FrameWebThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

<urn:nltl:generated-shape:TRF-049_BracketThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
