@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-052-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:equivalentSupportStatusByDirectCalculation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:node <urn:nltl:generated-shape:TRF-052-PrescriptiveSupportShape>
        ]
    ) .

<urn:nltl:generated-shape:TRF-052-PrescriptiveSupportShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the frame is asymmetrical or its web angle to the shell is below 90 degrees, antitripping support spacing must be at most 1300 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:frameAsymmetrical true .
                }
                FILTER NOT EXISTS {
                    $this nltl:frameWebAngleToShell ?angleNode .
                    ?angleNode qudt:numericValue ?angle .
                    FILTER (?angle < 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:frameAsymmetrical ?asymmetrical .
                    FILTER (?asymmetrical = false)
                    $this nltl:frameWebAngleToShell ?angleNode2 .
                    ?angleNode2 qudt:numericValue ?angle2 .
                    FILTER (?angle2 >= 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                    ?spacingNode qudt:numericValue ?spacing .
                    FILTER (?spacing <= 1300)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required antitripping support region scope is not represented for the frame span and ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:frameSpan ?spanNode .
                    ?spanNode qudt:numericValue ?span .
                    FILTER (?span > 4)
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:midbodyRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:sternRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue .
                    }
                }
                UNION
                {
                    $this nltl:frameSpan ?spanNode2 ;
                          nltl:iceClass nltl:iceClassIaSuper .
                    ?spanNode2 qudt:numericValue ?span2 .
                    FILTER (?span2 <= 4)
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:midbodyRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:sternRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue .
                    }
                }
                UNION
                {
                    $this nltl:frameSpan ?spanNode3 ;
                          nltl:iceClass nltl:iceClassIa .
                    ?spanNode3 qudt:numericValue ?span3 .
                    FILTER (?span3 <= 4)
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion ;
                              nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                    }
                }
                UNION
                {
                    $this nltl:frameSpan ?spanNode4 ;
                          nltl:iceClass ?iceClass .
                    ?spanNode4 qudt:numericValue ?span4 .
                    FILTER (?span4 <= 4)
                    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                    }
                }
            }
        """
    ] .
