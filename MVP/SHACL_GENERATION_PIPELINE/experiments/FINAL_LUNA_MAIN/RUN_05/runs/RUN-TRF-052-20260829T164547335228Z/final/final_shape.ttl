@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF052FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:equivalentSupportStatusByDirectCalculation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSpan ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minExclusive 4
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:bowRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:midbodyRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:sternRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:otherIceStrengthenedAreaValue ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSpan ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 4
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:bowRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:midbodyRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:sternRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:otherIceStrengthenedAreaValue ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSpan ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 4
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:bowRegion ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:midbodyRegion ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSpan ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 4
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                )
            ] ;
            sh:property [
                sh:path nltl:hasAntitrippingSupportRegion ;
                sh:hasValue nltl:bowRegion ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "When the frame is asymmetrical or its web angle is below 90 degrees, antitripping support spacing of no more than 1300 mm must be represented." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameAsymmetrical ?asym ;
                      nltl:frameWebAngleToShell ?angleNode .
                ?angleNode qudt:numericValue ?angle .
                FILTER (
                    (?asym = true || ?angle < 90) &&
                    NOT EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingNode .
                        ?spacingNode qudt:numericValue ?spacing ;
                                     qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (?spacing <= 1300)
                    }
                )
            }
        """
    ] .
