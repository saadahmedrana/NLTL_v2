@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qdt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qdt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qdt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qdt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qdt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qdt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qdt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qdt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qdt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qdt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qdt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF054IceStringerShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An ice pressure in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A design ice load height in metres is required."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A span in metres is required."
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A stringer span in metres is required."
    ] ;
    sh:property [
        sh:path nltl:distanceToAdjacentIceStringer ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The distance to the adjacent ice stringer in metres is required."
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The distance to the ice belt in metres is required."
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame moment factor m is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The yield strength in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The design line load, outside-ice-belt factor, section modulus, and required shear area must satisfy the TRF-054 formulas within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qdt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qdt:numericValue ?p ;
                      nltl:designIceLoadHeight/qdt:numericValue ?h ;
                      nltl:span/qdt:numericValue ?l ;
                      nltl:stringerSpan/qdt:numericValue ?lsSpan ;
                      nltl:distanceToAdjacentIceStringer/qdt:numericValue ?ls ;
                      nltl:distanceToIceBelt/qdt:numericValue ?hs ;
                      nltl:frameMomentFactorM/qdt:numericValue ?m ;
                      nltl:yieldStrength/qdt:numericValue ?sigma ;
                      nltl:designLineLoad/qdt:numericValue ?reportedLine ;
                      nltl:outsideIceBeltFactor/qdt:numericValue ?reportedFactor ;
                      nltl:sectionModulus/qdt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qdt:numericValue ?reportedA .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?line)
                BIND((1 - (?hs / ?ls)) AS ?factor)
                BIND((0.80 * 1.8 * ?line * (?lsSpan * ?lsSpan) /
                      (?m * ?sigma) * ?factor * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?line * ?lsSpan /
                      (2 * ?sigma) * ?factor * 10000) AS ?expectedA)

                FILTER(
                    ABS(?reportedLine - ?line) >
                    (0.000001 * ABS(?line) + 0.000000001)
                    ||
                    ABS(?reportedFactor - ?factor) >
                    (0.000001 * ABS(?factor) + 0.000000001)
                    ||
                    ABS(?reportedZ - ?expectedZ) >
                    (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?reportedA - ?expectedA) >
                    (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """
    ] .
