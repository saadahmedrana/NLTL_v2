@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF_054_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:TRF_054_MegaPaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

gen:TRF_054_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gen:TRF_054_KiloNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M>
    ] .

gen:TRF_054_CentiM2QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

gen:TRF_054_CentiM3QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
    ] .

gen:TRF_054_IceStringerShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:filterShape [
        a sh:NodeShape ;
        sh:property [
            sh:path nltl:locatedOutsideIceBelt ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:hasValue true
        ] ;
        sh:property [
            sh:path nltl:supportsIceStrengthenedFrames ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:hasValue true
        ]
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MegaPaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MegaPaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:distanceToAdjacentIceStringer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_KiloNewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_CentiM3QuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_054_CentiM2QuantityShape
    ] ;
    sh:sparql [
        sh:message "The design line load, outside-ice-belt factor, section modulus, and required shear area must match the declared formulas within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this
                    nltl:icePressure/qudt:numericValue ?p ;
                    nltl:designIceLoadHeight/qudt:numericValue ?h ;
                    nltl:span/qudt:numericValue ?span ;
                    nltl:stringerSpan/qudt:numericValue ?l ;
                    nltl:frameMomentFactorM/qudt:numericValue ?m ;
                    nltl:yieldStrength/qudt:numericValue ?sigma ;
                    nltl:distanceToIceBelt/qudt:numericValue ?hs ;
                    nltl:distanceToAdjacentIceStringer/qudt:numericValue ?ls ;
                    nltl:designLineLoad/qudt:numericValue ?reportedLoad ;
                    nltl:outsideIceBeltFactor/qudt:numericValue ?reportedFactor ;
                    nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                    nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?loadMNPerM)
                BIND((?loadMNPerM * 1000) AS ?expectedLoad)
                BIND((1 - (?hs / ?ls)) AS ?expectedFactor)
                BIND((0.80 * 1.8 * ?loadMNPerM * ?l * ?l /
                      (?m * ?sigma) * ?expectedFactor * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 *
                      ?loadMNPerM * ?l / (2 * ?sigma) *
                      ?expectedFactor * 10000) AS ?expectedA)

                FILTER(
                    ABS(?reportedLoad - ?expectedLoad) >
                    (ABS(?expectedLoad) * 0.000001 + 0.000001)
                    ||
                    ABS(?reportedFactor - ?expectedFactor) >
                    (ABS(?expectedFactor) * 0.000001 + 0.000001)
                    ||
                    ABS(?reportedZ - ?expectedZ) >
                    (ABS(?expectedZ) * 0.000001 + 0.000001)
                    ||
                    ABS(?reportedA - ?expectedA) >
                    (ABS(?expectedA) * 0.000001 + 0.000001)
                )
            }
        """
    ] .
