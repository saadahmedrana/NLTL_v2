@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF058ForceKiloNewtonShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF058LengthMetreShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF058WebFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:or (
        [
            sh:property [
                sh:path nltl:supportedStringerOutsideIceBelt ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The supported-stringer-outside-ice-belt applicability value must be true or false."
            ] ;
            sh:property [
                sh:path nltl:iceLoadForce ;
                sh:node gen:TRF058ForceKiloNewtonShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An ice load force in kN is required when the supported stringer is outside the ice belt."
            ] ;
            sh:property [
                sh:path nltl:stringerOutsideIceBeltHeight ;
                sh:node gen:TRF058LengthMetreShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The stringer height outside the ice belt in metres is required when the supported stringer is outside the ice belt."
            ] ;
            sh:property [
                sh:path nltl:stringerSpan ;
                sh:node gen:TRF058LengthMetreShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The stringer span in metres is required when the supported stringer is outside the ice belt."
            ] ;
            sh:property [
                sh:path nltl:adjustedIceLoadForce ;
                sh:node gen:TRF058ForceKiloNewtonShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The adjusted ice load force in kN is required when the supported stringer is outside the ice belt."
            ] ;
            sh:sparql [
                sh:message "Adjusted ice load force must equal ice load force multiplied by (1 - stringer outside ice belt height / stringer span), within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kN." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce ?forceNode ;
                              nltl:stringerOutsideIceBeltHeight ?heightNode ;
                              nltl:stringerSpan ?spanNode ;
                              nltl:adjustedIceLoadForce ?adjustedNode .

                        ?forceNode qudt:numericValue ?force ;
                                   qudt:unit unit:KiloN .
                        ?heightNode qudt:numericValue ?height ;
                                    qudt:unit unit:M .
                        ?spanNode qudt:numericValue ?span ;
                                   qudt:unit unit:M .
                        ?adjustedNode qudt:numericValue ?adjusted ;
                                      qudt:unit unit:KiloN .

                        BIND (?force * (1 - (?height / ?span)) AS ?expected)
                        FILTER (
                            ABS(?adjusted - ?expected) >
                            (0.000001 * ABS(?expected) + 0.000001)
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportedStringerOutsideIceBelt ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The supported-stringer-outside-ice-belt applicability value must be true or false."
            ]
        ]
    ) .
