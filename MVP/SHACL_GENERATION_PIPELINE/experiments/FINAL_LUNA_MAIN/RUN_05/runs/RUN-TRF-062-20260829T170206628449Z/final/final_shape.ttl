@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF_062_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerBladeTipHullClearance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide one propeller blade tip-to-hull clearance in metres."
    ] ;
    sh:property [
        sh:path nltl:minimumClearance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide the applicable h0 minimum clearance threshold in metres."
    ] ;
    sh:sparql [
        sh:message "The propeller blade tip-to-hull clearance must be no less than the applicable h0 minimum clearance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerBladeTipHullClearance ?clearanceQuantity .
                ?clearanceQuantity qudt:numericValue ?clearanceValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:minimumClearance ?thresholdQuantity .
                ?thresholdQuantity qudt:numericValue ?thresholdValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER(
                    datatype(?clearanceValue) = xsd:decimal &&
                    datatype(?thresholdValue) = xsd:decimal &&
                    ?clearanceValue < ?thresholdValue
                )
            }
        """
    ] .
