@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF066ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall have exactly one valid ice class." ;
    ] ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa ;
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterline ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The lower ice waterline shall be recorded for an IA ship subject to this requirement." ;
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "For an IA ship, practicability of an ice knife shall be recorded as true when the ice-knife alternative is used." ;
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node gs:TRF066IceKnifeArrangementShape ;
                sh:message "An IA ship shall have a rudder protection arrangement using an ice knife extending below the lower ice waterline." ;
            ] ;
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper ;
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterline ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The lower ice waterline shall be recorded for an IA Super ship subject to this requirement." ;
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "For an IA Super ship, practicability of an ice knife shall be recorded as true when the ice-knife alternative is used." ;
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node gs:TRF066IceKnifeArrangementShape ;
                sh:message "An IA Super ship shall have a rudder protection arrangement using an ice knife extending below the lower ice waterline." ;
            ] ;
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
            ] ;
        ]
    ) .

gs:TRF066IceKnifeArrangementShape a sh:NodeShape ;
    sh:class nltl:rudderProtectionArrangement ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:class nltl:iceKnife ;
            sh:property [
                sh:path nltl:extendsBelowLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ice knife shall extend below the lower ice waterline." ;
            ] ;
        ]
        [
            a sh:NodeShape ;
            sh:class nltl:equivalentRudderProtectionMeans ;
        ]
    ) .
