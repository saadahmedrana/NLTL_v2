@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:or (
            [ sh:node gen:TRF078Table6_6CaseShape ]
            [ sh:node gen:TRF078Table6_7CaseShape ]
        ) ;
        sh:minCount 2
    ] ;
    sh:sparql [
        sh:message "The ship must provide both the Table 6-6 and Table 6-7 lookup cases with a reported ice-load cycle count equal to k1*k2*k3*N_class*n_n within the required tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case6 ;
                      nltl:hasTableLookupCase ?case7 ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?actual .

                ?case6 a nltl:tableLookupCase ;
                       nltl:tableReference nltl:traficomTable6Dash6 ;
                       nltl:iceClass ?iceClass ;
                       nltl:selectedIceClassCycleCount ?nClassNode .

                ?case7 a nltl:tableLookupCase ;
                       nltl:tableReference nltl:traficomTable6Dash7 ;
                       nltl:tableLookupPropellerLocation ?location ;
                       nltl:selectedPropellerLocationFactor ?k1Node .

                ?k2Node <http://qudt.org/schema/qudt/numericValue> ?k2 .
                ?k3Node <http://qudt.org/schema/qudt/numericValue> ?k3 .
                ?nnNode <http://qudt.org/schema/qudt/numericValue> ?nn .
                ?nClassNode <http://qudt.org/schema/qudt/numericValue> ?nClass .
                ?k1Node <http://qudt.org/schema/qudt/numericValue> ?k1 .

                BIND((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                BIND(ABS(?actual - ?expected) AS ?difference)

                FILTER (
                    ?difference > (1e-6 * ABS(?expected))
                    && ?difference > 1e-9
                )
            }
        """
    ] .

gen:TRF078DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF078Table6_6CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF078Table6_7CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
