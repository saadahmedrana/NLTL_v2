@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_080_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A ship with a propeller ice interaction component must provide integer ice load cycle and propeller blade counts and an effective ice load cycle quantity with a decimal numeric value in unit UNITLESS." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component rdf:type nltl:propellerIceInteractionComponent .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceLoadCycleCount ?nice .
                        FILTER (datatype(?nice) = xsd:integer)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:propellerBladeCount ?blades .
                        FILTER (datatype(?blades) = xsd:integer)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:effectiveIceLoadCycleCount ?result .
                        ?result qudt:numericValue ?reported ;
                                qudt:unit ?unit .
                        FILTER (datatype(?reported) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a ship with a propeller ice interaction component, effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9, and its unit must be UNITLESS." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component ;
                      nltl:iceLoadCycleCount ?nice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?result .
                ?component rdf:type nltl:propellerIceInteractionComponent .
                ?result qudt:numericValue ?reported ;
                        qudt:unit ?unit .
                FILTER (
                    datatype(?nice) = xsd:integer
                    &&
                    datatype(?blades) = xsd:integer
                    &&
                    datatype(?reported) = xsd:decimal
                    &&
                    (
                        ?unit != qudt:UNITLESS
                        ||
                        EXISTS {
                            ?result qudt:unit ?otherUnit .
                            FILTER (?otherUnit != qudt:UNITLESS)
                        }
                        ||
                        ABS(?reported - (?nice * ?blades))
                        >
                        (ABS(?nice * ?blades) * 0.000001 + 0.000000001)
                    )
                )
            }
        """
    ] .
