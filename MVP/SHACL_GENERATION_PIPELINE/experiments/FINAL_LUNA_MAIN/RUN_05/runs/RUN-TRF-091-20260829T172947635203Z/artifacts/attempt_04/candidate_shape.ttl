@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-091-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:equals nltl:hasPropulsionLoadCase ;
        sh:node [
            sh:class nltl:iceMillingSequenceCase ;
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                sh:minCount 1
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:loadCasePurpose ;
                    sh:hasValue nltl:stallingAnalysisPurposeValue
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:equals nltl:hasIceMillingSequenceCase
    ] .
