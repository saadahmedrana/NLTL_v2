@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF101_BladeFailureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node gs:TRF101_LoadCaseShape ;
        sh:message "A load case with the required application radius and weakest-direction confirmation is required."
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_LengthMetresShape
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_LengthMetresShape
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [ sh:node gs:TRF101_AnalysisAlternativeShape ]
        [ sh:node gs:TRF101_CalculationAlternativeShape ]
    ) ;
    sh:sparql [
        sh:message "bladeFailureStatus must be true when bladeTipOffset exceeds 10 percent of propellerDiameter, and false otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerDiameter ?diameterQuantity ;
                      nltl:bladeTipOffset ?offsetQuantity ;
                      nltl:bladeFailureStatus ?status .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?offsetQuantity qudt:numericValue ?offset .
                FILTER (
                    (?offset > (0.10 * ?diameter) && ?status != true) ||
                    (?offset <= (0.10 * ?diameter) && ?status != false)
                )
            }
        """
    ] .

gs:TRF101_LengthMetresShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF101_ForceKiloNewtonsShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF101_PressureMegaPascalShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF101_DimensionlessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF101_LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gs:TRF101_DimensionlessShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "0.8"^^xsd:decimal ;
                sh:maxInclusive "0.8"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:TRF101_AnalysisAlternativeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:class nltl:approvalRecord ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An approved nonlinear blade stress analysis is required when the calculation alternative is not used."
    ] .

gs:TRF101_CalculationAlternativeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_LengthMetresShape
    ] ;
    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_LengthMetresShape
    ] ;
    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_LengthMetresShape
    ] ;
    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_PressureMegaPascalShape
    ] ;
    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_PressureMegaPascalShape
    ] ;
    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_PressureMegaPascalShape
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF101_ForceKiloNewtonsShape
    ] ;
    sh:sparql [
        sh:message "The calculated reference strength and blade failure ultimate load must match their declared formulas within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection ?cQuantity ;
                      nltl:bladeCylindricalRootRadius ?rQuantity ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?tQuantity ;
                      nltl:bladeMinimumYieldStrength ?yieldQuantity ;
                      nltl:bladeUltimateTensileStrength ?ultimateQuantity ;
                      nltl:bladeReferenceStrength1 ?referenceQuantity ;
                      nltl:bladeFailureUltimateLoad ?loadQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:hasLoadCase ?case .

                ?case nltl:bladeFailureLoadApplicationRadiusRatio ?ratioQuantity .
                ?cQuantity qudt:numericValue ?c .
                ?rQuantity qudt:numericValue ?r .
                ?tQuantity qudt:numericValue ?t .
                ?yieldQuantity qudt:numericValue ?yield .
                ?ultimateQuantity qudt:numericValue ?ultimate .
                ?referenceQuantity qudt:numericValue ?reference .
                ?loadQuantity qudt:numericValue ?load .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?ratioQuantity qudt:numericValue ?ratio .

                BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                BIND ((300 * ?c * ?t * ?t * ?expectedReference) / ((?ratio * ?diameter) - (2 * ?r)) AS ?expectedLoad)

                FILTER (
                    (?reference < (?expectedReference - ((?expectedReference * 0.000001) + 0.000001))) ||
                    (?reference > (?expectedReference + ((?expectedReference * 0.000001) + 0.000001))) ||
                    (?load < (?expectedLoad - ((?expectedLoad * 0.000001) + 0.000001))) ||
                    (?load > (?expectedLoad + ((?expectedLoad * 0.000001) + 0.000001)))
                )
            }
        """
    ] .
