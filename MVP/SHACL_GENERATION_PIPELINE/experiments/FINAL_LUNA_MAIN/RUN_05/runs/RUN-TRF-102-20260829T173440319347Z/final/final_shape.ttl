@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF102Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [ sh:node gen:TRF102FormulaShape ]
        [ sh:node gen:TRF102AnalysisShape ]
    ) ;
    sh:message "The maximum spindle torque must be established either by the declared approved stress analysis or by the specified calculation." .

gen:TRF102FormulaShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeExpandedAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102ForceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorqueFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102TorqueQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102TorqueQuantityShape
    ] ;
    sh:sparql [
        sh:message "The spindle torque factor, blade-failure spindle torque, and maximum spindle torque must conform to the specified calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bladeExpandedAreaRatio/qudt:numericValue ?ear ;
                      nltl:propellerBladeCount ?z ;
                      nltl:leadingEdgeChordPortionAtZeroPointEightRadius/qudt:numericValue ?cle ;
                      nltl:trailingEdgeChordPortionAtZeroPointEightRadius/qudt:numericValue ?cte ;
                      nltl:extremeIceForce/qudt:numericValue ?fex ;
                      nltl:bladeFailureSpindleTorqueFactor/qudt:numericValue ?factor ;
                      nltl:bladeFailureSpindleTorque/qudt:numericValue ?failureTorque ;
                      nltl:maximumSpindleTorque/qudt:numericValue ?maximumTorque .

                BIND ((4 * ?ear) / ?z AS ?ratio)
                BIND (0.7 * (1 - (?ratio * ?ratio * ?ratio)) AS ?rawFactor)
                BIND (IF(?rawFactor < 0.3, 0.3, ?rawFactor) AS ?expectedFactor)
                BIND (IF(?cle > (0.8 * ?cte), ?cle, (0.8 * ?cte)) AS ?chordTerm)
                BIND (?chordTerm * ?expectedFactor * ?fex AS ?expectedTorque)

                FILTER (
                    ?factor < (?expectedFactor - (0.000001 * ?expectedFactor + 0.000001)) ||
                    ?factor > (?expectedFactor + (0.000001 * ?expectedFactor + 0.000001)) ||
                    ?failureTorque < (?expectedTorque - (0.000001 * ?expectedTorque + 0.000001)) ||
                    ?failureTorque > (?expectedTorque + (0.000001 * ?expectedTorque + 0.000001)) ||
                    ?maximumTorque < (?expectedTorque - (0.000001 * ?expectedTorque + 0.000001)) ||
                    ?maximumTorque > (?expectedTorque + (0.000001 * ?expectedTorque + 0.000001))
                )
            }
        """
    ] .

gen:TRF102AnalysisShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedSpindleTorqueStressAnalysis ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:approvalRecord
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF102TorqueQuantityShape
    ] .

gen:TRF102DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF102LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF102ForceQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF102TorqueQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
