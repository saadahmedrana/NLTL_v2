@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-104-PropulsionLineShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:pyramidStrengthPrinciple ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship shall record that the propulsion line is designed according to the pyramid strength principle."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerBladeLoss ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerBladeLoss ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasPropellerShaftLineComponent ;
                sh:node <urn:nltl:generated-shape:TRF-104-ShaftLineComponentDamageShape>
            ]
        ]
    ) ;
    sh:message "The propeller-blade-loss applicability state shall be recorded; when blade loss applies, it shall not cause significant damage to linked propeller shaft line components." .

<urn:nltl:generated-shape:TRF-104-ShaftLineComponentDamageShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:significantDamageFromBladeLoss ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "Loss of the propeller blade shall not cause significant damage to this propeller shaft line component."
    ] .
