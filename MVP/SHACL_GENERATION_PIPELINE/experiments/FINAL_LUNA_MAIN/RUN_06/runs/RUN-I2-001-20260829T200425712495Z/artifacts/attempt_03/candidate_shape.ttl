@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-001-ShipApplicabilityShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide one construction contract date to determine UR I2 Rev.4 applicability." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2021-01-01"^^xsd:date ;
                sh:message "For ships subject to UR I2 Rev.4, the construction contract date must be on or after 2021-01-01." ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:maxInclusive "2020-12-31"^^xsd:date ;
            ] ;
        ]
    ) .
