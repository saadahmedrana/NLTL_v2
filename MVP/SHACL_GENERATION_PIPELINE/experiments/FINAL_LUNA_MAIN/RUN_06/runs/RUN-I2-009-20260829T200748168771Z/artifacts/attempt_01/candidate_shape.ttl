@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship shall provide its hull area." ;
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node <urn:nltl:generated-shape:I2-009-PressureValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship shall provide average ice pressure in MPa." ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node <urn:nltl:generated-shape:I2-009-AspectRatioValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load patch aspect ratio shall be exactly 3.6 and dimensionless." ;
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node <urn:nltl:generated-shape:I2-009-LengthValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship shall provide the non-bow load patch height in metres." ;
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node <urn:nltl:generated-shape:I2-009-LengthValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship shall provide the non-bow load patch length in metres." ;
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node <urn:nltl:generated-shape:I2-009-AngleValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship shall provide the buttock angle in degrees." ;
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node <urn:nltl:generated-shape:I2-009-AngleValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship shall provide the normal frame angle in degrees." ;
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bow-form applicability shall be recorded as a boolean." ;
    ] ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
        sh:minCount 1 ;
        sh:message "A ship shall provide its hull-area assignment." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Bow-form applicability shall be true exactly when the buttock angle is positive and below 80 degrees and the normal frame angle is greater than 10 degrees." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this
WHERE {
    ?this nltl:bowFormApplicability ?app .
    ?this nltl:buttockAngle ?gammaNode .
    ?gammaNode qudt:numericValue ?gamma .
    ?this nltl:normalFrameAngle ?betaNode .
    ?betaNode qudt:numericValue ?beta .
    FILTER (
        (?app = true && !((?gamma > 0) && (?gamma < 80) && (?beta > 10)))
        ||
        (?app = false && ((?gamma > 0) && (?gamma < 80) && (?beta > 10)))
    )
}
""" ;
    ] .

<urn:nltl:generated-shape:I2-009-PressureValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:I2-009-AspectRatioValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:I2-009-LengthValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:I2-009-AngleValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape>
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:class nltl:hullAreaValue ;
        sh:in (
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The hull-area assignment shall identify a permitted ice-strengthened hull area." ;
    ] .
