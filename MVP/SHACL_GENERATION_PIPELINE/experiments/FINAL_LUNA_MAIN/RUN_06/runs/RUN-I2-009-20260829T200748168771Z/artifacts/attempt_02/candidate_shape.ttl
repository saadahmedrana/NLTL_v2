@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:class nltl:hullAreaAssignment ;
        sh:minCount 1 ;
        sh:node ex:I2_009_HullAreaAssignmentShape ;
        sh:message "The ship must provide a hull-area assignment for the applicable ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must identify the hull area covered by this requirement."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node ex:I2_009_AverageIcePressureShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Average ice pressure must be supplied as a pressure quantity in MPa."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node ex:I2_009_LoadPatchAspectRatioShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load-patch aspect ratio must be supplied and equal 3.6."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node ex:I2_009_LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow load-patch height must be supplied as a length in metres."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node ex:I2_009_LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow load-patch length must be supplied as a length in metres."
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node ex:I2_009_AngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The buttock angle must be supplied as an angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node ex:I2_009_AngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The normal frame angle must be supplied as an angle in degrees."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Design ice forces are applicable only when the buttock angle is greater than 0 degrees and less than 80 degrees, and the normal frame angle is greater than 10 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:buttockAngle ?buttockQuantity .
                ?buttockQuantity qudt:numericValue ?buttockAngle .

                $this nltl:normalFrameAngle ?frameQuantity .
                ?frameQuantity qudt:numericValue ?frameAngle .

                FILTER (
                    ?buttockAngle <= 0 ||
                    ?buttockAngle >= 80 ||
                    ?frameAngle <= 10
                )
            }
        """
    ] .

ex:I2_009_HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:class nltl:hullAreaValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:otherIceStrengthenedArea
            nltl:otherIceStrengthenedAreaValue
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        ) ;
        sh:message "The hull-area assignment must identify an allowed other ice-strengthened area or its permitted regional value."
    ] .

ex:I2_009_AverageIcePressureShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ex:I2_009_LoadPatchAspectRatioShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ex:I2_009_LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ex:I2_009_AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
