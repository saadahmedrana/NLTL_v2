@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_011_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [ sh:node gs:I2_011_ApplicableShape ]
        [ sh:node gs:I2_011_BulbousBowAbsentShape ]
        [ sh:node gs:I2_011_OtherPolarClassShape ]
    ) .

gs:I2_011_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable ship must have Polar Class PC6 or PC7."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable ship must have a bulbous bow."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ForceMegaNewtonShape
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ForceMegaNewtonShape
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ShapeCoefficientShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_LoadPatchAspectRatioShape
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ForceKiloNewtonShape
    ] ;
    sh:sparql [
        sh:message "The reported bow design force must be at least both the method (iv) force and the method (iii) lower-bound force calculated with fa = 0.6 and AR = 1.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowDesignForce ?reportedNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:shapeCoefficient ?faNode ;
                      nltl:loadPatchAspectRatio ?arNode .

                ?reportedNode qudt:numericValue ?reported ;
                              qudt:unit qudt:KiloN .
                ?iiiNode qudt:numericValue ?iii ;
                          qudt:unit qudt:MegaN .
                ?ivNode qudt:numericValue ?iv ;
                         qudt:unit qudt:MegaN .
                ?faNode qudt:numericValue ?fa ;
                        qudt:unit qudt:UNITLESS .
                ?arNode qudt:numericValue ?ar ;
                        qudt:unit qudt:UNITLESS .

                BIND((?iii * (?fa / 0.6) * (?ar / 1.3)) * 1000.0 AS ?expectedIii)
                BIND(?iv * 1000.0 AS ?expectedIv)

                BIND(
                    IF(
                        (?expectedIii * 0.000001) >= 0.000001,
                        (?expectedIii * 0.000001),
                        0.000001
                    ) AS ?toleranceIii
                )
                BIND(
                    IF(
                        (?expectedIv * 0.000001) >= 0.000001,
                        (?expectedIv * 0.000001),
                        0.000001
                    ) AS ?toleranceIv
                )

                FILTER(
                    (?reported + ?toleranceIii < ?expectedIii) ||
                    (?reported + ?toleranceIv < ?expectedIv)
                )
            }
        """
    ] .

gs:I2_011_BulbousBowAbsentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:polarClassValue
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gs:I2_011_OtherPolarClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:I2_011_ForceMegaNewtonShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_ForceKiloNewtonShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_ShapeCoefficientShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.6 ;
        sh:maxInclusive 0.6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_011_LoadPatchAspectRatioShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.3 ;
        sh:maxInclusive 1.3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
