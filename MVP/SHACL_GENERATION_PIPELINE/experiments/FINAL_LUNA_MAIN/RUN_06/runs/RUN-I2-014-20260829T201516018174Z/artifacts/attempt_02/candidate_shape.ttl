@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;

    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;

            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:glancingImpactLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:glancingImpactPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:evidenceArtifact
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "The four bow subregions must have midpoint positions at LBOW/8, 3*LBOW/8, 5*LBOW/8, and 7*LBOW/8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lengthNode .
                ?lengthNode qudt:numericValue ?length .
                {
                    SELECT $this
                           (COUNT(DISTINCT ?slot) AS ?slotCount)
                           (SUM(?invalid) AS ?invalidCount)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionMidLengthPosition ?midNode .
                        ?midNode qudt:numericValue ?mid .
                        BIND(
                            IF(
                                ABS(?mid - (?length * 0.125)) <= (ABS(?length * 0.125) * 0.000001 + 0.000000001),
                                1,
                                IF(
                                    ABS(?mid - (?length * 0.375)) <= (ABS(?length * 0.375) * 0.000001 + 0.000000001),
                                    2,
                                    IF(
                                        ABS(?mid - (?length * 0.625)) <= (ABS(?length * 0.625) * 0.000001 + 0.000000001),
                                        3,
                                        IF(
                                            ABS(?mid - (?length * 0.875)) <= (ABS(?length * 0.875) * 0.000001 + 0.000000001),
                                            4,
                                            0
                                        )
                                    )
                                )
                            ) AS ?slot
                        )
                        BIND(IF(?slot = 0, 1, 0) AS ?invalid)
                    }
                    GROUP BY $this
                }
                FILTER (?slotCount != 4 || ?invalidCount != 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Selected maximum bow force, line load, and pressure must equal the corresponding maxima across the four calculation cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceNode ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoadNode ;
                      nltl:selectedMaximumBowPressure ?selectedPressureNode .
                ?selectedForceNode qudt:numericValue ?selectedForce .
                ?selectedLineLoadNode qudt:numericValue ?selectedLineLoad .
                ?selectedPressureNode qudt:numericValue ?selectedPressure .
                {
                    SELECT $this
                           (MAX(?force) AS ?maximumForce)
                           (MAX(?lineLoad) AS ?maximumLineLoad)
                           (MAX(?pressure) AS ?maximumPressure)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?forceNode ;
                              nltl:bowSubregionCalculatedLineLoad ?lineLoadNode ;
                              nltl:bowSubregionCalculatedPressure ?pressureNode .
                        ?forceNode qudt:numericValue ?force .
                        ?lineLoadNode qudt:numericValue ?lineLoad .
                        ?pressureNode qudt:numericValue ?pressure .
                    }
                    GROUP BY $this
                }
                FILTER (
                    ?selectedForce != ?maximumForce ||
                    ?selectedLineLoad != ?maximumLineLoad ||
                    ?selectedPressure != ?maximumPressure
                )
            }
        """
    ] .
