@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;

    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:peakPressureFactorLookupCase ;

            sh:property [
                sh:path nltl:localizedStructuralMemberCategory ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:bottomStructureFrameCategory
                    nltl:longitudinallyFramedPlatingCategory
                    nltl:stringerSideLongitudinalOrWebFrameCategory
                    nltl:transverseFrameWithLoadDistributingStringersCategory
                    nltl:transverseFrameWithoutLoadDistributingStringersCategory
                    nltl:transverselyFramedPlatingCategory
                )
            ] ;

            sh:property [
                sh:path nltl:selectedPeakPressureFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iacsUrI2Table3
            ] ;

            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ]
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;

    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:iceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "The Table 3 reference and lookup-selection evidence must be attached to the same peak pressure factor lookup case as the localized structural-member category and selected peak pressure factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPeakPressureFactorLookupCase ?peakCase ;
                      nltl:hasTableLookupCase ?tableCase .
                FILTER (?peakCase != ?tableCase)
            }
        """
    ] ;

    sh:sparql [
        sh:message "averageIcePressure must equal iceForce divided by loadPatchHeight and loadPatchLength, with iceForce converted from kN to MN; the comparison uses a relative tolerance of 1e-6 with an absolute fallback near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceForce ?forceQ ;
                      nltl:loadPatchHeight ?heightQ ;
                      nltl:loadPatchLength ?lengthQ ;
                      nltl:averageIcePressure ?averageQ .

                ?forceQ qudt:numericValue ?force .
                ?heightQ qudt:numericValue ?height .
                ?lengthQ qudt:numericValue ?length .
                ?averageQ qudt:numericValue ?average .

                FILTER (
                    datatype(?force) = xsd:decimal &&
                    datatype(?height) = xsd:decimal &&
                    datatype(?length) = xsd:decimal &&
                    datatype(?average) = xsd:decimal &&
                    ?height > 0 &&
                    ?length > 0
                )

                BIND ((?force / 1000) / (?height * ?length) AS ?expected)
                BIND (1e-6 * IF (ABS(?expected) > 1, ABS(?expected), 1) AS ?tolerance)

                FILTER (
                    ?average < (?expected - ?tolerance) ||
                    ?average > (?expected + ?tolerance)
                )
            }
        """
    ] .
