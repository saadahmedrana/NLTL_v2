@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:node [
            sh:class nltl:iceLoadPatch
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must identify its design ice load patch."
    ] ;

    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Average ice pressure must be supplied as a single MPa quantity."
    ] ;

    sh:property [
        sh:path nltl:iceForce ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice force must be supplied as a single kN quantity."
    ] ;

    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Load patch height must be supplied as a single metre quantity."
    ] ;

    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Load patch length must be supplied as a single metre quantity."
    ] ;

    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must supply a single dimensionless peak pressure factor."
    ] ;

    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:node [
            sh:class nltl:peakPressureFactorLookupCase ;
            sh:class nltl:tableLookupCase ;

            sh:property [
                sh:path nltl:localizedStructuralMemberCategory ;
                sh:in (
                    nltl:bottomStructureFrameCategory
                    nltl:longitudinallyFramedPlatingCategory
                    nltl:stringerSideLongitudinalOrWebFrameCategory
                    nltl:transverseFrameWithLoadDistributingStringersCategory
                    nltl:transverseFrameWithoutLoadDistributingStringersCategory
                    <https://w3id.org/nltl/vocab#transverselyFramedPlatingCategory>
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The lookup case must identify one permitted localized structural-member category."
            ] ;

            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:iacsUrI2Table3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The peak pressure factor lookup case must reference IACS UR I2 Table 3."
            ] ;

            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ] ;
                sh:minCount 1 ;
                sh:message "The Table 3 selection must have lookup-selection evidence."
            ] ;

            sh:property [
                sh:path nltl:selectedPeakPressureFactor ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The lookup case must provide one selected dimensionless peak pressure factor."
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must identify a peak pressure factor lookup case."
    ] ;

    sh:sparql [
        sh:message "Average ice pressure must equal ice force in MN divided by load patch height and length, within a relative tolerance of 1e-6 with a 1e-9 MPa absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:averageIcePressure ?averageQuantity ;
                      nltl:iceForce ?forceQuantity ;
                      nltl:loadPatchHeight ?heightQuantity ;
                      nltl:loadPatchLength ?lengthQuantity .

                ?averageQuantity qudt:numericValue ?average .
                ?forceQuantity qudt:numericValue ?force .
                ?heightQuantity qudt:numericValue ?height .
                ?lengthQuantity qudt:numericValue ?length .

                BIND((?force / 1000) / (?height * ?length) AS ?expected)
                BIND(ABS(?expected) * 0.000001 AS ?relativeTolerance)
                BIND(IF(?relativeTolerance > 0.000000001,
                        ?relativeTolerance,
                        0.000000001) AS ?tolerance)

                FILTER (ABS(?average - ?expected) > ?tolerance)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The ship-level peak pressure factor must equal the selected factor from its Table 3 lookup case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:peakPressureFactor ?shipFactorQuantity ;
                      nltl:hasPeakPressureFactorLookupCase ?lookupCase .

                ?shipFactorQuantity qudt:numericValue ?shipFactor .
                ?lookupCase nltl:selectedPeakPressureFactor ?selectedFactorQuantity .
                ?selectedFactorQuantity qudt:numericValue ?selectedFactor .

                FILTER (?shipFactor != ?selectedFactor)
            }
        """
    ] .
