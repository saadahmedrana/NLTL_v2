@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gs:StructuralMemberShape
    ] .

gs:StructuralMemberShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasStructuralMember ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:class nltl:hullAreaValue ;
        sh:node gs:HullAreaValueShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:SelectedHullAreaFactorShape
    ] ;
    sh:sparql [
        sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor among the hull areas spanned by the structural member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?area .
                ?area nltl:hullAreaFactor ?factorNode .
                ?factorNode qudt:numericValue ?expected .
                $this nltl:selectedHullAreaFactor ?selectedNode .
                ?selectedNode qudt:numericValue ?observed .
                FILTER (DATATYPE(?expected) = xsd:decimal)
                FILTER (DATATYPE(?observed) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:hasSpannedHullArea ?higherArea .
                    ?higherArea nltl:hullAreaFactor ?higherFactorNode .
                    ?higherFactorNode qudt:numericValue ?higher .
                    FILTER (?higher > ?expected)
                }
                FILTER (
                    ABS(?observed - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

gs:HullAreaValueShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasSpannedHullArea ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gs:SelectedHullAreaFactorShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
