@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_019_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_019_StructuralMemberShape
    ] .

gen:I2_019_StructuralMemberShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:node gen:I2_019_HullAreaValueShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:I2_019_QuantityValueShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:maxCount 0
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "selectedHullAreaFactor must equal the maximum spanned hull area factor within a relative tolerance of 1e-6, with an absolute fallback of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?area ;
                      nltl:selectedHullAreaFactor ?selectedFactor .
                ?area nltl:hullAreaFactor ?factor .
                ?factor qudt:numericValue ?factorValue .
                ?selectedFactor qudt:numericValue ?selectedValue .

                {
                    SELECT ?member (MAX(?candidateValue) AS ?expectedMaximum)
                    WHERE {
                        ?member nltl:hasSpannedHullArea ?candidateArea .
                        ?candidateArea nltl:hullAreaFactor ?candidateFactor .
                        ?candidateFactor qudt:numericValue ?candidateValue .
                    }
                    GROUP BY ?member
                }

                FILTER (?member = $this)
                BIND (ABS(?expectedMaximum) * 0.000001 AS ?relativeTolerance)
                BIND (
                    IF(
                        ?relativeTolerance > 0.000001,
                        ?relativeTolerance,
                        0.000001
                    ) AS ?tolerance
                )
                FILTER (
                    ABS(?selectedValue - ?expectedMaximum) > ?tolerance
                )
            }
        """
    ] .

gen:I2_019_HullAreaValueShape a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_019_QuantityValueShape
    ] .

gen:I2_019_QuantityValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
