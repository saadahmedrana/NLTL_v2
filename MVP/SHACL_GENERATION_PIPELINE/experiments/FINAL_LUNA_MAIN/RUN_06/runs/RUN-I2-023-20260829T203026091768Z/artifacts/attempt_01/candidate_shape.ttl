@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-023-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-023-LengthQuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-023-AngleQuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-023-MilliMQuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-023-UnitlessQuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-023-StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityValueShape> ;
        sh:message "Each structural member requires frame spacing in metres."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-UnitlessQuantityValueShape> ;
        sh:message "Each structural member requires the selected hull area factor."
    ] .

<urn:nltl:generated-shape:I2-023-PlatingShape>
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-AngleQuantityValueShape> ;
        sh:message "Each plating item requires its framing angle omega."
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-MilliMQuantityValueShape> ;
        sh:message "Each plating item requires the externally computed ice-load net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-StructuralMemberShape> ;
        sh:message "Each plating item must identify its supporting structural member."
    ] .

<urn:nltl:generated-shape:I2-023-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-QuantityValueShape> ;
        sh:message "The ship requires average ice pressure as an input to the external calculation."
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityValueShape> ;
        sh:message "The ship requires frame span as an input to the external calculation."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-LengthQuantityValueShape> ;
        sh:message "The ship requires load patch height as an input to the external calculation."
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-UnitlessQuantityValueShape> ;
        sh:message "The ship requires the peak pressure factor as an input to the external calculation."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-QuantityValueShape> ;
        sh:message "The ship requires yield strength as an input to the external calculation."
    ] ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-023-PlatingShape> ;
        sh:message "The ship must provide the plating relationship required by the calculation model."
    ] .
