@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_032_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node nltl:structuralMember
    ] ;
    sh:sparql [
        sh:message "The actual net effective shear area must satisfy the calculated required transverse frame shear area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:averageIcePressure ?pressureValue ;
                      nltl:frameSpan ?frameSpanValue ;
                      nltl:loadPatchHeight ?heightValue ;
                      nltl:peakPressureFactor ?peakFactorValue ;
                      nltl:shearArea ?shearAreaValue ;
                      nltl:span ?spanValue ;
                      nltl:yieldStrength ?yieldValue ;
                      nltl:hasStructuralMember ?member .

                ?pressureValue qudt:numericValue ?pressure ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?frameSpanValue qudt:numericValue ?frameSpan ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                ?heightValue qudt:numericValue ?height ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?peakFactorValue qudt:numericValue ?peakFactor ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?shearAreaValue qudt:numericValue ?actualArea ;
                               qudt:unit <http://qudt.org/vocab/unit/M2> .
                ?spanValue qudt:numericValue ?span ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                ?yieldValue qudt:numericValue ?yieldStrength ;
                            qudt:unit <http://qudt.org/vocab/unit/MegaPA> .

                ?member nltl:frameSpacing ?spacingValue ;
                        nltl:selectedHullAreaFactor ?selectedFactorValue ;
                        nltl:requiredTransverseFrameShearArea ?requiredValue .

                ?spacingValue qudt:numericValue ?spacing ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                ?selectedFactorValue qudt:numericValue ?selectedFactor ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?requiredValue qudt:numericValue ?requiredArea ;
                               qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                ?hullAreaNode a nltl:hullAreaValue ;
                              nltl:hullAreaFactor ?hullFactorValue .
                ?hullFactorValue qudt:numericValue ?hullFactor ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER (?yieldStrength > 0)
                FILTER (?span >= 0)
                FILTER (?frameSpan >= 0)
                FILTER (?height >= 0)
                FILTER (?spacing >= 0)
                FILTER (?hullFactor >= 0)
                FILTER (?selectedFactor >= 0)
                FILTER (?frameSpan = ?span)
                FILTER (?hullFactor = ?selectedFactor)

                BIND(IF(?span < ?height, ?span, ?height) AS ?ll)
                BIND((100 * 100 * 0.5 * ?ll * ?spacing *
                      (?hullFactor * ?peakFactor * ?pressure) /
                      (0.577 * ?yieldStrength)) AS ?expectedArea)

                FILTER (?expectedArea > 0)
                FILTER (?actualArea + (0.000001 * ?expectedArea + 0.000001) < ?expectedArea)
            }
        """
    ] .

gs:I2_032_StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredTransverseFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gs:I2_032_HullAreaValueShape
    a sh:NodeShape ;
    sh:targetClass nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
