@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2_037_StaticShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:class nltl:iceLoadPatch ;
        sh:minCount 1 ;
        sh:message "The ship must link the ice load patch used by the design case."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:class nltl:iceLoadPatchDesignCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:memberCapacityMinimizationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ice load patch design case must confirm capacity minimization."
            ]
        ] ;
        sh:message "The ship must link an ice load patch design case with confirmed capacity minimization."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:class nltl:loadCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:loadPatchApplicationLocation ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:combinedShearBendingEffect ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each structural member must have a load case specifying the patch application location and combined bending/shear effect."
            ] ;
            sh:property [
                sh:path nltl:memberCapacity ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each structural member must provide its capacity as a single kN quantity."
            ]
        ] ;
        sh:message "Each linked structural member must have its load case and capacity."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The linked ice load patch and design case must be used with each structural member load case whose location is associated with the member's minimized combined bending/shear capacity." ;
        sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#>\nSELECT $this\nWHERE {\n    $this nltl:hasIceLoadPatch ?patch .\n    $this nltl:hasIceLoadPatchDesignCase ?designCase .\n    ?designCase nltl:memberCapacityMinimizationConfirmed true .\n    $this nltl:hasStructuralMember ?member .\n    ?member nltl:hasStructuralMemberLoadCase ?loadCase .\n    ?loadCase nltl:loadPatchApplicationLocation ?location .\n    ?loadCase nltl:combinedShearBendingEffect ?combinedEffect .\n    ?member nltl:memberCapacity ?capacity .\n}"
    ] .
</urn:nltl:generated-shape:I2_037_StaticShape>
