@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_046_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "polarClassRequirementsApplicable must be recorded exactly once."
    ] ;
    sh:property [
        sh:path nltl:hasInternalIceStrengthenedStructure ;
        sh:node gen:I2_046_InternalStructureShape
    ] ;
    sh:or (
        gen:I2_046_ApplicableShape
        gen:I2_046_NonApplicableShape
    ) .

gen:I2_046_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "An applicable ship must have one valid polarClass value."
    ] .

gen:I2_046_NonApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:hasValue false
    ] .

gen:I2_046_InternalStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_046_AllowanceQuantityShape ;
        sh:message "Each linked internal ice-strengthened structure must have one corrosion/abrasion addition of at least 1.0 mm."
    ] .

gen:I2_046_AllowanceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:MilliM
    ] .
