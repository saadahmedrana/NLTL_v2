@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-046-InternalStructureAddition>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "1.0"^^xsd:decimal ;
        sh:message "The internal structure corrosion/abrasion addition must be exactly 1.0 mm."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The internal structure corrosion/abrasion addition must use exactly the MilliM unit."
    ] .

<urn:nltl:generated-shape:I2-046-Ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must provide exactly one Polar Class requirements applicability boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                ) ;
                sh:message "An applicable Polar Class ship must provide exactly one valid Polar Class value."
            ] ;
            sh:property [
                sh:path nltl:hasInternalIceStrengthenedStructure ;
                sh:node <urn:nltl:generated-shape:I2-046-InternalIceStrengthenedStructure>
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue false
            ]
        ]
    ) .

<urn:nltl:generated-shape:I2-046-InternalIceStrengthenedStructure>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:node <urn:nltl:generated-shape:I2-046-InternalStructureAddition>
        ] ;
        sh:message "Every linked internal ice-strengthened structure must have exactly one 1.0 mm corrosion/abrasion addition."
    ] .
