@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one supported Polar Class."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented steel-grade case must identify exactly one assessed plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:in ( nltl:iacsUrI2Table8 ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:node <urn:nltl:generated-shape:I2-048-ThicknessShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must provide exactly one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must specify one supported material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must specify one supported steel strength category."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:node <urn:nltl:generated-shape:I2-048-GradeShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must provide exactly one actual hull structural steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:node <urn:nltl:generated-shape:I2-048-GradeShape> ;
        sh:maxCount 1 ;
        sh:message "An applicable steel-grade case may have at most one required hull structural steel grade."
    ] .

<urn:nltl:generated-shape:I2-048-ThicknessShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-048-GradeShape>
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:class nltl:steelGradeValue ;
    sh:in (
        nltl:steelGradeAh
        nltl:steelGradeB
        nltl:steelGradeD
        nltl:steelGradeDh
        nltl:steelGradeE
        nltl:steelGradeEh
        nltl:steelGradeFh
    ) ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-048-ApplicableRequiredGradeShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable steel-grade selection must provide a required hull structural steel grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:polarClass ?pc ;
                      nltl:hasSteelGradeRequirementCase $this .
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?mc ;
                      nltl:steelStrengthCategory ?sc ;
                      nltl:tableReference nltl:iacsUrI2Table8 .
                ?tv qudt:numericValue ?t ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (
                    ?t > 0 &&
                    (
                        (?t <= 50 && ?mc IN (
                            nltl:steelMaterialClassOne,
                            nltl:steelMaterialClassTwo
                        )) ||
                        (?t <= 35 && ?mc = nltl:steelMaterialClassThree) ||
                        (?t > 35 && ?t <= 50 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?sc = nltl:highTensileSteelCategory)
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:requiredHullStructuralSteelGrade ?required
                }
            }
        """
    ] .

<urn:nltl:generated-shape:I2-048-TableComparisonShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual hull structural steel grade must meet or exceed the exact Table 8 grade selected by Polar Class, thickness, material class, and strength category, within the same strength category." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:polarClass ?pc ;
                      nltl:hasSteelGradeRequirementCase $this .
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?mc ;
                      nltl:steelStrengthCategory ?sc ;
                      nltl:actualHullStructuralSteelGrade ?actual ;
                      nltl:requiredHullStructuralSteelGrade ?required ;
                      nltl:tableReference nltl:iacsUrI2Table8 .
                ?tv qudt:numericValue ?t ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?actual nltl:steelGradeOrderRank ?actualRank .
                ?required nltl:steelGradeOrderRank ?requiredRank .
                FILTER (
                    ?t > 0 &&
                    (
                        (?t <= 10 &&
                         ?mc IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeB, nltl:steelGradeAh)) ||
                        (?t <= 10 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeE, nltl:steelGradeEh)) ||

                        (?t > 10 && ?t <= 15 &&
                         ?mc = nltl:steelMaterialClassOne &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeB, nltl:steelGradeAh)) ||
                        (?t > 10 && ?t <= 15 &&
                         ?mc = nltl:steelMaterialClassTwo &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeD, nltl:steelGradeDh)) ||
                        (?t > 10 && ?t <= 15 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeE, nltl:steelGradeEh)) ||

                        (?t > 15 && ?t <= 35 &&
                         ?mc = nltl:steelMaterialClassOne &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeD, nltl:steelGradeDh)) ||
                        (?t > 15 && ?t <= 35 &&
                         ?mc = nltl:steelMaterialClassTwo &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeD, nltl:steelGradeDh)) ||
                        (?t > 15 && ?t <= 35 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?required = IF(?sc = nltl:normalStrengthSteelCategory,
                             nltl:steelGradeE, nltl:steelGradeEh)) ||

                        (?t > 35 && ?t <= 50 &&
                         ?mc = nltl:steelMaterialClassOne &&
                         ?required = IF(?pc IN (
                             nltl:polarClassPc1,
                             nltl:polarClassPc2,
                             nltl:polarClassPc3,
                             nltl:polarClassPc4,
                             nltl:polarClassPc5
                         ),
                             IF(?sc = nltl:normalStrengthSteelCategory,
                                 nltl:steelGradeE, nltl:steelGradeEh),
                             IF(?sc = nltl:normalStrengthSteelCategory,
                                 nltl:steelGradeD, nltl:steelGradeDh))) ||
                        (?t > 35 && ?t <= 50 &&
                         ?mc = nltl:steelMaterialClassTwo &&
                         ?required = IF(?pc IN (
                             nltl:polarClassPc1,
                             nltl:polarClassPc2,
                             nltl:polarClassPc3,
                             nltl:polarClassPc4,
                             nltl:polarClassPc5
                         ),
                             IF(?sc = nltl:normalStrengthSteelCategory,
                                 nltl:steelGradeE, nltl:steelGradeEh),
                             IF(?sc = nltl:normalStrengthSteelCategory,
                                 nltl:steelGradeD, nltl:steelGradeDh))) ||
                        (?t > 35 && ?t <= 50 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?sc = nltl:highTensileSteelCategory &&
                         ?required =
                             IF(?pc IN (
                                 nltl:polarClassPc1,
                                 nltl:polarClassPc2,
                                 nltl:polarClassPc3
                             ), nltl:steelGradeFh,
                             IF(?pc IN (
                                 nltl:polarClassPc4,
                                 nltl:polarClassPc5
                             ), nltl:steelGradeFh,
                             nltl:steelGradeEh))) ||
                        (?t > 35 && ?t <= 50 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?sc = nltl:normalStrengthSteelCategory &&
                         ?pc IN (
                             nltl:polarClassPc1,
                             nltl:polarClassPc2,
                             nltl:polarClassPc3,
                             nltl:polarClassPc4,
                             nltl:polarClassPc5
                         ) &&
                         ?required = nltl:steelGradeE) ||
                        (?t > 35 && ?t <= 50 &&
                         ?mc = nltl:steelMaterialClassThree &&
                         ?sc = nltl:normalStrengthSteelCategory &&
                         ?pc IN (
                             nltl:polarClassPc6,
                             nltl:polarClassPc7
                         ) &&
                         ?required = nltl:steelGradeE)
                    )
                )
                FILTER ( ?actualRank < ?requiredRank || ?actual != ?required )
            }
        """
    ] .
