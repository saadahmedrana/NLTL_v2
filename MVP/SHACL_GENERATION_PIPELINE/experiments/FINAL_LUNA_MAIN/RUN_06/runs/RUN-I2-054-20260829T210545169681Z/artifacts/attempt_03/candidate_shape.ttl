@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_054_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_054_CalculationCaseShape ;
        sh:message "The ship shall provide a calculation case containing the prescribed paired interpolation anchors."
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:class nltl:hullGirderBendingMomentCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_054_HullGirderCaseShape ;
        sh:message "The ship shall provide a hull-girder bending-moment calculation case with the required inputs and externally calculated result."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:I2_054_CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 5 ;
        sh:node gen:I2_054_InterpolationPointShape ;
        sh:message "The calculation case shall contain one coherent collection of paired interpolation points."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The interpolation collection shall contain paired anchors (0.0,0.0), (0.5,1.0), (0.7,1.0), (0.95,0.3), and (1.0,0.0)." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p0 .
      ?p0 nltl:interpolationPointCoordinate ?c0 ;
          nltl:interpolationPointResult ?r0 .
      ?c0 qudt:numericValue ?cn0 .
      ?r0 qudt:numericValue ?rn0 .
      FILTER (?cn0 = 0.0 && ?rn0 = 0.0)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p1 .
      ?p1 nltl:interpolationPointCoordinate ?c1 ;
          nltl:interpolationPointResult ?r1 .
      ?c1 qudt:numericValue ?cn1 .
      ?r1 qudt:numericValue ?rn1 .
      FILTER (?cn1 = 0.5 && ?rn1 = 1.0)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p2 .
      ?p2 nltl:interpolationPointCoordinate ?c2 ;
          nltl:interpolationPointResult ?r2 .
      ?c2 qudt:numericValue ?cn2 .
      ?r2 qudt:numericValue ?rn2 .
      FILTER (?cn2 = 0.7 && ?rn2 = 1.0)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p3 .
      ?p3 nltl:interpolationPointCoordinate ?c3 ;
          nltl:interpolationPointResult ?r3 .
      ?c3 qudt:numericValue ?cn3 .
      ?r3 qudt:numericValue ?rn3 .
      FILTER (?cn3 = 0.95 && ?rn3 = 0.3)
    }
    ||
    NOT EXISTS {
      $this nltl:hasInterpolationPoint ?p4 .
      ?p4 nltl:interpolationPointCoordinate ?c4 ;
          nltl:interpolationPointResult ?r4 .
      ?c4 qudt:numericValue ?cn4 .
      ?r4 qudt:numericValue ?rn4 .
      FILTER (?cn4 = 1.0 && ?rn4 = 0.0)
    }
  )
}
"""
    ] .

gen:I2_054_InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:I2_054_HullGirderCaseShape
    a sh:NodeShape ;
    sh:class nltl:hullGirderBendingMomentCalculationCase ;
    sh:property [
        sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:caseBendingMomentDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:caseDesignVerticalIceBendingMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
