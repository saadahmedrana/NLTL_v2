@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:message "A nonlinear calculation case is required for the applicable structure."
    ] ;
    sh:property [
        sh:path nltl:fractureMargin ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dimensionless fracture margin is required."
    ] ;
    sh:property [
        sh:path nltl:majorBucklingMargin ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dimensionless major buckling margin is required."
    ] ;
    sh:property [
        sh:path nltl:yieldingMargin ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dimensionless yielding margin is required."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node gs:CalculationCaseShape
    ] .

gs:CalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:class nltl:calculationMethodValue ;
        sh:hasValue nltl:nonlinearCalculationMethodValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The calculation case must identify the nonlinear calculation method."
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Acceptance evidence for the nonlinear analysis is required."
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The permanent deformation assessment must be recorded as satisfied."
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A permanent lateral deformation value in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A permanent out-of-plane deformation value in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The relevant structural dimension in millimetres is required."
    ] .
