@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2_065_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:calculationMethod ;
                        sh:minCount 1 ;
                        sh:hasValue nltl:nonlinearCalculationMethodValue
                    ] ;
                    sh:property [
                        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:evidenceArtifact
                    ] ;
                    sh:property [
                        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype <http://www.w3.org/2001/XMLSchema#boolean> ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:fractureMargin ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:majorBucklingMargin ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:yieldingMargin ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:permanentLateralDeformation ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:permanentOutOfPlaneDeformation ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:relevantStructuralDimension ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:calculationMethod ;
                        sh:minCount 1 ;
                        sh:in (
                            nltl:directCalculationMethodValue
                            nltl:linearCalculationMethodValue
                            nltl:prescribedAnalyticalProcedure
                        )
                    ]
                ]
            )
        ]
    ] .
