@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-067-StrengthContinuity>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:structuralConnection ;
        sh:minCount 1 ;
        sh:class nltl:benchmarkEntity ;
        sh:message "The ship must identify at least one structural connection for strength-continuity verification."
    ] ;
    sh:property [
        sh:path nltl:strengthContinuityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Strength continuity must be recorded as true for the ship's structural connections."
    ] .
