@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-005> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:totalIcePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "A total ice presence observation is required to establish whether the ice condition is permitted."
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "The ice condition 'ice free waters' shall not be used when total ice is present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition ;
                      nltl:totalIcePresent ?totalIcePresent .
                FILTER (
                    str(?condition) = "ice free waters" &&
                    ?totalIcePresent = true
                )
            }
        """
    ] .
