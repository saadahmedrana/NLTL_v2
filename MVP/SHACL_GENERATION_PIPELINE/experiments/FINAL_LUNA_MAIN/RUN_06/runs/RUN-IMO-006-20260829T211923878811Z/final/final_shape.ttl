@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_006_MediumFirstYearIceThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:message "A ship must provide an ice type classification to determine the applicable thickness requirement."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For medium first-year ice, every ice thickness quantity must be a decimal in metres from 0.7 m through 1.2 m inclusive." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:mediumFirstYearIce .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceThickness ?thickness .
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        FILTER NOT EXISTS {
                            ?thickness a qudt:QuantityValue ;
                                qudt:unit unit:M ;
                                qudt:numericValue ?value .
                            FILTER (
                                datatype(?value) = xsd:decimal &&
                                ?value >= "0.7"^^xsd:decimal &&
                                ?value <= "1.2"^^xsd:decimal
                            )
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        ?thickness qudt:unit ?unitValue .
                        FILTER (?unitValue != unit:M)
                    }
                    ||
                    EXISTS {
                        $this nltl:iceThickness ?thickness .
                        ?thickness qudt:numericValue ?value .
                        FILTER (
                            datatype(?value) != xsd:decimal ||
                            ?value < "0.7"^^xsd:decimal ||
                            ?value > "1.2"^^xsd:decimal
                        )
                    }
                )
            }
        """
    ] .
