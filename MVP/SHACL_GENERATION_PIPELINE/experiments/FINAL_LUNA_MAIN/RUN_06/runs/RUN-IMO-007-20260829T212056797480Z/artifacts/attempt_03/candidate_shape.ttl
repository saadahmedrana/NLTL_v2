@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-007> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship shall provide one ice condition classification."
    ] ;
    sh:sparql [
        sh:message "For open-water classification, every sea ice concentration quantity shall be a QuantityValue with decimal numeric value strictly less than 1 and unit UNITLESS; ice of land origin shall be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                {
                    FILTER NOT EXISTS {
                        $this nltl:seaIceConcentration ?quantity .
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    FILTER NOT EXISTS {
                        ?quantity a qudt:QuantityValue .
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    FILTER NOT EXISTS {
                        ?quantity qudt:numericValue ?value .
                        FILTER (datatype(?value) = xsd:decimal)
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    ?quantity qudt:numericValue ?value .
                    FILTER (!(datatype(?value) = xsd:decimal && ?value < 1))
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    FILTER NOT EXISTS {
                        ?quantity qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    }
                }
                UNION
                {
                    $this nltl:seaIceConcentration ?quantity .
                    ?quantity qudt:unit ?unit .
                    FILTER (?unit != <http://qudt.org/vocab/unit/UNITLESS>)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent ?present .
                        FILTER (datatype(?present) = xsd:boolean && ?present = false)
                    }
                }
                UNION
                {
                    $this nltl:iceOfLandOriginPresent ?present .
                    FILTER (!(datatype(?present) = xsd:boolean && ?present = false))
                }
            }
        """
    ] .
