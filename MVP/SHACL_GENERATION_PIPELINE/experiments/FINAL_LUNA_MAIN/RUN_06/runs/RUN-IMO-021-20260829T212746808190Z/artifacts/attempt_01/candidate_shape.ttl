@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_021_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operationalAssessmentPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall record that an operational assessment is present."
    ] ;
    sh:property [
        sh:path nltl:assessedLowAirTemperature ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The operational assessment shall cover low-air-temperature operation."
    ] ;
    sh:property [
        sh:path nltl:assessedIceOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover operation in ice."
    ] ;
    sh:property [
        sh:path nltl:assessedHighLatitude ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover operation in high latitude."
    ] ;
    sh:property [
        sh:path nltl:assessedAbandonment ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover potential abandonment onto ice or land."
    ] ;
    sh:property [
        sh:path nltl:assessedCodeHazards ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover applicable hazards listed in Introduction section 3."
    ] ;
    sh:property [
        sh:path nltl:assessedAdditionalHazards ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover identified additional hazards."
    ] .
