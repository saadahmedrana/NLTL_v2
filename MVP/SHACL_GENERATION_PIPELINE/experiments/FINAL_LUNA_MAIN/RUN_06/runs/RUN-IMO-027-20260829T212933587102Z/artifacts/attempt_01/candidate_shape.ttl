@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-027> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualRiskProcedureCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall indicate coverage of risk-based procedures in the Polar Water Operational Manual."
    ] ;
    sh:property [
        sh:path nltl:voyageLimitAvoidance ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual shall include a voyage-limit avoidance procedure."
    ] ;
    sh:property [
        sh:path nltl:environmentalForecastArrangements ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual shall include arrangements for receiving environmental forecasts."
    ] ;
    sh:property [
        sh:path nltl:informationLimitationMeasures ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual shall include measures addressing limitations of available information."
    ] ;
    sh:property [
        sh:path nltl:requiredEquipmentOperation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual shall include procedures for operation of required equipment."
    ] ;
    sh:property [
        sh:path nltl:environmentalFunctionalityMeasures ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual shall indicate applicable environmental functionality measures."
    ] .
