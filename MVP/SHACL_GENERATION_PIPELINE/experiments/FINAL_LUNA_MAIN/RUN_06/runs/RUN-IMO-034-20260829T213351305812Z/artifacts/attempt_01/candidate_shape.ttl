@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO034Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO034NotLikelyBranch
        gen:IMO034LikelyBranch
    ) ;
    sh:message "The ship must declare whether ice accretion is likely and, when it is likely, provide the required ice-minimization design and ice-removal means." .

gen:IMO034NotLikelyBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Ice accretion likelihood must be explicitly recorded as false for this branch."
    ] .

gen:IMO034LikelyBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Ice accretion likelihood must be explicitly recorded as true for this branch."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionMinimizationDesignPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice accretion is likely, an ice-accretion minimization design must be present."
    ] ;
    sh:property [
        sh:path nltl:requiredIceRemovalMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice accretion is likely, required ice-removal means must be present."
    ] ;
    sh:property [
        sh:path nltl:administrationRequiredIceRemovalMeans ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When ice accretion is likely, the Administration-required ice-removal means must be recorded."
    ] .
