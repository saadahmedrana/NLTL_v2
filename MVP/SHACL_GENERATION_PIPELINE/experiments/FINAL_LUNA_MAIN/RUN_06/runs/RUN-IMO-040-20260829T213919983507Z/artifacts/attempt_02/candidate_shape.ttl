@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must provide explicit ice-accretion applicability evidence."
    ] ;
    sh:or (
        gen:IMO_040_IceAccretionLikelyShape
        gen:IMO_040_IceAccretionNotLikelyShape
    ) .

gen:IMO_040_IceAccretionLikelyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasRelevantHatchOrDoor ;
        sh:class nltl:relevantHatchOrDoorItem ;
        sh:node gen:IMO_040_RelevantHatchOrDoorShape
    ] .

gen:IMO_040_IceAccretionNotLikelyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1
    ] .

gen:IMO_040_RelevantHatchOrDoorShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each relevant hatch or door must have associated ice or snow removal or prevention means."
    ] .
