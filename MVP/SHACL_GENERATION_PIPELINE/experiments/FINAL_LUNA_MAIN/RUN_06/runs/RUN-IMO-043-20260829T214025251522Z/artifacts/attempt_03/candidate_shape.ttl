@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_043_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node gen:IMO_043_MachineryInstallationShape
    ] .

gen:IMO_043_MachineryInstallationShape
    a sh:NodeShape ;
    sh:class nltl:machineryInstallationItem ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:minCount 6 ;
        sh:maxCount 6 ;
        sh:in (
            nltl:iceAccretionHazard
            nltl:snowAccumulationHazard
            nltl:seawaterIceIngestionHazard
            nltl:liquidFreezingOrViscosityIncreaseHazard
            nltl:seawaterIntakeTemperatureHazard
            nltl:snowIngestionHazard
        ) ;
        sh:message "Each machinery installation shall identify all six applicable hazards." 
    ] ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:node gen:IMO_043_AssociatedEquipmentShape
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each machinery installation shall have protection evidence for its applicable hazards and associated equipment."
    ] .

gen:IMO_043_AssociatedEquipmentShape
    a sh:NodeShape ;
    sh:class nltl:associatedEquipmentItem .
