@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO047ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEssentialEngine ;
        sh:class nltl:essentialEngine ;
        sh:minCount 1 ;
        sh:node gs:IMO047EssentialEngineShape ;
        sh:message "The ship must identify its essential engine or engines and provide combustion-air temperature compliance data for each."
    ] .

gs:IMO047EssentialEngineShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:combustionAirTemperatureControlPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Combustion-air temperature control must be recorded as present for each essential engine."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO047TemperatureQuantityShape ;
        sh:message "A combustion-air temperature in degrees Celsius is required for each essential engine."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMinAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO047TemperatureQuantityShape ;
        sh:message "The manufacturer's minimum permissible combustion-air temperature is required for each essential engine."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMaxAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO047TemperatureQuantityShape ;
        sh:message "The manufacturer's maximum permissible combustion-air temperature is required for each essential engine."
    ] ;
    sh:sparql [
        sh:message "The combustion-air temperature must be within the manufacturer's stated minimum and maximum criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:combustionAirTemperature ?temperatureQuantity .
                ?temperatureQuantity qudt:numericValue ?temperatureValue .
                $this nltl:manufacturerMinAirTemperature ?minimumQuantity .
                ?minimumQuantity qudt:numericValue ?minimumValue .
                $this nltl:manufacturerMaxAirTemperature ?maximumQuantity .
                ?maximumQuantity qudt:numericValue ?maximumValue .
                FILTER (
                    ?temperatureValue < ?minimumValue ||
                    ?temperatureValue > ?maximumValue
                )
            }
        """
    ] .

gs:IMO047TemperatureQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
