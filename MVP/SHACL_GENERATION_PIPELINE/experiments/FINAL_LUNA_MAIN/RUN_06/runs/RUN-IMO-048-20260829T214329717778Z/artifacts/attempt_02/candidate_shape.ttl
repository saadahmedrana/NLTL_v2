@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO048ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO048ApplicableShape
        gen:IMO048NoExposedMaterialShape
    ) .

gen:IMO048ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:exposedMachineryOrFoundationMaterial ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An exposed machinery or foundation material must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:approvalEvidence
        ] ;
        sh:message "Approval evidence must be provided for the exposed machinery or foundation material."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
        sh:message "The approving authority must be the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "standard acceptable to the Organization" "another standard offering an equivalent level of safety" ) ;
        sh:message "The approval standard must be Organization-acceptable or offer an equivalent level of safety."
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceState
        ] ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The material approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:polarServiceTemperature ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG_C
            ]
        ] ;
        sh:message "The polar service temperature basis must be provided as a degree Celsius quantity."
    ] .

gen:IMO048NoExposedMaterialShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:exposedMachineryOrFoundationMaterial ;
        sh:maxCount 0
    ] .
