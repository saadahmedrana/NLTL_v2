@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-057_FirePumpCompartmentTemperatureShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must be linked to a compartment whose maintained temperature is a decimal value greater than 0 degrees Celsius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this rdf:type nltl:ship .
                $this nltl:hasComponent ?pump .
                ?pump rdf:type ?pumpClass .
                FILTER (
                    ?pumpClass IN (
                        nltl:firePump,
                        nltl:emergencyFirePump,
                        nltl:waterMistPump,
                        nltl:waterSprayPump
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                    }
                    ||
                    EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                        FILTER NOT EXISTS {
                            ?compartment nltl:maintainedTemperature ?temperature .
                            ?temperature rdf:type qudt:QuantityValue .
                            ?temperature qudt:numericValue ?value .
                            ?temperature qudt:unit unit:DEG_C .
                            FILTER (datatype(?value) = xsd:decimal)
                            FILTER (?value > 0)
                        }
                    }
                )
            }
        """
    ] .
