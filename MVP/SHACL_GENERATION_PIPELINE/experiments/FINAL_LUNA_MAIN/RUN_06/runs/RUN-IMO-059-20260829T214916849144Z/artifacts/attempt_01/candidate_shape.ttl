@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-059-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node <urn:nltl:generated-shape:IMO-059-FirefighterOutfitShape> ;
        sh:message "Each linked firefighter outfit shall be stored in a warm location."
    ] .

<urn:nltl:generated-shape:IMO-059-FirefighterOutfitShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStorageLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:physicalStorageLocation ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-059-StorageLocationShape> ;
        sh:message "A firefighter outfit shall have a storage location."
    ] .

<urn:nltl:generated-shape:IMO-059-StorageLocationShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:storageTemperatureClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in ( nltl:warmStorageLocation ) ;
        sh:message "The storage location shall be classified as warm."
    ] .
