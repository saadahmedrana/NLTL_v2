@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_064_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personOnBoard ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall record the persons-on-board manifest count."
    ] ;
    sh:property [
        sh:path nltl:assignedThermalProtection ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Assigned thermal-protection equipment shall be provided for persons on board."
    ] ;
    sh:property [
        sh:path nltl:thermalProtectionApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Thermal-protection adequacy approval shall be approved."
    ] ;
    sh:property [
        sh:path nltl:intendedVoyage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The intended voyage shall be recorded for thermal-protection adequacy."
    ] ;
    sh:property [
        sh:path nltl:anticipatedCold ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Anticipated cold shall be recorded for thermal-protection adequacy."
    ] ;
    sh:property [
        sh:path nltl:anticipatedWind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Anticipated wind shall be recorded for thermal-protection adequacy."
    ] ;
    sh:property [
        sh:path nltl:immersionPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable potential for immersion in polar water shall be recorded."
    ] .
