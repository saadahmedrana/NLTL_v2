@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_072_ExtendedDarknessSearchlightShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must provide one boolean extended-darkness-operation applicability value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For extended darkness operation, every lifeboat must have an assigned searchlight with continuous-use suitability status true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:extendedDarknessOperation true .
                $this nltl:hasLifeboat ?lifeboat .
                FILTER NOT EXISTS {
                    ?lifeboat nltl:hasAssignedSearchlight ?searchlight .
                    ?searchlight nltl:searchlightContinuousUseSuitabilityStatus ?status .
                    FILTER (
                        datatype(?status) = xsd:boolean &&
                        ?status = true
                    )
                }
            }
        """
    ] .
