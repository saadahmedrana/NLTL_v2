@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-082-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall comply with SOLAS regulation V/22.1.9.4."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "The bridge configuration is required to determine whether a clear astern view is required."
    ] ;
    sh:property [
        sh:path nltl:clearViewAsternStatus ;
        sh:datatype xsd:boolean ;
        sh:message "The clear astern view status, when represented, shall be boolean."
    ] ;
    sh:sparql [
        sh:message "A clear astern view shall be compliant when the bridge configuration requires it." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                OPTIONAL {
                    $this nltl:bridgeConfigurationType ?configuration .
                }
                OPTIONAL {
                    $this nltl:clearViewAsternStatus ?clearView .
                }
                FILTER (
                    !BOUND(?configuration)
                    ||
                    (
                        ?configuration = nltl:asternViewRequiredBridgeConfiguration
                        &&
                        (
                            !BOUND(?clearView)
                            ||
                            ?clearView != true
                        )
                    )
                )
            }
        """
    ] .
