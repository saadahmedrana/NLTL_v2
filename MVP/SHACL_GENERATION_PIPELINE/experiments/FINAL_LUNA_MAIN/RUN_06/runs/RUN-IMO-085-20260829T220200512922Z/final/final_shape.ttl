@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO085ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must have exactly one permitted polar ship category."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must have exactly one construction date."
    ] ;
    sh:or (
        gs:IMO085ApplicableBranch
        gs:IMO085CategoryCExemption
        gs:IMO085Pre2017Exemption
    ) .

gs:IMO085ApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:IMO085EnclosedBridgeWings
        gs:IMO085ProtectedBridgeWingDesign
    ) ;
    sh:message "Category A or B ships constructed on or after 1 January 2017 must have enclosed bridge wings or an approved bridge-wing protection design." .

gs:IMO085EnclosedBridgeWings a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeWingsEnclosed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:IMO085ProtectedBridgeWingDesign a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeWingProtectionDesignStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:IMO085CategoryCExemption a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:IMO085Pre2017Exemption a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
