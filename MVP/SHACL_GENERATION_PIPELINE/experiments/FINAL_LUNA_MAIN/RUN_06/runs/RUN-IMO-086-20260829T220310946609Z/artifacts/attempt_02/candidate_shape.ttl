@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO086ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 2 ;
        sh:node gs:IMO086HeadingMeansShape ;
        sh:message "The ship shall have at least two non-magnetic heading means."
    ] .

gs:IMO086HeadingMeansShape
    a sh:NodeShape ;
    sh:class nltl:nonMagneticHeadingMeans ;
    sh:class nltl:benchmarkEntity ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each non-magnetic heading means shall be connected to main power."
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each non-magnetic heading means shall be connected to emergency power."
    ] ;
    sh:property [
        sh:path nltl:independentFromHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each non-magnetic heading means shall have an independence relation to another heading means of the same ship."
    ] ;
    sh:sparql [
        sh:message "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means owned by the same ship." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
  FILTER NOT EXISTS {
    ?ship nltl:hasNonMagneticHeadingMeans $this .
    ?ship nltl:hasNonMagneticHeadingMeans ?other .
    FILTER (?other != $this)
    $this nltl:independentFromHeadingMeans ?other .
  }
}
"""
    ] .
