@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-088> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether it operates only in continuous daylight."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue false
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
                        sh:datatype xsd:integer ;
                        sh:minInclusive 2 ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:searchlightCoverageArc ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "360"^^xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:DEG ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:evidenceStateApproved ;
                        sh:minCount 1
                    ]
                ]
            ) ;
            sh:message "When the ship does not operate only in continuous daylight, it must provide either two or more bridge-controlled rotatable narrow-beam searchlights covering at least 360 degrees or approved alternative visual ice-detection means."
        ]
    ) .
