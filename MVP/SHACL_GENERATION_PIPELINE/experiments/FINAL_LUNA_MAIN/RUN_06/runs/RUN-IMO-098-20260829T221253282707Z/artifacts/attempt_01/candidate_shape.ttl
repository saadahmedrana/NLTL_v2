@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO098ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must record whether it operates in low air temperature." ;
    ] ;
    sh:or (
        gen:IMO098LowTemperatureTrueBranch
        gen:IMO098LowTemperatureFalseBranch
    ) .

gen:IMO098LowTemperatureTrueBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:node gen:IMO098OtherSurvivalCraftShape ;
        sh:message "When the ship operates in low air temperature, each other survival craft must carry both required communication devices." ;
    ] .

gen:IMO098LowTemperatureFalseBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:hasValue false ;
    ] .

gen:IMO098OtherSurvivalCraftShape
    a sh:NodeShape ;
    sh:class nltl:otherSurvivalCraft ;
    sh:property [
        sh:path nltl:hasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each other survival craft must carry at least one location-signal device." ;
    ] ;
    sh:property [
        sh:path nltl:hasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each other survival craft must carry at least one on-scene transmit/receive communication device." ;
    ] .
