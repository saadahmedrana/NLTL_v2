@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-101> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarRoutePlan ;
        sh:minCount 1 ;
        sh:class nltl:polarRoutePlan ;
        sh:node [
            sh:property [
                sh:path nltl:voyagePlanningTopicCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The polar route plan must indicate coverage of all nine required voyage-planning topics."
            ]
        ] ;
        sh:message "The ship must have a polar route plan with the required topic coverage."
    ] .
