@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_104_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall record completed PWOM familiarization."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:node gen:IMO_104_CrewMemberShape ;
        sh:class nltl:crewMember ;
        sh:message "Each linked crew member shall satisfy the PWOM familiarization constraints."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node gen:IMO_104_CrewMemberShape ;
        sh:class nltl:crewMember ;
        sh:message "Each crew member in the ship's crew inventory shall satisfy the PWOM familiarization constraints."
    ] .

gen:IMO_104_CrewMemberShape
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:node gen:IMO_104_AssignedDutyShape ;
        sh:class nltl:assignedDuty ;
        sh:message "The crew member's assigned duties shall identify relevant PWOM items."
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:node gen:IMO_104_FamiliarizationRecordShape ;
        sh:class nltl:familiarizationRecord ;
        sh:message "The crew member shall have a PWOM familiarization record."
    ] .

gen:IMO_104_AssignedDutyShape
    a sh:NodeShape ;
    sh:class nltl:assignedDuty ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:node gen:IMO_104_PWOMItemShape ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "Each assigned duty shall identify its relevant PWOM procedures or equipment."
    ] .

gen:IMO_104_FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:class nltl:familiarizationRecord ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:node gen:IMO_104_PWOMItemShape ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "The familiarization record shall cover the relevant PWOM procedures or equipment."
    ] .

gen:IMO_104_PWOMItemShape
    a sh:NodeShape ;
    sh:class nltl:polarWaterOperationalManualItem .
