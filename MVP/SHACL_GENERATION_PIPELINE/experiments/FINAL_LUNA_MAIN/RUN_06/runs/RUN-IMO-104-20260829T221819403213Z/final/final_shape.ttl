@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_104_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record completed PWOM familiarization."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_CrewMemberShape ;
        sh:message "The ship must link its crew members."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_CrewMemberShape ;
        sh:message "The ship must provide the required crew-member inventory path."
    ] .

gen:IMO_104_CrewMemberShape
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_AssignedDutyShape ;
        sh:message "Each crew member must have an assigned duty linked to relevant PWOM content."
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_FamiliarizationRecordShape ;
        sh:message "Each crew member must have a familiarization record."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each PWOM item relevant to a crew member's assigned duties must be represented in that crew member's familiarization record." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasAssignedDuty /
                      nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    $this nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """
    ] .

gen:IMO_104_AssignedDutyShape
    a sh:NodeShape ;
    sh:class nltl:assignedDuty ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_PWOMItemShape ;
        sh:message "Each assigned duty must identify relevant PWOM content."
    ] .

gen:IMO_104_FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:class nltl:familiarizationRecord ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:minCount 1 ;
        sh:node gen:IMO_104_PWOMItemShape ;
        sh:message "Each familiarization record must contain PWOM record items."
    ] .

gen:IMO_104_PWOMItemShape
    a sh:NodeShape ;
    sh:class nltl:polarWaterOperationalManualItem .
