@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO105ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO105ArcticApplicability
        gs:IMO105NonArcticApplicability
    ) ;
    sh:message "The ship's operating area must establish whether the Arctic-water discharge prohibition applies." .

gs:IMO105ArcticApplicability
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:hasValue "Arctic_waters" ;
        sh:message "An Arctic-water operating area must be identified as Arctic_waters."
    ] ;
    sh:property [
        sh:path nltl:oilOrOilyMixtureDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "Discharge of oil or oily mixtures to sea must be false in Arctic waters."
    ] ;
    sh:sparql [
        sh:message "Discharge of oil or oily mixtures to sea must not be true in Arctic waters." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea "Arctic_waters" .
                $this nltl:oilOrOilyMixtureDischargeToSea ?value .
                FILTER (?value = true)
            }
        """
    ] .

gs:IMO105NonArcticApplicability
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A non-Arctic operating area must be identified when the Arctic-water prohibition does not apply."
    ] ;
    sh:sparql [
        sh:message "This branch applies only when the operating area is not Arctic_waters." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area .
                FILTER (STR(?area) = "Arctic_waters")
            }
        """
    ] .
