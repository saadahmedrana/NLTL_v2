@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-108> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:aggregateOilFuelCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:individualOilFuelTankCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:oilFuelTankOuterShellSeparation ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For an applicable ship, every represented oil fuel tank separation must be a valid metre measurement of at least 0.76 m, and at least one valid measurement must be present." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:shipCategory ?category ;
        nltl:constructionDate ?date ;
        nltl:aggregateOilFuelCapacity ?aggregateQuantity ;
        nltl:individualOilFuelTankCapacity ?individualQuantity .

  ?aggregateQuantity a qudt:QuantityValue ;
                     qudt:numericValue ?aggregateValue ;
                     qudt:unit unit:M3 .
  ?individualQuantity a qudt:QuantityValue ;
                      qudt:numericValue ?individualValue ;
                      qudt:unit unit:M3 .

  FILTER (
    ?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB)
    && datatype(?date) = xsd:date
    && ?date >= "2017-01-01"^^xsd:date
    && datatype(?aggregateValue) = xsd:decimal
    && ?aggregateValue < "600"^^xsd:decimal
    && datatype(?individualValue) = xsd:decimal
    && ?individualValue > "30"^^xsd:decimal
  )

  FILTER (
    NOT EXISTS {
      $this nltl:oilFuelTankOuterShellSeparation ?validSeparation .
      ?validSeparation a qudt:QuantityValue ;
                       qudt:numericValue ?validValue ;
                       qudt:unit unit:M .
      FILTER (
        datatype(?validValue) = xsd:decimal
        && ?validValue >= "0.76"^^xsd:decimal
      )
    }
    ||
    EXISTS {
      $this nltl:oilFuelTankOuterShellSeparation ?representedSeparation .
      FILTER NOT EXISTS {
        ?representedSeparation a qudt:QuantityValue ;
                               qudt:numericValue ?representedValue ;
                               qudt:unit unit:M .
        FILTER (
          datatype(?representedValue) = xsd:decimal
          && ?representedValue >= "0.76"^^xsd:decimal
        )
      }
    }
  )
}
"""
    ] .
