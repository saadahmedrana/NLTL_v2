@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO110Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC )
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:deadweight ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:TON_Metric ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A ship declared as an oil tanker must also be typed as nltl:oilTanker." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType .
                FILTER(datatype(?shipType) = xsd:string)
                FILTER(?shipType = "oil_tanker")
                FILTER NOT EXISTS {
                    $this rdf:type nltl:oilTanker .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The cargo-tank double-bottom protection status must be exactly one xsd:boolean true when the requirement applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                $this nltl:shipType ?shipType .
                FILTER(?shipType = "oil_tanker")
                $this nltl:deadweight ?deadweight .
                ?deadweight qudt:numericValue ?mass ;
                    qudt:unit unit:TON_Metric .
                FILTER(datatype(?mass) = xsd:decimal)
                FILTER(?mass < 5000)
                $this nltl:constructionDate ?constructionDate .
                FILTER(datatype(?constructionDate) = xsd:date)
                FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
                {
                    FILTER NOT EXISTS {
                        $this nltl:entireCargoTankLengthDoubleBottomProtectionStatus ?status .
                        FILTER(datatype(?status) = xsd:boolean && ?status = true)
                    }
                }
                UNION
                {
                    $this nltl:entireCargoTankLengthDoubleBottomProtectionStatus ?status .
                    FILTER(!(datatype(?status) = xsd:boolean && ?status = true))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The cargo-tank double-bottom protection status must have exactly one value when the requirement applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                $this nltl:shipType ?shipType .
                FILTER(?shipType = "oil_tanker")
                $this nltl:deadweight ?deadweight .
                ?deadweight qudt:numericValue ?mass ;
                    qudt:unit unit:TON_Metric .
                FILTER(datatype(?mass) = xsd:decimal)
                FILTER(?mass < 5000)
                $this nltl:constructionDate ?constructionDate .
                FILTER(datatype(?constructionDate) = xsd:date)
                FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
                $this nltl:entireCargoTankLengthDoubleBottomProtectionStatus ?status .
            }
            GROUP BY $this
            HAVING(COUNT(?status) != 1)
        """
    ] ;
    sh:sparql [
        sh:message "The wing-tank protection status must be exactly one xsd:boolean true when the requirement applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                $this nltl:shipType ?shipType .
                FILTER(?shipType = "oil_tanker")
                $this nltl:deadweight ?deadweight .
                ?deadweight qudt:numericValue ?mass ;
                    qudt:unit unit:TON_Metric .
                FILTER(datatype(?mass) = xsd:decimal)
                FILTER(?mass < 5000)
                $this nltl:constructionDate ?constructionDate .
                FILTER(datatype(?constructionDate) = xsd:date)
                FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
                {
                    FILTER NOT EXISTS {
                        $this nltl:wingTankProtectionStatus ?status .
                        FILTER(datatype(?status) = xsd:boolean && ?status = true)
                    }
                }
                UNION
                {
                    $this nltl:wingTankProtectionStatus ?status .
                    FILTER(!(datatype(?status) = xsd:boolean && ?status = true))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The wing-tank protection status must have exactly one value when the requirement applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                $this nltl:shipType ?shipType .
                FILTER(?shipType = "oil_tanker")
                $this nltl:deadweight ?deadweight .
                ?deadweight qudt:numericValue ?mass ;
                    qudt:unit unit:TON_Metric .
                FILTER(datatype(?mass) = xsd:decimal)
                FILTER(?mass < 5000)
                $this nltl:constructionDate ?constructionDate .
                FILTER(datatype(?constructionDate) = xsd:date)
                FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
                $this nltl:wingTankProtectionStatus ?status .
            }
            GROUP BY $this
            HAVING(COUNT(?status) != 1)
        """
    ] .
