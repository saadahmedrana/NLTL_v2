@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-111-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one canonical polar ship category."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one construction date."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a Category A or B ship constructed on or after 1 January 2017, every linked oil residue tank or oily bilge water holding tank with individual capacity greater than 30 m3 must be separated from the outer shell by at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:hasComponent ?tank .

                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )
                FILTER (?date >= "2017-01-01"^^xsd:date)

                ?tank rdf:type ?tankType .
                FILTER (
                    ?tankType = nltl:oilResidueTank ||
                    ?tankType = nltl:oilyBilgeWaterHoldingTank
                )

                FILTER (
                    !EXISTS {
                        ?tank nltl:individualTankCapacity ?capacityValue .
                        ?capacityValue qudt:numericValue ?capacityNumber ;
                                       qudt:unit unit:M3 .
                        FILTER (datatype(?capacityNumber) = xsd:decimal)
                    }
                    ||
                    (
                        EXISTS {
                            ?tank nltl:individualTankCapacity ?largeCapacityValue .
                            ?largeCapacityValue qudt:numericValue ?largeCapacityNumber ;
                                                 qudt:unit unit:M3 .
                            FILTER (
                                datatype(?largeCapacityNumber) = xsd:decimal &&
                                ?largeCapacityNumber > 30
                            )
                        }
                        &&
                        !EXISTS {
                            ?tank nltl:tankOuterShellSeparation ?separationValue .
                            ?separationValue qudt:numericValue ?separationNumber ;
                                              qudt:unit unit:M .
                            FILTER (
                                datatype(?separationNumber) = xsd:decimal &&
                                ?separationNumber >= 0.76
                            )
                        }
                    )
                )
            }
        """
    ] .
