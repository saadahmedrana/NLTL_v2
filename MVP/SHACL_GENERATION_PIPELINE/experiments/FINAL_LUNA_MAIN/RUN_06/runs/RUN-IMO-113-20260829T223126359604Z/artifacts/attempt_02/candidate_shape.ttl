@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_113_ShipPolarDocumentCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The ship's polar-water applicability must be explicitly recorded as false when this conditional requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ship's polar-water applicability must be explicitly recorded as true when this conditional requirement applies."
            ] ;
            sh:property [
                sh:path nltl:cargoRecordBookPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The applicable Cargo Record Book must account for polar operation."
            ] ;
            sh:property [
                sh:path nltl:manualPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The applicable Manual must account for polar operation."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true ;
                        sh:message "The applicable noxious-liquid-substance marine pollution emergency plan must account for polar operation."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:pollutionEmergencyPlanPolarCoverage ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true ;
                        sh:message "The applicable marine pollution emergency plan must account for polar operation."
                    ]
                ]
            )
        ]
    ) .
