@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-115> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When sewage discharge is comminuted and disinfected, the MARPOL compliance status, strict distance threshold, concentration input, nearby concentration criterion, and distance from qualifying ice areas must be recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType .
                FILTER(?dischargeType = "comminuted_and_disinfected"^^xsd:string)
                FILTER(
                    NOT EXISTS {
                        $this nltl:comminutedAndDisinfected true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceToNearestIceShelfOrFastIce ?nearestDistance .
                        ?nearestDistance a qudt:QuantityValue ;
                            qudt:numericValue ?nearestValue ;
                            qudt:unit unit:MI_N .
                        FILTER(
                            datatype(?nearestValue) = xsd:decimal &&
                            ?nearestValue > "3"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceConcentration ?iceQuantity .
                        ?iceQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?iceValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER(datatype(?iceValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nearbyIceConcentration ?nearbyQuantity .
                        ?nearbyQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?nearbyValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER(
                            datatype(?nearbyValue) = xsd:decimal &&
                            ?nearbyValue > "0.1"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                        ?areaDistance a qudt:QuantityValue ;
                            qudt:numericValue ?areaDistanceValue ;
                            qudt:unit unit:MI_N .
                        FILTER(datatype(?areaDistanceValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
