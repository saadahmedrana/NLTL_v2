@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-116> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide its sewage discharge type."
    ] ;
    sh:sparql [
        sh:message "When sewage discharge is not comminuted or disinfected, the ship must record true applicability evidence, MARPOL Annex IV regulation 11.1.1 compliance, a distance greater than 12 nautical miles from ice shelf or fast ice, nearby ice concentration data, and a recorded distance from an area whose ice concentration exceeds 1/10; the concentration and recorded distance must be represented on the same ship-owned case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?stype .
                FILTER (
                    datatype(?stype) = xsd:string &&
                    ?stype = "not comminuted or disinfected"^^xsd:string
                )

                FILTER NOT EXISTS {
                    $this nltl:notComminutedOrDisinfected ?applicable .
                    FILTER (
                        datatype(?applicable) = xsd:boolean &&
                        ?applicable = true
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?compliant .
                    FILTER (
                        datatype(?compliant) = xsd:boolean &&
                        ?compliant = true
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestIceShelfOrFastIce ?iceDistance .
                    ?iceDistance a qudt:QuantityValue ;
                        qudt:numericValue ?iceDistanceValue ;
                        qudt:unit unit:MI_N .
                    FILTER (
                        datatype(?iceDistanceValue) = xsd:decimal &&
                        ?iceDistanceValue > "12"^^xsd:decimal
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?nearbyConcentration .
                    ?nearbyConcentration a qudt:QuantityValue ;
                        qudt:numericValue ?nearbyValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (datatype(?nearbyValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:iceConcentration ?areaConcentration .
                    ?areaConcentration a qudt:QuantityValue ;
                        qudt:numericValue ?areaConcentrationValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?areaConcentrationValue) = xsd:decimal &&
                        ?areaConcentrationValue > "0.1"^^xsd:decimal
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?recordedDistance .
                    ?recordedDistance a qudt:QuantityValue ;
                        qudt:numericValue ?recordedDistanceValue ;
                        qudt:unit unit:MI_N .
                    FILTER (datatype(?recordedDistanceValue) = xsd:decimal)
                }
            }
        """
    ] .
