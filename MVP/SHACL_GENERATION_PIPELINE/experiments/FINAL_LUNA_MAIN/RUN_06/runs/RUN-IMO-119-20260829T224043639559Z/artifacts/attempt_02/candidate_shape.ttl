@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_119_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ship category must be Category A or Category B."
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Ice concentration must be a single unitless decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:extendedPeriodOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "When the applicability conditions hold, an approved sewage treatment plant and compliant MARPOL certification statuses are required, together with Administration approval." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))

                $this nltl:iceConcentration ?ice .
                ?ice qudt:numericValue ?iceValue ;
                     qudt:unit unit:UNITLESS .
                FILTER (datatype(?iceValue) = xsd:decimal && ?iceValue > 1)

                $this nltl:extendedPeriodOperation true .
                $this nltl:sewageDischargeOccurs true .

                FILTER (
                    NOT EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed true
                    }
                    ||
                    EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed ?approvedUsed .
                        FILTER (?approvedUsed != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus
                            nltl:complianceStateCompliant
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ?annexStatus .
                        FILTER (?annexStatus != nltl:complianceStateCompliant)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolCertificationStatus nltl:complianceStateCompliant
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolCertificationStatus ?marpolStatus .
                        FILTER (?marpolStatus != nltl:complianceStateCompliant)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved
                    }
                    ||
                    EXISTS {
                        $this nltl:administrationDischargeApprovalStatus ?approvalStatus .
                        FILTER (?approvalStatus != nltl:evidenceStateApproved)
                    }
                )
            }
        """
    ] .
