@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship operating in Arctic_waters and discharging food waste to sea, a distance of at least 12 nautical miles from the nearest land ice shelf or fast ice and a recorded nearby ice concentration are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea true .

                FILTER (
                    datatype(?area) = xsd:string &&
                    ?area = "Arctic_waters"^^xsd:string
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:distanceToNearestLandIceShelfOrFastIce ?distance .
                        ?distance qudt:numericValue ?distanceValue ;
                                  qudt:unit unit:MI_N .
                        FILTER (
                            datatype(?distanceValue) = xsd:decimal &&
                            ?distanceValue >= "12"^^xsd:decimal
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nearbyIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?concentrationValue ;
                                        qudt:unit unit:UNITLESS .
                        FILTER (datatype(?concentrationValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
