@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-123-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node <urn:nltl:generated-shape:IMO-123-DischargeDistanceRecordShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A cargo-residue discharge record requires the specified residue, route, reception-facility, ice-concentration, and Arctic conditions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDischargeDistanceRecord ?record .
                FILTER (
                    NOT EXISTS {
                        $this nltl:residueNotRecoverableByCommonMethods true
                    }
                    ||
                    EXISTS {
                        $this nltl:residueNotRecoverableByCommonMethods ?residueValue .
                        FILTER (?residueValue != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:shipEnRoute true
                    }
                    ||
                    EXISTS {
                        $this nltl:shipEnRoute ?enRouteValue .
                        FILTER (?enRouteValue != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:harmfulSubstancePresent false
                    }
                    ||
                    EXISTS {
                        $this nltl:harmfulSubstancePresent ?harmfulValue .
                        FILTER (?harmfulValue != false)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:departureAndDestinationWithinArctic true
                    }
                    ||
                    EXISTS {
                        $this nltl:departureAndDestinationWithinArctic ?departureDestinationValue .
                        FILTER (?departureDestinationValue != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:routeRemainsWithinArctic true
                    }
                    ||
                    EXISTS {
                        $this nltl:routeRemainsWithinArctic ?routeValue .
                        FILTER (?routeValue != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:adequateReceptionFacilitiesAvailable false
                    }
                    ||
                    EXISTS {
                        $this nltl:adequateReceptionFacilitiesAvailable ?receptionValue .
                        FILTER (?receptionValue != false)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nearbyIceConcentration ?iceConcentration ;
                              nltl:nearbyIceConcentration ?iceConcentration .
                        ?iceConcentration qudt:numericValue ?iceValue ;
                                           qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?iceValue) = xsd:decimal &&
                            ?iceValue > "0.1"^^xsd:decimal
                        )
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-123-DischargeDistanceRecordShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "12.0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MI_N
            ]
        ] ;
        sh:message "The distance to the nearest land, ice shelf, or fast ice must be at least 12 nautical miles."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MI_N
            ]
        ] ;
        sh:message "A discharge distance from an area with ice concentration greater than one tenth must be recorded in nautical miles."
    ] .
