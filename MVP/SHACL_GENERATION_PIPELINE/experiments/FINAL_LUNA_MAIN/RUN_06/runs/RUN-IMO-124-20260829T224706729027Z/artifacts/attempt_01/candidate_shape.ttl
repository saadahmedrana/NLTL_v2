@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO124Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall record its operating area." ;
    ] ;
    sh:property [
        sh:path nltl:antarcticArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Antarctic-area applicability value shall be recorded." ;
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The MARPOL Annex V regulation 6.1 discharge status shall be recorded." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an Antarctic-area MARPOL Annex V regulation 6.1 discharge, the nearest fast ice shall be at least 12 nautical miles away, the distance from areas with ice concentration exceeding one tenth shall be recorded, and food waste shall not be discharged onto ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea .
                $this nltl:antarcticArea ?antarcticArea .
                $this nltl:marpolAnnexVRegulation6Point1DischargeOccurs ?discharge .

                FILTER (
                    STR(?operatingArea) = "Antarctic_area" &&
                    STR(?antarcticArea) = "Antarctic_area" &&
                    ?discharge = true
                )

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestFastIce ?fastIceDistance .
                    ?fastIceDistance qudt:numericValue ?fastIceValue .
                    ?fastIceDistance qudt:unit unit:MI_N .
                    FILTER (
                        DATATYPE(?fastIceValue) = xsd:decimal &&
                        ?fastIceValue >= "12"^^xsd:decimal
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:iceConcentration ?concentration .
                    ?concentration qudt:numericValue ?concentrationValue .
                    ?concentration qudt:unit unit:UNITLESS .
                    FILTER (
                        DATATYPE(?concentrationValue) = xsd:decimal &&
                        ?concentrationValue > "0.1"^^xsd:decimal
                    )
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                    ?areaDistance qudt:numericValue ?areaDistanceValue .
                    ?areaDistance qudt:unit unit:MI_N .
                    FILTER (
                        DATATYPE(?areaDistanceValue) = xsd:decimal
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:foodWasteDischargeOntoIce ?foodWaste .
                    FILTER (
                        DATATYPE(?foodWaste) = xsd:boolean &&
                        ?foodWaste = false
                    )
                }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable Antarctic-area discharge, nearby ice concentration and distance to the nearest fast ice shall be recorded as dimensionless and nautical-mile quantities." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea .
                $this nltl:antarcticArea ?antarcticArea .
                $this nltl:marpolAnnexVRegulation6Point1DischargeOccurs ?discharge .

                FILTER (
                    STR(?operatingArea) = "Antarctic_area" &&
                    STR(?antarcticArea) = "Antarctic_area" &&
                    ?discharge = true
                )

                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?nearbyConcentration .
                    ?nearbyConcentration qudt:numericValue ?nearbyValue .
                    ?nearbyConcentration qudt:unit unit:UNITLESS .
                    FILTER (DATATYPE(?nearbyValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestFastIce ?fastIceDistance .
                    ?fastIceDistance qudt:numericValue ?fastIceValue .
                    ?fastIceDistance qudt:unit unit:MI_N .
                    FILTER (DATATYPE(?fastIceValue) = xsd:decimal)
                }
            }
        """ ;
    ] .
