@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:Chapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship type is required to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 9-1 applicability must be recorded."
    ] ;
    sh:or (
        gen:FishingVesselApplicableShape
        gen:FishingVesselNotApplicableShape
        gen:PleasureYachtApplicableShape
        gen:PleasureYachtTradeNotApplicableShape
        gen:PleasureYachtTonnageNotApplicableShape
        gen:CargoShipApplicableShape
        gen:CargoShipLowTonnageNotApplicableShape
        gen:CargoShipHighTonnageNotApplicableShape
        gen:OtherShipNotApplicableShape
    ) .

gen:LengthOverallQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:GrossTonnageQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FishingVesselApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "fishing_vessel" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node gen:LengthOverallQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A fishing vessel is applicable to Chapter 9-1 only when its length overall is at least 24 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:lengthOverall ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v < "24"^^xsd:decimal)
            }
        """
    ] .

gen:FishingVesselNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "fishing_vessel" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node gen:LengthOverallQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A fishing vessel below 24 m in length overall is not applicable to Chapter 9-1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:lengthOverall ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v >= "24"^^xsd:decimal)
            }
        """
    ] .

gen:PleasureYachtApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "pleasure_yacht" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gen:GrossTonnageQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A non-trading pleasure yacht is applicable to Chapter 9-1 only at 300 gross tonnage or above." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v < "300"^^xsd:decimal)
            }
        """
    ] .

gen:PleasureYachtTradeNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "pleasure_yacht" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PleasureYachtTonnageNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "pleasure_yacht" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gen:GrossTonnageQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A non-trading pleasure yacht below 300 gross tonnage is not applicable to Chapter 9-1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v >= "300"^^xsd:decimal)
            }
        """
    ] .

gen:CargoShipApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "cargo_ship" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gen:GrossTonnageQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A cargo ship is applicable to Chapter 9-1 from 300 gross tonnage up to but below 500 gross tonnage." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v < "300"^^xsd:decimal || ?v >= "500"^^xsd:decimal)
            }
        """
    ] .

gen:CargoShipLowTonnageNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "cargo_ship" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gen:GrossTonnageQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A cargo ship below 300 gross tonnage is not applicable to Chapter 9-1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v >= "300"^^xsd:decimal)
            }
        """
    ] .

gen:CargoShipHighTonnageNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:hasValue "cargo_ship" ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gen:GrossTonnageQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A cargo ship of 500 gross tonnage or above is not applicable to Chapter 9-1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?q .
                ?q qudt:numericValue ?v .
                FILTER (?v < "500"^^xsd:decimal)
            }
        """
    ] .

gen:OtherShipNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:sparql [
        sh:message "A ship type outside the specified fishing vessel, pleasure yacht, and cargo ship cases is not applicable to Chapter 9-1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipType ?t .
                FILTER (?t NOT IN ("fishing_vessel", "pleasure_yacht", "cargo_ship"))
            }
        """
    ] .
