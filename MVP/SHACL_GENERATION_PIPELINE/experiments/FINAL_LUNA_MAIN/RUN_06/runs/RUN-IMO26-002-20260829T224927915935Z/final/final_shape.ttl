@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_002_Chapter9_1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship type is required to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 9-1 applicability must be recorded as a boolean."
    ] ;
    sh:sparql [
        sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, or trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                OPTIONAL {
                    $this nltl:shipType ?shipType .
                }
                OPTIONAL {
                    $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
                }
                OPTIONAL {
                    $this nltl:lengthOverall ?lengthQuantity .
                    OPTIONAL {
                        ?lengthQuantity qudt:numericValue ?lengthValue .
                    }
                    OPTIONAL {
                        ?lengthQuantity qudt:unit ?lengthUnit .
                    }
                }
                OPTIONAL {
                    $this nltl:grossTonnage ?tonnageQuantity .
                    OPTIONAL {
                        ?tonnageQuantity qudt:numericValue ?tonnageValue .
                    }
                    OPTIONAL {
                        ?tonnageQuantity qudt:unit ?tonnageUnit .
                    }
                }
                OPTIONAL {
                    $this nltl:engagedInTrade ?engagedInTrade .
                }

                FILTER (
                    !BOUND(?shipType)
                    || !BOUND(?applicable)
                    || (
                        ?shipType = "fishing_vessel"
                        &&
                        (
                            !BOUND(?lengthValue)
                            || !BOUND(?lengthUnit)
                            || DATATYPE(?lengthValue) != xsd:decimal
                            || ?lengthUnit != <http://qudt.org/vocab/unit/M>
                            || (
                                ?lengthValue >= 24.0
                                && ?applicable != true
                            )
                            || (
                                ?lengthValue < 24.0
                                && ?applicable != false
                            )
                        )
                    )
                    || (
                        ?shipType = "pleasure_yacht"
                        &&
                        (
                            !BOUND(?tonnageValue)
                            || !BOUND(?tonnageUnit)
                            || DATATYPE(?tonnageValue) != xsd:decimal
                            || ?tonnageUnit != <http://qudt.org/vocab/unit/UNITLESS>
                            || !BOUND(?engagedInTrade)
                            || (
                                ?tonnageValue >= 300.0
                                && ?engagedInTrade = false
                                && ?applicable != true
                            )
                            || (
                                ?tonnageValue < 300.0
                                || ?engagedInTrade != false
                            )
                            && ?applicable != false
                        )
                    )
                    || (
                        ?shipType = "cargo_ship"
                        &&
                        (
                            !BOUND(?tonnageValue)
                            || !BOUND(?tonnageUnit)
                            || DATATYPE(?tonnageValue) != xsd:decimal
                            || ?tonnageUnit != <http://qudt.org/vocab/unit/UNITLESS>
                            || (
                                ?tonnageValue >= 300.0
                                && ?tonnageValue < 500.0
                                && ?applicable != true
                            )
                            || (
                                ?tonnageValue < 300.0
                                || ?tonnageValue >= 500.0
                            )
                            && ?applicable != false
                        )
                    )
                    || (
                        ?shipType NOT IN (
                            "fishing_vessel",
                            "pleasure_yacht",
                            "cargo_ship"
                        )
                        && ?applicable != false
                    )
                )
            }
        """
    ] .
