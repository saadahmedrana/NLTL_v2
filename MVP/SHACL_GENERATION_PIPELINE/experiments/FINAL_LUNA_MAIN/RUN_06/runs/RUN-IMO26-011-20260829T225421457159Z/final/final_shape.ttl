@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-011> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Category C ships satisfy the non-applicable branch."
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:maxInclusive "2025-12-31"^^xsd:date ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            )
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:minInclusive "2026-01-01"^^xsd:date ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:bridgeWingsEnclosed ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:bridgeWingProtectionDesignStatus ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    )
                ]
            )
        ]
    ) .
