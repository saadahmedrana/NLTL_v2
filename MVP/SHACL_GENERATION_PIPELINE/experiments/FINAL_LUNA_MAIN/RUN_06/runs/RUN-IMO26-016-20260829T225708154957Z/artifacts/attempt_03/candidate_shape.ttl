@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's polar-water operating status is required and must be single-valued."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship type is required and must be single-valued."
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a ship operating in polar waters, chapter 11-1 applicability must be true for a qualifying fishing vessel, pleasure yacht, or cargo ship; it must not be true for a non-qualifying or non-polar ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?polar ;
                      nltl:shipType ?type .

                OPTIONAL {
                    $this nltl:lengthOverall ?lengthNode .
                    ?lengthNode qudt:numericValue ?lengthValue .
                }

                OPTIONAL {
                    $this nltl:grossTonnage ?tonnageNode .
                    ?tonnageNode qudt:numericValue ?tonnageValue .
                }

                OPTIONAL {
                    $this nltl:engagedInTrade ?trade .
                }

                OPTIONAL {
                    $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
                }

                FILTER (
                    (
                        ?polar = false &&
                        BOUND(?applicable) &&
                        ?applicable = true
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type = "fishing_vessel"^^xsd:string &&
                        (
                            !BOUND(?lengthValue) ||
                            ?lengthValue < 24 ||
                            !BOUND(?applicable) ||
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type = "pleasure_yacht"^^xsd:string &&
                        (
                            !BOUND(?tonnageValue) ||
                            ?tonnageValue < 300 ||
                            !BOUND(?trade) ||
                            ?trade != false ||
                            !BOUND(?applicable) ||
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type = "cargo_ship"^^xsd:string &&
                        (
                            !BOUND(?tonnageValue) ||
                            ?tonnageValue < 300 ||
                            ?tonnageValue >= 500 ||
                            !BOUND(?applicable) ||
                            ?applicable != true
                        )
                    )
                    ||
                    (
                        ?polar = true &&
                        ?type NOT IN (
                            "fishing_vessel"^^xsd:string,
                            "pleasure_yacht"^^xsd:string,
                            "cargo_ship"^^xsd:string
                        ) &&
                        BOUND(?applicable) &&
                        ?applicable = true
                    )
                )
            }
        """
    ] .
