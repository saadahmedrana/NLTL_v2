@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For a qualifying ship operating in polar waters, polarCodeChapter11Dash1Applicable must be true and the required threshold input must be present with its canonical unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX qudt-unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters true ;
                      nltl:shipType ?type .

                FILTER (
                    (
                        ?type = "fishing_vessel"
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:lengthOverall ?length .
                                ?length q:numericValue ?value ;
                                        q:unit qudt-unit:M .
                                FILTER (
                                    datatype(?value) = xsd:decimal
                                    && ?value >= 24.0
                                )
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
                                FILTER (
                                    datatype(?applicable) = xsd:boolean
                                    && ?applicable = true
                                )
                            }
                        )
                    )
                    ||
                    (
                        ?type = "pleasure_yacht"
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:grossTonnage ?tonnage ;
                                      nltl:engagedInTrade false .
                                ?tonnage q:numericValue ?value ;
                                         q:unit qudt-unit:UNITLESS .
                                FILTER (
                                    datatype(?value) = xsd:decimal
                                    && ?value >= 300.0
                                )
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
                                FILTER (
                                    datatype(?applicable) = xsd:boolean
                                    && ?applicable = true
                                )
                            }
                        )
                    )
                    ||
                    (
                        ?type = "cargo_ship"
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:grossTonnage ?tonnage .
                                ?tonnage q:numericValue ?value ;
                                         q:unit qudt-unit:UNITLESS .
                                FILTER (
                                    datatype(?value) = xsd:decimal
                                    && ?value >= 300.0
                                    && ?value < 500.0
                                )
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
                                FILTER (
                                    datatype(?applicable) = xsd:boolean
                                    && ?applicable = true
                                )
                            }
                        )
                    )
                )
            }
        """
    ] .
