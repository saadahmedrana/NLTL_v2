@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction contract date is required to determine applicability of the 2021 Ice Class Regulations."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulatoryProvisionValue ;
        sh:message "The 2021 Ice Class Regulations section 1.8 provision must apply."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulatoryProvisionValue ;
        sh:message "The 2021 Ice Class Regulations chapter 2 provision must apply."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2021-07-05"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2021 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassRegulationEditionValue ;
                sh:message "Ships contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations as applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:maxInclusive "2021-07-04"^^xsd:date
            ]
        ]
    ) ;
    sh:message "The applicability of the 2021 Ice Class Regulations must be consistent with the construction contract date." .
