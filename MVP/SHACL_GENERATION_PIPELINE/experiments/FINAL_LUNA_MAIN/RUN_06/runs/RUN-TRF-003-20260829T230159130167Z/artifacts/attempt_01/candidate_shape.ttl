@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine whether the 2010 Ice Class Regulations apply."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:maxInclusive "2011-12-31"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2019-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2012-01-01"^^xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iceClassRegulationEdition2010 ;
                sh:message "Ships contracted from 1 January 2012 up to but not including 1 January 2019 must identify the 2010 Ice Class Regulations as the applicable edition."
            ]
        ]
    ) .
