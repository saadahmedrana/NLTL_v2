@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF004IceClassRegulationApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#date> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single construction contract date is required to determine applicability of the 2008 Ice Class Regulations."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2008 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ships contracted for construction from 1 January 2010 through 31 December 2011 must identify the 2008 Ice Class Regulations."
            ] ;
            sh:sparql [
                sh:message "The 2008 Ice Class Regulations apply to ships contracted for construction in 2010 or 2011." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (!(YEAR(?date) = 2010 || YEAR(?date) = 2011))
                    }
                """
            ]
        ]
        [
            sh:sparql [
                sh:message "The 2008 Ice Class Regulations apply to ships contracted for construction from 1 January 2010 through 31 December 2011." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (YEAR(?date) = 2010 || YEAR(?date) = 2011)
                    }
                """
            ]
        ]
    ) .
