@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF004ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A ship must provide its construction contract date." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iceClassRegulationEdition2008 ;
                sh:message "Ships contracted from 1 January 2010 to before 1 January 2012 must identify the 2008 Ice Class Regulations." ;
            ] ;
            sh:sparql [
                sh:message "The construction contract date must be on or after 1 January 2010 and before 1 January 2012 for the 2008 regulation applicability branch." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:constructionContractDate ?date .
                        FILTER (
                            ?date < "2010-01-01"^^xsd:date
                            || ?date >= "2012-01-01"^^xsd:date
                        )
                    }
                """ ;
            ]
        ]
        [
            sh:sparql [
                sh:message "The construction contract date must be outside the period from 1 January 2010 to before 1 January 2012 for the non-applicable branch." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:constructionContractDate ?date .
                        FILTER (
                            ?date >= "2010-01-01"^^xsd:date
                            && ?date < "2012-01-01"^^xsd:date
                        )
                    }
                """ ;
            ]
        ]
    ) .
