@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "A construction-stage date, when represented, must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:message "An owner request for 2008 engine-output requirements must be an xsd:boolean."
    ] ;
    sh:sparql [
        sh:message "For ships constructed on or after 1986-11-01 and before 2003-09-01, the 1985 ice-class rules, the ship ice class, and the owner-request selector must be represented; engine-output edition must be 2008 when requested and 1985 otherwise." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date .
    FILTER (
        ?date >= "1986-11-01"^^xsd:date &&
        ?date < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
              nltl:iceClass ?iceClass ;
              nltl:ownerRequested2008EngineOutputRequirements ?requested ;
              nltl:engineOutputRegulationEdition ?engineEdition .
        FILTER ( isIRI(?iceClass) )
        FILTER (
            (?requested = true &&
             ?engineEdition = nltl:iceClassRegulationEdition2008) ||
            (?requested = false &&
             ?engineEdition = nltl:iceClassRuleEdition1985)
        )
    }
}
""" ;
    ] .
