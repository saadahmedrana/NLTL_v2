@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-009> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A ship must identify its ice class so the conditional requirement can be assessed."
    ] ;
    sh:sparql [
        sh:message "For an IA or IA Super ship, constructionStageDate is required to determine whether this conditional rule applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable IA or IA Super ship must satisfy the 20-year deadline based on its delivery date and assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .
                FILTER (?iceClass IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (datatype(?constructionDate) = xsd:date)
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (
                        YEAR(?constructionDate) = 2003 &&
                        MONTH(?constructionDate) < 9
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?deliveryDate ;
                          nltl:assessmentDate ?assessmentDate .
                    FILTER (datatype(?deliveryDate) = xsd:date)
                    FILTER (datatype(?assessmentDate) = xsd:date)
                    FILTER (
                        YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
                        (
                            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                            MONTH(?assessmentDate) = 1 &&
                            DAY(?assessmentDate) = 1
                        )
                    )
                }
            }
        """
    ] .
