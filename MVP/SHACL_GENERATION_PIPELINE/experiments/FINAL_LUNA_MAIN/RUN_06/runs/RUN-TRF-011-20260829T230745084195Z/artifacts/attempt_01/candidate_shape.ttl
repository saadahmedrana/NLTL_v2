@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF011ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape ;
        sh:message "The ship must identify the intended ice-operating waterline and its profile points."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape ;
        sh:message "The ship must identify the upper ice waterline and its profile points."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline must contain exactly the maximum vertical coordinate of the intended ice-operating waterlines at every longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this ?x ?maxIntended ?minUpper ?maxUpper
WHERE {
  {
    SELECT ?this ?x
           (MAX(?intendedVertical) AS ?maxIntended)
           (MIN(?upperVertical) AS ?minUpper)
           (MAX(?upperVertical) AS ?maxUpper)
           (COUNT(?intendedVertical) AS ?intendedCount)
           (COUNT(?upperVertical) AS ?upperCount)
    WHERE {
      {
        ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue .
        ?intendedPositionValue qudt:numericValue ?x ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
        ?intendedPoint nltl:verticalCoordinate ?intendedVerticalValue .
        ?intendedVerticalValue qudt:numericValue ?intendedVertical ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
      }
      UNION
      {
        ?this nltl:hasUpperIceWaterline ?upperWaterline .
        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperPositionValue .
        ?upperPositionValue qudt:numericValue ?x ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
        ?upperPoint nltl:verticalCoordinate ?upperVerticalValue .
        ?upperVerticalValue qudt:numericValue ?upperVertical ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
      }
    }
    GROUP BY ?this ?x
  }
  FILTER (
    ?intendedCount = 0 ||
    ?upperCount = 0 ||
    ?minUpper != ?maxIntended ||
    ?maxUpper != ?maxIntended
  )
}
""" ;
    ] .

gen:TRF011IceWaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node gen:TRF011ProfilePointShape ;
        sh:message "Each represented ice waterline must provide its waterline profile points."
    ] .

gen:TRF011ProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF011LengthQuantityShape ;
        sh:message "Each waterline profile point must provide one longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF011LengthQuantityShape ;
        sh:message "Each waterline profile point must provide one vertical coordinate in metres."
    ] .

gen:TRF011LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
