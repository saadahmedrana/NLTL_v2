@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:property [
                        sh:path nltl:waterlineDisplacement ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:displacementAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:forwardDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerHighestPointSubmerged ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasBallastTank ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:class nltl:ballastTank ;
                    sh:property [
                        sh:path nltl:situatedAboveLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:usedToReachLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:freezingPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "When navigating in ice, draught amidships must be at least the LIWL draught amidships." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:draughtAmidships ?draughtNode ;
                      nltl:liwlDraughtAmidships ?liwlNode .
                ?draughtNode qudt:numericValue ?draught .
                ?liwlNode qudt:numericValue ?liwl .
                FILTER (?draught < ?liwl)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The forward draught must satisfy the level-ice-thickness formula based on UIWL displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:displacementAtUpperIceWaterline ?deltaNode ;
                      nltl:levelIceThickness ?hiNode ;
                      nltl:forwardDraught ?forwardNode .
                ?deltaNode qudt:numericValue ?delta .
                ?hiNode qudt:numericValue ?hi .
                ?forwardNode qudt:numericValue ?forward .
                BIND ((2 + (0.00025 * ?delta)) * ?hi AS ?formulaLimit)
                BIND (4 * ?hi AS ?upperLimit)
                BIND (IF(?formulaLimit < ?upperLimit, ?formulaLimit, ?upperLimit) AS ?requiredForward)
                FILTER (?forward < ?requiredForward)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The displacement at the UIWL must correspond to a UIWL of greatest displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:displacementAtUpperIceWaterline ?selectedNode ;
                      nltl:hasUpperIceWaterline ?waterline .
                ?selectedNode qudt:numericValue ?selected .
                ?waterline nltl:waterlineDisplacement ?otherNode .
                ?otherNode qudt:numericValue ?other .
                FILTER (?other > ?selected)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The UIWL displacement value must be the displacement of one of the represented UIWL waterlines." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:displacementAtUpperIceWaterline ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterline ?waterline .
                    ?waterline nltl:waterlineDisplacement ?waterlineNode .
                    ?waterlineNode qudt:numericValue ?waterlineValue .
                    FILTER (?waterlineValue = ?selected)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The propeller highest point must be submerged when navigating in ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true .
                FILTER NOT EXISTS {
                    $this nltl:propellerHighestPointSubmerged true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ballast tank above the LIWL that is needed to reach the LIWL must have freezing prevention." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:hasBallastTank ?tank .
                ?tank nltl:situatedAboveLowerIceWaterline true ;
                      nltl:usedToReachLowerIceWaterline true .
                FILTER NOT EXISTS {
                    ?tank nltl:freezingPreventionPresent true .
                }
            }
        """
    ] .
