@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF016Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:iceWaterline
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:iceWaterline ;
                sh:node [
                    sh:property [
                        sh:path nltl:waterlineDisplacement ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/TON_Metric>
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:displacementAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/TON_Metric>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:forwardDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerHighestPointSubmerged ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasBallastTank ;
                sh:class nltl:ballastTank ;
                sh:node [
                    sh:property [
                        sh:path nltl:situatedAboveLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:usedToReachLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:freezingPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The selected UIWL displacement must be at least the displacement of every represented UIWL waterline." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:displacementAtUpperIceWaterline ?selectedQuantity .
                        ?selectedQuantity qudt:numericValue ?selectedValue .
                        $this nltl:hasUpperIceWaterline ?waterline .
                        ?waterline nltl:waterlineDisplacement ?waterlineQuantity .
                        ?waterlineQuantity qudt:numericValue ?waterlineValue .
                        FILTER NOT EXISTS {
                            $this nltl:hasUpperIceWaterline ?otherWaterline .
                            ?otherWaterline nltl:waterlineDisplacement ?otherQuantity .
                            ?otherQuantity qudt:numericValue ?otherValue .
                            FILTER (?otherValue > ?selectedValue)
                        }
                        FILTER (?selectedValue < ?waterlineValue)
                    }
                """
            ] ;
            sh:sparql [
                sh:message "Draught amidships must be at least the LIWL draught amidships." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?draughtQuantity ;
                              nltl:liwlDraughtAmidships ?liwlQuantity .
                        ?draughtQuantity qudt:numericValue ?draught .
                        ?liwlQuantity qudt:numericValue ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                """
            ] ;
            sh:sparql [
                sh:message "Forward draught must satisfy the applicable level-ice-thickness and UIWL-displacement formula." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:forwardDraught ?forwardQuantity ;
                              nltl:displacementAtUpperIceWaterline ?displacementQuantity ;
                              nltl:levelIceThickness ?iceQuantity .
                        ?forwardQuantity qudt:numericValue ?forward .
                        ?displacementQuantity qudt:numericValue ?displacement .
                        ?iceQuantity qudt:numericValue ?ice .
                        BIND ((2 + (0.00025 * ?displacement)) * ?ice AS ?uncapped)
                        BIND (4 * ?ice AS ?cap)
                        BIND (IF(?uncapped < ?cap, ?uncapped, ?cap) AS ?required)
                        FILTER (?forward < ?required)
                    }
                """
            ] ;
            sh:sparql [
                sh:message "A ballast tank above the LIWL that is needed to reach the LIWL must have freezing prevention." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasBallastTank ?tank .
                        ?tank nltl:situatedAboveLowerIceWaterline true ;
                              nltl:usedToReachLowerIceWaterline true .
                        FILTER NOT EXISTS {
                            ?tank nltl:freezingPreventionPresent true
                        }
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
