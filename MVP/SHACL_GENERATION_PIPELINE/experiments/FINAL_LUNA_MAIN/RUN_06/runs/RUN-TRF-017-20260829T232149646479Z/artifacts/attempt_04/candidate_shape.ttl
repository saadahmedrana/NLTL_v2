@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A power quantity must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A power quantity must use kW."
    ] .

gen:TRF_017_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:additionalPropulsionPower ;
        sh:node gen:PowerQuantityShape ;
        sh:maxCount 1 ;
        sh:message "Any additional propulsion power must be represented as one kW power quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Restricted propulsion output is required when the propulsion output restriction applies."
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Maximum continuous rating power is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propulsionMachineryContinuousOutput ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Continuous propulsion machinery output is required when no output restriction applies."
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Maximum continuous rating power is required."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output plus any available additional propulsion power, within tolerance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies true .
    $this nltl:maximumContinuousRatingPower ?pNode .
    ?pNode qudt:numericValue ?p .
    ?pNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    $this nltl:restrictedPropulsionOutput ?baseNode .
    ?baseNode qudt:numericValue ?base .
    ?baseNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    OPTIONAL {
        $this nltl:additionalPropulsionPower ?additionalNode .
        ?additionalNode qudt:numericValue ?additional .
        ?additionalNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    }
    BIND(COALESCE(?additional, "0"^^xsd:decimal) AS ?additionalValue)
    BIND(?base + ?additionalValue AS ?expected)
    FILTER(
        ABS(?p - ?expected) >
        IF(ABS(?expected) > "0"^^xsd:decimal,
           "0.000001"^^xsd:decimal * ABS(?expected),
           "0.000000001"^^xsd:decimal)
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When propulsion output is unrestricted, maximum continuous rating power must equal continuous propulsion machinery output plus any available additional propulsion power, within tolerance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies false .
    $this nltl:maximumContinuousRatingPower ?pNode .
    ?pNode qudt:numericValue ?p .
    ?pNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    $this nltl:propulsionMachineryContinuousOutput ?baseNode .
    ?baseNode qudt:numericValue ?base .
    ?baseNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    OPTIONAL {
        $this nltl:additionalPropulsionPower ?additionalNode .
        ?additionalNode qudt:numericValue ?additional .
        ?additionalNode qudt:unit <http://qudt.org/vocab/unit/KiloW> .
    }
    BIND(COALESCE(?additional, "0"^^xsd:decimal) AS ?additionalValue)
    BIND(?base + ?additionalValue AS ?expected)
    FILTER(
        ABS(?p - ?expected) >
        IF(ABS(?expected) > "0"^^xsd:decimal,
           "0.000001"^^xsd:decimal * ABS(?expected),
           "0.000000001"^^xsd:decimal)
    )
}
"""
    ] .
