@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-018> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must declare one applicable ice class: IA Super, IA, IB, or IC."
    ] ;
    sh:property [
        sh:path nltl:calculatedRequiredPower ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The calculated required power must be provided as one decimal power quantity in kW."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The maximum continuous rating power must be provided as one decimal power quantity in kW."
    ] ;
    sh:sparql [
        sh:message "For the declared ice class, maximum continuous rating power must be at least the calculated required power and at least 1,000 kW for IA, IB, or IC, or 2,800 kW for IA Super." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?maximumQuantity .

                ?calculatedQuantity qudt:numericValue ?calculatedPower .
                ?maximumQuantity qudt:numericValue ?maximumPower .

                FILTER (
                    ?maximumPower < ?calculatedPower ||
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        ?maximumPower < "2800"^^xsd:decimal
                    ) ||
                    (
                        ?iceClass != nltl:iceClassIaSuper &&
                        ?maximumPower < "1000"^^xsd:decimal
                    )
                )
            }
        """
    ] .
