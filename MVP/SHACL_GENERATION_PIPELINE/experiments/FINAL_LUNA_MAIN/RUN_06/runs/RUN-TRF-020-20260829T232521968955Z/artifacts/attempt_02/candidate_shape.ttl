@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF020Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:maxCount 1 ;
                sh:maxInclusive "2003-08-31"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "The ice class must be outside the applicable IA Super, IA, IB, and IC set for the non-applicable branch." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass NOT IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa,
                                nltl:iceClassIb,
                                nltl:iceClassIc
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                )
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerDiameter ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 1 ;
                sh:maxInclusive 3
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class nltl:iceWaterline
                ]
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class nltl:iceWaterline ;
                    sh:property [
                        sh:path nltl:upperIceWaterlineLength ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:upperIceWaterlineBreadth ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:propellerCount ;
                        sh:hasValue 1 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputCoefficientKe ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "2.03"^^xsd:decimal ;
                                sh:maxInclusive "2.03"^^xsd:decimal
                            ]
                        ]
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:propellerPitchControlType ;
                                sh:hasValue nltl:controllablePitch ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:conventionalPropulsionSystem ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:electricPropulsionMachinery ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:hydraulicPropulsionMachinery ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:propellerCount ;
                        sh:hasValue 1 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propellerPitchControlType ;
                        sh:hasValue nltl:fixedPitch ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propulsionSystemType ;
                        sh:hasValue nltl:conventionalPropulsionSystem ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputCoefficientKe ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "2.26"^^xsd:decimal ;
                                sh:maxInclusive "2.26"^^xsd:decimal
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:propellerCount ;
                        sh:hasValue 2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputCoefficientKe ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "1.44"^^xsd:decimal ;
                                sh:maxInclusive "1.44"^^xsd:decimal
                            ]
                        ]
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:propellerPitchControlType ;
                                sh:hasValue nltl:controllablePitch ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:conventionalPropulsionSystem ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:electricPropulsionMachinery ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:hydraulicPropulsionMachinery ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:propellerCount ;
                        sh:hasValue 2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propellerPitchControlType ;
                        sh:hasValue nltl:fixedPitch ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propulsionSystemType ;
                        sh:hasValue nltl:conventionalPropulsionSystem ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputCoefficientKe ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "1.60"^^xsd:decimal ;
                                sh:maxInclusive "1.60"^^xsd:decimal
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:propellerCount ;
                        sh:hasValue 3 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputCoefficientKe ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "1.18"^^xsd:decimal ;
                                sh:maxInclusive "1.18"^^xsd:decimal
                            ]
                        ]
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:propellerPitchControlType ;
                                sh:hasValue nltl:controllablePitch ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:conventionalPropulsionSystem ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:electricPropulsionMachinery ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:propulsionSystemType ;
                                sh:hasValue nltl:hydraulicPropulsionMachinery ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:propellerCount ;
                        sh:hasValue 3 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propellerPitchControlType ;
                        sh:hasValue nltl:fixedPitch ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propulsionSystemType ;
                        sh:hasValue nltl:conventionalPropulsionSystem ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputCoefficientKe ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "1.31"^^xsd:decimal ;
                                sh:maxInclusive "1.31"^^xsd:decimal
                            ]
                        ]
                    ]
                ]
            ) ;
            sh:sparql [
                sh:message "The maximum continuous rating power must be at least both externally calculated minimum powers." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower/qudt:numericValue ?mcr .
                        $this nltl:minimumRequiredPowerAtLowerIceWaterline/qudt:numericValue ?lower .
                        $this nltl:minimumRequiredPowerAtUpperIceWaterline/qudt:numericValue ?upper .
                        FILTER (?mcr < ?lower || ?mcr < ?upper)
                    }
                """
            ]
        ]
    ) ;
    sh:message "Construction date and ice class must establish applicability before the complex engine-output readiness constraints are assessed." .
