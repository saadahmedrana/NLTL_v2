@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF023Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable ice class regulation edition is required and must be single-valued."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship ice class is required and must be single-valued."
    ] ;
    sh:or (
        gen:TRF023ApplicableShape
        gen:TRF023NonApplicableShape
    ) .

gen:TRF023ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2002
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:message "The ship must provide its maximum continuous rating power in kW."
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:message "The required minimum power under the 1985 rules must be provided in kW."
    ] ;
    sh:sparql [
        sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                ?mcrQuantity qudt:numericValue ?mcrValue .
                $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?requiredQuantity qudt:numericValue ?requiredValue .
                FILTER (?mcrValue < ?requiredValue)
            }
        """
    ] .

gen:TRF023NonApplicableShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2008
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2010
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2017
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2021
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2002
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2002
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2002
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIi
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2002
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIii
            ]
        ]
    ) .
