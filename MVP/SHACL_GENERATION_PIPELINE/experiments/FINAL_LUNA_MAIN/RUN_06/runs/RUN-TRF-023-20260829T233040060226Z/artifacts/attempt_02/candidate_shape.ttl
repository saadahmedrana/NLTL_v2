@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF023Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF023IaShape
        gen:TRF023IaSuperShape
        gen:TRF023IbIcShape
    ) ;
    sh:message "The ship must satisfy the ice-class regulation edition and engine-output requirements applicable to its ice class." .

gen:TRF023IaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:hasValue nltl:iceClassIa ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:hasValue nltl:iceClassRegulationEdition2002 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice class IA must identify the applicable 2002 ice-class regulation edition."
    ] .

gen:TRF023IaSuperShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:hasValue nltl:iceClassRegulationEdition2002 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice class IA Super must identify the applicable 2002 ice-class regulation edition."
    ] .

gen:TRF023IbIcShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:hasValue nltl:iceClassRuleEdition1985 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice class IB or IC must identify applicability of the 1985 ice-class regulations."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue qudt:KiloW ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:message "The ship must provide one maximum continuous rating power value in kW."
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue qudt:KiloW ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:message "The required power under the 1985 rules must be provided in kW."
    ] ;
    sh:sparql [
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:maximumContinuousRatingPower ?mcrQuantity .
                ?mcrQuantity qudt:numericValue ?mcrValue .
                ?this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?requiredQuantity qudt:numericValue ?requiredValue .
                FILTER (?mcrValue < ?requiredValue)
            }
        """ ;
        sh:message "For ice class IB or IC, maximum continuous rating power must be at least the required power under the 1985 rules."
    ] .
