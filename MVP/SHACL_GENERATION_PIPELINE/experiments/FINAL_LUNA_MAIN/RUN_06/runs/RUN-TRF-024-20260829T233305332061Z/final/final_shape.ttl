@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-024-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        _:branch1
        _:branch2
        _:branch3
    ) ;
    sh:message "The ship must satisfy one applicable ice-class deadline branch or an explicit non-applicable branch." .

_:branch1
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

_:branch2
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For ice class IA or IA Super, the construction stage date must be on or after 1 September 2003 for this non-applicable branch." ;
        sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this nltl:constructionStageDate ?constructionDate . FILTER (datatype(?constructionDate) = xsd:date) FILTER ( YEAR(?constructionDate) < 2003 || ( YEAR(?constructionDate) = 2003 && ( MONTH(?constructionDate) < 9 || ( MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1 ) ) ) ) }"
    ] .

_:branch3
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For ice class IA or IA Super with construction before 1 September 2003, the assessment date must not be later than 1 January in the year twenty years after delivery." ;
        sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this nltl:constructionStageDate ?constructionDate ; nltl:deliveryDate ?deliveryDate ; nltl:assessmentDate ?assessmentDate . FILTER (datatype(?constructionDate) = xsd:date) FILTER (datatype(?deliveryDate) = xsd:date) FILTER (datatype(?assessmentDate) = xsd:date) FILTER ( YEAR(?constructionDate) < 2003 || ( YEAR(?constructionDate) = 2003 && ( MONTH(?constructionDate) < 9 || ( MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1 ) ) ) ) FILTER ( YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 || ( YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 && ( MONTH(?assessmentDate) > 1 || ( MONTH(?assessmentDate) = 1 && DAY(?assessmentDate) > 1 ) ) ) ) }"
    ] .
