@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:CaseBaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case shall specify its vertical load position."
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case shall specify its horizontal load position."
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case shall confirm the capacity-minimizing load position."
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case shall confirm evaluation of combined bending and shear."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:upperIceWaterlineCenteredPosition ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineReferencePosition ;
                sh:node nltlgen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterlineReferencePosition ;
                sh:node nltlgen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:intermediateVerticalPosition ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:otherHorizontalPosition ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .

nltlgen:CaseDeterminedShape
    a sh:NodeShape ;
    sh:node nltlgen:CaseBaseShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:CaseUndeterminedShape
    a sh:NodeShape ;
    sh:node nltlgen:CaseBaseShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each undetermined-length case shall specify its load patch length."
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each undetermined-length case shall pair its load patch length with its corresponding dimensionless ca value."
    ] .

nltlgen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node nltlgen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall provide the spacing input."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node nltlgen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall provide the span input."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node nltlgen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:class nltl:directAnalysisCase ;
                sh:node nltlgen:CaseDeterminedShape ;
                sh:minCount 3 ;
                sh:message "When load length is determined from the arrangement, several vertical and horizontal direct analysis cases shall be provided."
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseDeterminedShape ;
                    sh:property [
                        sh:path nltl:verticalLoadPositionType ;
                        sh:hasValue nltl:upperIceWaterlineCenteredPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseDeterminedShape ;
                    sh:property [
                        sh:path nltl:verticalLoadPositionType ;
                        sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseDeterminedShape ;
                    sh:property [
                        sh:path nltl:verticalLoadPositionType ;
                        sh:hasValue nltl:intermediateVerticalPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseDeterminedShape ;
                    sh:property [
                        sh:path nltl:horizontalLoadPositionType ;
                        sh:hasValue nltl:midSpanOrSpacingCenteredPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseDeterminedShape ;
                    sh:property [
                        sh:path nltl:horizontalLoadPositionType ;
                        sh:hasValue nltl:otherHorizontalPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:class nltl:directAnalysisCase ;
                sh:node nltlgen:CaseUndeterminedShape ;
                sh:minCount 3 ;
                sh:message "When load length is not determined from the arrangement, several paired load-length and ca direct analysis cases shall be provided."
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseUndeterminedShape ;
                    sh:property [
                        sh:path nltl:verticalLoadPositionType ;
                        sh:hasValue nltl:upperIceWaterlineCenteredPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseUndeterminedShape ;
                    sh:property [
                        sh:path nltl:verticalLoadPositionType ;
                        sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseUndeterminedShape ;
                    sh:property [
                        sh:path nltl:verticalLoadPositionType ;
                        sh:hasValue nltl:intermediateVerticalPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseUndeterminedShape ;
                    sh:property [
                        sh:path nltl:horizontalLoadPositionType ;
                        sh:hasValue nltl:midSpanOrSpacingCenteredPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node nltlgen:CaseUndeterminedShape ;
                    sh:property [
                        sh:path nltl:horizontalLoadPositionType ;
                        sh:hasValue nltl:otherHorizontalPosition
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ]
        ]
    ) .
