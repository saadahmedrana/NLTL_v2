@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF041PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A plating spacing value in metres is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:MegapascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A plating-owned yield strength value in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gen:MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A plating-owned corrosion and abrasion addition in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:node gen:MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally determined shell plating thickness in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:class nltl:platingFramingOrientationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The plating framing orientation must identify a permitted transverse or longitudinal case."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:platingFramingOrientation ;
                sh:hasValue nltl:transverseFramingOrientation ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:platingPressure ;
                sh:node gen:MegapascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Transverse framing requires plating pressure in MPa."
            ] ;
            sh:property [
                sh:path nltl:transversePlatingFactorF1 ;
                sh:node gen:UnitlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Transverse framing requires the plating factor f1."
            ]
        ]
        [
            sh:property [
                sh:path nltl:platingFramingOrientation ;
                sh:hasValue nltl:longitudinalFramingOrientation ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:icePressure ;
                sh:node gen:MegapascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Longitudinal framing requires ice pressure in MPa."
            ] ;
            sh:property [
                sh:path nltl:longitudinalPlatingFactorF2 ;
                sh:node gen:UnitlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Longitudinal framing requires the plating factor f2."
            ]
        ]
    ) .
