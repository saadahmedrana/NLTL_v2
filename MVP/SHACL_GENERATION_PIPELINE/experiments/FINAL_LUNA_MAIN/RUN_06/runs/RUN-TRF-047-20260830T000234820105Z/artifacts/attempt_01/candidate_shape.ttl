@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_047_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame covered by TRF-047 must have a strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:node gen:TRF_047_LowerEndShape ;
        sh:message "The lower end of the strengthened frame part must be represented."
    ] .

gen:TRF_047_LowerEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:tankTop ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The lower end must be attached to a deck, tank boundary plating, tank top, or ice stringer."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:node gen:TRF_047_HorizontalConnectionMemberShape ;
        sh:message "A represented horizontal connection member must satisfy the permitted alternative."
    ] ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:node gen:TRF_047_TerminationSupportingStructureShape ;
        sh:message "A represented termination below a supporting structure must identify that structure as being at or below the ice-belt lower limit."
    ] .

gen:TRF_047_TerminationSupportingStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The supporting structure for the conditional termination must be at or below the ice-belt lower limit."
    ] .

gen:TRF_047_HorizontalConnectionMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:class nltl:mainFrame ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:mainFrameBelowIceBeltStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "An adjacent main frame used by the conditional connection must be ice strengthened below the ice belt."
            ]
        ] ;
        sh:message "The horizontal connection member must connect to an adjacent main frame."
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The horizontal connection member must have the same scantlings as the main frames."
    ] .
