@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix qunit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM2>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue qunit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM3>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue qunit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-QuantityValue-M>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue qunit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-QuantityValue-MegaPA>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue qunit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-QuantityValue-Unitless>
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue qunit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-M-Exact-13-3>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-Unitless> ;
            sh:property [
                sh:path q:numericValue ;
                sh:minInclusive 13.3 ;
                sh:maxInclusive 13.3
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-048-M-Smaller-Than-13-3>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-Unitless> ;
            sh:property [
                sh:path q:numericValue ;
                sh:maxExclusive 13.3
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-048-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:continuousBeamWithBracketsFrameCondition
    ] ;

    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true
            ] ;
            sh:node <urn:nltl:generated-shape:TRF-048-M-Smaller-Than-13-3>
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false
            ] ;
            sh:node <urn:nltl:generated-shape:TRF-048-M-Exact-13-3>
        ]
    ) ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-MegaPA>
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-M>
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-M>
    ] ;

    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-M>
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-Unitless>
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-MegaPA>
    ] ;

    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-Unitless>
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM3>
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM2>
    ] ;

    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM2>
    ] ;

    sh:property [
        sh:path nltl:bracketArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM2>
    ] ;

    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-QuantityValue-CentiM2>
    ] ;

    sh:sparql [
        sh:message "The frame calculation results or actual shear-area exclusion do not satisfy the declared formulas; calculated decimals use a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode ;
                      nltl:actualFrameShearArea ?actualNode ;
                      nltl:bracketArea ?bracketNode ;
                      nltl:grossFrameShearArea ?grossNode .

                ?pNode q:numericValue ?p .
                ?hNode q:numericValue ?h .
                ?sNode q:numericValue ?s .
                ?lNode q:numericValue ?l .
                ?mNode q:numericValue ?m .
                ?sigmaNode q:numericValue ?sigma .
                ?f4Node q:numericValue ?f4 .
                ?zNode q:numericValue ?z .
                ?aNode q:numericValue ?a .
                ?actualNode q:numericValue ?actual .
                ?bracketNode q:numericValue ?bracket .
                ?grossNode q:numericValue ?gross .

                BIND ((1.0 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l / (4.0 * ?m * ?sigma) * 1000000.0) AS ?expectedZ)
                BIND ((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2.0 * ?sigma) * 10000.0) AS ?expectedA)
                BIND ((?gross - ?bracket) AS ?expectedActual)

                BIND ((1e-6 * ?expectedF4 + 1e-9) AS ?tolF4)
                BIND ((1e-6 * ?expectedZ + 1e-9) AS ?tolZ)
                BIND ((1e-6 * ?expectedA + 1e-9) AS ?tolA)
                BIND ((1e-6 * ?expectedActual + 1e-9) AS ?tolActual)

                FILTER (
                    (?f4 < (?expectedF4 - ?tolF4) || ?f4 > (?expectedF4 + ?tolF4)) ||
                    (?z < (?expectedZ - ?tolZ) || ?z > (?expectedZ + ?tolZ)) ||
                    (?a < (?expectedA - ?tolA) || ?a > (?expectedA + ?tolA)) ||
                    (?actual < (?expectedActual - ?tolActual) || ?actual > (?expectedActual + ?tolActual))
                )
            }
        """
    ] .
