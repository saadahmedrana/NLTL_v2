@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF056ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeatherdeckHatch ;
        sh:node gen:TRF056WeatherdeckHatchShape
    ] .

gen:TRF056WeatherdeckHatchShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "For a weatherdeck hatch longer than half the ship breadth, ship side deflection and both hatch cover and hatch fitting design evidence must be represented." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasWeatherdeckHatch $this .
                ?ship nltl:shipBreadth ?breadthQuantity .
                ?breadthQuantity qudt:numericValue ?breadthValue ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                $this nltl:hatchOpeningLength ?openingQuantity .
                ?openingQuantity qudt:numericValue ?openingValue ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (datatype(?breadthValue) = xsd:decimal)
                FILTER (datatype(?openingValue) = xsd:decimal)
                FILTER (?openingValue > (?breadthValue / 2))

                FILTER (
                    NOT EXISTS {
                        $this nltl:shipSideDeflection ?deflectionQuantity .
                        ?deflectionQuantity qudt:numericValue ?deflectionValue ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?deflectionValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                    }
                )
            }
        """
    ] .
