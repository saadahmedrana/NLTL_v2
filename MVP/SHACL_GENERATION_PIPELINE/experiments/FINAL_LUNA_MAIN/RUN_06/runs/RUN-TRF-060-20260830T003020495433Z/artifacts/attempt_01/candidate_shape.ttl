@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:QuantityValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:node gs:ActualWebFrameCrossSectionalAreaShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Actual web-frame cross-sectional area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gs:RequiredShearAreaShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Required shear area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gs:SectionModulusShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Externally computed section modulus is required in cm3."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gs:ShearAreaShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Shear area is required in m2."
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:node gs:WebFrameFreeFlangeAreaShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Web-frame free-flange area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:node gs:WebFrameIceLoadShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Web-frame ice load is required in kN."
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:node gs:WebFrameMaximumIceLoadBendingMomentShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Externally computed maximum ice-load bending moment is required in MN m."
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:node gs:WebFrameSpanShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Web-frame span is required in m."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gs:TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:message "A table lookup case with table-selection evidence is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:YieldStrengthShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength is required in MPa."
    ] .

gs:ActualWebFrameCrossSectionalAreaShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

gs:RequiredShearAreaShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

gs:SectionModulusShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
    ] .

gs:ShearAreaShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2>
    ] .

gs:WebFrameFreeFlangeAreaShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

gs:WebFrameIceLoadShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .

gs:WebFrameMaximumIceLoadBendingMomentShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M>
    ] .

gs:WebFrameSpanShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gs:YieldStrengthShape a sh:NodeShape ;
    sh:node gs:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

gs:TableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Table-selection evidence is required."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:class nltl:tableReferenceValue ;
        sh:in ( nltl:traficomTable4Dash8 ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The lookup case must reference TRAFICOM Table 4-8."
    ] .
