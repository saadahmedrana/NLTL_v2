@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:sidePropellerShaftingAssembly ;
            sh:property [
                sh:path nltl:enclosedByPlatedBossing ;
                sh:minCount 1 ;
                sh:class nltl:platedBossingStructure ;
                sh:message "Side propeller shafting shall be enclosed within plated bossing."
            ]
        ] ;
        sh:message "The ship shall identify side propeller shafting enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:sternTube ;
            sh:property [
                sh:path nltl:enclosedByPlatedBossing ;
                sh:minCount 1 ;
                sh:class nltl:platedBossingStructure ;
                sh:message "Stern tubes shall be enclosed within plated bossing."
            ]
        ] ;
        sh:message "The ship shall identify stern tubes enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The detached-strut applicability value shall be provided."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:detachedStrutStructure ;
                    sh:property [
                        sh:path nltl:hasStrutDesignEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:strutDesignEvidence ;
                        sh:message "Design evidence shall be provided for a detached strut."
                    ] ;
                    sh:property [
                        sh:path nltl:hasStrutStrengthEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:strutStrengthEvidence ;
                        sh:message "Strength evidence shall be provided for a detached strut."
                    ] ;
                    sh:property [
                        sh:path nltl:hasStrutHullAttachmentEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:strutHullAttachmentEvidence ;
                        sh:message "Hull-attachment evidence shall be provided for a detached strut."
                    ]
                ] ;
                sh:message "A detached-strut structure with design, strength, and hull-attachment evidence shall be provided."
            ]
        ]
    ) .
