@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A detached-strut applicability value must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node gen:EnclosedShipComponentShape
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node gen:EnclosedShipComponentShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:class nltl:detachedStrutStructure ;
                sh:minCount 1 ;
                sh:message "When detached struts are used, a detached-strut structure must be identified."
            ]
        ]
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:hasValue false
            ]
        ]
    ) .

gen:EnclosedShipComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:class nltl:platedBossingStructure ;
        sh:minCount 1 ;
        sh:message "Each represented side-propeller shafting or stern-tube component must be enclosed by plated bossing."
    ] .
