@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-066> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide one ice class to determine applicability of the rudder protection requirement."
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether an ice knife is practicable."
    ] ;
    sh:sparql [
        sh:message "For ice classes IA and IA Super, when an ice knife is practicable, the rudder protection arrangement must include an ice knife extending below the lower ice waterline." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                $this nltl:iceKnifePracticable ?practicable .
                FILTER (?practicable = true)
                FILTER NOT EXISTS {
                    $this nltl:hasRudderProtectionArrangement ?arrangement .
                    ?arrangement a nltl:iceKnife .
                    ?arrangement nltl:extendsBelowLowerIceWaterline true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For ice classes IA and IA Super, when an ice knife is not practicable, the rudder protection arrangement must provide equivalent rudder protection means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                $this nltl:iceKnifePracticable ?practicable .
                FILTER (?practicable = false)
                FILTER NOT EXISTS {
                    $this nltl:hasRudderProtectionArrangement ?arrangement .
                    ?arrangement a nltl:equivalentRudderProtectionMeans .
                }
            }
        """
    ] .
