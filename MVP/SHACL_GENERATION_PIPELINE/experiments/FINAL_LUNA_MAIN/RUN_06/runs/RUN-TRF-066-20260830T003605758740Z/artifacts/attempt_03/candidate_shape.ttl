@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:TRF066ApplicableShape
        gen:TRF066NonApplicableShape
    ) .

gen:TRF066ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        )
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterline ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:TRF066PracticableShape
        gen:TRF066EquivalentShape
    ) .

gen:TRF066PracticableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceKnife ;
            sh:property [
                sh:path nltl:extendsBelowLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For an IA or IA Super ship with a practicable ice knife, the ship's supplied lower ice waterline and the linked ice-knife arrangement extending below it must be represented." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:lowerIceWaterline ?liwl ;
                          nltl:hasRudderProtectionArrangement ?arrangement .
                    ?arrangement a nltl:iceKnife ;
                                 nltl:extendsBelowLowerIceWaterline true .
                }
            }
        """
    ] .

gen:TRF066EquivalentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:equivalentRudderProtectionMeans
        ]
    ] .

gen:TRF066NonApplicableShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "This branch applies only when the ship's ice class is not IA or IA Super." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
            }
        """
    ] .
