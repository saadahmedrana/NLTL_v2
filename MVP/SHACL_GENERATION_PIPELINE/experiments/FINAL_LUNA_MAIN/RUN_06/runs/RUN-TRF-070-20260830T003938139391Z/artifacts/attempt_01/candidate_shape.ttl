@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF070QuantityKiloNShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF070QuantityMegaPAShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF070DesignConditionShape>
    a sh:NodeShape ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designConditionExpectedLoad ;
        sh:node <urn:nltl:generated-shape:TRF070QuantityKiloNShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designConditionLocalStrengthCapacity ;
        sh:node <urn:nltl:generated-shape:TRF070QuantityKiloNShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The externally assessed local-strength capacity must be at least the applicable local ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasDesignCondition $this .
                ?ship nltl:localIcePressure ?pressureQuantity .
                ?pressureQuantity qudt:numericValue ?pressure .
                $this nltl:designConditionLocalStrengthCapacity ?capacityQuantity .
                ?capacityQuantity qudt:numericValue ?capacity .
                FILTER (?capacity < ?pressure)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF070ApplicableRequirementsShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:node <urn:nltl:generated-shape:TRF070QuantityKiloNShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:node <urn:nltl:generated-shape:TRF070QuantityKiloNShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node <urn:nltl:generated-shape:TRF070QuantityMegaPAShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:node <urn:nltl:generated-shape:TRF070DesignConditionShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF070AzimuthingBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:hasValue "azimuthing" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:node <urn:nltl:generated-shape:TRF070ApplicableRequirementsShape> .

<urn:nltl:generated-shape:TRF070FixedBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:hasValue "fixed" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:node <urn:nltl:generated-shape:TRF070ApplicableRequirementsShape> .

<urn:nltl:generated-shape:TRF070ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:TRF070AzimuthingBranchShape>
        <urn:nltl:generated-shape:TRF070FixedBranchShape>
    ) .
