@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:datatype nltl:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:datatype nltl:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 2 ;
        sh:node gen:TRF078TableLookupCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:traficomTable6Dash6
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIaSuper
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DimensionlessQuantityShape
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:traficomTable6Dash7
            ] ;
            sh:property [
                sh:path nltl:tableLookupPropellerLocation ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:propellerLocationValue
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DimensionlessQuantityShape
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true ;
        sh:message "The ship must provide one Table 6-6 lookup case and one Table 6-7 lookup case."
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n for the paired table lookup cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?reported ;
                      nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase .

                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nnNode qudt:numericValue ?nn .
                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                            nltl:selectedIceClassCycleCount ?nClassNode .
                ?nClassNode qudt:numericValue ?nClass .
                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                               nltl:selectedPropellerLocationFactor ?k1Node .
                ?k1Node qudt:numericValue ?k1 .

                BIND((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                FILTER(ABS(xsd:decimal(?reported) - ?expected) >
                       ((0.000001 * ABS(?expected)) + 0.000000001))
            }
        """
    ] .

gen:TRF078TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:traficomTable6Dash6
            nltl:traficomTable6Dash7
        ) ;
        sh:message "Each table lookup case must have exactly one permitted table reference."
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
