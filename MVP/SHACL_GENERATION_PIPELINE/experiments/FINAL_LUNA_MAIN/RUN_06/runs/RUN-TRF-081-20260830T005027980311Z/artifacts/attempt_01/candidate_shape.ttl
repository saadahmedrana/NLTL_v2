@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF081Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:forwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:backwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:forwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:backwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9 kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?forwardBladeForceNode ;
                      nltl:backwardBladeForce ?backwardBladeForceNode ;
                      nltl:hydrodynamicBollardThrust ?bollardNode ;
                      nltl:forwardIceThrust ?forwardIceNode ;
                      nltl:backwardIceThrust ?backwardIceNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?forwardBladeForceNode qudt:numericValue ?forwardBladeForce .
                ?backwardBladeForceNode qudt:numericValue ?backwardBladeForce .
                ?bollardNode qudt:numericValue ?bollard .
                ?forwardIceNode qudt:numericValue ?forwardIce .
                ?backwardIceNode qudt:numericValue ?backwardIce .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                BIND((1.1 * ?forwardBladeForce) AS ?forwardIceExpected)
                BIND((1.1 * ?backwardBladeForce) AS ?backwardIceExpected)
                BIND((?bollard + (2.2 * ?forwardIceExpected)) AS ?forwardDesignExpected)
                BIND((1.5 * ?backwardIceExpected) AS ?backwardDesignExpected)
                BIND(
                    IF(
                        ?forwardDesignExpected >= ?backwardDesignExpected,
                        ?forwardDesignExpected,
                        ?backwardDesignExpected
                    )
                    AS ?designExpected
                )

                FILTER(
                    ABS(?forwardIce - ?forwardIceExpected) >
                    (ABS(?forwardIceExpected) * 0.000001 + 0.000000001)
                    ||
                    ABS(?backwardIce - ?backwardIceExpected) >
                    (ABS(?backwardIceExpected) * 0.000001 + 0.000000001)
                    ||
                    ABS(?forwardDesign - ?designExpected) >
                    (ABS(?designExpected) * 0.000001 + 0.000000001)
                    ||
                    ABS(?backwardDesign - ?designExpected) >
                    (ABS(?designExpected) * 0.000001 + 0.000000001)
                    ||
                    ABS(?design - ?designExpected) >
                    (ABS(?designExpected) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .
