@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_083_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the propeller rotational speed at MCR in bollard condition in revolutions per minute."
    ] ;
    sh:property [
        sh:path nltl:rotationalSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:rotationalSpeedKnown ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:rotationalSpeedKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:node [
                    sh:class nltl:tableLookupCase ;
                    sh:property [
                        sh:path nltl:tableLookupApplied ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:tableReference ;
                        sh:hasValue nltl:traficomTable6Dash9 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:lookupSelectionEvidence ;
                        sh:node [
                            sh:class nltl:evidenceArtifact
                        ] ;
                        sh:minCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:message "When the propeller rotational speed is unknown, a lookup case using TRAFICOM Table 6-9 and selection evidence must be provided."
            ]
        ]
    ) ;
    sh:message "Rotational speed must be known or attributed using the required TRAFICOM Table 6-9 lookup case." .
