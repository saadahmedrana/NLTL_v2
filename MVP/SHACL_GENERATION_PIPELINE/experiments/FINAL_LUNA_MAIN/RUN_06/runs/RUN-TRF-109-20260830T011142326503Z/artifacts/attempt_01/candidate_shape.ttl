@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF109Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 5000000 ;
        sh:maxInclusive 100000000 ;
        sh:message "The ship must have exactly one ice load cycle count from 5000000 through 100000000."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:traficomTable6Dash14 ;
                sh:message "The table lookup case must reference exactly TRAFICOM Table 6-14."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:propellerType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:string ;
                        sh:hasValue "open" ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC1 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "0.000747"^^xsd:decimal ;
                                sh:maxInclusive "0.000747"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "0.0645"^^xsd:decimal ;
                                sh:maxInclusive "0.0645"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC3 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "-0.0565"^^xsd:decimal ;
                                sh:maxInclusive "-0.0565"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC4 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "2.22"^^xsd:decimal ;
                                sh:maxInclusive "2.22"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                ]
                [
                    sh:property [
                        sh:path nltl:propellerType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:string ;
                        sh:hasValue "ducted" ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC1 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "0.000534"^^xsd:decimal ;
                                sh:maxInclusive "0.000534"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "0.0533"^^xsd:decimal ;
                                sh:maxInclusive "0.0533"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC3 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "-0.0459"^^xsd:decimal ;
                                sh:maxInclusive "-0.0459"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                    sh:property [
                        sh:path nltl:fatigueCoefficientC4 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "2.584"^^xsd:decimal ;
                                sh:maxInclusive "2.584"^^xsd:decimal ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS ;
                            ] ;
                        ] ;
                    ] ;
                ]
            ) ;
            sh:message "The table lookup case must contain exactly one supported propeller type and the matching C1-C4 coefficients from Table 6-14."
        ] ;
    ] .
