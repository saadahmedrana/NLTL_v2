@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-004-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must specify exactly one upper ice waterline."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloTON_Metric
            ]
        ] ;
        sh:message "The ship must specify its upper-ice-waterline displacement in metric kilotonnes."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:node <urn:nltl:generated-shape:I2-004-CaseShape> ;
        sh:message "Each represented upper ice waterline case must have a valid displacement in metric kilotonnes."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline displacement must not be less than a represented waterline case displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
                ?shipDisplacement qudt:numericValue ?shipValue .
                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseDisplacement .
                ?caseDisplacement qudt:numericValue ?caseValue .
                FILTER (
                    datatype(?shipValue) = xsd:decimal &&
                    datatype(?caseValue) = xsd:decimal &&
                    ?caseValue > ?shipValue
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline displacement must equal the greatest represented waterline case displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?shipDisplacement .
                ?shipDisplacement qudt:numericValue ?shipValue .
                $this nltl:hasUpperIceWaterlineCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?matchingCase .
                    ?matchingCase nltl:waterlineCaseDisplacement ?matchingDisplacement .
                    ?matchingDisplacement qudt:numericValue ?matchingValue .
                    FILTER (
                        datatype(?matchingValue) = xsd:decimal &&
                        datatype(?shipValue) = xsd:decimal &&
                        ?matchingValue = ?shipValue
                    )
                }
            }
        """
    ] .

<urn:nltl:generated-shape:I2-004-CaseShape>
    a sh:NodeShape ;
    sh:class nltl:upperIceWaterlineCase ;
    sh:property [
        sh:path nltl:waterlineCaseDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloTON_Metric
            ]
        ] ;
        sh:message "A waterline case must specify exactly one displacement in metric kilotonnes."
    ] .
