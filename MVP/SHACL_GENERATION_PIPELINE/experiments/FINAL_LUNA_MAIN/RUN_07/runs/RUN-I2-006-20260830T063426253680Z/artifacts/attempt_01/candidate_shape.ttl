@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "When astern ice operation is intended, the aft section design basis must use the Bow and Bow Intermediate hull area requirements."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "When astern ice operation is intended, the hull area requirement set must be the Bow and Bow Intermediate hull area requirements."
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
