@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:GeneratedShape_I2_009 a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:class nltl:hullAreaAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify one hull-area assignment for this requirement."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node nltl:GeneratedPressureQuantity_I2_009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Average ice pressure must be supplied as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node nltl:GeneratedAngleQuantity_I2_009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The buttock angle must be supplied as a single degree quantity."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node nltl:GeneratedAspectRatioQuantity_I2_009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load-patch aspect ratio must be recorded as 3.6 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node nltl:GeneratedLengthQuantity_I2_009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow load-patch height must be supplied as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node nltl:GeneratedLengthQuantity_I2_009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow load-patch length must be supplied as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node nltl:GeneratedAngleQuantity_I2_009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The normal frame angle must be supplied as a single degree quantity."
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a bow form marked applicable, the buttock angle must be greater than 0 degrees and less than 80 degrees, and the normal frame angle must be greater than 10 degrees." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:bowFormApplicability true ;
        nltl:buttockAngle ?buttock ;
        nltl:normalFrameAngle ?frame .
  ?buttock qudt:numericValue ?buttockValue .
  ?frame qudt:numericValue ?frameValue .
  FILTER (?buttockValue <= 0 || ?buttockValue >= 80 || ?frameValue <= 10)
}
"""
    ] ;
    sh:sparql [
        sh:message "Bow-form applicability must be true when the supplied buttock and normal-frame angles satisfy the stated applicability conditions." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:buttockAngle ?buttock ;
        nltl:normalFrameAngle ?frame .
  ?buttock qudt:numericValue ?buttockValue .
  ?frame qudt:numericValue ?frameValue .
  FILTER (?buttockValue > 0 && ?buttockValue < 80 && ?frameValue > 10)
  FILTER NOT EXISTS {
    $this nltl:bowFormApplicability true
  }
}
"""
    ] .

nltl:GeneratedHullAreaAssignmentShape_I2_009 a sh:NodeShape ;
    sh:targetClass nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:in (
            nltl:otherIceStrengthenedArea
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The hull-area assignment must identify an allowed ice-strengthened area."
    ] .

nltl:GeneratedPressureQuantity_I2_009 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:GeneratedAngleQuantity_I2_009 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:GeneratedLengthQuantity_I2_009 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:GeneratedAspectRatioQuantity_I2_009 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
