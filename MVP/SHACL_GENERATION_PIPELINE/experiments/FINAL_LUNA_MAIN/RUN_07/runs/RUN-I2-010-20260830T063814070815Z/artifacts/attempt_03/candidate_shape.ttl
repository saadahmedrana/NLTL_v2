@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_010_DirectStaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "The ship must be assigned Polar Class PC6 or PC7."
    ] ;
    sh:property [
        sh:path nltl:verticalSidedBowForm ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The ship must have a bow form with vertical sides."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 0 ;
                sh:maxInclusive 10 ;
                sh:message "The normal frame angle must be between 0 and 10 degrees inclusive."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:DEG ;
                sh:message "The normal frame angle must use degrees."
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethod ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the design ice-force calculation method."
    ] .
