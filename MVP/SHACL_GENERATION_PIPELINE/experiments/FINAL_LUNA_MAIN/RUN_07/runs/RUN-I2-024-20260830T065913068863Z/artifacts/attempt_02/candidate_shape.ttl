@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node gs:CalculationCaseShape ;
        sh:message "Each ship shall provide a calculation case with the declared framing-thickness inputs."
    ] ;
    sh:property [
        sh:path nltl:hasObliquePlatingInterpolationCase ;
        sh:minCount 1 ;
        sh:class nltl:obliquePlatingInterpolationCase ;
        sh:node gs:ObliquePlatingInterpolationCaseShape ;
        sh:message "Each ship shall provide an oblique plating interpolation case."
    ] .

gs:CalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:longitudinalFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gs:MillimetreQuantityShape ;
        sh:message "The calculation case shall contain the longitudinal framing net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:transverseFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gs:MillimetreQuantityShape ;
        sh:message "The calculation case shall contain the transverse framing net plate thickness."
    ] .

gs:ObliquePlatingInterpolationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:obliquePlatingInterpolationCase ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:node gs:FramingAngleShape ;
        sh:message "The oblique plating interpolation case shall contain a framing angle strictly between 20 and 70 degrees."
    ] ;
    sh:property [
        sh:path nltl:interpolatedNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gs:UnspecifiedUnitQuantityShape ;
        sh:message "The oblique plating interpolation case shall contain the externally computed interpolated net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:minCount 1 ;
        sh:class nltl:interpolationPoint ;
        sh:node gs:InterpolationPointShape ;
        sh:message "The interpolation case shall link a lower interpolation point."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:minCount 1 ;
        sh:class nltl:interpolationPoint ;
        sh:node gs:InterpolationPointShape ;
        sh:message "The interpolation case shall link an upper interpolation point."
    ] .

gs:InterpolationPointShape
    a sh:NodeShape ;
    sh:targetClass nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:message "Each interpolation point shall contain its coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:node gs:UnspecifiedUnitQuantityShape ;
        sh:message "Each interpolation point shall contain its externally computed result."
    ] .

gs:FramingAngleShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 20.0 ;
        sh:maxExclusive 70.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

gs:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

gs:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gs:UnspecifiedUnitQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] .
