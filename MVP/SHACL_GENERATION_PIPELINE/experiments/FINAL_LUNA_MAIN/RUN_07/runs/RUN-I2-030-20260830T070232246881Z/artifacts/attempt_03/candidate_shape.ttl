@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-030-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node <urn:nltl:generated-shape:I2-030-CalculationCaseShape>
    ] .

<urn:nltl:generated-shape:I2-030-CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an oblique framing angle between 20 and 70 degrees, both interpolation endpoints with coordinate and result values are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        ?sm nltl:hasLocalFrameSectionCalculationCase ?lf .
                        ?lf nltl:sectionCalculationCasePlating ?pl .
                        ?pl nltl:framingAngleOmega ?angle .
                        ?angle qudt:numericValue ?omega .
                        FILTER (
                            datatype(?omega) = xsd:decimal &&
                            ?omega > 20 &&
                            ?omega < 70
                        )
                    }
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:interpolationLowerEndpoint ?lower .
                            ?lower a nltl:interpolationPoint .
                            ?lower nltl:interpolationPointCoordinate ?lowerCoord .
                            ?lower nltl:interpolationPointResult ?lowerResult .
                        }
                        ||
                        NOT EXISTS {
                            $this nltl:interpolationUpperEndpoint ?upper .
                            ?upper a nltl:interpolationPoint .
                            ?upper nltl:interpolationPointCoordinate ?upperCoord .
                            ?upper nltl:interpolationPointResult ?upperResult .
                        }
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-ContextQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-030-LocalFrameSectionCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:class nltl:plating ;
        sh:node <urn:nltl:generated-shape:I2-030-PlatingShape>
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember ;
        sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-030-PlatingShape>
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-AngleDegreeQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node <urn:nltl:generated-shape:I2-030-SectionModulusQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-AreaSquareCentimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-AngleDegreeQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When 100 times the local-frame flange area exceeds 1000 times net attached shell thickness times frame spacing, the net effective plastic section modulus is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:netLocalFrameFlangeArea ?areaQ .
                ?areaQ qudt:numericValue ?area ;
                    qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                $this nltl:netAttachedShellPlateThickness ?thicknessQ .
                ?thicknessQ qudt:numericValue ?thickness ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                $this nltl:frameSpacing ?spacingQ .
                ?spacingQ qudt:numericValue ?spacing ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    datatype(?area) = xsd:decimal &&
                    datatype(?thickness) = xsd:decimal &&
                    datatype(?spacing) = xsd:decimal &&
                    100 * ?area <= 1000 * ?thickness * ?spacing
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-030-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] .

<urn:nltl:generated-shape:I2-030-LengthMetreQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:I2-030-LengthMillimetreQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

<urn:nltl:generated-shape:I2-030-AreaSquareCentimetreQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

<urn:nltl:generated-shape:I2-030-SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
    ] .

<urn:nltl:generated-shape:I2-030-AngleDegreeQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

<urn:nltl:generated-shape:I2-030-UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

<urn:nltl:generated-shape:I2-030-ContextQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-030-QuantityValueShape> .
