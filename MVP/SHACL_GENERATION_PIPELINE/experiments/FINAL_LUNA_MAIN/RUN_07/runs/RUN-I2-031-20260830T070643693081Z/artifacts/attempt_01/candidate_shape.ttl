@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:GeneratedShape_I2_031_Ship a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:maxCount 1 ;
        sh:message "The ship frame profile type must be represented by a frame profile type value."
    ] ;
    sh:property [
        sh:path nltl:patchLoad ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:maxCount 1 ;
        sh:message "The patch load must be a single quantity value expressed in kN."
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The plastic collapse mechanism defining the plastic strength must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node nltl:GeneratedShape_I2_031_StructuralMember
    ] .

nltl:GeneratedShape_I2_031_StructuralMember a sh:NodeShape ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:in (
            nltl:bottomStructureLocation
            nltl:sideStructureLocation
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member must be identified as a bottom or side structure member."
    ] ;
    sh:property [
        sh:path nltl:transverseFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The structural member plastic strength must be a single quantity value expressed in kN."
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The midspan plastic collapse load must be a single quantity value expressed in kN."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:node nltl:GeneratedShape_I2_031_LoadCase
    ] ;
    sh:sparql [
        sh:message "The combined shear and bending demand must not exceed the member plastic strength, and the plastic strength must equal the midspan plastic collapse load." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:plasticStrength ?strength ;
          nltl:midspanPlasticCollapseLoad ?midspan ;
          nltl:hasStructuralMemberLoadCase ?loadCase .
    ?strength qudt:numericValue ?strengthValue .
    ?midspan qudt:numericValue ?midspanValue .
    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    ?demand qudt:numericValue ?demandValue .
    FILTER (
        xsd:decimal(?demandValue) > xsd:decimal(?strengthValue)
        || xsd:decimal(?strengthValue) != xsd:decimal(?midspanValue)
    )
}
"""
    ] .

nltl:GeneratedShape_I2_031_LoadCase a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural-member load case must provide one combined shear and bending demand quantity."
    ] ;
    sh:property [
        sh:path nltl:loadPatchOrientation ;
        sh:class nltl:loadPatchOrientationValue ;
        sh:hasValue nltl:loadPatchHeightParallelToFrame ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "For bottom structure, the patch-load dimension b must be parallel with the frame direction."
    ] .
