@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-034-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberApplicabilityShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable longitudinal side structural member must provide plastic strength, midspan plastic collapse load, and a valid combined shear-and-bending demand for every represented load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation .

                FILTER (
                    ! EXISTS {
                        ?member nltl:plasticStrength ?plasticStrength .
                        ?plasticStrength qudt:numericValue ?plasticValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?plasticValue) = xsd:decimal)
                    }
                    ||
                    ! EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                        ?collapseLoad qudt:numericValue ?collapseValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?collapseValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                        FILTER NOT EXISTS {
                            ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                            ?demand qudt:numericValue ?demandValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                            FILTER (datatype(?demandValue) = xsd:decimal)
                        }
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The combined shear-and-bending demand must not exceed the applicable member plastic strength or midspan plastic collapse load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:plasticStrength ?plasticStrength ;
                        nltl:midspanPlasticCollapseLoad ?collapseLoad ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .

                ?plasticStrength qudt:numericValue ?plasticValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?collapseLoad qudt:numericValue ?collapseValue ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                FILTER (
                    datatype(?plasticValue) = xsd:decimal &&
                    datatype(?collapseValue) = xsd:decimal &&
                    datatype(?demandValue) = xsd:decimal &&
                    (
                        ?demandValue > ?plasticValue ||
                        ?demandValue > ?collapseValue
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-034-StructuralMemberApplicabilityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A structural member must state whether it is longitudinally oriented."
    ] ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A structural member must provide its structural location."
    ] .
