@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-037-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:class nltl:loadCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:loadCase ;
                    sh:property [
                        sh:path nltl:combinedShearBendingEffect ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:loadPatchApplicationLocation ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:memberCapacity ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:class nltl:iceLoadPatchDesignCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatchDesignCase ;
            sh:property [
                sh:path nltl:memberCapacityMinimizationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:combinedShearBendingEffect ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:loadPatchApplicationLocation ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The selected load-patch location is not associated with a member capacity that is minimal under the combined bending and shear effects." ;
        sh:select '''
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasIceLoadPatchDesignCase ?designCase .
                ?designCase nltl:loadPatchApplicationLocation ?selectedLocation .
                ?designCase nltl:memberCapacityMinimizationConfirmed true .

                $this nltl:hasStructuralMember ?selectedMember .
                ?selectedMember nltl:hasStructuralMemberLoadCase ?selectedLoadCase .
                ?selectedLoadCase nltl:loadPatchApplicationLocation ?selectedLocation .
                ?selectedMember nltl:memberCapacity ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selectedCapacity ;
                                   qudt:unit unit:KiloN .

                $this nltl:hasStructuralMember ?otherMember .
                ?otherMember nltl:memberCapacity ?otherQuantity .
                ?otherQuantity qudt:numericValue ?otherCapacity ;
                                qudt:unit unit:KiloN .

                FILTER(?otherCapacity < ?selectedCapacity)
            }
        '''
    ] .
</urn:nltl:generated-shape:I2-037-ShipShape>
