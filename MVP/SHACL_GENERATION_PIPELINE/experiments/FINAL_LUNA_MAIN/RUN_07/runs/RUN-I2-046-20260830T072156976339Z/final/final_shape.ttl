@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_046_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "polarClassRequirementsApplicable must be recorded exactly once as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in [
                    rdf:first nltl:polarClassPc1 ;
                    rdf:rest [
                        rdf:first nltl:polarClassPc2 ;
                        rdf:rest [
                            rdf:first nltl:polarClassPc3 ;
                            rdf:rest [
                                rdf:first nltl:polarClassPc4 ;
                                rdf:rest [
                                    rdf:first nltl:polarClassPc5 ;
                                    rdf:rest [
                                        rdf:first nltl:polarClassPc6 ;
                                        rdf:rest [
                                            rdf:first nltl:polarClassPc7 ;
                                            rdf:rest rdf:nil
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ]
                ] ;
                sh:message "An applicable Polar Class ship must have exactly one valid polarClass value."
            ] ;
            sh:property [
                sh:path nltl:hasInternalIceStrengthenedStructure ;
                sh:node [
                    sh:property [
                        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive "1.0"^^xsd:decimal ;
                                sh:message "The internal structure corrosion/abrasion addition must be at least 1.0 mm."
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                sh:message "The internal structure corrosion/abrasion addition must use exactly one millimetre unit."
                            ]
                        ] ;
                        sh:message "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "The I2.11.3 obligation requires an explicit applicability branch."

.
