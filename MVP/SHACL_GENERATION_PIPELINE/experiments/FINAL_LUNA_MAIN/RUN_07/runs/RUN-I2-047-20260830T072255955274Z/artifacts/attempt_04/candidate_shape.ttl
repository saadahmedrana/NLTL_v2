@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-047_SteelRenewalIceStrengthened>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:sparql [
                sh:message "An ice-strengthened plating status activates the steel-renewal calculation." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasPlating ?plating .
                        ?plating nltl:iceStrengthenedStructureStatus true .
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:gaugedThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class qudt:QuantityValue ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:netThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class qudt:QuantityValue ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:steelRenewalRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For an ice-strengthened structure, steel renewal is true exactly when gauged thickness is less than net thickness plus 0.0005 m." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasPlating ?plating .
                        ?plating nltl:iceStrengthenedStructureStatus true .
                        $this nltl:gaugedThickness ?gauged .
                        ?gauged qudt:numericValue ?gaugedValue ;
                                qudt:unit unit:M .
                        $this nltl:netThickness ?net .
                        ?net qudt:numericValue ?netValue ;
                             qudt:unit unit:M .
                        $this nltl:steelRenewalRequired ?renewal .
                        FILTER (
                            (?gaugedValue < (?netValue + 0.0005) && ?renewal != true) ||
                            (?gaugedValue >= (?netValue + 0.0005) && ?renewal != false)
                        )
                    }
                """
            ]
        ]
    ) .
