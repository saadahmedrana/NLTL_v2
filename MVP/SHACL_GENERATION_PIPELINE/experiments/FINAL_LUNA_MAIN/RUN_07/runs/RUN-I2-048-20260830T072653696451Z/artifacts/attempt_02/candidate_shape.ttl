@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:i2-048-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase
    ] .

<urn:nltl:generated-shape:i2-048-case> a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel grade requirement case must identify exactly one plating." ;
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "Each steel grade requirement case must reference IACS UR I2 Table 8." ;
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue unit:MilliM ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:message "As-built plate thickness must be one decimal quantity in millimetres." ;
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
            nltl:normalStrengthHullStructuralSteel
            nltl:highStrengthHullStructuralSteel
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each case must state exactly one actual hull structural steel grade." ;
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
            nltl:normalStrengthHullStructuralSteel
            nltl:highStrengthHullStructuralSteel
        ) ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required steel grade must be the exact Table 8 grade for the case selectors and thickness band." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?mat ;
                      nltl:steelStrengthCategory ?cat .
                ?tv qudt:numericValue ?t .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                FILTER(?t > 0 && ?t <= 50)
                FILTER(
                    !(?cat = nltl:normalStrengthSteelCategory &&
                      ?mat = nltl:steelMaterialClassThree &&
                      ?t > 35 &&
                      (?pc IN (
                          nltl:polarClassPc1,
                          nltl:polarClassPc2,
                          nltl:polarClassPc3,
                          nltl:polarClassPc4,
                          nltl:polarClassPc5
                      )))
                )
                BIND(
                    IF(
                        ?cat = nltl:highTensileSteelCategory,
                        IF(
                            ?mat = nltl:steelMaterialClassOne,
                            IF(?t <= 10, nltl:steelGradeAh,
                                IF(?pc IN (
                                    nltl:polarClassPc1,
                                    nltl:polarClassPc2,
                                    nltl:polarClassPc3,
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ), nltl:steelGradeDh, nltl:steelGradeAh)),
                            IF(
                                ?mat = nltl:steelMaterialClassTwo,
                                IF(?t <= 10, nltl:steelGradeAh,
                                    IF(?t <= 25,
                                        IF(?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ), nltl:steelGradeDh, nltl:steelGradeAh),
                                        IF(?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ), nltl:steelGradeEh, nltl:steelGradeDh))),
                                IF(
                                    ?pc IN (
                                        nltl:polarClassPc1,
                                        nltl:polarClassPc2,
                                        nltl:polarClassPc3,
                                        nltl:polarClassPc4,
                                        nltl:polarClassPc5
                                    ),
                                    IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeFh),
                                    IF(?t <= 10, nltl:steelGradeAh,
                                        IF(?t <= 35, nltl:steelGradeDh, nltl:steelGradeEh))
                                )
                            )
                        ),
                        IF(
                            ?mat = nltl:steelMaterialClassOne,
                            IF(?t <= 15, nltl:steelGradeB,
                                IF(?t <= 35,
                                    IF(?pc IN (
                                        nltl:polarClassPc1,
                                        nltl:polarClassPc2,
                                        nltl:polarClassPc3,
                                        nltl:polarClassPc4,
                                        nltl:polarClassPc5
                                    ), nltl:steelGradeD, nltl:steelGradeB),
                                    IF(?pc IN (
                                        nltl:polarClassPc1,
                                        nltl:polarClassPc2,
                                        nltl:polarClassPc3,
                                        nltl:polarClassPc4,
                                        nltl:polarClassPc5
                                    ), nltl:steelGradeE, nltl:steelGradeD))),
                            IF(
                                ?mat = nltl:steelMaterialClassTwo,
                                IF(?t <= 10, nltl:steelGradeB,
                                    IF(?t <= 25,
                                        IF(?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ), nltl:steelGradeD, nltl:steelGradeB),
                                        IF(?pc IN (
                                            nltl:polarClassPc1,
                                            nltl:polarClassPc2,
                                            nltl:polarClassPc3,
                                            nltl:polarClassPc4,
                                            nltl:polarClassPc5
                                        ), nltl:steelGradeE, nltl:steelGradeD))),
                                IF(
                                    ?pc IN (
                                        nltl:polarClassPc1,
                                        nltl:polarClassPc2,
                                        nltl:polarClassPc3,
                                        nltl:polarClassPc4,
                                        nltl:polarClassPc5
                                    ),
                                    nltl:steelGradeE,
                                    IF(?t <= 10, nltl:steelGradeB,
                                        IF(?t <= 25, nltl:steelGradeD, nltl:steelGradeE))
                                )
                            )
                        )
                    )
                    AS ?expected
                )
                FILTER NOT EXISTS {
                    $this nltl:requiredHullStructuralSteelGrade ?req .
                    FILTER(?req = ?expected)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A NOT_APPLICABLE Table 8 selection must have no required steel grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass nltl:steelMaterialClassThree ;
                      nltl:steelStrengthCategory nltl:normalStrengthSteelCategory .
                ?tv qudt:numericValue ?t .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                FILTER(?t > 35 && ?t <= 50)
                FILTER(?pc IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3,
                    nltl:polarClassPc4,
                    nltl:polarClassPc5
                ))
                $this nltl:requiredHullStructuralSteelGrade ?req .
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The plate thickness must fall within the represented Table 8 range." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv .
                ?tv qudt:numericValue ?t .
                FILTER(?t <= 0 || ?t > 50)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual steel grade must have a family-scoped order rank at least as high as the required grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:requiredHullStructuralSteelGrade ?req ;
                      nltl:actualHullStructuralSteelGrade ?actual .
                FILTER NOT EXISTS {
                    ?req nltl:steelGradeOrderRank ?requiredRank .
                    ?actual nltl:steelGradeOrderRank ?actualRank .
                    FILTER(?actualRank >= ?requiredRank)
                }
            }
        """
    ] .
