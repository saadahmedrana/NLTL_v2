@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:i2-048-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one supported Polar Class."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:i2-048-case>
    ] .

<urn:nltl:generated-shape:i2-048-quantity> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:i2-048-case> a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must identify exactly one plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:node <urn:nltl:generated-shape:i2-048-quantity> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must provide exactly one supported steel material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must provide exactly one supported steel strength category."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must provide exactly one actual hull structural steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:message "An applicable table selection requires at most one required hull structural steel grade, while a non-applicable selection requires none."
    ] ;
    sh:sparql [
        sh:message "The required grade must be the exact Table 8 grade for the Polar Class, thickness, material class, and strength category; NOT_APPLICABLE selections must have no required grade, and the actual grade must meet the required rank within its strength family." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  ?this nltl:asBuiltPlateThickness/qudt:numericValue ?t ;
        nltl:steelMaterialClass ?mc ;
        nltl:steelStrengthCategory ?family ;
        nltl:actualHullStructuralSteelGrade ?actual .

  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .

  ?actual nltl:steelGradeOrderRank ?actualRank .

  BIND(
    (
      (?t >= 0 && ?t <= 10) ||
      (?t > 10 && ?t <= 15) ||
      (?t > 15 && ?t <= 20) ||
      (?t > 20 && ?t <= 25) ||
      (?t > 25 && ?t <= 30) ||
      (?t > 30 && ?t <= 35) ||
      (?t > 35 && ?t <= 40) ||
      (?t > 40 && ?t <= 45) ||
      (?t > 45 && ?t <= 50)
    )
    AS ?supportedThickness
  )

  BIND(
    (
      (?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
       ?mc = nltl:steelMaterialClassThree &&
       ?family = nltl:normalStrengthSteelCategory &&
       ?t > 35) ||
      (?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) &&
       ?mc = nltl:steelMaterialClassThree &&
       ?family = nltl:normalStrengthSteelCategory &&
       ?t > 45) ||
      (?pc IN (nltl:polarClassPc4, nltl:polarClassPc5) &&
       ?mc = nltl:steelMaterialClassThree &&
       ?family = nltl:normalStrengthSteelCategory &&
       ?t > 40)
    )
    AS ?notApplicable
  )

  BIND(
    IF(
      ?family = nltl:normalStrengthSteelCategory,
      IF(
        ?mc = nltl:steelMaterialClassOne,
        IF(
          ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
          IF(?t <= 10, nltl:steelGradeB,
             IF(?t <= 25, nltl:steelGradeD,
                IF(?t <= 45, nltl:steelGradeD, nltl:steelGradeE))),
          IF(?t <= 35, nltl:steelGradeB, nltl:steelGradeD)
        ),
        IF(
          ?mc = nltl:steelMaterialClassTwo,
          IF(
            ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
            IF(?t <= 10, nltl:steelGradeB,
               IF(?t <= 25, nltl:steelGradeD,
                  IF(?t <= 35, nltl:steelGradeE, nltl:steelGradeE))),
            IF(?t <= 25, nltl:steelGradeB,
               IF(?t <= 35, nltl:steelGradeD, nltl:steelGradeD))
          ),
          IF(
            ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
            IF(?t <= 10, nltl:steelGradeE,
               IF(?t <= 35, nltl:steelGradeE, ?this)),
            IF(?t <= 10, nltl:steelGradeB,
               IF(?t <= 25, nltl:steelGradeD, nltl:steelGradeE))
          )
        )
      ),
      IF(
        ?mc = nltl:steelMaterialClassOne,
        IF(
          ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
          IF(?t <= 10, nltl:steelGradeAh,
             IF(?t <= 25, nltl:steelGradeDh,
                IF(?t <= 45, nltl:steelGradeDh, nltl:steelGradeEh))),
          IF(?t <= 35, nltl:steelGradeAh, nltl:steelGradeDh)
        ),
        IF(
          ?mc = nltl:steelMaterialClassTwo,
          IF(
            ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
            IF(?t <= 10, nltl:steelGradeAh,
               IF(?t <= 25, nltl:steelGradeDh,
                  IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeEh))),
            IF(?t <= 25, nltl:steelGradeAh,
               IF(?t <= 35, nltl:steelGradeDh, nltl:steelGradeDh))
          ),
          IF(
            ?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3),
            IF(?t <= 10, nltl:steelGradeEh,
               IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeFh)),
            IF(
              ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5),
              IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeFh),
              IF(?t <= 10, nltl:steelGradeAh,
                 IF(?t <= 25, nltl:steelGradeDh,
                    IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeEh)))
            )
          )
        )
      )
    )
    AS ?expected
  )

  FILTER(
    !?supportedThickness ||
    (
      !?notApplicable &&
      (
        NOT EXISTS {
          ?this nltl:requiredHullStructuralSteelGrade ?required .
          FILTER(?required = ?expected)
        }
        ||
        EXISTS {
          ?this nltl:requiredHullStructuralSteelGrade ?required .
          FILTER(?required != ?expected)
        }
      )
    )
    ||
    (
      ?notApplicable &&
      EXISTS {
        ?this nltl:requiredHullStructuralSteelGrade ?required
      }
    )
  )

  FILTER(
    ?family = nltl:normalStrengthSteelCategory &&
    !?actual IN (
      nltl:steelGradeB,
      nltl:steelGradeD,
      nltl:steelGradeE
    )
    ||
    ?family = nltl:highTensileSteelCategory &&
    !?actual IN (
      nltl:steelGradeAh,
      nltl:steelGradeDh,
      nltl:steelGradeEh,
      nltl:steelGradeFh
    )
    ||
    EXISTS {
      ?this nltl:requiredHullStructuralSteelGrade ?required .
      ?required nltl:steelGradeOrderRank ?requiredRank .
      FILTER(?actualRank < ?requiredRank)
    }
  )
}
"""
    ] .
