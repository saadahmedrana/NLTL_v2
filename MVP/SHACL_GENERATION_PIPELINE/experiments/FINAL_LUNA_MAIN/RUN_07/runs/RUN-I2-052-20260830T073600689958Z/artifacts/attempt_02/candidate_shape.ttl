@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-052-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-052-CalculationCaseShape>
    ] ;
    sh:property [
        sh:path nltl:interpolatedValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify the interpolated result."
    ] .

<urn:nltl:generated-shape:I2-052-CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each calculation case must provide one longitudinal position from aft in metres."
    ] ;
    sh:property [
        sh:path nltl:interpolatedLongitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each calculation case must provide one dimensionless interpolated result."
    ] ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:node [
            sh:class nltl:interpolationPoint ;
            sh:property [
                sh:path nltl:interpolationPointCoordinate ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolationPointValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:interpolationPoint
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:interpolationPoint
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The calculation case must link distinct lower and upper interpolation points, place its input coordinate within their ordered coordinate interval, and place the interpolated result within the endpoint-value envelope." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT ?this
            WHERE {
                ?this nltl:hullGirderLongitudinalPositionFromAft ?xq .
                ?xq qudt:numericValue ?x .

                ?this nltl:interpolatedLongitudinalDistributionFactor ?rq .
                ?rq qudt:numericValue ?r .

                ?this nltl:interpolationLowerEndpoint ?lo .
                ?this nltl:interpolationUpperEndpoint ?up .
                ?this nltl:hasInterpolationPoint ?lo .
                ?this nltl:hasInterpolationPoint ?up .

                ?lo nltl:interpolationPointCoordinate ?lcq .
                ?lcq qudt:numericValue ?lx .
                ?lo nltl:interpolationPointValue ?lvq .
                ?lvq qudt:numericValue ?lv .

                ?up nltl:interpolationPointCoordinate ?ucq .
                ?ucq qudt:numericValue ?ux .
                ?up nltl:interpolationPointValue ?uvq .
                ?uvq qudt:numericValue ?uv .

                FILTER (
                    ?lo = ?up ||
                    ?lx >= ?ux ||
                    ?x < ?lx ||
                    ?x > ?ux ||
                    (
                        (?r < ?lv && ?r < ?uv) ||
                        (?r > ?lv && ?r > ?uv)
                    )
                )
            }
        """
    ] .
