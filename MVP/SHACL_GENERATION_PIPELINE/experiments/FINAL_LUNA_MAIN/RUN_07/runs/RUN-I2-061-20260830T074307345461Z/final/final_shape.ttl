@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-061-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:node [
            sh:property [
                sh:path nltl:calculationCaseAssessedHullStructure ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:hullStructure ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:thickness ;
                        sh:nodeKind sh:IRI ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:prescribedAnalyticalProcedure ;
                sh:message "An applicable calculation case shall use the prescribed analytical procedure rather than a direct calculation."
            ] ;
            sh:sparql [
                sh:message "A direct calculation method shall not be used for an applicable calculation case." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:calculationMethod
                              nltl:directCalculationMethodValue .
                    }
                """
            ]
        ]
    ] .
