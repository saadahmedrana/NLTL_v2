@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-064-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:yieldStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "A single-valued yield strength in MPa is required for the applicable linear calculation."
            ] ;
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-064-LinearCalculationCaseShape>
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-064-NonLinearCalculationCaseShape>
            ]
        ]
    ) ;
    sh:message "The calculation method must identify either an applicable linear calculation or an explicitly non-applicable alternative method." .

<urn:nltl:generated-shape:I2-064-LinearCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:hasValue nltl:linearCalculationMethodValue
        ] ;
        sh:message "The applicable calculation case must specify the linear calculation method."
    ] .

<urn:nltl:generated-shape:I2-064-NonLinearCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue nltl:nonlinearCalculationMethodValue
            ]
            [
                sh:hasValue nltl:prescribedAnalyticalProcedure
            ]
        ) ;
        sh:message "A non-linear or prescribed analytical calculation method must be explicitly identified when the linear rule is not applicable."
    ] .

<urn:nltl:generated-shape:I2-064-StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable buckling criteria must be confirmed for each represented structural member."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberWeb ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberWebShape>
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberFlange ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberFlangeShape>
    ] .

<urn:nltl:generated-shape:I2-064-StructuralMemberWebShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMemberWeb ;
    sh:property [
        sh:path nltl:nominalShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A single-valued nominal shear stress in MPa is required for each represented web."
    ] ;
    sh:sparql [
        sh:message "Nominal web shear stress must be less than yield strength divided by sqrt(3)." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    ?ship nltl:hasStructuralMember ?member .
    ?member nltl:hasStructuralMemberWeb $this .
    ?ship nltl:yieldStrength ?yieldQuantity .
    ?yieldQuantity qudt:numericValue ?yieldValue .
    $this nltl:nominalShearStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue .
    FILTER (?stressValue >= (?yieldValue / 1.7320508075688772))
}
"""
    ] .

<urn:nltl:generated-shape:I2-064-StructuralMemberFlangeShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMemberFlange ;
    sh:property [
        sh:path nltl:nominalFlangeVonMisesStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A single-valued nominal flange von Mises stress in MPa is required for each represented flange."
    ] ;
    sh:sparql [
        sh:message "Nominal flange von Mises stress must be less than 1.15 times yield strength." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    ?ship nltl:hasStructuralMember ?member .
    ?member nltl:hasStructuralMemberFlange $this .
    ?ship nltl:yieldStrength ?yieldQuantity .
    ?yieldQuantity qudt:numericValue ?yieldValue .
    $this nltl:nominalFlangeVonMisesStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue .
    FILTER (?stressValue >= (1.15 * ?yieldValue))
}
"""
    ] .
