@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:ComplexReadinessShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:nonlinearCalculationMethod ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:bucklingResponse ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:plasticDeformation ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:fractureMargin ;
        sh:node nltlg:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:majorBucklingMargin ;
        sh:node nltlg:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldingMargin ;
        sh:node nltlg:DimensionlessQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A nonlinear readiness record must identify a non-empty nonlinear calculation method, or a ship with readiness evidence must not omit that applicability selector." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    (
                        NOT EXISTS {
                            $this nltl:nonlinearCalculationMethod ?missingMethod
                        }
                        &&
                        (
                            EXISTS {
                                $this nltl:hasCalculationCase ?existingCase
                            }
                            ||
                            EXISTS {
                                $this nltl:bucklingResponse ?existingBuckling
                            }
                            ||
                            EXISTS {
                                $this nltl:plasticDeformation ?existingPlastic
                            }
                            ||
                            EXISTS {
                                $this nltl:fractureMargin ?existingFracture
                            }
                            ||
                            EXISTS {
                                $this nltl:majorBucklingMargin ?existingMajorBuckling
                            }
                            ||
                            EXISTS {
                                $this nltl:yieldingMargin ?existingYielding
                            }
                        )
                    )
                    ||
                    EXISTS {
                        $this nltl:nonlinearCalculationMethod ?emptyMethod .
                        FILTER (
                            datatype(?emptyMethod) = xsd:string &&
                            STRLEN(STR(?emptyMethod)) = 0
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When nonlinear calculation is applicable, the ship must provide buckling and plastic-deformation analysis indications, all required acceptance margins, and at least one calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:nonlinearCalculationMethod ?method .
                FILTER (
                    NOT EXISTS {
                        $this nltl:bucklingResponse ?buckling
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:plasticDeformation ?plastic
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:majorBucklingMargin ?majorBuckling
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasCalculationCase ?case
                    }
                )
            }
        """
    ] .

nltlg:NonlinearCalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:nonlinearCalculationMethodValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:node nltlg:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:node nltlg:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:node nltlg:LengthQuantityShape ;
        sh:minCount 1
    ] .
