@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-065-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:message "Each linked calculation case must be typed as a calculation case."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:nonlinearCalculationMethod ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An applicable nonlinear evaluation must identify the nonlinear calculation method."
            ] ;
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:class nltl:calculationCase ;
                sh:node <urn:nltl:generated-shape:I2-065-NonlinearCalculationCaseShape> ;
                sh:minCount 1 ;
                sh:message "An applicable nonlinear evaluation must provide a validated nonlinear calculation case."
            ] ;
            sh:property [
                sh:path nltl:bucklingResponse ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The applicable analysis must record reliable buckling capture."
            ] ;
            sh:property [
                sh:path nltl:plasticDeformation ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The applicable analysis must record reliable plastic-deformation capture."
            ] ;
            sh:property [
                sh:path nltl:fractureMargin ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-065-UnitlessQuantityShape> ;
                sh:message "An applicable nonlinear evaluation must provide a fracture margin."
            ] ;
            sh:property [
                sh:path nltl:majorBucklingMargin ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-065-UnitlessQuantityShape> ;
                sh:message "An applicable nonlinear evaluation must provide a major buckling margin."
            ] ;
            sh:property [
                sh:path nltl:yieldingMargin ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-065-UnitlessQuantityShape> ;
                sh:message "An applicable nonlinear evaluation must provide a yielding margin."
            ]
        ]
        [
            sh:property [
                sh:path nltl:nonlinearCalculationMethod ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:maxCount 0
            ]
        ]
    ) .

<urn:nltl:generated-shape:I2-065-NonlinearCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:nonlinearCalculationMethodValue ;
        sh:minCount 1 ;
        sh:message "The calculation case must explicitly identify the nonlinear calculation method."
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The nonlinear calculation case must provide acceptance evidence."
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The permanent deformation assessment must be explicitly recorded as satisfied."
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-065-MillimetreQuantityShape> ;
        sh:message "The calculation case must provide permanent lateral deformation."
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-065-MillimetreQuantityShape> ;
        sh:message "The calculation case must provide permanent out-of-plane deformation."
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-065-MillimetreQuantityShape> ;
        sh:message "The calculation case must provide the relevant structural dimension."
    ] .

<urn:nltl:generated-shape:I2-065-UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-065-MillimetreQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
