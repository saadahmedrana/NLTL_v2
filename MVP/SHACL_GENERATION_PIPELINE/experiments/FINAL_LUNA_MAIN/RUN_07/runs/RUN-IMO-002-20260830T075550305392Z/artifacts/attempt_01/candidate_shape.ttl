@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-002-ShipCategory>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ;
                sh:minCount 1 ;
                sh:message "A ship designed for at least thin first-year ice with possible old-ice inclusions shall have ship category B when it is not category A."
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB ;
                sh:minCount 1 ;
                sh:message "The ship category shall be B for the applicable design ice condition."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:in (
                    nltl:iceConditionLessSevereThanCategoryAAndB
                    nltl:iceFreeIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                    nltl:openWaterIceCondition
                    nltl:otherWatersIceCondition
                ) ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:message "The ship shall either be category B for the applicable thin first-year ice condition, be category A, or declare a different permitted design ice condition." .
