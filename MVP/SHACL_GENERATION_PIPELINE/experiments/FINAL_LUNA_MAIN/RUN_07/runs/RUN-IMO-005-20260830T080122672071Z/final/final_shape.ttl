@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-005> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:totalIcePresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When iceCondition is \"ice free waters\", totalIcePresent must be false and must not also be true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "ice free waters")
                FILTER (
                    NOT EXISTS {
                        $this nltl:totalIcePresent ?falseValue .
                        FILTER (?falseValue = false)
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIcePresent ?trueValue .
                        FILTER (?trueValue = true)
                    }
                )
            }
        """
    ] .
