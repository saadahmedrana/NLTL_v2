@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-007-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:iceConditionValue
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For open-water ice conditions, sea ice concentration must be less than 1 and ice of land origin must be absent." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER NOT EXISTS {
                    $this nltl:seaIceConcentration ?concentration .
                    ?concentration qudt:numericValue ?numericValue .
                    ?concentration qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (?numericValue < 1)
                }
                FILTER NOT EXISTS {
                    $this nltl:iceOfLandOriginPresent ?landOriginPresent .
                    FILTER (?landOriginPresent = "false"^^xsd:boolean)
                }
            }
        """
    ] .
