@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_008_ThinFirstYearIceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must specify its ice type classification."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.3"^^xsd:decimal ;
                sh:maxInclusive "0.7"^^xsd:decimal ;
                sh:message "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ice thickness must use the metre unit."
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:condition [
            sh:path nltl:iceTypeClassification ;
            sh:hasValue nltl:thinFirstYearIce
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:hasValue nltl:thinFirstYearIce ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "0.3"^^xsd:decimal ;
                        sh:maxInclusive "0.7"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:sparql [
                sh:message "This branch applies only when the ice type is not thin first-year ice." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceTypeClassification ?iceType .
                        FILTER (?iceType = nltl:thinFirstYearIce)
                    }
                """
            ]
        ]
    ) .
