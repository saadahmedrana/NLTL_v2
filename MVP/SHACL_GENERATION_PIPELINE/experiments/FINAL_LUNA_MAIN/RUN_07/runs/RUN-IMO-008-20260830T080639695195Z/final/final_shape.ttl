@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO008Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or ( gen:IMO008ThinFirstYearIceBranch gen:IMO008OtherIceBranch ) .

gen:IMO008ThinFirstYearIceBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:hasValue nltl:thinFirstYearIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice type classification must be thin first-year ice for this thickness range."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.3"^^xsd:decimal ;
                sh:maxInclusive "0.7"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive and use metres."
    ] .

gen:IMO008OtherIceBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:message "An ice type classification is required to determine whether the thin first-year ice thickness rule applies."
    ] ;
    sh:not [
        a sh:NodeShape ;
        sh:property [
            sh:path nltl:iceTypeClassification ;
            sh:hasValue nltl:thinFirstYearIce
        ]
    ] .
