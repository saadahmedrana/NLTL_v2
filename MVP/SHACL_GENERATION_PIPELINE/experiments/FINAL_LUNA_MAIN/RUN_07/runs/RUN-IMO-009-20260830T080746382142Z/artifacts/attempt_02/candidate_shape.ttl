@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-009> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "When iceCondition is bergy waters, land-origin ice concentration must be a single unitless decimal less than 1 and total ice concentration must be a single unitless decimal no greater than 1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition "bergy waters" .

                FILTER (
                    NOT EXISTS {
                        $this nltl:landOriginIceConcentration ?land
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?land1, ?land2 .
                        FILTER (?land1 != ?land2)
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?land .
                        FILTER NOT EXISTS {
                            ?land a qudt:QuantityValue ;
                                qudt:numericValue ?landValue ;
                                qudt:unit unit:UNITLESS .
                            FILTER (
                                datatype(?landValue) = xsd:decimal
                                && ?landValue < 1
                            )
                            FILTER NOT EXISTS {
                                ?land qudt:numericValue ?otherLandValue .
                                FILTER (?otherLandValue != ?landValue)
                            }
                            FILTER NOT EXISTS {
                                ?land qudt:unit ?otherLandUnit .
                                FILTER (?otherLandUnit != unit:UNITLESS)
                            }
                        }
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:totalIceConcentration ?total
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?total1, ?total2 .
                        FILTER (?total1 != ?total2)
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?total .
                        FILTER NOT EXISTS {
                            ?total a qudt:QuantityValue ;
                                qudt:numericValue ?totalValue ;
                                qudt:unit unit:UNITLESS .
                            FILTER (
                                datatype(?totalValue) = xsd:decimal
                                && ?totalValue <= 1
                            )
                            FILTER NOT EXISTS {
                                ?total qudt:numericValue ?otherTotalValue .
                                FILTER (?otherTotalValue != ?totalValue)
                            }
                            FILTER NOT EXISTS {
                                ?total qudt:unit ?otherTotalUnit .
                                FILTER (?otherTotalUnit != unit:UNITLESS)
                            }
                        }
                    }
                )
            }
        """
    ] .
