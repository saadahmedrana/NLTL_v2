@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-017-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The Polar Ship Certificate validity date is required and must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The Polar Ship Certificate survey date is required and must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The Polar Ship Certificate endorsement date is required and must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-PolarShipCertificateShape> ;
        sh:message "A Polar Ship Certificate record is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-SolasScheduleShape> ;
        sh:message "A SOLAS certificate schedule with certificate schedule date records is required."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-SupplementShape> ;
        sh:message "A Polar Certificate supplement with required equipment records is required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Certificate supplement presence indicator must be true."
    ] ;
    sh:sparql [
        sh:message "Each SOLAS certificate schedule date must match the corresponding Polar Ship Certificate date category." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDateType ?type ;
                        nltl:certificateScheduleDate ?date .
                FILTER (?type IN (
                    nltl:validityDateCategory,
                    nltl:surveyDateCategory,
                    nltl:endorsementDateCategory
                ))
                FILTER (
                    (?type = nltl:validityDateCategory &&
                     NOT EXISTS {
                         $this nltl:polarCertificateValidityDates ?date
                     })
                    ||
                    (?type = nltl:surveyDateCategory &&
                     NOT EXISTS {
                         $this nltl:surveyDates ?date
                     })
                    ||
                    (?type = nltl:endorsementDateCategory &&
                     NOT EXISTS {
                         $this nltl:endorsementDates ?date
                     })
                )
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-017-PolarShipCertificateShape> a sh:NodeShape .

<urn:nltl:generated-shape:IMO-017-SolasScheduleShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-DateRecordShape> ;
        sh:message "The SOLAS certificate schedule must contain certificate schedule date records."
    ] ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:certificateScheduleDateType ;
                sh:hasValue nltl:validityDateCategory
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A validity-date certificate schedule record is required."
    ] ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:certificateScheduleDateType ;
                sh:hasValue nltl:surveyDateCategory
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A survey-date certificate schedule record is required."
    ] ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:certificateScheduleDateType ;
                sh:hasValue nltl:endorsementDateCategory
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An endorsement-date certificate schedule record is required."
    ] .

<urn:nltl:generated-shape:IMO-017-DateRecordShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:message "Each certificate schedule date record must have one permitted date category."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Each certificate schedule date record must contain an xsd:date."
    ] .

<urn:nltl:generated-shape:IMO-017-SupplementShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "The Polar Certificate supplement must record required equipment."
    ] .
