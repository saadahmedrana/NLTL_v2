@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must state whether ice operation is applicable."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operation is applicable, the PWOM must include ice-operation monitoring and safety procedures."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:independentOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "Independent-operation limitations must be specified for independent polar operation."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Escort-operation requirements must be included when operation is conducted with icebreaker escort."
                    ] ;
                    sh:property [
                        sh:path nltl:escortedOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "Escorted-operation limitations must be specified for operation with icebreaker escort."
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:IMO-030> sh:message "When ice operation is applicable, the PWOM must specify the applicable operating-mode limitations and any applicable escort or icebreaker-assistance requirements." .
