@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_040_ApplicableShape
        gen:IMO_040_NotApplicableShape
    ) .

gen:IMO_040_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice accretion is likely, iceAccretionLikely must be true and every relevant hatch or door must have associated ice or snow removal or prevention means."
    ] ;
    sh:property [
        sh:path nltl:hasRelevantHatchOrDoor ;
        sh:node [
            sh:class nltl:relevantHatchOrDoorItem ;
            sh:class nltl:equipmentItem ;
            sh:property [
                sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:iceSnowRemovalOrPreventionMeans
                ] ;
                sh:message "Each relevant hatch or door must have an associated ice or snow removal or prevention means."
            ]
        ]
    ] .

gen:IMO_040_NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .
