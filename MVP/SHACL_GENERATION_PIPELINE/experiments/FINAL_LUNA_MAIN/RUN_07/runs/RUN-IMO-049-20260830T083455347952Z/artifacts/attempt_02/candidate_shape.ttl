@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-049-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:class nltl:machineryComponent ;
                sh:node <urn:nltl:generated-shape:IMO-049-CategoryABComponentShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:class nltl:machineryComponent ;
                sh:node <urn:nltl:generated-shape:IMO-049-CategoryABComponentShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:class nltl:machineryComponent ;
                sh:node <urn:nltl:generated-shape:IMO-049-CategoryCComponentShape>
            ]
        ]
    ) ;
    sh:message "The ship category and applicable machinery-component scantling approval evidence must conform to the applicable Polar Code branch." .

<urn:nltl:generated-shape:IMO-049-CategoryABComponentShape> a sh:NodeShape ;
    sh:class nltl:machineryComponent ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:class nltl:approvalRecord ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-049-CategoryABApprovalShape>
    ] ;
    sh:message "Each applicable machinery component must have approved scantling evidence from an authorized authority using an acceptable or equivalent-safety standard." .

<urn:nltl:generated-shape:IMO-049-CategoryABApprovalShape> a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue "Administration"^^xsd:string
            ]
            [
                sh:hasValue "recognized organization accepted by the Administration"^^xsd:string
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue "standard acceptable to the Organization"^^xsd:string
            ]
            [
                sh:hasValue "another standard offering an equivalent level of safety"^^xsd:string
            ]
        )
    ] .

<urn:nltl:generated-shape:IMO-049-CategoryCComponentShape> a sh:NodeShape ;
    sh:class nltl:machineryComponent ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:class nltl:approvalRecord ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-049-CategoryCApprovalShape>
    ] ;
    sh:message "Each applicable ice-strengthened category C machinery component must have approved scantling evidence addressing the operating ice type and concentration." .

<urn:nltl:generated-shape:IMO-049-CategoryCApprovalShape> a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue "Administration"^^xsd:string
            ]
            [
                sh:hasValue "recognized organization accepted by the Administration"^^xsd:string
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "acceptable standard adequate for operating ice type and concentration"^^xsd:string
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-049-IceConcentrationShape>
    ] .

<urn:nltl:generated-shape:IMO-049-IceConcentrationShape> a sh:NodeShape ;
    sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
