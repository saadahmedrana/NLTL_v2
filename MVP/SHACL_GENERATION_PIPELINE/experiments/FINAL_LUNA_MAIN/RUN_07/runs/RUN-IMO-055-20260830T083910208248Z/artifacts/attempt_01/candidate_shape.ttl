@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_055_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:not [
                    sh:in ( "isolating" "pressure" "vacuum" )
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:in ( "isolating" "pressure" "vacuum" )
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Exposed isolating, pressure, or vacuum valves must have ice accretion protection and remain continuously accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:valveExposed ?exposed .
                $this nltl:valveType ?type .
                FILTER (
                    ?exposed = true &&
                    ?type IN ("isolating", "pressure", "vacuum")
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceAccretionProtectionPresent ?protected .
                        FILTER (?protected = true)
                    } ||
                    NOT EXISTS {
                        $this nltl:continuouslyAccessible ?accessible .
                        FILTER (?accessible = true)
                    }
                )
            }
        """
    ] .
