@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO057ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gen:IMO057PumpLocationShape
    ] .

gen:IMO057PumpLocationShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must be assigned to a compartment maintained above 0 deg C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a ?pumpType .
                FILTER (
                    ?pumpType = nltl:firePump ||
                    ?pumpType = nltl:emergencyFirePump ||
                    ?pumpType = nltl:waterMistPump ||
                    ?pumpType = nltl:waterSprayPump
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasContainingCompartment ?anyCompartment .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasContainingCompartment ?compartment .
                        FILTER (
                            NOT EXISTS {
                                ?compartment nltl:maintainedTemperature ?temperature .
                            }
                            ||
                            EXISTS {
                                ?compartment nltl:maintainedTemperature ?temperature .
                                FILTER NOT EXISTS {
                                    ?temperature a qudt:QuantityValue ;
                                        qudt:unit unit:DEG_C ;
                                        qudt:numericValue ?value .
                                    FILTER (?value > 0)
                                }
                            }
                        )
                    }
                )
            }
        """
    ] .
