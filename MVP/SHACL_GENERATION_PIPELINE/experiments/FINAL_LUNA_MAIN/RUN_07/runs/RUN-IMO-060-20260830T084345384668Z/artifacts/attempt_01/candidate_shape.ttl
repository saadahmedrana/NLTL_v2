@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-060> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The fixed water system separation status must be provided as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The independent sea suction status must be provided as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:independentSeaSuctionUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:seaSuctionIceClearingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, the sea suction must be capable of being cleared of ice accumulation."
            ]
        ]
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:independentSeaSuctionUsed ;
                sh:hasValue false
            ]
        ]
    ) .
