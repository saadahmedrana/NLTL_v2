@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_060_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:seaSuctionIceClearingCapability ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, that suction must be capable of being cleared of ice accumulation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:fixedWaterSystemSeparateFromMainFirePumps ?fixedSystem .
                $this nltl:independentSeaSuctionUsed ?independentSuction .
                FILTER (
                    ?fixedSystem = true &&
                    ?independentSuction = true
                )
                FILTER NOT EXISTS {
                    $this nltl:seaSuctionIceClearingCapability true .
                }
            }
        """
    ] .
