@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_066_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The ship's ice-accretion exposure applicability must be recorded as false for this non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ship's ice-accretion exposure applicability must be recorded as true for this applicable branch."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:node gen:IMO_066_ProtectedItemShape ;
                sh:message "Every linked protected item must have its required ice or snow removal or prevention means."
            ]
        ]
    ) .

gen:IMO_066_ProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:in (
            nltl:escapeRouteProtectedItem
            nltl:musterStationProtectedItem
            nltl:embarkationAreaProtectedItem
            nltl:survivalCraftProtectedItem
            nltl:launchingApplianceProtectedItem
            nltl:survivalCraftAccessProtectedItem
        ) ;
        sh:minCount 1 ;
        sh:message "A protected item must identify one of the regulated escape, muster, embarkation, survival craft, launching appliance, or survival-craft access categories."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each regulated protected item must have associated ice or snow removal or prevention means."
    ] .
