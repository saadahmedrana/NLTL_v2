@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO070PassengerShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each applicable passenger ship shall have a true size compatibility status."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:node gs:IMO070PersonOnBoardMemberShape
    ] .

gs:IMO070PersonOnBoardMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO070AssignmentShape ;
        sh:message "Each person on board shall have exactly one personal survival equipment assignment."
    ] .

gs:IMO070AssignmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class nltl:immersionSuitEquipment ]
            [ sh:class nltl:thermalProtectiveAidEquipment ]
        ) ;
        sh:message "The assignment shall provide either a properly sized immersion suit or a thermal protective aid."
    ] .
