@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-083-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive true ;
                sh:maxInclusive true ;
                sh:message "Ice-accretion applicability must be recorded as true for this applicable branch."
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:minCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class nltl:navigationOrCommunicationAntenna ;
                    sh:property [
                        sh:path nltl:antennaIceAccumulationPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive true ;
                        sh:maxInclusive true ;
                        sh:message "Each required navigation or communication antenna must have ice-accumulation prevention means."
                    ]
                ]
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive false ;
                sh:maxInclusive false ;
                sh:message "Ice-accretion applicability must be recorded as false for this non-applicable branch."
            ]
        ]
    ) .
