@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_084_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:requiredSensorProjectsBelowHull ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:sensorIceProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When sensors project below the hull, the sensors must be protected against ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:requiredSensorProjectsBelowHull ?required .
                FILTER (DATATYPE(?required) = xsd:boolean && ?required = true)
                FILTER NOT EXISTS {
                    $this nltl:sensorIceProtectionPresent ?protected .
                    FILTER (DATATYPE(?protected) = xsd:boolean && ?protected = true)
                }
            }
        """
    ] .
