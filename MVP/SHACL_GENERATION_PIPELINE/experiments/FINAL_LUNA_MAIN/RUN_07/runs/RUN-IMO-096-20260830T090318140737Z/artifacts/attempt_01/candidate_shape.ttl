@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_096_TMASCapabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:telemedicalAssistanceServiceTwoWayVoiceCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each ship must provide two-way voice communication with a Telemedical Assistance Service (TMAS)." ;
    ] ;
    sh:property [
        sh:path nltl:telemedicalAssistanceServiceTwoWayDataCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each ship must provide two-way data communication with a Telemedical Assistance Service (TMAS)." ;
    ] .
