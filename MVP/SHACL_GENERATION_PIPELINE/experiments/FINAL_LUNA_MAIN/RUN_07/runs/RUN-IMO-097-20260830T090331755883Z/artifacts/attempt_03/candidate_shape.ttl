@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:minCount 1 ;
        sh:message "The ship must represent its lifeboat relationship."
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:minCount 1 ;
        sh:message "The ship must represent its other-survival-craft relationship."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
        sh:minCount 1 ;
        sh:message "The ship must represent its required rescue-boat or lifeboat relationship."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:minCount 1 ;
        sh:message "The ship must represent its survival-craft relationship."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-097-LowTemperatureApplicable>
        <urn:nltl:generated-shape:IMO-097-LowTemperatureNotApplicable>
    ) .

<urn:nltl:generated-shape:IMO-097-LowTemperatureApplicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:sparql [
        sh:message "Each released rescue boat or lifeboat represented by the declared lifeboat relationships must have the required distress-alert relationship, and each linked survival craft must have one ship-to-shore distress-alert device, one location-signal device, and one on-scene transmit/receive communication device." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasLifeboat ?lifeboat .
                $this nltl:hasRequiredRescueBoatOrLifeboat ?lifeboat .
                $this nltl:hasSurvivalCraft ?craft .
                FILTER (
                    NOT EXISTS {
                        ?lifeboat nltl:hasDistressAlertDevice ?distressDevice .
                    }
                    ||
                    NOT EXISTS {
                        ?craft nltl:survivalCraftHasShipToShoreDistressAlertDevice ?shipToShoreDevice .
                    }
                    ||
                    NOT EXISTS {
                        ?craft nltl:survivalCraftHasLocationSignalDevice ?locationDevice .
                    }
                    ||
                    NOT EXISTS {
                        ?craft nltl:survivalCraftHasOnSceneCommunicationDevice ?communicationDevice .
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-097-LowTemperatureNotApplicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .
