@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_097_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "The low-air-temperature applicability value must be a single boolean when provided."
    ] ;
    sh:property [
        sh:path nltl:releasedRescueBoatOrLifeboat ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "The released rescue boat or lifeboat applicability value must be a single boolean when provided."
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:class nltl:lifeboat ;
        sh:minCount 1 ;
        sh:message "The ship must identify its lifeboat relationship."
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft ;
        sh:minCount 1 ;
        sh:message "The ship must identify its other survival craft relationship."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
        sh:class nltl:lifeboat ;
        sh:minCount 1 ;
        sh:message "The ship must identify its required rescue boat or lifeboat relationship."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:class nltl:survivalCraft ;
        sh:minCount 1 ;
        sh:message "The ship must identify its survival craft relationship."
    ] .

gen:IMO_097_ApplicableSurvivalCraftTarget
    a sh:SPARQLTarget ;
    sh:select """
        PREFIX nltl: <https://w3id.org/nltl/vocab#>
        SELECT DISTINCT ?this
        WHERE {
            ?ship nltl:shipOperatesInLowAirTemperature true .
            ?ship nltl:releasedRescueBoatOrLifeboat true .
            ?ship nltl:hasSurvivalCraft ?this .
            ?ship (nltl:hasLifeboat|nltl:hasRequiredRescueBoatOrLifeboat) ?this .
        }
    """ .

gen:IMO_097_ApplicableSurvivalCraftShape
    a sh:NodeShape ;
    sh:target gen:IMO_097_ApplicableSurvivalCraftTarget ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:class nltl:locationSignalDevice ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one on-scene transmit/receive communication device."
    ] .
