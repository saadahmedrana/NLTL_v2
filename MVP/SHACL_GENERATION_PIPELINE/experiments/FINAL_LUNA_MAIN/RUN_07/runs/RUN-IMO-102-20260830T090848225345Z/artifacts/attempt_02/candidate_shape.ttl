@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceFreeIceCondition
            nltl:openWaterIceCondition
            nltl:otherWatersIceCondition
        ) ;
        sh:message "The ship must have exactly one controlled ice condition classification."
    ] ;
    sh:property [
        sh:path nltl:polarTrainingShipTypeClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:tankerPolarTrainingShipType
            nltl:passengerShipPolarTrainingShipType
            nltl:otherShipPolarTrainingType
        ) ;
        sh:message "The ship must have exactly one controlled polar training ship type."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node gen:CrewMemberShape
    ] .

gen:CrewMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarTrainingCrewRoleClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:masterPolarTrainingRole
            nltl:chiefMatePolarTrainingRole
            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
        ) ;
        sh:message "Each represented crew member must have exactly one controlled polar training role."
    ] ;
    sh:property [
        sh:path nltl:hasCrewTrainingRecord ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TrainingRecordShape ;
        sh:equals nltl:hasPolarTrainingRecord ;
        sh:message "Each crew member must link the same polar training record through the required training-record relationships."
    ] ;
    sh:property [
        sh:path nltl:hasPolarTrainingRecord ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TrainingRecordShape ;
        sh:equals nltl:hasCrewTrainingRecord ;
        sh:message "Each crew member must have a polar training record."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required training level must match the clause 12.3.1 ice-condition, ship-type, and crew-role matrix." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasCrewMemberInventory $this ;
        nltl:iceConditionClassification ?ice ;
        nltl:polarTrainingShipTypeClassification ?shipType .
  $this nltl:polarTrainingCrewRoleClassification ?role ;
        nltl:hasPolarTrainingRecord ?record .
  ?record nltl:requiredTrainingLevel ?required .
  FILTER (
    (?ice = nltl:iceFreeIceCondition &&
     ?required = nltl:polarTrainingNotApplicable)
    ||
    (?ice = nltl:openWaterIceCondition &&
     ?shipType = nltl:tankerPolarTrainingShipType &&
     (?role = nltl:masterPolarTrainingRole ||
      ?role = nltl:chiefMatePolarTrainingRole ||
      ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole) &&
     ?required = nltl:basicPolarTrainingLevel)
    ||
    (?ice = nltl:openWaterIceCondition &&
     ?shipType = nltl:passengerShipPolarTrainingShipType &&
     (?role = nltl:masterPolarTrainingRole ||
      ?role = nltl:chiefMatePolarTrainingRole ||
      ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole) &&
     ?required = nltl:basicPolarTrainingLevel)
    ||
    (?ice = nltl:openWaterIceCondition &&
     ?shipType = nltl:otherShipPolarTrainingType &&
     ?required = nltl:polarTrainingNotApplicable)
    ||
    (?ice = nltl:otherWatersIceCondition &&
     (?shipType = nltl:tankerPolarTrainingShipType ||
      ?shipType = nltl:passengerShipPolarTrainingShipType ||
      ?shipType = nltl:otherShipPolarTrainingType) &&
     (?role = nltl:masterPolarTrainingRole ||
      ?role = nltl:chiefMatePolarTrainingRole) &&
     ?required = nltl:advancedPolarTrainingLevel)
    ||
    (?ice = nltl:otherWatersIceCondition &&
     (?shipType = nltl:tankerPolarTrainingShipType ||
      ?shipType = nltl:passengerShipPolarTrainingShipType ||
      ?shipType = nltl:otherShipPolarTrainingType) &&
     ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
     ?required = nltl:basicPolarTrainingLevel)
  )
  FILTER ( ! (
    (?ice = nltl:iceFreeIceCondition &&
     ?required = nltl:polarTrainingNotApplicable)
    ||
    (?ice = nltl:openWaterIceCondition &&
     ?shipType = nltl:tankerPolarTrainingShipType &&
     ?required = nltl:basicPolarTrainingLevel)
    ||
    (?ice = nltl:openWaterIceCondition &&
     ?shipType = nltl:passengerShipPolarTrainingShipType &&
     ?required = nltl:basicPolarTrainingLevel)
    ||
    (?ice = nltl:openWaterIceCondition &&
     ?shipType = nltl:otherShipPolarTrainingType &&
     ?required = nltl:polarTrainingNotApplicable)
    ||
    (?ice = nltl:otherWatersIceCondition &&
     (?shipType = nltl:tankerPolarTrainingShipType ||
      ?shipType = nltl:passengerShipPolarTrainingShipType ||
      ?shipType = nltl:otherShipPolarTrainingType) &&
     (?role = nltl:masterPolarTrainingRole ||
      ?role = nltl:chiefMatePolarTrainingRole) &&
     ?required = nltl:advancedPolarTrainingLevel)
    ||
    (?ice = nltl:otherWatersIceCondition &&
     (?shipType = nltl:tankerPolarTrainingShipType ||
      ?shipType = nltl:passengerShipPolarTrainingShipType ||
      ?shipType = nltl:otherShipPolarTrainingType) &&
     ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
     ?required = nltl:basicPolarTrainingLevel)
  ) )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable crew member must have a valid STCW qualification for the required Basic or Advanced polar training level." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasCrewMemberInventory $this ;
        nltl:iceConditionClassification ?ice ;
        nltl:polarTrainingShipTypeClassification ?shipType .
  $this nltl:polarTrainingCrewRoleClassification ?role ;
        nltl:hasPolarTrainingRecord ?record .
  ?record nltl:requiredTrainingLevel ?required .
  FILTER (
    (?ice = nltl:openWaterIceCondition &&
     (?shipType = nltl:tankerPolarTrainingShipType ||
      ?shipType = nltl:passengerShipPolarTrainingShipType) &&
     (?role = nltl:masterPolarTrainingRole ||
      ?role = nltl:chiefMatePolarTrainingRole ||
      ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole) &&
     ?required = nltl:basicPolarTrainingLevel)
    ||
    (?ice = nltl:otherWatersIceCondition &&
     (?role = nltl:masterPolarTrainingRole ||
      ?role = nltl:chiefMatePolarTrainingRole) &&
     ?required = nltl:advancedPolarTrainingLevel)
    ||
    (?ice = nltl:otherWatersIceCondition &&
     ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
     ?required = nltl:basicPolarTrainingLevel)
  )
  FILTER NOT EXISTS {
    ?record nltl:stcwQualificationValid true
  }
}
"""
    ] .

gen:TrainingRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:requiredTrainingLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:basicPolarTrainingLevel
            nltl:advancedPolarTrainingLevel
            nltl:polarTrainingNotApplicable
        ) ;
        sh:message "The training record must specify exactly one controlled required training level."
    ] ;
    sh:property [
        sh:path nltl:trainingRecordLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:basicPolarTrainingLevel
            nltl:advancedPolarTrainingLevel
            nltl:polarTrainingNotApplicable
        ) ;
        sh:equals nltl:requiredTrainingLevel ;
        sh:message "The recorded training level must equal the required training level."
    ] ;
    sh:property [
        sh:path nltl:stcwQualificationValid ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Any recorded STCW qualification status must be a single boolean value."
    ] .
