@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-104-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record completed PWOM familiarization."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape>
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each crew member's assigned-duty PWOM procedures and equipment must be represented in a familiarization record." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this (nltl:hasCrewMemberInventory|nltl:hasCrewMember) ?crew .
                ?crew nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    ?crew nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-104-CrewMemberShape>
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-104-AssignedDutyShape> ;
        sh:message "Each crew member must have an assigned duty."
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-104-FamiliarizationRecordShape> ;
        sh:message "Each crew member must have a PWOM familiarization record."
    ] .

<urn:nltl:generated-shape:IMO-104-AssignedDutyShape>
    a sh:NodeShape ;
    sh:class nltl:assignedDuty ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "Each assigned duty must identify relevant PWOM procedures or equipment."
    ] .

<urn:nltl:generated-shape:IMO-104-FamiliarizationRecordShape>
    a sh:NodeShape ;
    sh:class nltl:familiarizationRecord ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "A familiarization record must identify the relevant PWOM procedures or equipment covered."
    ] .
