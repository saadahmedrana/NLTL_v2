@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-111> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship category must be Category A or Category B."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one valid construction date."
    ] ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The tank type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For an applicable Category A or B ship constructed on or after 1 January 2017, every oil-residue or oily-bilge-water holding tank with capacity greater than 30 m3 must have at least 0.76 m separation from the outer shell." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:shipCategory ?category .
  $this nltl:constructionDate ?constructionDate .
  $this nltl:tankType ?tankType .
  FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
  FILTER (
    YEAR(?constructionDate) > 2017 ||
    (YEAR(?constructionDate) = 2017 && MONTH(?constructionDate) > 1) ||
    (YEAR(?constructionDate) = 2017 && MONTH(?constructionDate) = 1 && DAY(?constructionDate) >= 1)
  )
  FILTER (
    ?tankType = "oil_residue_tank"^^xsd:string ||
    ?tankType = "oily_bilge_water_holding_tank"^^xsd:string
  )
  $this nltl:individualTankCapacity ?capacityQuantity .
  ?capacityQuantity qudt:numericValue ?capacityValue ;
                    qudt:unit unit:M3 .
  FILTER (?capacityValue > 30)
  FILTER NOT EXISTS {
    $this nltl:tankOuterShellSeparation ?separationQuantity .
    ?separationQuantity qudt:numericValue ?separationValue ;
                         qudt:unit unit:M .
    FILTER (?separationValue >= 0.76)
  }
}
"""
    ] .
