@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-113> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:cargoRecordBookPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "When the ship operates in polar waters, Cargo Record Book polar coverage shall be present."
            ] ;
            sh:property [
                sh:path nltl:manualPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "When the ship operates in polar waters, Manual polar coverage shall be present."
            ] ;
            sh:property [
                sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "When the ship operates in polar waters, polar coverage shall be present in the applicable noxious liquid substance or marine pollution emergency plan."
            ]
        ]
    ) .
