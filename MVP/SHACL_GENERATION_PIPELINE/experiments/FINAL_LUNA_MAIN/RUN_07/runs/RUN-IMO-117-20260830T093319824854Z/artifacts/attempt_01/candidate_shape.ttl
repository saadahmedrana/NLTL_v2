@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:IMO117ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlg:IMO117ApplicableShipBranch
        nltlg:IMO117NonApplicableShipBranch
    ) .

nltlg:IMO117NonApplicableShipBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The treatment-plant applicability indicator must be false for the non-applicable branch."
    ] .

nltlg:IMO117ApplicableShipBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:sewageTreatmentPlantApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "An applicable sewage treatment plant must have approved status."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable ships must provide the MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status."
    ] ;
    sh:property [
        sh:path nltl:marpolDischargeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Applicable sewage discharge must comply with MARPOL Annex IV regulation 11.1.2."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:node nltlg:IMO117DischargeDistanceRecordShape ;
        sh:minCount 1 ;
        sh:message "An applicable ship must record its discharge-distance information."
    ] .

nltlg:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node nltlg:IMO117NauticalMileQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each discharge-distance record must record the distance to the nearest land, ice shelf, or fast ice."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:node nltlg:IMO117NauticalMileQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each discharge-distance record must record the distance to an area with ice concentration greater than one tenth."
    ] .

nltlg:IMO117NauticalMileQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .
