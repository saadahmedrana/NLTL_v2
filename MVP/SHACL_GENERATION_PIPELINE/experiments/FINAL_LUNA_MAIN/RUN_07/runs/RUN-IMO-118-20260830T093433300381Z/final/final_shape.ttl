@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-118> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine sewage-discharge applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2017-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                sh:minCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:sewageDischargeToSea ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue nltl:passengerShip ;
                sh:minCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:sewageDischargeToSea ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For a Category A or B ship, or a passenger ship, constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with Polar Code paragraph 4.2.1.3 is true." .
