@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO123ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:residueNotRecoverableByCommonMethods ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record that the cargo residue is not recoverable by common methods."
    ] ;
    sh:property [
        sh:path nltl:shipEnRoute ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must be en route."
    ] ;
    sh:property [
        sh:path nltl:harmfulSubstancePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The cargo residues, cleaning agents, or additives must not include substances harmful to the marine environment."
    ] ;
    sh:property [
        sh:path nltl:departureAndDestinationWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The departure and destination ports must be within Arctic waters."
    ] ;
    sh:property [
        sh:path nltl:routeRemainsWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The route must remain within Arctic waters."
    ] ;
    sh:property [
        sh:path nltl:adequateReceptionFacilitiesAvailable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "No adequate reception facilities may be available at the applicable ports."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:minCount 1 ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gs:IMO123DischargeDistanceRecordShape ;
        sh:message "At least one discharge-distance record is required."
    ] .

gs:IMO123DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:targetClass nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO123NearestDistanceQuantityShape ;
        sh:message "The discharge record must state a distance of at least 12 nautical miles from the nearest land, ice shelf, or fast ice."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO123IceConcentrationAreaDistanceQuantityShape ;
        sh:message "The discharge record must state the distance from an area with ice concentration greater than one tenth."
    ] .

gs:IMO123NearestDistanceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 12
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .

gs:IMO123IceConcentrationAreaDistanceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .
