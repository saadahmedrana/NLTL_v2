@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion applicability must be recorded as a boolean."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ice accretion is likely, every required navigation or communication antenna must have ice accumulation prevention." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRequiredNavigationOrCommunicationAntenna ?antenna .
                FILTER NOT EXISTS {
                    ?antenna nltl:antennaIceAccumulationPreventionPresent ?value .
                    FILTER (
                        datatype(?value) = xsd:boolean &&
                        ?value = true
                    )
                }
            }
        """
    ] .
