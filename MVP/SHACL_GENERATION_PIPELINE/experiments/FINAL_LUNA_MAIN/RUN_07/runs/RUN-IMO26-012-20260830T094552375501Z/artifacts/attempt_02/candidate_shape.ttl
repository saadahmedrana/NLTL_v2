@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-012-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:node [
            sh:class nltl:nonMagneticHeadingMeans ;
            sh:nodeKind sh:IRI
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships of at least 500 gross tonnage shall have at least two distinct non-magnetic heading means, each connected to main and emergency power and independent from another heading means on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?grossQuantity .
                ?grossQuantity qudt:numericValue ?grossTonnage .
                FILTER (?grossTonnage >= 500)

                FILTER NOT EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?means1 .
                    $this nltl:hasNonMagneticHeadingMeans ?means2 .
                    FILTER (?means1 != ?means2)
                }

                FILTER EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?means .
                    FILTER NOT EXISTS {
                        ?means nltl:connectedToMainPower ?mainPower .
                        ?mainPower a nltl:benchmarkEntity .
                    }
                }

                FILTER EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?means .
                    FILTER NOT EXISTS {
                        ?means nltl:connectedToEmergencyPower ?emergencyPower .
                        ?emergencyPower a nltl:benchmarkEntity .
                    }
                }

                FILTER EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?means .
                    FILTER NOT EXISTS {
                        ?means nltl:independentFromHeadingMeans ?otherMeans .
                        FILTER (?otherMeans != ?means)
                        FILTER EXISTS {
                            $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                        }
                    }
                }
            }
        """
    ] .
