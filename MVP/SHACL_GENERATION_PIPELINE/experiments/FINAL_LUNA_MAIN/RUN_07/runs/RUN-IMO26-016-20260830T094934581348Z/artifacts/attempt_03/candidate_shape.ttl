@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's polar-waters operating status is required."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 11-1 applicability must be recorded."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ship type is required to determine Chapter 11-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Chapter 11-1 applicability must be true exactly for polar-waters ships meeting one of the specified type and threshold alternatives, and false otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?polar ;
                      nltl:polarCodeChapter11Dash1Applicable ?app .

                FILTER (
                    (
                        ?polar = true &&
                        ?app = true &&
                        NOT EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" ;
                                      nltl:lengthOverall ?lengthNode .
                                ?lengthNode qudt:numericValue ?lengthValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (?lengthValue >= 24)
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" ;
                                      nltl:grossTonnage ?tonnageNode ;
                                      nltl:engagedInTrade false .
                                ?tonnageNode qudt:numericValue ?tonnageValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300)
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" ;
                                      nltl:grossTonnage ?cargoTonnageNode .
                                ?cargoTonnageNode qudt:numericValue ?cargoTonnageValue ;
                                                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?cargoTonnageValue >= 300 && ?cargoTonnageValue < 500)
                            }
                        }
                    )
                    ||
                    (
                        ?polar = true &&
                        ?app != true &&
                        EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" ;
                                      nltl:lengthOverall ?lengthNode .
                                ?lengthNode qudt:numericValue ?lengthValue ;
                                            qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (?lengthValue >= 24)
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" ;
                                      nltl:grossTonnage ?tonnageNode ;
                                      nltl:engagedInTrade false .
                                ?tonnageNode qudt:numericValue ?tonnageValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300)
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" ;
                                      nltl:grossTonnage ?cargoTonnageNode .
                                ?cargoTonnageNode qudt:numericValue ?cargoTonnageValue ;
                                                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?cargoTonnageValue >= 300 && ?cargoTonnageValue < 500)
                            }
                        }
                    )
                    ||
                    (
                        ?polar != true &&
                        ?app = true
                    )
                )
            }
        """
    ] .
