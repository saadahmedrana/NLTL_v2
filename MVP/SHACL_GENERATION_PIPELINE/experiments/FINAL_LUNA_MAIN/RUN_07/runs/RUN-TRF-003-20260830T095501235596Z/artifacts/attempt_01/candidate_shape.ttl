@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF003> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A ship must provide its construction contract date to determine applicability of the 2010 Ice Class Regulations."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF003-applicable>
        <urn:nltl:generated-shape:TRF003-not-applicable>
    ) .

<urn:nltl:generated-shape:TRF003-applicable> a sh:NodeShape ;
    sh:sparql [
        sh:message "For a ship contracted for construction from 1 January 2012 up to but not including 1 January 2019, the 2010 Ice Class Regulations must apply." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:constructionContractDate ?date .
                    FILTER (
                        ?date < "2012-01-01"^^xsd:date ||
                        ?date >= "2019-01-01"^^xsd:date
                    )
                }
            }
        """
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:minCount 1 ;
        sh:in (
            nltl:iceClassRegulationEdition2010
        ) ;
        sh:message "The applicable Ice Class Regulation edition must be the 2010 edition."
    ] .

<urn:nltl:generated-shape:TRF003-not-applicable> a sh:NodeShape ;
    sh:sparql [
        sh:message "The ship's construction contract date must be outside the applicability period of the 2010 Ice Class Regulations for this non-applicable branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:constructionContractDate ?date .
                    FILTER (
                        ?date >= "2012-01-01"^^xsd:date &&
                        ?date < "2019-01-01"^^xsd:date
                    )
                }
            }
        """
    ] .
