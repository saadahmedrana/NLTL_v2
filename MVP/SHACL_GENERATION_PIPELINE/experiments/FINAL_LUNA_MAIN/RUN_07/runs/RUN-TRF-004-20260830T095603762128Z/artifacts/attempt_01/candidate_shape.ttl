@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF004Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine applicability of the 2008 Ice Class Regulations."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship contracted for construction on or after 1 January 2010 but before 1 January 2012, the applicable Ice Class regulation edition must be the 2008 edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    (
                        YEAR(?date) > 2010 ||
                        (YEAR(?date) = 2010 &&
                         (MONTH(?date) > 1 ||
                          (MONTH(?date) = 1 && DAY(?date) >= 1)))
                    )
                    &&
                    (
                        YEAR(?date) < 2012 ||
                        (YEAR(?date) = 2012 &&
                         (MONTH(?date) < 1 ||
                          (MONTH(?date) = 1 && DAY(?date) < 1)))
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                          nltl:iceClassRegulationEdition2008 .
                }
            }
        """
    ] .
