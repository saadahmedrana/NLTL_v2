@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "1986-11-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Construction stage date must be before 1986-11-01 for the non-applicable cohort."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2003-09-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Construction stage date must be on or after 2003-09-01 for the non-applicable cohort."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Construction stage date must identify the 1986-11-01 through 2003-08-31 cohort."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:message "Ships in the applicable cohort must use the 1985 ice-class rule edition."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The owner-request selector must be true when the 2008 engine-output edition is used."
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:iceClassRegulationEdition2008 ;
                        sh:minCount 1 ;
                        sh:message "A true owner request requires the 2008 engine-output regulation edition."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The owner-request selector must be false when the 1985 engine-output edition is used."
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:iceClassRuleEdition1985 ;
                        sh:minCount 1 ;
                        sh:message "Without an owner request, the engine-output regulation edition must remain the 1985 edition."
                    ]
                ]
            )
        ]
    ) .
