@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF006Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction-stage date is required to determine the applicable ice-class regulation cohort."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one canonical ice-class value."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide one maximum continuous rating power in kilowatts."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:or (
                    [
                        sh:maxExclusive "1986-11-01"^^xsd:date
                    ]
                    [
                        sh:minInclusive "2003-09-01"^^xsd:date
                    ]
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The owner-request selector must be explicitly false for the 1985 engine-output branch."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:engineOutputRegulationEdition ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The owner-request selector must be explicitly true for the 2008 engine-output branch."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:engineOutputRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2008 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:message "The ship must satisfy the applicable construction-stage and owner-request ice-class edition branch." .
