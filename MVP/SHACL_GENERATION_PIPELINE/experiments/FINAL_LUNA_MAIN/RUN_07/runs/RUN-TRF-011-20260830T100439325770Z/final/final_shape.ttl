@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF011ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape
    ] ;
    sh:sparql [
        sh:message "The upper ice waterline must contain exactly the envelope of the highest intended ice-operating waterline points at every longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  {
    SELECT $this ?position
           (MAX(?intendedVertical) AS ?expectedVertical)
           (MIN(?upperVertical) AS ?upperMinimum)
           (MAX(?upperVertical) AS ?upperMaximum)
    WHERE {
      {
        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                        nltl:verticalCoordinate ?intendedVerticalValue .
        ?intendedPositionValue qudt:numericValue ?position ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
        ?intendedVerticalValue qudt:numericValue ?intendedVertical ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          DATATYPE(?position) = xsd:decimal &&
          DATATYPE(?intendedVertical) = xsd:decimal
        )
      }
      UNION
      {
        $this nltl:hasUpperIceWaterline ?upperWaterline .
        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperPositionValue ;
                    nltl:verticalCoordinate ?upperVerticalValue .
        ?upperPositionValue qudt:numericValue ?position ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
        ?upperVerticalValue qudt:numericValue ?upperVertical ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          DATATYPE(?position) = xsd:decimal &&
          DATATYPE(?upperVertical) = xsd:decimal
        )
      }
    }
    GROUP BY $this ?position
  }
  BIND(
    ABS(?expectedVertical) * 0.000001 + 0.000000001
    AS ?tolerance
  )
  FILTER (
    !BOUND(?expectedVertical) ||
    !BOUND(?upperMinimum) ||
    !BOUND(?upperMaximum) ||
    ?upperMinimum < (?expectedVertical - ?tolerance) ||
    ?upperMaximum > (?expectedVertical + ?tolerance)
  )
}
"""
    ] .

gen:TRF011IceWaterlineShape
    a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node gen:TRF011ProfilePointShape
    ] .

gen:TRF011ProfilePointShape
    a sh:NodeShape ;
    sh:class nltl:waterlineProfilePoint ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF011LongitudinalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF011VerticalQuantityShape
    ] .

gen:TRF011LongitudinalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF011VerticalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
