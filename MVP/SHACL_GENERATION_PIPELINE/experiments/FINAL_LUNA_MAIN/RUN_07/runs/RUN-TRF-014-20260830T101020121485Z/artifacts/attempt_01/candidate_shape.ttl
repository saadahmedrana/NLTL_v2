@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-014-QuantityValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-014-ClassCertificateShape>
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-014-IceDraughtRestrictionDocumentShape>
    a sh:NodeShape ;
    sh:class nltl:iceDraughtRestrictionDocument .

<urn:nltl:generated-shape:TRF-014-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node <urn:nltl:generated-shape:TRF-014-ClassCertificateShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node <urn:nltl:generated-shape:TRF-014-IceDraughtRestrictionDocumentShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node <urn:nltl:generated-shape:TRF-014-QuantityValueShape> ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required ice-class marking evidence is missing or inconsistent with the construction date, assessment date, and draught condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:assessmentDate ?assessment .
                $this nltl:constructionDate ?construction .
                $this nltl:summerLoadLineFreshWaterDraught ?summerNode .
                $this nltl:upperIceWaterlineDraught ?upperNode .
                ?summerNode qudt:numericValue ?summer .
                ?upperNode qudt:numericValue ?upper .
                FILTER (
                    (
                        ?construction >= "2007-07-01"^^xsd:date &&
                        ?summer > ?upper &&
                        !EXISTS {
                            $this nltl:warningTrianglePresent true .
                            $this nltl:iceClassDraughtMarkPresent true .
                            $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                            ?markNode qudt:numericValue ?markValue .
                            ?markNode qudt:unit <http://qudt.org/vocab/unit/M> .
                            $this nltl:hasClassCertificate ?certificate .
                            ?certificate nltl:maximumIceClassDraughtAmidships ?certificateNode .
                            ?certificateNode qudt:numericValue ?certificateValue .
                            ?certificateNode qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (?markValue = ?certificateValue)
                        }
                    )
                    ||
                    (
                        ?construction < "2007-07-01"^^xsd:date &&
                        !EXISTS {
                            $this nltl:warningTrianglePresent true .
                            $this nltl:iceClassDraughtMarkPresent true .
                            $this nltl:iceClassDraughtMarkDraughtAmidships ?markNode2 .
                            ?markNode2 qudt:numericValue ?markValue2 .
                            ?markNode2 qudt:unit <http://qudt.org/vocab/unit/M> .
                            $this nltl:hasClassCertificate ?certificate2 .
                            ?certificate2 nltl:maximumIceClassDraughtAmidships ?certificateNode2 .
                            ?certificateNode2 qudt:numericValue ?certificateValue2 .
                            ?certificateNode2 qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (?markValue2 = ?certificateValue2)
                        } &&
                        (
                            !EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?firstDocking .
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?firstDockingAfter .
                                FILTER (?firstDockingAfter > ?assessment)
                            }
                        )
                    )
                )
            }
        """
    ] .
