@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-014> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node [
            sh:class nltl:classCertificate ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtFore ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtFore ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node [
            sh:class nltl:iceDraughtRestrictionDocument
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-014-LengthQuantity>
    ] ;
    sh:sparql [
        sh:message "When the applicable ice-draught marking condition is reached, complete marking evidence is required; for a pre-2007 ship without complete marking, the first scheduled dry docking date is required and the marking is due when that date is on or before the assessment date." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:constructionDate ?construction ;
          nltl:assessmentDate ?assessment ;
          nltl:summerLoadLineFreshWaterDraught ?summerNode ;
          nltl:upperIceWaterlineDraught ?uiwlNode .
    ?summerNode qudt:numericValue ?summerValue .
    ?uiwlNode qudt:numericValue ?uiwlValue .
    FILTER (
        (
            ?construction >= "2007-07-01"^^xsd:date &&
            ?summerValue > ?uiwlValue &&
            NOT EXISTS {
                $this nltl:warningTrianglePresent true ;
                      nltl:iceClassDraughtMarkPresent true ;
                      nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                ?markNode qudt:numericValue ?markValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?markValue) = xsd:decimal)
            }
        )
        ||
        (
            ?construction < "2007-07-01"^^xsd:date &&
            ?summerValue > ?uiwlValue &&
            NOT EXISTS {
                $this nltl:warningTrianglePresent true ;
                      nltl:iceClassDraughtMarkPresent true ;
                      nltl:iceClassDraughtMarkDraughtAmidships ?preMarkNode .
                ?preMarkNode qudt:numericValue ?preMarkValue ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?preMarkValue) = xsd:decimal)
            } &&
            (
                NOT EXISTS {
                    $this nltl:firstScheduledDryDockingDate ?docking
                }
                ||
                EXISTS {
                    $this nltl:firstScheduledDryDockingDate ?dueDate .
                    FILTER (?dueDate <= ?assessment)
                }
            )
        )
    )
}
"""
    ] .

<urn:nltl:generated-shape:TRF-014-LengthQuantity> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
