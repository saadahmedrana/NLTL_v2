@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_017_Static>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionOutputRestrictionApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propulsionMachineryContinuousOutput ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:additionalPropulsionPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloW ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When propulsion output is restricted, the restricted output and maximum continuous rating must equal machinery output plus additional propulsion power within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies true ;
                      nltl:maximumContinuousRatingPower ?maxNode ;
                      nltl:propulsionMachineryContinuousOutput ?machNode ;
                      nltl:additionalPropulsionPower ?addNode ;
                      nltl:restrictedPropulsionOutput ?restrictedNode .
                ?maxNode qudt:numericValue ?max .
                ?machNode qudt:numericValue ?mach .
                ?addNode qudt:numericValue ?add .
                ?restrictedNode qudt:numericValue ?restricted .
                BIND((?mach + ?add) AS ?expected)
                BIND((ABS(?expected) * 0.000001 + 0.000001) AS ?tolerance)
                FILTER(
                    (?max >= (?expected - ?tolerance)) &&
                    (?max <= (?expected + ?tolerance)) &&
                    (?restricted >= (?expected - ?tolerance)) &&
                    (?restricted <= (?expected + ?tolerance))
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When propulsion output is unrestricted, the maximum continuous rating must equal machinery output plus additional propulsion power within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies false ;
                      nltl:maximumContinuousRatingPower ?maxNode ;
                      nltl:propulsionMachineryContinuousOutput ?machNode ;
                      nltl:additionalPropulsionPower ?addNode .
                ?maxNode qudt:numericValue ?max .
                ?machNode qudt:numericValue ?mach .
                ?addNode qudt:numericValue ?add .
                BIND((?mach + ?add) AS ?expected)
                BIND((ABS(?expected) * 0.000001 + 0.000001) AS ?tolerance)
                FILTER(
                    (?max < (?expected - ?tolerance)) ||
                    (?max > (?expected + ?tolerance))
                )
            }
        """
    ] .
