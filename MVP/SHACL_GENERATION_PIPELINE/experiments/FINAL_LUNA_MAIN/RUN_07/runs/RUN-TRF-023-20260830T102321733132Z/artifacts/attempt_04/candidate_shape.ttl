@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-023> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For a ship with ice class IB or IC under the 1985 ice class rules, maximum continuous rating power must be present exactly once in kW and be at least the required power under the 1985 rules, which must also be present exactly once in kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                $this nltl:applicableIceClassRegulationEdition
                    nltl:iceClassRuleEdition1985 .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcr .
                        $this nltl:requiredPowerUnder1985Rules ?required .
                        ?mcr qudt:numericValue ?mcrValue .
                        ?mcr qudt:unit qudt:KiloW .
                        ?required qudt:numericValue ?requiredValue .
                        ?required qudt:unit qudt:KiloW .
                        FILTER (
                            isIRI(?mcr) &&
                            isIRI(?required) &&
                            DATATYPE(?mcrValue) = xsd:decimal &&
                            DATATYPE(?requiredValue) = xsd:decimal &&
                            ?mcrValue >= ?requiredValue
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrOnly
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredOnly
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcr1 .
                        $this nltl:maximumContinuousRatingPower ?mcr2 .
                        FILTER(?mcr1 != ?mcr2)
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?required1 .
                        $this nltl:requiredPowerUnder1985Rules ?required2 .
                        FILTER(?required1 != ?required2)
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrNode .
                        ?mcrNode qudt:numericValue ?mcrNum1 .
                        ?mcrNode qudt:numericValue ?mcrNum2 .
                        FILTER(?mcrNum1 != ?mcrNum2)
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredNode .
                        ?requiredNode qudt:numericValue ?requiredNum1 .
                        ?requiredNode qudt:numericValue ?requiredNum2 .
                        FILTER(?requiredNum1 != ?requiredNum2)
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrNodeUnit .
                        ?mcrNodeUnit qudt:unit ?mcrUnit1 .
                        ?mcrNodeUnit qudt:unit ?mcrUnit2 .
                        FILTER(?mcrUnit1 != ?mcrUnit2)
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredNodeUnit .
                        ?requiredNodeUnit qudt:unit ?requiredUnit1 .
                        ?requiredNodeUnit qudt:unit ?requiredUnit2 .
                        FILTER(?requiredUnit1 != ?requiredUnit2)
                    }
                )
            }
        """
    ] .
