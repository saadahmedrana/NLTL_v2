@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-028> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ]
    ] ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:class nltl:evidenceState ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceRch ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "An alternative Ke or RCH determination requires alternative calculation or model-test evidence, approved status, and at least one valid Ke or RCH result." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
  FILTER (
    NOT EXISTS {
      $this nltl:hasEvidence ?alternativeEvidence .
      ?alternativeEvidence rdf:type ?alternativeType .
      FILTER (
        ?alternativeType = nltl:alternativeCalculationEvidence ||
        ?alternativeType = nltl:modelTestEvidence
      )
    }
    ||
    (
      EXISTS {
        $this nltl:hasEvidence ?approvedEvidence .
        ?approvedEvidence rdf:type ?approvedType .
        FILTER (
          ?approvedType = nltl:alternativeCalculationEvidence ||
          ?approvedType = nltl:modelTestEvidence
        )
      }
      &&
      EXISTS {
        $this nltl:approvalStatus "true"^^xsd:boolean
      }
      &&
      EXISTS {
        $this nltl:approvalRevocationStatus nltl:evidenceStateApproved
      }
      &&
      (
        EXISTS {
          $this nltl:engineOutputCoefficientKe ?ke .
          ?ke qudt:numericValue ?keValue .
          ?ke qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        }
        ||
        EXISTS {
          $this nltl:brashIceChannelResistanceRch ?rch .
          ?rch qudt:numericValue ?rchValue .
          ?rch qudt:unit <http://qudt.org/vocab/unit/N> .
        }
      )
    )
  )
}
"""
    ] .
