@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF030ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the ice pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the applied ice pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide direct analysis cases."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:UpperIceWaterlineCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:HalfBelowLowerIceWaterlineCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:IntermediateVerticalCaseShape ;
        sh:qualifiedMinCount 2 ;
        sh:qualifiedValueShapesDisjoint true
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:MidSpanOrSpacingCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:OtherHorizontalCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:node gen:DirectAnalysisCaseWithCaShape ;
                sh:minCount 1
            ]
        ]
    ) .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:upperIceWaterlineCenteredPosition ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineReferencePosition ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterlineReferencePosition ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:intermediateVerticalPosition ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineReferencePosition ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterlineReferencePosition ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:otherHorizontalPosition ;
                sh:minCount 1
            ]
        ]
    ) .

gen:DirectAnalysisCaseWithCaShape
    a sh:NodeShape ;
    sh:node gen:DirectAnalysisCaseShape ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:upperIceWaterlineCenteredPosition ;
        sh:minCount 1
    ] .

gen:HalfBelowLowerIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
        sh:minCount 1
    ] .

gen:IntermediateVerticalCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:intermediateVerticalPosition ;
        sh:minCount 1
    ] .

gen:MidSpanOrSpacingCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:hasValue nltl:midSpanOrSpacingCenteredPosition ;
        sh:minCount 1
    ] .

gen:OtherHorizontalCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:hasValue nltl:otherHorizontalPosition ;
        sh:minCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
