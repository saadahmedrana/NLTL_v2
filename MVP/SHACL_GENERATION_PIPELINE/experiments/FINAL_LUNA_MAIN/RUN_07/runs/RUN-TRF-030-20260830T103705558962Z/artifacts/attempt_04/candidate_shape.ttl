@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-030-QuantityPressureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-QuantityLengthShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-QuantityUnitlessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-CaseWithCaShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each alternative load case must contain one metre-valued load patch length."
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityUnitlessShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each alternative load case must contain its corresponding unitless ice load area factor ca."
    ] .

<urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape>
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case must specify the load patch length."
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The direct analysis case must evaluate combined bending and shear."
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The direct analysis case must confirm a capacity-minimizing load position."
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:property [
                    sh:path nltl:verticalLoadPositionType ;
                    sh:hasValue nltl:upperIceWaterlineCenteredPosition
                ] ;
                sh:property [
                    sh:path nltl:upperIceWaterlineReferencePosition ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ]
            [
                sh:property [
                    sh:path nltl:verticalLoadPositionType ;
                    sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
                ] ;
                sh:property [
                    sh:path nltl:lowerIceWaterlineReferencePosition ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ]
            [
                sh:property [
                    sh:path nltl:verticalLoadPositionType ;
                    sh:hasValue nltl:intermediateVerticalPosition
                ] ;
                sh:property [
                    sh:path nltl:upperIceWaterlineReferencePosition ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ;
                sh:property [
                    sh:path nltl:lowerIceWaterlineReferencePosition ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition
            ]
            [
                sh:hasValue nltl:otherHorizontalPosition
            ]
        )
    ] .

<urn:nltl:generated-shape:TRF-030-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityPressureShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The source ice pressure p must be supplied as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityPressureShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally calculated applied pressure result, representing 1.8p, must be supplied as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityLengthShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ;
        sh:minCount 1 ;
        sh:or (
            [
                sh:property [
                    sh:path nltl:loadLengthDeterminedFromArrangement ;
                    sh:hasValue true
                ]
            ]
            [
                sh:property [
                    sh:path nltl:loadLengthDeterminedFromArrangement ;
                    sh:hasValue false
                ] ;
                sh:property [
                    sh:path nltl:hasDirectAnalysisCase ;
                    sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-030-CaseWithCaShape> ;
                    sh:qualifiedMinCount 2 ;
                    sh:qualifiedValueShapesDisjoint true
                ]
            ]
        )
    ] .
