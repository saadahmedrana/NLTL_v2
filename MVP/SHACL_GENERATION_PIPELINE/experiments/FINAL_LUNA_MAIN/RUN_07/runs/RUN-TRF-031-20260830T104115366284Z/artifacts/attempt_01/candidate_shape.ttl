@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_031_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldPoint ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "yieldPoint must be a single MPa quantity with a decimal numeric value."
    ] ;
    sh:property [
        sh:path nltl:combinedBendingShearStress ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "combinedBendingShearStress must be a single MPa quantity with a decimal numeric value."
    ] ;
    sh:property [
        sh:path nltl:yieldShearStress ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "yieldShearStress must be a single MPa quantity with a decimal numeric value."
    ] ;
    sh:property [
        sh:path nltl:vonMisesYieldCriterion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "von Mises" ;
        sh:message "vonMisesYieldCriterion must identify the von Mises yield criterion."
    ] ;
    sh:property [
        sh:path nltl:beamTheoryUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "beamTheoryUsed must be supplied to select the applicable calculation branch."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:allowableShearStress ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "allowableShearStress is required when beam theory is used."
            ]
        ]
        [
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "combinedBendingShearStress must be lower than yieldPoint." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:combinedBendingShearStress ?combinedQ ;
                      nltl:yieldPoint ?yieldQ .
                ?combinedQ qudt:numericValue ?combined .
                ?yieldQ qudt:numericValue ?yield .
                FILTER (?combined >= ?yield)
            }
        """
    ] ;
    sh:sparql [
        sh:message "yieldShearStress must equal yieldPoint divided by sqrt(3), within a relative tolerance of 1e-6 and an absolute fallback of 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldQ ;
                      nltl:yieldShearStress ?shearQ .
                ?yieldQ qudt:numericValue ?yield .
                ?shearQ qudt:numericValue ?shear .
                BIND (?yield / xsd:decimal("1.7320508075688772") AS ?expected)
                BIND (
                    IF(
                        ABS(?expected) * xsd:decimal("0.000001") > xsd:decimal("0.000000000001"),
                        ABS(?expected) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000000001")
                    )
                    AS ?tolerance
                )
                FILTER (
                    ?shear < (?expected - ?tolerance) ||
                    ?shear > (?expected + ?tolerance)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "When beam theory is used, allowableShearStress must be no greater than 0.9 times yieldPoint divided by sqrt(3)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:beamTheoryUsed true ;
                      nltl:allowableShearStress ?allowableQ ;
                      nltl:yieldPoint ?yieldQ .
                ?allowableQ qudt:numericValue ?allowable .
                ?yieldQ qudt:numericValue ?yield .
                BIND (
                    xsd:decimal("0.9") * ?yield /
                    xsd:decimal("1.7320508075688772")
                    AS ?limit
                )
                FILTER (?allowable > ?limit)
            }
        """
    ] .
