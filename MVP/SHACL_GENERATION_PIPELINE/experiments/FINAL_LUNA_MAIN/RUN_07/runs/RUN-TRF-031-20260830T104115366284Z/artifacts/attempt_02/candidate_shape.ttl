@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_031_StaticCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldPoint ;
        sh:node gen:TRF_031_StressQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must provide exactly one yield point in MPa."
    ] ;
    sh:property [
        sh:path nltl:combinedBendingShearStress ;
        sh:node gen:TRF_031_StressQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must provide exactly one combined bending and shear stress in MPa."
    ] ;
    sh:property [
        sh:path nltl:yieldShearStress ;
        sh:node gen:TRF_031_StressQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must provide exactly one calculated yield shear stress in MPa."
    ] ;
    sh:sparql [
        sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6, with an absolute fallback of 1e-9 near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:combinedBendingShearStress ?combinedStressNode ;
                      nltl:yieldShearStress ?yieldShearNode .

                ?yieldPointNode qudt:numericValue ?yieldPointValue .
                ?combinedStressNode qudt:numericValue ?combinedStressValue .
                ?yieldShearNode qudt:numericValue ?yieldShearValue .

                BIND((?yieldPointValue / 1.7320508075688772) AS ?expectedYieldShearValue)
                BIND(
                    IF(
                        (ABS(?expectedYieldShearValue) * 0.000001) > 0.000000001,
                        (ABS(?expectedYieldShearValue) * 0.000001),
                        0.000000001
                    )
                    AS ?tolerance
                )

                FILTER(
                    (?combinedStressValue >= ?yieldPointValue)
                    ||
                    (ABS(?yieldShearValue - ?expectedYieldShearValue) > ?tolerance)
                )
            }
        """
    ] .

gen:TRF_031_StressQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
