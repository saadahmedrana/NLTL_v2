@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF_032Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengtheningStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:regulationRequiredScantling ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:classificationSocietyRequiredScantling ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:sparql [
                sh:message "For a ship that is not ice strengthened, the regulation scantling must not be less than the classification society required scantling unless the classification scantling is selected." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:iceStrengtheningStatus ?ice .
                        ?this nltl:regulationRequiredScantling ?regulationQuantity .
                        ?regulationQuantity <http://qudt.org/schema/qudt/numericValue> ?regulationValue .
                        ?this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
                        ?classificationQuantity <http://qudt.org/schema/qudt/numericValue> ?classificationValue .
                        FILTER (?ice != false || ?regulationValue < ?classificationValue)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:selectedDesignScantling ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "When regulation scantlings are less than the classification society required scantlings for a non-ice-strengthened ship, the selected design scantling must equal the classification society required scantling." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT ?this
                    WHERE {
                        ?this nltl:iceStrengtheningStatus ?ice .
                        ?this nltl:regulationRequiredScantling ?regulationQuantity .
                        ?regulationQuantity <http://qudt.org/schema/qudt/numericValue> ?regulationValue .
                        ?this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
                        ?classificationQuantity <http://qudt.org/schema/qudt/numericValue> ?classificationValue .
                        ?this nltl:selectedDesignScantling ?selectedQuantity .
                        ?selectedQuantity <http://qudt.org/schema/qudt/numericValue> ?selectedValue .
                        FILTER (?ice != false || ?regulationValue >= ?classificationValue || ?selectedValue != ?classificationValue)
                    }
                """
            ]
        ]
    ) .
