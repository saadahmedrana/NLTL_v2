@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-036-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:node [
            sh:class nltl:iceClassDesignParameterSet
        ]
    ] .

<urn:nltl:generated-shape:TRF-036-ParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice class must be one of IA Super, IA, IB, or IC."
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Level ice thickness must be a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Design ice load height must be a single metre quantity."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Level ice thickness exceeds the Table 4-1 limit or the design ice load height does not match the ice-class value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?hiQuantity ;
                      nltl:designIceLoadHeight ?hQuantity .

                ?hiQuantity qudt:numericValue ?hiValue .
                ?hQuantity qudt:numericValue ?hValue .

                FILTER (
                    (?class = nltl:iceClassIaSuper &&
                     (?hiValue > 1.0 || ?hValue < 0.35 || ?hValue > 0.35))
                    ||
                    (?class = nltl:iceClassIa &&
                     (?hiValue > 0.8 || ?hValue < 0.30 || ?hValue > 0.30))
                    ||
                    (?class = nltl:iceClassIb &&
                     (?hiValue > 0.6 || ?hValue < 0.25 || ?hValue > 0.25))
                    ||
                    (?class = nltl:iceClassIc &&
                     (?hiValue > 0.4 || ?hValue < 0.22 || ?hValue > 0.22))
                )
            }
        """
    ] .
