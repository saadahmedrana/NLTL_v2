@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-036-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassDesignParameterSet ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-036-ParameterSetShape>
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one permitted ice class."
    ] .

<urn:nltl:generated-shape:TRF-036-ParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The level ice thickness and design ice load height must match the inclusive Table 4-1 values for the ship's ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasIceClassDesignParameterSet $this ;
                       nltl:iceClass ?iceClass .

                $this nltl:levelIceThickness ?hiQuantity ;
                       nltl:designIceLoadHeight ?hQuantity .

                ?hiQuantity qudt:numericValue ?hi ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?hQuantity qudt:numericValue ?h ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        (?hi > "1.0"^^xsd:decimal ||
                         ?h < "0.35"^^xsd:decimal ||
                         ?h > "0.35"^^xsd:decimal)
                    ) ||
                    (
                        ?iceClass = nltl:iceClassIa &&
                        (?hi > "0.8"^^xsd:decimal ||
                         ?h < "0.30"^^xsd:decimal ||
                         ?h > "0.30"^^xsd:decimal)
                    ) ||
                    (
                        ?iceClass = nltl:iceClassIb &&
                        (?hi > "0.6"^^xsd:decimal ||
                         ?h < "0.25"^^xsd:decimal ||
                         ?h > "0.25"^^xsd:decimal)
                    ) ||
                    (
                        ?iceClass = nltl:iceClassIc &&
                        (?hi > "0.4"^^xsd:decimal ||
                         ?h < "0.22"^^xsd:decimal ||
                         ?h > "0.22"^^xsd:decimal)
                    )
                )
            }
        """
    ] .
