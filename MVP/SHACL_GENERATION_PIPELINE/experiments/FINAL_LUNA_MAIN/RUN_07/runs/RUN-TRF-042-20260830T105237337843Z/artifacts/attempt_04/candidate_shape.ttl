@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:YieldStrengthQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMilliMetreQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMetreQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NormalStrengthYieldBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
        )
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:YieldStrengthQuantityValueShape ;
        sh:minInclusive 235 ;
        sh:maxInclusive 235
    ] .

gen:HighStrengthYieldBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:YieldStrengthQuantityValueShape ;
        sh:minInclusive 315
    ] .

gen:OtherSteelYieldBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Other steel grades may use their actual accepted yield strength and must not be one of the listed normal-strength or high-strength grades." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hullStructuralSteelGrade ?grade .
                FILTER (?grade IN (
                    nltl:steelGradeB,
                    nltl:steelGradeD,
                    nltl:steelGradeE,
                    nltl:steelGradeAh,
                    nltl:steelGradeDh,
                    nltl:steelGradeEh,
                    nltl:steelGradeFh
                ))
            }
        """
    ] .

gen:PlatingTRF042Shape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:LengthMetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each plating shall provide one design ice load height in metres."
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthMetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each plating shall provide one spacing in metres."
    ] ;

    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each plating shall provide one dimensionless longitudinal plating factor f2."
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:YieldStrengthQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each plating shall provide one yield strength in MPa."
    ] ;

    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each plating shall identify its hull structural steel grade."
    ] ;

    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gen:LengthMilliMetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The corrosion and abrasion increment shall be one length quantity in millimetres."
    ] ;

    sh:property [
        sh:path nltl:specialSurfaceCoatingMaintained ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:maxCount 1
    ] ;

    sh:or (
        gen:NormalStrengthYieldBranch
        gen:HighStrengthYieldBranch
        gen:OtherSteelYieldBranch
    ) ;

    sh:sparql [
        sh:message "The corrosion and abrasion increment shall be 2 mm, or below 2 mm only with a maintained special surface coating and approved material status; values above 2 mm are not permitted." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:corrosionAbrasionAddition ?addition .
                ?addition qudt:numericValue ?c .
                FILTER (
                    ?c > 2 ||
                    (
                        ?c < 2 &&
                        (
                            NOT EXISTS {
                                $this nltl:specialSurfaceCoatingMaintained true
                            } ||
                            NOT EXISTS {
                                $this nltl:materialApprovalStatus nltl:evidenceStateApproved
                            }
                        )
                    )
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The longitudinal plating factor f2 shall equal the applicable h/s formula within max(1e-6*ABS(expected),1e-12)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hQuantity ;
                      nltl:spacing ?sQuantity ;
                      nltl:longitudinalPlatingFactorF2 ?fQuantity .

                ?hQuantity qudt:numericValue ?h .
                ?sQuantity qudt:numericValue ?s .
                ?fQuantity qudt:numericValue ?reported .

                BIND (?h / ?s AS ?ratio)
                BIND (
                    IF(
                        ?ratio <= 1,
                        0.4 / ?ratio + 0.6,
                        1.4 - 0.4 * ?ratio
                    )
                    AS ?expected
                )

                FILTER (?ratio <= 1.8)
                FILTER (
                    ABS(?reported - ?expected) >
                    IF(
                        1e-6 * ABS(?expected) > 1e-12,
                        1e-6 * ABS(?expected),
                        1e-12
                    )
                )
            }
        """
    ] .
