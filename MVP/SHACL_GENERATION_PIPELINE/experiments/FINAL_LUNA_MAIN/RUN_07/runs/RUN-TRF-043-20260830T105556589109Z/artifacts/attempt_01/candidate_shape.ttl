@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF043_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:node <urn:nltl:generated-shape:TRF043_TerminationCaseShape>
    ] .

<urn:nltl:generated-shape:TRF043_TerminationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:framingIceStrengtheningTerminationCase ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF043_ExtensionQuantityShape> ;
        sh:message "Each framing ice-strengthening termination case must provide the extension beyond the adjacent boundary in millimetres."
    ] ;
    sh:property [
        sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the extension beyond the adjacent deck, tank boundary, or tank top is no more than 250 mm, termination at that boundary must be permitted and the boundary must be a deck structure, tank boundary plating, or tank top." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (xsd:decimal(?value) <= 250)
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ?permitted .
                        FILTER (?permitted = true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:terminationAdjacentBoundary ?boundary .
                        ?boundary a ?boundaryType .
                        FILTER (
                            ?boundaryType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:terminationAdjacentBoundary ?invalidBoundary .
                        FILTER NOT EXISTS {
                            ?invalidBoundary a ?invalidBoundaryType .
                            FILTER (
                                ?invalidBoundaryType IN (
                                    nltl:deckStructure,
                                    nltl:tankBoundaryPlating,
                                    nltl:tankTop
                                )
                            )
                        }
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF043_ExtensionQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
