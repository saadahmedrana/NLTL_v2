@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF043_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:node nltl:TRF043_TerminationCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:frame
        ] ;
        sh:qualifiedMinCount 0
    ] .

nltl:TRF043_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:class nltl:hullRegionValue ;
        sh:in (
            nltl:bowRegion
            nltl:midbodyRegion
            nltl:sternRegion
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node nltl:TRF043_MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node nltl:TRF043_MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:reachesTankTopOrBelowFloorTop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperBowIceBeltRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing vertical extents do not meet the applicable Table 4-6 minimums." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ic ;
                      nltl:hullRegion ?region ;
                      nltl:framingIceStrengtheningAboveUpperIceWaterline ?aboveQ ;
                      nltl:framingIceStrengtheningBelowLowerIceWaterline ?belowQ ;
                      nltl:reachesTankTopOrBelowFloorTop ?reaches .
                ?aboveQ qudt:numericValue ?above ;
                         qudt:unit <http://qudt.org/vocab/unit/M> .
                ?belowQ qudt:numericValue ?below ;
                         qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER(
                    (?ic = nltl:iceClassIaSuper && ?above < 1.2) ||
                    (?ic IN (nltl:iceClassIa, nltl:iceClassIb, nltl:iceClassIc) && ?above < 1.0) ||
                    (?ic = nltl:iceClassIaSuper && ?region = nltl:bowRegion && ?reaches = true && ?below < 2.0) ||
                    (?ic = nltl:iceClassIaSuper && ?region = nltl:bowRegion && ?reaches = false && ?below < 1.6) ||
                    (?ic = nltl:iceClassIaSuper && ?region = nltl:midbodyRegion && ?below < 2.0) ||
                    (?ic = nltl:iceClassIaSuper && ?region = nltl:sternRegion && ?below < 1.6) ||
                    (?ic IN (nltl:iceClassIa, nltl:iceClassIb, nltl:iceClassIc) && ?region = nltl:bowRegion && ?below < 1.6) ||
                    (?ic IN (nltl:iceClassIa, nltl:iceClassIb, nltl:iceClassIc) && ?region = nltl:midbodyRegion && ?below < 1.3) ||
                    (?ic IN (nltl:iceClassIa, nltl:iceClassIb, nltl:iceClassIc) && ?region = nltl:sternRegion && ?below < 1.0)
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When an upper bow ice belt is required, framing must reach its top." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperBowIceBeltRequired true .
                FILTER NOT EXISTS {
                    $this nltl:reachesUpperBowIceBeltTop true .
                }
            }
        """
    ] .

nltl:TRF043_MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF043_TerminationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:node nltl:TRF043_MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an extension of no more than 250 mm, termination at the identified adjacent boundary must be permitted." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?extensionQ .
                ?extensionQ qudt:numericValue ?extension ;
                            qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER(?extension <= 250)
                FILTER NOT EXISTS {
                    $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true ;
                          nltl:terminationAdjacentBoundary ?boundary .
                    {
                        ?boundary a nltl:deckStructure .
                    }
                    UNION
                    {
                        ?boundary a nltl:tankBoundaryPlating .
                    }
                    UNION
                    {
                        ?boundary a nltl:tankTop .
                    }
                }
            }
        """
    ] .

nltl:TRF043_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
