@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_045_FrameScantlingsConditionalShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ordinary frame scantlings are used, the frame span within the ice-strengthening zone must be less than 15% of the frame span, and both quantities must be expressed in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>

SELECT ?this
WHERE {
    ?this nltl:ordinaryFrameScantlingsUsed true .
    FILTER NOT EXISTS {
        ?this nltl:frameSpanWithinIceStrengtheningZone ?withinNode ;
              nltl:span ?spanNode .
        ?withinNode qudt:numericValue ?withinValue ;
                    qudt:unit unit:M .
        ?spanNode qudt:numericValue ?spanValue ;
                  qudt:unit unit:M .
        FILTER NOT EXISTS {
            ?withinNode qudt:unit ?withinUnit .
            FILTER (?withinUnit != unit:M)
        }
        FILTER NOT EXISTS {
            ?spanNode qudt:unit ?spanUnit .
            FILTER (?spanUnit != unit:M)
        }
        FILTER (?withinValue < (0.15 * ?spanValue))
    }
}
"""
    ] .
