@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF046FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:node gen:TRF046StrengthenedPartShape ;
        sh:message "A frame must identify its strengthened part."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When a frame terminates above supporting structure at or above the ice-belt upper limit, the permitted ordinary scantlings or intermediate-frame horizontal connection condition must be recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasUpperEnd ?upperEnd .
                ?upperEnd nltl:hasTerminationAboveSupportingStructure ?supportingStructure .
                ?supportingStructure nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .
                FILTER NOT EXISTS {
                    {
                        $this nltl:hasStrengthenedPart ?strengthenedPart .
                        ?strengthenedPart nltl:ordinaryFrameScantlingsUsed true .
                    }
                    UNION
                    {
                        $this a nltl:intermediateIceFrame .
                        ?upperEnd nltl:hasHorizontalConnectionMember ?horizontalMember .
                        ?horizontalMember nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                        ?horizontalMember nltl:sameScantlingsAsMainFrame true .
                    }
                }
            }
        """
    ] .

gen:TRF046StrengthenedPartShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .

gen:TRF046UpperEndOwnerShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:hasUpperEnd ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node gen:TRF046FrameEndShape ;
        sh:message "The upper end of the strengthened framing must be identified."
    ] .

gen:TRF046FrameEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The upper end must be attached to a deck, tank boundary plating, or ice stringer."
    ] ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:node [
            sh:property [
                sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:node [
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:minCount 1 ;
                sh:class nltl:mainFrame
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1
            ]
        ]
    ] .
