@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF_047_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:class nltl:mainFrame ;
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:message "A main frame must identify its strengthened part."
            ] ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:message "A main frame must identify its lower end."
            ] ;
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:node gen:TRF_047_SpecifiedSupportingStructureShape ;
                sh:message "The lower end of the strengthened main-frame part must be attached to a deck, tank boundary plating, tank top, or ice stringer."
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:message "An intermediate ice frame must identify its strengthened part."
            ] ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:message "An intermediate ice frame must identify its lower end."
            ] ;
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:node gen:TRF_047_SpecifiedSupportingStructureShape ;
                sh:message "The lower end of the strengthened intermediate-frame part must be attached to a deck, tank boundary plating, tank top, or ice stringer."
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "An intermediate frame terminating below a specified supporting structure at or below the ice-belt lower limit may use a horizontal member only when it connects to an adjacent main frame and has the same scantlings as the main frames." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this a nltl:intermediateIceFrame ;
                              nltl:hasStrengthenedPart ?strengthenedPart ;
                              nltl:hasLowerEnd ?lowerEnd ;
                              nltl:hasTerminationBelowSupportingStructure ?support ;
                              nltl:supportingStructureAtOrBelowIceBeltLowerLimit true ;
                              nltl:hasHorizontalConnectionMember ?member ;
                              nltl:sameScantlingsAsMainFrame true .
                        ?support a ?supportClass .
                        ?member nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                        ?adjacentMainFrame a nltl:mainFrame .
                        FILTER (
                            ?supportClass IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                """
            ]
        ]
    ) .

gen:TRF_047_SpecifiedSupportingStructureShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:tankTop ]
        [ sh:class nltl:iceStringer ]
    ) .
