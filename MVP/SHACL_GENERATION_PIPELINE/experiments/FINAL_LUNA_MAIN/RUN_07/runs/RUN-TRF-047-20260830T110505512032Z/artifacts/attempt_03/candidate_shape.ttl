@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-047-lower-end-attachment> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lower end of each strengthened main or intermediate ice frame must be attached to an allowed supporting structure, or satisfy the specified intermediate-frame horizontal-connection exception." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStrengthenedPart ?strengthenedPart .
                ?strengthenedPart rdf:type ?strengthenedPartClass .
                FILTER (
                    ?strengthenedPartClass IN (
                        nltl:mainFrame,
                        nltl:intermediateIceFrame
                    )
                )
                ?strengthenedPart nltl:hasLowerEnd ?lowerEnd .

                FILTER NOT EXISTS {
                    ?lowerEnd nltl:hasAttachedSupportingStructure ?attachedStructure .
                    ?attachedStructure rdf:type ?attachedStructureClass .
                    FILTER (
                        ?attachedStructureClass IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:tankTop,
                            nltl:iceStringer
                        )
                    )
                }

                FILTER NOT EXISTS {
                    ?strengthenedPart rdf:type nltl:intermediateIceFrame .
                    ?lowerEnd nltl:hasTerminationBelowSupportingStructure ?terminationStructure .
                    ?terminationStructure rdf:type ?terminationStructureClass .
                    FILTER (
                        ?terminationStructureClass IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:tankTop,
                            nltl:iceStringer
                        )
                    )
                    $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true ;
                          nltl:sameScantlingsAsMainFrame true .
                    ?lowerEnd nltl:hasHorizontalConnectionMember ?horizontalMember .
                    ?horizontalMember nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                    ?adjacentMainFrame nltl:mainFrameBelowIceBeltStrengthened true .
                }
            }
        """
    ] .
