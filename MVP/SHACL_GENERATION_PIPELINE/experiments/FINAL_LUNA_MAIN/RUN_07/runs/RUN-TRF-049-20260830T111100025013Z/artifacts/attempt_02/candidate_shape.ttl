@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-049-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-049-InIceShape>
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-049-InIceShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:effectiveAttachmentConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasSupportingStructureAttachment ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:node [
                    sh:property [
                        sh:path nltl:bracketThickness ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:bracketEdgeStiffened ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:bucklingStiffening ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The frame is not attached to every required supporting structure, lacks the required reciprocal attachment relationship or bracket construction, does not connect both web-plate sides when passing through a supporting structure, or has a bracket thinner than the frame web." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:hasFrameAttachment ?fa .
                        FILTER NOT EXISTS {
                            ?fa nltl:hasAttachedSupportingStructure ?ss .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasFrameAttachment ?fa .
                        ?fa nltl:hasAttachedSupportingStructure ?ss .
                        FILTER NOT EXISTS {
                            ?ss nltl:hasSupportingStructureAttachment ?fa
                        }
                    }
                    ||
                    EXISTS {
                        $this a nltl:longitudinalFrame .
                        $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?ss .
                        FILTER NOT EXISTS {
                            $this nltl:hasFrameAttachment ?fa .
                            ?fa nltl:hasAttachedSupportingStructure ?ss .
                            ?fa nltl:hasConnectionBracket ?br
                        }
                    }
                    ||
                    EXISTS {
                        $this a nltl:transverseFrame .
                        $this nltl:terminatesAtDeckOrIceStringer true .
                        FILTER NOT EXISTS {
                            $this nltl:hasFrameAttachment ?fa .
                            ?fa nltl:hasAttachedSupportingStructure ?ss .
                            {
                                ?fa nltl:hasConnectionBracket ?br
                            }
                            UNION
                            {
                                ?fa nltl:similarAttachmentConstructionPresent true
                            }
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:passesThroughSupportingStructure true .
                        FILTER NOT EXISTS {
                            $this nltl:webPlateConnectionSideCount 2
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasFrameAttachment ?fa .
                        ?fa nltl:hasConnectionBracket ?br .
                        FILTER NOT EXISTS {
                            $this nltl:frameWebThickness ?fw .
                            ?fw qudt:numericValue ?fn ;
                                qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            ?br nltl:bracketThickness ?bt .
                            ?bt qudt:numericValue ?bn ;
                                qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            FILTER (datatype(?fn) = xsd:decimal && datatype(?bn) = xsd:decimal)
                            FILTER (?bn >= ?fn)
                        }
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-049-TransverseFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
