@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF052FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Frame asymmetry status must be recorded as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF052AngleQuantityShape ;
        sh:message "Frame web angle to shell must be supplied as a single quantity in degrees."
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF052LengthQuantityShape ;
        sh:message "Frame span must be supplied as a single quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "Frame ice class must be one of the supplied canonical ice-class values."
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Equivalent support status, when supplied, must be a single boolean value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an asymmetrical frame or a frame web angle below 90 degrees, antitripping support spacing must not exceed 1300 mm unless equivalent support is demonstrated by direct calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                {
                    $this nltl:frameAsymmetrical true .
                }
                UNION
                {
                    $this nltl:frameWebAngleToShell [
                        qudt:numericValue ?angle ;
                        qudt:unit <http://qudt.org/vocab/unit/DEG>
                    ] .
                    FILTER (?angle < 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing [
                        qudt:numericValue ?spacing ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM>
                    ] .
                    FILTER (?spacing <= 1300)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable antitripping support region scope must be recorded unless an equivalent alternative arrangement is demonstrated by direct calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                $this nltl:frameSpan [
                    qudt:numericValue ?span ;
                    qudt:unit <http://qudt.org/vocab/unit/M>
                ] .
                {
                    FILTER (?span > 4)
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion ?region .
                    }
                }
                UNION
                {
                    FILTER (?span <= 4)
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion ?region .
                    }
                }
                UNION
                {
                    FILTER (?span <= 4)
                    $this nltl:iceClass nltl:iceClassIa .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                    }
                }
                UNION
                {
                    FILTER (?span <= 4)
                    $this nltl:iceClass nltl:iceClassIa .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                    }
                }
                UNION
                {
                    FILTER (?span <= 4)
                    {
                        $this nltl:iceClass nltl:iceClassIb .
                    }
                    UNION
                    {
                        $this nltl:iceClass nltl:iceClassIc .
                    }
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                    }
                }
            }
        """
    ] .

gen:TRF052LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF052AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
