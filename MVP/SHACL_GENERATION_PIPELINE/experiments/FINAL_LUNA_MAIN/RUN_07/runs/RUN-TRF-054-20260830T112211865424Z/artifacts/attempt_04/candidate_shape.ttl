@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF054Shape a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:locatedOutsideIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:supportsIceStrengthenedFrames ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:icePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:span ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:stringerSpan ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:yieldStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:distanceToIceBelt ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:distanceToAdjacentIceStringer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive 0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltDistributionFactorF9 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 0.80 ;
                        sh:maxInclusive 0.80
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltSafetyFactorF10 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 1.8 ;
                        sh:maxInclusive 1.8
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltShearFactorF11 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 1.2 ;
                        sh:maxInclusive 1.2
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:designLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The applicable ice-stringer quantities and calculated results do not satisfy the verified formulas." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:icePressure ?pNode ;
                              nltl:designIceLoadHeight ?hNode ;
                              nltl:span ?spanNode ;
                              nltl:stringerSpan ?lsNode ;
                              nltl:frameMomentFactorM ?mNode ;
                              nltl:yieldStrength ?syNode ;
                              nltl:distanceToIceBelt ?hsNode ;
                              nltl:distanceToAdjacentIceStringer ?lsDistanceNode ;
                              nltl:designLineLoad ?loadNode ;
                              nltl:outsideIceBeltFactor ?factorNode ;
                              nltl:sectionModulus ?zNode ;
                              nltl:requiredShearArea ?aNode .
                        ?pNode qudt:numericValue ?p .
                        ?hNode qudt:numericValue ?h .
                        ?spanNode qudt:numericValue ?span .
                        ?lsNode qudt:numericValue ?ls .
                        ?mNode qudt:numericValue ?m .
                        ?syNode qudt:numericValue ?sy .
                        ?hsNode qudt:numericValue ?hs .
                        ?lsDistanceNode qudt:numericValue ?lsDistance .
                        ?loadNode qudt:numericValue ?load .
                        ?factorNode qudt:numericValue ?factor .
                        ?zNode qudt:numericValue ?z .
                        ?aNode qudt:numericValue ?a .
                        BIND(IF((?p * ?h) > 0.15, (?p * ?h), 0.15) AS ?loadMN)
                        BIND((1 - (?hs / ?lsDistance)) AS ?expectedFactor)
                        BIND((0.80 * 1.8 * ?loadMN * ?ls * ?ls /
                              (?m * ?sy) * ?expectedFactor * 1000000) AS ?expectedZ)
                        BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 * ?loadMN * ?ls /
                              (2 * ?sy) * ?expectedFactor * 10000) AS ?expectedA)
                        BIND((1000 * ?loadMN) AS ?expectedLoad)
                        BIND(IF(?expectedLoad > 0, ?expectedLoad,
                              IF(?expectedLoad < 0, -?expectedLoad, 0.000001)) AS ?loadScale)
                        BIND(IF(?expectedFactor > 0, ?expectedFactor,
                              IF(?expectedFactor < 0, -?expectedFactor, 0.000001)) AS ?factorScale)
                        BIND(IF(?expectedZ > 0, ?expectedZ,
                              IF(?expectedZ < 0, -?expectedZ, 0.000001)) AS ?zScale)
                        BIND(IF(?expectedA > 0, ?expectedA,
                              IF(?expectedA < 0, -?expectedA, 0.000001)) AS ?aScale)
                        FILTER(
                            (?span > ?ls + (0.000001 * IF(?span > 0, ?span, 0.000001))) ||
                            (?span < ?ls - (0.000001 * IF(?span > 0, ?span, 0.000001))) ||
                            (?factor > ?expectedFactor + (0.000001 * ?factorScale)) ||
                            (?factor < ?expectedFactor - (0.000001 * ?factorScale)) ||
                            (?load > ?expectedLoad + (0.000001 * ?loadScale)) ||
                            (?load < ?expectedLoad - (0.000001 * ?loadScale)) ||
                            (?z > ?expectedZ + (0.000001 * ?zScale)) ||
                            (?z < ?expectedZ - (0.000001 * ?zScale)) ||
                            (?a > ?expectedA + (0.000001 * ?aScale)) ||
                            (?a < ?expectedA - (0.000001 * ?aScale))
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue false
            ]
        ]
    ) .
