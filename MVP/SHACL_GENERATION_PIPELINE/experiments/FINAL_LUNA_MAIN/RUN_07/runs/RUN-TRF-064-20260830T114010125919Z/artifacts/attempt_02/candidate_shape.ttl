@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "The detached-strut applicability value must be a single boolean when represented."
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:class nltl:sidePropellerShaftingAssembly ;
        sh:message "A represented side-propeller shafting assembly must be typed as a side-propeller shafting assembly."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:class nltl:sternTube ;
        sh:message "A represented stern tube must be typed as a stern tube."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented side-propeller shafting assembly must also be the ship component enclosed by a plated bossing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasSidePropellerShafting ?shaft .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?shaft .
                    ?shaft nltl:enclosedByPlatedBossing ?bossing .
                    ?bossing a nltl:platedBossingStructure .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented stern tube must also be the ship component enclosed by a plated bossing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasSternTube ?tube .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?tube .
                    ?tube nltl:enclosedByPlatedBossing ?bossing .
                    ?bossing a nltl:platedBossingStructure .
                }
            }
        """
    ] .
