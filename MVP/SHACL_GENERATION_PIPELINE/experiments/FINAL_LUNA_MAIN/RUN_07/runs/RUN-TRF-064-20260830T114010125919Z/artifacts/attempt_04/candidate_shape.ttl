@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF064Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:minCount 1 ;
        sh:class nltl:sidePropellerShaftingAssembly ;
        sh:message "The ship shall identify its side propeller shafting."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:minCount 1 ;
        sh:class nltl:sternTube ;
        sh:message "The ship shall identify its stern tubes."
    ] ;
    sh:property [
        sh:path (
            nltl:hasComponent
            nltl:enclosedByPlatedBossing
        ) ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "The applicable side-propeller shafting and stern-tube component path shall reach plated bossing."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:minCount 1 ;
                sh:class nltl:detachedStrutStructure ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasStrutDesignEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:strutDesignEvidence
                    ] ;
                    sh:property [
                        sh:path nltl:hasStrutHullAttachmentEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:strutHullAttachmentEvidence
                    ] ;
                    sh:property [
                        sh:path nltl:hasStrutStrengthEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:strutStrengthEvidence
                    ]
                ]
            ]
        ]
    ) .
