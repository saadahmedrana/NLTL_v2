@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF_067_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa ;
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "For ice class IA, a rudder protection arrangement for absorbing large ice loads shall be installed." ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper ;
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "For ice class IA Super, a rudder protection arrangement for absorbing large ice loads shall be installed." ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:iceClass ;
                    sh:hasValue nltl:iceClassIa ;
                ] ;
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:iceClass ;
                    sh:hasValue nltl:iceClassIaSuper ;
                ] ;
            ] ;
        ]
    ) .
