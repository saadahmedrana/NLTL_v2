@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF074ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:ballastConditionPropellerTopDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF074LengthQuantityShape ;
        sh:message "A ship must provide one ballast-condition propeller top depth in metres."
    ] ;
    sh:property [
        sh:path nltl:requiredPropellerSubmersionDepthHi ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF074LengthQuantityShape ;
        sh:message "A ship must provide one required propeller submersion depth hi in metres."
    ] ;
    sh:or (
        gen:TRF074ApplicableIceClassShape
        gen:TRF074NonApplicableIceClassShape
    ) .

gen:TRF074LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:TRF074ApplicableIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice classes IB or IC, when the ballast-condition propeller top depth is below hi, the propulsion system must be designed for ice class IA." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                ?depthQuantity qudt:numericValue ?depthValue .
                $this nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                ?hiQuantity qudt:numericValue ?hiValue .
                FILTER(
                    ?depthValue < ?hiValue
                )
                FILTER NOT EXISTS {
                    $this nltl:propulsionSystemDesignedForIceClass nltl:iceClassIa
                }
            }
        """
    ] .

gen:TRF074NonApplicableIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .
