@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF074ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide its ice class."
    ] ;
    sh:property [
        sh:path nltl:ballastConditionPropellerTopDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:nodeKind sh:IRI ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ballast-condition propeller top depth must be provided as a metre quantity."
    ] ;
    sh:property [
        sh:path nltl:requiredPropellerSubmersionDepthHi ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:nodeKind sh:IRI ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The required propeller submersion depth hi must be provided as a metre quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIaSuper
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                )
            ] ;
            sh:sparql [
                sh:message "For ice class IB or IC, the ballast-condition propeller top depth must be at least hi when the non-applicable branch is used." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                        ?depthQuantity qudt:numericValue ?depth .
                        $this nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                        ?hiQuantity qudt:numericValue ?hi .
                        FILTER (!(?depth >= ?hi))
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                )
            ] ;
            sh:property [
                sh:path nltl:propulsionSystemDesignedForIceClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:hasValue nltl:iceClassIa ;
                sh:minCount 1 ;
                sh:message "When the ballast-condition propeller top depth is below hi for ice class IB or IC, the propulsion system must be designed according to ice class IA."
            ] ;
            sh:sparql [
                sh:message "The applicable ice-class branch requires the ballast-condition propeller top depth to be below hi." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                        ?depthQuantity qudt:numericValue ?depth .
                        $this nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .
                        ?hiQuantity qudt:numericValue ?hi .
                        FILTER (!(?depth < ?hi))
                    }
                """
            ]
        ]
    ) .
