@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF076Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        g:TRF076CPBranch
        g:TRF076FPBranch
    ) .

g:TRF076CPBranch
    a sh:NodeShape ;
    sh:and (
        g:TRF076CPType
        g:TRF076Cases14
    ) .

g:TRF076CPType
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "CP" ;
        sh:message "A CP propeller must be explicitly identified."
    ] .

g:TRF076FPBranch
    a sh:NodeShape ;
    sh:and (
        g:TRF076FPType
        g:TRF076FPApplicability
    ) .

g:TRF076FPType
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP" ;
        sh:message "An FP propeller must be explicitly identified."
    ] .

g:TRF076FPApplicability
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "FP propellers must explicitly state whether reversing capability applies."
    ] ;
    sh:or (
        g:TRF076FPReversing
        g:TRF076FPNormal
    ) .

g:TRF076FPReversing
    a sh:NodeShape ;
    sh:and (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        g:TRF076Cases15
    ) .

g:TRF076FPNormal
    a sh:NodeShape ;
    sh:and (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        g:TRF076Cases14
    ) .

g:TRF076Cases14
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:qualifiedValueShape g:TRF076Case1 ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 1 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:qualifiedValueShape g:TRF076Case2 ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 2 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:qualifiedValueShape g:TRF076Case3 ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 3 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:qualifiedValueShape g:TRF076Case4 ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 4 must be covered."
    ] .

g:TRF076Cases15
    a sh:NodeShape ;
    sh:node g:TRF076Cases14 ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:qualifiedValueShape g:TRF076Case5 ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 5 must be covered for a reversing FP propeller."
    ] .

g:TRF076Case1
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] .

g:TRF076Case2
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] .

g:TRF076Case3
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] .

g:TRF076Case4
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] .

g:TRF076Case5
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5
    ] .
