@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-080> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Applicable propeller/ice-interaction cases require ice load cycles, propeller blade count, and a complete effective ice load cycle quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component rdf:type nltl:propellerIceInteractionComponent .
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceLoadCycleCount ?nice .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:propellerBladeCount ?blades .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:effectiveIceLoadCycleCount ?quantity .
                        ?quantity qudt:numericValue ?effective .
                        ?quantity qudt:unit ?unit .
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable propeller/ice-interaction calculation inputs and result must use their canonical datatypes and the effective result must use unit UNITLESS." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component ;
                      nltl:iceLoadCycleCount ?nice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?quantity .
                ?component rdf:type nltl:propellerIceInteractionComponent .
                ?quantity qudt:numericValue ?effective ;
                          qudt:unit ?unit .
                FILTER (
                    datatype(?nice) != xsd:integer
                    ||
                    datatype(?blades) != xsd:integer
                    ||
                    datatype(?effective) != xsd:decimal
                    ||
                    ?unit != <http://qudt.org/vocab/unit/UNITLESS>
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For applicable propeller/ice-interaction cases, effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component ;
                      nltl:iceLoadCycleCount ?nice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?quantity .
                ?component rdf:type nltl:propellerIceInteractionComponent .
                ?quantity qudt:numericValue ?effective ;
                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                BIND((?nice * ?blades) AS ?expected)
                FILTER(
                    ABS(?effective - ?expected)
                    >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .
