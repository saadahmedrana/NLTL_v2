@prefix calc: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

calc:TRF_081_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:forwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:backwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:forwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:backwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:propellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "Ice thrust and propeller shaft design thrust values must satisfy the TRF-081 formulas; calculated decimal results use a relative tolerance of 1e-6 with an absolute fallback near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?frNode ;
                      nltl:backwardPropellerShaftDesignThrust ?brNode ;
                      nltl:propellerShaftDesignThrust ?rNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?tNode qudt:numericValue ?t .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?frNode qudt:numericValue ?fr .
                ?brNode qudt:numericValue ?br .
                ?rNode qudt:numericValue ?r .

                BIND (1.1 * ?ff AS ?tfExpected)
                BIND (1.1 * ?fb AS ?tbExpected)
                BIND (?t + (2.2 * ?tfExpected) AS ?forwardExpected)
                BIND (1.5 * ?tbExpected AS ?backwardExpected)
                BIND (IF(?forwardExpected >= ?backwardExpected, ?forwardExpected, ?backwardExpected) AS ?designExpected)

                BIND (IF((?tf - ?tfExpected) >= 0, (?tf - ?tfExpected), 0 - (?tf - ?tfExpected)) AS ?tfDifference)
                BIND (IF(?tfExpected >= 0, ?tfExpected, 0 - ?tfExpected) AS ?tfMagnitude)
                BIND (IF(?tfMagnitude >= 1, ?tfMagnitude, 1) AS ?tfScale)

                BIND (IF((?tb - ?tbExpected) >= 0, (?tb - ?tbExpected), 0 - (?tb - ?tbExpected)) AS ?tbDifference)
                BIND (IF(?tbExpected >= 0, ?tbExpected, 0 - ?tbExpected) AS ?tbMagnitude)
                BIND (IF(?tbMagnitude >= 1, ?tbMagnitude, 1) AS ?tbScale)

                BIND (IF((?fr - ?forwardExpected) >= 0, (?fr - ?forwardExpected), 0 - (?fr - ?forwardExpected)) AS ?frDifference)
                BIND (IF(?forwardExpected >= 0, ?forwardExpected, 0 - ?forwardExpected) AS ?frMagnitude)
                BIND (IF(?frMagnitude >= 1, ?frMagnitude, 1) AS ?frScale)

                BIND (IF((?br - ?backwardExpected) >= 0, (?br - ?backwardExpected), 0 - (?br - ?backwardExpected)) AS ?brDifference)
                BIND (IF(?backwardExpected >= 0, ?backwardExpected, 0 - ?backwardExpected) AS ?brMagnitude)
                BIND (IF(?brMagnitude >= 1, ?brMagnitude, 1) AS ?brScale)

                BIND (IF((?r - ?designExpected) >= 0, (?r - ?designExpected), 0 - (?r - ?designExpected)) AS ?rDifference)
                BIND (IF(?designExpected >= 0, ?designExpected, 0 - ?designExpected) AS ?rMagnitude)
                BIND (IF(?rMagnitude >= 1, ?rMagnitude, 1) AS ?rScale)

                FILTER (
                    ?tfDifference > (0.000001 * ?tfScale) ||
                    ?tbDifference > (0.000001 * ?tbScale) ||
                    ?frDifference > (0.000001 * ?frScale) ||
                    ?brDifference > (0.000001 * ?brScale) ||
                    ?rDifference > (0.000001 * ?rScale)
                )
            }
        """
    ] .
