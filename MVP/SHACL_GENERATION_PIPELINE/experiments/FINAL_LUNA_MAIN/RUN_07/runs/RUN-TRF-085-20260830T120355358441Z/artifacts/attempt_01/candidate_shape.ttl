@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF085Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PropellerDiameterQuantityShape ;
        sh:message "The ship shall provide its propeller diameter in metres."
    ] ;
    sh:or (
        gen:TRF085KnownSpeedShape
        gen:TRF085TableSpeedShape
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When bollard propeller speed is not known, the reported speed shall equal the selected Table 6-9 lookup result." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:bollardPropellerSpeedKnown false .
                $this nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed .
                ?speed qudt:numericValue ?speedValue .
                $this nltl:hasTableLookupCase ?case .
                ?case nltl:lookupResultQuantity ?result .
                ?result qudt:numericValue ?resultValue .
                FILTER (?speedValue != ?resultValue)
            }
        """
    ] .

gen:PropellerDiameterQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PropellerSpeedQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LookupInputQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LookupResultQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF085KnownSpeedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardPropellerSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall state that the bollard propeller speed is known."
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PropellerSpeedQuantityShape ;
        sh:message "The known propeller rotational speed at MCR in bollard condition shall be provided."
    ] .

gen:TRF085TableSpeedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardPropellerSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship shall state that the bollard propeller speed is not known when Table 6-9 is used."
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PropellerSpeedQuantityShape ;
        sh:message "The propeller speed selected from Table 6-9 shall be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TRF085TableLookupCaseShape ;
        sh:message "A Table 6-9 lookup case shall be provided when the bollard propeller speed is not known."
    ] .

gen:TRF085TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:lookupInputQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LookupInputQuantityShape ;
        sh:message "The table lookup input quantity shall be provided."
    ] ;
    sh:property [
        sh:path nltl:lookupResultQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LookupResultQuantityShape ;
        sh:message "The selected Table 6-9 lookup result shall be provided."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "Evidence for the Table 6-9 selection shall be provided."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash9 ;
        sh:message "The lookup case shall reference TRAFICOM Table 6-9."
    ] .
