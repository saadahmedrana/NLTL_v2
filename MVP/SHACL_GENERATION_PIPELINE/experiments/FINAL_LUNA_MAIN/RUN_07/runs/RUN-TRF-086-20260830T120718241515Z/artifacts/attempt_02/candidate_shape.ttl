@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF_086_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:TRF_086_CP_Known
        gs:TRF_086_CP_Unknown
        gs:TRF_086_Not_CP
    ) ;
    sh:sparql [
        sh:message "For a CP propeller with unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6, with an absolute tolerance of 1e-9 near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrFreeRunning ?freeQuantity ;
                      nltl:propellerPitchAtMcrBollard ?bollardQuantity .

                ?freeQuantity qudt:numericValue ?free ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                ?bollardQuantity qudt:numericValue ?observed ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (datatype(?free) = xsd:decimal)
                FILTER (datatype(?observed) = xsd:decimal)

                BIND ((0.7 * ?free) AS ?expected)
                BIND (IF(?expected < 0, -?expected, ?expected) AS ?magnitude)
                BIND (
                    IF(
                        ?magnitude < 0.000000000001,
                        0.000000001,
                        ?magnitude * 0.000001
                    )
                    AS ?tolerance
                )

                FILTER (
                    ?observed < (?expected - ?tolerance) ||
                    ?observed > (?expected + ?tolerance)
                )
            }
        """
    ] .

gs:TRF_086_CP_Known a sh:NodeShape ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gs:TRF_086_CP_Unknown a sh:NodeShape ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrFreeRunning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gs:TRF_086_Not_CP a sh:NodeShape ;
    sh:not [
        sh:path nltl:propellerType ;
        sh:hasValue "CP"^^xsd:string
    ] .
