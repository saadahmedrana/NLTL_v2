@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:equals nltl:hasPropulsionLoadCase ;
        sh:node gen:TRF091LoadCaseShape ;
        sh:message "The ice-milling sequence case must be the propulsion-line strength-evaluation load case."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF091LoadCaseShape ;
        sh:message "A propulsion-line strength-evaluation load case is required."
    ] .

gen:TRF091LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:message "The load case must be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis."
    ] ;
    sh:not [
        sh:property [
            sh:path nltl:loadCasePurpose ;
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ]
    ] .
