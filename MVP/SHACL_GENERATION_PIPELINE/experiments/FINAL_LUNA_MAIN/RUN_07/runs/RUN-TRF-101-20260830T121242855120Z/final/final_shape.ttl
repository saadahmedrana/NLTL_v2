@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-101-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LoadCaseShape>
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-101-FormulaShape>
        <urn:nltl:generated-shape:TRF-101-ApprovedAnalysisShape>
    ) ;
    sh:sparql [
        sh:message "bladeFailureStatus must be true exactly when bladeTipOffset exceeds 10 percent of propellerDiameter" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset/qudt:numericValue ?tip ;
                      nltl:propellerDiameter/qudt:numericValue ?diameter ;
                      nltl:bladeFailureStatus ?status .
                BIND((?tip > (0.10 * ?diameter)) AS ?expectedStatus)
                FILTER (?status != ?expectedStatus)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-101-LoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 0.8 ;
                sh:maxInclusive 0.8
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

<urn:nltl:generated-shape:TRF-101-ApprovedAnalysisShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:approvalRecord
    ] .

<urn:nltl:generated-shape:TRF-101-FormulaShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The reported blade reference strength and ultimate load must satisfy the declared calculation within numerical tolerance" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection/qudt:numericValue ?c ;
                      nltl:bladeMaximumThicknessAtWeakestSection/qudt:numericValue ?t ;
                      nltl:bladeCylindricalRootRadius/qudt:numericValue ?r ;
                      nltl:bladeMinimumYieldStrength/qudt:numericValue ?yield ;
                      nltl:bladeUltimateTensileStrength/qudt:numericValue ?ultimate ;
                      nltl:bladeReferenceStrength1/qudt:numericValue ?reportedReference ;
                      nltl:bladeFailureUltimateLoad/qudt:numericValue ?reportedLoad .
                FILTER NOT EXISTS {
                    $this nltl:approvedNonlinearBladeStressAnalysis ?analysis .
                }
                BIND((0.6 * ?yield + 0.4 * ?ultimate) AS ?expectedReference)
                BIND((300 * ?c * ?t * ?t * ?expectedReference / (0.8 * ?diameter - 2 * ?r)) AS ?expectedLoad)
                $this nltl:propellerDiameter/qudt:numericValue ?diameter .
                BIND(IF(?expectedReference >= 0, ?expectedReference, -?expectedReference) AS ?referenceScale)
                BIND(IF(?expectedLoad >= 0, ?expectedLoad, -?expectedLoad) AS ?loadScale)
                BIND((?referenceScale * 0.000001 + 0.000001) AS ?referenceTolerance)
                BIND((?loadScale * 0.000001 + 0.000001) AS ?loadTolerance)
                FILTER (
                    ?reportedReference < (?expectedReference - ?referenceTolerance) ||
                    ?reportedReference > (?expectedReference + ?referenceTolerance) ||
                    ?reportedLoad < (?expectedLoad - ?loadTolerance) ||
                    ?reportedLoad > (?expectedLoad + ?loadTolerance)
                )
            }
        """
    ] .
