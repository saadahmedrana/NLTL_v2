@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

<urn:nltl:generated-shape:TRF-113-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship shall record the plastic bending design condition for the blade-loss case."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship shall record the propeller blade orientation causing the maximum component load."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:steeringMechanism
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall identify a steering mechanism subject to the blade-loss plastic-bending design requirement."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterFitting
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall identify a thruster fitting subject to the blade-loss plastic-bending design requirement."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterBody
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall identify a thruster body subject to the blade-loss plastic-bending design requirement."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:datatype xsd:boolean ;
                sh:message "The propulsion load case shall confirm that the maximum component load blade orientation has been considered."
            ]
        ] ;
        sh:message "The ship shall provide a propulsion load case for the blade-loss design assessment."
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "Evidence of the thruster blade-loss design assessment shall be provided."
    ] .

<urn:nltl:generated-shape:TRF-113-DesignEvidenceShape>
    a sh:NodeShape ;
    sh:targetClass nltl:evidenceArtifact .

<urn:nltl:generated-shape:TRF-113-LoadCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:loadCase ;
    sh:property [
        sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:datatype xsd:boolean ;
        sh:message "The load case shall confirm consideration of the blade orientation causing the maximum component load."
    ] .
