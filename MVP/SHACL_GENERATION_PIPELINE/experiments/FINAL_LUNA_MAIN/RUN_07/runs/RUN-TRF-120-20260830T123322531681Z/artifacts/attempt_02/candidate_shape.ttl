@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-120-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node [
            sh:property [
                sh:path nltl:hasNaturalFrequencyCalculationCase ;
                sh:node [
                    sh:class nltl:calculationCase ;
                    sh:property [
                        sh:path nltl:vibrationDirection ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:in (
                            nltl:longitudinalDirection
                            nltl:transverseDirection
                        ) ;
                        sh:message "Each natural-frequency calculation case must specify longitudinal or transverse vibration direction."
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For each linked thruster natural-frequency calculation case, the ship must provide string damping, water added mass in kilograms, and natural frequency in hertz, and the thruster body must provide ship attachment stiffness in kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasComponent ?body .
                ?body a nltl:thrusterBody ;
                      nltl:hasNaturalFrequencyCalculationCase ?case .

                FILTER (
                    NOT EXISTS {
                        $this nltl:damping ?damping .
                        FILTER (datatype(?damping) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:waterAddedMass ?mass .
                        ?mass a qudt:QuantityValue ;
                              qudt:numericValue ?massValue ;
                              qudt:unit unit:KiloGM .
                        FILTER (datatype(?massValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:thrusterNaturalFrequency ?frequency .
                        ?frequency a qudt:QuantityValue ;
                                   qudt:numericValue ?frequencyValue ;
                                   qudt:unit unit:HZ .
                        FILTER (datatype(?frequencyValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?body nltl:shipAttachmentStiffness ?stiffness .
                        ?stiffness a qudt:QuantityValue ;
                                   qudt:numericValue ?stiffnessValue ;
                                   qudt:unit unit:KiloN-PER-M .
                        FILTER (datatype(?stiffnessValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
