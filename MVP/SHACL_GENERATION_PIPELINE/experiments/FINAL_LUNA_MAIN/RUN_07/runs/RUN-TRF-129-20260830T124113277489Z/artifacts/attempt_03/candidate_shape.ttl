@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF129Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceNavigationCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An ice-navigation applicability condition is required."
            ] ;
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The applicability evidence must establish that the ship is navigating in ice."
            ] ;
            sh:property [
                sh:path nltl:coolingWaterSupplySecured ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Cooling water supply must be secured when navigating in ice."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceNavigationCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An ice-navigation applicability condition is required."
            ] ;
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The non-applicable branch requires explicit evidence that the ship is not navigating in ice."
            ]
        ]
    ) .
