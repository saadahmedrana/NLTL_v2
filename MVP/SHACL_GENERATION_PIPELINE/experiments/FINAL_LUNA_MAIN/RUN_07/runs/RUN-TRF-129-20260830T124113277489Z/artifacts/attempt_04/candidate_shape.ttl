@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_129_CoolingWaterSupplyWhenNavigatingInIceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceNavigationCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:minLength 1 ;
                sh:message "A non-empty ice navigation condition is required to establish applicability."
            ] ;
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Navigation in ice must be explicitly established when the cooling-water requirement applies."
            ] ;
            sh:property [
                sh:path nltl:coolingWaterSupplySecured ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Cooling-water supply must be secured when navigating in ice."
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceNavigationCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:minLength 1 ;
                sh:message "A non-empty ice navigation condition is required to establish non-applicability."
            ] ;
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The non-applicable branch requires explicit evidence that the ship is not navigating in ice."
            ]
        ]
    ) .
