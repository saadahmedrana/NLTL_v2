@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF131Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:inletChest
        ] ;
        sh:message "The ship must have an inlet chest; a ballast-water cooling arrangement cannot substitute for it."
    ] ;
    sh:property [
        sh:path nltl:substituteArrangementStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A ballast-water cooling arrangement must not be recorded as a substitute for the inlet chest."
    ] .
