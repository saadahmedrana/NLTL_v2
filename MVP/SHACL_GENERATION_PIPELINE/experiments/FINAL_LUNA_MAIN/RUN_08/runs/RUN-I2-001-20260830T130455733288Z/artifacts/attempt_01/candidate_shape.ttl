@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_001_ApplicableShipShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this a nltl:ship ;
                      nltl:constructionContractDate ?date .
                FILTER (
                    datatype(?date) = xsd:date &&
                    ?date >= "2021-01-01"^^xsd:date
                )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "2021-01-01"^^xsd:date ;
        sh:message "A ship to which UR I2 Rev.4 applies must have a single construction contract date on or after 2021-01-01."
    ] .
