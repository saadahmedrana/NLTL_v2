@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-006_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The astern ice operation intent must be recorded as false when the conditional design requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The astern ice operation intent must be recorded as true when the conditional design requirement is applicable."
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "When astern operation in ice regions is intended, the aft section design basis must use the Bow and Bow Intermediate hull area requirements."
            ]
        ]
    ) .
