@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-006>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:I2-006-astern-false>
        <urn:nltl:generated-shape:I2-006-astern-true>
    ) .

<urn:nltl:generated-shape:I2-006-astern-false>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:asternIceOperationIntent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The astern ice operation intent must be explicitly recorded as false when the conditional hull-area requirement does not apply."
    ] .

<urn:nltl:generated-shape:I2-006-astern-true>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:asternIceOperationIntent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The astern ice operation intent must be explicitly recorded as true for the applicable conditional hull-area requirement."
    ] ;
    sh:property [
        sh:path nltl:hullAreaRequirementSet ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
        sh:message "For astern operation in ice regions, the hull area requirement set must be Bow and Bow Intermediate hull area requirements."
    ] .
