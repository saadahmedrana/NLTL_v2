@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-PressureValueShape> ;
        sh:message "Average ice pressure must be supplied in MPa."
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-ButtockAngleValueShape> ;
        sh:message "The buttock angle at the stem must be greater than 0 degrees and less than 80 degrees."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-AspectRatioValueShape> ;
        sh:message "The load patch aspect ratio must be exactly 3.6 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-LengthValueShape> ;
        sh:message "The non-bow load patch height must be supplied in metres."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-LengthValueShape> ;
        sh:message "The non-bow load patch length must be supplied in metres."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-NormalFrameAngleValueShape> ;
        sh:message "The normal frame angle must be greater than 10 degrees."
    ] ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The hull area identification must be supplied."
    ] ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape> ;
        sh:message "A hull-area assignment for the other ice-strengthened area must be supplied."
    ] .

<urn:nltl:generated-shape:I2-009-HullAreaAssignmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:otherIceStrengthenedAreaValue ;
        sh:message "The assignment must identify the other ice-strengthened area value."
    ] .

<urn:nltl:generated-shape:I2-009-PressureValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

<urn:nltl:generated-shape:I2-009-LengthValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:I2-009-AspectRatioValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

<urn:nltl:generated-shape:I2-009-ButtockAngleValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0.0 ;
        sh:maxExclusive 80.0
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

<urn:nltl:generated-shape:I2-009-NormalFrameAngleValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 10.0
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .
