@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-010> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one permitted Polar Class value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc1
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc2
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc3
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc4
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc5
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:polarClass ;
                        sh:hasValue nltl:polarClassPc6
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bowDesignForceMethod ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "PC6 ships must record the design ice force calculation method."
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:bowVerticalSideStatus ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:hasValue true ;
                                sh:message "The bow must be recorded as having vertical sides."
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:verticalSidedBowForm ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:hasValue true ;
                                sh:message "The bow must be recorded as a vertical-sided bow form."
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:normalFrameAngle ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive 0 ;
                                sh:maxInclusive 10
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:message "Every supplied normal frame angle at the considered sub-regions must be between 0 and 10 degrees inclusive."
                    ]
                ]
            )
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:polarClass ;
                        sh:hasValue nltl:polarClassPc7
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bowDesignForceMethod ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "PC7 ships must record the design ice force calculation method."
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:bowVerticalSideStatus ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:hasValue true ;
                                sh:message "The bow must be recorded as having vertical sides."
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:verticalSidedBowForm ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:hasValue true ;
                                sh:message "The bow must be recorded as a vertical-sided bow form."
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:normalFrameAngle ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive 0 ;
                                sh:maxInclusive 10
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:message "Every supplied normal frame angle at the considered sub-regions must be between 0 and 10 degrees inclusive."
                    ]
                ]
            )
        ]
    ) .
