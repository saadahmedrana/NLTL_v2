@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_011_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;

    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:polarClass ;
                        sh:in (
                            nltl:polarClassPc6
                            nltl:polarClassPc7
                        )
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bulbousBowPresent ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shapeCoefficient ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive "0.6"^^xsd:decimal ;
                                sh:maxInclusive "0.6"^^xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:loadPatchAspectRatio ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive "1.3"^^xsd:decimal ;
                                sh:maxInclusive "1.3"^^xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:MegaN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:MegaN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bowDesignForce ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:KiloN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            )
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bulbousBowPresent ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:polarClass ;
                        sh:in (
                            nltl:polarClassPc1
                            nltl:polarClassPc2
                            nltl:polarClassPc3
                            nltl:polarClassPc4
                            nltl:polarClassPc5
                        )
                    ]
                ]
            )
        ]
    ) ;

    sh:sparql [
        sh:message "For an applicable ship, bowDesignForce must be at least the part-iii force and must agree with the part-iv force within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:bulbousBowPresent true ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:bowDesignForce ?forceNode .

                FILTER (
                    ?polarClass IN (
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    )
                )

                ?iiiNode qudt:numericValue ?iiiValue .
                ?ivNode qudt:numericValue ?ivValue .
                ?forceNode qudt:numericValue ?forceValue .

                FILTER (
                    ?forceValue < (?iiiValue * 1000)
                    ||
                    ABS(?forceValue - (?ivValue * 1000))
                    > (0.000001 * ABS(?ivValue * 1000) + 0.000001)
                )
            }
        """
    ] .
