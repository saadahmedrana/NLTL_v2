@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_014_BowSubregionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ] ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Each bow subregion midpoint must be one of the four equal-subdivision midpoint positions of bowLength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lbNode ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?lbNode qudt:numericValue ?lb .
                ?case nltl:bowSubregionMidLengthPosition ?midNode .
                ?midNode qudt:numericValue ?mid .
                BIND(?lb / 8 AS ?expected1)
                BIND(3 * ?lb / 8 AS ?expected2)
                BIND(5 * ?lb / 8 AS ?expected3)
                BIND(7 * ?lb / 8 AS ?expected4)
                FILTER (
                    ABS(?mid - ?expected1) > (0.000001 * ABS(?expected1) + 0.000000001) &&
                    ABS(?mid - ?expected2) > (0.000001 * ABS(?expected2) + 0.000000001) &&
                    ABS(?mid - ?expected3) > (0.000001 * ABS(?expected3) + 0.000000001) &&
                    ABS(?mid - ?expected4) > (0.000001 * ABS(?expected4) + 0.000000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint at one-quarter of the bow subdivision sequence is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lbNode .
                ?lbNode qudt:numericValue ?lb .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition ?midNode .
                    ?midNode qudt:numericValue ?mid .
                    BIND(?lb / 8 AS ?expected)
                    FILTER(ABS(?mid - ?expected) <= (0.000001 * ABS(?expected) + 0.000000001))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint at three-eighths of bowLength is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lbNode .
                ?lbNode qudt:numericValue ?lb .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition ?midNode .
                    ?midNode qudt:numericValue ?mid .
                    BIND(3 * ?lb / 8 AS ?expected)
                    FILTER(ABS(?mid - ?expected) <= (0.000001 * ABS(?expected) + 0.000000001))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint at five-eighths of bowLength is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lbNode .
                ?lbNode qudt:numericValue ?lb .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition ?midNode .
                    ?midNode qudt:numericValue ?mid .
                    BIND(5 * ?lb / 8 AS ?expected)
                    FILTER(ABS(?mid - ?expected) <= (0.000001 * ABS(?expected) + 0.000000001))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint at seven-eighths of bowLength is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lbNode .
                ?lbNode qudt:numericValue ?lb .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition ?midNode .
                    ?midNode qudt:numericValue ?mid .
                    BIND(7 * ?lb / 8 AS ?expected)
                    FILTER(ABS(?mid - ?expected) <= (0.000001 * ABS(?expected) + 0.000000001))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must equal one reported bow force and be no less than every reported bow force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedForce ?valueNode .
                    ?valueNode qudt:numericValue ?value .
                    FILTER(?selected = ?value)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must not be less than a reported bow force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedNode ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedNode qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedForce ?valueNode .
                ?valueNode qudt:numericValue ?value .
                FILTER(?selected < ?value)
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must equal one reported bow line load and be no less than every reported bow line load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedLineLoad ?valueNode .
                    ?valueNode qudt:numericValue ?value .
                    FILTER(?selected = ?value)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must not be less than a reported bow line load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedNode ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedNode qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedLineLoad ?valueNode .
                ?valueNode qudt:numericValue ?value .
                FILTER(?selected < ?value)
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must equal one reported bow pressure and be no less than every reported bow pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedNode .
                ?selectedNode qudt:numericValue ?selected .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedPressure ?valueNode .
                    ?valueNode qudt:numericValue ?value .
                    FILTER(?selected = ?value)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must not be less than a reported bow pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedNode ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedNode qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedPressure ?valueNode .
                ?valueNode qudt:numericValue ?value .
                FILTER(?selected < ?value)
            }
        """
    ] .
