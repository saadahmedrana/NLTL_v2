@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-014> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The four bow subregion midpoints must distinctly cover L/8, 3L/8, 5L/8, and 7L/8 within a relative tolerance of 1e-6, and each selected maximum must be the corresponding reported maximum within the same tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?l ;
                      nltl:hasBowSubregionCalculationCase ?c1, ?c2, ?c3, ?c4 ;
                      nltl:selectedMaximumBowForce/qudt:numericValue ?sf ;
                      nltl:selectedMaximumBowLineLoad/qudt:numericValue ?sq ;
                      nltl:selectedMaximumBowPressure/qudt:numericValue ?sp .

                FILTER (?c1 != ?c2 && ?c1 != ?c3 && ?c1 != ?c4 &&
                        ?c2 != ?c3 && ?c2 != ?c4 && ?c3 != ?c4)
                FILTER (?l > 0)

                ?c1 nltl:bowSubregionMidLengthPosition/qudt:numericValue ?p1 ;
                    nltl:bowSubregionCalculatedForce/qudt:numericValue ?f1 ;
                    nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?q1 ;
                    nltl:bowSubregionCalculatedPressure/qudt:numericValue ?r1 .
                ?c2 nltl:bowSubregionMidLengthPosition/qudt:numericValue ?p2 ;
                    nltl:bowSubregionCalculatedForce/qudt:numericValue ?f2 ;
                    nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?q2 ;
                    nltl:bowSubregionCalculatedPressure/qudt:numericValue ?r2 .
                ?c3 nltl:bowSubregionMidLengthPosition/qudt:numericValue ?p3 ;
                    nltl:bowSubregionCalculatedForce/qudt:numericValue ?f3 ;
                    nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?q3 ;
                    nltl:bowSubregionCalculatedPressure/qudt:numericValue ?r3 .
                ?c4 nltl:bowSubregionMidLengthPosition/qudt:numericValue ?p4 ;
                    nltl:bowSubregionCalculatedForce/qudt:numericValue ?f4 ;
                    nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?q4 ;
                    nltl:bowSubregionCalculatedPressure/qudt:numericValue ?r4 .

                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?cx .
                    ?cx nltl:bowSubregionMidLengthPosition/qudt:numericValue ?px .
                    FILTER (?px < (?l / 8) * (1 - 0.000001) ||
                            ?px > (?l / 8) * (1 + 0.000001))
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?cx .
                    ?cx nltl:bowSubregionMidLengthPosition/qudt:numericValue ?px .
                    FILTER (?px < (3 * ?l / 8) * (1 - 0.000001) ||
                            ?px > (3 * ?l / 8) * (1 + 0.000001))
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?cx .
                    ?cx nltl:bowSubregionMidLengthPosition/qudt:numericValue ?px .
                    FILTER (?px < (5 * ?l / 8) * (1 - 0.000001) ||
                            ?px > (5 * ?l / 8) * (1 + 0.000001))
                }
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?cx .
                    ?cx nltl:bowSubregionMidLengthPosition/qudt:numericValue ?px .
                    FILTER (?px < (7 * ?l / 8) * (1 - 0.000001) ||
                            ?px > (7 * ?l / 8) * (1 + 0.000001))
                }

                FILTER (
                    (
                        ?f1 >= ?f2 && ?f1 >= ?f3 && ?f1 >= ?f4 &&
                        ?sf >= ?f1 &&
                        ?sf >= ?f2 && ?sf >= ?f3 && ?sf >= ?f4 &&
                        ?sf >= ?f1 * (1 - 0.000001) &&
                        ?sf <= ?f1 * (1 + 0.000001)
                    ) ||
                    (
                        ?f2 >= ?f1 && ?f2 >= ?f3 && ?f2 >= ?f4 &&
                        ?sf >= ?f1 && ?sf >= ?f2 && ?sf >= ?f3 && ?sf >= ?f4 &&
                        ?sf >= ?f2 * (1 - 0.000001) &&
                        ?sf <= ?f2 * (1 + 0.000001)
                    ) ||
                    (
                        ?f3 >= ?f1 && ?f3 >= ?f2 && ?f3 >= ?f4 &&
                        ?sf >= ?f1 && ?sf >= ?f2 && ?sf >= ?f3 && ?sf >= ?f4 &&
                        ?sf >= ?f3 * (1 - 0.000001) &&
                        ?sf <= ?f3 * (1 + 0.000001)
                    ) ||
                    (
                        ?f4 >= ?f1 && ?f4 >= ?f2 && ?f4 >= ?f3 &&
                        ?sf >= ?f1 && ?sf >= ?f2 && ?sf >= ?f3 && ?sf >= ?f4 &&
                        ?sf >= ?f4 * (1 - 0.000001) &&
                        ?sf <= ?f4 * (1 + 0.000001)
                    )
                )

                FILTER (
                    (
                        ?q1 >= ?q2 && ?q1 >= ?q3 && ?q1 >= ?q4 &&
                        ?sq >= ?q1 && ?sq >= ?q2 && ?sq >= ?q3 && ?sq >= ?q4 &&
                        ?sq >= ?q1 * (1 - 0.000001) &&
                        ?sq <= ?q1 * (1 + 0.000001)
                    ) ||
                    (
                        ?q2 >= ?q1 && ?q2 >= ?q3 && ?q2 >= ?q4 &&
                        ?sq >= ?q1 && ?sq >= ?q2 && ?sq >= ?q3 && ?sq >= ?q4 &&
                        ?sq >= ?q2 * (1 - 0.000001) &&
                        ?sq <= ?q2 * (1 + 0.000001)
                    ) ||
                    (
                        ?q3 >= ?q1 && ?q3 >= ?q2 && ?q3 >= ?q4 &&
                        ?sq >= ?q1 && ?sq >= ?q2 && ?sq >= ?q3 && ?sq >= ?q4 &&
                        ?sq >= ?q3 * (1 - 0.000001) &&
                        ?sq <= ?q3 * (1 + 0.000001)
                    ) ||
                    (
                        ?q4 >= ?q1 && ?q4 >= ?q2 && ?q4 >= ?q3 &&
                        ?sq >= ?q1 && ?sq >= ?q2 && ?sq >= ?q3 && ?sq >= ?q4 &&
                        ?sq >= ?q4 * (1 - 0.000001) &&
                        ?sq <= ?q4 * (1 + 0.000001)
                    )
                )

                FILTER (
                    (
                        ?r1 >= ?r2 && ?r1 >= ?r3 && ?r1 >= ?r4 &&
                        ?sp >= ?r1 && ?sp >= ?r2 && ?sp >= ?r3 && ?sp >= ?r4 &&
                        ?sp >= ?r1 * (1 - 0.000001) &&
                        ?sp <= ?r1 * (1 + 0.000001)
                    ) ||
                    (
                        ?r2 >= ?r1 && ?r2 >= ?r3 && ?r2 >= ?r4 &&
                        ?sp >= ?r1 && ?sp >= ?r2 && ?sp >= ?r3 && ?sp >= ?r4 &&
                        ?sp >= ?r2 * (1 - 0.000001) &&
                        ?sp <= ?r2 * (1 + 0.000001)
                    ) ||
                    (
                        ?r3 >= ?r1 && ?r3 >= ?r2 && ?r3 >= ?r4 &&
                        ?sp >= ?r1 && ?sp >= ?r2 && ?sp >= ?r3 && ?sp >= ?r4 &&
                        ?sp >= ?r3 * (1 - 0.000001) &&
                        ?sp <= ?r3 * (1 + 0.000001)
                    ) ||
                    (
                        ?r4 >= ?r1 && ?r4 >= ?r2 && ?r4 >= ?r3 &&
                        ?sp >= ?r1 && ?sp >= ?r2 && ?sp >= ?r3 && ?sp >= ?r4 &&
                        ?sp >= ?r4 * (1 - 0.000001) &&
                        ?sp <= ?r4 * (1 + 0.000001)
                    )
                )
            }
        """
    ] .
