@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_019_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_019_StructuralMemberShape
    ] .

gen:I2_019_StructuralMemberShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:maxCount 0
            ]
        ]
        gen:I2_019_ApplicableStructuralMemberShape
    ) .

gen:I2_019_ApplicableStructuralMemberShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:minCount 1 ;
        sh:node gen:I2_019_HullAreaValueShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_019_SelectedFactorQuantityShape
    ] ;
    sh:sparql [
        sh:message "selectedHullAreaFactor must equal the maximum spanned hull area factor within the permitted calculation tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:selectedHullAreaFactor ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selectedValue .

                {
                    SELECT $this (MAX(?factorValue) AS ?expectedMaximum)
                    WHERE {
                        $this nltl:hasSpannedHullArea ?hullArea .
                        ?hullArea nltl:hullAreaFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factorValue .
                    }
                    GROUP BY $this
                }

                BIND(
                    IF(
                        (0.000001 * ?expectedMaximum) > 0.000000000001,
                        (0.000001 * ?expectedMaximum),
                        0.000000000001
                    )
                    AS ?tolerance
                )

                FILTER(
                    (?selectedValue < (?expectedMaximum - ?tolerance)) ||
                    (?selectedValue > (?expectedMaximum + ?tolerance))
                )
            }
        """
    ] .

gen:I2_019_HullAreaValueShape a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_019_FactorQuantityShape
    ] .

gen:I2_019_FactorQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_019_SelectedFactorQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
