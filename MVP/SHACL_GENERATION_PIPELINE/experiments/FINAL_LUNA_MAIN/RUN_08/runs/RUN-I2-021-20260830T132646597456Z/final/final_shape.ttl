@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_021_ShellPlatingThicknessShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasPlating ;
    sh:property [
        sh:path nltl:thickness ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAllowance ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For each linked plating item, thickness in millimetres must equal iceLoadRequiredNetPlateThickness plus corrosionAbrasionAllowance within a relative tolerance of 1e-6, with an absolute fallback of 1e-6 mm near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:thickness ?thicknessQuantity ;
                       nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                       nltl:corrosionAbrasionAllowance ?allowanceQuantity .

                ?thicknessQuantity qudt:numericValue ?thickness ;
                                    qudt:unit unit:MilliM .
                ?netQuantity qudt:numericValue ?net ;
                             qudt:unit unit:MilliM .
                ?allowanceQuantity qudt:numericValue ?allowance ;
                                    qudt:unit unit:MilliM .

                BIND((?net + ?allowance) AS ?expected)
                BIND((0.000001 * IF(?expected > 1, ?expected, 1)) AS ?tolerance)

                FILTER (
                    ?thickness < (?expected - ?tolerance)
                    || ?thickness > (?expected + ?tolerance)
                )
            }
        """
    ] .
