@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:I2-022-ComplexReadiness> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked plating must provide a valid framing angle in degrees so applicability can be established." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPlating ?plating .
                FILTER NOT EXISTS {
                    ?plating nltl:framingAngleOmega ?angle .
                    ?angle qudt:numericValue ?angleValue ;
                           qudt:unit unit:DEG .
                    FILTER (datatype(?angleValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicable transversely-framed plating must provide the declared external-calculation inputs, structural-member relationship, and externally computed net-thickness result with the required units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPlating ?plating .

                ?plating nltl:framingAngleOmega ?angle ;
                         nltl:platingHullAreaClassification ?area ;
                         nltl:platingSupportedByStructuralMember ?member .

                ?angle qudt:numericValue ?angleValue ;
                       qudt:unit unit:DEG .
                FILTER (datatype(?angleValue) = xsd:decimal)
                FILTER (?angleValue >= 70)

                FILTER (?area IN (
                    nltl:bowIntermediateBottomHullArea,
                    nltl:midbodyBottomHullArea,
                    nltl:sternBottomHullArea
                ))

                FILTER NOT EXISTS {
                    $this nltl:averageIcePressure ?averagePressure .
                    ?averagePressure qudt:numericValue ?averagePressureValue ;
                                     qudt:unit unit:MegaPA .
                    FILTER (datatype(?averagePressureValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:peakPressureFactor ?peakFactor .
                    ?peakFactor qudt:numericValue ?peakFactorValue ;
                                qudt:unit unit:UNITLESS .
                    FILTER (datatype(?peakFactorValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:yieldStrength ?yieldStrengthValue .
                    ?yieldStrengthValue qudt:numericValue ?yieldStrengthNumeric ;
                                         qudt:unit unit:MegaPA .
                    FILTER (datatype(?yieldStrengthNumeric) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:loadPatchHeight ?loadHeight .
                    ?loadHeight qudt:numericValue ?loadHeightValue ;
                                qudt:unit unit:M .
                    FILTER (datatype(?loadHeightValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?member nltl:frameSpacing ?spacing .
                    ?spacing qudt:numericValue ?spacingValue ;
                             qudt:unit unit:M .
                    FILTER (datatype(?spacingValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?member nltl:selectedHullAreaFactor ?selectedFactor .
                    ?selectedFactor qudt:numericValue ?selectedFactorValue ;
                                    qudt:unit unit:UNITLESS .
                    FILTER (datatype(?selectedFactorValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?plating nltl:iceLoadRequiredNetPlateThickness ?result .
                    ?result qudt:numericValue ?resultValue ;
                           qudt:unit unit:MilliM .
                    FILTER (datatype(?resultValue) = xsd:decimal)
                }
            }
        """
    ] .
