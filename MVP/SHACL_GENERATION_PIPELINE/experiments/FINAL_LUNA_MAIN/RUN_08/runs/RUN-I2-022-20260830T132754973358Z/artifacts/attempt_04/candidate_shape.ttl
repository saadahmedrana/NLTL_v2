@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_022_ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable transversely framed plating case must provide the declared relationships, operands, and externally computed net thickness result with the canonical units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:hasPlating ?plating .

                ?plating a nltl:plating ;
                         nltl:framingAngleOmega ?angle ;
                         nltl:platingHullAreaClassification ?area .

                ?angle qudt:numericValue ?omega ;
                       qudt:unit qudt:DEG .

                FILTER (?area IN (
                    nltl:bowIntermediateBottomHullArea,
                    nltl:midbodyBottomHullArea,
                    nltl:sternBottomHullArea
                ))
                FILTER (?omega >= 70)

                FILTER (
                    NOT EXISTS {
                        ?area a nltl:hullAreaValue
                    }
                    ||
                    NOT EXISTS {
                        ?plating nltl:platingSupportedByStructuralMember ?member .
                        ?member a nltl:structuralMember .
                    }
                    ||
                    NOT EXISTS {
                        ?plating nltl:iceLoadRequiredNetPlateThickness ?result .
                        ?result qudt:numericValue ?resultNumber ;
                               qudt:unit qudt:MilliM .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:averageIcePressure ?averagePressure .
                        ?averagePressure qudt:numericValue ?averagePressureNumber ;
                                          qudt:unit qudt:MegaPA .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:peakPressureFactor ?peakFactor .
                        ?peakFactor qudt:numericValue ?peakFactorNumber ;
                                   qudt:unit qudt:UNITLESS .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldStrength ?yield .
                        ?yield qudt:numericValue ?yieldNumber ;
                               qudt:unit qudt:MegaPA .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:loadPatchHeight ?patchHeight .
                        ?patchHeight qudt:numericValue ?patchHeightNumber ;
                                     qudt:unit qudt:M .
                    }
                    ||
                    NOT EXISTS {
                        ?plating nltl:platingSupportedByStructuralMember ?member2 .
                        ?member2 a nltl:structuralMember ;
                                 nltl:frameSpacing ?spacing .
                        ?spacing qudt:numericValue ?spacingNumber ;
                                qudt:unit qudt:M .
                    }
                    ||
                    NOT EXISTS {
                        ?plating nltl:platingSupportedByStructuralMember ?member3 .
                        ?member3 a nltl:structuralMember ;
                                 nltl:selectedHullAreaFactor ?selectedFactor .
                        ?selectedFactor qudt:numericValue ?selectedFactorNumber ;
                                        qudt:unit qudt:UNITLESS .
                    }
                )
            }
        """
    ] .
