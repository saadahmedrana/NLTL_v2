@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-030-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember
    ] .

<urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:localFrameSectionCalculationCase
    ] .

<urn:nltl:generated-shape:I2-030-PlatingShape>
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

<urn:nltl:generated-shape:I2-030-LocalFrameSectionCalculationCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:class nltl:plating
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember
    ] .

<urn:nltl:generated-shape:I2-030-CalculationCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:or (
            [
                sh:path nltl:plasticNeutralAxisHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
            [
                sh:path nltl:plasticNeutralAxisHeight ;
                sh:sparql [
                    sh:message "Plastic neutral axis height is required when the local-frame area exceeds the attached-plate-flange area." ;
                    sh:select """
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>
                        PREFIX qudt: <http://qudt.org/schema/qudt/>
                        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                        SELECT $this
                        WHERE {
                            ?ship nltl:hasCalculationCase $this ;
                                  nltl:hasStructuralMember ?member .
                            ?member nltl:netLocalFrameFlangeArea ?area ;
                                    nltl:netAttachedShellPlateThickness ?thickness ;
                                    nltl:frameSpacing ?spacing .
                            ?area qudt:numericValue ?areaValue .
                            ?thickness qudt:numericValue ?thicknessValue .
                            ?spacing qudt:numericValue ?spacingValue .
                            FILTER (
                                100 * xsd:decimal(?areaValue) >
                                1000 * xsd:decimal(?thicknessValue) *
                                xsd:decimal(?spacingValue)
                            )
                        }
                    """
                ]
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:or (
            [
                sh:path nltl:interpolationLowerEndpoint ;
                sh:minCount 1 ;
                sh:class nltl:interpolationPoint
            ]
            [
                sh:path nltl:interpolationLowerEndpoint ;
                sh:sparql [
                    sh:message "An interpolation lower endpoint is required for oblique framing between 20 and 70 degrees." ;
                    sh:select """
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>
                        PREFIX qudt: <http://qudt.org/schema/qudt/>
                        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                        SELECT $this
                        WHERE {
                            ?ship nltl:hasCalculationCase $this ;
                                  nltl:hasStructuralMember ?member .
                            ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                            ?localCase nltl:sectionCalculationCasePlating ?plating .
                            ?plating nltl:framingAngleOmega ?angle .
                            ?angle qudt:numericValue ?angleValue .
                            FILTER (
                                xsd:decimal(?angleValue) > 20 &&
                                xsd:decimal(?angleValue) < 70
                            )
                        }
                    """
                ]
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:or (
            [
                sh:path nltl:interpolationUpperEndpoint ;
                sh:minCount 1 ;
                sh:class nltl:interpolationPoint
            ]
            [
                sh:path nltl:interpolationUpperEndpoint ;
                sh:sparql [
                    sh:message "An interpolation upper endpoint is required for oblique framing between 20 and 70 degrees." ;
                    sh:select """
                        PREFIX nltl: <https://w3id.org/nltl/vocab#>
                        PREFIX qudt: <http://qudt.org/schema/qudt/>
                        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                        SELECT $this
                        WHERE {
                            ?ship nltl:hasCalculationCase $this ;
                                  nltl:hasStructuralMember ?member .
                            ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                            ?localCase nltl:sectionCalculationCasePlating ?plating .
                            ?plating nltl:framingAngleOmega ?angle .
                            ?angle qudt:numericValue ?angleValue .
                            FILTER (
                                xsd:decimal(?angleValue) > 20 &&
                                xsd:decimal(?angleValue) < 70
                            )
                        }
                    """
                ]
            ]
        )
    ] .

<urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    a sh:NodeShape ;
    sh:targetClass nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
