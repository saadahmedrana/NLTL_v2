@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-034> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable longitudinal side frame must provide plastic strength and its defining midspan plastic collapse load, and every represented load-case demand must not exceed the plastic strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation .

                {
                    FILTER NOT EXISTS {
                        ?member nltl:plasticStrength ?ps .
                        ?ps qudt:numericValue ?pvalue ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?pvalue) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?mc .
                        ?mc qudt:numericValue ?mvalue ;
                           qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        FILTER (datatype(?mvalue) = xsd:decimal)
                    }
                }
                UNION
                {
                    ?member nltl:plasticStrength ?ps .
                    ?ps qudt:numericValue ?pvalue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER (datatype(?pvalue) = xsd:decimal)

                    ?member nltl:midspanPlasticCollapseLoad ?mc .
                    ?mc qudt:numericValue ?mvalue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER (datatype(?mvalue) = xsd:decimal)

                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                    {
                        FILTER NOT EXISTS {
                            ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                            ?demand qudt:numericValue ?dvalue .
                            FILTER (datatype(?dvalue) = xsd:decimal)
                        }
                    }
                    UNION
                    {
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?dvalue .
                        FILTER (
                            datatype(?dvalue) = xsd:decimal &&
                            ?dvalue > ?pvalue
                        )
                    }
                }
            }
        """ ;
    ] .
