@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-046-PolarClassCorrosionAbrasionAdditionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one polarClassRequirementsApplicable boolean is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:polarClassValue ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                ) ;
                sh:message "An applicable ship must have exactly one valid polarClass value."
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:hasInternalIceStrengthenedStructure ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:internalStructureCorrosionAbrasionAddition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "1.0"^^xsd:decimal ;
                        sh:message "The internal structure corrosion/abrasion addition must be at least 1.0 mm."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                        sh:message "The internal structure corrosion/abrasion addition must use exactly one millimetre unit."
                    ]
                ] ;
                sh:message "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition."
            ]
        ]
    ] .
