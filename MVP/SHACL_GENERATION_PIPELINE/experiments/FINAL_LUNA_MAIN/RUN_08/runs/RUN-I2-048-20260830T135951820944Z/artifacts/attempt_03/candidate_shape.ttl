@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:SteelGradeRequirementCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must identify exactly one plating."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gs:ThicknessQuantityShape ;
        sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:message "Each steel-grade requirement case must provide exactly one permitted steel material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:message "Each steel-grade requirement case must provide exactly one permitted steel strength category."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:message "Each steel-grade requirement case must provide exactly one permitted actual steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:message "An applicable Table 8 case must have at most one permitted required steel grade."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required steel grade does not match the complete IACS UR I2 Table 8 selection, or a NOT_APPLICABLE selection has an impermissible result." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?th ;
        nltl:steelMaterialClass ?mc ;
        nltl:steelStrengthCategory ?sc .
  ?th qudt:numericValue ?t ;
      qudt:unit nltl:MilliM .
  FILTER (
    (
      (
        (
          (?t <= 10 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo)) ||
          (?t <= 10 && ?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 10 && ?t <= 25 && ?mc = nltl:steelMaterialClassOne) ||
          (?t > 10 && ?t <= 25 && ?mc IN (nltl:steelMaterialClassTwo,nltl:steelMaterialClassThree) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 25 && ?t <= 35 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 25 && ?t <= 35 && ?mc = nltl:steelMaterialClassThree) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassOne) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassTwo && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassThree) ||
          (?t > 45 && ?t <= 50 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 45 && ?t <= 50 && ?mc = nltl:steelMaterialClassThree && ?pc = nltl:polarClassPc6)
        )
        && ?sc = nltl:normalStrengthSteelCategory
        && NOT EXISTS {
          $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeB
        }
      )
      ||
      (
        (
          (?t <= 10 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo)) ||
          (?t <= 10 && ?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 10 && ?t <= 25 && ?mc = nltl:steelMaterialClassOne) ||
          (?t > 10 && ?t <= 25 && ?mc IN (nltl:steelMaterialClassTwo,nltl:steelMaterialClassThree) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 25 && ?t <= 35 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 25 && ?t <= 35 && ?mc = nltl:steelMaterialClassThree) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassOne) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassTwo && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassThree) ||
          (?t > 45 && ?t <= 50 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 45 && ?t <= 50 && ?mc = nltl:steelMaterialClassThree && ?pc = nltl:polarClassPc6)
        )
        && ?sc = nltl:highTensileSteelCategory
        && NOT EXISTS {
          $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeAh
        }
      )
      ||
      (
        (
          (?t > 10 && ?t <= 25 && ?mc = nltl:steelMaterialClassTwo && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5)) ||
          (?t > 10 && ?t <= 25 && ?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 25 && ?t <= 35 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5)) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassOne) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassTwo && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5)) ||
          (?t > 45 && ?t <= 50 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7))
        )
        && ?sc = nltl:normalStrengthSteelCategory
        && NOT EXISTS {
          $this nltl:requiredHullStructuralSteelGrade ?r
          FILTER (?r IN (nltl:steelGradeD,nltl:steelGradeE))
        }
      )
      ||
      (
        (
          (?t > 10 && ?t <= 25 && ?mc = nltl:steelMaterialClassTwo && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5)) ||
          (?t > 10 && ?t <= 25 && ?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7)) ||
          (?t > 25 && ?t <= 35 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5)) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassOne) ||
          (?t > 35 && ?t <= 45 && ?mc = nltl:steelMaterialClassTwo && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5)) ||
          (?t > 45 && ?t <= 50 && ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7))
        )
        && ?sc = nltl:highTensileSteelCategory
        && NOT EXISTS {
          $this nltl:requiredHullStructuralSteelGrade ?r
          FILTER (?r IN (nltl:steelGradeDh,nltl:steelGradeEh))
        }
      )
      ||
      (
        (?t > 35 && ?t <= 50 && ?mc = nltl:steelMaterialClassThree &&
         ?sc = nltl:normalStrengthSteelCategory &&
         ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5))
        && EXISTS { $this nltl:requiredHullStructuralSteelGrade ?r }
      )
      ||
      (
        (?t > 35 && ?t <= 50 && ?mc = nltl:steelMaterialClassThree &&
         ?sc = nltl:highTensileSteelCategory &&
         ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5))
        && NOT EXISTS {
          $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeFh
        }
      )
    )
  )
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual steel grade is not at least the required grade within the same steel-strength family." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:actualHullStructuralSteelGrade ?actual ;
        nltl:requiredHullStructuralSteelGrade ?required .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  ?required nltl:steelGradeOrderRank ?requiredRank .
  FILTER (
    (
      (?actual IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh) &&
       ?required IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh))
      ||
      (?actual IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE) &&
       ?required IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE))
    )
    &&
    ?actualRank < ?requiredRank
  )
}
""" ;
    ] .

gs:ThicknessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 50
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "Each ship assessed by a steel-grade requirement case must provide one permitted Polar Class."
    ] .

gs:SteelGradeValueShape
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeValue ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
