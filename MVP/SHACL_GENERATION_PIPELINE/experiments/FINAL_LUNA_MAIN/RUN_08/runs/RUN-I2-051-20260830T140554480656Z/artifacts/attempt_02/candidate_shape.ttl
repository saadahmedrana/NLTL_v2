@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-051-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shearForceDirection ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:positiveShearForce
                    ] ;
                    sh:property [
                        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:minInclusive "0"^^xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:M ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:sparql [
                        sh:message "For a positive shear-force case at or before 0.6 LUI from aft, the longitudinal distribution factor must be exactly 0.0." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position <= (?length * "0.6"^^xsd:decimal))
                                FILTER (?factor < "0.0"^^xsd:decimal || ?factor > "0.0"^^xsd:decimal)
                            }
                        """
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shearForceDirection ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:positiveShearForce
                    ] ;
                    sh:property [
                        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:maxInclusive "0"^^xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:M ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:sparql [
                        sh:message "For a positive shear-force case between 0.9 LUI and the forward end of LUI, the longitudinal distribution factor must be exactly 1.0." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                                ?positionQuantity qudt:numericValue ?position .
                                ?ship nltl:hasCalculationCase $this ;
                                       nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                                       nltl:longitudinalDistributionFactor ?factorQuantity .
                                ?lengthQuantity qudt:numericValue ?length .
                                ?factorQuantity qudt:numericValue ?factor .
                                FILTER (?position >= (?length * "0.9"^^xsd:decimal))
                                FILTER (?position <= ?length)
                                FILTER (?factor < "1.0"^^xsd:decimal || ?factor > "1.0"^^xsd:decimal)
                            }
                        """
                    ]
                ]
            )
        ]
    ] ;

    sh:sparql [
        sh:message "The design vertical ice shear force must equal the applicable longitudinal distribution factor multiplied by the design vertical ice force at bow, with unit conversion from MN to kN and a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?bowQuantity ;
                      nltl:designVerticalIceShearForce ?shearQuantity ;
                      nltl:longitudinalDistributionFactor ?factorQuantity ;
                      nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                      nltl:hasCalculationCase ?case .
                ?bowQuantity qudt:numericValue ?bow .
                ?shearQuantity qudt:numericValue ?shear .
                ?factorQuantity qudt:numericValue ?factor .
                ?lengthQuantity qudt:numericValue ?length .
                ?case nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity ;
                      nltl:shearForceDirection nltl:positiveShearForce .
                ?positionQuantity qudt:numericValue ?position .
                FILTER (
                    (?position >= "0"^^xsd:decimal &&
                     ?position <= (?length * "0.6"^^xsd:decimal)) ||
                    (?position >= (?length * "0.9"^^xsd:decimal) &&
                     ?position <= ?length)
                )
                BIND(?factor * ?bow * "1000"^^xsd:decimal AS ?expected)
                FILTER (
                    ABS(?shear - ?expected) >
                    ("0.000001"^^xsd:decimal * ABS(?expected) +
                     "0.000001"^^xsd:decimal)
                )
            }
        """
    ] .
