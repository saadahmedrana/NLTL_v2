@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PositiveShearCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:shearForceDirection ;
        sh:hasValue nltl:positiveShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each calculation case shall identify positive shear force."
    ] ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each positive-shear calculation case shall provide its hull-girder position from aft in metres."
    ] .

gen:PositiveShearCfZeroBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.0"^^xsd:decimal ;
                sh:maxInclusive "0.0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:PositiveShearCalculationCaseShape
    ] .

gen:PositiveShearCfOneBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.0"^^xsd:decimal ;
                sh:maxInclusive "1.0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:PositiveShearCalculationCaseShape
    ] .

gen:DesignVerticalIceShearForceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The design vertical ice force at bow shall be provided in MN."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The upper ice waterline length LUI shall be provided in metres."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The derived design vertical ice shear force shall be provided in kN."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:PositiveShearCalculationCaseShape
    ] ;
    sh:or (
        gen:PositiveShearCfZeroBranch
        gen:PositiveShearCfOneBranch
    ) ;
    sh:sparql [
        sh:message "For every positive-shear calculation case, the position shall be within the applicable inclusive interval and the reported shear force shall equal Cf times the bow force converted from MN to kN within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case ;
                      nltl:designVerticalIceForceAtBow ?fibNode ;
                      nltl:upperIceWaterlineLengthLUI ?luiNode ;
                      nltl:longitudinalDistributionFactor ?cfNode ;
                      nltl:designVerticalIceShearForce ?fiNode .

                ?case nltl:shearForceDirection nltl:positiveShearForce ;
                      nltl:hullGirderLongitudinalPositionFromAft ?positionNode .

                ?fibNode qudt:numericValue ?fib .
                ?luiNode qudt:numericValue ?lui .
                ?cfNode qudt:numericValue ?cf .
                ?fiNode qudt:numericValue ?fi .
                ?positionNode qudt:numericValue ?position .

                BIND(
                    IF(
                        ?position >= 0.0 && ?position <= (0.6 * ?lui),
                        0.0,
                        1.0
                    ) AS ?expectedCf
                )
                BIND((?expectedCf * ?fib * 1000.0) AS ?expectedFi)

                FILTER(
                    (
                        (
                            ?position < 0.0 ||
                            ?position > (0.6 * ?lui) ||
                            ?cf != 0.0
                        )
                        &&
                        (
                            ?position < (0.9 * ?lui) ||
                            ?position > ?lui ||
                            ?cf != 1.0
                        )
                    )
                    ||
                    ABS(?fi - ?expectedFi) >
                    (0.000001 * ABS(?expectedFi))
                )
            }
        """
    ] .
