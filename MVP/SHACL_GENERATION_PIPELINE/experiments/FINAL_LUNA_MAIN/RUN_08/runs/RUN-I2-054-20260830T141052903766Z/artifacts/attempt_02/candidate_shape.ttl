@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-054-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:hasInterpolationPoint ;
                sh:minCount 5 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The calculation case must contain paired interpolation points for C_m = 0.0 at 0.0 and 1.0, 1.0 at 0.5 and 0.7, 0.3 at 0.95, and 0.0 at 1.0; intermediate values are determined by linear interpolation." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER (
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p0 .
                                ?p0 nltl:interpolationPointCoordinate ?cq0 ;
                                    nltl:interpolationPointResult ?rq0 .
                                ?cq0 qudt:numericValue ?c0 .
                                ?rq0 qudt:numericValue ?r0 .
                                FILTER(?c0 >= 0.0 && ?c0 <= 0.0 && ?r0 >= 0.0 && ?r0 <= 0.0)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p1 .
                                ?p1 nltl:interpolationPointCoordinate ?cq1 ;
                                    nltl:interpolationPointResult ?rq1 .
                                ?cq1 qudt:numericValue ?c1 .
                                ?rq1 qudt:numericValue ?r1 .
                                FILTER(?c1 >= 0.5 && ?c1 <= 0.5 && ?r1 >= 1.0 && ?r1 <= 1.0)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p2 .
                                ?p2 nltl:interpolationPointCoordinate ?cq2 ;
                                    nltl:interpolationPointResult ?rq2 .
                                ?cq2 qudt:numericValue ?c2 .
                                ?rq2 qudt:numericValue ?r2 .
                                FILTER(?c2 >= 0.7 && ?c2 <= 0.7 && ?r2 >= 1.0 && ?r2 <= 1.0)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p3 .
                                ?p3 nltl:interpolationPointCoordinate ?cq3 ;
                                    nltl:interpolationPointResult ?rq3 .
                                ?cq3 qudt:numericValue ?c3 .
                                ?rq3 qudt:numericValue ?r3 .
                                FILTER(?c3 >= 0.95 && ?c3 <= 0.95 && ?r3 >= 0.3 && ?r3 <= 0.3)
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasInterpolationPoint ?p4 .
                                ?p4 nltl:interpolationPointCoordinate ?cq4 ;
                                    nltl:interpolationPointResult ?rq4 .
                                ?cq4 qudt:numericValue ?c4 .
                                ?rq4 qudt:numericValue ?r4 .
                                FILTER(?c4 >= 1.0 && ?c4 <= 1.0 && ?r4 >= 0.0 && ?r4 <= 0.0)
                            }
                        )
                    }
                """
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:hullGirderBendingMomentCalculationCase ;
            sh:property [
                sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:caseBendingMomentDistributionFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:caseDesignVerticalIceBendingMoment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:MegaN-M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
