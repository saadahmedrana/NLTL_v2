@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2_064_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node nltl:I2_064_CalculationCaseShape ;
        sh:message "A calculation case with the applicable calculation method is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_064_YieldStrengthShape ;
        sh:message "Yield strength in MPa is required for the direct checks."
    ] ;
    sh:sparql [
        sh:message "For a linear calculation case, nominal shear stress in every member web must be less than yield strength divided by sqrt(3)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue ;
                                qudt:unit qudt:MegaPA .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb ?web .
                ?web nltl:nominalShearStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue ;
                                qudt:unit qudt:MegaPA .
                FILTER ( ! ( ?stressValue < ( ?yieldValue / 1.7320508075688772 ) ) )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a linear calculation case, nominal flange von Mises stress in every member flange must be less than 1.15 times yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue ;
                                qudt:unit qudt:MegaPA .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange ?flange .
                ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue ;
                                qudt:unit qudt:MegaPA .
                FILTER ( ! ( ?stressValue < ( 1.15 * ?yieldValue ) ) )
            }
        """
    ] .

nltl:I2_064_CalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:linearCalculationMethodValue ;
        sh:message "The calculation case must identify the linear calculation method."
    ] .

nltl:I2_064_YieldStrengthShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:MegaPA ;
    ] .

nltl:I2_064_StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasStructuralMemberWeb ;
        sh:minCount 1 ;
        sh:node nltl:I2_064_WebShape ;
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberFlange ;
        sh:minCount 1 ;
        sh:node nltl:I2_064_FlangeShape ;
    ] ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Applicable buckling criteria must be satisfied."
    ] .

nltl:I2_064_WebShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMemberWeb ;
    sh:property [
        sh:path nltl:nominalShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_064_StressShape ;
        sh:message "Nominal shear stress is required for each member web."
    ] .

nltl:I2_064_FlangeShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMemberFlange ;
    sh:property [
        sh:path nltl:nominalFlangeVonMisesStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_064_StressShape ;
        sh:message "Nominal flange von Mises stress is required for each member flange."
    ] .

nltl:I2_064_StressShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:MegaPA ;
    ] .
