@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_066_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node gen:I2_066_WeldShape
    ] .

gen:I2_066_WeldShape a sh:NodeShape ;
    sh:class nltl:weld ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:weldType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:doubleContinuousWeld ;
                sh:message "Welding within an ice-strengthened area must be double continuous."
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "Each weld must explicitly indicate whether it is within an ice-strengthened area."
.
