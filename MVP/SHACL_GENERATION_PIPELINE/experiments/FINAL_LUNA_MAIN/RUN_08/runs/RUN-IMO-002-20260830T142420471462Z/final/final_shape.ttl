@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO002ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its design ice condition to establish the applicable category condition."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCategoryValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its Polar Code category."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB
            ] ;
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:in (
                    nltl:thinFirstYearIceWithPossibleOldIceInclusions
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryC
                )
            ]
        ]
    ) ;
    sh:message "A ship must be Category A, or must be Category B when designed for at least thin first-year ice including possible old-ice inclusions; only a less-severe-than-A-and-B design condition may be a non-B exception." .
