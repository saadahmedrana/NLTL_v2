@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO006ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must specify its ice type classification." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:hasValue nltl:mediumFirstYearIce ;
            ] ;
            sh:property [
                sh:path nltl:iceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "0.7"^^xsd:decimal ;
                        sh:maxInclusive "1.2"^^xsd:decimal ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                ] ;
                sh:message "For medium first-year ice, ice thickness must be between 0.7 m and 1.2 m inclusive." ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:in ( nltl:firstYearIce nltl:thinFirstYearIce ) ;
            ] ;
        ]
    ) .
