@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_009_BergyWatersShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For bergy waters, land origin ice concentration must be a decimal quantity in UNITLESS units and be less than 1." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceCondition "bergy waters"^^xsd:string .
    FILTER NOT EXISTS {
        $this nltl:landOriginIceConcentration ?quantity .
        ?quantity a qudt:QuantityValue ;
                  qudt:numericValue ?value ;
                  qudt:unit unit:UNITLESS .
        FILTER (
            datatype(?value) = xsd:decimal &&
            ?value < 1
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For bergy waters, total ice concentration must be a decimal quantity in UNITLESS units and be at most 1." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceCondition "bergy waters"^^xsd:string .
    FILTER NOT EXISTS {
        $this nltl:totalIceConcentration ?quantity .
        ?quantity a qudt:QuantityValue ;
                  qudt:numericValue ?value ;
                  qudt:unit unit:UNITLESS .
        FILTER (
            datatype(?value) = xsd:decimal &&
            ?value <= 1
        )
    }
}
""" ;
    ] .
