@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-009-Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:message "Ice condition must be recorded as a string when supplied."
    ] ;
    sh:property [
        sh:path nltl:landOriginIceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:totalIceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10; both concentrations must be supplied as valid dimensionless decimal quantities." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (?condition = "bergy waters")

                FILTER (
                    NOT EXISTS {
                        $this nltl:landOriginIceConcentration ?landQuantity .
                        ?landQuantity qudt:numericValue ?landValue ;
                                       qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?landValue) = xsd:decimal &&
                            ?landValue < 1
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:totalIceConcentration ?totalQuantity .
                        ?totalQuantity qudt:numericValue ?totalValue ;
                                        qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?totalValue) = xsd:decimal &&
                            ?totalValue <= 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?invalidLandQuantity .
                        FILTER NOT EXISTS {
                            ?invalidLandQuantity qudt:numericValue ?landNumericValue .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?invalidLandQuantity .
                        ?invalidLandQuantity qudt:numericValue ?landNumericValue .
                        FILTER (
                            datatype(?landNumericValue) != xsd:decimal ||
                            ?landNumericValue >= 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:landOriginIceConcentration ?invalidLandQuantity .
                        FILTER NOT EXISTS {
                            ?invalidLandQuantity qudt:unit unit:UNITLESS .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?invalidTotalQuantity .
                        FILTER NOT EXISTS {
                            ?invalidTotalQuantity qudt:numericValue ?totalNumericValue .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?invalidTotalQuantity .
                        ?invalidTotalQuantity qudt:numericValue ?totalNumericValue .
                        FILTER (
                            datatype(?totalNumericValue) != xsd:decimal ||
                            ?totalNumericValue > 1
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:totalIceConcentration ?invalidTotalQuantity .
                        FILTER NOT EXISTS {
                            ?invalidTotalQuantity qudt:unit unit:UNITLESS .
                        }
                    }
                )
            }
        """
    ] .
