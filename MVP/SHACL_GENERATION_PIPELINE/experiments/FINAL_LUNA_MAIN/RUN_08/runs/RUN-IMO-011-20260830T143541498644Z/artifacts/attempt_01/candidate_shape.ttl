@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-011-ShipReadinessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/YR> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide one data period in years."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide the externally calculated mean daily low temperature in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:hasDailyLowTemperatureObservation ;
        sh:node [
            sh:class nltl:dailyLowTemperatureObservation ;
            sh:property [
                sh:path nltl:dailyTemperatureObservationDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:dailyLowTemperature ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ] ;
        sh:message "Each linked daily low temperature observation shall have a date and a daily low temperature in degrees Celsius."
    ] ;
    sh:sparql [
        sh:message "When the data period is shorter than 10 years, the administration dataset approval status shall be Approved." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:dataPeriod ?period .
                ?period qudt:numericValue ?periodValue .
                FILTER ( ?periodValue < 10 )
                FILTER NOT EXISTS {
                    $this nltl:administrationDatasetApprovalStatus nltl:evidenceStateApproved .
                }
                FILTER NOT EXISTS {
                    $this nltl:administrationDatasetApprovalStatus ?status .
                    FILTER ( ?status != nltl:evidenceStateApproved )
                }
            }
        """
    ] .
