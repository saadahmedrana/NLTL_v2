@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_016_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:node gen:PolarShipCertificateFormShape ;
        sh:message "The ship must have a Polar Ship Certificate corresponding to the Appendix I model."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The certificate language must be recorded."
    ] ;
    sh:sparql [
        sh:message "If the certificate language is not English, French, or Spanish, an approved translation must be present." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
    $this nltl:certificateLanguage ?language .
    FILTER (?language NOT IN ("English", "French", "Spanish"))
    FILTER NOT EXISTS {
        $this nltl:approvedTranslationPresent ?translation .
        FILTER (?translation = true)
    }
}
"""
    ] .

gen:PolarShipCertificateFormShape
    a sh:NodeShape ;
    sh:class nltl:polarShipCertificateForm ;
    sh:property [
        sh:path nltl:certificateFormModel ;
        sh:class nltl:certificateFormModelValue ;
        sh:minCount 1 ;
        sh:hasValue nltl:appendixIPolarShipCertificateModel ;
        sh:message "The Polar Ship Certificate form model must be the Appendix I model."
    ] .
