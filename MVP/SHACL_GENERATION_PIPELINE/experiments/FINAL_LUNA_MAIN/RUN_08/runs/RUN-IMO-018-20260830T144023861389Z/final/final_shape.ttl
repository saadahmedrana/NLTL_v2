@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO018Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO018NotApplicableShape
        gen:IMO018ApplicableShape
    ) .

gen:IMO018NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ice capability methodology applicability decision must be explicitly false when the conditional requirement is not applicable."
    ] .

gen:IMO018ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice capability methodology applicability decision must be true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:certificateMethodologyReferencePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the ice capability methodology is applicable, the certificate must reference the methodology."
    ] ;
    sh:property [
        sh:path nltl:administrationAcceptanceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the ice capability methodology is applicable, Administration acceptance must be recorded as approved."
    ] .
