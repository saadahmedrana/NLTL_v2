@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO032Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryA
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node gs:IMO032ABApprovalRecordShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryB
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node gs:IMO032ABApprovalRecordShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node gs:IMO032CApprovalRecordShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "The ship must satisfy the applicable category-conditioned scantling approval requirement." .

gs:IMO032ABApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "(?i)^(Administration|recognized organization accepted by the Administration)$" ;
        sh:message "Approval must be by the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "(?i)^.*(acceptable to the Organization|equivalent level of safety).*$" ;
        sh:message "The approval standard must be acceptable to the Organization or offer an equivalent level of safety."
    ] .

gs:IMO032CApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "(?i)^(Administration|recognized organization accepted by the Administration)$" ;
        sh:message "Approval must be by the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:node gs:IMO032IceConcentrationShape
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "(?i)^.*(acceptable.*adequate|adequate.*acceptable).*$" ;
        sh:message "The approval standard must be acceptable and adequate for the declared operating ice context."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The Category C approval standard must explicitly address both the declared operating ice type and concentration." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:approvalStandard ?standard ;
                      nltl:operatingIceType ?iceType ;
                      nltl:operatingIceConcentration ?quantity .
                ?quantity qudt:numericValue ?concentration ;
                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (
                    !CONTAINS(
                        LCASE(STR(?standard)),
                        LCASE(STR(?iceType))
                    )
                    ||
                    !CONTAINS(
                        STR(?standard),
                        STR(?concentration)
                    )
                )
            }
        """
    ] .

gs:IMO032IceConcentrationShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
