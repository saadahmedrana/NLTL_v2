@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO034ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO034IceAccretionNotLikelyShape
        gs:IMO034IceAccretionLikelyShape
    ) .

gs:IMO034IceAccretionNotLikelyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "iceAccretionLikely must be recorded as false when the conditional requirement is non-applicable."
    ] .

gs:IMO034IceAccretionLikelyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "iceAccretionLikely must be recorded as true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionMinimizationDesignPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "When ice accretion is likely, the ship must have a design that minimizes ice accretion."
    ] ;
    sh:property [
        sh:path nltl:requiredIceRemovalMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "When ice accretion is likely, required ice-removal means must be present."
    ] .
