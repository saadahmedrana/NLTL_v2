@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-034> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Ice accretion likelihood must be true when the applicable branch is selected."
            ] ;
            sh:property [
                sh:path nltl:iceAccretionMinimizationDesignPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "A design to minimize ice accretion is required when ice accretion is likely."
            ] ;
            sh:property [
                sh:path nltl:requiredIceRemovalMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Required ice-removal means must be present when ice accretion is likely."
            ] ;
            sh:property [
                sh:path nltl:administrationRequiredIceRemovalMeans ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Administration-required ice-removal means must be recorded when ice accretion is likely."
            ]
        ]
    ) .
