@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO037LoadingConditionCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadingConditionCase ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Each applicable loading condition must have an identifier."
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each applicable loading condition must state whether the alternative instrument applies."
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each applicable loading condition must provide the alternative-instrument residual stability status."
    ] ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each applicable loading condition must provide a single dimensionless residual stability factor."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each applicable loading condition must have evidence for its external result."
    ] ;
    sh:sparql [
        sh:message "The external loading-condition result must either report a compliant alternative-instrument outcome or have residual stability factor s_i equal to one." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:alternativeInstrumentApplicable ?app ;
                      nltl:alternativeInstrumentResidualStabilityStatus ?status ;
                      nltl:residualStabilityFactorSI ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (
                    (?app = true && ?status != true) ||
                    (?app = false && (?value < 1.0 || ?value > 1.0))
                )
            }
        """
    ] .

gen:IMO037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:node gen:IMO037LoadingConditionCaseShape
            ]
        ]
    ) ;
    sh:message "For a Category A or B ship constructed on or after 1 January 2017, every linked loading-condition case must satisfy the residual stability outcome requirement."
    .
