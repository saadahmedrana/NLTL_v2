@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-041> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "hydraulic" ;
                sh:message "The opening actuation type must be hydraulic for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Hydraulic openings require freezing or excessive-viscosity control for the hydraulic fluid."
            ]
        ]
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An opening actuation type is required to determine applicability."
            ] ;
            sh:sparql [
                sh:message "The non-hydraulic applicability branch must not use the hydraulic actuation type." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?actuation .
                        FILTER (?actuation = "hydraulic"^^xsd:string)
                    }
                """
            ]
        ]
    ) .
