@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:IMO-043:> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hazardProtectionCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall record hazard protection coverage."
    ] ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:class nltl:machineryInstallationItem ;
        sh:node gen:MachineryInstallationShape
    ] .

gen:MachineryInstallationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:class nltl:associatedEquipmentItem
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:iceAccretionHazard ;
        sh:message "Protection coverage shall address the ice accretion hazard."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:snowAccumulationHazard ;
        sh:message "Protection coverage shall address the snow accumulation hazard."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:seawaterIceIngestionHazard ;
        sh:message "Protection coverage shall address the seawater ice ingestion hazard."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:liquidFreezingOrViscosityIncreaseHazard ;
        sh:message "Protection coverage shall address the liquid freezing or viscosity increase hazard."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:seawaterIntakeTemperatureHazard ;
        sh:message "Protection coverage shall address the seawater intake temperature hazard."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:snowIngestionHazard ;
        sh:message "Protection coverage shall address the snow ingestion hazard."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each machinery installation shall have hazard protection evidence."
    ] .
