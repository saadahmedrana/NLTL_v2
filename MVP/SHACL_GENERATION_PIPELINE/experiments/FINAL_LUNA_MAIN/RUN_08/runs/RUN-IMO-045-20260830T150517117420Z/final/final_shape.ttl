@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_045_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machinerySeawaterSupply ;
        sh:datatype xsd:boolean ;
        sh:message "machinerySeawaterSupply must be a boolean."
    ] ;
    sh:property [
        sh:path nltl:iceIngestionPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:message "iceIngestionPreventionPresent must be a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue false
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:machinerySeawaterSupply ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceIngestionPreventionPresent ;
                        sh:hasValue true
                    ]
                ]
            )
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:machinerySeawaterSupply ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                        sh:hasValue nltl:evidenceStateApproved
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For a ship with a machinery seawater supply, ice-ingestion prevention must be present or the alternative functionality arrangement must be approved." .
