@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO049ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryA
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:node gs:IMO049CategoryABComponentShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryB
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:node gs:IMO049CategoryABComponentShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:node gs:IMO049CategoryCComponentShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "The ship category and ice-strengthening state must select an applicable approval branch." .

gs:IMO049CategoryABComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable machinery component must identify its component type."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:node gs:IMO049CategoryABApprovalRecordShape ;
        sh:message "Each applicable machinery component must have approval evidence."
    ] .

gs:IMO049CategoryABApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The scantling approval record must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "The approval must identify an authorized approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:message "The approval must identify an Organization-acceptable or equivalent-safety standard."
    ] .

gs:IMO049CategoryCComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable machinery component must identify its component type."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:node gs:IMO049CategoryCApprovalRecordShape ;
        sh:message "Each applicable machinery component must have approval evidence."
    ] .

gs:IMO049CategoryCApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The scantling approval record must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "The approval must identify an authorized approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "acceptable standard adequate for operating ice type and concentration" ;
        sh:message "Category C approval must identify an acceptable standard adequate for the operating ice conditions."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Category C approval must record the operating ice type."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO049OperatingIceConcentrationShape ;
        sh:message "Category C approval must record the operating ice concentration."
    ] .

gs:IMO049OperatingIceConcentrationShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
