@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-055> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Valve exposure must be recorded as false when the conditional valve requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Valve exposure must be recorded as true for an applicable exposed-valve case."
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( "isolating" "pressure" "vacuum" ) ;
                sh:message "An exposed applicable valve must be identified as isolating, pressure, or vacuum."
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Applicable exposed isolating, pressure, or vacuum valves must be protected from ice accretion."
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Applicable exposed isolating, pressure, or vacuum valves must remain continuously accessible."
            ]
        ]
    ) .
