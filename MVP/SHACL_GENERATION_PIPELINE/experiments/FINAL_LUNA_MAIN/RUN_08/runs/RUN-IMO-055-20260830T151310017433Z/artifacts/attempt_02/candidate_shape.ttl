@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_055_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_055_NotExposedBranch
        gen:IMO_055_ExposedNonApplicableBranch
        gen:IMO_055_ApplicableBranch
    ) ;
    sh:message "A ship must represent valve exposure and satisfy the applicable ice-accretion protection and accessibility condition." .

gen:IMO_055_NotExposedBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "valveExposed must be false for the non-exposed branch."
    ] .

gen:IMO_055_ExposedNonApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "valveExposed must be true for an exposed-valve branch."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "valveType is required to establish whether the exposed-valve condition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An exposed valve whose type is not isolating, pressure, or vacuum is outside this conditional requirement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:valveExposed ?exposed .
                $this nltl:valveType ?type .
                FILTER (?exposed = true)
                FILTER (?type NOT IN ("isolating", "pressure", "vacuum"))
            }
        """
    ] .

gen:IMO_055_ApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "valveExposed must be true for the applicable valve condition."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "isolating" "pressure" "vacuum" ) ;
        sh:message "For an exposed valve, valveType must be isolating, pressure, or vacuum."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Applicable exposed valves must have ice-accretion protection."
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Applicable exposed valves must remain continuously accessible."
    ] .
