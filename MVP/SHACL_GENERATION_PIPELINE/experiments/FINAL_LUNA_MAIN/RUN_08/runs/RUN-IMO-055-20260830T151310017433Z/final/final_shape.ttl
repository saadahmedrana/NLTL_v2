@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO_055_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlgen:IMO_055_NotExposedBranch
        nltlgen:IMO_055_ApplicableExposedBranch
        nltlgen:IMO_055_NonApplicableExposedBranch
    ) .

nltlgen:IMO_055_NotExposedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The valve exposure state must establish that the valve is not exposed."
    ] .

nltlgen:IMO_055_ApplicableExposedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The valve exposure state must establish that the valve is exposed."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "isolating" "pressure" "vacuum" ) ;
        sh:message "An exposed applicable valve must have type isolating, pressure, or vacuum."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "An exposed isolating, pressure, or vacuum valve must be protected from ice accretion."
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "An exposed isolating, pressure, or vacuum valve must remain continuously accessible."
    ] .

nltlgen:IMO_055_NonApplicableExposedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The valve exposure state must establish that the valve is exposed."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "An exposed valve must provide its valve type to determine applicability."
    ] ;
    sh:sparql [
        sh:message "An exposed valve with an isolating, pressure, or vacuum type must satisfy the ice protection and continuous accessibility obligations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:valveExposed true ;
                      nltl:valveType ?type .
                FILTER (?type IN ("isolating", "pressure", "vacuum"))
            }
        """
    ] .
