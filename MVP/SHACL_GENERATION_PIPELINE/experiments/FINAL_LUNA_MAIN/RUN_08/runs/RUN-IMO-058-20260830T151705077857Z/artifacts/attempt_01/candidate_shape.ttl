@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO058ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedFireMainSection ;
        sh:node gen:IMO058ExposedFireMainSectionShape ;
        sh:message "Each linked exposed fire-main section must provide the required isolation and drainage arrangements."
    ] .

gen:IMO058ExposedFireMainSectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fireMainSectionIsolationCapability ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The exposed fire-main section must have isolation capability."
    ] ;
    sh:property [
        sh:path nltl:fireMainSectionDrainageMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Means of draining the exposed fire-main section must be provided."
    ] .
