@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-064-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personOnBoard ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:message "The ship must provide a persons-on-board count."
    ] ;
    sh:property [
        sh:path nltl:assignedThermalProtection ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Assigned thermal protection must be recorded as provided."
    ] ;
    sh:property [
        sh:path nltl:thermalProtectionApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Thermal-protection adequacy approval must be approved."
    ] ;
    sh:property [
        sh:path nltl:intendedVoyage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The intended voyage must be recorded for thermal-protection assessment."
    ] ;
    sh:property [
        sh:path nltl:anticipatedCold ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The anticipated cold conditions must be recorded."
    ] ;
    sh:property [
        sh:path nltl:anticipatedWind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The anticipated wind conditions must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-064-ApprovalEvidenceShape>
    a sh:NodeShape ;
    sh:targetClass nltl:approvalEvidence .
