@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_066_EscapeRouteItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:escapeRouteProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "An escape route shall have associated ice or snow removal or prevention means."
    ] .

gen:IMO_066_MusterStationItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:musterStationProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "A muster station shall have associated ice or snow removal or prevention means."
    ] .

gen:IMO_066_EmbarkationAreaItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:embarkationAreaProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "An embarkation area shall have associated ice or snow removal or prevention means."
    ] .

gen:IMO_066_SurvivalCraftItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:survivalCraftProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "A survival craft shall have associated ice or snow removal or prevention means."
    ] .

gen:IMO_066_LaunchingApplianceItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:launchingApplianceProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "A launching appliance shall have associated ice or snow removal or prevention means."
    ] .

gen:IMO_066_SurvivalCraftAccessItemShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Access to a survival craft shall have associated ice or snow removal or prevention means."
    ] .

gen:IMO_066_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO_066_EscapeRouteItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one escape route shall have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO_066_MusterStationItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one muster station shall have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO_066_EmbarkationAreaItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one embarkation area shall have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO_066_SurvivalCraftItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one survival craft shall have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO_066_LaunchingApplianceItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one launching appliance shall have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO_066_SurvivalCraftAccessItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one survival-craft access item shall have ice or snow removal or prevention means."
            ]
        ]
    ) .
