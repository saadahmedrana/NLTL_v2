@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-066-Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-066-ApplicableBranch>
        <urn:nltl:generated-shape:IMO-066-NotApplicableBranch>
    ) .

<urn:nltl:generated-shape:IMO-066-ApplicableBranch> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:IMO-066-EscapeRouteItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:IMO-066-MusterStationItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:IMO-066-EmbarkationAreaItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:IMO-066-SurvivalCraftItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:IMO-066-LaunchingApplianceItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:IMO-066-SurvivalCraftAccessItem> ;
        sh:qualifiedMinCount 1
    ] .

<urn:nltl:generated-shape:IMO-066-NotApplicableBranch> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:IMO-066-EscapeRouteItem> a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:escapeRouteProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:IMO-066-MusterStationItem> a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:musterStationProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:IMO-066-EmbarkationAreaItem> a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:embarkationAreaProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:IMO-066-SurvivalCraftItem> a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:survivalCraftProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:IMO-066-LaunchingApplianceItem> a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:launchingApplianceProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:IMO-066-SurvivalCraftAccessItem> a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .
