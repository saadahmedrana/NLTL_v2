@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO068ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship's ice-covered-water operating condition is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Whether direct evacuation onto ice is applicable is required to determine applicability."
    ] ;
    sh:or (
        gen:IMO068ApplicableByIceOperationShape
        gen:IMO068ApplicableByDirectIceEvacuationShape
        gen:IMO068NotApplicableShape
    ) .

gen:IMO068ApplicableByIceOperationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:safeEvacuationMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Safe evacuation means must be present when the ship operates in ice-covered waters."
    ] ;
    sh:property [
        sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Survival equipment deployment must have approved status when the ship operates in ice-covered waters."
    ] .

gen:IMO068ApplicableByDirectIceEvacuationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:safeEvacuationMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Safe evacuation means must be present when direct evacuation onto ice is applicable."
    ] ;
    sh:property [
        sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Survival equipment deployment must have approved status when direct evacuation onto ice is applicable."
    ] .

gen:IMO068NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:hasValue false
    ] .
