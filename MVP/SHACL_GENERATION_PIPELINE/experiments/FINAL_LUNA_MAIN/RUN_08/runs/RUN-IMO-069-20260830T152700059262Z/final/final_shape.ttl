@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_069_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must state whether an added life-saving device requires a source of power."
    ] ;
    sh:property [
        sh:path nltl:devicePowerSourceIndependentOfMainPower ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:devicePowerSourceIndependentOfMainPower ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When an added life-saving device requires power, its power source must operate independently of the ship's main source of power."
            ]
        ]
    ) .
