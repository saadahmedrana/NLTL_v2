@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO070ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:or (
        [
            sh:node gen:IMO070PassengerShipBranch
        ]
        [
            sh:node gen:IMO070NonPassengerShipBranch
        ]
    ) .

gen:IMO070PassengerShipBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "passenger_ship"
    ] ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A passenger ship shall have size-compatible personal survival equipment assignments."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:node gen:IMO070PersonShape
    ] .

gen:IMO070NonPassengerShipBranch
    a sh:NodeShape ;
    sh:sparql [
        sh:message "This branch applies only when the ship is not identified as a passenger ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipType ?shipTypeValue .
                FILTER (?shipTypeValue = "passenger_ship"^^xsd:string)
            }
        """
    ] .

gen:IMO070PersonShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO070AssignmentShape ;
        sh:message "Each person on board shall have exactly one personal survival equipment assignment."
    ] .

gen:IMO070AssignmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:class nltl:immersionSuitEquipment
            ]
            [
                sh:class nltl:thermalProtectiveAidEquipment
            ]
        ) ;
        sh:message "The assignment shall identify exactly one immersion suit or thermal protective aid."
    ] .
