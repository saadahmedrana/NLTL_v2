@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-072-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Extended darkness operation must be true for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-072-LifeboatShape> ;
                sh:message "At least one lifeboat is required when extended darkness operation applies."
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Extended darkness operation must be false for this applicability branch."
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-072-LifeboatShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-072-SearchlightShape> ;
        sh:message "Each lifeboat must have an assigned searchlight."
    ] .

<urn:nltl:generated-shape:IMO-072-SearchlightShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each assigned searchlight must be suitable for continuous use."
    ] .
