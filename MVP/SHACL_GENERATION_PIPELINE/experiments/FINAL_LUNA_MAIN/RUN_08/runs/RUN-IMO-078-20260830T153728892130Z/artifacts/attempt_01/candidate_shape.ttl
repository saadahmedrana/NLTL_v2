@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO078ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPassenger ;
        sh:class nltl:passenger ;
        sh:node gen:IMO078PassengerShape
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:class nltl:crewMember ;
        sh:node gen:IMO078CrewMemberShape
    ] .

gen:IMO078PassengerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:personalSurvivalEquipmentInstructionCompleted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Every linked passenger must have completed personal survival equipment instruction."
    ] .

gen:IMO078CrewMemberShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Every linked crew member must have completed personal and group survival equipment training."
    ] .
