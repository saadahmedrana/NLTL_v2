@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_089_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:icebreakerEscortOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:icebreakerEscortOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Icebreaker escort operation applicability must be explicitly recorded."
            ] ;
            sh:property [
                sh:path nltl:manuallyInitiatedFlashingRedStoppedLightPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "An applicable ship shall have a manually initiated flashing red stopped light."
            ] ;
            sh:property [
                sh:path nltl:lightVisibleFromAstern ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The applicable stopped light shall be visible from astern."
            ] ;
            sh:property [
                sh:path nltl:visibilityRange ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minInclusive "2"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:MI_N
                    ]
                ] ;
                sh:message "The applicable stopped light shall have a visibility range of at least two nautical miles."
            ] ;
            sh:property [
                sh:path nltl:colregSternLightArcComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The applicable stopped light shall comply with the COLREG stern-light visibility arcs."
            ]
        ]
    ) .
