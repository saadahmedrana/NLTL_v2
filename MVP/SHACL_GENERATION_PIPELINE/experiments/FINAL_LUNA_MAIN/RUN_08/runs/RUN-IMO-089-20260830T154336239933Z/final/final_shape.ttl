@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-089> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icebreakerEscortOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Icebreaker escort operation must be present as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:icebreakerEscortOperation ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:manuallyInitiatedFlashingRedStoppedLightPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "An icebreaker-escorted ship must have a manually initiated flashing red stopped light."
            ] ;
            sh:property [
                sh:path nltl:lightVisibleFromAstern ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The required flashing red stopped light must be visible from astern."
            ] ;
            sh:property [
                sh:path nltl:visibilityRange ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "2"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:MI_N
                    ]
                ] ;
                sh:message "The required light must have a visibility range of at least two nautical miles."
            ] ;
            sh:property [
                sh:path nltl:colregSternLightArcComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The stern light horizontal and vertical visibility arcs must comply with the applicable COLREG stern-light specifications."
            ]
        ]
        [
            sh:property [
                sh:path nltl:icebreakerEscortOperation ;
                sh:hasValue false
            ]
        ]
    ) .
