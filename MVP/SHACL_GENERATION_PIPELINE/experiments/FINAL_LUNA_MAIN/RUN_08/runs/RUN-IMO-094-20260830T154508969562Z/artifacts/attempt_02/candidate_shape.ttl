@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-094> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipProvidesIcebreakingEscort ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:asternFacingSoundSignalingSystemPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:internationalCodeOfSignalsComplianceStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "A ship providing icebreaking escort must have an astern-facing sound signaling system and comply with the International Code of Signals." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipProvidesIcebreakingEscort true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:asternFacingSoundSignalingSystemPresent true
                    }
                    ||
                    EXISTS {
                        $this nltl:asternFacingSoundSignalingSystemPresent ?soundPresent .
                        FILTER (?soundPresent != true)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:internationalCodeOfSignalsComplianceStatus true
                    }
                    ||
                    EXISTS {
                        $this nltl:internationalCodeOfSignalsComplianceStatus ?codeCompliant .
                        FILTER (?codeCompliant != true)
                    }
                )
            }
        """
    ] .
