@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating state is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable ship must identify its lifeboat and other-survival-craft relationships." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                FILTER (
                    NOT EXISTS { $this nltl:hasLifeboat ?lifeboat }
                    ||
                    NOT EXISTS { $this nltl:hasOtherSurvivalCraft ?craft }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each released lifeboat must carry at least one ship-to-shore distress-alert device." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:hasLifeboat ?lifeboat .
                ?lifeboat nltl:releasedRescueBoatOrLifeboat true .
                FILTER NOT EXISTS {
                    ?lifeboat nltl:hasDistressAlertDevice ?device .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each released lifeboat must carry at least one location-signal device." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:hasLifeboat ?lifeboat .
                ?lifeboat nltl:releasedRescueBoatOrLifeboat true .
                FILTER NOT EXISTS {
                    ?lifeboat nltl:survivalCraftHasLocationSignalDevice ?device .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each released lifeboat must carry at least one on-scene transmit/receive communication device." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:hasLifeboat ?lifeboat .
                ?lifeboat nltl:releasedRescueBoatOrLifeboat true .
                FILTER NOT EXISTS {
                    ?lifeboat nltl:survivalCraftHasOnSceneCommunicationDevice ?device .
                }
            }
        """
    ] .
