@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating applicability must be recorded."
    ] ;
    sh:sparql [
        sh:message "When the ship operates in low air temperature, the declared lifeboat and survival-craft relationships must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                FILTER (
                    NOT EXISTS { $this nltl:hasLifeboat ?lifeboat }
                    || NOT EXISTS { $this nltl:hasOtherSurvivalCraft ?otherCraft }
                    || NOT EXISTS { $this nltl:hasRequiredRescueBoatOrLifeboat ?requiredCraft }
                    || NOT EXISTS { $this nltl:hasSurvivalCraft ?survivalCraft }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable survival craft must identify whether it is a released rescue boat or lifeboat." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                $this nltl:hasSurvivalCraft ?craft .
                FILTER (
                    NOT EXISTS { ?craft nltl:releasedRescueBoatOrLifeboat ?released }
                    || EXISTS {
                        ?craft nltl:releasedRescueBoatOrLifeboat ?releasedValue .
                        FILTER (datatype(?releasedValue) != xsd:boolean)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device, one location-signal device, and one on-scene communication device." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                $this (nltl:hasLifeboat|nltl:hasRequiredRescueBoatOrLifeboat) ?craft .
                $this nltl:hasSurvivalCraft ?craft .
                ?craft nltl:releasedRescueBoatOrLifeboat true .
                FILTER (
                    NOT EXISTS {
                        ?craft nltl:survivalCraftHasShipToShoreDistressAlertDevice ?distressDevice
                    }
                    || NOT EXISTS {
                        ?craft nltl:survivalCraftHasLocationSignalDevice ?locationDevice
                    }
                    || NOT EXISTS {
                        ?craft nltl:survivalCraftHasOnSceneCommunicationDevice ?communicationDevice
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-097-SurvivalCraftShape> a sh:NodeShape ;
    sh:targetClass nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "An applicable released rescue boat or lifeboat must have a ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:message "An applicable released rescue boat or lifeboat must have a location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "An applicable released rescue boat or lifeboat must have an on-scene communication device."
    ] .
