@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO098ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:xone (
        gen:IMO098NotApplicableShape
        gen:IMO098ApplicableShape
    ) .

gen:IMO098NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The low-air-temperature applicability value must be false for this non-applicable branch."
    ] .

gen:IMO098ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The low-air-temperature applicability value must be true for this applicable branch."
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft ;
        sh:node gen:IMO098OtherSurvivalCraftShape ;
        sh:message "Each other survival craft must carry the required location-signal and on-scene communication devices."
    ] .

gen:IMO098OtherSurvivalCraftShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each other survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:hasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each other survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
