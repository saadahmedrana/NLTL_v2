@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-103> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-103-alternate-false>
        <urn:nltl:generated-shape:IMO-103-alternate-true>
    ) ;
    sh:message "The alternate-qualified-person conditions are not satisfied." .

<urn:nltl:generated-shape:IMO-103-alternate-false> a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "alternateQualifiedPersonUsed must be false when the alternate-person conditions do not apply."
    ] .

<urn:nltl:generated-shape:IMO-103-alternate-true> a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "alternateQualifiedPersonUsed must be true for this conditional branch."
    ] ;
    sh:property [
        sh:path nltl:administrationPermissionStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Administration permission must be approved."
    ] ;
    sh:property [
        sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "STCW Convention regulation II/2 compliance is required."
    ] ;
    sh:property [
        sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "STCW Code section A-II/2 compliance is required."
    ] ;
    sh:property [
        sh:path nltl:advancedPolarTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Advanced polar training is required."
    ] ;
    sh:property [
        sh:path nltl:watchCoverageStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Sufficient trained watch coverage is required."
    ] ;
    sh:property [
        sh:path nltl:restComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Administration minimum rest requirements must be satisfied."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-103-passenger-or-tanker-open>
        <urn:nltl:generated-shape:IMO-103-passenger-or-tanker-other>
        <urn:nltl:generated-shape:IMO-103-cargo-low-ice>
        <urn:nltl:generated-shape:IMO-103-cargo-high-ice>
    ) .

<urn:nltl:generated-shape:IMO-103-passenger-or-tanker-open> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "passenger ship" "tanker" )
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "open waters" "bergy waters" )
    ] .

<urn:nltl:generated-shape:IMO-103-passenger-or-tanker-other> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "passenger ship" "tanker" )
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on passenger ships and tankers must meet the applicable basic training requirements outside open or bergy waters."
    ] .

<urn:nltl:generated-shape:IMO-103-cargo-low-ice> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "cargo ship other than tanker"
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive "0.2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] .

<urn:nltl:generated-shape:IMO-103-cargo-high-ice> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "cargo ship other than tanker"
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0.2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on cargo ships other than tankers must meet the applicable basic training requirements when ice concentration exceeds 2/10."
    ] .
