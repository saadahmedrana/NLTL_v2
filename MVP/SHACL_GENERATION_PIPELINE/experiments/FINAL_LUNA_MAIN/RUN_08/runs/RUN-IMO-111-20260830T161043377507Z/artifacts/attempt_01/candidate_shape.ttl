@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_111_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        )
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For an applicable Category A or B ship, each represented applicable tank case must have the required date, tank type, capacity, and at least 0.76 m outer-shell separation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB,
                                nltl:polarShipCategoryC
                            )
                        )
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:shipCategory ?categoryAB .
                            FILTER (
                                ?categoryAB IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                )
                            )
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:constructionDate ?date .
                            FILTER (?date >= "2017-01-01"^^xsd:date)
                        }
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:shipCategory ?categoryAB2 .
                            FILTER (
                                ?categoryAB2 IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                )
                            )
                        }
                        &&
                        EXISTS {
                            $this nltl:constructionDate ?date2 .
                            FILTER (?date2 >= "2017-01-01"^^xsd:date)
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:tankType ?tankType .
                        }
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:shipCategory ?categoryAB3 .
                            FILTER (
                                ?categoryAB3 IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                )
                            )
                        }
                        &&
                        EXISTS {
                            $this nltl:constructionDate ?date3 .
                            FILTER (?date3 >= "2017-01-01"^^xsd:date)
                        }
                        &&
                        EXISTS {
                            $this nltl:tankType ?tankTypeAllowed .
                            FILTER (
                                ?tankTypeAllowed IN (
                                    "oil_residue_tank",
                                    "oily_bilge_water_holding_tank"
                                )
                            )
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:individualTankCapacity ?capacityNode .
                            ?capacityNode qudt:numericValue ?capacity .
                            ?capacityNode qudt:unit unit:M3 .
                            FILTER (
                                datatype(?capacity) = xsd:decimal
                            )
                        }
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:shipCategory ?categoryAB4 .
                            FILTER (
                                ?categoryAB4 IN (
                                    nltl:polarShipCategoryA,
                                    nltl:polarShipCategoryB
                                )
                            )
                        }
                        &&
                        EXISTS {
                            $this nltl:constructionDate ?date4 .
                            FILTER (?date4 >= "2017-01-01"^^xsd:date)
                        }
                        &&
                        EXISTS {
                            $this nltl:tankType ?tankTypeAllowed2 .
                            FILTER (
                                ?tankTypeAllowed2 IN (
                                    "oil_residue_tank",
                                    "oily_bilge_water_holding_tank"
                                )
                            )
                        }
                        &&
                        EXISTS {
                            $this nltl:individualTankCapacity ?capacityNode2 .
                            ?capacityNode2 qudt:numericValue ?capacity2 .
                            ?capacityNode2 qudt:unit unit:M3 .
                            FILTER (
                                datatype(?capacity2) = xsd:decimal
                                && ?capacity2 > "30"^^xsd:decimal
                            )
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:tankOuterShellSeparation ?separationNode .
                            ?separationNode qudt:numericValue ?separation .
                            ?separationNode qudt:unit unit:M .
                            FILTER (
                                datatype(?separation) = xsd:decimal
                                && ?separation >= "0.76"^^xsd:decimal
                            )
                        }
                    )
                )
            }
        """
    ] .
