@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_115> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "For comminuted and disinfected sewage, MARPOL compliance, the greater-than-three-nautical-mile distance, ice concentration above one tenth, and the recorded area distance must be present and conform." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType .
                FILTER (?dischargeType = "comminuted_and_disinfected"^^xsd:string)

                FILTER NOT EXISTS {
                    $this nltl:comminutedAndDisinfected true
                }

                FILTER NOT EXISTS {
                    $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestIceShelfOrFastIce ?nearestDistance .
                    ?nearestDistance qudt:numericValue ?nearestValue ;
                                     qudt:unit unit:MI_N .
                    FILTER (?nearestValue > 3)
                }

                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?nearbyConcentration .
                    ?nearbyConcentration qudt:numericValue ?nearbyValue ;
                                          qudt:unit unit:UNITLESS .
                    FILTER (?nearbyValue > 1)
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                    ?areaDistance qudt:numericValue ?areaDistanceValue ;
                                  qudt:unit unit:MI_N .
                }
            }
        """
    ] .
