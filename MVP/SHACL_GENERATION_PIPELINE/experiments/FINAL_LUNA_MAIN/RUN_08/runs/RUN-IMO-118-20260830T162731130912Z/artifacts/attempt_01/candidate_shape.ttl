@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_118_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxInclusive "2016-12-31"^^xsd:date ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:nodeKind sh:IRI ;
                        sh:in (
                            nltl:polarShipCategoryA
                            nltl:polarShipCategoryB
                        ) ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:class nltl:passengerShip
                ]
            ) ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:sewageDischargeToSea ;
                        sh:datatype xsd:boolean ;
                        sh:in ( false ) ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
                        sh:datatype xsd:boolean ;
                        sh:in ( true ) ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For ships constructed on or after 1 January 2017, sewage discharge to sea must be false unless paragraph 4.2.1.3 compliance is true." .
