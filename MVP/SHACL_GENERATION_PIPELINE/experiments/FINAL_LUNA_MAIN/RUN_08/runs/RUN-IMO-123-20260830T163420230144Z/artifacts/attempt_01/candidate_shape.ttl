@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-123-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:residueNotRecoverableByCommonMethods ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Cargo residues must not be discharged under this permission when they are recoverable by commonly available methods."
            ]
        ]
        [
            sh:property [
                sh:path nltl:residueNotRecoverableByCommonMethods ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:shipEnRoute ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ship must be en route for the cargo-residue discharge permission."
            ] ;
            sh:property [
                sh:path nltl:harmfulSubstancePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Cargo residues, cleaning agents, or additives must not contain substances harmful to the marine environment."
            ] ;
            sh:property [
                sh:path nltl:departureAndDestinationWithinArctic ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The port of departure and the next port of destination must be within Arctic waters."
            ] ;
            sh:property [
                sh:path nltl:routeRemainsWithinArctic ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The route between the ports must remain within Arctic waters."
            ] ;
            sh:property [
                sh:path nltl:adequateReceptionFacilitiesAvailable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "No adequate reception facilities may be available at the applicable ports."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:minCount 1 ;
                sh:class nltl:dischargeDistanceRecords ;
                sh:node [
                    a sh:NodeShape ;
                    sh:property [
                        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
                        sh:minCount 1 ;
                        sh:node [
                            a sh:NodeShape ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:minInclusive 12
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MI_N>
                            ]
                        ] ;
                        sh:message "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice."
                    ] ;
                    sh:property [
                        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
                        sh:minCount 1 ;
                        sh:node [
                            a sh:NodeShape ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MI_N>
                            ]
                        ] ;
                        sh:message "A discharge distance record must record the distance from an area with ice concentration greater than one tenth."
                    ]
                ] ;
                sh:message "An applicable cargo-residue discharge must have a discharge distance record containing both required distances."
            ]
        ]
    ) ;
    sh:message "Cargo-residue discharge is permitted only when one of the verified regulatory branches is satisfied." .
