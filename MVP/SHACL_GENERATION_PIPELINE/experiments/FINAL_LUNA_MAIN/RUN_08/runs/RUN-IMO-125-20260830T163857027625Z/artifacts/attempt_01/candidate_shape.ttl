@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_125_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_125_PolarWatersBranch
        gen:IMO_125_NonPolarWatersBranch
    ) .

gen:IMO_125_PolarWatersBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship's polar-waters applicability must be recorded as true for this branch."
    ] ;
    sh:property [
        sh:path nltl:garbageRecordBookPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The applicable Garbage Record Book must record polar-operation coverage."
    ] ;
    sh:property [
        sh:path nltl:garbageManagementPlanPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The applicable Garbage Management Plan must record polar-operation coverage."
    ] ;
    sh:property [
        sh:path nltl:garbagePlacardPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The applicable garbage placards must record polar-operation coverage."
    ] .

gen:IMO_125_NonPolarWatersBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The ship's polar-waters applicability must be recorded as false for this branch."
    ] .
