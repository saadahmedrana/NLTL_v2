@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-002> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship type is required to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Length overall must be supplied as a single metre-valued decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Gross tonnage must be supplied as a single unitless decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Trade status is required to determine pleasure-yacht applicability."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 9-1 applicability must be recorded as a single boolean value."
    ] ;
    sh:sparql [
        sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?type ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?grossQuantity ;
                      nltl:engagedInTrade ?trade ;
                      nltl:polarCodeChapter9Dash1Applicable ?app .

                ?lengthQuantity qudt:numericValue ?lengthValue ;
                                qudt:unit qudt:M .
                ?grossQuantity qudt:numericValue ?grossValue ;
                               qudt:unit qudt:UNITLESS .

                FILTER (
                    (
                        (?type = "fishing_vessel") &&
                        (?lengthValue >= 24) &&
                        (?app != true)
                    ) ||
                    (
                        (?type = "pleasure_yacht") &&
                        (?grossValue >= 300) &&
                        (?trade = false) &&
                        (?app != true)
                    ) ||
                    (
                        (?type = "cargo_ship") &&
                        (?grossValue >= 300) &&
                        (?grossValue < 500) &&
                        (?app != true)
                    ) ||
                    (
                        !(
                            (
                                (?type = "fishing_vessel") &&
                                (?lengthValue >= 24)
                            ) ||
                            (
                                (?type = "pleasure_yacht") &&
                                (?grossValue >= 300) &&
                                (?trade = false)
                            ) ||
                            (
                                (?type = "cargo_ship") &&
                                (?grossValue >= 300) &&
                                (?grossValue < 500)
                            )
                        ) &&
                        (?app != false)
                    )
                )
            }
        """
    ] .
