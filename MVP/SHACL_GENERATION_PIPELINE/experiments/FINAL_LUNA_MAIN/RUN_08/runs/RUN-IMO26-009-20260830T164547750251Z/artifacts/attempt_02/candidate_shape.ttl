@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_009_AntennaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each required navigation or communication antenna shall have ice accumulation prevention means."
    ] .

gen:IMO26_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:class nltl:navigationOrCommunicationAntenna ;
                sh:minCount 1 ;
                sh:node gen:IMO26_009_AntennaShape ;
                sh:message "When ice accretion is likely, at least one required navigation or communication antenna must be recorded and each such antenna must have ice accumulation prevention."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
