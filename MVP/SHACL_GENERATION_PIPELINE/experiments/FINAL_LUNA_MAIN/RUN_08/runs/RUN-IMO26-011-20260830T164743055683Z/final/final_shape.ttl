@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO26_011_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:message "A valid polar ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:bridgeWingsEnclosed ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:bridgeWingProtectionDesignStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a Category A or B ship constructed on or after 1 January 2026, bridge wings must be enclosed, have the required protection design, or have an Administration-approved equivalent arrangement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )

                FILTER (
                    YEAR(?constructionDate) > 2026
                    || (
                        YEAR(?constructionDate) = 2026
                        && MONTH(?constructionDate) > 1
                    )
                    || (
                        YEAR(?constructionDate) = 2026
                        && MONTH(?constructionDate) = 1
                        && DAY(?constructionDate) >= 1
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:bridgeWingsEnclosed ?enclosed .
                    FILTER (?enclosed = true)
                }

                FILTER NOT EXISTS {
                    $this nltl:bridgeWingProtectionDesignStatus ?designed .
                    FILTER (?designed = true)
                }

                FILTER NOT EXISTS {
                    $this nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ?equivalent .
                    FILTER (?equivalent = true)
                }
            }
        """
    ] .
