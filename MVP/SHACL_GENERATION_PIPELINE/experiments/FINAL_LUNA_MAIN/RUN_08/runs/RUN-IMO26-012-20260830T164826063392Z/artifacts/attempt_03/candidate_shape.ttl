@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-012-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Gross tonnage must be supplied as a single unitless decimal quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 0 ;
                        sh:maxExclusive 500
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 500
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasNonMagneticHeadingMeans ;
                sh:nodeKind sh:IRI ;
                sh:qualifiedValueShape [
                    sh:nodeKind sh:IRI ;
                    sh:class nltl:nonMagneticHeadingMeans
                ] ;
                sh:qualifiedMinCount 2 ;
                sh:message "Ships of at least 500 gross tonnage must have at least two distinct non-magnetic heading means."
            ] ;
            sh:property [
                sh:path nltl:hasNonMagneticHeadingMeans ;
                sh:nodeKind sh:IRI ;
                sh:node [
                    sh:class nltl:nonMagneticHeadingMeans ;
                    sh:property [
                        sh:path nltl:connectedToMainPower ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:benchmarkEntity ;
                        sh:minCount 1 ;
                        sh:message "Each non-magnetic heading means must be connected to main power."
                    ] ;
                    sh:property [
                        sh:path nltl:connectedToEmergencyPower ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:benchmarkEntity ;
                        sh:minCount 1 ;
                        sh:message "Each non-magnetic heading means must be connected to emergency power."
                    ] ;
                    sh:property [
                        sh:path nltl:independentFromHeadingMeans ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:nonMagneticHeadingMeans ;
                        sh:minCount 1 ;
                        sh:message "Each non-magnetic heading means must identify an independent heading means."
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "Each non-magnetic heading means must be independent from another distinct heading means of the same ship." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this a nltl:ship .
                        $this nltl:grossTonnage ?gross .
                        ?gross qudt:numericValue ?grossValue .
                        FILTER (?grossValue >= 500)

                        FILTER NOT EXISTS {
                            $this nltl:hasNonMagneticHeadingMeans ?means .
                            FILTER NOT EXISTS {
                                $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                                ?means nltl:independentFromHeadingMeans ?otherMeans .
                                FILTER (?otherMeans != ?means)
                            }
                        }
                    }
                """
            ]
        ]
    ) .
