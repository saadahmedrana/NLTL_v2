@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO26_012_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlgen:IMO26_012_ApplicableShipShape
        nltlgen:IMO26_012_NonApplicableShipShape
    ) .

nltlgen:IMO26_012_ApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:IMO26_012_ApplicableGrossTonnageShape
    ] ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:node nltlgen:IMO26_012_HeadingMeansShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable ship shall have at least two distinct non-magnetic heading means, and every such means shall be independent from another distinct heading means of the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?means1 .
                        $this nltl:hasNonMagneticHeadingMeans ?means2 .
                        FILTER (?means1 != ?means2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?means .
                        FILTER NOT EXISTS {
                            ?means nltl:independentFromHeadingMeans ?otherMeans .
                            $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                            FILTER (?otherMeans != ?means)
                        }
                    }
                )
            }
        """
    ] .

nltlgen:IMO26_012_NonApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:IMO26_012_NonApplicableGrossTonnageShape
    ] .

nltlgen:IMO26_012_ApplicableGrossTonnageShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 500
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

nltlgen:IMO26_012_NonApplicableGrossTonnageShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:maxExclusive 500
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

nltlgen:IMO26_012_HeadingMeansShape
    a sh:NodeShape ;
    sh:class nltl:nonMagneticHeadingMeans ;
    sh:property [
        sh:path nltl:independentFromHeadingMeans ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans
    ] ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity
    ] .
