@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF007ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A ship must provide its ice class to assess this requirement."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships of ice class IA or IA Super must provide a valid construction stage date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?stage .
                    FILTER (datatype(?stage) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships of ice class IA or IA Super whose construction stage began before 1 September 2003 must provide a valid delivery date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage .
                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (datatype(?stage) = xsd:date)
                FILTER (
                    YEAR(?stage) < 2003 ||
                    (YEAR(?stage) = 2003 && MONTH(?stage) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?delivery .
                    FILTER (datatype(?delivery) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships subject to this requirement must provide an assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage .
                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (datatype(?stage) = xsd:date)
                FILTER (
                    YEAR(?stage) < 2003 ||
                    (YEAR(?stage) = 2003 && MONTH(?stage) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?delivery .
                    FILTER (datatype(?delivery) = xsd:date)
                }
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?assessment .
                    FILTER (datatype(?assessment) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable 2017 Ice Class Regulations compliance method must be section 3.2.2 or section 3.2.4." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage .
                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (datatype(?stage) = xsd:date)
                FILTER (
                    YEAR(?stage) < 2003 ||
                    (YEAR(?stage) = 2003 && MONTH(?stage) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:engineOutputComplianceMethod ?method .
                    FILTER (?method IN (
                        nltl:traficom2017Section3Point2Point2Method,
                        nltl:traficom2017Section3Point2Point4Method
                    ))
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable compliance deadline is 1 January in the year twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage ;
                      nltl:deliveryDate ?delivery ;
                      nltl:assessmentDate ?assessment .
                FILTER (?ice IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (datatype(?stage) = xsd:date)
                FILTER (datatype(?delivery) = xsd:date)
                FILTER (datatype(?assessment) = xsd:date)
                FILTER (
                    YEAR(?stage) < 2003 ||
                    (YEAR(?stage) = 2003 && MONTH(?stage) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?observedAssessment .
                    FILTER (datatype(?observedAssessment) = xsd:date)
                    FILTER (
                        YEAR(?observedAssessment) < YEAR(?delivery) + 20 ||
                        (
                            YEAR(?observedAssessment) = YEAR(?delivery) + 20 &&
                            MONTH(?observedAssessment) = 1 &&
                            DAY(?observedAssessment) <= 1
                        )
                    )
                }
            }
        """
    ] .
