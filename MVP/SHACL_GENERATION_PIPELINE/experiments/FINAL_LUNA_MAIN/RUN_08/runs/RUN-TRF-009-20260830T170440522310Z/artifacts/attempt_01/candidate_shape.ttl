@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-009> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an IA Super or IA ship constructed before 1 September 2003, the required 2017 compliance method and the deadline based on delivery must be satisfied." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:iceClass ?iceClass .
  FILTER (
    ?iceClass = nltl:iceClassIaSuper ||
    ?iceClass = nltl:iceClassIa
  )

  FILTER (
    ! EXISTS {
      $this nltl:constructionStageDate ?constructionDate .
      FILTER (DATATYPE(?constructionDate) = xsd:date)
    }
    ||
    EXISTS {
      $this nltl:constructionStageDate ?constructionDate .
      FILTER (DATATYPE(?constructionDate) = xsd:date)
      FILTER (
        YEAR(?constructionDate) < 2003 ||
        (
          YEAR(?constructionDate) = 2003 &&
          (
            MONTH(?constructionDate) < 9 ||
            (MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1)
          )
        )
      )
      FILTER (
        ! EXISTS {
          $this nltl:deliveryDate ?deliveryDate .
          $this nltl:assessmentDate ?assessmentDate .
          FILTER (DATATYPE(?deliveryDate) = xsd:date)
          FILTER (DATATYPE(?assessmentDate) = xsd:date)
          FILTER (
            YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
            (
              YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
              MONTH(?assessmentDate) = 1 &&
              DAY(?assessmentDate) <= 1
            )
          )
        }
        ||
        ! EXISTS {
          $this nltl:engineOutputComplianceMethod ?method .
          FILTER (
            ?method = nltl:traficom2017Section3Point2Point2Method ||
            ?method = nltl:traficom2017Section3Point2Point4Method
          )
        }
        ||
        EXISTS {
          $this nltl:engineOutputComplianceMethod ?method .
          FILTER (
            ?method != nltl:traficom2017Section3Point2Point2Method &&
            ?method != nltl:traficom2017Section3Point2Point4Method
          )
        }
      )
    }
  )
}
"""
    ] .
