@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A valid construction stage date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A valid ice class is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an IA Super or IA ship whose construction stage began before 1 September 2003, an allowed compliance method and delivery date are required, and the compliance deadline must be 1 January twenty years after the delivery year." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionStageDate .

                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )

                FILTER (
                    YEAR(?constructionStageDate) < 2003
                    ||
                    (
                        YEAR(?constructionStageDate) = 2003
                        && MONTH(?constructionStageDate) < 9
                    )
                )

                OPTIONAL {
                    $this nltl:deliveryDate ?deliveryDate .
                }

                OPTIONAL {
                    $this nltl:engineOutputComplianceMethod ?method .
                }

                FILTER (
                    !BOUND(?deliveryDate)
                    ||
                    !BOUND(?method)
                    ||
                    (
                        datatype(?deliveryDate) = xsd:date
                        &&
                        (
                            MONTH(?deliveryDate) != 1
                            ||
                            DAY(?deliveryDate) != 1
                            ||
                            YEAR(?deliveryDate) + 20 < YEAR(?deliveryDate) + 20
                        )
                    )
                )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:engineOutputComplianceMethodValue ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        ) ;
        sh:maxCount 1
    ] .
