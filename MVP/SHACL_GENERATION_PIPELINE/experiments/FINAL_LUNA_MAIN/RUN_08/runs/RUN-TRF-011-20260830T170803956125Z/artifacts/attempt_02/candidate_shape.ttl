@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_011_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF_011_IceWaterlineShape>
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF_011_IceWaterlineShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline must contain exactly the maximum vertical coordinate at every intended ice-operating longitudinal position, with no missing, mismatched, or extra positions." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  {
    SELECT ?ship ?x (MAX(?iv) AS ?maxV)
    WHERE {
      ?ship nltl:hasIntendedIceOperatingWaterline ?iw .
      ?iw nltl:hasWaterlineProfilePoint ?ip .
      ?ip nltl:longitudinalPosition ?ixq ;
          nltl:verticalCoordinate ?iyq .
      ?ixq qudt:numericValue ?x .
      ?iyq qudt:numericValue ?iv .
      FILTER (?ship = $this)
    }
    GROUP BY ?ship ?x
  } .
  FILTER (
    NOT EXISTS {
      ?this nltl:hasUpperIceWaterline ?uw .
      ?uw nltl:hasWaterlineProfilePoint ?up .
      ?up nltl:longitudinalPosition ?uxq ;
          nltl:verticalCoordinate ?uyq .
      ?uxq qudt:numericValue ?ux .
      ?uyq qudt:numericValue ?uv .
      FILTER (
        ?ux = ?x &&
        ABS(?uv - ?maxV) <=
          IF(
            IF(?maxV < 0, -?maxV, ?maxV) * "0.000001"^^xsd:decimal >
              "0.000001"^^xsd:decimal,
            IF(?maxV < 0, -?maxV, ?maxV) * "0.000001"^^xsd:decimal,
            "0.000001"^^xsd:decimal
          )
      )
    }
    ||
    EXISTS {
      ?this nltl:hasUpperIceWaterline ?uw2 .
      ?uw2 nltl:hasWaterlineProfilePoint ?up2 .
      ?up2 nltl:longitudinalPosition ?uxq2 ;
           nltl:verticalCoordinate ?uyq2 .
      ?uxq2 qudt:numericValue ?ux2 .
      ?uyq2 qudt:numericValue ?uv2 .
      FILTER (
        ?ux2 = ?x &&
        ABS(?uv2 - ?maxV) >
          IF(
            IF(?maxV < 0, -?maxV, ?maxV) * "0.000001"^^xsd:decimal >
              "0.000001"^^xsd:decimal,
            IF(?maxV < 0, -?maxV, ?maxV) * "0.000001"^^xsd:decimal,
            "0.000001"^^xsd:decimal
          )
      )
    }
    ||
    EXISTS {
      ?this nltl:hasUpperIceWaterline ?uw3 .
      ?uw3 nltl:hasWaterlineProfilePoint ?up3 .
      ?up3 nltl:longitudinalPosition ?uxq3 .
      ?uxq3 qudt:numericValue ?ux3 .
      FILTER NOT EXISTS {
        ?this nltl:hasIntendedIceOperatingWaterline ?iw3 .
        ?iw3 nltl:hasWaterlineProfilePoint ?ip3 .
        ?ip3 nltl:longitudinalPosition ?ixq3 .
        ?ixq3 qudt:numericValue ?ux3 .
      }
    }
  )
}
"""
    ] .

<urn:nltl:generated-shape:TRF_011_IceWaterlineShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF_011_ProfilePointShape>
    ] .

<urn:nltl:generated-shape:TRF_011_ProfilePointShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF_011_LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF_011_LengthQuantityShape>
    ] .

<urn:nltl:generated-shape:TRF_011_LengthQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
