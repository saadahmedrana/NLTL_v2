@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:TRF014ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An assessment date is required for the deterministic deadline evaluation."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction date is required to select the applicable marking branch."
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape ;
        sh:message "The summer load line fresh water draught is required."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape ;
        sh:message "The upper ice waterline draught is required."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An ice class is required."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014ClassCertificateShape ;
        sh:message "A class certificate containing the required draught limits is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An ice draught restriction document is required."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice draught restriction information shall be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice draught restriction information shall be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2007-07-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:maxExclusive "2007-07-01"^^xsd:date
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship built on or after 1 July 2007, when the summer load line fresh water draught is above the UIWL, the warning triangle and ice-class draught mark at the maximum permissible amidships draught are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?construction ;
                      nltl:summerLoadLineFreshWaterDraught ?summer ;
                      nltl:upperIceWaterlineDraught ?uiwl .
                ?summer qudt:numericValue ?summerValue .
                ?uiwl qudt:numericValue ?uiwlValue .
                FILTER (?construction >= "2007-07-01"^^xsd:date)
                FILTER (?summerValue > ?uiwlValue)
                FILTER (
                    NOT EXISTS {
                        $this nltl:warningTrianglePresent true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClassDraughtMarkPresent true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClassDraughtMarkDraughtAmidships ?mark ;
                              nltl:hasClassCertificate ?certificate .
                        ?mark qudt:numericValue ?markValue .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximum .
                        ?maximum qudt:numericValue ?maximumValue .
                        FILTER (?markValue = ?maximumValue)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship built before 1 July 2007 without complete marking evidence, the first scheduled dry docking date is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?construction .
                FILTER (?construction < "2007-07-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:warningTrianglePresent true ;
                          nltl:iceClassDraughtMarkPresent true ;
                          nltl:iceClassDraughtMarkDraughtAmidships ?mark ;
                          nltl:hasClassCertificate ?certificate .
                    ?mark qudt:numericValue ?markValue .
                    ?certificate nltl:maximumIceClassDraughtAmidships ?maximum .
                    ?maximum qudt:numericValue ?maximumValue .
                    FILTER (?markValue = ?maximumValue)
                }
                FILTER NOT EXISTS {
                    $this nltl:firstScheduledDryDockingDate ?dryDocking
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a pre-1 July 2007 ship lacking complete marking evidence, the required markings shall be present when the first scheduled dry docking date is on or before the assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?construction ;
                      nltl:firstScheduledDryDockingDate ?dryDocking ;
                      nltl:assessmentDate ?assessment .
                FILTER (?construction < "2007-07-01"^^xsd:date)
                FILTER (?dryDocking <= ?assessment)
                FILTER NOT EXISTS {
                    $this nltl:warningTrianglePresent true ;
                          nltl:iceClassDraughtMarkPresent true ;
                          nltl:iceClassDraughtMarkDraughtAmidships ?mark ;
                          nltl:hasClassCertificate ?certificate .
                    ?mark qudt:numericValue ?markValue .
                    ?certificate nltl:maximumIceClassDraughtAmidships ?maximum .
                    ?maximum qudt:numericValue ?maximumValue .
                    FILTER (?markValue = ?maximumValue)
                }
            }
        """
    ] .

nltlgen:TRF014ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:TRF014LengthQuantityShape
    ] .

nltlgen:TRF014LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
