@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-028> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An approved alternative Ke or RCH basis must have approval status true."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateRevoked
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The alternative approval must be approved or revocable as revoked."
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The approved alternative Ke basis must provide a dimensionless Ke result."
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:node [
                    sh:class nltl:alternativeCalculationEvidence
                ] ;
                sh:minCount 1 ;
                sh:message "The approved alternative Ke basis must provide alternative-calculation evidence."
            ]
        ]
        [
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/N> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The approved alternative RCH basis must provide an RCH result in newtons."
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:node [
                    sh:class nltl:modelTestEvidence
                ] ;
                sh:minCount 1 ;
                sh:message "The approved alternative RCH basis must provide model-test evidence."
            ]
        ]
    ) .
