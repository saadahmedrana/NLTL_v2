@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-028> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When an approved alternative Ke or RCH basis is used, exactly one alternative result with its canonical unit, qualifying evidence, approval status, and revocation-capable evidence state must be provided." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasEvidence ?ev .
                    ?ev a nltl:evidenceArtifact ;
                        a ?evidenceKind .
                    FILTER (
                        ?evidenceKind IN (
                            nltl:alternativeCalculationEvidence,
                            nltl:modelTestEvidence
                        )
                    )
                }

                FILTER (
                    EXISTS { $this nltl:engineOutputCoefficientKe ?ke . }
                    ||
                    EXISTS { $this nltl:brashIceChannelResistanceRch ?rch . }
                )

                FILTER (
                    (
                        EXISTS { $this nltl:engineOutputCoefficientKe ?ke . }
                        &&
                        EXISTS { $this nltl:brashIceChannelResistanceRch ?rch . }
                    )
                    ||
                    (
                        NOT EXISTS { $this nltl:engineOutputCoefficientKe ?ke . }
                        &&
                        NOT EXISTS { $this nltl:brashIceChannelResistanceRch ?rch . }
                    )
                    ||
                    (
                        EXISTS { $this nltl:engineOutputCoefficientKe ?ke . }
                        &&
                        NOT EXISTS { $this nltl:brashIceChannelResistanceRch ?rch . }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:engineOutputCoefficientKe ?keValue .
                                ?keValue qudt:numericValue ?keNumber ;
                                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (datatype(?keNumber) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                $this nltl:engineOutputCoefficientKe ?keValue .
                                FILTER EXISTS {
                                    ?keValue qudt:numericValue ?keNumber .
                                    FILTER (datatype(?keNumber) != xsd:decimal)
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:engineOutputCoefficientKe ?keValue .
                                FILTER NOT EXISTS {
                                    ?keValue qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:approvalStatus ?approval .
                                FILTER (!(datatype(?approval) = xsd:boolean && ?approval = true))
                            }
                            ||
                            EXISTS {
                                $this nltl:approvalRevocationStatus ?state .
                                FILTER (
                                    ?state NOT IN (
                                        nltl:evidenceStateApproved,
                                        nltl:evidenceStateRevoked
                                    )
                                )
                            }
                        )
                    )
                    ||
                    (
                        EXISTS { $this nltl:brashIceChannelResistanceRch ?rch . }
                        &&
                        NOT EXISTS { $this nltl:engineOutputCoefficientKe ?ke . }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:brashIceChannelResistanceRch ?rchValue .
                                ?rchValue qudt:numericValue ?rchNumber ;
                                    qudt:unit <http://qudt.org/vocab/unit/N> .
                                FILTER (datatype(?rchNumber) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                $this nltl:brashIceChannelResistanceRch ?rchValue .
                                FILTER EXISTS {
                                    ?rchValue qudt:numericValue ?rchNumber .
                                    FILTER (datatype(?rchNumber) != xsd:decimal)
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:brashIceChannelResistanceRch ?rchValue .
                                FILTER NOT EXISTS {
                                    ?rchValue qudt:unit <http://qudt.org/vocab/unit/N> .
                                }
                            }
                            ||
                            EXISTS {
                                $this nltl:approvalStatus ?approval .
                                FILTER (!(datatype(?approval) = xsd:boolean && ?approval = true))
                            }
                            ||
                            EXISTS {
                                $this nltl:approvalRevocationStatus ?state .
                                FILTER (
                                    ?state NOT IN (
                                        nltl:evidenceStateApproved,
                                        nltl:evidenceStateRevoked
                                    )
                                )
                            }
                        )
                    )
                )
            }
        """
    ] .
