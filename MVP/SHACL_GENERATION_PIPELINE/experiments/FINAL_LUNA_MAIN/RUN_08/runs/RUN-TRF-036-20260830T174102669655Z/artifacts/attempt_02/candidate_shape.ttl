@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_036_IceClassDesignParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ice-class design parameter set must identify an ice class."
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Level ice thickness must be supplied as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Design ice load height must be supplied as a single metre quantity."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Level ice thickness or design ice load height does not conform to the Table 4-1 values for the ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?thickness ;
                      nltl:designIceLoadHeight ?height .
                ?thickness qudt:numericValue ?thicknessValue .
                ?height qudt:numericValue ?heightValue .
                FILTER (
                    !(
                        (
                            ?class = nltl:iceClassIaSuper &&
                            ?thicknessValue <= "1.0"^^xsd:decimal &&
                            ?heightValue >= "0.35"^^xsd:decimal &&
                            ?heightValue <= "0.35"^^xsd:decimal
                        ) ||
                        (
                            ?class = nltl:iceClassIa &&
                            ?thicknessValue <= "0.8"^^xsd:decimal &&
                            ?heightValue >= "0.30"^^xsd:decimal &&
                            ?heightValue <= "0.30"^^xsd:decimal
                        ) ||
                        (
                            ?class = nltl:iceClassIb &&
                            ?thicknessValue <= "0.6"^^xsd:decimal &&
                            ?heightValue >= "0.25"^^xsd:decimal &&
                            ?heightValue <= "0.25"^^xsd:decimal
                        ) ||
                        (
                            ?class = nltl:iceClassIc &&
                            ?thicknessValue <= "0.4"^^xsd:decimal &&
                            ?heightValue >= "0.22"^^xsd:decimal &&
                            ?heightValue <= "0.22"^^xsd:decimal
                        )
                    )
                )
            }
        """
    ] .
