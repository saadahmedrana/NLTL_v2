@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:TRF-036-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassDesignParameterSet ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceClassDesignParameterSet
        ]
    ] .

<urn:nltl:generated-shape:TRF-036-ParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Level ice thickness and design ice load height must satisfy the Table 4-1 values for the selected ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?levelQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity .
                ?levelQuantity qudt:numericValue ?levelValue .
                ?heightQuantity qudt:numericValue ?heightValue .
                FILTER (
                    (
                        ?class = nltl:iceClassIaSuper &&
                        (?levelValue > 1.0 || ?heightValue < 0.35 || ?heightValue > 0.35)
                    ) ||
                    (
                        ?class = nltl:iceClassIa &&
                        (?levelValue > 0.8 || ?heightValue < 0.30 || ?heightValue > 0.30)
                    ) ||
                    (
                        ?class = nltl:iceClassIb &&
                        (?levelValue > 0.6 || ?heightValue < 0.25 || ?heightValue > 0.25)
                    ) ||
                    (
                        ?class = nltl:iceClassIc &&
                        (?levelValue > 0.4 || ?heightValue < 0.22 || ?heightValue > 0.22)
                    )
                )
            }
        """
    ] .
