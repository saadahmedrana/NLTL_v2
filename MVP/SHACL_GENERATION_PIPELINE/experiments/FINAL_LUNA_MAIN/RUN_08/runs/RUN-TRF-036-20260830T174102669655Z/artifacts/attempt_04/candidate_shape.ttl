@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF036ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassDesignParameterSet
    ] .

gen:TRF036IceClassDesignParameterSetShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Level ice thickness must not exceed the Table 4-1 value and design ice load height must equal its class-specific Table 4-1 value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?class ;
                      nltl:levelIceThickness ?thickness ;
                      nltl:designIceLoadHeight ?height .
                ?thickness qudt:numericValue ?thicknessValue .
                ?height qudt:numericValue ?heightValue .
                FILTER (
                    (
                        ?class = nltl:iceClassIaSuper &&
                        (
                            ?thicknessValue > 1.0 ||
                            ?heightValue < 0.35 ||
                            ?heightValue > 0.35
                        )
                    ) ||
                    (
                        ?class = nltl:iceClassIa &&
                        (
                            ?thicknessValue > 0.8 ||
                            ?heightValue < 0.30 ||
                            ?heightValue > 0.30
                        )
                    ) ||
                    (
                        ?class = nltl:iceClassIb &&
                        (
                            ?thicknessValue > 0.6 ||
                            ?heightValue < 0.25 ||
                            ?heightValue > 0.25
                        )
                    ) ||
                    (
                        ?class = nltl:iceClassIc &&
                        (
                            ?thicknessValue > 0.4 ||
                            ?heightValue < 0.22 ||
                            ?heightValue > 0.22
                        )
                    )
                )
            }
        """
    ] .
