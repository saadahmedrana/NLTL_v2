@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthMillimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureMegaPascalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TransversePlatingReadinessShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:hasValue nltl:transverseFramingOrientation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Transverse framing orientation is required."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Spacing is required in metres."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice pressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:transversePlatingFactorF1 ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The transverse plating factor is required."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The corrosion and abrasion addition is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally determined shell plating thickness is required in millimetres."
    ] .

gen:LongitudinalPlatingReadinessShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:hasValue nltl:longitudinalFramingOrientation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Longitudinal framing orientation is required."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Spacing is required in metres."
    ] ;
    sh:property [
        sh:path nltl:platingPressure ;
        sh:node gen:PressureMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Plating pressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The longitudinal plating factor is required."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The corrosion and abrasion addition is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally determined shell plating thickness is required in millimetres."
    ] .

gen:TRF041PlatingReadinessShape a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:or (
        gen:TransversePlatingReadinessShape
        gen:LongitudinalPlatingReadinessShape
    ) ;
    sh:message "The plating record shall provide the applicable transverse or longitudinal calculation inputs and externally determined shell plating thickness."
    .
