@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF043QuantityMShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF043QuantityMmShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF043PermittedTerminationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:node gen:TRF043QuantityMmShape ;
        sh:maxInclusive 250 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The extension must be no more than 250 mm for termination at an adjacent boundary to be permitted."
    ] ;
    sh:property [
        sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Termination at the adjacent boundary must be marked as permitted when the extension is no more than 250 mm."
    ] ;
    sh:property [
        sh:path nltl:terminationAdjacentBoundary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or (
            [ sh:class nltl:deckStructure ]
            [ sh:class nltl:tankBoundaryPlating ]
            [ sh:class nltl:tankTop ]
        ) ;
        sh:message "The termination boundary must be a deck structure, tank boundary plating, or tank top."
    ] .

gen:TRF043BeyondTerminationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:node gen:TRF043QuantityMmShape ;
        sh:minExclusive 250 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF043TerminationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:node gen:TRF043QuantityMmShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:TRF043PermittedTerminationShape
        gen:TRF043BeyondTerminationShape
    ) .

gen:TRF043FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The frame must identify a permitted ice class."
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:bowRegion
            nltl:midbodyRegion
            nltl:sternRegion
        ) ;
        sh:message "The frame must identify the applicable bow, midbody, or stern hull region."
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node gen:TRF043QuantityMShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must record its vertical framing extent above the upper ice waterline in metres."
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node gen:TRF043QuantityMShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must record its vertical framing extent below the lower ice waterline in metres."
    ] ;
    sh:property [
        sh:path nltl:upperBowIceBeltRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:reachesUpperBowIceBeltTop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:reachesTankTopOrBelowFloorTop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When an upper bow ice belt is required, the framing must reach its top." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperBowIceBeltRequired ?required .
                $this nltl:reachesUpperBowIceBeltTop ?reaches .
                FILTER (?required = true && ?reaches != true)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing extent above the upper ice waterline does not meet the applicable Table 4-6 minimum." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                $this nltl:framingIceStrengtheningAboveUpperIceWaterline ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (
                    (?iceClass = nltl:iceClassIaSuper && ?value < 1.2) ||
                    ((?iceClass = nltl:iceClassIa ||
                      ?iceClass = nltl:iceClassIb ||
                      ?iceClass = nltl:iceClassIc) && ?value < 1.0)
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing extent below the lower ice waterline does not meet the applicable Table 4-6 minimum." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                $this nltl:hullRegion ?region .
                $this nltl:reachesTankTopOrBelowFloorTop ?reachesTank .
                $this nltl:framingIceStrengtheningBelowLowerIceWaterline ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (
                    (?iceClass = nltl:iceClassIaSuper &&
                     ?region = nltl:bowRegion &&
                     ?reachesTank != true) ||
                    (?iceClass = nltl:iceClassIaSuper &&
                     ?region = nltl:midbodyRegion &&
                     ?value < 2.0) ||
                    (?iceClass = nltl:iceClassIaSuper &&
                     ?region = nltl:sternRegion &&
                     ?value < 1.6) ||
                    ((?iceClass = nltl:iceClassIa ||
                      ?iceClass = nltl:iceClassIb ||
                      ?iceClass = nltl:iceClassIc) &&
                     ?region = nltl:bowRegion &&
                     ?value < 1.6) ||
                    ((?iceClass = nltl:iceClassIa ||
                      ?iceClass = nltl:iceClassIb ||
                      ?iceClass = nltl:iceClassIc) &&
                     ?region = nltl:midbodyRegion &&
                     ?value < 1.3) ||
                    ((?iceClass = nltl:iceClassIa ||
                      ?iceClass = nltl:iceClassIb ||
                      ?iceClass = nltl:iceClassIc) &&
                     ?region = nltl:sternRegion &&
                     ?value < 1.0)
                )
            }
        """
    ] .

gen:TRF043ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:node gen:TRF043TerminationCaseShape
    ] .
