@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF043ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:node <urn:nltl:generated-shape:TRF043TerminationCaseShape>
    ] .

<urn:nltl:generated-shape:TRF043FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:upperBowIceBeltRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF043UpperBeltRequiredShape>
        <urn:nltl:generated-shape:TRF043UpperBeltNotRequiredShape>
    ) ;
    sh:or (
        <urn:nltl:generated-shape:TRF043IaSuperBowShape>
        <urn:nltl:generated-shape:TRF043IaSuperMidbodyShape>
        <urn:nltl:generated-shape:TRF043IaSuperSternShape>
        <urn:nltl:generated-shape:TRF043IaIbIcBowShape>
        <urn:nltl:generated-shape:TRF043IaIbIcMidbodyShape>
        <urn:nltl:generated-shape:TRF043IaIbIcSternShape>
    ) .

<urn:nltl:generated-shape:TRF043UpperBeltRequiredShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:upperBowIceBeltRequired ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:reachesUpperBowIceBeltTop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

<urn:nltl:generated-shape:TRF043UpperBeltNotRequiredShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:upperBowIceBeltRequired ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:TRF043IaSuperBowShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:hasValue nltl:bowRegion
    ] ;
    sh:property [
        sh:path nltl:reachesTankTopOrBelowFloorTop ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Above1200mmShape>
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Below2000mmShape>
    ] .

<urn:nltl:generated-shape:TRF043IaSuperMidbodyShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:hasValue nltl:midbodyRegion
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Above1200mmShape>
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Below2000mmShape>
    ] .

<urn:nltl:generated-shape:TRF043IaSuperSternShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:hasValue nltl:sternRegion
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Above1200mmShape>
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Below1600mmShape>
    ] .

<urn:nltl:generated-shape:TRF043IaIbIcBowShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:hasValue nltl:bowRegion
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Above1000mmShape>
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Below1600mmShape>
    ] .

<urn:nltl:generated-shape:TRF043IaIbIcMidbodyShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:hasValue nltl:midbodyRegion
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Above1000mmShape>
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Below1300mmShape>
    ] .

<urn:nltl:generated-shape:TRF043IaIbIcSternShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:hasValue nltl:sternRegion
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Above1000mmShape>
    ] ;
    sh:property [
        sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF043Below1000mmShape>
    ] .

<urn:nltl:generated-shape:TRF043Above1200mmShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.2 ;
        sh:maxInclusive 1.2
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:TRF043Above1000mmShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 1.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:TRF043Below2000mmShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 2.0 ;
        sh:maxInclusive 2.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:TRF043Below1600mmShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.6 ;
        sh:maxInclusive 1.6
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:TRF043Below1300mmShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.3 ;
        sh:maxInclusive 1.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:TRF043Below1000mmShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 1.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:TRF043TerminationCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:terminationAdjacentBoundary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:class nltl:deckStructure
            ]
            [
                sh:class nltl:tankBoundaryPlating
            ]
            [
                sh:class nltl:tankTop
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF043ExtensionMillimetresShape>
    ] ;
    sh:property [
        sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An extension of 250 mm or less requires termination at the adjacent boundary to be permitted." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
  ?quantity qudt:numericValue ?extension .
  FILTER(?extension <= 250)
  FILTER NOT EXISTS {
    $this nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true
  }
}
"""
    ] .

<urn:nltl:generated-shape:TRF043ExtensionMillimetresShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
