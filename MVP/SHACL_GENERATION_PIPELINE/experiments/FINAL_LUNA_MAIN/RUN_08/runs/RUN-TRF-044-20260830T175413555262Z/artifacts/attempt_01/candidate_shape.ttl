@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-044> a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:class nltl:frameBoundaryConditionTypeValue ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:twoDeckFrameCondition
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A transverse frame shall have one permitted frame boundary condition type."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice pressure shall be provided as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Frame spacing shall be provided as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Design ice load height shall be provided as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Frame span shall be provided as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame boundary-condition factor m0 shall be provided as a single dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength shall be provided as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame moment factor mt shall be provided as a single dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Section modulus shall be provided as a single cm3 quantity."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Required shear area shall be provided as a single cm2 quantity."
    ] ;
    sh:sparql [
        sh:message "m0 shall match the selected Table 4-7 boundary condition, and mt, section modulus, and required shear area shall match their declared formulas within a relative tolerance of 1e-6 with a small absolute fallback near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:icePressure ?pNode ;
                      nltl:spacing ?sNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?sNode qudt:numericValue ?s .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?m0Node qudt:numericValue ?m0 .
                ?sigmaNode qudt:numericValue ?sigma .
                ?mtNode qudt:numericValue ?mt .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND ((7 * ?m0) / (7 - (5 * ?h / ?l)) AS ?expectedMt)
                BIND ((?p * ?s * ?h * ?l / (?expectedMt * ?sigma)) * 1000000 AS ?expectedZ)
                BIND ((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma)) * 10000 AS ?expectedA)

                FILTER (
                    (
                        ?condition = nltl:bulkCarrierTopWingTankFrameCondition &&
                        ?m0 >= 7 && ?m0 <= 7
                    ) ||
                    (
                        ?condition = nltl:singleDeckTankTopToMainDeckFrameCondition &&
                        ?m0 >= 6 && ?m0 <= 6
                    ) ||
                    (
                        ?condition = nltl:multiDeckOrStringerContinuousFrameCondition &&
                        ?m0 >= 5.7 && ?m0 <= 5.7
                    ) ||
                    (
                        ?condition = nltl:twoDeckFrameCondition &&
                        ?m0 >= 5 && ?m0 <= 5
                    )
                )

                FILTER (
                    ABS(?mt - ?expectedMt) > (ABS(?expectedMt) * 0.000001 + 0.000001) ||
                    ABS(?z - ?expectedZ) > (ABS(?expectedZ) * 0.000001 + 0.000001) ||
                    ABS(?a - ?expectedA) > (ABS(?expectedA) * 0.000001 + 0.000001)
                )
            }
        """
    ] .
