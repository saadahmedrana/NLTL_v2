@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_047_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:frameStrengthenedPart ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:frameEnd ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:hasAttachedSupportingStructure ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:supportingStructure ;
                                    sh:or (
                                        [ sh:class nltl:deckStructure ]
                                        [ sh:class nltl:tankBoundaryPlating ]
                                        [ sh:class nltl:tankTop ]
                                        [ sh:class nltl:iceStringer ]
                                    )
                                ] ;
                                sh:message "The lower end must be attached to a deck, tank boundary plating, tank top, or ice stringer."
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:hasTerminationBelowSupportingStructure ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:supportingStructure ;
                                    sh:property [
                                        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue true
                                    ]
                                ]
                            ] ;
                            sh:property [
                                sh:path nltl:hasHorizontalConnectionMember ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:horizontalConnectionMember ;
                                    sh:property [
                                        sh:path nltl:connectsToAdjacentMainFrame ;
                                        sh:minCount 1 ;
                                        sh:node [
                                            sh:class nltl:mainFrame ;
                                            sh:property [
                                                sh:path nltl:mainFrameBelowIceBeltStrengthened ;
                                                sh:datatype xsd:boolean ;
                                                sh:minCount 1 ;
                                                sh:maxCount 1 ;
                                                sh:hasValue true
                                            ]
                                        ]
                                    ] ;
                                    sh:property [
                                        sh:path nltl:sameScantlingsAsMainFrame ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue true
                                    ]
                                ] ;
                                sh:message "A lower end terminating below a supporting structure at or below the ice-belt lower limit must have a horizontal member connected to an adjacent ice-strengthened main frame with the same scantlings."
                            ]
                        ]
                    )
                ]
            ]
        ]
    ] .
