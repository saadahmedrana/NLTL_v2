@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF047Shape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:class nltl:mainFrame ;
            sh:property [
                sh:path nltl:mainFrameBelowIceBeltStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "A main frame covered by this rule must be ice strengthened below the ice belt."
            ] ;
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasLowerEnd ;
                        sh:minCount 1 ;
                        sh:node gen:TRF047AttachedLowerEndShape
                    ]
                ] ;
                sh:message "The strengthened part of a main frame must have a lower end attached to a permitted supporting structure."
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasStrengthenedPart ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasLowerEnd ;
                                sh:minCount 1 ;
                                sh:node gen:TRF047AttachedLowerEndShape
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:sameScantlingsAsMainFrame ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasStrengthenedPart ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasLowerEnd ;
                                sh:minCount 1 ;
                                sh:node gen:TRF047HorizontalLowerEndShape
                            ]
                        ]
                    ]
                ]
            ) ;
            sh:message "An intermediate ice frame must use an attached supporting structure, or the permitted below-ice-belt horizontal-member alternative."
        ]
    ) ;
    sh:message "Only strengthened main frames and intermediate ice frames are subject to this lower-end constraint." .

gen:TRF047AttachedLowerEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:tankTop ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The lower end must be attached to a deck structure, tank boundary plating, tank top, or ice stringer."
    ] .

gen:TRF047HorizontalLowerEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:supportingStructure
        ] ;
        sh:message "The intermediate frame lower end must terminate below the qualifying supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:mainFrame
                ] ;
                sh:message "The horizontal member must connect to an adjacent main frame."
            ]
        ] ;
        sh:message "The qualifying intermediate frame lower end must have a horizontal connection member."
    ] .
