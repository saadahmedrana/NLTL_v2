@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF049_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A frame governed by this requirement must be within the ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:node nltl:TRF049_FrameAttachmentShape ;
        sh:message "The frame must have an effective attachment record."
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:node nltl:TRF049_SupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:node nltl:TRF049_SupportingStructureShape
    ] .

nltl:TRF049_FrameAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be confirmed as effective."
    ] .

nltl:TRF049_SupportingStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:minCount 1 ;
        sh:node nltl:TRF049_FrameAttachmentShape ;
        sh:message "Each linked supporting structure must have an attachment record."
    ] .

nltl:TRF049_LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:node nltl:TRF049_BracketAttachmentShape ;
        sh:message "A longitudinal frame must be attached by brackets."
    ] .

nltl:TRF049_TransverseFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue false
            ]
            [
                sh:hasValue true ;
                sh:node nltl:TRF049_TerminatingTransverseFrameShape
            ]
        ) ;
        sh:message "The termination condition must be recorded; a terminating transverse frame requires a bracket or similar construction."
    ] .

nltl:TRF049_TerminatingTransverseFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:or (
            [
                sh:node nltl:TRF049_BracketAttachmentShape
            ]
            [
                sh:node nltl:TRF049_SimilarAttachmentShape
            ]
        ) ;
        sh:message "A transverse frame terminating at a deck or ice stringer must have a bracket or similar construction."
    ] .

nltl:TRF049_SimilarAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

nltl:TRF049_BracketAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:minCount 1 ;
        sh:node nltl:TRF049_ConnectionBracketShape ;
        sh:message "The attachment must include a connection bracket."
    ] ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

nltl:TRF049_ConnectionBracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "The bracket thickness must be supplied in millimetres."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened against buckling."
    ] ;
    sh:sparql [
        sh:message "The bracket thickness must be at least the frame web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?attachment nltl:hasConnectionBracket $this .
                ?frame nltl:hasFrameAttachment ?attachment .
                ?this nltl:bracketThickness ?bracketQuantity .
                ?bracketQuantity qudt:numericValue ?bracketValue .
                ?frame nltl:frameWebThickness ?webQuantity .
                ?webQuantity qudt:numericValue ?webValue .
                FILTER (?bracketValue < ?webValue)
            }
        """
    ] .

nltl:TRF049_PassingThroughFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue false
            ]
            [
                sh:hasValue true ;
                sh:property [
                    sh:path nltl:webPlateConnectionSideCount ;
                    sh:datatype xsd:integer ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:minInclusive 2 ;
                    sh:message "A frame passing through a supporting structure must have both sides of its web plate connected."
                ]
            ]
        ) ;
        sh:message "The through-structure condition must be recorded."
    ] .
