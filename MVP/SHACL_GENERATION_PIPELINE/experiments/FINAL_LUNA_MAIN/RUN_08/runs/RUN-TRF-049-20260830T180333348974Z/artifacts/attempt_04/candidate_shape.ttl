@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF049_QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF049_BracketShape>
    a sh:NodeShape ;
    sh:class nltl:connectionBracket ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:node <urn:nltl:generated-shape:TRF049_QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each installed connection bracket must have a single millimetre bracket thickness."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The connection bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The connection bracket must be stiffened against buckling."
    ] .

<urn:nltl:generated-shape:TRF049_FrameAttachmentShape>
    a sh:NodeShape ;
    sh:class nltl:frameAttachmentRecord ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each applicable frame attachment must be confirmed effective."
    ] ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape> ;
        sh:message "Each frame attachment must identify its attached supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:class nltl:connectionBracket ;
        sh:node <urn:nltl:generated-shape:TRF049_BracketShape> ;
    ] .

<urn:nltl:generated-shape:TRF049_AttachmentEvidenceShape>
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:class nltl:connectionBracket ;
                sh:node <urn:nltl:generated-shape:TRF049_BracketShape> ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF049_SupportingStructureShape>
    a sh:NodeShape ;
    sh:class nltl:supportingStructure ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:class nltl:frameAttachment ;
        sh:minCount 1 ;
        sh:message "Each supplied supporting structure must identify its frame attachment."
    ] .

<urn:nltl:generated-shape:TRF049_IceAreaShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:class nltl:frameAttachmentRecord ;
        sh:node <urn:nltl:generated-shape:TRF049_FrameAttachmentShape> ;
        sh:minCount 1 ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSupportingBulkhead ;
                sh:class nltl:supportingStructure ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasSupportingWebFrame ;
                sh:class nltl:supportingStructure ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape>
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every frame attachment must be effectively attached to every supplied supporting bulkhead or web frame, and the supporting structure must reference the same attachment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment .
                {
                    $this nltl:hasSupportingBulkhead ?support .
                }
                UNION
                {
                    $this nltl:hasSupportingWebFrame ?support .
                }
                FILTER NOT EXISTS {
                    ?attachment nltl:hasAttachedSupportingStructure ?support .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every installed connection bracket must be at least as thick as the frame web plate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameWebThickness ?frameThickness .
                ?frameThickness q:numericValue ?frameValue ;
                                q:unit <http://qudt.org/vocab/unit/MilliM> .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?bracketThickness q:numericValue ?bracketValue ;
                                  q:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (xsd:decimal(?bracketValue) < xsd:decimal(?frameValue))
            }
        """
    ] .

<urn:nltl:generated-shape:TRF049_LongitudinalShape>
    a sh:NodeShape ;
    sh:class nltl:longitudinalFrame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A longitudinal frame must be attached by a connection bracket to every supplied supporting web frame and bulkhead." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment .
                {
                    $this nltl:hasSupportingBulkhead ?support .
                }
                UNION
                {
                    $this nltl:hasSupportingWebFrame ?support .
                }
                FILTER NOT EXISTS {
                    ?attachment nltl:hasAttachedSupportingStructure ?support .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                    ?bracket a nltl:connectionBracket .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF049_TerminatingShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:node <urn:nltl:generated-shape:TRF049_AttachmentEvidenceShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF049_NonTerminatingShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:TRF049_PassingThroughShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:webPlateConnectionSideCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2 ;
        sh:message "A frame passing through a supporting structure must have both web-plate sides connected."
    ] .

<urn:nltl:generated-shape:TRF049_NonPassingThroughShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:TRF049_TransverseShape>
    a sh:NodeShape ;
    sh:class nltl:transverseFrame ;
    sh:or (
        [
            sh:node <urn:nltl:generated-shape:TRF049_TerminatingShape>
        ]
        [
            sh:node <urn:nltl:generated-shape:TRF049_NonTerminatingShape>
        ]
    ) ;
    sh:or (
        [
            sh:node <urn:nltl:generated-shape:TRF049_PassingThroughShape>
        ]
        [
            sh:node <urn:nltl:generated-shape:TRF049_NonPassingThroughShape>
        ]
    ) .

<urn:nltl:generated-shape:TRF049_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must state whether it is within the ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:node <urn:nltl:generated-shape:TRF049_QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame web thickness must be a single millimetre quantity."
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:class nltl:supportingStructure ;
        sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape>
    ] ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:class nltl:supportingStructure ;
        sh:node <urn:nltl:generated-shape:TRF049_SupportingStructureShape>
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node <urn:nltl:generated-shape:TRF049_IceAreaShape>
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:or (
        [
            sh:node <urn:nltl:generated-shape:TRF049_LongitudinalShape>
        ]
        [
            sh:node <urn:nltl:generated-shape:TRF049_TransverseShape>
        ]
    ) .
