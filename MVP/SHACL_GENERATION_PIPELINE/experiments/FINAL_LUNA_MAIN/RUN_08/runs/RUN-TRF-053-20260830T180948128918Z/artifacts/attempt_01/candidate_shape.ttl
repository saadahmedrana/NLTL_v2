@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF053_IceStringerShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide ice pressure as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide design ice load height as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide span as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide frame moment factor m as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide yield strength as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide the calculated design line load as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide the calculated section modulus as a single quantity value."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ice stringer must provide the calculated required shear area as a single quantity value."
    ] ;
    sh:sparql [
        sh:message "The design line load, section modulus, and required shear area must satisfy the TRF-053 formulas; calculated decimal results are checked with a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?qNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p ;
                       qudt:unit unit:MegaPA .
                ?hNode qudt:numericValue ?h ;
                       qudt:unit unit:M .
                ?lNode qudt:numericValue ?l ;
                       qudt:unit unit:M .
                ?mNode qudt:numericValue ?m ;
                       qudt:unit unit:UNITLESS .
                ?sigmaNode qudt:numericValue ?sigma ;
                           qudt:unit unit:MegaPA .
                ?qNode qudt:numericValue ?q ;
                       qudt:unit unit:KiloN-PER-M .
                ?zNode qudt:numericValue ?z ;
                       qudt:unit unit:CentiM3 .
                ?aNode qudt:numericValue ?a ;
                       qudt:unit unit:CentiM2 .

                BIND (?p * ?h AS ?product)
                BIND (IF(?product < 0.15, 0.15, ?product) AS ?qMNPerM)
                BIND (1000 * ?qMNPerM AS ?expectedQ)
                BIND (0.9 * 1.8 * ?qMNPerM * ?l * ?l / (?m * ?sigma) * 1000000 AS ?expectedZ)
                BIND (1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?qMNPerM * ?l / (2 * ?sigma) * 10000 AS ?expectedA)

                FILTER (
                    ABS(?q - ?expectedQ) > (0.000001 * ABS(?expectedQ) + 0.000000001)
                    || ABS(?z - ?expectedZ) > (0.000001 * ABS(?expectedZ) + 0.000000001)
                    || ABS(?a - ?expectedA) > (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """
    ] .
