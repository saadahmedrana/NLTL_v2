@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF055_NarrowDeckStripShape>
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        _:trf055Branch1
        _:trf055Branch2
        _:trf055Branch3
    ) .

_:trf055Branch1
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:hasValue false
    ] .

_:trf055Branch2
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:hasValue false
    ] .

_:trf055Branch3
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:hasValue true
    ] ;
    sh:node <urn:nltl:generated-shape:TRF055_ApplicableShape> .

<urn:nltl:generated-shape:TRF055_ApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Actual section modulus and shear area shall meet their required values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZ .
                $this nltl:requiredSectionModulus ?requiredZ .
                $this nltl:actualShearArea ?actualA .
                $this nltl:requiredShearArea ?requiredA .
                ?actualZ qudt:numericValue ?actualZValue .
                ?requiredZ qudt:numericValue ?requiredZValue .
                ?actualA qudt:numericValue ?actualAValue .
                ?requiredA qudt:numericValue ?requiredAValue .
                FILTER (
                    ?actualZValue >= ?requiredZValue &&
                    ?actualAValue >= ?requiredAValue
                )
            }
        """
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:permittedReducedLineLoad ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ;
                sh:property [
                    sh:path qudt:unit ;
                    sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ] ;
            sh:property [
                sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "For a very long hatch, the approved reduced line load shall be at least 0.10 and less than 0.15 kN/m." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:permittedReducedLineLoad ?load .
                        ?load qudt:numericValue ?loadValue .
                        FILTER (?loadValue >= 0.10 && ?loadValue < 0.15)
                    }
                """
            ]
        ]
    ) .
