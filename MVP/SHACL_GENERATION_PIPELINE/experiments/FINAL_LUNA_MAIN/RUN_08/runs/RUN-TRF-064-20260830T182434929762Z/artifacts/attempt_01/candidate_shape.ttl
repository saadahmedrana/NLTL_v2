@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:minCount 1 ;
        sh:node gen:TRF064EnclosureShape ;
        sh:message "Each side propeller shafting assembly shall be enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:minCount 1 ;
        sh:node gen:TRF064EnclosureShape ;
        sh:message "Each stern tube of a side propeller shall be enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:node gen:TRF064DetachedStrutShape
    ] .

gen:TRF064EnclosureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:message "The shafting or stern tube shall have an enclosing plated bossing."
    ] .

gen:TRF064DetachedStrutShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutDesignEvidence ;
        sh:message "A detached strut shall have evidence addressing its design."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutStrengthEvidence ;
        sh:message "A detached strut shall have evidence addressing its strength."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutHullAttachmentEvidence ;
        sh:message "A detached strut shall have evidence addressing its attachment to the hull."
    ] .
