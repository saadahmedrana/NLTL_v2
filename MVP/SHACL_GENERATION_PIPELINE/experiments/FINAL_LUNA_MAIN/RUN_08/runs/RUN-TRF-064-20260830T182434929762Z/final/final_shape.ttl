@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:class nltl:sidePropellerShaftingAssembly ;
        sh:node gen:EnclosedComponentShape
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:class nltl:sternTube ;
        sh:node gen:EnclosedComponentShape
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:class nltl:detachedStrutStructure ;
        sh:node gen:DetachedStrutShape
    ] .

gen:EnclosedComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:class nltl:platedBossingStructure ;
        sh:minCount 1 ;
        sh:message "The side-propeller shafting or stern tube must be enclosed within plated bossing."
    ] .

gen:DetachedStrutShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:class nltl:strutDesignEvidence ;
        sh:minCount 1 ;
        sh:message "A detached strut must have design evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:class nltl:strutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:message "A detached strut must have hull-attachment evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:class nltl:strutStrengthEvidence ;
        sh:minCount 1 ;
        sh:message "A detached strut must have strength evidence."
    ] .
