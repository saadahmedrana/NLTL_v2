@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have one ice class to determine applicability of the rudder protection requirement."
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice classes IA and IA Super, iceKnifePracticable must be recorded and the rudder protection arrangement must use an ice knife extending below the LIWL when practicable, or an equivalent rudder protection means otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIa ||
                    ?iceClass = nltl:iceClassIaSuper
                )

                {
                    FILTER NOT EXISTS {
                        $this nltl:iceKnifePracticable ?practicable .
                        FILTER (
                            ?practicable = true ||
                            ?practicable = false
                        )
                    }
                }
                UNION
                {
                    $this nltl:iceKnifePracticable ?practicable .
                    FILTER (
                        ?practicable = true ||
                        ?practicable = false
                    )
                    FILTER NOT EXISTS {
                        $this nltl:hasRudderProtectionArrangement ?arrangement .
                        {
                            ?arrangement rdf:type nltl:iceKnife .
                            ?arrangement nltl:extendsBelowLowerIceWaterline true .
                            FILTER (?practicable = true)
                        }
                        UNION
                        {
                            ?arrangement rdf:type nltl:equivalentRudderProtectionMeans .
                            FILTER (?practicable = false)
                        }
                    }
                }
            }
        """
    ] .
