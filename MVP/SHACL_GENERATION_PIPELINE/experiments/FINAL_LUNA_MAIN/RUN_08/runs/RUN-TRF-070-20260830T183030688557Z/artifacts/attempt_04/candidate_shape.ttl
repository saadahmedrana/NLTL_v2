@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:TRF070ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:in ( "azimuthing" "fixed" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A main-propulsion thruster type must be azimuthing or fixed."
    ] ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify the applicable thruster as main propulsion."
    ] ;
    sh:property [
        sh:path nltl:serviceLife ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:ServiceLifeQuantityShape ;
        sh:message "The ship must provide its service-life quantity."
    ] ;
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:message "The ship must provide the propeller/ice interaction load in kN."
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:message "The ship must provide the thruster-body/ice interaction load in kN."
    ] ;
    sh:property [
        sh:path nltl:extremeLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:message "The ship must provide the extreme-load quantity in kN."
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:minCount 1 ;
        sh:node nltlgen:DesignConditionShape ;
        sh:message "The ship must link a design condition containing the normal-operational expected-load context."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:thrusterBodyLocalStrength ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltlgen:MegaPascalQuantityShape ;
                sh:message "Local ice pressure is required when the thruster body is designed for extreme loads."
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:minCount 1 ;
                sh:node nltlgen:LocalStrengthConditionShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:thrusterBodyLocalStrength ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .

nltlgen:DesignConditionShape
    a sh:NodeShape ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The design condition must identify normal operational conditions."
    ] ;
    sh:property [
        sh:path nltl:designConditionExpectedLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:message "The design condition must provide the expected load in kN."
    ] .

nltlgen:LocalStrengthConditionShape
    a sh:NodeShape ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:designConditionLocalStrengthCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:message "The design condition must provide the local-strength capacity in kN."
    ] ;
    sh:sparql [
        sh:message "The local-strength capacity must be at least the applicable local ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasDesignCondition $this ;
                      nltl:thrusterBodyLocalStrength true ;
                      nltl:localIcePressure ?pressure .
                $this nltl:designConditionLocalStrengthCapacity ?capacity .
                ?pressure qudt:numericValue ?pressureValue ;
                          qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?capacity qudt:numericValue ?capacityValue ;
                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (xsd:decimal(?capacityValue) < xsd:decimal(?pressureValue))
            }
        """
    ] .

nltlgen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:ServiceLifeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/YR> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
