@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF075ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gen:TRF075LoadCaseShape
    ] .

gen:TRF075LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseBlade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:propellerBlade ;
        sh:message "Each propeller blade load case must identify exactly one propeller blade."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseIceBlock ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:iceBlock ;
        sh:message "Each propeller blade load case must identify exactly one ice block."
    ] ;
    sh:xone (
        gen:TRF075BackwardForceCaseShape
        gen:TRF075ForwardForceCaseShape
    ) .

gen:TRF075BackwardForceCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF075ForceQuantityShape ;
        sh:message "A load case using backward blade force must contain exactly one backward blade force."
    ] ;
    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:maxCount 0 ;
    ] .

gen:TRF075ForwardForceCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF075ForceQuantityShape ;
        sh:message "A load case using forward blade force must contain exactly one forward blade force."
    ] ;
    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:maxCount 0 ;
    ] .

gen:TRF075ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .
