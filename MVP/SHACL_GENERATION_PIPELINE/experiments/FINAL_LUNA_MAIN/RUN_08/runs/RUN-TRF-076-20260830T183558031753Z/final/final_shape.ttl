@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PropellerBladeLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "Each represented propeller blade load case must have an integer case number."
    ] .

gs:Case1Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] .

gs:Case2Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] .

gs:Case3Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] .

gs:Case4Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] .

gs:Case5Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5
    ] .

gs:PropellerBladeLoadCaseCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single propeller type is required to determine the applicable blade load cases."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:node gs:PropellerBladeLoadCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "CP" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case1Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case2Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case3Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case4Shape ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "FP" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case1Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case2Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case3Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case4Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case5Shape ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "FP" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case1Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case2Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case3Shape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape gs:Case4Shape ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:datatype xsd:string ;
                sh:pattern "^(?!CP$|FP$).*" ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
