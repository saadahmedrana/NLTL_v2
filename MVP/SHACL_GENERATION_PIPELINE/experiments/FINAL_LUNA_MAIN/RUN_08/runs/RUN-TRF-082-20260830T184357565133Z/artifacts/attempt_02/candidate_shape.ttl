@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF082ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF082KnownBranch
        gen:TRF082UnknownBranch
    ) .

gen:TRF082KnownBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Bollard thrust must be recorded as known for this branch."
    ] .

gen:TRF082UnknownBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Bollard thrust must be recorded as not known for the table-lookup branch."
    ] ;
    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN>
            ]
        ] ;
        sh:message "When hydrodynamic bollard thrust is not known, it must be supplied as a quantity in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:tableLookupApplied ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The Table 6-8 lookup must be recorded as applied."
            ] ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:traficomTable6Dash8 ;
                sh:message "The lookup case must reference TRAFICOM Table 6-8."
            ] ;
            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:message "Evidence for the Table 6-8 selection must be recorded."
            ]
        ]
    ]
.
