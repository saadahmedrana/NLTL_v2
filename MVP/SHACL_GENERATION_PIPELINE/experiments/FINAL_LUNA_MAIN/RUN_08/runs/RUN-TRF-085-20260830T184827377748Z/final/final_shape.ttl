@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF085Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:tableLookupCase ;
                    sh:property [
                        sh:path nltl:tableLookupApplied ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:lookupInputQuantity ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:class qudt:QuantityValue ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:lookupResultQuantity ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:class qudt:QuantityValue ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:lookupSelectionEvidence ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:class nltl:evidenceArtifact
                    ] ;
                    sh:property [
                        sh:path nltl:tableReference ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:traficomTable6Dash9
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Each table lookup case must use the ship's propeller diameter and produce the ship's bollard propeller speed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerDiameter ?diameter .
                ?diameter qudt:numericValue ?diameterValue .
                ?diameter qudt:unit <http://qudt.org/vocab/unit/M> .

                $this nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed .
                ?speed qudt:numericValue ?speedValue .
                ?speed qudt:unit <http://qudt.org/vocab/unit/REV-PER-MIN> .

                $this nltl:hasTableLookupCase ?case .
                ?case nltl:lookupInputQuantity ?input .
                ?input qudt:numericValue ?inputValue .
                ?input qudt:unit <http://qudt.org/vocab/unit/M> .

                ?case nltl:lookupResultQuantity ?result .
                ?result qudt:numericValue ?resultValue .
                ?result qudt:unit <http://qudt.org/vocab/unit/REV-PER-MIN> .

                FILTER (?inputValue != ?diameterValue || ?resultValue != ?speedValue)
            }
        """
    ] .
