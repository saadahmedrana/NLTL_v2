@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF086QuantityValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF086NonCPBranch>
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Non-CP propeller applicability branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:propellerType ?type .
                FILTER (STR(?type) != "CP")
            }
        """
    ] .

<urn:nltl:generated-shape:TRF086KnownBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:hasValue "CP" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:node <urn:nltl:generated-shape:TRF086QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF086UnknownBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:hasValue "CP" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:node <urn:nltl:generated-shape:TRF086QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrFreeRunning ;
        sh:node <urn:nltl:generated-shape:TRF086QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller with unknown pitch, bollard pitch shall equal 0.7 times free-running pitch within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:propellerType "CP"^^xsd:string ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrBollard ?result ;
                      nltl:propellerPitchAtMcrFreeRunning ?operand .
                ?result qudt:numericValue ?resultValue ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                ?operand qudt:numericValue ?operandValue ;
                         qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND (0.7 * xsd:decimal(?operandValue) AS ?expected)
                FILTER (
                    ABS(xsd:decimal(?resultValue) - ?expected)
                    > (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF086ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF086NonCPBranch>
        <urn:nltl:generated-shape:TRF086KnownBranch>
        <urn:nltl:generated-shape:TRF086UnknownBranch>
    ) .
