@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TorqueQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The maximum engine torque quantity must contain one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The maximum engine torque must use the kN*m unit."
    ] .

gs:TableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The applicable table lookup case must record that the lookup was applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash10 ;
        sh:message "The applicable lookup case must reference TRAFICOM Table 6-10."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The Table 6-10 selection must have lookup-selection evidence."
    ] .

gs:MaximumTorqueKnownShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:maximumEngineTorque ;
        sh:node gs:TorqueQuantityShape ;
        sh:minCount 1 ;
        sh:message "A known maximum engine torque must be supplied."
    ] .

gs:MaximumTorqueUnknownShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:maximumEngineTorque ;
        sh:node gs:TorqueQuantityShape ;
        sh:minCount 1 ;
        sh:message "When maximum engine torque is unknown, the torque accorded from Table 6-10 must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gs:TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:message "When maximum engine torque is unknown, a Table 6-10 lookup case is required."
    ] .

gs:TRF088Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:MaximumTorqueKnownShape
        gs:MaximumTorqueUnknownShape
    ) .
