@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:BladeExpandedAreaRatioQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:BladeFailureSpindleTorqueFactorQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:BladeFailureSpindleTorqueQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ExtremeIceForceQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LeadingEdgeChordPortionQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MaximumSpindleTorqueQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PropellerBladeCountShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TrailingEdgeChordPortionQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF102Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:approvedSpindleTorqueStressAnalysis ;
                sh:node [
                    sh:class nltl:approvalRecord
                ] ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumSpindleTorque ;
                sh:node gs:MaximumSpindleTorqueQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:bladeExpandedAreaRatio ;
                sh:node gs:BladeExpandedAreaRatioQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerBladeCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
                sh:node gs:LeadingEdgeChordPortionQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
                sh:node gs:TrailingEdgeChordPortionQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:extremeIceForce ;
                sh:node gs:ExtremeIceForceQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeFailureSpindleTorqueFactor ;
                sh:node gs:BladeFailureSpindleTorqueFactorQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeFailureSpindleTorque ;
                sh:node gs:BladeFailureSpindleTorqueQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumSpindleTorque ;
                sh:node gs:MaximumSpindleTorqueQuantity ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "The calculated spindle torque factor and spindle torque values must satisfy the prescribed formula within numerical tolerance." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bladeExpandedAreaRatio ?earNode ;
                              nltl:propellerBladeCount ?z ;
                              nltl:leadingEdgeChordPortionAtZeroPointEightRadius ?leNode ;
                              nltl:trailingEdgeChordPortionAtZeroPointEightRadius ?teNode ;
                              nltl:extremeIceForce ?forceNode ;
                              nltl:bladeFailureSpindleTorqueFactor ?factorNode ;
                              nltl:bladeFailureSpindleTorque ?qsexNode ;
                              nltl:maximumSpindleTorque ?qmaxNode .

                        ?earNode qudt:numericValue ?ear .
                        ?leNode qudt:numericValue ?le .
                        ?teNode qudt:numericValue ?te .
                        ?forceNode qudt:numericValue ?force .
                        ?factorNode qudt:numericValue ?factor .
                        ?qsexNode qudt:numericValue ?qsex .
                        ?qmaxNode qudt:numericValue ?qmax .

                        BIND ((4 * ?ear) / ?z AS ?ratio)
                        BIND (0.7 * (1 - (?ratio * ?ratio * ?ratio)) AS ?rawFactor)
                        BIND (IF(?rawFactor < 0.3, 0.3, ?rawFactor) AS ?expectedFactor)
                        BIND (IF(?le > (0.8 * ?te), ?le, (0.8 * ?te)) AS ?expectedChord)
                        BIND (?expectedChord * ?expectedFactor * ?force AS ?expectedTorque)

                        BIND (IF(?expectedFactor < 0, 0 - ?expectedFactor, ?expectedFactor) AS ?factorAbs)
                        BIND (IF(?expectedTorque < 0, 0 - ?expectedTorque, ?expectedTorque) AS ?torqueAbs)
                        BIND (IF((0.000001 * ?factorAbs) > 0.000001,
                                 (0.000001 * ?factorAbs),
                                 0.000001) AS ?factorTolerance)
                        BIND (IF((0.000001 * ?torqueAbs) > 0.000001,
                                 (0.000001 * ?torqueAbs),
                                 0.000001) AS ?torqueTolerance)

                        FILTER (
                            ?factor < (?expectedFactor - ?factorTolerance) ||
                            ?factor > (?expectedFactor + ?factorTolerance) ||
                            ?qsex < (?expectedTorque - ?torqueTolerance) ||
                            ?qsex > (?expectedTorque + ?torqueTolerance) ||
                            ?qmax < (?expectedTorque - ?torqueTolerance) ||
                            ?qmax > (?expectedTorque + ?torqueTolerance)
                        )
                    }
                """
            ]
        ]
    ) .
