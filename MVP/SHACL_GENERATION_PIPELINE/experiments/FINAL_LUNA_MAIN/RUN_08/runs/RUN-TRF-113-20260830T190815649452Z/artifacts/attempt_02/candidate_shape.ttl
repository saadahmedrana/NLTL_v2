@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-113> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:steeringMechanism
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A steering mechanism component must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterFitting
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A thruster fitting component must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterBody
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A thruster body component must be identified."
    ] ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The design must record the plastic bending of a blade that the relevant components are designed to withstand."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The propeller blade orientation causing the maximum component load must be recorded."
    ] ;
    sh:property [
        sh:path nltl:bladeLossLoad ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The blade-loss maximum load must be recorded as a force in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A load case confirming the blade orientation producing the maximum component load is required."
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "Evidence of the blade-loss design assessment is required."
    ] .
