@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-129> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceNavigationCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An ice-navigation condition is required to determine applicability."
            ] ;
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The navigating-in-ice applicability value must be true for this applicable case."
            ] ;
            sh:property [
                sh:path nltl:coolingWaterSupplySecured ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Cooling-water supply must be secured when navigating in ice."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceNavigationCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An ice-navigation condition is required to determine applicability."
            ] ;
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The non-applicable case requires navigatingInIce to be false."
            ]
        ]
    ) .
