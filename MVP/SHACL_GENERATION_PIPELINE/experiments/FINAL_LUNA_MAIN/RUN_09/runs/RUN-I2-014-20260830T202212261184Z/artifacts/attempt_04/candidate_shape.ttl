@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_BowSubregionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:glancingImpactLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:glancingImpactPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Four bow subregions must have midpoint positions at one-eighth, three-eighths, five-eighths, and seven-eighths of bow length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?blv .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                    FILTER (
                        ?mid >= ((?blv * 0.125) - ((?blv * 0.125) * 0.000001) - 0.000000001) &&
                        ?mid <= ((?blv * 0.125) + ((?blv * 0.125) * 0.000001) + 0.000000001)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint must occur at three-eighths of bow length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?blv .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                    FILTER (
                        ?mid >= ((?blv * 0.375) - ((?blv * 0.375) * 0.000001) - 0.000000001) &&
                        ?mid <= ((?blv * 0.375) + ((?blv * 0.375) * 0.000001) + 0.000000001)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint must occur at five-eighths of bow length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?blv .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                    FILTER (
                        ?mid >= ((?blv * 0.625) - ((?blv * 0.625) * 0.000001) - 0.000000001) &&
                        ?mid <= ((?blv * 0.625) + ((?blv * 0.625) * 0.000001) + 0.000000001)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bow subregion midpoint must occur at seven-eighths of bow length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?blv .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                    FILTER (
                        ?mid >= ((?blv * 0.875) - ((?blv * 0.875) * 0.000001) - 0.000000001) &&
                        ?mid <= ((?blv * 0.875) + ((?blv * 0.875) * 0.000001) + 0.000000001)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow force must match a case force and no case force may exceed it." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:selectedMaximumBowForce/qudt:numericValue ?selected .
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce/qudt:numericValue ?expected .
                        FILTER (
                            ?selected >= (?expected - (?expected * 0.000001) - 0.000000001) &&
                            ?selected <= (?expected + (?expected * 0.000001) + 0.000000001)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedForce/qudt:numericValue ?expected .
                    FILTER (?expected > (?selected + (?expected * 0.000001) + 0.000000001))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow line load must match a case line load and no case line load may exceed it." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:selectedMaximumBowLineLoad/qudt:numericValue ?selected .
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?expected .
                        FILTER (
                            ?selected >= (?expected - (?expected * 0.000001) - 0.000000001) &&
                            ?selected <= (?expected + (?expected * 0.000001) + 0.000000001)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?expected .
                    FILTER (?expected > (?selected + (?expected * 0.000001) + 0.000000001))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow pressure must match a case pressure and no case pressure may exceed it." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:selectedMaximumBowPressure/qudt:numericValue ?selected .
                    FILTER NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedPressure/qudt:numericValue ?expected .
                        FILTER (
                            ?selected >= (?expected - (?expected * 0.000001) - 0.000000001) &&
                            ?selected <= (?expected + (?expected * 0.000001) + 0.000000001)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasBowSubregionCalculationCase ?case .
                    ?case nltl:bowSubregionCalculatedPressure/qudt:numericValue ?expected .
                    FILTER (?expected > (?selected + (?expected * 0.000001) + 0.000000001))
                }
            }
        """
    ] .
