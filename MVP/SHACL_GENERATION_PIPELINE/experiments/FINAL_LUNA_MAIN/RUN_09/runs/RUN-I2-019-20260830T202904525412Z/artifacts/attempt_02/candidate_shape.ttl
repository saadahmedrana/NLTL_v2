@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_019_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:node [
                    sh:class nltl:hullAreaValue ;
                    sh:property [
                        sh:path nltl:hullAreaFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ] .

gen:I2_019_ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A structural member spanning multiple hull areas must have a selected hull area factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasSpannedHullArea ?area1 ;
                        nltl:hasSpannedHullArea ?area2 .
                FILTER (?area1 != ?area2)
                FILTER NOT EXISTS {
                    ?member nltl:selectedHullAreaFactor ?selectedFactorNode .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected hull area factor must equal the maximum hull area factor across all hull areas spanned by the structural member, within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasSpannedHullArea ?area1 ;
                        nltl:hasSpannedHullArea ?area2 ;
                        nltl:selectedHullAreaFactor ?selectedFactorNode .
                FILTER (?area1 != ?area2)

                ?selectedFactorNode qudt:numericValue ?selectedValue .

                {
                    SELECT $this ?member (MAX(?factorValue) AS ?expectedValue)
                    WHERE {
                        $this nltl:hasStructuralMember ?member .
                        ?member nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factorNode .
                        ?factorNode qudt:numericValue ?factorValue .
                    }
                    GROUP BY $this ?member
                }

                BIND(IF(?expectedValue < 0, -?expectedValue, ?expectedValue) AS ?scale)
                BIND((0.000001 * ?scale) + 0.000001 AS ?tolerance)
                FILTER (
                    ?selectedValue < (?expectedValue - ?tolerance) ||
                    ?selectedValue > (?expectedValue + ?tolerance)
                )
            }
        """
    ] .
