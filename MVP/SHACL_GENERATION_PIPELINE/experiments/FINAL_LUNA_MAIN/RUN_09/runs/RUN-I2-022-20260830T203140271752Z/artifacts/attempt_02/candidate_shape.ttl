@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MegaPA> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-M> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-DEG> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MilliM> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-Unitless> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-StructuralMember> a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member used by the applicable plating must provide frame spacing in metres."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-Unitless> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member used by the applicable plating must provide the selected hull area factor."
    ] .

<urn:nltl:generated-shape:I2-022-ApplicablePlating> a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 70
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable plating must have a framing angle of at least 70 degrees."
    ] ;
    sh:property [
        sh:path nltl:platingHullAreaClassification ;
        sh:in (
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable plating must be classified as BI_b, M_b, or S_b."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-022-StructuralMember> ;
        sh:minCount 1 ;
        sh:message "Applicable plating must identify its supporting structural member and its required structural inputs."
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable plating must provide the externally calculated net plate thickness in millimetres."
    ] .

<urn:nltl:generated-shape:I2-022-NonApplicablePlating> a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxExclusive 70
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-PlatingApplicability> a sh:NodeShape ;
    sh:or (
        <urn:nltl:generated-shape:I2-022-ApplicablePlating>
        <urn:nltl:generated-shape:I2-022-NonApplicablePlating>
    ) .

<urn:nltl:generated-shape:I2-022-ShipReadiness> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide average ice pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-Unitless> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the peak pressure factor."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide yield strength in MPa."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue-Decimal-M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide load patch height in metres."
    ] ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node <urn:nltl:generated-shape:I2-022-PlatingApplicability> ;
        sh:minCount 1 ;
        sh:message "Each linked plating must provide evidence of applicability or a non-applicable framing-angle branch."
    ] .
