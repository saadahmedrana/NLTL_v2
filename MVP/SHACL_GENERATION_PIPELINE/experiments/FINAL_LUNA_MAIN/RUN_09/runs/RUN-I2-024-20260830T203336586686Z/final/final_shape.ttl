@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2_024_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasObliquePlatingInterpolationCase ;
        sh:node [
            sh:class nltl:obliquePlatingInterpolationCase ;
            sh:property [
                sh:path nltl:framingAngle ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:minExclusive 20 ;
                        sh:maxExclusive 70 ;
                        sh:message "Framing angle must satisfy 20 deg < Omega < 70 deg."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolationLowerEndpoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolationUpperEndpoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolatedNetPlateThickness ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:longitudinalFramingNetPlateThickness ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:transverseFramingNetPlateThickness ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                    ]
                ]
            ]
        ]
    ] .
