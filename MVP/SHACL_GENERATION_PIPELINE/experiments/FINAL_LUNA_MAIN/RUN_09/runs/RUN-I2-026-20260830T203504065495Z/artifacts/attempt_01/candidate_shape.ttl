@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-026-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-026-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-026-StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member must declare either fixed or simple frame support."
    ] ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:node <urn:nltl:generated-shape:I2-026-MemberSupportShape>
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The declared support condition is inconsistent with continuity, connection-bracket support, demonstrated rotational restraint, or termination within the ice-strengthened area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameSupportCondition ?condition .

                FILTER (
                    (
                        ?condition = nltl:fixedFrameSupport &&
                        NOT EXISTS { $this nltl:continuousThroughSupport true } &&
                        NOT EXISTS {
                            $this nltl:hasMemberSupport ?fixedSupport .
                            ?fixedSupport nltl:connectionBracketPresent true
                        } &&
                        NOT EXISTS {
                            $this nltl:hasMemberSupport ?restrainedSupport .
                            ?restrainedSupport nltl:demonstratedRotationalRestraint true
                        }
                    )
                    ||
                    (
                        ?condition = nltl:simpleFrameSupport &&
                        (
                            EXISTS { $this nltl:continuousThroughSupport true } ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?bracketSupport .
                                ?bracketSupport nltl:connectionBracketPresent true
                            } ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?demonstratedSupport .
                                ?demonstratedSupport nltl:demonstratedRotationalRestraint true
                            }
                        )
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:terminatesWithinIceStrengthenedArea true
                        } &&
                        ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    EXISTS {
                        $this nltl:hasMemberSupport ?evidenceSupport .
                        ?evidenceSupport nltl:demonstratedRotationalRestraint true .
                        FILTER NOT EXISTS {
                            $this nltl:significantRotationalRestraintEvidence ?evidence .
                        }
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-026-MemberSupportShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-026-EvidenceShape>
    a sh:NodeShape ;
    sh:class nltl:evidenceArtifact .

<urn:nltl:generated-shape:I2-026-StructuralMemberEvidenceShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:node <urn:nltl:generated-shape:I2-026-EvidenceShape> ;
        sh:minCount 1
    ] .
