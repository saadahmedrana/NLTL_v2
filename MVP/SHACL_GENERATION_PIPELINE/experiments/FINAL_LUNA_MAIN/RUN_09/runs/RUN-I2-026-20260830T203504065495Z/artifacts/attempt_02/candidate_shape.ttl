@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_026_StructuralMemberShape ;
        sh:message "Each represented structural member must satisfy the framing support-fixity requirements."
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The structural member must state whether it is continuous through its support."
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The structural member must state whether it terminates within an ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:node gen:I2_026_MemberSupportShape ;
        sh:message "The structural member must identify its support."
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "Rotational-restraint evidence must be an evidence artifact."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A demonstrated significant rotational restraint requires evidence on the structural member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:demonstratedRotationalRestraint true .
                FILTER NOT EXISTS {
                    $this nltl:significantRotationalRestraintEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The support condition must be fixed when the member is continuous through its support, has a connection bracket, has demonstrated rotational restraint, or terminates within an ice-strengthened area; otherwise it must be simple." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                $this nltl:continuousThroughSupport ?continuous .
                $this nltl:terminatesWithinIceStrengthenedArea ?terminates .
                ?support nltl:connectionBracketPresent ?bracket .
                ?support nltl:demonstratedRotationalRestraint ?restraint .
                ?support nltl:frameSupportCondition ?condition .
                FILTER (
                    (
                        (
                            ?continuous = true ||
                            ?bracket = true ||
                            ?restraint = true ||
                            ?terminates = true
                        ) &&
                        ?condition != nltl:fixedFrameSupport
                    ) ||
                    (
                        ?continuous = false &&
                        ?bracket = false &&
                        ?restraint = false &&
                        ?terminates = false &&
                        ?condition != nltl:simpleFrameSupport
                    )
                )
            }
        """
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The member support must state whether a connection bracket is present."
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The member support must state whether significant rotational restraint is demonstrated."
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:fixedFrameSupport
            nltl:simpleFrameSupport
        ) ;
        sh:message "The member support condition must be fixed or simple."
    ] .
