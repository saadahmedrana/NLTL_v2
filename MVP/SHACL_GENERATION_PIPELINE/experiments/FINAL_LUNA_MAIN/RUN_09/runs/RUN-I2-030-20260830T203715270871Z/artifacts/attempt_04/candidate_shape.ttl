@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2_030ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030CalculationCaseShape>
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2_030StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2_030CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2_030InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2_030InterpolationPointShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an oblique framing angle strictly between 20 and 70 degrees, both interpolation endpoints are required for the supplied calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasCalculationCase $this .
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?angleNode .
                ?angleNode <http://qudt.org/schema/qudt/numericValue> ?angle .
                FILTER (?angle > 20 && ?angle < 70)
                FILTER NOT EXISTS {
                    $this nltl:interpolationLowerEndpoint ?lower .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an oblique framing angle strictly between 20 and 70 degrees, both interpolation endpoints are required for the supplied calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasCalculationCase $this .
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?localCase .
                ?localCase nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?angleNode .
                ?angleNode <http://qudt.org/schema/qudt/numericValue> ?angle .
                FILTER (?angle > 20 && ?angle < 70)
                FILTER NOT EXISTS {
                    $this nltl:interpolationUpperEndpoint ?upper .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:I2_030StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030SectionModulusQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030AreaCentiMetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030AngleDegreeQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030LocalFrameSectionCaseShape>
    ] .

<urn:nltl:generated-shape:I2_030LocalFrameSectionCaseShape>
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030PlatingShape>
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember ;
        sh:node <urn:nltl:generated-shape:I2_030StructuralMemberShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The area-exceeds applicability selector requires net local frame flange area, net attached shell plate thickness, and frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                FILTER NOT EXISTS {
                    ?member nltl:netLocalFrameFlangeArea ?area .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The area-exceeds applicability selector requires net local frame flange area, net attached shell plate thickness, and frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                FILTER NOT EXISTS {
                    ?member nltl:netAttachedShellPlateThickness ?thickness .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The area-exceeds applicability selector requires net local frame flange area, net attached shell plate thickness, and frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                FILTER NOT EXISTS {
                    ?member nltl:frameSpacing ?spacing .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:I2_030PlatingShape>
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030AngleDegreeQuantityShape>
    ] .

<urn:nltl:generated-shape:I2_030InterpolationPointShape>
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2_030UnspecifiedQuantityShape>
    ] .

<urn:nltl:generated-shape:I2_030QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030LengthMetreQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030LengthMillimetreQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030AreaCentiMetreQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030AngleDegreeQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2_030UnspecifiedQuantityShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2_030QuantityValueShape> .
