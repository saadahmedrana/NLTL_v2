@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-037> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:class nltl:iceLoadPatchDesignCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:combinedShearBendingEffect ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:loadPatchApplicationLocation ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:memberCapacityMinimizationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:class nltl:loadCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:combinedShearBendingEffect ;
                        sh:datatype xsd:string ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:loadPatchApplicationLocation ;
                        sh:datatype xsd:string ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:memberCapacity ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The ice load patch is not applied at a location where the selected member capacity is minimised for the same combined bending-and-shear effect and load-patch location." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:hasIceLoadPatchDesignCase ?designCase .
                ?designCase nltl:combinedShearBendingEffect ?designEffect ;
                            nltl:loadPatchApplicationLocation ?designLocation .

                $this nltl:hasStructuralMember ?selectedMember .
                ?selectedMember nltl:hasStructuralMemberLoadCase ?selectedLoadCase ;
                                nltl:memberCapacity ?selectedCapacityNode .
                ?selectedLoadCase nltl:combinedShearBendingEffect ?selectedEffect ;
                                   nltl:loadPatchApplicationLocation ?selectedLocation .
                ?selectedCapacityNode qudt:numericValue ?selectedCapacity .

                FILTER (?designEffect = ?selectedEffect)
                FILTER (?designLocation = ?selectedLocation)

                $this nltl:hasStructuralMember ?otherMember .
                FILTER (?otherMember != ?selectedMember)
                ?otherMember nltl:hasStructuralMemberLoadCase ?otherLoadCase ;
                             nltl:memberCapacity ?otherCapacityNode .
                ?otherLoadCase nltl:combinedShearBendingEffect ?otherEffect ;
                               nltl:loadPatchApplicationLocation ?otherLocation .
                ?otherCapacityNode qudt:numericValue ?otherCapacity .

                FILTER (?otherEffect = ?selectedEffect)
                FILTER (?otherLocation = ?selectedLocation)
                FILTER (?otherCapacity < ?selectedCapacity)
            }
        """
    ] .
