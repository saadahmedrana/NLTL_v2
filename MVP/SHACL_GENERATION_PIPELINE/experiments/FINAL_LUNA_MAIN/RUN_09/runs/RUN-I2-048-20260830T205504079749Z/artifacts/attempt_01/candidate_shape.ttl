@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single valid Polar Class is required." ;
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node gen:I2_048_CaseShape ;
    ] .

gen:I2_048_CaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented steel-grade case must identify exactly one plating." ;
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The steel-grade case must reference IACS UR I2 Table 8." ;
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ] ;
        sh:message "As-built plate thickness must be one millimetre-valued quantity." ;
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single valid steel material class is required." ;
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single valid steel strength category is required." ;
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The actual hull structural steel grade is required and must be a valid Table 8 grade." ;
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:maxCount 1 ;
        sh:message "An applicable steel-grade case must contain one selected required grade." ;
    ] ;
    sh:sparql [
        sh:message "An applicable Table 8 combination is missing its required hull structural steel grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?thickness ;
                      nltl:steelMaterialClass ?material ;
                      nltl:steelStrengthCategory ?strength .
                ?thickness qudt:numericValue ?t ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER(?t > 0 && ?t <= 50)
                FILTER(?material IN (
                    nltl:steelMaterialClassOne,
                    nltl:steelMaterialClassTwo,
                    nltl:steelMaterialClassThree
                ))
                FILTER(?strength IN (
                    nltl:normalStrengthSteelCategory,
                    nltl:highTensileSteelCategory
                ))
                FILTER NOT EXISTS {
                    ?ship nltl:hasSteelGradeRequirementCase $this ;
                          nltl:polarClass ?pc .
                    FILTER(?pc IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5,
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    ))
                }
                FILTER EXISTS {
                    ?ship2 nltl:hasSteelGradeRequirementCase $this ;
                           nltl:polarClass ?pc2 .
                    FILTER(?pc2 IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5,
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    ))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A non-applicable Table 8 combination must not contain a required grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?thickness ;
                      nltl:steelMaterialClass nltl:steelMaterialClassThree ;
                      nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
                      nltl:requiredHullStructuralSteelGrade ?required .
                ?thickness qudt:numericValue ?t ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER(?t > 35 && ?t <= 50)
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                FILTER(?pc IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3,
                    nltl:polarClassPc4,
                    nltl:polarClassPc5
                ))
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected required grade must be the Table 8 grade for the case selectors, and the actual grade must have at least the required rank within the same strength category." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?thickness ;
                      nltl:steelMaterialClass ?material ;
                      nltl:steelStrengthCategory ?strength ;
                      nltl:actualHullStructuralSteelGrade ?actual ;
                      nltl:requiredHullStructuralSteelGrade ?required .
                ?thickness qudt:numericValue ?t ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?actual nltl:steelGradeOrderRank ?actualRank .
                ?required nltl:steelGradeOrderRank ?requiredRank .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                FILTER(?t > 0 && ?t <= 50)
                FILTER(?pc IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3,
                    nltl:polarClassPc4,
                    nltl:polarClassPc5,
                    nltl:polarClassPc6,
                    nltl:polarClassPc7
                ))

                BIND(
                    IF(
                        ?strength = nltl:normalStrengthSteelCategory,
                        IF(
                            ?material = nltl:steelMaterialClassOne,
                            IF(
                                ?t <= 10,
                                IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeB, nltl:steelGradeB),
                                IF(
                                    ?t <= 35,
                                    IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeD, nltl:steelGradeB),
                                    IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeE, nltl:steelGradeD)
                                )
                            ),
                            IF(
                                ?material = nltl:steelMaterialClassTwo,
                                IF(
                                    ?t <= 10,
                                    nltl:steelGradeB,
                                    IF(
                                        ?t <= 25,
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeD, nltl:steelGradeB),
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeE, nltl:steelGradeD)
                                    )
                                ),
                                IF(
                                    ?t <= 10,
                                    IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeE, nltl:steelGradeB),
                                    IF(
                                        ?t <= 35,
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeE, nltl:steelGradeD),
                                        ?required
                                    )
                                )
                            )
                        ),
                        IF(
                            ?material = nltl:steelMaterialClassOne,
                            IF(
                                ?t <= 10,
                                nltl:steelGradeAh,
                                IF(
                                    ?t <= 35,
                                    IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeDh, nltl:steelGradeAh),
                                    IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeEh, nltl:steelGradeDh)
                                )
                            ),
                            IF(
                                ?material = nltl:steelMaterialClassTwo,
                                IF(
                                    ?t <= 10,
                                    nltl:steelGradeAh,
                                    IF(
                                        ?t <= 25,
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeDh, nltl:steelGradeAh),
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeEh, nltl:steelGradeDh)
                                    )
                                ),
                                IF(
                                    ?t <= 10,
                                    IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeEh, nltl:steelGradeAh),
                                    IF(
                                        ?t <= 35,
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeEh, nltl:steelGradeDh),
                                        IF(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5), nltl:steelGradeFh, nltl:steelGradeEh)
                                    )
                                )
                            )
                        )
                    ) AS ?expected
                )
                FILTER(
                    ?required != ?expected ||
                    ?actualRank < ?requiredRank ||
                    (
                        ?strength = nltl:normalStrengthSteelCategory &&
                        ?actual NOT IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE) ||
                        ?required NOT IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE)
                    ) ||
                    (
                        ?strength = nltl:highTensileSteelCategory &&
                        ?actual NOT IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh) ||
                        ?required NOT IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh)
                    )
                )
            }
        """
    ] .
