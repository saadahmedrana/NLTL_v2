@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class <urn:nltl:generated-shape:I2-048-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The table-selected required hull structural steel grade is missing, incorrect, or present for a non-applicable combination." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?q ;
        nltl:steelMaterialClass ?mat ;
        nltl:steelStrengthCategory ?cat ;
        nltl:tableReference nltl:iacsUrI2Table8 .
  ?q qudt:numericValue ?t ;
     qudt:unit <http://qudt.org/vocab/unit/MilliM> .

  BIND(
    IF(
      ?cat = nltl:normalStrengthSteelCategory &&
      ?mat = nltl:steelMaterialClassOne,
      IF(?t <= 10, nltl:steelGradeB,
        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
           IF(?t <= 35, nltl:steelGradeD, nltl:steelGradeE),
           IF(?t <= 35, nltl:steelGradeB, nltl:steelGradeD))),
      IF(
        ?cat = nltl:normalStrengthSteelCategory &&
        ?mat = nltl:steelMaterialClassTwo,
        IF(?t <= 10, nltl:steelGradeB,
          IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
             IF(?t <= 30, nltl:steelGradeD, nltl:steelGradeE),
             IF(?t <= 30, nltl:steelGradeB, nltl:steelGradeD))),
        IF(
          ?cat = nltl:normalStrengthSteelCategory &&
          ?mat = nltl:steelMaterialClassThree,
          IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) && ?t > 35,
             nltl:steelGradeB,
             IF(?pc IN (nltl:polarClassPc4, nltl:polarClassPc5) && ?t > 45,
                nltl:steelGradeB,
                IF(?pc IN (nltl:polarClassPc6, nltl:polarClassPc7),
                   IF(?t <= 10, nltl:steelGradeB,
                      IF(?t <= 35, nltl:steelGradeD, nltl:steelGradeE)),
                   nltl:steelGradeE))),
          IF(
            ?cat = nltl:highTensileSteelCategory &&
            ?mat = nltl:steelMaterialClassOne,
            IF(?t <= 10, nltl:steelGradeAh,
              IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
                 IF(?t <= 35, nltl:steelGradeDh, nltl:steelGradeEh),
                 IF(?t <= 35, nltl:steelGradeAh, nltl:steelGradeDh))),
            IF(
              ?cat = nltl:highTensileSteelCategory &&
              ?mat = nltl:steelMaterialClassTwo,
              IF(?t <= 10, nltl:steelGradeAh,
                IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5),
                   IF(?t <= 30, nltl:steelGradeDh, nltl:steelGradeEh),
                   IF(?t <= 30, nltl:steelGradeAh, nltl:steelGradeDh))),
              IF(
                ?mat = nltl:steelMaterialClassThree &&
                ?cat = nltl:highTensileSteelCategory,
                IF(?pc IN (nltl:polarClassPc6, nltl:polarClassPc7),
                   IF(?t <= 35, nltl:steelGradeAh, nltl:steelGradeEh),
                   IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeFh)),
                nltl:steelGradeB
              )
            )
          )
        )
      )
    )
    AS ?expected
  ) .

  BIND(
    (
      ?t <= 50 &&
      (
        ?cat = nltl:normalStrengthSteelCategory ||
        ?cat = nltl:highTensileSteelCategory
      ) &&
      (
        ?mat = nltl:steelMaterialClassOne ||
        ?mat = nltl:steelMaterialClassTwo ||
        ?mat = nltl:steelMaterialClassThree
      ) &&
      (
        ?pc IN (
          nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
          nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6,
          nltl:polarClassPc7
        )
      )
    )
    AS ?knownTableInput
  ) .

  BIND(
    (
      ?knownTableInput &&
      !(
        ?mat = nltl:steelMaterialClassThree &&
        ?cat = nltl:normalStrengthSteelCategory &&
        (
          (?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3) && ?t > 35) ||
          (?pc IN (nltl:polarClassPc4, nltl:polarClassPc5) && ?t > 45)
        )
      )
    )
    AS ?applicable
  ) .

  FILTER(
    !?knownTableInput ||
    (
      ?applicable &&
      NOT EXISTS {
        $this nltl:requiredHullStructuralSteelGrade ?expected
      }
    ) ||
    (
      !?applicable &&
      EXISTS {
        $this nltl:requiredHullStructuralSteelGrade ?presentGrade
      }
    )
  )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual hull structural steel grade must have a rank at least as high as the selected required grade within the same steel-strength family." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:actualHullStructuralSteelGrade ?actual ;
        nltl:requiredHullStructuralSteelGrade ?required .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  ?required nltl:steelGradeOrderRank ?requiredRank .
  FILTER(
    !(
      (
        ?actual IN (
          nltl:steelGradeB, nltl:steelGradeD, nltl:steelGradeE
        ) &&
        ?required IN (
          nltl:steelGradeB, nltl:steelGradeD, nltl:steelGradeE
        )
      ) ||
      (
        ?actual IN (
          nltl:steelGradeAh, nltl:steelGradeDh,
          nltl:steelGradeEh, nltl:steelGradeFh
        ) &&
        ?required IN (
          nltl:steelGradeAh, nltl:steelGradeDh,
          nltl:steelGradeEh, nltl:steelGradeFh
        )
      )
    ) ||
    ?actualRank < ?requiredRank
  )
}
"""
    ] .

<urn:nltl:generated-shape:I2-048-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-048-SteelGradeValueShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeValue ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
