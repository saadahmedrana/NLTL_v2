@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented steel grade requirement case must have exactly one plating link, table reference to IACS UR I2 Table 8, valid selectors, and the exact applicable table grade or no required grade for a non-applicable combination." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSteelGradeRequirementCase ?case .
                ?case nltl:asBuiltPlateThickness ?thicknessValue ;
                      nltl:steelMaterialClass ?material ;
                      nltl:steelStrengthCategory ?category ;
                      nltl:tableReference nltl:iacsUrI2Table8 ;
                      nltl:steelGradeRequirementCasePlating ?plating .
                ?thicknessValue qudt:numericValue ?t ;
                                qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                $this nltl:polarClass ?pc .

                BIND(
                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2,
                               nltl:polarClassPc3, nltl:polarClassPc4,
                               nltl:polarClassPc5), "pc15",
                    IF(?pc IN (nltl:polarClassPc6, nltl:polarClassPc7), "pc67",
                    "unknown"))
                    AS ?pcGroup
                )

                BIND(
                    (
                        ?t > 0 &&
                        ?t <= 50 &&
                        ?pcGroup != "unknown" &&
                        ?material IN (
                            nltl:steelMaterialClassOne,
                            nltl:steelMaterialClassTwo,
                            nltl:steelMaterialClassThree
                        ) &&
                        ?category IN (
                            nltl:normalStrengthSteelCategory,
                            nltl:highTensileSteelCategory
                        )
                    )
                    AS ?known
                )

                OPTIONAL {
                    VALUES (?ruleCategory ?ruleGroup ?ruleMaterial ?lower ?upper ?ruleGrade) {
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassOne UNDEF 10 nltl:steelGradeAh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassOne 10 45 nltl:steelGradeDh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassOne 45 UNDEF nltl:steelGradeEh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassTwo UNDEF 10 nltl:steelGradeAh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassTwo 10 25 nltl:steelGradeDh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassTwo 25 UNDEF nltl:steelGradeEh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassThree UNDEF 45 nltl:steelGradeEh)
                        (nltl:highTensileSteelCategory "pc15" nltl:steelMaterialClassThree 45 UNDEF nltl:steelGradeFh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassOne UNDEF 25 nltl:steelGradeAh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassOne 25 UNDEF nltl:steelGradeDh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassTwo UNDEF 25 nltl:steelGradeAh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassTwo 25 UNDEF nltl:steelGradeDh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassThree UNDEF 10 nltl:steelGradeAh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassThree 10 25 nltl:steelGradeDh)
                        (nltl:highTensileSteelCategory "pc67" nltl:steelMaterialClassThree 25 UNDEF nltl:steelGradeEh)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassOne UNDEF 10 nltl:steelGradeB)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassOne 10 45 nltl:steelGradeD)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassOne 45 UNDEF nltl:steelGradeE)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassTwo UNDEF 10 nltl:steelGradeB)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassTwo 10 25 nltl:steelGradeD)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassTwo 25 UNDEF nltl:steelGradeE)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassThree UNDEF 45 nltl:steelGradeE)
                        (nltl:normalStrengthSteelCategory "pc15" nltl:steelMaterialClassThree 45 UNDEF nltl:benchmarkEntity)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassOne UNDEF 30 nltl:steelGradeB)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassOne 30 UNDEF nltl:steelGradeD)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassTwo UNDEF 20 nltl:steelGradeB)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassTwo 20 UNDEF nltl:steelGradeD)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassThree UNDEF 10 nltl:steelGradeB)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassThree 10 25 nltl:steelGradeD)
                        (nltl:normalStrengthSteelCategory "pc67" nltl:steelMaterialClassThree 25 UNDEF nltl:steelGradeE)
                    }
                    FILTER(
                        ?category = ?ruleCategory &&
                        ?pcGroup = ?ruleGroup &&
                        ?material = ?ruleMaterial &&
                        (!BOUND(?lower) || ?t > ?lower) &&
                        (!BOUND(?upper) || ?t <= ?upper)
                    )
                }

                BIND(COALESCE(?ruleGrade, nltl:benchmarkEntity) AS ?expected)

                FILTER(
                    !?known ||
                    (
                        ?expected = nltl:benchmarkEntity &&
                        NOT EXISTS {
                            ?case nltl:requiredHullStructuralSteelGrade ?nonApplicableGrade
                        }
                    ) ||
                    (
                        ?expected != nltl:benchmarkEntity &&
                        NOT EXISTS {
                            ?case nltl:requiredHullStructuralSteelGrade ?wrongOrMissingGrade
                        } ||
                        NOT EXISTS {
                            ?case nltl:requiredHullStructuralSteelGrade ?expected
                        }
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        )
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        )
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual steel grade must be at least the selected required grade within the same steel strength family." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualHullStructuralSteelGrade ?actual ;
                      nltl:requiredHullStructuralSteelGrade ?required ;
                      nltl:steelStrengthCategory ?category .
                ?actual nltl:steelGradeOrderRank ?actualRank .
                ?required nltl:steelGradeOrderRank ?requiredRank .
                FILTER(?actualRank < ?requiredRank)
                FILTER(
                    (?category = nltl:normalStrengthSteelCategory &&
                     ?actual NOT IN (
                         nltl:steelGradeB,
                         nltl:steelGradeD,
                         nltl:steelGradeE
                     )) ||
                    (?category = nltl:highTensileSteelCategory &&
                     ?actual NOT IN (
                         nltl:steelGradeAh,
                         nltl:steelGradeDh,
                         nltl:steelGradeEh,
                         nltl:steelGradeFh
                     )) ||
                    (?category = nltl:normalStrengthSteelCategory &&
                     ?required NOT IN (
                         nltl:steelGradeB,
                         nltl:steelGradeD,
                         nltl:steelGradeE
                     )) ||
                    (?category = nltl:highTensileSteelCategory &&
                     ?required NOT IN (
                         nltl:steelGradeAh,
                         nltl:steelGradeDh,
                         nltl:steelGradeEh,
                         nltl:steelGradeFh
                     ))
                )
            }
        """
    ] .
