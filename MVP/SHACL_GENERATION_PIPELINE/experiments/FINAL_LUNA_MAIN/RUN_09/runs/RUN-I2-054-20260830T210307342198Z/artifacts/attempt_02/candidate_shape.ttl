@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_054_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide one upper ice waterline length in metres."
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide one stem angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide one design vertical ice force at the bow in meganewtons."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:hasInterpolationPoint ;
                sh:minCount 5 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ]
        ] ;
        sh:message "Each calculation case shall contain the interpolation-point structure."
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:hullGirderBendingMomentCalculationCase ;
            sh:property [
                sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:caseBendingMomentDistributionFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:caseDesignVerticalIceBendingMoment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each hull-girder calculation case shall provide the externally calculated design vertical ice bending moment in MN m."
            ]
        ] ;
        sh:message "Each hull-girder bending-moment calculation case shall provide its position, distribution factor, and externally calculated result."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every calculation case shall contain the required interpolation points: 0 at the aft end, 1 at 0.5 and 0.7 of L_UI, 0.3 at 0.95 of L_UI, and 0 at the forward end." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this a nltl:ship .
  FILTER NOT EXISTS {
    $this nltl:hasCalculationCase ?cc .
    FILTER NOT EXISTS {
      ?cc nltl:hasInterpolationPoint ?p0 .
      ?p0 nltl:interpolationPointCoordinate ?c0 ;
          nltl:interpolationPointResult ?r0 .
      ?c0 qudt:numericValue ?cv0 .
      ?r0 qudt:numericValue ?rv0 .
      FILTER (xsd:decimal(?cv0) = 0.0 && xsd:decimal(?rv0) = 0.0)
    }
    FILTER NOT EXISTS {
      ?cc nltl:hasInterpolationPoint ?p05 .
      ?p05 nltl:interpolationPointCoordinate ?c05 ;
           nltl:interpolationPointResult ?r05 .
      ?c05 qudt:numericValue ?cv05 .
      ?r05 qudt:numericValue ?rv05 .
      FILTER (xsd:decimal(?cv05) = 0.5 && xsd:decimal(?rv05) = 1.0)
    }
    FILTER NOT EXISTS {
      ?cc nltl:hasInterpolationPoint ?p07 .
      ?p07 nltl:interpolationPointCoordinate ?c07 ;
           nltl:interpolationPointResult ?r07 .
      ?c07 qudt:numericValue ?cv07 .
      ?r07 qudt:numericValue ?rv07 .
      FILTER (xsd:decimal(?cv07) = 0.7 && xsd:decimal(?rv07) = 1.0)
    }
    FILTER NOT EXISTS {
      ?cc nltl:hasInterpolationPoint ?p095 .
      ?p095 nltl:interpolationPointCoordinate ?c095 ;
            nltl:interpolationPointResult ?r095 .
      ?c095 qudt:numericValue ?cv095 .
      ?r095 qudt:numericValue ?rv095 .
      FILTER (xsd:decimal(?cv095) = 0.95 && xsd:decimal(?rv095) = 0.3)
    }
    FILTER NOT EXISTS {
      ?cc nltl:hasInterpolationPoint ?p1 .
      ?p1 nltl:interpolationPointCoordinate ?c1 ;
          nltl:interpolationPointResult ?r1 .
      ?c1 qudt:numericValue ?cv1 .
      ?r1 qudt:numericValue ?rv1 .
      FILTER (xsd:decimal(?cv1) = 1.0 && xsd:decimal(?rv1) = 0.0)
    }
  }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each hull-girder case distribution factor shall correspond to an interpolation result at the case longitudinal position normalized by L_UI." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this a nltl:ship .
  ?this nltl:upperIceWaterlineLengthLUI ?length ;
        nltl:hasHullGirderBendingMomentCalculationCase ?hc .
  ?length qudt:numericValue ?lv .
  ?hc nltl:caseHullGirderLongitudinalPositionFromAft ?position ;
      nltl:caseBendingMomentDistributionFactor ?factor .
  ?position qudt:numericValue ?pv .
  ?factor qudt:numericValue ?fv .
  FILTER (xsd:decimal(?lv) > 0)
  FILTER NOT EXISTS {
    $this nltl:hasCalculationCase ?cc .
    ?cc nltl:hasInterpolationPoint ?ip .
    ?ip nltl:interpolationPointCoordinate ?coordinate ;
        nltl:interpolationPointResult ?result .
    ?coordinate qudt:numericValue ?cv .
    ?result qudt:numericValue ?rv .
    FILTER (ABS(xsd:decimal(?cv) - (xsd:decimal(?pv) / xsd:decimal(?lv))) <= 0.000001)
    FILTER (ABS(xsd:decimal(?rv) - xsd:decimal(?fv)) <= 0.000001)
  }
}
"""
    ] .
