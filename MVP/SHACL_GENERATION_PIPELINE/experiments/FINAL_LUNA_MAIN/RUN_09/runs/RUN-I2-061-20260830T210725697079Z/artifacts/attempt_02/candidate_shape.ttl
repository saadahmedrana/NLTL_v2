@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_061_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_061_CalculationCaseShape ;
        sh:message "Each calculation case must identify the applicable assessed hull structure and use the prescribed analytical procedure rather than a direct calculation."
    ] .

gen:I2_061_CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationCaseAssessedHullStructure ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:hullStructure ;
        sh:minCount 1 ;
        sh:node gen:I2_061_HullStructureShape ;
        sh:message "A calculation case must identify its assessed hull structure."
    ] ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationMethodValue ;
        sh:maxCount 1 ;
        sh:message "The calculation method, when supplied, must be a canonical calculation-method value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:hasValue nltl:prescribedAnalyticalProcedure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable calculation case must use the prescribed analytical procedure."
            ]
        ]
        [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:maxCount 0 ;
                sh:message "A calculation case without an applicability method is not subject to this prescribed-procedure check."
            ]
        ]
    ) .

gen:I2_061_HullStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:thickness ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Any supplied hull-structure thickness must be a metre-valued decimal quantity."
    ] .
