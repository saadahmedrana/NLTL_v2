@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-065-ShipReadinessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship with a nonlinear calculation case, buckling and plastic deformation capture and the fracture, major buckling, and yielding margin inputs are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:bucklingResponse ?buckling .
                        FILTER (datatype(?buckling) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:plasticDeformation ?plastic .
                        FILTER (datatype(?plastic) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureNumber ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?fractureNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:majorBucklingMargin ?major .
                        ?major qudt:numericValue ?majorNumber ;
                               qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?majorNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingNumber ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?yieldingNumber) = xsd:decimal)
                    }
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-065-CalculationCaseReadinessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked nonlinear calculation case requires the prescribed method, permanent deformation inputs, relevant structural dimension, acceptance evidence, and a satisfied deformation assessment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasCalculationCase $this .
                $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:permanentLateralDeformation ?lateral .
                        ?lateral qudt:numericValue ?lateralNumber ;
                                 qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?lateralNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                        ?outOfPlane qudt:numericValue ?outOfPlaneNumber ;
                                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?outOfPlaneNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:relevantStructuralDimension ?dimension .
                        ?dimension qudt:numericValue ?dimensionNumber ;
                                   qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        FILTER (datatype(?dimensionNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                        ?evidence a nltl:evidenceArtifact .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:minorPermanentDeformationAssessmentSatisfied ?satisfied .
                        FILTER (
                            datatype(?satisfied) = xsd:boolean &&
                            ?satisfied = true
                        )
                    }
                )
            }
        """
    ] .
