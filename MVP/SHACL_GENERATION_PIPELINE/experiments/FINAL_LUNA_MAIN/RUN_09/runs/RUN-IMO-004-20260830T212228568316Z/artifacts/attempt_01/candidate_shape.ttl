@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-004> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOriginType ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A ship must provide an ice-origin value to determine applicability of the first-year ice classification rule."
    ] ;
    sh:property [
        sh:path nltl:winterGrowthCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "A ship must provide one integer winter-growth count to determine applicability of the first-year ice classification rule."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "A ship must provide one ice-thickness quantity with a decimal value in metres."
    ] ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "When the ice origin is sea ice, winter growth is not more than one, and thickness is between 0.3 m and 2.0 m inclusive, the ice type must be first-year ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType ?origin ;
                      nltl:winterGrowthCount ?growth ;
                      nltl:iceThickness ?thicknessNode .
                ?thicknessNode qudt:numericValue ?thickness .

                FILTER (?origin = nltl:seaIceOrigin)
                FILTER (?growth <= 1)
                FILTER (?thickness >= 0.3 && ?thickness <= 2.0)

                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce
                }
            }
        """
    ] .
