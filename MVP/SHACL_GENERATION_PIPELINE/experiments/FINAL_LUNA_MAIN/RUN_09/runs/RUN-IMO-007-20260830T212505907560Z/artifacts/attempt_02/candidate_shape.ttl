@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO007ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO007OpenWaterBranch
        gen:IMO007NonOpenWaterBranch
    ) .

gen:IMO007OpenWaterBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:openWaterIceCondition ;
        sh:message "The ship's ice condition classification must identify open water for the open-water branch."
    ] ;
    sh:property [
        sh:path nltl:seaIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO007SeaIceConcentrationQuantity ;
        sh:message "Open water requires a single sea-ice concentration quantity with the canonical unit."
    ] ;
    sh:property [
        sh:path nltl:iceOfLandOriginPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Open water requires ice of land origin to be recorded as false."
    ] ;
    sh:sparql [
        sh:message "For open water, sea-ice concentration must be less than 1/10." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:seaIceConcentration ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (?value >= 1)
            }
        """
    ] .

gen:IMO007NonOpenWaterBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceConditionLessSevereThanCategoryAAndB
            nltl:iceFreeIceCondition
            nltl:mediumFirstYearIceWithPossibleOldIceInclusions
            nltl:otherWatersIceCondition
            nltl:thinFirstYearIceWithPossibleOldIceInclusions
        ) ;
        sh:message "The ship's ice condition classification must be a permitted non-open-water classification when the open-water branch does not apply."
    ] .

gen:IMO007SeaIceConcentrationQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:message "Sea-ice concentration must use the canonical unitless QUDT unit."
    ] .
