@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_007_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:datatype nltl:iceConditionValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:openWaterIceCondition ;
                sh:message "Open-water classification is required for the open-water branch."
            ] ;
            sh:property [
                sh:path nltl:seaIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:UNITLESS ;
                        sh:message "Sea ice concentration must use the canonical unitless unit."
                    ] ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Sea ice concentration must provide a numeric value."
                    ]
                ] ;
                sh:message "Open-water ships must provide sea ice concentration."
            ] ;
            sh:property [
                sh:path nltl:iceOfLandOriginPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "No ice of land origin may be present in open water."
            ] ;
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:seaIceConcentration ?quantity .
                        ?quantity qudt:numericValue ?value .
                        FILTER (?value >= 1)
                    }
                """ ;
                sh:message "For open water, sea ice concentration must be less than 1."
            ]
        ]
        [
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceConditionClassification ?condition .
                        FILTER (?condition != nltl:openWaterIceCondition)
                        FILTER NOT EXISTS {
                            $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                        }
                    }
                """ ;
                sh:message "The non-open-water branch requires an existing ice-condition classification that is not open water."
            ]
        ]
    ) .
