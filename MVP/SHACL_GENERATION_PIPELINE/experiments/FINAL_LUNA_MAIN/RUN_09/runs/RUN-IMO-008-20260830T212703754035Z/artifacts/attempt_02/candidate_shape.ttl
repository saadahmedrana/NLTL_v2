@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_008_ThinFirstYearIceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:hasValue nltl:thinFirstYearIce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A ship classified as thin first-year ice shall have the thin first-year ice classification."
            ] ;
            sh:property [
                sh:path nltl:iceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "0.3"^^xsd:decimal ;
                        sh:maxInclusive "0.7"^^xsd:decimal ;
                        sh:message "Ice thickness for thin first-year ice shall be between 0.3 m and 0.7 m inclusive."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Ice thickness shall use metres as its unit."
                    ]
                ]
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceTypeClassification ;
                        sh:maxCount 0
                    ]
                ]
                [
                    sh:sparql [
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER (
                                    EXISTS {
                                        $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                                    }
                                    ||
                                    NOT EXISTS {
                                        $this nltl:iceTypeClassification ?classification .
                                        FILTER (?classification != nltl:thinFirstYearIce)
                                    }
                                )
                            }
                        """ ;
                        sh:message "A non-applicable ship shall not have thin first-year ice as its classification."
                    ]
                ]
            )
        ]
    ) .
