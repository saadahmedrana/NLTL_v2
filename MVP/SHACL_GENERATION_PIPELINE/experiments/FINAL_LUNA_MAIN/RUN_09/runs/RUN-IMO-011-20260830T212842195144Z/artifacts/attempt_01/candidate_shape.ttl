@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO011_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:IMO011_DataPeriodQuantityShape ;
        sh:message "A ship must provide one data period in years."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:IMO011_TemperatureQuantityShape ;
        sh:message "A ship must provide one externally calculated mean daily low temperature in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:hasDailyLowTemperatureObservation ;
        sh:node nltl:IMO011_DailyObservationShape
    ] ;
    sh:or (
        nltl:IMO011_DataPeriodAtLeastTenShape
        nltl:IMO011_DataPeriodBelowTenShape
    ) .

nltl:IMO011_DailyObservationShape
    a sh:NodeShape ;
    sh:class nltl:dailyLowTemperatureObservation ;
    sh:property [
        sh:path nltl:dailyTemperatureObservationDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Each daily low-temperature observation must have one calendar date."
    ] ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:IMO011_TemperatureQuantityShape ;
        sh:message "Each daily low-temperature observation must carry one temperature value in degrees Celsius."
    ] .

nltl:IMO011_DataPeriodQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/YR>
    ] .

nltl:IMO011_TemperatureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG_C>
    ] .

nltl:IMO011_DataPeriodAtLeastTenShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:IMO011_DataPeriodAtLeastTenQuantityShape
    ] .

nltl:IMO011_DataPeriodAtLeastTenQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 10
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/YR>
    ] .

nltl:IMO011_DataPeriodBelowTenShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:IMO011_DataPeriodBelowTenQuantityShape
    ] ;
    sh:property [
        sh:path nltl:administrationDatasetApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "When the data period is shorter than ten years, the dataset approval status must be Approved."
    ] .

nltl:IMO011_DataPeriodBelowTenQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:maxExclusive 10
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/YR>
    ] .
