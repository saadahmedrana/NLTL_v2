@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-017-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The ship shall provide Polar Ship Certificate validity dates."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The ship shall provide survey dates."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The ship shall provide endorsement dates."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate shall include a supplement."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-PolarShipCertificateShape> ;
        sh:message "The ship shall have a Polar Ship Certificate."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-SolasScheduleShape> ;
        sh:message "The ship shall have an applicable SOLAS certificate schedule."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-PolarSupplementShape> ;
        sh:message "The ship shall have a Polar Certificate supplement with required equipment records."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Ship Certificate validity, survey, and endorsement dates shall match the corresponding SOLAS certificate schedule dates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                            nltl:certificateScheduleDateType ?category .
                    FILTER (
                        ?category = nltl:validityDateCategory ||
                        ?category = nltl:surveyDateCategory ||
                        ?category = nltl:endorsementDateCategory
                    )
                    FILTER NOT EXISTS {
                        {
                            FILTER (?category = nltl:validityDateCategory)
                            $this nltl:polarCertificateValidityDates ?date
                        }
                        UNION
                        {
                            FILTER (?category = nltl:surveyDateCategory)
                            $this nltl:surveyDates ?date
                        }
                        UNION
                        {
                            FILTER (?category = nltl:endorsementDateCategory)
                            $this nltl:endorsementDates ?date
                        }
                    }
                }
                UNION
                {
                    $this nltl:polarCertificateValidityDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType nltl:validityDateCategory
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType nltl:surveyDateCategory
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?date .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType nltl:endorsementDateCategory
                    }
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-017-PolarShipCertificateShape>
    a sh:NodeShape ;
    sh:class nltl:polarShipCertificateForm .

<urn:nltl:generated-shape:IMO-017-SolasScheduleShape>
    a sh:NodeShape ;
    sh:class nltl:solasCertificateSchedule ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-DateRecordShape> ;
        sh:message "The SOLAS certificate schedule shall contain certificate schedule date records."
    ] .

<urn:nltl:generated-shape:IMO-017-DateRecordShape>
    a sh:NodeShape ;
    sh:class nltl:certificateScheduleDateRecord ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Each certificate schedule date record shall contain a date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:message "Each certificate schedule date record shall identify a validity, survey, or endorsement date category."
    ] .

<urn:nltl:generated-shape:IMO-017-PolarSupplementShape>
    a sh:NodeShape ;
    sh:class nltl:polarCertificateSupplement ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-017-RequiredEquipmentShape> ;
        sh:message "The Polar Certificate supplement shall record required equipment."
    ] .

<urn:nltl:generated-shape:IMO-017-RequiredEquipmentShape>
    a sh:NodeShape ;
    sh:class nltl:requiredEquipmentRecords .

<urn:nltl:generated-shape:IMO-017-CertificateScheduleRelationshipShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:hasCertificateScheduleDateRecord ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:node <urn:nltl:generated-shape:IMO-017-DateRecordShape>
    ] .
