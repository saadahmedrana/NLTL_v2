@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_030_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operations are applicable, the PWOM shall include ice-operation monitoring and safety procedures."
            ] ;
            sh:property [
                sh:path nltl:escortRequirementsPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operations are applicable, the PWOM shall include applicable escort or icebreaker-assistance requirements."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:independentOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "Independent-operation limitations shall be specified when that operating mode applies."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:escortedOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "Escorted-operation limitations shall be specified when escorted operation applies."
                    ]
                ]
            )
        ]
    ) .
