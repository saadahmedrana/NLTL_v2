@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-031-ExposedStructureMaterialApprovalShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each supplied exposed-structure material must have approved material status, an authorized approving authority and standard, and a polar service temperature basis." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:exposedStructureMaterial ?material .

                FILTER (
                    datatype(?material) != xsd:string

                    || NOT EXISTS {
                        ?this nltl:materialApprovalStatus nltl:evidenceStateApproved
                    }
                    || EXISTS {
                        ?this nltl:materialApprovalStatus ?status .
                        FILTER (?status != nltl:evidenceStateApproved)
                    }

                    || NOT EXISTS {
                        ?this nltl:approvingAuthority ?authority .
                        FILTER (
                            datatype(?authority) = xsd:string
                            && STR(?authority) IN (
                                "Administration",
                                "recognized organization accepted by the Administration"
                            )
                        )
                    }
                    || EXISTS {
                        ?this nltl:approvingAuthority ?authorityValue .
                        FILTER (
                            datatype(?authorityValue) != xsd:string
                            || STR(?authorityValue) NOT IN (
                                "Administration",
                                "recognized organization accepted by the Administration"
                            )
                        )
                    }

                    || NOT EXISTS {
                        ?this nltl:approvalStandard ?standard .
                        FILTER (
                            datatype(?standard) = xsd:string
                            && STR(?standard) IN (
                                "standard acceptable to the Organization",
                                "another standard offering an equivalent level of safety"
                            )
                        )
                    }
                    || EXISTS {
                        ?this nltl:approvalStandard ?standardValue .
                        FILTER (
                            datatype(?standardValue) != xsd:string
                            || STR(?standardValue) NOT IN (
                                "standard acceptable to the Organization",
                                "another standard offering an equivalent level of safety"
                            )
                        )
                    }

                    || NOT EXISTS {
                        ?this nltl:polarServiceTemperature ?temperature .
                        ?temperature a qudt:QuantityValue ;
                            qudt:numericValue ?numericValue ;
                            qudt:unit qudt:DEG_C .
                        FILTER (datatype(?numericValue) = xsd:decimal)
                    }
                    || EXISTS {
                        ?this nltl:polarServiceTemperature ?badTemperature .
                        FILTER (
                            NOT EXISTS {
                                ?badTemperature a qudt:QuantityValue
                            }
                            || NOT EXISTS {
                                ?badTemperature qudt:numericValue ?badNumericValue .
                                FILTER (datatype(?badNumericValue) = xsd:decimal)
                            }
                            || NOT EXISTS {
                                ?badTemperature qudt:unit qudt:DEG_C
                            }
                        )
                    }
                )
            }
        """ ;
    ] .
