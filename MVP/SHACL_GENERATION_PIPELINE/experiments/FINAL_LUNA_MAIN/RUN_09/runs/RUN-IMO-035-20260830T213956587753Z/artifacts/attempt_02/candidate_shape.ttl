@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO035ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarWaterOperationalManualRecord ;
        sh:minCount 1 ;
        sh:node nltl:IMO035PWOMRecordShape ;
        sh:message "A ship shall identify its polar water operational manual record containing the icing allowance information."
    ] ;
    sh:property [
        sh:path nltl:hasStabilityCalculationRecord ;
        sh:minCount 1 ;
        sh:node nltl:IMO035StabilityRecordShape ;
        sh:message "A ship shall identify its stability calculation record containing the icing allowance values."
    ] ;
    sh:sparql [
        sh:message "The polar water operational manual icing allowance values shall match the stability calculation icing allowance values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPolarWaterOperationalManualRecord ?pwomRecord .
                $this nltl:hasStabilityCalculationRecord ?stabilityRecord .
                ?pwomRecord nltl:polarWaterOperationalManualIcingAllowanceValues ?pwomValue .
                ?stabilityRecord nltl:stabilityCalculationIcingAllowanceValues ?stabilityValue .
                FILTER (?pwomValue != ?stabilityValue)
            }
        """
    ] .

nltl:IMO035PWOMRecordShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The polar water operational manual record shall state that icing allowance information is present."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The polar water operational manual record shall provide icing allowance values."
    ] .

nltl:IMO035StabilityRecordShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:stabilityCalculationIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The stability calculation record shall provide icing allowance values."
    ] .
