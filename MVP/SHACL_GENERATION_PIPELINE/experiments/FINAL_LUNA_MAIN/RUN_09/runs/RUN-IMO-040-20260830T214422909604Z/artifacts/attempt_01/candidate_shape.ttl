@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "iceAccretionLikely must be recorded as false when the conditional requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "iceAccretionLikely must be recorded as true when the conditional requirement applies."
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:class nltl:relevantHatchOrDoorItem ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:message "Each relevant hatch or door must have associated means to remove or prevent ice or snow accretion."
                    ]
                ]
            ]
        ]
    ) .
