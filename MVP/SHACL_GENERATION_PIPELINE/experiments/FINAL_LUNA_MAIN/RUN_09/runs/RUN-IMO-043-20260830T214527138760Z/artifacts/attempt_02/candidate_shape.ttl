@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO043ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node gen:IMO043MachineryInstallationShape
    ] .

gen:IMO043MachineryInstallationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:iceAccretionHazard ;
        sh:minCount 1 ;
        sh:message "The machinery installation must identify applicable ice accretion hazard coverage."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:snowAccumulationHazard ;
        sh:minCount 1 ;
        sh:message "The machinery installation must identify applicable snow accumulation hazard coverage."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:seawaterIceIngestionHazard ;
        sh:minCount 1 ;
        sh:message "The machinery installation must identify applicable seawater ice ingestion hazard coverage."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:liquidFreezingOrViscosityIncreaseHazard ;
        sh:minCount 1 ;
        sh:message "The machinery installation must identify applicable liquid freezing or viscosity increase hazard coverage."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:seawaterIntakeTemperatureHazard ;
        sh:minCount 1 ;
        sh:message "The machinery installation must identify applicable seawater intake temperature hazard coverage."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:hasValue nltl:snowIngestionHazard ;
        sh:minCount 1 ;
        sh:message "The machinery installation must identify applicable snow ingestion hazard coverage."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:minCount 1 ;
        sh:message "The machinery installation must have hazard-protection evidence."
    ] ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:node gen:IMO043AssociatedEquipmentShape
    ] .

gen:IMO043AssociatedEquipmentShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each associated equipment item must be covered by the linked machinery installation's six applicable hazard protections and hazard-protection evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                ?installation nltl:hasAssociatedEquipment $this .
                FILTER NOT EXISTS {
                    ?installation nltl:hasApplicableHazard nltl:iceAccretionHazard .
                }
                FILTER NOT EXISTS {
                    ?installation nltl:hasApplicableHazard nltl:snowAccumulationHazard .
                }
                FILTER NOT EXISTS {
                    ?installation nltl:hasApplicableHazard nltl:seawaterIceIngestionHazard .
                }
                FILTER NOT EXISTS {
                    ?installation nltl:hasApplicableHazard nltl:liquidFreezingOrViscosityIncreaseHazard .
                }
                FILTER NOT EXISTS {
                    ?installation nltl:hasApplicableHazard nltl:seawaterIntakeTemperatureHazard .
                }
                FILTER NOT EXISTS {
                    ?installation nltl:hasApplicableHazard nltl:snowIngestionHazard .
                }
                FILTER NOT EXISTS {
                    ?installation nltl:hasHazardProtectionEvidence ?evidence .
                }
            }
        """
    ] .
