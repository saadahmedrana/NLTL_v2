@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO047ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEssentialEngine ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:essentialEngine ;
        sh:message "The ship must identify at least one essential engine." ;
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperatureControlPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Combustion air temperature control must be recorded as present." ;
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO047TemperatureQuantityShape ;
        sh:message "A single combustion-air temperature in degrees Celsius is required." ;
    ] ;
    sh:property [
        sh:path nltl:manufacturerMinAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO047TemperatureQuantityShape ;
        sh:message "A single manufacturer minimum air temperature in degrees Celsius is required." ;
    ] ;
    sh:property [
        sh:path nltl:manufacturerMaxAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO047TemperatureQuantityShape ;
        sh:message "A single manufacturer maximum air temperature in degrees Celsius is required." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For each identified essential engine, the combustion-air temperature must be within the manufacturer minimum and maximum criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasEssentialEngine ?engine .
                $this nltl:combustionAirTemperature ?temperatureNode .
                $this nltl:manufacturerMinAirTemperature ?minimumNode .
                $this nltl:manufacturerMaxAirTemperature ?maximumNode .
                ?temperatureNode qudt:numericValue ?temperature .
                ?minimumNode qudt:numericValue ?minimum .
                ?maximumNode qudt:numericValue ?maximum .
                FILTER (?temperature < ?minimum || ?temperature > ?maximum)
            }
        """ ;
    ] .

gen:IMO047TemperatureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:DEG_C ;
    ] .
