@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO049Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must identify the applicable machinery component inventory."
    ] ;
    sh:or (
        gs:IMO049CategoryAShape
        gs:IMO049CategoryBShape
        gs:IMO049CategoryCIceStrengthenedShape
    ) .

gs:IMO049CategoryAShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryA ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:class nltl:machineryComponent ;
        sh:node gs:IMO049ABComponentShape ;
        sh:message "Each applicable machinery component must have approved scantling evidence."
    ] .

gs:IMO049CategoryBShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryB ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:class nltl:machineryComponent ;
        sh:node gs:IMO049ABComponentShape ;
        sh:message "Each applicable machinery component must have approved scantling evidence."
    ] .

gs:IMO049CategoryCIceStrengthenedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:class nltl:machineryComponent ;
        sh:node gs:IMO049CComponentShape ;
        sh:message "Each applicable ice-strengthened Category C machinery component must have context-specific approved scantling evidence."
    ] .

gs:IMO049ABComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:class nltl:approvalRecord ;
        sh:node gs:IMO049ABApprovalRecordShape ;
        sh:minCount 1 ;
        sh:message "An applicable machinery component must have an approved scantling approval record."
    ] .

gs:IMO049CComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:class nltl:approvalRecord ;
        sh:node gs:IMO049CApprovalRecordShape ;
        sh:minCount 1 ;
        sh:message "An applicable machinery component must have an approved Category C scantling approval record."
    ] .

gs:IMO049ABApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:minCount 1
    ] .

gs:IMO049CApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "acceptable standard adequate for operating ice type and concentration"
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:class qudt:QuantityValue ;
        sh:node gs:IMO049UnitlessQuantityShape ;
        sh:minCount 1
    ] .

gs:IMO049UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
