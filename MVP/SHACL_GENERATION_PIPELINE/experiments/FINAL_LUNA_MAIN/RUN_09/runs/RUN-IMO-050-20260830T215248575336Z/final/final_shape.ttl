@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_050_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        _:branch1
        _:branch2
    ) .

_:branch1
    sh:property _:property1 .

_:property1
    sh:path nltl:fireSafetyComponentExposed ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue false ;
    sh:message "Fire-safety component exposure must be explicitly recorded as false when the protection condition is not applicable." .

_:branch2
    sh:property _:property2 ;
    sh:property _:property3 .

_:property2
    sh:path nltl:fireSafetyComponentExposed ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue true ;
    sh:message "Fire-safety component exposure must be explicitly recorded as true when exposed equipment protection is required." .

_:property3
    sh:path nltl:iceAndSnowProtectionPresent ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue true ;
    sh:message "Exposed fire-safety components must have ice and snow protection." .
