@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-052-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasRequiredAccessItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredAccessItem ;
        sh:node [
            sh:property [
                sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                sh:minCount 1 ;
                sh:message "Each required access shall have associated ice or snow removal or prevention means."
            ]
        ]
    ] .
