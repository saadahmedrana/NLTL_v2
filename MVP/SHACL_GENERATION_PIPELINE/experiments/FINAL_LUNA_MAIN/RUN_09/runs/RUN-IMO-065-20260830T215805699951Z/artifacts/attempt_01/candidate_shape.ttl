@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-065-Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:abandonmentEnvironment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "An assessed abandonment environment must be recorded."
    ] ;
    sh:property [
        sh:path nltl:maximumExpectedRescueTime ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:DAY ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The maximum expected rescue time must be recorded as a decimal quantity in days."
    ] ;
    sh:property [
        sh:path nltl:survivalSupportDuration ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:DAY ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The survival support duration must be recorded as a decimal quantity in days."
    ] ;
    sh:property [
        sh:path nltl:habitableEnvironmentPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Resources must provide a habitable environment."
    ] ;
    sh:property [
        sh:path nltl:weatherProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Resources must protect persons from cold, wind, and sun."
    ] ;
    sh:property [
        sh:path nltl:accommodationSpacePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Resources must provide accommodation space."
    ] ;
    sh:property [
        sh:path nltl:sustenanceMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Resources must provide sustenance."
    ] ;
    sh:property [
        sh:path nltl:safeAccessExitPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Resources must provide safe access and exit points."
    ] ;
    sh:property [
        sh:path nltl:rescueCommunicationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Resources must provide communication with rescue assets."
    ] ;
    sh:sparql [
        sh:message "Survival support duration must be at least the maximum expected rescue time." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?supportDuration .
                ?supportDuration qudt:numericValue ?supportValue ;
                    qudt:unit qudt:DAY .
                $this nltl:maximumExpectedRescueTime ?rescueDuration .
                ?rescueDuration qudt:numericValue ?rescueValue ;
                    qudt:unit qudt:DAY .
                FILTER (?supportValue < ?rescueValue)
            }
        """
    ] .
