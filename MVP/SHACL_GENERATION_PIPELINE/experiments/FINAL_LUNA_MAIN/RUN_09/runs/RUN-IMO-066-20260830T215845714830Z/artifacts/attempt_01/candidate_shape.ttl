@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO066ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO066NotExposedBranch
        gs:IMO066ExposedBranch
    ) .

gs:IMO066NotExposedBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship exposure applicability value must be false for the non-applicable branch."
    ] .

gs:IMO066ExposedBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship exposure applicability value must be true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gs:IMO066EscapeRouteItem ;
        sh:qualifiedMinCount 1 ;
        sh:message "When the ship is exposed to ice accretion, every escape route must have associated ice or snow removal or prevention means."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gs:IMO066MusterStationItem ;
        sh:qualifiedMinCount 1 ;
        sh:message "When the ship is exposed to ice accretion, every muster station must have associated ice or snow removal or prevention means."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gs:IMO066EmbarkationAreaItem ;
        sh:qualifiedMinCount 1 ;
        sh:message "When the ship is exposed to ice accretion, every embarkation area must have associated ice or snow removal or prevention means."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gs:IMO066SurvivalCraftItem ;
        sh:qualifiedMinCount 1 ;
        sh:message "When the ship is exposed to ice accretion, every survival craft must have associated ice or snow removal or prevention means."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gs:IMO066LaunchingApplianceItem ;
        sh:qualifiedMinCount 1 ;
        sh:message "When the ship is exposed to ice accretion, every launching appliance must have associated ice or snow removal or prevention means."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape gs:IMO066SurvivalCraftAccessItem ;
        sh:qualifiedMinCount 1 ;
        sh:message "When the ship is exposed to ice accretion, every access route to a survival craft must have associated ice or snow removal or prevention means."
    ] .

gs:IMO066EscapeRouteItem a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:escapeRouteProtectedItem ;
        sh:minCount 1 ;
        sh:message "The protected item must be identified as an escape route."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "The escape route must have associated ice or snow removal or prevention means."
    ] .

gs:IMO066MusterStationItem a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:musterStationProtectedItem ;
        sh:minCount 1 ;
        sh:message "The protected item must be identified as a muster station."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "The muster station must have associated ice or snow removal or prevention means."
    ] .

gs:IMO066EmbarkationAreaItem a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:embarkationAreaProtectedItem ;
        sh:minCount 1 ;
        sh:message "The protected item must be identified as an embarkation area."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "The embarkation area must have associated ice or snow removal or prevention means."
    ] .

gs:IMO066SurvivalCraftItem a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftProtectedItem ;
        sh:minCount 1 ;
        sh:message "The protected item must be identified as a survival craft."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "The survival craft must have associated ice or snow removal or prevention means."
    ] .

gs:IMO066LaunchingApplianceItem a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:launchingApplianceProtectedItem ;
        sh:minCount 1 ;
        sh:message "The protected item must be identified as a launching appliance."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "The launching appliance must have associated ice or snow removal or prevention means."
    ] .

gs:IMO066SurvivalCraftAccessItem a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem ;
        sh:minCount 1 ;
        sh:message "The protected item must be identified as access to a survival craft."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Access to the survival craft must have associated ice or snow removal or prevention means."
    ] .
