@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-069-AddedDevicePower>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:devicePowerSourceIndependentOfMainPower ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When an added life-saving device requires power, its power source must be independent of the ship's main power source."
            ]
        ]
    ) .
