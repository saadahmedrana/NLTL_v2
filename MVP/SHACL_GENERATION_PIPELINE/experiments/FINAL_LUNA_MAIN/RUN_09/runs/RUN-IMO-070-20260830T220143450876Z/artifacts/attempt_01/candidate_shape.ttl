@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-070-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-070-PassengerShipBranch>
        <urn:nltl:generated-shape:IMO-070-NonPassengerShipBranch>
    ) .

<urn:nltl:generated-shape:IMO-070-PassengerShipBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "passenger_ship"
    ] ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A passenger ship must confirm that assigned survival equipment is properly sized."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:node <urn:nltl:generated-shape:IMO-070-PersonOnBoardMemberShape>
    ] .

<urn:nltl:generated-shape:IMO-070-NonPassengerShipBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The non-applicable branch requires shipType to identify a non-passenger ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType .
                FILTER (STR(?shipType) != "passenger_ship")
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-070-PersonOnBoardMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-070-AssignmentShape> ;
        sh:message "Each person on board must have one personal survival equipment assignment."
    ] .

<urn:nltl:generated-shape:IMO-070-AssignmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:class nltl:immersionSuitEquipment
            ]
            [
                sh:class nltl:thermalProtectiveAidEquipment
            ]
        ) ;
        sh:message "Each assignment must provide one immersion suit or one thermal protective aid."
    ] .
