@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-070-ship-applicability> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship identified as a passenger ship by shipType must be typed nltl:passengerShip." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType .
                FILTER ( ?shipType = "passenger_ship"^^xsd:string )
                FILTER NOT EXISTS {
                    $this a nltl:passengerShip .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-070-passenger-ship> a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "passenger_ship"
    ] ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:assignedPersonalSurvivalEquipment ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:qualifiedValueShape [
                                    sh:class nltl:immersionSuitEquipment
                                ] ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedMaxCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:assignedPersonalSurvivalEquipment ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:qualifiedValueShape [
                                    sh:class nltl:thermalProtectiveAidEquipment
                                ] ;
                                sh:qualifiedMinCount 1 ;
                                sh:qualifiedMaxCount 1
                            ]
                        ]
                    )
                ]
            ]
        ]
    ] .
