@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_071_ImmersionSuitShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_071_ImmersionSuitNotRequiredShape
        gen:IMO_071_InsulatedImmersionSuitShape
    ) .

gen:IMO_071_ImmersionSuitNotRequiredShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:immersionSuitRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false )
    ] .

gen:IMO_071_InsulatedImmersionSuitShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:immersionSuitRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:immersionSuitTypeClassification ;
        sh:minCount 1 ;
        sh:in ( nltl:insulatedImmersionSuit ) ;
        sh:message "When immersion suits are required, the immersion suit type shall be insulated."
    ] .
