@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO074Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        g:IMO074NotApplicableShape
        g:IMO074EquipmentAlternativeShape
        g:IMO074EquivalentFunctionalityAlternativeShape
    ) .

g:IMO074NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The abandonment onto ice or land potential assessment must be false when no conditional survival measure is required."
    ] .

g:IMO074EquipmentAlternativeShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:groupSurvivalEquipmentCarried ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When abandonment onto ice or land is potentially required, group survival equipment must be carried or approved equivalent functionality must be provided."
    ] .

g:IMO074EquivalentFunctionalityAlternativeShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "When abandonment onto ice or land is potentially required, approved equivalent survival functionality must be recorded unless group survival equipment is carried."
    ] .
