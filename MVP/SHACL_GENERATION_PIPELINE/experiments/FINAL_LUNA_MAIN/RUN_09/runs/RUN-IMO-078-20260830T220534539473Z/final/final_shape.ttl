@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_078_CrewMemberTrainingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each linked crew member shall have completed personal and group survival equipment training."
    ] .

gen:IMO_078_PassengerInstructionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:personalSurvivalEquipmentInstructionCompleted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each linked passenger shall have completed personal survival equipment instruction."
    ] .

gen:IMO_078_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node gen:IMO_078_CrewMemberTrainingShape
    ] ;
    sh:property [
        sh:path nltl:hasPassenger ;
        sh:node gen:IMO_078_PassengerInstructionShape
    ] .
