@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-081-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-081-NotApplicableDateShape>
        <urn:nltl:generated-shape:IMO-081-NotApplicableIceShape>
        <urn:nltl:generated-shape:IMO-081-IndependentDevicesShape>
        <urn:nltl:generated-shape:IMO-081-DeviceTransducerShape>
    ) ;
    sh:message "For ships constructed on or after 1 January 2017 and ice strengthened, either two independent echo-sounding devices or one device with at least two independent transducers is required." .

<urn:nltl:generated-shape:IMO-081-NotApplicableDateShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date before 1 January 2017 is required to establish non-applicability."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-strengthening status is required to determine applicability."
    ] .

<urn:nltl:generated-shape:IMO-081-NotApplicableIceShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "A valid construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:message "The ship must not be ice strengthened to establish non-applicability."
    ] .

<urn:nltl:generated-shape:IMO-081-IndependentDevicesShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:independentEchoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1 ;
        sh:message "At least two independent echo-sounding devices are required."
    ] .

<urn:nltl:generated-shape:IMO-081-DeviceTransducerShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:echoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:minCount 1 ;
        sh:message "At least one echo-sounding device is required."
    ] ;
    sh:property [
        sh:path nltl:independentTransducerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1 ;
        sh:message "At least two independent transducers are required."
    ] .
