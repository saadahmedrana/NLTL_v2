@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-081-DeviceTransducerShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-081-ApplicableShape>
        <urn:nltl:generated-shape:IMO-081-NotApplicableShape>
    ) .

<urn:nltl:generated-shape:IMO-081-ApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable ship must have a construction date on or after 2017-01-01."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable ship must be ice strengthened."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-081-TwoIndependentDevicesShape>
        <urn:nltl:generated-shape:IMO-081-OneDeviceTwoTransducersShape>
    ) .

<urn:nltl:generated-shape:IMO-081-NotApplicableShape>
    a sh:NodeShape ;
    sh:or (
        <urn:nltl:generated-shape:IMO-081-Pre2017Shape>
        <urn:nltl:generated-shape:IMO-081-NotIceStrengthenedShape>
    ) .

<urn:nltl:generated-shape:IMO-081-Pre2017Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:IMO-081-NotIceStrengthenedShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:IMO-081-TwoIndependentDevicesShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:independentEchoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive "2"^^xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An applicable ship must have at least two independent echo-sounding devices or satisfy the alternative equipment arrangement."
    ] .

<urn:nltl:generated-shape:IMO-081-OneDeviceTwoTransducersShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:echoSoundingDeviceCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive "1"^^xsd:integer ;
        sh:maxInclusive "1"^^xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The alternative arrangement requires exactly one echo-sounding device."
    ] ;
    sh:property [
        sh:path nltl:independentTransducerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive "2"^^xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The alternative arrangement requires at least two independent transducers."
    ] .
