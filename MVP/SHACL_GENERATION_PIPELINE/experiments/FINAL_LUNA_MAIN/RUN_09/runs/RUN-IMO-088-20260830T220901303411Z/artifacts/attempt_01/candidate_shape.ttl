@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-088> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's continuous-daylight operating profile must be provided."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A non-continuous-daylight ship must have at least two qualifying bridge-controlled rotatable narrow-beam searchlights."
            ] ;
            sh:property [
                sh:path nltl:searchlightCoverageArc ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 360 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:DEG ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The searchlights must provide coverage over an arc of at least 360 degrees."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A non-continuous-daylight ship must have approved alternative means to visually detect ice when the specified searchlight arrangement is not provided."
            ]
        ]
    ) ;
    sh:message "Ships not operating solely in continuous daylight must provide either the specified searchlight arrangement or approved alternative visual ice-detection means." .
