@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO094ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO094ApplicableShape
        gen:IMO094NotApplicableShape
    ) ;
    sh:message "A ship must identify whether it provides icebreaking escort; escorting ships must have the required astern-facing sound signaling system and International Code of Signals compliance." .

gen:IMO094ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipProvidesIcebreakingEscort ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:asternFacingSoundSignalingSystemPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship providing icebreaking escort must have an astern-facing sound signaling system."
    ] ;
    sh:property [
        sh:path nltl:internationalCodeOfSignalsComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship providing icebreaking escort must comply with the International Code of Signals."
    ] .

gen:IMO094NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipProvidesIcebreakingEscort ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .
