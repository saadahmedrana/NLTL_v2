@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The low-air-temperature applicability state must be explicitly false when this conditional requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The low-air-temperature applicability state must be explicitly true when this requirement applies."
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:node <urn:nltl:generated-shape:IMO-097-CraftShape>
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:node <urn:nltl:generated-shape:IMO-097-CraftShape>
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-097-CraftShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one on-scene transmit/receive communication device."
    ] .
