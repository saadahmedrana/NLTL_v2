@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO097ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The low-air-temperature applicability value must be true for this branch."
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:minCount 1 ;
                sh:node gen:IMO097LifeboatShape ;
                sh:message "Each applicable released rescue boat or lifeboat must be represented."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:minCount 1 ;
                sh:node gen:IMO097LifeboatShape ;
                sh:message "The applicable ship must represent its lifeboat relationship."
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:minCount 1 ;
                sh:class nltl:otherSurvivalCraft ;
                sh:message "The applicable ship must represent its other-survival-craft relationship."
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:minCount 1 ;
                sh:node gen:IMO097SurvivalCraftShape ;
                sh:message "Each applicable survival craft must be linked from the ship and carry the required communication devices."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The low-air-temperature applicability value must be false for this branch."
            ]
        ]
    ) .

gen:IMO097LifeboatShape a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:minCount 1 ;
        sh:class nltl:equipmentItem ;
        sh:message "Each applicable lifeboat must carry at least one distress-alert device."
    ] .

gen:IMO097SurvivalCraftShape a sh:NodeShape ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:message "Each applicable survival craft must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:class nltl:locationSignalDevice ;
        sh:message "Each applicable survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:message "Each applicable survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
