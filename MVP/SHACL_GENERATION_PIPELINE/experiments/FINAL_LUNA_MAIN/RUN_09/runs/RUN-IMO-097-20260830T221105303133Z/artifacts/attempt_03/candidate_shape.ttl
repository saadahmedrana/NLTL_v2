@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating status is required." ;
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft ;
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:class nltl:survivalCraft ;
        sh:node gen:IMO097SurvivalCraftShape ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gen:IMO097LifeboatShape ;
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gen:IMO097LifeboatShape ;
            ]
        ]
    ) .

gen:IMO097LifeboatShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:class nltl:equipmentItem ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat shall carry at least one ship-to-shore distress-alert device." ;
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat shall carry at least one location-signal device." ;
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat shall carry at least one on-scene transmit/receive communication device." ;
    ] .

gen:IMO097SurvivalCraftShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
    ] .
