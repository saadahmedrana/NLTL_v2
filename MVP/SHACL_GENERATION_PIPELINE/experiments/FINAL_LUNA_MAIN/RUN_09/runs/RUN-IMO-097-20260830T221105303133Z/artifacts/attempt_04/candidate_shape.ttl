@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating status is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:minCount 1 ;
                sh:node gen:IMO097LifeboatShape ;
                sh:message "At least one required rescue boat or lifeboat must be represented."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:minCount 1 ;
                sh:node gen:IMO097LifeboatShape ;
                sh:message "At least one lifeboat must be represented."
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:minCount 1 ;
                sh:class nltl:otherSurvivalCraft ;
                sh:message "Other survival craft must be represented."
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:class nltl:survivalCraft
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "When the ship operates in low air temperature, each represented released rescue boat or lifeboat must carry the required communication devices." .

gen:IMO097LifeboatShape a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "The released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:message "The released rescue boat or lifeboat must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "The released rescue boat or lifeboat must carry at least one on-scene transmit/receive communication device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "The released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] .
