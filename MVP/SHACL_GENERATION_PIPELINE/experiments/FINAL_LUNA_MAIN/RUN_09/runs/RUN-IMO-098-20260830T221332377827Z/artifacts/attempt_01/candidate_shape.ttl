@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-098-Ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The low-air-temperature operating applicability must be recorded as false for this non-applicable case."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The low-air-temperature operating applicability must be recorded as true for this applicable case."
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:node [
                    sh:class nltl:otherSurvivalCraft ;
                    sh:property [
                        sh:path nltl:hasLocationSignalDevice ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:locationSignalDevice
                        ] ;
                        sh:message "Every other survival craft must carry at least one location-signal device."
                    ] ;
                    sh:property [
                        sh:path nltl:hasOnSceneCommunicationDevice ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:onSceneCommunicationDevice
                        ] ;
                        sh:message "Every other survival craft must carry at least one on-scene transmit/receive communication device."
                    ]
                ]
            ]
        ]
    ) .
