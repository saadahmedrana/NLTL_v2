@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-104-crew-pwom-familiarization>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:class nltl:crewMember ;
        sh:message "Each supplied crew member must be represented as a crew member." ;
        sh:node [
            sh:property [
                sh:path nltl:hasAssignedDuty ;
                sh:class nltl:assignedDuty ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
                        sh:class nltl:polarWaterOperationalManualItem
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:message "The PWOM familiarization status, when supplied, must be boolean."
    ] ;
    sh:sparql [
        sh:message "Every supplied crew member must have completed familiarization for each PWOM procedure or equipment item relevant to that crew member's assigned duties." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasCrewMemberInventory ?crewMember .
                ?crewMember nltl:hasAssignedDuty ?assignedDuty .
                ?assignedDuty nltl:hasRelevantPolarWaterOperationalManualItem ?manualItem .
                FILTER NOT EXISTS {
                    ?crewMember nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?manualItem .
                }
                FILTER NOT EXISTS {
                    $this nltl:polarWaterOperationalManualFamiliarizationStatus ?status .
                    FILTER (?status = true)
                }
            }
        """
    ] .
