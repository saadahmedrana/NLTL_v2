@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_110_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship category of A, B, or C is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:deadweight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:TON_Metric ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Deadweight must be provided as a single metric-tonne quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB )
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:hasValue "oil_tanker"
            ] ;
            sh:property [
                sh:path nltl:deadweight ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "5000"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:entireCargoTankLengthDoubleBottomProtectionStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Applicable ships must have compliant double-bottom protection over the entire cargo tank length."
            ] ;
            sh:property [
                sh:path nltl:wingTankProtectionStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Applicable ships must have compliant wing-tank protection."
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:hasValue nltl:polarShipCategoryC
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shipType ;
                        sh:not [
                            sh:hasValue "oil_tanker"
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:deadweight ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minInclusive "5000"^^xsd:decimal
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:maxExclusive "2017-01-01"^^xsd:date
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For a Category A or B oil tanker of less than 5,000 tonnes deadweight constructed on or after 1 January 2017, both specified cargo-tank protection compliance statuses must be true." .
