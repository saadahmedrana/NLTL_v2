@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-111-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "Every oil residue tank or oily bilge water holding tank on an applicable ship must have a valid capacity, and tanks with capacity greater than 30 m3 must have outer-shell separation of at least 0.76 m." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasComponent ?tank .
                        ?tank rdf:type ?tankClass .
                        FILTER (
                            ?tankClass = nltl:oilResidueTank ||
                            ?tankClass = nltl:oilyBilgeWaterHoldingTank
                        )
                        FILTER (
                            !EXISTS {
                                ?tank nltl:individualTankCapacity ?capacityValue .
                                ?capacityValue qudt:numericValue ?capacity .
                                ?capacityValue qudt:unit unit:M3 .
                                FILTER (
                                    isLiteral(?capacity) &&
                                    datatype(?capacity) = xsd:decimal
                                )
                            }
                            ||
                            (
                                EXISTS {
                                    ?tank nltl:individualTankCapacity ?largeCapacityValue .
                                    ?largeCapacityValue qudt:numericValue ?largeCapacity .
                                    ?largeCapacityValue qudt:unit unit:M3 .
                                    FILTER (
                                        isLiteral(?largeCapacity) &&
                                        datatype(?largeCapacity) = xsd:decimal &&
                                        ?largeCapacity > 30
                                    )
                                }
                                &&
                                !EXISTS {
                                    ?tank nltl:tankOuterShellSeparation ?separationValue .
                                    ?separationValue qudt:numericValue ?separation .
                                    ?separationValue qudt:unit unit:M .
                                    FILTER (
                                        isLiteral(?separation) &&
                                        datatype(?separation) = xsd:decimal &&
                                        ?separation >= 0.76
                                    )
                                }
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxInclusive "2016-12-31"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
