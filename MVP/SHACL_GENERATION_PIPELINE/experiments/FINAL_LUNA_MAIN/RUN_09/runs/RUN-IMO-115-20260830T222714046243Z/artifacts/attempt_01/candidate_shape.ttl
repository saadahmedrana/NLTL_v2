@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-115> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "When sewage discharge is comminuted and disinfected, the MARPOL compliance status, qualifying distance, nearby ice concentration, and distance from areas exceeding one tenth ice concentration must be recorded and conform." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType .
                FILTER(?dischargeType = "comminuted_and_disinfected"^^xsd:string)

                FILTER(
                    NOT EXISTS {
                        $this nltl:comminutedAndDisinfected
                            "true"^^xsd:boolean
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus
                            "true"^^xsd:boolean
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceToNearestIceShelfOrFastIce ?distance .
                        ?distance a qudt:QuantityValue ;
                            qudt:numericValue ?distanceValue ;
                            qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                        FILTER(datatype(?distanceValue) = xsd:decimal)
                        FILTER(?distanceValue > "3"^^xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nearbyIceConcentration ?concentration .
                        ?concentration a qudt:QuantityValue ;
                            qudt:numericValue ?concentrationValue ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER(datatype(?concentrationValue) = xsd:decimal)
                        FILTER(?concentrationValue > "0.1"^^xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth
                            ?areaDistance .
                        ?areaDistance a qudt:QuantityValue ;
                            qudt:numericValue ?areaDistanceValue ;
                            qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                        FILTER(datatype(?areaDistanceValue) = xsd:decimal)
                    }
                )
            }
        """
    ] .
