@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_116_Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:notComminutedOrDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When sewage discharge is not comminuted or disinfected, the ship must record MARPOL Annex IV regulation 11.1.1 compliance, a distance greater than 12 nautical miles from the nearest ice shelf or fast ice, and the recorded distance from areas whose ice concentration exceeds 1/10." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType ;
                      nltl:notComminutedOrDisinfected ?notProcessed .

                FILTER (
                    ?dischargeType = "not_comminuted_or_disinfected" ||
                    ?notProcessed = true
                )

                FILTER NOT EXISTS {
                    $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true .
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestIceShelfOrFastIce ?nearestDistance .
                    ?nearestDistance a qudt:QuantityValue ;
                                     qudt:numericValue ?nearestValue ;
                                     qudt:unit unit:MI_N .
                    FILTER (
                        datatype(?nearestValue) = xsd:decimal &&
                        ?nearestValue > "12"^^xsd:decimal
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?nearbyConcentration .
                    ?nearbyConcentration a qudt:QuantityValue ;
                                         qudt:numericValue ?nearbyValue ;
                                         qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?nearbyValue) = xsd:decimal &&
                        ?nearbyValue > "1"^^xsd:decimal
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                    ?areaDistance a qudt:QuantityValue ;
                                  qudt:numericValue ?areaDistanceValue ;
                                  qudt:unit unit:MI_N .
                    FILTER (datatype(?areaDistanceValue) = xsd:decimal)
                }
            }
        """
    ] .
