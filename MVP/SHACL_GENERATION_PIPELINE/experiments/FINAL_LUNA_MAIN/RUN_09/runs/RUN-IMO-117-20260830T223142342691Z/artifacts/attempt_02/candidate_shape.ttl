@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO117ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The sewage-treatment-plant applicability value is required and must be a single boolean."
    ] ;
    sh:or (
        gen:IMO117TreatmentPlantApplicableShape
        gen:IMO117TreatmentPlantNotApplicableShape
    ) .

gen:IMO117TreatmentPlantApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:sewageTreatmentPlantApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "An applicable sewage treatment plant must have a single approved status."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "An applicable ship must have a single approved MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable ship must have a compliant MARPOL Annex IV regulation 11.1.2 discharge status."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:node gen:IMO117DischargeDistanceRecordShape ;
        sh:message "Each linked discharge-distance record must contain both required distance values."
    ] .

gen:IMO117TreatmentPlantNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:hasValue false
    ] .

gen:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:message "Each discharge-distance record must contain one distance to the nearest land, ice shelf, or fast ice."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:message "Each discharge-distance record must contain one distance to an area with ice concentration greater than one tenth."
    ] .

gen:IMO117NauticalMileQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .
