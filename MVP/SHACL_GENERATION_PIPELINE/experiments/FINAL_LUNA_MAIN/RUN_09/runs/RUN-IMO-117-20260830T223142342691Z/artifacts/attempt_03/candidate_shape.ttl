@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO117ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO117NotApplicableShape
        gs:IMO117ApplicableShape
    ) .

gs:IMO117NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The sewage treatment-plant condition must be explicitly false when this requirement is non-applicable."
    ] .

gs:IMO117ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The sewage treatment-plant applicability condition must be true."
    ] ;
    sh:property [
        sh:path nltl:sewageTreatmentPlantApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "An approved sewage treatment plant is required."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Approved MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification is required."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "MARPOL Annex IV regulation 11.1.2 discharge compliance is required."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gs:IMO117DischargeDistanceRecordShape ;
        sh:minCount 1 ;
        sh:message "At least one discharge-distance record is required when the sewage treatment plant is used."
    ] .

gs:IMO117DischargeDistanceRecordShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node gs:IMO117DistanceQuantityShape ;
        sh:minCount 1 ;
        sh:message "The distance to the nearest land, ice shelf, or fast ice must be recorded."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:node gs:IMO117DistanceQuantityShape ;
        sh:minCount 1 ;
        sh:message "The distance to the area with ice concentration greater than one tenth must be recorded."
    ] .

gs:IMO117DistanceQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .
