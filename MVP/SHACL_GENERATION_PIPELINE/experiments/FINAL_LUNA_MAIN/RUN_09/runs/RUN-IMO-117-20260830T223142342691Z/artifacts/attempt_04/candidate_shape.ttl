@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:IMO_117_QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A discharge distance quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A discharge distance must use nautical miles."
    ] .

ex:IMO_117_DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:class nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node ex:IMO_117_QuantityShape ;
        sh:minCount 1 ;
        sh:message "Each applicable discharge-distance record must record the distance to the nearest land ice shelf or fast ice."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:node ex:IMO_117_QuantityShape ;
        sh:minCount 1 ;
        sh:message "Each applicable discharge-distance record must record the distance to an area with ice concentration greater than one tenth."
    ] .

ex:IMO_117_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The treatment-plant applicability selector must be true for the applicable branch."
            ] ;
            sh:property [
                sh:path nltl:sewageTreatmentPlantApprovalStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "The sewage treatment plant must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolCertificationStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "MARPOL certification must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Discharge must comply with MARPOL Annex IV regulation 11.1.2."
            ] ;
            sh:property [
                sh:path nltl:marpolDischargeStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "MARPOL discharge status must be compliant."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:node ex:IMO_117_DischargeDistanceRecordShape ;
                sh:minCount 1 ;
                sh:message "At least one applicable discharge-distance record is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:datatype xsd:boolean ;
                sh:in ( false ) ;
                sh:message "The non-applicable branch excludes a true treatment-plant applicability selector."
            ]
        ]
    ) .
