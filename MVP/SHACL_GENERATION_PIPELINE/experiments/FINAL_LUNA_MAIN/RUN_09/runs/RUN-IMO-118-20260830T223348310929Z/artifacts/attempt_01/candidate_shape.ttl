@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO118Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine applicability of the sewage-discharge rule."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A ship category is required to determine applicability of the sewage-discharge rule."
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:message "Sewage-discharge status must be a boolean when represented."
    ] ;
    sh:property [
        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:message "Paragraph 4.2.1.3 compliance status must be a boolean when represented."
    ] ;
    sh:sparql [
        sh:message "For a ship constructed on or after 1 January 2017, category A or B status or passenger-ship classification is required to determine applicability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (?category IN (
                            nltl:polarShipCategoryA,
                            nltl:polarShipCategoryB
                        ))
                    }
                    &&
                    NOT EXISTS {
                        $this rdf:type nltl:passengerShip .
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable ships must not discharge sewage into the sea unless paragraph 4.2.1.3 compliance is recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                {
                    $this nltl:shipCategory ?category .
                    FILTER (?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                UNION
                {
                    $this rdf:type nltl:passengerShip .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
                        FILTER (?status = true)
                    }
                    &&
                    (
                        NOT EXISTS {
                            $this nltl:sewageDischargeToSea ?discharge .
                            FILTER (?discharge = false)
                        }
                        ||
                        EXISTS {
                            $this nltl:sewageDischargeToSea ?dischargeValue .
                            FILTER (?dischargeValue != false)
                        }
                    )
                )
            }
        """
    ] .
