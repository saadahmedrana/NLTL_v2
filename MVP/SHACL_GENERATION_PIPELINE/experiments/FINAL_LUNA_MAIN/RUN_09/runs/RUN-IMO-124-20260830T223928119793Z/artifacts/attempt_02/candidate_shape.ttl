@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_124_StaticShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an Antarctic MARPOL Annex V regulation 6.1 discharge, the fast-ice distance must be at least 12 nautical miles, the applicable ice-area distance and concentration must be recorded, and food waste must not be discharged onto ice." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:operatingArea ?operatingArea ;
          nltl:antarcticArea ?antarcticArea ;
          nltl:marpolAnnexVRegulation6Point1DischargeOccurs true .
    FILTER(?operatingArea = ?antarcticArea)

    FILTER(
        NOT EXISTS {
            $this nltl:distanceToNearestFastIce ?nearest .
            ?nearest qudt:numericValue ?nearestValue ;
                     qudt:unit unit:MI_N .
            FILTER(datatype(?nearestValue) = xsd:decimal &&
                   ?nearestValue >= "12"^^xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:distanceToNearestFastIce ?nearestBad .
            FILTER NOT EXISTS {
                ?nearestBad qudt:numericValue ?nearestValueBad ;
                            qudt:unit unit:MI_N .
                FILTER(datatype(?nearestValueBad) = xsd:decimal &&
                       ?nearestValueBad >= "12"^^xsd:decimal)
            }
        }
        ||
        EXISTS {
            $this nltl:distanceToNearestFastIce ?nearest1, ?nearest2 .
            FILTER(?nearest1 != ?nearest2)
        }
        ||
        NOT EXISTS {
            $this nltl:nearbyIceConcentration ?nearby .
            ?nearby qudt:numericValue ?nearbyValue ;
                    qudt:unit unit:UNITLESS .
            FILTER(datatype(?nearbyValue) = xsd:decimal &&
                   ?nearbyValue > "0.1"^^xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:nearbyIceConcentration ?nearbyBad .
            ?nearbyBad qudt:numericValue ?nearbyBadValue .
            FILTER(datatype(?nearbyBadValue) = xsd:decimal &&
                   ?nearbyBadValue <= "0.1"^^xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:nearbyIceConcentration ?nearby1, ?nearby2 .
            FILTER(?nearby1 != ?nearby2)
        }
        ||
        NOT EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
            ?areaDistance qudt:numericValue ?areaDistanceValue ;
                          qudt:unit unit:MI_N .
            FILTER(datatype(?areaDistanceValue) = xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistanceBad .
            FILTER NOT EXISTS {
                ?areaDistanceBad qudt:numericValue ?areaDistanceBadValue ;
                                 qudt:unit unit:MI_N .
                FILTER(datatype(?areaDistanceBadValue) = xsd:decimal)
            }
        }
        ||
        EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance1, ?areaDistance2 .
            FILTER(?areaDistance1 != ?areaDistance2)
        }
        ||
        NOT EXISTS {
            $this nltl:foodWasteDischargeOntoIce false
        }
        ||
        EXISTS {
            $this nltl:foodWasteDischargeOntoIce true
        }
        ||
        EXISTS {
            $this nltl:foodWasteDischargeOntoIce ?food1, ?food2 .
            FILTER(?food1 != ?food2)
        }
    )
}
""" ;
    ] .
