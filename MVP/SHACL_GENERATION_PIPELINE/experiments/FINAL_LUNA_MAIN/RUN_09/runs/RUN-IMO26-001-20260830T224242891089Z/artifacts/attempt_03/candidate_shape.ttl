@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue true ;
                sh:message "SOLAS chapter I certification is true; Polar Code chapter 9 is applicable." ;
            ]
            [
                sh:hasValue false ;
                sh:message "SOLAS chapter I certification is false; Polar Code chapter 9 is not applicable." ;
            ]
        )
    ] .
