@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's polar-waters operating status is required as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 11-1 applicability is required as a single boolean value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 11-1 applicability must be true exactly for qualifying fishing vessels, pleasure yachts, or cargo ships operating in polar waters, and false otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters ?polar ;
                      nltl:polarCodeChapter11Dash1Applicable ?app .

                FILTER (
                    (
                        ?polar = true &&
                        ?app = true &&
                        NOT EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" ;
                                      nltl:lengthOverall ?length .
                                ?length qudt:numericValue ?lengthValue ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (?lengthValue >= 24)
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" ;
                                      nltl:grossTonnage ?tonnage ;
                                      nltl:engagedInTrade false .
                                ?tonnage qudt:numericValue ?tonnageValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300)
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" ;
                                      nltl:grossTonnage ?tonnage .
                                ?tonnage qudt:numericValue ?tonnageValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300 && ?tonnageValue < 500)
                            }
                        }
                    )
                    ||
                    (
                        ?polar = true &&
                        ?app = false &&
                        EXISTS {
                            {
                                $this nltl:shipType "fishing_vessel" ;
                                      nltl:lengthOverall ?length .
                                ?length qudt:numericValue ?lengthValue ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (?lengthValue >= 24)
                            }
                            UNION
                            {
                                $this nltl:shipType "pleasure_yacht" ;
                                      nltl:grossTonnage ?tonnage ;
                                      nltl:engagedInTrade false .
                                ?tonnage qudt:numericValue ?tonnageValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300)
                            }
                            UNION
                            {
                                $this nltl:shipType "cargo_ship" ;
                                      nltl:grossTonnage ?tonnage .
                                ?tonnage qudt:numericValue ?tonnageValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (?tonnageValue >= 300 && ?tonnageValue < 500)
                            }
                        }
                    )
                    ||
                    (
                        ?polar = false &&
                        ?app != false
                    )
                )
            }
        """
    ] .
