@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-017> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When Polar Code chapter 11-1 is applicable, a voyage plan shall be present."
            ] ;
            sh:property [
                sh:path nltl:intendedVoyageHazard ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When Polar Code chapter 11-1 is applicable, the intended-voyage hazard register shall be present."
            ] ;
            sh:property [
                sh:path nltl:voyagePlanCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When Polar Code chapter 11-1 is applicable, the voyage plan shall cover every intended-voyage hazard."
            ]
        ]
    ) ;
    sh:message "The chapter 11-1 applicability state and its conditional voyage-plan hazard-coverage requirements shall conform." .
