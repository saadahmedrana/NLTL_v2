@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2012-01-01"^^xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date ;
                sh:message "A ship to which the 2010 Ice Class Regulations apply must have a construction contract date from 2012-01-01 through 2018-12-31."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2010 ;
                sh:minCount 1 ;
                sh:message "Ships contracted for construction from 2012-01-01 through 2018-12-31 must identify the 2010 Ice Class Regulations as the applicable regulation edition."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxExclusive "2012-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2019-01-01"^^xsd:date
            ]
        ]
    ) .
