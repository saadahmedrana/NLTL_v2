@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-005> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:message "Construction contract date must be an xsd:date when supplied."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "Construction stage date must be an xsd:date when supplied."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ships with a construction stage date on or after 2003-09-01 and a construction contract date before 2010-01-01, the applicable ice class regulation edition must be exactly the 2002 edition and no conflicting edition may be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (datatype(?stageDate) = xsd:date)
                FILTER (datatype(?contractDate) = xsd:date)

                FILTER (
                    YEAR(?stageDate) > 2003 ||
                    (YEAR(?stageDate) = 2003 && MONTH(?stageDate) > 9) ||
                    (YEAR(?stageDate) = 2003 && MONTH(?stageDate) = 9 && DAY(?stageDate) >= 1)
                )
                FILTER (YEAR(?contractDate) < 2010)

                FILTER (
                    NOT EXISTS {
                        ?this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002
                    }
                    ||
                    EXISTS {
                        ?this nltl:applicableIceClassRegulationEdition ?conflictingEdition .
                        FILTER (?conflictingEdition != nltl:iceClassRegulationEdition2002)
                    }
                )
            }
        """
    ] .
