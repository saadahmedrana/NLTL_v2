@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:IceWaterlineShape
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node gen:IceWaterlineShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline must contain exactly the pointwise envelope of the highest intended ice-operating waterline points." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?pos
                           (MAX(?intendedY) AS ?expected)
                           (MIN(?uiwlY) AS ?actualMin)
                           (MAX(?uiwlY) AS ?actualMax)
                    WHERE {
                        {
                            $this nltl:hasIntendedIceOperatingWaterline ?intendedLine .
                            ?intendedLine nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPosition ;
                                           nltl:verticalCoordinate ?intendedCoordinate .
                            ?intendedPosition qudt:numericValue ?pos .
                            ?intendedCoordinate qudt:numericValue ?intendedY .
                        }
                        UNION
                        {
                            $this nltl:hasUpperIceWaterline ?uiwlLine .
                            ?uiwlLine nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlPosition ;
                                       nltl:verticalCoordinate ?uiwlCoordinate .
                            ?uiwlPosition qudt:numericValue ?pos .
                            ?uiwlCoordinate qudt:numericValue ?uiwlY .
                        }
                    }
                    GROUP BY $this ?pos
                }
                BIND(
                    IF(
                        ?expected >= "0"^^xsd:decimal,
                        ?expected * "0.000001"^^xsd:decimal,
                        -?expected * "0.000001"^^xsd:decimal
                    )
                    AS ?relativeTolerance
                )
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(
                    !BOUND(?expected)
                    || !BOUND(?actualMin)
                    || !BOUND(?actualMax)
                    || ?actualMin < ?expected - ?tolerance
                    || ?actualMax > ?expected + ?tolerance
                )
            }
        """
    ] .

gen:IceWaterlineShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node gen:WaterlineProfilePointShape
    ] .

gen:WaterlineProfilePointShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape
    ] .

gen:LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
