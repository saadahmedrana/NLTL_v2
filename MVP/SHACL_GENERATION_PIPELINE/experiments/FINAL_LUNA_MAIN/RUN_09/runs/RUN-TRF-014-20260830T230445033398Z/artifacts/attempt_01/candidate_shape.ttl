@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014RestrictionDocumentShape
    a sh:NodeShape ;
    sh:class nltl:iceDraughtRestrictionDocument .

gen:TRF014PostCutoffShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship built on or after 1 July 2007, the applicable ice marking condition must be satisfied." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:constructionDate ?constructionDate .
                    FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                }
                UNION
                {
                    $this nltl:constructionDate ?constructionDate ;
                          nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                          nltl:upperIceWaterlineDraught ?uiwlQuantity .
                    ?summerQuantity qudt:numericValue ?summerValue ;
                                    qudt:unit unit:M .
                    ?uiwlQuantity qudt:numericValue ?uiwlValue ;
                                  qudt:unit unit:M .
                    FILTER (?constructionDate >= "2007-07-01"^^xsd:date)
                    FILTER (?summerValue > ?uiwlValue)
                    FILTER NOT EXISTS {
                        $this nltl:warningTrianglePresent ?warning ;
                              nltl:iceClassDraughtMarkPresent ?markPresent ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                         qudt:unit unit:M .
                        FILTER (datatype(?warning) = xsd:boolean)
                        FILTER (datatype(?markPresent) = xsd:boolean)
                        FILTER (?warning = true)
                        FILTER (?markPresent = true)
                        FILTER (datatype(?markValue) = xsd:decimal)
                        FILTER (datatype(?maximumValue) = xsd:decimal)
                        FILTER (?markValue = ?maximumValue)
                    }
                }
            }
        """
    ] .

gen:TRF014PreCutoffMarkedShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A pre-1 July 2007 ship without a required dry-docking exception must have complete ice marking evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:constructionDate ?constructionDate .
                    FILTER (?constructionDate >= "2007-07-01"^^xsd:date)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:constructionDate ?constructionDate .
                        FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                    }
                }
                UNION
                {
                    $this nltl:constructionDate ?constructionDate .
                    FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                    FILTER NOT EXISTS {
                        $this nltl:warningTrianglePresent ?warning ;
                              nltl:iceClassDraughtMarkPresent ?markPresent ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                         qudt:unit unit:M .
                        FILTER (datatype(?warning) = xsd:boolean)
                        FILTER (datatype(?markPresent) = xsd:boolean)
                        FILTER (?warning = true)
                        FILTER (?markPresent = true)
                        FILTER (datatype(?markValue) = xsd:decimal)
                        FILTER (datatype(?maximumValue) = xsd:decimal)
                        FILTER (?markValue = ?maximumValue)
                    }
                }
            }
        """
    ] .

gen:TRF014PreCutoffDryDockShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a pre-1 July 2007 ship lacking complete marking evidence, the first scheduled dry docking and any due marking are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:constructionDate ?constructionDate .
                    FILTER (?constructionDate >= "2007-07-01"^^xsd:date)
                }
                UNION
                {
                    $this nltl:constructionDate ?constructionDate .
                    FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                    FILTER EXISTS {
                        $this nltl:warningTrianglePresent ?warning ;
                              nltl:iceClassDraughtMarkPresent ?markPresent ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                         qudt:unit unit:M .
                        FILTER (?warning = true)
                        FILTER (?markPresent = true)
                        FILTER (?markValue = ?maximumValue)
                    }
                }
                UNION
                {
                    $this nltl:constructionDate ?constructionDate .
                    FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                    FILTER NOT EXISTS {
                        $this nltl:warningTrianglePresent ?warning ;
                              nltl:iceClassDraughtMarkPresent ?markPresent ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                         qudt:unit unit:M .
                        FILTER (?warning = true)
                        FILTER (?markPresent = true)
                        FILTER (?markValue = ?maximumValue)
                    }
                    FILTER NOT EXISTS {
                        $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                    }
                }
                UNION
                {
                    $this nltl:constructionDate ?constructionDate ;
                          nltl:firstScheduledDryDockingDate ?dryDockingDate ;
                          nltl:assessmentDate ?assessmentDate .
                    FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                    FILTER (?dryDockingDate <= ?assessmentDate)
                    FILTER NOT EXISTS {
                        $this nltl:warningTrianglePresent ?warning ;
                              nltl:iceClassDraughtMarkPresent ?markPresent ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                         qudt:unit unit:M .
                        FILTER (?warning = true)
                        FILTER (?markPresent = true)
                        FILTER (?markValue = ?maximumValue)
                    }
                }
            }
        """
    ] .

gen:TRF014ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:TRF014QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node gen:TRF014ClassCertificateShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node gen:TRF014RestrictionDocumentShape ;
        sh:minCount 1
    ] ;
    sh:or (
        [ sh:node gen:TRF014PostCutoffShape ]
        [ sh:node gen:TRF014PreCutoffMarkedShape ]
        [ sh:node gen:TRF014PreCutoffDryDockShape ]
    ) .
