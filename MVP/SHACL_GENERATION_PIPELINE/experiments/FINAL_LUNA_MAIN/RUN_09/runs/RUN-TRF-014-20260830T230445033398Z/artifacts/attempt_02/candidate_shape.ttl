@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014ClassCertificateShape
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:or (
        [ sh:node gen:TRF014PostCutoffShape ]
        [ sh:node gen:TRF014PreCutoffMarkedShape ]
        [ sh:node gen:TRF014PreCutoffDryDockingShape ]
    ) .

gen:TRF014LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014ClassCertificateShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] .

gen:TRF014MarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF014LengthQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-class draught mark draught amidships must equal the maximum permissible ice-class draught amidships in the class certificate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?markValue .
                $this nltl:hasClassCertificate ?certificate .
                ?certificate nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximumValue .
                FILTER (xsd:decimal(?markValue) != xsd:decimal(?maximumValue))
            }
        """
    ] .

gen:TRF014PostCutoffShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [ sh:node gen:TRF014PostCutoffConditionFalseShape ]
        [ sh:node gen:TRF014MarkingShape ]
    ) .

gen:TRF014PostCutoffConditionFalseShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a post-cutoff ship, marking evidence is required when the summer load line in fresh water is above the UIWL." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summerValue .
                $this nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwlValue .
                FILTER (xsd:decimal(?summerValue) > xsd:decimal(?uiwlValue))
            }
        """
    ] .

gen:TRF014PreCutoffMarkedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:node gen:TRF014MarkingShape .

gen:TRF014PreCutoffDryDockingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [ sh:node gen:TRF014DryDockingAfterAssessmentShape ]
        [ sh:node gen:TRF014MarkingShape ]
    ) .

gen:TRF014DryDockingAfterAssessmentShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Marking is required when the first scheduled dry docking date is on or before the assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                $this nltl:assessmentDate ?assessmentDate .
                FILTER (?dryDockingDate <= ?assessmentDate)
            }
        """
    ] .
