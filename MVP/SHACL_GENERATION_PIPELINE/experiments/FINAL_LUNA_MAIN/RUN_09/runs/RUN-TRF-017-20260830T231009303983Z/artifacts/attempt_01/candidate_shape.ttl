@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PowerQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MaximumContinuousRatingPowerShape a sh:PropertyShape ;
    sh:path nltl:maximumContinuousRatingPower ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gs:PowerQuantityShape .

gs:PropulsionMachineryContinuousOutputShape a sh:PropertyShape ;
    sh:path nltl:propulsionMachineryContinuousOutput ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gs:PowerQuantityShape .

gs:RestrictedPropulsionOutputShape a sh:PropertyShape ;
    sh:path nltl:restrictedPropulsionOutput ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gs:PowerQuantityShape .

gs:PropulsionOutputRestrictionShape a sh:PropertyShape ;
    sh:path nltl:propulsionOutputRestrictionApplies ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gs:ShipPropulsionOutputShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property gs:MaximumContinuousRatingPowerShape ;
    sh:property gs:PropulsionMachineryContinuousOutputShape ;
    sh:property gs:PropulsionOutputRestrictionShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property gs:RestrictedPropulsionOutputShape
        ]
    ) ;
    sh:sparql [
        sh:message "When propulsion output is not restricted, maximum continuous rating power must equal propulsion machinery continuous output." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                      nltl:maximumContinuousRatingPower ?maximumNode ;
                      nltl:propulsionMachineryContinuousOutput ?machineryNode .
                FILTER (?restriction = "false"^^xsd:boolean)
                ?maximumNode qudt:numericValue ?maximumValue .
                ?machineryNode qudt:numericValue ?machineryValue .
                FILTER (?maximumValue != ?machineryValue)
            }
        """
    ] ;
    sh:sparql [
        sh:message "When propulsion output is restricted, maximum continuous rating power must equal restricted propulsion output." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                      nltl:maximumContinuousRatingPower ?maximumNode ;
                      nltl:restrictedPropulsionOutput ?restrictedNode .
                FILTER (?restriction = "true"^^xsd:boolean)
                ?maximumNode qudt:numericValue ?maximumValue .
                ?restrictedNode qudt:numericValue ?restrictedValue .
                FILTER (?maximumValue != ?restrictedValue)
            }
        """
    ] .
