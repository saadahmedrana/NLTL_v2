@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PowerRequirementsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculatedRequiredPower ;
        sh:node gs:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:node gs:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF018ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper ;
                sh:minCount 1
            ] ;
            sh:node gs:PowerRequirementsShape
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa ;
                sh:minCount 1
            ] ;
            sh:node gs:PowerRequirementsShape
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIb ;
                sh:minCount 1
            ] ;
            sh:node gs:PowerRequirementsShape
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIc ;
                sh:minCount 1
            ] ;
            sh:node gs:PowerRequirementsShape
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIi ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIii ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For ice classes IA, IB and IC, maximumContinuousRatingPower must be at least calculatedRequiredPower and 1000 kW; for IA Super, it must be at least calculatedRequiredPower and 2800 kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .

                ?calculatedNode qudt:numericValue ?calculated ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?maximumNode qudt:numericValue ?maximum ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                FILTER (
                    (
                        ?ice IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        )
                        && (?maximum < ?calculated || ?maximum < 1000)
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        && (?maximum < ?calculated || ?maximum < 2800)
                    )
                )
            }
        """
    ] .
