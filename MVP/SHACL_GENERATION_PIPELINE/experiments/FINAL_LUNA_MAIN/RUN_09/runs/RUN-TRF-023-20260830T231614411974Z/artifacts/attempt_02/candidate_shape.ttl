@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF023ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:message "The applicable ice class regulation edition must be the 1985 rules for this branch."
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIb nltl:iceClassIc ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "For the 1985 rules, the ship ice class must be IB or IC."
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Maximum continuous rating power must be expressed in kW."
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:requiredPowerUnder1985Rules ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Required power under the 1985 rules must be expressed in kW."
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc)) .

                        $this nltl:maximumContinuousRatingPower ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue .
                        ?maximumQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                        $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                        ?requiredQuantity qudt:numericValue ?requiredValue .
                        ?requiredQuantity qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                        FILTER (?maximumValue < ?requiredValue)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:in (
                    nltl:iceClassRegulationEdition2002
                    nltl:iceClassRegulationEdition2008
                    nltl:iceClassRegulationEdition2010
                    nltl:iceClassRegulationEdition2017
                    nltl:iceClassRegulationEdition2021
                ) ;
                sh:minCount 1 ;
                sh:message "The applicable regulation edition is not the 1985 edition, so the IB/IC 1985-rule power constraint does not apply."
            ]
        ]
    ) .
