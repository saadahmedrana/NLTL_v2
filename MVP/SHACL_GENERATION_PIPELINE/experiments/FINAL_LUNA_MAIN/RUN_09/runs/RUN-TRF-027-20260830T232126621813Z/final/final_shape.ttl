@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF027Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "iceClass must be exactly one permitted controlled ice-class value."
    ] ;
    sh:or (
        [
            sh:node gen:TRF027ApplicableShape
        ]
        [
            sh:node gen:TRF027NonApplicableClassShape
        ]
        [
            sh:node gen:TRF027LaterConstructionShape
        ]
    ) .

gen:TRF027ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:message "IA Super and IA ships subject to this rule must have a construction stage date before 1 September 2003."
    ] ;
    sh:property gen:ShipLengthShape ;
    sh:property gen:IceClassDraughtShape ;
    sh:property gen:ShipBreadthShape ;
    sh:property gen:ClampedHullGeometryShape ;
    sh:property gen:C3Shape ;
    sh:property gen:C4Shape ;
    sh:property gen:C5Shape ;
    sh:property gen:F1Shape ;
    sh:property gen:F2Shape ;
    sh:property gen:F3Shape ;
    sh:property gen:F4Shape ;
    sh:property gen:G1Shape ;
    sh:property gen:G2Shape ;
    sh:property gen:G3Shape ;
    sh:sparql [
        sh:message "clampedHullGeometryTerm must equal the cube of ((shipLength * iceClassDraught) / shipBreadth squared), clamped to the interval 5 through 20, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipLength ?lengthValue ;
                      nltl:iceClassDraught ?draughtValue ;
                      nltl:shipBreadth ?breadthValue ;
                      nltl:clampedHullGeometryTerm ?resultValue .

                ?lengthValue qudt:numericValue ?length .
                ?draughtValue qudt:numericValue ?draught .
                ?breadthValue qudt:numericValue ?breadth .
                ?resultValue qudt:numericValue ?reported .

                FILTER (?breadth != 0)
                BIND((((?length * ?draught) / (?breadth * ?breadth)) *
                      ((?length * ?draught) / (?breadth * ?breadth)) *
                      ((?length * ?draught) / (?breadth * ?breadth))) AS ?raw)
                BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                BIND((1e-6 * ABS(?expected) + 1e-9) AS ?tolerance)
                FILTER (ABS(?reported - ?expected) > ?tolerance)
            }
        """
    ] .

gen:TRF027NonApplicableClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

gen:TRF027LaterConstructionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "2003-09-01"^^xsd:date
    ] .

gen:ShipLengthShape
    a sh:PropertyShape ;
    sh:path nltl:shipLength ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue unit:M ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

gen:IceClassDraughtShape
    a sh:PropertyShape ;
    sh:path nltl:iceClassDraught ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue unit:M ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

gen:ShipBreadthShape
    a sh:PropertyShape ;
    sh:path nltl:shipBreadth ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue unit:M ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

gen:ClampedHullGeometryShape
    a sh:PropertyShape ;
    sh:path nltl:clampedHullGeometryTerm ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue unit:UNITLESS ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

gen:C3Shape
    a sh:PropertyShape ;
    sh:path nltl:coefficientC3 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive "460"^^xsd:decimal ;
            sh:maxInclusive "460"^^xsd:decimal
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

