@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF028Shape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT DISTINCT $this
            WHERE {
                $this a nltl:ship .
                FILTER (
                    EXISTS {
                        $this nltl:hasEvidence ?evidence .
                        ?evidence a nltl:alternativeCalculationEvidence .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasEvidence ?evidence .
                        ?evidence a nltl:modelTestEvidence .
                    }
                    ||
                    EXISTS {
                        $this nltl:engineOutputCoefficientKe ?result .
                    }
                    ||
                    EXISTS {
                        $this nltl:brashIceChannelResistanceRch ?result .
                    }
                )
            }
        """ ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:class nltl:alternativeCalculationEvidence ;
                sh:minCount 1 ;
                sh:message "An approved alternative calculation method requires alternative calculation evidence."
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:class nltl:modelTestEvidence ;
                sh:minCount 1 ;
                sh:message "An approved model-test method requires model-test evidence."
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/N> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The approval status must be recorded as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateDraft
            nltl:evidenceStateExpired
            nltl:evidenceStateRejected
            nltl:evidenceStateRevoked
            nltl:evidenceStateSubmitted
            nltl:evidenceStateUnderReview
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The approval or revocation status must be one of the permitted evidence states."
    ] ;
    sh:sparql [
        sh:message "An approved ship must have approvalRevocationStatus evidenceStateApproved." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:approvalStatus true ;
                      nltl:approvalRevocationStatus ?state .
                FILTER (?state != nltl:evidenceStateApproved)
            }
        """
    ] .
