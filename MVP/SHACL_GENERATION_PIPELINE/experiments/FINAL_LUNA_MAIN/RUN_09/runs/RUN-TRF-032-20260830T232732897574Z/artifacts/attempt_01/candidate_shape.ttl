@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ScantlingQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF032Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:regulationRequiredScantling ;
                sh:node gs:ScantlingQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:classificationSocietyRequiredScantling ;
                sh:node gs:ScantlingQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedDesignScantling ;
                sh:node gs:ScantlingQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "When the ship is not ice strengthened and the regulation-required scantling is less than the classification-society-required scantling, the selected design scantling must equal the classification-society-required scantling." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceStrengtheningStatus false ;
                              nltl:regulationRequiredScantling ?regulationQuantity ;
                              nltl:classificationSocietyRequiredScantling ?classificationQuantity ;
                              nltl:selectedDesignScantling ?selectedQuantity .
                        ?regulationQuantity qudt:numericValue ?regulationValue .
                        ?classificationQuantity qudt:numericValue ?classificationValue .
                        ?selectedQuantity qudt:numericValue ?selectedValue .
                        FILTER (
                            ?regulationValue < ?classificationValue &&
                            ?selectedValue != ?classificationValue
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:regulationRequiredScantling ;
                sh:node gs:ScantlingQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:classificationSocietyRequiredScantling ;
                sh:node gs:ScantlingQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For a ship that is not ice strengthened, the regulation-required scantling must not be less than the classification-society-required scantling unless the classification-society-required scantling is selected." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceStrengtheningStatus false ;
                              nltl:regulationRequiredScantling ?regulationQuantity ;
                              nltl:classificationSocietyRequiredScantling ?classificationQuantity .
                        ?regulationQuantity qudt:numericValue ?regulationValue .
                        ?classificationQuantity qudt:numericValue ?classificationValue .
                        FILTER (?regulationValue < ?classificationValue)
                    }
                """
            ]
        ]
    ) .
