@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

<urn:nltl:generated-shape:TRF-034-effective-member-cross-section>
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The effective member cross section must provide one section modulus quantity in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The effective member cross section must provide one shear area quantity in square metres."
    ] ;
    sh:property [
        sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasEffectiveMemberCrossSection ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:hullStructure ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path [
                            sh:inversePath nltl:hasEffectiveMemberCrossSection
                        ] ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
                                sh:class nltl:evidenceArtifact ;
                                sh:minCount 1
                            ]
                        ]
                    ]
                ]
            )
        ] ;
        sh:message "The effective member cross section must be linked to a hull structure whose normal-to-plating status is established; non-normal members require classification-society section-property calculation evidence."
    ] .
