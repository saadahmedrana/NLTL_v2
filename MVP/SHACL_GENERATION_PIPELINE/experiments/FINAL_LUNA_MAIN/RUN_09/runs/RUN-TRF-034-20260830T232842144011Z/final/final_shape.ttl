@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-034-EffectiveMemberCrossSection>
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
            ]
        ] ;
        sh:message "The effective member cross section must provide a section modulus in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M2>
            ]
        ] ;
        sh:message "The effective member cross section must provide a shear area in square metres."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasEffectiveMemberCrossSection
        ] ;
        sh:class nltl:hullStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path [
                            sh:inversePath nltl:hasEffectiveMemberCrossSection
                        ] ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
                                sh:class nltl:evidenceArtifact ;
                                sh:minCount 1
                            ]
                        ]
                    ]
                ]
            )
        ] ;
        sh:message "The effective member cross section must link to a hull structure with a declared plating orientation; a non-normal member requires classification-society section-property calculation evidence."
    ] .
