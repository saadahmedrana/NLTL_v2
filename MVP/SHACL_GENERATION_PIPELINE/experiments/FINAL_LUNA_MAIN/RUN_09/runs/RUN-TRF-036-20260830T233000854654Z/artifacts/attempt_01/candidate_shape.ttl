@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF036_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassDesignParameterSet ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF036_IceClassDesignParameterSetShape> ;
        sh:message "The ship shall provide an ice class design parameter set." ;
    ] .

<urn:nltl:generated-shape:TRF036_IceClassDesignParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or (
            [
                sh:hasValue nltl:iceClassIaSuper ;
                sh:property [
                    sh:path nltl:levelIceThickness ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:maxInclusive "1.0"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ] ;
                sh:property [
                    sh:path nltl:designIceLoadHeight ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:minInclusive "0.35"^^xsd:decimal ;
                            sh:maxInclusive "0.35"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
            ]
            [
                sh:hasValue nltl:iceClassIa ;
                sh:property [
                    sh:path nltl:levelIceThickness ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:maxInclusive "0.8"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ] ;
                sh:property [
                    sh:path nltl:designIceLoadHeight ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:minInclusive "0.30"^^xsd:decimal ;
                            sh:maxInclusive "0.30"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
            ]
            [
                sh:hasValue nltl:iceClassIb ;
                sh:property [
                    sh:path nltl:levelIceThickness ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:maxInclusive "0.6"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ] ;
                sh:property [
                    sh:path nltl:designIceLoadHeight ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:minInclusive "0.25"^^xsd:decimal ;
                            sh:maxInclusive "0.25"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
            ]
            [
                sh:hasValue nltl:iceClassIc ;
                sh:property [
                    sh:path nltl:levelIceThickness ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:maxInclusive "0.4"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ] ;
                sh:property [
                    sh:path nltl:designIceLoadHeight ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:class qudt:QuantityValue ;
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:minInclusive "0.22"^^xsd:decimal ;
                            sh:maxInclusive "0.22"^^xsd:decimal
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:hasValue unit:M ;
                            sh:minCount 1 ;
                            sh:maxCount 1
                        ]
                    ]
                ]
            ]
        ) ;
        sh:message "The ice class, permitted level ice thickness, and design ice load height shall conform to Table 4-1." ;
    ] .
