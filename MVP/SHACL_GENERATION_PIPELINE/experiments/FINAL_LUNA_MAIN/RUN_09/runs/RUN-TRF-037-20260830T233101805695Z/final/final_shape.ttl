@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF037ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientA ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientK ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientB ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClassFactorCp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:nominalIcePressureP0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputFactorCd ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:directAnalysisCase ;
            sh:property [
                sh:path nltl:iceLoadAreaFactorCa ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "shipSizeEngineOutputFactorCd must equal the capped value of (a*k+b)/1000 within numerical tolerance" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputCoefficientA ?aNode ;
                      nltl:shipSizeEngineOutputCoefficientK ?kNode ;
                      nltl:shipSizeEngineOutputCoefficientB ?bNode ;
                      nltl:shipSizeEngineOutputFactorCd ?actualNode .
                ?aNode <http://qudt.org/schema/qudt/numericValue> ?a .
                ?kNode <http://qudt.org/schema/qudt/numericValue> ?k .
                ?bNode <http://qudt.org/schema/qudt/numericValue> ?b .
                ?actualNode <http://qudt.org/schema/qudt/numericValue> ?actual .
                BIND (((?a * ?k) + ?b) / 1000.0 AS ?rawCd)
                BIND (IF(?rawCd > 1.0, 1.0, ?rawCd) AS ?expected)
                BIND (?actual - ?expected AS ?delta)
                BIND (IF(?delta < 0, -?delta, ?delta) AS ?error)
                BIND (IF(?expected < 0, -?expected, ?expected) AS ?expectedMagnitude)
                BIND (IF(?expectedMagnitude > 0.000000001, ?expectedMagnitude, 0.000000001) AS ?scale)
                FILTER (?error > (0.000001 * ?scale))
            }
        """
    ] ;
    sh:sparql [
        sh:message "icePressure must equal shipSizeEngineOutputFactorCd multiplied by iceClassFactorCp, iceLoadAreaFactorCa, and nominalIcePressureP0 within numerical tolerance" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputFactorCd ?cdNode ;
                      nltl:iceClassFactorCp ?cpNode ;
                      nltl:nominalIcePressureP0 ?p0Node ;
                      nltl:icePressure ?actualNode ;
                      nltl:hasDirectAnalysisCase ?case .
                ?case nltl:iceLoadAreaFactorCa ?caNode .
                ?cdNode <http://qudt.org/schema/qudt/numericValue> ?cd .
                ?cpNode <http://qudt.org/schema/qudt/numericValue> ?cp .
                ?caNode <http://qudt.org/schema/qudt/numericValue> ?ca .
                ?p0Node <http://qudt.org/schema/qudt/numericValue> ?p0 .
                ?actualNode <http://qudt.org/schema/qudt/numericValue> ?actual .
                BIND (?cd * ?cp * ?ca * ?p0 AS ?expected)
                BIND (?actual - ?expected AS ?delta)
                BIND (IF(?delta < 0, -?delta, ?delta) AS ?error)
                BIND (IF(?expected < 0, -?expected, ?expected) AS ?expectedMagnitude)
                BIND (IF(?expectedMagnitude > 0.000000001, ?expectedMagnitude, 0.000000001) AS ?scale)
                FILTER (?error > (0.000001 * ?scale))
            }
        """
    ] .
