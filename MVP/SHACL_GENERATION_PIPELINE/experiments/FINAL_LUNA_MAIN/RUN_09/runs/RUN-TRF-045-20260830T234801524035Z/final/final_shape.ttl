@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_045_FrameOrdinaryScantlingsShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:datatype xsd:boolean ;
        sh:message "ordinaryFrameScantlingsUsed must be a boolean when stated."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed ?used .
                FILTER (?used = true)

                FILTER NOT EXISTS {
                    $this nltl:frameSpanWithinIceStrengtheningZone ?withinNode .
                    ?withinNode qudt:numericValue ?withinValue ;
                                qudt:unit unit:M .

                    $this nltl:span ?spanNode .
                    ?spanNode qudt:numericValue ?spanValue ;
                              qudt:unit unit:M .

                    FILTER (datatype(?withinValue) = xsd:decimal)
                    FILTER (datatype(?spanValue) = xsd:decimal)
                    FILTER (?withinValue < ("0.15"^^xsd:decimal * ?spanValue))
                }
            }
        """
    ] .
