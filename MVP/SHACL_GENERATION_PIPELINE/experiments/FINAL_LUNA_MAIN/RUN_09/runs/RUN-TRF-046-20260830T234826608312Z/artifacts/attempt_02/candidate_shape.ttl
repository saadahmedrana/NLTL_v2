@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-046-UpperEndAttachmentShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class nltl:deckStructure ]
            [ sh:class nltl:tankBoundaryPlating ]
            [ sh:class nltl:iceStringer ]
        ) ;
        sh:message "The upper end must be attached to a deck, tank-boundary plating, or ice stringer."
    ] .

<urn:nltl:generated-shape:TRF-046-MainFrameCaseShape> a sh:NodeShape ;
    sh:class nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:class nltl:frameStrengthenedPart ;
        sh:message "A main frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-046-UpperEndAttachmentShape> ;
        sh:message "The upper end of the strengthened main-frame part must be attached to an eligible supporting structure."
    ] .

<urn:nltl:generated-shape:TRF-046-IntermediateIceFrameCaseShape> a sh:NodeShape ;
    sh:class nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:class nltl:frameStrengthenedPart ;
        sh:message "An intermediate ice frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-046-UpperEndAttachmentShape> ;
        sh:message "The upper end of the strengthened intermediate ice frame must be attached to an eligible supporting structure."
    ] .

<urn:nltl:generated-shape:TRF-046-FrameShape> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        <urn:nltl:generated-shape:TRF-046-MainFrameCaseShape>
        <urn:nltl:generated-shape:TRF-046-IntermediateIceFrameCaseShape>
    ) ;
    sh:message "The rule applies to strengthened main frames and intermediate ice frames."
    .
