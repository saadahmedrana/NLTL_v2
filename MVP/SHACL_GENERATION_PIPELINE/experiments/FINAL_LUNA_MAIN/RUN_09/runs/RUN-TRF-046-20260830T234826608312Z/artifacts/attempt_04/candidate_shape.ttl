@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:UpperEndEligibleAttachmentProperty
    sh:path ( nltl:hasUpperEnd nltl:hasAttachedSupportingStructure ) ;
    sh:minCount 1 ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:iceStringer ]
    ) ;
    sh:message "The upper end must be attached to a deck, tank-boundary plating, or ice stringer." .

nltlgen:MainFrameUpperEndShape
    sh:class nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:class nltl:frameStrengthenedPart ;
        sh:message "A main frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:class nltl:frameEnd ;
        sh:message "A main frame must identify its upper end."
    ] ;
    sh:property nltlgen:UpperEndEligibleAttachmentProperty .

nltlgen:IntermediateIceFrameUpperEndShape
    sh:class nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:class nltl:frameStrengthenedPart ;
        sh:message "An intermediate ice frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:class nltl:frameEnd ;
        sh:message "An intermediate ice frame must identify its upper end."
    ] ;
    sh:property nltlgen:UpperEndEligibleAttachmentProperty .

nltlgen:TRF046Shape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        nltlgen:MainFrameUpperEndShape
        nltlgen:IntermediateIceFrameUpperEndShape
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When a main or intermediate ice frame terminates above an eligible supporting structure at or above the ice-belt upper limit, its strengthened part must record ordinary frame scantlings." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this a nltl:mainFrame .
                }
                UNION
                {
                    $this a nltl:intermediateIceFrame .
                }
                $this nltl:hasUpperEnd ?end .
                ?end nltl:hasTerminationAboveSupportingStructure ?support .
                {
                    ?support a nltl:deckStructure .
                }
                UNION
                {
                    ?support a nltl:tankBoundaryPlating .
                }
                UNION
                {
                    ?support a nltl:iceStringer .
                }
                ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit "true"^^xsd:boolean .
                $this nltl:hasStrengthenedPart ?part .
                FILTER NOT EXISTS {
                    ?part nltl:ordinaryFrameScantlingsUsed "true"^^xsd:boolean .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An intermediate ice frame using a horizontal member with main-frame scantlings must connect that member to an adjacent main frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:intermediateIceFrame .
                $this nltl:hasUpperEnd ?end .
                ?end nltl:hasTerminationAboveSupportingStructure ?support .
                {
                    ?support a nltl:deckStructure .
                }
                UNION
                {
                    ?support a nltl:tankBoundaryPlating .
                }
                UNION
                {
                    ?support a nltl:iceStringer .
                }
                ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit "true"^^xsd:boolean .
                ?end nltl:hasHorizontalConnectionMember ?member .
                ?member nltl:sameScantlingsAsMainFrame "true"^^xsd:boolean .
                FILTER NOT EXISTS {
                    ?member nltl:connectsToAdjacentMainFrame ?main .
                    ?main a nltl:mainFrame .
                }
            }
        """
    ] .
