@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF048DecimalQuantity a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048LengthQuantity a sh:NodeShape ;
    sh:node gen:TRF048DecimalQuantity ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048PressureQuantity a sh:NodeShape ;
    sh:node gen:TRF048DecimalQuantity ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048AreaQuantity a sh:NodeShape ;
    sh:node gen:TRF048DecimalQuantity ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048DimensionlessQuantity a sh:NodeShape ;
    sh:node gen:TRF048DecimalQuantity ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048SectionModulusQuantity a sh:NodeShape ;
    sh:node gen:TRF048DecimalQuantity ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048Shape a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:class nltl:frameBoundaryConditionTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A frame boundary condition type is required."
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The significantly different boundary conditions selector is required."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:TRF048PressureQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:TRF048LengthQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:TRF048LengthQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:TRF048LengthQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gen:TRF048DimensionlessQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:TRF048PressureQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node gen:TRF048DimensionlessQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:TRF048SectionModulusQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:TRF048AreaQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For significantly different boundary conditions, frameMomentFactorM must be smaller than 13.3; otherwise a continuous beam with brackets requires frameMomentFactorM equal to 13.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?boundary ;
                      nltl:significantlyDifferentBoundaryConditions ?different ;
                      nltl:frameMomentFactorM ?factorNode .
                ?factorNode qudt:numericValue ?factor .
                FILTER (
                    (?different = true && ! (?factor < 13.3)) ||
                    (?boundary = nltl:continuousBeamWithBracketsFrameCondition &&
                     ?different = false &&
                     ?factor != 13.3)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "f4, sectionModulus, and requiredShearArea must match their declared frame calculation formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:spacing ?spacingNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?p .
                ?heightNode qudt:numericValue ?h .
                ?spacingNode qudt:numericValue ?s .
                ?spanNode qudt:numericValue ?l .
                ?momentNode qudt:numericValue ?m .
                ?yieldNode qudt:numericValue ?sigma .
                ?f4Node qudt:numericValue ?f4 .
                ?zNode qudt:numericValue ?z .
                ?areaNode qudt:numericValue ?area .

                BIND (1 - (0.2 * ?h / ?s) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l / (4 * ?m * ?sigma)) * 1000000 AS ?expectedZ)
                BIND (((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l) / (2 * ?sigma)) * 10000 AS ?expectedArea)

                FILTER (
                    ABS(?f4 - ?expectedF4) > (ABS(?expectedF4) * 0.000001 + 0.000000001) ||
                    ABS(?z - ?expectedZ) > (ABS(?expectedZ) * 0.000001 + 0.000000001) ||
                    ABS(?area - ?expectedArea) > (ABS(?expectedArea) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .
