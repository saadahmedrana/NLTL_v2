@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-049-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:node <urn:nltl:generated-shape:TRF-049-FrameAttachmentShape>
            ] ;
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:webPlateConnectionSideCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 2 ;
                        sh:maxInclusive 2 ;
                        sh:message "A frame running through the supporting structure must have both web-plate sides connected."
                    ]
                ]
            ) ;
            sh:or (
                [
                    sh:class nltl:longitudinalFrame ;
                    sh:property [
                        sh:path nltl:hasSupportingWebFrame ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
                    ] ;
                    sh:property [
                        sh:path nltl:hasSupportingBulkhead ;
                        sh:minCount 1 ;
                        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
                    ]
                ]
                [
                    sh:class nltl:transverseFrame ;
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue false
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:hasFrameAttachment ;
                                sh:node [
                                    sh:or (
                                        [
                                            sh:property [
                                                sh:path nltl:hasConnectionBracket ;
                                                sh:minCount 1
                                            ]
                                        ]
                                        [
                                            sh:property [
                                                sh:path nltl:similarAttachmentConstructionPresent ;
                                                sh:datatype xsd:boolean ;
                                                sh:minCount 1 ;
                                                sh:maxCount 1 ;
                                                sh:hasValue true
                                            ]
                                        ]
                                    )
                                ]
                            ]
                        ]
                    )
                ]
                [
                    sh:class nltl:frame
                ]
            )
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A bracket must be at least as thick as the frame web, and the frame web thickness must be supplied when a bracket is installed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?bracketThickness qudt:numericValue ?bracketValue .
                FILTER NOT EXISTS {
                    $this nltl:frameWebThickness ?frameThickness .
                    ?frameThickness qudt:numericValue ?frameValue .
                    FILTER (xsd:decimal(?bracketValue) >= xsd:decimal(?frameValue))
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-049-FrameAttachmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each frame attachment in the ice-strengthened area must be effectively attached."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node <urn:nltl:generated-shape:TRF-049-ConnectionBracketShape>
    ] ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-049-ConnectionBracketShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:node <urn:nltl:generated-shape:TRF-049-BracketThicknessShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened against buckling."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket must have buckling stiffening."
    ] .

<urn:nltl:generated-shape:TRF-049-BracketThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-049-FrameAttachmentShape>
    ] .
