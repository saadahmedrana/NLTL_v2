@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-049-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:class nltl:frameAttachmentRecord ;
        sh:minCount 1 ;
        sh:message "Each supporting structure must identify its frame attachment."
    ] .

<urn:nltl:generated-shape:TRF-049-BracketShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:node <urn:nltl:generated-shape:TRF-049-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An installed bracket must specify its thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket must be stiffened against buckling."
    ] .

<urn:nltl:generated-shape:TRF-049-AttachmentShape>
    a sh:NodeShape ;
    sh:class nltl:frameAttachmentRecord ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape> ;
        sh:minCount 1 ;
        sh:message "Each frame attachment must identify its supporting structure."
    ] .

<urn:nltl:generated-shape:TRF-049-LongitudinalAttachmentShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-049-AttachmentShape> ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node <urn:nltl:generated-shape:TRF-049-BracketShape> ;
        sh:minCount 1 ;
        sh:message "A longitudinal frame must be attached to its supporting structure by a bracket."
    ] .

<urn:nltl:generated-shape:TRF-049-TerminatingAttachmentShape>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-049-AttachmentShape> ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:node <urn:nltl:generated-shape:TRF-049-BracketShape> ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "A transverse frame terminating at a deck or stringer must have a bracket or similar construction."
.

<urn:nltl:generated-shape:TRF-049-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:effectiveAttachmentConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Every frame in the ice-strengthened area must be effectively attached."
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:node <urn:nltl:generated-shape:TRF-049-QuantityValueShape> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The frame web thickness must be provided in millimetres."
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:node <urn:nltl:generated-shape:TRF-049-AttachmentShape> ;
                sh:minCount 1 ;
                sh:message "A frame in the ice-strengthened area must identify its frame attachments."
            ] ;
            sh:or (
                [
                    sh:class nltl:longitudinalFrame ;
                    sh:property [
                        sh:path nltl:hasSupportingWebFrame ;
                        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape> ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:hasSupportingBulkhead ;
                        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape> ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:hasFrameAttachment ;
                        sh:node <urn:nltl:generated-shape:TRF-049-LongitudinalAttachmentShape> ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:class nltl:transverseFrame ;
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:class nltl:transverseFrame ;
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasFrameAttachment ;
                        sh:node <urn:nltl:generated-shape:TRF-049-TerminatingAttachmentShape> ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:TRF-049-ThicknessComparison>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each installed bracket must be at least as thick as the web plate of its linked frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                $this nltl:frameWebThickness ?frameThickness .
                ?frameThickness qudt:numericValue ?frameValue ;
                                qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?bracketThickness qudt:numericValue ?bracketValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (
                    xsd:decimal(?bracketValue) >=
                    xsd:decimal(?frameValue)
                )
            }
        """
    ] .
