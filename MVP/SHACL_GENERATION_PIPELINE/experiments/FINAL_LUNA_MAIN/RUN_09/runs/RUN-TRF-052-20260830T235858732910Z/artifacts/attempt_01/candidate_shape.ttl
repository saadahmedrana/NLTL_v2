@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_052_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:datatype nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:equivalentSupportStatusByDirectCalculation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameAsymmetrical ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:frameWebAngleToShell ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/DEG>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:frameSpan ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:antitrippingSupportSpacing ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
                    ]
                ]
            ] ;
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:frameAsymmetrical ?asym ;
                              nltl:frameWebAngleToShell ?angleNode ;
                              nltl:frameSpan ?spanNode ;
                              nltl:iceClass ?iceClass .

                        ?angleNode qudt:numericValue ?angle .
                        ?spanNode qudt:numericValue ?span .

                        FILTER (
                            (
                                (?asym = true || ?angle < 90)
                                &&
                                !EXISTS {
                                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                                    ?spacingNode qudt:numericValue ?spacing .
                                    FILTER (?spacing <= 1300)
                                }
                            )
                            ||
                            (
                                ?span > 4
                                &&
                                (
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                                )
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIaSuper
                                &&
                                (
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:sternRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:otherIceStrengthenedAreaValue }
                                )
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                ?iceClass = nltl:iceClassIa
                                &&
                                (
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:bowRegion }
                                    ||
                                    !EXISTS { $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion }
                                )
                            )
                            ||
                            (
                                ?span <= 4
                                &&
                                (
                                    ?iceClass = nltl:iceClassIb
                                    ||
                                    ?iceClass = nltl:iceClassIc
                                )
                                &&
                                !EXISTS {
                                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                                }
                            )
                        )
                    }
                """ ;
                sh:message "The frame does not satisfy the applicable antitripping support spacing or regional coverage requirement."
            ]
        ]
    ) .
