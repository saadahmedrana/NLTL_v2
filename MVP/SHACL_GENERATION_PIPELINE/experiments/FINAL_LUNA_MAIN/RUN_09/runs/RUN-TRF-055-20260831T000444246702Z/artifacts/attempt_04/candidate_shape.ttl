@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityForcePerLength a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:QuantityLengthM a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:QuantityVolumeCm3 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:QuantityAreaCm2 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ScantlingApprovalStatusShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceState ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateDraft
            nltl:evidenceStateExpired
            nltl:evidenceStateRejected
            nltl:evidenceStateRevoked
            nltl:evidenceStateSubmitted
            nltl:evidenceStateUnderReview
        )
    ] .

gen:ApplicableSectionAndShearShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:node gen:QuantityVolumeCm3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:node gen:QuantityVolumeCm3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:node gen:QuantityAreaCm2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:QuantityAreaCm2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Actual section modulus and shear area shall meet their required values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZNode .
                ?actualZNode qudt:numericValue ?actualZ .
                $this nltl:requiredSectionModulus ?requiredZNode .
                ?requiredZNode qudt:numericValue ?requiredZ .
                $this nltl:actualShearArea ?actualANode .
                ?actualANode qudt:numericValue ?actualA .
                $this nltl:requiredShearArea ?requiredANode .
                ?requiredANode qudt:numericValue ?requiredA .
                FILTER (?actualZ < ?requiredZ || ?actualA < ?requiredA)
            }
        """
    ] .

gen:PermittedLineLoadAtLeast015Shape a sh:NodeShape ;
    sh:property [
        sh:path nltl:permittedReducedLineLoad ;
        sh:node gen:QuantityForcePerLength ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The permitted line load shall be at least 0.15 kN/m in the non-reduced alternative." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:permittedReducedLineLoad ?loadNode .
                ?loadNode qudt:numericValue ?load .
                FILTER (?load < "0.15"^^xsd:decimal)
            }
        """
    ] .

gen:ApprovedReducedLineLoadShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:permittedReducedLineLoad ;
        sh:node gen:QuantityForcePerLength ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:sparql [
        sh:message "An approved reduced line load shall be at least 0.10 and less than 0.15." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:permittedReducedLineLoad ?loadNode .
                ?loadNode qudt:numericValue ?load .
                FILTER (?load < "0.10"^^xsd:decimal || ?load >= "0.15"^^xsd:decimal)
            }
        """
    ] .

gen:ApplicableNarrowDeckStripShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:node gen:QuantityVolumeCm3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:node gen:QuantityVolumeCm3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:node gen:QuantityAreaCm2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:QuantityAreaCm2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Actual section modulus and shear area shall meet their required values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZNode .
                ?actualZNode qudt:numericValue ?actualZ .
                $this nltl:requiredSectionModulus ?requiredZNode .
                ?requiredZNode qudt:numericValue ?requiredZ .
                $this nltl:actualShearArea ?actualANode .
                ?actualANode qudt:numericValue ?actualA .
                $this nltl:requiredShearArea ?requiredANode .
                ?requiredANode qudt:numericValue ?requiredA .
                FILTER (?actualZ < ?requiredZ || ?actualA < ?requiredA)
            }
        """
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:node gen:PermittedLineLoadAtLeast015Shape
        ]
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:node gen:PermittedLineLoadAtLeast015Shape
        ]
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:node gen:ApprovedReducedLineLoadShape
        ]
    ) .

gen:TRF055NarrowDeckStripShape a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:node gen:QuantityForcePerLength ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hatchOpeningLength ;
        sh:node gen:QuantityLengthM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:QuantityVolumeCm3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:node gen:QuantityLengthM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ScantlingApprovalStatusShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:node gen:ApplicableNarrowDeckStripShape
        ]
    ) .
