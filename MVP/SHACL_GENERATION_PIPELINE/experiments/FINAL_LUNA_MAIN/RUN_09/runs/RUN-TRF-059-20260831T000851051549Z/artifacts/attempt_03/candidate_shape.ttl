@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF059WebFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ] ;
        sh:message "Maximum calculated shear force must be supplied in kN."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ] ;
        sh:message "Yield strength must be supplied in MPa."
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "Free flange to web area ratio must be supplied as a dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "Web frame shear factor alpha must be supplied as a dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM2
            ]
        ] ;
        sh:message "Required shear area must be supplied in cm2."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0"^^xsd:decimal ;
                        sh:maxInclusive "0"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.5"^^xsd:decimal ;
                        sh:maxInclusive "1.5"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0.2"^^xsd:decimal ;
                        sh:maxInclusive "0.2"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.23"^^xsd:decimal ;
                        sh:maxInclusive "1.23"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0.4"^^xsd:decimal ;
                        sh:maxInclusive "0.4"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.16"^^xsd:decimal ;
                        sh:maxInclusive "1.16"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0.6"^^xsd:decimal ;
                        sh:maxInclusive "0.6"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.11"^^xsd:decimal ;
                        sh:maxInclusive "1.11"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0.8"^^xsd:decimal ;
                        sh:maxInclusive "0.8"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.09"^^xsd:decimal ;
                        sh:maxInclusive "1.09"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.0"^^xsd:decimal ;
                        sh:maxInclusive "1.0"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.07"^^xsd:decimal ;
                        sh:maxInclusive "1.07"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.2"^^xsd:decimal ;
                        sh:maxInclusive "1.2"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.06"^^xsd:decimal ;
                        sh:maxInclusive "1.06"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.4"^^xsd:decimal ;
                        sh:maxInclusive "1.4"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.05"^^xsd:decimal ;
                        sh:maxInclusive "1.05"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.6"^^xsd:decimal ;
                        sh:maxInclusive "1.6"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.05"^^xsd:decimal ;
                        sh:maxInclusive "1.05"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.8"^^xsd:decimal ;
                        sh:maxInclusive "1.8"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.04"^^xsd:decimal ;
                        sh:maxInclusive "1.04"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "2.0"^^xsd:decimal ;
                        sh:maxInclusive "2.0"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webFrameShearFactorAlpha ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "1.04"^^xsd:decimal ;
                        sh:maxInclusive "1.04"^^xsd:decimal
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "requiredShearArea must equal sqrt(3) times alpha times 1.1 times maximumCalculatedShearForce divided by yieldStrength, scaled by 10^4, within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qNode ;
                      nltl:webFrameShearFactorAlpha ?aNode ;
                      nltl:yieldStrength ?sNode ;
                      nltl:requiredShearArea ?rNode .
                ?qNode qudt:numericValue ?q .
                ?aNode qudt:numericValue ?alpha .
                ?sNode qudt:numericValue ?sigma .
                ?rNode qudt:numericValue ?reported .
                BIND((1.7320508075688772 * ?alpha * 1.1 * ?q / ?sigma * 10000) AS ?expected)
                BIND(IF(?expected >= 0, ?expected, 0 - ?expected) AS ?magnitude)
                BIND((0.000001 * ?magnitude + 0.000000001) AS ?tolerance)
                FILTER (
                    ?reported < (?expected - ?tolerance)
                    || ?reported > (?expected + ?tolerance)
                )
            }
        """
    ] .
