@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF063_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 2 ;
                sh:maxInclusive 3
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
                sh:class nltl:sidePropellerStrengtheningEnvelope ;
                sh:node gs:TRF063_EnvelopeShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxInclusive 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 4
            ]
        ]
    ) ;
    sh:message "A ship must provide a valid propeller-count applicability branch; twin and triple screw ships must provide the specified side-propeller strengthening envelope." .

gs:TRF063_EnvelopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:strengtheningEnvelopeBoundary ;
        sh:class nltl:tankTop ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:strengtheningForwardExtent ;
        sh:node gs:TRF063_LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:strengtheningAftExtent ;
        sh:node gs:TRF063_LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:message "Each side-propeller strengthening envelope must identify the tank top and provide forward and aft extents of at least 1.5 metres." .

gs:TRF063_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "1.5"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
