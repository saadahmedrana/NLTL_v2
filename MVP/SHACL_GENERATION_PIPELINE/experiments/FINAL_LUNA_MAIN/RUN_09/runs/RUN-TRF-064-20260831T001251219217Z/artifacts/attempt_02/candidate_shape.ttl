@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:enclosedByPlatedBossing ;
                sh:class nltl:platedBossingStructure ;
                sh:minCount 1 ;
                sh:message "Each existing side propeller shafting assembly shall be enclosed by a plated bossing."
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:enclosedByPlatedBossing ;
                sh:class nltl:platedBossingStructure ;
                sh:minCount 1 ;
                sh:message "Each existing stern tube shall be enclosed by a plated bossing."
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:class nltl:detachedStrutStructure ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:hasStrutDesignEvidence ;
                sh:class nltl:strutDesignEvidence ;
                sh:minCount 1 ;
                sh:message "Each detached strut shall have design evidence."
            ] ;
            sh:property [
                sh:path nltl:hasStrutHullAttachmentEvidence ;
                sh:class nltl:strutHullAttachmentEvidence ;
                sh:minCount 1 ;
                sh:message "Each detached strut shall have hull-attachment evidence."
            ] ;
            sh:property [
                sh:path nltl:hasStrutStrengthEvidence ;
                sh:class nltl:strutStrengthEvidence ;
                sh:minCount 1 ;
                sh:message "Each detached strut shall have strength evidence."
            ]
        ]
    ] .
