@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-074-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one permitted ice class."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:ballastConditionPropellerTopDepth ;
                sh:node <urn:nltl:generated-shape:TRF-074-LengthQuantityShape> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ballast-condition propeller top depth is required for ice classes IB and IC."
            ] ;
            sh:property [
                sh:path nltl:requiredPropellerSubmersionDepthHi ;
                sh:node <urn:nltl:generated-shape:TRF-074-LengthQuantityShape> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Required propeller submersion depth hi is required for ice classes IB and IC."
            ] ;
            sh:or (
                [
                    sh:sparql [
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                                ?depthQuantity qudt:numericValue ?depthValue .
                                $this nltl:requiredPropellerSubmersionDepthHi ?requiredQuantity .
                                ?requiredQuantity qudt:numericValue ?requiredValue .
                                FILTER (?depthValue >= ?requiredValue)
                            }
                        """
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:propulsionSystemDesignedForIceClass ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:iceClassValue ;
                        sh:hasValue nltl:iceClassIa ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ) ;
            sh:message "For ice classes IB or IC, the propulsion system must be designed for ice class IA when the ballast-condition propeller depth is less than hi."
        ]
    ) .

<urn:nltl:generated-shape:TRF-074-LengthQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller depth quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller depth quantity must use metres."
    ] .
