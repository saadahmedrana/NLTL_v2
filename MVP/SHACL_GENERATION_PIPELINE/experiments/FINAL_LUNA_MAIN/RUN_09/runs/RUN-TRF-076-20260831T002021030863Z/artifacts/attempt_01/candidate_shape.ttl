@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PropellerBladeLoadCaseNodeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer
    ] .

gen:TRF076Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase ;
        sh:node gen:PropellerBladeLoadCaseNodeShape
    ] ;
    sh:or (
        gen:TRF076CPBranch
        gen:TRF076FPBranch
    ) .

gen:TRF076CPBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "CP"^^xsd:string
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "CP propellers must cover propeller blade load cases 1 through 4." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case1 .
                        ?case1 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number1 .
                        FILTER (datatype(?number1) = xsd:integer && ?number1 = 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case2 .
                        ?case2 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number2 .
                        FILTER (datatype(?number2) = xsd:integer && ?number2 = 2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case3 .
                        ?case3 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number3 .
                        FILTER (datatype(?number3) = xsd:integer && ?number3 = 3)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case4 .
                        ?case4 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number4 .
                        FILTER (datatype(?number4) = xsd:integer && ?number4 = 4)
                    }
                )
            }
        """
    ] .

gen:TRF076FPBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "FP"^^xsd:string
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "FP reversing propellers must cover propeller blade load cases 1 through 5." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case1 .
                        ?case1 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number1 .
                        FILTER (datatype(?number1) = xsd:integer && ?number1 = 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case2 .
                        ?case2 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number2 .
                        FILTER (datatype(?number2) = xsd:integer && ?number2 = 2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case3 .
                        ?case3 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number3 .
                        FILTER (datatype(?number3) = xsd:integer && ?number3 = 3)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case4 .
                        ?case4 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number4 .
                        FILTER (datatype(?number4) = xsd:integer && ?number4 = 4)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case5 .
                        ?case5 a nltl:propellerBladeLoadCase ;
                               nltl:propellerBladeLoadCaseNumber ?number5 .
                        FILTER (datatype(?number5) = xsd:integer && ?number5 = 5)
                    }
                )
            }
        """
    ] .
