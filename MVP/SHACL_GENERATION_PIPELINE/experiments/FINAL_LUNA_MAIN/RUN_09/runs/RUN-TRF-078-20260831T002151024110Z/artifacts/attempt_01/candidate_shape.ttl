@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:Trf078ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gen:Trf078LookupCaseShape ;
        sh:qualifiedValueShape [
            sh:node gen:Trf078Table6CaseShape
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must have a Table 6-6 lookup case."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:node gen:Trf078Table7CaseShape
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must have a Table 6-7 lookup case."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gen:Trf078UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide exactly one unitless ice-load coefficient k2."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gen:Trf078UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide exactly one unitless ice-load coefficient k3."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gen:Trf078UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide exactly one unitless propeller blade load-spectrum count factor."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide exactly one ice-load cycle count."
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within a relative tolerance of 1e-6 and an absolute tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?table6Case ;
                      nltl:hasTableLookupCase ?table7Case ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?reported .

                ?table6Case nltl:tableReference nltl:traficomTable6Dash6 ;
                            nltl:selectedIceClassCycleCount ?nclassNode .
                ?table7Case nltl:tableReference nltl:traficomTable6Dash7 ;
                            nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node qudt:numericValue ?k1 .
                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nclassNode qudt:numericValue ?nclass .
                ?nnNode qudt:numericValue ?nn .

                BIND (
                    xsd:decimal(?k1) *
                    xsd:decimal(?k2) *
                    xsd:decimal(?k3) *
                    xsd:decimal(?nclass) *
                    xsd:decimal(?nn)
                    AS ?expected
                )

                FILTER (
                    ABS(xsd:decimal(?reported) - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000001)
                )
            }
        """
    ] .

gen:Trf078LookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each table lookup case must have exactly one table reference."
    ] ;
    sh:or (
        [
            sh:node gen:Trf078Table6CaseShape
        ]
        [
            sh:node gen:Trf078Table7CaseShape
        ]
    ) .

gen:Trf078Table6CaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-6 lookup case must use one permitted ice-class selection key."
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node gen:Trf078UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-6 lookup case must provide exactly one selected ice-class cycle count."
    ] .

gen:Trf078Table7CaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-7 lookup case must provide exactly one propeller-location selection key."
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node gen:Trf078UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-7 lookup case must provide exactly one selected propeller-location factor."
    ] .

gen:Trf078UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
