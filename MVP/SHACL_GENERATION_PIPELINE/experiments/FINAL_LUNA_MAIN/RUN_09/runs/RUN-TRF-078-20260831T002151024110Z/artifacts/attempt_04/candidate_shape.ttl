@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF078_Table6CaseShape>
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF078_Table7CaseShape>
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF078_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:nodeKind sh:IRI ;
        sh:or (
            <urn:nltl:generated-shape:TRF078_Table6CaseShape>
            <urn:nltl:generated-shape:TRF078_Table7CaseShape>
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1*k2*k3*N_class*n_n within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9; exactly one valid Table 6-6 and one valid Table 6-7 case must supply the selected operands" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?reported .

                ?k2Node qudt:numericValue ?k2 ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k3Node qudt:numericValue ?k3 ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?nnNode qudt:numericValue ?nn ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                $this nltl:hasTableLookupCase ?case6 .
                ?case6 a nltl:tableLookupCase ;
                        nltl:tableReference nltl:traficomTable6Dash6 ;
                        nltl:iceClass ?classKey ;
                        nltl:selectedIceClassCycleCount ?nClassNode .
                ?nClassNode qudt:numericValue ?nClass ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?other6 .
                    ?other6 a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash6 .
                    FILTER (?other6 != ?case6)
                }

                $this nltl:hasTableLookupCase ?case7 .
                ?case7 a nltl:tableLookupCase ;
                        nltl:tableReference nltl:traficomTable6Dash7 ;
                        nltl:tableLookupPropellerLocation ?locationKey ;
                        nltl:selectedPropellerLocationFactor ?k1Node .
                ?k1Node qudt:numericValue ?k1 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?other7 .
                    ?other7 a nltl:tableLookupCase ;
                            nltl:tableReference nltl:traficomTable6Dash7 .
                    FILTER (?other7 != ?case7)
                }

                BIND ((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                BIND ((?expected * 0.000001 + 0.000000001) AS ?tolerance)

                FILTER (
                    (?reported > (?expected + ?tolerance)) ||
                    (?reported < (?expected - ?tolerance))
                )
            }
        """
    ] .
