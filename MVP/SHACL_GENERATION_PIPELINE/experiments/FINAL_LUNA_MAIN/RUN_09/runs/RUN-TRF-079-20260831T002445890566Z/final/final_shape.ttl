@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_079_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerImmersionFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerShaftCentrelineDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Propeller immersion function and ice load cycle coefficient k2 must satisfy the specified formulas." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:propellerShaftCentrelineDepth ?depthNode ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .

                ?iceNode qudt:numericValue ?ice .
                ?diameterNode qudt:numericValue ?diameter .
                ?depthNode qudt:numericValue ?depth .
                ?fNode qudt:numericValue ?reportedF .
                ?k2Node qudt:numericValue ?reportedK2 .

                BIND (((?depth - ?ice) / (?diameter / 2)) - 1 AS ?fCalc)

                BIND (
                    IF(
                        ?fCalc < 0,
                        0.8 - ?fCalc,
                        IF(
                            ?fCalc <= 1,
                            0.8 - (0.4 * ?fCalc),
                            IF(
                                ?fCalc <= 2.5,
                                0.6 - (0.2 * ?fCalc),
                                0.1
                            )
                        )
                    ) AS ?k2Calc
                )

                BIND (IF(?fCalc < 0, -?fCalc, ?fCalc) AS ?fMagnitude)
                BIND (IF(?fMagnitude > 0.000000001, ?fMagnitude * 0.000001, 0.000000001) AS ?fTolerance)

                BIND (IF(?k2Calc < 0, -?k2Calc, ?k2Calc) AS ?k2Magnitude)
                BIND (IF(?k2Magnitude > 0.000000001, ?k2Magnitude * 0.000001, 0.000000001) AS ?k2Tolerance)

                FILTER (
                    ?reportedF < (?fCalc - ?fTolerance) ||
                    ?reportedF > (?fCalc + ?fTolerance) ||
                    ?reportedK2 < (?k2Calc - ?k2Tolerance) ||
                    ?reportedK2 > (?k2Calc + ?k2Tolerance)
                )
            }
        """
    ] .
