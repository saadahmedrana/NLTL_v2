@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF_081_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:forwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:backwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:forwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:backwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:propellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "Ice thrust and propeller shaft design thrust values must satisfy the declared formulas; calculated results use a 1e-6 relative tolerance with a 1e-6 absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?forwardForceNode ;
                      nltl:backwardBladeForce ?backwardForceNode ;
                      nltl:hydrodynamicBollardThrust ?bollardNode ;
                      nltl:forwardIceThrust ?forwardIceNode ;
                      nltl:backwardIceThrust ?backwardIceNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?forwardForceNode qudt:numericValue ?forwardForce .
                ?backwardForceNode qudt:numericValue ?backwardForce .
                ?bollardNode qudt:numericValue ?bollard .
                ?forwardIceNode qudt:numericValue ?forwardIce .
                ?backwardIceNode qudt:numericValue ?backwardIce .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                BIND((1.1 * ?forwardForce) AS ?expectedForwardIce)
                BIND((1.1 * ?backwardForce) AS ?expectedBackwardIce)
                BIND((?bollard + (2.2 * ?expectedForwardIce)) AS ?forwardLoad)
                BIND((1.5 * ?expectedBackwardIce) AS ?backwardLoad)
                BIND(IF(?forwardLoad >= ?backwardLoad, ?forwardLoad, ?backwardLoad) AS ?expectedDesign)

                BIND(IF(ABS(?expectedForwardIce) * 0.000001 > 0.000001,
                        ABS(?expectedForwardIce) * 0.000001,
                        0.000001) AS ?forwardIceTolerance)
                BIND(IF(ABS(?expectedBackwardIce) * 0.000001 > 0.000001,
                        ABS(?expectedBackwardIce) * 0.000001,
                        0.000001) AS ?backwardIceTolerance)
                BIND(IF(ABS(?expectedDesign) * 0.000001 > 0.000001,
                        ABS(?expectedDesign) * 0.000001,
                        0.000001) AS ?designTolerance)

                FILTER (
                    ABS(?forwardIce - ?expectedForwardIce) > ?forwardIceTolerance
                    || ABS(?backwardIce - ?expectedBackwardIce) > ?backwardIceTolerance
                    || ABS(?forwardDesign - ?expectedDesign) > ?designTolerance
                    || ABS(?backwardDesign - ?expectedDesign) > ?designTolerance
                    || ABS(?design - ?expectedDesign) > ?designTolerance
                )
            }
        """
    ] .
