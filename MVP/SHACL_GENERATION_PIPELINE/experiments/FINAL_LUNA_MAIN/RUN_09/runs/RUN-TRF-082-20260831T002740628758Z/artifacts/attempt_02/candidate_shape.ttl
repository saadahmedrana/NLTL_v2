@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-082> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Bollard thrust must be explicitly recorded as known for this branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Bollard thrust must be explicitly recorded as not known for the table-lookup branch."
            ] ;
            sh:property [
                sh:path nltl:hydrodynamicBollardThrust ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
                    ]
                ] ;
                sh:message "A hydrodynamic bollard thrust quantity in kN is required when the thrust is not known."
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:tableLookupCase ;
                    sh:property [
                        sh:path nltl:tableLookupApplied ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "The Table 6-8 lookup case must be marked as applied."
                    ] ;
                    sh:property [
                        sh:path nltl:tableReference ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:hasValue nltl:traficomTable6Dash8
                        ] ;
                        sh:message "The lookup case must reference TRAFICOM Table 6-8."
                    ] ;
                    sh:property [
                        sh:path nltl:lookupSelectionEvidence ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:evidenceArtifact ;
                        sh:message "Evidence for the Table 6-8 selection is required."
                    ]
                ] ;
                sh:message "A Table 6-8 lookup case is required when hydrodynamic bollard thrust is not known."
            ] ;
            sh:sparql [
                sh:message "When thrust is not known, the recorded hydrodynamic bollard thrust must equal the numeric value selected from Table 6-8." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bollardThrustKnown false ;
                              nltl:hydrodynamicBollardThrust ?thrust ;
                              nltl:hasTableLookupCase ?case .
                        ?thrust qudt:numericValue ?actual .
                        ?case nltl:tableReference nltl:traficomTable6Dash8 .
                        FILTER (
                            NOT EXISTS {
                                nltl:traficomTable6Dash8 qudt:numericValue ?selected
                            }
                            ||
                            NOT EXISTS {
                                nltl:traficomTable6Dash8 qudt:numericValue ?matching ;
                                FILTER (?matching = ?actual)
                            }
                        )
                    }
                """
            ]
        ]
    ) .
