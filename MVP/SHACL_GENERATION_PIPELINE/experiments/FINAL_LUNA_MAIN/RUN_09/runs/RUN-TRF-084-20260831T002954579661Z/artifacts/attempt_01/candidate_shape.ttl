@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-084> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For a CP propeller with a known pitch value, propellerPitchAtMcrBollard must be present as a decimal quantity in metres." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP"^^xsd:string ;
                              nltl:pitchValueKnown true .
                        FILTER NOT EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?result .
                            ?result qudt:numericValue ?value ;
                                    qudt:unit unit:M .
                            FILTER(datatype(?value) = xsd:decimal)
                        }
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "For a CP propeller with an unknown pitch value, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within a relative tolerance of 1e-6 plus an absolute fallback of 1e-9, with both quantities expressed in metres." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX unit: <http://qudt.org/vocab/unit/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "CP"^^xsd:string ;
                              nltl:pitchValueKnown false .
                        FILTER NOT EXISTS {
                            $this nltl:propellerPitchAtMcrFreeRunning ?free ;
                                  nltl:propellerPitchAtMcrBollard ?bollard .
                            ?free qudt:numericValue ?freeValue ;
                                  qudt:unit unit:M .
                            ?bollard qudt:numericValue ?bollardValue ;
                                     qudt:unit unit:M .
                            FILTER(datatype(?freeValue) = xsd:decimal)
                            FILTER(datatype(?bollardValue) = xsd:decimal)
                            BIND(0.7 * ?freeValue AS ?expected)
                            FILTER(
                                ABS(?bollardValue - ?expected)
                                <= ABS(?expected) * 0.000001 + 0.000000001
                            )
                        }
                    }
                """
            ]
        ]
    ) .
