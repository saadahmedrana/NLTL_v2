@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF088Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF088KnownShape
        gen:TRF088UnknownShape
    ) .

gen:TRF088KnownShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Maximum engine torque shall be marked as known or unknown."
    ] ;
    sh:property [
        sh:path nltl:maximumEngineTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF088TorqueValueShape ;
        sh:message "A maximum engine torque value in kN*m is required."
    ] .

gen:TRF088UnknownShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "When maximum engine torque is unknown, the applicable Table 6-10 lookup shall be recorded."
    ] ;
    sh:property [
        sh:path nltl:maximumEngineTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF088TorqueValueShape ;
        sh:message "The maximum engine torque accorded from Table 6-10 shall be recorded in kN*m."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TRF088TableLookupCaseShape ;
        sh:message "A Table 6-10 lookup case is required when maximum engine torque is unknown."
    ] .

gen:TRF088TorqueValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:KiloN-M
    ] .

gen:TRF088TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash10
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:node gen:TRF088EvidenceShape
    ] .

gen:TRF088EvidenceShape
    a sh:NodeShape ;
    sh:class nltl:evidenceArtifact .
