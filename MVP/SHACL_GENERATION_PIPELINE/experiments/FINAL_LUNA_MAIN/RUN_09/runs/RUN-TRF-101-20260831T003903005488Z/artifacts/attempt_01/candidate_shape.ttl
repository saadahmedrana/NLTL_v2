@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF101QuantityLength a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF101QuantityForce a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF101QuantityPressure a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF101QuantityDimensionless a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF101CalculationBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityLength
    ] ;
    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityLength
    ] ;
    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityLength
    ] ;
    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityPressure
    ] ;
    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityPressure
    ] ;
    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityPressure
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityForce
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityLength
    ] ;
    sh:sparql [
        sh:message "Blade reference strength and ultimate failure load must satisfy the declared calculation within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection ?cNode ;
                      nltl:bladeCylindricalRootRadius ?rNode ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                      nltl:bladeMinimumYieldStrength ?yieldNode ;
                      nltl:bladeUltimateTensileStrength ?ultimateNode ;
                      nltl:bladeReferenceStrength1 ?referenceNode ;
                      nltl:bladeFailureUltimateLoad ?loadNode ;
                      nltl:propellerDiameter ?diameterNode .

                ?cNode qudt:numericValue ?c .
                ?rNode qudt:numericValue ?r .
                ?tNode qudt:numericValue ?t .
                ?yieldNode qudt:numericValue ?yield .
                ?ultimateNode qudt:numericValue ?ultimate .
                ?referenceNode qudt:numericValue ?reference .
                ?loadNode qudt:numericValue ?load .
                ?diameterNode qudt:numericValue ?diameter .

                BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                BIND ((0.8 * ?diameter) - (2 * ?r) AS ?denominator)
                BIND ((300 * ?c * ?t * ?t * ?expectedReference) / ?denominator AS ?expectedLoad)

                FILTER (
                    ?denominator <= 0 ||
                    ABS(?reference - ?expectedReference) >
                        ((0.000001 * ABS(?expectedReference)) + 0.000000001) ||
                    ABS(?load - ?expectedLoad) >
                        ((0.000001 * ABS(?expectedLoad)) + 0.000000001)
                )
            }
        """
    ] .

gen:TRF101AnalysisBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:approvalRecord
    ] .

gen:TRF101Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path ( nltl:hasLoadCase nltl:bladeFailureLoadApplicationRadiusRatio ) ;
        sh:minCount 1 ;
        sh:node gen:TRF101QuantityDimensionless
    ] ;
    sh:property [
        sh:path ( nltl:hasLoadCase nltl:bladeFailureLoadWeakestDirectionConfirmed ) ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:TRF101AnalysisBranch
        gen:TRF101CalculationBranch
    ) .

gen:TRF101FailureStatusShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityLength
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF101QuantityLength
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Blade failure status must be true exactly when tip offset exceeds ten percent of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?offsetNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeFailureStatus ?status .

                ?offsetNode qudt:numericValue ?offset .
                ?diameterNode qudt:numericValue ?diameter .

                FILTER (
                    (?offset > (0.10 * ?diameter) && ?status != true) ||
                    (?offset <= (0.10 * ?diameter) && ?status != false)
                )
            }
        """
    ] .
