@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:QuantityLengthMShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:QuantityForceKiloNShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:QuantityPressureMegaPAShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:QuantityDimensionlessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:node g:QuantityDimensionlessShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The blade failure load application radius ratio must equal the inclusive dimensionless value 0.8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeFailureLoadApplicationRadiusRatio ?ratioNode .
                ?ratioNode qudt:numericValue ?ratio ;
                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (?ratio < 0.8 || ?ratio > 0.8)
            }
        """
    ] .

g:CommonInputsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:node g:QuantityLengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:node g:QuantityLengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:node g:QuantityLengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:node g:QuantityPressureMegaPAShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:node g:QuantityPressureMegaPAShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:node g:QuantityLengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:node g:QuantityPressureMegaPAShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node g:QuantityLengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:class nltl:loadCase ;
        sh:node g:LoadCaseShape ;
        sh:minCount 1
    ] .

g:ApprovedAnalysisBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:class nltl:approvalRecord ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:node g:QuantityForceKiloNShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:CalculatedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:node g:QuantityForceKiloNShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The calculated blade failure load and reference strength must satisfy the declared formulas within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection ?cNode ;
                      nltl:bladeCylindricalRootRadius ?rNode ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                      nltl:bladeMinimumYieldStrength ?yieldNode ;
                      nltl:bladeReferenceStrength1 ?refNode ;
                      nltl:bladeUltimateTensileStrength ?ultimateNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:bladeFailureUltimateLoad ?loadNode .

                ?cNode qudt:numericValue ?c ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?rNode qudt:numericValue ?r ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?tNode qudt:numericValue ?t ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?yieldNode qudt:numericValue ?yield ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?refNode qudt:numericValue ?reference ;
                        qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?ultimateNode qudt:numericValue ?ultimate ;
                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?dNode qudt:numericValue ?d ;
                      qudt:unit <http://qudt.org/vocab/unit/M> .
                ?loadNode qudt:numericValue ?load ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                $this nltl:hasLoadCase ?case .
                ?case nltl:bladeFailureLoadApplicationRadiusRatio ?ratioNode .
                ?ratioNode qudt:numericValue ?ratio ;
                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                BIND ((300.0 * ?c * ?t * ?t * ?expectedReference) /
                      ((?ratio * ?d) - (2.0 * ?r)) AS ?expectedLoad)
                BIND (1e-6 * (IF (?expectedReference >= 0.0, ?expectedReference, -?expectedReference)) AS ?referenceTolerance)
                BIND (1e-6 * (IF (?expectedLoad >= 0.0, ?expectedLoad, -?expectedLoad)) AS ?loadTolerance)

                FILTER (((?reference - ?expectedReference) > (?referenceTolerance + 1e-12)) ||
                        ((?expectedReference - ?reference) > (?referenceTolerance + 1e-12)) ||
                        ((?load - ?expectedLoad) > (?loadTolerance + 1e-12)) ||
                        ((?expectedLoad - ?load) > (?loadTolerance + 1e-12)))
            }
        """
    ] .

g:BladeFailureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:node g:CommonInputsShape ;
    sh:or (
        g:ApprovedAnalysisBranch
        g:CalculatedBranch
    ) ;
    sh:sparql [
        sh:message "bladeFailureStatus must be true exactly when blade tip offset exceeds 10 percent of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?offsetNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeFailureStatus ?status .

                ?offsetNode qudt:numericValue ?offset ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                ?diameterNode qudt:numericValue ?diameter ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .

                BIND ((?offset > (0.10 * ?diameter)) AS ?expectedStatus)
                FILTER (?status != ?expectedStatus)
            }
        """
    ] .
