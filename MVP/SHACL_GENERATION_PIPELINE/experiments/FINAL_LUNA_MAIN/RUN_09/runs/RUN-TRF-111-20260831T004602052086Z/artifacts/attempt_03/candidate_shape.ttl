@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-111-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide one extreme ice force in kN."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:propellerShaftLineComponent ;
            sh:property [
                sh:path nltl:fatigueSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 1.5
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The fatigue safety factor for the propeller shaft line component must be at least 1.5."
            ]
        ] ;
        sh:message "The ship must identify the applicable propeller shaft line component."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:node [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:extremeOperationalLoadCase ;
                        sh:node [
                            sh:class nltl:shaftLineLoadCaseTypeValue
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:fatigueLoadCase ;
                        sh:node [
                            sh:class nltl:shaftLineLoadCaseTypeValue
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:bladeFailureLoadCase ;
                        sh:node [
                            sh:class nltl:shaftLineLoadCaseTypeValue
                        ]
                    ]
                ]
            )
        ] ;
        sh:message "Each propulsion load case must have an explicitly typed permitted shaft line load case type."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:extremeOperationalLoadCase ;
                sh:node [
                    sh:class nltl:shaftLineLoadCaseTypeValue
                ]
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 1.3
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one extreme operational load case must have a component yield safety factor of at least 1.3."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:fatigueLoadCase ;
                sh:node [
                    sh:class nltl:shaftLineLoadCaseTypeValue
                ]
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one fatigue load case must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:bladeFailureLoadCase ;
                sh:node [
                    sh:class nltl:shaftLineLoadCaseTypeValue
                ]
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 1.0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one blade failure load case must have a component yield safety factor of at least 1.0."
    ] .
