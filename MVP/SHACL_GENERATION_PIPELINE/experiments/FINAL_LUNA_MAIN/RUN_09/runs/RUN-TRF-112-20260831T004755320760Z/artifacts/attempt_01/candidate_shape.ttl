@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-112-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:shaftLineLoadCaseTypeValue
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:hasValue nltl:bladeFailureLoadCase ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:bladeFailureUltimateLoad ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:KiloN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:combinedAxialBendingTorsionLoad ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:KiloN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shaftLineLoadCaseType ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            )
        ]
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:propellerShaftLineComponent
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable blade-failure load case, each propeller shaft-line component shall provide a bending yield safety factor of at least 1.0 with a dimensionless unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:hasPropulsionLoadCase ?loadCase .
  ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
  $this nltl:hasPropellerShaftLineComponent ?component .
  FILTER NOT EXISTS {
    ?component nltl:bendingYieldSafetyFactor ?quantity .
    ?quantity a qudt:QuantityValue ;
              qudt:numericValue ?value ;
              qudt:unit qudt:UNITLESS .
    FILTER (datatype(?value) = xsd:decimal && ?value >= 1.0)
  }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable blade-failure load case, each propeller shaft-line component shall provide a torsional yield safety factor of at least 1.0 with a dimensionless unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:hasPropulsionLoadCase ?loadCase .
  ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
  $this nltl:hasPropellerShaftLineComponent ?component .
  FILTER NOT EXISTS {
    ?component nltl:torsionalYieldSafetyFactor ?quantity .
    ?quantity a qudt:QuantityValue ;
              qudt:numericValue ?value ;
              qudt:unit qudt:UNITLESS .
    FILTER (datatype(?value) = xsd:decimal && ?value >= 1.0)
  }
}
"""
    ] .
