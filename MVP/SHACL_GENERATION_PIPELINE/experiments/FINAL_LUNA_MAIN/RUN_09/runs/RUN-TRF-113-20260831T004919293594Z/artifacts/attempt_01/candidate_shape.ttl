@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-113-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the plastic bending design condition for blade-loss resistance."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the propeller blade orientation causing the maximum component load."
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "The ship must provide evidence of the thruster blade-loss design."
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "The load case must confirm that the selected blade orientation produces the maximum component load."
            ]
        ] ;
        sh:message "The ship must provide a load case identifying the maximum component-load blade orientation."
    ] .
