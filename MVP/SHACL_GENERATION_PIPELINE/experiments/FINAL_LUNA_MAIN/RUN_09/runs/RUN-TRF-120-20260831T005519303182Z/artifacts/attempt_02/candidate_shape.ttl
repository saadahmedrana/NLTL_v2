@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF120ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damping ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the damping used for thruster natural-frequency estimation."
    ] ;
    sh:property [
        sh:path nltl:waterAddedMass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide water added mass as a kilogram quantity."
    ] ;
    sh:property [
        sh:path nltl:thrusterNaturalFrequency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:HZ ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide the externally determined thruster natural-frequency result in hertz."
    ] .

gen:TRF120ThrusterBodyShape a sh:NodeShape ;
    sh:targetClass nltl:thrusterBody ;
    sh:property [
        sh:path nltl:shipAttachmentStiffness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-PER-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The thruster body must provide the ship attachment stiffness used in the model."
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:node gen:TRF120CalculationCaseShape ;
        sh:message "Each natural-frequency calculation case must identify one permitted vibration direction."
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:qualifiedValueShape gen:TRF120LongitudinalCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The thruster model must include a longitudinal natural-frequency calculation case."
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:qualifiedValueShape gen:TRF120TransverseCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The thruster model must include a transverse natural-frequency calculation case."
    ] .

gen:TRF120CalculationCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:longitudinalDirection
            nltl:transverseDirection
        )
    ] .

gen:TRF120LongitudinalCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:hasValue nltl:longitudinalDirection ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF120TransverseCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:hasValue nltl:transverseDirection ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
