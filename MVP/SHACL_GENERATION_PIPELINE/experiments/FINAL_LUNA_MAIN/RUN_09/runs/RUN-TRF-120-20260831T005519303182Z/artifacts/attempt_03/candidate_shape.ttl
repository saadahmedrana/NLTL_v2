@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF120ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damping ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the damping input used for thruster natural-frequency estimation."
    ] ;
    sh:property [
        sh:path nltl:waterAddedMass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide water added mass as a single kilogram quantity."
    ] ;
    sh:property [
        sh:path nltl:thrusterNaturalFrequency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:HZ ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide the externally estimated thruster natural frequency in hertz."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterBody
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must link the thruster body subject to the global natural-frequency estimation."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:qualifiedValueShape [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:vibrationDirection ;
                sh:hasValue nltl:longitudinalDirection ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must link a longitudinal natural-frequency calculation case."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:qualifiedValueShape [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:vibrationDirection ;
                sh:hasValue nltl:transverseDirection ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must link a transverse natural-frequency calculation case."
    ] .

gen:TRF120ThrusterBodyShape a sh:NodeShape ;
    sh:targetClass nltl:thrusterBody ;
    sh:property [
        sh:path nltl:shipAttachmentStiffness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-PER-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The thruster body must provide ship attachment stiffness in kilonewtons per metre."
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:qualifiedValueShape [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:vibrationDirection ;
                sh:hasValue nltl:longitudinalDirection ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The thruster body must have a longitudinal natural-frequency calculation case."
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:qualifiedValueShape [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:vibrationDirection ;
                sh:hasValue nltl:transverseDirection ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The thruster body must have a transverse natural-frequency calculation case."
    ] ;
    sh:sparql [
        sh:message "Each linked thruster body direction-specific case must also be represented as the ship's corresponding calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    ?ship a nltl:ship ;
                          nltl:hasComponent $this .
                }
                FILTER (
                    NOT EXISTS {
                        ?ship nltl:hasCalculationCase ?longitudinalCase .
                        $this nltl:hasNaturalFrequencyCalculationCase ?longitudinalCase .
                        ?longitudinalCase nltl:vibrationDirection nltl:longitudinalDirection .
                    }
                    ||
                    NOT EXISTS {
                        ?ship nltl:hasCalculationCase ?transverseCase .
                        $this nltl:hasNaturalFrequencyCalculationCase ?transverseCase .
                        ?transverseCase nltl:vibrationDirection nltl:transverseDirection .
                    }
                )
            }
        """
    ] .
