@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF126AirReceiverConsecutiveStartShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The propulsion engine reversal state must be true for the 12-start requirement."
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 12 ;
                sh:minCount 1 ;
                sh:message "Air receiver capacity must provide at least 12 consecutive propulsion-engine starts when reversal for astern movement is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The propulsion engine reversal state must be false for the 6-start requirement."
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 6 ;
                sh:minCount 1 ;
                sh:message "Air receiver capacity must provide at least 6 consecutive propulsion-engine starts when reversal for astern movement is not required."
            ]
        ]
    ) .
