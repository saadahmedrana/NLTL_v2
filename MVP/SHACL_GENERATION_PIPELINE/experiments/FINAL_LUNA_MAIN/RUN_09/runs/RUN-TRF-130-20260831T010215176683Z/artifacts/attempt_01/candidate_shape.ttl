@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:StandardArrangementBranch
        gen:AlternativeArrangementBranch
    ) .

gen:StandardArrangementBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:inletChest ;
            sh:node gen:StandardChestShape
        ] ;
        sh:qualifiedMinCount 1
    ] .

gen:AlternativeArrangementBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:inletChest ;
            sh:node gen:AlternativeChestShape
        ] ;
        sh:qualifiedMinCount 2
    ] .

gen:InletChestShape
    a sh:NodeShape ;
    sh:targetClass nltl:inletChest ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "near centreline and well aft if possible"
    ] ;
    sh:property [
        sh:path nltl:nearCentrelineAndWellAftIfPossible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:node gen:RatioQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The chest volume must be approximately total relevant engine power divided by 750, and strainer open area must be at least four times inlet pipe area. Volume comparison uses a relative tolerance of 1e-6 with a 0.000001 absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasComponent $this ;
                      nltl:totalRelevantEnginePower ?powerNode .
                ?powerNode qudt:numericValue ?power .

                $this nltl:recommendedChestVolume ?volumeNode ;
                      nltl:strainerOpenArea ?openNode ;
                      nltl:inletPipeArea ?pipeNode .

                ?volumeNode qudt:numericValue ?reportedVolume .
                ?openNode qudt:numericValue ?openArea .
                ?pipeNode qudt:numericValue ?pipeArea .

                BIND((?power / 750) AS ?expectedVolume)

                FILTER(
                    ?reportedVolume < (?expectedVolume - ((?expectedVolume * 0.000001) + 0.000001))
                    || ?reportedVolume > (?expectedVolume + ((?expectedVolume * 0.000001) + 0.000001))
                    || ?openArea < (4 * ?pipeArea)
                )
            }
        """
    ] .

gen:StandardChestShape
    a sh:NodeShape ;
    sh:and (
        gen:InletChestShape
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceAccumulationSpaceAboveInlet ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

gen:AlternativeChestShape
    a sh:NodeShape ;
    sh:and (
        gen:InletChestShape
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:VolumeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:RatioQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
