@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-130-CommonChest> a sh:NodeShape ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "near centreline and well aft if possible" ;
        sh:message "The sea inlet shall be near the centreline and well aft if possible."
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A full-capacity cooling-water discharge pipe shall be connected to the inlet chest."
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The strainer open area shall be at least four times the inlet pipe area, and the reported strainer open area ratio shall equal strainer open area divided by inlet pipe area within tolerance and be at least 4." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:inletPipeArea ?inletNode ;
                      nltl:strainerOpenArea ?strainerNode ;
                      nltl:strainerOpenAreaRatio ?ratioNode .

                ?inletNode qudt:numericValue ?inletArea .
                ?strainerNode qudt:numericValue ?strainerArea .
                ?ratioNode qudt:numericValue ?reportedRatio .

                BIND((?strainerArea / ?inletArea) AS ?expectedRatio)
                BIND((?expectedRatio * 0.000001) + 0.000000001 AS ?tolerance)

                FILTER(
                    ?inletArea <= 0 ||
                    ?strainerArea < (4 * ?inletArea) ||
                    ?reportedRatio < 4 ||
                    ?reportedRatio < (?expectedRatio - ?tolerance) ||
                    ?reportedRatio > (?expectedRatio + ?tolerance)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-130-StandardChest> a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-130-CommonChest> ;
    sh:property [
        sh:path nltl:iceAccumulationSpaceAboveInlet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The inlet chest shall provide space above the inlet pipe for ice accumulation."
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The recommended and declared sea-chest volumes shall be approximately total relevant engine power divided by 750, within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:recommendedChestVolume ?recommendedNode ;
                      nltl:seaChestVolume ?seaNode .

                ?recommendedNode qudt:numericValue ?recommendedVolume .
                ?seaNode qudt:numericValue ?seaVolume .

                ?ship nltl:hasComponent ?this ;
                      nltl:totalRelevantEnginePower ?totalPowerNode ;
                      nltl:maximumContinuousRatingPower ?mcrPowerNode .

                ?totalPowerNode qudt:numericValue ?totalPower .
                ?mcrPowerNode qudt:numericValue ?mcrPower .

                BIND((?totalPower / 750) AS ?expectedVolume)
                BIND((?expectedVolume * 0.000001) + 0.000000001 AS ?tolerance)

                FILTER(
                    ?totalPower <= 0 ||
                    ?recommendedVolume < (?expectedVolume - ?tolerance) ||
                    ?recommendedVolume > (?expectedVolume + ?tolerance) ||
                    ?seaVolume < (?expectedVolume - ?tolerance) ||
                    ?seaVolume > (?expectedVolume + ?tolerance)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-130-AlternativeChest> a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-130-CommonChest> ;
    sh:property [
        sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each alternative inlet chest shall support alternating cooling-water intake and discharge."
    ] .

<urn:nltl:generated-shape:TRF-130-Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:totalRelevantEnginePower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:node <urn:nltl:generated-shape:TRF-130-StandardChest>
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "At least one inlet chest shall satisfy the standard cooling-water inlet-chest requirements."
            ]
        ]
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:node <urn:nltl:generated-shape:TRF-130-AlternativeChest>
                ] ;
                sh:qualifiedMinCount 2 ;
                sh:message "When the standard volume and height requirements cannot be met, at least two alternating inlet chests shall be provided."
            ]
        ]
    ) .
