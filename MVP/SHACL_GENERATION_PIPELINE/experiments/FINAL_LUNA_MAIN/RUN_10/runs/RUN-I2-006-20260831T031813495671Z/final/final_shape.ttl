@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:asternIceOperationIntent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When astern ice operation is intended, the aft section design basis must be Bow and Bow Intermediate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asternIceOperationIntent true .
                FILTER NOT EXISTS {
                    $this nltl:aftSectionDesignBasis "Bow and Bow Intermediate"^^xsd:string .
                }
            }
        """
    ] .
