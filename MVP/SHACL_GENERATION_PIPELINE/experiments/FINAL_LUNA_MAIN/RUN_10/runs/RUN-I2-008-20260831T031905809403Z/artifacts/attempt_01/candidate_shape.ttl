@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:I2_008_ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:polarClassValue ;
            sh:in (
                nltl:polarClassPc1
                nltl:polarClassPc2
                nltl:polarClassPc3
                nltl:polarClassPc4
                nltl:polarClassPc5
                nltl:polarClassPc6
                nltl:polarClassPc7
            )
        ] ;
        sh:message "A ship shall specify a permitted Polar Class value." ;
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:PressureQuantityShape ;
        sh:message "Average ice pressure is required as an externally established calculation input." ;
    ] ;
    sh:property [
        sh:path nltl:lineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:LineLoadQuantityShape ;
        sh:message "Line load is required as an externally established calculation input." ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:LengthQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:LengthQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:PressureQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:DimensionlessQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:ForceQuantityShape ;
        sh:message "The externally computed total glancing impact force is required." ;
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:property [
                sh:path nltl:bowShapeCoefficient ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node g:DimensionlessQuantityShape ;
            ] ;
            sh:property [
                sh:path nltl:glancingImpactLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node g:GlancingLineLoadQuantityShape ;
                sh:message "Each bow subregion calculation case shall provide its externally computed glancing impact line load." ;
            ] ;
            sh:property [
                sh:path nltl:glancingImpactPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node g:PressureQuantityShape ;
                sh:message "Each bow subregion calculation case shall provide its externally computed glancing impact pressure." ;
            ]
        ] ;
    ] .

g:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

g:LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M>
    ] .

g:GlancingLineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2>
    ] .

g:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

g:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

g:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .
