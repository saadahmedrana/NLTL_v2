@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_008_MegaPaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gen:I2_008_UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case requires a unitless bow shape coefficient."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:node gen:I2_008_LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case requires a glancing impact line load."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:node gen:I2_008_MegaPaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case requires a glancing impact pressure."
    ] .

gen:I2_008_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Polar Class value from PC1 through PC7 is required to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:bowShape ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The actual bow shape must be provided."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:I2_008_MegaPaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lineLoad ;
        sh:node gen:I2_008_LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:I2_008_LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:I2_008_LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node gen:I2_008_MegaPaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node gen:I2_008_UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gen:I2_008_BowSubregionCaseShape ;
        sh:minCount 1 ;
        sh:message "The applicable bow area must have a bow subregion calculation case with externally computed ice-load characteristics."
    ] .
