@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:node nltl:I2_009_HullAreaAssignmentShape
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node nltl:I2_009_PressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node nltl:I2_009_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node nltl:I2_009_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node nltl:I2_009_AspectRatioQuantityShape
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node nltl:I2_009_ButtockAngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node nltl:I2_009_NormalFrameAngleQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an other ice-strengthened area, average ice pressure, non-bow load-patch height and length, and load-patch aspect ratio are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasHullAreaAssignment ?assignment .
                ?assignment nltl:assignedHullArea nltl:otherIceStrengthenedAreaValue .
                FILTER (
                    NOT EXISTS { $this nltl:averageIcePressure ?averagePressure . } ||
                    NOT EXISTS { $this nltl:nonBowLoadPatchHeight ?patchHeight . } ||
                    NOT EXISTS { $this nltl:nonBowLoadPatchLength ?patchLength . } ||
                    NOT EXISTS { $this nltl:loadPatchAspectRatio ?aspectRatio . }
                )
            }
        """
    ] .

nltl:I2_009_HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:in ( nltl:otherIceStrengthenedAreaValue ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The hull area assignment shall identify the other ice-strengthened area value."
    ] .

nltl:I2_009_PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_009_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_009_AspectRatioQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:message "The load patch aspect ratio shall be exactly 3.6."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_009_ButtockAngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive 0 ;
        sh:maxExclusive 80 ;
        sh:message "For an applicable bow form, the buttock angle shall be greater than 0 degrees and less than 80 degrees."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_009_NormalFrameAngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive 10 ;
        sh:message "For an applicable bow form, the normal frame angle shall be greater than 10 degrees."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
