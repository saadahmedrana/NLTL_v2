@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_011_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:I2_011_ApplicableShape
        gen:I2_011_InapplicableBulbousBowFalseShape
        gen:I2_011_InapplicablePc1Shape
        gen:I2_011_InapplicablePc2Shape
        gen:I2_011_InapplicablePc3Shape
        gen:I2_011_InapplicablePc4Shape
        gen:I2_011_InapplicablePc5Shape
    ) .

gen:I2_011_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.6"^^xsd:decimal ;
                sh:maxInclusive "0.6"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.3"^^xsd:decimal ;
                sh:maxInclusive "1.3"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaN>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN>
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The bow design force must be the method (iv) design force within tolerance and must not be less than the method (iii) force converted from MN to kN; method (iii) uses fa = 0.6 and AR = 1.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shapeCoefficient ?faNode ;
                      nltl:loadPatchAspectRatio ?arNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiNode ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivNode ;
                      nltl:bowDesignForce ?designNode .

                ?faNode qudt:numericValue ?fa ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?arNode qudt:numericValue ?ar ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?iiiNode qudt:numericValue ?iii ;
                         qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?ivNode qudt:numericValue ?iv ;
                        qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?designNode qudt:numericValue ?design ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                FILTER (
                    ?fa = "0.6"^^xsd:decimal &&
                    ?ar = "1.3"^^xsd:decimal &&
                    (
                        ?design < (?iii * 1000) ||
                        ABS(?design - (?iv * 1000)) >
                        (1e-6 * ABS(?iv * 1000) + 0.000001)
                    )
                )
            }
        """
    ] .

gen:I2_011_InapplicableBulbousBowFalseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:I2_011_InapplicablePc1Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarClassPc1
    ] .

gen:I2_011_InapplicablePc2Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarClassPc2
    ] .

gen:I2_011_InapplicablePc3Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarClassPc3
    ] .

gen:I2_011_InapplicablePc4Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarClassPc4
    ] .

gen:I2_011_InapplicablePc5Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarClassPc5
    ] .
