@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A unitless quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use the unitless unit."
    ] .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A length quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The length quantity must use metres."
    ] .

gs:AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An angle quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The angle quantity must use degrees."
    ] .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:message "The ship must provide one unitless beta i prime input."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape ;
        sh:message "The ship must provide one upper ice waterline length in metres."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;
            sh:node gs:BowSubregionCalculationCaseShape
        ] ;
        sh:message "The ship must provide a bow subregion calculation case."
    ] .

gs:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:class nltl:bowFormApplicabilityValue ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow calculation case must identify the I2.3.1(v) bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape ;
        sh:message "The bow calculation case must provide the mid-length position in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AngleQuantityShape ;
        sh:message "The bow calculation case must provide the waterline angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:message "The bow calculation case must provide the externally computed bow shape coefficient."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:node gs:FailureClassFactorLookupCaseShape
        ] ;
        sh:message "The bow calculation case must provide its failure-class factor lookup case."
    ] .

gs:BowSubregionCalculationCaseTargetShape
    a sh:NodeShape ;
    sh:targetClass nltl:bowSubregionCalculationCase ;
    sh:node gs:BowSubregionCalculationCaseShape .

gs:FailureClassFactorLookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:message "The lookup case must provide one flexural failure class factor."
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:message "The lookup case must provide one crushing failure class factor."
    ] .
