@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_017_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_017_LengthQuantityShape ;
        sh:message "The ship must provide one upper ice waterline draught D_UI in metres."
    ] ;
    sh:property [
        sh:path nltl:displacementFactorThreshold ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_017_LengthQuantityShape ;
        sh:message "The ship must provide one displacement factor threshold CF_DIS in metres."
    ] ;
    sh:property [
        sh:path nltl:hasNonBowIceLoadCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:nonBowIceLoadCalculationCase ;
            sh:property [
                sh:path nltl:shipDisplacementFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:I2_017_DimensionlessQuantityShape ;
                sh:message "The non-bow ice load calculation case must contain the externally determined ship displacement factor DF."
            ] ;
            sh:property [
                sh:path nltl:nonBowIceForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:I2_017_ForceQuantityShape ;
                sh:message "The non-bow ice load calculation case must contain the externally determined non-bow ice force F_NonBow."
            ] ;
            sh:property [
                sh:path nltl:nonBowIceLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:I2_017_LineLoadQuantityShape ;
                sh:message "The non-bow ice load calculation case must contain the externally determined non-bow ice line load Q_NonBow."
            ]
        ] ;
        sh:message "The ship must provide a non-bow ice load calculation case."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:crushingFailureClassFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:I2_017_DimensionlessQuantityShape ;
                sh:message "The table lookup case must provide the crushing failure class factor CFC."
            ] ;
            sh:property [
                sh:path nltl:loadPatchDimensionClassFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:I2_017_DimensionlessQuantityShape ;
                sh:message "The table lookup case must provide the load patch dimension class factor CFD."
            ]
        ] ;
        sh:message "The ship must provide a table lookup case containing the required class factors."
    ] .

gen:I2_017_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:I2_017_DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gen:I2_017_ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .

gen:I2_017_LineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2>
    ] .
