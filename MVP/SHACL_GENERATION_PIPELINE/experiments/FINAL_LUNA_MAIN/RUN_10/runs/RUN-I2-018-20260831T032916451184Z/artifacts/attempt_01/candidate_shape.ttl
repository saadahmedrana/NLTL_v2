@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:class nltl:iceLoadPatch ;
        sh:minCount 1 ;
        sh:message "The ship must identify a design ice load patch."
    ] ;

    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:class nltl:peakPressureFactorLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:localizedStructuralMemberCategory ;
                sh:in (
                    nltl:bottomStructureFrameCategory
                    nltl:longitudinallyFramedPlatingCategory
                    nltl:stringerSideLongitudinalOrWebFrameCategory
                    nltl:transverseFrameWithLoadDistributingStringersCategory
                    nltl:transverseFrameWithoutLoadDistributingStringersCategory
                    nltl:transverselyFramedPlatingCategory
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The peak-pressure lookup case must specify one permitted localized structural-member category."
            ] ;
            sh:property [
                sh:path nltl:selectedPeakPressureFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The lookup case must provide a dimensionless selected peak pressure factor."
            ]
        ] ;
        sh:message "The ship must provide a peak-pressure factor lookup case."
    ] ;

    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:iacsUrI2Table3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The table lookup case must cite IACS UR I2 Table 3."
            ] ;
            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "The Table 3 lookup selection must have evidence."
            ]
        ] ;
        sh:message "The ship must provide a Table 3 lookup case."
    ] ;

    sh:property [
        sh:path nltl:iceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide ice force in kilonewtons."
    ] ;

    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide load patch height in metres."
    ] ;

    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide load patch length in metres."
    ] ;

    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide average ice pressure in megapascals."
    ] ;

    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide a dimensionless peak pressure factor."
    ] ;

    sh:sparql [
        sh:message "Average ice pressure must equal ice force converted from kN to MN divided by load patch height times load patch length, within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:iceForce/qudt:numericValue ?force ;
                      nltl:loadPatchHeight/qudt:numericValue ?height ;
                      nltl:loadPatchLength/qudt:numericValue ?length ;
                      nltl:averageIcePressure/qudt:numericValue ?reported .
                BIND ((?force / 1000) / (?height * ?length) AS ?expected)
                FILTER (
                    ABS(?reported - ?expected) >
                    (0.000000001 + (0.000001 * ABS(?expected)))
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The reported peak pressure factor must equal the selected factor from the applicable Table 3 lookup case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:peakPressureFactor/qudt:numericValue ?reported ;
                      nltl:hasPeakPressureFactorLookupCase ?case .
                ?case nltl:selectedPeakPressureFactor/qudt:numericValue ?selected .
                FILTER (?reported != ?selected)
            }
        """
    ] .
