@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:I2-019-QuantityValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-019-HullAreaValueShape>
    a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-019-QuantityValueShape>
    ] .

<urn:nltl:generated-shape:I2-019-StructuralMemberShape>
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-019-HullAreaValueShape>
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:I2-019-QuantityValueShape>
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For a structural member spanning hull areas, selectedHullAreaFactor must equal the largest hullAreaFactor among its spanned hull areas." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt>

            SELECT $this
            WHERE {
                $this nltl:hasSpannedHullArea ?hullArea ;
                      nltl:selectedHullAreaFactor ?selectedNode .
                ?selectedNode qudt:numericValue ?reported ;
                              qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?hullArea nltl:hullAreaFactor ?factorNode .
                ?factorNode qudt:numericValue ?candidate ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER NOT EXISTS {
                    $this nltl:hasSpannedHullArea ?otherHullArea .
                    ?otherHullArea nltl:hullAreaFactor ?otherFactorNode .
                    ?otherFactorNode qudt:numericValue ?otherCandidate ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (?otherCandidate > ?candidate)
                }
                FILTER (
                    ABS(?reported - ?candidate) >
                    (0.000001 * ABS(?candidate) + 0.000000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-019-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-019-StructuralMemberShape>
    ] .
