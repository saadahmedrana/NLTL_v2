@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2_024_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasObliquePlatingInterpolationCase ;
        sh:class nltl:obliquePlatingInterpolationCase ;
        sh:minCount 1 ;
        sh:node gs:I2_024_ObliqueCaseShape ;
        sh:message "Each ship shall link an oblique plating interpolation case for this requirement."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:message "The ship shall link the calculation case used for the interpolation readiness record."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The oblique plating interpolation case shall be the calculation case linked by the ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasObliquePlatingInterpolationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?case .
                }
            }
        """
    ] .

gs:I2_024_ObliqueCaseShape
    a sh:NodeShape ;
    sh:class nltl:obliquePlatingInterpolationCase ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The framing angle shall be provided once in degrees."
    ] ;
    sh:property [
        sh:path nltl:interpolatedNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The externally calculated interpolated net plate thickness shall be provided once in millimetres."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_024_InterpolationPointShape ;
        sh:message "The interpolation case shall provide one lower interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_024_InterpolationPointShape ;
        sh:message "The interpolation case shall provide one upper interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The longitudinal framing net plate thickness operand shall be provided once in millimetres."
    ] ;
    sh:property [
        sh:path nltl:transverseFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The transverse framing net plate thickness operand shall be provided once in millimetres."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing angle for an oblique plating interpolation case shall satisfy 20 degrees < framing angle < 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:framingAngle ?angle .
                ?angle qudt:numericValue ?value .
                FILTER (?value <= 20 || ?value >= 70)
            }
        """
    ] .

gs:I2_024_InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ]
        ] ;
        sh:message "Each interpolation endpoint shall provide one dimensionless coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ]
        ] ;
        sh:message "Each interpolation endpoint shall provide one externally calculated result."
    ] .
