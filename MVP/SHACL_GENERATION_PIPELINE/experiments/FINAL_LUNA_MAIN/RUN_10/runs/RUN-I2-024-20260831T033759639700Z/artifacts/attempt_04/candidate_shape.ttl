@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoordinateQuantityShape ;
        sh:message "Each interpolation point must provide one dimensionless coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ResultQuantityShape ;
        sh:message "Each interpolation point must provide one interpolation result."
    ] .

gen:CoordinateQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:message "The interpolation point coordinate must use the unitless unit."
    ] .

gen:ResultQuantityShape
    a sh:NodeShape .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:longitudinalFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "The calculation case must provide one longitudinal framing net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:transverseFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "The calculation case must provide one transverse framing net plate thickness."
    ] .

gen:ObliquePlatingInterpolationCaseShape
    a sh:NodeShape ;
    sh:class nltl:obliquePlatingInterpolationCase ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape ;
        sh:message "An applicable oblique-plating case must provide one framing angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The oblique-plating interpolation case must provide one lower interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The oblique-plating interpolation case must provide one upper interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolatedNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "The applicable oblique-plating case must provide one interpolated net plate thickness in millimetres."
    ] ;
    sh:sparql [
        sh:message "The framing angle for obliquely-framed plating must be strictly between 20 and 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:framingAngle ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angle .
                FILTER (?angle <= 20 || ?angle >= 70)
            }
        """
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:message "The framing angle must use the degree unit."
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:message "The plate thickness must use the millimetre unit."
    ] .

gen:I2_024_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasObliquePlatingInterpolationCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasObliquePlatingInterpolationCase ;
                sh:minCount 1 ;
                sh:node gen:ObliquePlatingInterpolationCaseShape
            ] ;
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:minCount 1 ;
                sh:node gen:CalculationCaseShape
            ]
        ]
    ) .
