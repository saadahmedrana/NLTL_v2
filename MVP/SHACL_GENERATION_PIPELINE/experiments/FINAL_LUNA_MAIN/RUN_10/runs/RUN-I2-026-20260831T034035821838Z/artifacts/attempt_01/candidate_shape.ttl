@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gs:I2_026_StructuralMemberShape
    ] .

gs:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:class nltl:memberSupport ;
        sh:node gs:I2_026_MemberSupportShape
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue nltl:fixedFrameSupport ;
            ]
            [
                sh:hasValue nltl:simpleFrameSupport ;
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:continuousThroughSupport ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:fixedFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:connectionBracketPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:fixedFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:demonstratedRotationalRestraint ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:significantRotationalRestraintEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:fixedFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:terminatesWithinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:fixedFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:simpleFrameSupport
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A simple support condition is not conforming when continuity, a connection bracket, demonstrated rotational restraint, or termination within the ice-strengthened area requires fixity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:frameSupportCondition nltl:simpleFrameSupport .
                FILTER (
                    EXISTS {
                        $this nltl:continuousThroughSupport true .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasMemberSupport ?support .
                        ?support nltl:connectionBracketPresent true .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasMemberSupport ?support .
                        ?support nltl:demonstratedRotationalRestraint true .
                    }
                    ||
                    EXISTS {
                        $this nltl:terminatesWithinIceStrengthenedArea true .
                    }
                )
            }
        """
    ] .

gs:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .
