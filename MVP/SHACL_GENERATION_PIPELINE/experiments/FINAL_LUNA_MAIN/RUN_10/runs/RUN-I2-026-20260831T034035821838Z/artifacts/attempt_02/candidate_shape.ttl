@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_026_StructuralMemberShape ;
        sh:message "Each represented structural member must provide the support information needed to determine support fixity."
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The structural member must state whether it is continuous through the support."
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The structural member must state whether it terminates within the ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
        sh:message "The structural member must select either fixed support or simple support."
    ] ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:node gen:I2_026_MemberSupportShape ;
        sh:message "The structural member must identify its support condition inputs."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:fixedFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:simpleFrameSupport
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Support fixity must follow the continuous-member, connection-bracket, demonstrated-restraint, and ice-strengthened-area rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameSupportCondition ?condition ;
                      nltl:continuousThroughSupport ?continuous ;
                      nltl:terminatesWithinIceStrengthenedArea ?terminates .

                FILTER (
                    (
                        ?condition = nltl:simpleFrameSupport &&
                        (
                            ?terminates = true ||
                            ?continuous = true ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?bracketSupport .
                                ?bracketSupport nltl:connectionBracketPresent true .
                            } ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?restrainedSupport .
                                ?restrainedSupport nltl:demonstratedRotationalRestraint true ;
                                                   nltl:significantRotationalRestraintEvidence ?evidence .
                            } ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?evidenceSupport .
                                ?evidenceSupport nltl:significantRotationalRestraintEvidence ?anyEvidence .
                            }
                        )
                    )
                    ||
                    (
                        ?condition = nltl:fixedFrameSupport &&
                        !(
                            ?terminates = true ||
                            ?continuous = true ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?bracketSupport2 .
                                ?bracketSupport2 nltl:connectionBracketPresent true .
                            } ||
                            EXISTS {
                                $this nltl:hasMemberSupport ?restrainedSupport2 .
                                ?restrainedSupport2 nltl:demonstratedRotationalRestraint true ;
                                                    nltl:significantRotationalRestraintEvidence ?evidence2 .
                            }
                        )
                    )
                )
            }
        """
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The member support must state whether a connection bracket is present."
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The member support must state whether significant rotational restraint is demonstrated."
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Rotational-restraint evidence must be represented by an evidence artifact."
    ] .
