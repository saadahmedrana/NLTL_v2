@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_030_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_030_CalculationCaseShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each calculation case must be linked to its local-frame section case and structural member, and must contain the declared plastic neutral axis and section modulus results with their required operand relationships." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?cc .
                FILTER NOT EXISTS {
                    ?cc a nltl:calculationCase ;
                        nltl:plasticNeutralAxisHeight ?zna ;
                        nltl:interpolationLowerEndpoint ?lower ;
                        nltl:interpolationUpperEndpoint ?upper .
                    ?ccx nltl:sectionCalculationCaseStructuralMember ?sm .
                    ?sm nltl:hasLocalFrameSectionCalculationCase ?lfc ;
                        nltl:netEffectivePlasticSectionModulus ?zp ;
                        nltl:netLocalFrameFlangeArea ?afn ;
                        nltl:webHeight ?hw ;
                        nltl:netWebThickness ?twn ;
                        nltl:netAttachedShellPlateThickness ?tpn ;
                        nltl:frameSpacing ?s ;
                        nltl:localFrameFlangeCentreHeight ?hfc ;
                        nltl:webAngleToShellPlate ?phiw ;
                        nltl:webToFlangeCentreDistance ?bw .
                    ?lfc nltl:sectionCalculationCaseStructuralMember ?sm ;
                         nltl:sectionCalculationCasePlating ?pl .
                    ?pl nltl:framingAngleOmega ?omega .
                    ?afn qudt:numericValue ?afnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                    ?hw qudt:numericValue ?hwValue ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?twn qudt:numericValue ?twnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?tpn qudt:numericValue ?tpnValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?s qudt:numericValue ?sValue ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?hfc qudt:numericValue ?hfcValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?phiw qudt:numericValue ?phiwValue ;
                          qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    ?bw qudt:numericValue ?bwValue ;
                        qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?omega qudt:numericValue ?omegaValue ;
                           qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    ?zna qudt:numericValue ?znaValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?zp qudt:numericValue ?zpValue ;
                        qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                }
            }
        """
    ] .

gen:I2_030_CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        gen:I2_030_DirectBranchShape
        gen:I2_030_InterpolationBranchShape
    ) .

gen:I2_030_DirectBranchShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The direct-calculation branch requires selector operands and is applicable only when the local-frame area exceeds the attached-plate-flange area and the framing angle is outside the strict 20 to 70 degree interpolation interval." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        ?lfc nltl:sectionCalculationCaseStructuralMember ?sm ;
                             nltl:sectionCalculationCasePlating ?pl .
                        ?sm nltl:netLocalFrameFlangeArea ?afn ;
                            nltl:netAttachedShellPlateThickness ?tpn ;
                            nltl:frameSpacing ?s .
                        ?pl nltl:framingAngleOmega ?omega .
                        ?afn qudt:numericValue ?afnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                        ?tpn qudt:numericValue ?tpnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        ?s qudt:numericValue ?sValue ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?omega qudt:numericValue ?omegaValue ;
                               qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    }
                    ||
                    EXISTS {
                        ?lfc nltl:sectionCalculationCaseStructuralMember ?sm ;
                             nltl:sectionCalculationCasePlating ?pl .
                        ?sm nltl:netLocalFrameFlangeArea ?afn ;
                            nltl:netAttachedShellPlateThickness ?tpn ;
                            nltl:frameSpacing ?s .
                        ?pl nltl:framingAngleOmega ?omega .
                        ?afn qudt:numericValue ?afnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                        ?tpn qudt:numericValue ?tpnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        ?s qudt:numericValue ?sValue ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?omega qudt:numericValue ?omegaValue ;
                               qudt:unit <http://qudt.org/vocab/unit/DEG> .
                        FILTER (
                            !(
                                (100 * ?afnValue) >
                                (1000 * ?tpnValue * ?sValue)
                            )
                            ||
                            (
                                ?omegaValue > 20 &&
                                ?omegaValue < 70
                            )
                        )
                    }
                )
            }
        """
    ] .

gen:I2_030_InterpolationBranchShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:minCount 1 ;
        sh:node gen:I2_030_InterpolationPointShape
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:minCount 1 ;
        sh:node gen:I2_030_InterpolationPointShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The interpolation branch requires selector operands and is applicable only when the local-frame area exceeds the attached-plate-flange area and the framing angle is strictly between 20 and 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        ?lfc nltl:sectionCalculationCaseStructuralMember ?sm ;
                             nltl:sectionCalculationCasePlating ?pl .
                        ?sm nltl:netLocalFrameFlangeArea ?afn ;
                            nltl:netAttachedShellPlateThickness ?tpn ;
                            nltl:frameSpacing ?s .
                        ?pl nltl:framingAngleOmega ?omega .
                        ?afn qudt:numericValue ?afnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                        ?tpn qudt:numericValue ?tpnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        ?s qudt:numericValue ?sValue ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?omega qudt:numericValue ?omegaValue ;
                               qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    }
                    ||
                    EXISTS {
                        ?lfc nltl:sectionCalculationCaseStructuralMember ?sm ;
                             nltl:sectionCalculationCasePlating ?pl .
                        ?sm nltl:netLocalFrameFlangeArea ?afn ;
                            nltl:netAttachedShellPlateThickness ?tpn ;
                            nltl:frameSpacing ?s .
                        ?pl nltl:framingAngleOmega ?omega .
                        ?afn qudt:numericValue ?afnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                        ?tpn qudt:numericValue ?tpnValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                        ?s qudt:numericValue ?sValue ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?omega qudt:numericValue ?omegaValue ;
                               qudt:unit <http://qudt.org/vocab/unit/DEG> .
                        FILTER (
                            !(
                                (100 * ?afnValue) >
                                (1000 * ?tpnValue * ?sValue)
                            )
                            ||
                            !(
                                ?omegaValue > 20 &&
                                ?omegaValue < 70
                            )
                        )
                    }
                )
            }
        """
    ] .

gen:I2_030_InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:I2_030_StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_030_LocalFrameSectionCalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:node gen:I2_030_AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:node gen:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:node gen:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node gen:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node gen:I2_030_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:node gen:I2_030_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:node gen:I2_030_DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:node gen:I2_030_MillimetreQuantityShape
    ] .

gen:I2_030_LocalFrameSectionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:node gen:I2_030_PlatingShape
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember
    ] .

gen:I2_030_PlatingShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_030_DegreeQuantityShape
    ] .

gen:I2_030_AreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_030_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_030_MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_030_DegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
