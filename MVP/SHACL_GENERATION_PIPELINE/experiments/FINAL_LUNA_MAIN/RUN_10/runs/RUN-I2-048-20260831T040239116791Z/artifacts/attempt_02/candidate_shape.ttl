@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:hasValue nltl:polarClassPc1 ]
            [ sh:hasValue nltl:polarClassPc2 ]
            [ sh:hasValue nltl:polarClassPc3 ]
            [ sh:hasValue nltl:polarClassPc4 ]
            [ sh:hasValue nltl:polarClassPc5 ]
            [ sh:hasValue nltl:polarClassPc6 ]
            [ sh:hasValue nltl:polarClassPc7 ]
        )
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node [
            sh:property [
                sh:path nltl:steelGradeRequirementCasePlating ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:plating ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:asBuiltPlateThickness ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:steelMaterialClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelMaterialClassValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    [ sh:hasValue nltl:steelMaterialClassOne ]
                    [ sh:hasValue nltl:steelMaterialClassTwo ]
                    [ sh:hasValue nltl:steelMaterialClassThree ]
                )
            ] ;
            sh:property [
                sh:path nltl:steelStrengthCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelStrengthCategoryValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    [ sh:hasValue nltl:normalStrengthSteelCategory ]
                    [ sh:hasValue nltl:highTensileSteelCategory ]
                )
            ] ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:tableReferenceValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iacsUrI2Table8
            ] ;
            sh:property [
                sh:path nltl:actualHullStructuralSteelGrade ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelGradeValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:steelGradeOrderRank ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:requiredHullStructuralSteelGrade ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:steelGradeValue ;
                sh:node [
                    sh:property [
                        sh:path nltl:steelGradeOrderRank ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The Table 8 selection is missing, outside the applicable thickness range, uses the wrong grade family or rank, or omits the required grade for an applicable combination." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:asBuiltPlateThickness ?th ;
        nltl:steelMaterialClass ?mat ;
        nltl:steelStrengthCategory ?cat ;
        nltl:actualHullStructuralSteelGrade ?actual .

  ?th qudt:numericValue ?t .
  ?actual nltl:steelGradeOrderRank ?actualRank .

  OPTIONAL {
    $this nltl:requiredHullStructuralSteelGrade ?required .
    OPTIONAL { ?required nltl:steelGradeOrderRank ?requiredRank }
  }

  BIND(
    (
      ?t > 0 &&
      (
        (
          ?mat = nltl:steelMaterialClassOne &&
          ?cat = nltl:normalStrengthSteelCategory &&
          (
            (
              ?thisPolar = nltl:polarClassPc1 ||
              ?thisPolar = nltl:polarClassPc2 ||
              ?thisPolar = nltl:polarClassPc3 ||
              ?thisPolar = nltl:polarClassPc4 ||
              ?thisPolar = nltl:polarClassPc5
            ) &&
            ?t <= 10
          )
        )
      )
    ) AS ?unused
  )

  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?thisPolar .

  BIND(
    IF(
      (
        ?mat = nltl:steelMaterialClassOne &&
        ?cat = nltl:normalStrengthSteelCategory &&
        (
          (
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5) &&
            ?t > 0 && ?t <= 10
          ) ||
          (
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5) &&
            ?t > 10 && ?t <= 40
          ) ||
          (
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5) &&
            ?t > 40 && ?t <= 50
          ) ||
          (
            (?thisPolar = nltl:polarClassPc6 || ?thisPolar = nltl:polarClassPc7) &&
            ?t > 0 && ?t <= 30
          ) ||
          (
            (?thisPolar = nltl:polarClassPc6 || ?thisPolar = nltl:polarClassPc7) &&
            ?t > 30 && ?t <= 50
          )
        )
      ),
      IF(?t <= 10, nltl:steelGradeB,
        IF(
          (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
           ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
           ?thisPolar = nltl:polarClassPc5),
          IF(?t <= 40, nltl:steelGradeD, nltl:steelGradeE),
          IF(?t <= 30, nltl:steelGradeB, nltl:steelGradeD)
        )
      ),
      IF(
        ?mat = nltl:steelMaterialClassOne &&
        ?cat = nltl:highTensileSteelCategory &&
        (
          (
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5) &&
            ?t > 0 && ?t <= 10
          ) ||
          (
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5) &&
            ?t > 10 && ?t <= 40
          ) ||
          (
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5) &&
            ?t > 40 && ?t <= 50
          ) ||
          (
            (?thisPolar = nltl:polarClassPc6 || ?thisPolar = nltl:polarClassPc7) &&
            ?t > 0 && ?t <= 30
          ) ||
          (
            (?thisPolar = nltl:polarClassPc6 || ?thisPolar = nltl:polarClassPc7) &&
            ?t > 30 && ?t <= 50
          )
        ),
        IF(?t <= 10, nltl:steelGradeAh,
          IF(
            (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
             ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
             ?thisPolar = nltl:polarClassPc5),
            IF(?t <= 40, nltl:steelGradeDh, nltl:steelGradeEh),
            IF(?t <= 30, nltl:steelGradeAh, nltl:steelGradeDh)
          )
        ),
        IF(
          ?mat = nltl:steelMaterialClassTwo &&
          (
            ?cat = nltl:normalStrengthSteelCategory ||
            ?cat = nltl:highTensileSteelCategory
          ),
          IF(
            ?cat = nltl:normalStrengthSteelCategory,
            IF(
              (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
               ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
               ?thisPolar = nltl:polarClassPc5),
              IF(?t <= 10, nltl:steelGradeB,
                IF(?t <= 20, nltl:steelGradeD, nltl:steelGradeE)),
              IF(?t <= 15, nltl:steelGradeB,
                IF(?t <= 35, nltl:steelGradeD, nltl:steelGradeE))
            ),
            IF(
              (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
               ?thisPolar = nltl:polarClassPc3 || ?thisPolar = nltl:polarClassPc4 ||
               ?thisPolar = nltl:polarClassPc5),
              IF(?t <= 10, nltl:steelGradeAh,
                IF(?t <= 20, nltl:steelGradeDh, nltl:steelGradeEh)),
              IF(?t <= 15, nltl:steelGradeAh,
                IF(?t <= 35, nltl:steelGradeDh, nltl:steelGradeEh))
            )
          ),
          IF(
            ?mat = nltl:steelMaterialClassThree &&
            ?cat = nltl:normalStrengthSteelCategory,
            IF(
              (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
               ?thisPolar = nltl:polarClassPc3),
              nltl:steelGradeE,
              IF(
                (?thisPolar = nltl:polarClassPc4 || ?thisPolar = nltl:polarClassPc5),
                nltl:steelGradeE,
                IF(?thisPolar = nltl:polarClassPc6 || ?thisPolar = nltl:polarClassPc7,
                   IF(?t <= 30, nltl:steelGradeD, nltl:steelGradeE),
                   nltl:steelGradeB)
              )
            ),
            IF(
              ?mat = nltl:steelMaterialClassThree &&
              ?cat = nltl:highTensileSteelCategory,
              IF(
                (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
                 ?thisPolar = nltl:polarClassPc3),
                IF(?t <= 35, nltl:steelGradeEh, nltl:steelGradeFh),
                IF(
                  (?thisPolar = nltl:polarClassPc4 || ?thisPolar = nltl:polarClassPc5),
                  IF(?t <= 45, nltl:steelGradeEh, nltl:steelGradeFh),
                  IF(?t <= 30, nltl:steelGradeDh, nltl:steelGradeEh)
                )
              ),
              nltl:steelGradeB
            )
          )
        )
      )
    ) AS ?expected
  )

  FILTER(
    !(
      (
        (?mat = nltl:steelMaterialClassOne ||
         ?mat = nltl:steelMaterialClassTwo) &&
        ?t > 0 && ?t <= 50
      ) ||
      (
        ?mat = nltl:steelMaterialClassThree &&
        ?t > 0 && ?t <= 50 &&
        (
          ?cat = nltl:highTensileSteelCategory ||
          (
            ?cat = nltl:normalStrengthSteelCategory &&
            !(
              (?thisPolar = nltl:polarClassPc1 || ?thisPolar = nltl:polarClassPc2 ||
               ?thisPolar = nltl:polarClassPc3) && ?t > 35 ||
              (?thisPolar = nltl:polarClassPc4 || ?thisPolar = nltl:polarClassPc5) && ?t > 45
            )
          )
        )
      )
    )
    ||
    !BOUND(?required)
    ||
    !BOUND(?requiredRank)
    ||
    ?required != ?expected
    ||
    ?actualRank < ?requiredRank
    ||
    (
      ?cat = nltl:normalStrengthSteelCategory &&
      !(?actual = nltl:steelGradeB || ?actual = nltl:steelGradeD ||
        ?actual = nltl:steelGradeE)
    )
    ||
    (
      ?cat = nltl:highTensileSteelCategory &&
      !(?actual = nltl:steelGradeAh || ?actual = nltl:steelGradeDh ||
        ?actual = nltl:steelGradeEh || ?actual = nltl:steelGradeFh)
    )
  )
}
"""
            ]
        ]
    ] .
