@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_050_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengthCoefficientKI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:message "The ship must provide one ice strength coefficient k_I."
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AngleQuantityShape ;
        sh:message "The ship must provide one stem angle."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape ;
        sh:message "The ship must provide one upper ice waterline draught."
    ] ;
    sh:property [
        sh:path nltl:hullFormCoefficientKh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:message "The ship must provide one hull form coefficient k_h."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:crushingFailureClassFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:DimensionlessQuantityShape ;
                sh:message "Each table lookup case must provide one crushing failure class factor."
            ] ;
            sh:property [
                sh:path nltl:flexuralFailureClassFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:DimensionlessQuantityShape ;
                sh:message "Each table lookup case must provide one flexural failure class factor."
            ] ;
            sh:property [
                sh:path nltl:longitudinalStrengthClassFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:DimensionlessQuantityShape ;
                sh:message "Each table lookup case must provide one longitudinal strength class factor."
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape ;
        sh:message "The ship must provide the externally calculated design vertical ice force at the bow."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateOne ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape ;
        sh:message "The ship must provide the externally calculated first candidate bow ice force."
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateTwo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape ;
        sh:message "The ship must provide the externally calculated second candidate bow ice force."
    ] .

gs:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gs:AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gs:ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN>
    ] .
