@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:I2-052-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-CalculationCaseShape ;
        sh:message "The ship must provide a calculation case for the linear interpolation readiness record."
    ] ;
    sh:property [
        sh:path nltl:interpolatedValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must provide the externally recorded interpolated value."
    ] .

nltlgen:I2-052-CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-LengthQuantityShape ;
        sh:message "The calculation case must provide the hull girder longitudinal position from aft."
    ] ;
    sh:property [
        sh:path nltl:interpolatedLongitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-UnitlessQuantityShape ;
        sh:message "The calculation case must provide the interpolated longitudinal distribution factor."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-InterpolationPointShape ;
        sh:message "The calculation case must provide a lower interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-InterpolationPointShape ;
        sh:message "The calculation case must provide the intermediate interpolation point."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-InterpolationPointShape ;
        sh:message "The calculation case must provide an upper interpolation endpoint."
    ] ;
    sh:sparql [
        sh:message "The lower, intermediate, and upper interpolation coordinates and their paired values must be represented on the same calculation case, with strict lower-to-intermediate-to-upper coordinate ordering." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:interpolationLowerEndpoint ?lower .
                ?this nltl:hasInterpolationPoint ?intermediate .
                ?this nltl:interpolationUpperEndpoint ?upper .

                ?lower nltl:interpolationCoordinate ?lowerCoordinateNode .
                ?lower nltl:interpolationPointValue ?lowerValueNode .
                ?lowerCoordinateNode qudt:numericValue ?lowerCoordinate .
                ?lowerValueNode qudt:numericValue ?lowerValue .

                ?intermediate nltl:interpolationCoordinate ?intermediateCoordinateNode .
                ?intermediate nltl:interpolationPointValue ?intermediateValueNode .
                ?intermediateCoordinateNode qudt:numericValue ?intermediateCoordinate .
                ?intermediateValueNode qudt:numericValue ?intermediateValue .

                ?upper nltl:interpolationCoordinate ?upperCoordinateNode .
                ?upper nltl:interpolationPointValue ?upperValueNode .
                ?upperCoordinateNode qudt:numericValue ?upperCoordinate .
                ?upperValueNode qudt:numericValue ?upperValue .

                FILTER (
                    ?lowerCoordinate >= ?intermediateCoordinate ||
                    ?intermediateCoordinate >= ?upperCoordinate
                )
            }
        """
    ] .

nltlgen:I2-052-InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationCoordinate ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-CoordinateQuantityShape ;
        sh:message "Each interpolation point must provide an interpolation coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointValue ;
        sh:minCount 1 ;
        sh:node nltlgen:I2-052-GenericQuantityShape ;
        sh:message "Each interpolation point must provide its paired interpolation point value."
    ] .

nltlgen:I2-052-LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:maxCount 1 ;
        sh:minCount 1
    ] .

nltlgen:I2-052-UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:maxCount 1 ;
        sh:minCount 1
    ] .

nltlgen:I2-052-CoordinateQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] .

nltlgen:I2-052-GenericQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] .
