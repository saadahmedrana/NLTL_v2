@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix qudt: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:I2-054-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:equals nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:hasInterpolationPoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class q:QuantityValue ;
                            sh:property [
                                sh:path q:numericValue ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path q:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue qudt:UNITLESS
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class q:QuantityValue ;
                            sh:property [
                                sh:path q:numericValue ;
                                sh:minCount 1
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:minCount 1 ;
        sh:equals nltl:hasCalculationCase ;
        sh:node [
            sh:class nltl:hullGirderBendingMomentCalculationCase ;
            sh:property [
                sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue qudt:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:caseBendingMomentDistributionFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue qudt:UNITLESS
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:caseDesignVerticalIceBendingMoment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class q:QuantityValue ;
                    sh:property [
                        sh:path q:numericValue ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue qudt:MegaN-M
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class q:QuantityValue ;
            sh:property [
                sh:path q:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path q:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class q:QuantityValue ;
            sh:property [
                sh:path q:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path q:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:DEG
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class q:QuantityValue ;
            sh:property [
                sh:path q:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path q:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:MegaN
            ]
        ]
    ] ;
    sh:message "The ship must provide one coherent externally calculated hull-girder bending-moment case with required inputs, interpolation points, and result." .
