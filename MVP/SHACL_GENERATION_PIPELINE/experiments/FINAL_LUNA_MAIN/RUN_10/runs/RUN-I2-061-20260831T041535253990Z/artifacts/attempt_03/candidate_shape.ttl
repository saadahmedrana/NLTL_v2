@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-061-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape>
    ] .

<urn:nltl:generated-shape:I2-061-CalculationCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationCaseAssessedHullStructure ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:hullStructure ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable shell-plating or local-frame hull structure, the prescribed analytical procedure is required, direct calculation may not be used, and thickness must be present as a decimal quantity in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:calculationCaseAssessedHullStructure ?hullStructure .
                ?hullStructure rdf:type ?scopeType .
                FILTER (
                    ?scopeType = nltl:plating ||
                    ?scopeType = nltl:structuralMember
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:calculationMethod
                            nltl:prescribedAnalyticalProcedure
                    }
                    ||
                    EXISTS {
                        $this nltl:calculationMethod
                            nltl:directCalculationMethodValue
                    }
                    ||
                    NOT EXISTS {
                        ?hullStructure nltl:thickness ?quantity
                    }
                    ||
                    EXISTS {
                        ?hullStructure nltl:thickness ?quantity .
                        FILTER (
                            !isIRI(?quantity) ||
                            NOT EXISTS {
                                ?quantity qudt:numericValue ?numericValue ;
                                          qudt:unit qudt:M .
                                FILTER (datatype(?numericValue) = xsd:decimal)
                            } ||
                            EXISTS {
                                ?quantity qudt:unit ?unit .
                                FILTER (?unit != qudt:M)
                            }
                        )
                    }
                )
            }
        """
    ] .
