@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_064_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A calculation case with the explicitly selected linear calculation method is required to establish applicability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?linearCase .
                    ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable linear calculation, yield strength must be a decimal quantity in MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?linearCase .
                ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:yieldStrength ?yieldQuantity .
                    ?yieldQuantity qudt:numericValue ?yieldValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (datatype(?yieldValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable linear calculation, each structural member web must provide nominal shear stress as a decimal quantity in MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?linearCase .
                ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb ?web .
                FILTER NOT EXISTS {
                    ?web nltl:nominalShearStress ?stressQuantity .
                    ?stressQuantity qudt:numericValue ?stressValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (datatype(?stressValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable linear calculation, each structural member flange must provide nominal von Mises stress as a decimal quantity in MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?linearCase .
                ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange ?flange .
                FILTER NOT EXISTS {
                    ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
                    ?stressQuantity qudt:numericValue ?stressValue ;
                                    qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (datatype(?stressValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Nominal web shear stress must be strictly less than yield strength divided by sqrt(3) for linear calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?linearCase .
                ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb ?web .
                ?web nltl:nominalShearStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                FILTER (datatype(?yieldValue) = xsd:decimal)
                FILTER (datatype(?stressValue) = xsd:decimal)
                FILTER (?stressValue >= (?yieldValue / 1.7320508075688772))
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Nominal flange von Mises stress must be strictly less than 1.15 times yield strength for linear calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?linearCase .
                ?linearCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange ?flange .
                ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue ;
                                qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                FILTER (datatype(?yieldValue) = xsd:decimal)
                FILTER (datatype(?stressValue) = xsd:decimal)
                FILTER (?stressValue >= (1.15 * ?yieldValue))
            }
        """
    ] .

gen:I2_064_HullStructureShape
    a sh:NodeShape ;
    sh:targetClass nltl:hullStructure ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Applicable hull structures must satisfy the buckling criteria."
    ] .
