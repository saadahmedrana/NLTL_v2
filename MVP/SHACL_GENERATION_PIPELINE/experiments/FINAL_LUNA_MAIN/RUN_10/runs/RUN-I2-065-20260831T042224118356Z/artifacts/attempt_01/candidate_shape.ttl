@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2_065_QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_065_MarginValueShape
    a sh:NodeShape ;
    sh:node nltl:I2_065_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_065_LengthValueShape
    a sh:NodeShape ;
    sh:node nltl:I2_065_QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:I2_065_NonlinearCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:class nltl:calculationMethodValue ;
        sh:hasValue nltl:nonlinearCalculationMethodValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A nonlinear calculation case must identify the nonlinear calculation method."
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "A nonlinear calculation case must provide acceptance evidence."
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The minor permanent deformation assessment must be explicitly satisfied."
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:node nltl:I2_065_LengthValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A nonlinear calculation case must provide the permanent lateral deformation."
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:node nltl:I2_065_LengthValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A nonlinear calculation case must provide the permanent out-of-plane deformation."
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:node nltl:I2_065_LengthValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A nonlinear calculation case must provide the relevant structural dimension."
    ] .

nltl:I2_065_OtherMethodCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:or (
        [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:class nltl:calculationMethodValue ;
                sh:hasValue nltl:directCalculationMethodValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:class nltl:calculationMethodValue ;
                sh:hasValue nltl:linearCalculationMethodValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:class nltl:calculationMethodValue ;
                sh:hasValue nltl:prescribedAnalyticalProcedure ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .

nltl:I2_065_CalculationCaseShape
    a sh:NodeShape ;
    sh:or (
        [ sh:node nltl:I2_065_NonlinearCaseShape ]
        [ sh:node nltl:I2_065_OtherMethodCaseShape ]
    ) .

nltl:I2_065_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:class nltl:calculationCase ;
                sh:minCount 1 ;
                sh:node nltl:I2_065_CalculationCaseShape
            ] ;
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:class nltl:calculationCase ;
                sh:node [
                    sh:property [
                        sh:path nltl:calculationMethod ;
                        sh:hasValue nltl:nonlinearCalculationMethodValue ;
                        sh:minCount 1
                    ]
                ] ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:fractureMargin ;
                sh:node nltl:I2_065_MarginValueShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A nonlinear evaluation must provide the fracture margin."
            ] ;
            sh:property [
                sh:path nltl:majorBucklingMargin ;
                sh:node nltl:I2_065_MarginValueShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A nonlinear evaluation must provide the major buckling margin."
            ] ;
            sh:property [
                sh:path nltl:yieldingMargin ;
                sh:node nltl:I2_065_MarginValueShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A nonlinear evaluation must provide the yielding margin."
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasCalculationCase ;
                sh:class nltl:calculationCase ;
                sh:minCount 1 ;
                sh:node nltl:I2_065_OtherMethodCaseShape
            ]
        ]
    ) .
