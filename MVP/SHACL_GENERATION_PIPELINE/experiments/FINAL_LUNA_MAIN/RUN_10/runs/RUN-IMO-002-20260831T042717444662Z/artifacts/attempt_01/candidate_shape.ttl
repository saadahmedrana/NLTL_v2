@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-002-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide exactly one design ice condition, including the applicable thin first-year ice condition." ;
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide exactly one Polar Code ship category to establish applicability." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
            ] ;
            sh:sparql [
                sh:message "A non-category-A ship designed for at least thin first-year ice must be category B." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    SELECT $this
                    WHERE {
                        $this nltl:designIceCondition nltl:thinFirstYearIceWithPossibleOldIceInclusions .
                    }
                """ ;
            ]
        ]
    ) .
