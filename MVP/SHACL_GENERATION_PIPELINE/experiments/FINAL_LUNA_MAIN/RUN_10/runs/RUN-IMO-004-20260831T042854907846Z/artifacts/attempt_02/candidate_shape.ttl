@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_004_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOriginType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:hasValue nltl:seaIceOrigin
                ]
            ] ;
            sh:property [
                sh:path nltl:winterGrowthCount ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:maxInclusive 1
            ] ;
            sh:property [
                sh:path nltl:iceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "0.3"^^xsd:decimal ;
                        sh:maxInclusive "2.0"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:hasValue nltl:firstYearIce
                ]
            ]
        ]
        [
            sh:sparql [
                sh:message "When the sea-ice, winter-growth, and thickness conditions apply, ice type must be first-year ice." ;
                sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#> PREFIX qudt: <http://qudt.org/schema/qudt/> PREFIX unit: <http://qudt.org/vocab/unit/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this nltl:iceOriginType nltl:seaIceOrigin . $this nltl:winterGrowthCount ?growth . FILTER(?growth <= \"1\"^^xsd:integer) . $this nltl:iceThickness ?thicknessNode . ?thicknessNode qudt:numericValue ?thickness ; qudt:unit unit:M . FILTER(?thickness >= \"0.3\"^^xsd:decimal && ?thickness <= \"2.0\"^^xsd:decimal) }"
            ]
        ]
    ) .
