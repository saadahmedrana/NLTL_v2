@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_007_OpenWaterShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:hasValue nltl:openWaterIceCondition ;
                sh:message "The ship's ice condition classification must identify open water for the open-water constraints to apply."
            ] ;
            sh:property [
                sh:path nltl:seaIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:maxExclusive 1 ;
                        sh:message "For open water, sea ice concentration must be less than 1/10."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Sea ice concentration must use the unitless unit."
                    ]
                ] ;
                sh:message "Open water requires a unitless sea ice concentration less than 1/10."
            ] ;
            sh:property [
                sh:path nltl:iceOfLandOriginPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "For open water, ice of land origin must not be present."
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:in (
                    nltl:iceConditionLessSevereThanCategoryAAndB
                    nltl:iceFreeIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                    nltl:otherWatersIceCondition
                    nltl:thinFirstYearIceWithPossibleOldIceInclusions
                ) ;
                sh:message "The ship's ice condition classification must identify a permitted non-open-water condition when the open-water constraints do not apply."
            ]
        ]
    ) .
