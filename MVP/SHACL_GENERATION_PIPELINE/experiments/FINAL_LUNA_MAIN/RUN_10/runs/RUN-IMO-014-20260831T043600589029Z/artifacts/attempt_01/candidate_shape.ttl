@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-014-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must state whether the Polar Code applies."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-014-AppliesBranch>
        <urn:nltl:generated-shape:IMO-014-DoesNotApplyBranch>
    ) .

<urn:nltl:generated-shape:IMO-014-AppliesBranch> a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeApplies ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarShipCertificatePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship to which the Polar Code applies must have a Polar Ship Certificate."
    ] ;
    sh:property [
        sh:path nltl:polarShipCertificateStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate must be valid."
    ] .

<urn:nltl:generated-shape:IMO-014-DoesNotApplyBranch> a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeApplies ;
        sh:hasValue false
    ] .
