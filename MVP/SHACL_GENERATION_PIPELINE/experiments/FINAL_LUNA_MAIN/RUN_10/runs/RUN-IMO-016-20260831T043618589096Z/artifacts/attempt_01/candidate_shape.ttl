@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-016-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-016-CertificateShape> ;
        sh:message "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The certificate language shall be recorded exactly once."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:hasValue "English" ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:hasValue "French" ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:hasValue "Spanish" ;
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:certificateLanguage ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:approvedTranslationPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "A translation into English, French, or Spanish is required when another certificate language is used."
                    ]
                ]
                [
                    sh:sparql [
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX sh: <http://www.w3.org/ns/shacl#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                FILTER NOT EXISTS {
                                    $this nltl:certificateLanguage ?language ;
                                          nltl:approvedTranslationPresent ?translation .
                                    FILTER (?language NOT IN ("English", "French", "Spanish"))
                                    FILTER (?translation = true)
                                }
                            }
                        """
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:IMO-016-CertificateShape>
    a sh:NodeShape ;
    sh:class nltl:polarShipCertificateForm ;
    sh:property [
        sh:path nltl:certificateFormModel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:certificateFormModelValue ;
        sh:hasValue nltl:appendixIPolarShipCertificateModel ;
        sh:message "The Polar Ship Certificate form model shall be the Appendix I model."
    ] .
