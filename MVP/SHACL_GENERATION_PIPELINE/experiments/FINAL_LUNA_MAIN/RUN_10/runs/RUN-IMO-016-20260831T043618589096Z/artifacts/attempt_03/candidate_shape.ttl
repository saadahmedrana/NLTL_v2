@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO016StaticShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:polarShipCertificateForm ;
            sh:property [
                sh:path nltl:certificateFormModel ;
                sh:minCount 1 ;
                sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                sh:message "The Polar Ship Certificate form shall correspond to the Appendix I model."
            ]
        ] ;
        sh:message "A Polar Ship Certificate form corresponding to the Appendix I model is required."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:in ( "English" "French" "Spanish" )
            ]
            [
                sh:not [
                    sh:in ( "English" "French" "Spanish" )
                ] ;
                sh:property [
                    sh:path nltl:approvedTranslationPresent ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:hasValue true ;
                    sh:message "A certificate language other than English, French, or Spanish requires an approved translation."
                ]
            ]
        ) ;
        sh:message "The certificate language shall be English, French, or Spanish, or an approved translation shall be present for another language."
    ] .
