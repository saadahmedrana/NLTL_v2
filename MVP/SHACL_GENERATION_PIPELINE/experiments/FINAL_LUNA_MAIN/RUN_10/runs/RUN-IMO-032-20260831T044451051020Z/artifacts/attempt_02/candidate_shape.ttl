@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO032ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO032CategoryABBranch
        gen:IMO032CategoryCBranch
    ) .

gen:IMO032CategoryABBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:message "The ship category must be Category A or Category B for this approval branch."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:class nltl:approvalRecord ;
        sh:node gen:IMO032CategoryABApprovalRecord ;
        sh:message "An approval record meeting the Category A/B approval policy is required."
    ] .

gen:IMO032CategoryCBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:message "The ship category must be Category C for this approval branch."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The Category C branch requires the ship to be recorded as ice strengthened."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:class nltl:approvalRecord ;
        sh:node gen:IMO032CategoryCApprovalRecord ;
        sh:message "An approval record meeting the ice-strengthened Category C approval policy is required."
    ] .

gen:IMO032CategoryABApprovalRecord
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "The scantling approval status must be approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "The approval must be by the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:message "The approval standard must be acceptable to the Organization or offer an equivalent level of safety."
    ] .

gen:IMO032CategoryCApprovalRecord
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "The scantling approval status must be approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "The approval must be by the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "acceptable standard adequate for operating ice type and concentration"
        ) ;
        sh:message "The Category C approval standard must be acceptable and adequate for the operating ice type and concentration."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The Category C approval record must specify the operating ice type."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:node gen:IMO032IceConcentrationQuantity ;
        sh:message "The Category C approval record must specify the operating ice concentration."
    ] .

gen:IMO032IceConcentrationQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "The operating ice concentration must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS ;
        sh:message "The operating ice concentration must use the unitless unit."
    ] .
