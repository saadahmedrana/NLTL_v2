@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-040-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:message "When supplied, ice accretion applicability must be a boolean."
    ] ;
    sh:property [
        sh:path nltl:hasRelevantHatchOrDoor ;
        sh:class nltl:relevantHatchOrDoorItem ;
        sh:message "Each linked relevant hatch or door must be a relevant hatch or door item."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ice accretion is explicitly likely, every relevant hatch or door must have at least one associated ice or snow removal or prevention means of the canonical means type." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRelevantHatchOrDoor ?hatch .
                FILTER (
                    NOT EXISTS {
                        ?hatch nltl:hasIceOrSnowRemovalOrPreventionMeans ?means
                    }
                    ||
                    EXISTS {
                        ?hatch nltl:hasIceOrSnowRemovalOrPreventionMeans ?invalidMeans .
                        FILTER NOT EXISTS {
                            ?invalidMeans a nltl:iceSnowRemovalOrPreventionMeans
                        }
                    }
                )
            }
        """
    ] .
