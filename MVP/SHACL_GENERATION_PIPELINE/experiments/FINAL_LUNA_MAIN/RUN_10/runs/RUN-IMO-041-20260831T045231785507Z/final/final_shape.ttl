@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-041> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:openingActuationType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Opening actuation type is required to determine applicability of the hydraulic-fluid protection requirement."
    ] ;
    sh:property [
        sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "A ship with hydraulically operated hatches or doors shall record hydraulic-fluid freezing or excessive-viscosity control as present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:openingActuationType ?actuationType .
                FILTER(?actuationType = "hydraulic")
                FILTER NOT EXISTS {
                    $this nltl:hydraulicFluidFreezingOrViscosityControlPresent ?controlPresent .
                    FILTER(datatype(?controlPresent) = xsd:boolean && ?controlPresent = true)
                }
            }
        """
    ] .
