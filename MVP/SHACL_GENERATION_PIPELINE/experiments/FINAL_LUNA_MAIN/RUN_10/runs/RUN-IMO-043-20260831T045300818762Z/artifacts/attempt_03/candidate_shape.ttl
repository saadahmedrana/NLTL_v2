@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_043_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node gen:IMO_043_MachineryInstallationShape ;
        sh:message "Each represented machinery installation must satisfy the applicable hazard coverage constraints."
    ] .

gen:IMO_043_MachineryInstallationShape
    a sh:NodeShape ;
    sh:class nltl:machineryInstallationItem ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:node [
            sh:class nltl:associatedEquipmentItem
        ] ;
        sh:message "Each represented machinery installation must identify its associated equipment."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:in (
            nltl:iceAccretionHazard
            nltl:snowAccumulationHazard
            nltl:seawaterIceIngestionHazard
            nltl:liquidFreezingOrViscosityIncreaseHazard
            nltl:seawaterIntakeTemperatureHazard
            nltl:snowIngestionHazard
        ) ;
        sh:message "Each applicable hazard must be one of the six declared canonical hazard values."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:minCount 1 ;
        sh:message "Each machinery installation with applicable hazards must have hazard-protection evidence."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every associated equipment and applicable hazard combination on a machinery installation must be covered by hazard-protection evidence for that installation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>

            SELECT $this
            WHERE {
                $this nltl:hasAssociatedEquipment ?equipment .
                $this nltl:hasApplicableHazard ?hazard .
                FILTER (?hazard IN (
                    nltl:iceAccretionHazard,
                    nltl:snowAccumulationHazard,
                    nltl:seawaterIceIngestionHazard,
                    nltl:liquidFreezingOrViscosityIncreaseHazard,
                    nltl:seawaterIntakeTemperatureHazard,
                    nltl:snowIngestionHazard
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasHazardProtectionEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] .
