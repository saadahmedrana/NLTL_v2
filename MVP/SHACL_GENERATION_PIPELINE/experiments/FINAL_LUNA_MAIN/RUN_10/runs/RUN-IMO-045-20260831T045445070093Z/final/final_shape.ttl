@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-045> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machinerySeawaterSupply ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceIngestionPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A machinery seawater supply must have ice-ingestion prevention or an approved alternate functionality arrangement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:machinerySeawaterSupply true .
                FILTER NOT EXISTS {
                    $this nltl:iceIngestionPreventionPresent true .
                }
                FILTER NOT EXISTS {
                    $this nltl:alternateFunctionalityArrangementApprovalStatus
                          nltl:evidenceStateApproved .
                }
            }
        """
    ] .
