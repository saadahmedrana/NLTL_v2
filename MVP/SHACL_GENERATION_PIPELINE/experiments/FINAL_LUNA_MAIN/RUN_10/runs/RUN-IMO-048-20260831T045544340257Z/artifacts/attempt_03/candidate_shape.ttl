@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO048Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:exposedMachineryOrFoundationMaterial ;
        sh:datatype xsd:string ;
        sh:message "Each represented exposed machinery or foundation material must be recorded as a string."
    ] ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:node [
            sh:class nltl:approvalEvidence
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each approval evidence record must use an authorized approving authority, an authorized approval standard, approved status, and a polar service temperature in degrees Celsius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasEvidence ?approval .
                ?approval a nltl:approvalEvidence .
                FILTER (
                    NOT EXISTS {
                        ?approval nltl:approvingAuthority ?authority .
                        FILTER ( ?authority IN (
                            "Administration",
                            "recognized organization accepted by the Administration"
                        ) )
                    }
                    ||
                    NOT EXISTS {
                        ?approval nltl:approvalStandard ?standard .
                        FILTER ( ?standard IN (
                            "standard acceptable to the Organization",
                            "another standard offering an equivalent level of safety"
                        ) )
                    }
                    ||
                    NOT EXISTS {
                        ?approval nltl:materialApprovalStatus nltl:evidenceStateApproved
                    }
                    ||
                    NOT EXISTS {
                        ?approval nltl:polarServiceTemperature ?pst .
                        ?pst qudt:unit unit:DEG_C .
                        ?pst qudt:numericValue ?pstValue .
                        FILTER ( datatype(?pstValue) = xsd:decimal )
                    }
                )
            }
        """
    ] .
