@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-053-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:intendedOperationCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record that its extinguishing media are approved for the intended operation."
    ] ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:node <urn:nltl:generated-shape:IMO-053-ExtinguishingMediumItemShape>
    ] .

<urn:nltl:generated-shape:IMO-053-ExtinguishingMediumItemShape>
    a sh:NodeShape ;
    sh:class nltl:extinguishingMediumItem .
