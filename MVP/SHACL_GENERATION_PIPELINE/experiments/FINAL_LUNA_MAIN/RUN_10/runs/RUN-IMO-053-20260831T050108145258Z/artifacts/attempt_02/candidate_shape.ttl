@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-053-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:node <urn:nltl:generated-shape:IMO-053-ExtinguishingMediumItemShape> ;
        sh:message "Each linked extinguishing medium must have approved intended-operation compatibility."
    ] .

<urn:nltl:generated-shape:IMO-053-ExtinguishingMediumItemShape>
    a sh:NodeShape ;
    sh:targetClass nltl:extinguishingMediumItem ;
    sh:property [
        sh:path nltl:extinguishingMediumCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The extinguishing medium must have approved compatibility for the intended operation."
    ] .
