@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_055_Static_ConditionalShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Valve exposure status is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Valve type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Exposed isolating, pressure, or vacuum valves shall have ice accretion protection and remain continuously accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:valveExposed ?exposed ;
                      nltl:valveType ?type .

                FILTER (?exposed = true)
                FILTER (STR(?type) IN ("isolating", "pressure", "vacuum"))

                FILTER (
                    NOT EXISTS {
                        $this nltl:iceAccretionProtectionPresent true
                    }
                    || EXISTS {
                        $this nltl:iceAccretionProtectionPresent false
                    }
                    || NOT EXISTS {
                        $this nltl:continuouslyAccessible true
                    }
                    || EXISTS {
                        $this nltl:continuouslyAccessible false
                    }
                )
            }
        """
    ] .
