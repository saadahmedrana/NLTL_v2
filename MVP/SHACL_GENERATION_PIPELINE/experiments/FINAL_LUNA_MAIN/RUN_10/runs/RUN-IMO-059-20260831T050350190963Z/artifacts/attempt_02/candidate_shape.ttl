@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-059-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:node [
            a sh:NodeShape ;
            sh:class nltl:firefighterOutfitItem ;
            sh:property [
                sh:path nltl:hasStorageLocation ;
                sh:minCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class nltl:physicalStorageLocation ;
                    sh:property [
                        sh:path nltl:storageTemperatureClass ;
                        sh:minCount 1 ;
                        sh:node [
                            a sh:NodeShape ;
                            sh:class nltl:storageTemperatureClassValue ;
                            sh:hasValue nltl:warmStorageLocation ;
                            sh:message "The firefighter outfit storage location must be classified as warm."
                        ]
                    ]
                ] ;
                sh:message "Each firefighter outfit must have a storage location with a temperature classification."
            ]
        ]
    ] .
