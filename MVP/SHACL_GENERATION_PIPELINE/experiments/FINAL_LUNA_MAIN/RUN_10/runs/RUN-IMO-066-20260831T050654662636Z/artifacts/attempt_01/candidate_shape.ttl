@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_066_StaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship exposure-to-ice-accretion applicability value is required and must be a single boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:escapeRouteProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "An escape route must have associated means to remove or prevent ice and snow accretion."
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:musterStationProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "A muster station must have associated means to remove or prevent ice and snow accretion."
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:embarkationAreaProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "An embarkation area must have associated means to remove or prevent ice and snow accretion."
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:survivalCraftProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "A survival craft must have associated means to remove or prevent ice and snow accretion."
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:launchingApplianceProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "A launching appliance must have associated means to remove or prevent ice and snow accretion."
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:survivalCraftAccessProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "Access to a survival craft must have associated means to remove or prevent ice and snow accretion."
                    ]
                ] ;
                sh:qualifiedMinCount 1
            ]
        ]
    ) .
