@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PassengerTrainingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:personalSurvivalEquipmentInstructionCompleted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each linked passenger must have completed personal-survival-equipment instruction."
    ] .

gs:CrewTrainingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:personalAndGroupSurvivalEquipmentTrainingCompleted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each linked crew member must have completed personal and group survival-equipment training."
    ] .

gs:IMO078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPassenger ;
        sh:node gs:PassengerTrainingShape
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:node gs:CrewTrainingShape
    ] .
