@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-083-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-accretion applicability value must be recorded as a single boolean." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:node <urn:nltl:generated-shape:IMO-083-AntennaShape> ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false ;
            ] ;
        ]
    ) .

<urn:nltl:generated-shape:IMO-083-AntennaShape>
    a sh:NodeShape ;
    sh:class nltl:navigationOrCommunicationAntenna ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each required navigation or communication antenna must have means to prevent ice accumulation when ice accretion is likely." ;
    ] .
