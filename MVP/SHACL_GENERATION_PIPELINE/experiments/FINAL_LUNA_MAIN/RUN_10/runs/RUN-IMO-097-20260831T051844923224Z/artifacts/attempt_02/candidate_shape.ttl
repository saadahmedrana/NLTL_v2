@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO097ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltl:IMO097ApplicableShipShape
        nltl:IMO097NonApplicableShipShape
    ) .

nltl:IMO097ApplicableShipShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship subject to the low-air-temperature rule must explicitly indicate true applicability."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
        sh:class nltl:lifeboat ;
        sh:minCount 1 ;
        sh:node nltl:IMO097ReleasedLifeboatShape ;
        sh:message "Each applicable released rescue boat or lifeboat must be represented."
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:class nltl:lifeboat ;
        sh:minCount 1 ;
        sh:node nltl:IMO097ReleasedLifeboatShape ;
        sh:message "The applicable lifeboat relationship must be represented."
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft ;
        sh:minCount 1 ;
        sh:message "The declared survival-craft relationship must be represented."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:class nltl:survivalCraft ;
        sh:minCount 1 ;
        sh:node nltl:IMO097SurvivalCraftShape ;
        sh:message "Applicable survival craft must expose the declared communication-device relationships."
    ] .

nltl:IMO097NonApplicableShipShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A ship outside the low-air-temperature rule must explicitly indicate false applicability."
    ] .

nltl:IMO097ReleasedLifeboatShape a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:class nltl:equipmentItem ;
        sh:minCount 1 ;
        sh:message "Each applicable released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] .

nltl:IMO097SurvivalCraftShape a sh:NodeShape ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must carry at least one on-scene transmit/receive communication device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must carry at least one ship-to-shore distress-alert device."
    ] .
