@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_103_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or ( gen:IMO_103_AlternateFalse gen:IMO_103_AlternateTrue ) .

gen:IMO_103_AlternateFalse
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "alternateQualifiedPersonUsed must be false when the alternative qualified person provision is not used."
    ] .

gen:IMO_103_AlternateTrue
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:administrationPermissionStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Administration permission must be approved when an alternate qualified person is used."
    ] ;
    sh:property [
        sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "STCW Convention regulation II/2 compliance is required for an alternate qualified person."
    ] ;
    sh:property [
        sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "STCW Code section A-II/2 compliance is required for an alternate qualified person."
    ] ;
    sh:property [
        sh:path nltl:advancedPolarTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Advanced polar training is required for an alternate qualified person."
    ] ;
    sh:property [
        sh:path nltl:watchCoverageStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Sufficient trained persons must cover all watches."
    ] ;
    sh:property [
        sh:path nltl:restComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The alternate qualified person must satisfy the applicable minimum rest requirements."
    ] ;
    sh:or (
        gen:IMO_103_PassengerOpenOrBergy
        gen:IMO_103_PassengerOtherWater
        gen:IMO_103_TankerOpenOrBergy
        gen:IMO_103_TankerOtherWater
        gen:IMO_103_CargoLowIce
        gen:IMO_103_CargoHighIce
        gen:IMO_103_OtherShipType
    ) .

gen:IMO_103_PassengerOpenOrBergy
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "passenger ship" )
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "open waters" "bergy waters" )
    ] .

gen:IMO_103_PassengerOtherWater
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "passenger ship" )
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^(?!(open waters|bergy waters)$).+"
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on passenger ships must meet the applicable basic training requirements in waters other than open or bergy waters."
    ] .

gen:IMO_103_TankerOpenOrBergy
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "tanker" )
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "open waters" "bergy waters" )
    ] .

gen:IMO_103_TankerOtherWater
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "tanker" )
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^(?!(open waters|bergy waters)$).+"
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on tankers must meet the applicable basic training requirements in waters other than open or bergy waters."
    ] .

gen:IMO_103_CargoLowIce
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "cargo ship other than tanker" )
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive "0.2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:IMO_103_CargoHighIce
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "cargo ship other than tanker" )
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0.2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on cargo ships other than tankers must meet the applicable basic training requirements when ice concentration exceeds 2/10."
    ] .

gen:IMO_103_OtherShipType
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^(?!(passenger ship|tanker|cargo ship other than tanker)$).+"
    ] .
