@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_105_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Operating area is required to determine whether the Arctic-waters discharge prohibition applies."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:hasValue "Arctic_waters" ;
                sh:datatype xsd:string
            ] ;
            sh:property [
                sh:path nltl:oilOrOilyMixtureDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Oil or oily mixture discharge to sea must be recorded as false in Arctic waters."
            ]
        ]
        [
            sh:not [
                sh:property [
                    sh:path nltl:operatingArea ;
                    sh:hasValue "Arctic_waters"
                ]
            ]
        ]
    ) .
