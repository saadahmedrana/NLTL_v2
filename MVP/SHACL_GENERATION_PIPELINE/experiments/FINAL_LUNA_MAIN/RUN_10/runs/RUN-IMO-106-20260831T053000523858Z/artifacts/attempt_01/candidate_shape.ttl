@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-106-Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:minCount 1 ;
        sh:message "A discharged material classification is required to determine whether the paragraph 1.1.1 prohibition applies."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dischargedMaterialClassification ;
                sh:hasValue nltl:cleanBallastMaterial
            ] ;
            sh:property [
                sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable for clean ballast."
            ]
        ]
        [
            sh:property [
                sh:path nltl:dischargedMaterialClassification ;
                sh:hasValue nltl:segregatedBallastMaterial
            ] ;
            sh:property [
                sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The paragraph 1.1.1 oil-discharge prohibition must be recorded as not applicable for segregated ballast."
            ]
        ]
    ) .
