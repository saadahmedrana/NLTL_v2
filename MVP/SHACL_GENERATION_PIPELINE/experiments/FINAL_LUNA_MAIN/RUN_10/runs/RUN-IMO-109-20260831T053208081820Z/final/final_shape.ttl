@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-109> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:cargoTankCarriesOil ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For an applicable category A or B ship constructed on or after 2017-01-01 that is not an oil tanker and carries oil in cargo tanks, every cargo-tank outer-shell separation must be at least 0.76 m with decimal numeric values and unit M." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (?category IN (
                    nltl:polarShipCategoryA,
                    nltl:polarShipCategoryB
                ))
                $this nltl:shipType ?shipType .
                FILTER (datatype(?shipType) = xsd:string)
                FILTER NOT EXISTS {
                    $this a nltl:oilTanker
                }
                $this nltl:constructionDate ?constructionDate .
                FILTER (
                    datatype(?constructionDate) = xsd:date &&
                    YEAR(?constructionDate) >= 2017
                )
                $this nltl:cargoTankCarriesOil ?carriesOil .
                FILTER (
                    datatype(?carriesOil) = xsd:boolean &&
                    ?carriesOil = true
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?separation .
                    }
                    ||
                    EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?separation .
                        FILTER NOT EXISTS {
                            ?separation a qudt:QuantityValue .
                            ?separation qudt:numericValue ?value .
                            ?separation qudt:unit unit:M .
                            FILTER (
                                datatype(?value) = xsd:decimal &&
                                ?value >= "0.76"^^xsd:decimal
                            )
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?separation .
                        ?separation qudt:numericValue ?value .
                        FILTER (
                            datatype(?value) != xsd:decimal ||
                            ?value < "0.76"^^xsd:decimal
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?separation .
                        ?separation qudt:unit ?unit .
                        FILTER (?unit != unit:M)
                    }
                )
            }
        """
    ] .
