@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-111-Applicability> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category .
                        FILTER (?category NOT IN (
                            nltl:polarShipCategoryA,
                            nltl:polarShipCategoryB
                        ))
                    }
                """ ;
                sh:message "The ship is outside the Category A/B applicability scope of this requirement."
            ]
        ]
        [
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipCategory ?category ;
                              nltl:constructionDate ?date .
                        FILTER (
                            ?category IN (
                                nltl:polarShipCategoryA,
                                nltl:polarShipCategoryB
                            )
                        )
                        FILTER (
                            YEAR(?date) < 2017 ||
                            (YEAR(?date) = 2017 && MONTH(?date) = 1 && DAY(?date) < 1) ||
                            (YEAR(?date) = 2017 && MONTH(?date) < 1)
                        )
                    }
                """ ;
                sh:message "The ship was constructed before 1 January 2017 and is outside the applicability scope of this requirement."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable ship must have Category A or Category B."
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable ship must have a construction date on or after 1 January 2017."
            ]
        ]
    ) .
