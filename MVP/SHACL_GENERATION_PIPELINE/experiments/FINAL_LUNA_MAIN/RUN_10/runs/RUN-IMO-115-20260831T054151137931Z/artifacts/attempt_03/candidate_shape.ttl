@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_115_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single sewage discharge type is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sewageDischargeType ;
                sh:datatype xsd:string ;
                sh:hasValue "comminuted_and_disinfected"
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "MARPOL Annex IV regulation 11.1.1 compliance must be true for comminuted and disinfected sewage discharge."
            ] ;
            sh:property [
                sh:path nltl:distanceToNearestIceShelfOrFastIce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minExclusive "3"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MI_N ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Distance to the nearest ice shelf or fast ice must be greater than 3 nautical miles."
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minExclusive "0.1"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The qualifying ice concentration must be greater than one tenth."
            ] ;
            sh:property [
                sh:path nltl:nearbyIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MI_N ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "A nautical-mile distance from an area with ice concentration exceeding one tenth must be recorded."
            ]
        ]
        [
            sh:property [
                sh:path nltl:sewageDischargeType ;
                sh:datatype xsd:string ;
                sh:pattern "^(?!comminuted_and_disinfected$).*$"
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For comminuted and disinfected sewage discharge, the qualifying ice concentration, nearby concentration, and concentration-area distance must be represented on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType "comminuted_and_disinfected" .
                FILTER NOT EXISTS {
                    $this nltl:iceConcentration ?iceQ .
                    ?iceQ qudt:numericValue ?iceValue ;
                          qudt:unit unit:UNITLESS .
                    $this nltl:nearbyIceConcentration ?nearbyQ .
                    ?nearbyQ qudt:numericValue ?nearbyValue ;
                             qudt:unit unit:UNITLESS .
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?distanceQ .
                    ?distanceQ qudt:numericValue ?distanceValue ;
                              qudt:unit unit:MI_N .
                    FILTER (?iceValue > "0.1"^^xsd:decimal)
                }
            }
        """
    ] .
