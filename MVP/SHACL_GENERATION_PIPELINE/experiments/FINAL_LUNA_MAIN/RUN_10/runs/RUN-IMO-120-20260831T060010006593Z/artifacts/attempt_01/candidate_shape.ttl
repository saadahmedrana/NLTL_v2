@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:arcticWaters ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When operating in Arctic waters and discharging food waste to sea, the nearest-feature distance must be at least 12 nautical miles and the applicable ice-area distance must be recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea ?discharge .
                FILTER (STR(?area) = "Arctic_waters" && ?discharge = true)

                FILTER NOT EXISTS {
                    $this nltl:arcticWaters ?waters .
                    FILTER (STR(?waters) = "Arctic_waters")
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestLandIceShelfOrFastIce ?nearest .
                    ?nearest qudt:numericValue ?nearestValue ;
                             qudt:unit unit:MI_N .
                    FILTER (
                        DATATYPE(?nearestValue) = xsd:decimal &&
                        ?nearestValue >= 12
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?concentration .
                    ?concentration qudt:numericValue ?concentrationValue ;
                                   qudt:unit unit:UNITLESS .
                    FILTER (
                        DATATYPE(?concentrationValue) = xsd:decimal &&
                        ?concentrationValue > 1
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                    ?areaDistance qudt:numericValue ?areaDistanceValue ;
                                  qudt:unit unit:MI_N .
                    FILTER (DATATYPE(?areaDistanceValue) = xsd:decimal)
                }
            }
        """
    ] .
