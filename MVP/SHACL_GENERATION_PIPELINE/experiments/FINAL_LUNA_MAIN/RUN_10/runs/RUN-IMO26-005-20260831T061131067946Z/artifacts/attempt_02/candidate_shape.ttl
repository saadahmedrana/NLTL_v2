@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-005-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:headingOrPositionSystem ;
        sh:datatype xsd:string ;
        sh:message "Each supplied heading-reference or position-fixing system must be evaluated for intended-area suitability."
    ] ;
    sh:property [
        sh:path nltl:intendedArea ;
        sh:datatype xsd:string ;
        sh:message "The intended area must be recorded as a string when suitability is established."
    ] ;
    sh:property [
        sh:path nltl:intendedAreaSuitabilityApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceState ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "The intended-area suitability approval status must be Approved."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every supplied heading-reference or position-fixing system must have an intended area and an Approved suitability status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:headingOrPositionSystem ?system .
                FILTER NOT EXISTS {
                    $this nltl:intendedArea ?area ;
                          nltl:intendedAreaSuitabilityApprovalStatus nltl:evidenceStateApproved .
                    FILTER (
                        isLiteral(?area) &&
                        datatype(?area) = xsd:string
                    )
                }
            }
        """
    ] .
