@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_007_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The ship must record that it is not ice strengthened when this requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxExclusive "2026-01-01"^^xsd:date ;
                sh:message "An ice-strengthened ship constructed before 1 January 2026 is outside this requirement."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2026-01-01"^^xsd:date ;
                sh:message "The construction date must establish applicability from 1 January 2026."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:independentEchoSoundingDeviceCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:echoSoundingDeviceCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 1
                    ] ;
                    sh:property [
                        sh:path nltl:independentTransducerCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:administrationApprovedEquivalentDepthSoundingDevicePresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ]
            ) ;
            sh:message "An applicable ice-strengthened ship must have two independent echo-sounding devices, or one echo-sounding device with two independent transducers, or an Administration-approved equivalent device."
        ]
    ) .
