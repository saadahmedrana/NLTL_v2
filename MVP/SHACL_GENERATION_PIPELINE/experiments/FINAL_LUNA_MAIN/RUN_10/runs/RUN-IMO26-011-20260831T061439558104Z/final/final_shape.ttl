@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ApplicabilityShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2026-01-01"^^xsd:date ;
        sh:minCount 1
    ] .

gen:NonApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:not gen:ApplicabilityShape .

gen:EnclosedProtectionShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeWingsEnclosed ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] .

gen:DesignedProtectionShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeWingProtectionDesignStatus ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] .

gen:EquivalentProtectionShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:administrationApprovedEquivalentBridgeWingProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] .

gen:BridgeWingProtectionShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:NonApplicableShape
        [
            sh:and (
                gen:ApplicabilityShape
                gen:EnclosedProtectionShape
            )
        ]
        [
            sh:and (
                gen:ApplicabilityShape
                gen:DesignedProtectionShape
            )
        ]
        [
            sh:and (
                gen:ApplicabilityShape
                gen:EquivalentProtectionShape
            )
        ]
    ) ;
    sh:message "For Category A or B ships constructed on or after 2026-01-01, bridge wings must be enclosed, designed for protection, or provided with Administration-approved equivalent protection." .
