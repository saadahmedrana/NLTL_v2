@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_012_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:nodeKind sh:IRI ;
        sh:node gen:IMO26_012_GrossTonnageShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide one gross tonnage value to establish applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship with gross tonnage of at least 500, at least two distinct non-magnetic heading means are required, and each must be connected to main and emergency power and be independent from another heading means of the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this nltl:grossTonnage ?gross .
                ?gross qudt:numericValue ?grossValue .
                ?gross qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER(?grossValue >= 500)

                FILTER(
                    NOT EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?m1 .
                        $this nltl:hasNonMagneticHeadingMeans ?m2 .
                        FILTER(?m1 != ?m2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?m .
                        FILTER NOT EXISTS {
                            ?m a nltl:nonMagneticHeadingMeans .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?m .
                        FILTER NOT EXISTS {
                            ?m nltl:connectedToMainPower ?mainPower .
                            FILTER(isIRI(?mainPower))
                            ?mainPower a nltl:benchmarkEntity .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?m .
                        FILTER NOT EXISTS {
                            ?m nltl:connectedToEmergencyPower ?emergencyPower .
                            FILTER(isIRI(?emergencyPower))
                            ?emergencyPower a nltl:benchmarkEntity .
                        }
                    }
                    ||
                    EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?m .
                        FILTER NOT EXISTS {
                            ?m nltl:independentFromHeadingMeans ?other .
                            FILTER(?other != ?m)
                            $this nltl:hasNonMagneticHeadingMeans ?other .
                            ?other a nltl:nonMagneticHeadingMeans .
                        }
                    }
                )
            }
        """
    ] .

gen:IMO26_012_GrossTonnageShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
