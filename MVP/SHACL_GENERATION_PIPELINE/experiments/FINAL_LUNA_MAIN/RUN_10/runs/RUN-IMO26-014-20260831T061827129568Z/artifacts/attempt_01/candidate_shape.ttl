@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-014> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:path nltl:operatesOnlyInContinuousDaylight ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:hasValue true
        ]
        [
            sh:path nltl:operatesOnlyInContinuousDaylight ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:hasValue false
        ]
    ) ;
    sh:or (
        [
            sh:path nltl:operatesOnlyInContinuousDaylight ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:hasValue true
        ]
        [
            sh:and (
                [
                    sh:path nltl:operatesOnlyInContinuousDaylight ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:hasValue false
                ]
                [
                    sh:path nltl:visualIceDetectionIlluminationMeansCount ;
                    sh:datatype xsd:integer ;
                    sh:minCount 1 ;
                    sh:minInclusive 2 ;
                    sh:message "Ships not operating solely in continuous daylight shall have at least two means of illumination for visual ice detection."
                ]
            )
        ]
    ) .
