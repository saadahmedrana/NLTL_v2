@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO26_015_CertifiedBranch
        gen:IMO26_015_NotCertifiedBranch
    ) ;
    sh:message "SOLAS chapter I certification and Polar Code chapter 11 applicability must correspond." .

gen:IMO26_015_CertifiedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record SOLAS chapter I certification as true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Polar Code chapter 11 must be recorded as applicable when SOLAS chapter I certification is true."
    ] .

gen:IMO26_015_NotCertifiedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship must record SOLAS chapter I certification as false for the non-applicable branch."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Polar Code chapter 11 must be recorded as not applicable when SOLAS chapter I certification is false."
    ] .
