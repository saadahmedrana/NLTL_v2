@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_018_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Chapter 11-1 applicability must be provided as a boolean."
    ] ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Safety management system status must be provided as a boolean."
    ] ;
    sh:or (
        gen:IMO26_018_ChapterApplicableBranch
        gen:IMO26_018_ChapterNotApplicableBranch
    ) ;
    sh:or (
        gen:IMO26_018_SafetyManagementAbsentBranch
        gen:IMO26_018_SafetyManagementImplementedBranch
    ) .

gen:IMO26_018_ChapterApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When chapter 11-1 is applicable, voyage planning must cover all clause 11-1.3 topics."
    ] .

gen:IMO26_018_ChapterNotApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue false
    ] .

gen:IMO26_018_SafetyManagementAbsentBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:documentedPolarOperationProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When no safety management system is implemented, a documented polar operation procedure must be present."
    ] .

gen:IMO26_018_SafetyManagementImplementedBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:hasValue true
    ] .
