@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-006> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "A construction stage date must be an xsd:date when represented."
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:message "The owner-request selector must be an xsd:boolean when represented."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ships in the 1986-11-01 through 2003-08-31 construction-stage cohort, the owner-request selector is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For the applicable construction-stage cohort, the applicable ice-class regulation edition must be the 1985 rule edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRuleEdition1985 .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable ice-class regulation edition must not contain a value other than the 1985 rule edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:applicableIceClassRegulationEdition ?edition .
                FILTER (?edition != nltl:iceClassRuleEdition1985)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the owner requests the 2008 requirements, the engine-output regulation edition must be the 2008 edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                FILTER (?requested = "true"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:engineOutputRegulationEdition
                        nltl:iceClassRegulationEdition2008 .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the owner requests the 2008 requirements, the engine-output regulation edition must not contain another edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                FILTER (?requested = "true"^^xsd:boolean)
                $this nltl:engineOutputRegulationEdition ?edition .
                FILTER (?edition != nltl:iceClassRegulationEdition2008)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Without an owner request for the 2008 requirements, the engine-output regulation edition must be the 1985 rule edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                FILTER (?requested = "false"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:engineOutputRegulationEdition
                        nltl:iceClassRuleEdition1985 .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Without an owner request for the 2008 requirements, the engine-output regulation edition must not contain another edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                $this nltl:ownerRequested2008EngineOutputRequirements ?requested .
                FILTER (?requested = "false"^^xsd:boolean)
                $this nltl:engineOutputRegulationEdition ?edition .
                FILTER (?edition != nltl:iceClassRuleEdition1985)
            }
        """
    ] .
