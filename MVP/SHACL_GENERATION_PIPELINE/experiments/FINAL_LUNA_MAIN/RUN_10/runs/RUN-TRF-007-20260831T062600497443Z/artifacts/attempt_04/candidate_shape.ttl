@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-007-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one permitted ice class."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one construction-stage date."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:message "Delivery date, when supplied, must be a single xsd:date value."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:message "Assessment date, when supplied, must be a single xsd:date value."
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:engineOutputComplianceMethodValue ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        ) ;
        sh:maxCount 1 ;
        sh:message "The compliance method, when supplied, must be one permitted 2017 regulation method."
    ] ;
    sh:sparql [
        sh:message "An IA or IA Super ship constructed before 1 September 2003 must have a delivery date, assessment date, and permitted compliance method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?construction .
                FILTER (
                    ?ice = nltl:iceClassIa ||
                    ?ice = nltl:iceClassIaSuper
                )
                FILTER (
                    YEAR(?construction) < 2003 ||
                    (
                        YEAR(?construction) = 2003 &&
                        (
                            MONTH(?construction) < 9 ||
                            (MONTH(?construction) = 9 && DAY(?construction) < 1)
                        )
                    )
                )
                FILTER (
                    NOT EXISTS { $this nltl:deliveryDate ?delivery } ||
                    NOT EXISTS { $this nltl:assessmentDate ?assessment } ||
                    NOT EXISTS { $this nltl:engineOutputComplianceMethod ?method }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The assessment date exceeds the required deadline for an applicable IA or IA Super ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?construction ;
                      nltl:deliveryDate ?delivery ;
                      nltl:assessmentDate ?assessment ;
                      nltl:engineOutputComplianceMethod ?method .
                FILTER (
                    ?ice = nltl:iceClassIa ||
                    ?ice = nltl:iceClassIaSuper
                )
                FILTER (
                    YEAR(?construction) < 2003 ||
                    (
                        YEAR(?construction) = 2003 &&
                        (
                            MONTH(?construction) < 9 ||
                            (MONTH(?construction) = 9 && DAY(?construction) < 1)
                        )
                    )
                )
                FILTER (
                    ?method = nltl:traficom2017Section3Point2Point2Method ||
                    ?method = nltl:traficom2017Section3Point2Point4Method
                )
                FILTER (
                    YEAR(?assessment) > YEAR(?delivery) + 20 ||
                    (
                        YEAR(?assessment) = YEAR(?delivery) + 20 &&
                        (
                            MONTH(?assessment) > 1 ||
                            (MONTH(?assessment) = 1 && DAY(?assessment) > 1)
                        )
                    )
                )
            }
        """
    ] .
