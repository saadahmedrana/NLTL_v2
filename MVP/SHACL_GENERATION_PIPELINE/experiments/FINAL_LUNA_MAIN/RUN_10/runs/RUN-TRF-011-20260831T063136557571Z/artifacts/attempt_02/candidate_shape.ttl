@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-011-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape> ;
        sh:message "The ship must identify its upper ice waterline and its waterline profile points."
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape> ;
        sh:message "The ship must identify at least one intended ice-operating waterline and its waterline profile points."
    ] ;
    sh:sparql [
        sh:message "At each longitudinal position, the UIWL vertical coordinate must equal the maximum intended ice-operating waterline vertical coordinate within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9; every position must have points on both sides." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                {
                    SELECT ?this ?pos
                           (MAX(?uiwlVertical) AS ?maxUiwlVertical)
                           (MAX(?intendedVertical) AS ?maxIntendedVertical)
                           (COUNT(?uiwlVertical) AS ?uiwlCount)
                           (COUNT(?intendedVertical) AS ?intendedCount)
                    WHERE {
                        {
                            ?this nltl:hasUpperIceWaterline ?uiwl .
                            ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                            ?uiwlPoint nltl:longitudinalPosition ?uiwlPositionValue ;
                                       nltl:verticalCoordinate ?uiwlVerticalValue .
                            ?uiwlPositionValue qudt:numericValue ?pos .
                            ?uiwlVerticalValue qudt:numericValue ?uiwlVertical .
                            FILTER (?this = $this)
                        }
                        UNION
                        {
                            ?this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPositionValue ;
                                             nltl:verticalCoordinate ?intendedVerticalValue .
                            ?intendedPositionValue qudt:numericValue ?pos .
                            ?intendedVerticalValue qudt:numericValue ?intendedVertical .
                            FILTER (?this = $this)
                        }
                    }
                    GROUP BY ?this ?pos
                }
                FILTER (
                    ?uiwlCount = 0 ||
                    ?intendedCount = 0 ||
                    ABS(?maxUiwlVertical - ?maxIntendedVertical) >
                    (ABS(?maxIntendedVertical) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-ProfilePointShape> ;
        sh:message "Each represented ice waterline must have at least one profile point."
    ] .

<urn:nltl:generated-shape:TRF-011-ProfilePointShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
