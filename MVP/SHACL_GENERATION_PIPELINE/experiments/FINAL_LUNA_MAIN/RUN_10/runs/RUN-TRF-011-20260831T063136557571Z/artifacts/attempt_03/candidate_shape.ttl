@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF011ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape ;
        sh:class nltl:iceWaterline
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:minCount 1 ;
        sh:node gen:TRF011IceWaterlineShape ;
        sh:class nltl:iceWaterline
    ] ;
    sh:sparql [
        sh:message "Each UIWL profile point must have a corresponding intended ice-operating waterline point at the same longitudinal position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?uiwlPoint ?x
            WHERE {
                $this nltl:hasUpperIceWaterline ?uiwl .
                ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                ?uiwlPoint nltl:longitudinalPosition ?uiwlXValue .
                ?uiwlXValue qudt:numericValue ?x ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?x) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:hasIntendedIceOperatingWaterline ?intended .
                    ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                    ?intendedPoint nltl:longitudinalPosition ?intendedXValue .
                    ?intendedXValue qudt:numericValue ?intendedX ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (datatype(?intendedX) = xsd:decimal)
                    FILTER (?intendedX = ?x)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each intended ice-operating waterline profile point must have a corresponding UIWL point at the same longitudinal position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?intendedPoint ?x
            WHERE {
                $this nltl:hasIntendedIceOperatingWaterline ?intended .
                ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedXValue .
                ?intendedXValue qudt:numericValue ?x ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?x) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterline ?uiwl .
                    ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                    ?uiwlPoint nltl:longitudinalPosition ?uiwlXValue .
                    ?uiwlXValue qudt:numericValue ?uiwlX ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (datatype(?uiwlX) = xsd:decimal)
                    FILTER (?uiwlX = ?x)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The UIWL vertical coordinate must equal the maximum intended-waterline vertical coordinate at the same longitudinal position within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?uiwlPoint ?x ?observed ?expected
            WHERE {
                $this nltl:hasUpperIceWaterline ?uiwl .
                ?uiwl nltl:hasWaterlineProfilePoint ?uiwlPoint .
                ?uiwlPoint nltl:longitudinalPosition ?uiwlXValue ;
                    nltl:verticalCoordinate ?uiwlZValue .
                ?uiwlXValue qudt:numericValue ?uiwlX ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                ?uiwlZValue qudt:numericValue ?observed ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (datatype(?uiwlX) = xsd:decimal)
                FILTER (datatype(?observed) = xsd:decimal)

                {
                    SELECT $this ?x (MAX(?candidate) AS ?expected)
                    WHERE {
                        $this nltl:hasIntendedIceOperatingWaterline ?intended .
                        ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                        ?intendedPoint nltl:longitudinalPosition ?intendedXValue ;
                            nltl:verticalCoordinate ?intendedZValue .
                        ?intendedXValue qudt:numericValue ?x ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?intendedZValue qudt:numericValue ?candidate ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?x) = xsd:decimal)
                        FILTER (datatype(?candidate) = xsd:decimal)
                    }
                    GROUP BY $this ?x
                }

                FILTER (?uiwlX = ?x)
                FILTER (
                    ABS(?observed - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

gen:TRF011IceWaterlineShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:minCount 1 ;
        sh:node gen:TRF011ProfilePointShape ;
        sh:class nltl:waterlineProfilePoint
    ] .

gen:TRF011ProfilePointShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF011LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF011LengthQuantityShape
    ] .

gen:TRF011LengthQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .
