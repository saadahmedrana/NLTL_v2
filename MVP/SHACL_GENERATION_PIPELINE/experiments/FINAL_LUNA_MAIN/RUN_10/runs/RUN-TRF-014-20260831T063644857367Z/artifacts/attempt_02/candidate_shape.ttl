@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the supplied assessment date."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide its construction date."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape ;
        sh:message "The ship must provide its summer load line fresh-water draught in metres."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape ;
        sh:message "The ship must provide its upper ice-waterline draught in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide its ice class."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node gs:TRF014_ClassCertificateShape ;
        sh:minCount 1 ;
        sh:message "The ship must link a class certificate containing the required draught values."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node [
            sh:class nltl:iceDraughtRestrictionDocument
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must link its ice-draught restriction document."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-draught restriction document must be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-draught restriction document must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:sparql [
            a sh:SPARQLConstraint ;
            sh:message "For an applicable pre-cutoff ship without complete marking evidence, the scheduled dry-docking date is required; markings are required once that date is on or before the assessment date, and applicable post-cutoff ships must have complete markings." ;
            sh:select """
                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                PREFIX qudt: <http://qudt.org/schema/qudt/>
                PREFIX sh: <http://www.w3.org/ns/shacl#>
                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                SELECT $this
                WHERE {
                    $this nltl:assessmentDate ?assessment ;
                           nltl:constructionDate ?construction ;
                           nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                           nltl:upperIceWaterlineDraught ?uiwlNode .
                    ?summerNode qudt:numericValue ?summer .
                    ?uiwlNode qudt:numericValue ?uiwl .

                    FILTER(?summer > ?uiwl)

                    FILTER(
                        (
                            ?construction >= "2007-07-01"^^xsd:date
                            &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                       nltl:iceClassDraughtMarkPresent true ;
                                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?markValue .
                            }
                        )
                        ||
                        (
                            ?construction < "2007-07-01"^^xsd:date
                            &&
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                       nltl:iceClassDraughtMarkPresent true ;
                                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                ?markNode qudt:numericValue ?markValue .
                            }
                            &&
                            (
                                NOT EXISTS {
                                    $this nltl:firstScheduledDryDockingDate ?docking .
                                }
                                ||
                                (
                                    EXISTS {
                                        $this nltl:firstScheduledDryDockingDate ?docking .
                                        FILTER(?docking <= ?assessment)
                                    }
                                    &&
                                    NOT EXISTS {
                                        $this nltl:warningTrianglePresent true ;
                                               nltl:iceClassDraughtMarkPresent true ;
                                               nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                                        ?markNode qudt:numericValue ?markValue .
                                    }
                                )
                            )
                        )
                    )
                }
            """
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-class draught mark amidships must equal the class certificate maximum ice-class draught amidships." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasClassCertificate ?certificate ;
                       nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                ?certificate nltl:maximumIceClassDraughtAmidships ?certificateNode .
                ?markNode qudt:numericValue ?markValue .
                ?certificateNode qudt:numericValue ?certificateValue .
                FILTER(
                    ABS(?markValue - ?certificateValue)
                    >
                    (0.000001 *
                        IF(ABS(?certificateValue) > 0.000001,
                           ABS(?certificateValue),
                           0.000001))
                )
            }
        """
    ] .

gs:TRF014_ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF014_LengthMetreQuantityShape
    ] .

gs:TRF014_LengthMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
