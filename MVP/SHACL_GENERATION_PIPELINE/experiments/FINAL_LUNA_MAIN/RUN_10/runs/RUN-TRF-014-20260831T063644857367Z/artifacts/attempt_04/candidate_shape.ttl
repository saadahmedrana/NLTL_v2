@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The supplied assessment date is required and must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The construction date is required and must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "The ship's ice class is required."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node [
            sh:class nltl:classCertificate ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtFore ;
                sh:node gs:TRF014_MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAmidships ;
                sh:node gs:TRF014_MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAft ;
                sh:node gs:TRF014_MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtFore ;
                sh:node gs:TRF014_MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAmidships ;
                sh:node gs:TRF014_MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAft ;
                sh:node gs:TRF014_MetreQuantityShape ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "A class certificate containing all maximum and minimum ice-class draughts is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node [
            sh:class nltl:iceDraughtRestrictionDocument
        ] ;
        sh:minCount 1 ;
        sh:message "An ice-draught restriction document is required."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-draught restriction information must be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-draught restriction information must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gs:TRF014_MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gs:TRF014_MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gs:TRF014_MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required marking is absent, or the pre-cutoff dry-docking deadline and assessment-date condition is not satisfied." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summer ;
                      nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwl ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (?summer > ?uiwl)
                FILTER (
                    (
                        ?constructionDate >= "2007-07-01"^^xsd:date
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:warningTrianglePresent true ;
                                      nltl:iceClassDraughtMarkPresent true ;
                                      nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark .
                                $this nltl:hasClassCertificate/
                                     nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                                FILTER (
                                    ABS(?mark - ?maximum)
                                    > (ABS(?maximum) * 0.000001 + 0.000000001)
                                )
                            }
                        )
                    )
                    ||
                    (
                        ?constructionDate < "2007-07-01"^^xsd:date
                        &&
                        NOT EXISTS {
                            $this nltl:warningTrianglePresent true ;
                                  nltl:iceClassDraughtMarkPresent true .
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                                FILTER (?docking < "2007-07-01"^^xsd:date)
                            }
                            ||
                            EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?docking .
                                FILTER (?docking <= ?assessmentDate)
                                FILTER NOT EXISTS {
                                    $this nltl:warningTrianglePresent true ;
                                          nltl:iceClassDraughtMarkPresent true ;
                                          nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark .
                                    $this nltl:hasClassCertificate/
                                         nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                                    FILTER (
                                        ABS(?mark - ?maximum)
                                        <= (ABS(?maximum) * 0.000001 + 0.000000001)
                                    )
                                }
                            }
                        )
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-class draught mark amidships must equal the class certificate maximum amidships draught within the permitted numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceClassDraughtMarkPresent true ;
                      nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?mark ;
                      nltl:hasClassCertificate/
                      nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximum .
                FILTER (
                    ABS(?mark - ?maximum)
                    > (ABS(?maximum) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

gs:TRF014_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
