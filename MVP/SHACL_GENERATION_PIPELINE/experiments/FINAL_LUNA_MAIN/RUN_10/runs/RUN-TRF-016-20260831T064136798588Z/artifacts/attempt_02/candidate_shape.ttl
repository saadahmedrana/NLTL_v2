@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-016-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Navigating in ice must be explicitly recorded as true when this rule applies."
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:message "At least one upper ice waterline is required to determine the selected UIWL displacement."
            ] ;
            sh:property [
                sh:path nltl:displacementAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/TON_Metric> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:forwardDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:propellerHighestPointSubmerged ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:sparql [
                sh:message "Each linked UIWL must have a waterline displacement, and displacementAtUpperIceWaterline must be the displacement at the greatest-displacement UIWL." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasUpperIceWaterline ?uiwl ;
                              nltl:displacementAtUpperIceWaterline ?selectedValue .
                        ?selectedValue qudt:numericValue ?selected .
                        FILTER (
                            NOT EXISTS {
                                ?uiwl nltl:waterlineDisplacement ?uiwlValue .
                                ?uiwlValue qudt:numericValue ?uiwlDisplacement .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasUpperIceWaterline ?selectedUiwl .
                                ?selectedUiwl nltl:waterlineDisplacement ?selectedValue2 .
                                ?selectedValue2 qudt:numericValue ?selected .
                                FILTER NOT EXISTS {
                                    $this nltl:hasUpperIceWaterline ?greaterUiwl .
                                    ?greaterUiwl nltl:waterlineDisplacement ?greaterValue .
                                    ?greaterValue qudt:numericValue ?greater .
                                    FILTER (?greater > ?selected)
                                }
                            }
                        )
                    }
                """
            ] ;
            sh:sparql [
                sh:message "Draught amidships must be at least the LIWL draught amidships, and forward draught must satisfy the level-ice-thickness formula." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?draughtValue ;
                              nltl:liwlDraughtAmidships ?liwlValue ;
                              nltl:forwardDraught ?forwardValue ;
                              nltl:displacementAtUpperIceWaterline ?displacementValue ;
                              nltl:levelIceThickness ?iceValue .
                        ?draughtValue qudt:numericValue ?draught .
                        ?liwlValue qudt:numericValue ?liwl .
                        ?forwardValue qudt:numericValue ?forward .
                        ?displacementValue qudt:numericValue ?displacement .
                        ?iceValue qudt:numericValue ?ice .
                        BIND ((2 + (0.00025 * ?displacement)) * ?ice AS ?formulaLimit)
                        BIND (4 * ?ice AS ?maximumLimit)
                        BIND (IF (?formulaLimit < ?maximumLimit, ?formulaLimit, ?maximumLimit) AS ?requiredForward)
                        FILTER (?draught < ?liwl || ?forward < ?requiredForward)
                    }
                """
            ] ;
            sh:sparql [
                sh:message "A ballast tank situated above the LIWL and needed to reach the LIWL must have freezing prevention present." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:hasBallastTank ?tank .
                        ?tank nltl:situatedAboveLowerIceWaterline true ;
                             nltl:usedToReachLowerIceWaterline true .
                        FILTER NOT EXISTS {
                            ?tank nltl:freezingPreventionPresent true
                        }
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
</urn:nltl:generated-shape:TRF-016-ShipShape>
