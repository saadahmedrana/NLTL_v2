@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-023> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an IB or IC ship to which the 1985 ice-class rules apply, maximum continuous rating power must be a kW QuantityValue and must be at least the required power under the 1985 rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .

                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower .
                        ?maximumPower a qudt:QuantityValue ;
                                      qudt:numericValue ?maximumValue ;
                                      qudt:unit qudt:KiloW .
                        FILTER (datatype(?maximumValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                        ?requiredPower a qudt:QuantityValue ;
                                       qudt:numericValue ?requiredValue ;
                                       qudt:unit qudt:KiloW .
                        FILTER (datatype(?requiredValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:maximumContinuousRatingPower ?maximumPower ;
                              nltl:requiredPowerUnder1985Rules ?requiredPower .
                        ?maximumPower a qudt:QuantityValue ;
                                      qudt:numericValue ?maximumValue ;
                                      qudt:unit qudt:KiloW .
                        ?requiredPower a qudt:QuantityValue ;
                                       qudt:numericValue ?requiredValue ;
                                       qudt:unit qudt:KiloW .
                        FILTER (datatype(?maximumValue) = xsd:decimal)
                        FILTER (datatype(?requiredValue) = xsd:decimal)
                        FILTER (?maximumValue < ?requiredValue)
                    }
                )
            }
        """
    ] .
