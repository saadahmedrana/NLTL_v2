@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qdt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-027-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "iceClass must contain exactly one permitted ice-class value."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-027-ApplicableCase>
        <urn:nltl:generated-shape:TRF-027-NonApplicableCase>
    ) .

<urn:nltl:generated-shape:TRF-027-ApplicableCase>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
        )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:message "Applicable IA and IA Super ships must have a construction stage date before 2003-09-01."
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "460"^^xsd:decimal ;
                sh:maxInclusive "460"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "18.7"^^xsd:decimal ;
                sh:maxInclusive "18.7"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "825"^^xsd:decimal ;
                sh:maxInclusive "825"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:kilogramPerSquareSecondUnit
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "10.3"^^xsd:decimal ;
                sh:maxInclusive "10.3"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:N-PER-M2
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "45.8"^^xsd:decimal ;
                sh:maxInclusive "45.8"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:N-PER-M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "2.94"^^xsd:decimal ;
                sh:maxInclusive "2.94"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:N-PER-M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "5.8"^^xsd:decimal ;
                sh:maxInclusive "5.8"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:N-PER-M2
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1530"^^xsd:decimal ;
                sh:maxInclusive "1530"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:N
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "170"^^xsd:decimal ;
                sh:maxInclusive "170"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:N-PER-M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "400"^^xsd:decimal ;
                sh:maxInclusive "400"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qdt:QuantityValue ;
            sh:property [
                sh:path qdt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qdt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "clampedHullGeometryTerm must equal the clamped value of ((shipLength * iceClassDraught) / shipBreadth squared) cubed, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qdt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:shipLength ?lengthValue ;
                      nltl:iceClassDraught ?draughtValue ;
                      nltl:shipBreadth ?breadthValue ;
                      nltl:clampedHullGeometryTerm ?resultValue .

                ?lengthValue qdt:numericValue ?length .
                ?draughtValue qdt:numericValue ?draught .
                ?breadthValue qdt:numericValue ?breadth .
                ?resultValue qdt:numericValue ?reported .

                BIND((?length * ?draught) / (?breadth * ?breadth) AS ?ratio)
                BIND(?ratio * ?ratio * ?ratio AS ?raw)
                BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)

                FILTER(
                    ABS(?reported - ?expected) >
                    ((0.000001 * ABS(?expected)) + 0.000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-027-NonApplicableCase>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .
