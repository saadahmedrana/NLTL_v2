@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AlternativeCalculationBranch
    sh:path nltl:hasEvidence ;
    sh:minCount 1 ;
    sh:qualifiedValueShape [
        sh:class nltl:alternativeCalculationEvidence
    ] ;
    sh:qualifiedMinCount 1 .

gen:ModelTestBranch
    sh:path nltl:hasEvidence ;
    sh:qualifiedValueShape [
        sh:class nltl:modelTestEvidence
    ] ;
    sh:qualifiedMinCount 1 .

gen:EngineOutputCoefficientKeBranch
    sh:path nltl:engineOutputCoefficientKe ;
    sh:minCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

gen:BrashIceChannelResistanceRchBranch
    sh:path nltl:brashIceChannelResistanceRch ;
    sh:minCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/N> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

gen:TRF028ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:or (
            gen:AlternativeCalculationBranch
            gen:ModelTestBranch
        ) ;
        sh:message "The ship shall provide evidence for either an alternative calculation or a model test."
    ] ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall have an approved alternative Ke or RCH determination."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:class nltl:evidenceState ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateDraft
            nltl:evidenceStateExpired
            nltl:evidenceStateRejected
            nltl:evidenceStateRevoked
            nltl:evidenceStateSubmitted
            nltl:evidenceStateUnderReview
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The approval or revocation status shall be recorded using a permitted evidence state."
    ] ;
    sh:or (
        gen:EngineOutputCoefficientKeBranch
        gen:BrashIceChannelResistanceRchBranch
    ) ;
    sh:message "The ship shall provide an externally determined Ke or RCH result, with the corresponding quantity and unit."

.
