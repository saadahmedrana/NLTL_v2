@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF036_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassDesignParameterSet ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF036_ParameterSetShape>
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:sparql [
        sh:message "The level ice thickness and design ice load height must match the Table 4-1 values for the ship's ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER NOT EXISTS {
                    {
                        FILTER (?iceClass = nltl:iceClassIaSuper)
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?levelQuantity ;
                             nltl:designIceLoadHeight ?heightQuantity .
                        ?levelQuantity qudt:numericValue ?level ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?heightQuantity qudt:numericValue ?height ;
                                         qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?level <= 1.0 && ?height = 0.35)
                    }
                    UNION
                    {
                        FILTER (?iceClass = nltl:iceClassIa)
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?levelQuantity ;
                             nltl:designIceLoadHeight ?heightQuantity .
                        ?levelQuantity qudt:numericValue ?level ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?heightQuantity qudt:numericValue ?height ;
                                         qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?level <= 0.8 && ?height = 0.30)
                    }
                    UNION
                    {
                        FILTER (?iceClass = nltl:iceClassIb)
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?levelQuantity ;
                             nltl:designIceLoadHeight ?heightQuantity .
                        ?levelQuantity qudt:numericValue ?level ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?heightQuantity qudt:numericValue ?height ;
                                         qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?level <= 0.6 && ?height = 0.25)
                    }
                    UNION
                    {
                        FILTER (?iceClass = nltl:iceClassIc)
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?levelQuantity ;
                             nltl:designIceLoadHeight ?heightQuantity .
                        ?levelQuantity qudt:numericValue ?level ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?heightQuantity qudt:numericValue ?height ;
                                         qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (?level <= 0.4 && ?height = 0.22)
                    }
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF036_ParameterSetShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
