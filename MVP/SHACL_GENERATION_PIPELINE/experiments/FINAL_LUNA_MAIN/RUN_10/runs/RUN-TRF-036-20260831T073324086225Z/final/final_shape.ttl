@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF036Shape a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:or (
        gen:TRF036IaSuperCase
        gen:TRF036IaCase
        gen:TRF036IbCase
        gen:TRF036IcCase
    ) .

gen:TRF036IaSuperCase a sh:NodeShape ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1 ;
        sh:message "The parameter set must be linked from a ship with ice class IA Super."
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxInclusive 1.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Level ice thickness for IA Super must not exceed 1.0 m."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:minInclusive 0.35 ;
                sh:maxInclusive 0.35
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Design ice load height for IA Super must equal 0.35 m."
    ] .

gen:TRF036IaCase a sh:NodeShape ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasIceClassDesignParameterSet ]
            nltl:iceClass
        ) ;
        sh:hasValue nltl:iceClassIa ;
        sh:minCount 1 ;
        sh:message "The parameter set must be linked from a ship with ice class IA."
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxInclusive 0.8
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Level ice thickness for IA must not exceed 0.8 m."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:minInclusive 0.30 ;
                sh:maxInclusive 0.30
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Design ice load height for IA must equal 0.30 m."
    ] .

