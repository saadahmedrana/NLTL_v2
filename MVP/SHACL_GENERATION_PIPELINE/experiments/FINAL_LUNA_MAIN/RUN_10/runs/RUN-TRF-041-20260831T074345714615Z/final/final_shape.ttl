@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF041_PlatingShape>
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:SpacingQuantityShape> ;
        sh:message "Spacing is required in metres."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape> ;
        sh:message "Ice pressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:platingPressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape> ;
        sh:message "Plating pressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape> ;
        sh:message "Yield strength is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:transversePlatingFactorF1 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape> ;
        sh:message "The transverse plating factor f1 is required."
    ] ;
    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape> ;
        sh:message "The longitudinal plating factor f2 is required."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape> ;
        sh:message "The corrosion and abrasion addition is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:minCount 1 ;
        sh:in (
            nltl:transverseFramingOrientation
            nltl:longitudinalFramingOrientation
        ) ;
        sh:message "Framing orientation must be transverse or longitudinal."
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape> ;
        sh:message "The externally determined shell plating thickness is required in millimetres."
    ] .

<urn:nltl:generated-shape:SpacingQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:PressureQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

<urn:nltl:generated-shape:DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

<urn:nltl:generated-shape:MillimetreQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
