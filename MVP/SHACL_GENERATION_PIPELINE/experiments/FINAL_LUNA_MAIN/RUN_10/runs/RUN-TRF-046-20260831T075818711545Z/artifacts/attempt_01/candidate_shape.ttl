@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF_046_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path (
            nltl:hasUpperEnd
            nltl:hasAttachedSupportingStructure
        ) ;
        sh:minCount 1 ;
        sh:or (
            [
                sh:class nltl:deckStructure
            ]
            [
                sh:class nltl:tankBoundaryPlating
            ]
            [
                sh:class nltl:iceStringer
            ]
        ) ;
        sh:message "The upper end of the strengthened part must attach to a deck, tank boundary plating, or ice stringer."
    ] .
