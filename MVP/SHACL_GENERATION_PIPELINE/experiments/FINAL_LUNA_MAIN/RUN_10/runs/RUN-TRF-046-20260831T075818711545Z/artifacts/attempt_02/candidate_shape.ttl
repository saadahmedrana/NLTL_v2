@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-046> a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path (
            nltl:hasStrengthenedPart
            nltl:hasUpperEnd
            nltl:hasAttachedSupportingStructure
        ) ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class nltl:deckStructure ]
            [ sh:class nltl:tankBoundaryPlating ]
            [ sh:class nltl:iceStringer ]
        ) ;
        sh:message "The strengthened part upper end of a main frame or intermediate ice frame must be attached to a deck, tank boundary plating, or ice stringer."
    ] .
