@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-047_FrameShape> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        <urn:nltl:generated-shape:TRF-047_MainFrameBranch>
        <urn:nltl:generated-shape:TRF-047_IntermediateIceFrameBranch>
    ) .

<urn:nltl:generated-shape:TRF-047_MainFrameBranch> a sh:NodeShape ;
    sh:class nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasAttachedSupportingStructure ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:or (
                                [ sh:class nltl:deckStructure ]
                                [ sh:class nltl:tankBoundaryPlating ]
                                [ sh:class nltl:tankTop ]
                                [ sh:class nltl:iceStringer ]
                            )
                        ]
                    ]
                ]
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-047_IntermediateIceFrameBranch> a sh:NodeShape ;
    sh:class nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:or (
                    [
                        sh:node [
                            sh:property [
                                sh:path nltl:hasAttachedSupportingStructure ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:or (
                                        [ sh:class nltl:deckStructure ]
                                        [ sh:class nltl:tankBoundaryPlating ]
                                        [ sh:class nltl:tankTop ]
                                        [ sh:class nltl:iceStringer ]
                                    )
                                ]
                            ]
                        ]
                    ]
                    [
                        sh:node [
                            sh:property [
                                sh:path nltl:hasTerminationBelowSupportingStructure ;
                                sh:minCount 1 ;
                                sh:class nltl:supportingStructure
                            ] ;
                            sh:property [
                                sh:path nltl:hasHorizontalConnectionMember ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:horizontalConnectionMember ;
                                    sh:property [
                                        sh:path nltl:connectsToAdjacentMainFrame ;
                                        sh:minCount 1 ;
                                        sh:class nltl:mainFrame
                                    ]
                                ]
                            ]
                        ]
                    ]
                )
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasLowerEnd ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasAttachedSupportingStructure ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:or (
                                        [ sh:class nltl:deckStructure ]
                                        [ sh:class nltl:tankBoundaryPlating ]
                                        [ sh:class nltl:tankTop ]
                                        [ sh:class nltl:iceStringer ]
                                    )
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasLowerEnd ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:hasTerminationBelowSupportingStructure ;
                                sh:minCount 1 ;
                                sh:class nltl:supportingStructure
                            ] ;
                            sh:property [
                                sh:path nltl:hasHorizontalConnectionMember ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:horizontalConnectionMember ;
                                    sh:property [
                                        sh:path nltl:connectsToAdjacentMainFrame ;
                                        sh:minCount 1 ;
                                        sh:class nltl:mainFrame
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ) .
