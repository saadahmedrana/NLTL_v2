@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF047DirectAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class nltl:deckStructure ]
            [ sh:class nltl:tankBoundaryPlating ]
            [ sh:class nltl:tankTop ]
            [ sh:class nltl:iceStringer ]
        ) ;
        sh:message "The lower end must be attached to a permitted deck, tank boundary plating, tank top, or ice stringer."
    ] .

gen:TRF047HorizontalMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:minCount 1 ;
        sh:class nltl:supportingStructure ;
        sh:message "The intermediate frame must terminate below the qualifying supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:minCount 1 ;
                sh:class nltl:mainFrame
            ]
        ] ;
        sh:message "The lower end must have a horizontal connection member connected to an adjacent main frame."
    ] .

gen:TRF047MainFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ;
        sh:minCount 1 ;
        sh:node gen:TRF047DirectAttachmentShape ;
        sh:message "The lower end of the strengthened main-frame part must use a permitted direct attachment."
    ] .

gen:TRF047IntermediateIceFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path ( nltl:hasStrengthenedPart nltl:hasLowerEnd ) ;
        sh:minCount 1 ;
        sh:or (
            [
                sh:node gen:TRF047DirectAttachmentShape
            ]
            [
                sh:node gen:TRF047HorizontalMemberShape
            ]
        ) ;
        sh:message "The lower end of the strengthened intermediate ice frame must use either a permitted direct attachment or the qualifying horizontal-member alternative."
    ] ;
    sh:property [
        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .
