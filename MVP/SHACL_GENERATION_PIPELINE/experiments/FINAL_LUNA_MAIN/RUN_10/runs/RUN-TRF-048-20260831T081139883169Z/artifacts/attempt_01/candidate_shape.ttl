@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:datatype nltl:frameBoundaryConditionTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:continuousBeamWithBracketsFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:twoDeckFrameCondition
        ) ;
        sh:message "A longitudinal frame must declare one permitted frame boundary condition type."
    ] ;

    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A longitudinal frame must declare whether its boundary conditions are significantly different."
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Ice pressure must be provided as a single decimal quantity in MPa."
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Design ice load height must be provided as a single decimal quantity in metres."
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame spacing must be provided as a single decimal quantity in metres."
    ] ;

    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame span must be provided as a single decimal quantity in metres."
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Yield strength must be provided as a single decimal quantity in MPa."
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame moment factor m must be provided as a single dimensionless decimal quantity."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:continuousBeamWithBracketsFrameCondition ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "13.3"^^xsd:decimal ;
                        sh:maxInclusive "13.3"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:maxExclusive "13.3"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                    ]
                ]
            ]
        ]
    ) ;

    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The calculated longitudinal frame load distribution factor f4 must be provided as a dimensionless decimal quantity."
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The calculated section modulus must be provided as a decimal quantity in cm^3."
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The calculated required shear area must be provided as a decimal quantity in cm^2."
    ] ;

    sh:sparql [
        sh:message "f4, section modulus, and required shear area must match their declared calculations within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:requiredShearArea/qudt:numericValue ?a .

                BIND ((1.0 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND (((?expectedF4 * ?p * ?h * ?l * ?l) /
                       (4.0 * ?m * ?sigma)) * 1000000.0 AS ?expectedZ)
                BIND (((1.7320508075688773 * ?expectedF4 * 2.16 * ?p * ?h * ?l) /
                       (2.0 * ?sigma)) * 10000.0 AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) >
                    (0.000001 * ABS(?expectedF4) + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) >
                    (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?a - ?expectedA) >
                    (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """
    ] .
