@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether detached struts are used."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path ( nltl:hasSidePropellerShafting nltl:enclosedByPlatedBossing ) ;
                sh:minCount 1 ;
                sh:message "Side propeller shafting must be enclosed within plated bossing when detached struts are not used."
            ] ;
            sh:property [
                sh:path ( nltl:hasSternTube nltl:enclosedByPlatedBossing ) ;
                sh:minCount 1 ;
                sh:message "Stern tubes of side propellers must be enclosed within plated bossing when detached struts are not used."
            ]
        ]
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path ( nltl:hasDetachedStrut nltl:hasStrutDesignEvidence ) ;
                sh:minCount 1 ;
                sh:message "Design evidence is required for a detached strut."
            ] ;
            sh:property [
                sh:path ( nltl:hasDetachedStrut nltl:hasStrutStrengthEvidence ) ;
                sh:minCount 1 ;
                sh:message "Strength evidence is required for a detached strut."
            ] ;
            sh:property [
                sh:path ( nltl:hasDetachedStrut nltl:hasStrutHullAttachmentEvidence ) ;
                sh:minCount 1 ;
                sh:message "Hull-attachment evidence is required for a detached strut."
            ]
        ]
    ) .
