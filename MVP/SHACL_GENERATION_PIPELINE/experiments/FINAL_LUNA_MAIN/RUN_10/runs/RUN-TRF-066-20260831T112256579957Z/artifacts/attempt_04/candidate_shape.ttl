@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-066-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:message "The ship shall have one of the permitted Finnish-Swedish ice-class values."
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterline ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship shall provide its lower ice waterline."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:rudderProtectionArrangement ;
                    sh:class nltl:iceKnife ;
                    sh:property [
                        sh:path nltl:extendsBelowLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:message "The ice knife shall extend below the lower ice waterline."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:rudderProtectionArrangement ;
                    sh:class nltl:equivalentRudderProtectionMeans
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:rudderProtectionArrangement ;
                    sh:class nltl:iceKnife ;
                    sh:property [
                        sh:path nltl:extendsBelowLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:message "The ice knife shall extend below the lower ice waterline."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:rudderProtectionArrangement ;
                    sh:class nltl:equivalentRudderProtectionMeans
                ]
            ]
        ]
    ) .
