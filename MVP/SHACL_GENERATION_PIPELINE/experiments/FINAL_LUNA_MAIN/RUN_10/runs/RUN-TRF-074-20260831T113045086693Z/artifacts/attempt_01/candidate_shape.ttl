@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF_074_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "A ship must provide an ice class to determine applicability of the propeller submersion requirement."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice classes IB or IC, ballast propeller depth and required depth hi must be valid metre quantities; when the propeller top is shallower than hi, the propulsion system must be designed for ice class IA." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity .
                        ?depthQuantity qudt:numericValue ?depthValue ;
                                       qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?depthValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredPropellerSubmersionDepthHi ?requiredQuantity .
                        ?requiredQuantity qudt:numericValue ?requiredValue ;
                                           qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?requiredValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        $this nltl:ballastConditionPropellerTopDepth ?invalidDepthQuantity .
                        FILTER (
                            NOT EXISTS {
                                ?invalidDepthQuantity qudt:numericValue ?invalidDepthValue .
                                FILTER (DATATYPE(?invalidDepthValue) = xsd:decimal)
                            }
                            ||
                            NOT EXISTS {
                                ?invalidDepthQuantity qudt:unit <http://qudt.org/vocab/unit/M>
                            }
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredPropellerSubmersionDepthHi ?invalidRequiredQuantity .
                        FILTER (
                            NOT EXISTS {
                                ?invalidRequiredQuantity qudt:numericValue ?invalidRequiredValue .
                                FILTER (DATATYPE(?invalidRequiredValue) = xsd:decimal)
                            }
                            ||
                            NOT EXISTS {
                                ?invalidRequiredQuantity qudt:unit <http://qudt.org/vocab/unit/M>
                            }
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:ballastConditionPropellerTopDepth ?depthQuantity2 .
                        ?depthQuantity2 qudt:numericValue ?depthValue2 ;
                                        qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?depthValue2) = xsd:decimal)

                        $this nltl:requiredPropellerSubmersionDepthHi ?requiredQuantity2 .
                        ?requiredQuantity2 qudt:numericValue ?requiredValue2 ;
                                            qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (DATATYPE(?requiredValue2) = xsd:decimal)
                        FILTER (?depthValue2 < ?requiredValue2)

                        FILTER NOT EXISTS {
                            $this nltl:propulsionSystemDesignedForIceClass nltl:iceClassIa
                        }
                    }
                )
            }
        """ ;
    ] .
