@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qv: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:PropellerRotationalSpeedQuantityShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller rotational speed must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller rotational speed must use rev/min."
    ] .

gen:TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Table 6-9 lookup case must be marked as applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash9 ;
        sh:message "The lookup case must reference TRAFICOM Table 6-9."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The Table 6-9 lookup case must have lookup selection evidence."
    ] .

gen:KnownRotationalSpeedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:rotationalSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:node gen:PropellerRotationalSpeedQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A known bollard propeller speed at MCR must be provided in rev/min."
    ] .

gen:UnknownRotationalSpeedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:rotationalSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:node gen:PropellerRotationalSpeedQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An attributed bollard propeller speed at MCR must be provided in rev/min when the speed is unknown."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gen:TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:message "An unknown bollard propeller speed must have a Table 6-9 lookup case."
    ] .

gen:PropellerRotationalSpeedShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:rotationalSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The rotational-speed-known applicability value is required."
    ] ;
    sh:or (
        gen:KnownRotationalSpeedBranch
        gen:UnknownRotationalSpeedBranch
    ) .
