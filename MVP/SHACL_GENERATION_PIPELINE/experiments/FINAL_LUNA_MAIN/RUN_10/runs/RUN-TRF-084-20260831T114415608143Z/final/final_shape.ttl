@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF084Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a CP propeller with known pitch, propellerPitchAtMcrBollard must be a decimal metre quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "CP" ;
                      nltl:pitchValueKnown true .
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?quantity .
                    ?quantity a qudt:QuantityValue ;
                              qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a CP propeller with unknown pitch, propellerPitchAtMcrBollard must equal 0.7 times propellerPitchAtMcrFreeRunning within the permitted numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "CP" ;
                      nltl:pitchValueKnown false .
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrFreeRunning ?freeQuantity ;
                          nltl:propellerPitchAtMcrBollard ?bollardQuantity .
                    ?freeQuantity a qudt:QuantityValue ;
                                  qudt:numericValue ?freeValue ;
                                  qudt:unit unit:M .
                    ?bollardQuantity a qudt:QuantityValue ;
                                      qudt:numericValue ?bollardValue ;
                                      qudt:unit unit:M .
                    FILTER(
                        datatype(?freeValue) = xsd:decimal &&
                        datatype(?bollardValue) = xsd:decimal
                    )
                    BIND((0.7 * ?freeValue) AS ?expected)
                    BIND(((0.000001 * ?expected) + 0.000000001) AS ?tolerance)
                    FILTER(
                        ?bollardValue >= (?expected - ?tolerance) &&
                        ?bollardValue <= (?expected + ?tolerance)
                    )
                }
            }
        """
    ] .
