@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF108Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:stressLifeCurveKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Stress-life curve known status must be recorded as a single boolean." ;
    ] ;
    sh:or (
        gen:TRF108KnownShape
        gen:TRF108UnknownShape
    ) .

gen:TRF108KnownShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeMaterialProperty ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When the SN-curve is known, the blade material properties must be recorded." ;
    ] ;
    sh:property [
        sh:path nltl:stressLifeCurveSelection ;
        sh:class nltl:stressLifeCurveTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "When the SN-curve is known, a single selected SN-curve type must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "When the SN-curve is known, evidence that the selected curve corresponds to the blade material properties must be provided." ;
    ] .

gen:TRF108UnknownShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:stressLifeCurveSelection ;
        sh:hasValue nltl:twoSlopeStressLifeCurve ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "When the SN-curve is unknown, the two-slope SN curve must be selected." ;
    ] .
