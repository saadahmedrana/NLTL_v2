@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_123_OccasionalForceReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:occasionalForceLoadCase ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:occasionalForceCaseAssessedComponent ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:shipComponent ;
                            sh:property [
                                sh:path nltl:occasionalForceComponentStress ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node [
                                    sh:class qudt:QuantityValue ;
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:hasValue qudt:MegaPA ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ]
                                ]
                            ] ;
                            sh:property [
                                sh:path nltl:hasMaterialProperties ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:materialProperties ;
                                    sh:property [
                                        sh:path nltl:componentMaterialYieldStrength ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:node [
                                            sh:class qudt:QuantityValue ;
                                            sh:property [
                                                sh:path qudt:numericValue ;
                                                sh:datatype xsd:decimal ;
                                                sh:minCount 1 ;
                                                sh:maxCount 1
                                            ] ;
                                            sh:property [
                                                sh:path qudt:unit ;
                                                sh:hasValue qudt:MegaPA ;
                                                sh:minCount 1 ;
                                                sh:maxCount 1
                                            ]
                                        ]
                                    ]
                                ]
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:componentYieldSafetyFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            )
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For every non-excluded assessed component, stress multiplied by the safety factor must not exceed material yield strength; a relative tolerance of 1e-6 with a 1e-6 absolute fallback is permitted." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:hasOccasionalForceLoadCase ?case .
                ?case nltl:propellerBladeExcludedFromOccasionalForceScope false .
                ?case nltl:occasionalForceCaseAssessedComponent ?component .
                ?case nltl:componentYieldSafetyFactor ?factorQuantity .
                ?factorQuantity qudt:numericValue ?factor .
                ?component nltl:occasionalForceComponentStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stress .
                ?component nltl:hasMaterialProperties ?material .
                ?material nltl:componentMaterialYieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yield .
                FILTER (
                    (?stress * ?factor) >
                    (
                        ?yield +
                        IF(
                            ABS(?yield) * 0.000001 > 0.000001,
                            ABS(?yield) * 0.000001,
                            0.000001
                        )
                    )
                )
            }
        """
    ] .
