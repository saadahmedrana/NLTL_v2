@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF123ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:class nltl:occasionalForceLoadCase ;
        sh:minCount 1 ;
        sh:node gen:TRF123OccasionalForceLoadCaseShape ;
        sh:message "The ship must provide an occasional-force load case."
    ] .

gen:TRF123OccasionalForceLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:occasionalForceLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The occasional-force load case must state whether propeller blades are excluded."
    ] ;
    sh:property [
        sh:path nltl:occasionalForceCaseAssessedComponent ;
        sh:class nltl:shipComponent ;
        sh:node gen:TRF123AssessedComponentShape ;
        sh:message "Each assessed occasional-force component must provide the required stress, material, and safety-factor data."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:hasValue false
            ]
        ]
    ) .

gen:TRF123AssessedComponentShape
    a sh:NodeShape ;
    sh:class nltl:shipComponent ;
    sh:property [
        sh:path nltl:occasionalForceComponentStress ;
        sh:node gen:TRF123MegaPaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each assessed component must provide its occasional-force stress in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:class nltl:materialProperties ;
        sh:minCount 1 ;
        sh:node gen:TRF123MaterialPropertiesShape ;
        sh:message "Each assessed component must link its material properties."
    ] ;
    sh:sparql [
        sh:message "The calculated occasional-force stress multiplied by the yield safety factor must not exceed the component material yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:occasionalForceComponentStress ?stressQuantity ;
                      nltl:hasMaterialProperties ?materialProperties .

                ?stressQuantity qudt:numericValue ?stress ;
                                qudt:unit unit:MegaPA .

                ?loadCase nltl:occasionalForceCaseAssessedComponent $this ;
                          nltl:componentYieldSafetyFactor ?factorQuantity .

                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit unit:UNITLESS .

                ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .

                ?yieldQuantity qudt:numericValue ?yield ;
                             qudt:unit unit:MegaPA .

                FILTER (?stress * ?factor > ?yield)
            }
        """
    ] .

gen:TRF123MaterialPropertiesShape
    a sh:NodeShape ;
    sh:class nltl:materialProperties ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:node gen:TRF123MegaPaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The component material properties must provide material yield strength in MPa."
    ] .

gen:TRF123MegaPaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF123UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF123LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:node gen:TRF123UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each occasional-force load case must provide a dimensionless component yield safety factor."
    ] .
