@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_127_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:airReceiverServesAdditionalPurpose ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The applicability value must be true when air receivers serve an additional purpose."
            ] ;
            sh:property [
                sh:path nltl:airReceiverCapacity ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M3 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Air receiver capacity is required when additional purposes are served."
            ] ;
            sh:property [
                sh:path nltl:additionalPurposeRequiredAirCapacity ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Additional-purpose required air capacity is required when additional purposes are served."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Air receiver capacity must be at least the capacity required for additional purposes." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:airReceiverCapacity ?capacityNode .
                        $this nltl:additionalPurposeRequiredAirCapacity ?requiredNode .
                        ?capacityNode qudt:numericValue ?capacityValue .
                        ?requiredNode qudt:numericValue ?requiredValue .
                        FILTER ( ?capacityValue < ?requiredValue )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:airReceiverServesAdditionalPurpose ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The applicability value must be false when air receivers do not serve an additional purpose."
            ]
        ]
    ) .
