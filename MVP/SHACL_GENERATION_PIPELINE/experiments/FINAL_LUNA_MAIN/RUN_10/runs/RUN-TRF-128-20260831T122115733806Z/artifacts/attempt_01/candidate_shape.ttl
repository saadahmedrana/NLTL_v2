@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF128Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must specify its ice class."
    ] ;
    sh:property [
        sh:path nltl:propulsionEngineReversalRequiredForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must state whether propulsion engine reversal is required for going astern."
    ] ;
    sh:property [
        sh:path nltl:compressorChargeTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:HR ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A ship must specify compressor charge time as a single quantity in hours."
    ] ;
    sh:sparql [
        sh:message "Compressor charge time must be at most 0.5 hours for an IA Super ship requiring propulsion engine reversal for astern, and at most 1 hour otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propulsionEngineReversalRequiredForAstern ?reversal ;
                      nltl:compressorChargeTime ?chargeTime .
                ?chargeTime qudt:numericValue ?value .
                FILTER (
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        ?reversal = true &&
                        ?value > "0.5"^^xsd:decimal
                    )
                    ||
                    (
                        (
                            ?iceClass != nltl:iceClassIaSuper ||
                            ?reversal = false
                        ) &&
                        ?value > "1"^^xsd:decimal
                    )
                )
            }
        """
    ] .
