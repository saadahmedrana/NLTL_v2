@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one ice class." ;
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloW ;
            ] ;
        ] ;
        sh:message "The ship must declare one maximum continuous rating power in kW." ;
    ] ;
    sh:property [
        sh:path nltl:engineOutputFormulaBasePowerP0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloW ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:engineOutputFormulaDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:engineOutputFormulaFactorF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:engineOutputFormulaFactorF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:engineOutputFormulaFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:engineOutputFormulaFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
            ] ;
        ] ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:or (
                    [ sh:hasValue nltl:iceClassIb ]
                    [ sh:hasValue nltl:iceClassIc ]
                ) ;
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "740"^^xsd:decimal ;
                    ] ;
                ] ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:or (
                    [ sh:hasValue nltl:iceClassIa ]
                    [ sh:hasValue nltl:iceClassIaSuper ]
                    [ sh:hasValue nltl:iceClassIi ]
                    [ sh:hasValue nltl:iceClassIii ]
                ) ;
            ] ;
        ]
    ) ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0), within a relative tolerance of 1e-6 and an absolute fallback of 1e-6 kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?power ;
                      nltl:engineOutputFormulaBasePowerP0 ?p0 ;
                      nltl:engineOutputFormulaDisplacement ?delta ;
                      nltl:engineOutputFormulaFactorF1 ?f1 ;
                      nltl:engineOutputFormulaFactorF2 ?f2 ;
                      nltl:engineOutputFormulaFactorF3 ?f3 ;
                      nltl:engineOutputFormulaFactorF4 ?f4 .
                ?power qudt:numericValue ?actual .
                ?p0 qudt:numericValue ?p0Value .
                ?delta qudt:numericValue ?deltaValue .
                ?f1 qudt:numericValue ?f1Value .
                ?f2 qudt:numericValue ?f2Value .
                ?f3 qudt:numericValue ?f3Value .
                ?f4 qudt:numericValue ?f4Value .
                BIND((?f1Value * ?f2Value * ?f3Value * ((?f4Value * ?deltaValue) + ?p0Value)) AS ?expected)
                FILTER(
                    ?actual < ?expected &&
                    ABS(?actual - ?expected) > (ABS(?expected) * "0.000001"^^xsd:decimal + "0.000001"^^xsd:decimal)
                )
            }
        """ ;
    ] ;
] .
