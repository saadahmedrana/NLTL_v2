@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single Polar Class value is required."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:class nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must identify one plating."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each steel-grade case must provide one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must identify one material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must identify one steel strength category."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The steel-grade case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade case must identify one actual hull structural steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required steel grade must be selected from Table 8 for the Polar Class, thickness, material class and strength category, and the actual grade must be at least that grade within the same strength category." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                $this nltl:asBuiltPlateThickness/qudt:numericValue ?thickness ;
                      nltl:steelMaterialClass ?material ;
                      nltl:steelStrengthCategory ?category ;
                      nltl:actualHullStructuralSteelGrade ?actual .

                BIND (
                    IF(?category = nltl:normalStrengthSteelCategory,
                        IF(?material = nltl:steelMaterialClassOne,
                            IF(?thickness <= 10, 1,
                                IF(?thickness <= 35,
                                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
                                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2)
                                )
                            ),
                            IF(?material = nltl:steelMaterialClassTwo,
                                IF(?thickness <= 10, 1,
                                    IF(?thickness <= 25,
                                        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
                                        IF(?thickness < 35,
                                            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                                            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2)
                                        )
                                    )
                                ),
                                IF(?thickness <= 10,
                                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1),
                                    IF(?thickness < 40,
                                        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                                        IF(?thickness < 45,
                                            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), 0,
                                                IF(?pc IN (nltl:polarClassPc4, nltl:polarClassPc5), 3, 3)
                                            ),
                                            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 0, 3)
                                        )
                                    )
                                )
                            )
                        ),
                        IF(?material = nltl:steelMaterialClassOne,
                            IF(?thickness <= 10, 1,
                                IF(?thickness < 35,
                                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
                                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 2)
                                )
                            ),
                            IF(?material = nltl:steelMaterialClassTwo,
                                IF(?thickness <= 10, 1,
                                    IF(?thickness < 25,
                                        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 2, 1),
                                        IF(?thickness < 35,
                                            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2),
                                            IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 2)
                                        )
                                    )
                                ),
                                IF(?thickness < 35,
                                    IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 3, 1),
                                    IF(?thickness < 45,
                                        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), 4,
                                            IF(?pc IN (nltl:polarClassPc4, nltl:polarClassPc5), 3, 4)
                                        ),
                                        IF(?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5), 4, 4)
                                    )
                                )
                            )
                        )
                    )
                    AS ?requiredRank
                )
                ?this nltl:requiredHullStructuralSteelGrade ?required .
                ?actual nltl:steelGradeOrderRank ?actualRank .
                ?required nltl:steelGradeOrderRank ?requiredActualRank .

                FILTER(
                    ?requiredRank = 0 ||
                    ?requiredActualRank != ?requiredRank ||
                    ?actualRank < ?requiredActualRank ||
                    (
                        ?category = nltl:normalStrengthSteelCategory &&
                        ?required NOT IN (nltl:steelGradeB, nltl:steelGradeD, nltl:steelGradeE)
                    ) ||
                    (
                        ?category = nltl:highTensileSteelCategory &&
                        ?required NOT IN (nltl:steelGradeAh, nltl:steelGradeDh, nltl:steelGradeEh, nltl:steelGradeFh)
                    )
                )
            }
        """
    ] .
