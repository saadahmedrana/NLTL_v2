@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-064-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:minCount 1 ;
            ] ;
            sh:message "Each calculation case must identify a calculation method; the linear method applies only to linear calculation cases."
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:yieldStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
                    ]
                ] ;
                sh:message "The ship must provide one yield-strength quantity in MPa."
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:class nltl:structuralMember ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasStructuralMemberFlange ;
                        sh:class nltl:structuralMemberFlange ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:nominalFlangeVonMisesStress ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
                                    ]
                                ]
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:hasStructuralMemberWeb ;
                        sh:class nltl:structuralMemberWeb ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:nominalShearStress ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
                                    ]
                                ]
                            ]
                        ]
                    ] ;
                    sh:node [
                        sh:class nltl:hullStructure ;
                        sh:property [
                            sh:path nltl:bucklingCriteriaSatisfied ;
                            sh:datatype xsd:boolean ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:hasValue true ;
                            sh:message "The applicable buckling criteria must be recorded as satisfied."
                        ]
                    ]
                ]
            ]
        ]
        [
            sh:not [
                sh:property [
                    sh:path nltl:hasCalculationCase ;
                    sh:qualifiedValueShape [
                        sh:property [
                            sh:path nltl:calculationMethod ;
                            sh:hasValue nltl:linearCalculationMethodValue ;
                        ]
                    ] ;
                    sh:qualifiedMinCount 1
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Nominal shear stress in each structural-member web must be less than yield strength divided by sqrt(3)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?calculationCase .
                ?calculationCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb ?web .
                ?web nltl:nominalShearStress ?shearQuantity .
                ?shearQuantity qudt:numericValue ?shearValue .
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                FILTER (
                    ?shearValue >=
                    (?yieldValue / 1.7320508075688772)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Nominal flange von Mises stress in each structural-member flange must be less than 1.15 times yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?calculationCase .
                ?calculationCase nltl:calculationMethod nltl:linearCalculationMethodValue .
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange ?flange .
                ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue .
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                FILTER (
                    ?stressValue >=
                    (1.15 * ?yieldValue)
                )
            }
        """
    ] .
