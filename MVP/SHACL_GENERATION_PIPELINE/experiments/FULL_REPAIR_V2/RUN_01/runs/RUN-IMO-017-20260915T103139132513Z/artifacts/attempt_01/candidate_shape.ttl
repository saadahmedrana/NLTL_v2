@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_017_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A Polar Ship Certificate validity date is required."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A survey date is required."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "An endorsement date is required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate supplement must be present."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:message "The ship must have a Polar Ship Certificate."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:class nltl:polarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasRequiredEquipmentRecords ;
                sh:class nltl:requiredEquipmentRecords ;
                sh:minCount 1 ;
                sh:message "The Polar Certificate supplement must record the required equipment."
            ]
        ] ;
        sh:message "The ship must have a Polar Certificate supplement."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasCertificateScheduleDateRecord ;
                sh:class nltl:certificateScheduleDateRecord ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:certificateScheduleDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:message "Each SOLAS certificate schedule date record must contain a date."
                    ] ;
                    sh:property [
                        sh:path nltl:certificateScheduleDateType ;
                        sh:in (
                            nltl:validityDateCategory
                            nltl:surveyDateCategory
                            nltl:endorsementDateCategory
                        ) ;
                        sh:minCount 1 ;
                        sh:message "Each SOLAS certificate schedule date record must have a valid date category."
                    ]
                ]
            ]
        ] ;
        sh:message "The ship must have an applicable SOLAS certificate schedule with date records."
    ] ;
    sh:sparql [
        sh:message "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding categorized SOLAS certificate schedule dates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:validityDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:surveyDateCategory .
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?value .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule /
                              nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?value ;
                                nltl:certificateScheduleDateType nltl:endorsementDateCategory .
                    }
                }
            }
        """
    ] .
