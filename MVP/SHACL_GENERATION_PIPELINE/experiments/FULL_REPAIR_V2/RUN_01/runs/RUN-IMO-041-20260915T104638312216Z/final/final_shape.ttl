@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-041> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "hydraulic" ;
                sh:message "A ship with hydraulic opening actuation must identify that actuation type."
            ] ;
            sh:property [
                sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Hydraulic opening actuation requires freezing or excessive-viscosity control for the hydraulic fluid."
            ]
        ]
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The opening actuation type is required to determine applicability of the hydraulic-fluid protection requirement."
            ] ;
            sh:sparql [
                sh:message "Non-hydraulic opening actuation must not be classified as hydraulic." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?actuationType .
                        FILTER (?actuationType = "hydraulic")
                    }
                """
            ]
        ]
    ) .
