@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtv: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-049-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-049-category-ab-branch>
        <urn:nltl:generated-shape:IMO-049-category-c-branch>
    ) .

<urn:nltl:generated-shape:IMO-049-category-ab-branch> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship category must be Category A or Category B for this approval branch."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:or (
            <urn:nltl:generated-shape:IMO-049-component-ab>
            <urn:nltl:generated-shape:IMO-049-component-not-applicable>
        ) ;
        sh:message "Each applicable linked component must have the required approved scantling evidence."
    ] .

<urn:nltl:generated-shape:IMO-049-category-c-branch> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship category must be Category C for this approval branch."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:hasValue true ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Category C ship must be identified as ice-strengthened for this approval branch."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:or (
            <urn:nltl:generated-shape:IMO-049-component-c>
            <urn:nltl:generated-shape:IMO-049-component-not-applicable>
        ) ;
        sh:message "Each applicable linked component must have Category C approval evidence addressing operating ice conditions."
    ] .

<urn:nltl:generated-shape:IMO-049-component-ab> a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:in (
            "propeller blade"
            "propulsion line"
            "steering equipment"
            "other appendage"
        ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The machinery component type must identify a propeller blade, propulsion line, steering equipment, or other appendage."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:node <urn:nltl:generated-shape:IMO-049-approval-ab> ;
        sh:minCount 1 ;
        sh:message "An applicable machinery component must have approval evidence."
    ] .

<urn:nltl:generated-shape:IMO-049-component-c> a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:in (
            "propeller blade"
            "propulsion line"
            "steering equipment"
            "other appendage"
        ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The machinery component type must identify a propeller blade, propulsion line, steering equipment, or other appendage."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:node <urn:nltl:generated-shape:IMO-049-approval-c> ;
        sh:minCount 1 ;
        sh:message "An applicable machinery component must have Category C approval evidence."
    ] .

<urn:nltl:generated-shape:IMO-049-component-not-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:not [
            sh:in (
                "propeller blade"
                "propulsion line"
                "steering equipment"
                "other appendage"
            )
        ] ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Only propeller blades, propulsion line components, steering equipment, and other appendages are subject to this approval requirement."
    ] .

<urn:nltl:generated-shape:IMO-049-approval-ab> a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The scantling approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Approval must be issued by the Administration or a recognized organization accepted by it."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The approval standard must be Organization-acceptable or offer an equivalent level of safety."
    ] .

<urn:nltl:generated-shape:IMO-049-approval-c> a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The scantling approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Approval must be issued by the Administration or a recognized organization accepted by it."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:hasValue "acceptable standard adequate for operating ice type and concentration" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Category C approval standard must be acceptable and adequate for the operating ice type and concentration."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Operating ice type is required for Category C approval evidence."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:IMO-049-ice-concentration> ;
        sh:message "Operating ice concentration is required for Category C approval evidence."
    ] .

<urn:nltl:generated-shape:IMO-049-ice-concentration> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudtv:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
