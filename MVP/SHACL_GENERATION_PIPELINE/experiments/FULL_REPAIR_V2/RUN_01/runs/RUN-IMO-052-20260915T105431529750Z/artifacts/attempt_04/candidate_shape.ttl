@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-052-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasRequiredAccessItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredAccessItem
    ] ;
    sh:property [
        sh:path nltl:hasEquipmentItem ;
        sh:node <urn:nltl:generated-shape:IMO-052-EquipmentItemShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each required access must have an associated ice or snow removal or prevention means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasRequiredAccessItem ?requiredAccessItem .
                FILTER NOT EXISTS {
                    $this nltl:hasEquipmentItem ?equipmentItem .
                    ?equipmentItem nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-052-EquipmentItemShape>
    a sh:NodeShape ;
    sh:class nltl:equipmentItem ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An equipment item associated with a required access must have ice or snow removal or prevention means."
    ] .
