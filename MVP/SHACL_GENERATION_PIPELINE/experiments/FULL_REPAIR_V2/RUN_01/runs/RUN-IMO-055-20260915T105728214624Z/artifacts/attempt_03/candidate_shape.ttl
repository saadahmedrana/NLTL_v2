@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_055_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:valveExposed ;
                    sh:datatype xsd:boolean ;
                    sh:hasValue true
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:valveType ;
                    sh:hasValue "isolating"
                ]
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:valveType ;
                    sh:hasValue "pressure"
                ]
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:valveType ;
                    sh:hasValue "vacuum"
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "isolating"
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "pressure"
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "vacuum"
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "For an exposed isolating, pressure, or vacuum valve, ice accretion protection and continuous accessibility are required." .
