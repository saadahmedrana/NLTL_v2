@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:imo070-passenger-ship-survival-equipment>
    a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A passenger ship must establish that assigned survival equipment is properly sized."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:class nltl:personOnBoardMember ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:imo070-person-on-board>
    ] .

<urn:nltl:generated-shape:imo070-person-on-board>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:class nltl:personalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:imo070-equipment-assignment> ;
        sh:message "Each person on board must have one personal survival equipment assignment."
    ] .

<urn:nltl:generated-shape:imo070-equipment-assignment>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:class nltl:personalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:class nltl:immersionSuitEquipment
            ]
            [
                sh:class nltl:thermalProtectiveAidEquipment
            ]
        ) ;
        sh:message "The assignment must provide one immersion suit or one thermal protective aid."
    ] .
