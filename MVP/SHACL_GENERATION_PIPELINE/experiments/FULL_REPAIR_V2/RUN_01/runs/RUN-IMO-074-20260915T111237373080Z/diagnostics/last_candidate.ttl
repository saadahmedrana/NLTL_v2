@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO074Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The abandonment potential must be recorded as false when neither conditional alternative is required."
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:abandonmentOntoIceOrLandPotential ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true ;
                        sh:message "The abandonment onto ice or land potential must be recorded as true for this applicable case."
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:groupSurvivalEquipmentCarried ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:hasValue true ;
                                sh:message "Group survival equipment must be carried when abandonment onto ice or land is possible."
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                                sh:minCount 1 ;
                                sh:hasValue nltl:evidenceStateApproved ;
                                sh:class nltl:evidenceState ;
                                sh:message "Approved equivalence for the normal life-saving appliances is required when group survival equipment is not carried."
                            ]
                        ]
                    )
                ]
            )
        ]
    ) .
