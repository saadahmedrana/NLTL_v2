@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO088Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether it operates only in continuous daylight."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue true ;
                sh:message "No searchlight or alternate ice-detection approval is required for ships operating solely in continuous daylight."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue false
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2 ;
                        sh:message "The ship must have at least two bridge-controlled rotatable narrow-beam searchlights."
                    ] ;
                    sh:property [
                        sh:path nltl:searchlightCoverageArc ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:minInclusive "360"^^xsd:decimal ;
                                sh:message "Searchlight coverage must be at least 360 degrees."
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:DEG ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
                        sh:nodeKind sh:IRI ;
                        sh:minCount 1 ;
                        sh:hasValue nltl:evidenceStateApproved ;
                        sh:message "Approved alternative means for visually detecting ice must be recorded."
                    ]
                ]
            )
        ]
    ) .
