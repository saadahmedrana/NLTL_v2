@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-105> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:not [
                    sh:hasValue "Arctic_waters"
                ] ;
                sh:message "Operating area must be recorded and must not be Arctic_waters for the non-applicable case."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "Arctic_waters" ;
                sh:message "The Arctic waters applicability value must be recorded when this branch applies."
            ] ;
            sh:property [
                sh:path nltl:oilOrOilyMixtureDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Discharge of oil or oily mixtures into the sea is prohibited in Arctic waters."
            ]
        ]
    ) .
