@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO123ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO123NonApplicableShape
        gen:IMO123ApplicableShape
    ) .

gen:IMO123NonApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:residueNotRecoverableByCommonMethods ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Cargo residues are not eligible for this discharge permission."
    ] .

gen:IMO123ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:residueNotRecoverableByCommonMethods ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The cargo residue must not be recoverable by commonly available unloading methods."
    ] ;
    sh:property [
        sh:path nltl:shipEnRoute ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must be en route for the discharge."
    ] ;
    sh:property [
        sh:path nltl:harmfulSubstancePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Cargo residues, cleaning agents, or additives must not include substances harmful to the marine environment."
    ] ;
    sh:property [
        sh:path nltl:departureAndDestinationWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The port of departure and the next port of destination must be within Arctic waters."
    ] ;
    sh:property [
        sh:path nltl:routeRemainsWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The route must not transit outside Arctic waters between the ports."
    ] ;
    sh:property [
        sh:path nltl:adequateReceptionFacilitiesAvailable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "No adequate reception facilities may be available at the relevant ports."
    ] ;
    sh:property [
        sh:path nltl:nearbyIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO123IceConcentrationShape ;
        sh:message "The recorded nearby ice concentration must exceed one tenth."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:minCount 1 ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gen:IMO123DischargeDistanceRecordShape ;
        sh:message "An applicable discharge-distance record with both required distances must be recorded."
    ] .

gen:IMO123IceConcentrationShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0.1"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gen:IMO123DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO123IceConcentrationAreaDistanceShape ;
        sh:message "The discharge-distance record must record the distance from the area with ice concentration exceeding one tenth."
    ] ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IMO123NearestIceDistanceShape ;
        sh:message "The discharge must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice."
    ] .

gen:IMO123IceConcentrationAreaDistanceShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:MI_N
    ] .

gen:IMO123NearestIceDistanceShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "12"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:MI_N
    ] .
