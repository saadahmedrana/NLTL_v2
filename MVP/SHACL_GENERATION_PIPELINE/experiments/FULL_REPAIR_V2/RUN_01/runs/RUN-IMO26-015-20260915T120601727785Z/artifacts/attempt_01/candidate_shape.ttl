@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-015> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "SOLAS chapter I certification status is required to determine Polar Code chapter 11 applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:solasChapterICertified ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter11Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar Code chapter 11 must be applicable when the ship is certified under SOLAS chapter I."
            ]
        ]
        [
            sh:property [
                sh:path nltl:solasChapterICertified ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter11Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Polar Code chapter 11 must not be applicable when the ship is not certified under SOLAS chapter I."
            ]
        ]
    ) .
