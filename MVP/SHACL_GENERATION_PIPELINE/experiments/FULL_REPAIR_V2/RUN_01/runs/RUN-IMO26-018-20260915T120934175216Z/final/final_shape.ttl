@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_018_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 11-1 applicability must be recorded as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Safety management system implementation status must be recorded as a single boolean value."
    ] ;
    sh:or (
        gen:IMO26_018_NotApplicableShape
        gen:IMO26_018_ApplicableShape
    ) .

gen:IMO26_018_NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue false
    ] ;
    sh:or (
        gen:IMO26_018_SafetyManagementImplementedShape
        gen:IMO26_018_ProcedureRequiredShape
    ) .

gen:IMO26_018_ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When chapter 11-1 applies, the route planning record must cover all clause 11-1.3 topics."
    ] ;
    sh:or (
        gen:IMO26_018_SafetyManagementImplementedShape
        gen:IMO26_018_ProcedureRequiredShape
    ) .

gen:IMO26_018_SafetyManagementImplementedShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:hasValue true
    ] .

gen:IMO26_018_ProcedureRequiredShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:documentedPolarOperationProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "If no safety management system is implemented, a documented polar operation procedure must be present."
    ] .
