@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF006ApplicableOwnerRequested
        gen:TRF006ApplicableOwnerNotRequested
        gen:TRF006BeforeCohort
        gen:TRF006AfterCohort
    ) .

gen:TRF006ApplicableBase
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRuleEdition1985 ) ;
        sh:minCount 1 ;
        sh:message "Ships in the specified construction-stage cohort must identify the 1985 ice-class rules as applicable."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:message "Ships in the specified construction-stage cohort must identify an ice class."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1
            ]
        ] ;
        sh:message "Ships in the specified construction-stage cohort must identify maximum continuous rating power in kW."
    ] .

gen:TRF006ApplicableOwnerRequested
    a sh:NodeShape ;
    sh:node gen:TRF006ApplicableBase ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "1986-11-01"^^xsd:date ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The owner-request selector must be explicitly true when the 2008 engine-output requirements are selected."
    ] ;
    sh:property [
        sh:path nltl:engineOutputRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRegulationEdition2008 ) ;
        sh:minCount 1 ;
        sh:message "An applicable owner-requested case must identify the 2008 engine-output regulation edition."
    ] .

gen:TRF006ApplicableOwnerNotRequested
    a sh:NodeShape ;
    sh:node gen:TRF006ApplicableBase ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "1986-11-01"^^xsd:date ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:message "The owner-request selector must be explicitly false when the 2008 engine-output requirements are not selected."
    ] ;
    sh:property [
        sh:path nltl:engineOutputRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRuleEdition1985 ) ;
        sh:minCount 1 ;
        sh:message "Without an owner request, the engine-output regulation edition must remain the 1985 edition."
    ] .

gen:TRF006BeforeCohort
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "1986-11-01"^^xsd:date ;
        sh:minCount 1
    ] .

gen:TRF006AfterCohort
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2003-09-01"^^xsd:date ;
        sh:minCount 1
    ] .
