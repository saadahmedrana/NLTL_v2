    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N> ; sh:minCount 1 ; sh:maxCount 1 ] .
