@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-026-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall have exactly one permitted ice class."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-026-NonIaSuperBranch>
        <urn:nltl:generated-shape:TRF-026-IaSuperWithoutBulbBranch>
        <urn:nltl:generated-shape:TRF-026-IaSuperWithBulbBranch>
    ) .

<urn:nltl:generated-shape:TRF-026-NonIaSuperBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIa nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-026-IaSuperWithoutBulbBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An IA Super ship without a bulb is not subject to the bulb formula checks."
    ] .

<urn:nltl:generated-shape:TRF-026-IaSuperWithBulbBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An IA Super ship with a bulb shall identify the bulb and provide all declared calculation inputs and outputs."
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-F1Quantity>
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-F2Quantity>
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-F3Quantity>
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-F4Quantity>
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-G1Quantity>
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-G2Quantity>
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-G3Quantity>
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-BreadthQuantity>
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-LengthQuantity>
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-DraughtQuantity>
    ] ;
    sh:property [
        sh:path nltl:brashIceResistanceCoefficientC1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-C1Quantity>
    ] ;
    sh:property [
        sh:path nltl:brashIceResistanceCoefficientC2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-026-C2Quantity>
    ] .

<urn:nltl:generated-shape:TRF-026-F1Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-F2Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N-PER-M> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-F3Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N-PER-M> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-F4Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-G1Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-G2Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N-PER-M> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-G3Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-BreadthQuantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-LengthQuantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-DraughtQuantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:minCount 1 ; sh:maxCount 1 ] .

<urn:nltl:generated-shape:TRF-026-C1Quantity>
    a sh:NodeShape ;
    sh:property [ sh:path qudt:numericValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:hasValue <http://qudt.org/vocab/unit/N> ; sh:minCount 1 ; sh:maxCount 1 ] .

