@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF049_FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        _:TRF049_WithinIceFalse
        _:TRF049_WithinIceTrue
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every linked supporting bulkhead or web frame must be effectively attached through a frame attachment." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  ?this nltl:withinIceStrengthenedArea true .
  ?this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?support .
  FILTER NOT EXISTS {
    ?this nltl:hasFrameAttachment ?attachment .
    ?attachment nltl:hasAttachedSupportingStructure ?support ;
                nltl:effectiveAttachmentConfirmed true .
  }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A longitudinal frame must be attached by brackets to each linked supporting structure." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  ?this nltl:withinIceStrengthenedArea true ;
        a nltl:longitudinalFrame ;
        (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?support .
  FILTER NOT EXISTS {
    ?this nltl:hasFrameAttachment ?attachment .
    ?attachment nltl:hasAttachedSupportingStructure ?support ;
                nltl:hasConnectionBracket ?bracket .
  }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A transverse frame terminating at a deck or ice stringer must have a bracket or similar attachment construction." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  ?this nltl:withinIceStrengthenedArea true ;
        a nltl:transverseFrame ;
        nltl:terminatesAtDeckOrIceStringer true .
  FILTER NOT EXISTS {
    ?this nltl:hasFrameAttachment ?attachment .
    FILTER (
      EXISTS {
        ?attachment nltl:hasConnectionBracket ?bracket .
      }
      ||
      EXISTS {
        ?attachment nltl:similarAttachmentConstructionPresent true .
      }
    )
  }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A frame running through a supporting structure must provide a valid integer web-plate connection side count of exactly 2 and must connect both sides of its web plate to the relevant supporting structure." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  ?this nltl:withinIceStrengthenedArea true ;
        nltl:passesThroughSupportingStructure true .
  ?this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?support .

  FILTER (
    NOT EXISTS {
      ?this nltl:webPlateConnectionSideCount ?count .
      FILTER (
        DATATYPE(?count) = xsd:integer &&
        ?count = 2
      )
    }
    ||
    NOT EXISTS {
      ?this nltl:hasFrameAttachment ?attachment .
      ?attachment nltl:hasAttachedSupportingStructure ?support .
      ?support nltl:hasSupportingStructureAttachment ?attachment .
    }
  )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each installed bracket must be at least as thick as the frame web, with a stiffened edge against buckling." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this
WHERE {
  ?this nltl:withinIceStrengthenedArea true ;
        nltl:hasFrameAttachment ?attachment .
  ?attachment nltl:hasConnectionBracket ?bracket .

  FILTER NOT EXISTS {
    ?this nltl:frameWebThickness ?frameThickness .
    ?frameThickness qudt:numericValue ?frameValue ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    FILTER (DATATYPE(?frameValue) = xsd:decimal)
  }

  FILTER EXISTS {
    ?this nltl:frameWebThickness ?frameThickness .
    ?frameThickness qudt:numericValue ?frameValue ;
                    qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?bracket nltl:bracketThickness ?bracketThickness ;
             nltl:bracketEdgeStiffened true ;
             nltl:bucklingStiffening true .
    ?bracketThickness qudt:numericValue ?bracketValue ;
                      qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    FILTER (
      DATATYPE(?frameValue) = xsd:decimal &&
      DATATYPE(?bracketValue) = xsd:decimal &&
      ?bracketValue < ?frameValue
    )
  }
}
"""
    ] .

_:TRF049_WithinIceFalse
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

_:TRF049_WithinIceTrue
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:node gs:TRF049_FrameAttachmentShape
    ] ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF049_MillimetreQuantityShape ;
        sh:message "Each applicable frame must provide exactly one valid frame web thickness in decimal millimetres."
    ] ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF049_FrameAttachmentShape
    a sh:NodeShape ;
    sh:class nltl:frameAttachmentRecord ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be effectively confirmed."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node gs:TRF049_ConnectionBracketShape
    ] .

gs:TRF049_ConnectionBracketShape
    a sh:NodeShape ;
    sh:class nltl:connectionBracket ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF049_MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:TRF049_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
