@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-067-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "For ice class IA, the ship shall have a rudder protection arrangement suitable for absorbing the specified loads."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "For ice class IA Super, the ship shall have a rudder protection arrangement suitable for absorbing the specified loads."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIb
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIc
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIi
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIii
            ]
        ]
    ) ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:iceClass ;
                    sh:hasValue nltl:iceClassIa
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "For ice class IA, the ship shall have a rudder protection arrangement suitable for absorbing the specified loads."
            ]
        ]
    ) ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:iceClass ;
                    sh:hasValue nltl:iceClassIaSuper
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "For ice class IA Super, the ship shall have a rudder protection arrangement suitable for absorbing the specified loads."
            ]
        ]
    ) ;
    sh:message "The ship's ice class shall be supplied so that the rudder protection requirement can be determined." .
