@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ForceKiloNewtonShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureMegaPascalShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF070Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:thrusterType ;
                sh:in ( "azimuthing" "fixed" )
            ] ;
            sh:property [
                sh:path nltl:propellerIceInteractionLoad ;
                sh:node gen:ForceKiloNewtonShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyIceInteractionLoad ;
                sh:node gen:ForceKiloNewtonShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:node gen:PressureMegaPascalShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:designCondition ;
                    sh:property [
                        sh:path nltl:designConditionLocalStrengthCapacity ;
                        sh:node gen:ForceKiloNewtonShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:sparql [
                        sh:message "The design condition local-strength capacity must be compared with the applicable local ice pressure only after both operands have been represented in compatible units." ;
                        sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#> PREFIX qudt: <http://qudt.org/schema/qudt/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this nltl:designConditionLocalStrengthCapacity ?capacity . ?capacity qudt:numericValue ?capacityValue ; qudt:unit ?capacityUnit . ?ship nltl:hasDesignCondition $this ; nltl:localIcePressure ?pressure . ?pressure qudt:numericValue ?pressureValue ; qudt:unit ?pressureUnit . FILTER ( ?capacityUnit = ?pressureUnit ) FILTER ( ?capacityValue < ?pressureValue ) }"
                    ]
                ]
            ]
        ]
        [
            sh:sparql [
                sh:message "The thruster applicability inputs must identify a non-azimuthing/non-fixed or non-main-propulsion case." ;
                sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT $this WHERE { $this nltl:mainPropulsionThruster ?m ; nltl:thrusterType ?t . FILTER ( ! ( ?m = true && ?t IN (\"azimuthing\", \"fixed\") ) ) }"
            ]
        ]
    ) .
