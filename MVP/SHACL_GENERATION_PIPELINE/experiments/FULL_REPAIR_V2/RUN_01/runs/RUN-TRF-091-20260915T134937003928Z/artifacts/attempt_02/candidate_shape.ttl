@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:node gen:TRF091IceMillingSequenceCaseShape ;
        sh:message "The ship shall identify an ice milling sequence case used for the propulsion-line strength evaluation."
    ] .

gen:TRF091IceMillingSequenceCaseShape
    a sh:NodeShape ;
    sh:class nltl:iceMillingSequenceCase ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:minCount 1 ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:message "The ice milling load sequence case shall have propulsion-line strength evaluation as its purpose."
    ] ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:not [
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ] ;
        sh:message "The ice milling load sequence shall not be designated for propulsion system stalling analysis."
    ] .
