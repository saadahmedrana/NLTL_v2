@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_108_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:stressLifeCurveKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether the stress-life curve is known."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:stressLifeCurveKnown ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:propellerBladeMaterialProperty ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Material properties of the propeller blade are required when the stress-life curve is known."
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:stressLifeCurveTypeValue ;
                sh:node [
                    a sh:NodeShape ;
                    sh:property [
                        sh:path nltl:stressLifeCurveType ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "A single stress-life curve type must be selected and recorded for the applicable material properties."
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
                sh:minCount 1 ;
                sh:class nltl:evidenceArtifact ;
                sh:message "Evidence must demonstrate correspondence between the selected SN-curve type and the blade material properties."
            ]
        ]
        [
            sh:property [
                sh:path nltl:stressLifeCurveKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:stressLifeCurveTypeValue ;
                sh:hasValue nltl:twoSlopeStressLifeCurve ;
                sh:message "When the stress-life curve is unknown, the two-slope SN curve must be selected."
            ] ;
            sh:property [
                sh:path nltl:twoSlopeSnCurveUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The two-slope SN curve must be recorded as used when the stress-life curve is unknown."
            ]
        ]
    ) .
