@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-120-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damping ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the damping used for thruster global natural-frequency estimation."
    ] ;
    sh:property [
        sh:path nltl:waterAddedMass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloGM
            ]
        ] ;
        sh:message "The ship must provide water added mass in kilograms."
    ] ;
    sh:property [
        sh:path nltl:thrusterNaturalFrequency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:HZ
            ]
        ] ;
        sh:message "The ship must provide the thruster global natural frequency in hertz."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node [
            sh:class nltl:thrusterBody ;
            sh:property [
                sh:path nltl:shipAttachmentStiffness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:KiloN-PER-M
                    ]
                ] ;
                sh:message "Each represented thruster body must provide ship attachment stiffness in kilonewtons per metre."
            ] ;
            sh:property [
                sh:path nltl:hasNaturalFrequencyCalculationCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:calculationCase ;
                    sh:property [
                        sh:path nltl:vibrationDirection ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:in (
                            nltl:longitudinalDirection
                            nltl:transverseDirection
                        ) ;
                        sh:message "Each natural-frequency calculation case must identify a longitudinal or transverse vibration direction."
                    ]
                ] ;
                sh:message "Each represented thruster body must have a natural-frequency calculation case."
            ]
        ]
    ] .
