@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-088-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-088-DaylightBranch>
        <urn:nltl:generated-shape:IMO-088-NonDaylightBranch>
    ) ;
    sh:message "The ship must declare whether it operates only in continuous daylight and, when it does not, satisfy an approved visual ice-detection alternative." .

<urn:nltl:generated-shape:IMO-088-DaylightBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:IMO-088-NonDaylightBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-088-SearchlightBranch>
        <urn:nltl:generated-shape:IMO-088-ApprovedAlternativeBranch>
    ) .

<urn:nltl:generated-shape:IMO-088-SearchlightBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "At least two bridge-controlled rotatable narrow-beam searchlights are required." 
    ] ;
    sh:property [
        sh:path nltl:searchlightCoverageArc ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 360 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Searchlights must provide coverage over an arc of at least 360 degrees." 
    ] .

<urn:nltl:generated-shape:IMO-088-ApprovedAlternativeBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An approved alternative means of visually detecting ice is required." 
    ] .
