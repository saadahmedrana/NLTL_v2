@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_055_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "Valve exposure must be recorded as false for the non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Valve exposure must be recorded as true for an applicable valve."
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:in ( "isolating" "pressure" "vacuum" ) ;
                sh:minCount 1 ;
                sh:message "An exposed valve must be isolating, pressure, or vacuum type."
            ] ;
            sh:property [
                sh:path nltl:iceAccretionProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "An exposed isolating, pressure, or vacuum valve must be protected from ice accretion."
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "An exposed isolating, pressure, or vacuum valve must remain continuously accessible."
            ]
        ]
    ) .
