@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_068_ConditionalEvacuationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInIceCoveredWaters ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "A ship operating in ice-covered waters must record safe evacuation means and approved survival equipment deployment."
            ] ;
            sh:property [
                sh:path nltl:safeEvacuationMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Safe evacuation means must be present when the rule applies."
            ] ;
            sh:property [
                sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
                sh:class nltl:evidenceState ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:message "Survival equipment deployment must have approved status when the rule applies."
            ]
        ]
        [
            sh:property [
                sh:path nltl:directEvacuationOntoIceApplicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Direct evacuation onto the ice must be recorded as applicable when that evacuation arrangement is used."
            ] ;
            sh:property [
                sh:path nltl:safeEvacuationMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Safe evacuation means must be present when the rule applies."
            ] ;
            sh:property [
                sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
                sh:class nltl:evidenceState ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:message "Survival equipment deployment must have approved status when the rule applies."
            ]
        ]
    ) .
