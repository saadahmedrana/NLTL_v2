@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-069> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether an added life-saving device requires a source of power."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:devicePowerSourceIndependentOfMainPower ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "A power source for an added life-saving device must operate independently of the ship's main source of power."
            ]
        ]
    ) .
