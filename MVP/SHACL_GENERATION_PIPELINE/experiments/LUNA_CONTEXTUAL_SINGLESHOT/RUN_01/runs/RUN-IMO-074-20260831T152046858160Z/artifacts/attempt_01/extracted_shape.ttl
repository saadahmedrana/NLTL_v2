@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-074> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The abandonment potential assessment must be false, or an applicable survival alternative must be satisfied."
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:groupSurvivalEquipmentCarried ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Group survival equipment must be carried when abandonment onto ice or land is assessed as a potential."
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Approved equivalent survival functionality must be recorded when abandonment onto ice or land is assessed as a potential and group survival equipment is not the selected alternative."
            ]
        ]
    ) .
