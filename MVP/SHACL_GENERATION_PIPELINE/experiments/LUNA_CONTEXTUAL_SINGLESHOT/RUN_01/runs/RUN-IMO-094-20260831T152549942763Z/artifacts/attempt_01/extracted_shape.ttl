@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-094-Ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships providing icebreaking escort must have an astern-facing sound signaling system and comply with the International Code of Signals." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:shipProvidesIcebreakingEscort true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:asternFacingSoundSignalingSystemPresent true .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:internationalCodeOfSignalsComplianceStatus true .
                    }
                )
            }
        """ ;
    ] .
