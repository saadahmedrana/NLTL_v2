@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF022ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022AngleQuantityShape ;
        sh:message "Bow rake at quarter breadth is required with a decimal value in degrees."
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022AngleQuantityShape ;
        sh:message "Waterline angle at quarter breadth is required with a decimal value in degrees."
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022LengthQuantityShape ;
        sh:message "Ship length is required with a decimal value in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022LengthQuantityShape ;
        sh:message "Ice class draught is required with a decimal value in metres."
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022LengthQuantityShape ;
        sh:message "Ship breadth is required with a decimal value in metres."
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022C34QuantityShape ;
        sh:message "Coefficient C3 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022C34QuantityShape ;
        sh:message "Coefficient C4 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022C5QuantityShape ;
        sh:message "Coefficient C5 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022F1QuantityShape ;
        sh:message "Coefficient F1 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022F23QuantityShape ;
        sh:message "Coefficient F2 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022F23QuantityShape ;
        sh:message "Coefficient F3 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022F1QuantityShape ;
        sh:message "Coefficient F4 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022G1QuantityShape ;
        sh:message "Coefficient G1 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022F23QuantityShape ;
        sh:message "Coefficient G2 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022G3QuantityShape ;
        sh:message "Coefficient G3 is required with its declared unit."
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022AngleQuantityShape ;
        sh:message "Externally computed flare angle is required with a decimal value in degrees."
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF022DimensionlessQuantityShape ;
        sh:message "Externally computed clamped hull geometry term is required with a decimal dimensionless value."
    ] .

nltl:TRF022AngleQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022C34QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022C5QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022F1QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022F23QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022G1QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022G3QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF022DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
