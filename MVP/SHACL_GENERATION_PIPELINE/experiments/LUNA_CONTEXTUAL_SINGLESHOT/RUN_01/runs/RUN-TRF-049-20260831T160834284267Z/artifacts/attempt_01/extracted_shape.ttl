@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<nltl:generated-shape:TRF-049-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must state whether it is within the ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:node <nltl:generated-shape:TRF-049-WebThicknessShape>
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:minCount 1 ;
                sh:node <nltl:generated-shape:TRF-049-FrameAttachmentShape> ;
                sh:message "A frame within the ice-strengthened area must have an effective frame attachment."
            ] ;
            sh:or (
                [
                    sh:class nltl:longitudinalFrame ;
                    sh:property [
                        sh:path nltl:hasSupportingWebFrame ;
                        sh:node <nltl:generated-shape:TRF-049-SupportingStructureShape>
                    ] ;
                    sh:property [
                        sh:path nltl:hasSupportingBulkhead ;
                        sh:node <nltl:generated-shape:TRF-049-SupportingStructureShape>
                    ]
                ]
                [
                    sh:class nltl:transverseFrame ;
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:hasFrameAttachment ;
                                sh:node [
                                    sh:property [
                                        sh:path nltl:hasConnectionBracket ;
                                        sh:minCount 1
                                    ]
                                ]
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:hasFrameAttachment ;
                                sh:node [
                                    sh:property [
                                        sh:path nltl:similarAttachmentConstructionPresent ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue true
                                    ]
                                ]
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:terminatesAtDeckOrIceStringer ;
                                sh:hasValue false
                            ]
                        ]
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:webPlateConnectionSideCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2 ;
                        sh:message "Both sides of a frame web plate passing through a supporting structure must be connected."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:hasValue false
                    ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When a connection bracket is installed, its thickness must be at least the frame web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                $this nltl:frameWebThickness ?frameThickness .
                ?frameThickness qudt:numericValue ?frameValue .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?bracketThickness qudt:numericValue ?bracketValue .
                FILTER (xsd:decimal(?bracketValue) < xsd:decimal(?frameValue))
            }
            UNION
            {
                $this nltl:withinIceStrengthenedArea true .
                $this nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    $this nltl:frameWebThickness ?frameThickness .
                    ?frameThickness qudt:numericValue ?frameValue .
                }
            }
        """
    ] .

<nltl:generated-shape:TRF-049-FrameAttachmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be confirmed effective."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node <nltl:generated-shape:TRF-049-BracketShape>
    ] .

<nltl:generated-shape:TRF-049-SupportingStructureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:node [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:minCount 1 ;
                sh:node <nltl:generated-shape:TRF-049-BracketShape> ;
                sh:message "A supporting structure linked to the frame must be attached by a bracket."
            ]
        ]
    ] .

<nltl:generated-shape:TRF-049-BracketShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <nltl:generated-shape:TRF-049-BracketThicknessShape>
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

<nltl:generated-shape:TRF-049-BracketThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

<nltl:generated-shape:TRF-049-WebThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .
