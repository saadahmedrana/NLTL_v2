@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF070Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Main-propulsion thruster applicability must be stated as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Thruster type must be stated as a single string value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:thrusterType ;
                sh:in ( "azimuthing" "fixed" )
            ] ;
            sh:property [
                sh:path nltl:propellerIceInteractionLoad ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyIceInteractionLoad ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:node [
                    sh:class nltl:designCondition ;
                    sh:property [
                        sh:path nltl:designConditionLocalStrengthCapacity ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:KiloN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:minCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:message "Each applicable ship must provide a design condition with externally assessed local-strength capacity."
            ]
        ]
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:thrusterType ;
                sh:pattern "^(?!azimuthing$|fixed$).*$"
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "The externally assessed local-strength capacity must be at least the applicable local ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType ;
                      nltl:localIcePressure ?pressureNode ;
                      nltl:hasDesignCondition ?designCondition .

                FILTER (?thrusterType = "azimuthing" || ?thrusterType = "fixed")

                ?pressureNode qudt:numericValue ?pressure .
                ?designCondition nltl:designConditionLocalStrengthCapacity ?capacityNode .
                ?capacityNode qudt:numericValue ?capacity .

                FILTER (?capacity < ?pressure)
            }
        """
    ] .
