@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-091-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerIceMillingLoadSequence ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall identify the load sequence used for propeller ice-block milling."
    ] ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "The ship shall identify a propeller ice-milling load-sequence case."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:class nltl:loadCase ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis."
            ]
        ] ;
        sh:message "The ship shall identify a propulsion load case using the ice-milling load sequence."
    ] .
