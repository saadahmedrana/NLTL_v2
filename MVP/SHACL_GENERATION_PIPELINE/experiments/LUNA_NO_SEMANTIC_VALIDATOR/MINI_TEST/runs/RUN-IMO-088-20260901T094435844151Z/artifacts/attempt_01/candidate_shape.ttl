@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_088_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The continuous-daylight operating profile must be provided as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue false
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
                        sh:datatype xsd:integer ;
                        sh:minInclusive 2 ;
                        sh:minCount 1 ;
                        sh:message "At least two bridge-controlled rotatable narrow-beam searchlights are required."
                    ] ;
                    sh:property [
                        sh:path nltl:searchlightCoverageArc ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "360"^^xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:DEG ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:message "Searchlight coverage must be at least 360 degrees."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue nltl:evidenceStateApproved ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Approved alternative visual ice-detection means are required when the searchlight alternative is not used."
                    ]
                ]
            )
        ]
    ) ;
    sh:message "A ship not operating solely in continuous daylight must provide either two qualifying searchlights with 360-degree coverage or approved alternative visual ice-detection means." .
