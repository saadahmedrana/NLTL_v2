@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "Each relevant hatch or door must have associated means to remove or prevent ice and snow accretion."
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "When ice accretion is likely, every relevant hatch or door must have associated ice or snow removal or prevention means." .
