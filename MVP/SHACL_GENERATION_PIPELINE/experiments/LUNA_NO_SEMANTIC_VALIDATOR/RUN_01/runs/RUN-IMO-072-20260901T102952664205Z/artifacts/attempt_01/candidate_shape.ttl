@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_072_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasAssignedSearchlight ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true ;
                                sh:message "Each lifeboat searchlight must be suitable for continuous use."
                            ]
                        ]
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
    ) .
