@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO097Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:distressAlertDeviceCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 1
            ] ;
            sh:property [
                sh:path nltl:locationSignalDeviceCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 1
            ] ;
            sh:property [
                sh:path nltl:onSceneTransmitReceiveDeviceCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the ship operates in low air temperature, every linked survival craft must have the required communication devices." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:hasSurvivalCraft ?craft .
                FILTER NOT EXISTS {
                    ?craft nltl:survivalCraftHasShipToShoreDistressAlertDevice ?distressDevice ;
                           nltl:survivalCraftHasLocationSignalDevice ?locationDevice ;
                           nltl:survivalCraftHasOnSceneCommunicationDevice ?communicationDevice .
                }
            }
        """
    ] .

gs:IMO097RequiredRescueBoatOrLifeboatShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasRequiredRescueBoatOrLifeboat ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:class nltl:equipmentItem ;
        sh:minCount 1 ;
        sh:message "Each required rescue boat or lifeboat must carry a ship-to-shore distress-alert device."
    ] .
