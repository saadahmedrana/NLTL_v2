@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_105_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Arctic_waters" ;
                sh:message "The operating area must be recorded as Arctic_waters when this branch applies."
            ] ;
            sh:property [
                sh:path nltl:oilOrOilyMixtureDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Discharge of oil or oily mixtures to sea must be recorded as false in Arctic_waters."
            ] ;
            sh:sparql [
                sh:message "Oil or oily mixture discharge to sea must not have any value other than false in Arctic_waters." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea "Arctic_waters" .
                        FILTER NOT EXISTS {
                            $this nltl:oilOrOilyMixtureDischargeToSea ?discharge .
                            FILTER (?discharge != false)
                        }
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The operating area is required to determine whether the Arctic waters prohibition applies."
            ] ;
            sh:sparql [
                sh:message "This non-Arctic branch requires an operating area other than Arctic_waters." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:operatingArea "Arctic_waters" .
                        }
                    }
                """
            ]
        ]
    ) .
