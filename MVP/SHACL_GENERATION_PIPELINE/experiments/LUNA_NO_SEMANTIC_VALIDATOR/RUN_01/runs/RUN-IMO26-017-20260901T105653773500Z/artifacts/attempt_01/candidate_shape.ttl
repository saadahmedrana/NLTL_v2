@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_017_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Chapter 11-1 applicability must be true for this branch."
            ] ;
            sh:property [
                sh:path nltl:voyagePlanPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When Chapter 11-1 applies, a voyage plan must be present."
            ] ;
            sh:property [
                sh:path nltl:intendedVoyageHazard ;
                sh:datatype xsd:string ;
                sh:message "Each intended voyage hazard must be represented as a string."
            ] ;
            sh:property [
                sh:path nltl:voyagePlanCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When Chapter 11-1 applies, the voyage plan must cover every intended voyage hazard."
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Chapter 11-1 applicability must be false for this branch."
            ]
        ]
    ) .
