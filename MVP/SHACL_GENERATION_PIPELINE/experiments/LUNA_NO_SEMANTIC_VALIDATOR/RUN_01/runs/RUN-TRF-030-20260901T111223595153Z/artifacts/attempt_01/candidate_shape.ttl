@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-030-QuantityValue-MPa>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-QuantityValue-m>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-QuantityValue-unitless>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape>
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-m> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case must specify its load patch length with metre units."
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-unitless> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case must specify its corresponding dimensionless ice load area factor ca."
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-m> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case must specify a vertical load position."
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-m> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct analysis case must specify a horizontal load position."
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The direct analysis case must confirm that the load position minimizes structural capacity."
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The direct analysis case must confirm evaluation of combined bending and shear."
    ] .

<urn:nltl:generated-shape:TRF-030-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-MPa> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the externally determined ice pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-MPa> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the externally determined applied ice pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-m> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the load patch height in metres."
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether load length was determined from the structural arrangement."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ;
                sh:minCount 2
            ]
        ]
    ) .
