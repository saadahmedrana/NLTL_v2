@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasObliquePlatingInterpolationCase ;
        sh:class nltl:obliquePlatingInterpolationCase ;
        sh:minCount 1 ;
        sh:node gen:ObliquePlatingInterpolationCaseShape ;
        sh:message "An oblique plating interpolation case is required."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node gen:CalculationCaseShape ;
        sh:message "A calculation case containing the required framing thickness inputs is required."
    ] .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "Longitudinal framing net plate thickness is required in the calculation case."
    ] ;
    sh:property [
        sh:path nltl:transverseFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "Transverse framing net plate thickness is required in the calculation case."
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CoordinateQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ResultQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:InterpolationPointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:node gen:CoordinateQuantityShape ;
        sh:message "Each interpolation point requires a dimensionless coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:node gen:ResultQuantityShape ;
        sh:message "Each interpolation point requires an externally computed result."
    ] .

gen:ApplicableObliqueCaseShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing angle must be strictly between 20 and 70 degrees for the linear-interpolation branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:framingAngle ?angle .
                    ?angle qudt:numericValue ?value .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value > 20 &&
                        ?value < 70
                    )
                }
            }
        """
    ] ;
    sh:property [
        sh:path nltl:interpolatedNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "The applicable interpolation case requires an interpolated net plate thickness result."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The applicable interpolation case requires a lower interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The applicable interpolation case requires an upper interpolation endpoint."
    ] .

gen:NonApplicableObliqueCaseShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing angle must establish the non-applicable branch when linear interpolation is not required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:framingAngle ?angle .
                    ?angle qudt:numericValue ?value .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        (?value <= 20 || ?value >= 70)
                    )
                }
            }
        """
    ] .

gen:ObliquePlatingInterpolationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:node gen:AngleQuantityShape ;
        sh:message "The oblique plating interpolation case requires a framing angle."
    ] ;
    sh:or (
        [ sh:node gen:ApplicableObliqueCaseShape ]
        [ sh:node gen:NonApplicableObliqueCaseShape ]
    ) .
