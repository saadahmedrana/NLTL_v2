@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:DecimalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A decimal numeric value is required."
    ] .

gs:LengthMmQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use millimetres."
    ] .

gs:LengthMQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use metres."
    ] .

gs:AreaCm2QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use square centimetres."
    ] .

gs:AngleDegreeQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The angle must use degrees."
    ] .

gs:DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The coordinate must be dimensionless."
    ] .

gs:StructuralMemberOperandShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gs:LengthMQuantityShape ;
        sh:minCount 1 ;
        sh:message "Frame spacing is required for the readiness record."
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node gs:LengthMmQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node gs:LengthMmQuantityShape ;
        sh:minCount 1 ;
        sh:message "Attached shell plate thickness is required for applicability."
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node gs:DecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated plastic section modulus is required."
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:node gs:AreaCm2QuantityShape ;
        sh:minCount 1 ;
        sh:message "Local-frame flange area is required for applicability."
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node gs:LengthMmQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node gs:AngleDegreeQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node gs:LengthMmQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node gs:LengthMmQuantityShape ;
        sh:minCount 1
    ] .

gs:PlatingShape a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node gs:AngleDegreeQuantityShape ;
        sh:minCount 1 ;
        sh:message "Framing angle omega is required to select the applicable framing treatment."
    ] .

gs:InterpolationPointShape a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:node gs:DecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "An externally computed interpolation result is required."
    ] .

gs:CalculationCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:node gs:InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "The lower interpolation endpoint is required."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:node gs:InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "The upper interpolation endpoint is required."
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node gs:LengthMmQuantityShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated plastic neutral-axis height is required."
    ] .

gs:LocalFrameSectionCalculationCaseShape a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:node gs:PlatingShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:node gs:StructuralMemberOperandShape ;
        sh:minCount 1
    ] .

gs:StructuralMemberShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:node gs:StructuralMemberOperandShape ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:node gs:LocalFrameSectionCalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "A local-frame section calculation case is required."
    ] .

gs:I2_030_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node gs:CalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide a calculation case containing externally computed results."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide the structural-member inputs for the readiness check."
    ] .
