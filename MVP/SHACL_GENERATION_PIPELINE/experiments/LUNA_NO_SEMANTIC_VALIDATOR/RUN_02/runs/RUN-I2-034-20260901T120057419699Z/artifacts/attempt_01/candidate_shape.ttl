@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:I2-034-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A quantity value must contain one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use kN as its unit."
    ] .

<urn:nltl:generated-shape:I2-034-LoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-034-QuantityValueShape> ;
        sh:message "Each represented load case must provide one combined shear-and-bending demand."
    ] .

<urn:nltl:generated-shape:I2-034-ApplicableMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable member must be identified as longitudinal."
    ] ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:sideStructureLocation ;
        sh:message "An applicable longitudinal member must be located in the side structure."
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-034-QuantityValueShape> ;
        sh:message "An applicable member must provide its plastic strength."
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-034-QuantityValueShape> ;
        sh:message "An applicable member must provide its midspan plastic-collapse load."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:class nltl:loadCase ;
        sh:node <urn:nltl:generated-shape:I2-034-LoadCaseShape>
    ] ;
    sh:sparql [
        sh:message "The combined shear-and-bending demand must not exceed the member plastic strength or midspan plastic-collapse load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMemberLoadCase ?case .
                ?case nltl:combinedShearAndBendingDemand ?demandQuantity .
                ?demandQuantity qudt:numericValue ?demandValue .
                $this nltl:plasticStrength ?strengthQuantity .
                ?strengthQuantity qudt:numericValue ?strengthValue .
                $this nltl:midspanPlasticCollapseLoad ?collapseQuantity .
                ?collapseQuantity qudt:numericValue ?collapseValue .
                FILTER (
                    xsd:decimal(?demandValue) > xsd:decimal(?strengthValue)
                    ||
                    xsd:decimal(?demandValue) > xsd:decimal(?collapseValue)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-034-NonLongitudinalMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A non-applicable member branch must explicitly identify the member as non-longitudinal."
    ] .

<urn:nltl:generated-shape:I2-034-NonSideMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:message "A non-side member branch must provide its structural location."
    ] ;
    sh:sparql [
        sh:message "A member classified outside the side structure must not also be classified as a side-structure member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:structuralLocation ?location .
                FILTER NOT EXISTS {
                    $this nltl:structuralLocation nltl:sideStructureLocation .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:I2-034-StructuralMemberShape>
    a sh:NodeShape ;
    sh:or (
        <urn:nltl:generated-shape:I2-034-ApplicableMemberShape>
        <urn:nltl:generated-shape:I2-034-NonLongitudinalMemberShape>
        <urn:nltl:generated-shape:I2-034-NonSideMemberShape>
    ) .

<urn:nltl:generated-shape:I2-034-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:message "The ship must identify its frame profile type."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node <urn:nltl:generated-shape:I2-034-StructuralMemberShape>
    ] .
