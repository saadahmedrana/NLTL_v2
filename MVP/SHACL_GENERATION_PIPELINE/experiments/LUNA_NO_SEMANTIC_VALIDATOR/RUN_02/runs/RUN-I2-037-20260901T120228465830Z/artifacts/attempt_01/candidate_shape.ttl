@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gs:I2_037_StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify the structural members subject to the ice-load design case."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:class nltl:iceLoadPatchDesignCase ;
        sh:node gs:I2_037_DesignCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must provide an ice-load-patch design case."
    ] .

gs:I2_037_StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:class nltl:loadCase ;
        sh:node gs:I2_037_LoadCaseShape ;
        sh:minCount 1 ;
        sh:message "Each structural member must have a corresponding load case."
    ] .

gs:I2_037_LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:combinedShearBendingEffect ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load case must record the combined bending and shear effect."
    ] ;
    sh:property [
        sh:path nltl:loadPatchApplicationLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load case must record the load-patch application location."
    ] .

gs:I2_037_DesignCaseShape
    a sh:NodeShape ;
    sh:class nltl:iceLoadPatchDesignCase ;
    sh:property [
        sh:path nltl:memberCapacityMinimizationConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The design case must confirm that the load patch is applied where combined bending and shear capacity is minimised."
    ] .

gs:I2_037_MemberCapacityShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:memberCapacity ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
