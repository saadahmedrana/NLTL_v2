@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "The ship must specify one supported Polar Class."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must identify its plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "Each steel-grade requirement case must provide one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:message "Each applicable plating case must provide one supported actual hull structural steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:message "Each steel-grade requirement case must specify one supported material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:message "Each steel-grade requirement case must specify one supported steel-strength category."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required grade selected from IACS UR I2 Table 8 is missing or incorrect, the actual grade is below the selected grade within its strength category, or a not-applicable combination contains a required grade." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:asBuiltPlateThickness ?thicknessNode ;
        nltl:steelMaterialClass ?material ;
        nltl:steelStrengthCategory ?category ;
        nltl:actualHullStructuralSteelGrade ?actual .
  ?thicknessNode qudt:numericValue ?thickness .

  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?polar .

  OPTIONAL { $this nltl:requiredHullStructuralSteelGrade ?required . }
  OPTIONAL { ?actual nltl:steelGradeOrderRank ?actualRank . }

  BIND(
    IF(?polar IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3), "13",
      IF(?polar IN (nltl:polarClassPc4, nltl:polarClassPc5), "45",
        IF(?polar IN (nltl:polarClassPc6, nltl:polarClassPc7), "67", ""))
    ) AS ?polarGroup
  )

  BIND(
    IF(?thickness <= 10, 1,
      IF(?thickness <= 15, 2,
        IF(?thickness <= 20, 3,
          IF(?thickness <= 25, 4,
            IF(?thickness <= 30, 5,
              IF(?thickness <= 35, 6,
                IF(?thickness <= 40, 7,
                  IF(?thickness <= 45, 8,
                    IF(?thickness <= 50, 9, 0)
                  )
                )
              )
            )
          )
        )
      )
    ) AS ?band
  )

  BIND(
    IF(?material = nltl:steelMaterialClassOne,
      IF(?polarGroup = "67",
        IF(?band <= 6, 1, IF(?band <= 9, 2, 0)),
        IF(?band <= 2, 1, IF(?band <= 6, 2, IF(?band <= 9, 3, 0)))
      ),
      IF(?material = nltl:steelMaterialClassTwo,
        IF(?polarGroup = "67",
          IF(?band <= 4, 1, IF(?band <= 6, 2, IF(?band <= 9, 3, 0))),
          IF(?band <= 1, 1, IF(?band <= 4, 2, IF(?band <= 9, 3, 0)))
        ),
        IF(?material = nltl:steelMaterialClassThree,
          IF(?polarGroup = "67",
            IF(?band <= 5, 1, IF(?band <= 9, 3, 0)),
            IF(?polarGroup = "13",
              IF(?band <= 5, 3, 0),
              IF(?polarGroup = "45",
                IF(?band <= 5, 3,
                  IF(?band = 6, 3,
                    IF(?band = 7, 4, 0)
                  )
                ),
                0
              )
            )
          ),
          0
        )
      )
    ) AS ?expectedRank
  )

  BIND(
    IF(?category = nltl:normalStrengthSteelCategory,
      IF(?expectedRank = 1, nltl:steelGradeB,
        IF(?expectedRank = 2, nltl:steelGradeD,
          IF(?expectedRank = 3, nltl:steelGradeE, nltl:benchmarkEntity)
        )
      ),
      IF(?category = nltl:highTensileSteelCategory,
        IF(?expectedRank = 1, nltl:steelGradeAh,
          IF(?expectedRank = 2, nltl:steelGradeDh,
            IF(?expectedRank = 3, nltl:steelGradeEh,
              IF(?expectedRank = 4, nltl:steelGradeFh, nltl:benchmarkEntity)
            )
          )
        ),
        nltl:benchmarkEntity
      )
    ) AS ?expectedGrade
  )

  FILTER(
    ?expectedRank = 0
    || (
      ?expectedRank > 0
      &&
      (
        !BOUND(?required)
        || ?required != ?expectedGrade
        || !BOUND(?actualRank)
        || ?actualRank < ?expectedRank
        || (
          ?category = nltl:normalStrengthSteelCategory
          &&
          ?actual NOT IN (
            nltl:steelGradeB,
            nltl:steelGradeD,
            nltl:steelGradeE
          )
        )
        || (
          ?category = nltl:highTensileSteelCategory
          &&
          ?actual NOT IN (
            nltl:steelGradeAh,
            nltl:steelGradeDh,
            nltl:steelGradeEh,
            nltl:steelGradeFh
          )
        )
      )
    )
    || (
      ?expectedRank = 0
      && BOUND(?required)
    )
  )
}
"""
    ] .
