@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_065_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node gen:I2_065_CalculationCaseShape
    ] .

gen:I2_065_CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:class nltl:calculationMethodValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each calculation case must identify its calculation method."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A nonlinear calculation case must provide acceptance evidence, confirm the minor permanent deformation assessment, and provide the required margins, deformations, and structural dimension with the prescribed datatypes and units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                        ?evidence a nltl:evidenceArtifact .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:minorPermanentDeformationAssessmentSatisfied
                            "true"^^xsd:boolean .
                    }
                    ||
                    NOT EXISTS {
                        ?ship nltl:hasCalculationCase $this .
                        ?ship nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureNumber ;
                                  qudt:unit qudt:UNITLESS .
                        FILTER (datatype(?fractureNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?ship nltl:hasCalculationCase $this .
                        ?ship nltl:majorBucklingMargin ?buckling .
                        ?buckling qudt:numericValue ?bucklingNumber ;
                                  qudt:unit qudt:UNITLESS .
                        FILTER (datatype(?bucklingNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?ship nltl:hasCalculationCase $this .
                        ?ship nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingNumber ;
                                  qudt:unit qudt:UNITLESS .
                        FILTER (datatype(?yieldingNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:permanentLateralDeformation ?lateral .
                        ?lateral qudt:numericValue ?lateralNumber ;
                                 qudt:unit qudt:MilliM .
                        FILTER (datatype(?lateralNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:permanentOutOfPlaneDeformation ?outOfPlane .
                        ?outOfPlane qudt:numericValue ?outOfPlaneNumber ;
                                    qudt:unit qudt:MilliM .
                        FILTER (datatype(?outOfPlaneNumber) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:relevantStructuralDimension ?dimension .
                        ?dimension qudt:numericValue ?dimensionNumber ;
                                   qudt:unit qudt:MilliM .
                        FILTER (datatype(?dimensionNumber) = xsd:decimal)
                    }
                )
            }
        """
    ] .
