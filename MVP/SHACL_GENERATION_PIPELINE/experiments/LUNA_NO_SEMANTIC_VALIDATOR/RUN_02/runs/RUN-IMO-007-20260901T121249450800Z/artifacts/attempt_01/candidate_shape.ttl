@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-007> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:openWaterIceCondition ;
                sh:message "The ice condition must be open water for this branch."
            ] ;
            sh:property [
                sh:path nltl:seaIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:maxExclusive 1 ;
                        sh:message "For open water, sea ice concentration must be less than 1/10."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:iceOfLandOriginPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "For open water, no ice of land origin may be present."
            ]
        ] [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:iceConditionLessSevereThanCategoryAAndB
                    nltl:iceFreeIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                    nltl:otherWatersIceCondition
                    nltl:thinFirstYearIceWithPossibleOldIceInclusions
                ) ;
                sh:message "The ice condition must identify a permitted non-open-water condition."
            ]
        ]
    ) .
