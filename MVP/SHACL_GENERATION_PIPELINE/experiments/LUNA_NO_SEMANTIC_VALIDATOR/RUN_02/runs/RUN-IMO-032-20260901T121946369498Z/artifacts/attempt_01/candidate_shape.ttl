@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_032_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                )
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:scantlingApprovalStatus ;
                        sh:minCount 1 ;
                        sh:hasValue nltl:evidenceStateApproved
                    ] ;
                    sh:property [
                        sh:path nltl:approvingAuthority ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:in (
                            "Administration"
                            "recognized organization accepted by the Administration"
                        )
                    ] ;
                    sh:property [
                        sh:path nltl:approvalStandard ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:in (
                            "standard acceptable to the Organization"
                            "another standard offering an equivalent level of safety"
                        )
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:scantlingApprovalStatus ;
                        sh:minCount 1 ;
                        sh:hasValue nltl:evidenceStateApproved
                    ] ;
                    sh:property [
                        sh:path nltl:approvingAuthority ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:in (
                            "Administration"
                            "recognized organization accepted by the Administration"
                        )
                    ] ;
                    sh:property [
                        sh:path nltl:approvalStandard ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:hasValue "acceptable standard adequate for operating ice type and concentration"
                    ] ;
                    sh:property [
                        sh:path nltl:operatingIceType ;
                        sh:datatype xsd:string ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:operatingIceConcentration ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue unit:UNITLESS
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "The ship must have approved scantling evidence with an authorized authority and applicable approval standard; ice-strengthened category C ships must also identify operating ice type and concentration." .
