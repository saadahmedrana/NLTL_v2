@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-055> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Valve exposure must be supplied as a boolean to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Valve type must be supplied to determine applicability."
    ] ;
    sh:sparql [
        sh:message "Exposed isolating, pressure, and vacuum valves shall have ice-accretion protection and remain continuously accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:valveExposed true ;
                      nltl:valveType ?valveType .
                FILTER (STR(?valveType) IN ("isolating", "pressure", "vacuum"))
                {
                    FILTER NOT EXISTS {
                        $this nltl:iceAccretionProtectionPresent true .
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:continuouslyAccessible true .
                    }
                }
            }
        """
    ] .
