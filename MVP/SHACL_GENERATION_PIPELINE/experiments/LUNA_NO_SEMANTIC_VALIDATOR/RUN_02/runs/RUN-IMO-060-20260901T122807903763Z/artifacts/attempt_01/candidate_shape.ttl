@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO060Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The fixed water system separation status must be recorded as exactly one boolean value."
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The independent sea suction status must be recorded as exactly one boolean value."
    ] ;
    sh:or (
        gen:IMO060FixedSystemNotSeparateShape
        gen:IMO060IndependentSuctionNotUsedShape
        gen:IMO060ApplicableShape
    ) .

gen:IMO060FixedSystemNotSeparateShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:hasValue false
    ] .

gen:IMO060IndependentSuctionNotUsedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:hasValue false
    ] .

gen:IMO060ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:seaSuctionIceClearingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, the sea suction must be capable of being cleared of ice accumulation."
    ] .
