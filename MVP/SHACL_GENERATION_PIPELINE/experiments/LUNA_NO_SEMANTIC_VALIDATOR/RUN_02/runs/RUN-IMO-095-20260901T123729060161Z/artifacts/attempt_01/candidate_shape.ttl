@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-095-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:searchAndRescueCommunicationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall declare search and rescue communication capability."
    ] ;
    sh:property [
        sh:path nltl:rescueCoordinationCentreVoiceOrData ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall support voice or data communications with relevant rescue coordination centres."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:minCount 2 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt-unit:MegaHZ
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudt-unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:supportedAircraftVoiceFrequency ?frequency1215 .
                ?frequency1215 qudt:numericValue ?value1215 ;
                               qudt:unit qudt-unit:MegaHZ .
                FILTER (
                    datatype(?value1215) = xsd:decimal &&
                    ?value1215 >= 121.5 &&
                    ?value1215 <= 121.5
                )

                ?this nltl:supportedAircraftVoiceFrequency ?frequency1231 .
                ?frequency1231 qudt:numericValue ?value1231 ;
                               qudt:unit qudt-unit:MegaHZ .
                FILTER (
                    datatype(?value1231) = xsd:decimal &&
                    ?value1231 >= 123.1 &&
                    ?value1231 <= 123.1
                )

                FILTER (?frequency1215 != ?frequency1231)
            }
        """
    ] .
