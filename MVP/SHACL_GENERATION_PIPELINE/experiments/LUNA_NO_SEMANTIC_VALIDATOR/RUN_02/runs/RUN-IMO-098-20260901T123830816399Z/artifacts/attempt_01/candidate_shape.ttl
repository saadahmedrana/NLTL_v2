@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-098-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating applicability must be recorded."
    ] ;
    sh:sparql [
        sh:message "When the ship operates in low air temperature, every other survival craft must have at least one location-signal device and one on-scene transmit/receive communication device." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipOperatesInLowAirTemperature true .
    $this nltl:hasOtherSurvivalCraft ?craft .
    {
        FILTER NOT EXISTS {
            ?craft nltl:hasLocationSignalDevice ?locationDevice .
        }
    }
    UNION
    {
        FILTER NOT EXISTS {
            ?craft nltl:hasOnSceneCommunicationDevice ?communicationDevice .
        }
    }
}
"""
    ] .
