@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO101PolarRoutePlanShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarRoutePlan ;
        sh:minCount 1 ;
        sh:class nltl:polarRoutePlan ;
        sh:node gs:IMO101PolarRoutePlanNodeShape ;
        sh:message "Each ship shall have a polar route plan whose voyage-planning topic coverage is recorded as true."
    ] .

gs:IMO101PolarRoutePlanNodeShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The polar route plan shall record voyage-planning topic coverage as true."
    ] .
