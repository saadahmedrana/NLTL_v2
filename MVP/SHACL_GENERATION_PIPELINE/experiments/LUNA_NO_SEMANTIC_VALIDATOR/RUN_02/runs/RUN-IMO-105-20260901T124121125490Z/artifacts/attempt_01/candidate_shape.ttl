@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_105_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "An operating area is required to determine whether the Arctic-waters discharge prohibition applies."
    ] ;
    sh:property [
        sh:path nltl:oilOrOilyMixtureDischargeToSea ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "In Arctic waters, discharge of oil or oily mixtures into the sea must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area .
                FILTER (?area = "Arctic_waters")
                {
                    FILTER NOT EXISTS {
                        $this nltl:oilOrOilyMixtureDischargeToSea ?discharge .
                        FILTER (?discharge = false)
                    }
                }
                UNION
                {
                    $this nltl:oilOrOilyMixtureDischargeToSea ?discharge .
                    FILTER (?discharge != false)
                }
            }
        """
    ] .
