@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:IMO111Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlg:IMO111ApplicableShape
        nltlg:IMO111Pre2017Shape
        nltlg:IMO111OtherCategoryShape
    ) .

nltlg:IMO111ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node nltlg:IMO111ApplicableTankShape
    ] .

nltlg:IMO111Pre2017Shape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxInclusive "2016-12-31"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:IMO111OtherCategoryShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlg:IMO111ApplicableTankShape a sh:NodeShape ;
    sh:or (
        nltlg:IMO111NonRegulatedComponentShape
        nltlg:IMO111OilResidueTankShape
        nltlg:IMO111OilyBilgeTankShape
    ) .

nltlg:IMO111NonRegulatedComponentShape a sh:NodeShape ;
    sh:not [
        sh:or (
            [ sh:class nltl:oilResidueTank ]
            [ sh:class nltl:oilyBilgeWaterHoldingTank ]
        )
    ] .

nltlg:IMO111OilResidueTankShape a sh:NodeShape ;
    sh:class nltl:oilResidueTank ;
    sh:or (
        nltlg:IMO111SmallTankShape
        nltlg:IMO111LargeTankShape
    ) .

nltlg:IMO111OilyBilgeTankShape a sh:NodeShape ;
    sh:class nltl:oilyBilgeWaterHoldingTank ;
    sh:or (
        nltlg:IMO111SmallTankShape
        nltlg:IMO111LargeTankShape
    ) .

nltlg:IMO111SmallTankShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxInclusive "30"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

nltlg:IMO111LargeTankShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "30"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0.76"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
