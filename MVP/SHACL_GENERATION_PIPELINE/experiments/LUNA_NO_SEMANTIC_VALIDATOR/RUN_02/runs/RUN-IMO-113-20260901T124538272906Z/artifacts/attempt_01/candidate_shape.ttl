@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-113> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or ( _:branch1 _:branch2 ) .

_:branch1
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:message "The ship's polar-water applicability must be explicitly false when polar operation coverage is not required."
    ] .

_:branch2
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:cargoRecordBookPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Polar operation coverage must be recorded in the applicable Cargo Record Book."
    ] ;
    sh:property [
        sh:path nltl:manualPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Polar operation coverage must be recorded in the applicable Manual."
    ] ;
    sh:property [
        sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Polar operation coverage must be recorded in the applicable noxious liquid substance or marine pollution emergency plan."
    ] .
