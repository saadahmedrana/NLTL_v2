@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:arcticWaters ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For an Arctic_waters ship discharging food waste to sea, the required ice-related distances and concentration records must be present and conforming." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea ;
                      nltl:arcticWaters ?arcticWaters ;
                      nltl:foodWasteDischargeToSea ?discharge .

                FILTER(
                    STR(?operatingArea) = "Arctic_waters" &&
                    STR(?arcticWaters) = "Arctic_waters" &&
                    ?discharge = true
                )

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestLandIceShelfOrFastIce ?nearestDistance .
                    ?nearestDistance qudt:numericValue ?nearestValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                    FILTER(
                        DATATYPE(?nearestValue) = xsd:decimal &&
                        ?nearestValue >= 12
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                    ?areaDistance qudt:numericValue ?areaValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                    FILTER(DATATYPE(?areaValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?nearbyConcentration .
                    ?nearbyConcentration qudt:numericValue ?nearbyValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER(
                        DATATYPE(?nearbyValue) = xsd:decimal &&
                        ?nearbyValue > 1
                    )
                }

                FILTER NOT EXISTS {
                    $this nltl:iceConcentration ?concentration .
                    ?concentration qudt:numericValue ?concentrationValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER(DATATYPE(?concentrationValue) = xsd:decimal)
                }
            }
        """
    ] .
