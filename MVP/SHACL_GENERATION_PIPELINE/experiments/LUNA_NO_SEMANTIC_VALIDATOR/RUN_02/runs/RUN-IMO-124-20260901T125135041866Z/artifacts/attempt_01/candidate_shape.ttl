@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-124> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:antarcticArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an Antarctic-area MARPOL Annex V regulation 6.1 discharge, the required distances, ice-concentration input, and prohibition must conform." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea "Antarctic_area"^^xsd:string .
                $this nltl:antarcticArea "Antarctic_area"^^xsd:string .
                $this nltl:marpolAnnexVRegulation6Point1DischargeOccurs true .

                {
                    FILTER NOT EXISTS {
                        $this nltl:distanceToNearestFastIce ?nearest .
                        ?nearest qudt:numericValue ?nearestValue .
                        ?nearest qudt:unit unit:MI_N .
                        FILTER(
                            datatype(?nearestValue) = xsd:decimal &&
                            ?nearestValue >= "12"^^xsd:decimal
                        )
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:nearbyIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?concentrationValue .
                        ?concentration qudt:unit unit:UNITLESS .
                        FILTER(datatype(?concentrationValue) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                        ?areaDistance qudt:numericValue ?areaDistanceValue .
                        ?areaDistance qudt:unit unit:MI_N .
                        FILTER(datatype(?areaDistanceValue) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:foodWasteDischargeOntoIce false .
                    }
                }
            }
        """
    ] .
