@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO26_002_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO26_002_LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO26_002_GrossTonnageQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 9-1 applicability must match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:engagedInTrade ?engagedInTrade ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?tonnageQuantity ;
                      nltl:polarCodeChapter9Dash1Applicable ?applicable .
                ?lengthQuantity <http://qudt.org/schema/qudt/numericValue> ?length .
                ?tonnageQuantity <http://qudt.org/schema/qudt/numericValue> ?tonnage .
                FILTER (
                    (
                        ?shipType = "fishing_vessel"^^xsd:string &&
                        ?length >= 24 &&
                        ?applicable = true
                    ) ||
                    (
                        ?shipType = "pleasure_yacht"^^xsd:string &&
                        ?tonnage >= 300 &&
                        ?engagedInTrade = false &&
                        ?applicable = true
                    ) ||
                    (
                        ?shipType = "cargo_ship"^^xsd:string &&
                        ?tonnage >= 300 &&
                        ?tonnage < 500 &&
                        ?applicable = true
                    ) ||
                    (
                        !(
                            (
                                ?shipType = "fishing_vessel"^^xsd:string &&
                                ?length >= 24
                            ) ||
                            (
                                ?shipType = "pleasure_yacht"^^xsd:string &&
                                ?tonnage >= 300 &&
                                ?engagedInTrade = false
                            ) ||
                            (
                                ?shipType = "cargo_ship"^^xsd:string &&
                                ?tonnage >= 300 &&
                                ?tonnage < 500
                            )
                        ) &&
                        ?applicable = false
                    )
                )
            }
        """
    ] .

gs:IMO26_002_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gs:IMO26_002_GrossTonnageQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
