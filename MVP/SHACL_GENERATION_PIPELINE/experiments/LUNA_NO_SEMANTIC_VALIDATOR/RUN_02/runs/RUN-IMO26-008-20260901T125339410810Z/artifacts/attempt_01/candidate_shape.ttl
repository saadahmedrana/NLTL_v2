@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO26_008_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ship must comply with SOLAS regulation V/22.1.9.4."
            ] ;
            sh:property [
                sh:path nltl:clearViewAsternStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ship must have a clear view astern."
            ]
        ]
        [
            sh:property [
                sh:path nltl:administrationApprovedEquivalentVisibilityArrangementPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "An Administration-acceptable equivalent visibility arrangement must be provided when the SOLAS and clear-astern-view requirements cannot be met."
            ]
        ]
    ) .
