@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_009_RequiredAntennaShape
    a sh:NodeShape ;
    sh:class nltl:navigationOrCommunicationAntenna ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each required navigation or communication antenna must have ice accumulation prevention means when ice accretion is likely."
    ] .

gen:IMO26_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:class nltl:navigationOrCommunicationAntenna ;
                sh:node gen:IMO26_009_RequiredAntennaShape
            ]
        ]
    ) ;
    sh:message "iceAccretionLikely must be explicitly recorded as true or false; when true, every linked required navigation or communication antenna must provide ice accumulation prevention."
.
