@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_010_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:requiredSensorProjectsBelowHull ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The below-hull sensor applicability value must be true for this branch."
            ] ;
            sh:property [
                sh:path nltl:sensorIceProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Sensors projecting below the hull shall have ice protection."
            ]
        ]
        [
            sh:property [
                sh:path nltl:requiredSensorProjectsBelowHull ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The below-hull sensor applicability value must be false for this branch."
            ]
        ]
    ) .
