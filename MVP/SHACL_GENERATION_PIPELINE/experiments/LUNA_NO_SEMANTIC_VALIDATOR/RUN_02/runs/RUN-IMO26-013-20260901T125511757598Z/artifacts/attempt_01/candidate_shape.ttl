@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-013> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:plannedOrActualLatitude ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxCount 1 ;
                        sh:maxInclusive "80"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:plannedOrActualLatitude ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxCount 1 ;
                        sh:minExclusive "80"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:gnssCompassOrEquivalentCount ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:message "A ship proceeding to a latitude over 80 degrees shall have at least one GNSS compass or equivalent."
            ] ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:minCount 1 ;
                sh:node [ sh:class nltl:benchmarkEntity ] ;
                sh:message "A required GNSS compass or equivalent shall be connected to the ship's main source of power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:minCount 1 ;
                sh:node [ sh:class nltl:benchmarkEntity ] ;
                sh:message "A required GNSS compass or equivalent shall be connected to the ship's emergency source of power."
            ]
        ]
    ) .
