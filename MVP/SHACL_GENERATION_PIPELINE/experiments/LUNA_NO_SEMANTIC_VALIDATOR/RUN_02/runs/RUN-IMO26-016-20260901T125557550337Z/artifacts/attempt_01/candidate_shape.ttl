@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO26_016_Chapter11_1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's polar-waters operating status is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:lengthOverall ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:engagedInTrade ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Chapter 11-1 applicability must be recorded for a ship operating in polar waters."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 11-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:shipOperatesInPolarWaters true ;
        nltl:shipType ?type ;
        nltl:lengthOverall ?lengthQuantity ;
        nltl:grossTonnage ?tonnageQuantity ;
        nltl:engagedInTrade ?trade ;
        nltl:polarCodeChapter11Dash1Applicable ?applicable .
  ?lengthQuantity qudt:numericValue ?length .
  ?tonnageQuantity qudt:numericValue ?tonnage .

  FILTER (
    (?type = "fishing_vessel" &&
     ?length >= 24 &&
     ?applicable = true)
    ||
    (?type = "pleasure_yacht" &&
     ?tonnage >= 300 &&
     ?trade = false &&
     ?applicable = true)
    ||
    (?type = "cargo_ship" &&
     ?tonnage >= 300 &&
     ?tonnage < 500 &&
     ?applicable = true)
    ||
    (?type = "fishing_vessel" &&
     ?length < 24 &&
     ?applicable = false)
    ||
    (?type = "pleasure_yacht" &&
     (?tonnage < 300 || ?trade = true) &&
     ?applicable = false)
    ||
    (?type = "cargo_ship" &&
     (?tonnage < 300 || ?tonnage >= 500) &&
     ?applicable = false)
    ||
    (?type != "fishing_vessel" &&
     ?type != "pleasure_yacht" &&
     ?type != "cargo_ship" &&
     ?applicable = false)
  )
}
"""
    ] .
