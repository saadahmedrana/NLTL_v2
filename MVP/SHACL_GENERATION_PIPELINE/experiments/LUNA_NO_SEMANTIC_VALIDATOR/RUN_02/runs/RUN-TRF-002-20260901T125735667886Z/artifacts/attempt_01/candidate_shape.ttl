@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-002> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:TRF-002-applicable>
        <urn:nltl:generated-shape:TRF-002-not-applicable>
    ) .

<urn:nltl:generated-shape:TRF-002-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine applicability of the 2017 Ice Class Regulations."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRegulationEdition2017 ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ships contracted during the applicable period shall identify the 2017 Ice Class Regulations."
    ] ;
    sh:sparql [
        sh:message "The construction contract date is not within the applicability period of the 2017 Ice Class Regulations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    YEAR(?date) > 2019
                    || (YEAR(?date) = 2019 && MONTH(?date) >= 1)
                )
                FILTER (
                    YEAR(?date) < 2021
                    || (YEAR(?date) = 2021 &&
                        (MONTH(?date) < 7 ||
                         (MONTH(?date) = 7 && DAY(?date) < 5)))
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-002-not-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine applicability of the 2017 Ice Class Regulations."
    ] ;
    sh:sparql [
        sh:message "The construction contract date falls within the applicability period of the 2017 Ice Class Regulations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    YEAR(?date) < 2019
                    || YEAR(?date) > 2021
                    || (YEAR(?date) = 2021 &&
                        (MONTH(?date) > 7 ||
                         (MONTH(?date) = 7 && DAY(?date) >= 5)))
                )
            }
        """
    ] .
