@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF004Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:TRF004ApplicableBranch
        gs:TRF004NonApplicableBranch
    ) .

gs:TRF004ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A valid construction contract date is required to establish applicability of the 2008 Ice Class Regulations."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:hasValue nltl:iceClassRegulationEdition2008 ;
        sh:message "Ships contracted for construction from 1 January 2010 through 31 December 2011 shall identify the 2008 Ice Class Regulations as the applicable edition."
    ] ;
    sh:sparql [
        sh:message "The construction contract date does not establish the applicability period for the 2008 Ice Class Regulations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:constructionContractDate ?date .
                    FILTER (
                        datatype(?date) = xsd:date &&
                        YEAR(?date) >= 2010 &&
                        YEAR(?date) < 2012
                    )
                }
            }
        """
    ] .

gs:TRF004NonApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A valid construction contract date is required to establish applicability of the 2008 Ice Class Regulations."
    ] ;
    sh:sparql [
        sh:message "The construction contract date falls within the applicability period of the 2008 Ice Class Regulations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    datatype(?date) = xsd:date &&
                    YEAR(?date) >= 2010 &&
                    YEAR(?date) < 2012
                )
            }
        """
    ] .
