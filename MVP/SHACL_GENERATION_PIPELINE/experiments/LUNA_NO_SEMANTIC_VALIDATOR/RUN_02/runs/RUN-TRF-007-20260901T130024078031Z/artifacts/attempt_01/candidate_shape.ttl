@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF_007_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship shall have a permitted Finnish-Swedish ice class."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                )
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minInclusive "2003-09-01"^^xsd:date
            ]
        ]
        [
            sh:sparql [
                sh:message "For an IA Super or IA ship whose keel was laid or which was at a similar stage of construction before 1 September 2003, the applicable 2017 Ice Class Regulations method, delivery date, and assessment date shall establish compliance by 1 January of the year twenty years after delivery." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass ;
                              nltl:constructionStageDate ?constructionDate .

                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                        FILTER (?constructionDate < "2003-09-01"^^xsd:date)

                        FILTER (
                            NOT EXISTS {
                                $this nltl:deliveryDate ?deliveryDate ;
                                      nltl:assessmentDate ?assessmentDate .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:engineOutputComplianceMethod ?method .
                                FILTER (
                                    ?method IN (
                                        nltl:traficom2017Section3Point2Point2Method,
                                        nltl:traficom2017Section3Point2Point4Method
                                    )
                                )
                            }
                            ||
                            EXISTS {
                                $this nltl:deliveryDate ?deliveryDate ;
                                      nltl:assessmentDate ?assessmentDate .

                                FILTER (
                                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                                    ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                        &&
                                        (
                                            MONTH(?assessmentDate) > 1
                                            ||
                                            (
                                                MONTH(?assessmentDate) = 1
                                                &&
                                                DAY(?assessmentDate) > 1
                                            )
                                        )
                                    )
                                )
                            }
                        )
                    }
                """
            ]
        ]
    ) .
