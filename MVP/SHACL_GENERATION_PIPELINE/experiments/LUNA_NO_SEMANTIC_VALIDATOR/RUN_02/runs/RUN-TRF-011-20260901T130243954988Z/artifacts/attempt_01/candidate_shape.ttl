@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-011-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline shall contain exactly the maximum vertical coordinate of the intended ice-operating waterlines at every longitudinal position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                {
                    SELECT ?ship ?x
                           (MAX(?intendedY) AS ?maximumIntendedY)
                           (MIN(?upperY) AS ?minimumUpperY)
                           (MAX(?upperY) AS ?maximumUpperY)
                    WHERE {
                        {
                            ?ship nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedAnchor .
                            ?intendedAnchor nltl:longitudinalPosition ?intendedAnchorX .
                            ?intendedAnchorX qudt:numericValue ?anchorX .
                            BIND(?anchorX AS ?x)
                        }
                        UNION
                        {
                            ?ship nltl:hasUpperIceWaterline ?upperWaterline .
                            ?upperWaterline nltl:hasWaterlineProfilePoint ?upperAnchor .
                            ?upperAnchor nltl:longitudinalPosition ?upperAnchorX .
                            ?upperAnchorX qudt:numericValue ?upperAnchorXValue .
                            BIND(?upperAnchorXValue AS ?x)
                        }

                        OPTIONAL {
                            ?ship nltl:hasIntendedIceOperatingWaterline ?intendedWaterline2 .
                            ?intendedWaterline2 nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedPointX .
                            ?intendedPointX qudt:numericValue ?intendedX .
                            ?intendedPoint nltl:verticalCoordinate ?intendedPointY .
                            ?intendedPointY qudt:numericValue ?intendedY .
                            FILTER(?intendedX = ?x)
                        }

                        OPTIONAL {
                            ?ship nltl:hasUpperIceWaterline ?upperWaterline2 .
                            ?upperWaterline2 nltl:hasWaterlineProfilePoint ?upperPoint .
                            ?upperPoint nltl:longitudinalPosition ?upperPointX .
                            ?upperPointX qudt:numericValue ?upperX .
                            ?upperPoint nltl:verticalCoordinate ?upperPointY .
                            ?upperPointY qudt:numericValue ?upperY .
                            FILTER(?upperX = ?x)
                        }
                    }
                    GROUP BY ?ship ?x
                }
                FILTER(
                    !BOUND(?maximumIntendedY) ||
                    !BOUND(?minimumUpperY) ||
                    !BOUND(?maximumUpperY) ||
                    ?minimumUpperY != ?maximumIntendedY ||
                    ?maximumUpperY != ?maximumIntendedY
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF-011-ProfilePointShape>
    a sh:NodeShape ;
    sh:targetClass nltl:waterlineProfilePoint ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
