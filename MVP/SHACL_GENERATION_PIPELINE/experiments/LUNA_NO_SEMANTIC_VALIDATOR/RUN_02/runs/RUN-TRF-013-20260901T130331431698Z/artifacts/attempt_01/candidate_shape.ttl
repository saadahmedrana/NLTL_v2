@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A length quantity must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A draught quantity must use metres as its single unit."
    ] .

gen:ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must identify its ice class."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its upper ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its lower ice waterline."
    ] ;
    sh:property [
        sh:path nltl:operatingForeDraught ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its operating fore draught."
    ] ;
    sh:property [
        sh:path nltl:operatingAftDraught ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its operating aft draught."
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its maximum ice-class fore draught."
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its maximum ice-class aft draught."
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its minimum ice-class fore draught."
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "An ice-strengthened ship must provide its minimum ice-class aft draught."
    ] ;
    sh:sparql [
        sh:message "The operating draught at each perpendicular must be between the corresponding minimum and maximum ice-class draughts." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingForeDraught ?operatingForeNode .
                ?operatingForeNode qudt:numericValue ?operatingFore .

                $this nltl:maximumIceClassDraughtFore ?maximumForeNode .
                ?maximumForeNode qudt:numericValue ?maximumFore .

                $this nltl:minimumIceClassDraughtFore ?minimumForeNode .
                ?minimumForeNode qudt:numericValue ?minimumFore .

                $this nltl:operatingAftDraught ?operatingAftNode .
                ?operatingAftNode qudt:numericValue ?operatingAft .

                $this nltl:maximumIceClassDraughtAft ?maximumAftNode .
                ?maximumAftNode qudt:numericValue ?maximumAft .

                $this nltl:minimumIceClassDraughtAft ?minimumAftNode .
                ?minimumAftNode qudt:numericValue ?minimumAft .

                FILTER (
                    ?operatingFore < ?minimumFore ||
                    ?operatingFore > ?maximumFore ||
                    ?operatingAft < ?minimumAft ||
                    ?operatingAft > ?maximumAft
                )
            }
        """
    ] .

gen:NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1
    ] .

gen:TRF013ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:in ( true false ) ;
        sh:minCount 1 ;
        sh:message "The ship ice-strengthened applicability value must be present as a boolean."
    ] ;
    sh:or (
        gen:ApplicableShape
        gen:NotApplicableShape
    ) .
