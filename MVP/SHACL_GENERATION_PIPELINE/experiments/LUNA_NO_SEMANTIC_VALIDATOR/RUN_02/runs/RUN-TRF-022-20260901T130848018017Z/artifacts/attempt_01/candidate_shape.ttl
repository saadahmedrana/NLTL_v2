@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF022ReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Bow rake at quarter breadth input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Waterline angle at quarter breadth input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Ship length input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Ice class draught input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Ship breadth input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient C3 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient C4 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient C5 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient F1 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient F2 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient F3 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient F4 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient G1 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient G2 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Coefficient G3 input is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Externally computed flare angle result is required with the declared quantity representation."
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF022QuantityValueShape ;
        sh:message "Externally computed clamped hull geometry result is required with the declared quantity representation."
    ] .

gs:TRF022QuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Quantity value must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Quantity value must have exactly one declared unit."
    ] .
