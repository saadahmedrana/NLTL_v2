@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF043ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:node gs:TRF043TerminationCaseShape ;
        sh:message "Each linked framing ice-strengthening termination case must conform to the termination rule."
    ] .

gs:TRF043TerminationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "The termination case must state the extension beyond the adjacent boundary in millimetres."
    ] ;
    sh:property [
        sh:path nltl:terminationAdjacentBoundary ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [
                    sh:class nltl:deckStructure
                ]
                [
                    sh:class nltl:tankBoundaryPlating
                ]
                [
                    sh:class nltl:tankTop
                ]
            )
        ] ;
        sh:message "The termination adjacent boundary must be a deck structure, tank boundary plating, or tank top."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path (
                    nltl:extensionBeyondAdjacentDeckOrTankBoundary
                    qudt:numericValue
                ) ;
                sh:maxInclusive "250"^^xsd:decimal
            ] ;
            sh:property [
                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "Termination at the adjacent boundary must be permitted when the extension is no more than 250 mm."
            ]
        ]
        [
            sh:property [
                sh:path (
                    nltl:extensionBeyondAdjacentDeckOrTankBoundary
                    qudt:numericValue
                ) ;
                sh:minExclusive "250"^^xsd:decimal
            ]
        ]
    ) .
