@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-046-FrameShape> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path ( nltl:hasUpperEnd nltl:hasAttachedSupportingStructure ) ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The upper end of the strengthened part must be attached to a deck, tank boundary plating, or ice stringer."
    ] ;
    sh:sparql [
        sh:message "Ordinary non-ice-strengthened scantlings may be used above a supporting structure only when that structure is at or above the ice-belt upper limit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStrengthenedPart ?part .
                ?part nltl:ordinaryFrameScantlingsUsed true .
                FILTER NOT EXISTS {
                    $this nltl:hasUpperEnd ?end .
                    ?end nltl:hasTerminationAboveSupportingStructure ?support .
                    ?support rdf:type ?supportType .
                    FILTER (?supportType IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:iceStringer
                    ))
                    ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A horizontal connection member with the same scantlings as the main frame must connect to an adjacent main frame and be associated with a supporting structure at or above the ice-belt upper limit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasUpperEnd ?end .
                ?end nltl:hasHorizontalConnectionMember ?member .
                ?member nltl:sameScantlingsAsMainFrame true .
                FILTER (
                    NOT EXISTS {
                        ?member nltl:connectsToAdjacentMainFrame ?main .
                        ?main rdf:type nltl:mainFrame .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasUpperEnd ?conditionalEnd .
                        ?conditionalEnd nltl:hasTerminationAboveSupportingStructure ?support .
                        ?support rdf:type ?supportType .
                        FILTER (?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        ))
                        ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .
                    }
                )
            }
        """
    ] .
