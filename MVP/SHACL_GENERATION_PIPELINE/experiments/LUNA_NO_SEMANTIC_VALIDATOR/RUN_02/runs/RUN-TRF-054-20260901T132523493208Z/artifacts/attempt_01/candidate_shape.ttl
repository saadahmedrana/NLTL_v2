@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF054IceStringerShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloN-PER-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Design line load, outside-ice-belt factor, section modulus, and required shear area must satisfy the declared formulas within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:span ?spanNode ;
                      nltl:frameMomentFactorM ?momentNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:distanceToIceBelt ?iceBeltDistanceNode ;
                      nltl:stringerSpan ?stringerSpanNode ;
                      nltl:designLineLoad ?lineLoadNode ;
                      nltl:outsideIceBeltFactor ?outsideFactorNode ;
                      nltl:sectionModulus ?sectionModulusNode ;
                      nltl:requiredShearArea ?shearAreaNode .

                ?pressureNode qudt:numericValue ?pressureValue .
                ?heightNode qudt:numericValue ?heightValue .
                ?spanNode qudt:numericValue ?spanValue .
                ?momentNode qudt:numericValue ?momentValue .
                ?yieldNode qudt:numericValue ?yieldValue .
                ?iceBeltDistanceNode qudt:numericValue ?iceBeltDistanceValue .
                ?stringerSpanNode qudt:numericValue ?stringerSpanValue .
                ?lineLoadNode qudt:numericValue ?lineLoadValue .
                ?outsideFactorNode qudt:numericValue ?outsideFactorValue .
                ?sectionModulusNode qudt:numericValue ?sectionModulusValue .
                ?shearAreaNode qudt:numericValue ?shearAreaValue .

                BIND((?pressureValue * ?heightValue) AS ?pressureHeight)
                BIND(
                    IF(
                        ?pressureHeight < "0.15"^^xsd:decimal,
                        "0.15"^^xsd:decimal,
                        ?pressureHeight
                    )
                    AS ?expectedLineLoad
                )
                BIND(
                    (1 - (?iceBeltDistanceValue / ?stringerSpanValue))
                    AS ?expectedOutsideFactor
                )
                BIND(
                    (
                        "0.80"^^xsd:decimal *
                        "1.8"^^xsd:decimal *
                        ?expectedLineLoad *
                        ?spanValue *
                        ?spanValue /
                        (?momentValue * ?yieldValue) *
                        ?expectedOutsideFactor *
                        "1000000"^^xsd:decimal
                    )
                    AS ?expectedSectionModulus
                )
                BIND(
                    (
                        "1.7320508075688772"^^xsd:decimal *
                        "0.80"^^xsd:decimal *
                        "1.8"^^xsd:decimal *
                        "1.2"^^xsd:decimal *
                        ?expectedLineLoad *
                        ?spanValue /
                        ("2"^^xsd:decimal * ?yieldValue) *
                        ?expectedOutsideFactor *
                        "10000"^^xsd:decimal
                    )
                    AS ?expectedShearArea
                )

                FILTER (
                    ABS(?lineLoadValue - ?expectedLineLoad) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedLineLoad) + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?outsideFactorValue - ?expectedOutsideFactor) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedOutsideFactor) + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?sectionModulusValue - ?expectedSectionModulus) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedSectionModulus) + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?shearAreaValue - ?expectedShearArea) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedShearArea) + "0.000000001"^^xsd:decimal)
                )
            }
        """
    ] .
