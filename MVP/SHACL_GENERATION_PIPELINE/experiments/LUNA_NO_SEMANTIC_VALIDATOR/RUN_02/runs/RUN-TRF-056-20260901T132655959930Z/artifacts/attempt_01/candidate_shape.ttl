@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-056-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasWeatherdeckHatch ;
        sh:node [
            sh:class nltl:weatherdeckHatch ;
            sh:property [
                sh:path nltl:hatchOpeningLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
        sh:select "PREFIX nltl: <https://w3id.org/nltl/vocab#>\nPREFIX qudt: <http://qudt.org/schema/qudt/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT $this\nWHERE {\n    $this nltl:hasWeatherdeckHatch ?hatch .\n    $this nltl:shipBreadth ?breadthQuantity .\n    ?breadthQuantity qudt:numericValue ?breadth .\n    ?hatch nltl:hatchOpeningLength ?openingQuantity .\n    ?openingQuantity qudt:numericValue ?openingLength .\n    FILTER (\n        datatype(?breadth) = xsd:decimal &&\n        datatype(?openingLength) = xsd:decimal &&\n        ?openingLength > (?breadth / 2)\n    )\n    FILTER (\n        NOT EXISTS {\n            ?hatch nltl:shipSideDeflection ?deflectionQuantity .\n            ?deflectionQuantity qudt:numericValue ?deflection .\n            ?deflectionQuantity qudt:unit <http://qudt.org/vocab/unit/M> .\n            FILTER (datatype(?deflection) = xsd:decimal)\n        }\n        ||\n        NOT EXISTS {\n            ?hatch nltl:hasHatchCoverDesignEvidence ?coverEvidence .\n            ?coverEvidence a nltl:hatchCoverDesignEvidence .\n        }\n        ||\n        NOT EXISTS {\n            ?hatch nltl:hasHatchFittingDesignEvidence ?fittingEvidence .\n            ?fittingEvidence a nltl:hatchFittingDesignEvidence .\n        }\n    )\n}"
    ] .
