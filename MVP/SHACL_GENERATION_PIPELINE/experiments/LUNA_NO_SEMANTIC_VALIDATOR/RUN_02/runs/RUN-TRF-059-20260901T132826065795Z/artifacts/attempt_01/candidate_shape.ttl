@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_059_WebFrameRequiredShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "requiredShearArea must equal sqrt(3) times the Table 4-8 alpha, 1.1, maximumCalculatedShearForce in MN, divided by yieldStrength, times 10^4, within numerical tolerance; alpha must correspond to the free flange to web area ratio." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qv ;
                      nltl:webFrameShearFactorAlpha ?av ;
                      nltl:yieldStrength ?sv ;
                      nltl:freeFlangeToWebAreaRatio ?rv ;
                      nltl:requiredShearArea ?areaV .

                ?qv qudt:numericValue ?q .
                ?av qudt:numericValue ?alpha .
                ?sv qudt:numericValue ?sigma .
                ?rv qudt:numericValue ?ratio .
                ?areaV qudt:numericValue ?area .

                FILTER (
                    (?ratio = 0.0 && ?alpha = 1.5) ||
                    (?ratio = 0.2 && ?alpha = 1.23) ||
                    (?ratio = 0.4 && ?alpha = 1.16) ||
                    (?ratio = 0.6 && ?alpha = 1.11) ||
                    (?ratio = 0.8 && ?alpha = 1.09) ||
                    (?ratio = 1.0 && ?alpha = 1.07) ||
                    (?ratio = 1.2 && ?alpha = 1.06) ||
                    (?ratio = 1.4 && ?alpha = 1.05) ||
                    (?ratio = 1.6 && ?alpha = 1.05) ||
                    (?ratio = 1.8 && ?alpha = 1.04) ||
                    (?ratio = 2.0 && ?alpha = 1.04)
                )

                BIND (
                    1.7320508075688772 * ?alpha * 1.1 *
                    (?q / 1000.0) / ?sigma * 10000.0
                    AS ?expected
                )

                FILTER (
                    ABS(?area - ?expected) >
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                )
            }
        """
    ] .
