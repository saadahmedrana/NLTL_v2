@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-083> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:rotationalSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Rotational speed applicability must be recorded as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A single bollard propeller rotational speed at MCR, expressed in revolutions per minute, is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:rotationalSpeedKnown ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:rotationalSpeedKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:tableLookupApplied ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:tableReference ;
                        sh:hasValue nltl:traficomTable6Dash9 ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "An unknown bollard propeller speed must reference TRAFICOM Table 6-9."
                    ] ;
                    sh:property [
                        sh:path nltl:lookupSelectionEvidence ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:evidenceArtifact
                        ] ;
                        sh:message "Evidence for the Table 6-9 lookup selection is required."
                    ]
                ] ;
                sh:message "When bollard propeller speed is unknown, a Table 6-9 lookup case is required."
            ]
        ]
    ) .
