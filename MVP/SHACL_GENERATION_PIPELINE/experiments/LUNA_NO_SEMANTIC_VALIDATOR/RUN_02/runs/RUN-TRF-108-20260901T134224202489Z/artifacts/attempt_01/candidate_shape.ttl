@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-108_StressLifeCurveSelectionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:stressLifeCurveSelection ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:stressLifeCurveTypeValue ;
        sh:message "A ship shall have a selected stress-life curve type value."
    ] ;
    sh:property [
        sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Evidence shall identify correspondence between the selected SN-curve and the blade material properties."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:node [
                    sh:property [
                        sh:path nltl:stressLifeCurveType ;
                        sh:minCount 1 ;
                        sh:datatype xsd:string ;
                        sh:message "The selected stress-life curve shall have a known curve type."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:hasValue nltl:twoSlopeStressLifeCurve ;
                sh:message "When the SN-curve type is unknown, the two-slope SN curve shall be selected."
            ]
        ]
    ) ;
    sh:message "The SN-curve type shall correspond with the blade material properties; when the type is unknown, the two-slope SN curve shall be used." .
