@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF113Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:steeringMechanism
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must identify a steering mechanism." ;
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterFitting
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must identify the thruster fitting." ;
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterBody
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must identify the thruster body." ;
    ] ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the plastic-bending design consideration for blade loss." ;
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the propeller blade orientation producing the maximum component load." ;
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:minInclusive true ;
                sh:maxInclusive true ;
                sh:message "The propulsion load case must confirm the maximum-load blade orientation." ;
            ]
        ] ;
        sh:message "The ship must provide a propulsion load case confirming the maximum-load blade orientation." ;
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "The ship must provide evidence for the thruster blade-loss design." ;
    ] .
