@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-114-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperatingSpeed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide its ice operating speed in knots."
    ] ;
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasThrusterIceImpactLoadCase ;
        sh:node [
            sh:class nltl:thrusterIceImpactLoadCase ;
            sh:property [
                sh:path nltl:designIceBlockTableReference ;
                sh:hasValue nltl:traficomTable6Dash3Reference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The impact case must reference TRAFICOM Table 6-3 for the design ice block."
            ] ;
            sh:property [
                sh:path nltl:impactLoadCaseTableReference ;
                sh:hasValue nltl:traficomTable6Dash16Reference ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The impact case must reference TRAFICOM Table 6-16 for its impact load case."
            ] ;
            sh:property [
                sh:path nltl:thrusterImpactCaseAppliesToBody ;
                sh:class nltl:thrusterBody ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:thrusterResistanceCapacity ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:thrusterIceImpactLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:thrusterIceImpactDemand ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:thrusterIceImpactLoadedAreaEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Each impact case must provide evidence for the loaded-area assessment."
            ] ;
            sh:property [
                sh:path nltl:contactGeometryClassification ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:hemisphericalContactGeometry
                    nltl:nonHemisphericalContactGeometry
                )
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:contactGeometryClassification ;
                        sh:hasValue nltl:hemisphericalContactGeometry ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:contactGeometryClassification ;
                        sh:hasValue nltl:nonHemisphericalContactGeometry ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:contactGeometryCorrespondenceEvidence ;
                        sh:class nltl:evidenceArtifact ;
                        sh:minCount 1 ;
                        sh:message "Non-hemispherical contact geometry requires correspondence evidence."
                    ]
                ]
            )
        ]
    ] ;
    sh:sparql [
        sh:message "Non-hemispherical contact geometry requires an equivalent impact sphere radius on the ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER NOT EXISTS {
                    $this nltl:equivalentImpactSphereRadius ?radius .
                    ?radius qudt:numericValue ?value .
                    ?value a xsd:decimal .
                    ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The externally assessed thruster resistance capacity must be at least the thruster ice impact demand." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:thrusterIceImpactDemand ?demandNode .
                ?demandNode qudt:numericValue ?demandValue .
                ?demandNode qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                $this nltl:thrusterImpactCaseAppliesToBody ?body .
                ?body nltl:thrusterResistanceCapacity ?capacityNode .
                ?capacityNode qudt:numericValue ?capacityValue .
                ?capacityNode qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER(
                    datatype(?demandValue) = xsd:decimal &&
                    datatype(?capacityValue) = xsd:decimal &&
                    ?demandValue > ?capacityValue
                )
            }
        """
    ] .
