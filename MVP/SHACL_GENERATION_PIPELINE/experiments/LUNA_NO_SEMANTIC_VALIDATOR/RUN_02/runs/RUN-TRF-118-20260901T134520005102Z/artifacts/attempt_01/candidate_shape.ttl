@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-118-QuantityForce> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A force quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The force quantity must use kN."
    ] .

<urn:nltl:generated-shape:TRF-118-QuantityPressure> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A pressure quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The pressure quantity must use MPa."
    ] .

<urn:nltl:generated-shape:TRF-118-QuantityRatio> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dimensionless quantity must provide one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The dimensionless quantity must use unit 1."
    ] .

<urn:nltl:generated-shape:TRF-118-MaterialProperties> a sh:NodeShape ;
    sh:class nltl:materialProperties ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:node <urn:nltl:generated-shape:TRF-118-QuantityPressure> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Material properties must provide the component material yield strength."
    ] .

<urn:nltl:generated-shape:TRF-118-Assessment> a sh:NodeShape ;
    sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
    sh:property [
        sh:path nltl:assessedThrusterComponent ;
        sh:class nltl:shipComponent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:shipComponent ;
            sh:property [
                sh:path nltl:hasMaterialProperties ;
                sh:node <urn:nltl:generated-shape:TRF-118-MaterialProperties> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The assessed thruster component must provide material properties."
            ]
        ] ;
        sh:message "Each assessment must identify one assessed thruster component."
    ] ;
    sh:property [
        sh:path nltl:assessedFactoredExtremeLoad ;
        sh:node <urn:nltl:generated-shape:TRF-118-QuantityForce> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each assessment must provide the externally assessed factored extreme load."
    ] ;
    sh:property [
        sh:path nltl:assessmentOperabilityMaintained ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assessment must confirm that operability is maintained."
    ] ;
    sh:property [
        sh:path nltl:assessmentRepairRequired ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assessment must confirm that repair is not required."
    ] .

<urn:nltl:generated-shape:TRF-118-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterExtremeLoad ;
        sh:node <urn:nltl:generated-shape:TRF-118-QuantityForce> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the thruster extreme load input."
    ] ;
    sh:property [
        sh:path nltl:yieldSafetyFactor ;
        sh:node <urn:nltl:generated-shape:TRF-118-QuantityRatio> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the yield safety factor input."
    ] ;
    sh:property [
        sh:path nltl:nominalVonMisesStress ;
        sh:node <urn:nltl:generated-shape:TRF-118-QuantityPressure> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the nominal von Mises stress input."
    ] ;
    sh:property [
        sh:path nltl:localStressConcentration ;
        sh:node <urn:nltl:generated-shape:TRF-118-QuantityRatio> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the local stress concentration input."
    ] ;
    sh:property [
        sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ;
        sh:node <urn:nltl:generated-shape:TRF-118-Assessment> ;
        sh:minCount 1 ;
        sh:message "The ship must provide at least one externally assessed factored extreme-load operability assessment."
    ] .
