@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:CalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:longitudinalDirection
            nltl:transverseDirection
        ) ;
        sh:message "A natural-frequency calculation case must specify longitudinal or transverse vibration direction."
    ] .

nltlgen:ThrusterBodyShape
    a sh:NodeShape ;
    sh:targetClass nltl:thrusterBody ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:node nltlgen:CalculationCaseShape
    ] ;
    sh:sparql [
        sh:message "An applicable thruster natural-frequency calculation must include ship attachment stiffness in kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasNaturalFrequencyCalculationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:shipAttachmentStiffness ?quantity .
                    ?quantity a qudt:QuantityValue ;
                              qudt:numericValue ?value ;
                              qudt:unit unit:KiloN-PER-M .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] .

nltlgen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A ship with applicable thruster natural-frequency calculations must provide water added mass and thruster natural frequency in the canonical units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?thrusterBody .
                ?thrusterBody a nltl:thrusterBody ;
                               nltl:hasNaturalFrequencyCalculationCase ?case .
                FILTER (
                    NOT EXISTS {
                        $this nltl:waterAddedMass ?mass .
                        ?mass a qudt:QuantityValue ;
                              qudt:numericValue ?massValue ;
                              qudt:unit unit:KiloGM .
                        FILTER (datatype(?massValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:thrusterNaturalFrequency ?frequency .
                        ?frequency a qudt:QuantityValue ;
                                    qudt:numericValue ?frequencyValue ;
                                    qudt:unit unit:HZ .
                        FILTER (datatype(?frequencyValue) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable thruster natural-frequency calculations must include both longitudinal and transverse calculation cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?thrusterBody .
                ?thrusterBody a nltl:thrusterBody ;
                               nltl:hasNaturalFrequencyCalculationCase ?anyCase .
                FILTER NOT EXISTS {
                    ?thrusterBody nltl:hasNaturalFrequencyCalculationCase ?longitudinalCase .
                    ?longitudinalCase nltl:vibrationDirection nltl:longitudinalDirection .
                }
                FILTER NOT EXISTS {
                    ?thrusterBody nltl:hasNaturalFrequencyCalculationCase ?transverseCase .
                    ?transverseCase nltl:vibrationDirection nltl:transverseDirection .
                }
            }
        """
    ] .
