@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF123_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:class nltl:occasionalForceLoadCase ;
        sh:node <urn:nltl:generated-shape:TRF123_OccasionalForceCaseShape> ;
        sh:message "Each represented occasional-force load case must contain the required exclusion, assessed-component, stress, material, and safety-factor information."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The externally calculated occasional-force component stress, including the safety factor, must not exceed the component material yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasOccasionalForceLoadCase ?case .
                ?case nltl:occasionalForceCaseAssessedComponent ?component .
                ?component nltl:occasionalForceComponentStress ?stressQuantity .
                ?stressQuantity qudt:numericValue ?stressValue .
                ?case nltl:componentYieldSafetyFactor ?factorQuantity .
                ?factorQuantity qudt:numericValue ?factorValue .
                ?component nltl:hasMaterialProperties ?material .
                ?material nltl:componentMaterialYieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                FILTER (
                    ?stressValue * ?factorValue > ?yieldValue
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF123_OccasionalForceCaseShape>
    a sh:NodeShape ;
    sh:class nltl:occasionalForceLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The occasional-force load case must explicitly confirm that propeller blades are excluded."
    ] ;
    sh:property [
        sh:path nltl:occasionalForceCaseAssessedComponent ;
        sh:class nltl:shipComponent ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF123_ComponentShape> ;
        sh:message "The occasional-force load case must identify each assessed component."
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF123_DimensionlessQuantityShape> ;
        sh:message "Each occasional-force load case must provide the externally calculated component yield safety factor."
    ] .

<urn:nltl:generated-shape:TRF123_ComponentShape>
    a sh:NodeShape ;
    sh:class nltl:shipComponent ;
    sh:property [
        sh:path nltl:occasionalForceComponentStress ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF123_PressureQuantityShape> ;
        sh:message "Each assessed component must provide its externally calculated occasional-force stress."
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:class nltl:materialProperties ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF123_MaterialPropertiesShape> ;
        sh:message "Each assessed component must identify its material properties."
    ] .

<urn:nltl:generated-shape:TRF123_MaterialPropertiesShape>
    a sh:NodeShape ;
    sh:class nltl:materialProperties ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF123_PressureQuantityShape> ;
        sh:message "The material properties must provide the component material yield strength."
    ] .

<urn:nltl:generated-shape:TRF123_PressureQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

<urn:nltl:generated-shape:TRF123_DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
