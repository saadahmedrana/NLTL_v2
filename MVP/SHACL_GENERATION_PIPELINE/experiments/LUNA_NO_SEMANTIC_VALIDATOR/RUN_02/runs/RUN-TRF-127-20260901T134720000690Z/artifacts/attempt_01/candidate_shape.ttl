@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF_127_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:TRF_127_ApplicableShape
        gs:TRF_127_NotApplicableShape
    ) .

gs:TRF_127_ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:airReceiverCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:additionalPurposeRequiredAirCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Air receiver capacity must be sufficient for the additional-purpose required air capacity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:airReceiverCapacity ?capacity .
                ?capacity qudt:numericValue ?capacityValue .
                $this nltl:additionalPurposeRequiredAirCapacity ?required .
                ?required qudt:numericValue ?requiredValue .
                FILTER (
                    datatype(?capacityValue) = xsd:decimal &&
                    datatype(?requiredValue) = xsd:decimal &&
                    ?capacityValue < ?requiredValue
                )
            }
        """
    ] .

gs:TRF_127_NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
