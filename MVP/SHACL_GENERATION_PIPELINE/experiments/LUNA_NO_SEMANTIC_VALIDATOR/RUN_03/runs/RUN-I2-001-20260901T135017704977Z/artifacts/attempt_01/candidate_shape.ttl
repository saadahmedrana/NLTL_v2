@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_001_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:I2_001_Pre2021Branch
        gs:I2_001_OnOrAfter2021Branch
    ) .

gs:I2_001_Pre2021Branch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine UR I2 Rev.4 applicability." ;
        sh:sparql [
            sh:message "This applicability branch requires all construction contract dates to be before 1 January 2021." ;
            sh:select """
                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                PREFIX sh: <http://www.w3.org/ns/shacl#>
                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                SELECT $this
                WHERE {
                    $this nltl:constructionContractDate ?date .
                    FILTER (YEAR(?date) >= 2021)
                }
            """
        ]
    ] .

gs:I2_001_OnOrAfter2021Branch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine UR I2 Rev.4 applicability." ;
        sh:sparql [
            sh:message "This applicability branch requires all construction contract dates to be on or after 1 January 2021." ;
            sh:select """
                PREFIX nltl: <https://w3id.org/nltl/vocab#>
                PREFIX sh: <http://www.w3.org/ns/shacl#>
                PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                SELECT $this
                WHERE {
                    $this nltl:constructionContractDate ?date .
                    FILTER (YEAR(?date) < 2021)
                }
            """
        ]
    ] .
