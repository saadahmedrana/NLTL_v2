@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must contain four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:I2_014_BowSubregionCaseShape ;
        sh:message "Exactly four bow subregion calculation cases are required."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_ForceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_LineLoadQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_PressureQuantityShape
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow force, line load, and pressure must equal the respective maxima reported for the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceNode ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineNode ;
                      nltl:selectedMaximumBowPressure ?selectedPressureNode .
                ?selectedForceNode qudt:numericValue ?selectedForce .
                ?selectedLineNode qudt:numericValue ?selectedLine .
                ?selectedPressureNode qudt:numericValue ?selectedPressure .

                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?forceCase .
                        ?forceCase nltl:bowSubregionCalculatedForce ?forceNode .
                        ?forceNode qudt:numericValue ?forceValue .
                        FILTER (?forceValue > ?selectedForce)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalForceCase .
                        ?equalForceCase nltl:bowSubregionCalculatedForce ?equalForceNode .
                        ?equalForceNode qudt:numericValue ?equalForce .
                        FILTER (?equalForce = ?selectedForce)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?lineCase .
                        ?lineCase nltl:bowSubregionCalculatedLineLoad ?lineNode .
                        ?lineNode qudt:numericValue ?lineValue .
                        FILTER (?lineValue > ?selectedLine)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalLineCase .
                        ?equalLineCase nltl:bowSubregionCalculatedLineLoad ?equalLineNode .
                        ?equalLineNode qudt:numericValue ?equalLine .
                        FILTER (?equalLine = ?selectedLine)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?pressureCase .
                        ?pressureCase nltl:bowSubregionCalculatedPressure ?pressureNode .
                        ?pressureNode qudt:numericValue ?pressureValue .
                        FILTER (?pressureValue > ?selectedPressure)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalPressureCase .
                        ?equalPressureCase nltl:bowSubregionCalculatedPressure ?equalPressureNode .
                        ?equalPressureNode qudt:numericValue ?equalPressure .
                        FILTER (?equalPressure = ?selectedPressure)
                    }
                )
            }
        """
    ] .

gen:I2_014_BowSubregionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each bow subregion calculation case must have calculation evidence."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_LengthQuantityShape ;
        sh:message "Each bow subregion must report its mid-length position."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_AspectRatioQuantityShape ;
        sh:message "Each bow subregion must report its load patch aspect ratio."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_ForceQuantityShape ;
        sh:message "Each bow subregion must report its calculated force."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_LineLoadQuantityShape ;
        sh:message "Each bow subregion must report its calculated line load."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_014_PressureQuantityShape ;
        sh:message "Each bow subregion must report its calculated pressure."
    ] .

gen:I2_014_LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_014_AspectRatioQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_014_ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_014_LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_014_PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
