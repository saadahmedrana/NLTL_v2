@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_StaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_026_StructuralMemberShape
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:class nltl:memberSupport ;
        sh:node gen:I2_026_MemberSupportShape ;
        sh:message "Each structural member must identify its support condition."
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The support condition must be fixed when the member is continuous through its support, has a connection bracket, provides demonstrated rotational restraint, or terminates within an ice-strengthened area; otherwise it must be simple." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasMemberSupport ?support .
                ?support nltl:frameSupportCondition ?condition .
                FILTER (
                    (
                        (
                            EXISTS {
                                $this nltl:continuousThroughSupport true
                            }
                            ||
                            EXISTS {
                                ?support nltl:connectionBracketPresent true
                            }
                            ||
                            EXISTS {
                                ?support nltl:demonstratedRotationalRestraint true
                            }
                            ||
                            EXISTS {
                                $this nltl:terminatesWithinIceStrengthenedArea true
                            }
                        )
                        &&
                        ?condition != nltl:fixedFrameSupport
                    )
                    ||
                    (
                        NOT EXISTS {
                            $this nltl:continuousThroughSupport true
                        }
                        &&
                        NOT EXISTS {
                            ?support nltl:connectionBracketPresent true
                        }
                        &&
                        NOT EXISTS {
                            ?support nltl:demonstratedRotationalRestraint true
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:terminatesWithinIceStrengthenedArea true
                        }
                        &&
                        ?condition != nltl:simpleFrameSupport
                    )
                )
            }
        """
    ] .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:frameSupportConditionValue ;
        sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
        sh:message "A member support must specify either fixed or simple frame support."
    ] ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Demonstrated rotational restraint must be supported by significant rotational restraint evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:demonstratedRotationalRestraint true .
                FILTER NOT EXISTS {
                    $this nltl:significantRotationalRestraintEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] .
