@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_029_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node gs:I2_029_CalculationCaseShape ;
        sh:message "Each linked calculation case must conform to the section modulus and shear area conditions."
    ] .

gs:I2_029_CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:attachedShellPlatingIncludedInSectionModulus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Attached shell plating must be included in the section modulus calculation."
    ] ;
    sh:property [
        sh:path nltl:attachedShellPlatingExcludedFromShearArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Attached shell plating must be excluded from the shear area calculation."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:flangeMaterialIncludedInShearArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:sectionCalculationCaseStructuralMember ;
                sh:class nltl:structuralMember ;
                sh:node gs:I2_029_FittedStructuralMemberShape ;
                sh:minCount 1 ;
                sh:message "A calculation case including flange material in shear area must link to a fitted structural member."
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:flangeMaterialIncludedInShearArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
            ] ;
        ]
    ) .

gs:I2_029_FittedStructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:flangeFitted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The structural member must have a fitted flange when flange material is included in the shear area."
    ] .
