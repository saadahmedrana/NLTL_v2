@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_034_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify its frame profile type."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_034_StructuralMemberShape
    ] .

gen:I2_034_StructuralMemberShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:longitudinalFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:longitudinalFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:sideStructureLocation ;
                sh:class nltl:structuralLocationValue
            ] ;
            sh:property [
                sh:path nltl:plasticStrength ;
                sh:node gen:I2_034_PlasticStrengthShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable longitudinal side frame must have one plastic strength value."
            ] ;
            sh:property [
                sh:path nltl:midspanPlasticCollapseLoad ;
                sh:node gen:I2_034_MidspanLoadShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable longitudinal side frame must have one midspan plastic-collapse load."
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:node gen:I2_034_LoadCaseShape
            ]
        ]
    ) ;
    sh:message "A structural member must provide explicit longitudinal applicability evidence; applicable side frames must satisfy the shear-and-bending demand limit." .

gen:I2_034_PlasticStrengthShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .

gen:I2_034_MidspanLoadShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .

gen:I2_034_LoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node gen:I2_034_DemandShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented load case must have one combined shear-and-bending demand."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The combined shear-and-bending demand must not exceed the member plastic strength, and plastic strength must equal the midspan plastic-collapse load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?member nltl:hasStructuralMemberLoadCase $this ;
                        nltl:plasticStrength ?plasticStrength ;
                        nltl:midspanPlasticCollapseLoad ?midspanLoad .
                $this nltl:combinedShearAndBendingDemand ?demand .
                ?plasticStrength qudt:numericValue ?plasticValue .
                ?midspanLoad qudt:numericValue ?midspanValue .
                ?demand qudt:numericValue ?demandValue .
                FILTER (?demandValue > ?plasticValue || ?plasticValue != ?midspanValue)
            }
        """
    ] .

gen:I2_034_DemandShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .
