@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-040-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship shall provide one yield-strength quantity in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:netWebThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each structural member shall provide one net web thickness quantity in mm."
            ] ;
            sh:property [
                sh:path nltl:webHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Each structural member shall provide one web-height quantity in mm."
            ] ;
            sh:property [
                sh:path nltl:structuralSectionType ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    _:sectionFlat
                    _:sectionBulb
                    _:sectionTee
                    _:sectionAngle
                ) ;
                sh:message "Each structural member shall identify a permitted section type: flat-bar, bulb, tee, or angle."
            ]
        ]
    ] .

_:sectionFlat
    sh:class nltl:structuralSectionTypeValue ;
    sh:hasValue nltl:flatBarStructuralSection .

_:sectionBulb
    sh:class nltl:structuralSectionTypeValue ;
    sh:hasValue nltl:bulbSection .

_:sectionTee
    sh:class nltl:structuralSectionTypeValue ;
    sh:hasValue nltl:teeSection .

_:sectionAngle
    sh:class nltl:structuralSectionTypeValue ;
    sh:hasValue nltl:angleSection .
