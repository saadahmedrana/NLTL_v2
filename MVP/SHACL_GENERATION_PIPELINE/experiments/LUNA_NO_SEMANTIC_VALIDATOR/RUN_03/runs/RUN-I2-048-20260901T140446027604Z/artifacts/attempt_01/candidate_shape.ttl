@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one supported Polar Class."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented steel-grade case must identify exactly one plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "Each steel-grade case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each steel-grade case must provide one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented steel-grade case must provide exactly one actual hull structural steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:sparql [
        sh:message "An applicable Table 8 selection must provide a required hull structural steel grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?mat ;
                      nltl:steelStrengthCategory ?strength .
                ?tv qudt:numericValue ?t .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                BIND(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) AS ?pc13)
                BIND(?pc IN (nltl:polarClassPc4,nltl:polarClassPc5) AS ?pc45)
                BIND(?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) AS ?pc67)
                BIND(?t > 0 && ?t <= 10 AS ?b1)
                BIND(?t > 10 && ?t <= 15 AS ?b2)
                BIND(?t > 15 && ?t <= 35 AS ?b35)
                BIND(?t > 35 && ?t <= 45 AS ?b45)
                BIND(?t > 45 && ?t <= 50 AS ?b50)
                BIND(
                    (?b1 || ?b2 || ?b35 || ?b45 || ?b50) &&
                    (
                        ?mat IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) ||
                        (?mat = nltl:steelMaterialClassThree &&
                         (?strength = nltl:highTensileSteelCategory ||
                          !((?b45 || ?b50) && ?pc13 && ?strength = nltl:normalStrengthSteelCategory)))
                    )
                    AS ?applicable
                )
                FILTER(?applicable)
                FILTER NOT EXISTS {
                    $this nltl:requiredHullStructuralSteelGrade ?required
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The actual hull structural steel grade must meet or exceed the Table 8 grade rank for the same steel-strength category." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:asBuiltPlateThickness ?tv ;
                      nltl:steelMaterialClass ?mat ;
                      nltl:steelStrengthCategory ?strength ;
                      nltl:actualHullStructuralSteelGrade ?actual ;
                      nltl:requiredHullStructuralSteelGrade ?required .
                ?tv qudt:numericValue ?t .
                ?actual nltl:steelGradeOrderRank ?ar .
                ?required nltl:steelGradeOrderRank ?rr .
                ?ship nltl:hasSteelGradeRequirementCase $this ;
                      nltl:polarClass ?pc .
                BIND(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) AS ?pc13)
                BIND(?pc IN (nltl:polarClassPc4,nltl:polarClassPc5) AS ?pc45)
                BIND(?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) AS ?pc67)
                BIND(?t > 0 && ?t <= 10 AS ?b1)
                BIND(?t > 10 && ?t <= 15 AS ?b2)
                BIND(?t > 15 && ?t <= 35 AS ?b35)
                BIND(?t > 35 && ?t <= 45 AS ?b45)
                BIND(?t > 45 && ?t <= 50 AS ?b50)
                BIND(
                    IF(?b1,
                        IF(?mat = nltl:steelMaterialClassThree,3,1),
                    IF(?b2,
                        IF(?mat = nltl:steelMaterialClassOne,1,
                           IF(?mat = nltl:steelMaterialClassTwo,2,3)),
                    IF(?b35,
                        IF(?mat = nltl:steelMaterialClassThree,3,2),
                    IF(?b45,
                        IF(?mat = nltl:steelMaterialClassThree,
                           IF(?pc13 && ?strength = nltl:highTensileSteelCategory,4,3),
                           2),
                    IF(?mat = nltl:steelMaterialClassThree,
                       IF(?pc13 || ?pc45,
                          4,
                          3),
                       IF(?pc13 || ?pc45,3,2)))))) AS ?expectedRank)
                BIND(
                    (?b1 || ?b2 || ?b35 || ?b45 || ?b50) &&
                    (
                        ?mat IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) ||
                        (?mat = nltl:steelMaterialClassThree &&
                         (?strength = nltl:highTensileSteelCategory ||
                          !((?b45 || ?b50) && ?pc13 && ?strength = nltl:normalStrengthSteelCategory)))
                    )
                    AS ?applicable
                )
                FILTER(?applicable)
                FILTER(
                    ?rr != ?expectedRank ||
                    ?ar < ?rr ||
                    (?strength = nltl:normalStrengthSteelCategory &&
                     !(?actual IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE)) ) ||
                    (?strength = nltl:highTensileSteelCategory &&
                     !(?actual IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh)) ) ||
                    (?strength = nltl:normalStrengthSteelCategory &&
                     !(?required IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE)) ) ||
                    (?strength = nltl:highTensileSteelCategory &&
                     !(?required IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh)) )
                )
            }
        """
    ] .
