@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_066_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node gs:I2_066_WeldShape ;
        sh:message "Each linked weld must satisfy the ice-strengthened-area welding requirement."
    ] .

gs:I2_066_WeldShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each weld must state whether it is within an ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:weldType ;
                sh:minCount 1 ;
                sh:in ( nltl:doubleContinuousWeld ) ;
                sh:message "Welding within an ice-strengthened area must be of the double continuous type."
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
    ) .
