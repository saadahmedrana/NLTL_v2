@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its design ice condition."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarShipCategoryValue ;
                sh:minCount 1 ;
                sh:in ( nltl:polarShipCategoryA ) ;
                sh:message "A ship designed for at least medium first-year ice with possible old-ice inclusions must have Polar Code category A."
            ]
        ]
        [
            sh:sparql [
                sh:message "The design ice condition must be present and, when it is not at least medium first-year ice with possible old-ice inclusions, the category-A condition does not apply." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        FILTER (
                            EXISTS {
                                $this nltl:designIceCondition nltl:mediumFirstYearIceWithPossibleOldIceInclusions .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:designIceCondition ?condition .
                                FILTER (?condition != nltl:mediumFirstYearIceWithPossibleOldIceInclusions)
                            }
                        )
                    }
                """
            ]
        ]
    ) .
