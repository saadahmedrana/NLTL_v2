@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_006_MediumFirstYearIceThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceTypeValue
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:hasValue nltl:mediumFirstYearIce ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "0.7"^^xsd:decimal ;
                        sh:maxInclusive "1.2"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Medium first-year ice requires an ice thickness from 0.7 m through 1.2 m."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:minCount 1
            ] ;
            sh:sparql [
                sh:message "The medium first-year ice thickness constraint applies only when the ice classification is medium first-year ice." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceTypeClassification ?classification .
                        FILTER (?classification = nltl:mediumFirstYearIce)
                    }
                """
            ]
        ]
    ) .
