@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO007StaticShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:minCount 1 ;
        sh:message "An ice condition classification is required to determine whether the open-water rule applies."
    ] ;
    sh:sparql [
        sh:message "For an open-water ice condition, sea ice concentration must be less than 1/10 and ice of land origin must be absent." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER NOT EXISTS {
                    $this nltl:seaIceConcentration ?quantity .
                    ?quantity qudt:numericValue ?concentration ;
                              qudt:unit qudt:UNITLESS .
                    FILTER (
                        datatype(?concentration) = xsd:decimal &&
                        ?concentration < 1
                    )
                    $this nltl:iceOfLandOriginPresent false .
                }
            }
        """
    ] .
