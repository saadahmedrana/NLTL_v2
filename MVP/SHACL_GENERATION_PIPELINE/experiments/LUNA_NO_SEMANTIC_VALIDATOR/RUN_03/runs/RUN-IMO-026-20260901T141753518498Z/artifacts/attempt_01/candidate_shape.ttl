@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_026_ApplicableBranch
        gen:IMO_026_NotApplicableBranch
    ) .

gen:IMO_026_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIceCapabilityMethodologyPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the ice capability methodology is applicable, the PWOM shall contain that methodology."
    ] .

gen:IMO_026_NotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .
