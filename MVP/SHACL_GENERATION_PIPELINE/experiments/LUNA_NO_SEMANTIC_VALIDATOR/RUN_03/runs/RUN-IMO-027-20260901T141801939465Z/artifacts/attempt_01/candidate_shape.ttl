@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_027_PWOMProcedureCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualRiskProcedureCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must indicate that the Polar Water Operational Manual covers the required risk-based procedures."
    ] ;
    sh:property [
        sh:path nltl:voyageLimitAvoidance ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include procedures for avoiding voyage limits imposed by ice or temperature."
    ] ;
    sh:property [
        sh:path nltl:environmentalForecastArrangements ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include arrangements for receiving environmental forecasts."
    ] ;
    sh:property [
        sh:path nltl:informationLimitationMeasures ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include measures addressing limitations of available hydrographic, meteorological, and navigational information."
    ] ;
    sh:property [
        sh:path nltl:requiredEquipmentOperation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include procedures for operating equipment required under the Polar Code."
    ] ;
    sh:property [
        sh:path nltl:environmentalFunctionalityMeasures ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual must indicate coverage of applicable low-temperature, topside-icing, and sea-ice functionality measures."
    ] .
