@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_030_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether ice operation is applicable."
    ] ;
    sh:or (
        gen:IMO_030_IceOperationApplicableShape
        gen:IMO_030_IceOperationNotApplicableShape
    ) .

gen:IMO_030_IceOperationApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:iceSafetyMonitoringProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice operation is applicable, an ice-operation monitoring and safety procedure must be present."
    ] ;
    sh:property [
        sh:path nltl:escortRequirementsPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When ice operation is applicable, applicable escort or icebreaker-assistance requirements must be included."
    ] ;
    sh:property [
        sh:path nltl:independentOperationLimits ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When ice operation is applicable, independent-operation limitations must be specified."
    ] ;
    sh:property [
        sh:path nltl:escortedOperationLimits ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When ice operation is applicable, escorted-operation limitations must be specified."
    ] .

gen:IMO_030_IceOperationNotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] .
