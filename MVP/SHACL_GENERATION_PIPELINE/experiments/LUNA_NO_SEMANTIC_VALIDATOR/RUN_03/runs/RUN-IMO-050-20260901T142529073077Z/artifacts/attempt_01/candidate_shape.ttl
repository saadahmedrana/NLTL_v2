@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_050_StaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fireSafetyComponentExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must specify whether a fire safety component is exposed."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An exposed fire safety component must have ice and snow protection." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:fireSafetyComponentExposed true .
                FILTER NOT EXISTS {
                    $this nltl:iceAndSnowProtectionPresent true .
                }
            }
        """
    ] .
