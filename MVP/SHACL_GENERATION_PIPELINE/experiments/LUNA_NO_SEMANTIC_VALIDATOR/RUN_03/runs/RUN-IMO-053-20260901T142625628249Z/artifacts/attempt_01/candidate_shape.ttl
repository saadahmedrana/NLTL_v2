@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO053ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:node gs:IMO053ExtinguishingMediumItemShape ;
        sh:message "Each linked extinguishing medium must have an approved intended-operation compatibility status."
    ] .

gs:IMO053ExtinguishingMediumItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extinguishingMediumCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The extinguishing medium must be approved as compatible with the intended operation."
    ] .
