@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_055_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Exposed isolating, pressure, or vacuum valves must be protected from ice accretion and continuously accessible." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:valveExposed ?exposed ;
          nltl:valveType ?type .
    FILTER (
        ?exposed = true &&
        STR(?type) IN ("isolating", "pressure", "vacuum")
    )
    FILTER (
        NOT EXISTS {
            $this nltl:iceAccretionProtectionPresent ?protection .
            FILTER (?protection = true)
        }
        ||
        EXISTS {
            $this nltl:iceAccretionProtectionPresent ?badProtection .
            FILTER (?badProtection != true)
        }
        ||
        NOT EXISTS {
            $this nltl:continuouslyAccessible ?accessible .
            FILTER (?accessible = true)
        }
        ||
        EXISTS {
            $this nltl:continuouslyAccessible ?badAccessible .
            FILTER (?badAccessible != true)
        }
    )
}
"""
    ] .
