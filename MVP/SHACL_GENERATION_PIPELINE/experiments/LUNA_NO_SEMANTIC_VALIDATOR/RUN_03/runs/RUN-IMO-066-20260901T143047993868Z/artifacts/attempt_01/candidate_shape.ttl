@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066EscapeRouteProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:escapeRouteProtectedItem ;
        sh:minCount 1 ;
        sh:message "An escape route protected item must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "An escape route must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066MusterStationProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:musterStationProtectedItem ;
        sh:minCount 1 ;
        sh:message "A muster station protected item must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "A muster station must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066EmbarkationAreaProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:embarkationAreaProtectedItem ;
        sh:minCount 1 ;
        sh:message "An embarkation area protected item must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "An embarkation area must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066SurvivalCraftProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftProtectedItem ;
        sh:minCount 1 ;
        sh:message "A survival craft protected item must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "A survival craft must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066LaunchingApplianceProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:launchingApplianceProtectedItem ;
        sh:minCount 1 ;
        sh:message "A launching appliance protected item must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "A launching appliance must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066SurvivalCraftAccessProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem ;
        sh:minCount 1 ;
        sh:message "A survival craft access protected item must be identified."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Access to survival craft must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship's exposure to ice accretion must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066EscapeRouteProtectedItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When exposed to ice accretion, every escape route must have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066MusterStationProtectedItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When exposed to ice accretion, every muster station must have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066EmbarkationAreaProtectedItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When exposed to ice accretion, every embarkation area must have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066SurvivalCraftProtectedItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When exposed to ice accretion, every survival craft must have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066LaunchingApplianceProtectedItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When exposed to ice accretion, every launching appliance must have ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066SurvivalCraftAccessProtectedItemShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When exposed to ice accretion, access to every survival craft must have ice or snow removal or prevention means."
            ]
        ]
    ) .
