@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO074Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether abandonment onto ice or land is a potential." ;
    ] ;
    sh:or (
        gen:IMO074NotApplicableShape
        gen:IMO074ApplicableShape
    ) ;
    sh:message "If abandonment onto ice or land is possible, the ship must carry group survival equipment or have approved equivalent functionality from its normal life-saving appliances." .

gen:IMO074NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
    ] .

gen:IMO074ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
    ] ;
    sh:or (
        gen:IMO074GroupEquipmentShape
        gen:IMO074EquivalentFunctionalityShape
    ) .

gen:IMO074GroupEquipmentShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:groupSurvivalEquipmentCarried ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Group survival equipment must be carried when abandonment onto ice or land is possible." ;
    ] .

gen:IMO074EquivalentFunctionalityShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "Approved equivalent survival functionality from the ship's normal life-saving appliances is required as the alternative to carrying group survival equipment." ;
    ] .
