@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-095> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:searchAndRescueCommunicationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall declare search and rescue communication capability."
    ] ;
    sh:property [
        sh:path nltl:rescueCoordinationCentreVoiceOrData ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall provide voice or data communications with relevant rescue coordination centres."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaHZ>
            ]
        ] ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 121.5 ;
                sh:maxInclusive 121.5
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaHZ>
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall support aircraft voice communication on 121.5 MHz."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 123.1 ;
                sh:maxInclusive 123.1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaHZ>
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall support aircraft voice communication on 123.1 MHz."
    ] .
