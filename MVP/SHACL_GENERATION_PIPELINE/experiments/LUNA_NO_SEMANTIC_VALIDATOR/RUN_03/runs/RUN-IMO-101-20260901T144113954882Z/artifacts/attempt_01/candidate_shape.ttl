@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_101_PolarRoutePlanShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarRoutePlan ;
        sh:minCount 1 ;
        sh:class nltl:polarRoutePlan ;
        sh:node [
            sh:property [
                sh:path nltl:voyagePlanningTopicCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The polar-route planning record must indicate coverage of all nine required voyage-planning topics." ;
            ] ;
        ] ;
        sh:message "The ship must have a polar-route planning record." ;
    ] .
