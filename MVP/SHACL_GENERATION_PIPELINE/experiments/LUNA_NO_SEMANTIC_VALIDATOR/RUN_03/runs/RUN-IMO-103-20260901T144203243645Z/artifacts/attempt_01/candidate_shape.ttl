@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-103> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:administrationPermissionStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:advancedPolarTrainingStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:watchCoverageStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:restComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:iceCondition ;
                sh:datatype xsd:string ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For an alternate qualified person, the applicable ice-condition or ice-concentration information and designated-officer basic-training safeguard must be satisfied." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:alternateQualifiedPersonUsed true ;
                      nltl:shipType ?shipType .

                FILTER (
                    (
                        (?shipType = "passenger ship" || ?shipType = "tanker") &&
                        (
                            NOT EXISTS {
                                $this nltl:iceCondition ?iceCondition .
                            }
                            ||
                            (
                                EXISTS {
                                    $this nltl:iceCondition ?applicableIceCondition .
                                    FILTER (
                                        ?applicableIceCondition != "open waters" &&
                                        ?applicableIceCondition != "bergy waters"
                                    )
                                }
                                &&
                                NOT EXISTS {
                                    $this nltl:designatedOfficerBasicTrainingStatus true .
                                }
                            )
                        )
                    )
                    ||
                    (
                        ?shipType = "cargo ship other than tanker" &&
                        (
                            NOT EXISTS {
                                $this nltl:iceConcentration ?concentration .
                                ?concentration qudt:numericValue ?concentrationValue .
                            }
                            ||
                            (
                                EXISTS {
                                    $this nltl:iceConcentration ?applicableConcentration .
                                    ?applicableConcentration qudt:numericValue ?value .
                                    FILTER (?value > "0.2"^^xsd:decimal)
                                }
                                &&
                                NOT EXISTS {
                                    $this nltl:designatedOfficerBasicTrainingStatus true .
                                }
                            )
                        )
                    )
                )
            }
        """
    ] .
