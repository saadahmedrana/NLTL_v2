@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_114_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:message "A ship category of A, B, or C is required."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A valid construction date is required."
    ] ;
    sh:property [
        sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The type 3 tank NLS applicability indicator is required."
    ] ;
    sh:property [
        sh:path nltl:cargoTankType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A cargo tank type is required."
    ] ;
    sh:property [
        sh:path nltl:administrationCarriageApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateDraft
            nltl:evidenceStateExpired
            nltl:evidenceStateRejected
            nltl:evidenceStateRevoked
            nltl:evidenceStateSubmitted
            nltl:evidenceStateUnderReview
        )
    ] ;
    sh:property [
        sh:path nltl:applicableCertificatePolarOperationEntryPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For an applicable category A or B ship constructed on or after 1 January 2017 carrying NLS requiring a type 3 tank in cargo tanks of type 3, Administration approval and the applicable certificate polar-operation entry are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                $this nltl:constructionDate ?constructionDate .
                $this nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 .
                $this nltl:cargoTankType ?tankType .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                    && ?constructionDate >= "2017-01-01"^^xsd:date
                    && ?requiresType3 = true
                    && ?tankType = "3"
                )

                FILTER NOT EXISTS {
                    $this nltl:administrationCarriageApprovalStatus
                        nltl:evidenceStateApproved
                }

                FILTER EXISTS {
                    $this nltl:administrationCarriageApprovalStatus ?status .
                    FILTER (?status != nltl:evidenceStateApproved)
                }

                FILTER NOT EXISTS {
                    $this nltl:applicableCertificatePolarOperationEntryPresent true
                }

                FILTER EXISTS {
                    $this nltl:applicableCertificatePolarOperationEntryPresent ?entry .
                    FILTER (?entry != true)
                }
            }
        """
    ] .
