@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_115_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:comminutedAndDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When sewage discharge is comminuted and disinfected, MARPOL Annex IV regulation 11.1.1 compliance, a distance greater than 3 nautical miles from ice shelf or fast ice, ice-concentration data, and the associated concentration-area distance must be recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?type ;
                      nltl:comminutedAndDisinfected ?flag .
                FILTER (
                    str(?type) = "comminuted_and_disinfected"
                    &&
                    (
                        ?flag != true
                        ||
                        NOT EXISTS {
                            $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true ;
                                  nltl:distanceToNearestIceShelfOrFastIce ?iceDistance ;
                                  nltl:iceConcentration ?iceConcentration ;
                                  nltl:nearbyIceConcentration ?nearbyConcentration ;
                                  nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .

                            ?iceDistance a qudt:QuantityValue ;
                                         qudt:numericValue ?iceDistanceValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                            FILTER (
                                datatype(?iceDistanceValue) = xsd:decimal
                                && ?iceDistanceValue > 3
                            )

                            ?iceConcentration a qudt:QuantityValue ;
                                              qudt:numericValue ?iceConcentrationValue ;
                                              qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                            FILTER (
                                datatype(?iceConcentrationValue) = xsd:decimal
                                && ?iceConcentrationValue > 1
                            )

                            ?nearbyConcentration a qudt:QuantityValue ;
                                                  qudt:numericValue ?nearbyConcentrationValue ;
                                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                            FILTER (
                                datatype(?nearbyConcentrationValue) = xsd:decimal
                                && ?nearbyConcentrationValue > 1
                            )

                            ?areaDistance a qudt:QuantityValue ;
                                          qudt:numericValue ?areaDistanceValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                            FILTER (datatype(?areaDistanceValue) = xsd:decimal)
                        }
                    )
                )
            }
        """
    ] .
