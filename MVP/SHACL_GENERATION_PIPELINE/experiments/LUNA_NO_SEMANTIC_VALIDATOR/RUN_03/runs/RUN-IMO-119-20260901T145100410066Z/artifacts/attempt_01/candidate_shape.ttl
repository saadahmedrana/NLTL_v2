@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO119ConditionalCompositeShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extendedPeriodOperation ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeOccurs ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For a Category A or B ship with ice concentration exceeding 1/10 operating for an extended period while sewage discharge occurs, an approved sewage treatment plant and Administration discharge approval are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )

                $this nltl:iceConcentration ?iceQuantity .
                ?iceQuantity qudt:numericValue ?iceValue .
                ?iceQuantity qudt:unit unit:UNITLESS .
                FILTER(?iceValue > 1)

                $this nltl:extendedPeriodOperation true .
                $this nltl:sewageDischargeOccurs true .

                FILTER (
                    NOT EXISTS {
                        $this nltl:approvedSewageTreatmentPlantUsed true
                    } ||
                    NOT EXISTS {
                        $this nltl:administrationDischargeApprovalStatus
                            nltl:evidenceStateApproved
                    }
                )
            }
        """
    ] .
