@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-002-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine which Ice Class Regulations apply."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2019-01-01"^^xsd:date ;
                sh:maxExclusive "2021-07-05"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2017 ;
                sh:message "Ships contracted between 1 January 2019 and 5 July 2021 shall identify the 2017 Ice Class Regulations as applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:maxExclusive "2019-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minInclusive "2021-07-05"^^xsd:date
            ]
        ]
    ) .
