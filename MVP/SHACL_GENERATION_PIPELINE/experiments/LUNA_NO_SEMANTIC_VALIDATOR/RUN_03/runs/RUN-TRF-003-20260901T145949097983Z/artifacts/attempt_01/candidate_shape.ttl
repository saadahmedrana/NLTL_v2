@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have one construction contract date to determine applicability of the 2010 Ice Class Regulations."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue
    ] ;
    sh:sparql [
        sh:message "The 2010 Ice Class Regulations must apply to ships contracted for construction from 2012-01-01 through 2018-12-31, and must not be recorded as applicable outside that interval." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    (
                        ?date >= "2012-01-01"^^xsd:date &&
                        ?date < "2019-01-01"^^xsd:date &&
                        NOT EXISTS {
                            $this nltl:applicableIceClassRegulationEdition
                                nltl:iceClassRegulationEdition2010
                        }
                    )
                    ||
                    (
                        (
                            ?date < "2012-01-01"^^xsd:date ||
                            ?date >= "2019-01-01"^^xsd:date
                        ) &&
                        EXISTS {
                            $this nltl:applicableIceClassRegulationEdition
                                nltl:iceClassRegulationEdition2010
                        }
                    )
                )
            }
        """
    ] .
