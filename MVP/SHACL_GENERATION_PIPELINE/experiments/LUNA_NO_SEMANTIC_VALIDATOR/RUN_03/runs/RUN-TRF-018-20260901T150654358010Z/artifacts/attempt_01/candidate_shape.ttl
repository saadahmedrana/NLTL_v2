@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF018Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "iceClass is required and must be a canonical ice-class value."
    ] ;
    sh:property [
        sh:path nltl:calculatedRequiredPower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "calculatedRequiredPower is required as a single kW quantity value."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "maximumContinuousRatingPower is required as a single kW quantity value."
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be at least the calculated required power and at least 1000 kW for ice classes IA, IB, or IC, or at least 2800 kW for IA Super." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .

                ?calculatedNode qudt:numericValue ?calculated ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?maximumNode qudt:numericValue ?maximum ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloW> .

                FILTER (
                    (
                        ?ice IN (
                            nltl:iceClassIa ,
                            nltl:iceClassIb ,
                            nltl:iceClassIc
                        )
                        &&
                        (
                            ?maximum < ?calculated ||
                            ?maximum < 1000.0
                        )
                    )
                    ||
                    (
                        ?ice = nltl:iceClassIaSuper
                        &&
                        (
                            ?maximum < ?calculated ||
                            ?maximum < 2800.0
                        )
                    )
                )
            }
        """
    ] .
