@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF029Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "directAnalysisUsed must be provided as one boolean applicability value."
    ] ;
    sh:or (
        gen:TRF029DirectAnalysisShape
        gen:TRF029PrescribedProcedureShape
    ) .

gen:TRF029DirectAnalysisShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:prescribedProcedureApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "When direct analysis is used, the prescribed procedure must be marked not applicable."
    ] ;
    sh:property [
        sh:path nltl:directAnalysisApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "When direct analysis is used, its approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:structuralArrangement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "When direct analysis is used, a structural arrangement must be recorded."
    ] .

gen:TRF029PrescribedProcedureShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:hasValue false
    ] .
