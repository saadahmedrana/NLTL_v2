@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF034EffectiveMemberCrossSectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
            ]
        ] ;
        sh:message "The effective member cross section shall provide section modulus in cm^3."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M2>
            ]
        ] ;
        sh:message "The effective member cross section shall provide shear area in m^2."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasEffectiveMemberCrossSection
        ] ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:hullStructure ;
            sh:property [
                sh:path nltl:memberNormalToPlating ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean
            ]
        ] ;
        sh:message "The effective member cross section shall be linked to a hull structure with a declared member orientation."
    ] ;
    sh:sparql [
        sh:message "When the member is not normal to the plating, classification society section-property calculation evidence shall be provided." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?structure nltl:hasEffectiveMemberCrossSection $this .
                ?structure nltl:memberNormalToPlating ?normal .
                FILTER (?normal = false)
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] .
