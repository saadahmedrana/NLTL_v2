@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF045FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        gen:TRF045ApplicableCase
        gen:TRF045NonApplicableCase
    ) ;
    sh:sparql [
        sh:message "ordinaryFrameScantlingsUsed may be true only when the frame span within the ice-strengthening zone is less than 15% of the frame span." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:ordinaryFrameScantlingsUsed true .
    $this nltl:frameSpanWithinIceStrengtheningZone ?iceSpan .
    ?iceSpan qudt:numericValue ?iceValue ;
             qudt:unit unit:M .
    $this nltl:span ?spanValueNode .
    ?spanValueNode qudt:numericValue ?spanValue ;
                   qudt:unit unit:M .
    FILTER ( ?iceValue >= (0.15 * ?spanValue) )
}
""" ;
    ] .

gen:TRF045ApplicableCase
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpanWithinIceStrengtheningZone ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The frame span within the ice-strengthening zone must be less than 15% of the frame span for the applicable case." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:frameSpanWithinIceStrengtheningZone ?iceSpan .
    ?iceSpan qudt:numericValue ?iceValue ;
             qudt:unit unit:M .
    $this nltl:span ?spanValueNode .
    ?spanValueNode qudt:numericValue ?spanValue ;
                   qudt:unit unit:M .
    FILTER ( ?iceValue < (0.15 * ?spanValue) )
}
""" ;
    ] .

gen:TRF045NonApplicableCase
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpanWithinIceStrengtheningZone ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The frame span within the ice-strengthening zone must be at least 15% of the frame span for the non-applicable case." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:frameSpanWithinIceStrengtheningZone ?iceSpan .
    ?iceSpan qudt:numericValue ?iceValue ;
             qudt:unit unit:M .
    $this nltl:span ?spanValueNode .
    ?spanValueNode qudt:numericValue ?spanValue ;
                   qudt:unit unit:M .
    FILTER ( ?iceValue >= (0.15 * ?spanValue) )
}
""" ;
    ] .
