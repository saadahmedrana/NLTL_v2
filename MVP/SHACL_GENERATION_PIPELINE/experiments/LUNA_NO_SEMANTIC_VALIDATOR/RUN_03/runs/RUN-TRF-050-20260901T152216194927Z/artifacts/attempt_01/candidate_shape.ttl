@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-050_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAttachment ;
        sh:minCount 1 ;
        sh:class nltl:frameAttachmentRecord ;
        sh:node <urn:nltl:generated-shape:TRF-050_FrameAttachmentRecordShape> ;
        sh:message "Each frame shall have a frame attachment record conforming to the frame-to-shell attachment requirements."
    ] .

<urn:nltl:generated-shape:TRF-050_FrameAttachmentRecordShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frameAttachmentRecord ;
    sh:property [
        sh:path nltl:frameShellWeldType ;
        sh:minCount 1 ;
        sh:class nltl:weldTypeValue ;
        sh:hasValue nltl:doubleContinuousWeld ;
        sh:message "The frame shall be attached to the shell by a double continuous weld."
    ] ;
    sh:property [
        sh:path nltl:shellPlateButtCrossing ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Shell-plate-butt-crossing applicability must be recorded as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shellPlateButtCrossing ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:scallopingPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Scalloping is not allowed unless the frame crosses a shell-plate butt."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shellPlateButtCrossing ;
                sh:hasValue true
            ]
        ]
    ) .
