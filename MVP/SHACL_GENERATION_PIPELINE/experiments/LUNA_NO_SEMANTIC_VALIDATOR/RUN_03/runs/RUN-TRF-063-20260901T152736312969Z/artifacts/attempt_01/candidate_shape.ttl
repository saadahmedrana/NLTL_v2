@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF063ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single propeller count is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
                sh:node gen:TRF063StrengtheningEnvelopeShape ;
                sh:minCount 1 ;
                sh:message "A twin-screw ship shall have a side-propeller strengthening envelope."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:minInclusive 3 ;
                sh:maxInclusive 3
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
                sh:node gen:TRF063StrengtheningEnvelopeShape ;
                sh:minCount 1 ;
                sh:message "A triple-screw ship shall have a side-propeller strengthening envelope."
            ]
        ]
    ) .

gen:TRF063StrengtheningEnvelopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:strengtheningEnvelopeBoundary ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tankTop ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The strengthening envelope shall identify the tank top as its boundary."
    ] ;
    sh:property [
        sh:path nltl:strengtheningForwardExtent ;
        sh:node gen:TRF063LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The strengthening envelope shall specify a forward extent of at least 1.5 metres."
    ] ;
    sh:property [
        sh:path nltl:strengtheningAftExtent ;
        sh:node gen:TRF063LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The strengthening envelope shall specify an aft extent of at least 1.5 metres."
    ] .

gen:TRF063LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.5"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
