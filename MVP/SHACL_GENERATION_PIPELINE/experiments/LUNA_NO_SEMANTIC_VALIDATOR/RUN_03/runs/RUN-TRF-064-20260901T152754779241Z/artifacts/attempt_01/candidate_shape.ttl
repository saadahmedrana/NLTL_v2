@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether detached struts are used."
    ] ;
    sh:or (
        gen:TRF064EnclosedBranch
        gen:TRF064DetachedStrutBranch
    ) .

gen:TRF064EnclosedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node gen:TRF064SideShaftingShape ;
        sh:class nltl:sidePropellerShaftingAssembly
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node gen:TRF064SternTubeShape ;
        sh:class nltl:sternTube
    ] .

gen:TRF064DetachedStrutBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:minCount 1 ;
        sh:node gen:TRF064DetachedStrutShape ;
        sh:class nltl:detachedStrutStructure ;
        sh:message "A detached strut must have design, hull-attachment, and strength evidence."
    ] .

gen:TRF064SideShaftingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "Side propeller shafting must be enclosed within plated bossing when detached struts are not used."
    ] .

gen:TRF064SternTubeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "A side-propeller stern tube must be enclosed within plated bossing when detached struts are not used."
    ] .

gen:TRF064DetachedStrutShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutDesignEvidence ;
        sh:message "Detached strut design evidence is required."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutHullAttachmentEvidence ;
        sh:message "Detached strut hull-attachment evidence is required."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutStrengthEvidence ;
        sh:message "Detached strut strength evidence is required."
    ] .
