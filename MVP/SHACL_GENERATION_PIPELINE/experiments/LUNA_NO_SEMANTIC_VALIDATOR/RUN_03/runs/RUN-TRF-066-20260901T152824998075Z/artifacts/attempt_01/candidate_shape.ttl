@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:datatype nltl:iceClassValue ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship must have one permitted Finnish-Swedish ice-class value."
    ] ;
    sh:or (
        gs:TRF066IaShape
        gs:TRF066IaSuperShape
        gs:TRF066NonApplicableIceClassShape
    ) .

gs:TRF066IaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIa
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:TRF066PracticableShape
        gs:TRF066NotPracticableShape
    ) .

gs:TRF066IaSuperShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gs:TRF066PracticableShape
        gs:TRF066NotPracticableShape
    ) .

gs:TRF066NonApplicableIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

gs:TRF066PracticableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:hasValue true ;
        sh:message "For ice classes IA and IA Super, a practicable ice knife must extend below the lower ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node gs:TRF066IceKnifeArrangementShape ;
        sh:message "For ice classes IA and IA Super, the rudder protection arrangement must include an ice knife extending below the lower ice waterline."
    ] .

gs:TRF066NotPracticableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:minCount 1 ;
        sh:node gs:TRF066EquivalentArrangementShape ;
        sh:message "When an ice knife is not practicable for ice classes IA and IA Super, an equivalent rudder protection means is required."
    ] .

gs:TRF066IceKnifeArrangementShape
    a sh:NodeShape ;
    sh:class nltl:iceKnife ;
    sh:property [
        sh:path nltl:extendsBelowLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gs:TRF066EquivalentArrangementShape
    a sh:NodeShape ;
    sh:class nltl:equivalentRudderProtectionMeans .
