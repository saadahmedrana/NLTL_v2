@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF079Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerImmersionFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerShaftCentrelineDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The immersion function and ice load cycle coefficient do not satisfy the specified formulas." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?hNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:propellerShaftCentrelineDepth ?h0Node ;
                      nltl:propellerImmersionFunction ?fNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .

                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?dNode qudt:numericValue ?d ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?h0Node qudt:numericValue ?h0 ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                ?fNode qudt:numericValue ?reportedF ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k2Node qudt:numericValue ?reportedK2 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                BIND (((?h0 - ?h) / (?d / 2)) - 1 AS ?expectedF)
                BIND (
                    IF(
                        ?expectedF < 0,
                        0.8 - ?expectedF,
                        IF(
                            ?expectedF <= 1,
                            0.8 - (0.4 * ?expectedF),
                            IF(
                                ?expectedF <= 2.5,
                                0.6 - (0.2 * ?expectedF),
                                0.1
                            )
                        )
                    ) AS ?expectedK2
                )
                BIND ((IF(?expectedF >= 0, ?expectedF, -?expectedF) * 0.000001) + 0.000000001 AS ?fTolerance)
                BIND ((IF(?expectedK2 >= 0, ?expectedK2, -?expectedK2) * 0.000001) + 0.000000001 AS ?k2Tolerance)

                FILTER (
                    ?reportedF < (?expectedF - ?fTolerance) ||
                    ?reportedF > (?expectedF + ?fTolerance) ||
                    ?reportedK2 < (?expectedK2 - ?k2Tolerance) ||
                    ?reportedK2 > (?expectedK2 + ?k2Tolerance)
                )
            }
        """
    ] .
