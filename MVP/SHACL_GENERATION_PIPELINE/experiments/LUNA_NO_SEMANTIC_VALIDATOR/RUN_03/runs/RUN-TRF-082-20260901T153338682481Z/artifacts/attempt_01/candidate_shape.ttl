@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF082Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bollard thrust known status must be recorded as one boolean value."
    ] ;
    sh:or (
        gs:TRF082KnownShape
        gs:TRF082LookupRequiredShape
    ) .

gs:TRF082KnownShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:hasValue true ;
        sh:message "This branch applies when hydrodynamic bollard thrust is known."
    ] .

gs:TRF082LookupRequiredShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:hasValue false ;
        sh:message "When hydrodynamic bollard thrust is not known, the Table 6-8 lookup must be applied."
    ] ;
    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF082ThrustQuantityShape ;
        sh:message "Hydrodynamic bollard thrust must be supplied in the non-known branch."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node gs:TRF082LookupCaseShape ;
        sh:message "A Table 6-8 lookup case is required when hydrodynamic bollard thrust is not known."
    ] .

gs:TRF082ThrustQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Hydrodynamic bollard thrust must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Hydrodynamic bollard thrust must use the kilonewton unit."
    ] .

gs:TRF082LookupCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Table 6-8 lookup case must record that the lookup was applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash8 ;
        sh:message "The lookup case must reference TRAFICOM Table 6-8."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The Table 6-8 selection must have supporting evidence."
    ] .
