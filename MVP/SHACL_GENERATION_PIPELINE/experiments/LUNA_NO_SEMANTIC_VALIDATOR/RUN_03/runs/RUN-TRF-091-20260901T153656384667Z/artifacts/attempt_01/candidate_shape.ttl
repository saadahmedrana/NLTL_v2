@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:TRF-091:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:message "The ship must identify the load sequence case for propeller ice-block milling."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:node gen:PropulsionLoadCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify a propulsion load case used for the strength evaluation."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A propulsion load case for the ice-milling sequence must not be designated for propulsion system stalling analysis." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:loadCasePurpose nltl:stallingAnalysisPurposeValue .
            }
        """
    ] .

gen:PropulsionLoadCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:minCount 1 ;
        sh:message "The propulsion load case must have the purpose of propulsion line strength evaluation."
    ] .
