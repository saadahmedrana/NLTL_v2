@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-130-InletChestShape> a sh:NodeShape ;
    sh:class nltl:inletChest ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The cooling-water inlet chest must specify its sea inlet location."
    ] ;
    sh:property [
        sh:path nltl:nearCentrelineAndWellAftIfPossible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The sea inlet must be near the centreline and well aft if possible."
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The inlet chest must provide a recommended chest volume in cubic metres."
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The inlet chest must provide its sea chest volume in cubic metres."
    ] ;
    sh:property [
        sh:path nltl:iceAccumulationSpaceAboveInlet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The chest must have sufficient space for ice accumulation above the inlet pipe."
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A full-capacity cooling-water discharge pipe must be connected to the chest."
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The inlet pipe sectional area must be provided in square metres."
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The strainer open area must be provided in square metres."
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The strainer open-area ratio must be provided as a dimensionless quantity."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The chest volume must be approximately total relevant engine power divided by 750, and the strainer open area must be at least four times the inlet pipe area; the reported open-area ratio must correspond to those areas." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasComponent $this .
                ?ship nltl:totalRelevantEnginePower ?totalPowerNode .
                ?totalPowerNode qudt:numericValue ?totalPower .
                ?ship nltl:maximumContinuousRatingPower ?maximumPowerNode .
                ?maximumPowerNode qudt:numericValue ?maximumPower .
                $this nltl:recommendedChestVolume ?volumeNode .
                ?volumeNode qudt:numericValue ?volume .
                $this nltl:inletPipeArea ?inletAreaNode .
                ?inletAreaNode qudt:numericValue ?inletArea .
                $this nltl:strainerOpenArea ?openAreaNode .
                ?openAreaNode qudt:numericValue ?openArea .
                $this nltl:strainerOpenAreaRatio ?ratioNode .
                ?ratioNode qudt:numericValue ?ratio .
                BIND(?totalPower / 750.0 AS ?expectedVolume)
                BIND(?openArea / ?inletArea AS ?expectedRatio)
                FILTER(
                    ABS(?volume - ?expectedVolume) <=
                    (ABS(?expectedVolume) * 0.000001 + 0.000001)
                )
                FILTER(?openArea >= (4.0 * ?inletArea))
                FILTER(
                    ABS(?ratio - ?expectedRatio) <=
                    (ABS(?expectedRatio) * 0.000001 + 0.000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-130-AlternatingInletChestShape> a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-130-InletChestShape> ;
    sh:property [
        sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each alternative cooling-water chest must alternate intake and discharge."
    ] .

<urn:nltl:generated-shape:TRF-130-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The information needed to select the cooling-water chest arrangement is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-130-InletChestShape> ;
                sh:qualifiedMinCount 1 ;
                sh:qualifiedValueShapesDisjoint false ;
                sh:message "At least one cooling-water inlet chest must satisfy the stated arrangement requirements."
            ]
        ]
        [
            sh:property [
                sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The alternative arrangement must be recorded when the volume and height requirements cannot be met."
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-130-AlternatingInletChestShape> ;
                sh:qualifiedMinCount 2 ;
                sh:qualifiedValueShapesDisjoint false ;
                sh:message "At least two alternating cooling-water inlet chests are required for the permitted alternative arrangement."
            ]
        ]
    ) .
