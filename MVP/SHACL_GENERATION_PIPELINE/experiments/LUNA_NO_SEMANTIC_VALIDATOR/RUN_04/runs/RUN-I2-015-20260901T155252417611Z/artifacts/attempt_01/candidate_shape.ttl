@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:BowIceReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gs:BowSubregionCaseShape
    ] .

gs:BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:class nltl:bowFormApplicabilityValue ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must identify the I2.3.1(v) bow-form applicability classification."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable bow subregion calculation case must provide its mid-length position."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:node gs:AngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable bow subregion calculation case must provide its waterline angle."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable bow subregion calculation case must provide the externally computed bow shape coefficient."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1 ;
        sh:node gs:FailureFactorLookupShape ;
        sh:message "Each applicable bow subregion calculation case must provide its failure-class factor lookup case."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasBowSubregionCalculationCase
        ] ;
        sh:class nltl:ship ;
        sh:minCount 1 ;
        sh:node gs:ShipFormulaInputShape
    ] .

gs:ShipFormulaInputShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the upper ice waterline length for each applicable bow calculation case."
    ] ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide beta i prime for each applicable bow calculation case."
    ] .

gs:FailureFactorLookupShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The failure-class factor lookup case must provide the flexural failure class factor."
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The failure-class factor lookup case must provide the crushing failure class factor."
    ] .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
