@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMillimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt-unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:StructuralMemberShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable plating requires frame spacing on its linked structural member."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each applicable plating requires a selected hull area factor on its linked structural member."
    ] .

gen:ApplicablePlatingShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:node gen:AngleQuantityShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive 70
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable transversely-framed plating requires a framing angle of at least 70 degrees."
    ] ;
    sh:property [
        sh:path nltl:platingHullAreaClassification ;
        sh:class nltl:hullAreaValue ;
        sh:in (
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable plating must be classified as BI_b, M_b, or S_b."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "Applicable plating requires a linked structural member with the declared calculation inputs."
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable plating requires an externally calculated net plate thickness result."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:averageIcePressure
        ) ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable calculation requires average ice pressure on the ship."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:peakPressureFactor
        ) ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable calculation requires the peak pressure factor on the ship."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:yieldStrength
        ) ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable calculation requires yield strength on the ship."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:loadPatchHeight
        ) ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The declared calculation inputs require load patch height on the ship."
    ] .

gen:NonApplicablePlatingShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:node gen:AngleQuantityShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxExclusive 70
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PlatingCaseShape a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:or (
        gen:ApplicablePlatingShape
        gen:NonApplicablePlatingShape
    ) .

gen:I2_022_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node gen:PlatingCaseShape ;
        sh:minCount 1 ;
        sh:message "Each linked plating must provide the information needed to establish whether I2-022 applies."
    ] .
