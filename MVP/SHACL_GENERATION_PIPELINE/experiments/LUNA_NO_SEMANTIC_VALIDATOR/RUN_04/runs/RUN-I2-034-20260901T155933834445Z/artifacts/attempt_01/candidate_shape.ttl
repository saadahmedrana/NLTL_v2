@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_034_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_034_StructuralMemberShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented longitudinal structural member in the side structure must have plastic-strength inputs and every represented load-case demand must not exceed the member plastic strength and midspan plastic-collapse load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:longitudinalFrameOrientation true ;
                        nltl:structuralLocation nltl:sideStructureLocation .

                FILTER (
                    NOT EXISTS {
                        ?member nltl:plasticStrength ?strength .
                        ?strength qudt:numericValue ?strengthValue ;
                                 qudt:unit qudt:KiloN .
                        FILTER (datatype(?strengthValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                        ?collapseLoad qudt:numericValue ?collapseValue ;
                                      qudt:unit qudt:KiloN .
                        FILTER (datatype(?collapseValue) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                        FILTER NOT EXISTS {
                            ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                            ?demand qudt:numericValue ?demandValue ;
                                    qudt:unit qudt:KiloN .
                            FILTER (datatype(?demandValue) = xsd:decimal)
                        }
                    }
                    ||
                    EXISTS {
                        ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue ;
                                qudt:unit qudt:KiloN .
                        ?member nltl:plasticStrength ?strength .
                        ?strength qudt:numericValue ?strengthValue ;
                                 qudt:unit qudt:KiloN .
                        FILTER (
                            datatype(?demandValue) = xsd:decimal &&
                            datatype(?strengthValue) = xsd:decimal &&
                            ?demandValue > ?strengthValue
                        )
                    }
                    ||
                    EXISTS {
                        ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                        ?demand qudt:numericValue ?demandValue ;
                                qudt:unit qudt:KiloN .
                        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                        ?collapseLoad qudt:numericValue ?collapseValue ;
                                      qudt:unit qudt:KiloN .
                        FILTER (
                            datatype(?demandValue) = xsd:decimal &&
                            datatype(?collapseValue) = xsd:decimal &&
                            ?demandValue > ?collapseValue
                        )
                    }
                )
            }
        """
    ] .

gen:I2_034_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "A structural member must record whether it is longitudinal before applicability can be determined."
    ] ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:message "A structural member must record its structural location before side-structure applicability can be determined."
    ] .
