@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-037-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-037-StructuralMemberShape> ;
        sh:message "Each ship must provide structural-member load-case data for the applicable members."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-037-DesignCaseShape> ;
        sh:message "The ship must provide an ice-load-patch design case confirming the required minimization location."
    ] .

<urn:nltl:generated-shape:I2-037-StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:memberCapacity ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each structural member must have one capacity quantity in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-037-LoadCaseShape> ;
        sh:message "Each structural member must provide its load case."
    ] .

<urn:nltl:generated-shape:I2-037-LoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearBendingEffect ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load case must identify the combined bending-and-shear effect."
    ] ;
    sh:property [
        sh:path nltl:loadPatchApplicationLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load case must identify the load-patch application location."
    ] .

<urn:nltl:generated-shape:I2-037-DesignCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:memberCapacityMinimizationConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice-load-patch design case must confirm that the selected location minimizes member capacity under combined bending and shear."
    ] .
