@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node gen:CalculationCaseShape ;
        sh:message "The ship shall provide a calculation case for the interpolation." ;
    ] ;
    sh:property [
        sh:path nltl:interpolatedValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall provide the externally determined interpolated value." ;
    ] .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape ;
        sh:message "The calculation case shall contain the hull-girder longitudinal position from aft." ;
    ] ;
    sh:property [
        sh:path nltl:interpolatedLongitudinalDistributionFactor ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The calculation case shall contain the interpolated longitudinal distribution factor." ;
    ] ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The calculation case shall contain interpolation points." ;
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The calculation case shall identify a lower interpolation endpoint." ;
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "The calculation case shall identify an upper interpolation endpoint." ;
    ] .

gen:InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationCoordinate ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:QuantityValueShape ;
        sh:message "Each interpolation point shall contain an interpolation coordinate." ;
    ] ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Each interpolation point shall contain its interpolation-point coordinate." ;
    ] ;
    sh:property [
        sh:path nltl:interpolationPointValue ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:QuantityValueShape ;
        sh:message "Each interpolation point shall contain its interpolation-point value." ;
    ] .

gen:QuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
