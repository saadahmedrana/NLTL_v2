@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-001-ShipDesignIceCategory>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryA
            ] ;
            sh:message "A ship designed for at least medium first-year ice with possible old-ice inclusions shall have Polar Ship Category A."
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:designIceCondition ;
                    sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                ]
            ] ;
            sh:message "A design ice condition is required to determine whether the Category A condition applies."
        ]
    ) .
