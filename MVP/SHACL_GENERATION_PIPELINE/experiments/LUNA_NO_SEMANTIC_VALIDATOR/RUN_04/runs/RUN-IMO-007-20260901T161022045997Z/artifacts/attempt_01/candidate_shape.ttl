@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:imo-007> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must specify one canonical ice condition classification." ;
        sh:or (
            [
                sh:hasValue nltl:openWaterIceCondition ;
                sh:property [
                    sh:path nltl:seaIceConcentration ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:property [
                            sh:path qudt:numericValue ;
                            sh:datatype xsd:decimal ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:maxExclusive 1 ;
                            sh:message "For open water, sea ice concentration must be less than 1/10."
                        ] ;
                        sh:property [
                            sh:path qudt:unit ;
                            sh:minCount 1 ;
                            sh:maxCount 1 ;
                            sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:message "Sea ice concentration must use the unitless quantity unit."
                        ]
                    ]
                ] ;
                sh:property [
                    sh:path nltl:iceOfLandOriginPresent ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:hasValue false ;
                    sh:message "For open water, no ice of land origin may be present."
                ]
            ]
            [
                sh:hasValue nltl:iceFreeIceCondition
            ]
            [
                sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB
            ]
            [
                sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions
            ]
            [
                sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions
            ]
            [
                sh:hasValue nltl:otherWatersIceCondition
            ]
        )
    ] .
