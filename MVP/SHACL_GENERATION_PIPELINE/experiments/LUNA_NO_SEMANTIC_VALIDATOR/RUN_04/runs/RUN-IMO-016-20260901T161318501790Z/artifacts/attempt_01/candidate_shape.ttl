@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_016_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:polarShipCertificateForm ;
        sh:node [
            sh:property [
                sh:path nltl:certificateFormModel ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:appendixIPolarShipCertificateModel
            ]
        ] ;
        sh:message "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The certificate language shall be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:in ( "English" "French" "Spanish" )
            ]
        ]
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:string
            ] ;
            sh:property [
                sh:path nltl:approvedTranslationPresent ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "A certificate language other than English, French, or Spanish requires an approved translation."
            ] ;
            sh:sparql [
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:certificateLanguage ?lang .
    FILTER (
        STR(?lang) IN ("English", "French", "Spanish")
        || NOT EXISTS {
            $this nltl:approvedTranslationPresent true
        }
    )
}
""" ;
                sh:message "For a non-English, non-French, and non-Spanish certificate, approvedTranslationPresent shall be true."
            ]
        ]
    ) .
