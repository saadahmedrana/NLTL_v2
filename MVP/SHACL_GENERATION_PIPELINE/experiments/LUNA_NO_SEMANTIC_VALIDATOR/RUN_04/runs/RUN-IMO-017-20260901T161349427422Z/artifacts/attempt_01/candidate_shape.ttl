@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO017ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The polar certificate supplement must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Endorsement dates must be recorded as dates."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Survey dates must be recorded as dates."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate validity dates must be recorded as dates."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:class nltl:polarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node gen:IMO017SupplementShape ;
        sh:message "The ship must have a polar certificate supplement containing required equipment records."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:message "The ship must have a Polar Ship Certificate."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node gen:IMO017SolasScheduleShape ;
        sh:message "The ship must have an applicable SOLAS certificate schedule."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding SOLAS certificate schedule dates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT ?this
            WHERE {
                ?this ?dateProperty ?shipDate .
                FILTER (
                    ?dateProperty IN (
                        nltl:polarCertificateValidityDates,
                        nltl:surveyDates,
                        nltl:endorsementDates
                    )
                )
                ?this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDateType ?category ;
                        nltl:certificateScheduleDate ?scheduleDate .
                FILTER (
                    (?dateProperty = nltl:polarCertificateValidityDates &&
                     ?category = nltl:validityDateCategory)
                    ||
                    (?dateProperty = nltl:surveyDates &&
                     ?category = nltl:surveyDateCategory)
                    ||
                    (?dateProperty = nltl:endorsementDates &&
                     ?category = nltl:endorsementDateCategory)
                )
                FILTER NOT EXISTS {
                    ?schedule nltl:hasCertificateScheduleDateRecord ?matchingRecord .
                    ?matchingRecord nltl:certificateScheduleDateType ?category ;
                                    nltl:certificateScheduleDate ?matchingDate .
                    FILTER (?matchingDate = ?shipDate)
                }
            }
        """
    ] .

gen:IMO017SupplementShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:message "The polar certificate supplement must record required equipment."
    ] .

gen:IMO017SolasScheduleShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:class nltl:certificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO017DateRecordShape ;
        sh:message "The SOLAS certificate schedule must contain certificate schedule date records."
    ] .

gen:IMO017DateRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Each certificate schedule date record must contain a date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:minCount 1 ;
        sh:message "Each certificate schedule date record must identify a validity, survey, or endorsement date category."
    ] .
