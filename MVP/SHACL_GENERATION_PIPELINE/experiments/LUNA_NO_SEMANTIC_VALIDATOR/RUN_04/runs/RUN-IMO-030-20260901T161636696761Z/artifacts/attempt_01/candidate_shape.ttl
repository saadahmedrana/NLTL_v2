@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:path nltl:iceOperationApplicable ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:hasValue false
        ]
        [
            sh:and (
                [
                    sh:path nltl:iceOperationApplicable ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:hasValue true
                ]
                [
                    sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:hasValue true ;
                    sh:message "When ice operations are applicable, ice-operation monitoring and safety procedures must be present."
                ]
                [
                    sh:path nltl:escortRequirementsPresent ;
                    sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:hasValue true ;
                    sh:message "When ice operations are applicable, applicable escort or icebreaker-assistance requirements must be addressed."
                ]
                [
                    sh:path nltl:independentOperationLimits ;
                    sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:message "When ice operations are applicable, independent-operation limitations must be specified."
                ]
                [
                    sh:path nltl:escortedOperationLimits ;
                    sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:message "When ice operations are applicable, escorted-operation limitations must be specified."
                ]
            )
        ]
    ) ;
    sh:message "The ship must declare whether ice operations are applicable; if applicable, the PWOM must include ice-operation safety procedures, escort requirements, and operating-mode-specific limitations." .
