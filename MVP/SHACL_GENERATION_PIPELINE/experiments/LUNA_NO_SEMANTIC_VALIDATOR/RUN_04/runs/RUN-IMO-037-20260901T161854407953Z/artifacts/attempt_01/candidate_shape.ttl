@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-037-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCategoryValue
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-037-ApplicableShipBranch>
        <urn:nltl:generated-shape:IMO-037-NonApplicableShipBranch>
    ) ;
    sh:message "The ship must satisfy the applicable Polar Code branch or provide inputs establishing that the rule is not applicable." .

<urn:nltl:generated-shape:IMO-037-ApplicableShipBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:or (
            [ sh:hasValue nltl:polarShipCategoryA ]
            [ sh:hasValue nltl:polarShipCategoryB ]
        )
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:minInclusive "2017-01-01"^^xsd:date
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionCase ;
        sh:node <urn:nltl:generated-shape:IMO-037-LoadingConditionCaseShape>
    ] .

<urn:nltl:generated-shape:IMO-037-NonApplicableShipBranch>
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ship category and construction date establish applicability, but the applicable loading-condition constraints are missing or non-conforming." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date .
                FILTER (
                    (?category = nltl:polarShipCategoryA ||
                     ?category = nltl:polarShipCategoryB)
                    &&
                    (
                        YEAR(?date) > 2017 ||
                        (YEAR(?date) = 2017 && MONTH(?date) > 1) ||
                        (YEAR(?date) = 2017 && MONTH(?date) = 1 && DAY(?date) >= 1)
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-037-LoadingConditionCaseShape>
    a sh:NodeShape ;
    sh:class nltl:loadingConditionCase ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 1 ;
                sh:maxInclusive 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO-037-StandardResidualOutcome>
        <urn:nltl:generated-shape:IMO-037-AlternativeInstrumentOutcome>
    ) .

<urn:nltl:generated-shape:IMO-037-StandardResidualOutcome>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:IMO-037-AlternativeInstrumentOutcome>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] .
