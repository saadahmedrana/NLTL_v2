@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_041_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "hydraulic" ;
                sh:message "The opening actuation type must be hydraulic for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Hydraulic openings require means to prevent freezing or excessive viscosity of hydraulic liquids."
            ]
        ]
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The opening actuation type is required to determine applicability."
            ] ;
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?opening .
                        FILTER (STR(?opening) != "hydraulic")
                    }
                """ ;
                sh:message "This non-hydraulic opening actuation branch is applicable."
            ]
        ]
    ) .
