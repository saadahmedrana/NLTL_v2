@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-043-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hazardProtectionCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive true ;
        sh:maxInclusive true ;
        sh:message "The ship must record hazard protection coverage."
    ] ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:class nltl:machineryInstallationItem ;
        sh:node <urn:nltl:generated-shape:IMO-043-MachineryInstallationShape>
    ] .

<urn:nltl:generated-shape:IMO-043-MachineryInstallationShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:class nltl:associatedEquipmentItem ;
        sh:minCount 1 ;
        sh:message "Each machinery installation must identify its associated equipment."
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:in (
            nltl:iceAccretionHazard
            nltl:snowAccumulationHazard
            nltl:seawaterIceIngestionHazard
            nltl:liquidFreezingOrViscosityIncreaseHazard
            nltl:seawaterIntakeTemperatureHazard
            nltl:snowIngestionHazard
        ) ;
        sh:minCount 1 ;
        sh:message "Each machinery installation must identify its applicable controlled hazard values."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each machinery installation must provide hazard protection evidence."
    ] .
