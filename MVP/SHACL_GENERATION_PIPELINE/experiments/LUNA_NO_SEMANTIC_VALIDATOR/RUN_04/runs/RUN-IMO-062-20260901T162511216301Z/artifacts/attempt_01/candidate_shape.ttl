@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-062-ExposedEscapeRoute> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:accessibleStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record accessible status as true."
    ] ;
    sh:property [
        sh:path nltl:safeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record safe status as true."
    ] ;
    sh:property [
        sh:path nltl:iceSnowMitigationCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record ice and snow mitigation coverage as true."
    ] ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Each exposed escape route must have documented ice and snow mitigation evidence."
            ]
        ]
    ] .
