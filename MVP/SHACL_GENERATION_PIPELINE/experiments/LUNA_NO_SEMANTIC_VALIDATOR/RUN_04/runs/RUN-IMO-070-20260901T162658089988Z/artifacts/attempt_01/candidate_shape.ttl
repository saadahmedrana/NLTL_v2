@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-070-Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each person on board a passenger ship must have an immersion suit or thermal protective aid assignment, and the assigned equipment must be size compatible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this rdf:type nltl:passengerShip .
                FILTER (
                    NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus true .
                    }
                    ||
                    EXISTS {
                        $this nltl:hasPersonOnBoardMember ?person .
                        FILTER NOT EXISTS {
                            ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                            ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                            ?equipment rdf:type nltl:personalSurvivalEquipment .
                            ?equipment rdf:type ?equipmentType .
                            FILTER (
                                ?equipmentType = nltl:immersionSuitEquipment
                                || ?equipmentType = nltl:thermalProtectiveAidEquipment
                            )
                        }
                    }
                )
            }
        """ ;
    ] .
