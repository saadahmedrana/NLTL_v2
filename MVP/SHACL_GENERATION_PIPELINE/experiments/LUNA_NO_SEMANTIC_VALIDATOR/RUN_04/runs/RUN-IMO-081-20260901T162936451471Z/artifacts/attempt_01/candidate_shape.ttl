@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-081> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-strengthening status is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:maxExclusive "2017-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:independentEchoSoundingDeviceCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:echoSoundingDeviceCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 1
                    ] ;
                    sh:property [
                        sh:path nltl:independentTransducerCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For ships constructed on or after 1 January 2017 that are ice strengthened, either at least two independent echo-sounding devices or one echo-sounding device with at least two independent transducers is required." .
