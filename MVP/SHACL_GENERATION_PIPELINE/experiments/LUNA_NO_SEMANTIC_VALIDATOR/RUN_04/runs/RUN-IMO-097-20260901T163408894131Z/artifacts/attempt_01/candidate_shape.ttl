@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO097NotApplicableShape
        gen:IMO097ApplicableShape
    ) .

gen:IMO097NotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The ship must record that it does not operate in low air temperature when this requirement is non-applicable."
    ] .

gen:IMO097ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record whether it operates in low air temperature."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:node gen:IMO097SurvivalCraftShape
    ] .

gen:IMO097SurvivalCraftShape
    a sh:NodeShape ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must have at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must have at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable survival craft must have at least one on-scene communication device."
    ] .
