@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO112ArcticNlsDischargeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Arctic_waters" ;
                sh:message "The operating area must identify Arctic waters for the applicable prohibition branch."
            ] ;
            sh:property [
                sh:path nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Discharge of noxious liquid substances or mixtures must be recorded as false in Arctic waters."
            ] ;
            sh:sparql [
                sh:message "Every NLS discharge value must be false when the ship operates in Arctic waters." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea "Arctic_waters" .
                        $this nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ?discharge .
                        FILTER (?discharge != false)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:sparql [
                sh:message "The non-Arctic branch cannot be used when the operating area is Arctic waters." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:operatingArea "Arctic_waters" .
                    }
                """
            ]
        ]
    ) ;
    sh:message "The ship must identify its operating area and, when operating in Arctic waters, prohibit discharge of noxious liquid substances or mixtures." .
