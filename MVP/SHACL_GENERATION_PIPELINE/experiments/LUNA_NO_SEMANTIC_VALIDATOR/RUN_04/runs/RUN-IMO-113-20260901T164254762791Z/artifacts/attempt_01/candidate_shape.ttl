@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_113_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The ship's polar-waters applicability indicator must be false when the polar document-coverage condition is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ship's polar-waters applicability indicator must be true for this applicability branch."
            ] ;
            sh:property [
                sh:path nltl:cargoRecordBookPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar operation must be taken into account in the applicable Cargo Record Book."
            ] ;
            sh:property [
                sh:path nltl:manualPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar operation must be taken into account in the applicable Manual."
            ] ;
            sh:property [
                sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar operation must be taken into account in the applicable NLS or marine pollution emergency plan."
            ]
        ]
    ) .
