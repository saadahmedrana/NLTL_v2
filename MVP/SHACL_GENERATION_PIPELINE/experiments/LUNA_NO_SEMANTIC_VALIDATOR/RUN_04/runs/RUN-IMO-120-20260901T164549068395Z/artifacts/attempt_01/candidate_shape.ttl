@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_120_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must specify its operating area."
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must specify whether food waste is discharged to sea."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When operating in Arctic_waters and discharging food waste to sea, the ship must record a distance of at least 12 nautical miles to the nearest land, ice shelf, or fast ice, and must record the distance from areas whose ice concentration exceeds 1/10." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea ?area ;
                      nltl:foodWasteDischargeToSea true .

                FILTER (?area = "Arctic_waters"^^xsd:string)

                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestLandIceShelfOrFastIce ?nearestDistance ;
                          nltl:nearbyIceConcentration ?nearbyConcentration ;
                          nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .

                    ?nearestDistance rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?nearestValue ;
                                     qudt:unit unit:MI_N .

                    ?nearbyConcentration rdf:type qudt:QuantityValue ;
                                         qudt:numericValue ?nearbyValue ;
                                         qudt:unit unit:UNITLESS .

                    ?areaDistance rdf:type qudt:QuantityValue ;
                                   qudt:numericValue ?areaDistanceValue ;
                                   qudt:unit unit:MI_N .

                    FILTER (
                        datatype(?nearestValue) = xsd:decimal &&
                        ?nearestValue >= "12"^^xsd:decimal &&
                        datatype(?nearbyValue) = xsd:decimal &&
                        ?nearbyValue > "0.1"^^xsd:decimal &&
                        datatype(?areaDistanceValue) = xsd:decimal
                    )
                }
            }
        """
    ] .
