@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_124> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:antarcticArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:distanceToNearestFastIce ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MI_N ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:nearbyIceConcentration ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MI_N ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeOntoIce ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When operating area equals the Antarctic area and a MARPOL Annex V regulation 6.1 discharge occurs, the nearest-fast-ice distance must be recorded in nautical miles and be at least 12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea ;
                       nltl:antarcticArea ?antarcticArea ;
                       nltl:marpolAnnexVRegulation6Point1DischargeOccurs true .
                FILTER (?operatingArea = ?antarcticArea)
                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestFastIce ?distance .
                    ?distance qudt:numericValue ?value ;
                              qudt:unit unit:MI_N .
                    FILTER (?value >= 12)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When the applicable nearby ice concentration exceeds one tenth, the distance from that area must be recorded in nautical miles." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea ;
                       nltl:antarcticArea ?antarcticArea ;
                       nltl:marpolAnnexVRegulation6Point1DischargeOccurs true ;
                       nltl:nearbyIceConcentration ?concentration .
                FILTER (?operatingArea = ?antarcticArea)
                ?concentration qudt:numericValue ?concentrationValue ;
                               qudt:unit unit:UNITLESS .
                FILTER (?concentrationValue > 1)
                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?distance .
                    ?distance qudt:numericValue ?distanceValue ;
                              qudt:unit unit:MI_N .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When the conditional Antarctic discharge rule applies, food waste must not be discharged onto ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea ;
                       nltl:antarcticArea ?antarcticArea ;
                       nltl:marpolAnnexVRegulation6Point1DischargeOccurs true .
                FILTER (?operatingArea = ?antarcticArea)
                FILTER (
                    NOT EXISTS {
                        $this nltl:foodWasteDischargeOntoIce false
                    }
                    ||
                    EXISTS {
                        $this nltl:foodWasteDischargeOntoIce true
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The applicable nearby ice concentration must be recorded as a dimensionless quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatingArea ?operatingArea ;
                       nltl:antarcticArea ?antarcticArea ;
                       nltl:marpolAnnexVRegulation6Point1DischargeOccurs true .
                FILTER (?operatingArea = ?antarcticArea)
                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?concentration .
                    ?concentration qudt:numericValue ?value ;
                                   qudt:unit unit:UNITLESS .
                }
            }
        """
    ] .
