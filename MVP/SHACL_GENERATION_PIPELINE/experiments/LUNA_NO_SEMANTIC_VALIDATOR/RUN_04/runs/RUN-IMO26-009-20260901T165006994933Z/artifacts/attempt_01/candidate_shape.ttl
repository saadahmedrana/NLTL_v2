@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_009_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion applicability must be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:navigationOrCommunicationAntenna ;
                    sh:property [
                        sh:path nltl:antennaIceAccumulationPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true ;
                        sh:message "Every required navigation or communication antenna must have ice-accumulation prevention means."
                    ]
                ] ;
                sh:message "When ice accretion is likely, required navigation or communication antennas must be identified."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
    ) .
