@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO26_016_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO26_016_NonPolarBranch
        gen:IMO26_016_PolarBranch
    ) .

gen:IMO26_016_NonPolarBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship must be identified as not operating in polar waters for this non-applicable branch."
    ] .

gen:IMO26_016_PolarBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The polar applicability branch requires the ship to operate in polar waters."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthOverallQuantityShape
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:GrossTonnageQuantityShape
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a ship operating in polar waters, chapter 11-1 applicability must be true exactly for the specified fishing-vessel, pleasure-yacht, or cargo-ship thresholds." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters true ;
                      nltl:shipType ?type ;
                      nltl:lengthOverall ?lengthNode ;
                      nltl:grossTonnage ?tonnageNode ;
                      nltl:engagedInTrade ?trade ;
                      nltl:polarCodeChapter11Dash1Applicable ?app .

                ?lengthNode qudt:numericValue ?lengthValue ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .

                ?tonnageNode qudt:numericValue ?tonnageValue ;
                             qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                BIND(
                    (
                        (?type = "fishing_vessel" && ?lengthValue >= 24)
                        ||
                        (?type = "pleasure_yacht" && ?tonnageValue >= 300 && ?trade = false)
                        ||
                        (?type = "cargo_ship" && ?tonnageValue >= 300 && ?tonnageValue < 500)
                    )
                    AS ?qualifies
                )

                FILTER(
                    (?qualifies = true && ?app != true)
                    ||
                    (?qualifies = false && ?app != false)
                )
            }
        """
    ] .

gen:LengthOverallQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:GrossTonnageQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
