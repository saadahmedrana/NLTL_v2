@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_003> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A construction contract date is required to determine whether the 2010 Ice Class Regulations apply."
    ] ;
    sh:sparql [
        sh:message "For ships contracted for construction from 1 January 2012 through 31 December 2018, the applicable Ice Class regulation edition must be 2010." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (datatype(?contractDate) = xsd:date)
                FILTER (YEAR(?contractDate) >= 2012 && YEAR(?contractDate) < 2019)
                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                            nltl:iceClassRegulationEdition2010 .
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?edition .
                        FILTER (?edition != nltl:iceClassRegulationEdition2010)
                    }
                )
            }
        """
    ] .
