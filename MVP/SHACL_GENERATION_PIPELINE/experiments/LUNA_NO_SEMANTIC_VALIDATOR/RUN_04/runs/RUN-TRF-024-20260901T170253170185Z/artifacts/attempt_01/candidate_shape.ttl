@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-024-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship must identify its ice class."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship retaining ice class IA Super or IA with construction begun before 1 September 2003, assessment date, construction stage date, delivery date, and the section 3.2.2 compliance method are required; the assessment date must not be later than 1 January of the year twenty years after the delivery year." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice .
                FILTER (
                    ?ice = nltl:iceClassIaSuper ||
                    ?ice = nltl:iceClassIa
                )

                OPTIONAL { $this nltl:constructionStageDate ?construction . }
                OPTIONAL { $this nltl:deliveryDate ?delivery . }
                OPTIONAL { $this nltl:assessmentDate ?assessment . }
                OPTIONAL { $this nltl:engineOutputComplianceMethod ?method . }

                BIND(
                    IF(
                        BOUND(?construction) &&
                        datatype(?construction) = xsd:date,
                        YEAR(?construction),
                        -9999
                    ) AS ?constructionYear
                )
                BIND(
                    IF(
                        BOUND(?construction) &&
                        datatype(?construction) = xsd:date,
                        MONTH(?construction),
                        -9999
                    ) AS ?constructionMonth
                )
                BIND(
                    IF(
                        BOUND(?construction) &&
                        datatype(?construction) = xsd:date,
                        DAY(?construction),
                        -9999
                    ) AS ?constructionDay
                )
                BIND(
                    IF(
                        BOUND(?delivery) &&
                        datatype(?delivery) = xsd:date,
                        YEAR(?delivery),
                        -9999
                    ) AS ?deliveryYear
                )
                BIND(
                    IF(
                        BOUND(?assessment) &&
                        datatype(?assessment) = xsd:date,
                        YEAR(?assessment),
                        -9999
                    ) AS ?assessmentYear
                )
                BIND(
                    IF(
                        BOUND(?assessment) &&
                        datatype(?assessment) = xsd:date,
                        MONTH(?assessment),
                        -9999
                    ) AS ?assessmentMonth
                )
                BIND(
                    IF(
                        BOUND(?assessment) &&
                        datatype(?assessment) = xsd:date,
                        DAY(?assessment),
                        -9999
                    ) AS ?assessmentDay
                )

                FILTER (
                    !BOUND(?construction) ||
                    datatype(?construction) != xsd:date ||
                    !BOUND(?delivery) ||
                    datatype(?delivery) != xsd:date ||
                    !BOUND(?assessment) ||
                    datatype(?assessment) != xsd:date ||
                    !BOUND(?method) ||
                    ?method != nltl:traficom2017Section3Point2Point2Method ||
                    !(
                        ?constructionYear < 2003 ||
                        (
                            ?constructionYear = 2003 &&
                            (
                                ?constructionMonth < 9 ||
                                (
                                    ?constructionMonth = 9 &&
                                    ?constructionDay < 1
                                )
                            )
                        )
                    ) ||
                    !(
                        ?assessmentYear < (?deliveryYear + 20) ||
                        (
                            ?assessmentYear = (?deliveryYear + 20) &&
                            (
                                ?assessmentMonth < 1 ||
                                (
                                    ?assessmentMonth = 1 &&
                                    ?assessmentDay <= 1
                                )
                            )
                        )
                    )
                )
            }
        """
    ] .
