@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF031Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldPoint ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:yieldPoint qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:yieldPoint qudt:unit ) ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingShearStress ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:combinedBendingShearStress qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:combinedBendingShearStress qudt:unit ) ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldShearStress ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:yieldShearStress qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:yieldShearStress qudt:unit ) ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:beamTheoryUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:allowableShearStress ;
                sh:class qudt:QuantityValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path ( nltl:allowableShearStress qudt:numericValue ) ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path ( nltl:allowableShearStress qudt:unit ) ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Combined stress must be lower than yield point; yield shear stress must equal yield point divided by sqrt(3) within relative tolerance 1e-6 plus absolute tolerance 1e-9; under beam theory, allowable shear stress must not exceed 0.9 times yield shear stress." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointNode ;
                      nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldShearStress ?yieldShearNode ;
                      nltl:beamTheoryUsed ?beamUsed .
                ?yieldPointNode qudt:numericValue ?yieldPoint .
                ?combinedNode qudt:numericValue ?combined .
                ?yieldShearNode qudt:numericValue ?yieldShear .
                {
                    FILTER (
                        ?combined >= ?yieldPoint ||
                        ABS(?yieldShear - (?yieldPoint / 1.7320508075688772)) >
                        (0.000001 * ABS(?yieldPoint / 1.7320508075688772) + 0.000000001)
                    )
                }
                UNION
                {
                    FILTER (?beamUsed = true)
                    $this nltl:allowableShearStress ?allowableNode .
                    ?allowableNode qudt:numericValue ?allowable .
                    FILTER (?allowable > (0.9 * (?yieldPoint / 1.7320508075688772)))
                }
                UNION
                {
                    FILTER (?beamUsed = false)
                }
            }
        """
    ] .
