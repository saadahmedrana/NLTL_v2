@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF047_FrameShape a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:node nltl:TRF047_StrengthenedPartShape ;
        sh:message "Each represented strengthened main or intermediate ice frame part must satisfy the required lower-end attachment or permitted connection condition."
    ] .

nltl:TRF047_StrengthenedPartShape a sh:NodeShape ;
    sh:or (
        [
            sh:class nltl:mainFrame ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:node nltl:TRF047_AttachedLowerEndShape ;
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:node nltl:TRF047_AttachedLowerEndShape ;
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:node nltl:TRF047_AlternativeLowerEndShape ;
            ]
        ]
    ) .

nltl:TRF047_AttachedLowerEndShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node nltl:TRF047_PermittedSupportingStructureShape ;
        sh:message "The lower end must be attached to a deck structure, tank boundary plating, tank top, or ice stringer."
    ] .

nltl:TRF047_PermittedSupportingStructureShape a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:tankTop ]
        [ sh:class nltl:iceStringer ]
    ) .

nltl:TRF047_AlternativeLowerEndShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:minCount 1 ;
        sh:node nltl:TRF047_LowerLimitSupportingStructureShape ;
        sh:message "A permitted alternative connection requires termination below a qualifying supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:minCount 1 ;
        sh:node nltl:TRF047_HorizontalConnectionMemberShape ;
        sh:message "A permitted alternative connection requires a horizontal member connected to an adjacent main frame."
    ] .

nltl:TRF047_LowerLimitSupportingStructureShape a sh:NodeShape ;
    sh:or (
        [
            sh:class nltl:deckStructure ;
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:class nltl:tankBoundaryPlating ;
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:class nltl:tankTop ;
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:class nltl:iceStringer ;
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

nltl:TRF047_HorizontalConnectionMemberShape a sh:NodeShape ;
    sh:class nltl:horizontalConnectionMember ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:minCount 1 ;
        sh:node nltl:TRF047_AdjacentMainFrameShape ;
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The horizontal connection member must have the same scantlings as the main frames."
    ] .

nltl:TRF047_AdjacentMainFrameShape a sh:NodeShape ;
    sh:class nltl:mainFrame ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "An adjacent main frame below the ice belt must be ice strengthened."
    ] .
