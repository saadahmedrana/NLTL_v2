@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_056_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasWeatherdeckHatch ;
        sh:node [
            sh:class nltl:weatherdeckHatch ;
            sh:property [
                sh:path nltl:hatchOpeningLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/M>
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        ?ship nltl:hasWeatherdeckHatch $this .
                        ?ship nltl:shipBreadth ?breadthQuantity .
                        ?breadthQuantity qudt:numericValue ?breadth .
                        $this nltl:hatchOpeningLength ?openingQuantity .
                        ?openingQuantity qudt:numericValue ?openingLength .
                        FILTER (?openingLength > (?breadth / 2))
                        FILTER (
                            NOT EXISTS {
                                $this nltl:shipSideDeflection ?deflectionQuantity .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                            }
                        )
                    }
                """
            ]
        ]
    ] .

gen:TRF_056_ShipSideDeflectionShape
    a sh:PropertyShape ;
    sh:path nltl:shipSideDeflection ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:datatype xsd:decimal
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:hasValue <http://qudt.org/vocab/unit/M>
        ]
    ] .

gen:TRF_056_HatchCoverEvidenceShape
    a sh:PropertyShape ;
    sh:path nltl:hasHatchCoverDesignEvidence ;
    sh:minCount 1 ;
    sh:node [
        sh:class nltl:hatchCoverDesignEvidence
    ] .

gen:TRF_056_HatchFittingEvidenceShape
    a sh:PropertyShape ;
    sh:path nltl:hasHatchFittingDesignEvidence ;
    sh:minCount 1 ;
    sh:node [
        sh:class nltl:hatchFittingDesignEvidence
    ] .
