@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF060ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:minCount 1 ;
        sh:node gen:AreaCentiM2Value ;
        sh:message "The ship shall provide the actual web-frame cross-sectional area in cm2."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:node gen:AreaCentiM2Value ;
        sh:message "The ship shall provide the required shear area in cm2."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node gen:SectionModulusCentiM3Value ;
        sh:message "The ship shall provide the externally calculated section modulus in cm3."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:node gen:AreaM2Value ;
        sh:message "The ship shall provide the shear area in m2."
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:minCount 1 ;
        sh:node gen:AreaCentiM2Value ;
        sh:message "The ship shall provide the web-frame free flange area in cm2."
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:minCount 1 ;
        sh:node gen:ForceKiloNValue ;
        sh:message "The ship shall provide the web-frame ice load in kN."
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:minCount 1 ;
        sh:node gen:TorqueMegaNMValue ;
        sh:message "The ship shall provide the externally calculated maximum ice-load bending moment in MN m."
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:minCount 1 ;
        sh:node gen:LengthMValue ;
        sh:message "The ship shall provide the web-frame span in m."
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:minCount 1 ;
        sh:node gen:AreaCentiM2Value ;
        sh:message "The ship shall provide the web-frame web area in cm2."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gen:StressMegaPAValue ;
        sh:message "The ship shall provide the yield strength in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:class nltl:tableReferenceValue ;
                sh:in ( nltl:traficomTable4Dash8 ) ;
                sh:message "The lookup case shall cite TRAFICOM Table 4-8."
            ] ;
            sh:property [
                sh:path nltl:webFrameTable4Dash8GammaFactor ;
                sh:minCount 1 ;
                sh:node gen:DimensionlessValue ;
                sh:message "The lookup case shall provide the gamma factor selected from Table 4-8."
            ] ;
            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:minCount 1 ;
                sh:class nltl:evidenceArtifact ;
                sh:message "The Table 4-8 selection shall have supporting evidence."
            ]
        ] ;
        sh:message "The ship shall provide a Table 4-8 lookup case for the externally performed calculation."
    ] .

gen:AreaCentiM2Value
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaM2Value
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusCentiM3Value
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

