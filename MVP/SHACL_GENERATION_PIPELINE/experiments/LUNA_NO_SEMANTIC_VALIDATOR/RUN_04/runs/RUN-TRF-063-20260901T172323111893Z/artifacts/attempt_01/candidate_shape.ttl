@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF063EnvelopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:strengtheningEnvelopeBoundary ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tankTop ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The strengthening envelope must identify exactly one tank top boundary."
    ] ;
    sh:property [
        sh:path nltl:strengtheningForwardExtent ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.5"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The forward strengthening extent must be at least 1.5 m."
    ] ;
    sh:property [
        sh:path nltl:strengtheningAftExtent ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.5"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The aft strengthening extent must be at least 1.5 m."
    ] .

gen:TRF063ApplicableEnvelopeBranch2
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:sidePropellerStrengtheningEnvelope ;
        sh:node gen:TRF063EnvelopeShape ;
        sh:minCount 1 ;
        sh:message "A twin-screw ship must provide a conforming side-propeller strengthening envelope."
    ] .

gen:TRF063ApplicableEnvelopeBranch3
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:sidePropellerStrengtheningEnvelope ;
        sh:node gen:TRF063EnvelopeShape ;
        sh:minCount 1 ;
        sh:message "A triple-screw ship must provide a conforming side-propeller strengthening envelope."
    ] .

gen:TRF063NonApplicableBranch
    a sh:NodeShape ;
    sh:sparql [
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerCount ?count .
                FILTER (?count = 2 || ?count = 3)
            }
        """ ;
        sh:message "This branch applies only when the ship does not have two or three propellers."
    ] .

gen:TRF063ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide one propeller count to determine applicability."
    ] ;
    sh:or (
        gen:TRF063ApplicableEnvelopeBranch2
        gen:TRF063ApplicableEnvelopeBranch3
        gen:TRF063NonApplicableBranch
    ) .
