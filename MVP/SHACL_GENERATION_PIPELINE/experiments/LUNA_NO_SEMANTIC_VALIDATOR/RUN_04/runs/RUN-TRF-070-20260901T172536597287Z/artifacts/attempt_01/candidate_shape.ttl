@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qdt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "Non-applicable ships must explicitly indicate that the thruster is not for main propulsion."
            ]
        ]
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "The main-propulsion applicability indicator must be true for this requirement."
            ] ;
            sh:property [
                sh:path nltl:thrusterType ;
                sh:datatype xsd:string ;
                sh:in ( "azimuthing" "fixed" ) ;
                sh:minCount 1 ;
                sh:message "An applicable thruster must be identified as azimuthing or fixed."
            ] ;
            sh:property [
                sh:path nltl:propellerIceInteractionLoad ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qdt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qdt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The applicable propeller/ice interaction load must be provided as a single kN quantity."
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyIceInteractionLoad ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qdt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qdt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The applicable thruster-body/ice interaction load must be provided as a single kN quantity."
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qdt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qdt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "The applicable local ice pressure must be provided as a single MPa quantity."
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:class nltl:designCondition ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:designConditionLocalStrengthCapacity ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qdt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qdt:unit ;
                                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:message "Each design condition must provide the externally assessed local-strength capacity as a single kN quantity."
                    ]
                ] ;
                sh:message "An applicable ship must provide at least one linked design condition with local-strength capacity."
            ] ;
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qdt: <http://qudt.org/schema/qudt/>

                    SELECT $this
                    WHERE {
                        $this nltl:hasDesignCondition ?condition .
                        $this nltl:localIcePressure ?pressure .
                        ?pressure qdt:numericValue ?pressureValue .
                        ?condition nltl:designConditionLocalStrengthCapacity ?capacity .
                        ?capacity qdt:numericValue ?capacityValue .
                        FILTER (?capacityValue < ?pressureValue)
                    }
                """ ;
                sh:message "The local strength capacity of every applicable design condition must be at least the local ice pressure."
            ]
        ]
    ) .
