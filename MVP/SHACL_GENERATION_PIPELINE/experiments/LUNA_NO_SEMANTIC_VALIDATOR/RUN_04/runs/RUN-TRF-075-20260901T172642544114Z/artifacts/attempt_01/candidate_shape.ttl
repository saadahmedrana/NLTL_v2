@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-075-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node <urn:nltl:generated-shape:TRF-075-LoadCaseShape>
    ] .

<urn:nltl:generated-shape:TRF-075-LoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseBlade ;
        sh:class nltl:propellerBlade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each propeller blade load case must link to exactly one propeller blade."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseIceBlock ;
        sh:class nltl:iceBlock ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each propeller blade load case must link to exactly one ice block."
    ] ;
    sh:xone (
        [
            sh:path nltl:backwardBladeForce ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:node [
                sh:class qudt:QuantityValue ;
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ;
                sh:property [
                    sh:path qudt:unit ;
                    sh:hasValue unit:KiloN ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ]
        ]
        [
            sh:path nltl:forwardBladeForce ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:node [
                sh:class qudt:QuantityValue ;
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ;
                sh:property [
                    sh:path qudt:unit ;
                    sh:hasValue unit:KiloN ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ]
        ]
    ) ;
    sh:message "Each propeller blade load case must have exactly one of backward blade force or forward blade force, with the force expressed in kilonewtons." .
