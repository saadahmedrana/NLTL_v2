@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LoadCase1Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1 ;
        sh:message "Load case 1 must be represented."
    ] .

gs:LoadCase2Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2 ;
        sh:message "Load case 2 must be represented."
    ] .

gs:LoadCase3Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3 ;
        sh:message "Load case 3 must be represented."
    ] .

gs:LoadCase4Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "Load case 4 must be represented."
    ] .

gs:LoadCase5Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5 ;
        sh:message "Load case 5 must be represented for a reversing FP propeller."
    ] .

gs:Cases1To4Shape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gs:LoadCase1Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 1 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gs:LoadCase2Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 2 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gs:LoadCase3Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 3 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gs:LoadCase4Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 4 must be covered."
    ] .

gs:CPPropellerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "CP" ;
        sh:message "The applicable propeller type must be CP."
    ] ;
    sh:node gs:Cases1To4Shape .

gs:FPNonReversingPropellerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP" ;
        sh:message "The applicable propeller type must be FP."
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The reversing-capability value must be recorded for an FP propeller."
    ] ;
    sh:node gs:Cases1To4Shape .

gs:FPReversingPropellerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "FP" ;
        sh:message "The applicable propeller type must be FP."
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The reversing-capability value must be recorded for an FP propeller."
    ] ;
    sh:node gs:Cases1To4Shape ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gs:LoadCase5Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 5 must be covered for a reversing FP propeller."
    ] .

gs:TRF076ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:CPPropellerShape
        gs:FPNonReversingPropellerShape
        gs:FPReversingPropellerShape
    ) .
