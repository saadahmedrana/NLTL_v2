@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-113-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall record the plastic bending design consideration for a blade."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall record the propeller blade orientation causing the maximum component load."
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "The ship shall provide evidence for the thruster blade-loss design."
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The load case shall confirm that blade loss was considered at the orientation producing the maximum component load."
            ]
        ] ;
        sh:message "The ship shall identify a load case confirming the maximum-load blade-loss condition."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:steeringMechanism
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall include a steering mechanism designed for the blade plastic-bending load condition."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterFitting
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall include the thruster fitting designed for the blade plastic-bending load condition."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:thrusterBody
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship shall include the thruster body designed for the blade plastic-bending load condition."
    ] .
