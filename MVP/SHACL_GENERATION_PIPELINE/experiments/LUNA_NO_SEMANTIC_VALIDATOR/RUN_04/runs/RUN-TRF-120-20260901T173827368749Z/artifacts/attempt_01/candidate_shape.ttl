@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-120-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented thruster natural-frequency estimation case must specify a longitudinal or transverse direction, and the corresponding thruster must provide damping, water added mass, ship attachment stiffness, and natural frequency values with their canonical units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                       nltl:hasComponent ?thruster .
                ?thruster a nltl:thrusterBody ;
                          nltl:hasNaturalFrequencyCalculationCase ?case .

                FILTER (
                    NOT EXISTS {
                        ?case nltl:vibrationDirection ?direction .
                        FILTER (
                            ?direction IN (
                                nltl:longitudinalDirection,
                                nltl:transverseDirection
                            )
                        )
                    }
                    ||
                    EXISTS {
                        ?case nltl:vibrationDirection ?invalidDirection .
                        FILTER (
                            ?invalidDirection NOT IN (
                                nltl:longitudinalDirection,
                                nltl:transverseDirection
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:damping ?damping .
                        FILTER (datatype(?damping) = xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        ?thruster nltl:waterAddedMass ?waterMass .
                        ?waterMass a qudt:QuantityValue ;
                                   qudt:numericValue ?waterMassValue ;
                                   qudt:unit unit:KiloGM .
                        FILTER (datatype(?waterMassValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?thruster nltl:shipAttachmentStiffness ?attachmentStiffness .
                        ?attachmentStiffness a qudt:QuantityValue ;
                                             qudt:numericValue ?attachmentValue ;
                                             qudt:unit unit:KiloN-PER-M .
                        FILTER (datatype(?attachmentValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?thruster nltl:thrusterNaturalFrequency ?naturalFrequency .
                        ?naturalFrequency a qudt:QuantityValue ;
                                           qudt:numericValue ?frequencyValue ;
                                           qudt:unit unit:HZ .
                        FILTER (datatype(?frequencyValue) = xsd:decimal)
                    }
                )
            }
        """ ;
    ] .
