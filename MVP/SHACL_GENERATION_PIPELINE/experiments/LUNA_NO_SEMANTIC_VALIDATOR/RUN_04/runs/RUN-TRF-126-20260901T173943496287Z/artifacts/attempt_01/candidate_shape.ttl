@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF126ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionEngineReversedForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The propulsion engine astern-reversal applicability state must be provided."
    ] ;
    sh:or (
        gen:TRF126ReversedAsternBranch
        gen:TRF126NotReversedAsternBranch
    ) .

gen:TRF126ReversedAsternBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:propulsionEngineReversedForAstern ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:airReceiverConsecutiveStartCapacity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 12 ;
        sh:minCount 1 ;
        sh:message "When the propulsion engine must be reversed for astern movement, the air receiver capacity must provide at least 12 consecutive starts."
    ] .

gen:TRF126NotReversedAsternBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:propulsionEngineReversedForAstern ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:airReceiverConsecutiveStartCapacity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 6 ;
        sh:minCount 1 ;
        sh:message "When the propulsion engine does not have to be reversed for astern movement, the air receiver capacity must provide at least 6 consecutive starts."
    ] .
