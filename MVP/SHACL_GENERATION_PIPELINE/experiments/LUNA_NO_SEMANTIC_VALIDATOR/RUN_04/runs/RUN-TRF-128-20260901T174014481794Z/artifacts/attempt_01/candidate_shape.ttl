@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF128Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must specify one ice class."
    ] ;
    sh:property [
        sh:path nltl:propulsionEngineReversalRequiredForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must specify whether propulsion engine reversal is required for astern."
    ] ;
    sh:property [
        sh:path nltl:compressorChargeTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:HR ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The compressor charge time must be provided as one quantity in hours."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:propulsionEngineReversalRequiredForAstern ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:compressorChargeTime ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0"^^xsd:decimal ;
                        sh:maxInclusive "0.5"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:propulsionEngineReversalRequiredForAstern ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:not [
                            sh:hasValue nltl:iceClassIaSuper
                        ]
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:compressorChargeTime ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "0"^^xsd:decimal ;
                        sh:maxInclusive "1"^^xsd:decimal
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "The compressor charge time must be at most 0.5 hours for an IA Super ship requiring propulsion-engine reversal for astern, and at most 1 hour otherwise." .
