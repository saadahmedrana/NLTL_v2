@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-131> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:ballastWaterCoolingArrangement ;
        sh:datatype xsd:string ;
        sh:message "A ballast water cooling arrangement, when recorded, must be a string."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ballast water cooling arrangement may be recorded as a reserve, but it must not be accepted as a substitute for an inlet chest." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ballastWaterCoolingArrangement ?arrangement .
                FILTER NOT EXISTS {
                    $this nltl:substituteArrangementStatus ?status .
                    FILTER ( ?status = false )
                }
            }
        """
    ] .
