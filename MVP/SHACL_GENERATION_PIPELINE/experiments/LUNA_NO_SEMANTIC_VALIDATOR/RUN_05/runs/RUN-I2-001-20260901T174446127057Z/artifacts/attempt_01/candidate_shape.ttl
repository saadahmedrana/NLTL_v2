@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide one construction contract date to determine whether UR I2 Rev.4 applies."
    ] ;
    sh:sparql [
        sh:message "The construction contract date determines UR I2 Rev.4 applicability: the revision applies on or after 2021-01-01." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (DATATYPE(?contractDate) = xsd:date)
                FILTER (
                    YEAR(?contractDate) > 2021
                    ||
                    (YEAR(?contractDate) = 2021 && MONTH(?contractDate) > 1)
                    ||
                    (YEAR(?contractDate) = 2021 && MONTH(?contractDate) = 1 && DAY(?contractDate) >= 1)
                    ||
                    YEAR(?contractDate) < 2021
                    ||
                    (YEAR(?contractDate) = 2021 && MONTH(?contractDate) < 1)
                    ||
                    (YEAR(?contractDate) = 2021 && MONTH(?contractDate) = 1 && DAY(?contractDate) < 1)
                )
            }
        """
    ] .
