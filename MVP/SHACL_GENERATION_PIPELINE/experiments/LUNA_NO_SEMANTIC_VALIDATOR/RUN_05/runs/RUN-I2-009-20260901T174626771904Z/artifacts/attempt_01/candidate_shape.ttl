@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A hull area representation is required."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gs:I2_009_PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Average ice pressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node gs:I2_009_AngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The buttock angle is required in degrees."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node gs:I2_009_AspectRatioShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load patch aspect ratio must be exactly 3.6."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node gs:I2_009_LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow load patch height is required in metres."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node gs:I2_009_LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow load patch length is required in metres."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node gs:I2_009_AngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The normal frame angle is required in degrees."
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bow-form applicability must be recorded as a boolean."
    ] ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:class nltl:hullAreaAssignment ;
        sh:minCount 1 ;
        sh:message "A hull area assignment is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Bow-form applicability must agree with the buttock-angle and normal-frame-angle conditions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowFormApplicability ?app .
                $this nltl:buttockAngle ?buttockNode .
                ?buttockNode qudt:numericValue ?buttock .
                $this nltl:normalFrameAngle ?frameNode .
                ?frameNode qudt:numericValue ?frame .
                FILTER (
                    (?app = true &&
                     !(?buttock > 0 && ?buttock < 80 && ?frame > 10))
                    ||
                    (?app = false &&
                     (?buttock > 0 && ?buttock < 80 && ?frame > 10))
                )
            }
        """
    ] .

gs:I2_009_HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:in (
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
            nltl:otherIceStrengthenedArea
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assigned hull area must be one of the permitted ice-strengthened areas."
    ] .

gs:I2_009_PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_009_AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_009_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_009_AspectRatioShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
