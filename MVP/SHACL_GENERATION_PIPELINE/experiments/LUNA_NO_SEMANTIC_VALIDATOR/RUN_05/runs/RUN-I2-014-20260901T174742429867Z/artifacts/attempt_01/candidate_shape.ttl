@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionMidLengthPositionShape a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionAspectRatioShape a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculatedForceShape a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculatedLineLoadShape a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculatedPressureShape a sh:NodeShape ;
    sh:node gen:QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculationCaseShape a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gen:BowSubregionMidLengthPositionShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report one midpoint position in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:node gen:BowSubregionAspectRatioShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report one load-patch aspect ratio."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:node gen:BowSubregionCalculatedForceShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report one calculated force."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:node gen:BowSubregionCalculatedLineLoadShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report one calculated line load."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:node gen:BowSubregionCalculatedPressureShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow subregion calculation case must report one calculated pressure."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each bow subregion calculation case must have calculation evidence."
    ] .

gen:ShipBowSubregionCalculationShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must be divided into four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gen:BowSubregionCalculationCaseShape ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:message "Exactly four bow subregion calculation cases are required."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:node gen:BowSubregionCalculatedForceShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The selected maximum bow force must be reported."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:node gen:BowSubregionCalculatedLineLoadShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The selected maximum bow line load must be reported."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:node gen:BowSubregionCalculatedPressureShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The selected maximum bow pressure must be reported."
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowForce must equal the maximum calculated force among the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForce .
                ?selectedForce qudt:numericValue ?sf .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?force .
                        ?force qudt:numericValue ?f .
                        FILTER (?f > ?sf)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalCase .
                        ?equalCase nltl:bowSubregionCalculatedForce ?equalForce .
                        ?equalForce qudt:numericValue ?ef .
                        FILTER (?ef = ?sf)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must equal the maximum calculated line load among the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedLineLoad .
                ?selectedLineLoad qudt:numericValue ?sql .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedLineLoad ?lineLoad .
                        ?lineLoad qudt:numericValue ?ql .
                        FILTER (?ql > ?sql)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalCase .
                        ?equalCase nltl:bowSubregionCalculatedLineLoad ?equalLineLoad .
                        ?equalLineLoad qudt:numericValue ?eql .
                        FILTER (?eql = ?sql)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "selectedMaximumBowPressure must equal the maximum calculated pressure among the four bow subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedPressure .
                ?selectedPressure qudt:numericValue ?sp .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedPressure ?pressure .
                        ?pressure qudt:numericValue ?p .
                        FILTER (?p > ?sp)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalCase .
                        ?equalCase nltl:bowSubregionCalculatedPressure ?equalPressure .
                        ?equalPressure qudt:numericValue ?ep .
                        FILTER (?ep = ?sp)
                    }
                )
            }
        """
    ] .
