@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-018> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatch
        ] ;
        sh:message "The ship must identify its design ice load patch."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceForce ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasPeakPressureFactorLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:peakPressureFactorLookupCase ;
            sh:property [
                sh:path nltl:localizedStructuralMemberCategory ;
                sh:minCount 1 ;
                sh:node [
                    sh:in (
                        nltl:bottomStructureFrameCategory
                        nltl:longitudinallyFramedPlatingCategory
                        nltl:stringerSideLongitudinalOrWebFrameCategory
                        nltl:transverseFrameWithLoadDistributingStringersCategory
                        nltl:transverseFrameWithoutLoadDistributingStringersCategory
                        nltl:transverselyFramedPlatingCategory
                    )
                ]
            ] ;
            sh:property [
                sh:path nltl:selectedPeakPressureFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ] ;
        sh:message "A peak-pressure-factor lookup case with a permitted localized structural-member category is required."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:minCount 1 ;
                sh:node [
                    sh:in ( nltl:iacsUrI2Table3 )
                ]
            ] ;
            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ]
            ]
        ] ;
        sh:message "The cited IACS UR I2 Table 3 reference and lookup-selection evidence are required."
    ] ;
    sh:sparql [
        sh:message "averageIcePressure must equal iceForce divided by loadPatchHeight and loadPatchLength, after converting kN to MN, within a relative tolerance of 1e-6 plus an absolute fallback of 1e-6 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:averageIcePressure ?avgQ ;
                       nltl:iceForce ?forceQ ;
                       nltl:loadPatchHeight ?heightQ ;
                       nltl:loadPatchLength ?lengthQ .
                ?avgQ qudt:numericValue ?avg .
                ?forceQ qudt:numericValue ?force .
                ?heightQ qudt:numericValue ?height .
                ?lengthQ qudt:numericValue ?length .
                BIND (?force / (1000 * ?height * ?length) AS ?expected)
                FILTER (ABS(?avg - ?expected) >
                        ((1e-6 * ABS(?expected)) + 1e-6))
            }
        """
    ] ;
    sh:sparql [
        sh:message "The ship peakPressureFactor must equal the selected peak pressure factor from its Table 3 lookup case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:peakPressureFactor ?shipFactorQ ;
                       nltl:hasPeakPressureFactorLookupCase ?case .
                ?shipFactorQ qudt:numericValue ?shipFactor .
                ?case nltl:selectedPeakPressureFactor ?selectedFactorQ .
                ?selectedFactorQ qudt:numericValue ?selectedFactor .
                FILTER (?shipFactor != ?selectedFactor)
            }
        """
    ] .
