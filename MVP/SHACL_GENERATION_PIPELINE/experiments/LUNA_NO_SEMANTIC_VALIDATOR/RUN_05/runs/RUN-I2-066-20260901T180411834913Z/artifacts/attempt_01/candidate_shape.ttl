@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_066_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node gen:I2_066_WeldShape
    ] .

gen:I2_066_WeldShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each linked weld must state whether it is within an ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:weldType ;
                sh:minCount 1 ;
                sh:hasValue nltl:doubleContinuousWeld ;
                sh:in ( nltl:doubleContinuousWeld )
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "A weld within an ice-strengthened area must be of the double continuous type." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:weldType nltl:doubleContinuousWeld .
                    }
                    ||
                    EXISTS {
                        $this nltl:weldType ?type .
                        FILTER (?type != nltl:doubleContinuousWeld)
                    }
                )
            }
        """
    ] .
