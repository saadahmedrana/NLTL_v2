@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-004> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:winterGrowthCount ;
        sh:datatype xsd:integer ;
        sh:message "Winter growth count must be an integer when provided."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Ice thickness must be a metre-valued QUDT quantity with a decimal numeric value."
    ] ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:maxCount 1 ;
        sh:message "Ice type classification must have at most one value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the ice is sea ice with no more than one winter growth and thickness from 0.3 m through 2.0 m, its classification must be first-year ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growthCount ;
                       nltl:iceThickness ?thicknessNode .

                ?thicknessNode qudt:numericValue ?thickness ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (datatype(?growthCount) = xsd:integer)
                FILTER (datatype(?thickness) = xsd:decimal)
                FILTER (?growthCount <= 1)
                FILTER (?thickness >= 0.3)
                FILTER (?thickness <= 2.0)

                FILTER NOT EXISTS {
                    $this nltl:iceTypeClassification nltl:firstYearIce
                }
            }
        """
    ] .
