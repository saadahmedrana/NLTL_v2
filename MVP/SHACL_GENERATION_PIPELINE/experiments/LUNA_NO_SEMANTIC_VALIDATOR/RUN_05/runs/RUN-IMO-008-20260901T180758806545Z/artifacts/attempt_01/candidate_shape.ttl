@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_008_ThinFirstYearIceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A ship must provide an ice type classification to determine whether the thin first-year ice thickness rule applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For thin first-year ice, ice thickness must be a decimal quantity in metres from 0.3 m through 0.7 m, inclusive." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceTypeClassification nltl:thinFirstYearIce .
                FILTER NOT EXISTS {
                    $this nltl:iceThickness ?quantity .
                    ?quantity a qudt:QuantityValue ;
                              qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value >= 0.3 &&
                        ?value <= 0.7
                    )
                }
            }
        """
    ] .
