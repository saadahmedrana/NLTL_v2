@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:node [
                    sh:class nltl:loadingConditionCase ;
                    sh:property [
                        sh:path nltl:loadingConditionIdentifier ;
                        sh:datatype xsd:string ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:alternativeInstrumentApplicable ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:residualStabilityFactorSI ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "1"^^xsd:decimal ;
                                sh:maxInclusive "1"^^xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue qudt:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ] ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:hasLoadingConditionResultEvidence ;
                        sh:class nltl:evidenceArtifact ;
                        sh:minCount 1
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:alternativeInstrumentApplicable ;
                                sh:hasValue false ;
                                sh:minCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:alternativeInstrumentApplicable ;
                                sh:hasValue true ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true ;
                                sh:minCount 1
                            ]
                        ]
                    )
                ]
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:hasValue nltl:polarShipCategoryC ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB ) ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:maxExclusive "2017-01-01"^^xsd:date ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For applicable Category A or B ships constructed on or after 2017-01-01, each linked loading condition must provide a compliant residual-stability outcome or the permitted alternative-instrument outcome." .
