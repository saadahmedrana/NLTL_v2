@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ice accretion applicability value must be true or false."
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:node gen:IMO_040_RelevantHatchOrDoorShape ;
                sh:message "Every relevant hatch or door must have associated ice or snow removal or prevention means when ice accretion is likely."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The ice accretion applicability value must be true or false."
            ]
        ]
    ) .

gen:IMO_040_RelevantHatchOrDoorShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "The relevant hatch or door must have associated ice or snow removal or prevention means."
    ] .
