@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-048> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each ship with exposed machinery or foundation material must record an approved material status, an authorized approving authority and approval standard, and a polar service temperature in degrees Celsius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:exposedMachineryOrFoundationMaterial ?material .
                FILTER (
                    datatype(?material) != xsd:string
                    || NOT EXISTS {
                        $this nltl:approvalStandard ?standard .
                        FILTER (
                            datatype(?standard) = xsd:string
                            && ?standard IN (
                                "standard acceptable to the Organization"^^xsd:string,
                                "another standard offering an equivalent level of safety"^^xsd:string
                            )
                        )
                    }
                    || NOT EXISTS {
                        $this nltl:approvingAuthority ?authority .
                        FILTER (
                            datatype(?authority) = xsd:string
                            && ?authority IN (
                                "Administration"^^xsd:string,
                                "recognized organization accepted by the Administration"^^xsd:string
                            )
                        )
                    }
                    || NOT EXISTS {
                        $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                    }
                    || NOT EXISTS {
                        $this nltl:polarServiceTemperature ?temperature .
                        ?temperature a qudt:QuantityValue ;
                            qudt:numericValue ?value ;
                            qudt:unit unit:DEG_C .
                        FILTER (datatype(?value) = xsd:decimal)
                    }
                )
            }
        """
    ] .
