@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-051-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLocalControlItem ;
        sh:node <urn:nltl:generated-shape:IMO-051-LocalControlItemShape>
    ] .

<urn:nltl:generated-shape:IMO-051-LocalControlItemShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:localControlProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each local control item must have freezing, snow, and ice protection."
    ] ;
    sh:property [
        sh:path nltl:localControlContinuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each local control item must remain continuously accessible."
    ] .
