@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO058ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedFireMainSection ;
        sh:node gen:IMO058ExposedFireMainSectionShape
    ] .

gen:IMO058ExposedFireMainSectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fireMainSectionIsolationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each exposed fire-main section must have isolation capability."
    ] ;
    sh:property [
        sh:path nltl:fireMainSectionDrainageMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each exposed fire-main section must have means of drainage."
    ] .
