@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_070_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Passenger ships shall provide each person on board with one compatible immersion suit or thermal protective aid." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this a nltl:passengerShip .
    FILTER (
        NOT EXISTS {
            $this nltl:sizeCompatibilityStatus ?compatibility .
            FILTER (
                DATATYPE(?compatibility) = xsd:boolean &&
                ?compatibility = true
            )
        }
        ||
        EXISTS {
            $this nltl:hasPersonOnBoardMember ?person .
            FILTER NOT EXISTS {
                ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                ?equipment a ?equipmentType .
                FILTER (
                    ?equipmentType IN (
                        nltl:immersionSuitEquipment,
                        nltl:thermalProtectiveAidEquipment
                    )
                )
            }
        }
    )
}
""" ;
    ] .
