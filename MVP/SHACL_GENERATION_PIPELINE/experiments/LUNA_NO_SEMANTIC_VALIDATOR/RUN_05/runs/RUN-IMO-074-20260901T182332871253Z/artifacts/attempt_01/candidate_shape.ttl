@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_074_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:groupSurvivalEquipmentCarried ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                sh:class nltl:evidenceState ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved
            ]
        ]
    ) ;
    sh:message "When abandonment onto ice or land potential is true, group survival equipment must be carried or approved equivalent functionality must be provided." .
