@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-085> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship category must be recorded as Category A, B, or C."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The construction date must be recorded as an xsd:date."
    ] ;
    sh:or (
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:hasValue nltl:polarShipCategoryC
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:maxInclusive "2016-12-31"^^xsd:date
                    ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB )
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bridgeWingsEnclosed ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bridgeWingProtectionDesignStatus ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:IMO-085-applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB )
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:minInclusive "2017-01-01"^^xsd:date
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bridgeWingsEnclosed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:bridgeWingProtectionDesignStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-085-nonapplicable> a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:maxInclusive "2016-12-31"^^xsd:date
            ]
        ]
    ) .
