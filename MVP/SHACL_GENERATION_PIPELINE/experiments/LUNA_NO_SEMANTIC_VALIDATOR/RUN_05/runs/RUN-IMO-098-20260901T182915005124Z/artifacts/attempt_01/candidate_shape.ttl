@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_098_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The ship must explicitly indicate that it does not operate in low air temperature."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ship must explicitly indicate that it operates in low air temperature."
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:node gen:IMO_098_OtherSurvivalCraftShape
            ]
        ]
    ) ;
    sh:message "The applicability state must be explicitly recorded, and when applicable every other survival craft must carry both required communication devices." .

gen:IMO_098_OtherSurvivalCraftShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:class nltl:locationSignalDevice ;
        sh:message "Each other survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:hasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:message "Each other survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
