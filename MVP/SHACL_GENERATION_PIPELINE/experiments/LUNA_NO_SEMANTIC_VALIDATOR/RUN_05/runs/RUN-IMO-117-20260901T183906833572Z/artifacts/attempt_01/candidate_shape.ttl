@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:class nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A discharge distance record must include the distance to the nearest land ice shelf or fast ice in nautical miles."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A discharge distance record must include the distance to the area with ice concentration greater than one tenth in nautical miles."
    ] .

gen:IMO117ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sewageTreatmentPlantApprovalStatus ;
                sh:class nltl:evidenceState ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "An applicable sewage treatment plant must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
                sh:class nltl:evidenceState ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status evidence is required."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Discharge must comply with MARPOL Annex IV regulation 11.1.2."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:class nltl:dischargeDistanceRecords ;
                sh:minCount 1 ;
                sh:node gen:IMO117DischargeDistanceRecordShape ;
                sh:message "An applicable discharge must have a discharge distance record."
            ]
        ]
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
