@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-002> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single ship type is required to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a fishing vessel of at least 24 m, a pleasure yacht of at least 300 gross tonnage not engaged in trade, or a cargo ship of at least 300 and below 500 gross tonnage, Chapter 9-1 applicability must be recorded as true and all branch inputs must conform." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this nltl:shipType "fishing_vessel"^^xsd:string .
                    {
                        FILTER NOT EXISTS {
                            $this nltl:lengthOverall ?lengthNode .
                            ?lengthNode qudt:numericValue ?lengthValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (datatype(?lengthValue) = xsd:decimal &&
                                    ?lengthValue >= 24)
                        }
                    }
                    UNION
                    {
                        FILTER NOT EXISTS {
                            $this nltl:polarCodeChapter9Dash1Applicable true .
                        }
                    }
                }
                UNION
                {
                    $this nltl:shipType "pleasure_yacht"^^xsd:string .
                    {
                        FILTER NOT EXISTS {
                            $this nltl:grossTonnage ?tonnageNode .
                            ?tonnageNode qudt:numericValue ?tonnageValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                            FILTER (datatype(?tonnageValue) = xsd:decimal &&
                                    ?tonnageValue >= 300)
                        }
                    }
                    UNION
                    {
                        FILTER NOT EXISTS {
                            $this nltl:engagedInTrade false .
                        }
                    }
                    UNION
                    {
                        FILTER NOT EXISTS {
                            $this nltl:polarCodeChapter9Dash1Applicable true .
                        }
                    }
                }
                UNION
                {
                    $this nltl:shipType "cargo_ship"^^xsd:string .
                    {
                        FILTER NOT EXISTS {
                            $this nltl:grossTonnage ?tonnageNode .
                            ?tonnageNode qudt:numericValue ?tonnageValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                            FILTER (datatype(?tonnageValue) = xsd:decimal &&
                                    ?tonnageValue >= 300 &&
                                    ?tonnageValue < 500)
                        }
                    }
                    UNION
                    {
                        FILTER NOT EXISTS {
                            $this nltl:polarCodeChapter9Dash1Applicable true .
                        }
                    }
                }
            }
        """
    ] .
