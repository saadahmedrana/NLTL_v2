@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must record whether it operates in polar waters."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:lengthOverall ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:engagedInTrade ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Chapter 11-1 applicability must be recorded for a ship operating in polar waters."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 11-1 applicability does not match the ship type, length, gross tonnage, and trade-status criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters true ;
                      nltl:shipType ?shipType ;
                      nltl:lengthOverall ?lengthValue ;
                      nltl:grossTonnage ?tonnageValue ;
                      nltl:engagedInTrade ?engaged ;
                      nltl:polarCodeChapter11Dash1Applicable ?applicable .
                ?lengthValue qudt:numericValue ?length ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                ?tonnageValue qudt:numericValue ?tonnage ;
                               qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (
                    (
                        (
                            ?shipType = "fishing_vessel" &&
                            ?length >= 24
                        ) ||
                        (
                            ?shipType = "pleasure_yacht" &&
                            ?tonnage >= 300 &&
                            ?engaged = false
                        ) ||
                        (
                            ?shipType = "cargo_ship" &&
                            ?tonnage >= 300 &&
                            ?tonnage < 500
                        )
                    ) && ?applicable != true
                    ||
                    (
                        !(
                            (
                                ?shipType = "fishing_vessel" &&
                                ?length >= 24
                            ) ||
                            (
                                ?shipType = "pleasure_yacht" &&
                                ?tonnage >= 300 &&
                                ?engaged = false
                            ) ||
                            (
                                ?shipType = "cargo_ship" &&
                                ?tonnage >= 300 &&
                                ?tonnage < 500
                            )
                        ) && ?applicable != false
                    )
                )
            }
        """
    ] .
