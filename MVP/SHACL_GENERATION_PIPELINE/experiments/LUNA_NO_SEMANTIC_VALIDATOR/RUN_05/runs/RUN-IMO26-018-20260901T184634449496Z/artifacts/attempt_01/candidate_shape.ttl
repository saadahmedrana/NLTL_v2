@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_018_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanningTopicCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "When Polar Code chapter 11-1 is applicable, voyage planning coverage of all clause 11-1.3 topics must be recorded as true." ;
    sh:or (
        [
            sh:property [
                sh:path nltl:safetyManagementSystemImplemented ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:safetyManagementSystemImplemented ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:documentedPolarOperationProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "If the safety management system is not implemented, a documented polar operation procedure must be recorded as present." .
