@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-002-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have one construction contract date to determine the applicable Ice Class Regulations."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2019-01-01"^^xsd:date ;
                sh:maxExclusive "2021-07-05"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRegulationEdition2017 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ships contracted from 1 January 2019 through 4 July 2021 must identify the 2017 Ice Class Regulations as the applicable edition."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2021-07-05"^^xsd:date
            ]
        ]
    ) .
