@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine whether the 2010 Ice Class Regulations apply."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRegulationEdition2010 ;
                sh:minCount 1 ;
                sh:message "Ships contracted during the specified period must identify the 2010 Ice Class Regulations as applicable."
            ] ;
            sh:sparql [
                sh:message "The construction contract date is not within the applicability period for the 2010 Ice Class Regulations." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:constructionContractDate ?date .
                            FILTER (
                                ?date >= "2012-01-01"^^xsd:date &&
                                ?date < "2019-01-01"^^xsd:date
                            )
                        }
                    }
                """
            ]
        ]
        [
            sh:sparql [
                sh:message "The 2010 Ice Class Regulations must be identified as applicable for ships contracted from 1 January 2012 up to, but not including, 1 January 2019." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionContractDate ?date .
                        FILTER (
                            ?date >= "2012-01-01"^^xsd:date &&
                            ?date < "2019-01-01"^^xsd:date
                        )
                    }
                """
            ]
        ]
    ) .
