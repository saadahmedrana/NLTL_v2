@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-004> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine applicability of the 2008 Ice Class Regulations."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ships contracted on or after 1 January 2010 and before 1 January 2012, the applicable Ice Class regulation edition must be 2008." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (
                    ?contractDate >= "2010-01-01"^^xsd:date &&
                    ?contractDate < "2012-01-01"^^xsd:date
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                            nltl:iceClassRegulationEdition2008 .
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?edition .
                        FILTER (?edition != nltl:iceClassRegulationEdition2008)
                    }
                )
            }
        """
    ] .
