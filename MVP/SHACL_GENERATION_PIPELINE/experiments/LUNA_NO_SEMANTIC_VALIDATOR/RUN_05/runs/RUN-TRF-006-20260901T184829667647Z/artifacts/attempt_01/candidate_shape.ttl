@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF006BeforeCohortShape
        gen:TRF006AfterCohortShape
        gen:TRF006Requested2008Shape
        gen:TRF006NotRequested2008Shape
    ) .

gen:TRF006BeforeCohortShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "1986-11-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction-stage date before 1 November 1986 is required to establish non-applicability of this cohort rule."
    ] .

gen:TRF006AfterCohortShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2003-09-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction-stage date on or after 1 September 2003 is required to establish non-applicability of this cohort rule."
    ] .

gen:TRF006Requested2008Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "1986-11-01"^^xsd:date ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "The construction-stage date must identify the 1 November 1986 through 31 August 2003 cohort."
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "The owner request must be explicitly true when the 2008 engine-output requirements are applied."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRuleEdition1985 ) ;
        sh:minCount 1 ;
        sh:message "Ships in this construction-stage cohort must identify the 1985 Ice Class Rules as the applicable regulation edition."
    ] ;
    sh:property [
        sh:path nltl:engineOutputRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRegulationEdition2008 ) ;
        sh:minCount 1 ;
        sh:message "When the owner requests the alternative engine-output requirements, the engine-output regulation edition must be the 2008 edition."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An ice class is required for a ship in the applicable construction-stage cohort."
    ] .

gen:TRF006NotRequested2008Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "1986-11-01"^^xsd:date ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "The construction-stage date must identify the 1 November 1986 through 31 August 2003 cohort."
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:in ( false ) ;
        sh:minCount 1 ;
        sh:message "The owner-request selector must be explicitly false when the 2008 engine-output requirements are not applied."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRuleEdition1985 ) ;
        sh:minCount 1 ;
        sh:message "Ships in this construction-stage cohort must identify the 1985 Ice Class Rules as the applicable regulation edition."
    ] ;
    sh:property [
        sh:path nltl:engineOutputRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:iceClassRuleEdition1985 ) ;
        sh:minCount 1 ;
        sh:message "Without an owner request for the alternative requirements, the engine-output regulation edition must remain the 1985 edition."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An ice class is required for a ship in the applicable construction-stage cohort."
    ] .
