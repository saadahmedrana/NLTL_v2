@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF012ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:node gs:TRF012IceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "The ship must represent each intended ice-operating waterline with profile points and coordinates."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:node gs:TRF012IceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "The externally determined lower ice waterline must be represented with profile points and coordinates."
    ] .

gs:TRF012IceWaterlineShape
    a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:node gs:TRF012WaterlineProfilePointShape ;
        sh:minCount 1 ;
        sh:message "Each represented ice waterline must have at least one waterline profile point."
    ] .

gs:TRF012WaterlineProfilePointShape
    a sh:NodeShape ;
    sh:class nltl:waterlineProfilePoint ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:node gs:TRF012LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each waterline profile point must have one longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:node gs:TRF012LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each waterline profile point must have one vertical coordinate in metres."
    ] .

gs:TRF012LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
