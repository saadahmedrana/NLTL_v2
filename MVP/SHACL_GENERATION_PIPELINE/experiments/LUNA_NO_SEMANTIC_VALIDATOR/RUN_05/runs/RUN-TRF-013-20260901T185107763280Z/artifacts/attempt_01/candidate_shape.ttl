@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF013Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF013ApplicableShape
        gen:TRF013NotApplicableShape
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the ship is ice-strengthened, each operating draught must be between its corresponding minimum and maximum ice-class draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipIceStrengthened true ;
                    nltl:operatingForeDraught ?of ;
                    nltl:operatingAftDraught ?oa ;
                    nltl:maximumIceClassDraughtFore ?maxf ;
                    nltl:maximumIceClassDraughtAft ?maxa ;
                    nltl:minimumIceClassDraughtFore ?minf ;
                    nltl:minimumIceClassDraughtAft ?mina .
                ?of qudt:numericValue ?ofv .
                ?oa qudt:numericValue ?oav .
                ?maxf qudt:numericValue ?maxfv .
                ?maxa qudt:numericValue ?maxav .
                ?minf qudt:numericValue ?minfv .
                ?mina qudt:numericValue ?minav .
                FILTER (
                    ?ofv < ?minfv ||
                    ?ofv > ?maxfv ||
                    ?oav < ?minav ||
                    ?oav > ?maxav
                )
            }
        """
    ] .

gen:TRF013ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingForeDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF013LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:operatingAftDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF013LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF013LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF013LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF013LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF013LengthQuantityShape
    ] .

gen:TRF013NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:TRF013LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
