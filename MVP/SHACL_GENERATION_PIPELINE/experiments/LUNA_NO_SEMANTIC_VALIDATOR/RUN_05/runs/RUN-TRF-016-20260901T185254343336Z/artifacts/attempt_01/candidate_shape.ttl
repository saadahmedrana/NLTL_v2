@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF016ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:node gen:TRF016LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:node gen:TRF016LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:node gen:TRF016LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:displacementAtUpperIceWaterline ;
                sh:node gen:TRF016MassQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:forwardDraught ;
                sh:node gen:TRF016LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:propellerHighestPointSubmerged ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasBallastTank ;
                sh:class nltl:ballastTank ;
                sh:node gen:TRF016BallastTankShape
            ] ;
            sh:sparql [
                sh:message "For navigation in ice, draught amidships must be at least the LIWL draught, and forward draught must be at least the applicable level-ice-thickness threshold." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?amidshipsNode ;
                              nltl:liwlDraughtAmidships ?liwlNode ;
                              nltl:forwardDraught ?forwardNode ;
                              nltl:levelIceThickness ?thicknessNode ;
                              nltl:displacementAtUpperIceWaterline ?selectedDisplacementNode ;
                              nltl:hasUpperIceWaterline ?upperWaterline .
                        ?amidshipsNode qudt:numericValue ?amidships .
                        ?liwlNode qudt:numericValue ?liwl .
                        ?forwardNode qudt:numericValue ?forward .
                        ?thicknessNode qudt:numericValue ?thickness .
                        ?selectedDisplacementNode qudt:numericValue ?selectedDisplacement .
                        ?upperWaterline nltl:waterlineDisplacement ?waterlineDisplacementNode .
                        ?waterlineDisplacementNode qudt:numericValue ?waterlineDisplacement .
                        FILTER (
                            ?amidships < ?liwl ||
                            ?forward < (
                                IF(
                                    ((2 + (0.00025 * ?selectedDisplacement)) * ?thickness)
                                    <
                                    (4 * ?thickness),
                                    ((2 + (0.00025 * ?selectedDisplacement)) * ?thickness),
                                    (4 * ?thickness)
                                )
                            ) ||
                            ?selectedDisplacement != ?waterlineDisplacement
                        )
                        FILTER NOT EXISTS {
                            $this nltl:hasUpperIceWaterline ?otherUpperWaterline .
                            ?otherUpperWaterline nltl:waterlineDisplacement ?otherDisplacementNode .
                            ?otherDisplacementNode qudt:numericValue ?otherDisplacement .
                            FILTER (?otherDisplacement > ?waterlineDisplacement)
                        }
                    }
                """ ;
            ]
        ]
    ) .

gen:TRF016LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:TRF016MassQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/TON_Metric>
    ] .

gen:TRF016BallastTankShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:situatedAboveLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:usedToReachLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:freezingPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A ballast tank situated above the LIWL and needed to reach the LIWL must have freezing prevention." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:situatedAboveLowerIceWaterline true ;
                      nltl:usedToReachLowerIceWaterline true .
                FILTER NOT EXISTS {
                    $this nltl:freezingPreventionPresent true
                }
            }
        """ ;
    ] .
