@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:RegulatedIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:hasValue nltl:iceClassRuleEdition1985 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable ice-class regulation edition must be the 1985 rules."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The retained ice class must be IB or IC."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:node gen:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum continuous rating power is required in kW."
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:node gen:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Required power under the 1985 rules is required in kW."
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:maximumContinuousRatingPower ?mcrNode .
    ?mcrNode qudt:numericValue ?mcr .
    $this nltl:requiredPowerUnder1985Rules ?requiredNode .
    ?requiredNode qudt:numericValue ?required .
    FILTER (?mcr < ?required)
}
"""
    ] .

gen:ExemptNon1985IceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:in (
            nltl:iceClassRegulationEdition2002
            nltl:iceClassRegulationEdition2008
            nltl:iceClassRegulationEdition2010
            nltl:iceClassRegulationEdition2017
            nltl:iceClassRegulationEdition2021
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:Exempt1985OtherIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue ;
        sh:hasValue nltl:iceClassRuleEdition1985 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF023ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:RegulatedIceClassShape
        gen:ExemptNon1985IceClassShape
        gen:Exempt1985OtherIceClassShape
    ) ;
    sh:message "The ship must provide an applicable regulation edition and ice class; IB or IC ships governed by the 1985 rules must satisfy the required minimum engine output." .
