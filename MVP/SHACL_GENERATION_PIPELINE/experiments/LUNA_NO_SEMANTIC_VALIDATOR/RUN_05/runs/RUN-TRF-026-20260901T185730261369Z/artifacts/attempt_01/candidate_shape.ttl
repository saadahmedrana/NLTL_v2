@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF026ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship shall have exactly one permitted ice class."
    ] ;
    sh:or (
        gen:TRF026IaSuperBulbTrueShape
        gen:TRF026IaSuperBulbFalseShape
        gen:TRF026OtherIceClassShape
    ) .

gen:TRF026IaSuperBulbTrueShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An IA Super ship applicable to the formula checks shall identify that a bulbous bow is present."
    ] ;
    sh:property gen:TRF026F1PropertyShape ;
    sh:property gen:TRF026F2PropertyShape ;
    sh:property gen:TRF026F3PropertyShape ;
    sh:property gen:TRF026F4PropertyShape ;
    sh:property gen:TRF026G1PropertyShape ;
    sh:property gen:TRF026G2PropertyShape ;
    sh:property gen:TRF026G3PropertyShape ;
    sh:property gen:TRF026BreadthPropertyShape ;
    sh:property gen:TRF026LengthPropertyShape ;
    sh:property gen:TRF026DraughtPropertyShape ;
    sh:property gen:TRF026C1PropertyShape ;
    sh:property gen:TRF026C2PropertyShape .

gen:TRF026IaSuperBulbFalseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "An IA Super ship without a bulbous bow is not applicable to the bulb formula checks."
    ] .

gen:TRF026OtherIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

gen:TRF026QuantityNodeShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF026F1PropertyShape
    a sh:PropertyShape ;
    sh:path nltl:coefficientF1 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:TRF026F1QuantityShape .

gen:TRF026F1QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2>
    ] .

