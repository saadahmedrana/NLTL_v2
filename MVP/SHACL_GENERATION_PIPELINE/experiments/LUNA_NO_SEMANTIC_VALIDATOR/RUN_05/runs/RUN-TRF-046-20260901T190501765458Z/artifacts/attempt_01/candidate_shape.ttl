@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF046FrameShape a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:node gen:TRF046UpperEndShape ;
        sh:message "The frame shall have an upper end that is attached to an eligible deck, tank boundary plating, or ice stringer."
    ] .

gen:TRF046UpperEndShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:message "The upper end shall have an attached supporting structure."
    ] ;
    sh:sparql [
        sh:message "The upper end shall be attached to a deck, tank boundary plating, or ice stringer." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasAttachedSupportingStructure ?support .
                    ?support rdf:type ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        )
                    )
                }
            }
        """
    ] .
