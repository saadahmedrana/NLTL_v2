@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF049FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node gs:TRF049InAreaFrameShape
        ]
    ) .

gs:TRF049InAreaFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:node gs:TRF049FrameAttachmentShape ;
        sh:message "Each frame within the ice-strengthened area must have an effective frame attachment."
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:node gs:TRF049SupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:node gs:TRF049SupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:webPlateConnectionSideCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2 ;
                sh:message "A frame passing through a supporting structure must have both sides of its web plate connected."
            ]
        ]
    ) .

gs:TRF049InAreaFrameShape
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each installed bracket must be at least as thick as the frame web." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameWebThickness ?webQuantity .
                ?webQuantity qudt:numericValue ?webThickness .
                {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                }
                UNION
                {
                    $this nltl:hasSupportingBulkhead ?bulkhead .
                    ?bulkhead nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                }
                UNION
                {
                    $this nltl:hasSupportingWebFrame ?webFrame .
                    ?webFrame nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                }
                ?bracket nltl:bracketThickness ?bracketQuantity .
                ?bracketQuantity qudt:numericValue ?bracketThickness .
                FILTER (
                    datatype(?webThickness) = xsd:decimal &&
                    datatype(?bracketThickness) = xsd:decimal &&
                    ?bracketThickness < ?webThickness
                )
            }
        """
    ] .

gs:TRF049FrameAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be confirmed as effective."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node gs:TRF049ConnectionBracketShape
    ] .

gs:TRF049SupportingStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:minCount 1 ;
        sh:node gs:TRF049FrameAttachmentShape ;
        sh:message "Each linked supporting structure must have an effective attachment."
    ] .

gs:TRF049ConnectionBracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened against buckling."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket must have buckling stiffening."
    ] ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF049BracketThicknessQuantityShape ;
        sh:message "The bracket must specify a single thickness in millimetres."
    ] .

gs:TRF049BracketThicknessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

gs:TRF049FrameWebThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TRF049FrameWebThicknessQuantityShape ;
        sh:message "The frame web thickness must specify a single value in millimetres."
    ] .

gs:TRF049FrameWebThicknessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

gs:TRF049LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node gs:TRF049LongitudinalInAreaShape
        ]
    ) .

gs:TRF049LongitudinalInAreaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:node gs:TRF049BracketedSupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:node gs:TRF049BracketedSupportingStructureShape
    ] .

gs:TRF049BracketedSupportingStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:minCount 1 ;
        sh:node gs:TRF049BracketedAttachmentShape ;
        sh:message "A longitudinal frame must be attached by brackets to each linked supporting web frame and bulkhead."
    ] .

gs:TRF049BracketedAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:minCount 1 ;
        sh:node gs:TRF049ConnectionBracketShape
    ] .

gs:TRF049TransverseFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node gs:TRF049TransverseInAreaShape
        ]
    ) .

gs:TRF049TransverseInAreaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:minCount 1 ;
                sh:node gs:TRF049BracketOrSimilarAttachmentShape ;
                sh:message "A transverse frame terminating at a deck or ice stringer must have a bracket or similar construction."
            ]
        ]
    ) .

gs:TRF049BracketOrSimilarAttachmentShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:minCount 1 ;
                sh:node gs:TRF049ConnectionBracketShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .
