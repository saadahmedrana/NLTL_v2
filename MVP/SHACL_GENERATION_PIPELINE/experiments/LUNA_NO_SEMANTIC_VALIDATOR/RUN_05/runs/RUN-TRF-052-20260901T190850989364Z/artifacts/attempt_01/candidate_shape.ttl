@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF052FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Frame asymmetry status is required for the tripping-support applicability determination."
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG>
            ]
        ] ;
        sh:message "Frame web angle to shell must be recorded as one decimal quantity in degrees."
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ] ;
        sh:message "Frame span must be recorded as one decimal quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Ice class is required to determine the prescribed antitripping-support scope."
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The frame does not satisfy the prescribed antitripping-support spacing and scope, and no demonstrated equivalent support arrangement is recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameAsymmetrical ?asym ;
                      nltl:frameWebAngleToShell ?angleNode ;
                      nltl:frameSpan ?spanNode ;
                      nltl:iceClass ?iceClass .

                ?angleNode qudt:numericValue ?angleValue .
                ?spanNode qudt:numericValue ?spanValue .

                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true
                }

                FILTER (
                    (
                        (?asym = true || ?angleValue < 90)
                        &&
                        NOT EXISTS {
                            $this nltl:antitrippingSupportSpacing ?spacingNode .
                            ?spacingNode qudt:numericValue ?spacingValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                            FILTER (DATATYPE(?spacingValue) = xsd:decimal)
                            FILTER (?spacingValue <= 1300)
                        }
                    )
                    ||
                    (
                        ?spanValue > 4
                        &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:allRegions
                        }
                    )
                    ||
                    (
                        ?spanValue <= 4
                        &&
                        ?iceClass = nltl:iceClassIaSuper
                        &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:allRegions
                        }
                    )
                    ||
                    (
                        ?spanValue <= 4
                        &&
                        ?iceClass = nltl:iceClassIa
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                            }
                        )
                    )
                    ||
                    (
                        ?spanValue <= 4
                        &&
                        (
                            ?iceClass = nltl:iceClassIb
                            ||
                            ?iceClass = nltl:iceClassIc
                        )
                        &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                        }
                    )
                )
            }
        """
    ] .

g:TRF052ConditionalSpacingShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ]
    ] .
