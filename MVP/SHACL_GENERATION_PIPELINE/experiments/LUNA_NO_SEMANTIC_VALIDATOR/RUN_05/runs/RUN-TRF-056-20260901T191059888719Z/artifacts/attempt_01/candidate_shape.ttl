@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-056_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasWeatherdeckHatch ;
        sh:node <urn:nltl:generated-shape:TRF-056_WeatherdeckHatchShape>
    ] .

<urn:nltl:generated-shape:TRF-056_WeatherdeckHatchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hatchOpeningLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipSideDeflection ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasHatchCoverDesignEvidence ;
        sh:node [
            sh:class nltl:hatchCoverDesignEvidence
        ]
    ] ;
    sh:property [
        sh:path nltl:hasHatchFittingDesignEvidence ;
        sh:node [
            sh:class nltl:hatchFittingDesignEvidence
        ]
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-056_NonApplicableBranch>
        <urn:nltl:generated-shape:TRF-056_ApplicableBranch>
    ) .

<urn:nltl:generated-shape:TRF-056_NonApplicableBranch>
    a sh:NodeShape ;
    sh:sparql [
        sh:message "For a weatherdeck hatch, hatch opening length must be no greater than half the ship breadth when the conditional design obligation is not applicable." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship nltl:hasWeatherdeckHatch $this .
                    ?ship nltl:shipBreadth ?breadthQuantity .
                    ?breadthQuantity qudt:numericValue ?breadth ;
                        qudt:unit unit:M .
                    $this nltl:hatchOpeningLength ?lengthQuantity .
                    ?lengthQuantity qudt:numericValue ?length ;
                        qudt:unit unit:M .
                    FILTER ( ?length <= (?breadth / 2) )
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-056_ApplicableBranch>
    a sh:NodeShape ;
    sh:sparql [
        sh:message "For a weatherdeck hatch longer than half the ship breadth, ship-side deflection and both hatch-cover and hatch-fitting design evidence must be represented." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?ship nltl:hasWeatherdeckHatch $this .
                    ?ship nltl:shipBreadth ?breadthQuantity .
                    ?breadthQuantity qudt:numericValue ?breadth ;
                        qudt:unit unit:M .
                    $this nltl:hatchOpeningLength ?lengthQuantity .
                    ?lengthQuantity qudt:numericValue ?length ;
                        qudt:unit unit:M .
                    $this nltl:shipSideDeflection ?deflectionQuantity .
                    ?deflectionQuantity qudt:numericValue ?deflection ;
                        qudt:unit unit:M .
                    $this nltl:hasHatchCoverDesignEvidence ?coverEvidence .
                    $this nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                    FILTER ( ?length > (?breadth / 2) )
                }
            }
        """
    ] .
