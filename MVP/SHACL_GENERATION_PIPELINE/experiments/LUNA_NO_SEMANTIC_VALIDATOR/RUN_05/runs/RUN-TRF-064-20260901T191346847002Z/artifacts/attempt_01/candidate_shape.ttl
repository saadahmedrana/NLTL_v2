@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must state whether detached struts are used so that the applicable TRF-064 branch can be validated."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path ( nltl:hasSidePropellerShafting nltl:enclosedByPlatedBossing ) ;
                sh:node [
                    sh:class nltl:platedBossingStructure
                ] ;
                sh:minCount 1 ;
                sh:message "Shafting of a side propeller must be enclosed within plated bossing when detached struts are not used."
            ] ;
            sh:property [
                sh:path ( nltl:hasSternTube nltl:enclosedByPlatedBossing ) ;
                sh:node [
                    sh:class nltl:platedBossingStructure
                ] ;
                sh:minCount 1 ;
                sh:message "The stern tube of a side propeller must be enclosed within plated bossing when detached struts are not used."
            ]
        ]
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:node gen:TRF064DetachedStrutShape ;
                sh:minCount 1 ;
                sh:message "A detached strut must have documented design, strength, and hull-attachment consideration."
            ]
        ]
    ) .

gen:TRF064DetachedStrutShape
    a sh:NodeShape ;
    sh:class nltl:detachedStrutStructure ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:node [
            sh:class nltl:strutDesignEvidence
        ] ;
        sh:minCount 1 ;
        sh:message "A detached strut must have design evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:node [
            sh:class nltl:strutStrengthEvidence
        ] ;
        sh:minCount 1 ;
        sh:message "A detached strut must have strength evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:node [
            sh:class nltl:strutHullAttachmentEvidence
        ] ;
        sh:minCount 1 ;
        sh:message "A detached strut must have hull-attachment evidence."
    ] .
