@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF069Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall have an applicable Finnish-Swedish ice class." ;
    ] ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:in ( "open" "ducted" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller type shall be open or ducted." ;
    ] ;
    sh:property [
        sh:path nltl:pitchType ;
        sh:datatype xsd:string ;
        sh:in ( "controllable" "fixed" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The pitch type shall be controllable or fixed." ;
    ] ;
    sh:property [
        sh:path nltl:maximumIceTorque ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The maximum ice torque shall be recorded as a quantity in kN*m." ;
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:designCondition ;
            sh:property [
                sh:path nltl:normalOperationalConditions ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "The design-load scope shall cover normal operational conditions." ;
            ] ;
            sh:property [
                sh:path nltl:normalServiceLifePropellerIceLoadCondition ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "The design-load scope shall cover normal service-life propeller and ice loads." ;
            ] ;
            sh:property [
                sh:path nltl:fixedPitchPropellerReversalLoadIncluded ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Loads resulting from changing rotational direction of fixed-pitch propellers shall be included." ;
            ] ;
            sh:property [
                sh:path nltl:stoppedPropellerDraggingOutsideLoadModel ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Stopped-propeller dragging through ice shall be recorded as outside the prescribed load model." ;
            ] ;
            sh:property [
                sh:path nltl:radialIceEntryOutsideLoadModel ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "Radial ice entry into a turned azimuthing thruster shall be recorded as outside the prescribed load model." ;
            ]
        ]
    ] .
