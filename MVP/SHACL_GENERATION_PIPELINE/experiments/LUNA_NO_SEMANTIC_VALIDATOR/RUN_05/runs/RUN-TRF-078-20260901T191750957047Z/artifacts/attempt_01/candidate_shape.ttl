@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TRF078Table6Dash6CaseShape ;
        sh:message "The ship must have a Table 6-6 lookup case." ;
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TRF078Table6Dash7CaseShape ;
        sh:message "The ship must have a Table 6-7 lookup case." ;
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:message "The ship must provide exactly one k2 coefficient in a dimensionless quantity." ;
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:message "The ship must provide exactly one k3 coefficient in a dimensionless quantity." ;
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:message "The ship must provide exactly one propeller blade load spectrum count factor." ;
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "The ship must provide exactly one integer ice load cycle count." ;
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1 multiplied by k2, k3, N_class, and n_n within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case6 ;
                      nltl:hasTableLookupCase ?case7 ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?result .

                ?case6 nltl:tableReference nltl:traficomTable6Dash6 ;
                        nltl:selectedIceClassCycleCount ?nClassNode .

                ?case7 nltl:tableReference nltl:traficomTable6Dash7 ;
                        nltl:selectedPropellerLocationFactor ?k1Node .

                ?k1Node qudt:numericValue ?k1 .
                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nClassNode qudt:numericValue ?nClass .
                ?nnNode qudt:numericValue ?nn .
                ?resultValueNode qudt:numericValue ?result .
                FILTER (?resultValueNode = $this)
                BIND ((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                FILTER (
                    ABS(?result - ?expected) >
                    ((ABS(?expected) * 0.000001) + 0.000000001)
                )
            }
        """
    ] .

gen:TRF078DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    ] .

gen:TRF078Table6Dash6CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:message "A Table 6-6 lookup case must have exactly one Table 6-6 table reference." ;
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "A Table 6-6 lookup case must use one permitted ice-class selection key." ;
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:message "A Table 6-6 lookup case must provide exactly one selected ice-class cycle count." ;
    ] .

gen:TRF078Table6Dash7CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:message "A Table 6-7 lookup case must have exactly one Table 6-7 table reference." ;
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:message "A Table 6-7 lookup case must provide exactly one propeller-location selection key." ;
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:message "A Table 6-7 lookup case must provide exactly one selected propeller-location factor." ;
    ] .
