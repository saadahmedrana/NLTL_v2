@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-126> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "A propulsion engine that must be reversed for moving astern shall be identified as true."
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 12 ;
                sh:minCount 1 ;
                sh:message "Air receiver capacity shall provide at least 12 consecutive propulsion-engine starts when reversal for moving astern is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "A propulsion engine that does not have to be reversed for moving astern shall be identified as false."
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 6 ;
                sh:minCount 1 ;
                sh:message "Air receiver capacity shall provide at least 6 consecutive propulsion-engine starts when reversal for moving astern is not required."
            ]
        ]
    ) .
