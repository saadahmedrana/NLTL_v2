@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_129_CoolingWaterSupply a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceNavigationCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must provide the ice-navigation applicability condition."
    ] ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must provide whether it is navigating in ice."
    ] ;
    sh:property [
        sh:path nltl:coolingWaterSupplySecured ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When the ship is navigating in ice, its cooling water supply must be secured." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true .
                FILTER NOT EXISTS {
                    $this nltl:coolingWaterSupplySecured true .
                }
            }
        """
    ] .
