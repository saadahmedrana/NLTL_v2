@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A ship must provide its construction contract date to determine UR I2 Rev.4 applicability."
    ] ;
    sh:sparql [
        sh:message "Ships contracted for construction on or after 2021-01-01 must indicate that UR I2 Rev.4 applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (?date >= "2021-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:urI2RevisionApplicability true
                }
            }
        """
    ] .
