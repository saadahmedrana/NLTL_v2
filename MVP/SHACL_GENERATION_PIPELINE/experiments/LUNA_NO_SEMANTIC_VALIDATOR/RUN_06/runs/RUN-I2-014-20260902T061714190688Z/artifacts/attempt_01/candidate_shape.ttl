@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;

    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;

            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:class nltl:evidenceArtifact
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "The four bow subregions must have midpoint positions at one-eighth, three-eighths, five-eighths, and seven-eighths of bowLength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?bowQuantity .
                ?bowQuantity qudt:numericValue ?length .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?c1 .
                        ?c1 nltl:bowSubregionMidLengthPosition ?p1 .
                        ?p1 qudt:numericValue ?m1 .
                        FILTER (
                            ABS(?m1 - (?length / 8)) <=
                            (ABS(?length / 8) * 0.000001 + 0.000001)
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?c2 .
                        ?c2 nltl:bowSubregionMidLengthPosition ?p2 .
                        ?p2 qudt:numericValue ?m2 .
                        FILTER (
                            ABS(?m2 - ((?length * 3) / 8)) <=
                            (ABS((?length * 3) / 8) * 0.000001 + 0.000001)
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?c3 .
                        ?c3 nltl:bowSubregionMidLengthPosition ?p3 .
                        ?p3 qudt:numericValue ?m3 .
                        FILTER (
                            ABS(?m3 - ((?length * 5) / 8)) <=
                            (ABS((?length * 5) / 8) * 0.000001 + 0.000001)
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?c4 .
                        ?c4 nltl:bowSubregionMidLengthPosition ?p4 .
                        ?p4 qudt:numericValue ?m4 .
                        FILTER (
                            ABS(?m4 - ((?length * 7) / 8)) <=
                            (ABS((?length * 7) / 8) * 0.000001 + 0.000001)
                        )
                    }
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Selected maximum bow force, line load, and pressure must equal the corresponding maxima across the four bow subregion cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineQuantity ;
                      nltl:selectedMaximumBowPressure ?selectedPressureQuantity .
                ?selectedForceQuantity qudt:numericValue ?selectedForce .
                ?selectedLineQuantity qudt:numericValue ?selectedLine .
                ?selectedPressureQuantity qudt:numericValue ?selectedPressure .
                FILTER (
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?forceCase .
                        ?forceCase nltl:bowSubregionCalculatedForce ?forceQuantity .
                        ?forceQuantity qudt:numericValue ?force .
                        FILTER (?force > ?selectedForce)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalForceCase .
                        ?equalForceCase nltl:bowSubregionCalculatedForce ?equalForceQuantity .
                        ?equalForceQuantity qudt:numericValue ?equalForce .
                        FILTER (?equalForce = ?selectedForce)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?lineCase .
                        ?lineCase nltl:bowSubregionCalculatedLineLoad ?lineQuantity .
                        ?lineQuantity qudt:numericValue ?line .
                        FILTER (?line > ?selectedLine)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalLineCase .
                        ?equalLineCase nltl:bowSubregionCalculatedLineLoad ?equalLineQuantity .
                        ?equalLineQuantity qudt:numericValue ?equalLine .
                        FILTER (?equalLine = ?selectedLine)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?pressureCase .
                        ?pressureCase nltl:bowSubregionCalculatedPressure ?pressureQuantity .
                        ?pressureQuantity qudt:numericValue ?pressure .
                        FILTER (?pressure > ?selectedPressure)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?equalPressureCase .
                        ?equalPressureCase nltl:bowSubregionCalculatedPressure ?equalPressureQuantity .
                        ?equalPressureQuantity qudt:numericValue ?equalPressure .
                        FILTER (?equalPressure = ?selectedPressure)
                    }
                )
            }
        """
    ] .
