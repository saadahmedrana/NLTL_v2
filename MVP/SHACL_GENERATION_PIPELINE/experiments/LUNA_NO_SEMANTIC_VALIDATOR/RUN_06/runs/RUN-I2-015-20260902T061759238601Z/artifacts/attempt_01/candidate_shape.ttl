@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-015-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:message "Each ship shall provide beta i prime with a dimensionless unit." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:message "Each ship shall provide upper ice waterline length L_UI in metres." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:message "Each applicable ship shall provide a bow subregion calculation case." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-BowCaseShape>
    ] .

<urn:nltl:generated-shape:I2-015-BowCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:message "The bow subregion calculation case shall identify the I2.3.1(v) bow-form applicability." ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:i231vBowFormApplicability
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:message "The applicable bow subregion calculation case shall provide its mid-length position in metres." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:message "The applicable bow subregion calculation case shall provide its waterline angle in degrees." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-AngleQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:message "The applicable bow subregion calculation case shall provide the externally calculated bow shape coefficient." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:message "The applicable bow subregion calculation case shall provide its failure-class-factor lookup case." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-LookupCaseShape>
    ] .

<urn:nltl:generated-shape:I2-015-LookupCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:message "The failure-class-factor lookup case shall provide the flexural failure class factor with a dimensionless unit." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:message "The failure-class-factor lookup case shall provide the crushing failure class factor with a dimensionless unit." ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-015-DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-015-LengthQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-015-AngleQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
