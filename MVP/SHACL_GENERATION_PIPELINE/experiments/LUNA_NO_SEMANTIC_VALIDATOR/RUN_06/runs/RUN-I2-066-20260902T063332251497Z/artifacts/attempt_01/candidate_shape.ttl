@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_066_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node gen:I2_066_WeldShape ;
        sh:message "Each linked weld must identify whether it is within an ice-strengthened area and, when applicable, must be double continuous."
    ] .

gen:I2_066_WeldShape
    a sh:NodeShape ;
    sh:class nltl:weld ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:weldType ;
                sh:minCount 1 ;
                sh:hasValue nltl:doubleContinuousWeld
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
