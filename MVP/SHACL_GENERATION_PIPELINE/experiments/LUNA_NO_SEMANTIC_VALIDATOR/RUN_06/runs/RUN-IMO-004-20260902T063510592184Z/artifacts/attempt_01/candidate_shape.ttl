@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_004_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOriginType ;
        sh:minCount 1 ;
        sh:message "Ice origin is required to determine whether the first-year ice classification rule applies."
    ] ;
    sh:property [
        sh:path nltl:winterGrowthCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Exactly one integer winter growth count is required."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "One ice thickness quantity in metres is required."
    ] ;
    sh:sparql [
        sh:message "For sea ice with no more than one winter growth and thickness from 0.3 m through 2.0 m, the ice type must be first-year ice." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceOriginType nltl:seaIceOrigin .
    $this nltl:winterGrowthCount ?growth .
    $this nltl:iceThickness ?thicknessNode .
    ?thicknessNode qudt:numericValue ?thickness ;
                   qudt:unit unit:M .
    FILTER (
        ?growth <= 1 &&
        ?thickness >= "0.3"^^xsd:decimal &&
        ?thickness <= "2.0"^^xsd:decimal
    )
    FILTER NOT EXISTS {
        $this nltl:iceTypeClassification nltl:firstYearIce .
    }
}
"""
    ] .
