@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO011Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DataPeriodQuantityShape ;
        sh:message "The ship shall provide one data period in years."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:TemperatureQuantityShape ;
        sh:message "The ship shall provide one externally calculated mean daily low temperature."
    ] ;
    sh:property [
        sh:path nltl:hasDailyLowTemperatureObservation ;
        sh:node [
            sh:class nltl:dailyLowTemperatureObservation ;
            sh:property [
                sh:path nltl:dailyTemperatureObservationDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each daily low-temperature observation shall have one calendar date."
            ] ;
            sh:property [
                sh:path nltl:dailyLowTemperature ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:TemperatureQuantityShape ;
                sh:message "Each daily low-temperature observation shall carry one value in degrees Celsius."
            ]
        ]
    ] ;
    sh:or (
        [
            sh:sparql [
                sh:message "A data period of at least 10 years is required for the non-approval branch." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:dataPeriod ?period .
    ?period qudt:numericValue ?value .
    FILTER (xsd:decimal(?value) < 10)
}
"""
            ]
        ]
        [
            sh:sparql [
                sh:message "A data period shorter than 10 years requires an approved administration dataset." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:dataPeriod ?period .
    ?period qudt:numericValue ?value .
    FILTER (xsd:decimal(?value) >= 10)
}
"""
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:class nltl:evidenceState ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A data period shorter than 10 years requires administration dataset approval."
            ]
        ]
    ) .

gs:DataPeriodQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/YR> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TemperatureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
