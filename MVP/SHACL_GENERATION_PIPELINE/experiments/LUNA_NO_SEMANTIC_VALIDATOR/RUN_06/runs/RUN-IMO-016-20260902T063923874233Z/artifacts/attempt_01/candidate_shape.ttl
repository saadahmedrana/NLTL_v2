@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO-016-StaticShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCertificateForm ;
        sh:node [
            sh:property [
                sh:path nltl:certificateFormModel ;
                sh:minCount 1 ;
                sh:in ( nltl:appendixIPolarShipCertificateModel ) ;
                sh:message "The Polar Ship Certificate form must correspond to the Appendix I model."
            ]
        ] ;
        sh:message "A Polar Ship Certificate corresponding to the Appendix I model is required."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The certificate language is required to determine the translation obligation."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:in ( "English" "French" "Spanish" )
            ]
        ]
        [
            sh:property [
                sh:path nltl:approvedTranslationPresent ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "An approved translation into English, French, or Spanish is required when the certificate language is another language."
            ] ;
            sh:sparql [
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:certificateLanguage ?language .
                        FILTER (?language NOT IN ("English", "French", "Spanish"))
                    }
                """
            ]
        ]
    ) .
