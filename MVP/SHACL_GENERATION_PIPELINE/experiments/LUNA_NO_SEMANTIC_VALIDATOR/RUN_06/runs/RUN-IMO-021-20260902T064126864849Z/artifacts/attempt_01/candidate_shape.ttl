@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_021_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operationalAssessmentPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall have an operational assessment."
    ] ;
    sh:property [
        sh:path nltl:assessedLowAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG_C>
            ]
        ] ;
        sh:message "The operational assessment shall cover low-air-temperature operation with a temperature quantity in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:assessedIceOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover operation in ice."
    ] ;
    sh:property [
        sh:path nltl:assessedHighLatitude ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover operation in high latitude."
    ] ;
    sh:property [
        sh:path nltl:assessedAbandonment ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover potential abandonment onto ice or land."
    ] ;
    sh:property [
        sh:path nltl:assessedCodeHazards ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover applicable hazards listed in Introduction section 3."
    ] ;
    sh:property [
        sh:path nltl:assessedAdditionalHazards ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover any identified additional hazards."
    ] .
