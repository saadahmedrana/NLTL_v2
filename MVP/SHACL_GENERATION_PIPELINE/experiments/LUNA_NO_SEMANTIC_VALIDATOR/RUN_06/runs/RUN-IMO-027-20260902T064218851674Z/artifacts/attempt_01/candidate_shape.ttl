@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-027-PWOM-risk-procedure-coverage>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualRiskProcedureCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship's Polar Water Operational Manual must include the required risk-based procedures."
    ] ;
    sh:property [
        sh:path nltl:voyageLimitAvoidance ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include voyage-limit avoidance procedures."
    ] ;
    sh:property [
        sh:path nltl:environmentalForecastArrangements ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include arrangements for receiving environmental forecasts."
    ] ;
    sh:property [
        sh:path nltl:informationLimitationMeasures ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must address limitations of available hydrographic, meteorological, and navigational information."
    ] ;
    sh:property [
        sh:path nltl:requiredEquipmentOperation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual must include procedures for operating required equipment."
    ] ;
    sh:property [
        sh:path nltl:environmentalFunctionalityMeasures ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual must cover applicable measures for equipment and system functionality under polar environmental conditions."
    ] .
