@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operations are applicable, the ship shall record ice-operation monitoring and safety procedures."
            ] ;
            sh:property [
                sh:path nltl:escortRequirementsPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operations are applicable, the ship shall record applicable escort or icebreaker-assistance requirements."
            ] ;
            sh:property [
                sh:path nltl:independentOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When ice operations are applicable, the ship shall record limitations for independent operation."
            ] ;
            sh:property [
                sh:path nltl:escortedOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When ice operations are applicable, the ship shall record limitations for escorted operation."
            ]
        ]
    ) .
