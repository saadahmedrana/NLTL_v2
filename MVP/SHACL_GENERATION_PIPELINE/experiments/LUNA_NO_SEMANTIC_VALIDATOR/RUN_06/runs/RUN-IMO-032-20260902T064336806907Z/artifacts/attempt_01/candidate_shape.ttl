@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-032> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA ;
                sh:minCount 1 ;
                sh:message "The ship category shall be Category A."
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:class nltl:approvalRecord ;
                sh:node <urn:nltl:generated-shape:IMO-032-AB-approval> ;
                sh:minCount 1 ;
                sh:message "A conforming approval record is required for a Category A ship."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB ;
                sh:minCount 1 ;
                sh:message "The ship category shall be Category B."
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:class nltl:approvalRecord ;
                sh:node <urn:nltl:generated-shape:IMO-032-AB-approval> ;
                sh:minCount 1 ;
                sh:message "A conforming approval record is required for a Category B ship."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1 ;
                sh:message "The ship category shall be Category C."
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "A Category C ship shall be identified as ice strengthened for this approval condition."
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:class nltl:approvalRecord ;
                sh:node <urn:nltl:generated-shape:IMO-032-C-approval> ;
                sh:minCount 1 ;
                sh:message "A conforming approval record is required for an ice-strengthened Category C ship."
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-032-AB-approval> a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:message "The scantling approval status shall be Approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1 ;
        sh:message "The scantlings shall be approved by the Administration or an accepted recognized organization."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:minCount 1 ;
        sh:message "The approval standard shall be acceptable to the Organization or offer an equivalent level of safety."
    ] .

<urn:nltl:generated-shape:IMO-032-C-approval> a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:message "The scantling approval status shall be Approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1 ;
        sh:message "The scantlings shall be approved by the Administration or an accepted recognized organization."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "acceptable standard adequate for operating ice type and concentration"
        ) ;
        sh:minCount 1 ;
        sh:message "The approval standard shall be acceptable and adequate for the operating ice type and concentration."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The operating ice type shall be recorded for an ice-strengthened Category C approval."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:maxCount 1 ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The operating ice concentration shall be recorded as a dimensionless quantity."
    ] .
