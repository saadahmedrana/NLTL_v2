@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:message "A valid polar ship category is required."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction date is required for applicability determination."
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionCase ;
        sh:class nltl:loadingConditionCase
    ] ;
    sh:sparql [
        sh:message "For an applicable Category A or B ship constructed on or after 1 January 2017, every linked loading condition case must provide its identifier, applicability input, result evidence, and either a residual stability factor of exactly 1 or a compliant permitted alternative-instrument result." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?case
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:hasLoadingConditionCase ?case .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )

                FILTER (
                    YEAR(?date) > 2017 ||
                    (
                        YEAR(?date) = 2017 &&
                        (
                            MONTH(?date) > 1 ||
                            (MONTH(?date) = 1 && DAY(?date) >= 1)
                        )
                    )
                )

                FILTER NOT EXISTS {
                    ?case nltl:loadingConditionIdentifier ?identifier ;
                          nltl:alternativeInstrumentApplicable ?applicable ;
                          nltl:hasLoadingConditionResultEvidence ?evidence .

                    ?evidence a nltl:evidenceArtifact .

                    {
                        ?case nltl:residualStabilityFactorSI ?factor .
                        ?factor qudt:numericValue ?value ;
                                qudt:unit qudt:UNITLESS .
                        FILTER (
                            ?value >= "1.0"^^xsd:decimal &&
                            ?value <= "1.0"^^xsd:decimal
                        )
                    }
                    UNION
                    {
                        ?case nltl:alternativeInstrumentApplicable true ;
                              nltl:alternativeInstrumentResidualStabilityStatus true .
                    }
                }
            }
        """
    ] .

g:IMO037LoadingConditionCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:loadingConditionCase ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentApplicable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:residualStabilityFactorSI ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasLoadingConditionResultEvidence ;
        sh:class nltl:evidenceArtifact
    ] .
