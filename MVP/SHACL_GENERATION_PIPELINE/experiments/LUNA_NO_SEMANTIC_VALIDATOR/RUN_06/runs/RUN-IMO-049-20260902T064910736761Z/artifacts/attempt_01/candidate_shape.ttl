@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:IMO-049-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every linked machinery component must have a string-valued machinery component type." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:hasComponent ?component .
  FILTER NOT EXISTS {
    ?component nltl:machineryComponentType ?componentType .
    FILTER (datatype(?componentType) = xsd:string)
  }
}
""" ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship category must be Category A or Category B for this approval branch."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Each applicable Category A or B machinery component must have approved scantling evidence with an authorized authority and an acceptable or equivalent-safety standard." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
  $this nltl:hasComponent ?component .
  ?component nltl:machineryComponentType ?componentType .
  FILTER (STR(?componentType) IN (
    "propeller blade",
    "propulsion-line",
    "propulsion line",
    "steering-equipment",
    "steering equipment",
    "appendage"
  ))
  FILTER (
    NOT EXISTS {
      ?component nltl:hasApprovalRecord ?approvalRecord .
    }
    ||
    EXISTS {
      ?component nltl:hasApprovalRecord ?approvalRecord .
      FILTER (
        NOT EXISTS {
          ?approvalRecord nltl:scantlingApprovalStatus nltl:evidenceStateApproved .
        }
        ||
        NOT EXISTS {
          ?approvalRecord nltl:approvingAuthority ?authority .
          FILTER (STR(?authority) IN (
            "Administration",
            "recognized organization accepted by the Administration"
          ))
        }
        ||
        NOT EXISTS {
          ?approvalRecord nltl:approvalStandard ?standard .
          FILTER (STR(?standard) IN (
            "standard acceptable to the Organization",
            "another standard offering an equivalent level of safety"
          ))
        }
      )
    }
  )
}
""" ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship category must be Category C for this approval branch."
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Category C requires the ship to be recorded as ice-strengthened."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Each applicable ice-strengthened Category C machinery component must have approved scantling evidence with an authorized authority, an acceptable ice-adequacy standard, operating ice type, and operating ice concentration." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
SELECT $this
WHERE {
  $this nltl:hasComponent ?component .
  ?component nltl:machineryComponentType ?componentType .
  FILTER (STR(?componentType) IN (
    "propeller blade",
    "propulsion-line",
    "propulsion line",
    "steering-equipment",
    "steering equipment",
    "appendage"
  ))
  FILTER (
    NOT EXISTS {
      ?component nltl:hasApprovalRecord ?approvalRecord .
    }
    ||
    EXISTS {
      ?component nltl:hasApprovalRecord ?approvalRecord .
      FILTER (
        NOT EXISTS {
          ?approvalRecord nltl:scantlingApprovalStatus nltl:evidenceStateApproved .
        }
        ||
        NOT EXISTS {
          ?approvalRecord nltl:approvingAuthority ?authority .
          FILTER (STR(?authority) IN (
            "Administration",
            "recognized organization accepted by the Administration"
          ))
        }
        ||
        NOT EXISTS {
          ?approvalRecord nltl:approvalStandard ?standard .
          FILTER (STR(?standard) = "acceptable standard adequate for operating ice type and concentration")
        }
        ||
        NOT EXISTS {
          ?approvalRecord nltl:operatingIceType ?iceType .
          FILTER (datatype(?iceType) = xsd:string)
        }
        ||
        NOT EXISTS {
          ?approvalRecord nltl:operatingIceConcentration ?concentration .
          ?concentration qudt:numericValue ?numericValue ;
                         qudt:unit unit:UNITLESS .
          FILTER (datatype(?numericValue) = xsd:decimal)
        }
      )
    }
  )
}
""" ;
            ]
        ]
    ) .
