@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-053-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:node <urn:nltl:generated-shape:IMO-053-ExtinguishingMediumShape>
    ] .

<urn:nltl:generated-shape:IMO-053-ExtinguishingMediumShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:intendedOperationCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each extinguishing medium must have approved intended-operation compatibility status."
    ] .
