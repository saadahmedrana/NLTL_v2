@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship exposure-to-ice-accretion applicability value must be recorded exactly once."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:node gen:IMO066ProtectedItemShape ;
                sh:minCount 1 ;
                sh:message "When the ship is exposed to ice accretion, each protected item must have a category and associated ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066EscapeRouteCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "An escape route protected item with associated ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066MusterStationCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A muster station protected item with associated ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066EmbarkationAreaCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "An embarkation area protected item with associated ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066SurvivalCraftCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A survival craft protected item with associated ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066LaunchingApplianceCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A launching appliance protected item with associated ice or snow removal or prevention means is required."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape gen:IMO066SurvivalCraftAccessCoverageShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A survival craft access protected item with associated ice or snow removal or prevention means is required."
            ]
        ]
    ) .

gen:IMO066ProtectedItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:in (
            nltl:escapeRouteProtectedItem
            nltl:musterStationProtectedItem
            nltl:embarkationAreaProtectedItem
            nltl:survivalCraftProtectedItem
            nltl:launchingApplianceProtectedItem
            nltl:survivalCraftAccessProtectedItem
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each protected item must have exactly one permitted protected-item category."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each protected item must have associated ice or snow removal or prevention means."
    ] .

gen:IMO066EscapeRouteCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:escapeRouteProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066MusterStationCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:musterStationProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066EmbarkationAreaCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:embarkationAreaProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066SurvivalCraftCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066LaunchingApplianceCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:launchingApplianceProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .

gen:IMO066SurvivalCraftAccessCoverageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1
    ] .
