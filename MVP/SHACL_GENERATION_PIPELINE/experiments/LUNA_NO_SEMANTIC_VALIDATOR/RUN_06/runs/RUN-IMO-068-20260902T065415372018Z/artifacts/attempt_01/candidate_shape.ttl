@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_068_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's ice-covered-water operating condition must be recorded as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether direct evacuation onto the ice is applicable must be recorded as a single boolean value."
    ] ;
    sh:or (
        gen:IMO_068_IceWaterBranch
        gen:IMO_068_DirectIceBranch
        gen:IMO_068_NonApplicableBranch
    ) .

gen:IMO_068_IceWaterBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:hasValue true
    ] ;
    sh:node gen:IMO_068_RequiredEvacuationMeasuresShape .

gen:IMO_068_DirectIceBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:hasValue true
    ] ;
    sh:node gen:IMO_068_RequiredEvacuationMeasuresShape .

gen:IMO_068_NonApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:hasValue false
    ] .

gen:IMO_068_RequiredEvacuationMeasuresShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:safeEvacuationMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the rule applies, the ship must have means for safe evacuation."
    ] ;
    sh:property [
        sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "When the rule applies, survival equipment deployment must have approved status."
    ] .
