@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_071_ImmersionSuitTypeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "The immersion-suit applicability value must be false when the insulated-type condition is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The immersion-suit applicability value must be true to invoke the insulated-type requirement."
            ] ;
            sh:property [
                sh:path nltl:immersionSuitTypeClassification ;
                sh:minCount 1 ;
                sh:in ( nltl:insulatedImmersionSuit ) ;
                sh:message "Where immersion suits are required, the immersion suit type must be insulated."
            ]
        ]
    ) .
