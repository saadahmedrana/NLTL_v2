@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-072-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:message "The ship's extended darkness operation applicability must be recorded as false when this conditional requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:message "The ship's extended darkness operation applicability must be recorded as true when this conditional requirement applies."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:node <urn:nltl:generated-shape:IMO-072-LifeboatShape>
            ]
        ]
    ) .

<urn:nltl:generated-shape:IMO-072-LifeboatShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:node <urn:nltl:generated-shape:IMO-072-SearchlightShape> ;
        sh:minCount 1 ;
        sh:message "Each lifeboat must have an assigned searchlight when the ship operates in extended periods of darkness."
    ] .

<urn:nltl:generated-shape:IMO-072-SearchlightShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The assigned searchlight must be suitable for continuous use."
    ] .
