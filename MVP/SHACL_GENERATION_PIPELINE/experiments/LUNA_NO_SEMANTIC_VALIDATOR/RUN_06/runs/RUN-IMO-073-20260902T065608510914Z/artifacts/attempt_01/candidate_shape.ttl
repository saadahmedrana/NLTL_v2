@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-073-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:lifeboat ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:lifeboatTypeClassification ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:partiallyEnclosedLifeboat
                    nltl:totallyEnclosedLifeboat
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each lifeboat shall have exactly one type classification: partially enclosed or totally enclosed."
            ]
        ]
    ] .
