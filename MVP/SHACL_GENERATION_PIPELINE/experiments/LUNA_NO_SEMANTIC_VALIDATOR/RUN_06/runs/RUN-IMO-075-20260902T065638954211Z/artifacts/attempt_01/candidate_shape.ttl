@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-075> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personalOrGroupSurvivalEquipmentRequired ;
        sh:datatype xsd:boolean ;
        sh:message "personalOrGroupSurvivalEquipmentRequired must be a boolean when provided."
    ] ;
    sh:property [
        sh:path nltl:personsOnBoard ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "personsOnBoard is required to establish survival equipment capacity."
    ] ;
    sh:property [
        sh:path nltl:availableSurvivalEquipmentCapacity ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "availableSurvivalEquipmentCapacity is required when personal or group survival equipment is required."
    ] ;
    sh:property [
        sh:path nltl:storageAccessibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "storageAccessibilityStatus is required when personal or group survival equipment is required."
    ] ;
    sh:sparql [
        sh:message "When personal or group survival equipment is required, capacity must be at least 110% of persons on board and storage must be accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired true .
                FILTER NOT EXISTS {
                    $this nltl:personsOnBoard ?persons ;
                          nltl:availableSurvivalEquipmentCapacity ?capacity ;
                          nltl:storageAccessibilityStatus true .
                    FILTER (
                        ?capacity >= (?persons * 1.10)
                    )
                }
            }
        """
    ] .
