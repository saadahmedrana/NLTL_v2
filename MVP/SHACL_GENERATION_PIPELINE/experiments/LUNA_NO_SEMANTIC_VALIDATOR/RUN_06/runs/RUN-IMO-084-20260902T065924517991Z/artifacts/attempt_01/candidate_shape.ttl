@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO084Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:requiredSensorProjectsBelowHull ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must state whether required sensors project below the hull."
    ] ;
    sh:or (
        gs:IMO084NotApplicableBranch
        gs:IMO084ApplicableBranch
    ) .

gs:IMO084NotApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:requiredSensorProjectsBelowHull ;
        sh:hasValue false
    ] .

gs:IMO084ApplicableBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:requiredSensorProjectsBelowHull ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:sensorIceProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Sensors projecting below the hull must be protected against ice."
    ] .
