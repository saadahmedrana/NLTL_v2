@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-098-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-098-ApplicableShape>
        <urn:nltl:generated-shape:IMO-098-NotApplicableShape>
    ) .

<urn:nltl:generated-shape:IMO-098-ApplicableShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The low-air-temperature applicability value must be true for this branch."
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft ;
        sh:node <urn:nltl:generated-shape:IMO-098-OtherSurvivalCraftShape> ;
        sh:message "Each other survival craft must carry both required communication devices."
    ] .

<urn:nltl:generated-shape:IMO-098-NotApplicableShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The low-air-temperature applicability value must be false for this branch."
    ] .

<urn:nltl:generated-shape:IMO-098-OtherSurvivalCraftShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each other survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:hasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each other survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
