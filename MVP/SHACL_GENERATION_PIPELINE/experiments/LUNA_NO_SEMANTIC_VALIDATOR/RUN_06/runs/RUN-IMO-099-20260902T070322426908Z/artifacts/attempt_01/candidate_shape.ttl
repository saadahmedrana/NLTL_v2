@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_099_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:batteryLifeManagementProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The battery-life management procedure must be present."
    ] ;
    sh:property [
        sh:path nltl:procedureImplementationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The battery-life management procedure must be implemented."
    ] ;
    sh:property [
        sh:path nltl:communicationDeviceAvailability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CommunicationDeviceAvailabilityQuantityShape ;
        sh:message "Communication-device availability must be provided."
    ] ;
    sh:property [
        sh:path nltl:maximumExpectedRescueTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MaximumExpectedRescueTimeQuantityShape ;
        sh:message "The maximum expected rescue time must be provided."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Communication-device availability must be at least the maximum expected rescue time." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:communicationDeviceAvailability ?availabilityQuantity .
                ?availabilityQuantity qudt:numericValue ?availabilityValue .
                $this nltl:maximumExpectedRescueTime ?rescueQuantity .
                ?rescueQuantity qudt:numericValue ?rescueValue .
                FILTER (?availabilityValue < ?rescueValue)
            }
        """ ;
    ] .

gen:CommunicationDeviceAvailabilityQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DAY> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MaximumExpectedRescueTimeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DAY> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
