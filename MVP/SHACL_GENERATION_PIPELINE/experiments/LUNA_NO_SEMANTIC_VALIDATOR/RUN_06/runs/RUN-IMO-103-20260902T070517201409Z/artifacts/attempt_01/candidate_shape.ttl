@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO103Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO103AlternateNotUsedShape
        gen:IMO103AlternateUsedShape
    ) .

gen:IMO103AlternateNotUsedShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The alternate-qualified-person indicator must be false when the conditional permission is not used."
    ] .

gen:IMO103AlternateUsedShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The alternate-qualified-person indicator must be true to use the conditional credential provision."
    ] ;
    sh:property [
        sh:path nltl:administrationPermissionStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Administration permission is required for use of an alternate qualified person."
    ] ;
    sh:property [
        sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "STCW Convention regulation II/2 compliance is required."
    ] ;
    sh:property [
        sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "STCW Code section A-II/2 compliance is required."
    ] ;
    sh:property [
        sh:path nltl:advancedPolarTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Advanced polar training compliance is required."
    ] ;
    sh:property [
        sh:path nltl:watchCoverageStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Sufficient trained watch coverage is required."
    ] ;
    sh:property [
        sh:path nltl:restComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Administration minimum rest requirements must be satisfied."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:or (
        gen:IMO103PassengerOrTankerOtherWatersShape
        gen:IMO103PassengerOrTankerOpenOrBergyShape
        gen:IMO103CargoHighIceShape
        gen:IMO103CargoLowIceShape
    ) .

gen:IMO103PassengerOrTankerOtherWatersShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:in ( "passenger ship" "tanker" ) ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on passenger ships and tankers must meet the applicable basic training requirements in waters other than open or bergy waters."
    ] ;
    sh:sparql [
        sh:message "The passenger-ship or tanker basic-training branch applies only in waters other than open waters or bergy waters." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER (str(?condition) IN ("open waters", "bergy waters"))
            }
        """
    ] .

gen:IMO103PassengerOrTankerOpenOrBergyShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:in ( "passenger ship" "tanker" ) ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:in ( "open waters" "bergy waters" ) ;
        sh:minCount 1 ;
    ] .

gen:IMO103CargoHighIceShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:hasValue "cargo ship other than tanker" ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minExclusive "0.2"^^xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designatedOfficerBasicTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Designated officers on cargo ships other than tankers must meet the applicable basic training requirements when ice concentration exceeds 2/10."
    ] .

gen:IMO103CargoLowIceShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:hasValue "cargo ship other than tanker" ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxInclusive "0.2"^^xsd:decimal ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ] .
