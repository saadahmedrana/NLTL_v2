@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO105Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Operating area is required to determine whether the Arctic-waters discharge prohibition applies."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:hasValue "Arctic_waters"
            ] ;
            sh:property [
                sh:path nltl:oilOrOilyMixtureDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "Discharge of oil or oily mixtures to sea must be false for a ship operating in Arctic waters."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatingArea ;
                sh:pattern "^(?!Arctic_waters$).*"
            ]
        ]
    ) .
