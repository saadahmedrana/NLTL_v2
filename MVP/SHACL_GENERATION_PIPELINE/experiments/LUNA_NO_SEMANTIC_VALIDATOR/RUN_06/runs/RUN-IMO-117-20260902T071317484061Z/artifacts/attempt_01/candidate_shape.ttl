@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-117-DischargeDistanceRecordShape>
    a sh:NodeShape ;
    sh:targetClass nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each discharge distance record must record the distance to an area with ice concentration greater than one tenth in nautical miles."
    ] ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MI_N> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each discharge distance record must record the distance to the nearest land, ice shelf, or fast ice in nautical miles."
    ] .

<urn:nltl:generated-shape:IMO-117-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The sewage-treatment-plant discharge applicability value must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sewageTreatmentPlantApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable sewage treatment plant must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Applicable sewage treatment plant certification must have approved status under MARPOL Annex IV regulation 9.1.1 or 9.2.1."
            ] ;
            sh:property [
                sh:path nltl:marpolCertificationStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "MARPOL certification must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Sewage discharge must comply with MARPOL Annex IV regulation 11.1.2."
            ] ;
            sh:property [
                sh:path nltl:marpolDischargeStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "MARPOL discharge status must indicate compliance."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-117-DischargeDistanceRecordShape> ;
                sh:message "At least one applicable discharge distance record must be provided."
            ]
        ]
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:hasValue false
            ]
        ]
    ) .
