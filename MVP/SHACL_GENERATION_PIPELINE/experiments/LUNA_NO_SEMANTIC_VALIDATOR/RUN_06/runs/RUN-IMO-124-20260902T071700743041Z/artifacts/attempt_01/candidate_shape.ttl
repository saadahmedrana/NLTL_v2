@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-124> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:antarcticArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For an Antarctic-area MARPOL Annex V regulation 6.1 discharge, the required distances, nearby ice concentration, and prohibition on food-waste discharge onto ice must conform." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:operatingArea ?operatingArea ;
        nltl:antarcticArea ?antarcticArea ;
        nltl:marpolAnnexVRegulation6Point1DischargeOccurs ?discharge .

  FILTER(
    ?operatingArea = "Antarctic_area"^^xsd:string &&
    ?antarcticArea = "Antarctic_area"^^xsd:string &&
    ?discharge = true
  )

  FILTER(
    NOT EXISTS {
      $this nltl:distanceToNearestFastIce ?fastIceDistance .
      ?fastIceDistance qudt:numericValue ?fastIceValue ;
                        qudt:unit unit:MI_N .
      FILTER(
        datatype(?fastIceValue) = xsd:decimal &&
        ?fastIceValue >= 12
      )
    }
    ||
    NOT EXISTS {
      $this nltl:nearbyIceConcentration ?nearbyConcentration .
      ?nearbyConcentration qudt:numericValue ?nearbyValue ;
                           qudt:unit unit:UNITLESS .
      FILTER(
        datatype(?nearbyValue) = xsd:decimal
      )
    }
    ||
    NOT EXISTS {
      $this nltl:foodWasteDischargeOntoIce ?foodWasteDischarge .
      FILTER(
        datatype(?foodWasteDischarge) = xsd:boolean &&
        ?foodWasteDischarge = false
      )
    }
    ||
    (
      EXISTS {
        $this nltl:nearbyIceConcentration ?highConcentration .
        ?highConcentration qudt:numericValue ?highValue ;
                           qudt:unit unit:UNITLESS .
        FILTER(
          datatype(?highValue) = xsd:decimal &&
          ?highValue > 0.1
        )
      }
      &&
      NOT EXISTS {
        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?iceAreaDistance .
        ?iceAreaDistance qudt:numericValue ?iceAreaDistanceValue ;
                          qudt:unit unit:MI_N .
        FILTER(
          datatype(?iceAreaDistanceValue) = xsd:decimal
        )
      }
    )
  )
}
""" ;
    ] .
