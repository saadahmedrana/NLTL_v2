@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-002-Chapter9-1ApplicabilityShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship type is required to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 9-1 applicability must be recorded as a single boolean result."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 9-1 applicability must match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?type ;
                      nltl:polarCodeChapter9Dash1Applicable ?app .
                FILTER (
                    (
                        ?type = "fishing_vessel" &&
                        (
                            NOT EXISTS {
                                $this nltl:lengthOverall ?lengthQuantity .
                                ?lengthQuantity qudt:numericValue ?lengthValue ;
                                                qudt:unit <http://qudt.org/vocab/unit/M> .
                                FILTER (
                                    datatype(?lengthValue) = xsd:decimal &&
                                    ?lengthValue >= 24
                                )
                            } ||
                            ?app != true
                        )
                    ) ||
                    (
                        ?type = "pleasure_yacht" &&
                        (
                            NOT EXISTS {
                                $this nltl:grossTonnage ?grossQuantity ;
                                      nltl:engagedInTrade ?trade .
                                ?grossQuantity qudt:numericValue ?grossValue ;
                                               qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (
                                    datatype(?grossValue) = xsd:decimal &&
                                    ?grossValue >= 300 &&
                                    datatype(?trade) = xsd:boolean &&
                                    ?trade = false
                                )
                            } ||
                            ?app != true
                        )
                    ) ||
                    (
                        ?type = "cargo_ship" &&
                        (
                            NOT EXISTS {
                                $this nltl:grossTonnage ?cargoGrossQuantity .
                                ?cargoGrossQuantity qudt:numericValue ?cargoGrossValue ;
                                                     qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER (
                                    datatype(?cargoGrossValue) = xsd:decimal &&
                                    ?cargoGrossValue >= 300 &&
                                    ?cargoGrossValue < 500
                                )
                            } ||
                            ?app != true
                        )
                    ) ||
                    (
                        ?type NOT IN ("fishing_vessel", "pleasure_yacht", "cargo_ship") &&
                        ?app != false
                    )
                )
            }
        """
    ] .
