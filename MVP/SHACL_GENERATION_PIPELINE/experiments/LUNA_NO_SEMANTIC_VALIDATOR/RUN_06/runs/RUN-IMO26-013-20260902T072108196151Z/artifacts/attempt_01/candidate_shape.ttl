@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26_013_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A planned or actual latitude in degrees is required to determine applicability."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO26_013_NonApplicableBranch>
        <urn:nltl:generated-shape:IMO26_013_ApplicableBranch>
    ) ;
    sh:message "The latitude must establish either the non-applicable branch (at most 80 degrees) or the applicable branch (over 80 degrees)."
.

<urn:nltl:generated-shape:IMO26_013_NonApplicableBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive "80"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ]
.

<urn:nltl:generated-shape:IMO26_013_ApplicableBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "80"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:gnssCompassOrEquivalentCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:message "At latitudes over 80 degrees, at least one GNSS compass or equivalent is required."
    ] ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:benchmarkEntity
        ] ;
        sh:message "At latitudes over 80 degrees, the GNSS compass or equivalent must be connected to the ship's main power."
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:benchmarkEntity
        ] ;
        sh:message "At latitudes over 80 degrees, the GNSS compass or equivalent must be connected to the ship's emergency power."
    ]
.
