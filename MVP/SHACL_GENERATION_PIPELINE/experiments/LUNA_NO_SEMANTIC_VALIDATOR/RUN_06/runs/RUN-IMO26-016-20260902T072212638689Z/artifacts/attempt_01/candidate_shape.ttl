@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 11-1 applicability must be true for a qualifying ship operating in polar waters." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipOperatesInPolarWaters true .
                {
                    $this nltl:shipType "fishing_vessel" ;
                          nltl:lengthOverall ?lengthNode .
                    ?lengthNode qudt:numericValue ?lengthValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER ( ?lengthValue >= "24"^^xsd:decimal )
                }
                UNION
                {
                    $this nltl:shipType "pleasure_yacht" ;
                          nltl:grossTonnage ?tonnageNode ;
                          nltl:engagedInTrade false .
                    ?tonnageNode qudt:numericValue ?tonnageValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER ( ?tonnageValue >= "300"^^xsd:decimal )
                }
                UNION
                {
                    $this nltl:shipType "cargo_ship" ;
                          nltl:grossTonnage ?tonnageNode .
                    ?tonnageNode qudt:numericValue ?tonnageValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        ?tonnageValue >= "300"^^xsd:decimal &&
                        ?tonnageValue < "500"^^xsd:decimal
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter11Dash1Applicable true .
                }
            }
        """
    ] .
