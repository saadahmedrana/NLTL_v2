@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-017> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Chapter 11-1 applicability state must be provided exactly once."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "When Chapter 11-1 is applicable, the voyage plan must be present."
            ] ;
            sh:property [
                sh:path nltl:intendedVoyageHazard ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When Chapter 11-1 is applicable, at least one intended voyage hazard must be recorded."
            ] ;
            sh:property [
                sh:path nltl:voyagePlanCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The voyage plan must take into account every recorded intended voyage hazard."
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue false
            ]
        ]
    ) .
