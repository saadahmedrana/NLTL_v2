nltlg:IceClassIiOrIiiBranch
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIi ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIii ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .

nltlg:TRF018Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        nltlg:IceClassIaSuperBranch
        nltlg:IceClassIaBranch
        nltlg:IceClassIbBranch
        nltlg:IceClassIcBranch
        nltlg:IceClassIiOrIiiBranch
    ) .
