@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF022QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF022Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:node gs:TRF022BowRakeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:node gs:TRF022WaterlineAngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:node gs:TRF022ShipLengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:node gs:TRF022IceClassDraughtQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:node gs:TRF022ShipBreadthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:node gs:TRF022CoefficientC3QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:node gs:TRF022CoefficientC4QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:node gs:TRF022CoefficientC5QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:node gs:TRF022CoefficientF1QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:node gs:TRF022CoefficientF2QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:node gs:TRF022CoefficientF3QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:node gs:TRF022CoefficientF4QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:node gs:TRF022CoefficientG1QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:node gs:TRF022CoefficientG2QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:node gs:TRF022CoefficientG3QuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:node gs:TRF022FlareAngleQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally computed psi result must be provided with a degree unit."
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:node gs:TRF022ClampedHullGeometryQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The externally computed clamped hull geometry result must be provided."
    ] .

gs:TRF022BowRakeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

gs:TRF022WaterlineAngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

gs:TRF022ShipLengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gs:TRF022IceClassDraughtQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gs:TRF022ShipBreadthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gs:TRF022CoefficientC3QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gs:TRF022CoefficientC4QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gs:TRF022CoefficientC5QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit
    ] .

gs:TRF022CoefficientF1QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2>
    ] .

