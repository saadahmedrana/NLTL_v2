    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N-PER-M>
    ] .

gs:TRF022CoefficientF4QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
