gs:TRF022CoefficientG3QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit
    ] .

gs:TRF022FlareAngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

gs:TRF022ClampedHullGeometryQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:node gs:TRF022QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
