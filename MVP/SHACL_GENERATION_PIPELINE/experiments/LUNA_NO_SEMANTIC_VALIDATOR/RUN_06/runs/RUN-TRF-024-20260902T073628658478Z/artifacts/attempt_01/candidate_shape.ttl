@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_024_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "The ship must specify an ice class."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The ship must specify its construction-stage date to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship retaining ice class IA Super or IA with construction begun before 1 September 2003, delivery date and assessment date are required, and the section 3.2.2 deadline must not have passed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                    nltl:iceClass ?ice ;
                    nltl:constructionStageDate ?construction .

                FILTER (
                    ?ice IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )

                FILTER (
                    YEAR(?construction) < 2003
                    || (
                        YEAR(?construction) = 2003
                        && (
                            MONTH(?construction) < 9
                            || (
                                MONTH(?construction) = 9
                                && DAY(?construction) < 1
                            )
                        )
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:deliveryDate ?delivery .
                    }
                    || NOT EXISTS {
                        $this nltl:assessmentDate ?assessment .
                    }
                    || EXISTS {
                        $this nltl:deliveryDate ?delivery ;
                            nltl:assessmentDate ?assessment .

                        FILTER (
                            YEAR(?assessment) > YEAR(?delivery) + 20
                            || (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                && (
                                    MONTH(?assessment) > 1
                                    || (
                                        MONTH(?assessment) = 1
                                        && DAY(?assessment) > 1
                                    )
                                )
                            )
                        )
                    }
                )
            }
        """
    ] .
</urn:nltl:generated-shape:TRF_024_ShipShape>
