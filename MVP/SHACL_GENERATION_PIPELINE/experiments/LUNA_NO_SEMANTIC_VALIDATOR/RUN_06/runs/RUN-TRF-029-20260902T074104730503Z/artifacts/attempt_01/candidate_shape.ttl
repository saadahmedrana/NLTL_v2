@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-029> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "directAnalysisUsed must be recorded as exactly one boolean value." ;
        sh:or (
            [
                sh:hasValue false
            ]
            [
                sh:hasValue true
            ]
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:prescribedProcedureApplicability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "When direct analysis is used, prescribedProcedureApplicability must be false."
            ] ;
            sh:property [
                sh:path nltl:directAnalysisApprovalStatus ;
                sh:minCount 1 ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:class nltl:evidenceState ;
                sh:message "When direct analysis is used, its approval status must be Approved."
            ] ;
            sh:property [
                sh:path nltl:structuralArrangement ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When direct analysis is used, structuralArrangement must be recorded."
            ]
        ]
    ) .
