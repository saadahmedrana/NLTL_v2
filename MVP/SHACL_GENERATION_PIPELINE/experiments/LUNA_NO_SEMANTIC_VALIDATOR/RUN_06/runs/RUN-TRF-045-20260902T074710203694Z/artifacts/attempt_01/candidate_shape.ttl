@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-045_FrameScantlings> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:datatype xsd:boolean ;
        sh:message "ordinaryFrameScantlingsUsed must be a boolean when represented."
    ] ;
    sh:property [
        sh:path nltl:frameSpanWithinIceStrengtheningZone ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Ordinary frame scantlings may be used only when less than 15% of the frame span is within the ice-strengthening zone; both spans must be supplied in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:ordinaryFrameScantlingsUsed ?use .
                FILTER(?use = true)

                FILTER(
                    NOT EXISTS {
                        $this nltl:frameSpanWithinIceStrengtheningZone ?frameQuantity .
                        ?frameQuantity qudt:numericValue ?frameValue ;
                            qudt:unit unit:M .
                        FILTER(datatype(?frameValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:span ?spanQuantity .
                        ?spanQuantity qudt:numericValue ?spanValue ;
                            qudt:unit unit:M .
                        FILTER(datatype(?spanValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:frameSpanWithinIceStrengtheningZone ?frameQuantity2 .
                        ?frameQuantity2 qudt:numericValue ?frameValue2 ;
                            qudt:unit unit:M .
                        $this nltl:span ?spanQuantity2 .
                        ?spanQuantity2 qudt:numericValue ?spanValue2 ;
                            qudt:unit unit:M .
                        FILTER(datatype(?frameValue2) = xsd:decimal)
                        FILTER(datatype(?spanValue2) = xsd:decimal)
                        FILTER(?frameValue2 < (0.15 * ?spanValue2))
                    }
                )
            }
        """
    ] .
