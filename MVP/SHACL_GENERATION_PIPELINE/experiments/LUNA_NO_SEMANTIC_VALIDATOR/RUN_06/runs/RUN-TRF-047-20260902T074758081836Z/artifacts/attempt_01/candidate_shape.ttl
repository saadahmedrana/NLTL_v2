@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-047-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:message "A frame must identify its lower end."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lower end must be attached to an approved deck, tank plating, tank top, or ice stringer, unless the declared intermediate-frame exception is satisfied." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasLowerEnd ?end .
                    ?end nltl:hasAttachedSupportingStructure ?support .
                    ?support a ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:tankTop,
                            nltl:iceStringer
                        )
                    )
                }
                FILTER NOT EXISTS {
                    $this a nltl:intermediateIceFrame .
                    $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit
                        "true"^^xsd:boolean .
                    $this nltl:sameScantlingsAsMainFrame
                        "true"^^xsd:boolean .
                    $this nltl:hasLowerEnd ?end .
                    ?end nltl:hasHorizontalConnectionMember ?member .
                    ?member a nltl:horizontalConnectionMember .
                    ?member nltl:connectsToAdjacentMainFrame ?mainFrame .
                    ?mainFrame a nltl:mainFrame .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A main frame below the ice belt must be declared ice strengthened." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:mainFrame .
                FILTER NOT EXISTS {
                    $this nltl:mainFrameBelowIceBeltStrengthened
                        "true"^^xsd:boolean
                }
            }
        """
    ] .
