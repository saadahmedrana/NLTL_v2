@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-064-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:class nltl:sidePropellerShaftingAssembly ;
        sh:node <urn:nltl:generated-shape:TRF-064-ShaftingEnclosureShape>
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:class nltl:sternTube ;
        sh:node <urn:nltl:generated-shape:TRF-064-SternTubeEnclosureShape>
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:class nltl:detachedStrutStructure ;
        sh:node <urn:nltl:generated-shape:TRF-064-DetachedStrutEvidenceShape>
    ] .

<urn:nltl:generated-shape:TRF-064-ShaftingEnclosureShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "Side propeller shafting shall be enclosed within plated bossing."
    ] .

<urn:nltl:generated-shape:TRF-064-SternTubeEnclosureShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure ;
        sh:message "Stern tubes of side propellers shall be enclosed within plated bossing."
    ] .

<urn:nltl:generated-shape:TRF-064-DetachedStrutEvidenceShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutDesignEvidence ;
        sh:message "A detached strut shall have design evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutStrengthEvidence ;
        sh:message "A detached strut shall have strength evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutHullAttachmentEvidence ;
        sh:message "A detached strut shall have hull-attachment evidence."
    ] .
