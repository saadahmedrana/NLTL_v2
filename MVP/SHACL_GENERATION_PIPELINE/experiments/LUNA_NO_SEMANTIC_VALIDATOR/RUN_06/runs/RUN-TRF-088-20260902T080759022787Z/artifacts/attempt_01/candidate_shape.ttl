@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF088TorqueQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque must use kN*m."
    ] .

gs:TRF088TableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The applicable maximum-torque lookup case must record that the table lookup was applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:traficomTable6Dash10 ;
        sh:message "The applicable lookup case must reference TRAFICOM Table 6-10."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The applicable table selection must have evidence."
    ] .

gs:TRF088Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:maximumEngineTorqueKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:maximumEngineTorque ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:TRF088TorqueQuantityShape ;
                sh:message "A known maximum engine torque must be provided as a quantity."
            ]
        ]
        [
            sh:property [
                sh:path nltl:maximumEngineTorqueKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
            ] ;
            sh:property [
                sh:path nltl:maximumEngineTorque ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:TRF088TorqueQuantityShape ;
                sh:message "When maximum engine torque is unknown, the Table 6-10 torque value must be represented."
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:node gs:TRF088TableLookupCaseShape ;
                sh:message "When maximum engine torque is unknown, a Table 6-10 lookup case is required."
            ]
        ]
    ) .
