@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:node gen:TRF091IceMillingSequenceCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:node gen:TRF091PropulsionLoadCaseShape
    ] .

gen:TRF091IceMillingSequenceCaseShape
    a sh:NodeShape ;
    sh:class nltl:iceMillingSequenceCase .

gen:TRF091PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:in (
            nltl:propulsionLineStrengthEvaluationPurpose
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A propulsion load case shall be designated for propulsion line strength evaluation and shall not be designated for stalling analysis."
    ] .
