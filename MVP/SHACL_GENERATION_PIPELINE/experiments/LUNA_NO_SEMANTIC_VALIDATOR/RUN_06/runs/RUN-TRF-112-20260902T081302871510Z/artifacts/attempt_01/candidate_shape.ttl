@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_112_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node gen:TRF_112_PropellerShaftLineComponentShape ;
        sh:message "The ship shall identify the applicable propeller shaft line component or components." ;
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node gen:TRF_112_PropulsionLoadCaseShape ;
        sh:message "The ship shall identify the propulsion load case used for the total blade-failure loading assessment." ;
    ] .

gen:TRF_112_PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:bladeFailureLoadCase ;
        sh:message "The propulsion load case shall be identified as the total blade-failure load case." ;
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_112_ForceQuantityShape ;
        sh:message "The blade-failure ultimate load shall be provided for the load case." ;
    ] ;
    sh:property [
        sh:path nltl:combinedAxialBendingTorsionLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_112_ForceQuantityShape ;
        sh:message "The combined axial, bending, and torsion load shall be provided for the load case." ;
    ] .

gen:TRF_112_PropellerShaftLineComponentShape
    a sh:NodeShape ;
    sh:class nltl:propellerShaftLineComponent ;
    sh:property [
        sh:path nltl:bendingYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_112_BendingSafetyFactorShape ;
        sh:message "The externally calculated bending safety factor shall be provided and shall be at least 1.0." ;
    ] ;
    sh:property [
        sh:path nltl:torsionalYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF_112_TorsionalSafetyFactorShape ;
        sh:message "The externally calculated torsional safety factor shall be provided and shall be at least 1.0." ;
    ] .

gen:TRF_112_ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
    ] .

gen:TRF_112_BendingSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    ] .

gen:TRF_112_TorsionalSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
    ] .
