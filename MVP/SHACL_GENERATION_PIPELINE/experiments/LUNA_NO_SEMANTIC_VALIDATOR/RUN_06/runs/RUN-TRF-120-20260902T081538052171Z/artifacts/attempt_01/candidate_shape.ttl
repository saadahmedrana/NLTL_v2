@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF120ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damping ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide damping information for thruster global natural-frequency estimation."
    ] ;
    sh:property [
        sh:path nltl:waterAddedMass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:WaterAddedMassShape ;
        sh:message "The ship must provide water added mass for thruster global natural-frequency estimation."
    ] ;
    sh:property [
        sh:path nltl:thrusterNaturalFrequency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ThrusterNaturalFrequencyShape ;
        sh:message "The ship must provide the thruster global natural frequency."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gen:TRF120ThrusterBodyShape
    ] .

gen:TRF120ThrusterBodyShape
    a sh:NodeShape ;
    sh:class nltl:thrusterBody ;
    sh:property [
        sh:path nltl:shipAttachmentStiffness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ShipAttachmentStiffnessShape ;
        sh:message "The thruster body must provide ship attachment stiffness."
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:TRF120CalculationCaseShape ;
        sh:qualifiedValueShape gen:TRF120LongitudinalCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint false ;
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:qualifiedValueShape gen:TRF120TransverseCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint false ;
    ] .

gen:TRF120CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:longitudinalDirection
            nltl:transverseDirection
        ) ;
        sh:message "Each natural-frequency calculation case must identify a longitudinal or transverse vibration direction."
    ] .

gen:TRF120LongitudinalCaseShape
    a sh:NodeShape ;
    sh:node gen:TRF120CalculationCaseShape ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:hasValue nltl:longitudinalDirection ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF120TransverseCaseShape
    a sh:NodeShape ;
    sh:node gen:TRF120CalculationCaseShape ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:hasValue nltl:transverseDirection ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:WaterAddedMassShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloGM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ThrusterNaturalFrequencyShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:HZ ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ShipAttachmentStiffnessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
