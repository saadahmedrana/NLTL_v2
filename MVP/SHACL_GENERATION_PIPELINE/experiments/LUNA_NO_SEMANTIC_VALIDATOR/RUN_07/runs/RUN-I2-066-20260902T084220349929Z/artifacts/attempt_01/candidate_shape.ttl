@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_066_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node gen:I2_066_WeldShape ;
        sh:message "Each linked weld must identify whether it is within the ice-strengthened area and satisfy the applicable weld-type rule."
    ] .

gen:I2_066_WeldShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each weld must state whether it is within the ice-strengthened area."
    ] ;
    sh:or (
        gen:I2_066_WeldInIceAreaShape
        gen:I2_066_WeldOutsideIceAreaShape
    ) ;
    sh:message "The within-ice-strengthened-area value must be true or false, with the applicable weld-type constraint satisfied." .

gen:I2_066_WeldInIceAreaShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:weldType ;
        sh:minCount 1 ;
        sh:hasValue nltl:doubleContinuousWeld ;
        sh:message "Welding within an ice-strengthened area must be of the double continuous type."
    ] .

gen:I2_066_WeldOutsideIceAreaShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:hasValue false
    ] .
