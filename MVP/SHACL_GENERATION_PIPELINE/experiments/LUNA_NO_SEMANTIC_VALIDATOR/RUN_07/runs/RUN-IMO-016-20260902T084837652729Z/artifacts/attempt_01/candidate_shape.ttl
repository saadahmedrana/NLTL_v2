@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO016ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:node gen:IMO016CertificateShape ;
        sh:message "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model."
    ] ;
    sh:or (
        gen:IMO016StandardLanguageShape
        gen:IMO016TranslatedLanguageShape
    ) .

gen:IMO016CertificateShape
    a sh:NodeShape ;
    sh:class nltl:polarShipCertificateForm ;
    sh:property [
        sh:path nltl:certificateFormModel ;
        sh:minCount 1 ;
        sh:hasValue nltl:appendixIPolarShipCertificateModel ;
        sh:message "The Polar Ship Certificate form shall correspond to the Appendix I model."
    ] .

gen:IMO016StandardLanguageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "English" "French" "Spanish" )
    ] .

gen:IMO016TranslatedLanguageShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvedTranslationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "A certificate language other than English, French, or Spanish shall include an approved translation into one of those languages."
    ] .
