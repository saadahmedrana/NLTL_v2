@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_040_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must record whether ice accretion is likely so the conditional equipment requirement can be evaluated."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:node [
                    sh:class nltl:relevantHatchOrDoorItem ;
                    sh:property [
                        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:iceSnowRemovalOrPreventionMeans
                        ] ;
                        sh:message "Each relevant hatch or door must have an associated means to remove or prevent ice and snow accretion."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
    ) .
