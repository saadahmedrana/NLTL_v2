@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO041Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:openingActuationType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Each ship must specify its opening actuation type."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:hasValue "hydraulic"
            ] ;
            sh:property [
                sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Hydraulic openings require freezing or excessive-viscosity control for the hydraulic fluid."
            ]
        ]
        [
            sh:sparql [
                sh:message "The non-hydraulic alternative cannot apply when the ship has a hydraulic opening actuator." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?actuationType .
                        FILTER (STR(?actuationType) = "hydraulic")
                    }
                """
            ]
        ]
    ) .
