@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO-060-ConditionalCapabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:seaSuctionIceClearingCapability ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:independentSeaSuctionUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:seaSuctionIceClearingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:independentSeaSuctionUsed ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "When the fixed water system is separate from the main fire pumps and uses an independent sea suction, that sea suction must be capable of being cleared of ice accumulation." .
