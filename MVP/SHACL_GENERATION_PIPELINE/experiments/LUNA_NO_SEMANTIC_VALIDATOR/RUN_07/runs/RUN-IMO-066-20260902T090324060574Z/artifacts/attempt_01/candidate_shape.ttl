@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO066NotExposedShape
        gen:IMO066ExposedShape
    ) .

gen:IMO066NotExposedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ship's ice-accretion exposure status must be recorded as false for the non-applicable branch."
    ] .

gen:IMO066ExposedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship's ice-accretion exposure status must be recorded as true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:node gen:IMO066ProtectedItemShape ;
        sh:message "Every represented protected item must have an applicable category and associated ice or snow removal or prevention means."
    ] .

gen:IMO066ProtectedItemShape
    a sh:NodeShape ;
    sh:class nltl:protectedItem ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:escapeRouteProtectedItem
            nltl:musterStationProtectedItem
            nltl:embarkationAreaProtectedItem
            nltl:survivalCraftProtectedItem
            nltl:launchingApplianceProtectedItem
            nltl:survivalCraftAccessProtectedItem
        ) ;
        sh:message "Each protected item must identify one of the permitted escape, muster, embarkation, survival craft, launching appliance, or survival-craft access categories."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:node gen:IMO066IceSnowMeansShape ;
        sh:message "Each protected item must have associated means to remove or prevent ice and snow accretion."
    ] .

gen:IMO066IceSnowMeansShape
    a sh:NodeShape ;
    sh:class nltl:iceSnowRemovalOrPreventionMeans .
