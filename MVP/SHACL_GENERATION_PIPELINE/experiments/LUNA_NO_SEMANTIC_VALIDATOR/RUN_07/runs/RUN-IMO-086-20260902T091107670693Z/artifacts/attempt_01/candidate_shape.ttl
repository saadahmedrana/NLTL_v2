@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO086_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:minCount 2 ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:minCount 1 ;
                sh:class nltl:benchmarkEntity ;
                sh:nodeKind sh:IRI ;
                sh:message "Each non-magnetic heading means shall be connected to main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:minCount 1 ;
                sh:class nltl:benchmarkEntity ;
                sh:nodeKind sh:IRI ;
                sh:message "Each non-magnetic heading means shall be connected to emergency power."
            ] ;
            sh:property [
                sh:path nltl:independentFromHeadingMeans ;
                sh:minCount 1 ;
                sh:class nltl:nonMagneticHeadingMeans ;
                sh:nodeKind sh:IRI ;
                sh:message "Each non-magnetic heading means shall have an independence relation."
            ]
        ] ;
        sh:message "The ship shall have at least two non-magnetic heading means."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked non-magnetic heading means shall be independent from another distinct linked heading means on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?other .
                    FILTER (?other != ?means)
                    FILTER EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?other .
                    }
                }
            }
        """
    ] .
