@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-097> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The ship's low-air-temperature operating status must be recorded as false for this non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "When the ship operates in low air temperature, the rescue-boat or lifeboat release status must be recorded."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The ship must record that a rescue boat or lifeboat is released for evacuation."
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:node [
                    sh:property [
                        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
                        sh:minCount 1 ;
                        sh:message "Each released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
                    ] ;
                    sh:property [
                        sh:path nltl:survivalCraftHasLocationSignalDevice ;
                        sh:minCount 1 ;
                        sh:message "Each released rescue boat or lifeboat must carry at least one location-signal device."
                    ] ;
                    sh:property [
                        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
                        sh:minCount 1 ;
                        sh:message "Each released rescue boat or lifeboat must carry at least one on-scene transmit/receive communication device."
                    ]
                ]
            ]
        ]
    ) .
