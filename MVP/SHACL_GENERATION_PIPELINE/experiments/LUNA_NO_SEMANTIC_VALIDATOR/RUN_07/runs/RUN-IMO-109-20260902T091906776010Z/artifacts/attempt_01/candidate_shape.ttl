@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_109_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a Category A or B ship constructed on or after 2017-01-01, other than an oil tanker, carrying oil in its cargo tank, cargo tank separation from the outer shell must be at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:shipType ?shipType ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:cargoTankCarriesOil true .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    datatype(?shipType) = xsd:string
                    && ?shipType != "oil_tanker"^^xsd:string
                )
                FILTER (
                    datatype(?constructionDate) = xsd:date
                    && ?constructionDate >= "2017-01-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this rdf:type nltl:oilTanker
                }

                FILTER (
                    NOT EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?validQuantity .
                        ?validQuantity qudt:numericValue ?validValue ;
                                        qudt:unit unit:M .
                        FILTER (
                            datatype(?validValue) = xsd:decimal
                            && ?validValue >= "0.76"^^xsd:decimal
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:cargoTankOuterShellSeparation ?invalidQuantity .
                        ?invalidQuantity qudt:numericValue ?invalidValue ;
                                          qudt:unit unit:M .
                        FILTER (
                            datatype(?invalidValue) = xsd:decimal
                            && ?invalidValue < "0.76"^^xsd:decimal
                        )
                    }
                )
            }
        """
    ] .
