@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-116> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:notComminutedOrDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "When sewage is not comminuted or disinfected, MARPOL Annex IV regulation 11.1.1 compliance, the strict distance threshold, nearby ice concentration, and the distance from areas exceeding one tenth ice concentration must be recorded and conform." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?type ;
                      nltl:notComminutedOrDisinfected ?notComminuted .
                FILTER (
                    ?type = "not_comminuted_or_disinfected"^^xsd:string &&
                    ?notComminuted = true
                )
                FILTER NOT EXISTS {
                    $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?status ;
                          nltl:distanceToNearestIceShelfOrFastIce ?nearestDistance ;
                          nltl:nearbyIceConcentration ?nearbyConcentration ;
                          nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .

                    ?nearestDistance a qudt:QuantityValue ;
                                     qudt:numericValue ?nearestValue ;
                                     qudt:unit unit:MI_N .
                    ?nearbyConcentration a qudt:QuantityValue ;
                                         qudt:numericValue ?nearbyValue ;
                                         qudt:unit unit:UNITLESS .
                    ?areaDistance a qudt:QuantityValue ;
                                  qudt:numericValue ?areaValue ;
                                  qudt:unit unit:MI_N .

                    FILTER (
                        ?status = true &&
                        datatype(?nearestValue) = xsd:decimal &&
                        datatype(?nearbyValue) = xsd:decimal &&
                        datatype(?areaValue) = xsd:decimal &&
                        ?nearestValue > "12"^^xsd:decimal &&
                        ?nearbyValue > "1"^^xsd:decimal
                    )
                }
            }
        """
    ] .
