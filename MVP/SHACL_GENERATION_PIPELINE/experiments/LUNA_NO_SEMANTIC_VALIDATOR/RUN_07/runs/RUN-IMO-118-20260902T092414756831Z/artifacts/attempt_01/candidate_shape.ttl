@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-118> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine applicability of the sewage-discharge rule."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                    nltl:polarShipCategoryC
                ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:class nltl:passengerShip
        ]
    ) ;
    sh:property [
        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:message "Any represented paragraph 4.2.1.3 compliance status must be a boolean."
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:message "Any represented sewage-discharge value must be a boolean."
    ] ;
    sh:sparql [
        sh:message "For an applicable ship constructed on or after 1 January 2017, sewage discharge to sea must be false unless paragraph 4.2.1.3 compliance is true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate .
                FILTER (?constructionDate >= "2017-01-01"^^xsd:date)
                {
                    $this nltl:shipCategory ?category .
                    FILTER (?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                UNION
                {
                    $this a nltl:passengerShip .
                }
                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
                    FILTER (?status = true)
                }
                FILTER NOT EXISTS {
                    $this nltl:sewageDischargeToSea ?discharge .
                    FILTER (?discharge = false)
                }
            }
        """
    ] .
