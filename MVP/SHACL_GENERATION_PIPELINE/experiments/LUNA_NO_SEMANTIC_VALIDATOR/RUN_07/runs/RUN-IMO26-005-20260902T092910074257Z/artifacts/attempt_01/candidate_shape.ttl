@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-005-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:headingOrPositionSystem ;
                sh:minCount 1 ;
                sh:datatype xsd:string
            ] ;
            sh:property [
                sh:path nltl:intendedAreaSuitabilityApprovalStatus ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:evidenceState ;
                sh:in ( nltl:evidenceStateApproved )
            ]
        ]
        [
            sh:property [
                sh:path nltl:headingOrPositionSystem ;
                sh:maxCount 0
            ]
        ]
    ) ;
    sh:message "Each represented heading-reference or position-fixing system must have an approved intended-area suitability status." .
