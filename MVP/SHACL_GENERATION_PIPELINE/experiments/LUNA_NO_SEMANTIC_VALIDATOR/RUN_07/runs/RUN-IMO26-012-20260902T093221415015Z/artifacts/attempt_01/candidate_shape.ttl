@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO26_012_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When at least two non-magnetic heading means are represented, each must be typed, connected to main and emergency power, and independent from another distinct means of the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?m1 .
                $this nltl:hasNonMagneticHeadingMeans ?m2 .
                FILTER (?m1 != ?m2)

                $this nltl:hasNonMagneticHeadingMeans ?m .
                FILTER (
                    NOT EXISTS {
                        ?m a nltl:nonMagneticHeadingMeans .
                    }
                    ||
                    NOT EXISTS {
                        ?m nltl:connectedToMainPower ?mainPower .
                        ?mainPower a nltl:benchmarkEntity .
                    }
                    ||
                    NOT EXISTS {
                        ?m nltl:connectedToEmergencyPower ?emergencyPower .
                        ?emergencyPower a nltl:benchmarkEntity .
                    }
                    ||
                    NOT EXISTS {
                        ?m nltl:independentFromHeadingMeans ?other .
                        FILTER (?other != ?m)
                        $this nltl:hasNonMagneticHeadingMeans ?other .
                        ?other a nltl:nonMagneticHeadingMeans .
                    }
                )
            }
        """
    ] .
