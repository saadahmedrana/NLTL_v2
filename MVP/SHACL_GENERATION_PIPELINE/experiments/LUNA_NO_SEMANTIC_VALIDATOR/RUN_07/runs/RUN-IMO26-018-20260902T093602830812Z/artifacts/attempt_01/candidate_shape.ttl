@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_018_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Chapter 11-1 applicability must be recorded as a boolean."
    ] ;
    sh:or (
        gen:IMO26_018_NotApplicableBranch
        gen:IMO26_018_ApplicableBranch
    ) .

gen:IMO26_018_NotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue false ;
        sh:message "The non-applicable branch requires chapter 11-1 applicability to be false."
    ] .

gen:IMO26_018_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue true ;
        sh:message "The applicable branch requires chapter 11-1 applicability to be true."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When chapter 11-1 applies, route planning records must cover all nine clause 11-1.3 topics."
    ] ;
    sh:or (
        gen:IMO26_018_SmsImplementedBranch
        gen:IMO26_018_NoSmsBranch
    ) .

gen:IMO26_018_SmsImplementedBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The safety management system status must be recorded as implemented or not implemented."
    ] .

gen:IMO26_018_NoSmsBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:safetyManagementSystemImplemented ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The no-safety-management-system branch requires the status to be false."
    ] ;
    sh:property [
        sh:path nltl:documentedPolarOperationProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When no safety management system is implemented, a documented polar operation procedure is required."
    ] .
