@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "Construction stage date must be an xsd:date when provided."
    ] ;
    sh:property [
        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
        sh:datatype xsd:boolean ;
        sh:message "The owner request selector must be an xsd:boolean when provided."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A construction-stage date in the 1986-11-01 to 2003-08-31 cohort requires owner-request selector evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:ownerRequested2008EngineOutputRequirements ?request .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships in the specified construction-stage cohort must identify the 1985 Ice Class Rules as the applicable regulation edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRuleEdition1985 .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For the specified construction-stage cohort, engine output must reference the 2008 edition when requested and the 1985 rules otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:ownerRequested2008EngineOutputRequirements ?request .
                FILTER (
                    ?date >= "1986-11-01"^^xsd:date &&
                    ?date < "2003-09-01"^^xsd:date
                )
                FILTER (
                    (?request = true &&
                     NOT EXISTS {
                         $this nltl:engineOutputRegulationEdition
                             nltl:iceClassRegulationEdition2008 .
                     })
                    ||
                    (?request = false &&
                     NOT EXISTS {
                         $this nltl:engineOutputRegulationEdition
                             nltl:iceClassRuleEdition1985 .
                     })
                )
            }
        """
    ] .
