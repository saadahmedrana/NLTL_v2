@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF015Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF015NavigatingInIceShape
        gen:TRF015NotNavigatingInIceShape
    ) .

gen:TRF015CommonShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:intendedRouteSeaWaterSalinity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF015SalinityQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadingCalculationSeaWaterSalinity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF015SalinityQuantityShape
    ] ;
    sh:sparql [
        sh:message "The loading calculation salinity must equal the intended-route sea-water salinity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:intendedRouteSeaWaterSalinity ?intended ;
                      nltl:loadingCalculationSeaWaterSalinity ?loading .
                ?intended qudt:numericValue ?intendedValue ;
                          qudt:unit nltl:gramPerKilogramSalinityUnit .
                ?loading qudt:numericValue ?loadingValue ;
                         qudt:unit nltl:gramPerKilogramSalinityUnit .
                FILTER (?intendedValue != ?loadingValue)
            }
        """
    ] .

gen:TRF015SalinityQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:gramPerKilogramSalinityUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF015LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF015NavigatingInIceShape a sh:NodeShape ;
    sh:node gen:TRF015CommonShape ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship navigating in ice must record navigatingInIce as true."
    ] ;
    sh:property [
        sh:path nltl:operatingDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF015LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:operatingTrim ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF015LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF015LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumPermittedIceTrim ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF015LengthQuantityShape
    ] ;
    sh:sparql [
        sh:message "When navigating in ice, the operating draught and operating trim must not exceed their permitted limits." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:operatingDraught ?draught ;
                      nltl:upperIceWaterlineDraught ?uiwl ;
                      nltl:operatingTrim ?trim ;
                      nltl:maximumPermittedIceTrim ?maximumTrim .
                ?draught qudt:numericValue ?draughtValue .
                ?uiwl qudt:numericValue ?uiwlValue .
                ?trim qudt:numericValue ?trimValue .
                ?maximumTrim qudt:numericValue ?maximumTrimValue .
                FILTER (
                    ?draughtValue > ?uiwlValue ||
                    ?trimValue > ?maximumTrimValue
                )
            }
        """
    ] .

gen:TRF015NotNavigatingInIceShape a sh:NodeShape ;
    sh:node gen:TRF015CommonShape ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship not navigating in ice must record navigatingInIce as false."
    ] .
