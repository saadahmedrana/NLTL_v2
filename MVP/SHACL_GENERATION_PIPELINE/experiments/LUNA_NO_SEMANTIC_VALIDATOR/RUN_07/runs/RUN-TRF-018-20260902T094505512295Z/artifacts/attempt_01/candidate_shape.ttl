@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-018> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:hasValue nltl:iceClassIaSuper ]
            [ sh:hasValue nltl:iceClassIa ]
            [ sh:hasValue nltl:iceClassIb ]
            [ sh:hasValue nltl:iceClassIc ]
            [ sh:nodeKind sh:IRI ]
        ) ;
        sh:message "iceClass must be present so the applicable engine-output branch can be determined."
    ] ;
    sh:property [
        sh:path nltl:calculatedRequiredPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloW ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "calculatedRequiredPower must be provided as a single decimal quantity in kW."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:KiloW ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "maximumContinuousRatingPower must be provided as a single decimal quantity in kW."
    ] ;
    sh:sparql [
        sh:message "maximumContinuousRatingPower must be at least the calculated required power and at least 1000 kW for IA, IB, or IC, or at least 2800 kW for IA Super." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:calculatedRequiredPower ?calculatedQuantity ;
                      nltl:maximumContinuousRatingPower ?ratingQuantity .
                ?calculatedQuantity qudt:numericValue ?calculatedPower ;
                                    qudt:unit qudt:KiloW .
                ?ratingQuantity qudt:numericValue ?ratingPower ;
                                qudt:unit qudt:KiloW .
                FILTER (
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        (
                            ?ratingPower < ?calculatedPower ||
                            ?ratingPower < 2800
                        )
                    ) ||
                    (
                        ?iceClass IN (
                            nltl:iceClassIa,
                            nltl:iceClassIb,
                            nltl:iceClassIc
                        ) &&
                        (
                            ?ratingPower < ?calculatedPower ||
                            ?ratingPower < 1000
                        )
                    )
                )
            }
        """
    ] .
