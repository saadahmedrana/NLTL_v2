@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF024Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A non-IA or non-IA Super ice class is required to establish non-applicability."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIaSuper
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship must have ice class IA or IA Super for this conditional requirement."
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:maxInclusive "2003-08-31"^^xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "For ice class IA or IA Super, the keel-laying or equivalent construction date must be before 1 September 2003."
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The delivery date is required to determine the twenty-year compliance deadline."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The assessment date is required to evaluate the compliance deadline."
            ] ;
            sh:property [
                sh:path nltl:engineOutputComplianceMethod ;
                sh:hasValue nltl:traficom2017Section3Point2Point2Method ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship must comply with the requirements identified by the section 3.2.2 compliance method."
            ] ;
            sh:sparql [
                sh:message "Section 3.2.2 compliance must be established no later than 1 January of the year twenty years after delivery." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        BIND(YEAR(?delivery) + 20 AS ?deadlineYear)
                        FILTER (
                            YEAR(?assessment) < ?deadlineYear
                            ||
                            (
                                YEAR(?assessment) = ?deadlineYear
                                && MONTH(?assessment) = 1
                                && DAY(?assessment) = 1
                            )
                        )
                    }
                """
            ]
        ]
    ) .
