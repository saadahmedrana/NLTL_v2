@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path <http://qudt.org/schema/qudt/numericValue> ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path <http://qudt.org/schema/qudt/unit> ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF031Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldPoint ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingShearStress ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldShearStress ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:allowableShearStress ;
                sh:node gen:PressureQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Combined bending and shear stress must be lower than the yield point; yield shear stress must equal yield point divided by sqrt(3) within the stated tolerance; and, when beam theory is used, allowable shear stress must not exceed 0.9 times the yield shear stress." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldPointQuantity ;
                      nltl:combinedBendingShearStress ?combinedQuantity ;
                      nltl:yieldShearStress ?yieldShearQuantity .

                ?yieldPointQuantity
                    <http://qudt.org/schema/qudt/numericValue> ?yieldPoint .

                ?combinedQuantity
                    <http://qudt.org/schema/qudt/numericValue> ?combined .

                ?yieldShearQuantity
                    <http://qudt.org/schema/qudt/numericValue> ?yieldShear .

                FILTER (?combined >= ?yieldPoint)

                BIND ((?yieldPoint / 1.7320508075688772) AS ?expectedYieldShear)
                FILTER (
                    ABS(?yieldShear - ?expectedYieldShear) >
                    ((0.000001 * ABS(?expectedYieldShear)) + 0.000001)
                )

                OPTIONAL {
                    $this nltl:beamTheoryUsed true ;
                          nltl:allowableShearStress ?allowableQuantity .
                    ?allowableQuantity
                        <http://qudt.org/schema/qudt/numericValue> ?allowable .
                    FILTER (?allowable > (0.9 * ?expectedYieldShear))
                }
            }
        """
    ] .
