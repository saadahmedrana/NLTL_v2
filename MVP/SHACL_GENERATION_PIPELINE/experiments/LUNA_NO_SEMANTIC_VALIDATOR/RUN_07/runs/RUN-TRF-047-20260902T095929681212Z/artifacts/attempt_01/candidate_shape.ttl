@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_047_FrameShape a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame must identify its strengthened part."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:frameEnd ;
                    sh:property [
                        sh:path nltl:hasAttachedSupportingStructure ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:or (
                                [ sh:class nltl:deckStructure ]
                                [ sh:class nltl:tankBoundaryPlating ]
                                [ sh:class nltl:tankTop ]
                                [ sh:class nltl:iceStringer ]
                            )
                        ] ;
                        sh:message "The lower end must be attached to a permitted deck, tank plating, tank top, or ice stringer."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue nltl:intermediateIceFrame ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:mainFrameBelowIceBeltStrengthened ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:frameEnd ;
                    sh:property [
                        sh:path nltl:hasHorizontalConnectionMember ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:horizontalConnectionMember ;
                            sh:property [
                                sh:path nltl:connectsToAdjacentMainFrame ;
                                sh:minCount 1 ;
                                sh:node [
                                    sh:class nltl:mainFrame
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "The lower end must satisfy the required supporting-structure attachment or the permitted intermediate-frame horizontal-connection alternative."
.
