@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityCentiM3 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A section modulus quantity must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:CentiM3 ;
        sh:message "A section modulus quantity must use cm^3."
    ] .

gen:QuantityCentiM2 a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A shear area quantity must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:CentiM2 ;
        sh:message "A shear area quantity must use cm^2."
    ] .

gen:BaseScantlingRequirements a sh:NodeShape ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:node gen:QuantityCentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The actual section modulus is required."
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:node gen:QuantityCentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The required section modulus is required."
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:node gen:QuantityCentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The actual shear area is required."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:QuantityCentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The required shear area is required."
    ] ;
    sh:sparql [
        sh:message "The actual section modulus and shear area must each be at least their required value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualZNode .
                ?actualZNode qudt:numericValue ?actualZ .
                $this nltl:requiredSectionModulus ?requiredZNode .
                ?requiredZNode qudt:numericValue ?requiredZ .
                $this nltl:actualShearArea ?actualANode .
                ?actualANode qudt:numericValue ?actualA .
                $this nltl:requiredShearArea ?requiredANode .
                ?requiredANode qudt:numericValue ?requiredA .
                FILTER(?actualZ < ?requiredZ || ?actualA < ?requiredA)
            }
        """
    ] .

gen:VeryLongHatchException a sh:NodeShape ;
    sh:node gen:BaseScantlingRequirements ;
    sh:property [
        sh:path nltl:permittedReducedLineLoad ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:KiloN-PER-M
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An approved very-long-hatch exception must specify one permitted reduced line load in kN/m."
    ] ;
    sh:property [
        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The reduced line load must be approved by the classification society."
    ] ;
    sh:sparql [
        sh:message "For an approved very-long-hatch exception, the permitted reduced line load must be at least 0.10 kN/m and less than 0.15 kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:permittedReducedLineLoad ?loadNode .
                ?loadNode qudt:numericValue ?load .
                FILTER(?load < 0.10 || ?load >= 0.15)
            }
        """
    ] .

gen:ApplicableOrdinary a sh:NodeShape ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ordinary applicable branch requires the hatch not to be very long."
    ] ;
    sh:node gen:BaseScantlingRequirements .

gen:ApplicableVeryLong a sh:NodeShape ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The very-long-hatch branch requires an explicit true applicability value."
    ] ;
    sh:node gen:VeryLongHatchException .

gen:ApplicableNarrowDeckStrip a sh:NodeShape ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:or (
        gen:ApplicableOrdinary
        gen:ApplicableVeryLong
    ) .

gen:NotApplicableNarrowDeckStrip a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .

gen:TRF055NarrowDeckStripShape a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:or (
        gen:NotApplicableNarrowDeckStrip
        gen:ApplicableNarrowDeckStrip
    ) .
