@prefix gen: <urn:nltl:generated-shape:TRF-076:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LoadCase1Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1 ;
        sh:minCount 1
    ] .

gen:LoadCase2Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2 ;
        sh:minCount 1
    ] .

gen:LoadCase3Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3 ;
        sh:minCount 1
    ] .

gen:LoadCase4Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:minCount 1
    ] .

gen:LoadCase5Shape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5 ;
        sh:minCount 1
    ] .

gen:CPPropellerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:hasValue "CP"
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase1Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase2Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase3Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase4Shape ;
        sh:qualifiedMinCount 1
    ] .

gen:FPReversingPropellerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:hasValue "FP"
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase1Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase2Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase3Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase4Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase5Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must cover propeller blade load case 5."
    ] .

gen:FPNonReversingPropellerShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:hasValue "FP"
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase1Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase2Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase3Shape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:LoadCase4Shape ;
        sh:qualifiedMinCount 1
    ] .

gen:TRF076Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:CPPropellerShape
        gen:FPReversingPropellerShape
        gen:FPNonReversingPropellerShape
    ) ;
    sh:message "The ship must cover load cases 1-4 for CP or FP propellers; a reversing FP propeller must also cover load case 5."
    .
