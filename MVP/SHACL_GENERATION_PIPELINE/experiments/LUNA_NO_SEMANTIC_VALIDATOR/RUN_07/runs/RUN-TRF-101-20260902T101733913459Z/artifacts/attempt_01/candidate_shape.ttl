@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF101BladeFailureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:class nltl:approvalRecord
    ] ;

    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:node gen:LengthInMetres ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:node gen:LengthInMetres ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:node gen:LengthInMetres ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:node gen:StressInMegaPascals ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:node gen:StressInMegaPascals ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:node gen:StressInMegaPascals ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:node gen:LengthInMetres ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node gen:LengthInMetres ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:node gen:ForceInKiloNewtons ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "bladeFailureStatus must be recorded and must match the blade-tip-offset failure condition"
    ] ;

    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:node gen:BladeFailureLoadCase ;
        sh:minCount 1
    ] ;

    sh:sparql [
        sh:message "Without an approved nonlinear blade stress analysis, bladeReferenceStrength1 must equal 0.6 times bladeMinimumYieldStrength plus 0.4 times bladeUltimateTensileStrength within numerical tolerance, and bladeFailureUltimateLoad must satisfy the prescribed formula" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:approvedNonlinearBladeStressAnalysis ?analysis .
                }

                $this nltl:bladeChordLengthAtWeakestSection ?cNode ;
                      nltl:bladeCylindricalRootRadius ?rNode ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                      nltl:bladeMinimumYieldStrength ?yNode ;
                      nltl:bladeUltimateTensileStrength ?uNode ;
                      nltl:bladeReferenceStrength1 ?refNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:bladeFailureUltimateLoad ?fNode .

                ?cNode qudt:numericValue ?c ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?rNode qudt:numericValue ?r ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?tNode qudt:numericValue ?t ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?yNode qudt:numericValue ?y ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?uNode qudt:numericValue ?u ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?refNode qudt:numericValue ?ref ;
                        qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?dNode qudt:numericValue ?d ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?fNode qudt:numericValue ?f ;
                       qudt:unit <http://qudt.org/vocab/unit/KiloN> .

                BIND ((0.6 * ?y) + (0.4 * ?u) AS ?expectedRef)
                BIND ((300 * ?c * ?t * ?t * ?expectedRef) / ((0.8 * ?d) - (2 * ?r)) AS ?expectedF)

                FILTER (
                    ABS(?ref - ?expectedRef) >
                    (0.000001 + (0.000001 * ABS(?expectedRef)))
                    ||
                    ABS(?f - ?expectedF) >
                    (0.000001 + (0.000001 * ABS(?expectedF)))
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "bladeFailureStatus must be true when bladeTipOffset exceeds 10 percent of propellerDiameter, and false otherwise" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?tipNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeFailureStatus ?status .

                ?tipNode qudt:numericValue ?tip ;
                         qudt:unit <http://qudt.org/vocab/unit/M> .
                ?diameterNode qudt:numericValue ?diameter ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (
                    (?tip > (0.10 * ?diameter) && ?status != true)
                    ||
                    (?tip <= (0.10 * ?diameter) && ?status != false)
                )
            }
        """
    ] .

gen:BladeFailureLoadCase
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:node gen:UnitlessQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The blade failure load application radius ratio must be exactly 0.8" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bladeFailureLoadApplicationRadiusRatio ?ratioNode .
                ?ratioNode qudt:numericValue ?ratio ;
                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (?ratio < 0.8 || ?ratio > 0.8)
            }
        """
    ] .

gen:LengthInMetres
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:StressInMegaPascals
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ForceInKiloNewtons
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.8 ;
        sh:maxInclusive 0.8
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
