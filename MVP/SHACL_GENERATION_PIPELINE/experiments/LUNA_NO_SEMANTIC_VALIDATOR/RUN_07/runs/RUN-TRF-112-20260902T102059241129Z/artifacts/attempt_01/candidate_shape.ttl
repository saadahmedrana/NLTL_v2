@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-112-ComplexReadinessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:message "A propeller shaft line component is required for the blade-failure yielding assessment."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:class nltl:shaftLineLoadCaseTypeValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The propulsion load case must identify its shaft-line load-case type."
            ]
        ] ;
        sh:message "A propulsion load case is required for the blade-failure yielding assessment."
    ] ;
    sh:sparql [
        sh:message "For an applicable total-blade-failure load case, the externally calculated ultimate and combined axial, bending, and torsion load inputs must be present in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                FILTER NOT EXISTS {
                    ?loadCase nltl:bladeFailureUltimateLoad ?ultimateLoad .
                    ?ultimateLoad qudt:numericValue ?ultimateValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER ( DATATYPE(?ultimateValue) = xsd:decimal )
                }
                FILTER NOT EXISTS {
                    ?loadCase nltl:combinedAxialBendingTorsionLoad ?combinedLoad .
                    ?combinedLoad qudt:numericValue ?combinedValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER ( DATATYPE(?combinedValue) = xsd:decimal )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an applicable total-blade-failure load case, every linked propeller shaft line component must provide externally calculated bending and torsional yield safety factors of at least 1.0." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER NOT EXISTS {
                    ?component nltl:bendingYieldSafetyFactor ?bendingFactor .
                    ?bendingFactor qudt:numericValue ?bendingValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        DATATYPE(?bendingValue) = xsd:decimal &&
                        ?bendingValue >= 1.0
                    )
                }
                FILTER NOT EXISTS {
                    ?component nltl:torsionalYieldSafetyFactor ?torsionalFactor .
                    ?torsionalFactor qudt:numericValue ?torsionalValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        DATATYPE(?torsionalValue) = xsd:decimal &&
                        ?torsionalValue >= 1.0
                    )
                }
            }
        """
    ] .
