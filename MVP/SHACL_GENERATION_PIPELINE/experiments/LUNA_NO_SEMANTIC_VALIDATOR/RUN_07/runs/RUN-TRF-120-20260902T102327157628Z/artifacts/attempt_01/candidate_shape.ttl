@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF120ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damping ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide damping for thruster global natural-frequency estimation."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented thruster natural-frequency calculation must account for damping, water added mass, ship attachment stiffness, and thruster natural frequency." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?thrusterBody .
                ?thrusterBody rdf:type nltl:thrusterBody ;
                    nltl:hasNaturalFrequencyCalculationCase ?case .
                ?case rdf:type nltl:calculationCase ;
                    nltl:vibrationDirection ?direction .
                FILTER NOT EXISTS {
                    $this nltl:damping ?damping .
                    ?thrusterBody nltl:waterAddedMass ?mass ;
                        nltl:shipAttachmentStiffness ?stiffness ;
                        nltl:thrusterNaturalFrequency ?frequency .
                    ?mass qudt:numericValue ?massValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloGM> .
                    ?stiffness qudt:numericValue ?stiffnessValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloN-PER-M> .
                    ?frequency qudt:numericValue ?frequencyValue ;
                        qudt:unit <http://qudt.org/vocab/unit/HZ> .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Thruster global natural-frequency estimation must represent both longitudinal and transverse directions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?thrusterBody .
                ?thrusterBody rdf:type nltl:thrusterBody ;
                    nltl:hasNaturalFrequencyCalculationCase ?case .
                FILTER NOT EXISTS {
                    ?thrusterBody nltl:hasNaturalFrequencyCalculationCase ?longitudinalCase .
                    ?longitudinalCase nltl:vibrationDirection nltl:longitudinalDirection .
                }
                FILTER NOT EXISTS {
                    ?thrusterBody nltl:hasNaturalFrequencyCalculationCase ?transverseCase .
                    ?transverseCase nltl:vibrationDirection nltl:transverseDirection .
                }
            }
        """
    ] .

g:TRF120ThrusterBodyShape a sh:NodeShape ;
    sh:targetClass nltl:thrusterBody ;
    sh:property [
        sh:path nltl:waterAddedMass ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloGM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipAttachmentStiffness ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:thrusterNaturalFrequency ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/HZ> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:node g:TRF120CalculationCaseShape
    ] .

g:TRF120CalculationCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:longitudinalDirection
            nltl:transverseDirection
        ) ;
        sh:message "A natural-frequency calculation case must identify a longitudinal or transverse vibration direction."
    ] .
