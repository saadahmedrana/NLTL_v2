@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_006_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements"
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements"
            ]
        ]
    ) ;
    sh:message "The ship's astern-in-ice applicability and, when applicable, aft-section design basis must conform to I2.2.6." .
