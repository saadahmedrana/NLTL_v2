@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-011-ForceMN> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-011-ForceKN> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-011-ShapeCoefficient> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.6"^^xsd:decimal ;
        sh:maxInclusive "0.6"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-011-LoadPatchAspectRatio> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.3"^^xsd:decimal ;
        sh:maxInclusive "1.3"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-011-Applicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:hasValue true ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:node <urn:nltl:generated-shape:I2-011-ForceMN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The I2.3.2.1(iii) bow design force is required in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:node <urn:nltl:generated-shape:I2-011-ForceMN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The I2.3.2.1(iv) bow design force is required in MN."
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node <urn:nltl:generated-shape:I2-011-ShapeCoefficient> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The shape coefficient fa must be 0.6 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node <urn:nltl:generated-shape:I2-011-LoadPatchAspectRatio> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The load patch aspect ratio AR must be 1.3 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:node <urn:nltl:generated-shape:I2-011-ForceKN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The bow design force is required in kN."
    ] ;
    sh:sparql [
        sh:message "The bow design force must equal the I2.3.2.1(iv) force within a relative tolerance of 1e-6 with a 1e-6 MN absolute fallback, and must not be less than the I2.3.2.1(iii) force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bowDesignForce ?resultQ ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiQ ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivQ .

                ?resultQ qudt:numericValue ?resultValue ;
                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?iiiQ qudt:numericValue ?iiiValue ;
                      qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                ?ivQ qudt:numericValue ?ivValue ;
                     qudt:unit <http://qudt.org/vocab/unit/MegaN> .

                FILTER (
                    (?resultValue * "0.001"^^xsd:decimal) <
                    ?iiiValue
                    ||
                    ABS(
                        (?resultValue * "0.001"^^xsd:decimal) - ?ivValue
                    ) >
                    (
                        "0.000001"^^xsd:decimal * ABS(?ivValue) +
                        "0.000001"^^xsd:decimal
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-011-NotApplicable> a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:hasValue false ;
        sh:datatype xsd:boolean
    ] .

<urn:nltl:generated-shape:I2-011-Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:I2-011-NotApplicable>
        <urn:nltl:generated-shape:I2-011-Applicable>
    ) .
