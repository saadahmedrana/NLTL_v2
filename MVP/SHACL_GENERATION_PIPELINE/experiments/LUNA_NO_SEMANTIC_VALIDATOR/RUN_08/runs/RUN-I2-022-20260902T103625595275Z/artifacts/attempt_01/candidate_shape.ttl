@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-022-QuantityValue>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "A quantity value must contain one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A quantity value must contain one unit."
    ] .

<urn:nltl:generated-shape:I2-022-AverageIcePressure>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-PeakPressureFactor>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-YieldStrength>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-LoadPatchHeight>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-FrameSpacing>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-SelectedHullAreaFactor>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-IceLoadRequiredNetPlateThickness>
    a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-StructuralMember>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-FrameSpacing>
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-SelectedHullAreaFactor>
    ] .

<urn:nltl:generated-shape:I2-022-ApplicablePlating>
    a sh:NodeShape ;
    sh:sparql [
        sh:message "For an applicable plating, framing angle omega must be at least 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:framingAngleOmega ?angle .
                ?angle qudt:numericValue ?value .
                FILTER ( ?value >= 70 )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-AverageIcePressure>
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-PeakPressureFactor>
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-YieldStrength>
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-LoadPatchHeight>
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-IceLoadRequiredNetPlateThickness>
    ] .

<urn:nltl:generated-shape:I2-022-NonApplicablePlating>
    a sh:NodeShape ;
    sh:sparql [
        sh:message "This plating is non-applicable because its framing angle omega is below 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:framingAngleOmega ?angle .
                ?angle qudt:numericValue ?value .
                FILTER ( ?value < 70 )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-022-Plating>
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-QuantityValue> ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:property [
        sh:path nltl:platingHullAreaClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        )
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-StructuralMember>
    ] ;
    sh:or (
        <urn:nltl:generated-shape:I2-022-ApplicablePlating>
        <urn:nltl:generated-shape:I2-022-NonApplicablePlating>
    ) .

<urn:nltl:generated-shape:I2-022-Ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-Plating> ;
        sh:message "The ship must provide the linked plating applicability, model relationships, and readiness information."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-AverageIcePressure>
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-PeakPressureFactor>
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-YieldStrength>
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-022-LoadPatchHeight>
    ] .
