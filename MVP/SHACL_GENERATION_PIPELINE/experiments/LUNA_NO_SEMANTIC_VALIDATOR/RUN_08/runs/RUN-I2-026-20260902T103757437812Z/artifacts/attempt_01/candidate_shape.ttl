@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:StructuralMemberShape
    ] .

gs:StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:node gs:MemberSupportShape
    ] ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:fixedFrameSupport
            nltl:simpleFrameSupport
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:simpleFrameSupport
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:fixedFrameSupport
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:continuousThroughSupport ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasMemberSupport ;
                        sh:node [
                            sh:property [
                                sh:path nltl:connectionBracketPresent ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:hasValue true
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:demonstratedRotationalRestraint ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:significantRotationalRestraintEvidence ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI
                    ]
                ]
            )
        ]
    ) ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A member terminating within an ice-strengthened area, or relying on demonstrated rotational restraint, must use fixed frame support." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameSupportCondition ?condition .
                FILTER (
                    ?condition != nltl:fixedFrameSupport
                    &&
                    (
                        EXISTS {
                            $this nltl:terminatesWithinIceStrengthenedArea true^^xsd:boolean
                        }
                        ||
                        EXISTS {
                            $this nltl:demonstratedRotationalRestraint true^^xsd:boolean
                        }
                    )
                )
            }
        """
    ] .

gs:MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:nodeKind sh:IRI
    ] .
