@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:memberInstability ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Each structural member associated with a cutout must identify that it is in way of the cutout." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                FILTER NOT EXISTS {
                    ?member nltl:memberInWayOfCutout ?inWay .
                    FILTER (
                        datatype(?inWay) = xsd:boolean &&
                        ?inWay = true
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each structural member associated with a cutout must have a boolean stiffening-necessity determination." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                FILTER NOT EXISTS {
                    ?member nltl:stiffeningNecessary ?necessary .
                    FILTER (datatype(?necessary) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Loads carried by members in way of cutouts must not cause instability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                FILTER NOT EXISTS {
                    $this nltl:memberInstability ?instability .
                    FILTER (
                        datatype(?instability) = xsd:boolean &&
                        ?instability = false
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A structural stiffening description is required where stiffening is necessary for a member in way of a cutout." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                ?member nltl:stiffeningNecessary ?necessary .
                FILTER (
                    datatype(?necessary) = xsd:boolean &&
                    ?necessary = true
                )
                FILTER NOT EXISTS {
                    $this nltl:structuralStiffening ?stiffening .
                    FILTER (datatype(?stiffening) = xsd:string)
                }
            }
        """
    ] .

gen:I2_060_StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:sparql [
        sh:message "A referenced cutout must be typed as a cutout." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this nltl:hasCutout ?cutout .
                FILTER NOT EXISTS {
                    ?cutout rdf:type nltl:cutout .
                }
            }
        """
    ] .
