@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_064_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_064_YieldStrengthShape ;
        sh:message "The ship must provide one yield-strength value in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_064_CalculationCaseShape ;
        sh:message "The ship must provide an applicable calculation case."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_064_StructuralMemberShape
    ] .

gen:I2_064_YieldStrengthShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_064_CalculationCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:minCount 1 ;
        sh:hasValue nltl:linearCalculationMethodValue ;
        sh:message "The calculation case must identify the linear calculation method."
    ] .

gen:I2_064_StructuralMemberShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The structural member must confirm that the applicable buckling criteria are satisfied."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberWeb ;
        sh:node gen:I2_064_WebShape
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberFlange ;
        sh:node gen:I2_064_FlangeShape
    ] .

gen:I2_064_WebShape a sh:NodeShape ;
    sh:class nltl:structuralMemberWeb ;
    sh:property [
        sh:path nltl:nominalShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_064_StressQuantityShape ;
        sh:message "The structural member web must provide one nominal shear-stress value in MPa."
    ] ;
    sh:sparql [
        sh:message "Nominal shear stress in the web must be less than yield strength divided by sqrt(3)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb $this .
                ?ship nltl:yieldStrength ?yieldQuantity .
                $this nltl:nominalShearStress ?stressQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                ?stressQuantity qudt:numericValue ?stressValue .
                FILTER (?stressValue >= (?yieldValue / 1.7320508075688772))
            }
        """
    ] .

gen:I2_064_FlangeShape a sh:NodeShape ;
    sh:class nltl:structuralMemberFlange ;
    sh:property [
        sh:path nltl:nominalFlangeVonMisesStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_064_StressQuantityShape ;
        sh:message "The structural member flange must provide one nominal von Mises-stress value in MPa."
    ] ;
    sh:sparql [
        sh:message "Nominal von Mises stress in the flange must be less than 1.15 times yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange $this .
                ?ship nltl:yieldStrength ?yieldQuantity .
                $this nltl:nominalFlangeVonMisesStress ?stressQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                ?stressQuantity qudt:numericValue ?stressValue .
                FILTER (?stressValue >= (1.15 * ?yieldValue))
            }
        """
    ] .

gen:I2_064_StressQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
