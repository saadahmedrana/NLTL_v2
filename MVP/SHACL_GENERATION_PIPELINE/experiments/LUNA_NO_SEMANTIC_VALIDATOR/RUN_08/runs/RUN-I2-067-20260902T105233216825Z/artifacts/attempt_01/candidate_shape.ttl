@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_067_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:structuralConnection ;
        sh:node gen:I2_067_StructuralConnectionShape
    ] .

gen:I2_067_StructuralConnectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:strengthContinuityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each structural connection must have strength continuity ensured."
    ] .
