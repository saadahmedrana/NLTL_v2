@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-007-OpenWaterIceCondition>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:hasValue nltl:openWaterIceCondition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship's ice condition classification must be open water for this branch."
            ] ;
            sh:property [
                sh:path nltl:seaIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:maxExclusive 1 ;
                        sh:message "For open water, sea ice concentration must be less than 1/10."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Sea ice concentration must use the unitless unit."
                    ]
                ] ;
                sh:message "Sea ice concentration is required and must be less than 1/10 for open water."
            ] ;
            sh:property [
                sh:path nltl:iceOfLandOriginPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "No ice of land origin may be present for open water."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:in (
                    nltl:iceConditionLessSevereThanCategoryAAndB
                    nltl:iceFreeIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                    nltl:thinFirstYearIceWithPossibleOldIceInclusions
                    nltl:otherWatersIceCondition
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ship's ice condition classification must identify a non-open-water condition when the open-water branch does not apply."
            ]
        ]
    ) ;
    sh:message "The ship must provide an ice condition classification and satisfy the open-water limits when classified as open water." .
