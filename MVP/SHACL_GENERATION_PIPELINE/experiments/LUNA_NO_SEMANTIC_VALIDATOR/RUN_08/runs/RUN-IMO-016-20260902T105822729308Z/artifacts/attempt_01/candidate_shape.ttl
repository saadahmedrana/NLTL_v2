@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_016_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:node gen:IMO_016_CertificateShape ;
        sh:message "The ship shall have a Polar Ship Certificate corresponding to the Appendix I model."
    ] ;
    sh:property [
        sh:path nltl:certificateLanguage ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Polar Ship Certificate language shall be recorded exactly once."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:in (
                    "English"^^xsd:string
                    "French"^^xsd:string
                    "Spanish"^^xsd:string
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:certificateLanguage ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:approvedTranslationPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "A certificate in a language other than English, French, or Spanish shall include an approved translation into one of those languages."
            ] ;
            sh:sparql [
                sh:message "The translation obligation branch applies only when the certificate language is outside English, French, and Spanish." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:certificateLanguage ?language .
                        FILTER (
                            ?language IN (
                                "English"^^xsd:string,
                                "French"^^xsd:string,
                                "Spanish"^^xsd:string
                            )
                        )
                    }
                """
            ]
        ]
    ) .

gen:IMO_016_CertificateShape a sh:NodeShape ;
    sh:class nltl:polarShipCertificateForm ;
    sh:property [
        sh:path nltl:certificateFormModel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:appendixIPolarShipCertificateModel ;
        sh:message "The Polar Ship Certificate shall use the model given in Appendix I."
    ] .
