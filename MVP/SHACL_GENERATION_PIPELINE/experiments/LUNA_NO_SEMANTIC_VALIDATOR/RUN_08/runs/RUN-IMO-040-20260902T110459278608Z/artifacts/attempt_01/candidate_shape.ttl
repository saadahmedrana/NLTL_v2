@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:IMO_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "iceAccretionLikely must be recorded as false when the conditional requirement does not apply."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "iceAccretionLikely must be recorded as true when the conditional requirement applies."
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:node nltlg:IMO_040_RelevantHatchOrDoorShape
            ]
        ]
    ) ;
    sh:message "The ice-accretion condition must be explicitly recorded, and when true every relevant hatch or door must have associated ice or snow removal or prevention means." .

nltlg:IMO_040_RelevantHatchOrDoorShape
    a sh:NodeShape ;
    sh:class nltl:relevantHatchOrDoorItem ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:message "Each relevant hatch or door must have associated ice or snow removal or prevention means when ice accretion is likely."
    ] .
