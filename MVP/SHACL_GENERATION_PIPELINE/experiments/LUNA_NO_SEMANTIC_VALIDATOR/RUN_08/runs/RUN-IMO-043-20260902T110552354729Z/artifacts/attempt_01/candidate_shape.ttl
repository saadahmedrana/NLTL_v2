@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-043_ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hazardProtectionCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall declare hazard protection coverage."
    ] ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:machineryInstallationItem
    ] .

<urn:nltl:generated-shape:IMO-043_MachineryInstallationShape> a sh:NodeShape ;
    sh:targetClass nltl:machineryInstallationItem ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:class nltl:applicableHazardValue ;
        sh:in (
            nltl:iceAccretionHazard
            nltl:snowAccumulationHazard
            nltl:seawaterIceIngestionHazard
            nltl:liquidFreezingOrViscosityIncreaseHazard
            nltl:seawaterIntakeTemperatureHazard
            nltl:snowIngestionHazard
        ) ;
        sh:message "Each machinery installation shall identify its applicable permitted hazards."
    ] ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:associatedEquipmentItem
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each machinery installation shall have hazard protection evidence."
    ] .
