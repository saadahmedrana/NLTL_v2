@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO047Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEssentialEngine ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:essentialEngine ;
        sh:message "Each linked essential engine must be represented as an essentialEngine resource."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperatureControlPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Combustion air temperature control must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:DEG_C
            ]
        ] ;
        sh:message "Combustion air temperature must be supplied as a single degree-Celsius quantity."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMinAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:DEG_C
            ]
        ] ;
        sh:message "The manufacturer's minimum air temperature criterion must be supplied as a single degree-Celsius quantity."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMaxAirTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:DEG_C
            ]
        ] ;
        sh:message "The manufacturer's maximum air temperature criterion must be supplied as a single degree-Celsius quantity."
    ] ;
    sh:sparql [
        sh:message "Combustion air temperature must be within the manufacturer's minimum and maximum criteria." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:combustionAirTemperature ?observedQuantity .
  ?observedQuantity qudt:numericValue ?observed ;
                    qudt:unit qudt:DEG_C .
  $this nltl:manufacturerMinAirTemperature ?minimumQuantity .
  ?minimumQuantity qudt:numericValue ?minimum ;
                   qudt:unit qudt:DEG_C .
  $this nltl:manufacturerMaxAirTemperature ?maximumQuantity .
  ?maximumQuantity qudt:numericValue ?maximum ;
                   qudt:unit qudt:DEG_C .
  FILTER (
    ?observed >= ?minimum &&
    ?observed <= ?maximum
  )
}
"""
    ] .
