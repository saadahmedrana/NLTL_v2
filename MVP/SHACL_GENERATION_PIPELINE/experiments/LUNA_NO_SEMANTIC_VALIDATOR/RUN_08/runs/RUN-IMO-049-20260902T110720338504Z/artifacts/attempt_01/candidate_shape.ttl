@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO049ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gs:IMO049CategoryAShape
        gs:IMO049CategoryBShape
        gs:IMO049CategoryCShape
    ) .

gs:IMO049CategoryAShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryA
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gs:IMO049CategoryABComponentShape
    ] .

gs:IMO049CategoryBShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryB
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gs:IMO049CategoryABComponentShape
    ] .

gs:IMO049CategoryCShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryC
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gs:IMO049CategoryCComponentShape
    ] .

gs:IMO049ComponentTypeShape a sh:PropertyShape ;
    sh:path nltl:machineryComponentType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in (
        "propeller blade"
        "propulsion-line"
        "steering equipment"
        "appendage"
    ) .

gs:IMO049CategoryABComponentShape a sh:NodeShape ;
    sh:property gs:IMO049ComponentTypeShape ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:node gs:IMO049CategoryABApprovalShape
    ] .

gs:IMO049CategoryCComponentShape a sh:NodeShape ;
    sh:property gs:IMO049ComponentTypeShape ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:node gs:IMO049CategoryCApprovalShape
    ] .

gs:IMO049CategoryABApprovalShape a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:message "Each applicable scantling approval record must be approved, use an authorized authority, and identify an acceptable or equivalent-safety standard." .

gs:IMO049CategoryCApprovalShape a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:IMO049IceConcentrationQuantityShape
    ] ;
    sh:message "Each applicable ice-strengthened Category C scantling approval record must be approved, identify an authorized authority and acceptable standard, and include operating ice type and concentration." .

gs:IMO049IceConcentrationQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .
