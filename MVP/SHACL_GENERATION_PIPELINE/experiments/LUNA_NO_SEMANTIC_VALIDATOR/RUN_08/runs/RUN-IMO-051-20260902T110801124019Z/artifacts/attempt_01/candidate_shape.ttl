@prefix generated: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

generated:IMO051ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLocalControlItem ;
        sh:node generated:IMO051LocalControlItemShape ;
        sh:message "Each linked local control item shall satisfy the freezing and accessibility requirements."
    ] .

generated:IMO051LocalControlItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:localControlProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The local control item shall have freezing, snow, and ice protection."
    ] ;
    sh:property [
        sh:path nltl:localControlContinuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The local control item shall remain continuously accessible."
    ] .
