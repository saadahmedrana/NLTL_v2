@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO26_014_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The daylight operating profile must be recorded as false when the ship requires illumination means for visual ice detection."
            ] ;
            sh:property [
                sh:path nltl:visualIceDetectionIlluminationMeansCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 2 ;
                sh:message "A ship not operating solely in continuous daylight must have at least two means of illumination to aid visual detection of ice."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .
