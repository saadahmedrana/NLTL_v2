@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-015> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Applicable ;
        sh:datatype xsd:boolean ;
        sh:message "Polar Code chapter 11 applicability must be a Boolean value."
    ] ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean ;
        sh:message "SOLAS chapter I certification status must be a Boolean value."
    ] ;
    sh:sparql [
        sh:message "Polar Code chapter 11 may apply only to a ship certified in accordance with SOLAS chapter I." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter11Applicable ?applicable .
                FILTER (?applicable = true)
                FILTER NOT EXISTS {
                    $this nltl:solasChapterICertified ?certified .
                    FILTER (?certified = true)
                }
            }
        """
    ] .
