@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship's polar-waters operating status is required to determine Chapter 11-1 applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Chapter 11-1 applicability shall be recorded as true for a qualifying ship operating in polar waters."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipType ;
                        sh:datatype xsd:string ;
                        sh:hasValue "fishing_vessel"
                    ] ;
                    sh:property [
                        sh:path nltl:lengthOverall ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive 24
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:M
                            ]
                        ] ;
                        sh:message "A fishing vessel operating in polar waters shall have a length overall of at least 24 m for Chapter 11-1 applicability."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shipType ;
                        sh:datatype xsd:string ;
                        sh:hasValue "pleasure_yacht"
                    ] ;
                    sh:property [
                        sh:path nltl:grossTonnage ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive 300
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS
                            ]
                        ] ;
                        sh:message "A pleasure yacht operating in polar waters shall have a gross tonnage of at least 300 for Chapter 11-1 applicability."
                    ] ;
                    sh:property [
                        sh:path nltl:engagedInTrade ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:shipType ;
                        sh:datatype xsd:string ;
                        sh:hasValue "cargo_ship"
                    ] ;
                    sh:property [
                        sh:path nltl:grossTonnage ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive 300 ;
                                sh:maxExclusive 500
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS
                            ]
                        ] ;
                        sh:message "A cargo ship operating in polar waters shall have a gross tonnage of at least 300 and below 500 for Chapter 11-1 applicability."
                    ]
                ]
            )
        ]
    ) .
