@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_017_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO26_017_ApplicableBranch
        gen:IMO26_017_NotApplicableBranch
    ) .

gen:IMO26_017_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Chapter 11-1 applicability must be recorded as true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "When Chapter 11-1 is applicable, a voyage plan must be present."
    ] ;
    sh:property [
        sh:path nltl:intendedVoyageHazard ;
        sh:datatype xsd:string ;
        sh:message "Each intended voyage hazard must be recorded as a string."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanCoverage ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "When Chapter 11-1 is applicable, the voyage plan must cover every intended voyage hazard."
    ] .

gen:IMO26_017_NotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "Chapter 11-1 applicability must be recorded as false for the non-applicable branch."
    ] .
