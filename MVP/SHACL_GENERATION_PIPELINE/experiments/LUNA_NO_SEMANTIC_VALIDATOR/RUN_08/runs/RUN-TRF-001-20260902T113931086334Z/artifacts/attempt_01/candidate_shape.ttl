@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
        sh:minCount 1 ;
        sh:message "The 2021 chapter 2 Ice Class Draught provision must apply to the ship."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
        sh:minCount 1 ;
        sh:message "The 2021 section 1.8 Ice Classes provision must apply to the ship."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxInclusive "2021-07-04"^^xsd:date ;
                sh:message "The construction contract date must be before 5 July 2021 for the non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2021-07-05"^^xsd:date ;
                sh:message "The construction contract date must be on or after 5 July 2021 for the applicable branch."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRegulationEdition2021 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ships contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations."
            ]
        ]
    ) .
