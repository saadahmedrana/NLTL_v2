@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF004Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2010-01-01"^^xsd:date ;
                sh:maxExclusive "2012-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2008 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassRegulationEditionValue ;
                sh:minCount 1 ;
                sh:message "Ships contracted from 1 January 2010 to before 1 January 2012 shall identify the 2008 Ice Class Regulations as the applicable edition."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxExclusive "2010-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2012-01-01"^^xsd:date
            ]
        ]
    ) ;
    sh:message "The construction contract date must establish whether the 2008 Ice Class Regulations apply." .
