@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF009Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF009NonApplicableShape
        gen:TRF009ApplicableShape
    ) .

gen:TRF009NonApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For ice class IA or IA Super, construction stage date must establish that construction was reached on or after 1 September 2003, or the applicable deadline branch must be satisfied." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (
                    nltl:iceClassIa,
                    nltl:iceClassIaSuper
                ))
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionStageDate ?stageDate .
                        FILTER (
                            datatype(?stageDate) = xsd:date &&
                            (
                                YEAR(?stageDate) > 2003 ||
                                (
                                    YEAR(?stageDate) = 2003 &&
                                    (
                                        MONTH(?stageDate) > 9 ||
                                        (
                                            MONTH(?stageDate) = 9 &&
                                            DAY(?stageDate) >= 1
                                        )
                                    )
                                )
                            )
                        )
                    } ||
                    EXISTS {
                        $this nltl:constructionStageDate ?earlyStageDate .
                        FILTER (
                            datatype(?earlyStageDate) = xsd:date &&
                            (
                                YEAR(?earlyStageDate) < 2003 ||
                                (
                                    YEAR(?earlyStageDate) = 2003 &&
                                    (
                                        MONTH(?earlyStageDate) < 9 ||
                                        (
                                            MONTH(?earlyStageDate) = 9 &&
                                            DAY(?earlyStageDate) < 1
                                        )
                                    )
                                )
                            )
                        )
                    }
                )
            }
        """
    ] .

gen:TRF009ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
        )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:engineOutputComplianceMethodValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        )
    ] ;
    sh:sparql [
        sh:message "Applicable ships must comply with section 3.2.2 or 3.2.4 no later than 1 January in the year twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (
                    !(
                        YEAR(?stageDate) < 2003 ||
                        (
                            YEAR(?stageDate) = 2003 &&
                            (
                                MONTH(?stageDate) < 9 ||
                                (
                                    MONTH(?stageDate) = 9 &&
                                    DAY(?stageDate) < 1
                                )
                            )
                        )
                    ) ||
                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                    (
                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                        (
                            MONTH(?assessmentDate) > 1 ||
                            (
                                MONTH(?assessmentDate) = 1 &&
                                DAY(?assessmentDate) > 1
                            )
                        )
                    )
                )
            }
        """
    ] .
