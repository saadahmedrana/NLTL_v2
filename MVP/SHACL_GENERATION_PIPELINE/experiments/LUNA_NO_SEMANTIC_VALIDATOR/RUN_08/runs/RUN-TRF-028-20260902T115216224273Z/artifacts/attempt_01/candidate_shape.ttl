@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-028-ComplexReadinessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's alternative Ke or RCH approval status must be present and true."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's alternative Ke or RCH approval revocation status must be present."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "An approved alternative engine-output coefficient Ke with a dimensionless quantity value must be provided."
            ]
        ]
        [
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue qudt:N ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "An approved alternative brash-ice channel resistance RCH with a force quantity value in newtons must be provided."
            ]
        ]
    ) ;
    sh:message "The ship must provide an approved alternative Ke or RCH result."

.
