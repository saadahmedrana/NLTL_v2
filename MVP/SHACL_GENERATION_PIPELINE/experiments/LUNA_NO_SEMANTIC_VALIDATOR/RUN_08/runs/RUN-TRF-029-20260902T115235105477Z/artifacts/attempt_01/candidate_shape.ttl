@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF029DirectAnalysisShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "directAnalysisUsed must be false when the prescribed analytical procedure applies."
            ]
        ]
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "directAnalysisUsed must be true for the direct-analysis branch."
            ] ;
            sh:property [
                sh:path nltl:prescribedProcedureApplicability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The prescribed procedure must be marked not applicable when direct analysis is used."
            ] ;
            sh:property [
                sh:path nltl:directAnalysisApprovalStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Direct analysis must have approved status."
            ] ;
            sh:property [
                sh:path nltl:structuralArrangement ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "A structural arrangement is required when direct analysis is used."
            ]
        ]
    ) .
