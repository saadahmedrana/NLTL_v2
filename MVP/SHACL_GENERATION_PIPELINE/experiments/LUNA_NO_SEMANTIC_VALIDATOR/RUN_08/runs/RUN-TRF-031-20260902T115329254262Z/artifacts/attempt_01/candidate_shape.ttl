@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:StressQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF031Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:StressQuantityShape
    ] ;
    sh:property [
        sh:path nltl:combinedBendingShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:StressQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:StressQuantityShape
    ] ;
    sh:property [
        sh:path nltl:beamTheoryUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:allowableShearStress ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:StressQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:beamTheoryUsed ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Combined bending and shear stress must be lower than the yield point, and yield shear stress must equal yield point divided by sqrt(3) within a relative tolerance of 1e-6 plus a small absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldPoint ?yieldNode ;
                      nltl:combinedBendingShearStress ?combinedNode ;
                      nltl:yieldShearStress ?resultNode .
                ?yieldNode qudt:numericValue ?yield .
                ?combinedNode qudt:numericValue ?combined .
                ?resultNode qudt:numericValue ?reported .
                FILTER (?combined >= ?yield)
                BIND (?yield / 1.7320508075688772 AS ?expected)
                FILTER (
                    ABS(?reported - ?expected) >
                    ((ABS(?expected) * 0.000001) + 0.000000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "When beam theory is used, allowable shear stress must not exceed 0.9 times yield point divided by sqrt(3)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:beamTheoryUsed true ;
                      nltl:yieldPoint ?yieldNode ;
                      nltl:allowableShearStress ?allowableNode .
                ?yieldNode qudt:numericValue ?yield .
                ?allowableNode qudt:numericValue ?allowable .
                FILTER (?allowable > (0.9 * (?yield / 1.7320508075688772)))
            }
        """
    ] .
