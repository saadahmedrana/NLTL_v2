@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-034-effective-member-cross-section>
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The effective member cross section must provide a section modulus in cm^3."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The effective member cross section must provide a shear area in m^2."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path [
                    sh:inversePath nltl:hasEffectiveMemberCrossSection
                ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:hullStructure ;
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path [
                    sh:inversePath nltl:hasEffectiveMemberCrossSection
                ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:hullStructure ;
                    sh:property [
                        sh:path nltl:memberNormalToPlating ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue false
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "When the member is not normal to the plating, classification-society section-property calculation evidence is required."
            ]
        ]
    ) ;
    sh:message "The member normal-to-plating status must be established, and non-normal members require classification-society section-property calculation evidence." .
