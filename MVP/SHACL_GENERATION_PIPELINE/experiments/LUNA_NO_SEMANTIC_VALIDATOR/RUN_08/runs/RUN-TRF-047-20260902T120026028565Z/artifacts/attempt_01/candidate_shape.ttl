@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-047_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame shall identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:message "A transverse frame shall identify its lower end."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lower end shall be attached to a deck structure, tank boundary plating, tank top, or ice stringer, or shall satisfy the permitted horizontal-member alternative." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasLowerEnd ?end .
                FILTER (
                    NOT EXISTS {
                        ?end nltl:hasAttachedSupportingStructure ?attached .
                        ?attached rdf:type ?attachedType .
                        FILTER (
                            ?attachedType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:tankTop,
                                nltl:iceStringer
                            )
                        )
                    }
                    &&
                    NOT EXISTS {
                        ?end nltl:hasTerminationBelowSupportingStructure ?terminationStructure .
                        ?terminationStructure nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                        ?end nltl:hasHorizontalConnectionMember ?member .
                        ?member nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                        ?adjacentMainFrame rdf:type nltl:mainFrame .
                        ?member nltl:sameScantlingsAsMainFrame true .
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A main frame below the lower edge of the ice belt shall be ice strengthened." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this rdf:type nltl:mainFrame .
                FILTER NOT EXISTS {
                    $this nltl:mainFrameBelowIceBeltStrengthened true
                }
            }
        """
    ] .
