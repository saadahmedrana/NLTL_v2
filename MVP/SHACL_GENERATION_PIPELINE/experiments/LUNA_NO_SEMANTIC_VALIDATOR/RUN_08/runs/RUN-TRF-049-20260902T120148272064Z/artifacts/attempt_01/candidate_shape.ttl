@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-049-FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        <urn:nltl:generated-shape:TRF-049-InIceFrameShape>
        <urn:nltl:generated-shape:TRF-049-OutOfIceFrameShape>
    ) ;
    sh:sparql [
        sh:message "Each installed bracket must be at least as thick as the web plate of its frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameWebThickness/qudt:numericValue ?frameThickness .
                $this nltl:hasFrameAttachment/nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness/qudt:numericValue ?bracketThickness .
                FILTER (datatype(?frameThickness) = xsd:decimal)
                FILTER (datatype(?bracketThickness) = xsd:decimal)
                FILTER (?bracketThickness < ?frameThickness)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-049-OutOfIceFrameShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A frame outside the ice-strengthened area must identify that applicability state."
    ] .

<urn:nltl:generated-shape:TRF-049-InIceFrameShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A frame governed by this requirement must be identified as being within the ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:node <urn:nltl:generated-shape:TRF-049-FrameAttachmentShape> ;
        sh:minCount 1 ;
        sh:message "A frame within the ice-strengthened area must have an effective attachment record."
    ] ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:node <urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
    ] ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must state whether it passes through a supporting structure."
    ] ;
    sh:sparql [
        sh:message "A frame passing through a supporting structure must have both web-plate connection sides connected, represented by a side count of 2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:passesThroughSupportingStructure true .
                FILTER NOT EXISTS {
                    $this nltl:webPlateConnectionSideCount ?count .
                    FILTER (datatype(?count) = xsd:integer && ?count = 2)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A longitudinal frame must be attached by brackets to every linked supporting web frame or bulkhead." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:longitudinalFrame .
                $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?supporting .
                FILTER NOT EXISTS {
                    ?supporting nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?supporting ;
                                nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A transverse frame must identify its termination condition and, when it terminates at a deck or ice stringer, must have a bracket or similar construction." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                {
                    $this a nltl:transverseFrame .
                    FILTER NOT EXISTS {
                        $this nltl:terminatesAtDeckOrIceStringer ?termination .
                        FILTER (?termination = true || ?termination = false)
                    }
                }
                UNION
                {
                    $this a nltl:transverseFrame ;
                          nltl:terminatesAtDeckOrIceStringer true .
                    FILTER NOT EXISTS {
                        $this nltl:hasFrameAttachment/nltl:hasConnectionBracket ?bracket
                    }
                    FILTER NOT EXISTS {
                        $this nltl:hasFrameAttachment/nltl:similarAttachmentConstructionPresent true
                    }
                }
            }
        """
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasFrameAttachment nltl:hasConnectionBracket ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:node <urn:nltl:generated-shape:TRF-049-FrameWebThicknessShape> ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:hasFrameAttachment nltl:hasConnectionBracket ) ;
                sh:maxCount 0
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-049-FrameAttachmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each frame attachment must be effectively attached."
    ] ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure ;
        sh:minCount 1 ;
        sh:message "Each frame attachment must identify its attached supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:node <urn:nltl:generated-shape:TRF-049-ConnectionBracketShape>
    ] ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-049-SupportingStructureShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:node <urn:nltl:generated-shape:TRF-049-FrameAttachmentShape>
    ] .

<urn:nltl:generated-shape:TRF-049-ConnectionBracketShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:node <urn:nltl:generated-shape:TRF-049-BracketThicknessShape> ;
        sh:minCount 1 ;
        sh:message "An installed bracket must specify its thickness."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket must be stiffened against buckling."
    ] .

<urn:nltl:generated-shape:TRF-049-FrameWebThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-049-BracketThicknessShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
