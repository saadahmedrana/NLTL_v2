@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-052> a sh:NodeShape ;
    sh:targetClass nltl:frame ;

    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:frameSpan ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:maxCount 1
    ] ;

    sh:sparql [
        sh:message "Frame asymmetry or web angle applicability is not sufficiently established." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER NOT EXISTS {
                    $this nltl:frameAsymmetrical true .
                }
                FILTER NOT EXISTS {
                    $this nltl:frameWebAngleToShell ?angleNode .
                    ?angleNode qudt:numericValue ?angle .
                    FILTER ( ?angle < 90 )
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:frameAsymmetrical ?asymmetry .
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:frameAsymmetrical false .
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:frameWebAngleToShell ?angleNode2 .
                            ?angleNode2 qudt:numericValue ?angle2 .
                        }
                    )
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Frame span and ice class are required to establish the applicable support-scope branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:frameSpan ?spanNode .
                        ?spanNode qudt:numericValue ?span .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClass ?iceClass .
                    }
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Antitripping support spacing shall not exceed 1300 mm when the frame is asymmetrical or its web angle to the shell is less than 90 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER (
                    EXISTS {
                        $this nltl:frameAsymmetrical true .
                    }
                    ||
                    EXISTS {
                        $this nltl:frameWebAngleToShell ?angleNode .
                        ?angleNode qudt:numericValue ?angle .
                        FILTER ( ?angle < 90 )
                    }
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingNode .
                        ?spacingNode qudt:numericValue ?spacing .
                    }
                    ||
                    EXISTS {
                        $this nltl:antitrippingSupportSpacing ?spacingNode2 .
                        ?spacingNode2 qudt:numericValue ?spacing2 .
                        FILTER ( ?spacing2 > 1300 )
                    }
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "For frames with span not exceeding 4 m and ice class IA, antitripping support is required in the bow and midbody regions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                FILTER ( ?span <= 4 )
                $this nltl:iceClass nltl:iceClassIa .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                    }
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "For frames with span not exceeding 4 m and ice class IB or IC, antitripping support is required in the bow region." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                FILTER ( ?span <= 4 )
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )
                FILTER NOT EXISTS {
                    $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                }
            }
        """
    ] .
