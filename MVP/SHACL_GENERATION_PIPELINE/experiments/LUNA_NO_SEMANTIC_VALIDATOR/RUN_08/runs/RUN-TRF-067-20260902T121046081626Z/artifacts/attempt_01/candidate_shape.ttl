@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF_067_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must declare exactly one ice class to determine applicability of the rudder-load protection requirement."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa ;
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "Ships of ice class IA shall have a rudder protection arrangement suitable for absorbing the large loads described in the requirement."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper ;
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:rudderProtectionArrangement ;
                sh:minCount 1 ;
                sh:message "Ships of ice class IA Super shall have a rudder protection arrangement suitable for absorbing the large loads described in the requirement."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
            ]
        ]
    ) .
