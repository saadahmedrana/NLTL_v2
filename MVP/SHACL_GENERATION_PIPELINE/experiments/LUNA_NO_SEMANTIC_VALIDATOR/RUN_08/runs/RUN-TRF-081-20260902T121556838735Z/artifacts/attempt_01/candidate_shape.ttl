@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:KiloNewtonQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:TRF081Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:forwardIceThrust ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:backwardIceThrust ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:forwardPropellerShaftDesignThrust ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:backwardPropellerShaftDesignThrust ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerShaftDesignThrust ;
        sh:node g:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Forward and backward ice thrusts and shaft design thrusts must satisfy TRF-081 within a relative tolerance of 1e-6 plus an absolute tolerance of 1e-9 kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?trfNode ;
                      nltl:backwardPropellerShaftDesignThrust ?trbNode ;
                      nltl:propellerShaftDesignThrust ?trNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?tNode qudt:numericValue ?t .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?trfNode qudt:numericValue ?trf .
                ?trbNode qudt:numericValue ?trb .
                ?trNode qudt:numericValue ?tr .

                FILTER (
                    ABS(?tf - ("1.1"^^xsd:decimal * ?ff)) >
                        (ABS("1.1"^^xsd:decimal * ?ff) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?tb - ("1.1"^^xsd:decimal * ?fb)) >
                        (ABS("1.1"^^xsd:decimal * ?fb) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?trf - (?t + ("2.2"^^xsd:decimal * ?tf))) >
                        (ABS(?t + ("2.2"^^xsd:decimal * ?tf)) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?trb - ("1.5"^^xsd:decimal * ?tb)) >
                        (ABS("1.5"^^xsd:decimal * ?tb) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                    ||
                    ABS(?tr - IF(
                        (?trf >= ?trb),
                        ?trf,
                        ?trb
                    )) >
                        (ABS(IF((?trf >= ?trb), ?trf, ?trb)) * "0.000001"^^xsd:decimal + "0.000000001"^^xsd:decimal)
                )
            }
        """
    ] .
