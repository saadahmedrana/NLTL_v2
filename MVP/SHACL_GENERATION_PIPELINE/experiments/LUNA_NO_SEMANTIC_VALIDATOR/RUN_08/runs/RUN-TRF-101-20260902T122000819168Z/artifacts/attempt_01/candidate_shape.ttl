@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-101-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LoadCaseShape>
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-101-ApprovedAnalysisBranch>
        <urn:nltl:generated-shape:TRF-101-FormulaBranch>
    ) ;
    sh:sparql [
        sh:message "bladeFailureStatus must be true when bladeTipOffset exceeds 10% of propellerDiameter and false otherwise" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeTipOffset ?tipNode ;
                      nltl:bladeFailureStatus ?status .
                ?diameterNode qudt:numericValue ?diameter .
                ?tipNode qudt:numericValue ?tip .
                FILTER (
                    (?tip > (0.10 * ?diameter) && ?status != true) ||
                    (?tip <= (0.10 * ?diameter) && ?status != false)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-101-LengthQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-PressureQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-ForceQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-RatioQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.8"^^xsd:decimal ;
        sh:maxInclusive "0.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-LoadCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-RatioQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

<urn:nltl:generated-shape:TRF-101-ApprovedAnalysisBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF-101-FormulaBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-101-ForceQuantityShape>
    ] ;
    sh:sparql [
        sh:message "bladeReferenceStrength1 and bladeFailureUltimateLoad must satisfy the declared blade failure-load calculation" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection ?cNode ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                      nltl:bladeCylindricalRootRadius ?rNode ;
                      nltl:propellerDiameter ?dNode ;
                      nltl:bladeMinimumYieldStrength ?yieldNode ;
                      nltl:bladeUltimateTensileStrength ?ultimateNode ;
                      nltl:bladeReferenceStrength1 ?referenceNode ;
                      nltl:bladeFailureUltimateLoad ?loadNode .
                ?cNode qudt:numericValue ?c .
                ?tNode qudt:numericValue ?t .
                ?rNode qudt:numericValue ?r .
                ?dNode qudt:numericValue ?d .
                ?yieldNode qudt:numericValue ?yield .
                ?ultimateNode qudt:numericValue ?ultimate .
                ?referenceNode qudt:numericValue ?reference .
                ?loadNode qudt:numericValue ?load .
                BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                BIND ((300 * ?c * ?t * ?t * ?expectedReference) / ((0.8 * ?d) - (2 * ?r)) AS ?expectedLoad)
                BIND ((1e-6 * ABS(?expectedReference)) + 1e-9 AS ?referenceTolerance)
                BIND ((1e-6 * ABS(?expectedLoad)) + 1e-9 AS ?loadTolerance)
                FILTER (
                    ABS(?reference - ?expectedReference) > ?referenceTolerance ||
                    ABS(?load - ?expectedLoad) > ?loadTolerance
                )
            }
        """
    ] .
