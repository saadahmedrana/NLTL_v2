@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF123Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:occasionalForceLoadCase ;
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The occasional-force load case must identify that propeller blades are excluded from its scope."
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                    ]
                ] ;
                sh:message "Each occasional-force load case must provide a dimensionless component yield safety factor."
            ] ;
            sh:property [
                sh:path nltl:occasionalForceCaseAssessedComponent ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:shipComponent ;
                    sh:property [
                        sh:path nltl:occasionalForceComponentStress ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
                            ]
                        ] ;
                        sh:message "Each assessed component must provide its externally calculated occasional-force stress in MPa."
                    ] ;
                    sh:property [
                        sh:path nltl:hasMaterialProperties ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:materialProperties ;
                            sh:property [
                                sh:path nltl:componentMaterialYieldStrength ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node [
                                    sh:class qudt:QuantityValue ;
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
                                    ]
                                ] ;
                                sh:message "Material properties must provide the component material yield strength in MPa."
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "The externally calculated occasional-force stress, including the declared safety factor, must not exceed the component material yield strength." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:occasionalForceCaseAssessedComponent ?component .
    ?component nltl:occasionalForceComponentStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue .
    $this nltl:componentYieldSafetyFactor ?factorQuantity .
    ?factorQuantity qudt:numericValue ?factorValue .
    ?component nltl:hasMaterialProperties ?materialProperties .
    ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
    ?yieldQuantity qudt:numericValue ?yieldValue .
    FILTER (xsd:decimal(?stressValue) * xsd:decimal(?factorValue) > xsd:decimal(?yieldValue))
}
"""
            ]
        ]
    ] .
