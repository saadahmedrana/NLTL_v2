@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF130Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130PowerQuantityShape
    ] ;
    sh:property [
        sh:path nltl:totalRelevantEnginePower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130PowerQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class nltl:inletChest
        ] ;
        sh:qualifiedValueShapesDisjoint false ;
        sh:message "At least one linked component must be an inlet chest."
    ] ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The cooling-water chest volume and height applicability selector is required."
    ] ;
    sh:or (
        nltl:TRF130StandardArrangementShape
        nltl:TRF130AlternativeArrangementShape
    ) .

nltl:TRF130StandardArrangementShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class nltl:inletChest
        ] ;
        sh:qualifiedValueShapesDisjoint false ;
        sh:message "At least one inlet chest is required for the standard arrangement."
    ] .

nltl:TRF130AlternativeArrangementShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:coolingWaterChestVolumeAndHeightRequirementsCannotBeMet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:coolingWaterChestAlternativeArrangementUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The alternative cooling-water chest arrangement must be recorded when the volume and height requirements cannot be met."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedMinCount 2 ;
        sh:qualifiedValueShape [
            sh:class nltl:inletChest ;
            sh:property [
                sh:path nltl:alternatingCoolingWaterIntakeAndDischarge ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ] ;
        sh:qualifiedValueShapesDisjoint false ;
        sh:message "At least two alternating inlet chests are required for the alternative arrangement."
    ] .

nltl:TRF130PowerQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130InletChestShape a sh:NodeShape ;
    sh:targetClass nltl:inletChest ;
    sh:property [
        sh:path nltl:seaInletLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "near_centreline_and_well_aft_if_possible" ;
        sh:message "The sea inlet must be near the centreline and well aft if possible."
    ] ;
    sh:property [
        sh:path nltl:recommendedChestVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130VolumeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:seaChestVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130VolumeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceAccumulationSpaceAboveInlet ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The inlet chest must provide space for ice accumulation above the inlet."
    ] ;
    sh:property [
        sh:path nltl:fullCapacityDischargePipeConnected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A full-capacity cooling-water discharge pipe must be connected to the inlet chest."
    ] ;
    sh:property [
        sh:path nltl:inletPipeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:strainerOpenArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130AreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:strainerOpenAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF130RatioQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Recommended chest volume must be approximately total relevant engine power divided by 750, within a relative tolerance of 1e-6 and a 1e-6 absolute fallback near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:recommendedChestVolume ?volumeNode .
                ?volumeNode qudt:numericValue ?reportedVolume .
                ?ship nltl:hasComponent $this ;
                      nltl:totalRelevantEnginePower ?powerNode .
                ?powerNode qudt:numericValue ?power .
                BIND(?power / 750 AS ?expectedVolume)
                FILTER(
                    ABS(?reportedVolume - ?expectedVolume) >
                    ABS(?expectedVolume) * "0.000001"^^xsd:decimal
                    &&
                    (
                        ABS(?expectedVolume) >= "0.000001"^^xsd:decimal
                        ||
                        ABS(?reportedVolume - ?expectedVolume) >
                        "0.000001"^^xsd:decimal
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Strainer open area must be at least four times the inlet pipe area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:strainerOpenArea ?strainerNode ;
                      nltl:inletPipeArea ?pipeNode .
                ?strainerNode qudt:numericValue ?strainerArea .
                ?pipeNode qudt:numericValue ?pipeArea .
                FILTER(?strainerArea < 4 * ?pipeArea)
            }
        """
    ] .

nltl:TRF130VolumeQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130AreaQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF130RatioQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
