@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF_131_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:ballastWaterCoolingArrangement ;
        sh:datatype xsd:string ;
        sh:message "A ballast water cooling arrangement must be represented as a string when provided."
    ] ;
    sh:property [
        sh:path nltl:substituteArrangementStatus ;
        sh:datatype xsd:boolean ;
        sh:message "The substitute arrangement status must be boolean."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ballast water cooling arrangement may be used as a reserve but must not be accepted as a substitute for an inlet chest." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ballastWaterCoolingArrangement ?arrangement .
                FILTER (
                    NOT EXISTS {
                        $this nltl:substituteArrangementStatus ?validStatus .
                        FILTER (
                            datatype(?validStatus) = xsd:boolean &&
                            ?validStatus = false
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:substituteArrangementStatus ?invalidStatus .
                        FILTER (
                            datatype(?invalidStatus) != xsd:boolean ||
                            ?invalidStatus != false
                        )
                    }
                )
            }
        """
    ] .
