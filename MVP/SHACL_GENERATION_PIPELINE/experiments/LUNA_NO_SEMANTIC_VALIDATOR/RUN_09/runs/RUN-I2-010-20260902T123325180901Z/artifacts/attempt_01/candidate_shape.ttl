@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-010> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:datatype nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one Polar Class value." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in ( nltl:polarClassPc1 nltl:polarClassPc2 nltl:polarClassPc3 nltl:polarClassPc4 nltl:polarClassPc5 ) ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ;
            ] ;
            sh:property [
                sh:path nltl:bowVerticalSideStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
            ] ;
            sh:property [
                sh:path nltl:verticalSidedBowForm ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ;
            ] ;
            sh:property [
                sh:path nltl:bowVerticalSideStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:verticalSidedBowForm ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethod ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A design ice force calculation method must be recorded for an applicable PC6 or PC7 ship with a vertical-sided bow." ;
            ] ;
            sh:property [
                sh:path nltl:normalFrameAngle ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 0 ;
                        sh:maxInclusive 10 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:DEG ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ] ;
                sh:message "For an applicable PC6 or PC7 ship with a vertical-sided bow, each represented normal frame angle must be between 0 and 10 degrees." ;
            ]
        ]
    ) ;
    sh:message "The ship must satisfy the Polar Class and vertical-sided-bow applicability conditions for the design ice force calculation." .
