@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:I2_030_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:interpolationLowerEndpoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_DimensionlessQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_QuantityShape
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolationUpperEndpoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:interpolationPoint ;
                    sh:property [
                        sh:path nltl:interpolationPointCoordinate ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_DimensionlessQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:interpolationPointResult ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_QuantityShape
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:plasticNeutralAxisHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:I2_030_MillimetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:sectionCalculationCaseStructuralMember ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:structuralMember ;
                    sh:property [
                        sh:path nltl:frameSpacing ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_MetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:localFrameFlangeCentreHeight ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_MillimetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:netAttachedShellPlateThickness ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_MillimetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:netEffectivePlasticSectionModulus ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_CubicCentimetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:netLocalFrameFlangeArea ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_SquareCentimetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:netWebThickness ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_MillimetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:webAngleToShellPlate ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_DegreeQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:webHeight ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_MillimetreQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:webToFlangeCentreDistance ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node gs:I2_030_MillimetreQuantityShape
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:hasLocalFrameSectionCalculationCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:localFrameSectionCalculationCase ;
                    sh:property [
                        sh:path nltl:sectionCalculationCasePlating ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:plating ;
                            sh:property [
                                sh:path nltl:framingAngleOmega ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node gs:I2_030_DegreeQuantityShape
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:sectionCalculationCaseStructuralMember ;
                        sh:minCount 1 ;
                        sh:class nltl:structuralMember
                    ]
                ]
            ]
        ]
    ] .

gs:I2_030_QuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_DegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_030_CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
