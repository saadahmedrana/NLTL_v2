@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<nltl:generated-shape:I2-046-QuantityValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.0 ;
        sh:message "The internal structure corrosion/abrasion addition must be at least 1.0 mm."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:message "The internal structure corrosion/abrasion addition must use exactly one millimetre unit."
    ] .

<nltl:generated-shape:I2-046-InternalStructureShape>
    a sh:NodeShape ;
    sh:class nltl:internalIceStrengthenedStructure ;
    sh:property [
        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
        sh:node <nltl:generated-shape:I2-046-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each linked internal ice-strengthened structure must have exactly one corrosion/abrasion addition."
    ] .

<nltl:generated-shape:I2-046-ApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "An applicable ship must provide one valid polar class value."
    ] ;
    sh:property [
        sh:path nltl:hasInternalIceStrengthenedStructure ;
        sh:node <nltl:generated-shape:I2-046-InternalStructureShape> ;
        sh:message "Every linked internal ice-strengthened structure must satisfy the corrosion/abrasion addition requirement."
    ] .

<nltl:generated-shape:I2-046-NonApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] .

<nltl:generated-shape:I2-046-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must have exactly one polar class applicability boolean."
    ] ;
    sh:or (
        <nltl:generated-shape:I2-046-ApplicableShape>
        <nltl:generated-shape:I2-046-NonApplicableShape>
    ) .
