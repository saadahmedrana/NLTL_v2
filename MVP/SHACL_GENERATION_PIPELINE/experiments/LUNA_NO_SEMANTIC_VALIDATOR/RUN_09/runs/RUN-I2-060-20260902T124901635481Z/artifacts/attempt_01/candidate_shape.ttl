@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_060_StructuralMemberShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a structural member associated with a cutout, applicability and stiffening information must be valid, instability must be false, and required stiffening must be recorded." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER NOT EXISTS {
      ?member nltl:memberInWayOfCutout ?inWay .
      FILTER (
        datatype(?inWay) = xsd:boolean &&
        (?inWay = true || ?inWay = false)
      )
    }
  }
  UNION
  {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    ?member nltl:memberInWayOfCutout true .
    FILTER NOT EXISTS {
      ?member nltl:stiffeningNecessary ?necessary .
      FILTER (
        datatype(?necessary) = xsd:boolean &&
        (?necessary = true || ?necessary = false)
      )
    }
  }
  UNION
  {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    ?member nltl:memberInWayOfCutout true .
    ?member nltl:stiffeningNecessary true .
    FILTER NOT EXISTS {
      $this nltl:structuralStiffening ?stiffening .
      FILTER (datatype(?stiffening) = xsd:string)
    }
  }
  UNION
  {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    ?member nltl:memberInWayOfCutout true .
    FILTER NOT EXISTS {
      $this nltl:memberInstability ?instability .
      FILTER (
        datatype(?instability) = xsd:boolean &&
        ?instability = false
      )
    }
  }
}
"""
    ] .

gen:I2_060_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCutout ;
        sh:class nltl:cutout
    ] .
