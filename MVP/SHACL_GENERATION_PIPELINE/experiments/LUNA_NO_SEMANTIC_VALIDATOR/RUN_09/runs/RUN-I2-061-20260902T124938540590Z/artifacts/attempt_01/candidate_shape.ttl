@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node gs:CalculationCaseShape ;
        sh:message "The ship must identify a calculation case for the prescribed shell-plating or local-frame analytical procedure."
    ] .

gs:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationCaseAssessedHullStructure ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:hullStructure ;
        sh:minCount 1 ;
        sh:node gs:HullStructureShape ;
        sh:message "Each calculation case must identify the assessed hull structure."
    ] ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:directCalculationMethodValue
            nltl:prescribedAnalyticalProcedure
        ) ;
        sh:hasValue nltl:prescribedAnalyticalProcedure ;
        sh:minCount 1 ;
        sh:message "The calculation case must use the prescribed analytical procedure rather than a direct calculation."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A direct calculation must not be used as an alternative to the prescribed analytical procedure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:directCalculationMethodValue .
            }
        """
    ] .

gs:HullStructureShape
    a sh:NodeShape ;
    sh:class nltl:hullStructure ;
    sh:property [
        sh:path nltl:thickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class qudt:QuantityValue ;
        sh:node gs:ThicknessQuantityShape ;
        sh:message "The assessed hull structure must have one thickness quantity expressed in metres."
    ] .

gs:ThicknessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
