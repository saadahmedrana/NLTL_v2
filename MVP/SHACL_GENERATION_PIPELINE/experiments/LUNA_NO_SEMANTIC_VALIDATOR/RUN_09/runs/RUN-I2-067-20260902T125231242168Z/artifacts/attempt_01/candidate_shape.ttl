@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_067_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:structuralConnection ;
        sh:node [
            sh:property [
                sh:path nltl:strengthContinuityStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "Every structural connection must ensure continuity of strength."
            ]
        ]
    ] .
