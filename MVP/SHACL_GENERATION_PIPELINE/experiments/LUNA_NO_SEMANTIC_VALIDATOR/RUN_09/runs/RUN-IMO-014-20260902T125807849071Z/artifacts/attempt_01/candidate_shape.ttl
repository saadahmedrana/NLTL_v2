@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO_014_AppliesBranch
        gen:IMO_014_DoesNotApplyBranch
    ) .

gen:IMO_014_AppliesBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "polarCodeApplies must be true to use the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:polarShipCertificatePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "A ship to which the Polar Code applies must have a Polar Ship Certificate."
    ] ;
    sh:property [
        sh:path nltl:polarShipCertificateStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate must have valid status."
    ] .

gen:IMO_014_DoesNotApplyBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "polarCodeApplies must be explicitly false to use the non-applicable branch."
    ] .
