@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-017-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A Polar Ship Certificate validity date is required."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A Polar Ship Certificate survey date is required."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A Polar Ship Certificate endorsement date is required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Certificate supplement must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCertificateForm ;
        sh:message "A Polar Ship Certificate form is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:solasCertificateSchedule ;
        sh:node <urn:nltl:generated-shape:IMO-017-SolasScheduleShape> ;
        sh:message "A SOLAS certificate schedule with certificate date records is required."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarCertificateSupplement ;
        sh:node <urn:nltl:generated-shape:IMO-017-SupplementShape> ;
        sh:message "A Polar Certificate supplement with required equipment records is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each Polar Ship Certificate validity, survey, and endorsement date must match a SOLAS certificate schedule date of the corresponding controlled category." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  {
    $this nltl:polarCertificateValidityDates ?date .
    FILTER NOT EXISTS {
      $this nltl:hasSolasCertificateSchedule ?schedule .
      ?schedule nltl:hasCertificateScheduleDateRecord ?record .
      ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
              nltl:certificateScheduleDate ?date .
    }
  }
  UNION
  {
    $this nltl:surveyDates ?date .
    FILTER NOT EXISTS {
      $this nltl:hasSolasCertificateSchedule ?schedule .
      ?schedule nltl:hasCertificateScheduleDateRecord ?record .
      ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
              nltl:certificateScheduleDate ?date .
    }
  }
  UNION
  {
    $this nltl:endorsementDates ?date .
    FILTER NOT EXISTS {
      $this nltl:hasSolasCertificateSchedule ?schedule .
      ?schedule nltl:hasCertificateScheduleDateRecord ?record .
      ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
              nltl:certificateScheduleDate ?date .
    }
  }
}
"""
    ] .

<urn:nltl:generated-shape:IMO-017-SolasScheduleShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:certificateScheduleDateRecord ;
        sh:node <urn:nltl:generated-shape:IMO-017-DateRecordShape> ;
        sh:message "The SOLAS certificate schedule must contain certificate schedule date records."
    ] .

<urn:nltl:generated-shape:IMO-017-DateRecordShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Each certificate schedule date record must contain a date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:message "Each certificate schedule date record must have a permitted controlled date category."
    ] .

<urn:nltl:generated-shape:IMO-017-SupplementShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:message "The Polar Certificate supplement must record required equipment."
    ] .
