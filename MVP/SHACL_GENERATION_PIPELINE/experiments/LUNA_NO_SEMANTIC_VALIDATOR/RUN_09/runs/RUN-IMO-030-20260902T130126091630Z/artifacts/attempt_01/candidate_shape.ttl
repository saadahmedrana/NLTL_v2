@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO030Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must state whether ice operation is applicable."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operation is applicable, an ice-safety monitoring procedure must be present."
            ] ;
            sh:property [
                sh:path nltl:escortRequirementsPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operation is applicable, applicable escort or icebreaker-assistance requirements must be included."
            ] ;
            sh:property [
                sh:path nltl:independentOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When ice operation is applicable, independent-operation limitations must be specified."
            ] ;
            sh:property [
                sh:path nltl:escortedOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When ice operation is applicable, escorted-operation limitations must be specified."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:hasValue false
            ]
        ]
    ) .
