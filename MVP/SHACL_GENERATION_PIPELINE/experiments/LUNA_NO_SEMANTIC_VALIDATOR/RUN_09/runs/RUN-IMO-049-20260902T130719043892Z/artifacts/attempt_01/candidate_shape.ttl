@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO049ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        )
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Each linked machinery component must have scantling approval evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                FILTER NOT EXISTS {
                    ?component nltl:hasApprovalRecord ?record .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Category A or B approval evidence must use an authorized authority and an acceptable or equivalent-safety standard." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (
                    ?category = nltl:polarShipCategoryA ||
                    ?category = nltl:polarShipCategoryB
                )
                $this nltl:hasComponent ?component .
                ?component nltl:hasApprovalRecord ?record .
                FILTER NOT EXISTS {
                    ?record nltl:approvingAuthority ?authority .
                    FILTER (
                        STR(?authority) = "Administration" ||
                        STR(?authority) = "recognized organization accepted by the Administration"
                    )
                }
                FILTER NOT EXISTS {
                    ?record nltl:approvalStandard ?standard .
                    FILTER (
                        STR(?standard) = "standard acceptable to the Organization" ||
                        STR(?standard) = "another standard offering an equivalent level of safety"
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Ice-strengthened category C approval evidence must use an authorized authority and an acceptable standard adequate for the operating ice conditions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:shipCategory nltl:polarShipCategoryC .
                $this nltl:shipIceStrengthened true .
                $this nltl:hasComponent ?component .
                ?component nltl:hasApprovalRecord ?record .
                FILTER NOT EXISTS {
                    ?record nltl:approvingAuthority ?authority .
                    FILTER (
                        STR(?authority) = "Administration" ||
                        STR(?authority) = "recognized organization accepted by the Administration"
                    )
                }
                FILTER NOT EXISTS {
                    ?record nltl:approvalStandard ?standard .
                    FILTER (
                        STR(?standard) =
                        "acceptable standard adequate for operating ice type and concentration"
                    )
                }
                FILTER NOT EXISTS {
                    ?record nltl:operatingIceType ?iceType .
                    ?record nltl:operatingIceConcentration ?concentration .
                    ?concentration qudt:numericValue ?numericValue ;
                                   qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (DATATYPE(?iceType) = xsd:string)
                    FILTER (DATATYPE(?numericValue) = xsd:decimal)
                }
            }
        """
    ] .

gen:IMO049MachineryComponentShape a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasComponent ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IMO049ApprovalRecordShape a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasApprovalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] .
