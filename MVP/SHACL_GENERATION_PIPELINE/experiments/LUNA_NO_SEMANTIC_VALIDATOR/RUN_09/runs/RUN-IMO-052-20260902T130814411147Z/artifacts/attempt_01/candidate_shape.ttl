@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO_052_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasRequiredAccessItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredAccessItem ;
        sh:node [
            sh:property [
                sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                sh:minCount 1 ;
                sh:message "Each required access item shall have associated means to remove or prevent ice and snow accretion."
            ]
        ]
    ] .
