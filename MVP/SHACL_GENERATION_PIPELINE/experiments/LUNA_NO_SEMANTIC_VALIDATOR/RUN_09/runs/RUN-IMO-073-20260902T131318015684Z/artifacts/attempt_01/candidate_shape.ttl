@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-073-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:lifeboat ;
        sh:node <urn:nltl:generated-shape:IMO-073-LifeboatShape>
    ] .

<urn:nltl:generated-shape:IMO-073-LifeboatShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:lifeboatTypeClassification ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:lifeboatTypeValue ;
        sh:minCount 1 ;
        sh:in (
            nltl:partiallyEnclosedLifeboat
            nltl:totallyEnclosedLifeboat
        ) ;
        sh:message "Each lifeboat shall be classified as partially enclosed or totally enclosed."
    ] .
