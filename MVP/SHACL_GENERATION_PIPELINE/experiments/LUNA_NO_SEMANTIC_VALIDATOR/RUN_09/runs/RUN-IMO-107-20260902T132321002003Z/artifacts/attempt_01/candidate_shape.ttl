@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO_107_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's polar-waters operating applicability must be recorded as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarOperationCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar-operation coverage must be recorded when the ship operates in polar waters."
            ] ;
            sh:property [
                sh:path nltl:oilRecordBookPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar-operation coverage must be recorded in the applicable Oil Record Book."
            ] ;
            sh:property [
                sh:path nltl:manualPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar-operation coverage must be included in the applicable manuals."
            ] ;
            sh:property [
                sh:path nltl:pollutionEmergencyPlanPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Polar-operation coverage must be included in the applicable oil or marine pollution emergency plan."
            ]
        ]
    ) .
