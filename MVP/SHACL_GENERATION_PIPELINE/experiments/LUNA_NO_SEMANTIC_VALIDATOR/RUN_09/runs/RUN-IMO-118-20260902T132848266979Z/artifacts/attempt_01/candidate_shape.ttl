@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-118_StaticDirect>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:message "A ship construction date is required and must be a valid date."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                    nltl:polarShipCategoryC
                ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:class nltl:passengerShip
        ]
    ) ;
    sh:message "Ship-category evidence or passenger-ship classification is required to determine applicability." ;
    sh:sparql [
        sh:message "For an applicable ship, sewage discharge to sea must be false unless compliance with Polar Code paragraph 4.2.1.3 is recorded as true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate .
                FILTER (?constructionDate >= "2017-01-01"^^xsd:date)

                {
                    $this nltl:shipCategory ?shipCategory .
                    FILTER (?shipCategory IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    ))
                }
                UNION
                {
                    $this a nltl:passengerShip .
                }

                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?complianceStatus .
                    FILTER (?complianceStatus = true)
                }

                FILTER NOT EXISTS {
                    $this nltl:sewageDischargeToSea ?dischargeStatus .
                    FILTER (?dischargeStatus = false)
                }
            }
        """
    ] .
