@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO123ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:residueNotRecoverableByCommonMethods ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Cargo residues must not be recoverable by commonly available methods."
    ] ;
    sh:property [
        sh:path nltl:shipEnRoute ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must be en route."
    ] ;
    sh:property [
        sh:path nltl:harmfulSubstancePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Cargo residues, cleaning agents, or additives must not include substances harmful to the marine environment."
    ] ;
    sh:property [
        sh:path nltl:departureAndDestinationWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The port of departure and the next port of destination must be within Arctic waters."
    ] ;
    sh:property [
        sh:path nltl:routeRemainsWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must not transit outside Arctic waters between the ports."
    ] ;
    sh:property [
        sh:path nltl:adequateReceptionFacilitiesAvailable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Adequate reception facilities must not be available at the relevant ports."
    ] ;
    sh:property [
        sh:path nltl:nearbyIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:NearbyIceConcentrationShape ;
        sh:message "The relevant ice concentration must exceed one tenth."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gen:DischargeDistanceRecordShape
    ] .

gen:DischargeDistanceRecordShape a sh:NodeShape ;
    sh:targetClass nltl:dischargeDistanceRecords ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:IceConcentrationAreaDistanceShape ;
        sh:message "A discharge-distance record must record the distance from an area with ice concentration greater than one tenth."
    ] ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:NearestLandIceShelfOrFastIceDistanceShape ;
        sh:message "A discharge-distance record must record a distance of at least 12 nautical miles from the nearest land, ice shelf, or fast ice."
    ] .

gen:NearbyIceConcentrationShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive 0.1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gen:IceConcentrationAreaDistanceShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .

gen:NearestLandIceShelfOrFastIceDistanceShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 12.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MI_N>
    ] .
