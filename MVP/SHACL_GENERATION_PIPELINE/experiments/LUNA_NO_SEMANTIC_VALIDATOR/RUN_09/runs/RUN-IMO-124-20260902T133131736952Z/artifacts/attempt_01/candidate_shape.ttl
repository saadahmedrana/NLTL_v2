@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_124_Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "An operating area is required to determine applicability of the Antarctic discharge rule."
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexVRegulation6Point1DischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The MARPOL Annex V regulation 6.1 discharge status is required to determine applicability."
    ] ;
    sh:sparql [
        sh:message "For an Antarctic-area MARPOL Annex V regulation 6.1 discharge, the ship must be at least 12 nautical miles from the nearest fast ice, record the distance from areas whose ice concentration exceeds one tenth, and not discharge food waste onto ice." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:operatingArea ?area ;
        nltl:marpolAnnexVRegulation6Point1DischargeOccurs ?discharge .
  FILTER(STR(?area) = "Antarctic_area")
  FILTER(?discharge = true)
  FILTER(
    NOT EXISTS {
      $this nltl:distanceToNearestFastIce ?fastIceDistance .
      ?fastIceDistance a qudt:QuantityValue ;
                        qudt:numericValue ?fastIceValue ;
                        qudt:unit unit:MI_N .
      FILTER(datatype(?fastIceValue) = xsd:decimal)
      FILTER(?fastIceValue >= "12"^^xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:nearbyIceConcentration ?nearbyConcentration ;
            nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
      ?nearbyConcentration a qudt:QuantityValue ;
                           qudt:numericValue ?concentrationValue ;
                           qudt:unit unit:UNITLESS .
      ?areaDistance a qudt:QuantityValue ;
                    qudt:numericValue ?areaDistanceValue ;
                    qudt:unit unit:MI_N .
      FILTER(datatype(?concentrationValue) = xsd:decimal)
      FILTER(?concentrationValue > "1"^^xsd:decimal)
      FILTER(datatype(?areaDistanceValue) = xsd:decimal)
    }
    ||
    NOT EXISTS {
      $this nltl:foodWasteDischargeOntoIce ?foodWasteDischarge .
      FILTER(?foodWasteDischarge = false)
    }
  )
}
"""
    ] .
