@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_016_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's polar-water operating status must be recorded as a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Ship type, when recorded, must be a single string value."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Trade status, when recorded, must be a single boolean value."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Chapter 11-1 applicability, when recorded, must be a single boolean value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship operating in polar waters, ship type, the required particulars, and the Chapter 11-1 applicability value must conform to the applicable Chapter 11-1 scope branch." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:shipOperatesInPolarWaters true .
  FILTER (
    NOT EXISTS {
      $this nltl:shipType ?type
    }
    ||
    EXISTS {
      $this nltl:shipType ?type .
      FILTER (?type NOT IN ("fishing_vessel", "pleasure_yacht", "cargo_ship"))
    }
    ||
    EXISTS {
      $this nltl:shipType ?type .
      FILTER (
        (
          ?type = "fishing_vessel"
          &&
          (
            NOT EXISTS {
              $this nltl:lengthOverall ?lengthNode .
              ?lengthNode qudt:numericValue ?lengthValue ;
                           qudt:unit qudt:M .
              FILTER (?lengthValue >= 0)
            }
            ||
            (
              EXISTS {
                $this nltl:lengthOverall ?lengthNode .
                ?lengthNode qudt:numericValue ?lengthValue ;
                             qudt:unit qudt:M .
                FILTER (?lengthValue >= 24)
              }
              &&
              NOT EXISTS {
                $this nltl:polarCodeChapter11Dash1Applicable true
              }
            )
            ||
            (
              EXISTS {
                $this nltl:lengthOverall ?lengthNode .
                ?lengthNode qudt:numericValue ?lengthValue ;
                             qudt:unit qudt:M .
                FILTER (?lengthValue < 24)
              }
              &&
              NOT EXISTS {
                $this nltl:polarCodeChapter11Dash1Applicable false
              }
            )
          )
        )
        ||
        (
          ?type = "pleasure_yacht"
          &&
          (
            NOT EXISTS {
              $this nltl:grossTonnage ?tonnageNode .
              ?tonnageNode qudt:numericValue ?tonnageValue ;
                           qudt:unit qudt:UNITLESS .
              FILTER (?tonnageValue >= 0)
            }
            ||
            NOT EXISTS {
              $this nltl:engagedInTrade false
            }
            ||
            (
              EXISTS {
                $this nltl:grossTonnage ?tonnageNode .
                ?tonnageNode qudt:numericValue ?tonnageValue ;
                             qudt:unit qudt:UNITLESS .
                FILTER (?tonnageValue >= 300)
              }
              &&
              EXISTS {
                $this nltl:engagedInTrade false
              }
              &&
              NOT EXISTS {
                $this nltl:polarCodeChapter11Dash1Applicable true
              }
            )
            ||
            (
              EXISTS {
                $this nltl:grossTonnage ?tonnageNode .
                ?tonnageNode qudt:numericValue ?tonnageValue ;
                             qudt:unit qudt:UNITLESS .
                FILTER (?tonnageValue < 300)
              }
              &&
              EXISTS {
                $this nltl:engagedInTrade false
              }
              &&
              NOT EXISTS {
                $this nltl:polarCodeChapter11Dash1Applicable false
              }
            )
          )
        )
        ||
        (
          ?type = "cargo_ship"
          &&
          (
            NOT EXISTS {
              $this nltl:grossTonnage ?tonnageNode .
              ?tonnageNode qudt:numericValue ?tonnageValue ;
                           qudt:unit qudt:UNITLESS .
              FILTER (?tonnageValue >= 0)
            }
            ||
            (
              EXISTS {
                $this nltl:grossTonnage ?tonnageNode .
                ?tonnageNode qudt:numericValue ?tonnageValue ;
                             qudt:unit qudt:UNITLESS .
                FILTER (?tonnageValue >= 300 && ?tonnageValue < 500)
              }
              &&
              NOT EXISTS {
                $this nltl:polarCodeChapter11Dash1Applicable true
              }
            )
            ||
            (
              EXISTS {
                $this nltl:grossTonnage ?tonnageNode .
                ?tonnageNode qudt:numericValue ?tonnageValue ;
                             qudt:unit qudt:UNITLESS .
                FILTER (?tonnageValue < 300 || ?tonnageValue >= 500)
              }
              &&
              NOT EXISTS {
                $this nltl:polarCodeChapter11Dash1Applicable false
              }
            )
          )
        )
      )
    }
  )
}
""" ;
    ] .
