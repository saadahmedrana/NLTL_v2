@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_017_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether Polar Code chapter 11-1 is applicable." ;
    ] ;
    sh:or (
        gen:IMO26_017_ApplicableBranch
        gen:IMO26_017_NotApplicableBranch
    ) .

gen:IMO26_017_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:voyagePlanPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When chapter 11-1 is applicable, the voyage plan must be present." ;
    ] ;
    sh:property [
        sh:path nltl:intendedVoyageHazard ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path nltl:voyagePlanCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When chapter 11-1 is applicable, the voyage plan must cover every intended voyage hazard." ;
    ] .

gen:IMO26_017_NotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:hasValue false ;
    ] .
