@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-001-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction contract date is required and must be a single xsd:date."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship must have one permitted Finnish-Swedish ice-class value."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The 2021 section 1.8 ice-class provision must apply."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The 2021 chapter 2 Ice Class Draught provision must apply."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-001-ContractedOnOrAfter20210705>
        <urn:nltl:generated-shape:TRF-001-ContractedBefore20210705>
    ) .

<urn:nltl:generated-shape:TRF-001-ContractedOnOrAfter20210705>
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships contracted on or after 5 July 2021 must identify the 2021 Ice Class Regulations as applicable." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    YEAR(?date) > 2021 ||
                    (YEAR(?date) = 2021 && MONTH(?date) > 7) ||
                    (YEAR(?date) = 2021 && MONTH(?date) = 7 && DAY(?date) >= 5)
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2021
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-001-ContractedBefore20210705>
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships contracted before 5 July 2021 must not be represented as ships to which the 2021 Ice Class Regulations apply." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    YEAR(?date) < 2021 ||
                    (YEAR(?date) = 2021 && MONTH(?date) < 7) ||
                    (YEAR(?date) = 2021 && MONTH(?date) = 7 && DAY(?date) < 5)
                )
                FILTER EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2021
                }
            }
        """
    ] .
