@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2012-01-01"^^xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date ;
                sh:message "A ship in the 2012-01-01 through 2018-12-31 contract-date interval must have a valid construction contract date."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:iceClassRegulationEdition2010 ) ;
                sh:minCount 1 ;
                sh:message "Ships contracted for construction from 2012-01-01 through 2018-12-31 must identify the 2010 Ice Class Regulations."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:or (
                    [
                        sh:maxExclusive "2012-01-01"^^xsd:date
                    ]
                    [
                        sh:minInclusive "2019-01-01"^^xsd:date
                    ]
                ) ;
                sh:message "For the non-applicable branch, the construction contract date must be before 2012-01-01 or on or after 2019-01-01."
            ]
        ]
    ) ;
    sh:message "The construction contract date must establish whether the 2010 Ice Class Regulations apply; when applicable, the applicable regulation edition must be the 2010 edition." .
