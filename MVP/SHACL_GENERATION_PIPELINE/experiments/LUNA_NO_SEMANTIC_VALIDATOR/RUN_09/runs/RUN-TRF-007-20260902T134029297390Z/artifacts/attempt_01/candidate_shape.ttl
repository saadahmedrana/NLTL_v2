@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF007ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "A ship must specify an ice class."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "Construction stage date must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:message "Delivery date must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:message "Assessment date must be an xsd:date."
    ] ;
    sh:sparql [
        sh:message "For an IA Super or IA ship constructed before 1 September 2003, the 2017 section 3.2.2 or 3.2.4 method, delivery date, assessment date, and deadline compliance are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:constructionStageDate ?constructionStageDate .
                    }
                    ||
                    EXISTS {
                        $this nltl:constructionStageDate ?constructionStageDate .
                        FILTER (
                            ?constructionStageDate < "2003-09-01"^^xsd:date
                        )
                        FILTER (
                            NOT EXISTS {
                                $this nltl:deliveryDate ?deliveryDate .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:assessmentDate ?assessmentDate .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:engineOutputComplianceMethod ?method .
                                FILTER (
                                    ?method IN (
                                        nltl:traficom2017Section3Point2Point2Method,
                                        nltl:traficom2017Section3Point2Point4Method
                                    )
                                )
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:deliveryDate ?deliveryDate ;
                                      nltl:assessmentDate ?assessmentDate .
                                FILTER (
                                    YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20
                                    ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                        &&
                                        MONTH(?assessmentDate) = 1
                                        &&
                                        DAY(?assessmentDate) <= 1
                                    )
                                )
                            }
                        )
                    }
                )
            }
        """
    ] .
