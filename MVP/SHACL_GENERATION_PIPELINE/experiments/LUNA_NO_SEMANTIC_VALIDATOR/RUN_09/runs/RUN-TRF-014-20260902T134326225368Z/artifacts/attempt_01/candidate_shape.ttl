@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ClassCertificateShape a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PostCutoffBranch a sh:NodeShape ;
    sh:sparql [
        sh:message "For a ship constructed on or after 1 July 2007, required ice marking evidence is missing when the summer fresh-water load-line draught exceeds the UIWL." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:constructionDate ?construction ;
                      nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                      nltl:upperIceWaterlineDraught ?uiwlNode .
                ?summerNode qudt:numericValue ?summer .
                ?uiwlNode qudt:numericValue ?uiwl .
                FILTER ( ! (
                    ?construction >= "2007-07-01"^^xsd:date &&
                    (
                        ?summer <= ?uiwl ||
                        (
                            EXISTS {
                                ?this nltl:warningTrianglePresent ?warning .
                                FILTER(?warning = true)
                            } &&
                            EXISTS {
                                ?this nltl:iceClassDraughtMarkPresent ?mark .
                                FILTER(?mark = true)
                            } &&
                            EXISTS {
                                ?this nltl:iceClassDraughtMarkDraughtAmidships ?markDraught .
                            }
                        )
                    )
                ) )
            }
        """
    ] .

gen:PreCutoffBranch a sh:NodeShape ;
    sh:sparql [
        sh:message "For a ship constructed before 1 July 2007, complete marking evidence or a first scheduled dry-docking date after the assessment date is required when markings are not complete." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:constructionDate ?construction ;
                      nltl:assessmentDate ?assessment .
                FILTER ( ! (
                    ?construction < "2007-07-01"^^xsd:date &&
                    (
                        (
                            EXISTS {
                                ?this nltl:warningTrianglePresent ?warning .
                                FILTER(?warning = true)
                            } &&
                            EXISTS {
                                ?this nltl:iceClassDraughtMarkPresent ?mark .
                                FILTER(?mark = true)
                            } &&
                            EXISTS {
                                ?this nltl:iceClassDraughtMarkDraughtAmidships ?markDraught .
                            }
                        ) ||
                        EXISTS {
                            ?this nltl:firstScheduledDryDockingDate ?dryDocking .
                            FILTER(?dryDocking > ?assessment)
                        }
                    )
                ) )
            }
        """
    ] .

gen:TRF014Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node gen:ClassCertificateShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node [
            sh:class nltl:iceDraughtRestrictionDocument
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:LengthQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:node gen:PostCutoffBranch
        ]
        [
            sh:node gen:PreCutoffBranch
        ]
    ) .
