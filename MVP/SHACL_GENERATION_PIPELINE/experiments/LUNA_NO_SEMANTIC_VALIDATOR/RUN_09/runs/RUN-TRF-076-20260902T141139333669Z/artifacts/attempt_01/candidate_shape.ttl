@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-076-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide its propeller type to determine whether the load-case rule applies."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:class nltl:propellerBladeLoadCase
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF-076-CPBranch>
        <urn:nltl:generated-shape:TRF-076-FPReversingBranch>
        <urn:nltl:generated-shape:TRF-076-FPNonReversingBranch>
        <urn:nltl:generated-shape:TRF-076-NonApplicableBranch>
    ) .

<urn:nltl:generated-shape:TRF-076-CPBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "CP" ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case1Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A CP propeller must cover blade load case 1."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case2Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A CP propeller must cover blade load case 2."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case3Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A CP propeller must cover blade load case 3."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case4Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A CP propeller must cover blade load case 4."
    ] .

<urn:nltl:generated-shape:TRF-076-FPReversingBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "FP" ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case1Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must cover blade load case 1."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case2Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must cover blade load case 2."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case3Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must cover blade load case 3."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case4Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must cover blade load case 4."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case5Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must also cover blade load case 5."
    ] .

<urn:nltl:generated-shape:TRF-076-FPNonReversingBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "FP" ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case1Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A non-reversing FP propeller must cover blade load case 1."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case2Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A non-reversing FP propeller must cover blade load case 2."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case3Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A non-reversing FP propeller must cover blade load case 3."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape <urn:nltl:generated-shape:TRF-076-Case4Shape> ;
        sh:qualifiedMinCount 1 ;
        sh:message "A non-reversing FP propeller must cover blade load case 4."
    ] .

<urn:nltl:generated-shape:TRF-076-NonApplicableBranch>
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The propeller type must identify the ship as outside the CP/FP applicability or satisfy the applicable load-case branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:propellerType ?type .
                    FILTER (?type NOT IN ("CP", "FP"))
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-076-Case1Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] .

<urn:nltl:generated-shape:TRF-076-Case2Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] .

<urn:nltl:generated-shape:TRF-076-Case3Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] .

<urn:nltl:generated-shape:TRF-076-Case4Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] .

<urn:nltl:generated-shape:TRF-076-Case5Shape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5
    ] .
