@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-084> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a CP propeller, pitchValueKnown must be present as a boolean." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:propellerType ?type .
                FILTER (?type = "CP")
                FILTER NOT EXISTS {
                    $this nltl:pitchValueKnown ?known .
                    FILTER (datatype(?known) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a CP propeller with unknown pitch value, both MCR pitch quantities must be present in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known .
                FILTER (?type = "CP")
                FILTER (datatype(?known) = xsd:boolean && ?known = false)
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrFreeRunning ?free .
                    ?free qudt:numericValue ?freeValue ;
                          qudt:unit unit:M .
                    FILTER (datatype(?freeValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a CP propeller with unknown pitch value, the bollard-condition MCR pitch must be present in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known .
                FILTER (?type = "CP")
                FILTER (datatype(?known) = xsd:boolean && ?known = false)
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?bollard .
                    ?bollard qudt:numericValue ?bollardValue ;
                             qudt:unit unit:M .
                    FILTER (datatype(?bollardValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a CP propeller with known pitch value, the bollard-condition MCR pitch must be present in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known .
                FILTER (?type = "CP")
                FILTER (datatype(?known) = xsd:boolean && ?known = true)
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?bollard .
                    ?bollard qudt:numericValue ?bollardValue ;
                             qudt:unit unit:M .
                    FILTER (datatype(?bollardValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a CP propeller with unknown pitch value, bollard-condition MCR pitch must equal 0.7 times free-running MCR pitch within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:propellerType ?type ;
                      nltl:pitchValueKnown ?known ;
                      nltl:propellerPitchAtMcrFreeRunning ?free ;
                      nltl:propellerPitchAtMcrBollard ?bollard .
                FILTER (?type = "CP")
                FILTER (datatype(?known) = xsd:boolean && ?known = false)
                ?free qudt:numericValue ?freeValue ;
                      qudt:unit unit:M .
                ?bollard qudt:numericValue ?bollardValue ;
                         qudt:unit unit:M .
                FILTER (datatype(?freeValue) = xsd:decimal)
                FILTER (datatype(?bollardValue) = xsd:decimal)
                BIND (0.7 * ?freeValue AS ?expected)
                FILTER (
                    ABS(?bollardValue - ?expected) >
                    (ABS(?expected) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .
