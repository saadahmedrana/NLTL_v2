@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF_120> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked thruster body used for global natural-frequency estimation must provide damping, water added mass, ship attachment stiffness, a natural frequency, and longitudinal and transverse calculation cases with valid vibration directions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?body .
                ?body rdf:type nltl:thrusterBody .

                FILTER NOT EXISTS {
                    $this nltl:damping ?damping .
                    FILTER (isLiteral(?damping) && datatype(?damping) = xsd:string)
                }

                FILTER NOT EXISTS {
                    $this nltl:waterAddedMass ?waterMass .
                    ?waterMass rdf:type qudt:QuantityValue ;
                        qudt:numericValue ?waterMassValue ;
                        qudt:unit unit:KiloGM .
                    FILTER (datatype(?waterMassValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:thrusterNaturalFrequency ?frequency .
                    ?frequency rdf:type qudt:QuantityValue ;
                        qudt:numericValue ?frequencyValue ;
                        qudt:unit unit:HZ .
                    FILTER (datatype(?frequencyValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?body nltl:shipAttachmentStiffness ?stiffness .
                    ?stiffness rdf:type qudt:QuantityValue ;
                        qudt:numericValue ?stiffnessValue ;
                        qudt:unit unit:KiloN-PER-M .
                    FILTER (datatype(?stiffnessValue) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    ?body nltl:hasNaturalFrequencyCalculationCase ?longitudinalCase .
                    ?longitudinalCase nltl:vibrationDirection nltl:longitudinalDirection .
                }

                FILTER NOT EXISTS {
                    ?body nltl:hasNaturalFrequencyCalculationCase ?transverseCase .
                    ?transverseCase nltl:vibrationDirection nltl:transverseDirection .
                }

                {
                    ?body nltl:hasNaturalFrequencyCalculationCase ?case .
                    FILTER NOT EXISTS {
                        ?case nltl:vibrationDirection ?direction .
                        FILTER (?direction IN (
                            nltl:longitudinalDirection,
                            nltl:transverseDirection
                        ))
                    }
                }
            }
        """
    ] .
