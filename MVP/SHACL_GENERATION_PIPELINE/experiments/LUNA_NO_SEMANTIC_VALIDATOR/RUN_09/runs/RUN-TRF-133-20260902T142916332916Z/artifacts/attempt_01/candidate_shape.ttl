@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-133-Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:message "The ship must have a permitted Finnish-Swedish ice class."
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node [
            sh:class nltl:hullStructure ;
            sh:property [
                sh:path nltl:draughtMarkAftOffset ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "540"^^xsd:decimal ;
                        sh:maxInclusive "540"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:markingReferencePointValue
                ]
            ] ;
            sh:property [
                sh:path nltl:markingPlateThickness ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "5"^^xsd:decimal ;
                        sh:maxInclusive "8"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:markingWeldedToShipSide ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:reflectingMarkingColour ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:reflectingMarkingColourValue ;
                    sh:in (
                        nltl:redReflectingMarkingColour
                        nltl:yellowReflectingMarkingColour
                    )
                ]
            ] ;
            sh:property [
                sh:path nltl:markingPlainlyVisibleInIceConditions ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:letterDimensionsEqualLoadLineMark ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must have a conforming ice-class draught marking."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:node [
            sh:class nltl:hullStructure ;
            sh:property [
                sh:path nltl:warningTriangleUpperEdgeVerticallyAboveIceMark ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:markingAtOrBelowDeckLine ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "1000"^^xsd:decimal ;
                        sh:maxInclusive "1000"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:warningTriangleSideLength ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "300"^^xsd:decimal ;
                        sh:maxInclusive "300"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:markingPlateThickness ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "5"^^xsd:decimal ;
                        sh:maxInclusive "8"^^xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:markingWeldedToShipSide ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:reflectingMarkingColour ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:reflectingMarkingColourValue ;
                    sh:in (
                        nltl:redReflectingMarkingColour
                        nltl:yellowReflectingMarkingColour
                    )
                ]
            ] ;
            sh:property [
                sh:path nltl:markingPlainlyVisibleInIceConditions ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must have a conforming warning triangle marking."
    ] ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:or (
            [
                sh:hasValue true ;
                sh:property [
                    sh:path nltl:hasIceClassDraughtMarking ;
                    sh:node [
                        sh:property [
                            sh:path nltl:draughtMarkAftReferencePoint ;
                            sh:hasValue nltl:timberLoadLineVerticalReference ;
                            sh:minCount 1
                        ]
                    ] ;
                    sh:minCount 1
                ]
            ]
            [
                sh:hasValue false ;
                sh:property [
                    sh:path nltl:hasIceClassDraughtMarking ;
                    sh:node [
                        sh:property [
                            sh:path nltl:draughtMarkAftReferencePoint ;
                            sh:hasValue nltl:loadLineRingCentreReference ;
                            sh:minCount 1
                        ]
                    ] ;
                    sh:minCount 1
                ]
            ]
        ) ;
        sh:message "The timber load line applicability selector and its corresponding draught-mark reference must be present."
    ] .
