@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_010_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowDesignForceMethod ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A bow design force method must be recorded."
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ;
        sh:minCount 1 ;
        sh:message "The ship must be assigned Polar Class PC6 or PC7."
    ] ;
    sh:or (
        gen:I2_010_VerticalSidedBowFormBranch
        gen:I2_010_BowVerticalSideStatusBranch
        gen:I2_010_NormalFrameAngleBranch
    ) ;
    sh:message "The ship must have a vertical-sided bow, represented by the approved vertical-bow indicator or by normal frame angles between 0 and 10 degrees inclusive." .

gen:I2_010_VerticalSidedBowFormBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalSidedBowForm ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The vertical-sided bow form indicator must be true."
    ] .

gen:I2_010_BowVerticalSideStatusBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowVerticalSideStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The bow vertical-side status must be true."
    ] .

gen:I2_010_NormalFrameAngleBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:node gen:I2_010_NormalFrameAngleQuantity ;
        sh:message "A normal frame angle between 0 and 10 degrees inclusive must be recorded."
    ] .

gen:I2_010_NormalFrameAngleQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 10
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
