@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-011-StaticCalculation> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bulbous-bow applicability must be explicitly recorded." ;
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Polar class must be one of the permitted canonical Polar Class values." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:polarClass ;
                sh:in ( nltl:polarClassPc6 nltl:polarClassPc7 ) ;
            ] ;
            sh:property [
                sh:path nltl:shapeCoefficient ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ] ;
            ] ;
            sh:property [
                sh:path nltl:loadPatchAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 1.3 ;
                        sh:maxInclusive 1.3 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ] ;
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ] ;
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ] ;
            ] ;
            sh:property [
                sh:path nltl:bowDesignForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                    ]
                ] ;
            ] ;
            sh:sparql [
                sh:message "The bow design force must be no less than the design forces from methods I2.3.2.1 (iii) and (iv)." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bowDesignForce ?resultValue ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiValue ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivValue .
                        ?resultValue qudt:numericValue ?result ;
                                     qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                        ?iiiValue qudt:numericValue ?iii ;
                                  qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?ivValue qudt:numericValue ?iv ;
                                  qudt:unit <http://qudt.org/vocab/unit/MegaN> .
                        FILTER (?result < (?iii * 1000) || ?result < (?iv * 1000))
                    }
                """ ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:hasValue false ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                ) ;
            ]
        ]
    ) .
