@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_029_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:attachedShellPlatingIncludedInSectionModulus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Each calculation case must include attached shell plating in the section modulus."
            ] ;
            sh:property [
                sh:path nltl:attachedShellPlatingExcludedFromShearArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Each calculation case must exclude attached shell plating from the shear area."
            ] ;
            sh:property [
                sh:path nltl:flangeMaterialIncludedInShearArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    [
                        sh:hasValue false
                    ]
                    [
                        sh:hasValue true ;
                        sh:property [
                            sh:path nltl:sectionCalculationCaseStructuralMember ;
                            sh:minCount 1 ;
                            sh:node [
                                sh:class nltl:structuralMember ;
                                sh:property [
                                    sh:path nltl:flangeFitted ;
                                    sh:datatype xsd:boolean ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1 ;
                                    sh:hasValue true ;
                                    sh:message "A structural member whose flange material is included in shear area must have a fitted flange."
                                ]
                            ]
                        ]
                    ]
                ) ;
                sh:message "Flange material inclusion in shear area must be explicitly represented and, when true, linked to a structural member with a fitted flange."
            ]
        ]
    ] .
