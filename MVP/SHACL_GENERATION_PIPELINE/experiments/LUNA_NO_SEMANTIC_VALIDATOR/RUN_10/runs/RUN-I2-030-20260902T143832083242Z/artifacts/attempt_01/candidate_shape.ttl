@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-030-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-CalculationCaseShape> ;
        sh:message "The ship shall provide a calculation case for the externally performed section-modulus assessment."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-030-CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-CubicCentimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-SquareCentimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:class nltl:localFrameSectionCalculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-LocalFrameSectionCalculationCaseShape>
    ] .

<urn:nltl:generated-shape:I2-030-LocalFrameSectionCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-PlatingShape>
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-030-PlatingShape>
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-DegreeQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-030-InterpolationPointShape>
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030-UnspecifiedUnitQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-030-MetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-MillimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-SquareCentimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-CubicCentimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-DegreeQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030-UnspecifiedUnitQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
