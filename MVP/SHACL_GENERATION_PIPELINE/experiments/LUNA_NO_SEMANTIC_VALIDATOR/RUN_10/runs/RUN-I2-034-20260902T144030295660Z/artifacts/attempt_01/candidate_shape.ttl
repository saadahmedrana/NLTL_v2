@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:GeneratedShape_I2_034 a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:message "A frame profile type relationship is required for the ship."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node nltl:GeneratedShape_I2_034_Member ;
        sh:message "Each represented structural member must satisfy the I2.7.1 applicability and strength constraint."
    ] .

nltl:GeneratedShape_I2_034_Member a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:longitudinalFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:class nltl:structuralLocationValue ;
                sh:minCount 1
            ] ;
            sh:sparql [
                sh:message "A non-side structural member must have a structural location other than sideStructureLocation." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:structuralLocation ?location .
                        FILTER (?location = nltl:sideStructureLocation)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:longitudinalFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:structuralLocation ;
                sh:class nltl:structuralLocationValue ;
                sh:minCount 1 ;
                sh:hasValue nltl:sideStructureLocation
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMemberLoadCase ;
                sh:node nltl:GeneratedShape_I2_034_LoadCase
            ]
        ]
    ) .

nltl:GeneratedShape_I2_034_LoadCase a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node nltl:GeneratedShape_I2_034_ForceQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented applicable load case must provide one combined shear-and-bending demand."
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node nltl:GeneratedShape_I2_034_ForceQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented applicable load case must provide the member plastic strength."
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:node nltl:GeneratedShape_I2_034_ForceQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented applicable load case must provide the midspan plastic-collapse load defining plastic strength."
    ] ;
    sh:sparql [
        sh:message "The combined shear-and-bending demand must not exceed the member plastic strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:combinedShearAndBendingDemand ?demandQuantity .
                ?demandQuantity qudt:numericValue ?demand .
                $this nltl:plasticStrength ?strengthQuantity .
                ?strengthQuantity qudt:numericValue ?strength .
                FILTER (?demand > ?strength)
            }
        """
    ] .

nltl:GeneratedShape_I2_034_ForceQuantity a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .
