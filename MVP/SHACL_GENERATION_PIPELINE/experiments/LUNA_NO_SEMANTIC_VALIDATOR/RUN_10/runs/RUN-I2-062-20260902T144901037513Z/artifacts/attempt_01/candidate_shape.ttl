@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-062> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directCalculationUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record that the required direct calculation is used."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:or (
                [
                    sh:class nltl:loadCarryingStringer ;
                    sh:property [
                        sh:path nltl:partOfGrillageSystem ;
                        sh:class nltl:grillageSystem ;
                        sh:minCount 1 ;
                        sh:message "A load carrying stringer must form part of a grillage system."
                    ]
                ]
                [
                    sh:class nltl:webFrame ;
                    sh:property [
                        sh:path nltl:partOfGrillageSystem ;
                        sh:class nltl:grillageSystem ;
                        sh:minCount 1 ;
                        sh:message "A web frame must form part of a grillage system."
                    ]
                ]
            )
        ]
    ] .
