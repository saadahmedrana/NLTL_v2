@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-066-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:node <urn:nltl:generated-shape:I2-066-WeldScopeShape> ;
        sh:message "Each linked weld must declare whether it is within the ice-strengthened area and, when applicable, must be double continuous."
    ] .

<urn:nltl:generated-shape:I2-066-WeldScopeShape>
    a sh:NodeShape ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:weldType ;
                sh:minCount 1 ;
                sh:hasValue nltl:doubleContinuousWeld ;
                sh:message "Welding within an ice-strengthened area must be of the double continuous type."
            ]
        ]
    ) .
