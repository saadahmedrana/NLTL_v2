@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO003ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its design ice condition to determine applicability of the category rule."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:in (
                    nltl:openWaterIceCondition
                    nltl:iceConditionLessSevereThanCategoryAAndB
                )
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarShipCategoryValue ;
                sh:minCount 1 ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:message "A ship designed for open water or less severe than category A and B ice conditions shall have polar ship category C."
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:not [
                    sh:in (
                        nltl:openWaterIceCondition
                        nltl:iceConditionLessSevereThanCategoryAAndB
                    )
                ]
            ]
        ]
    ) .
