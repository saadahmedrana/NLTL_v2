@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-018-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:IMO-018-NotApplicableBranch>
        <urn:nltl:generated-shape:IMO-018-ApplicableBranch>
    ) .

<urn:nltl:generated-shape:IMO-018-NotApplicableBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The ice capability methodology applicability decision must be recorded as false or true."
    ] .

<urn:nltl:generated-shape:IMO-018-ApplicableBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ice capability methodology applicability decision must be recorded as false or true."
    ] ;
    sh:property [
        sh:path nltl:certificateMethodologyReferencePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the ice capability methodology is applicable, the certificate must reference the methodology."
    ] ;
    sh:property [
        sh:path nltl:administrationAcceptanceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the ice capability methodology is applicable, Administration acceptance must be recorded as approved."
    ] .
