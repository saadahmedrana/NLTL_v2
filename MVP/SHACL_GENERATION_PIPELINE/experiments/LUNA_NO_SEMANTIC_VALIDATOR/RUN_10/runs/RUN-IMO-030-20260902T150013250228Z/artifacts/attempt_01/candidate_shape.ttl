@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "iceOperationApplicable must be recorded as false when the conditional ice-operation requirement does not apply."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "iceOperationApplicable must be recorded as true to invoke the ice-operation PWOM requirements."
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Ice safety monitoring and safety procedures must be present when ice operation is applicable."
            ] ;
            sh:property [
                sh:path nltl:escortRequirementsPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Applicable escort or icebreaker-assistance requirements must be recorded when ice operation is applicable."
            ] ;
            sh:property [
                sh:path nltl:independentOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Independent-operation limitations must be recorded when ice operation is applicable."
            ] ;
            sh:property [
                sh:path nltl:escortedOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Escorted-operation limitations must be recorded when ice operation is applicable."
            ]
        ]
    ) .
