@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_032_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node gen:IMO_032_CategoryABApprovalRecordShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node gen:IMO_032_CategoryABApprovalRecordShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue true ;
                sh:datatype xsd:boolean ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasApprovalRecord ;
                sh:minCount 1 ;
                sh:node gen:IMO_032_CategoryCApprovalRecordShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue false ;
                sh:datatype xsd:boolean ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:message "The ship category and ice-strengthening status must select an applicable approval branch." .

gen:IMO_032_CategoryABApprovalRecordShape
    a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:minCount 1
    ] ;
    sh:message "Category A or B scantlings require approved status, an authorized approving authority, and an acceptable or equivalent-safety approval standard." .

gen:IMO_032_CategoryCApprovalRecordShape
    a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "acceptable standard adequate for operating ice type and concentration"
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:node gen:IMO_032_ConcentrationQuantityShape
    ] ;
    sh:message "An ice-strengthened Category C approval requires approved status, an authorized authority, an adequate operating-area standard, and operating ice type and concentration." .

gen:IMO_032_ConcentrationQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
