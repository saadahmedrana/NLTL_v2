@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCategoryValue
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:or (
                    [ sh:hasValue nltl:polarShipCategoryA ]
                    [ sh:hasValue nltl:polarShipCategoryB ]
                )
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:node [
                    sh:class nltl:loadingConditionCase ;
                    sh:property [
                        sh:path nltl:loadingConditionIdentifier ;
                        sh:minCount 1 ;
                        sh:datatype xsd:string
                    ] ;
                    sh:property [
                        sh:path nltl:alternativeInstrumentApplicable ;
                        sh:minCount 1 ;
                        sh:datatype xsd:boolean
                    ] ;
                    sh:property [
                        sh:path nltl:residualStabilityFactorSI ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:datatype xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:hasLoadingConditionResultEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:evidenceArtifact
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:alternativeInstrumentApplicable ;
                                sh:hasValue false
                            ] ;
                            sh:property [
                                sh:path nltl:residualStabilityFactorSI ;
                                sh:node [
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:minInclusive 1 ;
                                        sh:maxInclusive 1
                                    ]
                                ]
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:alternativeInstrumentApplicable ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                                sh:minCount 1 ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true
                            ]
                        ]
                    )
                ]
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipCategory ;
                        sh:hasValue nltl:polarShipCategoryC
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:maxExclusive "2017-01-01"^^xsd:date
                    ]
                ]
            )
        ]
    ) ;
    sh:message "Category A or B ships constructed on or after 1 January 2017 require a conforming residual stability outcome for every linked loading condition." .
