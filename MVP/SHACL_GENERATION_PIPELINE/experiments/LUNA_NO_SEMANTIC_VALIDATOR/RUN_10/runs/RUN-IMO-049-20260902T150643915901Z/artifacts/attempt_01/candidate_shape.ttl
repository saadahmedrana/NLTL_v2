@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO049ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO049CategoryABBranch
        gen:IMO049CategoryCBranch
    ) ;
    sh:message "The ship must satisfy the applicable polar-category scantling approval branch." .

gen:IMO049CategoryABBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:message "Category A or B is required for this approval branch."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gen:IMO049CategoryABComponentShape ;
        sh:message "Each linked machinery component must have qualifying approval evidence."
    ] .

gen:IMO049CategoryCBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:message "Category C is required for the ice-strengthened Category C branch."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Ice-strengthened status must be true for the Category C branch."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node gen:IMO049CategoryCComponentShape ;
        sh:message "Each linked machinery component must have qualifying Category C approval evidence."
    ] .

gen:IMO049CategoryABComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The machinery component type is required."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO049CategoryABApprovalShape ;
        sh:message "A Category A or B machinery component requires approved scantling evidence."
    ] .

gen:IMO049CategoryCComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The machinery component type is required."
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO049CategoryCApprovalShape ;
        sh:message "An ice-strengthened Category C machinery component requires approved scantling evidence."
    ] .

gen:IMO049CategoryABApprovalShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The scantling approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "The approval must identify an authorized approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:message "The approval must use an Organization-acceptable or equivalent-safety standard."
    ] .

gen:IMO049CategoryCApprovalShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The scantling approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "The approval must identify an authorized approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:hasValue "acceptable standard adequate for operating ice type and concentration" ;
        sh:message "The Category C approval must use an acceptable standard adequate for the operating ice type and concentration."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Operating ice type is required for Category C approval evidence."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:UNITLESS
            ]
        ] ;
        sh:message "Operating ice concentration with a unitless numeric value is required for Category C approval evidence."
    ] .
