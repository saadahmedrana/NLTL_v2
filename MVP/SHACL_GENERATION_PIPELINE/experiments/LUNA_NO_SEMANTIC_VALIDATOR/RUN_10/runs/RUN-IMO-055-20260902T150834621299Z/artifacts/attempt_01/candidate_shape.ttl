@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO055Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Valve exposure status is required to determine applicability of the valve protection rule."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Valve type is required to determine applicability of the valve protection rule."
    ] ;
    sh:sparql [
        sh:message "Exposed isolating, pressure, or vacuum valves shall have ice accretion protection and remain continuously accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:valveExposed true ;
                      nltl:valveType ?type .
                FILTER (?type IN ("isolating", "pressure", "vacuum"))
                FILTER (
                    NOT EXISTS {
                        $this nltl:iceAccretionProtectionPresent true .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:continuouslyAccessible true .
                    }
                )
            }
        """
    ] .
