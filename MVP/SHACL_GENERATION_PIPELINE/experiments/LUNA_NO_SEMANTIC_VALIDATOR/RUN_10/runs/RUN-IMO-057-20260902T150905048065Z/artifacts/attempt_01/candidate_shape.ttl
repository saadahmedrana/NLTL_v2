@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

nltl:IMO057FirePumpCompartmentTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every fire pump, including emergency fire pumps, water-mist pumps, and water-spray pumps, must be linked to a compartment maintained above 0 deg C." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump rdf:type/rdfs:subClassOf* nltl:firePump .
    FILTER (
        NOT EXISTS {
            ?pump nltl:hasContainingCompartment ?anyCompartment .
        }
        ||
        EXISTS {
            ?pump nltl:hasContainingCompartment ?compartment .
            FILTER (
                NOT EXISTS {
                    ?compartment rdf:type/rdfs:subClassOf* nltl:compartment .
                }
                ||
                NOT EXISTS {
                    ?compartment nltl:maintainedTemperature ?temperature .
                }
                ||
                EXISTS {
                    ?compartment nltl:maintainedTemperature ?temperature .
                    FILTER (
                        NOT EXISTS {
                            ?temperature a qudt:QuantityValue ;
                                qudt:numericValue ?value ;
                                qudt:unit unit:DEG_C .
                            FILTER (
                                datatype(?value) = xsd:decimal &&
                                ?value > 0
                            )
                        }
                    )
                }
            )
        }
    )
}
""" ;
    ] .
