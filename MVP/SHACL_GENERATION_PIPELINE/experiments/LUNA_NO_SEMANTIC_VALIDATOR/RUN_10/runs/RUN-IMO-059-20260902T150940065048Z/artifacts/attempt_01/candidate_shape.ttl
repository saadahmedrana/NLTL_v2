@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

nltl:IMO059_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node nltl:IMO059_FirefighterOutfitShape
    ] .

nltl:IMO059_FirefighterOutfitShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStorageLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:physicalStorageLocation ;
        sh:node nltl:IMO059_StorageLocationShape ;
        sh:message "Each firefighter outfit must be stored in a classified storage location."
    ] .

nltl:IMO059_StorageLocationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:storageTemperatureClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:storageTemperatureClassValue ;
        sh:hasValue nltl:warmStorageLocation ;
        sh:message "The storage location for a firefighter outfit must be classified as warm."
    ] .
