@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO066ApplicableShape
        gen:IMO066NotApplicableShape
    ) .

gen:IMO066ApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A ship applicable to the ice-accretion requirement must record shipExposedToIceAccretion as true."
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:node gen:IMO066ProtectedItemShape
    ] ;
    sh:sparql [
        sh:message "For an exposed ship, each required protected-item category must have an associated ice or snow removal or prevention means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        ?this nltl:hasProtectedItem ?escapeRouteItem .
                        ?escapeRouteItem nltl:protectedItemCategory nltl:escapeRouteProtectedItem ;
                            nltl:hasIceSnowRemovalOrPreventionMeans ?escapeRouteMeans .
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:hasProtectedItem ?musterStationItem .
                        ?musterStationItem nltl:protectedItemCategory nltl:musterStationProtectedItem ;
                            nltl:hasIceSnowRemovalOrPreventionMeans ?musterStationMeans .
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:hasProtectedItem ?embarkationAreaItem .
                        ?embarkationAreaItem nltl:protectedItemCategory nltl:embarkationAreaProtectedItem ;
                            nltl:hasIceSnowRemovalOrPreventionMeans ?embarkationAreaMeans .
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:hasProtectedItem ?survivalCraftItem .
                        ?survivalCraftItem nltl:protectedItemCategory nltl:survivalCraftProtectedItem ;
                            nltl:hasIceSnowRemovalOrPreventionMeans ?survivalCraftMeans .
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:hasProtectedItem ?launchingApplianceItem .
                        ?launchingApplianceItem nltl:protectedItemCategory nltl:launchingApplianceProtectedItem ;
                            nltl:hasIceSnowRemovalOrPreventionMeans ?launchingApplianceMeans .
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:hasProtectedItem ?survivalCraftAccessItem .
                        ?survivalCraftAccessItem nltl:protectedItemCategory nltl:survivalCraftAccessProtectedItem ;
                            nltl:hasIceSnowRemovalOrPreventionMeans ?survivalCraftAccessMeans .
                    }
                )
            }
        """
    ] .

gen:IMO066NotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "A ship not subject to the conditional requirement must record shipExposedToIceAccretion as false."
    ] .

gen:IMO066ProtectedItemShape a sh:NodeShape ;
    sh:class nltl:protectedItem ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:minCount 1 ;
        sh:in (
            nltl:escapeRouteProtectedItem
            nltl:musterStationProtectedItem
            nltl:embarkationAreaProtectedItem
            nltl:survivalCraftProtectedItem
            nltl:launchingApplianceProtectedItem
            nltl:survivalCraftAccessProtectedItem
        ) ;
        sh:message "Each linked protected item must identify one of the required protected-item categories."
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each required protected item must have an associated ice or snow removal or prevention means."
    ] .
