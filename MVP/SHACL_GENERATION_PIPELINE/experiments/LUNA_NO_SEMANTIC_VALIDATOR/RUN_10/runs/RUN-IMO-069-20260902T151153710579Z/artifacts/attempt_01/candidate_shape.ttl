@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO069Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must state whether an added life-saving device requires a source of power."
    ] ;
    sh:or (
        gen:IMO069PowerRequiredShape
        gen:IMO069PowerNotRequiredShape
    ) .

gen:IMO069PowerRequiredShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:devicePowerSourceIndependentOfMainPower ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "When an added life-saving device requires power, its power source must be independent of the ship's main power source."
    ] .

gen:IMO069PowerNotRequiredShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:hasValue false
    ] .
