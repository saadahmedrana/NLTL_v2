@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_074_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "The abandonment potential assessment must be true for this applicable branch."
            ] ;
            sh:property [
                sh:path nltl:groupSurvivalEquipmentCarried ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "Group survival equipment must be carried when abandonment onto ice or land is identified."
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "The abandonment potential assessment must be true for this applicable branch."
            ] ;
            sh:property [
                sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                sh:class nltl:evidenceState ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Approved equivalent functionality for survival must be recorded when group survival equipment is not used."
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:message "The abandonment potential assessment must be explicitly false when the conditional requirement is not applicable."
            ]
        ]
    ) .
