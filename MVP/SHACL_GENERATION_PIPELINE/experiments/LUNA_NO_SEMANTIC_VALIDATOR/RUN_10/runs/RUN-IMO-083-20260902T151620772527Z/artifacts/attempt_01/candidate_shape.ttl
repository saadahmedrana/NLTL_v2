@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:IMO_083_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        nltlg:IMO_083_ApplicableBranch
        nltlg:IMO_083_NotApplicableBranch
    ) ;
    sh:message "iceAccretionLikely must be explicitly recorded as true or false." .

nltlg:IMO_083_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "When ice accretion is likely, iceAccretionLikely must be true."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
        sh:class nltl:navigationOrCommunicationAntenna ;
        sh:node nltlg:IMO_083_AntennaShape
    ] .

nltlg:IMO_083_NotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "When ice accretion is not likely, iceAccretionLikely must be false."
    ] .

nltlg:IMO_083_AntennaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Each required navigation or communication antenna must have ice accumulation prevention means when ice accretion is likely."
    ] .
