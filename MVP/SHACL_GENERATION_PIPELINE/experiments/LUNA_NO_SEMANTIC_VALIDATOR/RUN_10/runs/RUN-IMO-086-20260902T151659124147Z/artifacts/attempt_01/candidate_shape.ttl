@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-086-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 2 ;
        sh:node [
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:minCount 1 ;
                sh:message "Each non-magnetic heading means shall be connected to main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:minCount 1 ;
                sh:message "Each non-magnetic heading means shall be connected to emergency power."
            ] ;
            sh:property [
                sh:path nltl:independentFromHeadingMeans ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:nonMagneticHeadingMeans ;
                sh:minCount 1 ;
                sh:message "Each non-magnetic heading means shall be independent from another heading means."
            ]
        ] ;
        sh:message "The ship shall have at least two non-magnetic heading means."
    ] ;
    sh:sparql [
        sh:message "Each linked non-magnetic heading means shall connect to both power sources and to a distinct linked heading means on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:connectedToMainPower ?mainPower ;
                           nltl:connectedToEmergencyPower ?emergencyPower ;
                           nltl:independentFromHeadingMeans ?otherMeans .
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                }
            }
        """
    ] .
