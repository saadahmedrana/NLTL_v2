@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_106_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A ship must identify its discharged material classification."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For clean ballast or segregated ballast, the Polar Code oil-discharge paragraph 1.1.1 applicability must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (?material IN (
                    nltl:cleanBallastMaterial,
                    nltl:segregatedBallastMaterial
                ))
                FILTER NOT EXISTS {
                    $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
                    FILTER (
                        datatype(?applicable) = xsd:boolean &&
                        ?applicable = false
                    )
                }
            }
        """
    ] .
