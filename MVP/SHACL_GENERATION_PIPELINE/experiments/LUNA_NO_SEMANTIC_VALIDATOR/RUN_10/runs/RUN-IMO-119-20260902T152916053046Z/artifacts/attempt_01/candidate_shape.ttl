@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO119ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:extendedPeriodOperation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeOccurs ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:approvedSewageTreatmentPlantUsed ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:administrationDischargeApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
        sh:class nltl:evidenceState ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For an applicable Category A or B ship, ice concentration above 1/10, extended operation, and sewage discharge require approved treatment, an Administration-approved discharge status, and a MARPOL certification status record." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:shipCategory ?category ;
                      nltl:iceConcentration ?ice ;
                      nltl:extendedPeriodOperation true ;
                      nltl:sewageDischargeOccurs true .

                ?ice qudt:numericValue ?iceValue ;
                     qudt:unit unit:UNITLESS .

                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (datatype(?iceValue) = xsd:decimal)
                FILTER (?iceValue > 1)

                FILTER (
                    NOT EXISTS {
                        ?this nltl:approvedSewageTreatmentPlantUsed true
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:administrationDischargeApprovalStatus
                            nltl:evidenceStateApproved
                    }
                    ||
                    NOT EXISTS {
                        ?this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus
                            ?certificationStatus
                    }
                )
            }
        """
    ] .
