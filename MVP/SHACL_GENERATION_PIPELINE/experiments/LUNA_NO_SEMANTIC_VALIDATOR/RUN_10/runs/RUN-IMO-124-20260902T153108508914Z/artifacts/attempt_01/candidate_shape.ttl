@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_124_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an Antarctic MARPOL Annex V regulation 6.1 discharge, the required ice-distance records must conform, and food waste must not be discharged onto ice." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    FILTER (
        EXISTS {
            $this nltl:operatingArea ?area .
            FILTER (
                datatype(?area) = xsd:string &&
                str(?area) = "Antarctic_area"
            )
        }
        ||
        EXISTS {
            $this nltl:antarcticArea ?area .
            FILTER (
                datatype(?area) = xsd:string &&
                str(?area) = "Antarctic_area"
            )
        }
    )
    FILTER (
        EXISTS {
            $this nltl:marpolAnnexVRegulation6Point1DischargeOccurs true
        }
    )
    FILTER (
        NOT EXISTS {
            $this nltl:distanceToNearestFastIce ?fastIceDistance .
            ?fastIceDistance a qudt:QuantityValue ;
                qudt:numericValue ?fastIceValue ;
                qudt:unit unit:MI_N .
            FILTER (
                datatype(?fastIceValue) = xsd:decimal &&
                ?fastIceValue >= 12
            )
        }
        ||
        EXISTS {
            $this nltl:distanceToNearestFastIce ?fastIceDistance .
            FILTER NOT EXISTS {
                ?fastIceDistance a qudt:QuantityValue ;
                    qudt:numericValue ?fastIceValue ;
                    qudt:unit unit:MI_N .
                FILTER (
                    datatype(?fastIceValue) = xsd:decimal &&
                    ?fastIceValue >= 12
                )
            }
        }
        ||
        NOT EXISTS {
            $this nltl:nearbyIceConcentration ?nearbyConcentration .
            ?nearbyConcentration a qudt:QuantityValue ;
                qudt:numericValue ?nearbyValue ;
                qudt:unit unit:UNITLESS .
            FILTER (
                datatype(?nearbyValue) = xsd:decimal &&
                ?nearbyValue > 0.1
            )
        }
        ||
        EXISTS {
            $this nltl:nearbyIceConcentration ?nearbyConcentration .
            FILTER NOT EXISTS {
                ?nearbyConcentration a qudt:QuantityValue ;
                    qudt:numericValue ?nearbyValue ;
                    qudt:unit unit:UNITLESS .
                FILTER (
                    datatype(?nearbyValue) = xsd:decimal &&
                    ?nearbyValue > 0.1
                )
            }
        }
        ||
        NOT EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?iceAreaDistance .
            ?iceAreaDistance a qudt:QuantityValue ;
                qudt:numericValue ?iceAreaDistanceValue ;
                qudt:unit unit:MI_N .
            FILTER (datatype(?iceAreaDistanceValue) = xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?iceAreaDistance .
            FILTER NOT EXISTS {
                ?iceAreaDistance a qudt:QuantityValue ;
                    qudt:numericValue ?iceAreaDistanceValue ;
                    qudt:unit unit:MI_N .
                FILTER (datatype(?iceAreaDistanceValue) = xsd:decimal)
            }
        }
        ||
        NOT EXISTS {
            $this nltl:foodWasteDischargeOntoIce false
        }
        ||
        EXISTS {
            $this nltl:foodWasteDischargeOntoIce true
        }
    )
}
""" ;
    ] .
