@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-005-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:headingOrPositionSystem ;
        sh:datatype xsd:string ;
        sh:message "The ship's heading-reference and position-fixing system inventory must be represented as strings."
    ] ;
    sh:property [
        sh:path nltl:intendedArea ;
        sh:datatype xsd:string ;
        sh:message "The intended area must be represented as a string."
    ] ;
    sh:property [
        sh:path nltl:intendedAreaSuitabilityApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every heading-reference and position-fixing system must have approved intended-area suitability status."
    ] .
