@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_013_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A planned or actual latitude quantity in degrees is required to determine applicability."
    ] ;
    sh:or (
        gen:IMO26_013_LatitudeAtMost80
        gen:IMO26_013_LatitudeOver80
    ) ;
    sh:message "The ship must either have a latitude of at most 80 degrees or satisfy the equipment and power-connection requirements for latitudes over 80 degrees." .

gen:IMO26_013_LatitudeAtMost80
    a sh:NodeShape ;
    sh:property [
        sh:path ( nltl:plannedOrActualLatitude qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:maxInclusive "80"^^xsd:decimal
    ] .

gen:IMO26_013_LatitudeOver80
    a sh:NodeShape ;
    sh:property [
        sh:path ( nltl:plannedOrActualLatitude qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "80"^^xsd:decimal
    ] ;
    sh:property [
        sh:path nltl:gnssCompassOrEquivalentCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:message "At latitudes over 80 degrees, at least one GNSS compass or equivalent is required."
    ] ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:benchmarkEntity
        ] ;
        sh:message "At latitudes over 80 degrees, a GNSS compass or equivalent must be connected to the ship's main power source."
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:benchmarkEntity
        ] ;
        sh:message "At latitudes over 80 degrees, a GNSS compass or equivalent must be connected to the ship's emergency power source."
    ] .
