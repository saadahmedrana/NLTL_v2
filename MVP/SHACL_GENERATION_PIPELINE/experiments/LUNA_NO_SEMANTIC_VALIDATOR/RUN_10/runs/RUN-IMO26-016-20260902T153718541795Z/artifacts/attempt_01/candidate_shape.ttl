@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:message "shipOperatesInPolarWaters, when supplied, must be a boolean." ;
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:message "polarCodeChapter11Dash1Applicable, when supplied, must be a boolean." ;
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:message "shipType, when supplied, must be a string." ;
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:message "engagedInTrade, when supplied, must be a boolean." ;
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
        sh:message "lengthOverall quantities must contain a decimal numericValue expressed in metres." ;
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
        sh:message "grossTonnage quantities must contain a decimal numericValue expressed as unitless." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship operating in polar waters, Chapter 11-1 applicability must be true for a fishing vessel of at least 24 m, a pleasure yacht of at least 300 gross tonnage not engaged in trade, or a cargo ship from 300 to below 500 gross tonnage." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:shipOperatesInPolarWaters true .
  FILTER (
    NOT EXISTS {
      {
        $this nltl:shipType "fishing_vessel" ;
              nltl:lengthOverall ?lengthQuantity .
        ?lengthQuantity qudt:numericValue ?lengthValue ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
        FILTER (
          datatype(?lengthValue) = xsd:decimal &&
          ?lengthValue >= 24
        )
      }
      UNION
      {
        $this nltl:shipType "pleasure_yacht" ;
              nltl:grossTonnage ?tonnageQuantity ;
              nltl:engagedInTrade false .
        ?tonnageQuantity qudt:numericValue ?tonnageValue ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (
          datatype(?tonnageValue) = xsd:decimal &&
          ?tonnageValue >= 300
        )
      }
      UNION
      {
        $this nltl:shipType "cargo_ship" ;
              nltl:grossTonnage ?tonnageQuantity .
        ?tonnageQuantity qudt:numericValue ?tonnageValue ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        FILTER (
          datatype(?tonnageValue) = xsd:decimal &&
          ?tonnageValue >= 300 &&
          ?tonnageValue < 500
        )
      }
    }
    ||
    NOT EXISTS {
      $this nltl:polarCodeChapter11Dash1Applicable true .
    }
  )
}
""" ;
    ] .
