@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-018-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 11-1 applicability must be recorded as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanningTopicCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "When Chapter 11-1 applies, the route planning record must cover all nine clause 11-1.3 topics."
            ] ;
            sh:property [
                sh:path nltl:safetyManagementSystemImplemented ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When Chapter 11-1 applies, the safety management system status must be recorded."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:safetyManagementSystemImplemented ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:safetyManagementSystemImplemented ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:documentedPolarOperationProcedurePresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "If no safety management system is implemented, a documented procedure for operation in polar waters must be present."
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:IMO26-018-ApplicableShape>
    a sh:NodeShape .

<urn:nltl:generated-shape:IMO26-018-NonApplicableShape>
    a sh:NodeShape .
