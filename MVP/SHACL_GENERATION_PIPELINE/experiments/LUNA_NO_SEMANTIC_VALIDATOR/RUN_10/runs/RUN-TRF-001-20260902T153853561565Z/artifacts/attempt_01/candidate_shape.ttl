@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-001> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide its construction contract date to determine applicability of the 2021 Ice Class Regulations."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulatoryProvisionValue ;
        sh:hasValue nltl:iceClassDraughtChapter2Provision2021 ;
        sh:minCount 1 ;
        sh:message "The 2021 Ice Class Regulations chapter 2 Ice Class Draught provision must apply."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulatoryProvision ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulatoryProvisionValue ;
        sh:hasValue nltl:iceClassSection1Point8Provision2021 ;
        sh:minCount 1 ;
        sh:message "The 2021 Ice Class Regulations section 1.8 Ice Classes provision must apply."
    ] ;
    sh:sparql [
        sh:message "Ships contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations as the applicable regulation edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (?contractDate >= "2021-07-05"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2021 .
                }
            }
        """
    ] .
