@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assessment date is required for deadline evaluation."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The construction date is required to determine the applicable marking rule."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The summer load line fresh water draught must be supplied as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The upper ice waterline draught must be supplied as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's ice class is required."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node [
            sh:class nltl:classCertificate ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtFore ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtFore ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A class certificate with all maximum and minimum fore, amidships, and aft ice-class draughts is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:node [
            sh:class nltl:iceDraughtRestrictionDocument
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An ice-draught restriction document is required."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-draught restriction document must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-draught restriction document must be readily available to the master."
    ] ;
    sh:sparql [
        sh:message "For a ship built on or after 1 July 2007, required marking evidence must be present when the summer load line fresh water draught is above the UIWL, including a draught mark at the certificate maximum amidships draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                      nltl:upperIceWaterlineDraught ?uiwlQuantity .
                ?summerQuantity qudt:numericValue ?summerValue .
                ?uiwlQuantity qudt:numericValue ?uiwlValue .
                FILTER (?constructionDate >= "2007-07-01"^^xsd:date)
                FILTER (?summerValue > ?uiwlValue)
                FILTER (
                    !EXISTS { $this nltl:warningTrianglePresent true } ||
                    !EXISTS { $this nltl:iceClassDraughtMarkPresent true } ||
                    !EXISTS {
                        $this nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                        qudt:unit unit:M .
                        FILTER (?markValue = ?maximumValue)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a ship built before 1 July 2007, complete marking evidence or a first scheduled dry docking date is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate .
                FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                FILTER (
                    !EXISTS {
                        $this nltl:warningTrianglePresent true ;
                              nltl:iceClassDraughtMarkPresent true ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                        qudt:unit unit:M .
                        FILTER (?markValue = ?maximumValue)
                    }
                    &&
                    !EXISTS {
                        $this nltl:firstScheduledDryDockingDate ?dryDockingDate
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "When the first scheduled dry docking date has passed or is the assessment date, the required warning triangle and ice-class draught mark must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:firstScheduledDryDockingDate ?dryDockingDate ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (?constructionDate < "2007-07-01"^^xsd:date)
                FILTER (?dryDockingDate <= ?assessmentDate)
                FILTER (
                    !EXISTS {
                        $this nltl:warningTrianglePresent true ;
                              nltl:iceClassDraughtMarkPresent true ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
                              nltl:hasClassCertificate ?certificate .
                        ?markQuantity qudt:numericValue ?markValue ;
                                      qudt:unit unit:M .
                        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                        ?maximumQuantity qudt:numericValue ?maximumValue ;
                                        qudt:unit unit:M .
                        FILTER (?markValue = ?maximumValue)
                    }
                )
            }
        """
    ] .
