@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-022-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-022-AngleQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-022-AngleQuantityShape>
    ] ;
    sh:property [
