@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF_046_FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "Each frame shall identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF_046_FrameEndShape> ;
        sh:message "The upper end of the frame's strengthened part shall be identified and attached to an eligible supporting structure."
    ] .

<urn:nltl:generated-shape:TRF_046_FrameEndShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
                [ sh:class nltl:supportingStructure ]
            )
        ] ;
        sh:message "The frame upper end shall be attached to a deck, tank boundary plating, ice stringer, or other identified supporting structure."
    ] .
