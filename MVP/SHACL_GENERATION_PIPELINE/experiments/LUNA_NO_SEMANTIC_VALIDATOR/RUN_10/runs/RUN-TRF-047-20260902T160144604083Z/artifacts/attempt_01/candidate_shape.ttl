@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-047-frame> a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A frame shall have a strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:message "A frame shall identify its lower end."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:node <urn:nltl:generated-shape:TRF-047-attached-lower-end>
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:node <urn:nltl:generated-shape:TRF-047-horizontal-lower-end>
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-047-attached-lower-end> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:tankTop ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The lower end shall be attached to a permitted deck, tank plating, tank top, or ice stringer."
    ] .

<urn:nltl:generated-shape:TRF-047-horizontal-lower-end> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:supportingStructure
        ] ;
        sh:message "A conditionally connected lower end shall terminate below a supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:horizontalConnectionMember ;
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:class nltl:mainFrame ;
                sh:minCount 1
            ]
        ] ;
        sh:message "A conditionally connected lower end shall have a horizontal member connected to an adjacent main frame."
    ] .

<urn:nltl:generated-shape:TRF-047-main-frame> a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A main frame below the ice belt shall be ice strengthened."
    ] .
