@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DecimalQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LineLoadQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF053IceStringerShape a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityValueShape ;
        sh:message "Ice pressure is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityValueShape ;
        sh:message "Design ice load height is required in metres."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityValueShape ;
        sh:message "Stringer span is required in metres."
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:message "Frame moment factor m is required and must be dimensionless."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityValueShape ;
        sh:message "Yield strength is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LineLoadQuantityValueShape ;
        sh:message "Design line load is required in kN/m."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SectionModulusQuantityValueShape ;
        sh:message "Section modulus is required in cm3."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AreaQuantityValueShape ;
        sh:message "Required shear area is required in cm2."
    ] ;
    sh:sparql [
        sh:message "Design line load, section modulus, and required shear area do not satisfy the TRF-053 formulas; calculated decimal results are checked with a relative tolerance of 1e-6 and an absolute fallback of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                       nltl:designIceLoadHeight ?heightNode ;
                       nltl:span ?spanNode ;
                       nltl:frameMomentFactorM ?momentNode ;
                       nltl:yieldStrength ?yieldNode ;
                       nltl:designLineLoad ?lineLoadNode ;
                       nltl:sectionModulus ?sectionNode ;
                       nltl:requiredShearArea ?areaNode .

                ?pressureNode qudt:numericValue ?pressure .
                ?heightNode qudt:numericValue ?height .
                ?spanNode qudt:numericValue ?span .
                ?momentNode qudt:numericValue ?moment .
                ?yieldNode qudt:numericValue ?yield .
                ?lineLoadNode qudt:numericValue ?lineLoad .
                ?sectionNode qudt:numericValue ?section .
                ?areaNode qudt:numericValue ?area .

                BIND((?pressure * ?height) AS ?pressureHeight)
                BIND(IF(?pressureHeight < 0.15, 0.15, ?pressureHeight) AS ?expectedLineLoad)
                BIND((0.9 * 1.8 * ?expectedLineLoad * ?span * ?span / (?moment * ?yield) * 1000000) AS ?expectedSection)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?expectedLineLoad * ?span / (2 * ?yield) * 10000) AS ?expectedArea)

                FILTER (
                    ?lineLoad != ?expectedLineLoad ||
                    ABS(?section - ?expectedSection) >
                        (0.000001 * IF(ABS(?expectedSection) > 1, ABS(?expectedSection), 1)) ||
                    ABS(?area - ?expectedArea) >
                        (0.000001 * IF(ABS(?expectedArea) > 1, ABS(?expectedArea), 1))
                )
            }
        """
    ] .
