@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF055NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The narrow deck strip is not abreast of a hatch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "The narrow deck strip does not serve as an ice stringer."
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:abreastOfHatch ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Applicability requires the narrow deck strip to be recorded as abreast of a hatch."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:servesAsIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "Applicability requires the narrow deck strip to be recorded as serving as an ice stringer."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:actualSectionModulus ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue qudt:CentiM3
                            ]
                        ] ;
                        sh:message "Actual section modulus must be supplied in cm^3."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:requiredSectionModulus ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue qudt:CentiM3
                            ]
                        ] ;
                        sh:message "Required section modulus must be supplied in cm^3."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:actualShearArea ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue qudt:CentiM2
                            ]
                        ] ;
                        sh:message "Actual shear area must be supplied in cm^2."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:requiredShearArea ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:datatype xsd:decimal
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue qudt:CentiM2
                            ]
                        ] ;
                        sh:message "Required shear area must be supplied in cm^2."
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "Actual section modulus and actual shear area must meet their required values." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:actualSectionModulus/qudt:numericValue ?actualZ .
                                $this nltl:requiredSectionModulus/qudt:numericValue ?requiredZ .
                                $this nltl:actualShearArea/qudt:numericValue ?actualA .
                                $this nltl:requiredShearArea/qudt:numericValue ?requiredA .
                                FILTER (?actualZ < ?requiredZ || ?actualA < ?requiredA)
                            }
                        """
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:veryLongHatchOpening ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue false
                            ]
                        ]
                        [
                            sh:and (
                                [
                                    sh:property [
                                        sh:path nltl:veryLongHatchOpening ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue true
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:permittedReducedLineLoad ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:node [
                                            sh:property [
                                                sh:path qudt:numericValue ;
                                                sh:minCount 1 ;
                                                sh:maxCount 1 ;
                                                sh:datatype xsd:decimal ;
                                                sh:minInclusive 0.10 ;
                                                sh:maxExclusive 0.15
                                            ] ;
                                            sh:property [
                                                sh:path qudt:unit ;
                                                sh:minCount 1 ;
                                                sh:maxCount 1 ;
                                                sh:hasValue qudt:KiloN-PER-M
                                            ]
                                        ] ;
                                        sh:message "For a very long hatch, the permitted reduced line load must be at least 0.10 and less than 0.15 kN/m."
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1 ;
                                        sh:hasValue true ;
                                        sh:message "A reduced line load for a very long hatch requires classification society approval."
                                    ]
                                ]
                            )
                        ]
                    )
                ]
            )
        ]
    ) .
