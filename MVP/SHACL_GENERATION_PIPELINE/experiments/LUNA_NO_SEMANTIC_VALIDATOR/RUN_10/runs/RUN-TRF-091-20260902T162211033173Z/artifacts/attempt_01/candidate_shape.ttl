@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:message "The ship shall identify the ice milling load-sequence case." ;
        sh:node gen:TRF091IceMillingSequenceCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:message "The ship shall identify the propulsion-line strength-evaluation load case." ;
        sh:node gen:TRF091PropulsionLoadCaseShape
    ] .

gen:TRF091IceMillingSequenceCaseShape
    a sh:NodeShape .

gen:TRF091PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:not [
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ] ;
        sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis."
    ] .
