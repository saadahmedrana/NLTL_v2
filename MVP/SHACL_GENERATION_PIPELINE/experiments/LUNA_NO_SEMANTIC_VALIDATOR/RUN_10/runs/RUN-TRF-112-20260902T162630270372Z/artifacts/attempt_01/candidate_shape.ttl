@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-112-ComplexReadiness> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:message "The ship shall identify the applicable propeller shaft line component." ;
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:message "The ship shall identify the propulsion load case used for applicability and readiness assessment." ;
    ] ;
    sh:property [
        sh:path ( nltl:hasPropulsionLoadCase nltl:shaftLineLoadCaseType ) ;
        sh:class nltl:shaftLineLoadCaseTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each propulsion load case shall identify one shaft line load case type." ;
    ] ;
    sh:sparql [
        sh:message "For an applicable total blade failure load case, the externally calculated ultimate and combined loads shall be recorded in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                FILTER NOT EXISTS {
                    ?loadCase nltl:bladeFailureUltimateLoad ?ultimateQuantity .
                    ?ultimateQuantity qudt:numericValue ?ultimateValue ;
                                       qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER ( datatype(?ultimateValue) = xsd:decimal )
                }
                FILTER NOT EXISTS {
                    ?loadCase nltl:combinedAxialBendingTorsionLoad ?combinedQuantity .
                    ?combinedQuantity qudt:numericValue ?combinedValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER ( datatype(?combinedValue) = xsd:decimal )
                }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "For an applicable total blade failure load case, bending and torsional yield safety factors shall be recorded as dimensionless values of at least 1.0 for each linked propeller shaft line component." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?loadCase .
                ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER NOT EXISTS {
                    ?component nltl:bendingYieldSafetyFactor ?bendingQuantity .
                    ?bendingQuantity qudt:numericValue ?bendingValue ;
                                     qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        datatype(?bendingValue) = xsd:decimal &&
                        ?bendingValue >= 1
                    )
                }
                FILTER NOT EXISTS {
                    ?component nltl:torsionalYieldSafetyFactor ?torsionalQuantity .
                    ?torsionalQuantity qudt:numericValue ?torsionalValue ;
                                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        datatype(?torsionalValue) = xsd:decimal &&
                        ?torsionalValue >= 1
                    )
                }
            }
        """ ;
    ] .
