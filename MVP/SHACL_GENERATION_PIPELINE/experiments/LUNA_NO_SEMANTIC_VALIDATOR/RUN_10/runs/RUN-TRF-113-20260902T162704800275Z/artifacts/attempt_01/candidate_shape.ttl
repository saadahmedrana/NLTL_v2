@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF_113_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:steeringMechanism
        ] ;
        sh:message "The ship shall identify a steering mechanism designed for the blade-loss plastic-bending load."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:thrusterFitting
        ] ;
        sh:message "The ship shall identify the thruster fitting designed for the blade-loss plastic-bending load."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:thrusterBody
        ] ;
        sh:message "The ship shall identify the thruster body designed for the blade-loss plastic-bending load."
    ] ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship shall record the blade plastic-bending design condition."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship shall record the propeller blade orientation producing the maximum component load."
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "The ship shall provide evidence of the thruster blade-loss design assessment."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:datatype xsd:boolean ;
                sh:message "Each propulsion load case shall confirm that blade loss was assessed at the blade orientation producing the maximum component load."
            ]
        ]
    ] .
