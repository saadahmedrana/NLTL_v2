@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF123Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:minCount 1 ;
        sh:class nltl:occasionalForceLoadCase ;
        sh:node gen:TRF123OccasionalForceLoadCaseShape ;
        sh:message "The ship must provide an occasional-force load case for the required readiness assessment."
    ] .

gen:TRF123OccasionalForceLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The occasional-force load case must explicitly confirm that propeller blades are excluded."
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF123DimensionlessQuantityShape ;
        sh:message "The occasional-force load case must contain the externally calculated component yield safety factor."
    ] ;
    sh:property [
        sh:path nltl:occasionalForceCaseAssessedComponent ;
        sh:minCount 1 ;
        sh:class nltl:shipComponent ;
        sh:node gen:TRF123AssessedComponentShape ;
        sh:message "The occasional-force load case must identify each assessed component."
    ] .

gen:TRF123AssessedComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:occasionalForceComponentStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF123PressureQuantityShape ;
        sh:message "Each assessed component must provide its externally calculated occasional-force stress."
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:class nltl:materialProperties ;
        sh:node gen:TRF123MaterialPropertiesShape ;
        sh:message "Each assessed component must identify its material properties."
    ] .

gen:TRF123MaterialPropertiesShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF123PressureQuantityShape ;
        sh:message "The material properties must provide the component material yield strength."
    ] .

gen:TRF123PressureQuantityShape
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

gen:TRF123DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class q:QuantityValue ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
