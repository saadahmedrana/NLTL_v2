@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF131ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:ballastWaterCoolingArrangement ;
        sh:datatype xsd:string ;
        sh:message "A ballast-water cooling arrangement must be represented as a string when present."
    ] ;
    sh:sparql [
        sh:message "A ballast-water cooling arrangement may be used as a reserve but must not be accepted as a substitute for an inlet chest; the applicable substitute status must be false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ballastWaterCoolingArrangement ?arrangement .
                FILTER NOT EXISTS {
                    $this nltl:substituteArrangementStatus ?status .
                    FILTER (
                        datatype(?status) = xsd:boolean &&
                        ?status = false
                    )
                }
            }
        """
    ] .
