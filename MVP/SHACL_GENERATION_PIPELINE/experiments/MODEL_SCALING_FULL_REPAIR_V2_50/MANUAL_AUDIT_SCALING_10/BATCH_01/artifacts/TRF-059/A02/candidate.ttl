@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF059WebFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The web frame shear factor alpha must correspond to the free-flange-to-web-area ratio in Table 4-8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity .
                ?ratioQuantity qudt:numericValue ?ratio .
                ?alphaQuantity qudt:numericValue ?alpha .
                FILTER (!(
                    (?ratio = "0"^^xsd:decimal && ?alpha = "1.5"^^xsd:decimal) ||
                    (?ratio = "0.2"^^xsd:decimal && ?alpha = "1.23"^^xsd:decimal) ||
                    (?ratio = "0.4"^^xsd:decimal && ?alpha = "1.16"^^xsd:decimal) ||
                    (?ratio = "0.6"^^xsd:decimal && ?alpha = "1.11"^^xsd:decimal) ||
                    (?ratio = "0.8"^^xsd:decimal && ?alpha = "1.09"^^xsd:decimal) ||
                    (?ratio = "1.0"^^xsd:decimal && ?alpha = "1.07"^^xsd:decimal) ||
                    (?ratio = "1.2"^^xsd:decimal && ?alpha = "1.06"^^xsd:decimal) ||
                    (?ratio = "1.4"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                    (?ratio = "1.6"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                    (?ratio = "1.8"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal) ||
                    (?ratio = "2.0"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal)
                ))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Required shear area must satisfy the prescribed formula within relative tolerance 1e-6 and absolute fallback 1e-9 cm2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?strengthQuantity ;
                      nltl:requiredShearArea ?areaQuantity .
                ?forceQuantity qudt:numericValue ?forceKiloN .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?strengthQuantity qudt:numericValue ?yieldStrengthMPa .
                ?areaQuantity qudt:numericValue ?reportedAreaCm2 .
                BIND(
                    IF(
                        ?yieldStrengthMPa = "0"^^xsd:decimal,
                        "0"^^xsd:decimal,
                        "1.7320508075688772935"^^xsd:decimal *
                        ?alpha *
                        "1.1"^^xsd:decimal *
                        (?forceKiloN / "1000"^^xsd:decimal) /
                        ?yieldStrengthMPa *
                        "10000"^^xsd:decimal
                    )
                    AS ?expectedAreaCm2
                )
                BIND(
                    IF(
                        ABS(?expectedAreaCm2) * "0.000001"^^xsd:decimal >
                            "0.000000001"^^xsd:decimal,
                        ABS(?expectedAreaCm2) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (
                    ?yieldStrengthMPa = "0"^^xsd:decimal ||
                    ABS(?reportedAreaCm2 - ?expectedAreaCm2) > ?tolerance
                )
            }
        """
    ] .
