@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:availableEmergencyRationPerson ex:availableEmergencyRationPersonValue ;
    nltl:maximumExpectedRescueTime ex:maximumExpectedRescueTimeValue ;
    nltl:personsOnBoard 1 .

ex:availableEmergencyRationPersonValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DAY .

ex:maximumExpectedRescueTimeValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DAY .

