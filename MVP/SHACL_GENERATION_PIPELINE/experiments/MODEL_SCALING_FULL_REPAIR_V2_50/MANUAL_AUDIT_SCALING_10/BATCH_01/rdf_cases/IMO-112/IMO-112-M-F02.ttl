@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:arcticWaters "Arctic waters"^^xsd:string ;
    nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea false .

