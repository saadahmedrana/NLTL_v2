@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
    nltl:constructionStageDate "2003-09-01"^^xsd:date ;
    nltl:engineOutputRegulationEdition nltl:iceClassRuleEdition1985 ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:ownerRequested2008EngineOutputRequirements false .

