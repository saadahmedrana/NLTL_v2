@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:brashIceResistanceCoefficientC1 ex:brashIceResistanceCoefficientC1 ;
    nltl:brashIceResistanceCoefficientC2 ex:brashIceResistanceCoefficientC2 ;
    nltl:bulbousBowPresent false ;
    nltl:coefficientF2 ex:coefficientF2 ;
    nltl:coefficientF3 ex:coefficientF3 ;
    nltl:coefficientF4 ex:coefficientF4 ;
    nltl:coefficientG1 ex:coefficientG1 ;
    nltl:coefficientG2 ex:coefficientG2 ;
    nltl:coefficientG3 ex:coefficientG3 ;
    nltl:iceClass nltl:iceClassIaSuper ;
    nltl:iceClassDraught ex:iceClassDraught ;
    nltl:shipBreadth ex:shipBreadth ;
    nltl:shipLength ex:shipLength .

ex:brashIceResistanceCoefficientC1 a qudt:QuantityValue ;
    qudt:numericValue 65394.63534883721 ;
    qudt:unit unit:N .

ex:brashIceResistanceCoefficientC2 a qudt:QuantityValue ;
    qudt:numericValue 49576.17759721259 ;
    qudt:unit unit:N .

ex:coefficientF2 a qudt:QuantityValue ;
    qudt:numericValue 45.8 ;
    qudt:unit unit:N-PER-M .

ex:coefficientF3 a qudt:QuantityValue ;
    qudt:numericValue 2.94 ;
    qudt:unit unit:N-PER-M .

ex:coefficientF4 a qudt:QuantityValue ;
    qudt:numericValue 5.8 ;
    qudt:unit unit:N-PER-M2 .

ex:coefficientG1 a qudt:QuantityValue ;
    qudt:numericValue 1530.0 ;
    qudt:unit unit:N .

ex:coefficientG2 a qudt:QuantityValue ;
    qudt:numericValue 170.0 ;
    qudt:unit unit:N-PER-M .

ex:coefficientG3 a qudt:QuantityValue ;
    qudt:numericValue 400.0 ;
    qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .

ex:iceClassDraught a qudt:QuantityValue ;
    qudt:numericValue 9.0 ;
    qudt:unit unit:M .

ex:shipBreadth a qudt:QuantityValue ;
    qudt:numericValue 25.0 ;
    qudt:unit unit:M .

ex:shipLength a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:M .

