@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:material a nltl:materialProperties ;
    nltl:componentMaterialYieldStrength ex:componentMaterialYieldStrengthValue .

ex:ship a nltl:ship ;
    nltl:hasOccasionalForceLoadCase ex:loadCase .

ex:component a nltl:shipComponent ;
    nltl:componentYieldSafetyFactor ex:componentYieldSafetyFactorValue .

ex:componentMaterialYieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:MegaPA .

ex:componentYieldSafetyFactorValue a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

ex:loadCase a nltl:occasionalForceLoadCase ;
    nltl:occasionalForceCaseAssessedComponent ex:component ;
    nltl:occasionalForceComponentStress ex:occasionalForceComponentStressValue ;
    nltl:propellerBladeExcludedFromOccasionalForceScope true .

ex:occasionalForceComponentStressValue a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:MegaPA .

