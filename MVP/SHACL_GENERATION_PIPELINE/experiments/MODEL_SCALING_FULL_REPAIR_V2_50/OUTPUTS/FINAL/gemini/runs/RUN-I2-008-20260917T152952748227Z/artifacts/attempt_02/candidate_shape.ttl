@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:ShipPolarClassIceLoadShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:maxCount 0 ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:BowSubregionCalculationCaseShape> ;
                sh:message "Polar class ships must have at least one bow subregion calculation case." ;
            ] ;
            sh:property [
                sh:path nltl:totalGlancingImpactForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TotalGlancingImpactForceQuantityShape> ;
                sh:message "Polar class ships must specify a total glancing impact force." ;
            ] ;
            sh:property [
                sh:path nltl:averageIcePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:AverageIcePressureQuantityShape> ;
                sh:message "Polar class ships must specify an average ice pressure." ;
            ] ;
            sh:property [
                sh:path nltl:lineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:LineLoadQuantityShape> ;
                sh:message "Polar class ships must specify a line load." ;
            ] ;
            sh:property [
                sh:path nltl:loadPatchHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:LoadPatchHeightQuantityShape> ;
                sh:message "Polar class ships must specify a load patch height." ;
            ] ;
            sh:property [
                sh:path nltl:loadPatchLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:LoadPatchLengthQuantityShape> ;
                sh:message "Polar class ships must specify a load patch length." ;
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:LocalIcePressureQuantityShape> ;
                sh:message "Polar class ships must specify a local ice pressure." ;
            ] ;
            sh:property [
                sh:path nltl:shapeCoefficient ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:ShapeCoefficientQuantityShape> ;
                sh:message "Polar class ships must specify a shape coefficient." ;
            ]
        ]
    ) .

<urn:nltl:generated-shape:BowSubregionCalculationCaseShape> a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:BowShapeCoefficientQuantityShape> ;
        sh:message "Each bow subregion calculation case must have a bow shape coefficient (f_ai)." ;
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:GlancingImpactLineLoadQuantityShape> ;
        sh:message "Each bow subregion calculation case must have a glancing impact line load (Q_i)." ;
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:GlancingImpactPressureQuantityShape> ;
        sh:message "Each bow subregion calculation case must have a glancing impact pressure (P_i)." ;
    ] .

<urn:nltl:generated-shape:TotalGlancingImpactForceQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:BowShapeCoefficientQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:GlancingImpactLineLoadQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:GlancingImpactPressureQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:AverageIcePressureQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:LineLoadQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:LoadPatchHeightQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:LoadPatchLengthQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:LocalIcePressureQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

<urn:nltl:generated-shape:ShapeCoefficientQuantityShape> a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
