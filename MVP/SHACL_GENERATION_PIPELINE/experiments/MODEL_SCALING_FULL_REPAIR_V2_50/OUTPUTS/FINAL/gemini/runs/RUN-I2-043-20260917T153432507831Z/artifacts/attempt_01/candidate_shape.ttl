@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipStructuralStabilityShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:StructuralMemberReadinessShape ;
        sh:message "Each structural member linked from the ship must satisfy readiness requirements." ;
    ] .

gs:StructuralMemberReadinessShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:netFlangeThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NetFlangeThicknessQuantityShape ;
        sh:message "Net flange thickness is a required input for structural member stability." ;
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:YieldStrengthQuantityShape ;
        sh:message "Yield strength is a required input for structural member stability." ;
    ] ;
    sh:property [
        sh:path nltl:flangeOutstand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:FlangeOutstandQuantityShape ;
        sh:message "Flange outstand is a required output for structural member stability." ;
    ] .

gs:NetFlangeThicknessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Net flange thickness numeric value must be specified as a decimal." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Net flange thickness unit must be MilliM." ;
    ] .

gs:YieldStrengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength numeric value must be specified as a decimal." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength unit must be MegaPA." ;
    ] .

gs:FlangeOutstandQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Flange outstand numeric value must be specified as a decimal." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Flange outstand unit must be MilliM." ;
    ] .
