@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:class nltl:exposedEscapeRoute ;
        sh:node shape:ExposedEscapeRouteShape
    ] .

shape:ExposedEscapeRouteShape a sh:NodeShape ;
    sh:targetClass nltl:exposedEscapeRoute ;
    sh:property [
        sh:path nltl:escapeRouteAccessibleStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The escape route accessible status must be true."
    ] ;
    sh:property [
        sh:path nltl:escapeRouteSafeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The escape route safe status must be true."
    ] ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "The escape route must have documented ice/snow mitigation evidence."
    ] .
