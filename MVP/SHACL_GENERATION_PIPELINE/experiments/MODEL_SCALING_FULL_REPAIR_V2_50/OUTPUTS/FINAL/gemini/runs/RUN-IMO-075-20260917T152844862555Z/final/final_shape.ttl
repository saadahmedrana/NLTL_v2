@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO075Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personalOrGroupSurvivalEquipmentRequired ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:personsOnBoard ;
        sh:datatype xsd:integer ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:availableSurvivalEquipmentCapacity ;
        sh:datatype xsd:integer ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:storageAccessibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When personal/group survival equipment is required, available capacity must be >= 110% of persons on board and stowed in an accessible location." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired true .
                OPTIONAL { $this nltl:personsOnBoard ?persons }
                OPTIONAL { $this nltl:availableSurvivalEquipmentCapacity ?capacity }
                OPTIONAL { $this nltl:storageAccessibilityStatus ?accessible }
                FILTER (
                    !BOUND(?persons) ||
                    !BOUND(?capacity) ||
                    !BOUND(?accessible) ||
                    (?capacity < CEIL(?persons * 1.10)) ||
                    (?accessible != true)
                )
            }
        """
    ] .
