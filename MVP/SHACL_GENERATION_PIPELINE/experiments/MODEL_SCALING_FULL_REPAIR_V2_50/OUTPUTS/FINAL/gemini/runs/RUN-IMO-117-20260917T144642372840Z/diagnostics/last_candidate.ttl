@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:SewageTreatmentPlantDischargeComplianceShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Sewage treatment plant operational and discharge distance record requirements are not met when sewage discharge uses a treatment plant." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?value ?message
            WHERE {
                $this nltl:sewageDischargeUsesTreatmentPlant true .
                BIND($this AS ?value)
                {
                    FILTER NOT EXISTS {
                        $this nltl:sewageTreatmentPlantApprovalStatus nltl:evidenceStateApproved .
                    }
                    BIND("Sewage treatment plant approval status must be approved." AS ?message)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateApproved .
                    }
                    BIND("MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status must be approved." AS ?message)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus true .
                    }
                    BIND("MARPOL Annex IV regulation 11.1.2 discharge compliance status must be compliant (true)." AS ?message)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasDischargeDistanceRecord ?record .
                    }
                    BIND("At least one discharge distance record must be registered for the ship." AS ?message)
                }
                UNION
                {
                    $this nltl:hasDischargeDistanceRecord ?record .
                    {
                        FILTER NOT EXISTS {
                            ?record nltl:distanceToNearestLandIceShelfOrFastIce ?qty1 .
                            ?qty1 qudt:numericValue ?val1 .
                            ?qty1 qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                        }
                        BIND("Each discharge distance record must contain the distance to nearest land, ice shelf, or fast ice in nautical miles." AS ?message)
                    }
                    UNION
                    {
                        FILTER NOT EXISTS {
                            ?record nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ?qty2 .
                            ?qty2 qudt:numericValue ?val2 .
                            ?qty2 qudt:unit <http://qudt.org/vocab/unit/MI_N> .
                        }
                        BIND("Each discharge distance record must contain the distance to area with ice concentration exceeding 1/10 in nautical miles." AS ?message)
                    }
                }
            }
        """
    ] .
