@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:message "Ice class must be an IRI." ;
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Ice knife practicable must be a single boolean value." ;
    ] ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:nodeKind sh:IRI ;
        sh:message "Rudder protection arrangement must refer to an IRI." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice classes IA and IA Super, the rudder must be protected by an ice knife extending below the LIWL if practicable, or by equivalent means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))

                FILTER NOT EXISTS {
                    ?this nltl:hasRudderProtectionArrangement ?arr .
                    {
                        ?arr rdf:type nltl:equivalentRudderProtectionMeans .
                    }
                    UNION
                    {
                        ?arr rdf:type nltl:iceKnife .
                        FILTER (
                            NOT EXISTS { ?this nltl:iceKnifePracticable true } ||
                            EXISTS { ?arr nltl:extendsBelowLowerIceWaterline true }
                        )
                    }
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IceKnifeShape> a sh:NodeShape ;
    sh:targetClass nltl:iceKnife ;
    sh:property [
        sh:path nltl:extendsBelowLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Extends below lower ice waterline must be a single boolean value." ;
    ] .
