@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:TRF102Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:bladeExpandedAreaRatio ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorqueFactor ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorque ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN-M ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:sparql [
        sh:message "bladeFailureSpindleTorqueFactor does not match the calculated value max(0.3, 0.7 * (1 - (4 * bladeExpandedAreaRatio / propellerBladeCount)^3))" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeExpandedAreaRatio/qudt:numericValue ?ear ;
                      nltl:propellerBladeCount ?z ;
                      nltl:bladeFailureSpindleTorqueFactor/qudt:numericValue ?c_spex .
                FILTER(?z > 0)
                BIND( (4.0 * ?ear) / ?z AS ?ratio )
                BIND( 0.7 * (1.0 - (?ratio * ?ratio * ?ratio)) AS ?raw_c_spex )
                BIND( IF(?raw_c_spex > 0.3, ?raw_c_spex, 0.3) AS ?expected_c_spex )
                FILTER( abs(?c_spex - ?expected_c_spex) > 1e-5 )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "bladeFailureSpindleTorque does not match the calculated value max(C_LE0.8, 0.8 * C_TE0.8) * C_spex * F_ex" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:leadingEdgeChordPortionAtZeroPointEightRadius/qudt:numericValue ?c_le ;
                      nltl:trailingEdgeChordPortionAtZeroPointEightRadius/qudt:numericValue ?c_te ;
                      nltl:bladeFailureSpindleTorqueFactor/qudt:numericValue ?c_spex ;
                      nltl:extremeIceForce/qudt:numericValue ?f_ex ;
                      nltl:bladeFailureSpindleTorque/qudt:numericValue ?q_sex .
                BIND( IF(?c_le > 0.8 * ?c_te, ?c_le, 0.8 * ?c_te) AS ?max_chord )
                BIND( ?max_chord * ?c_spex * ?f_ex AS ?expected_q_sex )
                FILTER( abs(?q_sex - ?expected_q_sex) > 1e-5 )
            }
        """ ;
    ] ;
    sh:sparql [
        sh:message "maximumSpindleTorque must equal bladeFailureSpindleTorque unless an approved spindle torque stress analysis is present" ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeFailureSpindleTorque/qudt:numericValue ?q_sex ;
                      nltl:maximumSpindleTorque/qudt:numericValue ?q_smax .
                FILTER NOT EXISTS { $this nltl:approvedSpindleTorqueStressAnalysis ?analysis }
                FILTER( abs(?q_smax - ?q_sex) > 1e-5 )
            }
        """ ;
    ] .
