@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:LengthQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

shape:AreaQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

shape:ShipReadinessShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:node shape:LengthQuantityValueShape ;
        sh:message "Ship must have design ice thickness defined in meters." ;
    ] ;
    sh:property [
        sh:path nltl:nonHemisphericalImpactContactArea ;
        sh:minCount 1 ;
        sh:node shape:AreaQuantityValueShape ;
        sh:message "Ship must have non-hemispherical impact contact area defined in square meters." ;
    ] ;
    sh:property [
        sh:path nltl:propellerHubOrThrusterEndCapImpact ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ship must indicate if a propeller hub or thruster end cap impact applies." ;
    ] .

shape:BenchmarkEntityReadinessShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:minCount 1 ;
        sh:node shape:LengthQuantityValueShape ;
        sh:message "Ship must have an equivalent impact sphere radius defined in meters." ;
    ] ;
    sh:property [
        sh:path nltl:nonHemisphericalImpactArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ship must specify a non-hemispherical impact area name or description." ;
    ] .
