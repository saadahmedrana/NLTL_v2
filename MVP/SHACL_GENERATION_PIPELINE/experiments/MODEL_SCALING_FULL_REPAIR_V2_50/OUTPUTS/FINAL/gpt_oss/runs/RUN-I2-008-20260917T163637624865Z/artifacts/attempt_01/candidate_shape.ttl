@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix : <urn:nltl:generated-shape:> .

:ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    # Polar class (applicability)
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its Polar Class (value of type nltl:polarClassValue)." ;
    ] ;
    # Ship‑level input quantities
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node :AvgIcePressureShape ;
        sh:minCount 1 ;
        sh:message "Average ice pressure (MPa) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node :ShapeCoeffShape ;
        sh:minCount 1 ;
        sh:message "Shape coefficient (unitless) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:lineLoad ;
        sh:node :LineLoadShape ;
        sh:minCount 1 ;
        sh:message "Line load (kN/m) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node :LoadPatchHeightShape ;
        sh:minCount 1 ;
        sh:message "Load patch height (m) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node :LoadPatchLengthShape ;
        sh:minCount 1 ;
        sh:message "Load patch length (m) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node :LocalIcePressureShape ;
        sh:minCount 1 ;
        sh:message "Local ice pressure (MPa) must be supplied." ;
    ] ;
    # Bow‑subregion calculation case(s) containing result quantities
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 1 ;
        sh:node :BowSubregionCaseShape ;
        sh:message "At least one Bow sub‑region calculation case must be provided." ;
    ] .

# ---- Quantity value shapes ----
:AvgIcePressureShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "Numeric value (decimal) required for average ice pressure." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:message "Unit must be MPa for average ice pressure." ;
    ] .

:ShapeCoeffShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
    ] .

:LineLoadShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
    ] .

:LoadPatchHeightShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
    ] .

:LoadPatchLengthShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
    ] .

:LocalIcePressureShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
    ] .

# ---- Bow sub‑region calculation case shape ----
:BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    # Input: bow shape coefficient (f_ai)
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node :BowShapeCoeffShape ;
        sh:minCount 1 ;
        sh:message "Bow shape coefficient must be supplied for the calculation case." ;
    ] ;
    # Result: glancing impact line load (Qi)
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:node :GlancingImpactLineLoadShape ;
        sh:minCount 1 ;
        sh:message "Glancing impact line load (MN·m⁻²) must be supplied." ;
    ] ;
    # Result: glancing impact pressure (Pi)
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:node :GlancingImpactPressureShape ;
        sh:minCount 1 ;
        sh:message "Glancing impact pressure (MPa) must be supplied." ;
    ] ;
    # Result: total glancing impact force (Fi)
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:node :TotalGlancingImpactForceShape ;
        sh:minCount 1 ;
        sh:message "Total glancing impact force (kN) must be supplied." ;
    ] .

:BowShapeCoeffShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
    ] .

:GlancingImpactLineLoadShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
        sh:minCount 1 ;
    ] .

:GlancingImpactPressureShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
    ] .

:TotalGlancingImpactForceShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
    ] .
