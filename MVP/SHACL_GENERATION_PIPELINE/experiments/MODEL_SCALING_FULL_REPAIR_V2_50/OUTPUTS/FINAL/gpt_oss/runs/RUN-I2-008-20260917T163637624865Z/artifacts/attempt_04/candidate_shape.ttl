@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix : <urn:nltl:generated-shape:> .

:ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    # Polar class (applicability)
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:message "A ship must declare its Polar Class (value of type nltl:polarClassValue)." ;
    ] ;
    # Ship‑level input quantities
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node :AverageIcePressureValueShape ;
        sh:minCount 1 ;
        sh:message "Average ice pressure (MPa) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:node :ShapeCoefficientValueShape ;
        sh:minCount 1 ;
        sh:message "Shape coefficient (unitless) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:lineLoad ;
        sh:node :LineLoadValueShape ;
        sh:minCount 1 ;
        sh:message "Line load (kN/m) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node :LoadPatchHeightValueShape ;
        sh:minCount 1 ;
        sh:message "Load patch height (m) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node :LoadPatchLengthValueShape ;
        sh:minCount 1 ;
        sh:message "Load patch length (m) must be supplied." ;
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node :LocalIcePressureValueShape ;
        sh:minCount 1 ;
        sh:message "Local ice pressure (MPa) must be supplied." ;
    ] ;
    # Bow‑subregion calculation case(s) containing result quantities
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 1 ;
        sh:node :BowSubregionCaseShape ;
        sh:message "At least one Bow sub‑region calculation case must be provided." ;
    ] .

# ---- Bow sub‑region calculation case shape ----
:BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    # Input: bow shape coefficient (f_ai)
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node :BowShapeCoefficientValueShape ;
        sh:minCount 1 ;
        sh:message "Bow shape coefficient must be supplied for the calculation case." ;
    ] ;
    # Result: glancing impact line load (Qi)
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:node :GlancingImpactLineLoadValueShape ;
        sh:minCount 1 ;
        sh:message "Glancing impact line load (MN·m⁻²) must be supplied." ;
    ] ;
    # Result: glancing impact pressure (Pi)
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:node :GlancingImpactPressureValueShape ;
        sh:minCount 1 ;
        sh:message "Glancing impact pressure (MPa) must be supplied." ;
    ] ;
    # Result: total glancing impact force (Fi)
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:node :TotalGlancingImpactForceValueShape ;
        sh:minCount 1 ;
        sh:message "Total glancing impact force (kN) must be supplied." ;
    ] .

# ---- QuantityValue shapes for each quantity property ----
:AverageIcePressureValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:ShapeCoefficientValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:LineLoadValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:LoadPatchHeightValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:LoadPatchLengthValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:LocalIcePressureValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:BowShapeCoefficientValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

:GlancingImpactLineLoadValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
