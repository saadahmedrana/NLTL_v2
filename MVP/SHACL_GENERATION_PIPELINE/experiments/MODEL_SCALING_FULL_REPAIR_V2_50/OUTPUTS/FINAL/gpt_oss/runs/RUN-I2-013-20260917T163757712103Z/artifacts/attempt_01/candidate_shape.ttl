@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:InertialLoadEvidenceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classificationSocietyAccelerationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Missing Classification Society acceleration evidence for ship." ;
    ] ;
    sh:property [
        sh:path nltl:inertialLoadDesignConsiderationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Missing inertial load design consideration evidence for ship." ;
    ] .
