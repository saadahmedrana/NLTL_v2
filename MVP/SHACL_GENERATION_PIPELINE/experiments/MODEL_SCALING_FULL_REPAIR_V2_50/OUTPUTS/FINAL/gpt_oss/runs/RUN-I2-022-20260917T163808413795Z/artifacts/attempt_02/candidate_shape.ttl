@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2-022Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For transversely‑framed plating (Omega ≥ 70 deg) the ship must provide all required input quantities and the calculated ice‑load net plate thickness (t_net) with correct units." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this WHERE {
    # Find a plating with framing angle Omega >= 70 deg
    $this nltl:hasPlating ?pl .
    ?pl nltl:framingAngleOmega ?omegaQ .
    ?omegaQ qudt:numericValue ?omegaVal .
    ?omegaQ qudt:unit <http://qudt.org/vocab/unit/DEG> .
    FILTER(?omegaVal >= 70) .

    # PeakPressureFactor (unit UNITLESS) must be present on the ship
    FILTER NOT EXISTS {
        $this nltl:peakPressureFactor ?ppf .
        ?ppf qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?ppf qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
    }

    # AverageIcePressure (unit MPa) must be present on the ship
    FILTER NOT EXISTS {
        $this nltl:averageIcePressure ?aip .
        ?aip qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?aip qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
    }

    # YieldStrength (unit MPa) must be present on the ship
    FILTER NOT EXISTS {
        $this nltl:yieldStrength ?ys .
        ?ys qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?ys qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
    }

    # LoadPatchHeight (unit m) must be present on the ship
    FILTER NOT EXISTS {
        $this nltl:loadPatchHeight ?lph .
        ?lph qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?lph qudt:unit <http://qudt.org/vocab/unit/M> .
    }

    # FrameSpacing (unit m) must be present on at least one structural member
    FILTER NOT EXISTS {
        $this nltl:hasStructuralMember ?sm .
        ?sm nltl:frameSpacing ?fs .
        ?fs qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?fs qudt:unit <http://qudt.org/vocab/unit/M> .
    }

    # SelectedHullAreaFactor (unit UNITLESS) must be present on at least one structural member
    FILTER NOT EXISTS {
        $this nltl:hasStructuralMember ?sm2 .
        ?sm2 nltl:selectedHullAreaFactor ?af .
        ?af qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?af qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
    }

    # Result: iceLoadRequiredNetPlateThickness (unit mm) must be present on plating
    FILTER NOT EXISTS {
        $this nltl:hasPlating ?pl2 .
        ?pl2 nltl:iceLoadRequiredNetPlateThickness ?t .
        ?t qudt:numericValue ?v .
        FILTER(datatype(?v) = xsd:decimal) .
        ?t qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    }
}""" ;
    ] ;
    # --- Dependency relationship checks ---
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Missing required relationship: platingHullAreaClassification from plating." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this WHERE {
    $this nltl:hasPlating ?pl .
    FILTER NOT EXISTS { ?pl nltl:platingHullAreaClassification ?any . }
}""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Missing required relationship: platingSupportedByStructuralMember from plating." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this WHERE {
    $this nltl:hasPlating ?pl .
    FILTER NOT EXISTS { ?pl nltl:platingSupportedByStructuralMember ?any . }
}""" ;
    ] ;
    # --- Applicability evidence (required hull area individuals) ---
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicability evidence missing: bowIntermediateBottomHullArea individual." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this WHERE {
    FILTER NOT EXISTS { nltl:bowIntermediateBottomHullArea a nltl:hullAreaValue . }
}""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicability evidence missing: midbodyBottomHullArea individual." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this WHERE {
    FILTER NOT EXISTS { nltl:midbodyBottomHullArea a nltl:hullAreaValue . }
}""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicability evidence missing: sternBottomHullArea individual." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this WHERE {
    FILTER NOT EXISTS { nltl:sternBottomHullArea a nltl:hullAreaValue . }
}""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicability evidence missing: platingHullAreaClassification property usage." ;
        sh:select """PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this WHERE {
    $this nltl:hasPlating ?pl .
    FILTER NOT EXISTS { ?pl nltl:platingHullAreaClassification ?any . }
}""" ;
    ] .
