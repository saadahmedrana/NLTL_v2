@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

# Shape for QuantityValue of net flange thickness (mm)
gen:NetFlangeThicknessValueShape a sh:NodeShape ;
    sh:property [
        sh:path gen:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "netFlangeThickness must have a numeric decimal value."
    ] ;
    sh:property [
        sh:path gen:unit ;
        sh:hasValue "mm"^^xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "netFlangeThickness must use the unit millimetre."
    ] .

# Shape for QuantityValue of yield strength (MPa)
gen:YieldStrengthValueShape a sh:NodeShape ;
    sh:property [
        sh:path gen:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "yieldStrength must have a numeric decimal value."
    ] ;
    sh:property [
        sh:path gen:unit ;
        sh:hasValue "MPa"^^xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "yieldStrength must use the unit megapascal."
    ] .

# Shape for QuantityValue of flange outstand (mm)
gen:FlangeOutstandValueShape a sh:NodeShape ;
    sh:property [
        sh:path gen:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "flangeOutstand must have a numeric decimal value."
    ] ;
    sh:property [
        sh:path gen:unit ;
        sh:hasValue "mm"^^xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "flangeOutstand must use the unit millimetre."
    ] .

# Shape for each structural member required by the requirement
gen:StructuralMemberShape a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    # net flange thickness quantity (QuantityValue)
    sh:property [
        sh:path nltl:netFlangeThickness ;
        sh:node gen:NetFlangeThicknessValueShape ;
        sh:minCount 1 ;
        sh:message "Each structural member must provide netFlangeThickness as a QuantityValue (mm)."
    ] ;
    # yield strength quantity (QuantityValue)
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:YieldStrengthValueShape ;
        sh:minCount 1 ;
        sh:message "Each structural member must provide yieldStrength as a QuantityValue (MPa)."
    ] ;
    # flange outstand quantity (QuantityValue)
    sh:property [
        sh:path nltl:flangeOutstand ;
        sh:node gen:FlangeOutstandValueShape ;
        sh:minCount 1 ;
        sh:message "Each structural member must provide flangeOutstand as a QuantityValue (mm)."
    ] .

# Ship shape linking to structural members
gen:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "Ship must have at least one structuralMember with required quantities."
    ] .
