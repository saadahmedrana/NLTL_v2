@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:Shape_I2-051> a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # Design vertical ice force at bow (FIB) – required quantity in MN
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    # Upper ice waterline length LUI – required quantity in metres
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    # Longitudinal distribution factor (Cf) – dimensionless, required
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    # Design vertical ice shear force (FI) – required quantity in kN
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    # Link to calculation case (holds position data)
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:calculationCase ;
            sh:property [
                sh:path nltl:hullGirderLongitudinalPositionFromAft ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;

    # --- SPARQL constraint: Cf = 0.0 when position ≤ 0.6 × LUI ---
    sh:sparql [
        sh:message "Longitudinal distribution factor must be 0.0 when hull‑girder position is within 0.6 × LUI from the aft end." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:hullGirderLongitudinalPositionFromAft ?posQty .
                ?posQty qudt:numericValue ?pos .
                $this nltl:upperIceWaterlineLengthLUI ?luiQty .
                ?luiQty qudt:numericValue ?lui .
                $this nltl:longitudinalDistributionFactor ?cfQty .
                ?cfQty qudt:numericValue ?cf .
                FILTER ( ?pos <= (0.6 * ?lui) && (abs(?cf - 0.0) > 1e-9) )
            }"""
    ] ;

    # --- SPARQL constraint: Cf = 1.0 when position ≥ 0.9 × LUI ---
    sh:sparql [
        sh:message "Longitudinal distribution factor must be 1.0 when hull‑girder position is at or beyond 0.9 × LUI from the aft end." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:hullGirderLongitudinalPositionFromAft ?posQty .
                ?posQty qudt:numericValue ?pos .
                $this nltl:upperIceWaterlineLengthLUI ?luiQty .
                ?luiQty qudt:numericValue ?lui .
                $this nltl:longitudinalDistributionFactor ?cfQty .
                ?cfQty qudt:numericValue ?cf .
                FILTER ( ?pos >= (0.9 * ?lui) && (abs(?cf - 1.0) > 1e-9) )
            }"""
    ] ;

    # --- SPARQL constraint: FI = Cf × FIB × 1000 (kN) ---
    sh:sparql [
        sh:message "Design vertical ice shear force (FI) must equal Cf × FIB × 1000 (kN)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this nltl:designVerticalIceForceAtBow ?fibQty .
                ?fibQty qudt:numericValue ?fib .
                $this nltl:designVerticalIceShearForce ?fiQty .
                ?fiQty qudt:numericValue ?fi .
                $this nltl:longitudinalDistributionFactor ?cfQty .
                ?cfQty qudt:numericValue ?cf .
                BIND ( ?cf * ?fib * 1000.0 AS ?expected ) .
                FILTER ( abs(?fi - ?expected) > (1e-6 * (abs(?expected) + 1e-9)) )
            }"""
    ] .
