@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt#> .

gen:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    # calculation case required for non‑linear assessment
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:targetClass nltl:calculationCase ;
            # the calculation method must be the controlled non‑linear method value
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:class nltl:calculationMethodValue ;
                sh:hasValue nltl:nonlinearCalculationMethodValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            # evidence that the non‑linear analysis was accepted
            sh:property [
                sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            # result of the assessment – must be true
            sh:property [
                sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    # operand terms that must be present (quantities with units)
    sh:property [
        sh:path nltl:fractureMargin ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue
        ]
    ] ;
    sh:property [
        sh:path nltl:majorBucklingMargin ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue
        ]
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue
        ]
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue
        ]
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldingMargin ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue
        ]
    ] .
