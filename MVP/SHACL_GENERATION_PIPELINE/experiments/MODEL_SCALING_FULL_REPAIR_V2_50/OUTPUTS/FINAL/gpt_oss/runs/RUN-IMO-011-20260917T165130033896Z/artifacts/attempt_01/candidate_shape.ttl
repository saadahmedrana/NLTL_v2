@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix gen:  <urn:nltl:generated-shape:> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:YR ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:administrationDatasetApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:in ( nltl:evidenceStateApproved )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When dataPeriod is less than 10 years, administrationDatasetApprovalStatus must be Approved." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:dataPeriod ?dp .
                ?dp qudt:numericValue ?val .
                FILTER ( ?val < 10 )
                FILTER NOT EXISTS { $this nltl:administrationDatasetApprovalStatus nltl:evidenceStateApproved . }
            }
        """ ;
    ] .

gen:DailyLowTempObsShape
    a sh:NodeShape ;
    sh:targetClass nltl:dailyLowTemperatureObservation ;
    sh:property [
        sh:path nltl:dailyTemperatureObservationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1
            ]
        ] ;
        sh:minCount 1
    ] .
