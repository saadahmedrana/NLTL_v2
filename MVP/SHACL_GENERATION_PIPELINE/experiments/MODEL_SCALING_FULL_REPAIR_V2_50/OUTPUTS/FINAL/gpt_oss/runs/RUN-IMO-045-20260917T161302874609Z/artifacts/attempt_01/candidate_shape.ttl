@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO-045
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machinerySeawaterSupply ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Machinery seawater supply must be present (true)."
    ] ;
    sh:or (
        [   a sh:NodeShape ;
            sh:property [
                sh:path nltl:iceIngestionPreventionPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ice ingestion prevention must be true."
            ]
        ]
        [   a sh:NodeShape ;
            sh:property [
                sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Alternate functionality arrangement approval status must be approved."
            ]
        ]
    ) ;
    sh:message "Machinery seawater supply must either have ice ingestion prevention true or an approved alternate functionality arrangement." .
