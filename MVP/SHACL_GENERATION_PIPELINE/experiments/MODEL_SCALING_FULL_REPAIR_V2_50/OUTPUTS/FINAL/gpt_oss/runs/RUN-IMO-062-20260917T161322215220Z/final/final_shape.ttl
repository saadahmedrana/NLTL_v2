@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:node gs:ExposedEscapeRouteShape
    ] .

gs:ExposedEscapeRouteShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:escapeRouteAccessibleStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Exposed escape route must be accessible (true)." 
    ] ;
    sh:property [
        sh:path nltl:escapeRouteSafeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Exposed escape route must be safe (true)." 
    ] ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:minCount 1 ;
        sh:message "Exposed escape route must have documented ice/snow mitigation evidence." 
    ] .
