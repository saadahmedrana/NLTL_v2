@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:IMO-079
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # personsOnBoard – integer count
    sh:property [
        sh:path nltl:personsOnBoard ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    # maximumExpectedRescueTime – quantity in days
    sh:property [
        sh:path nltl:maximumExpectedRescueTime ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DAY ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    # availableEmergencyRationPerson – quantity in days
    sh:property [
        sh:path nltl:availableEmergencyRationPerson ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DAY ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    # Comparison: available >= persons * maximum rescue time
    sh:sparql [
        sh:message "availableEmergencyRationPerson must be at least personsOnBoard multiplied by maximumExpectedRescueTime." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:availableEmergencyRationPerson ?avQty .
                ?avQty qudt:numericValue ?avNum .
                $this nltl:maximumExpectedRescueTime ?maxQty .
                ?maxQty qudt:numericValue ?maxNum .
                $this nltl:personsOnBoard ?persons .

                FILTER (?avNum < (?persons * ?maxNum))
            }
        """ ;
    ] .
