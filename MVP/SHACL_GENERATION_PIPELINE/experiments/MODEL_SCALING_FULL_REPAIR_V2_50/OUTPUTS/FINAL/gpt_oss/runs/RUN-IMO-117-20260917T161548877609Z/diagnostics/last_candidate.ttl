@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-117>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    # presence of the boolean flag (optional)
    sh:property [
        sh:path nltl:sewageDischargeUsesTreatmentPlant ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    # conditional constraints when the flag is true
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When sewageDischargeUsesTreatmentPlant is true, required approvals, compliance flags and discharge‑distance records must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this nltl:sewageDischargeUsesTreatmentPlant true .
                FILTER (
                    NOT EXISTS { $this nltl:sewageTreatmentPlantApprovalStatus nltl:evidenceStateApproved } ||
                    NOT EXISTS { $this nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus true } ||
                    NOT EXISTS { $this nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateApproved } ||
                    NOT EXISTS {
                        $this nltl:hasDischargeDistanceRecord ?rec .
                        ?rec nltl:distanceToNearestLandIceShelfOrFastIce ?valLand .
                        FILTER(datatype(?valLand) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:hasDischargeDistanceRecord ?rec2 .
                        ?rec2 nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ?valIce .
                        FILTER(datatype(?valIce) = xsd:decimal)
                    }
                )
            }
        """ ;
        sh:severity sh:Violation
    ] .
