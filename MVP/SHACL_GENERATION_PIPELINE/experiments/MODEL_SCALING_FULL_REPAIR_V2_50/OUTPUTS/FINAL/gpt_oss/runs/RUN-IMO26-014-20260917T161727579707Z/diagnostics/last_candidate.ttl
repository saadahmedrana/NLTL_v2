@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:ShipDaylightIlluminationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # presence of the daylight‑operation flag (boolean)
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must indicate whether it operates only in continuous daylight." ;
    ] ;

    # optional illumination‑means count (integer) – datatype enforced
    sh:property [
        sh:path nltl:visualIceDetectionIlluminationMeansCount ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:message "If present, the illumination‑means count must be an integer." ;
    ] ;

    # conditional rule: when not continuous‑daylight, count must be ≥ 2
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships that do not operate only in continuous daylight must have at least two visual ice‑detection illumination means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:operatesOnlyInContinuousDaylight ?daylight .
                OPTIONAL { $this nltl:visualIceDetectionIlluminationMeansCount ?cnt . }
                FILTER (
                    ?daylight = "false"^^xsd:boolean &&
                    ( !BOUND(?cnt) || ?cnt < 2 )
                )
            }
        """ ;
    ] .
