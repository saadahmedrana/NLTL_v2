@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .

<urn:nltl:generated-shape:TRF-025-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # --- Required ice class (must be IA Super) ---
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;

    # --- Required bulbous bow presence (must be false) ---
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;

    # --- Operand quantities ----------------------------------------------------
    # Ship breadth (B)
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;

    # Ship length (L)
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;

    # Ice class draught (T)
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;

    # Coefficient f1
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2>
            ]
        ]
    ] ;

    # Coefficient f2
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M>
            ]
        ]
    ] ;

    # Coefficient f3
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M>
            ]
        ]
    ] ;

    # Coefficient f4
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2>
            ]
        ]
    ] ;

    # Coefficient g1
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N>
            ]
        ]
    ] ;

    # Coefficient g2
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N-PER-M>
            ]
        ]
    ] ;

    # Coefficient g3 (unit: N·m⁻¹·⁵)
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit
            ]
        ]
    ] ;

    # --- Result quantities (C1 and C2) -----------------------------------------
    # C1
    sh:property [
        sh:path nltl:brashIceResistanceCoefficientC1 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N>
            ]
        ]
    ] ;

    # C2
    sh:property [
        sh:path nltl:brashIceResistanceCoefficientC2 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/N>
            ]
        ]
    ] ;

    # --- Conditional applicability: enforce presence of C1/C2 only for IA Super without bulb ---
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For IA Super ships without a bulb, C1 and C2 must be provided." ;
        sh:select """ 
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                $this nltl:bulbousBowPresent false .
                FILTER NOT EXISTS { $this nltl:brashIceResistanceCoefficientC1 ?c1 . }
                FILTER NOT EXISTS { $this nltl:brashIceResistanceCoefficientC2 ?c2 . }
            }
        """
    ] .
