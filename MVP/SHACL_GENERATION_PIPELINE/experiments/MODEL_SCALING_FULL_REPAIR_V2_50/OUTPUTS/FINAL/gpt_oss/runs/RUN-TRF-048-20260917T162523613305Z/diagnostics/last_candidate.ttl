@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix math: <http://www.w3.org/2005/xpath-functions/math#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF-048
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    # presence of condition indicators
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    # operand properties (mandatory)
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
            ]
        ]
    ] ;

    # frameMomentFactorM – dimensionless quantity (UNITLESS)
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;

    # longitudinalFrameLoadDistributionFactorF4 – dimensionless quantity (UNITLESS)
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;

    # sectionModulus – area‑moment (cm³)
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
            ]
        ]
    ] ;

    # requiredShearArea – area (cm²)
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/numericValue> ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path <http://qudt.org/schema/qudt/unit> ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
            ]
        ]
    ] ;

    # -----------------------------------------------------------------
    # Conditional rule: m = 13.3 when continuous beam with brackets &
    # no significantly different boundary conditions
    # -----------------------------------------------------------------
    sh:sparql [
        sh:message "When frameBoundaryConditionType = continuousBeamWithBracketsFrameCondition and significantlyDifferentBoundaryConditions = false, frameMomentFactorM must be 13.3 (UNITLESS)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qv: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType nltl:continuousBeamWithBracketsFrameCondition .
                $this nltl:significantlyDifferentBoundaryConditions "false"^^xsd:boolean .
                $this nltl:frameMomentFactorM ?qNode .
                ?qNode <http://qudt.org/schema/qudt/numericValue> ?mVal .
                FILTER (datatype(?mVal) = xsd:decimal) .
                BIND (13.3 AS ?expected) .
                BIND (abs(?mVal - ?expected) AS ?diff) .
                FILTER ( ?diff > 1e-6 )
            }
        """ ;
    ] ;

    # -----------------------------------------------------------------
    # Calculation checks for f4, Z, and required shear area A
    # -----------------------------------------------------------------
    sh:sparql [
        sh:message "Calculated values for longitudinalFrameLoadDistributionFactorF4, sectionModulus, and requiredShearArea do not match the prescribed formulas." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX qv: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                # operand literals (extracted from QuantityValue nodes)
                $this nltl:designIceLoadHeight ?hNode .
                $this nltl:spacing ?sNode .
                $this nltl:span ?lNode .
                $this nltl:icePressure ?pNode .
                $this nltl:yieldStrength ?sigNode .
                $this nltl:frameMomentFactorM ?mNode .

                ?hNode <http://qudt.org/schema/qudt/numericValue> ?hVal .
                ?sNode <http://qudt.org/schema/qudt/numericValue> ?sVal .
                ?lNode <http://qudt.org/schema/qudt/numericValue> ?lVal .
                ?pNode <http://qudt.org/schema/qudt/numericValue> ?pVal .
                ?sigNode <http://qudt.org/schema/qudt/numericValue> ?sigVal .
                ?mNode <http://qudt.org/schema/qudt/numericValue> ?mVal .

                FILTER (datatype(?hVal) = xsd:decimal && datatype(?sVal) = xsd:decimal && datatype(?lVal) = xsd:decimal &&
                        datatype(?pVal) = xsd:decimal && datatype(?sigVal) = xsd:decimal && datatype(?mVal) = xsd:decimal) .

                # result literals (extracted from QuantityValue nodes)
                $this nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node .
                $this nltl:sectionModulus ?zNode .
                $this nltl:requiredShearArea ?aNode .

                ?f4Node <http://qudt.org/schema/qudt/numericValue> ?f4Val .
                ?zNode <http://qudt.org/schema/qudt/numericValue> ?zVal .
                ?aNode <http://qudt.org/schema/qudt/numericValue> ?aVal .

                FILTER (datatype(?f4Val) = xsd:decimal && datatype(?zVal) = xsd:decimal && datatype(?aVal) = xsd:decimal) .

                # expected calculations (values are in the units defined by the ontology)
                BIND (1 - (0.2 * ?hVal) / ?sVal AS ?expF4) .
                BIND ( ?expF4 * ?pVal * ?hVal * (?lVal * ?lVal) /
                       (4 * ?mVal * ?sigVal) * 1000000 AS ?expZ ) .
                BIND ( math:sqrt(3) * ?expF4 * 2.16 * ?pVal * ?hVal * ?lVal /
                       (2 * ?sigVal) * 10000 AS ?expA ) .

                BIND (abs(?f4Val - ?expF4) AS ?diffF4) .
                BIND (abs(?zVal - ?expZ) AS ?diffZ) .
                BIND (abs(?aVal - ?expA) AS ?diffA) .

                FILTER ( ?diffF4 > 1e-6 || ?diffZ > 1e-6 || ?diffA > 1e-6 )
            }
        """ ;
    ] .
