@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-051_FrameWebThickness_Min9mm>
    a sh:NodeShape ;
    sh:targetClass nltl:hullStructure ;
    
    # frame web thickness – fixed 9 mm minimum
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "9"^^xsd:decimal ;
        sh:message "Frame web thickness must be at least 9 mm." ;
    ] ;
    
    # required input: adjacent frame height
    sh:property [
        sh:path nltl:adjacentFrameHeight ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Adjacent frame height must be provided as a decimal value (mm)." ;
    ] ;
    
    # required input: corrosion abrasion addition
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Corrosion abrasion addition must be provided as a decimal value (mm)." ;
    ] ;
    
    # required input: frame profile type
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:minCount 1 ;
        sh:class nltl:frameProfileTypeValue ;
        sh:message "Frame profile type must be specified." ;
    ] ;
    
    # required input: in lieu of frame (boolean)
    sh:property [
        sh:path nltl:inLieuOfFrame ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "In lieu of frame must be a boolean." ;
    ] ;
    
    # required input: net shell plating thickness
    sh:property [
        sh:path nltl:netShellPlatingThickness ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Net shell plating thickness must be provided as a decimal value (mm)." ;
    ] ;
    
    # required input: yield strength
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Yield strength must be provided as a decimal value (MPa)." ;
    ] .
