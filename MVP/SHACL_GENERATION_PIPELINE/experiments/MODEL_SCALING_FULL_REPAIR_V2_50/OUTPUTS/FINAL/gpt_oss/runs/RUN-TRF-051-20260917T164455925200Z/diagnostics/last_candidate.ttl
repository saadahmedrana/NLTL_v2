@prefix sh:   <http://www.w3.org/2001/XMLSchema#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .

<urn:nltl:generated-shape:TRF-051_FrameWebThickness_Min9mm>
    a sh:NodeShape ;
    sh:targetClass nltl:hullStructure ;
    
    # frame web thickness – fixed 9 mm minimum (as a QUDT QuantityValue)
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "9"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "Frame web thickness must be provided as a QUDT QuantityValue with a numeric value of at least 9 mm." ;
    ] ;
    
    # required input: adjacent frame height (as a QUDT QuantityValue)
    sh:property [
        sh:path nltl:adjacentFrameHeight ;
        sh:minCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "Adjacent frame height must be provided as a QUDT QuantityValue (mm)." ;
    ] ;
    
    # required input: corrosion abrasion addition (as a QUDT QuantityValue)
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "Corrosion abrasion addition must be provided as a QUDT QuantityValue (mm)." ;
    ] ;
    
    # required input: frame profile type
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:minCount 1 ;
        sh:class nltl:frameProfileTypeValue ;
        sh:message "Frame profile type must be specified." ;
    ] ;
    
    # required input: in lieu of frame (boolean)
    sh:property [
        sh:path nltl:inLieuOfFrame ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "In lieu of frame must be a boolean." ;
    ] ;
    
    # required input: net shell plating thickness (as a QUDT QuantityValue)
    sh:property [
        sh:path nltl:netShellPlatingThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM>
            ]
        ] ;
        sh:message "Net shell plating thickness must be provided as a QUDT QuantityValue (mm)." ;
    ] ;
    
    # required input: yield strength (as a QUDT QuantityValue)
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node [
            sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
            ]
        ] ;
        sh:message "Yield strength must be provided as a QUDT QuantityValue (MPa)." ;
    ] .
