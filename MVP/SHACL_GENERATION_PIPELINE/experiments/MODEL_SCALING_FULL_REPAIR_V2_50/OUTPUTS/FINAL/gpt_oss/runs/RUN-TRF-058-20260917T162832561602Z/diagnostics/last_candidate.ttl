@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF-058Shape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:supportedStringerOutsideIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadForce ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:stringerOutsideIceBeltHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:adjustedIceLoadForce ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 0 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "When supportedStringerOutsideIceBelt is true, adjustedIceLoadForce must equal iceLoadForce * (1 - hs/ls) within tolerance." ;
        sh:select """ 
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:supportedStringerOutsideIceBelt true ;
                     nltl:iceLoadForce ?iceNode ;
                     nltl:stringerOutsideIceBeltHeight ?hsNode ;
                     nltl:stringerSpan ?lsNode ;
                     nltl:adjustedIceLoadForce ?adjNode .

                ?iceNode qudt:numericValue ?iceVal .
                ?hsNode  qudt:numericValue ?hsVal .
                ?lsNode  qudt:numericValue ?lsVal .
                ?adjNode qudt:numericValue ?adjVal .

                BIND ( ?iceVal * (1 - (?hsVal / ?lsVal)) AS ?expected )
                BIND ( 1e-6 AS ?tol )
                FILTER ( ABS(?adjVal - ?expected) > ?tol )
            }
        """ ;
    ] .

gen:AdjIceLoadForceConditionalShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:if [
        sh:property [
            sh:path nltl:supportedStringerOutsideIceBelt ;
            sh:hasValue true ;
        ]
    ] ;
    sh:then [
        sh:property [
            sh:path nltl:adjustedIceLoadForce ;
            sh:node [
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ] ;
                sh:property [
                    sh:path qudt:unit ;
                    sh:hasValue unit:KiloN ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ] ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .
