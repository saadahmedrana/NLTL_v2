@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix gen: <urn:nltl:generated-shape:> .

# Reusable shape for a QUDT QuantityValue with correct unit
gen:QuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Numeric value (xsd:decimal) is required." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Unit IRI is required." ;
    ] .

# Shape for the table lookup case that supplies gamma selection evidence
gen:TableLookupCaseShape a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Evidence of table lookup selection is required." ;
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable4Dash8 ;
        sh:message "Table reference must be the controlled individual traficomTable4Dash8." ;
    ] .

# Main shape targeting the ship
gen:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    # Requirement that a ship provides at least one table lookup case for the gamma factor
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TableLookupCaseShape ;
        sh:message "A table lookup case (for gamma factor) with evidence is required." ;
    ] ;
    # Operand terms – each must have a quantity value with proper unit and be present
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Actual web-frame cross‑sectional area must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Required shear area must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Section modulus must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Shear area must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Web‑frame free flange area must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Web‑frame ice load must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Web‑frame maximum ice load bending moment must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Web‑frame span must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:webFrameTable4Dash8GammaFactor ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Gamma factor (from Table 4‑8) must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Web‑frame web area must be provided." ;
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Yield strength must be provided." ;
    ] .
