@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix :     <urn:nltl:generated-shape:> .

:TRF-070_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # Applicability – thruster type
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:in ( "azimuthing" "fixed" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "thrusterType must be present and be either 'azimuthing' or 'fixed'." ;
    ] ;

    # Applicability – main propulsion thruster must be true
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "mainPropulsionThruster must be true for the requirement to apply." ;
    ] ;

    # Require a design condition and embed the local strength capacity quantity
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:class nltl:designCondition ;
        sh:minCount 1 ;
        sh:message "A designCondition must be associated with the ship." ;
        sh:node [
            sh:property [
                sh:path nltl:designConditionLocalStrengthCapacity ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                    ] ;
                ] ;
                sh:minCount 1 ;
                sh:message "designConditionLocalStrengthCapacity must be provided as a QUDT QuantityValue." ;
            ] ;
        ] ;
    ] ;

    # Require local ice pressure quantity (QUDT QuantityValue)
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
            ] ;
        ] ;
        sh:minCount 1 ;
        sh:message "localIcePressure quantity must be provided as a QUDT QuantityValue." ;
    ] ;

    # Require propeller‑ice interaction load (QUDT QuantityValue)
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
            ] ;
        ] ;
        sh:minCount 1 ;
        sh:message "propellerIceInteractionLoad quantity must be provided as a QUDT QuantityValue." ;
    ] ;

    # Require thruster‑body ice interaction load (QUDT QuantityValue)
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
            ] ;
        ] ;
        sh:minCount 1 ;
        sh:message "thrusterBodyIceInteractionLoad quantity must be provided as a QUDT QuantityValue." ;
    ] ;

    # Direct check: capacity >= pressure (using QUDT numeric values)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Design condition local strength capacity is insufficient compared to local ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this WHERE {
                ?this nltl:hasDesignCondition ?dc .
                ?dc nltl:designConditionLocalStrengthCapacity ?capacityNode .
                ?capacityNode qudt:numericValue ?capacityVal .

                ?this nltl:localIcePressure ?pressureNode .
                ?pressureNode qudt:numericValue ?pressureVal .

                FILTER ( ?capacityVal < ?pressureVal )
            }
        """ ;
    ] .
