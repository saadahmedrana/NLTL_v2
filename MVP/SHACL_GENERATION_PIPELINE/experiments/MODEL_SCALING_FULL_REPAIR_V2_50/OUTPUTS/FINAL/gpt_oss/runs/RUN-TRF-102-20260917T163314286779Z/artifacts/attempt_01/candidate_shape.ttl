@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix : <urn:nltl:generated-shape:> .

:TRF-102 a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    #--- Operand properties -------------------------------------------------
    sh:property [
        sh:path nltl:bladeExpandedAreaRatio ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:leadingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:trailingEdgeChordPortionAtZeroPointEightRadius ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:kN ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;

    #--- Result properties ---------------------------------------------------
    sh:property [
        sh:path nltl:bladeFailureSpindleTorqueFactor ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureSpindleTorque ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:kN.m ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumSpindleTorque ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:kN.m ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;

    #--- Calculation check (applies only if no approved analysis) ------------
    sh:sparql [
        sh:message "Calculated spindle‑torque values do not match the formula defined in TRF‑102." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this WHERE {
                # If a stress‑analysis record exists, skip the calculation check
                FILTER NOT EXISTS { $this nltl:approvedSpindleTorqueStressAnalysis ?analysis . }

                # ---- retrieve operands ------------------------------------------------
                $this nltl:bladeExpandedAreaRatio ?earQty .
                ?earQty qudt:numericValue ?ear .
                $this nltl:propellerBladeCount ?bladeCount .

                $this nltl:leadingEdgeChordPortionAtZeroPointEightRadius ?cLeQty .
                ?cLeQty qudt:numericValue ?cLe .
                $this nltl:trailingEdgeChordPortionAtZeroPointEightRadius ?cTeQty .
                ?cTeQty qudt:numericValue ?cTe .

                $this nltl:extremeIceForce ?iceForceQty .
                ?iceForceQty qudt:numericValue ?Fex .

                # ---- compute C_spex ---------------------------------------------------
                BIND ( (4.0 * ?ear) / ?bladeCount AS ?x )
                BIND ( ?x * ?x * ?x AS ?x3 )
                BIND ( 0.7 * (1.0 - ?x3) AS ?cTemp )
                BIND ( IF ( ?cTemp > 0.3 , ?cTemp , 0.3 ) AS ?cSpexCalc )

                # ---- compute Q_sex ----------------------------------------------------
                BIND ( 0.8 * ?cTe AS ?cTeScaled )
                BIND ( IF ( ?cLe > ?cTeScaled , ?cLe , ?cTeScaled ) AS ?cChordMax )
                BIND ( ?cChordMax * ?cSpexCalc * ?Fex AS ?qSexCalc )

                # ---- retrieve reported results ----------------------------------------
                $this nltl:bladeFailureSpindleTorqueFactor ?factorQty .
                ?factorQty qudt:numericValue ?factorReported .
                $this nltl:bladeFailureSpindleTorque ?torqueQty .
                ?torqueQty qudt:numericValue ?torqueReported .
                $this nltl:maximumSpindleTorque ?maxTorqueQty .
                ?maxTorqueQty qudt:numericValue ?maxTorqueReported .

                # ---- tolerance (relative 1e-6) ---------------------------------------
                BIND (1e-6 AS ?relTol)

                BIND (ABS(?factorReported - ?cSpexCalc) AS ?diffFactor)
                BIND (ABS(?torqueReported - ?qSexCalc) AS ?diffTorque)
                BIND (ABS(?maxTorqueReported - ?qSexCalc) AS ?diffMax)

                FILTER ( ?diffFactor > (IF(?cSpexCalc = 0, 0.0, ?relTol * ABS(?cSpexCalc))) )
                FILTER ( ?diffTorque > (IF(?qSexCalc = 0, 0.0, ?relTol * ABS(?qSexCalc))) )
                FILTER ( ?diffMax   > (IF(?qSexCalc = 0, 0.0, ?relTol * ABS(?qSexCalc))) )
            }
        """
    ] .
