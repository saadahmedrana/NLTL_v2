@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/2002/07/owl#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:TRF-132Shape a shacl:NodeShape ;
    shacl:targetClass nltl:ship ;

    # --- Engine output formula base power P0 (kW) ---
    shacl:property [
        shacl:path nltl:engineOutputFormulaBasePowerP0 ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ] ;
            shacl:property [
                shacl:path qudt:unit ;
                shacl:hasValue unit:KiloW ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
        ]
    ] ;

    # --- Engine output formula displacement (Delta) ---
    shacl:property [
        shacl:path nltl:engineOutputFormulaDisplacement ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
            # unit not mandated (recommendedUnit null)
        ]
    ] ;

    # --- Factor f1 (dimensionless) ---
    shacl:property [
        shacl:path nltl:engineOutputFormulaFactorF1 ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ] ;
            shacl:property [
                shacl:path qudt:unit ;
                shacl:hasValue unit:UNITLESS ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
        ]
    ] ;

    # --- Factor f2 (dimensionless) ---
    shacl:property [
        shacl:path nltl:engineOutputFormulaFactorF2 ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ] ;
            shacl:property [
                shacl:path qudt:unit ;
                shacl:hasValue unit:UNITLESS ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
        ]
    ] ;

    # --- Factor f3 (dimensionless) ---
    shacl:property [
        shacl:path nltl:engineOutputFormulaFactorF3 ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ] ;
            shacl:property [
                shacl:path qudt:unit ;
                shacl:hasValue unit:UNITLESS ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
        ]
    ] ;

    # --- Factor f4 (no mandatory unit) ---
    shacl:property [
        shacl:path nltl:engineOutputFormulaFactorF4 ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
            # unit not required
        ]
    ] ;

    # --- Maximum Continuous Rating Power (engine output) ---
    shacl:property [
        shacl:path nltl:maximumContinuousRatingPower ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:node [
            shacl:class qudt:QuantityValue ;
            shacl:property [
                shacl:path qudt:numericValue ;
                shacl:datatype xsd:decimal ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ] ;
            shacl:property [
                shacl:path qudt:unit ;
                shacl:hasValue unit:KiloW ;
                shacl:minCount 1 ;
                shacl:maxCount 1
            ]
        ]
    ] ;

    # --- Ice class (controlled value) ---
    shacl:property [
        shacl:path nltl:iceClass ;
        shacl:minCount 1 ;
        shacl:maxCount 1 ;
        shacl:class nltl:iceClassValue
    ] ;

    # --- Formula comparison: MCR must be >= calculated P ---
    shacl:sparql [
        shacl:message "Maximum continuous rating power must be no less than the calculated engine output P = f1·f2·f3·(f4·Delta + P0)." ;
        shacl:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputFormulaBasePowerP0 ?p0Node .
                ?p0Node qudt:numericValue ?p0 .
                $this nltl:engineOutputFormulaDisplacement ?deltaNode .
                ?deltaNode qudt:numericValue ?delta .
                $this nltl:engineOutputFormulaFactorF1 ?f1Node .
                ?f1Node qudt:numericValue ?f1 .
                $this nltl:engineOutputFormulaFactorF2 ?f2Node .
                ?f2Node qudt:numericValue ?f2 .
                $this nltl:engineOutputFormulaFactorF3 ?f3Node .
                ?f3Node qudt:numericValue ?f3 .
                $this nltl:engineOutputFormulaFactorF4 ?f4Node .
                ?f4Node qudt:numericValue ?f4 .
                $this nltl:maximumContinuousRatingPower ?mcrNode .
                ?mcrNode qudt:numericValue ?mcr .
                BIND( (?f1 * ?f2 * ?f3 * ((?f4 * ?delta) + ?p0)) AS ?calcP )
                FILTER ( ?mcr < ?calcP )
            }
        """
    ] ;

    # --- Ice‑class specific absolute minimum (IB, IC) ---
    shacl:sparql [
        shacl:message "For ice classes IB and IC, maximum continuous rating power must be at least 740 kW." ;
        shacl:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ic .
                FILTER ( ?ic IN (nltl:iceClassIb, nltl:iceClassIc) )
                $this nltl:maximumContinuousRatingPower ?mcrNode .
                ?mcrNode qudt:numericValue ?mcr .
                FILTER ( ?mcr < 740 )
            }
        """
    ] .

