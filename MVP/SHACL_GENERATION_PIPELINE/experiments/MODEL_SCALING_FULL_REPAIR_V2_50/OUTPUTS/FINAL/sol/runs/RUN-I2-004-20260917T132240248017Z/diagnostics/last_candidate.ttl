@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DisplacementQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The displacement shall have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloTON_Metric ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The displacement shall use metric kilotonnes."
    ] .

gen:UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:class nltl:upperIceWaterlineCase ;
    sh:property [
        sh:path nltl:waterlineCaseDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DisplacementQuantityShape ;
        sh:message "Each upper ice waterline case shall have one displacement."
    ] .

gen:UpperIceWaterlineDisplacementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DisplacementQuantityShape ;
        sh:message "The ship shall have one upper ice waterline displacement."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:minCount 1 ;
        sh:node gen:UpperIceWaterlineCaseShape ;
        sh:message "The ship shall have at least one upper ice waterline case."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline displacement shall equal the greatest linked waterline-case displacement." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
    ?duiQuantity qudt:numericValue ?duiValue ;
        qudt:unit unit:KiloTON_Metric .
    FILTER (
        NOT EXISTS {
            $this nltl:hasUpperIceWaterlineCase ?matchingCase .
            ?matchingCase nltl:waterlineCaseDisplacement ?matchingQuantity .
            ?matchingQuantity qudt:numericValue ?matchingValue ;
                qudt:unit unit:KiloTON_Metric .
            FILTER (xsd:decimal(?matchingValue) = xsd:decimal(?duiValue))
        }
        ||
        EXISTS {
            $this nltl:hasUpperIceWaterlineCase ?greaterCase .
            ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
            ?greaterQuantity qudt:numericValue ?greaterValue ;
                qudt:unit unit:KiloTON_Metric .
            FILTER (xsd:decimal(?greaterValue) > xsd:decimal(?duiValue))
        }
    )
}
"""
    ] .
