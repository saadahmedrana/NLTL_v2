@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_008_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:message "Polar Class is required to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Average ice pressure is required."
    ] ;
    sh:property [
        sh:path nltl:lineLoad ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonPerMetreQuantityShape ;
        sh:message "Line load is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Load patch height is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Load patch length is required."
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Local ice pressure is required."
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Shape coefficient is required."
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "Total glancing impact force is required."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_008_BowSubregionCalculationCaseShape ;
        sh:message "A bow subregion calculation case is required."
    ] .

gen:I2_008_BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The bow shape coefficient is required for each bow subregion calculation case."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:node gen:MegaNewtonPerMetreQuantityShape ;
        sh:message "The glancing impact line load is required for each bow subregion calculation case."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "The glancing impact pressure is required for each bow subregion calculation case."
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
