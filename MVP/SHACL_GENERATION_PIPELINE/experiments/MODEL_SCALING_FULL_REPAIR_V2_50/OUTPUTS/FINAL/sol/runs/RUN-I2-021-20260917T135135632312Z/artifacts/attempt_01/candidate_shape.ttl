@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_021_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:node gen:I2_021_PlatingShape ;
        sh:message "Each ship must identify plating for the shell plate thickness calculation."
    ] .

gen:I2_021_PlatingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_021_MillimetreQuantityShape ;
        sh:message "Each plating item must have one ice-load required net plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAllowance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_021_MillimetreQuantityShape ;
        sh:message "Each plating item must have one corrosion and abrasion allowance in millimetres."
    ] ;
    sh:property [
        sh:path nltl:thickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_021_MetreQuantityShape ;
        sh:message "Each plating item must have one required shell plate thickness in metres."
    ] ;
    sh:sparql [
        sh:message "Shell plate thickness must equal the ice-load required net thickness plus the corrosion and abrasion allowance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                      nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                      nltl:thickness ?thicknessQuantity .
                ?netQuantity qudt:numericValue ?net .
                ?allowanceQuantity qudt:numericValue ?allowance .
                ?thicknessQuantity qudt:numericValue ?reported .
                BIND(
                    (xsd:decimal(?net) + xsd:decimal(?allowance))
                    / "1000"^^xsd:decimal
                    AS ?expected
                )
                BIND(
                    ABS(?expected) * "0.000001"^^xsd:decimal
                    AS ?relativeTolerance
                )
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(
                    ABS(xsd:decimal(?reported) - ?expected) > ?tolerance
                )
            }
        """
    ] .

gen:I2_021_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_021_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
