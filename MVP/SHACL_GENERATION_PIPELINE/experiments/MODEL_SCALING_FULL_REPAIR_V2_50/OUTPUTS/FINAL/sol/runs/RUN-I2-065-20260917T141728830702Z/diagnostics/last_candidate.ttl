@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_065_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:qualifiedValueShape gen:I2_065_NonlinearCalculationCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A nonlinear calculation case satisfying the I2.17.6 readiness requirements is required."
    ] ;
    sh:property [
        sh:path nltl:fractureMargin ;
        sh:class qudt:QuantityValue ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "A unitless fracture margin is required for the nonlinear analysis."
    ] ;
    sh:property [
        sh:path nltl:majorBucklingMargin ;
        sh:class qudt:QuantityValue ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "A unitless major buckling margin is required for the nonlinear analysis."
    ] ;
    sh:property [
        sh:path nltl:yieldingMargin ;
        sh:class qudt:QuantityValue ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "A unitless yielding margin is required for the nonlinear analysis."
    ] .

gen:I2_065_NonlinearCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:class nltl:calculationMethodValue ;
        sh:hasValue nltl:nonlinearCalculationMethodValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The calculation case must select the nonlinear calculation method."
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MillimetreDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "Permanent lateral deformation in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MillimetreDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "Permanent out-of-plane deformation in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MillimetreDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "The relevant structural dimension in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Nonlinear analysis acceptance evidence is required."
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The permanent-deformation assessment must be recorded as satisfied."
    ] .

gen:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MillimetreDecimalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
