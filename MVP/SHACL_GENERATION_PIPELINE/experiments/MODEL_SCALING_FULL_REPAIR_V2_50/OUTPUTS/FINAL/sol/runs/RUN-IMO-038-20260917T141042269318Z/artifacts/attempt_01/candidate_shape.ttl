@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IceDamageExtentShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damageCenterForwardOfMaxBreadth ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The damage-centre position relative to maximum breadth is required."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "Upper ice waterline length is required in metres."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "Upper ice waterline draught is required in metres."
    ] ;
    sh:property [
        sh:path nltl:longitudinalDamageExtent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "Longitudinal damage extent is required in metres."
    ] ;
    sh:property [
        sh:path nltl:transversePenetration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TransversePenetrationValueShape ;
        sh:message "Transverse penetration must be exactly 760 mm."
    ] ;
    sh:property [
        sh:path nltl:verticalDamageExtent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "Vertical damage extent is required in metres."
    ] ;
    sh:property [
        sh:path nltl:selectedVerticalDamagePosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:NonNegativeMetreQuantityValueShape ;
        sh:message "A selected vertical damage position measured from the keel is required in metres."
    ] ;
    sh:sparql [
        sh:message "Damage extents or selected vertical position do not satisfy the required formulas and inclusive range." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthValue ;
                      nltl:upperIceWaterlineDraught ?draughtValue ;
                      nltl:longitudinalDamageExtent ?longitudinalValue ;
                      nltl:verticalDamageExtent ?verticalValue ;
                      nltl:selectedVerticalDamagePosition ?positionValue .

                ?lengthValue qudt:numericValue ?length .
                ?draughtValue qudt:numericValue ?draught .
                ?longitudinalValue qudt:numericValue ?longitudinal .
                ?verticalValue qudt:numericValue ?vertical .
                ?positionValue qudt:numericValue ?position .

                BIND(
                    IF(
                        ?forward,
                        0.045 * ?length,
                        0.015 * ?length
                    )
                    AS ?expectedLongitudinal
                )
                BIND(
                    IF(
                        ABS(?expectedLongitudinal) * 0.000001 > 0.000000001,
                        ABS(?expectedLongitudinal) * 0.000001,
                        0.000000001
                    )
                    AS ?longitudinalTolerance
                )
                BIND(
                    IF(
                        0.20 * ?draught < ?longitudinal,
                        0.20 * ?draught,
                        ?longitudinal
                    )
                    AS ?expectedVertical
                )
                BIND(
                    IF(
                        ABS(?expectedVertical) * 0.000001 > 0.000000001,
                        ABS(?expectedVertical) * 0.000001,
                        0.000000001
                    )
                    AS ?verticalTolerance
                )

                FILTER (
                    ABS(?longitudinal - ?expectedLongitudinal) > ?longitudinalTolerance ||
                    ABS(?vertical - ?expectedVertical) > ?verticalTolerance ||
                    ?position < 0 ||
                    ?position > 1.20 * ?draught
                )
            }
        """
    ] .

gen:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NonNegativeMetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TransversePenetrationValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 760 ;
        sh:maxInclusive 760 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
