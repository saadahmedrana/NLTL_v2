@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO062ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:class nltl:exposedEscapeRoute ;
        sh:node gen:IMO062ExposedEscapeRouteShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasExposedEscapeRoute ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasExposedEscapeRoute ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:accessibleStatus ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "Accessible status must be recorded as true when exposed escape routes exist."
            ] ;
            sh:property [
                sh:path nltl:safeStatus ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "Safe status must be recorded as true when exposed escape routes exist."
            ] ;
            sh:property [
                sh:path nltl:iceSnowMitigationCoverage ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "Ice and snow mitigation coverage must be recorded as true when exposed escape routes exist."
            ]
        ]
    ) .

gen:IMO062ExposedEscapeRouteShape
    a sh:NodeShape ;
    sh:class nltl:exposedEscapeRoute ;
    sh:property [
        sh:path nltl:escapeRouteAccessibleStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Each exposed escape route must have accessible status true."
    ] ;
    sh:property [
        sh:path nltl:escapeRouteSafeStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Each exposed escape route must have safe status true."
    ] ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each exposed escape route must have documented ice and snow mitigation evidence."
    ] .
