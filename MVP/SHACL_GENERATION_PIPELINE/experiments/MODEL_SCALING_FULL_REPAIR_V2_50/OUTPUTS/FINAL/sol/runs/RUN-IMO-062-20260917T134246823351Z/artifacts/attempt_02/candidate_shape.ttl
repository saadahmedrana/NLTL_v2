@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO062ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:class nltl:exposedEscapeRoute ;
        sh:node gen:IMO062ExposedEscapeRouteShape
    ] .

gen:IMO062ExposedEscapeRouteShape
    a sh:NodeShape ;
    sh:class nltl:exposedEscapeRoute ;
    sh:property [
        sh:path nltl:escapeRouteAccessibleStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Each exposed escape route must have accessible status true."
    ] ;
    sh:property [
        sh:path nltl:escapeRouteSafeStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Each exposed escape route must have safe status true."
    ] ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each exposed escape route must have documented ice and snow mitigation evidence."
    ] .
