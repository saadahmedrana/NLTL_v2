@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO114Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The Type 3 tank requirement status of the carried noxious liquid substance is required."
    ] ;
    sh:property [
        sh:path nltl:cargoTankType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Cargo tank type is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable Category A or B ship must have Administration approval and a certificate entry identifying polar-water operation." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?constructionDate ;
          nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3Tank ;
          nltl:cargoTankType ?tankType .

    FILTER(?category IN (
        nltl:polarShipCategoryA,
        nltl:polarShipCategoryB
    ))
    FILTER(YEAR(?constructionDate) >= 2017)
    FILTER(?requiresType3Tank = true)
    FILTER(STR(?tankType) = "3")

    FILTER(
        NOT EXISTS {
            $this nltl:administrationCarriageApprovalStatus
                  nltl:evidenceStateApproved .
        }
        ||
        EXISTS {
            $this nltl:administrationCarriageApprovalStatus ?approvalStatus .
            FILTER(?approvalStatus != nltl:evidenceStateApproved)
        }
        ||
        NOT EXISTS {
            $this nltl:applicableCertificatePolarOperationEntryPresent
                  ?certificateEntry .
            FILTER(
                isLiteral(?certificateEntry) &&
                DATATYPE(?certificateEntry) = xsd:boolean &&
                ?certificateEntry = true
            )
        }
        ||
        EXISTS {
            $this nltl:applicableCertificatePolarOperationEntryPresent
                  ?otherCertificateEntry .
            FILTER(
                !isLiteral(?otherCertificateEntry) ||
                DATATYPE(?otherCertificateEntry) != xsd:boolean ||
                ?otherCertificateEntry != true
            )
        }
    )
}
"""
    ] .
