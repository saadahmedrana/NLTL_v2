@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO26-014Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "The ship must explicitly record that it operates only in continuous daylight."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false ) ;
                sh:message "The ship must explicitly record that it does not operate only in continuous daylight."
            ] ;
            sh:property [
                sh:path nltl:visualIceDetectionIlluminationMeansCount ;
                sh:minCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:message "A ship not operating only in continuous daylight must have at least two means of illumination for visual ice detection."
            ]
        ]
    ) .
