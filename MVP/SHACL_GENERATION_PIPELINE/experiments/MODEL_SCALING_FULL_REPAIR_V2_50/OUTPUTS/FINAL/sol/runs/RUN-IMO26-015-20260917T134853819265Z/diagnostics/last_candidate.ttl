@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarCodeChapter11ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Applicable ;
        sh:datatype xsd:boolean ;
        sh:message "Polar Code chapter 11 applicability must be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Applicable ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Applicable ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:solasChapterICertified ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "A ship for which Polar Code chapter 11 applies must be certified in accordance with SOLAS chapter I."
            ]
        ]
    ) .
