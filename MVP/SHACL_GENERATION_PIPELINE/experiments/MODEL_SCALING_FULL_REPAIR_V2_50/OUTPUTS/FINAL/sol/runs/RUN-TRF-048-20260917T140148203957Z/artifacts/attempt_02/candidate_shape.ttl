@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF048LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:frameBoundaryConditionTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single frame boundary-condition type is required."
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The significantly-different-boundary-conditions selector is required."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:class qudt:QuantityValue ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:class qudt:QuantityValue ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:class qudt:QuantityValue ;
        sh:node gen:CubicCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:class qudt:QuantityValue ;
        sh:node gen:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:class qudt:QuantityValue ;
        sh:node gen:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:class qudt:QuantityValue ;
        sh:node gen:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:class qudt:QuantityValue ;
        sh:node gen:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "For a continuous beam with brackets without significantly different boundary conditions, frameMomentFactorM must equal 13.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType nltl:continuousBeamWithBracketsFrameCondition ;
                      nltl:significantlyDifferentBoundaryConditions false ;
                      nltl:frameMomentFactorM ?mQuantity .
                ?mQuantity qudt:numericValue ?m .
                FILTER (?m < 13.3 || ?m > 13.3)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The reported f4, section modulus, and required shear area must satisfy the TRF-048 formulas within relative tolerance 1e-6 and absolute fallback 1e-9; spacing, m, and yield strength must permit division." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pQuantity ;
                      nltl:designIceLoadHeight ?hQuantity ;
                      nltl:spacing ?sQuantity ;
                      nltl:span ?lQuantity ;
                      nltl:frameMomentFactorM ?mQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Quantity ;
                      nltl:sectionModulus ?zQuantity ;
                      nltl:requiredShearArea ?aQuantity .

                ?pQuantity qudt:numericValue ?p .
                ?hQuantity qudt:numericValue ?h .
                ?sQuantity qudt:numericValue ?s .
                ?lQuantity qudt:numericValue ?l .
                ?mQuantity qudt:numericValue ?m .
                ?yieldQuantity qudt:numericValue ?yield .
                ?f4Quantity qudt:numericValue ?reportedF4 .
                ?zQuantity qudt:numericValue ?reportedZ .
                ?aQuantity qudt:numericValue ?reportedA .

                BIND(IF(?s = 0, 0, 1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND(IF((?m = 0 || ?yield = 0), 0,
                    (?expectedF4 * ?p * ?h * ?l * ?l /
                    (4 * ?m * ?yield)) * 1000000) AS ?expectedZ)
                BIND(IF(?yield = 0, 0,
                    (1.7320508075688772 * ?expectedF4 * 2.16 *
                    ?p * ?h * ?l / (2 * ?yield)) * 10000) AS ?expectedA)

                BIND(IF(ABS(?expectedF4) * 0.000001 > 0.000000001,
                    ABS(?expectedF4) * 0.000001, 0.000000001) AS ?f4Tolerance)
                BIND(IF(ABS(?expectedZ) * 0.000001 > 0.000000001,
                    ABS(?expectedZ) * 0.000001, 0.000000001) AS ?zTolerance)
                BIND(IF(ABS(?expectedA) * 0.000001 > 0.000000001,
                    ABS(?expectedA) * 0.000001, 0.000000001) AS ?aTolerance)

                FILTER (
                    ?s = 0 ||
                    ?m = 0 ||
                    ?yield = 0 ||
                    ABS(?reportedF4 - ?expectedF4) > ?f4Tolerance ||
                    ABS(?reportedZ - ?expectedZ) > ?zTolerance ||
                    ABS(?reportedA - ?expectedA) > ?aTolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Actual frame shear area must exclude bracket area and equal gross frame shear area minus bracket area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea ?grossQuantity ;
                      nltl:bracketArea ?bracketQuantity ;
                      nltl:actualFrameShearArea ?actualQuantity .

                ?grossQuantity qudt:numericValue ?gross .
                ?bracketQuantity qudt:numericValue ?bracket .
                ?actualQuantity qudt:numericValue ?actual .

                FILTER (?actual != (?gross - ?bracket))
            }
        """
    ] .
