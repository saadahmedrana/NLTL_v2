@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KilonewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 0.8 ;
                sh:maxInclusive 0.8
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gen:TRF101BladeFailureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:qualifiedValueShape gen:LoadCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one blade-failure load case must apply the load at radius ratio 0.8 in the weakest blade direction."
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:KilonewtonQuantityShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:approvedNonlinearBladeStressAnalysis ;
                sh:class nltl:approvalRecord ;
                sh:minCount 1 ;
                sh:message "An approved nonlinear blade stress analysis must be provided for the analysis alternative."
            ]
        ]
        [
            sh:property [
                sh:path nltl:bladeChordLengthAtWeakestSection ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:bladeCylindricalRootRadius ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:bladeMinimumYieldStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MegaPascalQuantityShape
            ] ;
            sh:property [
                sh:path nltl:bladeUltimateTensileStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MegaPascalQuantityShape
            ] ;
            sh:property [
                sh:path nltl:bladeReferenceStrength1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MegaPascalQuantityShape
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Without an approved nonlinear analysis, blade reference strength and ultimate load must satisfy the prescribed formulas; the load denominator must be nonzero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:approvedNonlinearBladeStressAnalysis ?analysis .
                    ?analysis a nltl:approvalRecord .
                }

                $this nltl:bladeChordLengthAtWeakestSection ?chordQuantity ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?thicknessQuantity ;
                      nltl:bladeCylindricalRootRadius ?rootRadiusQuantity ;
                      nltl:bladeMinimumYieldStrength ?yieldQuantity ;
                      nltl:bladeUltimateTensileStrength ?ultimateStrengthQuantity ;
                      nltl:bladeReferenceStrength1 ?referenceStrengthQuantity ;
                      nltl:bladeFailureUltimateLoad ?failureLoadQuantity ;
                      nltl:propellerDiameter ?diameterQuantity .

                ?chordQuantity qudt:numericValue ?chord .
                ?thicknessQuantity qudt:numericValue ?thickness .
                ?rootRadiusQuantity qudt:numericValue ?rootRadius .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?ultimateStrengthQuantity qudt:numericValue ?ultimateStrength .
                ?referenceStrengthQuantity qudt:numericValue ?reportedReferenceStrength .
                ?failureLoadQuantity qudt:numericValue ?reportedFailureLoad .
                ?diameterQuantity qudt:numericValue ?diameter .

                BIND((0.6 * ?yieldStrength + 0.4 * ?ultimateStrength) AS ?expectedReferenceStrength)
                BIND((0.8 * ?diameter - 2.0 * ?rootRadius) AS ?denominator)
                BIND(
                    IF(
                        ?denominator != 0,
                        300.0 * ?chord * ?thickness * ?thickness * ?expectedReferenceStrength / ?denominator,
                        0.0
                    )
                    AS ?expectedFailureLoad
                )

                FILTER (
                    ?denominator = 0 ||
                    ?reportedReferenceStrength != ?expectedReferenceStrength ||
                    (
                        ?denominator != 0 &&
                        ?reportedFailureLoad != ?expectedFailureLoad
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Blade failure status must be true when blade tip offset exceeds 10 percent of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?offsetQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:bladeFailureStatus ?failureStatus .

                ?offsetQuantity qudt:numericValue ?offset .
                ?diameterQuantity qudt:numericValue ?diameter .

                FILTER (?offset > 0.10 * ?diameter && ?failureStatus != true)
            }
        """
    ] .
