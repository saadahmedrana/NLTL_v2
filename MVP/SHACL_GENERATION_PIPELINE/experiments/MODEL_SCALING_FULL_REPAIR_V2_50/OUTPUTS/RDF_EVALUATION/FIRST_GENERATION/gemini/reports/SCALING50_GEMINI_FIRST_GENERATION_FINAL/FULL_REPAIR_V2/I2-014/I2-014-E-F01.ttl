@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "The bow region must be divided into exactly 4 subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:naa9e444b5baa433589c091de306a2a58b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "Each ship must have exactly 4 bow subregion calculation cases." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 4 ;
                    sh:message "Each ship must have exactly 4 bow subregion calculation cases." ;
                    sh:minCount 4 ;
                    sh:node <urn:nltl:generated-shape:BowSubregionShape> ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "The bow region must be divided into exactly 4 subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:naa9e444b5baa433589c091de306a2a58b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:bowLength ] ] .

_:naa9e444b5baa433589c091de306a2a58b1 sh:datatype xsd:integer ;
    sh:hasValue 4 ;
    sh:maxCount 1 ;
    sh:message "The bow region must be divided into exactly 4 subregions." ;
    sh:minCount 1 ;
    sh:path nltl:bowSubregionCount .

