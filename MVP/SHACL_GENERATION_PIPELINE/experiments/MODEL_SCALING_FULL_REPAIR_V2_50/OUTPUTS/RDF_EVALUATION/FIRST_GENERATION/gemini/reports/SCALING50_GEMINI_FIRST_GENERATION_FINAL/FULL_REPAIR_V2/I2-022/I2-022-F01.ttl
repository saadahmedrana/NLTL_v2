@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ;
            sh:resultMessage "Ship has applicable transversely-framed bottom plating missing required engineering inputs (frameSpacing, selectedHullAreaFactor, averageIcePressure, peakPressureFactor, yieldStrength, loadPatchHeight) or outputs (iceLoadRequiredNetPlateThickness) with their correct units." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ship has applicable transversely-framed bottom plating missing required engineering inputs (frameSpacing, selectedHullAreaFactor, averageIcePressure, peakPressureFactor, yieldStrength, loadPatchHeight) or outputs (iceLoadRequiredNetPlateThickness) with their correct units." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?plating
            WHERE {
                $this nltl:hasPlating ?plating .

                # Determine if ?plating is applicable (Omega >= 70 deg OR in bottom hull areas BI_b, M_b, S_b)
                {
                    ?plating nltl:framingAngleOmega ?omegaNode .
                    ?omegaNode qudt:numericValue ?omegaVal .
                    ?omegaNode qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    FILTER (?omegaVal >= 70)
                }
                UNION
                {
                    ?plating nltl:platingHullAreaClassification ?area .
                    FILTER (?area IN (nltl:bowIntermediateBottomHullArea, nltl:midbodyBottomHullArea, nltl:sternBottomHullArea))
                }

                # Verify presence of all required input/output terms and correct units
                FILTER NOT EXISTS {
                    # Plating-level output
                    ?plating nltl:iceLoadRequiredNetPlateThickness ?tNode .
                    ?tNode qudt:numericValue ?tVal .
                    ?tNode qudt:unit <http://qudt.org/vocab/unit/MilliM> .

                    # Structural member operands
                    ?plating nltl:platingSupportedByStructuralMember ?sm .
                    ?sm nltl:frameSpacing ?sNode .
                    ?sNode qudt:numericValue ?sVal .
                    ?sNode qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?sm nltl:selectedHullAreaFactor ?afNode .
                    ?afNode qudt:numericValue ?afVal .
                    ?afNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                    # Ship-level operands
                    $this nltl:averageIcePressure ?pNode .
                    ?pNode qudt:numericValue ?pVal .
                    ?pNode qudt:unit <http://qudt.org/vocab/unit/MegaPA> .

                    $this nltl:peakPressureFactor ?ppfNode .
                    ?ppfNode qudt:numericValue ?ppfVal .
                    ?ppfNode qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                    $this nltl:yieldStrength ?ysNode .
                    ?ysNode qudt:numericValue ?ysVal .
                    ?ysNode qudt:unit <http://qudt.org/vocab/unit/MegaPA> .

                    $this nltl:loadPatchHeight ?bNode .
                    ?bNode qudt:numericValue ?bVal .
                    ?bNode qudt:unit <http://qudt.org/vocab/unit/M> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipPlatingReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F01/ship> ] .

