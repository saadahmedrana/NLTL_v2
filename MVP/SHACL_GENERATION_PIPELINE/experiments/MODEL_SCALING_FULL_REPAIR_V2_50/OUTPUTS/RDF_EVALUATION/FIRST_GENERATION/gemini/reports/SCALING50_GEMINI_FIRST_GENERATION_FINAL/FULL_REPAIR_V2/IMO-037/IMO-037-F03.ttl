@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F03/ship> ;
            sh:resultMessage "For Category A or B ships constructed on/after 2017-01-01, each loading condition must have a residual stability factor s_i of 1, or comply with the alternative instrument criteria." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For Category A or B ships constructed on/after 2017-01-01, each loading condition must have a residual stability factor s_i of 1, or comply with the alternative instrument criteria." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?cat .
                FILTER (?cat IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                
                $this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                
                $this nltl:hasLoadingConditionCase ?case .
                
                # Check that neither the exact factor of 1 is met...
                FILTER NOT EXISTS {
                    ?case nltl:residualStabilityFactorSI ?siNode .
                    ?siNode qudt:numericValue ?siVal .
                    FILTER (?siVal = 1)
                }
                # ...nor is the alternative instrument applicable and status compliant (true)
                FILTER NOT EXISTS {
                    ?case nltl:alternativeInstrumentApplicable true .
                    ?case nltl:alternativeInstrumentResidualStabilityStatus true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F03/ship> ] .

