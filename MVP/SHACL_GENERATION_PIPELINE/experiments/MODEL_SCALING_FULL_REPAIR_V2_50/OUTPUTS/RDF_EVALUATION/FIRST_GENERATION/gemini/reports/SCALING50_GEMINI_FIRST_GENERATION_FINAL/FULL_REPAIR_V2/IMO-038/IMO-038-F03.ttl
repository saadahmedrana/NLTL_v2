@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix urn: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Assumed ice damage extents or vertical positions do not comply with the piecewise calculation formulas or limits specified in Polar Code 4.3.2.2." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Assumed ice damage extents or vertical positions do not comply with the piecewise calculation formulas or limits specified in Polar Code 4.3.2.2." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?isForward ;
                      nltl:upperIceWaterlineLength [ qudt:numericValue ?L_val ] ;
                      nltl:upperIceWaterlineDraught [ qudt:numericValue ?D_val ] ;
                      nltl:longitudinalDamageExtent [ qudt:numericValue ?longExtent ] ;
                      nltl:transversePenetration [ qudt:numericValue ?transPen ] ;
                      nltl:verticalDamageExtent [ qudt:numericValue ?vertExtent ] ;
                      nltl:selectedVerticalDamagePosition [ qudt:numericValue ?vertPos ] .

                BIND(IF(?isForward = true, 0.045 * ?L_val, 0.015 * ?L_val) AS ?expectedLong)
                BIND(IF(0.20 * ?D_val < ?longExtent, 0.20 * ?D_val, ?longExtent) AS ?expectedVert)

                BIND(abs(?longExtent - ?expectedLong) AS ?diffLong)
                BIND((1e-6 * ?expectedLong) + 1e-9 AS ?tolLong)

                BIND(abs(?transPen - 760.0) AS ?diffTrans)
                BIND(1e-5 AS ?tolTrans)

                BIND(abs(?vertExtent - ?expectedVert) AS ?diffVert)
                BIND((1e-6 * ?expectedVert) + 1e-9 AS ?tolVert)

                BIND(1.20 * ?D_val AS ?maxVertPos)

                FILTER (
                    ?diffLong > ?tolLong ||
                    ?diffTrans > ?tolTrans ||
                    ?diffVert > ?tolVert ||
                    ?vertPos < -1e-9 ||
                    ?vertPos > ?maxVertPos + 1e-9
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape urn:IceDamageExtentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

