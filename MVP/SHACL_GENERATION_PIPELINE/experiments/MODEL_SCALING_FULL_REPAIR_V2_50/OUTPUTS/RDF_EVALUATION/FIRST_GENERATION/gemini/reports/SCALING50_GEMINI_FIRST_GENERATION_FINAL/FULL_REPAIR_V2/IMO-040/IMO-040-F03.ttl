@prefix genshape: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/ship> ;
            sh:resultMessage "When ice accretion is likely, every relevant hatch or door must have an associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When ice accretion is likely, every relevant hatch or door must have an associated ice or snow removal or prevention means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                $this nltl:hasRelevantHatchOrDoor ?hatchOrDoor .
                FILTER NOT EXISTS {
                    ?hatchOrDoor nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape genshape:ShipIceAccretionShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F03/ship> ] .

