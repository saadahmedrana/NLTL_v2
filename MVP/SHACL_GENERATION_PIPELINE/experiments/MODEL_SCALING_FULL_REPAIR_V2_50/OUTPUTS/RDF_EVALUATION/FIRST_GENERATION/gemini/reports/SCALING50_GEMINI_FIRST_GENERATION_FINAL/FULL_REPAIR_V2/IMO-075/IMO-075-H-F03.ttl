@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F03/ship> ;
            sh:resultMessage "When personal/group survival equipment is required, available capacity must be >= 110% of persons on board and stowed in an accessible location." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When personal/group survival equipment is required, available capacity must be >= 110% of persons on board and stowed in an accessible location." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired true .
                OPTIONAL { $this nltl:personsOnBoard ?persons }
                OPTIONAL { $this nltl:availableSurvivalEquipmentCapacity ?capacity }
                OPTIONAL { $this nltl:storageAccessibilityStatus ?accessible }
                FILTER (
                    !BOUND(?persons) ||
                    !BOUND(?capacity) ||
                    !BOUND(?accessible) ||
                    (?capacity < CEIL(?persons * 1.10)) ||
                    (?accessible != true)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO075Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F03/ship> ] .

