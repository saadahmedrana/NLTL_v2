@prefix gshape: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ;
            sh:resultMessage "For ships subject to the 1985 ice class regulations and having ice class IB or IC, the maximum continuous rating power must be at least the required minimum engine output under the 1985 rules." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ships subject to the 1985 ice class regulations and having ice class IB or IC, the maximum continuous rating power must be at least the required minimum engine output under the 1985 rules." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?this ?value ?message
WHERE {
  ?this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .
  ?this nltl:iceClass ?iceClass .
  FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
  
  OPTIONAL {
    ?this nltl:maximumContinuousRatingPower/qudt:numericValue ?mcrVal .
  }
  OPTIONAL {
    ?this nltl:requiredPowerUnder1985Rules/qudt:numericValue ?reqVal .
  }
  
  BIND(
    IF(!BOUND(?mcrVal), "Missing maximum continuous rating power.",
    IF(!BOUND(?reqVal), "Missing required power under 1985 rules.",
    IF(?mcrVal < ?reqVal, "Maximum continuous rating power is less than the required power under 1985 rules.",
    ""))) AS ?message
  )
  FILTER (?message != "")
  BIND (?this AS ?value)
}
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gshape:Ship1985RulesPowerShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F03/ship> ] .

