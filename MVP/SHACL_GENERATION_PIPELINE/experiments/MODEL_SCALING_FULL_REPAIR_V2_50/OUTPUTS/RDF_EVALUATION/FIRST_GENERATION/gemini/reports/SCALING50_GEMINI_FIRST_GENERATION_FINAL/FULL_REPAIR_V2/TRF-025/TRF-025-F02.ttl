@prefix s: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:not [ sh:hasValue nltl:iceClassIaSuper ] ; sh:path nltl:iceClass ] ] [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ] ] ) ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path nltl:bulbousBowPresent ], [ sh:hasValue nltl:iceClassIaSuper ; sh:path nltl:iceClass ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Brash ice resistance coefficient C1 must be specified in N.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInN ; sh:path nltl:brashIceResistanceCoefficientC1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Brash ice resistance coefficient C2 must be specified in N.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInN ; sh:path nltl:brashIceResistanceCoefficientC2 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient f1 must be specified in N/m2.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInNPerM2 ; sh:path nltl:coefficientF1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient f2 must be specified in N/m.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInNPerM ; sh:path nltl:coefficientF2 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient f3 must be specified in N/m.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInNPerM ; sh:path nltl:coefficientF3 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient f4 must be specified in N/m2.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInNPerM2 ; sh:path nltl:coefficientF4 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient g1 must be specified in N.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInN ; sh:path nltl:coefficientG1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient g2 must be specified in N/m.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInNPerM ; sh:path nltl:coefficientG2 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Coefficient g3 must be specified in N/m^1.5.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:QuantityInNewtonPerMetreToPowerOnePointFiveUnit ; sh:path nltl:coefficientG3 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For IA Super ships without a bulb, ice class draught (T) must be a positive quantity in meters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:PositiveLengthInMeters ; sh:path nltl:iceClassDraught ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For IA Super ships without a bulb, ship breadth (B) must be a positive quantity in meters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:PositiveLengthInMeters ; sh:path nltl:shipBreadth ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"For IA Super ships without a bulb, ship length (L) must be a positive quantity in meters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node s:PositiveLengthInMeters ; sh:path nltl:shipLength ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape s:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-025-F02/ship> ] .

