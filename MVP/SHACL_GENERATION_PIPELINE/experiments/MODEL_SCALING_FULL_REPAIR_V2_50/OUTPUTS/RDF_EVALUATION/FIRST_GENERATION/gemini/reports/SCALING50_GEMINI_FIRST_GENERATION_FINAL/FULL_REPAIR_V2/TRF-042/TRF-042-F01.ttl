@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "longitudinalPlatingFactorF2 does not match the calculated value based on designIceLoadHeight (h) and spacing (s) ratio." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "longitudinalPlatingFactorF2 does not match the calculated value based on designIceLoadHeight (h) and spacing (s) ratio." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:longitudinalPlatingFactorF2/qudt:numericValue ?f2Val .
                FILTER (?s > 0)
                BIND (?h / ?s AS ?hs)
                BIND (
                    IF (?hs <= 1.0,
                        0.4 / ?hs + 0.6,
                        IF (?hs <= 1.8,
                            1.4 - 0.4 * ?hs,
                            -1.0
                        )
                    ) AS ?expected
                )
                BIND (IF (1e-6 * ABS(?expected) > 1e-12, 1e-6 * ABS(?expected), 1e-12) AS ?tol)
                FILTER (?hs > 1.8 || ?expected < 0 || ABS(?f2Val - ?expected) > ?tol)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:PlatingShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Each plating must have exactly one corrosionAbrasionAddition with unit MilliM and a numeric value." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each plating must have exactly one corrosionAbrasionAddition with unit MilliM and a numeric value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:corrosionAbrasionAddition ] ] .

