@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F02/ship> ;
            sh:resultMessage "webFrameMaximumIceLoadBendingMoment is required with MegaN-M unit." ;
            sh:resultPath nltl:webFrameMaximumIceLoadBendingMoment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "webFrameMaximumIceLoadBendingMoment is required with MegaN-M unit." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:MegaN-MQuantityValue> ;
                    sh:path nltl:webFrameMaximumIceLoadBendingMoment ] ] .

