@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ;
                    sh:resultMessage "Less than 1 values on ex:assessment->nltl:assessedFactoredExtremeLoad" ;
                    sh:resultPath nltl:assessedFactoredExtremeLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node shape:QuantityValueForceShape ;
                            sh:path nltl:assessedFactoredExtremeLoad ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/component> ;
                            sh:resultMessage "Less than 1 values on ex:component->nltl:hasMaterialProperties" ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node shape:MaterialPropertiesShape ;
                                    sh:path nltl:hasMaterialProperties ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ;
                    sh:resultMessage "Value does not conform to Shape shape:ShipComponentShape. See details for more information." ;
                    sh:resultPath nltl:assessedThrusterComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node shape:ShipComponentShape ;
                            sh:path nltl:assessedThrusterComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape shape:FactoredExtremeLoadOperabilityAssessmentShape. See details for more information." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node shape:FactoredExtremeLoadOperabilityAssessmentShape ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ] .

