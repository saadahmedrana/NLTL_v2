@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "Engine output (maximumContinuousRatingPower) must be no less than calculated P = f1*f2*f3*(f4*Delta + P0) kW, and in no case less than 740 kW for ice classes IB and IC." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Engine output (maximumContinuousRatingPower) must be no less than calculated P = f1*f2*f3*(f4*Delta + P0) kW, and in no case less than 740 kW for ice classes IB and IC." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower/qudt:numericValue ?mcr .
                $this nltl:engineOutputFormulaFactorF1/qudt:numericValue ?f1 .
                $this nltl:engineOutputFormulaFactorF2/qudt:numericValue ?f2 .
                $this nltl:engineOutputFormulaFactorF3/qudt:numericValue ?f3 .
                $this nltl:engineOutputFormulaFactorF4/qudt:numericValue ?f4 .
                $this nltl:engineOutputFormulaDisplacement/qudt:numericValue ?delta .
                $this nltl:engineOutputFormulaBasePowerP0/qudt:numericValue ?p0 .
                $this nltl:iceClass ?iceClass .

                BIND(?f1 * ?f2 * ?f3 * (?f4 * ?delta + ?p0) AS ?calculatedP)

                FILTER (
                    (?mcr < (?calculatedP - 1e-6)) ||
                    ((?iceClass = nltl:iceClassIb || ?iceClass = nltl:iceClassIc) && ?mcr < 740)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape shape:ShipEngineOutputRequirementShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

