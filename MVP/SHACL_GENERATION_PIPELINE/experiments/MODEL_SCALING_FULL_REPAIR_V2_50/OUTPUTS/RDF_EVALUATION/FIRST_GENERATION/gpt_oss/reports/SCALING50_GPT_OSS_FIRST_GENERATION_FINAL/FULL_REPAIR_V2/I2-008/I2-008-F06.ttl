@prefix : <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Load patch length (m) must be supplied." ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Load patch length (m) must be supplied." ;
                    sh:minCount 1 ;
                    sh:node :LoadPatchLengthShape ;
                    sh:path nltl:loadPatchLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Shape coefficient (unitless) must be supplied." ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Shape coefficient (unitless) must be supplied." ;
                    sh:minCount 1 ;
                    sh:node :ShapeCoeffShape ;
                    sh:path nltl:shapeCoefficient ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Line load (kN/m) must be supplied." ;
            sh:resultPath nltl:lineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Line load (kN/m) must be supplied." ;
                    sh:minCount 1 ;
                    sh:node :LineLoadShape ;
                    sh:path nltl:lineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "At least one Bow sub‑region calculation case must be provided." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least one Bow sub‑region calculation case must be provided." ;
                    sh:minCount 1 ;
                    sh:node :BowSubregionCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Local ice pressure (MPa) must be supplied." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Local ice pressure (MPa) must be supplied." ;
                    sh:minCount 1 ;
                    sh:node :LocalIcePressureShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Average ice pressure (MPa) must be supplied." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Average ice pressure (MPa) must be supplied." ;
                    sh:minCount 1 ;
                    sh:node :AvgIcePressureShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Load patch height (m) must be supplied." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Load patch height (m) must be supplied." ;
                    sh:minCount 1 ;
                    sh:node :LoadPatchHeightShape ;
                    sh:path nltl:loadPatchHeight ] ] .

