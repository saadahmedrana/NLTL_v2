@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ;
                    sh:resultMessage "Shell plate thickness must equal net plate thickness plus corrosion‑abrasion allowance (within tolerance)." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Shell plate thickness must equal net plate thickness plus corrosion‑abrasion allowance (within tolerance)." ;
                            sh:select """
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:thickness ?thickQV .
                        $this nltl:iceLoadRequiredNetPlateThickness ?netQV .
                        $this nltl:corrosionAbrasionAllowance ?caQV .
                        ?thickQV qudt:numericValue ?tVal .
                        ?netQV qudt:numericValue ?netVal .
                        ?caQV qudt:numericValue ?caVal .
                        FILTER (
                            abs(?tVal - (?netVal + ?caVal)) >
                            ( "0.000001"^^xsd:decimal * (abs(?netVal + ?caVal) + "0.000000001"^^xsd:decimal) )
                        )
                    }
                """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:iceLoadRequiredNetPlateThickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:corrosionAbrasionAllowance ] ;
                            sh:sparql [ sh:message "Shell plate thickness must equal net plate thickness plus corrosion‑abrasion allowance (within tolerance)." ;
                                    sh:select """
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:thickness ?thickQV .
                        $this nltl:iceLoadRequiredNetPlateThickness ?netQV .
                        $this nltl:corrosionAbrasionAllowance ?caQV .
                        ?thickQV qudt:numericValue ?tVal .
                        ?netQV qudt:numericValue ?netVal .
                        ?caQV qudt:numericValue ?caVal .
                        FILTER (
                            abs(?tVal - (?netVal + ?caVal)) >
                            ( "0.000001"^^xsd:decimal * (abs(?netVal + ?caVal) + "0.000000001"^^xsd:decimal) )
                        )
                    }
                """ ] ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class nltl:plating ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:M ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:thickness ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MilliM ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:corrosionAbrasionAllowance ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:MilliM ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:iceLoadRequiredNetPlateThickness ] ; sh:sparql [ sh:message Literal("Shell plate thickness must equal net plate thickness plus corrosion‑abrasion allowance (within tolerance).") ; sh:select Literal("
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:thickness ?thickQV .
                        $this nltl:iceLoadRequiredNetPlateThickness ?netQV .
                        $this nltl:corrosionAbrasionAllowance ?caQV .
                        ?thickQV qudt:numericValue ?tVal .
                        ?netQV qudt:numericValue ?netVal .
                        ?caQV qudt:numericValue ?caVal .
                        FILTER (
                            abs(?tVal - (?netVal + ?caVal)) >
                            ( "0.000001"^^xsd:decimal * (abs(?netVal + ?caVal) + "0.000000001"^^xsd:decimal) )
                        )
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class nltl:plating ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:M ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:thickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:iceLoadRequiredNetPlateThickness ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue unit:MilliM ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:corrosionAbrasionAllowance ] ;
                            sh:sparql [ sh:message "Shell plate thickness must equal net plate thickness plus corrosion‑abrasion allowance (within tolerance)." ;
                                    sh:select """
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:thickness ?thickQV .
                        $this nltl:iceLoadRequiredNetPlateThickness ?netQV .
                        $this nltl:corrosionAbrasionAllowance ?caQV .
                        ?thickQV qudt:numericValue ?tVal .
                        ?netQV qudt:numericValue ?netVal .
                        ?caQV qudt:numericValue ?caVal .
                        FILTER (
                            abs(?tVal - (?netVal + ?caVal)) >
                            ( "0.000001"^^xsd:decimal * (abs(?netVal + ?caVal) + "0.000000001"^^xsd:decimal) )
                        )
                    }
                """ ] ] ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F02/plating> ] .

