@prefix ex: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
            sh:resultMessage "Combined shear and bending demand exceeds plastic strength for this structural member." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Combined shear and bending demand exceeds plastic strength for this structural member." ;
                    sh:select """
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
              $this nltl:structuralLocation ?locValue .
              FILTER(?locValue IN (nltl:bottomStructureLocation, nltl:sideStructureLocation))
              $this nltl:hasStructuralMemberLoadCase ?lc .
              ?lc nltl:combinedShearAndBendingDemand ?demandQty .
              ?demandQty qudt:numericValue ?demand .
              $this nltl:plasticStrength ?strengthQty .
              ?strengthQty qudt:numericValue ?strength .
              FILTER(?demand > ?strength)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape ex:MemberStrengthCheck ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] .

