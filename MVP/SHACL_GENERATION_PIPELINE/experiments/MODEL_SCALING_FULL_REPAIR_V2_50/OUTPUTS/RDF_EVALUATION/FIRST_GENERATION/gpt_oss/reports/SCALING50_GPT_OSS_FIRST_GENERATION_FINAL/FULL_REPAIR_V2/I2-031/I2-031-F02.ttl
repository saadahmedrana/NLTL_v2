@prefix ex: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ;
            sh:resultMessage "For bottom‑structure members the patch load must be applied with the dimension (b) parallel to the frame direction." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For bottom‑structure members the patch load must be applied with the dimension (b) parallel to the frame direction." ;
                    sh:select """
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
              $this nltl:structuralLocation nltl:bottomStructureLocation .
              $this nltl:hasStructuralMemberLoadCase ?lc .
              FILTER NOT EXISTS {
                ?lc nltl:loadPatchOrientation nltl:loadPatchHeightParallelToFrame .
              }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape ex:BottomPatchOrientationCheck ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F02/member> ] .

