@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F01/ship> ;
            sh:resultMessage "At least one loading condition case must be provided." ;
            sh:resultPath nltl:hasLoadingConditionCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least one loading condition case must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasLoadingConditionCase ] ] .

