@prefix : <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/ship> ;
            sh:resultMessage "Each loading condition case must have residualStabilityFactorSI = 1, or (alternativeInstrumentApplicable = true and alternativeInstrumentResidualStabilityStatus = true)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each loading condition case must have residualStabilityFactorSI = 1, or (alternativeInstrumentApplicable = true and alternativeInstrumentResidualStabilityStatus = true)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this WHERE {
                $this nltl:shipCategory ?cat .
                FILTER(?cat = nltl:polarShipCategoryA || ?cat = nltl:polarShipCategoryB) .
                $this nltl:constructionDate ?cdate .
                FILTER(?cdate >= "2017-01-01"^^xsd:date) .
                $this nltl:hasLoadingConditionCase ?lc .

                OPTIONAL {
                    ?lc nltl:residualStabilityFactorSI ?q .
                    ?q qudt:numericValue ?val .
                }
                OPTIONAL { ?lc nltl:alternativeInstrumentApplicable ?altApp . }
                OPTIONAL { ?lc nltl:alternativeInstrumentResidualStabilityStatus ?altStat . }

                FILTER( !( (BOUND(?val) && math:abs(?val - 1) <= 1e-6) ||
                          (BOUND(?altApp) && ?altApp = true && BOUND(?altStat) && ?altStat = true) ) )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape :ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F02/ship> ] .

