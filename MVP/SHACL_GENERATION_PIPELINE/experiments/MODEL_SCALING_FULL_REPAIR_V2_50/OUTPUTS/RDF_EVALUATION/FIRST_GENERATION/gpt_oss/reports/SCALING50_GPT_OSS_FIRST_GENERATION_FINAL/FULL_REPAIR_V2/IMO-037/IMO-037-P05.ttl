@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P05/ship> ;
            sh:resultMessage "At least one loading condition case must be provided." ;
            sh:resultPath nltl:hasLoadingConditionCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "At least one loading condition case must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:hasLoadingConditionCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P05/ship> ;
            sh:resultMessage "Construction date must be on or after 2017‑01‑01." ;
            sh:resultPath nltl:constructionDate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:message "Construction date must be on or after 2017‑01‑01." ;
                    sh:minInclusive "2017-01-01"^^xsd:date ;
                    sh:path nltl:constructionDate ] ;
            sh:value "2016-12-31"^^xsd:date ] .

