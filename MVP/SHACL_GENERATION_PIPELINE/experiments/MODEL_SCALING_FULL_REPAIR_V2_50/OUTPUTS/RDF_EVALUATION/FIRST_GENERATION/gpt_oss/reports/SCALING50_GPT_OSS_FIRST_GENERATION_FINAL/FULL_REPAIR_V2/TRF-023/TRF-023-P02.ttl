            sh:sourceShape _:n16a218ba7651450f8bdaf4f811d11c3db5 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P02/mcr> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P02/ship> ;
            sh:resultMessage "Maximum continuous rating power must be provided as a QuantityValue." ;
