            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P02/mcr> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P02/ship> ;
            sh:resultMessage "Required power under 1985 rules must be provided as a QuantityValue." ;
