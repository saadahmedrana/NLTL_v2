@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Required power under 1985 rules must be provided as a QuantityValue." ;
            sh:resultPath nltl:requiredPowerUnder1985Rules ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeKindConstraintComponent ;
            sh:sourceShape _:n16a218ba7651450f8bdaf4f811d11c3db6 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/legacyRequired> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Maximum continuous rating power must be provided as a QuantityValue." ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeKindConstraintComponent ;
            sh:sourceShape _:n16a218ba7651450f8bdaf4f811d11c3db5 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/mcr> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Maximum continuous rating power must be provided as a QuantityValue." ;
            sh:resultPath nltl:maximumContinuousRatingPower ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:n16a218ba7651450f8bdaf4f811d11c3db5 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/mcr> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Required power under 1985 rules must be provided as a QuantityValue." ;
            sh:resultPath nltl:requiredPowerUnder1985Rules ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:n16a218ba7651450f8bdaf4f811d11c3db6 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/legacyRequired> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P03/ship> ;
            sh:resultMessage "Ship must have ice class IB or IC." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceClassIb nltl:iceClassIc ) ;
                    sh:message "Ship must have ice class IB or IC." ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIa ] .

_:n16a218ba7651450f8bdaf4f811d11c3db5 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:message "Maximum continuous rating power must be provided as a QuantityValue." ;
    sh:minCount 1 ;
    sh:nodeKind sh:BlankNode ;
    sh:path nltl:maximumContinuousRatingPower .

_:n16a218ba7651450f8bdaf4f811d11c3db6 sh:class qudt:QuantityValue ;
    sh:maxCount 1 ;
    sh:message "Required power under 1985 rules must be provided as a QuantityValue." ;
    sh:minCount 1 ;
    sh:nodeKind sh:BlankNode ;
    sh:path nltl:requiredPowerUnder1985Rules .

