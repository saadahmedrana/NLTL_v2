@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ;
            sh:resultMessage "Permitted reduced line load for very‑long‑hatch opening is out of the allowed range or not approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Permitted reduced line load for very‑long‑hatch opening is out of the allowed range or not approved." ;
                    sh:select """
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:veryLongHatchOpening true .

                $this nltl:permittedReducedLineLoad ?permLoadNode .
                ?permLoadNode qudt:numericValue ?permLoadVal .
                ?permLoadNode qudt:unit unit:KiloN-PER-M .

                $this nltl:reducedLineLoadApprovedByClassificationSociety true .

                FILTER ( ?permLoadVal < 0.10 || ?permLoadVal >= 0.15 )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF-055 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/narrowDeckStrip> ] .

