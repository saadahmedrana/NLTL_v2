@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Web frame ice load does not satisfy F = f12 * max(p*h, 0.15) * S (converted to kN) with f12 = 1.8" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Web frame ice load does not satisfy F = f12 * max(p*h, 0.15) * S (converted to kN) with f12 = 1.8" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode .
                ?pNode qudt:numericValue ?pVal .
                $this nltl:iceLoadHeight ?hNode .
                ?hNode qudt:numericValue ?hVal .
                $this nltl:webFrameSpacing ?sNode .
                ?sNode qudt:numericValue ?sVal .
                $this nltl:webFrameIceLoad ?fNode .
                ?fNode qudt:numericValue ?fVal .

                # calculate p*h
                BIND (?pVal * ?hVal AS ?phProd) .
                # apply lower bound 0.15 MN/m
                BIND (IF(?phProd < 0.15, 0.15, ?phProd) AS ?phAdj) .
                # expected load in MN: f12 * phAdj * S, with f12 = 1.8
                BIND (1.8 * ?phAdj * ?sVal AS ?expectedMN) .
                # convert to kN (1 MN = 1000 kN)
                BIND (?expectedMN * 1000 AS ?expectedKN) .

                # tolerance: relative 1e-6, absolute 1e-9
                BIND ( (1e-6 * ABS(?expectedKN) + 1e-9) AS ?tol ) .
                FILTER ( ABS(?fVal - ?expectedKN) > ?tol )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF-057 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

