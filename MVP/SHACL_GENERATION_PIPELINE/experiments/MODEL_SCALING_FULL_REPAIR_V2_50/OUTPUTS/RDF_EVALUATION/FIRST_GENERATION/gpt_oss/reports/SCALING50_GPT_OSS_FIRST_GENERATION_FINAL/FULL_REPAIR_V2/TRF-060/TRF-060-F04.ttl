@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F04/lookup> ;
            sh:resultMessage "Evidence of table lookup selection is required." ;
            sh:resultPath nltl:lookupSelectionEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf320977aa87743ab9966eb81bab7252fb3 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F04/lookup> ;
                    sh:resultMessage "Evidence of table lookup selection is required." ;
                    sh:resultPath nltl:lookupSelectionEvidence ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:nf320977aa87743ab9966eb81bab7252fb3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F04/ship> ;
            sh:resultMessage "A table lookup case (for gamma factor) with evidence is required." ;
            sh:resultPath nltl:hasTableLookupCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "A table lookup case (for gamma factor) with evidence is required." ;
                    sh:minCount 1 ;
                    sh:node gen:TableLookupCaseShape ;
                    sh:path nltl:hasTableLookupCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F04/lookup> ] .

_:nf320977aa87743ab9966eb81bab7252fb3 sh:class nltl:evidenceArtifact ;
    sh:message "Evidence of table lookup selection is required." ;
    sh:minCount 1 ;
    sh:path nltl:lookupSelectionEvidence .

