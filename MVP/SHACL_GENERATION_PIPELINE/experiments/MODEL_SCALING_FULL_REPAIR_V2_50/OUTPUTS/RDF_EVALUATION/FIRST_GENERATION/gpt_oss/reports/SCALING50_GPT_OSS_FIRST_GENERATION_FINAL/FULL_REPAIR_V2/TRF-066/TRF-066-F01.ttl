@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "For ice class IA or IA Super, when practicable, an ice knife must extend below the lower ice waterline." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice class IA or IA Super, when practicable, an ice knife must extend below the lower ice waterline." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this (COUNT(*) AS ?violations) WHERE {
                $this nltl:iceClass ?ic .
                FILTER(?ic = nltl:iceClassIa || ?ic = nltl:iceClassIaSuper)
                $this nltl:iceKnifePracticable true .
                FILTER NOT EXISTS {
                    ?knife a nltl:iceKnife .
                    ?knife nltl:extendsBelowLowerIceWaterline true .
                }
            }
            GROUP BY $this
            HAVING (COUNT(*) > 0)
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF-066 ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ] .

