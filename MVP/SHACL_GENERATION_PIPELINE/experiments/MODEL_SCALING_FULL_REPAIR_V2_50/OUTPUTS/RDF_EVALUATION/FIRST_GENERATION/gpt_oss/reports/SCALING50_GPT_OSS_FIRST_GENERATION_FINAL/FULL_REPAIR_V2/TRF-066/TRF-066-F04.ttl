@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F04/ship> ;
            sh:resultMessage "Ice‑knife practicability must be indicated as a boolean." ;
            sh:resultPath nltl:iceKnifePracticable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Ice‑knife practicability must be indicated as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:iceKnifePracticable ] ] .

