@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-P03/ship> ;
            sh:resultMessage "Ice class, when declared, must be IA or IA Super for this requirement." ;
            sh:resultPath nltl:iceClass ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ;
                    sh:message "Ice class, when declared, must be IA or IA Super for this requirement." ;
                    sh:path nltl:iceClass ] ;
            sh:value nltl:iceClassIb ] .

