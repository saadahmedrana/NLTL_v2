@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a shacl:ValidationReport ;
    shacl:conforms false ;
    shacl:result [ a shacl:ValidationResult ;
            shacl:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F04/ship> ;
            shacl:resultMessage "Less than 1 values on ex:ship->nltl:maximumContinuousRatingPower" ;
            shacl:resultPath nltl:maximumContinuousRatingPower ;
            shacl:resultSeverity shacl:Violation ;
            shacl:sourceConstraintComponent shacl:MinCountConstraintComponent ;
            shacl:sourceShape [ shacl:maxCount 1 ;
                    shacl:minCount 1 ;
                    shacl:node [ shacl:class qudt:QuantityValue ;
                            shacl:property [ shacl:hasValue unit:KiloW ;
                                    shacl:maxCount 1 ;
                                    shacl:minCount 1 ;
                                    shacl:path qudt:unit ],
                                [ shacl:datatype xsd:decimal ;
                                    shacl:maxCount 1 ;
                                    shacl:minCount 1 ;
                                    shacl:path qudt:numericValue ] ] ;
                    shacl:path nltl:maximumContinuousRatingPower ] ] .

