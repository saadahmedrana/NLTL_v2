@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must identify the plastic collapse mechanism." ;
            sh:resultPath nltl:plasticCollapseMechanism ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the plastic collapse mechanism." ;
                    sh:minCount 1 ;
                    sh:path nltl:plasticCollapseMechanism ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath nltl:patchLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-031-KiloNewtonQuantityShape> ;
                    sh:path nltl:patchLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "A frame profile type is required for the ship." ;
            sh:resultPath nltl:frameProfileType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A frame profile type is required for the ship." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:frameProfileType ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ;
                    sh:resultMessage "Combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "Combined shear and bending demand must not exceed plastic strength, and plastic strength must equal the midspan plastic collapse load within tolerance." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX q: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMemberLoadCase ?case .
                ?case nltl:combinedShearAndBendingDemand ?demandQuantity .
                ?demandQuantity q:numericValue ?demand .
                $this nltl:plasticStrength ?strengthQuantity .
                ?strengthQuantity q:numericValue ?strength .
                $this nltl:midspanPlasticCollapseLoad ?midspanQuantity .
                ?midspanQuantity q:numericValue ?midspan .
                FILTER (
                    ?demand > ?strength
                    ||
                    ABS(?strength - ?midspan) >
                    (ABS(?midspan) * "0.000001"^^xsd:decimal + "0.000001"^^xsd:decimal)
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/ship> ;
            sh:resultMessage "Each represented structural member must satisfy the local-frame requirement." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member must satisfy the local-frame requirement." ;
                    sh:node <urn:nltl:generated-shape:I2-031-StructuralMemberShape> ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F01/member> ] .

