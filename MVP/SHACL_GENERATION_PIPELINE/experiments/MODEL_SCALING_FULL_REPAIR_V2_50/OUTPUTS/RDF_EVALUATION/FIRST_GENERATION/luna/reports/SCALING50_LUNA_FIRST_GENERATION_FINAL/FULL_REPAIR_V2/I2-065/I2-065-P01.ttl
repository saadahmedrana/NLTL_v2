@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ;
            sh:resultMessage "A ship with a nonlinear calculation case must provide fracture, major-buckling, and yielding margins." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with a nonlinear calculation case must provide fracture, major-buckling, and yielding margins." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS { $this nltl:fractureMargin ?fracture }
                    || NOT EXISTS { $this nltl:majorBucklingMargin ?buckling }
                    || NOT EXISTS { $this nltl:yieldingMargin ?yielding }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_065_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ] .

