@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
                    sh:resultMessage "The Polar Ship Certificate shall use the Appendix I model." ;
                    sh:resultPath nltl:certificateFormModel ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nd352a953933740748421630f367ab1b0b13 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The ship shall have a Polar Ship Certificate form conforming to the required model." ;
            sh:resultPath nltl:hasPolarShipCertificate ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:polarShipCertificateForm ;
                    sh:message "The ship shall have a Polar Ship Certificate form conforming to the required model." ;
                    sh:minCount 1 ;
                    sh:node gen:IMO_016_CertificateFormShape ;
                    sh:path nltl:hasPolarShipCertificate ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
            sh:resultMessage "The Polar Ship Certificate shall use the Appendix I model." ;
            sh:resultPath nltl:certificateFormModel ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nd352a953933740748421630f367ab1b0b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The certificate language is required to determine whether an approved translation is required." ;
            sh:resultPath nltl:certificateLanguage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The certificate language is required to determine whether an approved translation is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:certificateLanguage ] ] .

_:nd352a953933740748421630f367ab1b0b13 sh:hasValue nltl:appendixIPolarShipCertificateModel ;
    sh:message "The Polar Ship Certificate shall use the Appendix I model." ;
    sh:minCount 1 ;
    sh:path nltl:certificateFormModel .

