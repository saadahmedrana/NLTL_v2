@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F04/ship> ;
            sh:resultMessage "For category A or B ships constructed on or after 1 January 2017, every loading condition requires the declared residual-stability outcome." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-037-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F04/ship> ] .

