            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nd54b99578f0649de95db8cb5f7ff191ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-122-N-F04/ship> ;
            sh:resultMessage "Food waste shall not be discharged onto the ice." ;
            sh:resultPath nltl:foodWasteDischargeOntoIce ;
            sh:resultSeverity sh:Violation ;
