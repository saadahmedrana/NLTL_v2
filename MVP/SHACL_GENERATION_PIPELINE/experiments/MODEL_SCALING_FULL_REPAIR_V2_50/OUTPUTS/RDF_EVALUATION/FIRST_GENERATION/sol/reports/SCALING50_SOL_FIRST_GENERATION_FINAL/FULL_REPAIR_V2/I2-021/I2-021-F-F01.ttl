@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ;
                    sh:resultMessage "Shell plate thickness must equal the ice-load required net thickness plus the corrosion and abrasion allowance." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ sh:message "Shell plate thickness must equal the ice-load required net thickness plus the corrosion and abrasion allowance." ;
                            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadRequiredNetPlateThickness ?netQuantity ;
                      nltl:corrosionAbrasionAllowance ?allowanceQuantity ;
                      nltl:thickness ?thicknessQuantity .
                ?netQuantity qudt:numericValue ?net .
                ?allowanceQuantity qudt:numericValue ?allowance .
                ?thicknessQuantity qudt:numericValue ?reported .
                BIND(
                    (xsd:decimal(?net) + xsd:decimal(?allowance))
                    / "1000"^^xsd:decimal
                    AS ?expected
                )
                BIND(
                    ABS(?expected) * "0.000001"^^xsd:decimal
                    AS ?relativeTolerance
                )
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(
                    ABS(xsd:decimal(?reported) - ?expected) > ?tolerance
                )
            }
        """ ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape gen:I2_021_PlatingShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/ship> ;
            sh:resultMessage "Each ship must identify plating for the shell plate thickness calculation." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:message "Each ship must identify plating for the shell plate thickness calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_021_PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F01/plating> ] .

