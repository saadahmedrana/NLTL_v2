@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F03/plating> ;
                    sh:resultMessage "Each plating item must have one corrosion and abrasion allowance in millimetres." ;
                    sh:resultPath nltl:corrosionAbrasionAllowance ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each plating item must have one corrosion and abrasion allowance in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_021_MillimetreQuantityShape ;
                            sh:path nltl:corrosionAbrasionAllowance ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F03/ship> ;
            sh:resultMessage "Each ship must identify plating for the shell plate thickness calculation." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:message "Each ship must identify plating for the shell plate thickness calculation." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_021_PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F03/plating> ] .

