@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F04/member> ;
                    sh:resultMessage "Each assessed structural member must provide its externally determined flange outstand in millimetres." ;
                    sh:resultPath nltl:flangeOutstand ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each assessed structural member must provide its externally determined flange outstand in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gs:I2-043-MillimetreQuantityShape ;
                            sh:path nltl:flangeOutstand ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F04/ship> ;
            sh:resultMessage "A ship must identify the structural member assessed under requirement I2-043." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:message "A ship must identify the structural member assessed under requirement I2-043." ;
                    sh:minCount 1 ;
                    sh:node gs:I2-043-StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F04/member> ] .

