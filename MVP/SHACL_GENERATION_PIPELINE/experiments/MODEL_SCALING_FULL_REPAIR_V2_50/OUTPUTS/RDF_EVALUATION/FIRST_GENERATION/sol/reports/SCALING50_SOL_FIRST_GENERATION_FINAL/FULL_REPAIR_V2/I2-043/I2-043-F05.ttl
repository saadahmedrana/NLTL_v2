@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/flangeOutstand> ;
                            sh:resultMessage "Node ex:flangeOutstand->qudt:unit does not contain a value in the set: ['unit:MilliM']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue unit:MilliM ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/member> ;
                    sh:resultMessage "Each assessed structural member must provide its externally determined flange outstand in millimetres." ;
                    sh:resultPath nltl:flangeOutstand ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each assessed structural member must provide its externally determined flange outstand in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gs:I2-043-MillimetreQuantityShape ;
                            sh:path nltl:flangeOutstand ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/flangeOutstand> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/ship> ;
            sh:resultMessage "A ship must identify the structural member assessed under requirement I2-043." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:structuralMember ;
                    sh:message "A ship must identify the structural member assessed under requirement I2-043." ;
                    sh:minCount 1 ;
                    sh:node gs:I2-043-StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F05/member> ] .

