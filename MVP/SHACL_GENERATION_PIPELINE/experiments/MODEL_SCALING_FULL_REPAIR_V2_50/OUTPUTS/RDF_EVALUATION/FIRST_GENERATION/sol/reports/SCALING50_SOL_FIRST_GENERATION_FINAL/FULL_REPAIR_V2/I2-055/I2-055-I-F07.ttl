@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F07/designStress> ;
                    sh:resultMessage "Stress must use MPa." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( unit:MegaPA ) ;
                            sh:maxCount 1 ;
                            sh:message "Stress must use MPa." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ;
                    sh:value unit:UNITLESS ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F07/ship> ;
            sh:resultMessage "Design stress is required in MPa." ;
            sh:resultPath nltl:designStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "Design stress is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node gs:StressQuantityValueShape ;
                    sh:path nltl:designStress ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F07/designStress> ] .

