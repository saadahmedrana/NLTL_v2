@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ;
                    sh:resultMessage "Each daily low-temperature observation must have a calendar date." ;
                    sh:resultPath nltl:dailyTemperatureObservationDate ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:date ;
                            sh:message "Each daily low-temperature observation must have a calendar date." ;
                            sh:minCount 1 ;
                            sh:path nltl:dailyTemperatureObservationDate ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class qudt:QuantityValue ; sh:message Literal(\"Each observation must carry a daily low temperature in degrees Celsius.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG_C ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:dailyLowTemperature ], [ sh:datatype xsd:date ; sh:message Literal(\"Each daily low-temperature observation must have a calendar date.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:dailyTemperatureObservationDate ] ]. See details for more information." ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dailyLowTemperatureObservation ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:date ;
                                    sh:message "Each daily low-temperature observation must have a calendar date." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:dailyTemperatureObservationDate ],
                                [ sh:class qudt:QuantityValue ;
                                    sh:message "Each observation must carry a daily low temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:DEG_C ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:dailyLowTemperature ] ] ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ] .

