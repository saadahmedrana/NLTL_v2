@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F07/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasDailyLowTemperatureObservation" ;
            sh:resultPath nltl:hasDailyLowTemperatureObservation ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:dailyLowTemperatureObservation ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:date ;
                                    sh:message "Each daily low-temperature observation must have a calendar date." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:dailyTemperatureObservationDate ],
                                [ sh:class qudt:QuantityValue ;
                                    sh:message "Each observation must carry a daily low temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue unit:DEG_C ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ] ;
                                    sh:path nltl:dailyLowTemperature ] ] ;
                    sh:path nltl:hasDailyLowTemperatureObservation ] ] .

