@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "Damage extents or selected vertical position do not satisfy the required formulas and inclusive range." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Damage extents or selected vertical position do not satisfy the required formulas and inclusive range." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:upperIceWaterlineLength ?lengthValue ;
                      nltl:upperIceWaterlineDraught ?draughtValue ;
                      nltl:longitudinalDamageExtent ?longitudinalValue ;
                      nltl:verticalDamageExtent ?verticalValue ;
                      nltl:selectedVerticalDamagePosition ?positionValue .

                ?lengthValue qudt:numericValue ?length .
                ?draughtValue qudt:numericValue ?draught .
                ?longitudinalValue qudt:numericValue ?longitudinal .
                ?verticalValue qudt:numericValue ?vertical .
                ?positionValue qudt:numericValue ?position .

                BIND(
                    IF(
                        ?forward,
                        0.045 * ?length,
                        0.015 * ?length
                    )
                    AS ?expectedLongitudinal
                )
                BIND(
                    IF(
                        ABS(?expectedLongitudinal) * 0.000001 > 0.000000001,
                        ABS(?expectedLongitudinal) * 0.000001,
                        0.000000001
                    )
                    AS ?longitudinalTolerance
                )
                BIND(
                    IF(
                        0.20 * ?draught < ?longitudinal,
                        0.20 * ?draught,
                        ?longitudinal
                    )
                    AS ?expectedVertical
                )
                BIND(
                    IF(
                        ABS(?expectedVertical) * 0.000001 > 0.000000001,
                        ABS(?expectedVertical) * 0.000001,
                        0.000000001
                    )
                    AS ?verticalTolerance
                )

                FILTER (
                    ABS(?longitudinal - ?expectedLongitudinal) > ?longitudinalTolerance ||
                    ABS(?vertical - ?expectedVertical) > ?verticalTolerance ||
                    ?position < 0 ||
                    ?position > 1.20 * ?draught
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IceDamageExtentShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

