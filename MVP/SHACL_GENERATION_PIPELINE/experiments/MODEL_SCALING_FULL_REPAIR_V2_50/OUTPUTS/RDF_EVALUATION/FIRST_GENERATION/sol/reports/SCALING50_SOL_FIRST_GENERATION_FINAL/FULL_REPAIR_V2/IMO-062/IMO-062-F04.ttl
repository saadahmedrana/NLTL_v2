@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "Each exposed escape route must have safe status true." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed escape route must have safe status true." ;
                            sh:minCount 1 ;
                            sh:path nltl:escapeRouteSafeStatus ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "Each exposed escape route must have accessible status true." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed escape route must have accessible status true." ;
                            sh:minCount 1 ;
                            sh:path nltl:escapeRouteAccessibleStatus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO062ExposedEscapeRouteShape. See details for more information." ;
            sh:resultPath nltl:hasExposedEscapeRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:exposedEscapeRoute ;
                    sh:node gen:IMO062ExposedEscapeRouteShape ;
                    sh:path nltl:hasExposedEscapeRoute ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasExposedEscapeRoute ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Accessible status must be recorded as true when exposed escape routes exist.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:accessibleStatus ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Ice and snow mitigation coverage must be recorded as true when exposed escape routes exist.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:iceSnowMitigationCoverage ], [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"Safe status must be recorded as true when exposed escape routes exist.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:safeStatus ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:hasExposedEscapeRoute ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO062ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ] .

