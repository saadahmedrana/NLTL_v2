@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F05/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Required survival equipment must be stored in an accessible location.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:storageAccessibilityStatus ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Available survival equipment capacity must be provided when survival equipment is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:availableSurvivalEquipmentCapacity ], [ sh:datatype xsd:integer ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Persons on board must be provided when survival equipment is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:personsOnBoard ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:personalOrGroupSurvivalEquipmentRequired ] ; sh:sparql [ sh:message Literal("Available survival equipment capacity must be at least 110 percent of the persons on board, rounded up to a whole person.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:personalOrGroupSurvivalEquipmentRequired true ;
                              nltl:personsOnBoard ?persons ;
                              nltl:availableSurvivalEquipmentCapacity ?capacity .
                        FILTER (
                            xsd:decimal(?capacity) <
                            (xsd:decimal(?persons) * 1.10)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO075Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F05/ship> ] .

