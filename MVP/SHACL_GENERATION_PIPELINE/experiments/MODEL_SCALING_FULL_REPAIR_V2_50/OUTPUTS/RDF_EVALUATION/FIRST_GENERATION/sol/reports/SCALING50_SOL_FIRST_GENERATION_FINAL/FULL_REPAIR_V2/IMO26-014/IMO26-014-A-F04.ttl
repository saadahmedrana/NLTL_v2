@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F04/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"The ship must explicitly record that it operates only in continuous daylight.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:operatesOnlyInContinuousDaylight ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:message Literal(\"The ship must explicitly record that it does not operate only in continuous daylight.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:operatesOnlyInContinuousDaylight ], [ sh:datatype xsd:integer ; sh:message Literal(\"A ship not operating only in continuous daylight must have at least two means of illumination for visual ice detection.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path nltl:visualIceDetectionIlluminationMeansCount ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gs:IMO26-014Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F04/ship> ] .

