@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:in ( Literal(\"false\" = False, datatype=xsd:boolean) ) ; sh:path nltl:polarCodeChapter11Applicable ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:message Literal(\"A ship for which Polar Code chapter 11 applies must be certified in accordance with SOLAS chapter I.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:solasChapterICertified ], [ sh:in ( Literal(\"true\" = True, datatype=xsd:boolean) ) ; sh:path nltl:polarCodeChapter11Applicable ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:PolarCodeChapter11ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ] .

