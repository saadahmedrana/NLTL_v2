@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F03/ship> ;
            sh:resultMessage "Polar Code chapter 11 applicability must be recorded as a boolean." ;
            sh:resultPath nltl:polarCodeChapter11Applicable ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "Polar Code chapter 11 applicability must be recorded as a boolean." ;
                    sh:minCount 1 ;
                    sh:path nltl:polarCodeChapter11Applicable ] ] .

