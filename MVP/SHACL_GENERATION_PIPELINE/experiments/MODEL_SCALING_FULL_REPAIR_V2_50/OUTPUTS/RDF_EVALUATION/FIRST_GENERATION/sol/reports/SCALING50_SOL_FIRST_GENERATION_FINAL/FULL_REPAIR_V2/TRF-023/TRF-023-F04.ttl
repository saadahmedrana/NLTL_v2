@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ;
            sh:resultMessage "A ship retaining ice class IB or IC under the 1985 regulations must provide maximum continuous rating power and required power under the 1985 rules as decimal quantities in kilowatts." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship retaining ice class IB or IC under the 1985 regulations must provide maximum continuous rating power and required power under the 1985 rules as decimal quantities in kilowatts." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition
                    nltl:iceClassRuleEdition1985 ;
                    nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                        ?mcrQuantity
                            qudt:numericValue ?mcrPower ;
                            qudt:unit unit:KiloW .
                        FILTER (DATATYPE(?mcrPower) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                        ?requiredQuantity
                            qudt:numericValue ?requiredPower ;
                            qudt:unit unit:KiloW .
                        FILTER (DATATYPE(?requiredPower) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF023ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-F04/ship> ] .

