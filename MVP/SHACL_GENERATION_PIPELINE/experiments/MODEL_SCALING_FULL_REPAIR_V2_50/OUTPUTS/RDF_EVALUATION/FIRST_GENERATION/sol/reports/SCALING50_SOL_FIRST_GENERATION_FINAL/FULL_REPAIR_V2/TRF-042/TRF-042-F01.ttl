@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Corrosion and abrasion addition is required in millimetres." ;
            sh:resultPath nltl:corrosionAbrasionAddition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Corrosion and abrasion addition is required in millimetres." ;
                    sh:minCount 1 ;
                    sh:node gen:CorrosionAbrasionAdditionShape ;
                    sh:path nltl:corrosionAbrasionAddition ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ;
            sh:resultMessage "Longitudinal plating factor f2 must match the applicable h/s formula within max(1e-6 times the absolute expected value, 1e-12), with nonzero spacing and h/s not exceeding 1.8." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Longitudinal plating factor f2 must match the applicable h/s formula within max(1e-6 times the absolute expected value, 1e-12), with nonzero spacing and h/s not exceeding 1.8." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?heightNode ;
                      nltl:spacing ?spacingNode ;
                      nltl:longitudinalPlatingFactorF2 ?factorNode .
                ?heightNode qudt:numericValue ?height .
                ?spacingNode qudt:numericValue ?spacing .
                ?factorNode qudt:numericValue ?reportedFactor .
                BIND(IF(?spacing = 0.0, 0.0, ?height / ?spacing) AS ?ratio)
                BIND(
                    IF(
                        ?ratio <= 1.0,
                        0.4 / ?ratio + 0.6,
                        1.4 - 0.4 * ?ratio
                    )
                    AS ?expectedFactor
                )
                BIND(0.000001 * ABS(?expectedFactor) AS ?relativeTolerance)
                BIND(
                    IF(
                        ?relativeTolerance > 0.000000000001,
                        ?relativeTolerance,
                        0.000000000001
                    )
                    AS ?tolerance
                )
                FILTER(
                    ?spacing = 0.0 ||
                    ?ratio > 1.8 ||
                    ABS(?reportedFactor - ?expectedFactor) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:PlatingShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-F01/plating> ] .

