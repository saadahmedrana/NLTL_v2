@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ;
            sh:resultMessage "The reported f4, section modulus, and required shear area must satisfy the TRF-048 formulas within relative tolerance 1e-6 and absolute fallback 1e-9; spacing, m, and yield strength must permit division." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The reported f4, section modulus, and required shear area must satisfy the TRF-048 formulas within relative tolerance 1e-6 and absolute fallback 1e-9; spacing, m, and yield strength must permit division." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pQuantity ;
                      nltl:designIceLoadHeight ?hQuantity ;
                      nltl:spacing ?sQuantity ;
                      nltl:span ?lQuantity ;
                      nltl:frameMomentFactorM ?mQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Quantity ;
                      nltl:sectionModulus ?zQuantity ;
                      nltl:requiredShearArea ?aQuantity .

                ?pQuantity qudt:numericValue ?p .
                ?hQuantity qudt:numericValue ?h .
                ?sQuantity qudt:numericValue ?s .
                ?lQuantity qudt:numericValue ?l .
                ?mQuantity qudt:numericValue ?m .
                ?yieldQuantity qudt:numericValue ?yield .
                ?f4Quantity qudt:numericValue ?reportedF4 .
                ?zQuantity qudt:numericValue ?reportedZ .
                ?aQuantity qudt:numericValue ?reportedA .

                BIND(IF(?s = 0, 0, 1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND(IF((?m = 0 || ?yield = 0), 0,
                    (?expectedF4 * ?p * ?h * ?l * ?l /
                    (4 * ?m * ?yield)) * 1000000) AS ?expectedZ)
                BIND(IF(?yield = 0, 0,
                    (1.7320508075688772 * ?expectedF4 * 2.16 *
                    ?p * ?h * ?l / (2 * ?yield)) * 10000) AS ?expectedA)

                BIND(IF(ABS(?expectedF4) * 0.000001 > 0.000000001,
                    ABS(?expectedF4) * 0.000001, 0.000000001) AS ?f4Tolerance)
                BIND(IF(ABS(?expectedZ) * 0.000001 > 0.000000001,
                    ABS(?expectedZ) * 0.000001, 0.000000001) AS ?zTolerance)
                BIND(IF(ABS(?expectedA) * 0.000001 > 0.000000001,
                    ABS(?expectedA) * 0.000001, 0.000000001) AS ?aTolerance)

                FILTER (
                    ?s = 0 ||
                    ?m = 0 ||
                    ?yield = 0 ||
                    ABS(?reportedF4 - ?expectedF4) > ?f4Tolerance ||
                    ABS(?reportedZ - ?expectedZ) > ?zTolerance ||
                    ABS(?reportedA - ?expectedA) > ?aTolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/longitudinalFrame> ] .

