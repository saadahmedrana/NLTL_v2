@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F01/webFrame> ;
            sh:resultMessage "The web frame shear factor alpha must correspond to the free-flange-to-web-area ratio in Table 4-8." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The web frame shear factor alpha must correspond to the free-flange-to-web-area ratio in Table 4-8." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity .
                ?ratioQuantity qudt:numericValue ?ratio .
                ?alphaQuantity qudt:numericValue ?alpha .
                FILTER (!(
                    (?ratio = "0"^^xsd:decimal && ?alpha = "1.5"^^xsd:decimal) ||
                    (?ratio = "0.2"^^xsd:decimal && ?alpha = "1.23"^^xsd:decimal) ||
                    (?ratio = "0.4"^^xsd:decimal && ?alpha = "1.16"^^xsd:decimal) ||
                    (?ratio = "0.6"^^xsd:decimal && ?alpha = "1.11"^^xsd:decimal) ||
                    (?ratio = "0.8"^^xsd:decimal && ?alpha = "1.09"^^xsd:decimal) ||
                    (?ratio = "1.0"^^xsd:decimal && ?alpha = "1.07"^^xsd:decimal) ||
                    (?ratio = "1.2"^^xsd:decimal && ?alpha = "1.06"^^xsd:decimal) ||
                    (?ratio = "1.4"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                    (?ratio = "1.6"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                    (?ratio = "1.8"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal) ||
                    (?ratio = "2.0"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal)
                ))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF059WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F01/webFrame> ] .

