@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ;
            sh:resultMessage "Required shear area must satisfy the prescribed formula within relative tolerance 1e-6 and absolute fallback 1e-9 cm2." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Required shear area must satisfy the prescribed formula within relative tolerance 1e-6 and absolute fallback 1e-9 cm2." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:yieldStrength ?strengthQuantity ;
                      nltl:requiredShearArea ?areaQuantity .
                ?forceQuantity qudt:numericValue ?forceKiloN .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?strengthQuantity qudt:numericValue ?yieldStrengthMPa .
                ?areaQuantity qudt:numericValue ?reportedAreaCm2 .
                BIND(
                    IF(
                        ?yieldStrengthMPa = "0"^^xsd:decimal,
                        "0"^^xsd:decimal,
                        "1.7320508075688772935"^^xsd:decimal *
                        ?alpha *
                        "1.1"^^xsd:decimal *
                        (?forceKiloN / "1000"^^xsd:decimal) /
                        ?yieldStrengthMPa *
                        "10000"^^xsd:decimal
                    )
                    AS ?expectedAreaCm2
                )
                BIND(
                    IF(
                        ABS(?expectedAreaCm2) * "0.000001"^^xsd:decimal >
                            "0.000000001"^^xsd:decimal,
                        ABS(?expectedAreaCm2) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (
                    ?yieldStrengthMPa = "0"^^xsd:decimal ||
                    ABS(?reportedAreaCm2 - ?expectedAreaCm2) > ?tolerance
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF059WebFrameShearAreaShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F02/webFrame> ] .

