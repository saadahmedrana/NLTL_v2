@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureStatus" ;
            sh:resultPath nltl:bladeFailureStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bladeFailureStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:approvalRecord ; sh:message Literal(\"An approved nonlinear blade stress analysis must be provided for the analysis alternative.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] , [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:KilonewtonQuantityShape ; sh:path nltl:bladeFailureUltimateLoad ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegaPascalQuantityShape ; sh:path nltl:bladeMinimumYieldStrength ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegaPascalQuantityShape ; sh:path nltl:bladeReferenceStrength1 ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MegaPascalQuantityShape ; sh:path nltl:bladeUltimateTensileStrength ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:bladeChordLengthAtWeakestSection ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:bladeCylindricalRootRadius ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node gen:MetreQuantityShape ; sh:path nltl:bladeMaximumThicknessAtWeakestSection ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:TRF101BladeFailureShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F02/ship> ;
            sh:resultMessage "Each blade-failure load case must apply the load at radius ratio 0.8 in the weakest blade direction." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Each blade-failure load case must apply the load at radius ratio 0.8 in the weakest blade direction." ;
                    sh:minCount 1 ;
                    sh:node gen:LoadCaseShape ;
                    sh:path nltl:hasLoadCase ] ] .

