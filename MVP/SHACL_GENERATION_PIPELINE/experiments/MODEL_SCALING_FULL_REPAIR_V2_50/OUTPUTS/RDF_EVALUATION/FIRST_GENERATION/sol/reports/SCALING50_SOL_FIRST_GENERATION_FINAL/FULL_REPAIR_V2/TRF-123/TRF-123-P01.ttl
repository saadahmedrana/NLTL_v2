@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/loadCase> ;
                    sh:resultMessage "The load case must provide the externally determined component yield safety factor." ;
                    sh:resultPath nltl:componentYieldSafetyFactor ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The load case must provide the externally determined component yield safety factor." ;
                            sh:minCount 1 ;
                            sh:node gs:UnitlessDecimalQuantityShape ;
                            sh:path nltl:componentYieldSafetyFactor ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/component> ;
                            sh:resultMessage "Each assessed component must provide its externally calculated occasional-force stress." ;
                            sh:resultPath nltl:occasionalForceComponentStress ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:message "Each assessed component must provide its externally calculated occasional-force stress." ;
                                    sh:minCount 1 ;
                                    sh:node gs:MegaPascalDecimalQuantityShape ;
                                    sh:path nltl:occasionalForceComponentStress ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/loadCase> ;
                    sh:resultMessage "The load case must identify each assessed component." ;
                    sh:resultPath nltl:occasionalForceCaseAssessedComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shipComponent ;
                            sh:message "The load case must identify each assessed component." ;
                            sh:minCount 1 ;
                            sh:node gs:OccasionalForceAssessedComponentShape ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:occasionalForceCaseAssessedComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/ship> ;
            sh:resultMessage "The ship must provide an occasional-force load case." ;
            sh:resultPath nltl:hasOccasionalForceLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:occasionalForceLoadCase ;
                    sh:message "The ship must provide an occasional-force load case." ;
                    sh:minCount 1 ;
                    sh:node gs:OccasionalForceLoadCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasOccasionalForceLoadCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-P01/loadCase> ] .

