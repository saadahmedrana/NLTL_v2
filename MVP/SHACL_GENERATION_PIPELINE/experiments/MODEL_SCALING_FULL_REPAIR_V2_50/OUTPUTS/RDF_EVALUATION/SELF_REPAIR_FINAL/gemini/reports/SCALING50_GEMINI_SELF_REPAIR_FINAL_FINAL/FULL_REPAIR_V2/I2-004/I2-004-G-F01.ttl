@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship's upper ice waterline displacement (DUI) must be equal to the maximum displacement among its upper ice waterline cases." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship's upper ice waterline displacement (DUI) must be equal to the maximum displacement among its upper ice waterline cases." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            
            SELECT $this (nltl:upperIceWaterlineDisplacement AS ?path) (?duiQty AS ?value)
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiQty .
                ?duiQty qudt:numericValue ?dui .
                {
                    SELECT $this (MAX(?caseVal) AS ?maxCaseVal)
                    WHERE {
                        $this nltl:hasUpperIceWaterlineCase ?case .
                        ?case nltl:waterlineCaseDisplacement ?caseQty .
                        ?caseQty qudt:numericValue ?caseVal .
                    }
                    GROUP BY $this
                }
                FILTER (abs(?dui - ?maxCaseVal) > 1e-6 && (?maxCaseVal = 0.0 || (abs(?dui - ?maxCaseVal) / ?maxCaseVal) > 1e-6))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/selectedDui> ] .

