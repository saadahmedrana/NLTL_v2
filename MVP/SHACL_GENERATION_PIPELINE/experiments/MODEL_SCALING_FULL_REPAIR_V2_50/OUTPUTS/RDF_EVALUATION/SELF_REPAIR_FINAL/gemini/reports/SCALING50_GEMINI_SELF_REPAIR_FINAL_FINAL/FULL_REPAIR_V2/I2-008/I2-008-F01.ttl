@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:polarClass ] ] , [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify a line load.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:LineLoadQuantityShape> ; sh:path nltl:lineLoad ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify a load patch height.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:LoadPatchHeightQuantityShape> ; sh:path nltl:loadPatchHeight ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify a load patch length.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:LoadPatchLengthQuantityShape> ; sh:path nltl:loadPatchLength ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify a local ice pressure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:LocalIcePressureQuantityShape> ; sh:path nltl:localIcePressure ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify a shape coefficient.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:ShapeCoefficientQuantityShape> ; sh:path nltl:shapeCoefficient ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify a total glancing impact force.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TotalGlancingImpactForceQuantityShape> ; sh:path nltl:totalGlancingImpactForce ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Polar class ships must specify an average ice pressure.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:AverageIcePressureQuantityShape> ; sh:path nltl:averageIcePressure ], [ sh:message Literal(\"Polar class ships must have at least one bow subregion calculation case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:BowSubregionCalculationCaseShape> ; sh:path nltl:hasBowSubregionCalculationCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipPolarClassIceLoadShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F01/ship> ] .

