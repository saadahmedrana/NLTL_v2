@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The bow region must be divided into exactly 4 subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n817c2e35f4ac441fbd1d4cbc0fe26331b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The selected maximum bow force (selectedMaximumBowForce) must equal the maximum of the calculated forces across all subregions." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The selected maximum bow force (selectedMaximumBowForce) must equal the maximum of the calculated forces across all subregions." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (MAX(?force_val) AS ?max_force)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase/nltl:bowSubregionCalculatedForce/qudt:numericValue ?force_val .
                    }
                    GROUP BY $this
                }
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?reported_max_force .
                FILTER (ABS(?reported_max_force - ?max_force) > 1e-6)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "The bow region must be divided into exactly 4 subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n817c2e35f4ac441fbd1d4cbc0fe26331b1 ] .

_:n817c2e35f4ac441fbd1d4cbc0fe26331b1 sh:datatype xsd:integer ;
    sh:hasValue 4 ;
    sh:maxCount 1 ;
    sh:message "The bow region must be divided into exactly 4 subregions." ;
    sh:minCount 1 ;
    sh:path nltl:bowSubregionCount .

