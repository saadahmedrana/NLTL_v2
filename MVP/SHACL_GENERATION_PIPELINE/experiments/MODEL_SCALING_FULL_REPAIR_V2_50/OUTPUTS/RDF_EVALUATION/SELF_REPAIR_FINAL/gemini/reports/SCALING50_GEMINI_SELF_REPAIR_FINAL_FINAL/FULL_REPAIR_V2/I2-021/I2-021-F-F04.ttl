@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ;
                            sh:resultMessage "Node ex:thickness->qudt:unit does not contain a value in the set: ['unit:M']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:nfc2b079747f3404cb23b68b4e6020f88b7 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:QuantityValueMetersShape>. See details for more information." ;
                    sh:resultPath nltl:thickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nfc2b079747f3404cb23b68b4e6020f88b3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:PlatingShape>. See details for more information." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:PlatingShape> ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/ship> ;
            sh:resultMessage "The plating thickness must equal the sum of ice load required net plate thickness and corrosion abrasion allowance (t = tnet + ts)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The plating thickness must equal the sum of ice load required net plate thickness and corrosion abrasion allowance (t = tnet + ts)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?plating
            WHERE {
                $this nltl:hasPlating ?plating .
                ?plating nltl:thickness/qudt:numericValue ?t_val ;
                         nltl:thickness/qudt:unit ?t_unit ;
                         nltl:iceLoadRequiredNetPlateThickness/qudt:numericValue ?tnet_val ;
                         nltl:iceLoadRequiredNetPlateThickness/qudt:unit ?tnet_unit ;
                         nltl:corrosionAbrasionAllowance/qudt:numericValue ?ts_val ;
                         nltl:corrosionAbrasionAllowance/qudt:unit ?ts_unit .
                
                BIND(IF(?t_unit = unit:M, ?t_val * 1000.0, ?t_val) AS ?t_mm)
                BIND(IF(?tnet_unit = unit:M, ?tnet_val * 1000.0, ?tnet_val) AS ?tnet_mm)
                BIND(IF(?ts_unit = unit:M, ?ts_val * 1000.0, ?ts_val) AS ?ts_mm)
                
                BIND(?tnet_mm + ?ts_mm AS ?expected)
                BIND(abs(?t_mm - ?expected) AS ?diff)
                BIND(IF(?expected > 0.0, ?diff / ?expected, ?diff) AS ?rel_err)
                
                FILTER (?diff > 1e-5 && ?rel_err > 1e-5)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ;
                    sh:resultMessage "Node ex:thickness->qudt:unit does not contain a value in the set: ['unit:M']" ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nfc2b079747f3404cb23b68b4e6020f88b7 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/plating> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:QuantityValueMetersShape>. See details for more information." ;
            sh:resultPath nltl:thickness ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:nfc2b079747f3404cb23b68b4e6020f88b3 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-021-F-F04/thickness> ] .

_:nfc2b079747f3404cb23b68b4e6020f88b3 sh:node <urn:nltl:generated-shape:QuantityValueMetersShape> ;
    sh:path nltl:thickness .

_:nfc2b079747f3404cb23b68b4e6020f88b7 sh:hasValue unit:M ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path qudt:unit .

