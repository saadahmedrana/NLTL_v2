@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ;
                    sh:resultMessage "Less than 1 values on ex:calculation->nltl:hullGirderLongitudinalPositionFromAft" ;
                    sh:resultPath nltl:hullGirderLongitudinalPositionFromAft ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:LengthQuantityValue> ;
                            sh:path nltl:hullGirderLongitudinalPositionFromAft ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:CalculationCaseShape>. See details for more information." ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:CalculationCaseShape> ;
                    sh:path nltl:hasCalculationCase ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F04/calculation> ] .

