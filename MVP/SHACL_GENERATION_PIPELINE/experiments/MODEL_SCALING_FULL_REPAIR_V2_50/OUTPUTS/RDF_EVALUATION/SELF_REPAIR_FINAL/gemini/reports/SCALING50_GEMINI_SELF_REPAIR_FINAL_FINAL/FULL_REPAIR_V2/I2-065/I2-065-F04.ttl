@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage "Non-linear calculation case readiness check failed." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:ndae94393b6054491b0bd4fb36f1426b3b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-NonlinearCalculationReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage "Non-linear calculation case readiness check failed." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:ndae94393b6054491b0bd4fb36f1426b3b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-NonlinearCalculationReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage "Non-linear calculation case readiness check failed." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:ndae94393b6054491b0bd4fb36f1426b3b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-NonlinearCalculationReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage "Non-linear calculation case readiness check failed." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:ndae94393b6054491b0bd4fb36f1426b3b1 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-NonlinearCalculationReadinessShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ] .

_:ndae94393b6054491b0bd4fb36f1426b3b1 a sh:SPARQLConstraint ;
    sh:message "Non-linear calculation case readiness check failed." ;
    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this ?value ?message
WHERE {
  $this nltl:hasCalculationCase ?case .
  ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
  {
    FILTER NOT EXISTS {
      $this nltl:fractureMargin ?fm .
      ?fm qudt:numericValue ?fmVal .
      ?fm qudt:unit unit:UNITLESS .
    }
    BIND($this AS ?value)
    BIND("Ship with non-linear calculation must have a valid fractureMargin with unit:UNITLESS" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      $this nltl:majorBucklingMargin ?mbm .
      ?mbm qudt:numericValue ?mbmVal .
      ?mbm qudt:unit unit:UNITLESS .
    }
    BIND($this AS ?value)
    BIND("Ship with non-linear calculation must have a valid majorBucklingMargin with unit:UNITLESS" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      $this nltl:yieldingMargin ?ym .
      ?ym qudt:numericValue ?ymVal .
      ?ym qudt:unit unit:UNITLESS .
    }
    BIND($this AS ?value)
    BIND("Ship with non-linear calculation must have a valid yieldingMargin with unit:UNITLESS" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      ?case nltl:permanentLateralDeformation ?pld .
      ?pld qudt:numericValue ?pldVal .
      ?pld qudt:unit unit:MilliM .
    }
    BIND(?case AS ?value)
    BIND("CalculationCase with non-linear method must have a valid permanentLateralDeformation with unit:MilliM" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      ?case nltl:permanentOutOfPlaneDeformation ?pod .
      ?pod qudt:numericValue ?podVal .
      ?pod qudt:unit unit:MilliM .
    }
    BIND(?case AS ?value)
    BIND("CalculationCase with non-linear method must have a valid permanentOutOfPlaneDeformation with unit:MilliM" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      ?case nltl:relevantStructuralDimension ?rsd .
      ?rsd qudt:numericValue ?rsdVal .
      ?rsd qudt:unit unit:MilliM .
    }
    BIND(?case AS ?value)
    BIND("CalculationCase with non-linear method must have a valid relevantStructuralDimension with unit:MilliM" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      ?case nltl:nonlinearAnalysisAcceptanceEvidence ?ev .
      ?ev a nltl:evidenceArtifact .
    }
    BIND(?case AS ?value)
    BIND("CalculationCase with non-linear method must have nonlinearAnalysisAcceptanceEvidence pointing to an evidenceArtifact" AS ?message)
  } UNION {
    FILTER NOT EXISTS {
      ?case nltl:minorPermanentDeformationAssessmentSatisfied true .
    }
    BIND(?case AS ?value)
    BIND("CalculationCase with non-linear method must have minorPermanentDeformationAssessmentSatisfied set to true" AS ?message)
  }
}
""" .

