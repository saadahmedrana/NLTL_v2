@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F01/ship> ;
            sh:resultMessage "When added life-saving devices require power, the power source must be independent of the ship's main power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When added life-saving devices require power, the power source must be independent of the ship's main power." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:addedLifeSavingDeviceRequiresPower true .
                FILTER NOT EXISTS {
                    ?this nltl:devicePowerSourceIndependentOfMainPower true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:Imo069Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-069-F01/ship> ] .

