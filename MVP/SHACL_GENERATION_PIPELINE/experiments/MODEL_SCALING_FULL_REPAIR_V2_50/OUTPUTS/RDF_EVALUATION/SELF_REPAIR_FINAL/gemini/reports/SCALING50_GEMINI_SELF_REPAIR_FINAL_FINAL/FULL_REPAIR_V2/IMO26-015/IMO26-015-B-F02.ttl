@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ;
            sh:resultMessage "Polar Code chapter 11 applies only when the ship is certified in accordance with SOLAS Chapter I." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Code chapter 11 applies only when the ship is certified in accordance with SOLAS Chapter I." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter11Applicable true .
                FILTER NOT EXISTS {
                    $this nltl:solasChapterICertified true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:PolarCodeChapter11ApplicabilityShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ] .

