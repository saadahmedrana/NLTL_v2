@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "Narrow deck strip failed compliance checks for section modulus, shear area, or permitted reduced line load limits under TRAFICOM 4.5.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Narrow deck strip failed compliance checks for section modulus, shear area, or permitted reduced line load limits under TRAFICOM 4.5.3." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?value ?message
            WHERE {
                $this nltl:abreastOfHatch true .
                $this nltl:servesAsIceStringer true .

                OPTIONAL {
                    $this nltl:actualSectionModulus/qudt:numericValue ?actSM .
                    $this nltl:requiredSectionModulus/qudt:numericValue ?reqSM .
                }
                OPTIONAL {
                    $this nltl:actualShearArea/qudt:numericValue ?actSA .
                    $this nltl:requiredShearArea/qudt:numericValue ?reqSA .
                }
                OPTIONAL {
                    $this nltl:veryLongHatchOpening ?veryLong .
                }
                OPTIONAL {
                    $this nltl:reducedLineLoadApprovedByClassificationSociety ?approved .
                }
                OPTIONAL {
                    $this nltl:permittedReducedLineLoad/qudt:numericValue ?permittedLL .
                }

                BIND(COALESCE(?actSM >= ?reqSM - 1e-6, false) AS ?smValid)
                BIND(COALESCE(?actSA >= ?reqSA - 1e-6, false) AS ?saValid)

                BIND(
                    IF(
                        COALESCE(?veryLong, false) && COALESCE(?approved, false),
                        IF(BOUND(?permittedLL) && ?permittedLL >= 0.10 - 1e-6 && ?permittedLL < 0.15 + 1e-6, true, false),
                        true
                    ) AS ?permittedLLValid
                )

                FILTER (!?smValid || !?saValid || !?permittedLLValid)

                BIND($this AS ?value)
                BIND(
                    CONCAT(
                        "Narrow deck strip is non-conforming. ",
                        IF(!?smValid, "Actual section modulus is less than required or missing. ", ""),
                        IF(!?saValid, "Actual shear area is less than required or missing. ", ""),
                        IF(!?permittedLLValid, "Permitted reduced line load is invalid, missing, or out of [0.10, 0.15) bounds. ", "")
                    ) AS ?message
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:NarrowDeckStripShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ] .

