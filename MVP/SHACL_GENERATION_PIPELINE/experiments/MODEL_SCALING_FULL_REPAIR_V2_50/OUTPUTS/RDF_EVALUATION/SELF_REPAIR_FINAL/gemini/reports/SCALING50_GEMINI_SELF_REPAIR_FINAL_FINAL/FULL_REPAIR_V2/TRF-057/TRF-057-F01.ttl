@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:iceLoadSourceType" ;
            sh:resultPath nltl:iceLoadSourceType ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( nltl:iceStringerLoadSource nltl:longitudinalFramingLoadSource ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:iceLoadSourceType ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:loadLengthParameter" ;
            sh:resultPath nltl:loadLengthParameter ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:loadLengthParameter ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:webFrameSafetyFactor" ;
            sh:resultPath nltl:webFrameSafetyFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 1.8 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.8 ;
                                    sh:path qudt:numericValue ],
                                [ sh:hasValue unit:UNITLESS ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ] ;
                    sh:path nltl:webFrameSafetyFactor ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Web frame ice load F does not match the calculated value F = 1.8 * max(p * h, 0.15) * S [MN] converted to kN" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Web frame ice load F does not match the calculated value F = 1.8 * max(p * h, 0.15) * S [MN] converted to kN" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:webFrameSpacing/qudt:numericValue ?S .
                $this nltl:icePressure/qudt:numericValue ?p .
                $this nltl:iceLoadHeight/qudt:numericValue ?h .
                $this nltl:webFrameIceLoad/qudt:numericValue ?F .

                BIND(?p * ?h AS ?ph)
                BIND(IF(?ph < 0.15, 0.15, ?ph) AS ?ph_eff)
                BIND(1800.0 * ?ph_eff * ?S AS ?F_expected)

                BIND(ABS(?F - ?F_expected) AS ?diff)
                BIND(ABS(?F - ?F_expected) / ?F_expected AS ?rel_diff)

                FILTER (?diff > 1e-5 && ?rel_diff > 1e-5)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape shape:WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Less than 1 values on ex:webFrame->nltl:minimumLineLoad" ;
            sh:resultPath nltl:minimumLineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class qudt:QuantityValue ;
                            sh:property [ sh:hasValue unit:KiloN-PER-M ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 150.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 150.0 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:path nltl:minimumLineLoad ] ] .

