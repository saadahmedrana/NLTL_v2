@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ;
            sh:resultMessage "For ice classes IA and IA Super, the rudder must be protected by an ice knife extending below the LIWL if practicable, or by equivalent means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ice classes IA and IA Super, the rudder must be protected by an ice knife extending below the LIWL if practicable, or by equivalent means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))

                FILTER NOT EXISTS {
                    ?this nltl:hasRudderProtectionArrangement ?arr .
                    {
                        ?arr rdf:type nltl:equivalentRudderProtectionMeans .
                    }
                    UNION
                    {
                        ?arr rdf:type nltl:iceKnife .
                        FILTER (
                            NOT EXISTS { ?this nltl:iceKnifePracticable true } ||
                            EXISTS { ?arr nltl:extendsBelowLowerIceWaterline true }
                        )
                    }
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F02/ship> ] .

