@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage """Node ex:ship must conform to one or more shapes in [ sh:property [ sh:class nltl:approvalRecord ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:approvedNonlinearBladeStressAnalysis ] ] , [ sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityKiloN> ; sh:path nltl:bladeFailureUltimateLoad ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityM> ; sh:path nltl:bladeChordLengthAtWeakestSection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityM> ; sh:path nltl:bladeCylindricalRootRadius ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityM> ; sh:path nltl:bladeMaximumThicknessAtWeakestSection ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityMegaPA> ; sh:path nltl:bladeMinimumYieldStrength ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityMegaPA> ; sh:path nltl:bladeReferenceStrength1 ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:QuantityMegaPA> ; sh:path nltl:bladeUltimateTensileStrength ] ; sh:sparql [ sh:message Literal("F_ex must match formula 300*c*t^2*sigma_ref1/(0.8*D - 2*r) and sigma_ref1 must match 0.6*sigma_0.2 + 0.4*sigma_u") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:bladeChordLengthAtWeakestSection/qudt:numericValue ?c ;
                              nltl:bladeMaximumThicknessAtWeakestSection/qudt:numericValue ?t ;
                              nltl:bladeCylindricalRootRadius/qudt:numericValue ?r ;
                              nltl:propellerDiameter/qudt:numericValue ?D ;
                              nltl:bladeMinimumYieldStrength/qudt:numericValue ?sigma_02 ;
                              nltl:bladeUltimateTensileStrength/qudt:numericValue ?sigma_u ;
                              nltl:bladeReferenceStrength1/qudt:numericValue ?sigma_ref1 ;
                              nltl:bladeFailureUltimateLoad/qudt:numericValue ?F_ex .

                        BIND(0.6 * ?sigma_02 + 0.4 * ?sigma_u AS ?sigma_ref1_calc)
                        BIND((300 * ?c * (?t * ?t) * ?sigma_ref1_calc) / (0.8 * ?D - 2 * ?r) AS ?F_ex_calc)

                        FILTER (
                            (ABS(?sigma_ref1 - ?sigma_ref1_calc) / (?sigma_ref1_calc + 1e-9) > 1e-5) ||
                            (ABS(?F_ex - ?F_ex_calc) / (?F_ex_calc + 1e-9) > 1e-5)
                        )
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasLoadCase" ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:loadCase ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LoadCaseShape> ;
                    sh:path nltl:hasLoadCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureStatus" ;
            sh:resultPath nltl:bladeFailureStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bladeFailureStatus ] ] .

