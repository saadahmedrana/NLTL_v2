@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/ship> ;
            sh:resultMessage "bladeFailureSpindleTorque does not match the calculated value max(C_LE0.8, 0.8 * C_TE0.8) * C_spex * F_ex" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "bladeFailureSpindleTorque does not match the calculated value max(C_LE0.8, 0.8 * C_TE0.8) * C_spex * F_ex" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:leadingEdgeChordPortionAtZeroPointEightRadius/qudt:numericValue ?c_le ;
                      nltl:trailingEdgeChordPortionAtZeroPointEightRadius/qudt:numericValue ?c_te ;
                      nltl:bladeFailureSpindleTorqueFactor/qudt:numericValue ?c_spex ;
                      nltl:extremeIceForce/qudt:numericValue ?f_ex ;
                      nltl:bladeFailureSpindleTorque/qudt:numericValue ?q_sex .
                BIND( IF(?c_le > 0.8 * ?c_te, ?c_le, 0.8 * ?c_te) AS ?max_chord )
                BIND( ?max_chord * ?c_spex * ?f_ex AS ?expected_q_sex )
                FILTER( abs(?q_sex - ?expected_q_sex) > 1e-5 )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape shape:TRF102Shape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/ship> ] .

