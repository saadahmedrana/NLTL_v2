@prefix : <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The ship displacement (upperIceWaterlineDisplacement) must be equal to the greatest waterline case displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The ship displacement (upperIceWaterlineDisplacement) must be equal to the greatest waterline case displacement." ;
                    sh:select """
            PREFIX sh:   <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?shipValue ?maxCaseVal
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiNode .
                ?duiNode qudt:numericValue ?shipValue .
                FILTER(datatype(?shipValue) = xsd:decimal)

                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseNode .
                ?caseNode qudt:numericValue ?caseValue .
                FILTER(datatype(?caseValue) = xsd:decimal)
            }
            GROUP BY $this ?shipValue
            HAVING (?shipValue != MAX(?caseValue))
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape :UpperIceWaterlineDisplacementShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

