[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F04/ship> ;
            sh:resultMessage "Node ex:ship->nltl:bowSubregionCount does not contain a value in the set: ['Literal(\"4\", datatype=xsd:integer)']" ;
