@prefix ex: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Focus node does not conform to shape MaxCount 0: ex:MemberStrengthCheck_QV" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMaxCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasStructuralMember ;
                    sh:qualifiedMaxCount 0 ;
                    sh:qualifiedValueShape ex:MemberStrengthCheck_QV ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Focus node does not conform to shape MaxCount 0: ex:StructuralMemberFrameProfileTypeCheck_QV" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMaxCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasStructuralMember ;
                    sh:qualifiedMaxCount 0 ;
                    sh:qualifiedValueShape ex:StructuralMemberFrameProfileTypeCheck_QV ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-F03/ship> ;
            sh:resultMessage "Focus node does not conform to shape MaxCount 0: ex:BottomPatchOrientationCheck_QV" ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMaxCountConstraintComponent ;
            sh:sourceShape [ sh:path nltl:hasStructuralMember ;
                    sh:qualifiedMaxCount 0 ;
                    sh:qualifiedValueShape ex:BottomPatchOrientationCheck_QV ] ] .

