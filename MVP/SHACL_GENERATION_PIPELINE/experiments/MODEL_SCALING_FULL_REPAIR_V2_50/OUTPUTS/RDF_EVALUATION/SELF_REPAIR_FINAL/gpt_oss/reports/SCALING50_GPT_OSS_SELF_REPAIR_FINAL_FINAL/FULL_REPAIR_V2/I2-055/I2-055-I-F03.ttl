@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/ship> ;
            sh:resultMessage "Strength criterion status must be true." ;
            sh:resultPath nltl:strengthCriterionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:message "Strength criterion status must be true." ;
                    sh:minCount 1 ;
                    sh:path nltl:strengthCriterionStatus ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/ship> ;
            sh:resultMessage "Design stress exceeds permissible stress." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Design stress exceeds permissible stress." ;
                    sh:select """ 
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:designStress ?dQ .
                ?dQ qudt:numericValue ?dVal .
                $this nltl:permissibleStress ?pQ .
                ?pQ qudt:numericValue ?pVal .
                FILTER( ?dVal > ?pVal )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:StrengthCriteriaShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F03/ship> ] .

