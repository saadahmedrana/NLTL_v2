@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F06/ship> ;
            sh:resultMessage "Strength criterion status must be true." ;
            sh:resultPath nltl:strengthCriterionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf13c4bd9d98f4d93964092b3c2681358b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F06/ship> ;
            sh:resultMessage "Strength criterion status must be true." ;
            sh:resultPath nltl:strengthCriterionStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf13c4bd9d98f4d93964092b3c2681358b3 ] .

_:nf13c4bd9d98f4d93964092b3c2681358b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "Strength criterion status must be true." ;
    sh:minCount 1 ;
    sh:path nltl:strengthCriterionStatus .

