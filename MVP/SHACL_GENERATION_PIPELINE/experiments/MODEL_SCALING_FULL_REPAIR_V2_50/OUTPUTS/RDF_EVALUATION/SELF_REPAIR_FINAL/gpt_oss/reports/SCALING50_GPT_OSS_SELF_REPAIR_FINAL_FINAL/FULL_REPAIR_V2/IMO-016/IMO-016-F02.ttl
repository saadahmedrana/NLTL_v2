@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "Polar ship certificate must use the Appendix I model." ;
            sh:resultPath ( nltl:hasPolarShipCertificate nltl:certificateFormModel ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:appendixIPolarShipCertificateModel ;
                    sh:message "Polar ship certificate must use the Appendix I model." ;
                    sh:path ( nltl:hasPolarShipCertificate nltl:certificateFormModel ) ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "Certificate language must be provided." ;
            sh:resultPath nltl:certificateLanguage ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Certificate language must be provided." ;
                    sh:minCount 1 ;
                    sh:path nltl:certificateLanguage ] ] .

