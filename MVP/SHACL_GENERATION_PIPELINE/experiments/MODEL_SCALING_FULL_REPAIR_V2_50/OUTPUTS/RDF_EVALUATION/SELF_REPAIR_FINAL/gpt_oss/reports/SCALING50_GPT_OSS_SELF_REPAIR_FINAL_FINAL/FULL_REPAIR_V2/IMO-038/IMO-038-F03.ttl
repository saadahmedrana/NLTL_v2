@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ;
            sh:resultMessage "verticalDamageExtent must be the lesser of 0.20 × upperIceWaterlineDraught and longitudinalDamageExtent." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "verticalDamageExtent must be the lesser of 0.20 × upperIceWaterlineDraught and longitudinalDamageExtent." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this WHERE {
                $this nltl:upperIceWaterlineDraught ?draughtNode .
                $this nltl:longitudinalDamageExtent ?lonNode .
                $this nltl:verticalDamageExtent ?vertNode .
                ?draughtNode qudt:numericValue ?draughtVal .
                ?lonNode qudt:numericValue ?lonVal .
                ?vertNode qudt:numericValue ?vertVal .
                BIND ( ?draughtVal * 0.20 AS ?limit ) .
                BIND ( IF(?lonVal < ?limit, ?lonVal, ?limit) AS ?expected ) .
                FILTER ( abs(?vertVal - ?expected) > 1e-6 )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F03/ship> ] .

