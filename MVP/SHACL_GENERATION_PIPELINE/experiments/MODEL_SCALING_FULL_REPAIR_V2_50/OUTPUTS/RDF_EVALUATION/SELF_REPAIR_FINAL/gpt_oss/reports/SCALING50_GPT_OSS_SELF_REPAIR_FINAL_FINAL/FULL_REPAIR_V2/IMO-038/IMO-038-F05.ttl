@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F05/ship> ;
            sh:resultMessage "selectedVerticalDamagePosition must lie between the keel (0 m) and 1.20 × upperIceWaterlineDraught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "selectedVerticalDamagePosition must lie between the keel (0 m) and 1.20 × upperIceWaterlineDraught." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this WHERE {
                $this nltl:upperIceWaterlineDraught ?draughtNode .
                $this nltl:selectedVerticalDamagePosition ?posNode .
                ?draughtNode qudt:numericValue ?draughtVal .
                ?posNode qudt:numericValue ?posVal .
                BIND ( ?draughtVal * 1.20 AS ?upper ) .
                FILTER ( ?posVal < 0 || ?posVal > ?upper )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F05/ship> ] .

