@prefix : <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F02/ship> ;
            sh:resultMessage "When personal or group survival equipment is required, available capacity must be at least 110 % of persons on board (rounded up) and storage must be accessible." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "When personal or group survival equipment is required, available capacity must be at least 110 % of persons on board (rounded up) and storage must be accessible." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this nltl:personalOrGroupSurvivalEquipmentRequired ?personal .
                FILTER ( ?personal = true )
                $this nltl:personsOnBoard ?persons .
                $this nltl:availableSurvivalEquipmentCapacity ?available .
                $this nltl:storageAccessibilityStatus ?storage .
                FILTER ( ?available < CEIL(?persons * 1.10) || ?storage != true )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape :IMO-075Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-075-H-F02/ship> ] .

