@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ;
            sh:resultMessage "availableEmergencyRationPerson must be at least personsOnBoard multiplied by maximumExpectedRescueTime." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "availableEmergencyRationPerson must be at least personsOnBoard multiplied by maximumExpectedRescueTime." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:availableEmergencyRationPerson ?avQty .
                ?avQty qudt:numericValue ?avNum .
                $this nltl:maximumExpectedRescueTime ?maxQty .
                ?maxQty qudt:numericValue ?maxNum .
                $this nltl:personsOnBoard ?persons .

                FILTER (?avNum < (?persons * ?maxNum))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:IMO-079 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-079-H-F01/ship> ] .

