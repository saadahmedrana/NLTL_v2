@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F01/ship> ;
            sh:resultMessage "For ships of Polar Category A or B built on or after 2017‑01‑01 that carry NLS requiring a type‑3 tank and have cargo tank type “3”, the administration carriage approval status must be Approved and the polar‑operation certificate entry must be present (true)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For ships of Polar Category A or B built on or after 2017‑01‑01 that carry NLS requiring a type‑3 tank and have cargo tank type “3”, the administration carriage approval status must be Approved and the polar‑operation certificate entry must be present (true)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                $this nltl:shipCategory ?cat .
                FILTER(?cat IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))

                $this nltl:constructionDate ?cdate .
                FILTER(?cdate >= "2017-01-01"^^xsd:date)

                $this nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?cNLS .
                FILTER(?cNLS = true)

                $this nltl:cargoTankType ?cTank .
                FILTER(?cTank = "3"^^xsd:string)

                OPTIONAL { $this nltl:administrationCarriageApprovalStatus ?admStatus . }
                OPTIONAL { $this nltl:applicableCertificatePolarOperationEntryPresent ?certPresent . }

                FILTER( !bound(?admStatus) || ?admStatus != nltl:evidenceStateApproved ||
                        !bound(?certPresent) || ?certPresent != true )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO114Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-F01/ship> ] .

