@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F01/ship> ;
            sh:resultMessage "Ships that do not operate only in continuous daylight must have at least two visual ice‑detection illumination means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Ships that do not operate only in continuous daylight must have at least two visual ice‑detection illumination means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:operatesOnlyInContinuousDaylight ?daylight .
                OPTIONAL { $this nltl:visualIceDetectionIlluminationMeansCount ?cnt . }
                FILTER (
                    ?daylight = "false"^^xsd:boolean &&
                    ( !BOUND(?cnt) || ?cnt < 2 )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:ShipDaylightIlluminationShape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-014-A-F01/ship> ] .

