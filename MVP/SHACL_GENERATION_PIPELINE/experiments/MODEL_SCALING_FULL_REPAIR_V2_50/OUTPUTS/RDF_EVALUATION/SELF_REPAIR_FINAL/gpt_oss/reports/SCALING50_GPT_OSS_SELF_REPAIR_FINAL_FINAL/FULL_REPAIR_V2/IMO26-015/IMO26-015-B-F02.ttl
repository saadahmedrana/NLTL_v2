@prefix : <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ;
            sh:resultMessage "Polar Code Chapter 11 cannot be applicable unless the ship is SOLAS Chapter I certified." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Polar Code Chapter 11 cannot be applicable unless the ship is SOLAS Chapter I certified." ;
                    sh:select """
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?valPolar
            WHERE {
                $this nltl:polarCodeChapter11Applicable ?valPolar .
                FILTER ( ?valPolar = true )
                FILTER NOT EXISTS {
                    $this nltl:solasChapterICertified true .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape :IMO26-015Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-015-B-F02/ship> ] .

