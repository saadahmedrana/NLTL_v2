@prefix g: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ;
            sh:resultMessage "When the construction contract date is on or after 2019‑01‑01 and before 2021‑07‑05, the applicable ice‑class regulation edition must be the 2017 edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the construction contract date is on or after 2019‑01‑01 and before 2021‑07‑05, the applicable ice‑class regulation edition must be the 2017 edition." ;
                    sh:select """
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER ( ?date >= "2019-01-01"^^xsd:date && ?date < "2021-07-05"^^xsd:date )
                OPTIONAL { $this nltl:applicableIceClassRegulationEdition ?edition . }
                FILTER ( !bound(?edition) || ?edition != nltl:iceClassRegulationEdition2017 )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape g:TRF-002_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ] .

