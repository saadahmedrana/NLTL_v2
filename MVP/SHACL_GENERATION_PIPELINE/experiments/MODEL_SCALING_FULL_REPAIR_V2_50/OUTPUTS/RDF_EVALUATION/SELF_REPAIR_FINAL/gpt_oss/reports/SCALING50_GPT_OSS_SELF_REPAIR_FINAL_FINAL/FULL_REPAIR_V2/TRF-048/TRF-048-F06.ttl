@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F06/yieldStrengthValue> ;
                    sh:resultMessage "Node ex:yieldStrengthValue-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F06/longitudinalFrame> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:path <http://qudt.org/schema/qudt/unit> ] ]. See details for more information." ;
            sh:resultPath nltl:yieldStrength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path nltl:yieldStrength ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F06/yieldStrengthValue> ] .

