@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/ship> ;
            sh:resultMessage "Evidence of table lookup selection is required." ;
            sh:resultPath nltl:lookupSelectionEvidence ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:evidenceArtifact ;
                    sh:message "Evidence of table lookup selection is required." ;
                    sh:minCount 1 ;
                    sh:path nltl:lookupSelectionEvidence ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F06/ship> ;
            sh:resultMessage "Table reference must be the controlled individual traficomTable4Dash8." ;
            sh:resultPath nltl:tableReference ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue nltl:traficomTable4Dash8 ;
                    sh:message "Table reference must be the controlled individual traficomTable4Dash8." ;
                    sh:path nltl:tableReference ] ] .

