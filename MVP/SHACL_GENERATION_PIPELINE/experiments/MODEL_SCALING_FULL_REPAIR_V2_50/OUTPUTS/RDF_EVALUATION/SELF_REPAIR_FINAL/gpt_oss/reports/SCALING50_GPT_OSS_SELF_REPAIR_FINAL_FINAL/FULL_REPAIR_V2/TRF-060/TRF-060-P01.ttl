@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-P01/ship> ;
            sh:resultMessage "Gamma factor (from Table 4‑8) must be provided." ;
            sh:resultPath nltl:webFrameTable4Dash8GammaFactor ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Gamma factor (from Table 4‑8) must be provided." ;
                    sh:minCount 1 ;
                    sh:node gen:QuantityValueShape ;
                    sh:path nltl:webFrameTable4Dash8GammaFactor ] ] .

