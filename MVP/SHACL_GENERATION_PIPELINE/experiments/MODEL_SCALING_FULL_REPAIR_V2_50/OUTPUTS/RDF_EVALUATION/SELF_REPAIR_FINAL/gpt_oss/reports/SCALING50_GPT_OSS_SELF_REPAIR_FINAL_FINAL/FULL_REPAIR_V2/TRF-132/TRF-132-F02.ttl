@prefix gen: <urn:nltl:generated-shape:> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a shacl:ValidationReport ;
    shacl:conforms false ;
    shacl:result [ a shacl:ValidationResult ;
            shacl:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F02/ship> ;
            shacl:resultMessage "For ice classes IB and IC, maximum continuous rating power must be at least 740 kW." ;
            shacl:resultSeverity shacl:Violation ;
            shacl:sourceConstraint [ shacl:message "For ice classes IB and IC, maximum continuous rating power must be at least 740 kW." ;
                    shacl:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ic .
                FILTER ( ?ic IN (nltl:iceClassIb, nltl:iceClassIc) )
                $this nltl:maximumContinuousRatingPower ?mcrNode .
                ?mcrNode qudt:numericValue ?mcr .
                FILTER ( ?mcr < 740 )
            }
        """ ] ;
            shacl:sourceConstraintComponent shacl:SPARQLConstraintComponent ;
            shacl:sourceShape gen:TRF-132Shape ;
            shacl:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F02/ship> ] .

