@prefix gen: <urn:nltl:generated-shape:> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a shacl:ValidationReport ;
    shacl:conforms false ;
    shacl:result [ a shacl:ValidationResult ;
            shacl:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ;
            shacl:resultMessage "Maximum continuous rating power must be no less than the calculated engine output P = f1·f2·f3·(f4·Delta + P0)." ;
            shacl:resultSeverity shacl:Violation ;
            shacl:sourceConstraint [ shacl:message "Maximum continuous rating power must be no less than the calculated engine output P = f1·f2·f3·(f4·Delta + P0)." ;
                    shacl:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputFormulaBasePowerP0 ?p0Node .
                ?p0Node qudt:numericValue ?p0 .
                $this nltl:engineOutputFormulaDisplacement ?deltaNode .
                ?deltaNode qudt:numericValue ?delta .
                $this nltl:engineOutputFormulaFactorF1 ?f1Node .
                ?f1Node qudt:numericValue ?f1 .
                $this nltl:engineOutputFormulaFactorF2 ?f2Node .
                ?f2Node qudt:numericValue ?f2 .
                $this nltl:engineOutputFormulaFactorF3 ?f3Node .
                ?f3Node qudt:numericValue ?f3 .
                $this nltl:engineOutputFormulaFactorF4 ?f4Node .
                ?f4Node qudt:numericValue ?f4 .
                $this nltl:maximumContinuousRatingPower ?mcrNode .
                ?mcrNode qudt:numericValue ?mcr .
                BIND( (?f1 * ?f2 * ?f3 * ((?f4 * ?delta) + ?p0)) AS ?calcP )
                FILTER ( ?mcr < ?calcP )
            }
        """ ] ;
            shacl:sourceConstraintComponent shacl:SPARQLConstraintComponent ;
            shacl:sourceShape gen:TRF-132Shape ;
            shacl:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-P04/ship> ] .

