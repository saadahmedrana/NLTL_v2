@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowSubregionCount" ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "selectedMaximumBowLineLoad must be the maximum line load reported for the bow subregions" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "selectedMaximumBowLineLoad must be the maximum line load reported for the bow subregions" ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selected .
                ?selected qudt:numericValue ?selectedValue .
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowSubregionCalculatedLineLoad ?lineLoad .
                ?lineLoad qudt:numericValue ?caseValue .
                FILTER (?caseValue > ?selectedValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:Shape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:LengthQuantityShape ;
                    sh:path nltl:bowLength ] ] .

