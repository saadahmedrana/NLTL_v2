@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage "A ship with a nonlinear calculation case must provide fracture, major-buckling, and yielding margins." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with a nonlinear calculation case must provide fracture, major-buckling, and yielding margins." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS { $this nltl:fractureMargin ?fracture }
                    || NOT EXISTS { $this nltl:majorBucklingMargin ?buckling }
                    || NOT EXISTS { $this nltl:yieldingMargin ?yielding }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_065_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ;
            sh:resultMessage "A ship with a nonlinear calculation case must provide explicit assessments that the analysis reliably captures buckling and plastic deformation of the structure." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A ship with a nonlinear calculation case must provide explicit assessments that the analysis reliably captures buckling and plastic deformation of the structure." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS { $this nltl:bucklingResponse ?bucklingResponse }
                    || NOT EXISTS { $this nltl:plasticDeformation ?plasticDeformation }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_065_ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/calculation> ;
            sh:resultMessage "A nonlinear calculation case must identify the nonlinear method, acceptance evidence, a satisfied permanent-deformation assessment, and the required deformation and structural-dimension inputs." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A nonlinear calculation case must identify the nonlinear method, acceptance evidence, a satisfied permanent-deformation assessment, and the required deformation and structural-dimension inputs." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:nonlinearAnalysisAcceptanceEvidence ?evidence .
                        ?evidence a nltl:evidenceArtifact
                    }
                    || NOT EXISTS {
                        $this nltl:minorPermanentDeformationAssessmentSatisfied true
                    }
                    || NOT EXISTS { $this nltl:permanentLateralDeformation ?lateral }
                    || NOT EXISTS { $this nltl:permanentOutOfPlaneDeformation ?outOfPlane }
                    || NOT EXISTS { $this nltl:relevantStructuralDimension ?dimension }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:I2_065_CalculationCaseShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F04/calculation> ] .

