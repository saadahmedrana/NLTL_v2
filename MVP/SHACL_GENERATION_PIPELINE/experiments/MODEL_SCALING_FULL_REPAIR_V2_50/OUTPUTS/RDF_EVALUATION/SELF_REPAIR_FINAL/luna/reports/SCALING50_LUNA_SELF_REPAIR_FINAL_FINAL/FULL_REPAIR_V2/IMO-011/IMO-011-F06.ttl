@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ;
            sh:resultMessage "When the data period is shorter than 10 years, the administration dataset approval status must be Approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "When the data period is shorter than 10 years, the administration dataset approval status must be Approved." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:dataPeriod ?period .
                ?period qudt:numericValue ?years ;
                        qudt:unit <http://qudt.org/vocab/unit/YR> .
                FILTER (?years < 10)
                FILTER NOT EXISTS {
                    $this nltl:administrationDatasetApprovalStatus
                          nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-011-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ;
            sh:resultMessage "A short data period must not have an administration dataset approval status other than Approved." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A short data period must not have an administration dataset approval status other than Approved." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:dataPeriod ?period ;
                      nltl:administrationDatasetApprovalStatus ?status .
                ?period qudt:numericValue ?years ;
                        qudt:unit <http://qudt.org/vocab/unit/YR> .
                FILTER (?years < 10)
                FILTER (?status != nltl:evidenceStateApproved)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-011-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ] .

