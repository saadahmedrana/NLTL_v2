@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ;
            sh:resultMessage "A permitted reduced line load is valid only for a very long hatch, must be approved by the classification society, and must satisfy 0.10 <= p*h < 0.15 kN/m." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "A permitted reduced line load is valid only for a very long hatch, must be approved by the classification society, and must satisfy 0.10 <= p*h < 0.15 kN/m." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudtunit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:permittedReducedLineLoad ?reducedLoad .

                OPTIONAL {
                    $this nltl:veryLongHatchOpening ?veryLong .
                }
                OPTIONAL {
                    $this nltl:reducedLineLoadApprovedByClassificationSociety ?approved .
                }

                OPTIONAL {
                    ?reducedLoad qudt:numericValue ?reducedValue ;
                                 qudt:unit qudtunit:KiloN-PER-M .
                }

                FILTER (
                    !BOUND(?veryLong) ||
                    ?veryLong != true ||
                    !BOUND(?approved) ||
                    ?approved != true ||
                    !BOUND(?reducedValue) ||
                    ?reducedValue < "0.10"^^xsd:decimal ||
                    ?reducedValue >= "0.15"^^xsd:decimal
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF055NarrowDeckStripShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-P02/narrowDeckStrip> ] .

