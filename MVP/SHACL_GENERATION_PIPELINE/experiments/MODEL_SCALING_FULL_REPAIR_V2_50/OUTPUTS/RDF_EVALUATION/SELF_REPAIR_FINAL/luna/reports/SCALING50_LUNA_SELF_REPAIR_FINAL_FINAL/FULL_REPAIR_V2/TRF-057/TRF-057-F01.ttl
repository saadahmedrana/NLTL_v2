@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "webFrameIceLoad must equal 1.8 times webFrameSpacing times the greater of icePressure multiplied by iceLoadHeight and 0.15 MN/m, with a 1e-6 relative tolerance and a small absolute fallback." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "webFrameIceLoad must equal 1.8 times webFrameSpacing times the greater of icePressure multiplied by iceLoadHeight and 0.15 MN/m, with a 1e-6 relative tolerance and a small absolute fallback." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureNode ;
                      nltl:iceLoadHeight ?heightNode ;
                      nltl:webFrameSpacing ?spacingNode ;
                      nltl:webFrameIceLoad ?loadNode .

                ?pressureNode qudt:numericValue ?pressureValue .
                ?heightNode qudt:numericValue ?heightValue .
                ?spacingNode qudt:numericValue ?spacingValue .
                ?loadNode qudt:numericValue ?loadValue .

                BIND(
                    1800 * ?spacingValue *
                    IF(
                        (?pressureValue * ?heightValue) <
                        "0.15"^^xsd:decimal,
                        "0.15"^^xsd:decimal,
                        (?pressureValue * ?heightValue)
                    )
                    AS ?expectedLoad
                )

                FILTER(
                    ABS(?loadValue - ?expectedLoad) >
                    (
                        (ABS(?expectedLoad) * "0.000001"^^xsd:decimal) +
                        "0.000001"^^xsd:decimal
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gs:TRF_057_WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

