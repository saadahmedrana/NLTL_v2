@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ;
                    sh:resultMessage "The assessment must provide the externally assessed factored extreme load in kN." ;
                    sh:resultPath nltl:assessedFactoredExtremeLoad ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The assessment must provide the externally assessed factored extreme load in kN." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ] ;
                            sh:path nltl:assessedFactoredExtremeLoad ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/component> ;
                            sh:resultMessage "Less than 1 values on ex:component->nltl:hasMaterialProperties" ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ sh:class nltl:materialProperties ;
                                            sh:property [ sh:message "Component material yield strength in MPa is required." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:class qudt:QuantityValue ;
                                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                                    sh:maxCount 1 ;
                                                                    sh:minCount 1 ;
                                                                    sh:path qudt:unit ],
                                                                [ sh:datatype xsd:decimal ;
                                                                    sh:maxCount 1 ;
                                                                    sh:minCount 1 ;
                                                                    sh:path qudt:numericValue ] ] ;
                                                    sh:path nltl:componentMaterialYieldStrength ] ] ;
                                    sh:path nltl:hasMaterialProperties ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ;
                    sh:resultMessage "The assessment must identify its assessed thruster component." ;
                    sh:resultPath nltl:assessedThrusterComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The assessment must identify its assessed thruster component." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class nltl:shipComponent ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:class nltl:materialProperties ;
                                                    sh:property [ sh:message "Component material yield strength in MPa is required." ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path nltl:componentMaterialYieldStrength ] ] ;
                                            sh:path nltl:hasMaterialProperties ] ] ;
                            sh:path nltl:assessedThrusterComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/ship> ;
            sh:resultMessage "Each factored-load operability assessment must include its paired component, factored load, and residual operability checks." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each factored-load operability assessment must include its paired component, factored load, and residual operability checks." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The assessment must confirm that operability is maintained." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentOperabilityMaintained ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "The assessment must confirm that no repair is required." ;
                                    sh:minCount 1 ;
                                    sh:path nltl:assessmentRepairRequired ],
                                [ sh:message "The assessment must provide the externally assessed factored extreme load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:path nltl:assessedFactoredExtremeLoad ],
                                [ sh:message "The assessment must identify its assessed thruster component." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class nltl:shipComponent ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path nltl:hasMaterialProperties ] ] ;
                                    sh:path nltl:assessedThrusterComponent ] ] ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F02/assessment> ] .

