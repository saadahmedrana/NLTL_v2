@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ;
            sh:resultMessage "The maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0)." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The maximum continuous rating power must be at least f1*f2*f3*(f4*Delta + P0)." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputFormulaBasePowerP0 ?p0q ;
                    nltl:engineOutputFormulaDisplacement ?deltaq ;
                    nltl:engineOutputFormulaFactorF1 ?f1q ;
                    nltl:engineOutputFormulaFactorF2 ?f2q ;
                    nltl:engineOutputFormulaFactorF3 ?f3q ;
                    nltl:engineOutputFormulaFactorF4 ?f4q ;
                    nltl:maximumContinuousRatingPower ?outq .
                ?p0q qudt:numericValue ?p0 .
                ?deltaq qudt:numericValue ?delta .
                ?f1q qudt:numericValue ?f1 .
                ?f2q qudt:numericValue ?f2 .
                ?f3q qudt:numericValue ?f3 .
                ?f4q qudt:numericValue ?f4 .
                ?outq qudt:numericValue ?out .
                BIND (?f1 * ?f2 * ?f3 * (?f4 * ?delta + ?p0) AS ?expected)
                FILTER (?out < ?expected)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-132-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F01/ship> ] .

