@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F02/ship> ;
            sh:resultMessage "For ice classes IB and IC, the maximum continuous rating power must be at least 740 kW." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For ice classes IB and IC, the maximum continuous rating power must be at least 740 kW." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                    nltl:maximumContinuousRatingPower ?outq .
                ?outq qudt:numericValue ?out .
                FILTER (
                    (?ice = nltl:iceClassIb || ?ice = nltl:iceClassIc)
                    && ?out < 740
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-132-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-132-F02/ship> ] .

