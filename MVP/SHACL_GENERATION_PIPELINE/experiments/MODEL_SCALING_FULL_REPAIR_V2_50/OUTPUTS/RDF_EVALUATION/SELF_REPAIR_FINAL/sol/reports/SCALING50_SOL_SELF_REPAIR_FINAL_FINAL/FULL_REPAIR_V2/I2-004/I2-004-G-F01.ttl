@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement shall equal the greatest linked waterline-case displacement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline displacement shall equal the greatest linked waterline-case displacement." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:upperIceWaterlineDisplacement ?duiQuantity .
    ?duiQuantity qudt:numericValue ?duiValue ;
        qudt:unit unit:KiloTON_Metric .
    FILTER (
        NOT EXISTS {
            $this nltl:hasUpperIceWaterlineCase ?matchingCase .
            ?matchingCase nltl:waterlineCaseDisplacement ?matchingQuantity .
            ?matchingQuantity qudt:numericValue ?matchingValue ;
                qudt:unit unit:KiloTON_Metric .
            FILTER (xsd:decimal(?matchingValue) = xsd:decimal(?duiValue))
        }
        ||
        EXISTS {
            $this nltl:hasUpperIceWaterlineCase ?greaterCase .
            ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
            ?greaterQuantity qudt:numericValue ?greaterValue ;
                qudt:unit unit:KiloTON_Metric .
            FILTER (xsd:decimal(?greaterValue) > xsd:decimal(?duiValue))
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:UpperIceWaterlineDisplacementShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

