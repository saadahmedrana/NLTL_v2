@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ;
                    sh:resultMessage "The displacement shall use metric kilotonnes." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue unit:KiloTON_Metric ;
                            sh:maxCount 1 ;
                            sh:message "The displacement shall use metric kilotonnes." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "The ship shall have one upper ice waterline displacement." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall have one upper ice waterline displacement." ;
                    sh:minCount 1 ;
                    sh:node gen:DisplacementQuantityShape ;
                    sh:path nltl:upperIceWaterlineDisplacement ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ] .

