@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Average ice pressure is required." ;
            sh:resultPath nltl:averageIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Average ice pressure is required." ;
                    sh:minCount 1 ;
                    sh:node gen:MegaPascalQuantityShape ;
                    sh:path nltl:averageIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Total glancing impact force is required." ;
            sh:resultPath nltl:totalGlancingImpactForce ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Total glancing impact force is required." ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonQuantityShape ;
                    sh:path nltl:totalGlancingImpactForce ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "A bow subregion calculation case is required." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:message "A bow subregion calculation case is required." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_008_BowSubregionCalculationCaseShape ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Local ice pressure is required." ;
            sh:resultPath nltl:localIcePressure ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Local ice pressure is required." ;
                    sh:minCount 1 ;
                    sh:node gen:MegaPascalQuantityShape ;
                    sh:path nltl:localIcePressure ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Shape coefficient is required." ;
            sh:resultPath nltl:shapeCoefficient ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Shape coefficient is required." ;
                    sh:minCount 1 ;
                    sh:node gen:UnitlessQuantityShape ;
                    sh:path nltl:shapeCoefficient ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Line load is required." ;
            sh:resultPath nltl:lineLoad ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Line load is required." ;
                    sh:minCount 1 ;
                    sh:node gen:KiloNewtonPerMetreQuantityShape ;
                    sh:path nltl:lineLoad ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Load patch height is required." ;
            sh:resultPath nltl:loadPatchHeight ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Load patch height is required." ;
                    sh:minCount 1 ;
                    sh:node gen:MetreQuantityShape ;
                    sh:path nltl:loadPatchHeight ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F06/ship> ;
            sh:resultMessage "Load patch length is required." ;
            sh:resultPath nltl:loadPatchLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Load patch length is required." ;
                    sh:minCount 1 ;
                    sh:node gen:MetreQuantityShape ;
                    sh:path nltl:loadPatchLength ] ] .

