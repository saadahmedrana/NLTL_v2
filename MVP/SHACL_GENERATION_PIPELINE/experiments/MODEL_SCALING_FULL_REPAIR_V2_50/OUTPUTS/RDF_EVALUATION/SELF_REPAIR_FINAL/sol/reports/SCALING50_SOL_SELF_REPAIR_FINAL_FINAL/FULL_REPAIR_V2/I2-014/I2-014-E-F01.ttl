@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bowLength" ;
            sh:resultPath nltl:bowLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gs:BowLengthQuantityShape ;
                    sh:path nltl:bowLength ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "The bow region must be represented as four subregions." ;
            sh:resultPath nltl:bowSubregionCount ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:maxInclusive 4 ;
                    sh:message "The bow region must be represented as four subregions." ;
                    sh:minCount 1 ;
                    sh:minInclusive 4 ;
                    sh:path nltl:bowSubregionCount ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-014-E-F01/ship> ;
            sh:resultMessage "Exactly four bow subregion calculation cases are required." ;
            sh:resultPath nltl:hasBowSubregionCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:bowSubregionCalculationCase ;
                    sh:maxCount 4 ;
                    sh:message "Exactly four bow subregion calculation cases are required." ;
                    sh:minCount 4 ;
                    sh:node gs:BowSubregionCalculationCaseShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasBowSubregionCalculationCase ] ] .

