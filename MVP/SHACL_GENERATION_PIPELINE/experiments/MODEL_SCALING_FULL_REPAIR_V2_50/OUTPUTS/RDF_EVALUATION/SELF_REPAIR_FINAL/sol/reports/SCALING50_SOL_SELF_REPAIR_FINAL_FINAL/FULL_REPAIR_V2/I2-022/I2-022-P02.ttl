@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/plating> ;
                    sh:resultMessage "Plating with a framing angle of at least 70 degrees must provide all declared calculation inputs and the externally computed result." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape gs:I2-022PlatingShape ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/ship> ;
            sh:resultMessage "The ship must identify plating governed by the shell plate requirement." ;
            sh:resultPath nltl:hasPlating ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:plating ;
                    sh:message "The ship must identify plating governed by the shell plate requirement." ;
                    sh:minCount 1 ;
                    sh:node gs:I2-022PlatingShape ;
                    sh:path nltl:hasPlating ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-P02/plating> ] .

