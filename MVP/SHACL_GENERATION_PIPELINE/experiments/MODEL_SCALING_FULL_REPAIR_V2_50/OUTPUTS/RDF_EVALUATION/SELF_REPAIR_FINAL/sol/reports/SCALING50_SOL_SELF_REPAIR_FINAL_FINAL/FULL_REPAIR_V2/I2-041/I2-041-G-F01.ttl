@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F01/member> ;
                    sh:resultMessage "The structural member must provide net attached shell-plate thickness in millimetres." ;
                    sh:resultPath nltl:netAttachedShellPlateThickness ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The structural member must provide net attached shell-plate thickness in millimetres." ;
                            sh:minCount 1 ;
                            sh:node gen:I2_041_MillimetreQuantityShape ;
                            sh:path nltl:netAttachedShellPlateThickness ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F01/ship> ;
            sh:resultMessage "Each linked structural member must provide the required thickness and yield-strength readiness data." ;
            sh:resultPath nltl:hasStructuralMember ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each linked structural member must provide the required thickness and yield-strength readiness data." ;
                    sh:minCount 1 ;
                    sh:node gen:I2_041_StructuralMemberShape ;
                    sh:path nltl:hasStructuralMember ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-041-F01/member> ] .

