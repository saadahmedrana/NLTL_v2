@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F03/ship> ;
            sh:resultMessage "Focus node does not conform to shape MinCount 1: gs:I2_051_CalculationCaseShape" ;
            sh:resultPath nltl:hasCalculationCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node gs:I2_051_ConditionalCalculationCaseShape ;
                    sh:path nltl:hasCalculationCase ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape gs:I2_051_CalculationCaseShape ] ] .

