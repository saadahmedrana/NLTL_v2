@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F05/ship> ;
            sh:resultMessage "Permissible stress is required in MPa." ;
            sh:resultPath nltl:permissibleStress ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "Permissible stress is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node gs:StressQuantityValueShape ;
                    sh:path nltl:permissibleStress ] ] .

