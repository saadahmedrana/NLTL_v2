@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ;
            sh:resultMessage "A unitless yielding margin is required for the nonlinear analysis." ;
            sh:resultPath nltl:yieldingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A unitless yielding margin is required for the nonlinear analysis." ;
                    sh:minCount 1 ;
                    sh:node gen:UnitlessDecimalQuantityShape ;
                    sh:path nltl:yieldingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ;
            sh:resultMessage "A unitless major buckling margin is required for the nonlinear analysis." ;
            sh:resultPath nltl:majorBucklingMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A unitless major buckling margin is required for the nonlinear analysis." ;
                    sh:minCount 1 ;
                    sh:node gen:UnitlessDecimalQuantityShape ;
                    sh:path nltl:majorBucklingMargin ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-P01/ship> ;
            sh:resultMessage "A unitless fracture margin is required for the nonlinear analysis." ;
            sh:resultPath nltl:fractureMargin ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "A unitless fracture margin is required for the nonlinear analysis." ;
                    sh:minCount 1 ;
                    sh:node gen:UnitlessDecimalQuantityShape ;
                    sh:path nltl:fractureMargin ] ] .

