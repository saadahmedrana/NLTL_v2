@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ;
            sh:resultMessage "Node ex:ship must conform to one or more shapes in [ sh:property [ sh:node [ sh:property [ sh:minInclusive Literal(\"10.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:dataPeriod ] ] , [ sh:property [ sh:in ( nltl:evidenceStateApproved ) ; sh:message Literal(\"A data period shorter than 10 years requires Administration approval of the dataset.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:administrationDatasetApprovalStatus ], [ sh:node [ sh:property [ sh:maxExclusive Literal(\"10.0\", datatype=xsd:decimal) ; sh:path qudt:numericValue ] ] ; sh:path nltl:dataPeriod ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_011_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F06/ship> ] .

