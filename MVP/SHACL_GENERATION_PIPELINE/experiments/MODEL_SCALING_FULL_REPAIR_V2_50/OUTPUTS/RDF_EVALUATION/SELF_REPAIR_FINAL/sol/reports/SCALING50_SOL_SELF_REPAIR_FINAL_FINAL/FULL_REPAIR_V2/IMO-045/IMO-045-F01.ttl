@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F01/ship> ;
            sh:resultMessage "A machinery seawater supply must prevent ice ingestion or have an approved alternate functionality arrangement." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:IMO_045_Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F01/ship> ] .

