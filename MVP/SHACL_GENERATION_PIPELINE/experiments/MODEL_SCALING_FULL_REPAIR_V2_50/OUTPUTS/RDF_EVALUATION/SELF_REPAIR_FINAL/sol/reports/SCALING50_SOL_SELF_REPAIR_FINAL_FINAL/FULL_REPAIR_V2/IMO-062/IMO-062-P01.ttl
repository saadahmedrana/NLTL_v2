@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ;
                    sh:resultMessage "Each exposed escape route must have accessible status true." ;
                    sh:resultPath nltl:escapeRouteAccessibleStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed escape route must have accessible status true." ;
                            sh:minCount 1 ;
                            sh:path nltl:escapeRouteAccessibleStatus ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ;
                    sh:resultMessage "Each exposed escape route must have safe status true." ;
                    sh:resultPath nltl:escapeRouteSafeStatus ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "Each exposed escape route must have safe status true." ;
                            sh:minCount 1 ;
                            sh:path nltl:escapeRouteSafeStatus ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/ship> ;
            sh:resultMessage "Value does not conform to Shape gen:IMO062ExposedEscapeRouteShape. See details for more information." ;
            sh:resultPath nltl:hasExposedEscapeRoute ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:exposedEscapeRoute ;
                    sh:node gen:IMO062ExposedEscapeRouteShape ;
                    sh:path nltl:hasExposedEscapeRoute ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P01/route1> ] .

