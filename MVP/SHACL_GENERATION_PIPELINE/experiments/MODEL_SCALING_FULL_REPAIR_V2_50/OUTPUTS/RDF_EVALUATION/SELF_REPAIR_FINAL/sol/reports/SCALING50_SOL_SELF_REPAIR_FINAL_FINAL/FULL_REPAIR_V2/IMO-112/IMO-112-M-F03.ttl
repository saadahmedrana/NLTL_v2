@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F03/ship> ;
            sh:resultMessage "In Arctic waters, the NLS or NLS-mixture discharge-to-sea state must be present and false." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "In Arctic waters, the NLS or NLS-mixture discharge-to-sea state must be present and false." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:operatingArea ?operatingArea ;
          nltl:arcticWaters ?arcticWaters .
    FILTER (?operatingArea = ?arcticWaters)
    FILTER (
        NOT EXISTS {
            $this nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ?discharge .
        }
        ||
        EXISTS {
            $this nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ?discharge .
            FILTER (?discharge != false)
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:IMO112Shape ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-112-M-F03/ship> ] .

