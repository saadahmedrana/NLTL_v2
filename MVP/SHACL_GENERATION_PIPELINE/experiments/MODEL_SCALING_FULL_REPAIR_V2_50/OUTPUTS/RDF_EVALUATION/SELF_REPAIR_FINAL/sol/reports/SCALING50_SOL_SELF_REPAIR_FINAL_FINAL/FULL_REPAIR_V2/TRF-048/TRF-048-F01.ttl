@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:bracketArea" ;
            sh:resultPath nltl:bracketArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:SquareCentimetreQuantityShape ;
                    sh:path nltl:bracketArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "For a continuous beam with brackets without significantly different boundary conditions, frameMomentFactorM must equal 13.3." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a continuous beam with brackets without significantly different boundary conditions, frameMomentFactorM must equal 13.3." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType nltl:continuousBeamWithBracketsFrameCondition ;
                      nltl:significantlyDifferentBoundaryConditions false ;
                      nltl:frameMomentFactorM ?mQuantity .
                ?mQuantity qudt:numericValue ?m .
                FILTER (?m < 13.3 || ?m > 13.3)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:actualFrameShearArea" ;
            sh:resultPath nltl:actualFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:SquareCentimetreQuantityShape ;
                    sh:path nltl:actualFrameShearArea ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F01/longitudinalFrame> ;
            sh:resultMessage "Less than 1 values on ex:longitudinalFrame->nltl:grossFrameShearArea" ;
            sh:resultPath nltl:grossFrameShearArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node gen:SquareCentimetreQuantityShape ;
                    sh:path nltl:grossFrameShearArea ] ] .

