@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ;
            sh:resultMessage "Actual frame shear area must exclude bracket area and equal gross frame shear area minus bracket area." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Actual frame shear area must exclude bracket area and equal gross frame shear area minus bracket area." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea ?grossQuantity ;
                      nltl:bracketArea ?bracketQuantity ;
                      nltl:actualFrameShearArea ?actualQuantity .

                ?grossQuantity qudt:numericValue ?gross .
                ?bracketQuantity qudt:numericValue ?bracket .
                ?actualQuantity qudt:numericValue ?actual .

                FILTER (?actual != (?gross - ?bracket))
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF048LongitudinalFrameShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F07/longitudinalFrame> ] .

