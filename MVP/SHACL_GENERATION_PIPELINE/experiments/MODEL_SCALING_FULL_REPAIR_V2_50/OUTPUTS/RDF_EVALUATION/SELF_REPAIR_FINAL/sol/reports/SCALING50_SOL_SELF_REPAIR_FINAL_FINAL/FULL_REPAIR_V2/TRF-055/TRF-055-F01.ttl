@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F01/narrowDeckStrip> ;
            sh:resultMessage """Node ex:narrowDeckStrip must conform to one or more shapes in [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:abreastOfHatch ] ] [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:servesAsIceStringer ] ] ) ] , [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:message Literal("A reduced line load exception is permitted only for a very long hatch opening.") ; sh:path nltl:permittedReducedLineLoad ] ] [ sh:or ( [ sh:property [ sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:maxCount Literal("0", datatype=xsd:integer) ; sh:message Literal("A reduced line load may not be recorded without classification-society approval.") ; sh:path nltl:permittedReducedLineLoad ] ] [ sh:property [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:message Literal("An approved very-long-hatch exception requires a permitted reduced line load.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:ReducedLineLoadQuantityShape ; sh:path nltl:permittedReducedLineLoad ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Classification-society approval status for the reduced line load must be stated.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:reducedLineLoadApprovedByClassificationSociety ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:veryLongHatchOpening ] ] ) ; sh:property [ sh:datatype xsd:boolean ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Whether the applicable hatch opening is very long must be stated.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path nltl:veryLongHatchOpening ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:abreastOfHatch ], [ sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:path nltl:servesAsIceStringer ], [ sh:message Literal("A required section modulus is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:SectionModulusQuantityShape ; sh:path nltl:requiredSectionModulus ], [ sh:message Literal("A required shear area is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:ShearAreaQuantityShape ; sh:path nltl:requiredShearArea ], [ sh:message Literal("An actual section modulus is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:SectionModulusQuantityShape ; sh:path nltl:actualSectionModulus ], [ sh:message Literal("An actual shear area is required.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node gen:ShearAreaQuantityShape ; sh:path nltl:actualShearArea ] ; sh:sparql [ rdf:type sh:SPARQLConstraint ; sh:message Literal("The actual section modulus and shear area must not be less than their respective required values.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:actualSectionModulus ?actualSectionNode ;
           nltl:requiredSectionModulus ?requiredSectionNode ;
           nltl:actualShearArea ?actualAreaNode ;
           nltl:requiredShearArea ?requiredAreaNode .
    ?actualSectionNode qudt:numericValue ?actualSection .
    ?requiredSectionNode qudt:numericValue ?requiredSection .
    ?actualAreaNode qudt:numericValue ?actualArea .
    ?requiredAreaNode qudt:numericValue ?requiredArea .
    FILTER (
        ?actualSection < ?requiredSection ||
        ?actualArea < ?requiredArea
    )
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape gen:NarrowDeckStripComplianceShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F01/narrowDeckStrip> ] .

