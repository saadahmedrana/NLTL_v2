@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ;
            sh:resultMessage "Web-frame ice load must equal 1.8 times the greater of p*h and 0.15 MN/m, times web-frame spacing." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Web-frame ice load must equal 1.8 times the greater of p*h and 0.15 MN/m, times web-frame spacing." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceLoadHeight ?heightQuantity ;
                      nltl:webFrameSpacing ?spacingQuantity ;
                      nltl:webFrameIceLoad ?loadQuantity .
                ?pressureQuantity qudt:numericValue ?pressure .
                ?heightQuantity qudt:numericValue ?height .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?loadQuantity qudt:numericValue ?reportedLoad .
                BIND((xsd:decimal(?pressure) * xsd:decimal(?height)) AS ?pressureHeight)
                BIND(
                    IF(
                        ?pressureHeight < "0.15"^^xsd:decimal,
                        "0.15"^^xsd:decimal,
                        ?pressureHeight
                    ) AS ?effectiveLineLoad
                )
                BIND(
                    ("1800"^^xsd:decimal * ?effectiveLineLoad * xsd:decimal(?spacing))
                    AS ?expectedLoad
                )
                FILTER (xsd:decimal(?reportedLoad) != ?expectedLoad)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF057WebFrameIceLoadShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-F01/webFrame> ] .

