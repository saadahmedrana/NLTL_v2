@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F02/ship> ;
            sh:resultMessage "Maximum ice-load bending moment is required." ;
            sh:resultPath nltl:webFrameMaximumIceLoadBendingMoment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Maximum ice-load bending moment is required." ;
                    sh:minCount 1 ;
                    sh:node gs:MegaNMQuantityShape ;
                    sh:path nltl:webFrameMaximumIceLoadBendingMoment ] ] .

