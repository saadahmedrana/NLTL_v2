@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "At least one blade-failure load case must apply the load at radius ratio 0.8 in the weakest blade direction." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape _:ne196558ceb9e4eec9459cf07174c4babb12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "At least one blade-failure load case must apply the load at radius ratio 0.8 in the weakest blade direction." ;
            sh:resultPath nltl:hasLoadCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne196558ceb9e4eec9459cf07174c4babb12 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Without an approved nonlinear analysis, blade reference strength and ultimate load must satisfy the prescribed formulas; the load denominator must be nonzero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Without an approved nonlinear analysis, blade reference strength and ultimate load must satisfy the prescribed formulas; the load denominator must be nonzero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:approvedNonlinearBladeStressAnalysis ?analysis .
                    ?analysis a nltl:approvalRecord .
                }

                $this nltl:bladeChordLengthAtWeakestSection ?chordQuantity ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?thicknessQuantity ;
                      nltl:bladeCylindricalRootRadius ?rootRadiusQuantity ;
                      nltl:bladeMinimumYieldStrength ?yieldQuantity ;
                      nltl:bladeUltimateTensileStrength ?ultimateStrengthQuantity ;
                      nltl:bladeReferenceStrength1 ?referenceStrengthQuantity ;
                      nltl:bladeFailureUltimateLoad ?failureLoadQuantity ;
                      nltl:propellerDiameter ?diameterQuantity .

                ?chordQuantity qudt:numericValue ?chord .
                ?thicknessQuantity qudt:numericValue ?thickness .
                ?rootRadiusQuantity qudt:numericValue ?rootRadius .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?ultimateStrengthQuantity qudt:numericValue ?ultimateStrength .
                ?referenceStrengthQuantity qudt:numericValue ?reportedReferenceStrength .
                ?failureLoadQuantity qudt:numericValue ?reportedFailureLoad .
                ?diameterQuantity qudt:numericValue ?diameter .

                BIND((0.6 * ?yieldStrength + 0.4 * ?ultimateStrength) AS ?expectedReferenceStrength)
                BIND((0.8 * ?diameter - 2.0 * ?rootRadius) AS ?denominator)
                BIND(
                    IF(
                        ?denominator != 0,
                        300.0 * ?chord * ?thickness * ?thickness * ?expectedReferenceStrength / ?denominator,
                        0.0
                    )
                    AS ?expectedFailureLoad
                )

                FILTER (
                    ?denominator = 0 ||
                    ?reportedReferenceStrength != ?expectedReferenceStrength ||
                    (
                        ?denominator != 0 &&
                        ?reportedFailureLoad != ?expectedFailureLoad
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape gen:TRF101BladeFailureShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:bladeFailureStatus" ;
            sh:resultPath nltl:bladeFailureStatus ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path nltl:bladeFailureStatus ] ] .

_:ne196558ceb9e4eec9459cf07174c4babb12 sh:message "At least one blade-failure load case must apply the load at radius ratio 0.8 in the weakest blade direction." ;
    sh:minCount 1 ;
    sh:path nltl:hasLoadCase ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape gen:LoadCaseShape .

