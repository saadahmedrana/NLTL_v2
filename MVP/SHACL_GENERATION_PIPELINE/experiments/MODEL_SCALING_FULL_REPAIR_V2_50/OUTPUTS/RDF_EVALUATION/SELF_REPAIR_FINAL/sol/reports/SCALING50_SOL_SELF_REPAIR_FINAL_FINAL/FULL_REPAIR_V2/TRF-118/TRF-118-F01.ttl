@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must confirm that operability is maintained." ;
                    sh:resultPath nltl:assessmentOperabilityMaintained ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The assessment must confirm that operability is maintained." ;
                            sh:minCount 1 ;
                            sh:path nltl:assessmentOperabilityMaintained ] ;
                    sh:value false ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessment must confirm that repair is not required." ;
                    sh:resultPath nltl:assessmentRepairRequired ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( false ) ;
                            sh:message "The assessment must confirm that repair is not required." ;
                            sh:minCount 1 ;
                            sh:path nltl:assessmentRepairRequired ] ;
                    sh:value true ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/component> ;
                            sh:resultMessage "Material properties are required for each assessed thruster component." ;
                            sh:resultPath nltl:hasMaterialProperties ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class nltl:materialProperties ;
                                    sh:message "Material properties are required for each assessed thruster component." ;
                                    sh:minCount 1 ;
                                    sh:node gs:MaterialPropertiesShape ;
                                    sh:path nltl:hasMaterialProperties ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ;
                    sh:resultMessage "The assessed thruster component is required." ;
                    sh:resultPath nltl:assessedThrusterComponent ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class nltl:shipComponent ;
                            sh:message "The assessed thruster component is required." ;
                            sh:minCount 1 ;
                            sh:node gs:AssessedThrusterComponentShape ;
                            sh:path nltl:assessedThrusterComponent ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/ship> ;
            sh:resultMessage "A factored extreme-load operability assessment is required." ;
            sh:resultPath nltl:hasFactoredExtremeLoadOperabilityAssessment ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
                    sh:message "A factored extreme-load operability assessment is required." ;
                    sh:minCount 1 ;
                    sh:node gs:FactoredExtremeLoadOperabilityAssessmentShape ;
                    sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-F01/assessment> ] .

