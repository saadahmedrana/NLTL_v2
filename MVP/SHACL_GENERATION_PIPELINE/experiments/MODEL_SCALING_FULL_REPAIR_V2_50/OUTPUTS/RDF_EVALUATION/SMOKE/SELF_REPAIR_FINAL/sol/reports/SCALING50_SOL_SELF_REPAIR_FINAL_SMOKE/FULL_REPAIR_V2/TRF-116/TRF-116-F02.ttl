@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-116-F02/ship> ;
            sh:resultMessage "Non-hemispherical impact contact area is required as a decimal quantity in square metres." ;
            sh:resultPath nltl:nonHemisphericalImpactContactArea ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "Non-hemispherical impact contact area is required as a decimal quantity in square metres." ;
                    sh:minCount 1 ;
                    sh:node gen:AreaQuantityValueShape ;
                    sh:path nltl:nonHemisphericalImpactContactArea ] ] .

