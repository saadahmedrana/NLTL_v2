@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:nltl:generated-shape:> .

:IMO-069 a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # presence and datatype of the trigger property (optional)
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    # datatype of the dependent property (presence enforced by SPARQL)
    sh:property [
        sh:path nltl:devicePowerSourceIndependentOfMainPower ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    # conditional rule: if power is required then independence must be true
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If an added life\u2011saving device requires power, its power source must be independent of the ship's main power." ;
        sh:select """ 
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:addedLifeSavingDeviceRequiresPower true .
                FILTER NOT EXISTS { $this nltl:devicePowerSourceIndependentOfMainPower true . }
            }"""
    ] .
