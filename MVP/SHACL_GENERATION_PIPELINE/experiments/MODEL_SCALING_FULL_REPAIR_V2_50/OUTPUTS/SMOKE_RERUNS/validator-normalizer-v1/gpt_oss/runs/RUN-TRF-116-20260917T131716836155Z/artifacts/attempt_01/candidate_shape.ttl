@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .

<urn:nltl:generated-shape:TRF-116Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    ## Operand: non‑hemispherical impact contact area (A)
    sh:property [
        sh:path nltl:nonHemisphericalImpactContactArea ;
        sh:minCount 1 ;
        sh:message "Non‑hemispherical impact contact area (A) must be provided." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "Numeric value for impact contact area is required."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                sh:minCount 1 ;
                sh:message "Unit for impact contact area must be square metres (m²)."
            ]
        ]
    ] ;

    ## Operand: design ice thickness (H_iced)
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:message "Design ice thickness (H_iced) must be provided." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "Numeric value for design ice thickness is required."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:message "Unit for design ice thickness must be metres (m)."
            ]
        ]
    ] ;

    ## Operand: propeller‑hub or thruster‑end‑cap impact flag
    sh:property [
        sh:path nltl:propellerHubOrThrusterEndCapImpact ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Flag indicating propeller‑hub or thruster‑end‑cap impact must be provided."
    ] ;

    ## Result: equivalent impact sphere radius (R_ceq)
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:minCount 1 ;
        sh:message "Equivalent impact sphere radius must be supplied (result of the formula)." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "Numeric value for equivalent impact sphere radius is required."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:message "Unit for equivalent impact sphere radius must be metres (m)."
            ]
        ]
    ] .
