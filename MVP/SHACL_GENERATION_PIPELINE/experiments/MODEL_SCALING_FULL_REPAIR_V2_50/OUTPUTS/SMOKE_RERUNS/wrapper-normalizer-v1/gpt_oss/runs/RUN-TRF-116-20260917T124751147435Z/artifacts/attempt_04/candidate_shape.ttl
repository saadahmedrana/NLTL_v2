@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:nltl:generated-shape:> .

:TRF-116Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    # designIceThickness – numeric value in metres
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;

    # nonHemisphericalImpactContactArea – numeric value in square metres
    sh:property [
        sh:path nltl:nonHemisphericalImpactContactArea ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;

    # propellerHubOrThrusterEndCapImpact – Boolean flag
    sh:property [
        sh:path nltl:propellerHubOrThrusterEndCapImpact ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;

    # equivalentImpactSphereRadius – numeric value in metres
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] .
