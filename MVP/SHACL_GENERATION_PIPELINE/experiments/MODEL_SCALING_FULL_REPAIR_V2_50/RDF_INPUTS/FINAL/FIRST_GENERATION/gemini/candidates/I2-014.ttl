@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue 4 ;
        sh:message "The bow region must be divided into exactly 4 subregions."
    ] ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node <urn:nltl:generated-shape:BowSubregionShape> ;
        sh:message "Each ship must have exactly 4 bow subregion calculation cases."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The mid-length positions of the 4 subregions must correspond to 0.125, 0.375, 0.625, and 0.875 of the bow length (LBOW)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength/qudt:numericValue ?L_bow .
                {
                    SELECT $this (COUNT(?case) AS ?count125)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                        $this nltl:bowLength/qudt:numericValue ?L .
                        FILTER (ABS(?mid / ?L - 0.125) < 1e-4)
                    }
                    GROUP BY $this
                }
                {
                    SELECT $this (COUNT(?case) AS ?count375)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                        $this nltl:bowLength/qudt:numericValue ?L .
                        FILTER (ABS(?mid / ?L - 0.375) < 1e-4)
                    }
                    GROUP BY $this
                }
                {
                    SELECT $this (COUNT(?case) AS ?count625)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                        $this nltl:bowLength/qudt:numericValue ?L .
                        FILTER (ABS(?mid / ?L - 0.625) < 1e-4)
                    }
                    GROUP BY $this
                }
                {
                    SELECT $this (COUNT(?case) AS ?count875)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?mid .
                        $this nltl:bowLength/qudt:numericValue ?L .
                        FILTER (ABS(?mid / ?L - 0.875) < 1e-4)
                    }
                    GROUP BY $this
                }
                FILTER (?count125 != 1 || ?count375 != 1 || ?count625 != 1 || ?count875 != 1)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow force (selectedMaximumBowForce) must equal the maximum of the calculated forces across all subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (MAX(?force_val) AS ?max_force)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase/nltl:bowSubregionCalculatedForce/qudt:numericValue ?force_val .
                    }
                    GROUP BY $this
                }
                $this nltl:selectedMaximumBowForce/qudt:numericValue ?reported_max_force .
                FILTER (ABS(?reported_max_force - ?max_force) > 1e-6)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow line load (selectedMaximumBowLineLoad) must equal the maximum of the calculated line loads across all subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (MAX(?ll_val) AS ?max_ll)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase/nltl:bowSubregionCalculatedLineLoad/qudt:numericValue ?ll_val .
                    }
                    GROUP BY $this
                }
                $this nltl:selectedMaximumBowLineLoad/qudt:numericValue ?reported_max_ll .
                FILTER (ABS(?reported_max_ll - ?max_ll) > 1e-6)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow pressure (selectedMaximumBowPressure) must equal the maximum of the calculated pressures across all subregions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (MAX(?p_val) AS ?max_p)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase/nltl:bowSubregionCalculatedPressure/qudt:numericValue ?p_val .
                    }
                    GROUP BY $this
                }
                $this nltl:selectedMaximumBowPressure/qudt:numericValue ?reported_max_p .
                FILTER (ABS(?reported_max_p - ?max_p) > 1e-6)
            }
        """
    ] .

<urn:nltl:generated-shape:BowSubregionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each bow subregion calculation case must carry a link to an evidence artifact."
    ] .
