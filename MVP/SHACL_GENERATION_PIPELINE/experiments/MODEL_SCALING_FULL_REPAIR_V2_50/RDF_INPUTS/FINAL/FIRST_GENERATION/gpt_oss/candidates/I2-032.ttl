@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_032 a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    # --- quantity property presence & datatype/unit checks --------------------
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CM2 ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ; sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ; sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:frameSpacing ;
                sh:minCount 1 ; sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ; sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ; sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:minCount 1 ; sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ; sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ; sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    # --- calculation & comparison -------------------------------------------
    sh:sparql [
        sh:message "Shear area (A_w) must be greater than or equal to the required shear area (A_t) computed from the formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this WHERE {
                # ship‑level quantities
                $this nltl:shearArea ?saNode .
                ?saNode qudt:numericValue ?A_w ; qudt:unit unit:CM2 .
                $this nltl:yieldStrength ?ysNode .
                ?ysNode qudt:numericValue ?sigma_y ; qudt:unit unit:MegaPA .
                $this nltl:frameSpan ?fsNode .
                ?fsNode qudt:numericValue ?a ; qudt:unit unit:M .
                $this nltl:loadPatchHeight ?lphNode .
                ?lphNode qudt:numericValue ?b ; qudt:unit unit:M .
                $this nltl:averageIcePressure ?pavgNode .
                ?pavgNode qudt:numericValue ?P_avg ; qudt:unit unit:MegaPA .
                $this nltl:peakPressureFactor ?ppfNode .
                ?ppfNode qudt:numericValue ?PPF ; qudt:unit unit:UNITLESS .
                # structural‑member quantities
                $this nltl:hasStructuralMember ?member .
                ?member nltl:frameSpacing ?fsMemberNode .
                ?fsMemberNode qudt:numericValue ?s ; qudt:unit unit:M .
                ?member nltl:selectedHullAreaFactor ?afNode .
                ?afNode qudt:numericValue ?AF ; qudt:unit unit:UNITLESS .
                # compute LL = min(a,b)
                BIND( IF(?a < ?b, ?a, ?b) AS ?LL ) .
                # A_t = 100^2 * 0.5 * LL * s * (AF * PPF * P_avg) / (0.577 * sigma_y)
                BIND( (100*100) * 0.5 * ?LL * ?s * ( ?AF * ?PPF * ?P_avg ) / ( 0.577 * ?sigma_y ) AS ?A_t ) .
                FILTER ( ?A_w < ?A_t )
            }
        """
    ] .
