@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix gen: <urn:nltl:generated-shape:> .

# Ship level shape – requires at least one structural member
gen:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:minCount 1 ;
        sh:node gen:StructuralMemberShape ;
        sh:message "A ship must be linked to at least one structural member via nltl:hasStructuralMember." ;
    ] .

# Structural member shape – required quantities
gen:StructuralMemberShape a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    
    # net attached shell plate thickness (t_pn)
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "netAttachedShellPlateThickness must have a numeric value." ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:message "netAttachedShellPlateThickness must use unit millimetre (unit:MilliM)." ;
            ] ;
        ] ;
        sh:message "netAttachedShellPlateThickness (t_pn) is required for each structural member." ;
    ] ;
    
    # yield strength (sigma_y)
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "yieldStrength must have a numeric value." ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:message "yieldStrength must use unit megapascal (unit:MegaPA)." ;
            ] ;
        ] ;
        sh:message "yieldStrength is required for each structural member." ;
    ] ;
    
    # net web thickness (t_wn) – result term
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "netWebThickness must have a numeric value." ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:message "netWebThickness must use unit millimetre (unit:MilliM)." ;
            ] ;
        ] ;
        sh:message "netWebThickness (t_wn) is required for each structural member." ;
    ] .
