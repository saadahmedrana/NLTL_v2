@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF075ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gen:TRF075LoadCaseShape
    ] .

gen:TRF075LoadCaseShape a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseBlade ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:propellerBlade
        ] ;
        sh:message "Each propeller blade load case must link to its assessed propeller blade."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseIceBlock ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceBlock
        ] ;
        sh:message "Each propeller blade load case must link to its associated ice block."
    ] ;
    sh:xone (
        [
            sh:path nltl:backwardBladeForce ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:node gen:TRF075ForceShape
        ]
        [
            sh:path nltl:forwardBladeForce ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:node gen:TRF075ForceShape
        ]
    ) ;
    sh:message "Each propeller blade load case must contain exactly one of backward blade force or forward blade force." .

gen:TRF075ForceShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "The blade force quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN ;
        sh:message "The blade force quantity must use the canonical kilonewton unit."
    ] .

