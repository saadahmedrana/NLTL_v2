@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The section modulus must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The section modulus unit must be cubic centimetres."
    ] .

gen:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The shear area must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The shear area unit must be square centimetres."
    ] .

gen:ReducedLineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.10 ;
        sh:maxExclusive 0.15 ;
        sh:message "The permitted reduced line load must be at least 0.10 and less than 0.15."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The permitted reduced line load unit must be kilonewtons per metre."
    ] .

gen:NarrowDeckStripComplianceShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether the narrow deck strip is abreast of a hatch must be stated."
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether the narrow deck strip serves as an ice stringer must be stated."
    ] ;
    sh:or (
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:abreastOfHatch ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:servesAsIceStringer ;
                        sh:hasValue false
                    ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Whether the applicable hatch opening is very long must be stated."
            ] ;
            sh:property [
                sh:path nltl:actualSectionModulus ;
                sh:node gen:SectionModulusQuantityShape ;
                sh:minCount 1 ;
                sh:message "An actual section modulus is required."
            ] ;
            sh:property [
                sh:path nltl:requiredSectionModulus ;
                sh:node gen:SectionModulusQuantityShape ;
                sh:minCount 1 ;
                sh:message "A required section modulus is required."
            ] ;
            sh:property [
                sh:path nltl:actualShearArea ;
                sh:node gen:ShearAreaQuantityShape ;
                sh:minCount 1 ;
                sh:message "An actual shear area is required."
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:node gen:ShearAreaQuantityShape ;
                sh:minCount 1 ;
                sh:message "A required shear area is required."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The actual section modulus and shear area must not be less than their respective required values." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:actualSectionModulus ?actualSectionNode ;
           nltl:requiredSectionModulus ?requiredSectionNode ;
           nltl:actualShearArea ?actualAreaNode ;
           nltl:requiredShearArea ?requiredAreaNode .
    ?actualSectionNode qudt:numericValue ?actualSection .
    ?requiredSectionNode qudt:numericValue ?requiredSection .
    ?actualAreaNode qudt:numericValue ?actualArea .
    ?requiredAreaNode qudt:numericValue ?requiredArea .
    FILTER (
        ?actualSection < ?requiredSection ||
        ?actualArea < ?requiredArea
    )
}
"""
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:veryLongHatchOpening ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:permittedReducedLineLoad ;
                        sh:maxCount 0 ;
                        sh:message "A reduced line load exception is permitted only for a very long hatch opening."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:veryLongHatchOpening ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "Classification-society approval status for the reduced line load must be stated."
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                                sh:hasValue false
                            ] ;
                            sh:property [
                                sh:path nltl:permittedReducedLineLoad ;
                                sh:maxCount 0 ;
                                sh:message "A reduced line load may not be recorded without classification-society approval."
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:permittedReducedLineLoad ;
                                sh:node gen:ReducedLineLoadQuantityShape ;
                                sh:minCount 1 ;
                                sh:message "An approved very-long-hatch exception requires a permitted reduced line load."
                            ]
                        ]
                    )
                ]
            )
        ]
    ) .
