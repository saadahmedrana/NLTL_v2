@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066RudderProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:message "Ships of ice class IA or IA Super must have the applicable rudder protection arrangement." ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIaSuper
                )
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:minCount 1 ;
                        sh:datatype xsd:boolean ;
                        sh:in ( true )
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:qualifiedValueShape [
                            sh:class nltl:iceKnife ;
                            sh:property [
                                sh:path nltl:extendsBelowLowerIceWaterline ;
                                sh:minCount 1 ;
                                sh:datatype xsd:boolean ;
                                sh:in ( true )
                            ]
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:minCount 1 ;
                        sh:datatype xsd:boolean ;
                        sh:in ( false )
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:qualifiedValueShape [
                            sh:class nltl:equivalentRudderProtectionMeans
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
            )
        ]
    ) .
