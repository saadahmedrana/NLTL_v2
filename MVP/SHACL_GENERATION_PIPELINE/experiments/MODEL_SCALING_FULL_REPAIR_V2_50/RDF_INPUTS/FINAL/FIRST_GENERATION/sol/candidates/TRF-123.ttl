@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:OccasionalForceRequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:occasionalForceLoadCase ;
        sh:node gs:OccasionalForceLoadCaseShape ;
        sh:message "The ship must provide an occasional-force load case."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The occasional-force component stress multiplied by the reported yield safety factor must not exceed the component material yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?case ?component
            WHERE {
                $this nltl:hasOccasionalForceLoadCase ?case .
                ?case nltl:occasionalForceCaseAssessedComponent ?component ;
                      nltl:componentYieldSafetyFactor ?factorQuantity .
                ?component nltl:occasionalForceComponentStress ?stressQuantity ;
                           nltl:hasMaterialProperties ?materialProperties .
                ?materialProperties
                    nltl:componentMaterialYieldStrength ?yieldQuantity .
                ?stressQuantity qudt:numericValue ?stress .
                ?factorQuantity qudt:numericValue ?factor .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                FILTER (
                    xsd:decimal(?stress) * xsd:decimal(?factor)
                    > xsd:decimal(?yieldStrength)
                )
            }
        """
    ] .

gs:OccasionalForceLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:occasionalForceLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The load case must confirm that propeller blades are excluded from the occasional-force scope."
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:message "The load case must provide the externally determined component yield safety factor."
    ] ;
    sh:property [
        sh:path nltl:occasionalForceCaseAssessedComponent ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:shipComponent ;
        sh:node gs:OccasionalForceAssessedComponentShape ;
        sh:message "The load case must identify each assessed component."
    ] .

gs:OccasionalForceAssessedComponentShape
    a sh:NodeShape ;
    sh:class nltl:shipComponent ;
    sh:property [
        sh:path nltl:occasionalForceComponentStress ;
        sh:minCount 1 ;
        sh:node gs:MegaPascalDecimalQuantityShape ;
        sh:message "Each assessed component must provide its externally calculated occasional-force stress."
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:materialProperties ;
        sh:node gs:OccasionalForceMaterialPropertiesShape ;
        sh:message "Each assessed component must provide its material properties."
    ] .

gs:OccasionalForceMaterialPropertiesShape
    a sh:NodeShape ;
    sh:class nltl:materialProperties ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:node gs:MegaPascalDecimalQuantityShape ;
        sh:message "The material properties must provide the component material yield strength."
    ] .

gs:MegaPascalDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gs:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
