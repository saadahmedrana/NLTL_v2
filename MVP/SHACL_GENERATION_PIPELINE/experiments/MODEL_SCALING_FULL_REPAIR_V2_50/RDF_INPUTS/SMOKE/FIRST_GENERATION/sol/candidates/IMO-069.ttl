@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO069Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:addedLifeSavingDeviceRequiresPower ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Whether an added life-saving device requires power must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:addedLifeSavingDeviceRequiresPower ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:devicePowerSourceIndependentOfMainPower ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "A powered added life-saving device must have a power source independent of the ship's main power source."
            ]
        ]
    ) .
