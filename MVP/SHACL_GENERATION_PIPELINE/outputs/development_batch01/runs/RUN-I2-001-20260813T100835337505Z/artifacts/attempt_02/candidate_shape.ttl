@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:URI2Rev4ApplicabilityShape>
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:constructionContractDate ?contractDate .
                FILTER(
                    DATATYPE(?contractDate) = xsd:date &&
                    ?contractDate >= "2021-01-01"^^xsd:date
                )
            }
        """
    ] .
