@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_002_Shape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:polarClass ?polarClass .
                FILTER (
                    ?polarClass IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5,
                        nltl:polarClassPc6,
                        nltl:polarClassPc7
                    )
                )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:urI1ComplianceStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "A Polar Class PC1-PC7 ship must have exactly one UR I1 compliance status equal to true."
    ] .
