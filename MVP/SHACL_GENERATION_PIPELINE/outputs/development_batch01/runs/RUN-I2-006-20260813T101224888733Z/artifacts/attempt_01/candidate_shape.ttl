@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_006_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements"^^xsd:string ;
                sh:message "A ship intended to operate astern in ice regions must record the required aft-section design basis."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow"^^xsd:string ;
                sh:message "The Bow hull area requirements must be included for the aft section."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow Intermediate"^^xsd:string ;
                sh:message "The Bow Intermediate hull area requirements must be included for the aft section."
            ]
        ]
    ) .
