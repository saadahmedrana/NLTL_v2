@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MegaPAQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA
    ] .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gs:KilonewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN
    ] .

gs:LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gs:I2_008Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:qualifiedValueShape [
                    sh:in (
                        nltl:polarClassPc1
                        nltl:polarClassPc2
                        nltl:polarClassPc3
                        nltl:polarClassPc4
                        nltl:polarClassPc5
                        nltl:polarClassPc6
                        nltl:polarClassPc7
                    )
                ] ;
                sh:qualifiedMaxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:qualifiedValueShape [
                    sh:in (
                        nltl:polarClassPc1
                        nltl:polarClassPc2
                        nltl:polarClassPc3
                        nltl:polarClassPc4
                        nltl:polarClassPc5
                        nltl:polarClassPc6
                        nltl:polarClassPc7
                    )
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:bowShape ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hullArea ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:shapeCoefficient ;
                sh:node gs:UnitlessQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:totalGlancingImpactForce ;
                sh:node gs:KilonewtonQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:lineLoad ;
                sh:node gs:LineLoadQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:node gs:MegaPAQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:averageIcePressure ;
                sh:node gs:MegaPAQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:loadPatchHeight ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:loadPatchLength ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ]
        ]
    ) .
