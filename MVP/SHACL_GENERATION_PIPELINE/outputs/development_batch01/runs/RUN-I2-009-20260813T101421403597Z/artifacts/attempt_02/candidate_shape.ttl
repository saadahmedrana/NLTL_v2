@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2-009Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ] ;
        sh:message "Average ice pressure must have a decimal value in MPa."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "Non-bow load patch height must be a positive decimal value in metres."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "Non-bow load patch length must be a positive decimal value in metres."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "3.6"^^xsd:decimal ;
                sh:maxInclusive "3.6"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "The load patch aspect ratio must be the unitless value 3.6."
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ] ;
        sh:message "Buttock angle applicability input must be a decimal value in degrees."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ] ;
        sh:message "Normal frame angle applicability input must be a decimal value in degrees."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:minExclusive "0"^^xsd:decimal ;
                sh:maxExclusive "80"^^xsd:decimal
            ] ;
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:minExclusive "10"^^xsd:decimal
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:maxInclusive "0"^^xsd:decimal
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:minInclusive "80"^^xsd:decimal
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:maxInclusive "10"^^xsd:decimal
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Non-bow load patch length must equal 3.6 times its height within the numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:nonBowLoadPatchHeight ?heightQuantity ;
                      nltl:nonBowLoadPatchLength ?lengthQuantity .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?lengthQuantity qudt:numericValue ?length ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND ("3.6"^^xsd:decimal * ?height AS ?expectedLength)
                BIND (
                    IF (
                        ABS(?expectedLength) * "0.000001"^^xsd:decimal >
                            "0.000000001"^^xsd:decimal,
                        ABS(?expectedLength) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?length - ?expectedLength) > ?tolerance)
            }
        """
    ] .
