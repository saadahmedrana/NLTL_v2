@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ObliquelyFramedPlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:node gs:FramingAngleValueShape ;
        sh:message "A framing angle in degrees is required to determine whether linear interpolation applies."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingAngle ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive "20"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:framingAngle ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "70"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:framingAngle ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minExclusive "20"^^xsd:decimal ;
                        sh:maxExclusive "70"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:interpolatedShellPlateRequirement ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ]
        ]
    ) ;
    sh:message "Linear interpolation must be used when the framing angle is greater than 20 degrees and less than 70 degrees." .

gs:FramingAngleValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "The framing angle must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:DEG ) ;
        sh:message "The framing angle must be expressed in degrees."
    ] .
