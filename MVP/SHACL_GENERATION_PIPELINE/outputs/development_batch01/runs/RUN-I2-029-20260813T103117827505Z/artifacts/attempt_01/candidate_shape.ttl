@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:I2_029_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node g:SectionModulusQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node g:ShearAreaQuantityShape
    ] ;
    sh:property [
        sh:path nltl:thickness ;
        sh:node g:ThicknessQuantityShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:shearArea ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:thickness ;
                sh:minCount 1 ;
                sh:message "A thickness quantity is required when section modulus is supplied."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shearArea ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:thickness ;
                sh:minCount 1 ;
                sh:message "A thickness quantity is required when shear area is supplied."
            ]
        ]
    ) .

g:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1
    ] .

g:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1
    ] .

g:ThicknessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .
