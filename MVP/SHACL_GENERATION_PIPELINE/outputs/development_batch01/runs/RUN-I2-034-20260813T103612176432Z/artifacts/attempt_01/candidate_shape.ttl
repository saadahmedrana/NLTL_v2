@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2-034-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:combinedShearBendingEffect ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The combined shear and bending effect must be provided."
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:minCount 1 ;
        sh:node gen:I2-034-PlasticStrengthValueShape ;
        sh:message "Plastic strength must be provided in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The plastic collapse mechanism defining plastic strength must be provided."
    ] .

gen:I2-034-PlasticStrengthValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( <http://qudt.org/vocab/unit/KiloN> )
    ] .
