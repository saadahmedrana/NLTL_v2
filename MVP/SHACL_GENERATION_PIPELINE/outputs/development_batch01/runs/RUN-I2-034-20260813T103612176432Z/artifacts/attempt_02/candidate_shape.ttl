@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_034_ShipShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                      nltl:hasComponent ?frame .
                ?frame a nltl:longitudinalLocalFrame .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gen:I2_034_PlasticStrengthValueShape ;
        sh:message "Plastic strength must be reported as a quantity value in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The plastic-collapse mechanism defining the reported plastic strength must be identified."
    ] .

gen:I2_034_PlasticStrengthValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Plastic strength must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:KiloN ;
        sh:message "Plastic strength must use kilonewtons."
    ] .
