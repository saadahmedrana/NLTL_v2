@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_037_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with a web frame or load-carrying stringer must record the combined bending and shear effect, load-patch application location, and member capacity in kilonewtons." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?member .
    ?member a ?memberType .
    FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))

    FILTER NOT EXISTS {
        $this nltl:combinedShearBendingEffect ?effect ;
              nltl:loadPatchApplicationLocation ?location ;
              nltl:memberCapacity ?capacity .

        ?capacity a qudt:QuantityValue ;
                  qudt:numericValue ?capacityValue ;
                  qudt:unit unit:KiloN .

        FILTER (
            datatype(?effect) = xsd:string &&
            datatype(?location) = xsd:string &&
            datatype(?capacityValue) = xsd:decimal
        )
    }
}
""" 
    ] .
