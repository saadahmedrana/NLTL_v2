@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_046_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengthenedHullArea ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "A ship with a stated ice-strengthened hull area must have a corrosion/abrasion addition of at least 1.0 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceStrengthenedHullArea ?area .
                FILTER (
                    NOT EXISTS {
                        $this nltl:corrosionAbrasionAddition ?addition .
                        ?addition a qudt:QuantityValue ;
                            qudt:numericValue ?value ;
                            qudt:unit unit:MilliM .
                        FILTER (
                            datatype(?value) = xsd:decimal &&
                            ?value >= 1.0
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:corrosionAbrasionAddition ?reportedAddition .
                        FILTER NOT EXISTS {
                            ?reportedAddition a qudt:QuantityValue ;
                                qudt:numericValue ?reportedValue ;
                                qudt:unit unit:MilliM .
                            FILTER (
                                datatype(?reportedValue) = xsd:decimal &&
                                ?reportedValue >= 1.0
                            )
                        }
                    }
                )
            }
        """
    ] .
