@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:asBuiltThickness ;
        sh:minCount 1 ;
        sh:node gen:I2_048_ThicknessValueShape ;
        sh:message "As-built thickness in metres is required for the Table 8 lookup."
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "A recognized Polar Class is required for the Table 8 lookup."
    ] ;
    sh:property [
        sh:path nltl:materialClass ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Material class is required for the Table 8 lookup."
    ] ;
    sh:property [
        sh:path nltl:steelGrade ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Steel grade is required for assessment against Table 8."
    ] .

gen:I2_048_ThicknessValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "As-built thickness requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:M ) ;
        sh:message "As-built thickness must use metre as its unit."
    ] .
