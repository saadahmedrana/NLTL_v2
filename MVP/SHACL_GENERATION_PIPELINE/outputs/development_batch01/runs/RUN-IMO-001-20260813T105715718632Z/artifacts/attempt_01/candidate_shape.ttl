@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarShipCategoryAShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship design ice condition is required to determine Polar ship category applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship designed for at least medium first-year ice, including possible old-ice inclusions, must have Polar ship category A." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER(
                    ?condition =
                    "at least medium first-year ice, including possible old-ice inclusions"^^xsd:string
                )
                FILTER(
                    !EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryA .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER(?category != nltl:polarShipCategoryA)
                    }
                )
            }
        """
    ] .
