@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO002ShipCategoryShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single design ice condition is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single declared Polar Code ship category is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship designed for at least thin first-year ice that is not category A shall be category B." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:designIceCondition ?iceCondition ;
          nltl:shipCategory ?category .
    FILTER (
        LCASE(STR(?iceCondition)) IN (
            "at least thin first-year ice, including possible old-ice inclusions",
            "at least thin first-year ice, which may include old ice inclusions"
        )
        && ?category != nltl:polarShipCategoryA
        && ?category != nltl:polarShipCategoryB
    )
}
"""
    ] .
