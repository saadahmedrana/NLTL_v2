@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO003Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship design ice condition is required to determine whether Category C applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship designed for open water or ice conditions less severe than Categories A and B must be declared as Category C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER (
                    LCASE(STR(?condition)) IN (
                        "open water",
                        "ice conditions less severe than categories a and b"
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryC .
                }
            }
        """
    ] .
