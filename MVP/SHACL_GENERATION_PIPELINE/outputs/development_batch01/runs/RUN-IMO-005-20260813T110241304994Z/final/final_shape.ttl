@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IceFreeWatersShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship declaring 'ice free waters' must record total ice present as false." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceCondition ?condition .
    FILTER(
        DATATYPE(?condition) = xsd:string &&
        STR(?condition) = "ice free waters"
    )
    FILTER NOT EXISTS {
        $this nltl:totalIcePresent ?icePresent .
        FILTER(
            DATATYPE(?icePresent) = xsd:boolean &&
            ?icePresent = false
        )
    }
}
"""
    ] .
