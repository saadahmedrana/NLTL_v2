@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:BergyWatersShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Ice condition is required to determine whether the bergy-waters limits apply."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For bergy waters, land-origin ice concentration must be less than 1 and total ice concentration must not exceed 1, both as decimal unitless quantities." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER(STR(?condition) = "bergy waters")

                OPTIONAL {
                    $this nltl:landOriginIceConcentration ?landQuantity .
                    OPTIONAL {
                        ?landQuantity a qudt:QuantityValue .
                        BIND(true AS ?landTyped)
                    }
                    OPTIONAL {
                        ?landQuantity qudt:numericValue ?landValue .
                    }
                    OPTIONAL {
                        ?landQuantity qudt:unit ?landUnit .
                    }
                }

                OPTIONAL {
                    $this nltl:totalIceConcentration ?totalQuantity .
                    OPTIONAL {
                        ?totalQuantity a qudt:QuantityValue .
                        BIND(true AS ?totalTyped)
                    }
                    OPTIONAL {
                        ?totalQuantity qudt:numericValue ?totalValue .
                    }
                    OPTIONAL {
                        ?totalQuantity qudt:unit ?totalUnit .
                    }
                }

                FILTER(
                    !BOUND(?landQuantity) ||
                    !BOUND(?landTyped) ||
                    !BOUND(?landValue) ||
                    (
                        BOUND(?landValue) &&
                        (
                            !isLiteral(?landValue) ||
                            DATATYPE(?landValue) != xsd:decimal ||
                            ?landValue >= "1"^^xsd:decimal
                        )
                    ) ||
                    !BOUND(?landUnit) ||
                    (
                        BOUND(?landUnit) &&
                        ?landUnit != unit:UNITLESS
                    ) ||
                    !BOUND(?totalQuantity) ||
                    !BOUND(?totalTyped) ||
                    !BOUND(?totalValue) ||
                    (
                        BOUND(?totalValue) &&
                        (
                            !isLiteral(?totalValue) ||
                            DATATYPE(?totalValue) != xsd:decimal ||
                            ?totalValue > "1"^^xsd:decimal
                        )
                    ) ||
                    !BOUND(?totalUnit) ||
                    (
                        BOUND(?totalUnit) &&
                        ?totalUnit != unit:UNITLESS
                    )
                )
            }
        """
    ] .
