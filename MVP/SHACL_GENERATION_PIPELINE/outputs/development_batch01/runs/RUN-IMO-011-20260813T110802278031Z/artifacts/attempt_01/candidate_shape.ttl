@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TemperatureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG_C ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DataPeriodQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:YR ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MeanDailyLowTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:node gen:TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:message "At least one daily low temperature in degrees Celsius is required."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:node gen:TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one mean daily low temperature in degrees Celsius is required."
    ] ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:node gen:DataPeriodQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one data period in years is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "10"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "10"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A data period under 10 years requires an approved Administration dataset."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Mean daily low temperature must equal the mean of the supplied daily low temperatures within a relative tolerance of 1e-6 and an absolute fallback of 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:meanDailyLowTemperature ?meanNode ;
                      nltl:dailyLowTemperature ?dailyNode .
                ?meanNode qudt:numericValue ?reported .
                ?dailyNode qudt:numericValue ?daily .
            }
            GROUP BY $this ?reported
            HAVING (
                ABS(xsd:decimal(?reported) - AVG(xsd:decimal(?daily))) >
                IF(
                    ABS(AVG(xsd:decimal(?daily))) * 0.000001 >
                        0.000000000001,
                    ABS(AVG(xsd:decimal(?daily))) * 0.000001,
                    0.000000000001
                )
            )
        """
    ] .
