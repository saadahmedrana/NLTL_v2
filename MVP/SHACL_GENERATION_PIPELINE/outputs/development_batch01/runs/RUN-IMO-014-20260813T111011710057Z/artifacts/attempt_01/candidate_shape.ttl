@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarShipCertificateShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Polar Code applicability must be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeApplies ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeApplies ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:polarShipCertificatePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "A Polar Ship Certificate must be present when the Polar Code applies."
            ] ;
            sh:property [
                sh:path nltl:polarShipCertificateStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The Polar Ship Certificate must have valid status when the Polar Code applies."
            ]
        ]
    ) .
