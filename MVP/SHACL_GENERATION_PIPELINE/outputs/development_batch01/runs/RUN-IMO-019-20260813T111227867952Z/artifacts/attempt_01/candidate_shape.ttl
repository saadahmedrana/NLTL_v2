@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO019Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:in ( false ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:polarServiceTemperature ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:in ( unit:DEG_C ) ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:lowestMdlt ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:in ( unit:DEG_C ) ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:requiredSystemsFunctionalAtPst ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For a ship operating in low air temperature, the Polar Service Temperature must be at least 10 degrees Celsius below the lowest MDLT." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:polarServiceTemperature ?pstQuantity ;
                      nltl:lowestMdlt ?mdltQuantity .
                ?pstQuantity qudt:numericValue ?pst ;
                             qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                ?mdltQuantity qudt:numericValue ?mdlt ;
                              qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                FILTER (?pst > (?mdlt - "10"^^xsd:decimal))
            }
        """
    ] .
