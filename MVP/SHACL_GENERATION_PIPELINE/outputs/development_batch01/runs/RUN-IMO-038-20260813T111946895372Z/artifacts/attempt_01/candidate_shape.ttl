@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MillimetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:IceDamageExtentShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLength ;
        sh:node gs:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Upper ice waterline length must be provided once in metres."
    ] ;
    sh:property [
        sh:path nltl:damageCenterForwardOfMaxBreadth ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The damage-centre position relative to maximum breadth must be provided once."
    ] ;
    sh:property [
        sh:path nltl:longitudinalDamageExtent ;
        sh:node gs:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Longitudinal damage extent must be provided once in metres."
    ] ;
    sh:property [
        sh:path nltl:transversePenetration ;
        sh:node gs:MillimetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:minInclusive "760"^^xsd:decimal ;
            sh:maxInclusive "760"^^xsd:decimal
        ] ;
        sh:message "Transverse penetration must be exactly 760 mm."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gs:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Upper ice waterline draught must be provided once in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalDamageExtent ;
        sh:node gs:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Vertical damage extent must be provided once in metres."
    ] ;
    sh:property [
        sh:path nltl:allowedVerticalPosition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "between keel and 1.20 * upper ice waterline draught" ;
        sh:message "The allowed vertical position must extend from the keel to 1.20 times the upper ice waterline draught."
    ] ;
    sh:sparql [
        sh:message "Calculated longitudinal and vertical damage extents must satisfy the required formulas within a relative tolerance of 1e-6 or an absolute tolerance of 1e-9 near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineLength ?lengthQuantity ;
                      nltl:damageCenterForwardOfMaxBreadth ?forward ;
                      nltl:longitudinalDamageExtent ?longitudinalQuantity ;
                      nltl:upperIceWaterlineDraught ?draughtQuantity ;
                      nltl:verticalDamageExtent ?verticalQuantity .
                ?lengthQuantity qudt:numericValue ?length .
                ?longitudinalQuantity qudt:numericValue ?longitudinal .
                ?draughtQuantity qudt:numericValue ?draught .
                ?verticalQuantity qudt:numericValue ?vertical .

                BIND(
                    IF(
                        ?forward = true,
                        "0.045"^^xsd:decimal * ?length,
                        "0.015"^^xsd:decimal * ?length
                    )
                    AS ?expectedLongitudinal
                )
                BIND(
                    IF(
                        ABS(?expectedLongitudinal) * "0.000001"^^xsd:decimal
                            > "0.000000001"^^xsd:decimal,
                        ABS(?expectedLongitudinal) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?longitudinalTolerance
                )
                BIND("0.20"^^xsd:decimal * ?draught AS ?draughtFraction)
                BIND(
                    IF(
                        ?draughtFraction < ?longitudinal,
                        ?draughtFraction,
                        ?longitudinal
                    )
                    AS ?expectedVertical
                )
                BIND(
                    IF(
                        ABS(?expectedVertical) * "0.000001"^^xsd:decimal
                            > "0.000000001"^^xsd:decimal,
                        ABS(?expectedVertical) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?verticalTolerance
                )
                FILTER(
                    ABS(?longitudinal - ?expectedLongitudinal)
                        > ?longitudinalTolerance
                    ||
                    ABS(?vertical - ?expectedVertical)
                        > ?verticalTolerance
                )
            }
        """
    ] .
