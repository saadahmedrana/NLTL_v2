@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_040_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion likelihood is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ice accretion is likely, relevant hatch or door records and ice or snow removal or prevention means records are required as strings." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceAccretionLikely ?likely .
                FILTER(?likely = true)
                FILTER(
                    NOT EXISTS {
                        $this nltl:relevantHatchOrDoor ?hatchOrDoor .
                    }
                    ||
                    EXISTS {
                        $this nltl:relevantHatchOrDoor ?hatchOrDoor .
                        FILTER(!isLiteral(?hatchOrDoor) || datatype(?hatchOrDoor) != xsd:string)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOrSnowRemovalOrPreventionMeans ?means .
                    }
                    ||
                    EXISTS {
                        $this nltl:iceOrSnowRemovalOrPreventionMeans ?means .
                        FILTER(!isLiteral(?means) || datatype(?means) != xsd:string)
                    }
                )
            }
        """
    ] .
