@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MachinerySeawaterSupplyShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceIngestionPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:in ( true )
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                        sh:minCount 1 ;
                        sh:in ( nltl:evidenceStateApproved )
                    ]
                ]
            )
        ]
    ) ;
    sh:message "A machinery seawater supply must prevent ice ingestion or have an approved alternate functionality arrangement." .
