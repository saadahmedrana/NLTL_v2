@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:EssentialEngineCombustionAirShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship with an essential engine, combustion-air temperature control must be present and true, and the combustion-air temperature must be within the manufacturer's limits in degrees Celsius." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?engine .
    ?engine a nltl:essentialEngine .

    FILTER (
        !EXISTS {
            $this nltl:combustionAirTemperatureControlPresent ?control .
            FILTER (
                DATATYPE(?control) = xsd:boolean &&
                ?control = true
            )
        }
        ||
        !EXISTS {
            $this nltl:combustionAirTemperature ?temperatureQuantity ;
                  nltl:manufacturerMinAirTemperature ?minimumQuantity ;
                  nltl:manufacturerMaxAirTemperature ?maximumQuantity .

            ?temperatureQuantity
                qudt:numericValue ?temperature ;
                qudt:unit unit:DEG_C .

            ?minimumQuantity
                qudt:numericValue ?minimum ;
                qudt:unit unit:DEG_C .

            ?maximumQuantity
                qudt:numericValue ?maximum ;
                qudt:unit unit:DEG_C .

            FILTER (
                DATATYPE(?temperature) = xsd:decimal &&
                DATATYPE(?minimum) = xsd:decimal &&
                DATATYPE(?maximum) = xsd:decimal &&
                ?minimum <= ?temperature &&
                ?temperature <= ?maximum
            )
        }
    )
}
"""
    ] .
