@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO-051-Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:localControl ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Local-control applicability status is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:localControl ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:localControl ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:freezingSnowIceProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Local controls must have freezing, snow, and ice protection."
            ] ;
            sh:property [
                sh:path nltl:continuouslyAccessible ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Local controls must remain continuously accessible."
            ]
        ]
    ) .
