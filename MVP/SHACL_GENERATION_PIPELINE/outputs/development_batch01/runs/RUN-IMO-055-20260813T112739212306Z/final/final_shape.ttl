@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO-055-Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:valveExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Valve exposure status is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:valveType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Valve type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An exposed isolating, pressure, or vacuum valve must be protected from ice accretion and continuously accessible." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:valveExposed ?exposed ;
          nltl:valveType ?type .
    FILTER(
        ?exposed = "true"^^xsd:boolean &&
        ?type IN ("isolating", "pressure", "vacuum")
    )
    FILTER(
        NOT EXISTS {
            $this nltl:iceAccretionProtectionPresent ?protected .
            FILTER(?protected = "true"^^xsd:boolean)
        }
        ||
        NOT EXISTS {
            $this nltl:continuouslyAccessible ?accessible .
            FILTER(?accessible = "true"^^xsd:boolean)
        }
    )
}
"""
    ] .
