@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FirePumpCompartmentTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each fire, emergency fire, water-mist, or water-spray pump must be assigned to a compartment maintained above 0 degrees Celsius." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?pump
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType .
    FILTER (
        ?pumpType IN (
            nltl:firePump,
            nltl:emergencyFirePump,
            nltl:waterMistPump,
            nltl:waterSprayPump
        )
    )
    FILTER NOT EXISTS {
        ?pump nltl:hasContainingCompartment ?compartment .
        ?compartment a nltl:compartment ;
            nltl:maintainedTemperature ?temperature .
        ?temperature a qudt:QuantityValue ;
            qudt:numericValue ?value ;
            qudt:unit unit:DEG_C .
        FILTER (
            datatype(?value) = xsd:decimal &&
            ?value > "0"^^xsd:decimal
        )
    }
}
""" 
    ] .
