@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExposedFireMainSectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:exposedFireMainSection ;
        sh:datatype xsd:string
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:exposedFireMainSection ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:exposedFireMainSection ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:isolationCapability ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "An exposed fire-main section requires isolation capability."
            ] ;
            sh:property [
                sh:path nltl:drainageMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "An exposed fire-main section requires drainage means."
            ]
        ]
    ) .
