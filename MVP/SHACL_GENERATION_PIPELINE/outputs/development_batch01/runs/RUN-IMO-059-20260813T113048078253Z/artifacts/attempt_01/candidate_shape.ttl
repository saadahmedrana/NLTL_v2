@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FirefighterOutfitWarmStorageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:firefighterOutfit ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:storageLocation ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:storageLocationTemperatureClass ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship recording a firefighter outfit must record a storage location classified as warm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:firefighterOutfit ?outfit .
    FILTER NOT EXISTS {
        $this nltl:storageLocation ?location .
        $this nltl:storageLocationTemperatureClass "warm"^^xsd:string .
    }
}
"""
    ] .
