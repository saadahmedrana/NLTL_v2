@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:SeaSuctionIceClearingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:independentSeaSuctionUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:independentSeaSuctionUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:seaSuctionIceClearingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "The firefighting-system and sea-suction states must establish a valid applicability branch." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An independent sea suction for a separate fixed water system must be capable of being cleared of ice accumulation." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
SELECT $this
WHERE {
    $this nltl:fixedWaterSystemSeparateFromMainFirePumps true ;
          nltl:independentSeaSuctionUsed true .
    FILTER NOT EXISTS {
        $this nltl:seaSuctionIceClearingCapability true .
    }
}
"""
    ] .
