@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:ImmersionSuitInsulatedShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:immersionSuitType ;
                sh:minCount 1 ;
                sh:datatype xsd:string ;
                sh:in ( "insulated"^^xsd:string )
            ]
        ]
    ) ;
    sh:message "Immersion-suit applicability must be recorded; when required, the immersion-suit type must be insulated." .
