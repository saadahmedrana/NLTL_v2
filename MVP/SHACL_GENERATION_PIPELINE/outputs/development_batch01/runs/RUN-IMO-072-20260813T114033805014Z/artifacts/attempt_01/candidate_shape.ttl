@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExtendedDarknessSearchlightShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:assignedSearchlight ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "A searchlight assignment is required for extended-darkness operation."
            ] ;
            sh:property [
                sh:path nltl:continuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The assigned searchlight must be approved as suitable for continuous use."
            ]
        ]
    ) ;
    sh:message "Extended-darkness operation status must be recorded, and applicable searchlight assignment and continuous-use suitability information must conform." .
