@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LifeboatTypeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:lifeboatType ;
        sh:datatype xsd:string ;
        sh:in (
            "partially enclosed"^^xsd:string
            "totally enclosed"^^xsd:string
        ) ;
        sh:message "Each stated lifeboat type must be partially enclosed or totally enclosed."
    ] .
