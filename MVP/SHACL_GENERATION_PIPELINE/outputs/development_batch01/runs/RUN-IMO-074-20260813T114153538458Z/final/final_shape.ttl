@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AbandonmentSurvivalEquipmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:groupSurvivalEquipmentCarried ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                        sh:hasValue nltl:evidenceStateApproved
                    ]
                ]
            )
        ]
    ) ;
    sh:message "Record a single abandonment-potential value; when true, group survival equipment must be carried or equivalent functionality must be approved." .
