@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:PassengerInstructionAndCrewTrainingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:passengerInstructionStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Passenger instruction in personal survival equipment and emergency action must be completed."
    ] ;
    sh:property [
        sh:path nltl:crewSurvivalEquipmentTrainingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Crew training in personal and group survival equipment must be completed."
    ] .
