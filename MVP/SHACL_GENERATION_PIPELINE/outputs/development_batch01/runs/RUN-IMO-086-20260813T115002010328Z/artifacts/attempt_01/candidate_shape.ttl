@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO086HeadingMeansShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:nonMagneticHeadingMeansCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 2 ;
        sh:message "At least two non-magnetic heading means must be recorded."
    ] ;
    sh:property [
        sh:path nltl:headingMeansIndependent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The non-magnetic heading means must be independent."
    ] ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:message "Main-power connections for the heading means must be recorded."
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:message "Emergency-power connections for the heading means must be recorded."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each recorded non-magnetic heading means must share main- and emergency-power connection records." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:nonMagneticHeadingMeansCount ?meansCount .
    OPTIONAL {
        $this nltl:connectedToMainPower ?means ;
              nltl:connectedToEmergencyPower ?means .
    }
}
GROUP BY $this ?meansCount
HAVING (COUNT(DISTINCT ?means) < ?meansCount)
"""
    ] .
