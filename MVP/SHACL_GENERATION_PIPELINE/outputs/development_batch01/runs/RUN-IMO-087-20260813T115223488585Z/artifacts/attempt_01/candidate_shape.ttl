@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LatitudeValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "Latitude requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:DEG ) ;
        sh:message "Latitude must use the degree unit."
    ] .

gs:PolarLatitudeNavigationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:node gs:LatitudeValueShape ;
        sh:message "Planned or actual latitude is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:plannedOrActualLatitude qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:maxInclusive "80"^^xsd:decimal
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:plannedOrActualLatitude qudt:numericValue ) ;
                sh:minCount 1 ;
                sh:minExclusive "80"^^xsd:decimal
            ] ;
            sh:property [
                sh:path nltl:gnssCompassOrEquivalentCount ;
                sh:minCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:message "A ship proceeding above 80 degrees must have at least one GNSS compass or equivalent."
            ] ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:message "A ship proceeding above 80 degrees must record connection to main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:message "A ship proceeding above 80 degrees must record connection to emergency power."
            ]
        ]
    ) .
