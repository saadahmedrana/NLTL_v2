@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:SARCommunicationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:rescueCoordinationCentreVoiceOrData ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Rescue coordination centre voice or data communication must be supported."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 121.5 ;
                sh:maxInclusive 121.5
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaHZ
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Aircraft voice frequency support must include 121.5 MHz."
    ] ;
    sh:property [
        sh:path nltl:supportedAircraftVoiceFrequency ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 123.1 ;
                sh:maxInclusive 123.1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaHZ
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Aircraft voice frequency support must include 123.1 MHz."
    ] .
