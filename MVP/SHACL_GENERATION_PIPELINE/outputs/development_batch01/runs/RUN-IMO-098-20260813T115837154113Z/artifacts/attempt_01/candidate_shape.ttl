@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:SurvivalCraftCommunicationDeviceCountsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship's low-air-temperature operating status must be recorded."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship operating in low air temperature must report location-signal and on-scene transmit/receive device counts of at least one." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:locationSignalDeviceCount ?locationCount .
                        FILTER (
                            datatype(?locationCount) = xsd:integer &&
                            ?locationCount >= 1
                        )
                    } ||
                    EXISTS {
                        $this nltl:locationSignalDeviceCount ?invalidLocationCount .
                        FILTER (
                            datatype(?invalidLocationCount) != xsd:integer ||
                            ?invalidLocationCount < 1
                        )
                    } ||
                    NOT EXISTS {
                        $this nltl:onSceneTransmitReceiveDeviceCount ?communicationCount .
                        FILTER (
                            datatype(?communicationCount) = xsd:integer &&
                            ?communicationCount >= 1
                        )
                    } ||
                    EXISTS {
                        $this nltl:onSceneTransmitReceiveDeviceCount ?invalidCommunicationCount .
                        FILTER (
                            datatype(?invalidCommunicationCount) != xsd:integer ||
                            ?invalidCommunicationCount < 1
                        )
                    }
                )
            }
        """
    ] .
