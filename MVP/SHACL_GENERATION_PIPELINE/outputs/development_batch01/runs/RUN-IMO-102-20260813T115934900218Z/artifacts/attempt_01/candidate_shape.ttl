@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarTrainingQualificationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Ice condition is required to determine the polar training level."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Ship type is required to determine the polar training level."
    ] ;
    sh:property [
        sh:path nltl:crewRole ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Crew role is required to determine the polar training level."
    ] ;
    sh:property [
        sh:path nltl:requiredPolarTrainingLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The required polar training level must be recorded."
    ] ;
    sh:property [
        sh:path nltl:stcwQualificationStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Ice free"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "master"
                    "chief mate"
                    "officer in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Not applicable"
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Open waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "master"
                    "chief mate"
                    "officer in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Basic training"
            ] ;
            sh:property [
                sh:path nltl:stcwQualificationStatus ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Open waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:hasValue "Other"
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "master"
                    "chief mate"
                    "officer in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Not applicable"
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Other waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in ( "master" "chief mate" )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Advanced training"
            ] ;
            sh:property [
                sh:path nltl:stcwQualificationStatus ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Other waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:hasValue "officer in charge of a navigational watch"
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Basic training"
            ] ;
            sh:property [
                sh:path nltl:stcwQualificationStatus ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "The polar training level and STCW qualification status do not match the ice condition, ship type, and crew role matrix." .
