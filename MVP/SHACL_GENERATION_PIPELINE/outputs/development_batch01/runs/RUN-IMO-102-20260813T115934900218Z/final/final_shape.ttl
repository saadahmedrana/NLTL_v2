@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:PolarTrainingMatrixShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:crewRole ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredPolarTrainingLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:stcwQualificationStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Ice free"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "Master"
                    "Chief mate"
                    "Officer in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Not applicable"
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Open waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "Master"
                    "Chief mate"
                    "Officer in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Basic training"
            ] ;
            sh:property [
                sh:path nltl:stcwQualificationStatus ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Open waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:hasValue "Other"
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "Master"
                    "Chief mate"
                    "Officer in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Not applicable"
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Other waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in ( "Master" "Chief mate" )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Advanced training"
            ] ;
            sh:property [
                sh:path nltl:stcwQualificationStatus ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:hasValue "Other waters"
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:hasValue "Officer in charge of a navigational watch"
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:hasValue "Basic training"
            ] ;
            sh:property [
                sh:path nltl:stcwQualificationStatus ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "The recorded ice condition, ship type, crew role, training level, and STCW status must match a clause 12.3.1 matrix row." .
