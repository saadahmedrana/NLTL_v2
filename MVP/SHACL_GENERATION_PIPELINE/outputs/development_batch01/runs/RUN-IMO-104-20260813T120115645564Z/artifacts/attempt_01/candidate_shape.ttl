@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:CrewPwomFamiliarizationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assignedDuties ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Assigned duties are required to assess PWOM familiarization."
    ] ;
    sh:property [
        sh:path nltl:relevantPolarWaterOperationalManualProcedureOrEquipment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Relevant PWOM procedures or equipment are required."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "PWOM familiarization status must be completed."
    ] .
