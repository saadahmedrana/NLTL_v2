@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:M3QuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:in ( unit:M3 ) ;
        sh:minCount 1
    ] .

gs:MQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:in ( unit:M ) ;
        sh:minCount 1
    ] .

gs:IMO_108_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:message "Applicable Category A or B ships must have oil fuel tank outer-shell separation of at least 0.76 m." ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:aggregateOilFuelCapacity ;
                sh:node gs:M3QuantityValueShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:aggregateOilFuelCapacity
                    qudt:numericValue
                ) ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "600"^^xsd:decimal ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:aggregateOilFuelCapacity ;
                sh:node gs:M3QuantityValueShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:aggregateOilFuelCapacity
                    qudt:numericValue
                ) ;
                sh:datatype xsd:decimal ;
                sh:maxExclusive "600"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:individualOilFuelTankCapacity ;
                sh:node gs:M3QuantityValueShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:individualOilFuelTankCapacity
                    qudt:numericValue
                ) ;
                sh:datatype xsd:decimal ;
                sh:maxInclusive "30"^^xsd:decimal ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:aggregateOilFuelCapacity ;
                sh:node gs:M3QuantityValueShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:aggregateOilFuelCapacity
                    qudt:numericValue
                ) ;
                sh:datatype xsd:decimal ;
                sh:maxExclusive "600"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:individualOilFuelTankCapacity ;
                sh:node gs:M3QuantityValueShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:individualOilFuelTankCapacity
                    qudt:numericValue
                ) ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "30"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:oilFuelTankOuterShellSeparation ;
                sh:node gs:MQuantityValueShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:oilFuelTankOuterShellSeparation
                    qudt:numericValue
                ) ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0.76"^^xsd:decimal ;
                sh:minCount 1
            ]
        ]
    ) .
