@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO111Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
            nltl:polarShipCategoryC
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must have exactly one Category A, B, or C value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                )
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A Category A or B ship requires exactly one construction date to determine applicability."
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "A regulated tank requires exactly one individual tank capacity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:tankType ?tankType .
                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    YEAR(?date) > 2017 ||
                    (
                        YEAR(?date) = 2017 &&
                        (
                            MONTH(?date) > 1 ||
                            (MONTH(?date) = 1 && DAY(?date) >= 1)
                        )
                    )
                )
                FILTER (
                    ?tankType IN (
                        "oil_residue_tank",
                        "oily_bilge_water_holding_tank"
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:individualTankCapacity ?capacity .
                    } ||
                    EXISTS {
                        $this nltl:individualTankCapacity ?capacity1,
                                                           ?capacity2 .
                        FILTER (?capacity1 != ?capacity2)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The individual tank capacity must have exactly one decimal numeric value in cubic metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:tankType ?tankType ;
                      nltl:individualTankCapacity ?capacity .
                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    YEAR(?date) > 2017 ||
                    (
                        YEAR(?date) = 2017 &&
                        (
                            MONTH(?date) > 1 ||
                            (MONTH(?date) = 1 && DAY(?date) >= 1)
                        )
                    )
                )
                FILTER (
                    ?tankType IN (
                        "oil_residue_tank",
                        "oily_bilge_water_holding_tank"
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?capacity qudt:numericValue ?capacityValue .
                    } ||
                    EXISTS {
                        ?capacity qudt:numericValue ?capacityValue1,
                                                    ?capacityValue2 .
                        FILTER (?capacityValue1 != ?capacityValue2)
                    } ||
                    EXISTS {
                        ?capacity qudt:numericValue ?invalidCapacityValue .
                        FILTER (DATATYPE(?invalidCapacityValue) != xsd:decimal)
                    } ||
                    NOT EXISTS {
                        ?capacity qudt:unit ?capacityUnit .
                    } ||
                    EXISTS {
                        ?capacity qudt:unit ?capacityUnit1,
                                            ?capacityUnit2 .
                        FILTER (?capacityUnit1 != ?capacityUnit2)
                    } ||
                    EXISTS {
                        ?capacity qudt:unit ?wrongCapacityUnit .
                        FILTER (?wrongCapacityUnit != unit:M3)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A regulated tank with capacity greater than 30 cubic metres requires exactly one outer-shell separation value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:tankType ?tankType ;
                      nltl:individualTankCapacity ?capacity .
                ?capacity qudt:numericValue ?capacityValue ;
                          qudt:unit unit:M3 .
                FILTER (DATATYPE(?capacityValue) = xsd:decimal)
                FILTER (?capacityValue > "30"^^xsd:decimal)
                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    YEAR(?date) > 2017 ||
                    (
                        YEAR(?date) = 2017 &&
                        (
                            MONTH(?date) > 1 ||
                            (MONTH(?date) = 1 && DAY(?date) >= 1)
                        )
                    )
                )
                FILTER (
                    ?tankType IN (
                        "oil_residue_tank",
                        "oily_bilge_water_holding_tank"
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:tankOuterShellSeparation ?separation .
                    } ||
                    EXISTS {
                        $this nltl:tankOuterShellSeparation ?separation1,
                                                            ?separation2 .
                        FILTER (?separation1 != ?separation2)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The required tank outer-shell separation must have exactly one decimal numeric value in metres and must be at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:tankType ?tankType ;
                      nltl:individualTankCapacity ?capacity ;
                      nltl:tankOuterShellSeparation ?separation .
                ?capacity qudt:numericValue ?capacityValue ;
                          qudt:unit unit:M3 .
                FILTER (DATATYPE(?capacityValue) = xsd:decimal)
                FILTER (?capacityValue > "30"^^xsd:decimal)
                FILTER (
                    ?category IN (
                        nltl:polarShipCategoryA,
                        nltl:polarShipCategoryB
                    )
                )
                FILTER (
                    YEAR(?date) > 2017 ||
                    (
                        YEAR(?date) = 2017 &&
                        (
                            MONTH(?date) > 1 ||
                            (MONTH(?date) = 1 && DAY(?date) >= 1)
                        )
                    )
                )
                FILTER (
                    ?tankType IN (
                        "oil_residue_tank",
                        "oily_bilge_water_holding_tank"
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?separation qudt:numericValue ?separationValue .
                    } ||
                    EXISTS {
                        ?separation qudt:numericValue ?separationValue1,
                                                      ?separationValue2 .
                        FILTER (?separationValue1 != ?separationValue2)
                    } ||
                    EXISTS {
                        ?separation qudt:numericValue ?invalidSeparationValue .
                        FILTER (
                            DATATYPE(?invalidSeparationValue) != xsd:decimal ||
                            ?invalidSeparationValue < "0.76"^^xsd:decimal
                        )
                    } ||
                    NOT EXISTS {
                        ?separation qudt:unit ?separationUnit .
                    } ||
                    EXISTS {
                        ?separation qudt:unit ?separationUnit1,
                                              ?separationUnit2 .
                        FILTER (?separationUnit1 != ?separationUnit2)
                    } ||
                    EXISTS {
                        ?separation qudt:unit ?wrongSeparationUnit .
                        FILTER (?wrongSeparationUnit != unit:M)
                    }
                )
            }
        """
    ] .
