@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO118Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "Ship category must be single-valued when recorded."
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Sewage discharge status must be single-valued when recorded."
    ] ;
    sh:property [
        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "Paragraph 4.2.1.3 compliance status must be single-valued when recorded."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship constructed on or after 1 January 2017 must have a category unless it is identified as a passenger ship." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionDate ?date .
    FILTER (?date >= "2017-01-01"^^xsd:date)
    FILTER NOT EXISTS {
        $this a nltl:passengerShip .
    }
    FILTER NOT EXISTS {
        $this nltl:shipCategory ?category .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable ship, sewage discharge to sea must be false unless paragraph 4.2.1.3 compliance status is true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionDate ?date .
    FILTER (?date >= "2017-01-01"^^xsd:date)
    FILTER (
        EXISTS {
            $this nltl:shipCategory nltl:polarShipCategoryA .
        }
        ||
        EXISTS {
            $this nltl:shipCategory nltl:polarShipCategoryB .
        }
        ||
        EXISTS {
            $this a nltl:passengerShip .
        }
    )
    FILTER (
        !EXISTS {
            $this nltl:sewageDischargeToSea ?discharge .
            FILTER (?discharge = false)
        }
        &&
        !EXISTS {
            $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ?status .
            FILTER (?status = true)
        }
    )
}
"""
    ] .
