@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:FoodWasteDischargeArcticWatersShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The operating area must be recorded when food waste discharge to sea is recorded as true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:foodWasteDischargeToSea ?discharge .
    FILTER (?discharge = true)
    FILTER NOT EXISTS {
        $this nltl:operatingArea ?area .
        FILTER (DATATYPE(?area) = xsd:string)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The food waste discharge state must be recorded as a boolean for operation in Arctic waters." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:operatingArea ?area .
    FILTER (
        DATATYPE(?area) = xsd:string &&
        ?area = "Arctic_waters"^^xsd:string
    )
    FILTER NOT EXISTS {
        $this nltl:foodWasteDischargeToSea ?discharge .
        FILTER (
            DATATYPE(?discharge) = xsd:boolean &&
            (?discharge IN (true, false))
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Food waste discharge in Arctic waters requires a recorded distance of at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:operatingArea ?area ;
          nltl:foodWasteDischargeToSea ?discharge .
    FILTER (
        DATATYPE(?area) = xsd:string &&
        ?area = "Arctic_waters"^^xsd:string &&
        ?discharge = true
    )
    FILTER NOT EXISTS {
        $this nltl:distanceToNearestLandIceShelfOrFastIce ?distance .
        ?distance a qudt:QuantityValue ;
                  qudt:numericValue ?value ;
                  qudt:unit unit:MI_N .
        FILTER (
            DATATYPE(?value) = xsd:decimal &&
            ?value >= "12"^^xsd:decimal
        )
    }
}
"""
    ] .
