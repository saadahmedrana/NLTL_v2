@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_001_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter9Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "A ship marked as subject to Polar Code chapter 9 must be certified in accordance with SOLAS chapter I." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:polarCodeChapter9Applicable ?applicable .
    FILTER (?applicable = "true"^^xsd:boolean)
    FILTER NOT EXISTS {
        $this nltl:solasChapterICertified ?certified .
        FILTER (?certified = "true"^^xsd:boolean)
    }
}
"""
    ] .
