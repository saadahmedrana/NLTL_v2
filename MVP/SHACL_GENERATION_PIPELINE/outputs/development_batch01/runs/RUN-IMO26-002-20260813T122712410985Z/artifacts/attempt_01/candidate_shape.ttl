@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthOverallMetersValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:M
    ] .

gen:GrossTonnageUnitlessValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:FishingVesselChapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:fishingVessel ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:node gen:LengthOverallMetersValueShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:lengthOverall ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "24"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:lengthOverall ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "24"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "Fishing-vessel Chapter 9-1 applicability must correspond to the 24 m length-overall threshold." .

gen:PleasureYachtChapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:pleasureYacht ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:node gen:GrossTonnageUnitlessValueShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "300"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:engagedInTrade ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "300"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "300"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:engagedInTrade ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "Pleasure-yacht Chapter 9-1 applicability must correspond to gross tonnage and trade status." .

gen:CargoShipChapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:cargoShip ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:node gen:GrossTonnageUnitlessValueShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "300"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "300"^^xsd:decimal ;
                        sh:maxExclusive "500"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "500"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:polarCodeChapter9Dash1Applicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "Cargo-ship Chapter 9-1 applicability must correspond to the 300 inclusive and 500 exclusive gross-tonnage limits." .
