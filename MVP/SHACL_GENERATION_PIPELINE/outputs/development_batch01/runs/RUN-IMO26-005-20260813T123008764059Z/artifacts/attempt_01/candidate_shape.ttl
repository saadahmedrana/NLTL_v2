@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:HeadingPositionSystemSuitabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:headingOrPositionSystem ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:headingOrPositionSystem ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:intendedArea ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An intended area is required for a ship with a heading or position system."
            ] ;
            sh:property [
                sh:path nltl:intendedAreaSuitabilityApprovalStatus ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:message "Heading or position systems must have approved intended-area suitability status."
            ]
        ]
    ) .
