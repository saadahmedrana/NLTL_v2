@prefix gshape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gshape:IMO26-012Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:message "Gross tonnage requires a decimal numeric value."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:message "Gross tonnage must use the unitless unit."
            ]
        ] ;
        sh:message "Gross tonnage information is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:grossTonnage qudt:numericValue ) ;
                sh:maxExclusive "500"^^xsd:decimal
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:grossTonnage qudt:numericValue ) ;
                sh:minInclusive "500"^^xsd:decimal
            ] ;
            sh:property [
                sh:path nltl:nonMagneticHeadingMeansCount ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:minCount 1 ;
                sh:message "A ship of 500 gross tonnage or more must have at least two non-magnetic heading means."
            ] ;
            sh:property [
                sh:path nltl:headingMeansIndependent ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "The non-magnetic heading means must be independent."
            ] ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:message "The non-magnetic heading means must be connected to main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:message "The non-magnetic heading means must be connected to emergency power."
            ]
        ]
    ) .
