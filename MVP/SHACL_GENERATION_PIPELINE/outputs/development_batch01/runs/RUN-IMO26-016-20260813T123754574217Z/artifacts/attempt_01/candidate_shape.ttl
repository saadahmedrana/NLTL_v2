@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:Chapter11Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Polar-waters operating status is required to determine Chapter 11-1 applicability."
    ] ;
    sh:sparql [
        sh:message "A fishing vessel operating in polar waters requires length overall expressed as an xsd:decimal value in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:fishingVessel ;
          nltl:shipOperatesInPolarWaters true .
    FILTER NOT EXISTS {
        $this nltl:lengthOverall ?length .
        ?length qudt:numericValue ?lengthValue ;
                qudt:unit unit:M .
        FILTER(datatype(?lengthValue) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Chapter 11-1 must be recorded as applicable for a fishing vessel operating in polar waters with length overall of at least 24 metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:fishingVessel ;
          nltl:shipOperatesInPolarWaters true ;
          nltl:lengthOverall ?length .
    ?length qudt:numericValue ?lengthValue ;
            qudt:unit unit:M .
    FILTER(
        datatype(?lengthValue) = xsd:decimal &&
        ?lengthValue >= 24.0
    )
    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
        FILTER(
            datatype(?applicable) = xsd:boolean &&
            ?applicable = true
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "A pleasure yacht operating in polar waters requires gross tonnage expressed as an xsd:decimal unitless value." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:pleasureYacht ;
          nltl:shipOperatesInPolarWaters true .
    FILTER NOT EXISTS {
        $this nltl:grossTonnage ?tonnage .
        ?tonnage qudt:numericValue ?tonnageValue ;
                 qudt:unit unit:UNITLESS .
        FILTER(datatype(?tonnageValue) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Trade status is required for a pleasure yacht operating in polar waters with gross tonnage of at least 300." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:pleasureYacht ;
          nltl:shipOperatesInPolarWaters true ;
          nltl:grossTonnage ?tonnage .
    ?tonnage qudt:numericValue ?tonnageValue ;
             qudt:unit unit:UNITLESS .
    FILTER(
        datatype(?tonnageValue) = xsd:decimal &&
        ?tonnageValue >= 300.0
    )
    FILTER NOT EXISTS {
        $this nltl:engagedInTrade ?tradeStatus .
        FILTER(datatype(?tradeStatus) = xsd:boolean)
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Chapter 11-1 must be recorded as applicable for a pleasure yacht operating in polar waters with gross tonnage of at least 300 that is not engaged in trade." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:pleasureYacht ;
          nltl:shipOperatesInPolarWaters true ;
          nltl:grossTonnage ?tonnage ;
          nltl:engagedInTrade false .
    ?tonnage qudt:numericValue ?tonnageValue ;
             qudt:unit unit:UNITLESS .
    FILTER(
        datatype(?tonnageValue) = xsd:decimal &&
        ?tonnageValue >= 300.0
    )
    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
        FILTER(
            datatype(?applicable) = xsd:boolean &&
            ?applicable = true
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "A cargo ship operating in polar waters requires gross tonnage expressed as an xsd:decimal unitless value." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:cargoShip ;
          nltl:shipOperatesInPolarWaters true .
    FILTER NOT EXISTS {
        $this nltl:grossTonnage ?tonnage .
        ?tonnage qudt:numericValue ?tonnageValue ;
                 qudt:unit unit:UNITLESS .
        FILTER(datatype(?tonnageValue) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Chapter 11-1 must be recorded as applicable for a cargo ship operating in polar waters with gross tonnage of at least 300 and below 500." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:cargoShip ;
          nltl:shipOperatesInPolarWaters true ;
          nltl:grossTonnage ?tonnage .
    ?tonnage qudt:numericValue ?tonnageValue ;
             qudt:unit unit:UNITLESS .
    FILTER(
        datatype(?tonnageValue) = xsd:decimal &&
        ?tonnageValue >= 300.0 &&
        ?tonnageValue < 500.0
    )
    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
        FILTER(
            datatype(?applicable) = xsd:boolean &&
            ?applicable = true
        )
    }
}
"""
    ] .
