@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF001Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine regulation applicability."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:message "An ice class is required for every ship irrespective of its year of build."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "A ship contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations as applicable." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#constructionContractDate> ?date .
                FILTER (?date >= "2021-07-05"^^<http://www.w3.org/2001/XMLSchema#date>)
                FILTER NOT EXISTS {
                    $this <https://w3id.org/nltl-benchmark/vocab#applicableIceClassRegulationEdition>
                          <https://w3id.org/nltl-benchmark/vocab#iceClassRegulationEdition2021> .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The applicability of the 2021 chapter 2 Ice Class Draught provisions cannot be validated because the required canonical benchmark term is unavailable." ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER (true)
            }
        """
    ] .
