@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF001ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one construction contract date."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "Every ship must identify an ice class."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassRegulationEditionValue
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship contracted for construction on or after 5 July 2021 must identify the 2021 Ice Class Regulations as applicable." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl-benchmark/vocab#constructionContractDate> ?contractDate .
                FILTER (?contractDate >= "2021-07-05"^^<http://www.w3.org/2001/XMLSchema#date>)
                FILTER NOT EXISTS {
                    $this
                        <https://w3id.org/nltl-benchmark/vocab#applicableIceClassRegulationEdition>
                        <https://w3id.org/nltl-benchmark/vocab#iceClassRegulationEdition2021> .
                }
            }
        """
    ] .
