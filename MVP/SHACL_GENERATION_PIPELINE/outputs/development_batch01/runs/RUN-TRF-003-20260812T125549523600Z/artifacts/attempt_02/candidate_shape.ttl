@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF003Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:message "A recorded construction contract date must be an xsd:date."
    ] ;
    sh:sparql [
        sh:message "A ship contracted on or after 2012-01-01 and before 2019-01-01 must identify the 2010 Ice Class Regulations as applicable." ;
        sh:select """
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (
                    ?contractDate >= "2012-01-01"^^xsd:date &&
                    ?contractDate < "2019-01-01"^^xsd:date
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2010 .
                }
            }
        """
    ] .
