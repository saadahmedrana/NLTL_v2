@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF003Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one construction contract date."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship contracted on or after 2012-01-01 and before 2019-01-01 must have the 2010 Ice Class Regulations as its applicable edition." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:constructionContractDate ?date .
    FILTER(
        ?date >= "2012-01-01"^^xsd:date &&
        ?date < "2019-01-01"^^xsd:date
    )
    {
        FILTER NOT EXISTS {
            $this nltl:applicableIceClassRegulationEdition
                nltl:iceClassRegulationEdition2010 .
        }
    }
    UNION
    {
        $this nltl:applicableIceClassRegulationEdition ?edition .
        FILTER(?edition != nltl:iceClassRegulationEdition2010)
    }
}
"""
    ] .
