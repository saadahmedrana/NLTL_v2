@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF004Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships contracted on or after 2010-01-01 and before 2012-01-01 must identify the 2008 Ice Class Regulations as applicable." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:constructionContractDate ?contractDate .
    FILTER (
        ?contractDate >= "2010-01-01"^^xsd:date &&
        ?contractDate < "2012-01-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:applicableIceClassRegulationEdition
            nltl:iceClassRegulationEdition2008 .
    }
}
"""
    ] .
