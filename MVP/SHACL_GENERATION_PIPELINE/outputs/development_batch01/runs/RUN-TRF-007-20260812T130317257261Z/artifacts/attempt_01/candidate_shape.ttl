@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF007Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable ship requires a valid delivery date to calculate the compliance deadline." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    VALUES ?iceClass {
        nltl:iceClassIaSuper
        nltl:iceClassIa
    }
    FILTER(
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:deliveryDate ?deliveryDate .
        FILTER(DATATYPE(?deliveryDate) = xsd:date)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable ship requires a valid assessment date to determine whether its compliance deadline has elapsed." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    VALUES ?iceClass {
        nltl:iceClassIaSuper
        nltl:iceClassIa
    }
    FILTER(
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:assessmentDate ?assessmentDate .
        FILTER(DATATYPE(?assessmentDate) = xsd:date)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "By the calculated deadline, the ship must use the 2017 section 3.2.2 or section 3.2.4 compliance method." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .
    VALUES ?iceClass {
        nltl:iceClassIaSuper
        nltl:iceClassIa
    }
    FILTER(
        DATATYPE(?constructionDate) = xsd:date &&
        DATATYPE(?deliveryDate) = xsd:date &&
        DATATYPE(?assessmentDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    BIND(YEAR(?deliveryDate) + 20 AS ?deadlineYear)
    BIND(
        STRDT(CONCAT(STR(?deadlineYear), "-01-01"), xsd:date)
        AS ?complianceDeadline
    )
    FILTER(?assessmentDate >= ?complianceDeadline)
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        VALUES ?method {
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        }
    }
}
"""
    ] .
