@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF007Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A valid construction stage date is needed to determine applicability for an IA Super or IA ship that has no recorded permitted compliance method." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER (?method IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ))
    }
    FILTER NOT EXISTS {
        $this nltl:constructionStageDate ?constructionDate .
        FILTER (DATATYPE(?constructionDate) = xsd:date)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Valid delivery and assessment dates are needed when the construction stage predates 1 September 2003 and no permitted compliance method is recorded." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    FILTER (
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER (?method IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ))
    }
    {
        FILTER NOT EXISTS {
            $this nltl:deliveryDate ?deliveryDate .
            FILTER (DATATYPE(?deliveryDate) = xsd:date)
        }
    }
    UNION
    {
        FILTER NOT EXISTS {
            $this nltl:assessmentDate ?assessmentDate .
            FILTER (DATATYPE(?assessmentDate) = xsd:date)
        }
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "By 1 January of the year twenty years after the delivery year, the ship must record compliance under section 3.2.2 or section 3.2.4 of the 2017 Ice Class Regulations." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    FILTER (
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER (DATATYPE(?deliveryDate) = xsd:date)
    FILTER (DATATYPE(?assessmentDate) = xsd:date)
    BIND(
        xsd:date(CONCAT(STR(YEAR(?deliveryDate) + 20), "-01-01"))
        AS ?complianceDeadline
    )
    FILTER (?assessmentDate >= ?complianceDeadline)
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER (?method IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ))
    }
}
"""
    ] .
