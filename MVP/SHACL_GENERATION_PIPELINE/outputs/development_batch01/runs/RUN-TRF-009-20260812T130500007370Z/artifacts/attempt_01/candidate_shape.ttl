@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF009Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A valid delivery date is needed to calculate the compliance deadline." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    FILTER (
        ?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa) &&
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:deliveryDate ?deliveryDate .
        FILTER (DATATYPE(?deliveryDate) = xsd:date)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A valid assessment date is needed to determine whether the compliance deadline has been reached." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate .
    FILTER (
        ?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa) &&
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date &&
        DATATYPE(?deliveryDate) = xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:assessmentDate ?assessmentDate .
        FILTER (DATATYPE(?assessmentDate) = xsd:date)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "By the calculated deadline, compliance must use the 2017 section 3.2.2 or section 3.2.4 method." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .
    FILTER (
        ?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa) &&
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date &&
        DATATYPE(?deliveryDate) = xsd:date &&
        DATATYPE(?assessmentDate) = xsd:date
    )
    BIND(
        xsd:date(
            CONCAT(
                STR(YEAR(?deliveryDate) + 20),
                "-01-01"
            )
        ) AS ?deadline
    )
    FILTER (?assessmentDate >= ?deadline)
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER (
            ?method IN (
                nltl:traficom2017Section3Point2Point2Method,
                nltl:traficom2017Section3Point2Point4Method
            )
        )
    }
}
"""
    ] .
