@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF009ComplianceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA Super or IA ship must use the section 3.2.2 or section 3.2.4 compliance method." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    FILTER (
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER (
            ?method IN (
                nltl:traficom2017Section3Point2Point2Method,
                nltl:traficom2017Section3Point2Point4Method
            )
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable ship must have xsd:date delivery and assessment dates showing compliance no later than the calculated 1 January deadline." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .
    FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    FILTER (
        DATATYPE(?constructionDate) = xsd:date &&
        ?constructionDate < "2003-09-01"^^xsd:date
    )
    FILTER NOT EXISTS {
        $this nltl:deliveryDate ?deliveryDate ;
              nltl:assessmentDate ?assessmentDate .
        FILTER (
            DATATYPE(?deliveryDate) = xsd:date &&
            DATATYPE(?assessmentDate) = xsd:date
        )
        BIND (
            xsd:integer(SUBSTR(STR(?deliveryDate), 1, 4)) + 20
            AS ?deadlineYear
        )
        BIND (
            xsd:date(CONCAT(STR(?deadlineYear), "-01-01"))
            AS ?deadline
        )
        FILTER (?assessmentDate <= ?deadline)
    }
}
"""
    ] .
