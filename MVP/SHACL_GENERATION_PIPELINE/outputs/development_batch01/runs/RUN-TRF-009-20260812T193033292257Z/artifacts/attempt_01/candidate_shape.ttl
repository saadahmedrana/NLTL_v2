@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF009Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA Super or IA ship must use the 2017 section 3.2.2 or 3.2.4 compliance method when its deadline has been reached or cannot be determined from delivery and assessment dates." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .

    FILTER (
        ?iceClass IN (
            nltl:iceClassIaSuper,
            nltl:iceClassIa
        )
    )

    FILTER (
        DATATYPE(?constructionDate) = xsd:date &&
        (
            YEAR(?constructionDate) < 2003 ||
            (
                YEAR(?constructionDate) = 2003 &&
                MONTH(?constructionDate) < 9
            )
        )
    )

    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER (
            ?method IN (
                nltl:traficom2017Section3Point2Point2Method,
                nltl:traficom2017Section3Point2Point4Method
            )
        )
    }

    OPTIONAL {
        $this nltl:deliveryDate ?deliveryDate .
        FILTER (DATATYPE(?deliveryDate) = xsd:date)
    }

    OPTIONAL {
        $this nltl:assessmentDate ?assessmentDate .
        FILTER (DATATYPE(?assessmentDate) = xsd:date)
    }

    FILTER (
        !BOUND(?deliveryDate) ||
        !BOUND(?assessmentDate) ||
        YEAR(?assessmentDate) >= YEAR(?deliveryDate) + 20
    )
}
""" ;
    ] .
