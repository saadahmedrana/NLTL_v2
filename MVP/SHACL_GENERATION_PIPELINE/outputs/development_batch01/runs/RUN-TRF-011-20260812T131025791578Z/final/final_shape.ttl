@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UpperIceWaterlineEnvelopeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gen:WaterlineShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must identify exactly one upper ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gen:WaterlineShape ;
        sh:minCount 1 ;
        sh:message "At least one intended ice-operating waterline is required to determine the upper envelope."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline must contain the maximum intended-waterline vertical coordinate at every represented longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?x
WHERE {
    {
        SELECT $this ?x (MAX(xsd:decimal(?candidateZ)) AS ?maximumZ)
        WHERE {
            $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
            ?intendedPoint nltl:longitudinalPosition ?xQuantity ;
                           nltl:verticalCoordinate ?zQuantity .
            ?xQuantity qudt:numericValue ?x ;
                       qudt:unit unit:M .
            ?zQuantity qudt:numericValue ?candidateZ ;
                       qudt:unit unit:M .
            FILTER(datatype(?x) = xsd:decimal)
            FILTER(datatype(?candidateZ) = xsd:decimal)
        }
        GROUP BY $this ?x
    }
    FILTER NOT EXISTS {
        $this nltl:hasUpperIceWaterline ?upperWaterline .
        ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                    nltl:verticalCoordinate ?upperZQuantity .
        ?upperXQuantity qudt:numericValue ?upperX ;
                        qudt:unit unit:M .
        ?upperZQuantity qudt:numericValue ?upperZ ;
                        qudt:unit unit:M .
        FILTER(datatype(?upperX) = xsd:decimal)
        FILTER(datatype(?upperZ) = xsd:decimal)
        FILTER(xsd:decimal(?upperX) = xsd:decimal(?x))
        FILTER(xsd:decimal(?upperZ) = ?maximumZ)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every upper ice waterline point must equal the intended-waterline maximum at the same longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?upperPoint
WHERE {
    $this nltl:hasUpperIceWaterline ?upperWaterline .
    ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
    ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                nltl:verticalCoordinate ?upperZQuantity .
    ?upperXQuantity qudt:numericValue ?upperX ;
                    qudt:unit unit:M .
    ?upperZQuantity qudt:numericValue ?upperZ ;
                    qudt:unit unit:M .
    FILTER(datatype(?upperX) = xsd:decimal)
    FILTER(datatype(?upperZ) = xsd:decimal)

    FILTER NOT EXISTS {
        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                       nltl:verticalCoordinate ?intendedZQuantity .
        ?intendedXQuantity qudt:numericValue ?intendedX ;
                           qudt:unit unit:M .
        ?intendedZQuantity qudt:numericValue ?intendedZ ;
                           qudt:unit unit:M .
        FILTER(datatype(?intendedX) = xsd:decimal)
        FILTER(datatype(?intendedZ) = xsd:decimal)
        FILTER(xsd:decimal(?intendedX) = xsd:decimal(?upperX))
        FILTER(xsd:decimal(?intendedZ) = xsd:decimal(?upperZ))

        FILTER NOT EXISTS {
            $this nltl:hasIntendedIceOperatingWaterline ?otherWaterline .
            ?otherWaterline nltl:hasWaterlineProfilePoint ?otherPoint .
            ?otherPoint nltl:longitudinalPosition ?otherXQuantity ;
                        nltl:verticalCoordinate ?otherZQuantity .
            ?otherXQuantity qudt:numericValue ?otherX ;
                            qudt:unit unit:M .
            ?otherZQuantity qudt:numericValue ?otherZ ;
                            qudt:unit unit:M .
            FILTER(datatype(?otherX) = xsd:decimal)
            FILTER(datatype(?otherZ) = xsd:decimal)
            FILTER(xsd:decimal(?otherX) = xsd:decimal(?intendedX))
            FILTER(xsd:decimal(?otherZ) > xsd:decimal(?intendedZ))
        }
    }
}
"""
    ] .

gen:WaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:node gen:WaterlineProfilePointShape ;
        sh:minCount 1 ;
        sh:message "A waterline must have at least one profile point."
    ] .

gen:WaterlineProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each waterline profile point must have exactly one longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each waterline profile point must have exactly one vertical coordinate in metres."
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must have exactly one unit, metre."
    ] .
