@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF011ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gs:TRF011WaterlineShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship shall identify exactly one upper ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gs:TRF011WaterlineShape ;
        sh:minCount 1 ;
        sh:message "At least one intended ice operating waterline is required to establish the upper envelope."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every highest intended-operating-waterline point shall occur on the upper ice waterline at the same longitudinal position and vertical coordinate." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasUpperIceWaterline ?upper ;
          nltl:hasIntendedIceOperatingWaterline ?intended .
    ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
    ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                   nltl:verticalCoordinate ?intendedZQuantity .
    ?intendedXQuantity qudt:numericValue ?x ;
                       qudt:unit unit:M .
    ?intendedZQuantity qudt:numericValue ?z ;
                       qudt:unit unit:M .

    FILTER NOT EXISTS {
        $this nltl:hasIntendedIceOperatingWaterline ?otherIntended .
        ?otherIntended nltl:hasWaterlineProfilePoint ?higherPoint .
        ?higherPoint nltl:longitudinalPosition ?higherXQuantity ;
                     nltl:verticalCoordinate ?higherZQuantity .
        ?higherXQuantity qudt:numericValue ?higherX ;
                         qudt:unit unit:M .
        ?higherZQuantity qudt:numericValue ?higherZ ;
                         qudt:unit unit:M .
        FILTER (
            xsd:decimal(?higherX) = xsd:decimal(?x) &&
            xsd:decimal(?higherZ) > xsd:decimal(?z)
        )
    }

    FILTER NOT EXISTS {
        ?upper nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                    nltl:verticalCoordinate ?upperZQuantity .
        ?upperXQuantity qudt:numericValue ?upperX ;
                        qudt:unit unit:M .
        ?upperZQuantity qudt:numericValue ?upperZ ;
                        qudt:unit unit:M .
        FILTER (
            xsd:decimal(?upperX) = xsd:decimal(?x) &&
            xsd:decimal(?upperZ) = xsd:decimal(?z)
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every upper-ice-waterline point shall coincide with an intended-operating-waterline point and shall have no higher intended point at the same longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasUpperIceWaterline ?upper .
    ?upper nltl:hasWaterlineProfilePoint ?upperPoint .
    ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                nltl:verticalCoordinate ?upperZQuantity .
    ?upperXQuantity qudt:numericValue ?upperX ;
                    qudt:unit unit:M .
    ?upperZQuantity qudt:numericValue ?upperZ ;
                    qudt:unit unit:M .

    FILTER (
        NOT EXISTS {
            $this nltl:hasIntendedIceOperatingWaterline ?matchingIntended .
            ?matchingIntended nltl:hasWaterlineProfilePoint ?matchingPoint .
            ?matchingPoint nltl:longitudinalPosition ?matchingXQuantity ;
                           nltl:verticalCoordinate ?matchingZQuantity .
            ?matchingXQuantity qudt:numericValue ?matchingX ;
                               qudt:unit unit:M .
            ?matchingZQuantity qudt:numericValue ?matchingZ ;
                               qudt:unit unit:M .
            FILTER (
                xsd:decimal(?matchingX) = xsd:decimal(?upperX) &&
                xsd:decimal(?matchingZ) = xsd:decimal(?upperZ)
            )
        }
        ||
        EXISTS {
            $this nltl:hasIntendedIceOperatingWaterline ?higherIntended .
            ?higherIntended nltl:hasWaterlineProfilePoint ?higherPoint .
            ?higherPoint nltl:longitudinalPosition ?higherXQuantity ;
                         nltl:verticalCoordinate ?higherZQuantity .
            ?higherXQuantity qudt:numericValue ?higherX ;
                             qudt:unit unit:M .
            ?higherZQuantity qudt:numericValue ?higherZ ;
                             qudt:unit unit:M .
            FILTER (
                xsd:decimal(?higherX) = xsd:decimal(?upperX) &&
                xsd:decimal(?higherZ) > xsd:decimal(?upperZ)
            )
        }
    )
}
"""
    ] .

gs:TRF011WaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:node gs:TRF011ProfilePointShape ;
        sh:minCount 1 ;
        sh:message "Each waterline shall provide at least one profile point."
    ] .

gs:TRF011ProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:class qudt:QuantityValue ;
        sh:node gs:TRF011MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each profile point shall have exactly one longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:class qudt:QuantityValue ;
        sh:node gs:TRF011MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each profile point shall have exactly one vertical coordinate in metres."
    ] .

gs:TRF011MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity shall have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity shall have exactly one unit, metre."
    ] .
