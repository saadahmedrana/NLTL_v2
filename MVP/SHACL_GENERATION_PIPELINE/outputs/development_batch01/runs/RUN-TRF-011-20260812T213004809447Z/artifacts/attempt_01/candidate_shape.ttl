@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF011ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gs:TRF011WaterlineShape ;
        sh:message "An upper ice waterline with a usable profile is required."
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gs:TRF011WaterlineShape ;
        sh:message "An intended ice-operating waterline with a usable profile is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline must be the envelope of the highest intended ice-operating waterline points at corresponding longitudinal positions, using relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    FILTER (
        EXISTS {
            $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
            ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                           nltl:verticalCoordinate ?intendedZQuantity .
            ?intendedXQuantity qudt:numericValue ?intendedX ;
                               qudt:unit unit:M .
            ?intendedZQuantity qudt:numericValue ?intendedZ ;
                               qudt:unit unit:M .
            FILTER NOT EXISTS {
                $this nltl:hasUpperIceWaterline ?upperWaterline .
                ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
                ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                            nltl:verticalCoordinate ?upperZQuantity .
                ?upperXQuantity qudt:numericValue ?upperX ;
                                qudt:unit unit:M .
                ?upperZQuantity qudt:numericValue ?upperZ ;
                                qudt:unit unit:M .
                FILTER (
                    ABS(?upperX - ?intendedX) <=
                    (
                        "0.000000001"^^xsd:decimal +
                        "0.000001"^^xsd:decimal *
                        IF(ABS(?upperX) > ABS(?intendedX), ABS(?upperX), ABS(?intendedX))
                    )
                )
                FILTER (
                    ?upperZ +
                    (
                        "0.000000001"^^xsd:decimal +
                        "0.000001"^^xsd:decimal *
                        IF(ABS(?upperZ) > ABS(?intendedZ), ABS(?upperZ), ABS(?intendedZ))
                    )
                    >= ?intendedZ
                )
            }
        }
        ||
        EXISTS {
            $this nltl:hasUpperIceWaterline ?upperWaterline .
            ?upperWaterline nltl:hasWaterlineProfilePoint ?upperPoint .
            ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                        nltl:verticalCoordinate ?upperZQuantity .
            ?upperXQuantity qudt:numericValue ?upperX ;
                            qudt:unit unit:M .
            ?upperZQuantity qudt:numericValue ?upperZ ;
                            qudt:unit unit:M .
            FILTER NOT EXISTS {
                $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
                ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                               nltl:verticalCoordinate ?intendedZQuantity .
                ?intendedXQuantity qudt:numericValue ?intendedX ;
                                   qudt:unit unit:M .
                ?intendedZQuantity qudt:numericValue ?intendedZ ;
                                   qudt:unit unit:M .
                FILTER (
                    ABS(?upperX - ?intendedX) <=
                    (
                        "0.000000001"^^xsd:decimal +
                        "0.000001"^^xsd:decimal *
                        IF(ABS(?upperX) > ABS(?intendedX), ABS(?upperX), ABS(?intendedX))
                    )
                )
                FILTER (
                    ABS(?upperZ - ?intendedZ) <=
                    (
                        "0.000000001"^^xsd:decimal +
                        "0.000001"^^xsd:decimal *
                        IF(ABS(?upperZ) > ABS(?intendedZ), ABS(?upperZ), ABS(?intendedZ))
                    )
                )
            }
        }
    )
}
"""
    ] .

gs:TRF011WaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:node gs:TRF011ProfilePointShape ;
        sh:message "A waterline must provide profile points with longitudinal and vertical coordinates."
    ] .

gs:TRF011ProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:minCount 1 ;
        sh:node gs:TRF011LengthQuantityShape ;
        sh:message "A waterline profile point requires a longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:minCount 1 ;
        sh:node gs:TRF011LengthQuantityShape ;
        sh:message "A waterline profile point requires a vertical coordinate in metres."
    ] .

gs:TRF011LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:M
    ] .
