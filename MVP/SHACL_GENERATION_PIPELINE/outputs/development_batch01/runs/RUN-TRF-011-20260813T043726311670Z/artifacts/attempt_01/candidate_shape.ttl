@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UpperIceWaterlineEnvelopeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gen:WaterlineShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify an upper ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gen:WaterlineShape ;
        sh:minCount 1 ;
        sh:message "At least one intended ice operating waterline is required to establish the upper envelope."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every intended operating-waterline point must have an upper-waterline point at the same longitudinal position whose vertical coordinate is not lower." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasIntendedIceOperatingWaterline ?intendedLine .
    ?intendedLine nltl:hasWaterlineProfilePoint ?intendedPoint .
    ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                   nltl:verticalCoordinate ?intendedZQuantity .
    ?intendedXQuantity qudt:numericValue ?intendedX ;
                       qudt:unit unit:M .
    ?intendedZQuantity qudt:numericValue ?intendedZ ;
                       qudt:unit unit:M .
    FILTER NOT EXISTS {
        $this nltl:hasUpperIceWaterline ?upperLine .
        ?upperLine nltl:hasWaterlineProfilePoint ?upperPoint .
        ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                    nltl:verticalCoordinate ?upperZQuantity .
        ?upperXQuantity qudt:numericValue ?upperX ;
                        qudt:unit unit:M .
        ?upperZQuantity qudt:numericValue ?upperZ ;
                        qudt:unit unit:M .
        FILTER(?upperX = ?intendedX && ?upperZ >= ?intendedZ)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every upper-waterline profile point must coincide with a highest point of an intended ice operating waterline at the same longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasUpperIceWaterline ?upperLine .
    ?upperLine nltl:hasWaterlineProfilePoint ?upperPoint .
    ?upperPoint nltl:longitudinalPosition ?upperXQuantity ;
                nltl:verticalCoordinate ?upperZQuantity .
    ?upperXQuantity qudt:numericValue ?upperX ;
                    qudt:unit unit:M .
    ?upperZQuantity qudt:numericValue ?upperZ ;
                    qudt:unit unit:M .
    FILTER NOT EXISTS {
        $this nltl:hasIntendedIceOperatingWaterline ?intendedLine .
        ?intendedLine nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                       nltl:verticalCoordinate ?intendedZQuantity .
        ?intendedXQuantity qudt:numericValue ?intendedX ;
                           qudt:unit unit:M .
        ?intendedZQuantity qudt:numericValue ?intendedZ ;
                           qudt:unit unit:M .
        FILTER(?intendedX = ?upperX && ?intendedZ = ?upperZ)
    }
}
"""
    ] .

gen:WaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:node gen:WaterlineProfilePointShape ;
        sh:minCount 1 ;
        sh:message "A waterline must provide at least one profile point."
    ] .

gen:WaterlineProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each waterline profile point must have one longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each waterline profile point must have one vertical coordinate in metres."
    ] .

gen:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .
