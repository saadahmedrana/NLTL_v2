@prefix gs: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:LowerIceWaterlineEnvelopeShape
    a sh:NodeShape ;
    sh:targetClass <https://w3id.org/nltl-benchmark/vocab#ship> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Lower ice waterline envelope calculation requires typed waterlines and profile points with decimal longitudinal and vertical coordinates in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    FILTER (
        NOT EXISTS {
            $this nltl:hasLowerIceWaterline ?lower .
            ?lower a nltl:iceWaterline .
        }
        ||
        NOT EXISTS {
            $this nltl:hasIntendedIceOperatingWaterline ?intended .
            ?intended a nltl:iceWaterline .
        }
        ||
        EXISTS {
            {
                $this nltl:hasLowerIceWaterline ?waterline .
            }
            UNION
            {
                $this nltl:hasIntendedIceOperatingWaterline ?waterline .
            }
            FILTER (
                !isIRI(?waterline)
                ||
                NOT EXISTS { ?waterline a nltl:iceWaterline . }
                ||
                NOT EXISTS {
                    ?waterline nltl:hasWaterlineProfilePoint ?point .
                }
            )
        }
        ||
        EXISTS {
            {
                $this nltl:hasLowerIceWaterline ?waterline .
            }
            UNION
            {
                $this nltl:hasIntendedIceOperatingWaterline ?waterline .
            }
            ?waterline nltl:hasWaterlineProfilePoint ?point .
            FILTER (
                !isIRI(?point)
                ||
                NOT EXISTS { ?point a nltl:waterlineProfilePoint . }
                ||
                NOT EXISTS {
                    ?point nltl:longitudinalPosition ?xQuantity .
                    ?xQuantity qudt:numericValue ?x ;
                               qudt:unit unit:M .
                    FILTER(datatype(?x) = xsd:decimal)
                }
                ||
                NOT EXISTS {
                    ?point nltl:verticalCoordinate ?zQuantity .
                    ?zQuantity qudt:numericValue ?z ;
                               qudt:unit unit:M .
                    FILTER(datatype(?z) = xsd:decimal)
                }
            )
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lower ice waterline is missing a lowest intended operating-waterline point at a represented longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasIntendedIceOperatingWaterline ?intended .
    ?intended a nltl:iceWaterline ;
              nltl:hasWaterlineProfilePoint ?point .
    ?point a nltl:waterlineProfilePoint ;
           nltl:longitudinalPosition ?xQuantity ;
           nltl:verticalCoordinate ?zQuantity .
    ?xQuantity qudt:numericValue ?x ;
               qudt:unit unit:M .
    ?zQuantity qudt:numericValue ?z ;
               qudt:unit unit:M .
    FILTER(datatype(?x) = xsd:decimal)
    FILTER(datatype(?z) = xsd:decimal)

    FILTER NOT EXISTS {
        $this nltl:hasIntendedIceOperatingWaterline ?otherIntended .
        ?otherIntended a nltl:iceWaterline ;
                       nltl:hasWaterlineProfilePoint ?otherPoint .
        ?otherPoint a nltl:waterlineProfilePoint ;
                    nltl:longitudinalPosition ?otherXQuantity ;
                    nltl:verticalCoordinate ?otherZQuantity .
        ?otherXQuantity qudt:numericValue ?otherX ;
                        qudt:unit unit:M .
        ?otherZQuantity qudt:numericValue ?otherZ ;
                        qudt:unit unit:M .
        FILTER(datatype(?otherX) = xsd:decimal)
        FILTER(datatype(?otherZ) = xsd:decimal)
        FILTER(?otherX = ?x && ?otherZ < ?z)
    }

    FILTER NOT EXISTS {
        $this nltl:hasLowerIceWaterline ?lower .
        ?lower a nltl:iceWaterline ;
               nltl:hasWaterlineProfilePoint ?lowerPoint .
        ?lowerPoint a nltl:waterlineProfilePoint ;
                    nltl:longitudinalPosition ?lowerXQuantity ;
                    nltl:verticalCoordinate ?lowerZQuantity .
        ?lowerXQuantity qudt:numericValue ?lowerX ;
                        qudt:unit unit:M .
        ?lowerZQuantity qudt:numericValue ?lowerZ ;
                        qudt:unit unit:M .
        FILTER(datatype(?lowerX) = xsd:decimal)
        FILTER(datatype(?lowerZ) = xsd:decimal)
        FILTER(?lowerX = ?x && ?lowerZ = ?z)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A lower ice waterline point is not a lowest intended operating-waterline point at the same longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasLowerIceWaterline ?lower .
    ?lower a nltl:iceWaterline ;
           nltl:hasWaterlineProfilePoint ?lowerPoint .
    ?lowerPoint a nltl:waterlineProfilePoint ;
                nltl:longitudinalPosition ?lowerXQuantity ;
                nltl:verticalCoordinate ?lowerZQuantity .
    ?lowerXQuantity qudt:numericValue ?lowerX ;
                    qudt:unit unit:M .
    ?lowerZQuantity qudt:numericValue ?lowerZ ;
                    qudt:unit unit:M .
    FILTER(datatype(?lowerX) = xsd:decimal)
    FILTER(datatype(?lowerZ) = xsd:decimal)

    FILTER NOT EXISTS {
        $this nltl:hasIntendedIceOperatingWaterline ?intended .
        ?intended a nltl:iceWaterline ;
                  nltl:hasWaterlineProfilePoint ?point .
        ?point a nltl:waterlineProfilePoint ;
               nltl:longitudinalPosition ?xQuantity ;
               nltl:verticalCoordinate ?zQuantity .
        ?xQuantity qudt:numericValue ?x ;
                   qudt:unit unit:M .
        ?zQuantity qudt:numericValue ?z ;
                   qudt:unit unit:M .
        FILTER(datatype(?x) = xsd:decimal)
        FILTER(datatype(?z) = xsd:decimal)
        FILTER(?x = ?lowerX && ?z = ?lowerZ)

        FILTER NOT EXISTS {
            $this nltl:hasIntendedIceOperatingWaterline ?otherIntended .
            ?otherIntended a nltl:iceWaterline ;
                           nltl:hasWaterlineProfilePoint ?otherPoint .
            ?otherPoint a nltl:waterlineProfilePoint ;
                        nltl:longitudinalPosition ?otherXQuantity ;
                        nltl:verticalCoordinate ?otherZQuantity .
            ?otherXQuantity qudt:numericValue ?otherX ;
                            qudt:unit unit:M .
            ?otherZQuantity qudt:numericValue ?otherZ ;
                            qudt:unit unit:M .
            FILTER(datatype(?otherX) = xsd:decimal)
            FILTER(datatype(?otherZ) = xsd:decimal)
            FILTER(?otherX = ?lowerX && ?otherZ < ?z)
        }
    }
}
"""
    ] .
