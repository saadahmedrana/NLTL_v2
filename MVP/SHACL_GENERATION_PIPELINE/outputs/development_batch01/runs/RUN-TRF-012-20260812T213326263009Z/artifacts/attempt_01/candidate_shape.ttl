@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LowerIceWaterlineShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gen:IceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "At least one intended ice operating waterline is required."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:node gen:IceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "A lower ice waterline is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each lower ice waterline profile point must have intended-waterline data at the same longitudinal position." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasLowerIceWaterline ?lowerWaterline .
    ?lowerWaterline nltl:hasWaterlineProfilePoint ?lowerPoint .
    ?lowerPoint nltl:longitudinalPosition ?lowerPosition .
    ?lowerPosition qudt:numericValue ?lowerX .
    FILTER NOT EXISTS {
        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
        ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
        ?intendedPoint nltl:longitudinalPosition ?intendedPosition .
        ?intendedPosition qudt:numericValue ?intendedX .
        FILTER(
            ABS(?lowerX - ?intendedX) <=
            (0.000001 * IF(ABS(?lowerX) > 1, ABS(?lowerX), 1))
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The lower ice waterline vertical coordinate must equal the lowest intended-waterline coordinate at the same longitudinal position within a relative tolerance of 1e-6." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasLowerIceWaterline ?lowerWaterline ;
          nltl:hasIntendedIceOperatingWaterline ?intendedWaterline .
    ?lowerWaterline nltl:hasWaterlineProfilePoint ?lowerPoint .
    ?lowerPoint nltl:longitudinalPosition ?lowerPosition ;
                nltl:verticalCoordinate ?lowerVertical .
    ?lowerPosition qudt:numericValue ?lowerX .
    ?lowerVertical qudt:numericValue ?lowerY .

    ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
    ?intendedPoint nltl:longitudinalPosition ?intendedPosition ;
                   nltl:verticalCoordinate ?intendedVertical .
    ?intendedPosition qudt:numericValue ?intendedX .
    ?intendedVertical qudt:numericValue ?intendedY .

    FILTER(
        ABS(?lowerX - ?intendedX) <=
        (0.000001 * IF(ABS(?lowerX) > 1, ABS(?lowerX), 1))
    )
}
GROUP BY $this ?lowerPoint ?lowerY
HAVING(
    ABS(?lowerY - MIN(?intendedY)) >
    (0.000001 * IF(ABS(MIN(?intendedY)) > 1, ABS(MIN(?intendedY)), 1))
)
"""
    ] .

gen:IceWaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:node gen:WaterlineProfilePointShape ;
        sh:minCount 1 ;
        sh:message "The ice waterline must have at least one profile point."
    ] .

gen:WaterlineProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:node gen:LengthQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "A waterline profile point requires a longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:node gen:LengthQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "A waterline profile point requires a vertical coordinate in metres."
    ] .

gen:LengthQuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .
