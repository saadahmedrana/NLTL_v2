@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

g:TRF013Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An explicitly ice-strengthened ship must provide its ice class, upper and lower ice waterlines, and fore and aft draught values in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipIceStrengthened "true"^^xsd:boolean .
    FILTER NOT EXISTS {
        $this nltl:iceClass ?iceClass ;
              nltl:hasUpperIceWaterline ?upper ;
              nltl:hasLowerIceWaterline ?lower ;
              nltl:operatingForeDraught ?operatingFore ;
              nltl:operatingAftDraught ?operatingAft .

        FILTER(isIRI(?iceClass))
        FILTER(isIRI(?upper))
        FILTER(isIRI(?lower))

        ?upper a nltl:iceWaterline ;
               nltl:draughtAtForePerpendicular ?upperFore ;
               nltl:draughtAtAftPerpendicular ?upperAft .

        ?lower a nltl:iceWaterline ;
               nltl:draughtAtForePerpendicular ?lowerFore ;
               nltl:draughtAtAftPerpendicular ?lowerAft .

        ?upperFore a qudt:QuantityValue ;
                   qudt:numericValue ?upperForeValue ;
                   qudt:unit unit:M .
        ?lowerFore a qudt:QuantityValue ;
                   qudt:numericValue ?lowerForeValue ;
                   qudt:unit unit:M .
        ?upperAft a qudt:QuantityValue ;
                  qudt:numericValue ?upperAftValue ;
                  qudt:unit unit:M .
        ?lowerAft a qudt:QuantityValue ;
                  qudt:numericValue ?lowerAftValue ;
                  qudt:unit unit:M .
        ?operatingFore a qudt:QuantityValue ;
                       qudt:numericValue ?operatingForeValue ;
                       qudt:unit unit:M .
        ?operatingAft a qudt:QuantityValue ;
                      qudt:numericValue ?operatingAftValue ;
                      qudt:unit unit:M .

        FILTER(
            datatype(?upperForeValue) = xsd:decimal &&
            datatype(?lowerForeValue) = xsd:decimal &&
            datatype(?upperAftValue) = xsd:decimal &&
            datatype(?lowerAftValue) = xsd:decimal &&
            datatype(?operatingForeValue) = xsd:decimal &&
            datatype(?operatingAftValue) = xsd:decimal
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The operating fore and aft draughts must be between the corresponding lower and upper ice-waterline draughts." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipIceStrengthened "true"^^xsd:boolean ;
          nltl:hasUpperIceWaterline ?upper ;
          nltl:hasLowerIceWaterline ?lower ;
          nltl:operatingForeDraught ?operatingFore ;
          nltl:operatingAftDraught ?operatingAft .

    ?upper nltl:draughtAtForePerpendicular ?upperFore ;
           nltl:draughtAtAftPerpendicular ?upperAft .
    ?lower nltl:draughtAtForePerpendicular ?lowerFore ;
           nltl:draughtAtAftPerpendicular ?lowerAft .

    ?upperFore qudt:numericValue ?upperForeValue ;
               qudt:unit unit:M .
    ?lowerFore qudt:numericValue ?lowerForeValue ;
               qudt:unit unit:M .
    ?upperAft qudt:numericValue ?upperAftValue ;
              qudt:unit unit:M .
    ?lowerAft qudt:numericValue ?lowerAftValue ;
              qudt:unit unit:M .
    ?operatingFore qudt:numericValue ?operatingForeValue ;
                   qudt:unit unit:M .
    ?operatingAft qudt:numericValue ?operatingAftValue ;
                  qudt:unit unit:M .

    FILTER(
        datatype(?upperForeValue) = xsd:decimal &&
        datatype(?lowerForeValue) = xsd:decimal &&
        datatype(?upperAftValue) = xsd:decimal &&
        datatype(?lowerAftValue) = xsd:decimal &&
        datatype(?operatingForeValue) = xsd:decimal &&
        datatype(?operatingAftValue) = xsd:decimal
    )

    FILTER(
        ?operatingForeValue < ?lowerForeValue ||
        ?operatingForeValue > ?upperForeValue ||
        ?operatingAftValue < ?lowerAftValue ||
        ?operatingAftValue > ?upperAftValue
    )
}
"""
    ] .
