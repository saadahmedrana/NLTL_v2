@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF013Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ice-strengthened ships require upper, lower, and operating fore and aft draught values in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    VALUES ?iceClass {
        nltl:iceClassIaSuper
        nltl:iceClassIa
        nltl:iceClassIb
        nltl:iceClassIc
    }
    FILTER NOT EXISTS {
        $this nltl:hasLowerIceWaterline ?lowerWaterline ;
              nltl:hasUpperIceWaterline ?upperWaterline ;
              nltl:operatingForeDraught ?operatingFore ;
              nltl:operatingAftDraught ?operatingAft .

        ?lowerWaterline a nltl:iceWaterline ;
            nltl:draughtAtForePerpendicular ?lowerFore ;
            nltl:draughtAtAftPerpendicular ?lowerAft .

        ?upperWaterline a nltl:iceWaterline ;
            nltl:draughtAtForePerpendicular ?upperFore ;
            nltl:draughtAtAftPerpendicular ?upperAft .

        ?lowerFore a qudt:QuantityValue ;
            qudt:numericValue ?lowerForeValue ;
            qudt:unit unit:M .
        ?upperFore a qudt:QuantityValue ;
            qudt:numericValue ?upperForeValue ;
            qudt:unit unit:M .
        ?lowerAft a qudt:QuantityValue ;
            qudt:numericValue ?lowerAftValue ;
            qudt:unit unit:M .
        ?upperAft a qudt:QuantityValue ;
            qudt:numericValue ?upperAftValue ;
            qudt:unit unit:M .
        ?operatingFore a qudt:QuantityValue ;
            qudt:numericValue ?operatingForeValue ;
            qudt:unit unit:M .
        ?operatingAft a qudt:QuantityValue ;
            qudt:numericValue ?operatingAftValue ;
            qudt:unit unit:M .

        FILTER(
            datatype(?lowerForeValue) = xsd:decimal &&
            datatype(?upperForeValue) = xsd:decimal &&
            datatype(?lowerAftValue) = xsd:decimal &&
            datatype(?upperAftValue) = xsd:decimal &&
            datatype(?operatingForeValue) = xsd:decimal &&
            datatype(?operatingAftValue) = xsd:decimal
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Operating fore and aft draughts must be between the corresponding lower and upper ice waterlines." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:hasLowerIceWaterline ?lowerWaterline ;
          nltl:hasUpperIceWaterline ?upperWaterline ;
          nltl:operatingForeDraught ?operatingFore ;
          nltl:operatingAftDraught ?operatingAft .

    VALUES ?iceClass {
        nltl:iceClassIaSuper
        nltl:iceClassIa
        nltl:iceClassIb
        nltl:iceClassIc
    }

    ?lowerWaterline a nltl:iceWaterline ;
        nltl:draughtAtForePerpendicular ?lowerFore ;
        nltl:draughtAtAftPerpendicular ?lowerAft .

    ?upperWaterline a nltl:iceWaterline ;
        nltl:draughtAtForePerpendicular ?upperFore ;
        nltl:draughtAtAftPerpendicular ?upperAft .

    ?lowerFore a qudt:QuantityValue ;
        qudt:numericValue ?lowerForeValue ;
        qudt:unit unit:M .
    ?upperFore a qudt:QuantityValue ;
        qudt:numericValue ?upperForeValue ;
        qudt:unit unit:M .
    ?lowerAft a qudt:QuantityValue ;
        qudt:numericValue ?lowerAftValue ;
        qudt:unit unit:M .
    ?upperAft a qudt:QuantityValue ;
        qudt:numericValue ?upperAftValue ;
        qudt:unit unit:M .
    ?operatingFore a qudt:QuantityValue ;
        qudt:numericValue ?operatingForeValue ;
        qudt:unit unit:M .
    ?operatingAft a qudt:QuantityValue ;
        qudt:numericValue ?operatingAftValue ;
        qudt:unit unit:M .

    FILTER(
        datatype(?lowerForeValue) = xsd:decimal &&
        datatype(?upperForeValue) = xsd:decimal &&
        datatype(?lowerAftValue) = xsd:decimal &&
        datatype(?upperAftValue) = xsd:decimal &&
        datatype(?operatingForeValue) = xsd:decimal &&
        datatype(?operatingAftValue) = xsd:decimal
    )

    FILTER(
        ?lowerForeValue > ?operatingForeValue ||
        ?operatingForeValue > ?upperForeValue ||
        ?lowerAftValue > ?operatingAftValue ||
        ?operatingAftValue > ?upperAftValue
    )
}
""" ;
    ] .
