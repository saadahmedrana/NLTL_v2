@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IceClassDraughtShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Ice-strengthened ships require complete upper and lower ice-waterline and operating-draught values in metres at both perpendiculars." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:hasUpperIceWaterline ?upperWaterline ;
                               nltl:hasLowerIceWaterline ?lowerWaterline ;
                               nltl:operatingForeDraught ?operatingFore ;
                               nltl:operatingAftDraught ?operatingAft .
                    ?upperWaterline nltl:draughtAtForePerpendicular ?upperFore ;
                                    nltl:draughtAtAftPerpendicular ?upperAft .
                    ?lowerWaterline nltl:draughtAtForePerpendicular ?lowerFore ;
                                    nltl:draughtAtAftPerpendicular ?lowerAft .
                    ?operatingFore qudt:numericValue ?operatingForeValue ;
                                   qudt:unit unit:M .
                    ?operatingAft qudt:numericValue ?operatingAftValue ;
                                  qudt:unit unit:M .
                    ?upperFore qudt:numericValue ?upperForeValue ;
                               qudt:unit unit:M .
                    ?upperAft qudt:numericValue ?upperAftValue ;
                              qudt:unit unit:M .
                    ?lowerFore qudt:numericValue ?lowerForeValue ;
                               qudt:unit unit:M .
                    ?lowerAft qudt:numericValue ?lowerAftValue ;
                              qudt:unit unit:M .
                    FILTER (
                        datatype(?operatingForeValue) = xsd:decimal &&
                        datatype(?operatingAftValue) = xsd:decimal &&
                        datatype(?upperForeValue) = xsd:decimal &&
                        datatype(?upperAftValue) = xsd:decimal &&
                        datatype(?lowerForeValue) = xsd:decimal &&
                        datatype(?lowerAftValue) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The operating fore draught must be between the lower and upper ice-waterline draughts." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:hasComponent ?component .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                ?component nltl:hasUpperIceWaterline ?upperWaterline ;
                           nltl:hasLowerIceWaterline ?lowerWaterline ;
                           nltl:operatingForeDraught ?operatingFore .
                ?upperWaterline nltl:draughtAtForePerpendicular ?upperFore .
                ?lowerWaterline nltl:draughtAtForePerpendicular ?lowerFore .
                ?operatingFore qudt:numericValue ?operatingValue ;
                               qudt:unit unit:M .
                ?upperFore qudt:numericValue ?upperValue ;
                           qudt:unit unit:M .
                ?lowerFore qudt:numericValue ?lowerValue ;
                           qudt:unit unit:M .
                FILTER (
                    datatype(?operatingValue) = xsd:decimal &&
                    datatype(?upperValue) = xsd:decimal &&
                    datatype(?lowerValue) = xsd:decimal
                )
                FILTER (
                    ?operatingValue < ?lowerValue ||
                    ?operatingValue > ?upperValue
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The operating aft draught must be between the lower and upper ice-waterline draughts." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:hasComponent ?component .
                FILTER (
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                ?component nltl:hasUpperIceWaterline ?upperWaterline ;
                           nltl:hasLowerIceWaterline ?lowerWaterline ;
                           nltl:operatingAftDraught ?operatingAft .
                ?upperWaterline nltl:draughtAtAftPerpendicular ?upperAft .
                ?lowerWaterline nltl:draughtAtAftPerpendicular ?lowerAft .
                ?operatingAft qudt:numericValue ?operatingValue ;
                              qudt:unit unit:M .
                ?upperAft qudt:numericValue ?upperValue ;
                          qudt:unit unit:M .
                ?lowerAft qudt:numericValue ?lowerValue ;
                          qudt:unit unit:M .
                FILTER (
                    datatype(?operatingValue) = xsd:decimal &&
                    datatype(?upperValue) = xsd:decimal &&
                    datatype(?lowerValue) = xsd:decimal
                )
                FILTER (
                    ?operatingValue < ?lowerValue ||
                    ?operatingValue > ?upperValue
                )
            }
        """
    ] .
