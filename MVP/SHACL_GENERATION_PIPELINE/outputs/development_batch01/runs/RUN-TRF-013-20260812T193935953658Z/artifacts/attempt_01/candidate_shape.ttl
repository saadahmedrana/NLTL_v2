@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IceClassDraughtBoundsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice-strengthened ice classes, fore and aft operating draughts must be expressed in metres and lie between the corresponding lower and upper ice-waterline draughts." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass .
    FILTER (
        ?iceClass IN (
            nltl:iceClassIaSuper,
            nltl:iceClassIa,
            nltl:iceClassIb,
            nltl:iceClassIc
        )
    )

    OPTIONAL {
        $this nltl:hasUpperIceWaterline ?upperWaterline .
        OPTIONAL {
            ?upperWaterline nltl:draughtAtForePerpendicular ?upperForeQuantity .
            OPTIONAL {
                ?upperForeQuantity qudt:numericValue ?upperForeValue .
                OPTIONAL { ?upperForeQuantity qudt:unit ?upperForeUnit . }
            }
        }
        OPTIONAL {
            ?upperWaterline nltl:draughtAtAftPerpendicular ?upperAftQuantity .
            OPTIONAL {
                ?upperAftQuantity qudt:numericValue ?upperAftValue .
                OPTIONAL { ?upperAftQuantity qudt:unit ?upperAftUnit . }
            }
        }
    }

    OPTIONAL {
        $this nltl:hasLowerIceWaterline ?lowerWaterline .
        OPTIONAL {
            ?lowerWaterline nltl:draughtAtForePerpendicular ?lowerForeQuantity .
            OPTIONAL {
                ?lowerForeQuantity qudt:numericValue ?lowerForeValue .
                OPTIONAL { ?lowerForeQuantity qudt:unit ?lowerForeUnit . }
            }
        }
        OPTIONAL {
            ?lowerWaterline nltl:draughtAtAftPerpendicular ?lowerAftQuantity .
            OPTIONAL {
                ?lowerAftQuantity qudt:numericValue ?lowerAftValue .
                OPTIONAL { ?lowerAftQuantity qudt:unit ?lowerAftUnit . }
            }
        }
    }

    OPTIONAL {
        $this nltl:operatingForeDraught ?operatingForeQuantity .
        OPTIONAL {
            ?operatingForeQuantity qudt:numericValue ?operatingForeValue .
            OPTIONAL { ?operatingForeQuantity qudt:unit ?operatingForeUnit . }
        }
    }

    OPTIONAL {
        $this nltl:operatingAftDraught ?operatingAftQuantity .
        OPTIONAL {
            ?operatingAftQuantity qudt:numericValue ?operatingAftValue .
            OPTIONAL { ?operatingAftQuantity qudt:unit ?operatingAftUnit . }
        }
    }

    FILTER (
        !(
            COALESCE(isIRI(?upperWaterline), false) &&
            COALESCE(isIRI(?lowerWaterline), false) &&

            COALESCE(DATATYPE(?upperForeValue) = xsd:decimal, false) &&
            COALESCE(DATATYPE(?lowerForeValue) = xsd:decimal, false) &&
            COALESCE(DATATYPE(?operatingForeValue) = xsd:decimal, false) &&

            COALESCE(DATATYPE(?upperAftValue) = xsd:decimal, false) &&
            COALESCE(DATATYPE(?lowerAftValue) = xsd:decimal, false) &&
            COALESCE(DATATYPE(?operatingAftValue) = xsd:decimal, false) &&

            COALESCE(?upperForeUnit = unit:M, false) &&
            COALESCE(?lowerForeUnit = unit:M, false) &&
            COALESCE(?operatingForeUnit = unit:M, false) &&

            COALESCE(?upperAftUnit = unit:M, false) &&
            COALESCE(?lowerAftUnit = unit:M, false) &&
            COALESCE(?operatingAftUnit = unit:M, false) &&

            COALESCE(
                ?lowerForeValue <= ?operatingForeValue &&
                ?operatingForeValue <= ?upperForeValue,
                false
            ) &&
            COALESCE(
                ?lowerAftValue <= ?operatingAftValue &&
                ?operatingAftValue <= ?upperAftValue,
                false
            )
        )
    )
}
""" ;
    ] .
