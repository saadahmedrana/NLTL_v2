@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IceClassDraughtShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:not [
                sh:or (
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIaSuper
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIa
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIb
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIc
                        ]
                    ]
                )
            ]
        ]
        gen:ApplicableIceClassDraughtShape
    ) .

gen:ApplicableIceClassDraughtShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:minCount 1 ;
        sh:node gen:IceWaterlineDraughtShape ;
        sh:message "An applicable ship must have an upper ice waterline with fore and aft draughts in metres."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:minCount 1 ;
        sh:node gen:IceWaterlineDraughtShape ;
        sh:message "An applicable ship must have a lower ice waterline with fore and aft draughts in metres."
    ] ;
    sh:property [
        sh:path nltl:operatingForeDraught ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "An applicable ship must have an operating fore draught in metres."
    ] ;
    sh:property [
        sh:path nltl:operatingAftDraught ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "An applicable ship must have an operating aft draught in metres."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The operating draught at each perpendicular must be between the corresponding lower and upper ice-waterline draughts." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasLowerIceWaterline ?lowerWaterline ;
          nltl:hasUpperIceWaterline ?upperWaterline ;
          ?operatingProperty ?operatingQuantity .

    ?lowerWaterline ?waterlineProperty ?lowerQuantity .
    ?upperWaterline ?waterlineProperty ?upperQuantity .

    ?lowerQuantity qudt:numericValue ?lowerValue .
    ?operatingQuantity qudt:numericValue ?operatingValue .
    ?upperQuantity qudt:numericValue ?upperValue .

    FILTER(
        (?operatingProperty = nltl:operatingForeDraught &&
         ?waterlineProperty = nltl:draughtAtForePerpendicular)
        ||
        (?operatingProperty = nltl:operatingAftDraught &&
         ?waterlineProperty = nltl:draughtAtAftPerpendicular)
    )

    FILTER(
        xsd:decimal(?lowerValue) > xsd:decimal(?operatingValue)
        ||
        xsd:decimal(?operatingValue) > xsd:decimal(?upperValue)
    )
}
"""
    ] .

gen:IceWaterlineDraughtShape
    a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:draughtAtForePerpendicular ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "The ice waterline must have a fore-perpendicular draught in metres."
    ] ;
    sh:property [
        sh:path nltl:draughtAtAftPerpendicular ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "The ice waterline must have an aft-perpendicular draught in metres."
    ] .

gen:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The quantity must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:message "The quantity must be expressed in metres."
    ] .
