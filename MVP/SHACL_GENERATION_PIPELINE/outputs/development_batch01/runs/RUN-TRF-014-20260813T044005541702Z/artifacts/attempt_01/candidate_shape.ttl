@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gen:TRF014ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship's ice class is required to establish applicability."
    ] ;

    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:message "Draught restrictions for operation in ice must be documented."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The ice draught restriction information must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The ice draught restriction information must be readily available to the master."
    ] ;

    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:message "A class certificate indicating the ice class draughts is required."
    ] ;

    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "The construction date is required to determine the applicable marking rule."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The summer load line fresh-water draught is required to determine marking applicability."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The upper ice waterline draught is required to determine marking applicability."
    ] ;

    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minExclusive "2007-07-01"^^xsd:date
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Where the fresh-water summer load line is above the UIWL, a warning triangle and an ice class draught mark at the maximum permissible ice class draught amidships are required; a pre-1 July 2007 ship also requires its first scheduled dry-docking date after that date." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:constructionDate ?constructionDate ;
          nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity ;
          nltl:maximumIceClassDraughtAmidships ?maximumQuantity .

    ?summerQuantity qudt:numericValue ?summerDraught ;
                    qudt:unit unit:M .
    ?uiwlQuantity qudt:numericValue ?uiwlDraught ;
                  qudt:unit unit:M .
    ?maximumQuantity qudt:numericValue ?maximumDraught ;
                     qudt:unit unit:M .

    BIND(
        YEAR(?constructionDate) < 2007 ||
        (
            YEAR(?constructionDate) = 2007 &&
            (
                MONTH(?constructionDate) < 7 ||
                (MONTH(?constructionDate) = 7 && DAY(?constructionDate) < 1)
            )
        )
        AS ?builtBeforeThreshold
    )

    FILTER(xsd:decimal(?summerDraught) > xsd:decimal(?uiwlDraught))

    FILTER(
        NOT EXISTS {
            $this nltl:warningTrianglePresent true .
        } ||
        NOT EXISTS {
            $this nltl:iceClassDraughtMarkPresent true .
        } ||
        NOT EXISTS {
            $this nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
            ?markQuantity qudt:numericValue ?markDraught ;
                          qudt:unit unit:M .
            FILTER(xsd:decimal(?markDraught) = xsd:decimal(?maximumDraught))
        } ||
        (
            ?builtBeforeThreshold &&
            NOT EXISTS {
                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
            }
        )
    )
}
"""
    ] .
