@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IceNavigationLimitsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Operating draught exceeds the upper ice waterline draught." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent? ?subject .
    ?subject nltl:operatingDraught ?operatingQuantity ;
             nltl:upperIceWaterlineDraught ?limitQuantity .
    ?operatingQuantity qudt:numericValue ?operatingValue ;
                       qudt:unit unit:M .
    ?limitQuantity qudt:numericValue ?limitValue ;
                   qudt:unit unit:M .
    FILTER(
        datatype(?operatingValue) = xsd:decimal &&
        datatype(?limitValue) = xsd:decimal &&
        ?operatingValue > ?limitValue
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Operating trim exceeds the maximum permitted ice trim." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent? ?subject .
    ?subject nltl:operatingTrim ?operatingQuantity ;
             nltl:maximumPermittedIceTrim ?limitQuantity .
    ?operatingQuantity qudt:numericValue ?operatingValue ;
                       qudt:unit unit:M .
    ?limitQuantity qudt:numericValue ?limitValue ;
                   qudt:unit unit:M .
    FILTER(
        datatype(?operatingValue) = xsd:decimal &&
        datatype(?limitValue) = xsd:decimal &&
        ?operatingValue > ?limitValue
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Loading-calculation sea-water salinity differs from the intended-route salinity expressed in the same unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent? ?subject .
    ?subject nltl:intendedRouteSeaWaterSalinity ?routeQuantity ;
             nltl:loadingCalculationSeaWaterSalinity ?loadingQuantity .
    ?routeQuantity qudt:numericValue ?routeValue ;
                   qudt:unit ?unit .
    ?loadingQuantity qudt:numericValue ?loadingValue ;
                     qudt:unit ?unit .
    FILTER(
        datatype(?routeValue) = xsd:decimal &&
        datatype(?loadingValue) = xsd:decimal &&
        ?loadingValue != ?routeValue
    )
}
"""
    ] .
