@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF015Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When navigating in ice, draught, trim, their applicable limits, and route and loading-calculation salinity inputs must be recorded with compatible quantity data." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce "true"^^xsd:boolean .
                FILTER (
                    NOT EXISTS {
                        $this nltl:operatingDraught ?operatingDraught .
                        ?operatingDraught a qudt:QuantityValue ;
                            qudt:numericValue ?operatingDraughtValue ;
                            qudt:unit unit:M .
                        FILTER (datatype(?operatingDraughtValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineDraught ?upperIceWaterlineDraught .
                        ?upperIceWaterlineDraught a qudt:QuantityValue ;
                            qudt:numericValue ?upperIceWaterlineDraughtValue ;
                            qudt:unit unit:M .
                        FILTER (datatype(?upperIceWaterlineDraughtValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:operatingTrim ?operatingTrim .
                        ?operatingTrim a qudt:QuantityValue ;
                            qudt:numericValue ?operatingTrimValue ;
                            qudt:unit unit:M .
                        FILTER (datatype(?operatingTrimValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:maximumPermittedIceTrim ?maximumPermittedIceTrim .
                        ?maximumPermittedIceTrim a qudt:QuantityValue ;
                            qudt:numericValue ?maximumPermittedIceTrimValue ;
                            qudt:unit unit:M .
                        FILTER (datatype(?maximumPermittedIceTrimValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:intendedRouteSeaWaterSalinity ?routeSalinity .
                        ?routeSalinity a qudt:QuantityValue ;
                            qudt:numericValue ?routeSalinityValue ;
                            qudt:unit ?routeSalinityUnit .
                        FILTER (datatype(?routeSalinityValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:loadingCalculationSeaWaterSalinity ?loadingSalinity .
                        ?loadingSalinity a qudt:QuantityValue ;
                            qudt:numericValue ?loadingSalinityValue ;
                            qudt:unit ?loadingSalinityUnit .
                        FILTER (datatype(?loadingSalinityValue) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When navigating in ice, the operating draught must not exceed the upper ice waterline draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce "true"^^xsd:boolean ;
                    nltl:operatingDraught ?operatingDraught ;
                    nltl:upperIceWaterlineDraught ?upperIceWaterlineDraught .
                ?operatingDraught a qudt:QuantityValue ;
                    qudt:numericValue ?operatingDraughtValue ;
                    qudt:unit unit:M .
                ?upperIceWaterlineDraught a qudt:QuantityValue ;
                    qudt:numericValue ?upperIceWaterlineDraughtValue ;
                    qudt:unit unit:M .
                FILTER (
                    datatype(?operatingDraughtValue) = xsd:decimal &&
                    datatype(?upperIceWaterlineDraughtValue) = xsd:decimal &&
                    ?operatingDraughtValue > ?upperIceWaterlineDraughtValue
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When navigating in ice, the operating trim must not exceed the maximum permitted ice trim." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce "true"^^xsd:boolean ;
                    nltl:operatingTrim ?operatingTrim ;
                    nltl:maximumPermittedIceTrim ?maximumPermittedIceTrim .
                ?operatingTrim a qudt:QuantityValue ;
                    qudt:numericValue ?operatingTrimValue ;
                    qudt:unit unit:M .
                ?maximumPermittedIceTrim a qudt:QuantityValue ;
                    qudt:numericValue ?maximumPermittedIceTrimValue ;
                    qudt:unit unit:M .
                FILTER (
                    datatype(?operatingTrimValue) = xsd:decimal &&
                    datatype(?maximumPermittedIceTrimValue) = xsd:decimal &&
                    ?operatingTrimValue > ?maximumPermittedIceTrimValue
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When navigating in ice, the loading-calculation sea-water salinity must match the intended-route sea-water salinity in value and unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:navigatingInIce "true"^^xsd:boolean ;
                    nltl:loadingCalculationSeaWaterSalinity ?loadingSalinity .
                ?loadingSalinity a qudt:QuantityValue ;
                    qudt:numericValue ?loadingSalinityValue ;
                    qudt:unit ?loadingSalinityUnit .
                FILTER (datatype(?loadingSalinityValue) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:intendedRouteSeaWaterSalinity ?routeSalinity .
                    ?routeSalinity a qudt:QuantityValue ;
                        qudt:numericValue ?routeSalinityValue ;
                        qudt:unit ?loadingSalinityUnit .
                    FILTER (
                        datatype(?routeSalinityValue) = xsd:decimal &&
                        ?routeSalinityValue = ?loadingSalinityValue
                    )
                }
            }
        """
    ] .
