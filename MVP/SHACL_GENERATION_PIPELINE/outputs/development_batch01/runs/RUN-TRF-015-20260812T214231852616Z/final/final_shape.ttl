@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gs:SalinityQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:gramPerKilogramSalinityUnit
    ] .

gs:TRF015Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must state exactly once whether it is navigating in ice."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:operatingDraught ;
                sh:minCount 1 ;
                sh:node gs:MetreQuantityShape ;
                sh:message "Operating draught in metres is required when navigating in ice."
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineDraught ;
                sh:minCount 1 ;
                sh:node gs:MetreQuantityShape ;
                sh:message "Upper ice waterline draught in metres is required when navigating in ice."
            ] ;
            sh:property [
                sh:path nltl:operatingTrim ;
                sh:minCount 1 ;
                sh:node gs:MetreQuantityShape ;
                sh:message "Operating trim in metres is required when navigating in ice."
            ] ;
            sh:property [
                sh:path nltl:maximumPermittedIceTrim ;
                sh:minCount 1 ;
                sh:node gs:MetreQuantityShape ;
                sh:message "Maximum permitted ice trim in metres is required when navigating in ice."
            ] ;
            sh:property [
                sh:path nltl:intendedRouteSeaWaterSalinity ;
                sh:minCount 1 ;
                sh:node gs:SalinityQuantityShape ;
                sh:message "Intended-route sea-water salinity in grams per kilogram is required when navigating in ice."
            ] ;
            sh:property [
                sh:path nltl:loadingCalculationSeaWaterSalinity ;
                sh:minCount 1 ;
                sh:node gs:SalinityQuantityShape ;
                sh:message "Loading-calculation sea-water salinity in grams per kilogram is required when navigating in ice."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "When navigating in ice, operating draught and trim must not exceed their permitted limits, and the loading calculation must use the intended-route sea-water salinity." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:operatingDraught ?operatingDraughtNode ;
          nltl:upperIceWaterlineDraught ?uiwlNode ;
          nltl:operatingTrim ?operatingTrimNode ;
          nltl:maximumPermittedIceTrim ?maximumTrimNode ;
          nltl:intendedRouteSeaWaterSalinity ?routeSalinityNode ;
          nltl:loadingCalculationSeaWaterSalinity ?loadingSalinityNode .
    ?operatingDraughtNode qudt:numericValue ?operatingDraught .
    ?uiwlNode qudt:numericValue ?uiwl .
    ?operatingTrimNode qudt:numericValue ?operatingTrim .
    ?maximumTrimNode qudt:numericValue ?maximumTrim .
    ?routeSalinityNode qudt:numericValue ?routeSalinity .
    ?loadingSalinityNode qudt:numericValue ?loadingSalinity .
    FILTER (
        ?operatingDraught > ?uiwl ||
        ?operatingTrim > ?maximumTrim ||
        ?loadingSalinity != ?routeSalinity
    )
}
"""
            ]
        ]
    ) .
