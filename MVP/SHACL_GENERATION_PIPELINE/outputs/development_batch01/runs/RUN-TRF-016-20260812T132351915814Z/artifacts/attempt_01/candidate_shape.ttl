@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LengthMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .

gs:MetricTonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:TON_Metric ;
        sh:minCount 1
    ] .

gs:UpperIceWaterlineShape
    a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:waterlineDisplacement ;
        sh:node gs:MetricTonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each upper ice waterline must provide its displacement in metric tonnes."
    ] .

gs:BallastTankConstraintShape
    a sh:NodeShape ;
    sh:class nltl:ballastTank ;
    sh:sparql [
        sh:message "A ballast tank above the lower ice waterline and used to reach that waterline must have freezing prevention." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:situatedAboveLowerIceWaterline true ;
                      nltl:usedToReachLowerIceWaterline true .
                FILTER NOT EXISTS {
                    $this nltl:freezingPreventionPresent true .
                }
            }
        """
    ] .

gs:ShipRequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerHighestPointSubmerged ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The highest point of the propeller must be submerged."
    ] ;
    sh:property [
        sh:path nltl:forwardDraught ;
        sh:node gs:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Forward draught in metres is required for the minimum-draught calculation."
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node gs:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Level ice thickness in metres is required for the minimum-draught calculation."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:node gs:UpperIceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "At least one upper ice waterline with displacement is required."
    ] ;
    sh:property [
        sh:path nltl:hasBallastTank ;
        sh:node gs:BallastTankConstraintShape
    ] ;
    sh:sparql [
        sh:message "Forward draught must be at least the lesser of (2 + 0.00025 times the greatest UIWL displacement) times level ice thickness and four times level ice thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:forwardDraught ?forwardQuantity ;
                      nltl:levelIceThickness ?iceQuantity ;
                      nltl:hasUpperIceWaterline ?waterline .

                ?forwardQuantity qudt:numericValue ?forward ;
                                 qudt:unit unit:M .
                ?iceQuantity qudt:numericValue ?iceThickness ;
                             qudt:unit unit:M .
                ?waterline nltl:waterlineDisplacement ?displacementQuantity .
                ?displacementQuantity qudt:numericValue ?displacement ;
                                      qudt:unit unit:TON_Metric .

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterline ?otherWaterline .
                    ?otherWaterline nltl:waterlineDisplacement ?otherQuantity .
                    ?otherQuantity qudt:numericValue ?otherDisplacement ;
                                   qudt:unit unit:TON_Metric .
                    FILTER (?otherDisplacement > ?displacement)
                }

                BIND(
                    (2.0 + (0.00025 * ?displacement)) * ?iceThickness
                    AS ?displacementBasedMinimum
                )
                BIND(4.0 * ?iceThickness AS ?fourThicknessMinimum)
                BIND(
                    IF(
                        ?displacementBasedMinimum < ?fourThicknessMinimum,
                        ?displacementBasedMinimum,
                        ?fourThicknessMinimum
                    )
                    AS ?requiredForwardDraught
                )
                FILTER (?forward < ?requiredForwardDraught)
            }
        """
    ] .
