@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The power quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The power quantity must have exactly one unit, KiloW."
    ] .

gen:EngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:node gen:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Engine output P must be recorded as exactly one power quantity."
    ] ;
    sh:property [
        sh:path nltl:propulsionOutputRestrictionApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean propulsion-output restriction applicability value is required."
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When propulsion output is restricted, exactly one restricted propulsion output is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:propulsionMachineryContinuousOutput ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When propulsion output is not restricted, exactly one total propulsion machinery continuous output is required."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "When propulsion output is restricted, engine output P must equal the restricted propulsion output." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?applies ;
          nltl:maximumContinuousRatingPower ?p ;
          nltl:restrictedPropulsionOutput ?restricted .
    ?p qudt:numericValue ?pValue .
    ?restricted qudt:numericValue ?restrictedValue .
    FILTER(
        ?applies = "true"^^xsd:boolean &&
        ?pValue != ?restrictedValue
    )
}
"""
    ] ;
    sh:sparql [
        sh:message "When propulsion output is not restricted, engine output P must equal the total continuous propulsion output, including additional propulsion power sources." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?applies ;
          nltl:maximumContinuousRatingPower ?p ;
          nltl:propulsionMachineryContinuousOutput ?continuous .
    ?p qudt:numericValue ?pValue .
    ?continuous qudt:numericValue ?continuousValue .
    FILTER(
        ?applies = "false"^^xsd:boolean &&
        ?pValue != ?continuousValue
    )
}
"""
    ] .
