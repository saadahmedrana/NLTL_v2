@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF020EngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Applicable ships require decimal quantity values with the prescribed units for MCR power, both minimum required powers, Ke, RCH, and propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:iceClass ?iceClass .
                VALUES ?iceClass {
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                }
                FILTER (
                    DATATYPE(?date) = xsd:date &&
                    ?date >= xsd:date("2003-09-01")
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                        ?mcrQuantity qudt:numericValue ?mcr ;
                                     qudt:unit unit:KiloW .
                        FILTER (isLiteral(?mcr) && DATATYPE(?mcr) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:minimumRequiredPowerAtUpperIceWaterline ?uiwlQuantity .
                        ?uiwlQuantity qudt:numericValue ?uiwl ;
                                      qudt:unit unit:KiloW .
                        FILTER (isLiteral(?uiwl) && DATATYPE(?uiwl) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:minimumRequiredPowerAtLowerIceWaterline ?liwlQuantity .
                        ?liwlQuantity qudt:numericValue ?liwl ;
                                      qudt:unit unit:KiloW .
                        FILTER (isLiteral(?liwl) && DATATYPE(?liwl) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:engineOutputCoefficientKe ?keQuantity .
                        ?keQuantity qudt:numericValue ?ke ;
                                    qudt:unit unit:UNITLESS .
                        FILTER (isLiteral(?ke) && DATATYPE(?ke) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:brashIceChannelResistanceRch ?rchQuantity .
                        ?rchQuantity qudt:numericValue ?rch ;
                                     qudt:unit unit:N .
                        FILTER (isLiteral(?rch) && DATATYPE(?rch) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:propellerDiameter ?diameterQuantity .
                        ?diameterQuantity qudt:numericValue ?diameter ;
                                          qudt:unit unit:M .
                        FILTER (isLiteral(?diameter) && DATATYPE(?diameter) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be no less than both the UIWL and LIWL minimum required powers." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:iceClass ?iceClass .
                VALUES ?iceClass {
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                }
                FILTER (
                    DATATYPE(?date) = xsd:date &&
                    ?date >= xsd:date("2003-09-01")
                )
                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?mcrQuantity ;
                          nltl:minimumRequiredPowerAtUpperIceWaterline ?uiwlQuantity ;
                          nltl:minimumRequiredPowerAtLowerIceWaterline ?liwlQuantity .
                    ?mcrQuantity qudt:numericValue ?mcr ;
                                 qudt:unit unit:KiloW .
                    ?uiwlQuantity qudt:numericValue ?uiwl ;
                                  qudt:unit unit:KiloW .
                    ?liwlQuantity qudt:numericValue ?liwl ;
                                  qudt:unit unit:KiloW .
                    FILTER (
                        isLiteral(?mcr) &&
                        isLiteral(?uiwl) &&
                        isLiteral(?liwl) &&
                        DATATYPE(?mcr) = xsd:decimal &&
                        DATATYPE(?uiwl) = xsd:decimal &&
                        DATATYPE(?liwl) = xsd:decimal &&
                        ?mcr >= ?uiwl &&
                        ?mcr >= ?liwl
                    )
                }
            }
        """
    ] .
