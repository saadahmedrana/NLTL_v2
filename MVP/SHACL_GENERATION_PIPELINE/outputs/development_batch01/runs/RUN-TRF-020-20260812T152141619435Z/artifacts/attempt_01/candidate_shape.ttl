@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF020EngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Applicable ships require decimal values for Ke, propeller diameter, UIWL and LIWL resistance, UIWL and LIWL minimum power, and maximum continuous rating power in their specified units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:iceClass ?iceClass .
                FILTER (
                    datatype(?date) = xsd:date &&
                    ?date >= "2003-09-01"^^xsd:date &&
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:engineOutputCoefficientKe ?keQuantity .
                        ?keQuantity qudt:numericValue ?ke ;
                                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?ke) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:propellerDiameter ?diameterQuantity .
                        ?diameterQuantity qudt:numericValue ?diameter ;
                                          qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?diameter) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:brashIceChannelResistanceAtUpperIceWaterline ?upperResistanceQuantity .
                        ?upperResistanceQuantity
                            qudt:numericValue ?upperResistance ;
                            qudt:unit <http://qudt.org/vocab/unit/N> .
                        FILTER (datatype(?upperResistance) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:brashIceChannelResistanceAtLowerIceWaterline ?lowerResistanceQuantity .
                        ?lowerResistanceQuantity
                            qudt:numericValue ?lowerResistance ;
                            qudt:unit <http://qudt.org/vocab/unit/N> .
                        FILTER (datatype(?lowerResistance) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:minimumRequiredPowerAtUpperIceWaterline ?upperPowerQuantity .
                        ?upperPowerQuantity qudt:numericValue ?upperPower ;
                                            qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                        FILTER (datatype(?upperPower) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerPowerQuantity .
                        ?lowerPowerQuantity qudt:numericValue ?lowerPower ;
                                            qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                        FILTER (datatype(?lowerPower) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:maximumContinuousRatingPower ?mcrQuantity .
                        ?mcrQuantity qudt:numericValue ?mcr ;
                                     qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                        FILTER (datatype(?mcr) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The UIWL minimum required power must satisfy P_min = Ke*(R_CH/1000)^(3/2)/D_p." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:iceClass ?iceClass ;
                      nltl:engineOutputCoefficientKe ?keQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:brashIceChannelResistanceAtUpperIceWaterline ?resistanceQuantity ;
                      nltl:minimumRequiredPowerAtUpperIceWaterline ?powerQuantity .
                ?keQuantity qudt:numericValue ?ke ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?diameterQuantity qudt:numericValue ?diameter ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                ?resistanceQuantity qudt:numericValue ?resistance ;
                                    qudt:unit <http://qudt.org/vocab/unit/N> .
                ?powerQuantity qudt:numericValue ?power ;
                               qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                FILTER (
                    datatype(?date) = xsd:date &&
                    datatype(?ke) = xsd:decimal &&
                    datatype(?diameter) = xsd:decimal &&
                    datatype(?resistance) = xsd:decimal &&
                    datatype(?power) = xsd:decimal &&
                    ?date >= "2003-09-01"^^xsd:date &&
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER (
                    ?ke <= 0 ||
                    ?diameter <= 0 ||
                    ?resistance < 0 ||
                    ?power < 0 ||
                    ((?power * ?diameter) * (?power * ?diameter)) !=
                    ((?ke * ?ke) *
                     ((?resistance / 1000) *
                      (?resistance / 1000) *
                      (?resistance / 1000)))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The LIWL minimum required power must satisfy P_min = Ke*(R_CH/1000)^(3/2)/D_p." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:iceClass ?iceClass ;
                      nltl:engineOutputCoefficientKe ?keQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:brashIceChannelResistanceAtLowerIceWaterline ?resistanceQuantity ;
                      nltl:minimumRequiredPowerAtLowerIceWaterline ?powerQuantity .
                ?keQuantity qudt:numericValue ?ke ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?diameterQuantity qudt:numericValue ?diameter ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                ?resistanceQuantity qudt:numericValue ?resistance ;
                                    qudt:unit <http://qudt.org/vocab/unit/N> .
                ?powerQuantity qudt:numericValue ?power ;
                               qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                FILTER (
                    datatype(?date) = xsd:date &&
                    datatype(?ke) = xsd:decimal &&
                    datatype(?diameter) = xsd:decimal &&
                    datatype(?resistance) = xsd:decimal &&
                    datatype(?power) = xsd:decimal &&
                    ?date >= "2003-09-01"^^xsd:date &&
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER (
                    ?ke <= 0 ||
                    ?diameter <= 0 ||
                    ?resistance < 0 ||
                    ?power < 0 ||
                    ((?power * ?diameter) * (?power * ?diameter)) !=
                    ((?ke * ?ke) *
                     ((?resistance / 1000) *
                      (?resistance / 1000) *
                      (?resistance / 1000)))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be no less than both the UIWL and LIWL minimum required powers." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?date ;
                      nltl:iceClass ?iceClass ;
                      nltl:maximumContinuousRatingPower ?mcrQuantity ;
                      nltl:minimumRequiredPowerAtUpperIceWaterline ?upperPowerQuantity ;
                      nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerPowerQuantity .
                ?mcrQuantity qudt:numericValue ?mcr ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?upperPowerQuantity qudt:numericValue ?upperPower ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                ?lowerPowerQuantity qudt:numericValue ?lowerPower ;
                                    qudt:unit <http://qudt.org/vocab/unit/KiloW> .
                FILTER (
                    datatype(?date) = xsd:date &&
                    datatype(?mcr) = xsd:decimal &&
                    datatype(?upperPower) = xsd:decimal &&
                    datatype(?lowerPower) = xsd:decimal &&
                    ?date >= "2003-09-01"^^xsd:date &&
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    )
                )
                FILTER (?mcr < ?upperPower || ?mcr < ?lowerPower)
            }
        """
    ] .
