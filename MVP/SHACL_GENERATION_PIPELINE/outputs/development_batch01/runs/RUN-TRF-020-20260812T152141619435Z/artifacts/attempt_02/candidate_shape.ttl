@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF020EngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Applicable ships require MCR power, propeller diameter, K_e, and UIWL/LIWL resistance and minimum-power quantities in their prescribed units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER (
        NOT EXISTS {
            $this nltl:maximumContinuousRatingPower ?mcr .
            ?mcr qudt:numericValue ?mcrValue ;
                 qudt:unit unit:KiloW .
            FILTER (datatype(?mcrValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:propellerDiameter ?diameter .
            ?diameter qudt:numericValue ?diameterValue ;
                      qudt:unit unit:M .
            FILTER (datatype(?diameterValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:engineOutputCoefficientKe ?ke .
            ?ke qudt:numericValue ?keValue ;
                qudt:unit unit:UNITLESS .
            FILTER (datatype(?keValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:brashIceChannelResistanceAtUpperIceWaterline ?upperResistance .
            ?upperResistance qudt:numericValue ?upperResistanceValue ;
                             qudt:unit unit:N .
            FILTER (datatype(?upperResistanceValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:brashIceChannelResistanceAtLowerIceWaterline ?lowerResistance .
            ?lowerResistance qudt:numericValue ?lowerResistanceValue ;
                             qudt:unit unit:N .
            FILTER (datatype(?lowerResistanceValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:minimumRequiredPowerAtUpperIceWaterline ?upperPower .
            ?upperPower qudt:numericValue ?upperPowerValue ;
                        qudt:unit unit:KiloW .
            FILTER (datatype(?upperPowerValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerPower .
            ?lowerPower qudt:numericValue ?lowerPowerValue ;
                        qudt:unit unit:KiloW .
            FILTER (datatype(?lowerPowerValue) = xsd:decimal)
        }
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "An applicable ship requires an IRI-valued propulsion-system type for the K_e table lookup." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER NOT EXISTS {
        $this nltl:propulsionSystemType ?propulsionType .
        FILTER (isIRI(?propulsionType))
    }
}
""" ;
    ] ;
    sh:sparql [
        sh:message "A conventional propulsion system must select a Table 3-1 branch using fixed or controllable pitch and a propeller count of 1, 2, or 3." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass ;
          nltl:propulsionSystemType nltl:conventionalPropulsionSystem .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER NOT EXISTS {
        $this nltl:propellerPitchControlType ?pitch ;
              nltl:propellerCount ?count .
        FILTER (datatype(?count) = xsd:integer)
        FILTER (?pitch IN (nltl:fixedPitch, nltl:controllablePitch))
        FILTER (?count IN (1, 2, 3))
    }
}
""" ;
    ] ;
    sh:sparql [
        sh:message "K_e must equal the Table 3-1 value selected by propeller pitch control type and propeller count." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass ;
          nltl:propulsionSystemType nltl:conventionalPropulsionSystem ;
          nltl:propellerPitchControlType ?pitch ;
          nltl:propellerCount ?count ;
          nltl:engineOutputCoefficientKe ?ke .
    ?ke qudt:numericValue ?keValue ;
        qudt:unit unit:UNITLESS .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER (datatype(?count) = xsd:integer)
    FILTER (datatype(?keValue) = xsd:decimal)
    FILTER (
        (?pitch = nltl:fixedPitch && ?count = 1 && ?keValue != "2.26"^^xsd:decimal)
        ||
        (?pitch = nltl:fixedPitch && ?count = 2 && ?keValue != "1.44"^^xsd:decimal)
        ||
        (?pitch = nltl:fixedPitch && ?count = 3 && ?keValue != "1.18"^^xsd:decimal)
        ||
        (?pitch = nltl:controllablePitch && ?count = 1 && ?keValue != "2.03"^^xsd:decimal)
        ||
        (?pitch = nltl:controllablePitch && ?count = 2 && ?keValue != "1.44"^^xsd:decimal)
        ||
        (?pitch = nltl:controllablePitch && ?count = 3 && ?keValue != "1.18"^^xsd:decimal)
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "The UIWL minimum required power must satisfy P_min = K_e*(R_CH/1000)^(3/2)/D_p." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass ;
          nltl:engineOutputCoefficientKe ?ke ;
          nltl:propellerDiameter ?diameter ;
          nltl:brashIceChannelResistanceAtUpperIceWaterline ?resistance ;
          nltl:minimumRequiredPowerAtUpperIceWaterline ?power .
    ?ke qudt:numericValue ?keValue ;
        qudt:unit unit:UNITLESS .
    ?diameter qudt:numericValue ?diameterValue ;
              qudt:unit unit:M .
    ?resistance qudt:numericValue ?resistanceValue ;
                qudt:unit unit:N .
    ?power qudt:numericValue ?powerValue ;
           qudt:unit unit:KiloW .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER (
        ?diameterValue <= "0"^^xsd:decimal
        ||
        ?resistanceValue < "0"^^xsd:decimal
        ||
        ?powerValue < "0"^^xsd:decimal
        ||
        (
            (?powerValue * ?powerValue * ?diameterValue * ?diameterValue)
            !=
            (
                ?keValue * ?keValue
                * (?resistanceValue / "1000"^^xsd:decimal)
                * (?resistanceValue / "1000"^^xsd:decimal)
                * (?resistanceValue / "1000"^^xsd:decimal)
            )
        )
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "The LIWL minimum required power must satisfy P_min = K_e*(R_CH/1000)^(3/2)/D_p." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass ;
          nltl:engineOutputCoefficientKe ?ke ;
          nltl:propellerDiameter ?diameter ;
          nltl:brashIceChannelResistanceAtLowerIceWaterline ?resistance ;
          nltl:minimumRequiredPowerAtLowerIceWaterline ?power .
    ?ke qudt:numericValue ?keValue ;
        qudt:unit unit:UNITLESS .
    ?diameter qudt:numericValue ?diameterValue ;
              qudt:unit unit:M .
    ?resistance qudt:numericValue ?resistanceValue ;
                qudt:unit unit:N .
    ?power qudt:numericValue ?powerValue ;
           qudt:unit unit:KiloW .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER (
        ?diameterValue <= "0"^^xsd:decimal
        ||
        ?resistanceValue < "0"^^xsd:decimal
        ||
        ?powerValue < "0"^^xsd:decimal
        ||
        (
            (?powerValue * ?powerValue * ?diameterValue * ?diameterValue)
            !=
            (
                ?keValue * ?keValue
                * (?resistanceValue / "1000"^^xsd:decimal)
                * (?resistanceValue / "1000"^^xsd:decimal)
                * (?resistanceValue / "1000"^^xsd:decimal)
            )
        )
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be no less than both the UIWL and LIWL minimum required powers." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionStageDate ?date ;
          nltl:iceClass ?iceClass ;
          nltl:maximumContinuousRatingPower ?mcr ;
          nltl:minimumRequiredPowerAtUpperIceWaterline ?upperPower ;
          nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerPower .
    ?mcr qudt:numericValue ?mcrValue ;
         qudt:unit unit:KiloW .
    ?upperPower qudt:numericValue ?upperPowerValue ;
                qudt:unit unit:KiloW .
    ?lowerPower qudt:numericValue ?lowerPowerValue ;
                qudt:unit unit:KiloW .
    FILTER (?date >= "2003-09-01"^^xsd:date)
    FILTER (?iceClass IN (
        nltl:iceClassIaSuper,
        nltl:iceClassIa,
        nltl:iceClassIb,
        nltl:iceClassIc
    ))
    FILTER (
        ?mcrValue < ?upperPowerValue
        ||
        ?mcrValue < ?lowerPowerValue
    )
}
""" ;
    ] .
