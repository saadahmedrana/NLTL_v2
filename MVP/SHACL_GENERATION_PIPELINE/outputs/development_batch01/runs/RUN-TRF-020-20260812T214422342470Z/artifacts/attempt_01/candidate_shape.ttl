@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ApplicableShipTarget
    a sh:SPARQLTarget ;
    sh:select """
        PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
        SELECT DISTINCT ?this
        WHERE {
            ?this a nltl:ship ;
                nltl:constructionStageDate ?date ;
                nltl:iceClass ?iceClass .
            FILTER (
                ?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                )
            )
            FILTER (datatype(?date) = xsd:date)
            FILTER (
                YEAR(?date) > 2003 ||
                (YEAR(?date) = 2003 && MONTH(?date) > 9) ||
                (YEAR(?date) = 2003 && MONTH(?date) = 9 && DAY(?date) >= 1)
            )
        }
    """ .

gen:ForceInNewtonValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N
    ] .

gen:PowerInKilowattValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW
    ] .

gen:LengthInMetreValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gen:UnitlessDecimalValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gen:EngineOutputRequirementShape
    a sh:NodeShape ;
    sh:target gen:ApplicableShipTarget ;

    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:node gen:PowerInKilowattValueShape ;
        sh:minCount 1 ;
        sh:message "Maximum continuous rating power in kilowatts is required."
    ] ;
    sh:property [
        sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ;
        sh:node gen:PowerInKilowattValueShape ;
        sh:minCount 1 ;
        sh:message "Minimum required power at the upper ice waterline in kilowatts is required."
    ] ;
    sh:property [
        sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ;
        sh:node gen:PowerInKilowattValueShape ;
        sh:minCount 1 ;
        sh:message "Minimum required power at the lower ice waterline in kilowatts is required."
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ;
        sh:node gen:ForceInNewtonValueShape ;
        sh:minCount 1 ;
        sh:message "Brash-ice channel resistance at the upper ice waterline in newtons is required."
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ;
        sh:node gen:ForceInNewtonValueShape ;
        sh:minCount 1 ;
        sh:message "Brash-ice channel resistance at the lower ice waterline in newtons is required."
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node gen:LengthInMetreValueShape ;
        sh:minCount 1 ;
        sh:message "Propeller diameter in metres is required."
    ] ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:node gen:UnitlessDecimalValueShape ;
        sh:minCount 1 ;
        sh:message "The dimensionless engine-output coefficient Ke is required."
    ] ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer ;
        sh:in ( 1 2 3 ) ;
        sh:minCount 1 ;
        sh:message "Propeller count must be 1, 2, or 3 for Table 3-1 selection."
    ] ;
    sh:property [
        sh:path nltl:propulsionSystemType ;
        sh:in (
            nltl:conventionalPropulsionSystem
            nltl:electricPropulsionMachinery
            nltl:hydraulicPropulsionMachinery
        ) ;
        sh:minCount 1 ;
        sh:message "A permitted propulsion-system type is required for Table 3-1 selection."
    ] ;
    sh:property [
        sh:path nltl:propellerPitchControlType ;
        sh:in (
            nltl:controllablePitch
            nltl:fixedPitch
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionSystemType ;
                sh:in (
                    nltl:electricPropulsionMachinery
                    nltl:hydraulicPropulsionMachinery
                ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionSystemType ;
                sh:hasValue nltl:conventionalPropulsionSystem
            ] ;
            sh:property [
                sh:path nltl:propellerPitchControlType ;
                sh:in (
                    nltl:controllablePitch
                    nltl:fixedPitch
                ) ;
                sh:minCount 1
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "Engine-output coefficient Ke must equal the applicable Table 3-1 value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerCount ?count ;
                    nltl:propulsionSystemType ?system ;
                    nltl:engineOutputCoefficientKe ?keQuantity .
                ?keQuantity qudt:numericValue ?ke ;
                    qudt:unit unit:UNITLESS .

                BIND(
                    ?system IN (
                        nltl:electricPropulsionMachinery,
                        nltl:hydraulicPropulsionMachinery
                    ) ||
                    EXISTS {
                        $this nltl:propellerPitchControlType nltl:controllablePitch .
                    }
                    AS ?firstColumn
                )
                BIND(
                    IF(
                        ?count = 1,
                        IF(?firstColumn, 2.03, 2.26),
                        IF(
                            ?count = 2,
                            IF(?firstColumn, 1.44, 1.60),
                            IF(?firstColumn, 1.18, 1.31)
                        )
                    )
                    AS ?expectedKe
                )
                FILTER (?ke != ?expectedKe)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Calculated minimum powers must satisfy formula 3.1 within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputCoefficientKe ?keQuantity ;
                    nltl:propellerDiameter ?diameterQuantity ;
                    nltl:brashIceChannelResistanceAtUpperIceWaterline ?upperResistanceQuantity ;
                    nltl:brashIceChannelResistanceAtLowerIceWaterline ?lowerResistanceQuantity ;
                    nltl:minimumRequiredPowerAtUpperIceWaterline ?upperPowerQuantity ;
                    nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerPowerQuantity .

                ?keQuantity qudt:numericValue ?ke ;
                    qudt:unit unit:UNITLESS .
                ?diameterQuantity qudt:numericValue ?diameter ;
                    qudt:unit unit:M .
                ?upperResistanceQuantity qudt:numericValue ?upperResistance ;
                    qudt:unit unit:N .
                ?lowerResistanceQuantity qudt:numericValue ?lowerResistance ;
                    qudt:unit unit:N .
                ?upperPowerQuantity qudt:numericValue ?upperPower ;
                    qudt:unit unit:KiloW .
                ?lowerPowerQuantity qudt:numericValue ?lowerPower ;
                    qudt:unit unit:KiloW .

                BIND((?upperPower * ?diameter) / ?ke AS ?upperBase)
                BIND(?upperResistance / 1000.0 AS ?upperResistanceKilonewton)
                BIND(?upperBase * ?upperBase AS ?upperLeft)
                BIND(
                    ?upperResistanceKilonewton *
                    ?upperResistanceKilonewton *
                    ?upperResistanceKilonewton
                    AS ?upperRight
                )
                BIND(0.000001 * ABS(?upperRight) AS ?upperRelativeTolerance)
                BIND(
                    IF(
                        ?upperRelativeTolerance > 0.000000001,
                        ?upperRelativeTolerance,
                        0.000000001
                    )
                    AS ?upperTolerance
                )

                BIND((?lowerPower * ?diameter) / ?ke AS ?lowerBase)
                BIND(?lowerResistance / 1000.0 AS ?lowerResistanceKilonewton)
                BIND(?lowerBase * ?lowerBase AS ?lowerLeft)
                BIND(
                    ?lowerResistanceKilonewton *
                    ?lowerResistanceKilonewton *
                    ?lowerResistanceKilonewton
                    AS ?lowerRight
                )
                BIND(0.000001 * ABS(?lowerRight) AS ?lowerRelativeTolerance)
                BIND(
                    IF(
                        ?lowerRelativeTolerance > 0.000000001,
                        ?lowerRelativeTolerance,
                        0.000000001
                    )
                    AS ?lowerTolerance
                )

                FILTER (
                    ABS(?upperLeft - ?upperRight) > ?upperTolerance ||
                    ABS(?lowerLeft - ?lowerRight) > ?lowerTolerance
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Maximum continuous rating power must be no less than both calculated minimum powers." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?mcrQuantity ;
                    nltl:minimumRequiredPowerAtUpperIceWaterline ?upperPowerQuantity ;
                    nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerPowerQuantity .

                ?mcrQuantity qudt:numericValue ?mcr ;
                    qudt:unit unit:KiloW .
                ?upperPowerQuantity qudt:numericValue ?upperPower ;
                    qudt:unit unit:KiloW .
                ?lowerPowerQuantity qudt:numericValue ?lowerPower ;
                    qudt:unit unit:KiloW .

                FILTER (?mcr < ?upperPower || ?mcr < ?lowerPower)
            }
        """
    ] .
