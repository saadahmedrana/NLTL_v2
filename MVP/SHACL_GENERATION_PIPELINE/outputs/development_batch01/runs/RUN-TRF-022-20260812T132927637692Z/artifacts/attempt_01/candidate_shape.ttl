@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF022Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "0"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path ( nltl:hasComponent nltl:clampedHullGeometryTerm ) ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path ( nltl:hasComponent nltl:bowRakeAtQuarterBreadth ) ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path ( nltl:hasComponent nltl:waterlineAngleAtQuarterBreadth ) ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Bow rake and waterline angle inputs must be available on the same component for the flare-angle calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component ;
                          nltl:flareAngle ?psiQuantity .
                    ?component nltl:bowRakeAtQuarterBreadth ?phiQuantity ;
                               nltl:waterlineAngleAtQuarterBreadth ?alphaQuantity .
                    ?phiQuantity qudt:numericValue ?phi ;
                                 qudt:unit unit:DEG .
                    ?alphaQuantity qudt:numericValue ?alpha ;
                                   qudt:unit unit:DEG .
                    ?psiQuantity qudt:numericValue ?psi ;
                                 qudt:unit unit:DEG .
                    FILTER(
                        datatype(?phi) = xsd:decimal &&
                        datatype(?alpha) = xsd:decimal &&
                        datatype(?psi) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The clamped hull geometry term must equal ((L*T)/B^2)^3 clamped to the inclusive interval from 5 to 20." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:clampedHullGeometryTerm ?clampedQuantity .
                ?clampedQuantity qudt:numericValue ?actual ;
                                 qudt:unit unit:UNITLESS .
                FILTER(datatype(?actual) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:shipLength ?lengthQuantity ;
                          nltl:iceClassDraught ?draughtQuantity ;
                          nltl:shipBreadth ?breadthQuantity .
                    ?lengthQuantity qudt:numericValue ?length ;
                                    qudt:unit unit:M .
                    ?draughtQuantity qudt:numericValue ?draught ;
                                     qudt:unit unit:M .
                    ?breadthQuantity qudt:numericValue ?breadth ;
                                     qudt:unit unit:M .
                    FILTER(
                        datatype(?length) = xsd:decimal &&
                        datatype(?draught) = xsd:decimal &&
                        datatype(?breadth) = xsd:decimal &&
                        ?breadth > "0"^^xsd:decimal
                    )
                    BIND(
                        (?length * ?draught) / (?breadth * ?breadth)
                        AS ?ratio
                    )
                    BIND((?ratio * ?ratio * ?ratio) AS ?unclamped)
                    BIND(
                        IF(
                            ?unclamped < "5"^^xsd:decimal,
                            "5"^^xsd:decimal,
                            IF(
                                ?unclamped > "20"^^xsd:decimal,
                                "20"^^xsd:decimal,
                                ?unclamped
                            )
                        )
                        AS ?expected
                    )
                    FILTER(?actual = ?expected)
                }
            }
        """
    ] .
