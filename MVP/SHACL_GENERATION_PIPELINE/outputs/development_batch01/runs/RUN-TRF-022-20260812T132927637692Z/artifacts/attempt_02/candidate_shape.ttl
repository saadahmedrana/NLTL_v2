@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF022NewShipCalculationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:hasValue "845"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-M2-SEC2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "C_3 must equal 845 kg/(m^2*s^2)."
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:hasValue "42"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-M2-SEC2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "C_4 must equal 42 kg/(m^2*s^2)."
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:hasValue "825"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloGM-PER-SEC2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "C_5 must equal 825 kg/s^2."
    ] ;
    sh:sparql [
        sh:message "The calculation requires one component containing degree-valued phi_2, alpha, and psi inputs." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:bowRakeAtQuarterBreadth ?phi ;
                               nltl:waterlineAngleAtQuarterBreadth ?alpha ;
                               nltl:flareAngle ?psi .
                    ?phi qudt:numericValue ?phiValue ;
                         qudt:unit unit:DEG .
                    ?alpha qudt:numericValue ?alphaValue ;
                           qudt:unit unit:DEG .
                    ?psi qudt:numericValue ?psiValue ;
                         qudt:unit unit:DEG .
                    FILTER(
                        datatype(?phiValue) = xsd:decimal &&
                        datatype(?alphaValue) = xsd:decimal &&
                        datatype(?psiValue) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The clamped hull geometry term must use ship length, ice-class draught, and breadth in metres and a dimensionless component result." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:shipLength ?length ;
                          nltl:iceClassDraught ?draught ;
                          nltl:shipBreadth ?breadth ;
                          nltl:hasComponent ?component .
                    ?component nltl:clampedHullGeometryTerm ?clamped .
                    ?length qudt:numericValue ?lengthValue ;
                            qudt:unit unit:M .
                    ?draught qudt:numericValue ?draughtValue ;
                             qudt:unit unit:M .
                    ?breadth qudt:numericValue ?breadthValue ;
                             qudt:unit unit:M .
                    ?clamped qudt:numericValue ?clampedValue ;
                             qudt:unit unit:UNITLESS .
                    FILTER(
                        datatype(?lengthValue) = xsd:decimal &&
                        datatype(?draughtValue) = xsd:decimal &&
                        datatype(?breadthValue) = xsd:decimal &&
                        datatype(?clampedValue) = xsd:decimal &&
                        ?breadthValue != 0
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The clamped hull geometry term must equal max(5, min(20, ((L*T)/(B*B))^3))." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipLength ?length ;
                      nltl:iceClassDraught ?draught ;
                      nltl:shipBreadth ?breadth ;
                      nltl:hasComponent ?component .
                ?component nltl:clampedHullGeometryTerm ?clamped .
                ?length qudt:numericValue ?lengthValue ;
                        qudt:unit unit:M .
                ?draught qudt:numericValue ?draughtValue ;
                         qudt:unit unit:M .
                ?breadth qudt:numericValue ?breadthValue ;
                         qudt:unit unit:M .
                ?clamped qudt:numericValue ?clampedValue ;
                         qudt:unit unit:UNITLESS .
                FILTER(?breadthValue != 0)
                BIND((?lengthValue * ?draughtValue) / (?breadthValue * ?breadthValue) AS ?ratio)
                BIND(?ratio * ?ratio * ?ratio AS ?unclamped)
                {
                    FILTER(?unclamped < 5 && ?clampedValue != 5)
                }
                UNION
                {
                    FILTER(?unclamped >= 5 && ?unclamped <= 20 && ?clampedValue != ?unclamped)
                }
                UNION
                {
                    FILTER(?unclamped > 20 && ?clampedValue != 20)
                }
            }
        """
    ] .
