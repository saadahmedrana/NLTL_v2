@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF022Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:C3QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:C4QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:C5QuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:sparql [
        sh:message "The flare-angle formula is undefined when sin of the waterline angle is zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:waterlineAngleAtQuarterBreadth ?alphaQuantity .
                ?alphaQuantity qudt:numericValue ?alphaValue .
                BIND(
                    xsd:double(?alphaValue) * math:pi() / 180.0e0
                    AS ?alphaRadians
                )
                BIND(math:sin(?alphaRadians) AS ?denominator)
                FILTER(?denominator = 0.0e0)
            }
        """
    ] ;
    sh:sparql [
        sh:message "flareAngle must equal atan(tan(bowRakeAtQuarterBreadth) / sin(waterlineAngleAtQuarterBreadth))." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:bowRakeAtQuarterBreadth ?phiQuantity ;
                      nltl:waterlineAngleAtQuarterBreadth ?alphaQuantity ;
                      nltl:flareAngle ?psiQuantity .
                ?phiQuantity qudt:numericValue ?phiValue .
                ?alphaQuantity qudt:numericValue ?alphaValue .
                ?psiQuantity qudt:numericValue ?psiValue .
                BIND(
                    xsd:double(?phiValue) * math:pi() / 180.0e0
                    AS ?phiRadians
                )
                BIND(
                    xsd:double(?alphaValue) * math:pi() / 180.0e0
                    AS ?alphaRadians
                )
                BIND(math:sin(?alphaRadians) AS ?denominator)
                FILTER(?denominator != 0.0e0)
                BIND(
                    math:atan(
                        math:tan(?phiRadians) / ?denominator
                    ) * 180.0e0 / math:pi()
                    AS ?expectedPsi
                )
                FILTER(xsd:double(?psiValue) != ?expectedPsi)
            }
        """
    ] ;
    sh:sparql [
        sh:message "shipBreadth must be non-zero for the hull geometry calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipBreadth ?breadthQuantity .
                ?breadthQuantity qudt:numericValue ?breadthValue .
                FILTER(xsd:decimal(?breadthValue) = 0)
            }
        """
    ] ;
    sh:sparql [
        sh:message "clampedHullGeometryTerm must equal the cube of shipLength times iceClassDraught divided by squared shipBreadth, clamped to the inclusive interval from 5 to 20." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipLength ?lengthQuantity ;
                      nltl:iceClassDraught ?draughtQuantity ;
                      nltl:shipBreadth ?breadthQuantity ;
                      nltl:clampedHullGeometryTerm ?clampedQuantity .
                ?lengthQuantity qudt:numericValue ?lengthValue .
                ?draughtQuantity qudt:numericValue ?draughtValue .
                ?breadthQuantity qudt:numericValue ?breadthValue .
                ?clampedQuantity qudt:numericValue ?clampedValue .
                FILTER(xsd:decimal(?breadthValue) != 0)
                BIND(
                    (xsd:decimal(?lengthValue) * xsd:decimal(?draughtValue))
                    /
                    (xsd:decimal(?breadthValue) * xsd:decimal(?breadthValue))
                    AS ?geometryRatio
                )
                BIND(
                    ?geometryRatio * ?geometryRatio * ?geometryRatio
                    AS ?rawGeometryTerm
                )
                BIND(
                    IF(
                        ?rawGeometryTerm < 5,
                        5,
                        IF(?rawGeometryTerm > 20, 20, ?rawGeometryTerm)
                    )
                    AS ?expectedClampedTerm
                )
                FILTER(xsd:decimal(?clampedValue) != ?expectedClampedTerm)
            }
        """
    ] .

gen:C3QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "845"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gen:C4QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "42"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gen:C5QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "825"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
