@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DegreeQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:C3QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "845"^^xsd:decimal ;
        sh:maxInclusive "845"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:C4QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "42"^^xsd:decimal ;
        sh:maxInclusive "42"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:C5QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "825"^^xsd:decimal ;
        sh:maxInclusive "825"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F1QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "23"^^xsd:decimal ;
        sh:maxInclusive "23"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F2QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "45.8"^^xsd:decimal ;
        sh:maxInclusive "45.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F3QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "14.7"^^xsd:decimal ;
        sh:maxInclusive "14.7"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F4QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "29"^^xsd:decimal ;
        sh:maxInclusive "29"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:G1QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1530"^^xsd:decimal ;
        sh:maxInclusive "1530"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:G2QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "170"^^xsd:decimal ;
        sh:maxInclusive "170"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:G3QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "400"^^xsd:decimal ;
        sh:maxInclusive "400"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF022Shape a sh:NodeShape ;
    sh:targetClass nltl:benchmarkEntity ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:C3QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:C4QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:C5QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:F1QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:F2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:F3QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:F4QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:G1QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:G2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:G3QuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:sparql [
        sh:message "The clamped hull geometry term or flare-angle relation is inconsistent with the required formula; derived values use relative tolerance 1e-6 with absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipLength/qudt:numericValue ?length ;
                      nltl:iceClassDraught/qudt:numericValue ?draught ;
                      nltl:shipBreadth/qudt:numericValue ?breadth ;
                      nltl:clampedHullGeometryTerm/qudt:numericValue ?actualTerm ;
                      nltl:flareAngle/qudt:numericValue ?actualPsi ;
                      nltl:bowRakeAtQuarterBreadth/qudt:numericValue ?phi2Degrees ;
                      nltl:waterlineAngleAtQuarterBreadth/qudt:numericValue ?alphaDegrees .

                BIND(IF(?breadth = 0, 0,
                        (?length * ?draught) / (?breadth * ?breadth)) AS ?ratio)
                BIND(?ratio * ?ratio * ?ratio AS ?rawTerm)
                BIND(IF(?rawTerm < 5, 5,
                        IF(?rawTerm > 20, 20, ?rawTerm)) AS ?expectedTerm)
                BIND(IF(ABS(?expectedTerm) * 0.000001 > 0.000000001,
                        ABS(?expectedTerm) * 0.000001,
                        0.000000001) AS ?termTolerance)

                BIND(?phi2Degrees * 0.017453292519943295 AS ?phi2Radians)
                BIND(?alphaDegrees * 0.017453292519943295 AS ?alphaRadians)
                BIND(SIN(?alphaRadians) AS ?alphaSine)
                BIND(IF(ABS(?alphaSine) < 0.000000000000001,
                        0,
                        TAN(?phi2Radians) / ?alphaSine) AS ?psiRatio)
                BIND(ATAN(?psiRatio) / 0.017453292519943295 AS ?expectedPsi)
                BIND(IF(ABS(?expectedPsi) * 0.000001 > 0.000000001,
                        ABS(?expectedPsi) * 0.000001,
                        0.000000001) AS ?psiTolerance)

                FILTER(
                    ?breadth = 0 ||
                    ABS(?alphaSine) < 0.000000000000001 ||
                    ABS(?actualTerm - ?expectedTerm) > ?termTolerance ||
                    ABS(?actualPsi - ?expectedPsi) > ?psiTolerance
                )
            }
        """
    ] .
