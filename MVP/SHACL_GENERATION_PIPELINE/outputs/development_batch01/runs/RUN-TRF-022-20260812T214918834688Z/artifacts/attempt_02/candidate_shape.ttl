@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:NewShipHullGeometryShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this rdf:type nltl:ship ;
                      nltl:constructionStageDate ?date .
                FILTER (
                    YEAR(?date) > 2022 ||
                    (YEAR(?date) = 2022 && MONTH(?date) > 1) ||
                    (YEAR(?date) = 2022 && MONTH(?date) = 1 && DAY(?date) >= 1)
                )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientC3Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientC4Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientC5Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientF1Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientF2Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientF3Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientF4Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientG1Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientG2Shape
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CoefficientG3Shape
    ] ;
    sh:sparql [
        sh:message "The clamped hull geometry term must equal ((L*T)/B^2)^3 clamped to [5,20], within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipLength/qudt:numericValue ?lengthValue ;
                      nltl:iceClassDraught/qudt:numericValue ?draughtValue ;
                      nltl:shipBreadth/qudt:numericValue ?breadthValue ;
                      nltl:clampedHullGeometryTerm/qudt:numericValue ?actualValue .
                BIND(xsd:decimal(?lengthValue) AS ?length)
                BIND(xsd:decimal(?draughtValue) AS ?draught)
                BIND(xsd:decimal(?breadthValue) AS ?breadth)
                BIND(xsd:decimal(?actualValue) AS ?actual)
                BIND((?length * ?draught) / (?breadth * ?breadth) AS ?ratio)
                BIND(?ratio * ?ratio * ?ratio AS ?raw)
                BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                BIND(IF(ABS(?expected) > 0.001, 0.000001 * ABS(?expected), 0.000000001) AS ?tolerance)
                FILTER(
                    ?breadth = 0 ||
                    ABS(?actual - ?expected) > ?tolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "flareAngle must equal atan(tan(bowRakeAtQuarterBreadth)/sin(waterlineAngleAtQuarterBreadth)) in degrees; singular or zero-denominator inputs are non-conforming." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowRakeAtQuarterBreadth/qudt:numericValue ?phiValue ;
                      nltl:waterlineAngleAtQuarterBreadth/qudt:numericValue ?alphaValue ;
                      nltl:flareAngle/qudt:numericValue ?psiValue .
                BIND(xsd:double(?phiValue) AS ?phiDegrees)
                BIND(xsd:double(?alphaValue) AS ?alphaDegrees)
                BIND(xsd:double(?psiValue) AS ?actualDegrees)
                BIND(3.14159265358979323846 AS ?pi)
                BIND(?phiDegrees * ?pi / 180.0 AS ?phiRadians)
                BIND(?alphaDegrees * ?pi / 180.0 AS ?alphaRadians)
                BIND(SIN(?alphaRadians) AS ?sinAlpha)
                BIND(COS(?phiRadians) AS ?cosPhi)
                BIND(
                    IF(
                        ABS(?sinAlpha) > 0.000000000001 && ABS(?cosPhi) > 0.000000000001,
                        ATAN(TAN(?phiRadians) / ?sinAlpha) * 180.0 / ?pi,
                        0.0
                    )
                    AS ?expectedDegrees
                )
                BIND(
                    IF(
                        ABS(?expectedDegrees) > 0.001,
                        0.000001 * ABS(?expectedDegrees),
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(
                    ABS(?sinAlpha) <= 0.000000000001 ||
                    ABS(?cosPhi) <= 0.000000000001 ||
                    ABS(?actualDegrees - ?expectedDegrees) > ?tolerance
                )
            }
        """
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "5"^^xsd:decimal ;
        sh:maxInclusive "20"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CoefficientC3Shape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:hasValue "845"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CoefficientC4Shape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:hasValue "42"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

