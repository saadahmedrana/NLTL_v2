gen:G3Quantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "400"^^xsd:decimal ;
        sh:maxInclusive "400"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( nltl:newtonPerMetreToPowerOnePointFiveUnit )
    ] .
