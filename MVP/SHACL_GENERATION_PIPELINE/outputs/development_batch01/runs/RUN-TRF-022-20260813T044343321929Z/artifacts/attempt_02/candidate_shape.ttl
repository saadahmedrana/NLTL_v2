@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF022Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single construction stage date is required to determine TRF-022 applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:coefficientC3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:C3ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientC4 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:C4ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientC5 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:C5ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:F1ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:F2ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:F3ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF4 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:F4ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientG1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:G1ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientG2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:G2ValueShape
            ] ;
            sh:property [
                sh:path nltl:coefficientG3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:G3ValueShape
            ] ;
            sh:property [
                sh:path nltl:bowRakeAtQuarterBreadth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:DegreeOperandShape
            ] ;
            sh:property [
                sh:path nltl:waterlineAngleAtQuarterBreadth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:DegreeOperandShape
            ] ;
            sh:property [
                sh:path nltl:flareAngle ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:DegreeOperandShape
            ] ;
            sh:property [
                sh:path nltl:shipLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:MetreOperandShape
            ] ;
            sh:property [
                sh:path nltl:iceClassDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:MetreOperandShape
            ] ;
            sh:property [
                sh:path nltl:shipBreadth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:MetreOperandShape
            ] ;
            sh:property [
                sh:path nltl:clampedHullGeometryTerm ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ClampedTermShape
            ] ;
            sh:sparql [
                sh:message "Flare angle must equal atan(tan(bow rake at quarter breadth) / sin(waterline angle at quarter breadth)) within the specified numerical tolerance." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bowRakeAtQuarterBreadth ?phiNode ;
                              nltl:waterlineAngleAtQuarterBreadth ?alphaNode ;
                              nltl:flareAngle ?psiNode .
                        ?phiNode qudt:numericValue ?phi .
                        ?alphaNode qudt:numericValue ?alpha .
                        ?psiNode qudt:numericValue ?psi .
                        BIND(xsd:decimal(?phi) * 3.141592653589793 / 180.0 AS ?phiRad)
                        BIND(xsd:decimal(?alpha) * 3.141592653589793 / 180.0 AS ?alphaRad)
                        BIND(math:sin(?alphaRad) AS ?sinAlpha)
                        BIND(
                            IF(
                                ABS(?sinAlpha) <= 0.000000000001,
                                0.0,
                                math:atan(math:tan(?phiRad) / ?sinAlpha)
                                * 180.0 / 3.141592653589793
                            )
                            AS ?expectedPsi
                        )
                        FILTER(
                            ABS(?sinAlpha) <= 0.000000000001 ||
                            ABS(xsd:decimal(?psi) - ?expectedPsi)
                                > (0.000000001 + 0.000001 * ABS(?expectedPsi))
                        )
                    }
                """
            ] ;
            sh:sparql [
                sh:message "The clamped hull geometry term must equal ((L*T)/B^2)^3 clamped to the inclusive interval from 5 through 20, within the specified numerical tolerance." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipLength ?lengthNode ;
                              nltl:iceClassDraught ?draughtNode ;
                              nltl:shipBreadth ?breadthNode ;
                              nltl:clampedHullGeometryTerm ?clampedNode .
                        ?lengthNode qudt:numericValue ?length .
                        ?draughtNode qudt:numericValue ?draught .
                        ?breadthNode qudt:numericValue ?breadth .
                        ?clampedNode qudt:numericValue ?actual .
                        BIND(
                            IF(
                                xsd:decimal(?breadth) = 0.0,
                                0.0,
                                (
                                    (xsd:decimal(?length) * xsd:decimal(?draught))
                                    /
                                    (xsd:decimal(?breadth) * xsd:decimal(?breadth))
                                ) *
                                (
                                    (xsd:decimal(?length) * xsd:decimal(?draught))
                                    /
                                    (xsd:decimal(?breadth) * xsd:decimal(?breadth))
                                ) *
                                (
                                    (xsd:decimal(?length) * xsd:decimal(?draught))
                                    /
                                    (xsd:decimal(?breadth) * xsd:decimal(?breadth))
                                )
                            )
                            AS ?rawTerm
                        )
                        BIND(
                            IF(?rawTerm < 5.0, 5.0, IF(?rawTerm > 20.0, 20.0, ?rawTerm))
                            AS ?expected
                        )
                        FILTER(
                            xsd:decimal(?breadth) = 0.0 ||
                            ABS(xsd:decimal(?actual) - ?expected)
                                > (0.000000001 + 0.000001 * ABS(?expected))
                        )
                    }
                """
            ]
        ]
    ) .

gs:C3ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "845"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gs:C4ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "42"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gs:C5ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "825"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit
    ] .

gs:F1ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "23"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N-PER-M2
    ] .

