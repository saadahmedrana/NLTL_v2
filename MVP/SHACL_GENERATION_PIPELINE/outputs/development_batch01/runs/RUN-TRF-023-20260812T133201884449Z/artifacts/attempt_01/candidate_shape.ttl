@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-023-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship of ice class IB or IC subject to the 1985 regulations must have maximum continuous rating power in kW at least equal to the required power under the 1985 rules." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          nltl:iceClass ?iceClass .

    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))

    FILTER NOT EXISTS {
        $this nltl:maximumContinuousRatingPower ?mcrPower ;
              nltl:requiredPowerUnder1985Rules ?requiredPower .

        ?mcrPower qudt:numericValue ?mcrValue ;
                  qudt:unit unit:KiloW .

        ?requiredPower qudt:numericValue ?requiredValue ;
                       qudt:unit unit:KiloW .

        FILTER (
            datatype(?mcrValue) = xsd:decimal &&
            datatype(?requiredValue) = xsd:decimal &&
            ?mcrValue >= ?requiredValue
        )
    }
}
"""
    ] .
