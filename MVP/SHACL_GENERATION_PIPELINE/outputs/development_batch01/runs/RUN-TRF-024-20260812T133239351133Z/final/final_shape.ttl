@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF024Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA Super or IA ship must use the section 3.2.2 compliance method by the calculated deadline." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate ;
          nltl:deliveryDate ?deliveryDate ;
          nltl:assessmentDate ?assessmentDate .

    VALUES ?iceClass {
        nltl:iceClassIaSuper
        nltl:iceClassIa
    }

    FILTER("2003-09-01"^^xsd:date > ?constructionDate)

    BIND(
        xsd:date(
            CONCAT(
                STR(xsd:integer(YEAR(?deliveryDate)) + 20),
                "-01-01"
            )
        )
        AS ?complianceDeadline
    )

    FILTER(?assessmentDate >= ?complianceDeadline)

    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod
              nltl:traficom2017Section3Point2Point2Method .
    }
}
"""
    ] .
