@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF024Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA Super or IA ship requires a valid delivery date to determine the compliance deadline." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?construction .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                BIND(xsd:date(?construction) AS ?constructionDate)
                FILTER(BOUND(?constructionDate))
                FILTER(?constructionDate < "2003-09-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?delivery .
                    BIND(xsd:date(?delivery) AS ?deliveryDate)
                    FILTER(BOUND(?deliveryDate))
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable IA Super or IA ship requires a valid assessment date to determine whether its compliance deadline has elapsed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?construction .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                BIND(xsd:date(?construction) AS ?constructionDate)
                FILTER(BOUND(?constructionDate))
                FILTER(?constructionDate < "2003-09-01"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?assessment .
                    BIND(xsd:date(?assessment) AS ?assessmentDate)
                    FILTER(BOUND(?assessmentDate))
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "After the calculated deadline, an applicable IA Super or IA ship must use the section 3.2.2 compliance method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?construction ;
                      nltl:deliveryDate ?delivery ;
                      nltl:assessmentDate ?assessment .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                BIND(xsd:date(?construction) AS ?constructionDate)
                BIND(xsd:date(?delivery) AS ?deliveryDate)
                BIND(xsd:date(?assessment) AS ?assessmentDate)
                FILTER(
                    BOUND(?constructionDate) &&
                    BOUND(?deliveryDate) &&
                    BOUND(?assessmentDate)
                )
                FILTER(?constructionDate < "2003-09-01"^^xsd:date)
                BIND(YEAR(?deliveryDate) + 20 AS ?deadlineYear)
                BIND(xsd:date(CONCAT(STR(?deadlineYear), "-01-01")) AS ?deadline)
                FILTER(?assessmentDate >= ?deadline)
                FILTER NOT EXISTS {
                    $this nltl:engineOutputComplianceMethod
                        nltl:traficom2017Section3Point2Point2Method .
                }
            }
        """
    ] .
