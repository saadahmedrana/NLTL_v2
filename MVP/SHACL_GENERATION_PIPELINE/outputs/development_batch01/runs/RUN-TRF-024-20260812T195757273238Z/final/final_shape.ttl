@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF024Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an IA Super or IA ship whose construction stage was before 1 September 2003, delivery and assessment dates are required; from 1 January of the delivery year plus twenty years, the section 3.2.2 compliance method is required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:constructionStageDate ?constructionDate .

    FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
    FILTER(
        DATATYPE(?constructionDate) = xsd:date &&
        (
            YEAR(?constructionDate) < 2003 ||
            (
                YEAR(?constructionDate) = 2003 &&
                (
                    MONTH(?constructionDate) < 9 ||
                    (
                        MONTH(?constructionDate) = 9 &&
                        DAY(?constructionDate) < 1
                    )
                )
            )
        )
    )

    FILTER(
        NOT EXISTS {
            $this nltl:deliveryDate ?availableDeliveryDate .
            FILTER(DATATYPE(?availableDeliveryDate) = xsd:date)
        }
        ||
        NOT EXISTS {
            $this nltl:assessmentDate ?availableAssessmentDate .
            FILTER(DATATYPE(?availableAssessmentDate) = xsd:date)
        }
        ||
        EXISTS {
            $this nltl:deliveryDate ?deliveryDate ;
                  nltl:assessmentDate ?assessmentDate .

            FILTER(
                DATATYPE(?deliveryDate) = xsd:date &&
                DATATYPE(?assessmentDate) = xsd:date
            )
            FILTER(
                YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                (
                    YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                    (
                        MONTH(?assessmentDate) > 1 ||
                        (
                            MONTH(?assessmentDate) = 1 &&
                            DAY(?assessmentDate) >= 1
                        )
                    )
                )
            )
            FILTER NOT EXISTS {
                $this nltl:engineOutputComplianceMethod
                    nltl:traficom2017Section3Point2Point2Method .
            }
        }
    )
}
"""
    ] .
