@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF025Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "IA Super ships without a bulb require conforming quantity inputs and results for the C1 and C2 calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent false .
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipBreadth ?bq .
                        ?bq qudt:numericValue ?b ;
                            qudt:unit unit:M .
                        FILTER (datatype(?b) = xsd:decimal && ?b != 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:shipLength ?lq .
                        ?lq qudt:numericValue ?l ;
                            qudt:unit unit:M .
                        FILTER (datatype(?l) = xsd:decimal && ?l > 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceClassDraught ?tq .
                        ?tq qudt:numericValue ?t ;
                            qudt:unit unit:M .
                        FILTER (datatype(?t) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF1 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M2 .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF2 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF3 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientF4 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M2 .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientG1 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientG2 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:coefficientG3 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit ?u .
                        FILTER (datatype(?v) = xsd:decimal && isIRI(?u))
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC1 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC2 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For IA Super without a bulb, C1 must equal f1*(B*L)/(2*T/B+1)+1.84*(f2*B+f3*L+f4*B*L)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent false .
                FILTER NOT EXISTS {
                    $this nltl:shipBreadth ?bq ;
                          nltl:shipLength ?lq ;
                          nltl:iceClassDraught ?tq ;
                          nltl:coefficientF1 ?f1q ;
                          nltl:coefficientF2 ?f2q ;
                          nltl:coefficientF3 ?f3q ;
                          nltl:coefficientF4 ?f4q ;
                          nltl:brashIceResistanceCoefficientC1 ?c1q .
                    ?bq qudt:numericValue ?b ;
                        qudt:unit unit:M .
                    ?lq qudt:numericValue ?l ;
                        qudt:unit unit:M .
                    ?tq qudt:numericValue ?t ;
                        qudt:unit unit:M .
                    ?f1q qudt:numericValue ?f1 ;
                         qudt:unit unit:N-PER-M2 .
                    ?f2q qudt:numericValue ?f2 ;
                         qudt:unit unit:N-PER-M .
                    ?f3q qudt:numericValue ?f3 ;
                         qudt:unit unit:N-PER-M .
                    ?f4q qudt:numericValue ?f4 ;
                         qudt:unit unit:N-PER-M2 .
                    ?c1q qudt:numericValue ?c1 ;
                         qudt:unit unit:N .
                    FILTER (
                        datatype(?b) = xsd:decimal &&
                        datatype(?l) = xsd:decimal &&
                        datatype(?t) = xsd:decimal &&
                        datatype(?f1) = xsd:decimal &&
                        datatype(?f2) = xsd:decimal &&
                        datatype(?f3) = xsd:decimal &&
                        datatype(?f4) = xsd:decimal &&
                        datatype(?c1) = xsd:decimal &&
                        ?b != 0 &&
                        ?c1 = (
                            ?f1 * (?b * ?l) / (2 * ?t / ?b + 1)
                            + 1.84 * (?f2 * ?b + ?f3 * ?l + ?f4 * ?b * ?l)
                        )
                    )
                }
            }
        """
    ] .
