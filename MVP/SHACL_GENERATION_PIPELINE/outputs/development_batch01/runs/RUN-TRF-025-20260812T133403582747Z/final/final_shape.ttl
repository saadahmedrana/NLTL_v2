@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF025Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Ice class IA Super requires a boolean bulbous-bow applicability value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                FILTER NOT EXISTS {
                    $this nltl:bulbousBowPresent ?bulb .
                    FILTER(DATATYPE(?bulb) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable IA Super ship without a bulb lacks a required decimal formula operand, result, or required unit for C1 or C2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb .
                FILTER(DATATYPE(?bulb) = xsd:boolean && ?bulb = false)

                {
                    FILTER NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC1 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC2 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientF1 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M2 .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientF2 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientF3 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientF4 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M2 .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientG1 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientG2 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:N-PER-M .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:coefficientG3 ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit ?u .
                        ?u qudt:symbol ?symbol .
                        FILTER(
                            DATATYPE(?v) = xsd:decimal &&
                            STR(?symbol) = "N/m^1.5"
                        )
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:shipBreadth ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:M .
                        FILTER(DATATYPE(?v) = xsd:decimal && ?v != 0)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:shipLength ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:M .
                        FILTER(DATATYPE(?v) = xsd:decimal && ?v > 0)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:iceClassDraught ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:M .
                        FILTER(DATATYPE(?v) = xsd:decimal)
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:shipBreadth ?bq ;
                              nltl:iceClassDraught ?tq .
                        ?bq qudt:numericValue ?b ;
                            qudt:unit unit:M .
                        ?tq qudt:numericValue ?t ;
                            qudt:unit unit:M .
                        FILTER(
                            DATATYPE(?b) = xsd:decimal &&
                            DATATYPE(?t) = xsd:decimal &&
                            ?b != 0 &&
                            (2.0 * ?t / ?b + 1.0) != 0
                        )
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "C1 does not equal f1*(B*L)/(2*T/B+1) + 1.84*(f2*B+f3*L+f4*B*L)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb ;
                      nltl:brashIceResistanceCoefficientC1 ?c1q ;
                      nltl:coefficientF1 ?f1q ;
                      nltl:coefficientF2 ?f2q ;
                      nltl:coefficientF3 ?f3q ;
                      nltl:coefficientF4 ?f4q ;
                      nltl:shipBreadth ?bq ;
                      nltl:shipLength ?lq ;
                      nltl:iceClassDraught ?tq .

                ?c1q qudt:numericValue ?c1 ; qudt:unit unit:N .
                ?f1q qudt:numericValue ?f1 ; qudt:unit unit:N-PER-M2 .
                ?f2q qudt:numericValue ?f2 ; qudt:unit unit:N-PER-M .
                ?f3q qudt:numericValue ?f3 ; qudt:unit unit:N-PER-M .
                ?f4q qudt:numericValue ?f4 ; qudt:unit unit:N-PER-M2 .
                ?bq qudt:numericValue ?b ; qudt:unit unit:M .
                ?lq qudt:numericValue ?l ; qudt:unit unit:M .
                ?tq qudt:numericValue ?t ; qudt:unit unit:M .

                FILTER(
                    DATATYPE(?bulb) = xsd:boolean &&
                    ?bulb = false &&
                    DATATYPE(?c1) = xsd:decimal &&
                    DATATYPE(?f1) = xsd:decimal &&
                    DATATYPE(?f2) = xsd:decimal &&
                    DATATYPE(?f3) = xsd:decimal &&
                    DATATYPE(?f4) = xsd:decimal &&
                    DATATYPE(?b) = xsd:decimal &&
                    DATATYPE(?l) = xsd:decimal &&
                    DATATYPE(?t) = xsd:decimal &&
                    ?b != 0 &&
                    ?l > 0 &&
                    (2.0 * ?t / ?b + 1.0) != 0 &&
                    ?c1 != (
                        ?f1 * (?b * ?l) / (2.0 * ?t / ?b + 1.0) +
                        1.84 * (?f2 * ?b + ?f3 * ?l + ?f4 * ?b * ?l)
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "C2 does not equal 3.52*(g1+g2*B) + g3*(1+1.2*T/B)*B^2/sqrt(L)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb ;
                      nltl:brashIceResistanceCoefficientC2 ?c2q ;
                      nltl:coefficientG1 ?g1q ;
                      nltl:coefficientG2 ?g2q ;
                      nltl:coefficientG3 ?g3q ;
                      nltl:shipBreadth ?bq ;
                      nltl:shipLength ?lq ;
                      nltl:iceClassDraught ?tq .

                ?c2q qudt:numericValue ?c2 ; qudt:unit unit:N .
                ?g1q qudt:numericValue ?g1 ; qudt:unit unit:N .
                ?g2q qudt:numericValue ?g2 ; qudt:unit unit:N-PER-M .
                ?g3q qudt:numericValue ?g3 ; qudt:unit ?g3Unit .
                ?g3Unit qudt:symbol ?g3Symbol .
                ?bq qudt:numericValue ?b ; qudt:unit unit:M .
                ?lq qudt:numericValue ?l ; qudt:unit unit:M .
                ?tq qudt:numericValue ?t ; qudt:unit unit:M .

                FILTER(
                    DATATYPE(?bulb) = xsd:boolean &&
                    ?bulb = false &&
                    DATATYPE(?c2) = xsd:decimal &&
                    DATATYPE(?g1) = xsd:decimal &&
                    DATATYPE(?g2) = xsd:decimal &&
                    DATATYPE(?g3) = xsd:decimal &&
                    DATATYPE(?b) = xsd:decimal &&
                    DATATYPE(?l) = xsd:decimal &&
                    DATATYPE(?t) = xsd:decimal &&
                    STR(?g3Symbol) = "N/m^1.5" &&
                    ?b != 0 &&
                    ?l > 0
                )

                BIND(3.52 * (?g1 + ?g2 * ?b) AS ?base)
                BIND(?g3 * (1.0 + 1.2 * ?t / ?b) * ?b * ?b AS ?numerator)
                BIND(?c2 - ?base AS ?difference)

                FILTER(
                    !(
                        (?numerator = 0 && ?difference = 0) ||
                        (
                            ?numerator != 0 &&
                            ?difference * ?numerator > 0 &&
                            ?difference * ?difference * ?l =
                                ?numerator * ?numerator
                        )
                    )
                )
            }
        """
    ] .
