@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF025Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For an IA Super ship explicitly recorded without a bulb, all formula operands and results must have decimal values in the required units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass nltl:iceClassIaSuper ;
          nltl:bulbousBowPresent ?bulb .
    FILTER (datatype(?bulb) = xsd:boolean && ?bulb = false)
    FILTER (
        NOT EXISTS {
            $this nltl:shipBreadth [
                qudt:numericValue ?b ;
                qudt:unit unit:M
            ] .
            FILTER (datatype(?b) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:shipLength [
                qudt:numericValue ?l ;
                qudt:unit unit:M
            ] .
            FILTER (datatype(?l) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:iceClassDraught [
                qudt:numericValue ?t ;
                qudt:unit unit:M
            ] .
            FILTER (datatype(?t) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientF1 [
                qudt:numericValue ?f1 ;
                qudt:unit unit:N-PER-M2
            ] .
            FILTER (datatype(?f1) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientF2 [
                qudt:numericValue ?f2 ;
                qudt:unit unit:N-PER-M
            ] .
            FILTER (datatype(?f2) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientF3 [
                qudt:numericValue ?f3 ;
                qudt:unit unit:N-PER-M
            ] .
            FILTER (datatype(?f3) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientF4 [
                qudt:numericValue ?f4 ;
                qudt:unit unit:N-PER-M2
            ] .
            FILTER (datatype(?f4) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientG1 [
                qudt:numericValue ?g1 ;
                qudt:unit unit:N
            ] .
            FILTER (datatype(?g1) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientG2 [
                qudt:numericValue ?g2 ;
                qudt:unit unit:N-PER-M
            ] .
            FILTER (datatype(?g2) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:coefficientG3 [
                qudt:numericValue ?g3 ;
                qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit
            ] .
            FILTER (datatype(?g3) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:brashIceResistanceCoefficientC1 [
                qudt:numericValue ?c1 ;
                qudt:unit unit:N
            ] .
            FILTER (datatype(?c1) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:brashIceResistanceCoefficientC2 [
                qudt:numericValue ?c2 ;
                qudt:unit unit:N
            ] .
            FILTER (datatype(?c2) = xsd:decimal)
        }
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "Ship breadth and length must permit evaluation of the IA Super no-bulb formulas." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass nltl:iceClassIaSuper ;
          nltl:bulbousBowPresent ?bulb ;
          nltl:shipBreadth [
              qudt:numericValue ?b ;
              qudt:unit unit:M
          ] ;
          nltl:shipLength [
              qudt:numericValue ?l ;
              qudt:unit unit:M
          ] ;
          nltl:iceClassDraught [
              qudt:numericValue ?t ;
              qudt:unit unit:M
          ] .
    FILTER (
        datatype(?bulb) = xsd:boolean &&
        ?bulb = false &&
        datatype(?b) = xsd:decimal &&
        datatype(?l) = xsd:decimal &&
        datatype(?t) = xsd:decimal
    )
    FILTER (?b <= 0.0 || ?l <= 0.0 || (2.0 * ?t / ?b + 1.0) = 0.0)
}
""" ;
    ] ;
    sh:sparql [
        sh:message "For an IA Super ship without a bulb, C1 and C2 must satisfy the prescribed formulas." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass nltl:iceClassIaSuper ;
          nltl:bulbousBowPresent ?bulb ;
          nltl:shipBreadth [
              qudt:numericValue ?b ;
              qudt:unit unit:M
          ] ;
          nltl:shipLength [
              qudt:numericValue ?l ;
              qudt:unit unit:M
          ] ;
          nltl:iceClassDraught [
              qudt:numericValue ?t ;
              qudt:unit unit:M
          ] ;
          nltl:coefficientF1 [
              qudt:numericValue ?f1 ;
              qudt:unit unit:N-PER-M2
          ] ;
          nltl:coefficientF2 [
              qudt:numericValue ?f2 ;
              qudt:unit unit:N-PER-M
          ] ;
          nltl:coefficientF3 [
              qudt:numericValue ?f3 ;
              qudt:unit unit:N-PER-M
          ] ;
          nltl:coefficientF4 [
              qudt:numericValue ?f4 ;
              qudt:unit unit:N-PER-M2
          ] ;
          nltl:coefficientG1 [
              qudt:numericValue ?g1 ;
              qudt:unit unit:N
          ] ;
          nltl:coefficientG2 [
              qudt:numericValue ?g2 ;
              qudt:unit unit:N-PER-M
          ] ;
          nltl:coefficientG3 [
              qudt:numericValue ?g3 ;
              qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit
          ] ;
          nltl:brashIceResistanceCoefficientC1 [
              qudt:numericValue ?c1 ;
              qudt:unit unit:N
          ] ;
          nltl:brashIceResistanceCoefficientC2 [
              qudt:numericValue ?c2 ;
              qudt:unit unit:N
          ] .
    FILTER (
        datatype(?bulb) = xsd:boolean &&
        ?bulb = false &&
        datatype(?b) = xsd:decimal &&
        datatype(?l) = xsd:decimal &&
        datatype(?t) = xsd:decimal &&
        datatype(?f1) = xsd:decimal &&
        datatype(?f2) = xsd:decimal &&
        datatype(?f3) = xsd:decimal &&
        datatype(?f4) = xsd:decimal &&
        datatype(?g1) = xsd:decimal &&
        datatype(?g2) = xsd:decimal &&
        datatype(?g3) = xsd:decimal &&
        datatype(?c1) = xsd:decimal &&
        datatype(?c2) = xsd:decimal &&
        ?b > 0.0 &&
        ?l > 0.0 &&
        (2.0 * ?t / ?b + 1.0) != 0.0
    )
    BIND (
        ?f1 * (?b * ?l) / (2.0 * ?t / ?b + 1.0) +
        1.84 * (?f2 * ?b + ?f3 * ?l + ?f4 * ?b * ?l)
        AS ?expectedC1
    )
    BIND (3.52 * (?g1 + ?g2 * ?b) AS ?c2Base)
    BIND (?g3 * (1.0 + 1.2 * ?t / ?b) * ?b * ?b AS ?c2Numerator)
    BIND (?c2 - ?c2Base AS ?c2Delta)
    FILTER (
        ?c1 != ?expectedC1 ||
        ?c2Delta * ?c2Numerator < 0.0 ||
        ?c2Delta * ?c2Delta * ?l != ?c2Numerator * ?c2Numerator
    )
}
""" ;
    ] .
