@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF025Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An IA Super ship must provide a boolean bulbous-bow status to determine applicability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                FILTER NOT EXISTS {
                    $this nltl:bulbousBowPresent ?bulb .
                    FILTER (datatype(?bulb) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An IA Super ship without a bulb must provide decimal formula quantities in their prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb .
                FILTER (?bulb = false)

                FILTER (
                    NOT EXISTS {
                        $this nltl:shipBreadth ?qB .
                        ?qB qudt:numericValue ?b ;
                            qudt:unit unit:M .
                        FILTER (datatype(?b) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:shipLength ?qL .
                        ?qL qudt:numericValue ?l ;
                            qudt:unit unit:M .
                        FILTER (datatype(?l) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:iceClassDraught ?qT .
                        ?qT qudt:numericValue ?t ;
                            qudt:unit unit:M .
                        FILTER (datatype(?t) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientF1 ?qF1 .
                        ?qF1 qudt:numericValue ?f1 ;
                             qudt:unit unit:N-PER-M2 .
                        FILTER (datatype(?f1) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientF2 ?qF2 .
                        ?qF2 qudt:numericValue ?f2 ;
                             qudt:unit unit:N-PER-M .
                        FILTER (datatype(?f2) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientF3 ?qF3 .
                        ?qF3 qudt:numericValue ?f3 ;
                             qudt:unit unit:N-PER-M .
                        FILTER (datatype(?f3) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientF4 ?qF4 .
                        ?qF4 qudt:numericValue ?f4 ;
                             qudt:unit unit:N-PER-M2 .
                        FILTER (datatype(?f4) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientG1 ?qG1 .
                        ?qG1 qudt:numericValue ?g1 ;
                             qudt:unit unit:N .
                        FILTER (datatype(?g1) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientG2 ?qG2 .
                        ?qG2 qudt:numericValue ?g2 ;
                             qudt:unit unit:N-PER-M .
                        FILTER (datatype(?g2) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:coefficientG3 ?qG3 .
                        ?qG3 qudt:numericValue ?g3 ;
                             qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                        FILTER (datatype(?g3) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC1 ?qC1 .
                        ?qC1 qudt:numericValue ?c1 ;
                             qudt:unit unit:N .
                        FILTER (datatype(?c1) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:brashIceResistanceCoefficientC2 ?qC2 .
                        ?qC2 qudt:numericValue ?c2 ;
                             qudt:unit unit:N .
                        FILTER (datatype(?c2) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "C1 must equal f1*(B*L)/(2*T/B+1)+1.84*(f2*B+f3*L+f4*B*L)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb .
                FILTER (?bulb = false)

                FILTER NOT EXISTS {
                    $this nltl:shipBreadth ?qB ;
                          nltl:shipLength ?qL ;
                          nltl:iceClassDraught ?qT ;
                          nltl:coefficientF1 ?qF1 ;
                          nltl:coefficientF2 ?qF2 ;
                          nltl:coefficientF3 ?qF3 ;
                          nltl:coefficientF4 ?qF4 ;
                          nltl:brashIceResistanceCoefficientC1 ?qC1 .

                    ?qB qudt:numericValue ?b ; qudt:unit unit:M .
                    ?qL qudt:numericValue ?l ; qudt:unit unit:M .
                    ?qT qudt:numericValue ?t ; qudt:unit unit:M .
                    ?qF1 qudt:numericValue ?f1 ; qudt:unit unit:N-PER-M2 .
                    ?qF2 qudt:numericValue ?f2 ; qudt:unit unit:N-PER-M .
                    ?qF3 qudt:numericValue ?f3 ; qudt:unit unit:N-PER-M .
                    ?qF4 qudt:numericValue ?f4 ; qudt:unit unit:N-PER-M2 .
                    ?qC1 qudt:numericValue ?c1 ; qudt:unit unit:N .

                    FILTER (
                        datatype(?b) = xsd:decimal &&
                        datatype(?l) = xsd:decimal &&
                        datatype(?t) = xsd:decimal &&
                        datatype(?f1) = xsd:decimal &&
                        datatype(?f2) = xsd:decimal &&
                        datatype(?f3) = xsd:decimal &&
                        datatype(?f4) = xsd:decimal &&
                        datatype(?c1) = xsd:decimal &&
                        ?b > 0 &&
                        ((2.0 * ?t / ?b) + 1.0) != 0 &&
                        ?c1 = (
                            ?f1 * (?b * ?l) / ((2.0 * ?t / ?b) + 1.0) +
                            1.84 * (?f2 * ?b + ?f3 * ?l + ?f4 * ?b * ?l)
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "C2 must equal 3.52*(g1+g2*B)+g3*(1+1.2*T/B)*B^2/sqrt(L)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb .
                FILTER (?bulb = false)

                FILTER NOT EXISTS {
                    $this nltl:shipBreadth ?qB ;
                          nltl:shipLength ?qL ;
                          nltl:iceClassDraught ?qT ;
                          nltl:coefficientG1 ?qG1 ;
                          nltl:coefficientG2 ?qG2 ;
                          nltl:coefficientG3 ?qG3 ;
                          nltl:brashIceResistanceCoefficientC2 ?qC2 .

                    ?qB qudt:numericValue ?b ; qudt:unit unit:M .
                    ?qL qudt:numericValue ?l ; qudt:unit unit:M .
                    ?qT qudt:numericValue ?t ; qudt:unit unit:M .
                    ?qG1 qudt:numericValue ?g1 ; qudt:unit unit:N .
                    ?qG2 qudt:numericValue ?g2 ; qudt:unit unit:N-PER-M .
                    ?qG3 qudt:numericValue ?g3 ;
                          qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                    ?qC2 qudt:numericValue ?c2 ; qudt:unit unit:N .

                    FILTER (
                        datatype(?b) = xsd:decimal &&
                        datatype(?l) = xsd:decimal &&
                        datatype(?t) = xsd:decimal &&
                        datatype(?g1) = xsd:decimal &&
                        datatype(?g2) = xsd:decimal &&
                        datatype(?g3) = xsd:decimal &&
                        datatype(?c2) = xsd:decimal &&
                        ?b > 0 &&
                        ?l > 0
                    )

                    BIND (?c2 - 3.52 * (?g1 + ?g2 * ?b) AS ?x)
                    BIND (?g3 * (1.0 + 1.2 * ?t / ?b) * ?b * ?b AS ?y)

                    FILTER (
                        ?x * ?x * ?l = ?y * ?y &&
                        ?x * ?y >= 0
                    )
                }
            }
        """
    ] .
