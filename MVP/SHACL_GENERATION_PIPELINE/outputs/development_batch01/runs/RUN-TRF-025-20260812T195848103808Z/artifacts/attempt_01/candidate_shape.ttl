@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:TRF025Shape
    a sh:NodeShape ;
    sh:targetClass nltl:benchmarkEntity ;
    sh:sparql [
        sh:message "For ice class IA Super without a bulb, C1 and C2 require complete decimal operands in their specified units and must match the prescribed formulas within relative tolerance 1e-6 or absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent ?bulb .
                FILTER (
                    DATATYPE(?bulb) = xsd:boolean &&
                    ?bulb = false
                )

                FILTER NOT EXISTS {
                    $this nltl:shipBreadth ?breadthQuantity ;
                          nltl:shipLength ?lengthQuantity ;
                          nltl:iceClassDraught ?draughtQuantity ;
                          nltl:coefficientF1 ?f1Quantity ;
                          nltl:coefficientF2 ?f2Quantity ;
                          nltl:coefficientF3 ?f3Quantity ;
                          nltl:coefficientF4 ?f4Quantity ;
                          nltl:coefficientG1 ?g1Quantity ;
                          nltl:coefficientG2 ?g2Quantity ;
                          nltl:coefficientG3 ?g3Quantity ;
                          nltl:brashIceResistanceCoefficientC1 ?c1Quantity ;
                          nltl:brashIceResistanceCoefficientC2 ?c2Quantity .

                    ?breadthQuantity
                        qudt:numericValue ?breadth ;
                        qudt:unit unit:M .
                    ?lengthQuantity
                        qudt:numericValue ?length ;
                        qudt:unit unit:M .
                    ?draughtQuantity
                        qudt:numericValue ?draught ;
                        qudt:unit unit:M .
                    ?f1Quantity
                        qudt:numericValue ?f1 ;
                        qudt:unit unit:N-PER-M2 .
                    ?f2Quantity
                        qudt:numericValue ?f2 ;
                        qudt:unit unit:N-PER-M .
                    ?f3Quantity
                        qudt:numericValue ?f3 ;
                        qudt:unit unit:N-PER-M .
                    ?f4Quantity
                        qudt:numericValue ?f4 ;
                        qudt:unit unit:N-PER-M2 .
                    ?g1Quantity
                        qudt:numericValue ?g1 ;
                        qudt:unit unit:N .
                    ?g2Quantity
                        qudt:numericValue ?g2 ;
                        qudt:unit unit:N-PER-M .
                    ?g3Quantity
                        qudt:numericValue ?g3 ;
                        qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                    ?c1Quantity
                        qudt:numericValue ?c1 ;
                        qudt:unit unit:N .
                    ?c2Quantity
                        qudt:numericValue ?c2 ;
                        qudt:unit unit:N .

                    FILTER (
                        DATATYPE(?breadth) = xsd:decimal &&
                        DATATYPE(?length) = xsd:decimal &&
                        DATATYPE(?draught) = xsd:decimal &&
                        DATATYPE(?f1) = xsd:decimal &&
                        DATATYPE(?f2) = xsd:decimal &&
                        DATATYPE(?f3) = xsd:decimal &&
                        DATATYPE(?f4) = xsd:decimal &&
                        DATATYPE(?g1) = xsd:decimal &&
                        DATATYPE(?g2) = xsd:decimal &&
                        DATATYPE(?g3) = xsd:decimal &&
                        DATATYPE(?c1) = xsd:decimal &&
                        DATATYPE(?c2) = xsd:decimal &&
                        ?breadth != 0 &&
                        ?length > 0
                    )

                    BIND (
                        ?f1 * (?breadth * ?length) /
                            (2 * ?draught / ?breadth + 1) +
                        1.84 * (
                            ?f2 * ?breadth +
                            ?f3 * ?length +
                            ?f4 * ?breadth * ?length
                        )
                        AS ?expectedC1
                    )
                    BIND (
                        3.52 * (?g1 + ?g2 * ?breadth) +
                        ?g3 * (1 + 1.2 * ?draught / ?breadth) *
                            ?breadth * ?breadth / SQRT(?length)
                        AS ?expectedC2
                    )

                    FILTER (
                        ABS(?c1 - ?expectedC1) <=
                            IF(
                                0.000001 * ABS(?expectedC1) > 0.000000001,
                                0.000001 * ABS(?expectedC1),
                                0.000000001
                            ) &&
                        ABS(?c2 - ?expectedC2) <=
                            IF(
                                0.000001 * ABS(?expectedC2) > 0.000000001,
                                0.000001 * ABS(?expectedC2),
                                0.000000001
                            )
                    )
                }
            }
        """
    ] .
