@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .

gen:NewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N ;
        sh:maxCount 1
    ] .

gen:NewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:maxCount 1
    ] .

gen:NewtonPerSquareMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:maxCount 1
    ] .

gen:NewtonPerMetrePowerOnePointFiveQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:maxCount 1
    ] .

gen:TRF025Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:shipBreadth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:shipLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:iceClassDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerSquareMetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientF4 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerSquareMetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientG1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientG2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:coefficientG3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetrePowerOnePointFiveQuantityShape
            ] ;
            sh:property [
                sh:path nltl:brashIceResistanceCoefficientC1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonQuantityShape
            ] ;
            sh:property [
                sh:path nltl:brashIceResistanceCoefficientC2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
    ) ;
    sh:message "Ice class and bulb status must establish a permitted branch; an IA Super ship without a bulb must provide all formula inputs and results with the required units." ;
    sh:sparql [
        sh:message "For an IA Super ship without a bulb, C1 and C2 must satisfy the prescribed formulas within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                      nltl:bulbousBowPresent false ;
                      nltl:shipBreadth ?breadthQuantity ;
                      nltl:shipLength ?lengthQuantity ;
                      nltl:iceClassDraught ?draughtQuantity ;
                      nltl:coefficientF1 ?f1Quantity ;
                      nltl:coefficientF2 ?f2Quantity ;
                      nltl:coefficientF3 ?f3Quantity ;
                      nltl:coefficientF4 ?f4Quantity ;
                      nltl:coefficientG1 ?g1Quantity ;
                      nltl:coefficientG2 ?g2Quantity ;
                      nltl:coefficientG3 ?g3Quantity ;
                      nltl:brashIceResistanceCoefficientC1 ?c1Quantity ;
                      nltl:brashIceResistanceCoefficientC2 ?c2Quantity .

                ?breadthQuantity qudt:numericValue ?breadth .
                ?lengthQuantity qudt:numericValue ?length .
                ?draughtQuantity qudt:numericValue ?draught .
                ?f1Quantity qudt:numericValue ?f1 .
                ?f2Quantity qudt:numericValue ?f2 .
                ?f3Quantity qudt:numericValue ?f3 .
                ?f4Quantity qudt:numericValue ?f4 .
                ?g1Quantity qudt:numericValue ?g1 .
                ?g2Quantity qudt:numericValue ?g2 .
                ?g3Quantity qudt:numericValue ?g3 .
                ?c1Quantity qudt:numericValue ?c1 .
                ?c2Quantity qudt:numericValue ?c2 .

                BIND(
                    ?f1 * (?breadth * ?length) /
                    (2 * ?draught / ?breadth + 1) +
                    1.84 * (
                        ?f2 * ?breadth +
                        ?f3 * ?length +
                        ?f4 * ?breadth * ?length
                    )
                    AS ?expectedC1
                )
                BIND(ABS(?c1 - ?expectedC1) AS ?c1Difference)
                BIND(
                    IF(ABS(?c1) > ABS(?expectedC1), ABS(?c1), ABS(?expectedC1))
                    AS ?c1Scale
                )
                BIND(
                    IF(
                        0.000001 * ?c1Scale > 0.000000000001,
                        0.000001 * ?c1Scale,
                        0.000000000001
                    )
                    AS ?c1Tolerance
                )

                BIND(3.52 * (?g1 + ?g2 * ?breadth) AS ?c2Base)
                BIND(
                    ?g3 * (1 + 1.2 * ?draught / ?breadth) *
                    ?breadth * ?breadth
                    AS ?c2Numerator
                )
                BIND(?c2 - ?c2Base AS ?c2Remainder)
                BIND(
                    ?c2Remainder * ?c2Remainder * ?length
                    AS ?c2Left
                )
                BIND(?c2Numerator * ?c2Numerator AS ?c2Right)
                BIND(ABS(?c2Left - ?c2Right) AS ?c2Difference)
                BIND(
                    IF(ABS(?c2Left) > ABS(?c2Right), ABS(?c2Left), ABS(?c2Right))
                    AS ?c2Scale
                )
                BIND(
                    IF(
                        0.000001 * ?c2Scale > 0.000000000001,
                        0.000001 * ?c2Scale,
                        0.000000000001
                    )
                    AS ?c2Tolerance
                )

                FILTER(
                    ?breadth <= 0 ||
                    ?length <= 0 ||
                    (2 * ?draught / ?breadth + 1) = 0 ||
                    ?c1Difference > ?c1Tolerance ||
                    (?c2Remainder * ?c2Numerator < 0) ||
                    ?c2Difference > ?c2Tolerance
                )
            }
        """
    ] .
