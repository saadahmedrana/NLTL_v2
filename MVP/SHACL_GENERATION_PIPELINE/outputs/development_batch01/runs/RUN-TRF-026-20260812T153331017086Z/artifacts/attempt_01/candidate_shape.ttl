@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF026Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable IA Super ship with a bulb requires decimal formula operands and results in their required units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass nltl:iceClassIaSuper ;
          nltl:hasComponent ?component .
    ?component nltl:bulbousBowPresent true .

    FILTER NOT EXISTS {
        $this nltl:shipBreadth ?breadthQuantity ;
              nltl:shipLength ?lengthQuantity ;
              nltl:iceClassDraught ?draughtQuantity ;
              nltl:coefficientF1 ?f1Quantity ;
              nltl:coefficientF2 ?f2Quantity ;
              nltl:coefficientF3 ?f3Quantity ;
              nltl:coefficientF4 ?f4Quantity ;
              nltl:coefficientG1 ?g1Quantity ;
              nltl:coefficientG2 ?g2Quantity ;
              nltl:coefficientG3 ?g3Quantity .

        ?component nltl:brashIceResistanceCoefficientC1 ?c1Quantity ;
                   nltl:brashIceResistanceCoefficientC2 ?c2Quantity .

        ?breadthQuantity qudt:numericValue ?breadth ;
                         qudt:unit unit:M .
        ?lengthQuantity qudt:numericValue ?length ;
                        qudt:unit unit:M .
        ?draughtQuantity qudt:numericValue ?draught ;
                         qudt:unit unit:M .
        ?f1Quantity qudt:numericValue ?f1 ;
                    qudt:unit unit:N-PER-M2 .
        ?f2Quantity qudt:numericValue ?f2 ;
                    qudt:unit unit:N-PER-M .
        ?f3Quantity qudt:numericValue ?f3 ;
                    qudt:unit unit:N-PER-M .
        ?f4Quantity qudt:numericValue ?f4 ;
                    qudt:unit unit:N-PER-M2 .
        ?g1Quantity qudt:numericValue ?g1 ;
                    qudt:unit unit:N .
        ?g2Quantity qudt:numericValue ?g2 ;
                    qudt:unit unit:N-PER-M .
        ?g3Quantity qudt:numericValue ?g3 ;
                    qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
        ?c1Quantity qudt:numericValue ?c1 ;
                    qudt:unit unit:N .
        ?c2Quantity qudt:numericValue ?c2 ;
                    qudt:unit unit:N .

        FILTER (
            datatype(?breadth) = xsd:decimal &&
            datatype(?length) = xsd:decimal &&
            datatype(?draught) = xsd:decimal &&
            datatype(?f1) = xsd:decimal &&
            datatype(?f2) = xsd:decimal &&
            datatype(?f3) = xsd:decimal &&
            datatype(?f4) = xsd:decimal &&
            datatype(?g1) = xsd:decimal &&
            datatype(?g2) = xsd:decimal &&
            datatype(?g3) = xsd:decimal &&
            datatype(?c1) = xsd:decimal &&
            datatype(?c2) = xsd:decimal &&
            ?breadth != 0 &&
            ?length > 0 &&
            ((2 * ?draught / ?breadth) + 1) != 0
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        sh:message "C1 and C2 must satisfy the prescribed IA Super bulbous-bow formulae." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass nltl:iceClassIaSuper ;
          nltl:hasComponent ?component .
    ?component nltl:bulbousBowPresent true .

    FILTER EXISTS {
        $this nltl:shipBreadth ?readyBreadthQuantity ;
              nltl:shipLength ?readyLengthQuantity ;
              nltl:iceClassDraught ?readyDraughtQuantity ;
              nltl:coefficientF1 ?readyF1Quantity ;
              nltl:coefficientF2 ?readyF2Quantity ;
              nltl:coefficientF3 ?readyF3Quantity ;
              nltl:coefficientF4 ?readyF4Quantity ;
              nltl:coefficientG1 ?readyG1Quantity ;
              nltl:coefficientG2 ?readyG2Quantity ;
              nltl:coefficientG3 ?readyG3Quantity .

        ?component nltl:brashIceResistanceCoefficientC1 ?readyC1Quantity ;
                   nltl:brashIceResistanceCoefficientC2 ?readyC2Quantity .

        ?readyBreadthQuantity qudt:numericValue ?readyBreadth ;
                              qudt:unit unit:M .
        ?readyLengthQuantity qudt:numericValue ?readyLength ;
                             qudt:unit unit:M .
        ?readyDraughtQuantity qudt:numericValue ?readyDraught ;
                              qudt:unit unit:M .
        ?readyF1Quantity qudt:numericValue ?readyF1 ;
                         qudt:unit unit:N-PER-M2 .
        ?readyF2Quantity qudt:numericValue ?readyF2 ;
                         qudt:unit unit:N-PER-M .
        ?readyF3Quantity qudt:numericValue ?readyF3 ;
                         qudt:unit unit:N-PER-M .
        ?readyF4Quantity qudt:numericValue ?readyF4 ;
                         qudt:unit unit:N-PER-M2 .
        ?readyG1Quantity qudt:numericValue ?readyG1 ;
                         qudt:unit unit:N .
        ?readyG2Quantity qudt:numericValue ?readyG2 ;
                         qudt:unit unit:N-PER-M .
        ?readyG3Quantity qudt:numericValue ?readyG3 ;
                         qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
        ?readyC1Quantity qudt:numericValue ?readyC1 ;
                         qudt:unit unit:N .
        ?readyC2Quantity qudt:numericValue ?readyC2 ;
                         qudt:unit unit:N .

        FILTER (
            datatype(?readyBreadth) = xsd:decimal &&
            datatype(?readyLength) = xsd:decimal &&
            datatype(?readyDraught) = xsd:decimal &&
            datatype(?readyF1) = xsd:decimal &&
            datatype(?readyF2) = xsd:decimal &&
            datatype(?readyF3) = xsd:decimal &&
            datatype(?readyF4) = xsd:decimal &&
            datatype(?readyG1) = xsd:decimal &&
            datatype(?readyG2) = xsd:decimal &&
            datatype(?readyG3) = xsd:decimal &&
            datatype(?readyC1) = xsd:decimal &&
            datatype(?readyC2) = xsd:decimal &&
            ?readyBreadth != 0 &&
            ?readyLength > 0 &&
            ((2 * ?readyDraught / ?readyBreadth) + 1) != 0
        )
    }

    FILTER NOT EXISTS {
        $this nltl:shipBreadth ?breadthQuantity ;
              nltl:shipLength ?lengthQuantity ;
              nltl:iceClassDraught ?draughtQuantity ;
              nltl:coefficientF1 ?f1Quantity ;
              nltl:coefficientF2 ?f2Quantity ;
              nltl:coefficientF3 ?f3Quantity ;
              nltl:coefficientF4 ?f4Quantity ;
              nltl:coefficientG1 ?g1Quantity ;
              nltl:coefficientG2 ?g2Quantity ;
              nltl:coefficientG3 ?g3Quantity .

        ?component nltl:brashIceResistanceCoefficientC1 ?c1Quantity ;
                   nltl:brashIceResistanceCoefficientC2 ?c2Quantity .

        ?breadthQuantity qudt:numericValue ?breadth ;
                         qudt:unit unit:M .
        ?lengthQuantity qudt:numericValue ?length ;
                        qudt:unit unit:M .
        ?draughtQuantity qudt:numericValue ?draught ;
                         qudt:unit unit:M .
        ?f1Quantity qudt:numericValue ?f1 ;
                    qudt:unit unit:N-PER-M2 .
        ?f2Quantity qudt:numericValue ?f2 ;
                    qudt:unit unit:N-PER-M .
        ?f3Quantity qudt:numericValue ?f3 ;
                    qudt:unit unit:N-PER-M .
        ?f4Quantity qudt:numericValue ?f4 ;
                    qudt:unit unit:N-PER-M2 .
        ?g1Quantity qudt:numericValue ?g1 ;
                    qudt:unit unit:N .
        ?g2Quantity qudt:numericValue ?g2 ;
                    qudt:unit unit:N-PER-M .
        ?g3Quantity qudt:numericValue ?g3 ;
                    qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
        ?c1Quantity qudt:numericValue ?c1 ;
                    qudt:unit unit:N .
        ?c2Quantity qudt:numericValue ?c2 ;
                    qudt:unit unit:N .

        FILTER (
            datatype(?breadth) = xsd:decimal &&
            datatype(?length) = xsd:decimal &&
            datatype(?draught) = xsd:decimal &&
            datatype(?f1) = xsd:decimal &&
            datatype(?f2) = xsd:decimal &&
            datatype(?f3) = xsd:decimal &&
            datatype(?f4) = xsd:decimal &&
            datatype(?g1) = xsd:decimal &&
            datatype(?g2) = xsd:decimal &&
            datatype(?g3) = xsd:decimal &&
            datatype(?c1) = xsd:decimal &&
            datatype(?c2) = xsd:decimal &&
            ?breadth != 0 &&
            ?length > 0 &&
            ((2 * ?draught / ?breadth) + 1) != 0
        )

        BIND (
            (?f1 * (?breadth * ?length) /
                ((2 * ?draught / ?breadth) + 1)) +
            (2.89 * (
                (?f2 * ?breadth) +
                (?f3 * ?length) +
                (?f4 * ?breadth * ?length)
            ))
            AS ?expectedC1
        )
        BIND (
            ?c2 - (6.67 * (?g1 + (?g2 * ?breadth)))
            AS ?c2Difference
        )
        BIND (
            ?g3 * (1 + (1.2 * ?draught / ?breadth)) *
            ?breadth * ?breadth
            AS ?c2Numerator
        )

        FILTER (
            ?c1 = ?expectedC1 &&
            (?c2Difference * ?c2Difference * ?length) =
                (?c2Numerator * ?c2Numerator) &&
            (?c2Difference * ?c2Numerator) >= 0
        )
    }
}
""" ;
    ] .
