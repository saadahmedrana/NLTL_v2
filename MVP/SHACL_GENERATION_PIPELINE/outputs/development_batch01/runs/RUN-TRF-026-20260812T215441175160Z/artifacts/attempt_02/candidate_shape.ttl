@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF026Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:not [
                sh:and (
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIaSuper
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:bulbousBowPresent ;
                            sh:hasValue true
                        ]
                    ]
                )
            ]
        ]
        [
            sh:node gs:TRF026CalculationShape
        ]
    ) .

gs:TRF026CalculationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositiveMetreQuantityShape ;
        sh:message "Applicable ships require one positive ship breadth in metres."
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositiveMetreQuantityShape ;
        sh:message "Applicable ships require one positive ship length in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositiveMetreQuantityShape ;
        sh:message "Applicable ships require one positive ice-class draught in metres."
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonPerSquareMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonPerSquareMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:NewtonPerMetrePowerOnePointFiveQuantityShape
    ] ;
    sh:property [
        sh:path nltl:brashIceResistanceCoefficientC1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:brashIceResistanceCoefficientC2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DecimalQuantityShape
    ] ;
    sh:sparql [
        sh:message "C1 or C2 does not satisfy the applicable bulbous-bow formula within the numerical tolerance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipBreadth/qudt:numericValue ?b ;
          nltl:shipLength/qudt:numericValue ?l ;
          nltl:iceClassDraught/qudt:numericValue ?t ;
          nltl:coefficientF1/qudt:numericValue ?f1 ;
          nltl:coefficientF2/qudt:numericValue ?f2 ;
          nltl:coefficientF3/qudt:numericValue ?f3 ;
          nltl:coefficientF4/qudt:numericValue ?f4 ;
          nltl:coefficientG1/qudt:numericValue ?g1 ;
          nltl:coefficientG2/qudt:numericValue ?g2 ;
          nltl:coefficientG3/qudt:numericValue ?g3 ;
          nltl:brashIceResistanceCoefficientC1/qudt:numericValue ?c1 ;
          nltl:brashIceResistanceCoefficientC2/qudt:numericValue ?c2 .

    BIND(
        ?f1 * (?b * ?l) / (2.0 * ?t / ?b + 1.0)
        + 2.89 * (?f2 * ?b + ?f3 * ?l + ?f4 * ?b * ?l)
        AS ?expectedC1
    )
    BIND(ABS(?c1 - ?expectedC1) AS ?c1Error)
    BIND(
        IF(
            ABS(?c1) > ABS(?expectedC1),
            ABS(?c1),
            ABS(?expectedC1)
        )
        AS ?c1Scale
    )
    BIND(
        IF(
            0.000001 * ?c1Scale > 0.000000001,
            0.000001 * ?c1Scale,
            0.000000001
        )
        AS ?c1Tolerance
    )

    BIND(6.67 * (?g1 + ?g2 * ?b) AS ?c2Base)
    BIND(
        ?g3 * (1.0 + 1.2 * ?t / ?b) * ?b * ?b
        AS ?c2Numerator
    )
    BIND(?c2 - ?c2Base AS ?c2Difference)
    BIND(?c2Difference * ?c2Difference * ?l AS ?c2Left)
    BIND(?c2Numerator * ?c2Numerator AS ?c2Right)
    BIND(ABS(?c2Left - ?c2Right) AS ?c2Error)
    BIND(
        IF(
            ABS(?c2Left) > ABS(?c2Right),
            ABS(?c2Left),
            ABS(?c2Right)
        )
        AS ?c2Scale
    )
    BIND(
        IF(
            0.000001 * ?c2Scale > 0.000000001,
            0.000001 * ?c2Scale,
            0.000000001
        )
        AS ?c2Tolerance
    )

    FILTER(
        ?c1Error > ?c1Tolerance
        ||
        ?c2Difference * ?c2Numerator < 0
        ||
        ?c2Error > ?c2Tolerance
    )
}
"""
    ] .

gs:DecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] .

gs:PositiveMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gs:NewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N
    ] .

gs:NewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N-PER-M
    ] .

gs:NewtonPerSquareMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N-PER-M2
    ] .

gs:NewtonPerMetrePowerOnePointFiveQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit
    ] .
