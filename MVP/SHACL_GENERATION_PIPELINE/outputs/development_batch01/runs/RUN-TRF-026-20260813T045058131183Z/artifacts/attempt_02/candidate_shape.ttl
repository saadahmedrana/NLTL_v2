@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF026Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:shipBreadth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositiveMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:shipLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositiveMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:iceClassDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositiveMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientF1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerSquareMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientF2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientF3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientF4 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerSquareMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientG1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientG2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetreQuantity
            ] ;
            sh:property [
                sh:path nltl:coefficientG3 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:NewtonPerMetrePowerOnePointFiveQuantity
            ] ;
            sh:property [
                sh:path nltl:brashIceResistanceCoefficientC1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DecimalQuantity
            ] ;
            sh:property [
                sh:path nltl:brashIceResistanceCoefficientC2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DecimalQuantity
            ] ;
            sh:sparql [
                sh:message "For an IA Super ship with a bulb, C1 and C2 must satisfy the prescribed formulas within a relative tolerance of 1e-6 and a small absolute fallback near zero." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipBreadth/qudt:numericValue ?breadth ;
                              nltl:shipLength/qudt:numericValue ?length ;
                              nltl:iceClassDraught/qudt:numericValue ?draught ;
                              nltl:coefficientF1/qudt:numericValue ?f1 ;
                              nltl:coefficientF2/qudt:numericValue ?f2 ;
                              nltl:coefficientF3/qudt:numericValue ?f3 ;
                              nltl:coefficientF4/qudt:numericValue ?f4 ;
                              nltl:coefficientG1/qudt:numericValue ?g1 ;
                              nltl:coefficientG2/qudt:numericValue ?g2 ;
                              nltl:coefficientG3/qudt:numericValue ?g3 ;
                              nltl:brashIceResistanceCoefficientC1/qudt:numericValue ?c1 ;
                              nltl:brashIceResistanceCoefficientC2/qudt:numericValue ?c2 .

                        BIND(
                            ?f1 * (?breadth * ?length) /
                                (2.0 * ?draught / ?breadth + 1.0)
                            + 2.89 * (
                                ?f2 * ?breadth
                                + ?f3 * ?length
                                + ?f4 * ?breadth * ?length
                            )
                            AS ?expectedC1
                        )
                        BIND(
                            IF(
                                ABS(?expectedC1) > 0.000000000001,
                                0.000001 * ABS(?expectedC1),
                                0.000000000001
                            )
                            AS ?c1Tolerance
                        )

                        BIND(6.67 * (?g1 + ?g2 * ?breadth) AS ?c2Base)
                        BIND(
                            ?g3
                            * (1.0 + 1.2 * ?draught / ?breadth)
                            * ?breadth * ?breadth
                            AS ?c2Numerator
                        )
                        BIND(?c2 - ?c2Base AS ?c2Residual)
                        BIND(
                            ?c2Residual * ?c2Residual * ?length
                            AS ?c2RelationLeft
                        )
                        BIND(
                            ?c2Numerator * ?c2Numerator
                            AS ?c2RelationRight
                        )
                        BIND(
                            IF(
                                ABS(?c2RelationRight) > 0.000000000001,
                                0.000002 * ABS(?c2RelationRight),
                                0.000000000001
                            )
                            AS ?c2RelationTolerance
                        )

                        FILTER(
                            ABS(?c1 - ?expectedC1) > ?c1Tolerance
                            ||
                            (?c2Residual * ?c2Numerator < 0.0)
                            ||
                            ABS(?c2RelationLeft - ?c2RelationRight)
                                > ?c2RelationTolerance
                        )
                    }
                """
            ]
        ]
    ) .

gen:DecimalQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] .

gen:PositiveMetreQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:NewtonQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N
    ] .

gen:NewtonPerMetreQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N-PER-M
    ] .

gen:NewtonPerSquareMetreQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:N-PER-M2
    ] .

gen:NewtonPerMetrePowerOnePointFiveQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit
    ] .
