@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:ExistingIaShipCoefficientsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "IA or IA Super ships require a valid construction stage date to determine applicability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                OPTIONAL {
                    $this nltl:constructionStageDate ?constructionDate .
                }
                FILTER (
                    !BOUND(?constructionDate) ||
                    DATATYPE(?constructionDate) != xsd:date
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an applicable existing IA or IA Super ship, the prescribed coefficients, metre-based hull inputs, and clamped hull geometry term must be present with the required units and values." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .

                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
                FILTER (DATATYPE(?constructionDate) = xsd:date)
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9) ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) = 9 && DAY(?constructionDate) < 1)
                )

                OPTIONAL {
                    $this nltl:coefficientF1 ?f1Quantity .
                    ?f1Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?f1 ;
                                qudt:unit unit:N-PER-M2 .
                    FILTER (DATATYPE(?f1) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientF2 ?f2Quantity .
                    ?f2Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?f2 ;
                                qudt:unit unit:N-PER-M .
                    FILTER (DATATYPE(?f2) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientF3 ?f3Quantity .
                    ?f3Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?f3 ;
                                qudt:unit unit:N-PER-M .
                    FILTER (DATATYPE(?f3) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientF4 ?f4Quantity .
                    ?f4Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?f4 ;
                                qudt:unit unit:N-PER-M2 .
                    FILTER (DATATYPE(?f4) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientG1 ?g1Quantity .
                    ?g1Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?g1 ;
                                qudt:unit unit:N .
                    FILTER (DATATYPE(?g1) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientG2 ?g2Quantity .
                    ?g2Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?g2 ;
                                qudt:unit unit:N-PER-M .
                    FILTER (DATATYPE(?g2) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientG3 ?g3Quantity .
                    ?g3Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?g3 ;
                                qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                    FILTER (DATATYPE(?g3) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientC3 ?c3Quantity .
                    ?c3Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?c3 ;
                                qudt:unit nltl:kilogramPerSquareMetreSquareSecondUnit .
                    FILTER (DATATYPE(?c3) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientC4 ?c4Quantity .
                    ?c4Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?c4 ;
                                qudt:unit nltl:kilogramPerSquareMetreSquareSecondUnit .
                    FILTER (DATATYPE(?c4) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:coefficientC5 ?c5Quantity .
                    ?c5Quantity rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?c5 ;
                                qudt:unit nltl:kilogramPerSquareSecondUnit .
                    FILTER (DATATYPE(?c5) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:shipLength ?lengthQuantity .
                    ?lengthQuantity rdf:type qudt:QuantityValue ;
                                    qudt:numericValue ?length ;
                                    qudt:unit unit:M .
                    FILTER (DATATYPE(?length) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:iceClassDraught ?draughtQuantity .
                    ?draughtQuantity rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?draught ;
                                     qudt:unit unit:M .
                    FILTER (DATATYPE(?draught) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:shipBreadth ?breadthQuantity .
                    ?breadthQuantity rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?breadth ;
                                     qudt:unit unit:M .
                    FILTER (DATATYPE(?breadth) = xsd:decimal)
                }
                OPTIONAL {
                    $this nltl:clampedHullGeometryTerm ?clampedQuantity .
                    ?clampedQuantity rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?clamped ;
                                     qudt:unit unit:UNITLESS .
                    FILTER (DATATYPE(?clamped) = xsd:decimal)
                }

                BIND (
                    ((?length * ?draught) / (?breadth * ?breadth)) *
                    ((?length * ?draught) / (?breadth * ?breadth)) *
                    ((?length * ?draught) / (?breadth * ?breadth))
                    AS ?rawGeometryTerm
                )
                BIND (
                    IF(
                        ?rawGeometryTerm < 5.0,
                        5.0,
                        IF(?rawGeometryTerm > 20.0, 20.0, ?rawGeometryTerm)
                    )
                    AS ?expectedClampedTerm
                )
                BIND (ABS(?clamped - ?expectedClampedTerm) AS ?clampedDifference)
                BIND (
                    IF(
                        ABS(?expectedClampedTerm) > 0.000001,
                        ABS(?expectedClampedTerm) * 0.000001,
                        0.000001
                    )
                    AS ?clampedTolerance
                )

                FILTER (
                    !BOUND(?f1) || ?f1 != 10.3 ||
                    !BOUND(?f2) || ?f2 != 45.8 ||
                    !BOUND(?f3) || ?f3 != 2.94 ||
                    !BOUND(?f4) || ?f4 != 5.8 ||
                    !BOUND(?g1) || ?g1 != 1530 ||
                    !BOUND(?g2) || ?g2 != 170 ||
                    !BOUND(?g3) || ?g3 != 400 ||
                    !BOUND(?c3) || ?c3 != 460 ||
                    !BOUND(?c4) || ?c4 != 18.7 ||
                    !BOUND(?c5) || ?c5 != 825 ||
                    !BOUND(?length) ||
                    !BOUND(?draught) ||
                    !BOUND(?breadth) ||
                    !BOUND(?clamped) ||
                    !BOUND(?expectedClampedTerm) ||
                    !BOUND(?clampedDifference) ||
                    ?clampedDifference > ?clampedTolerance
                )
            }
        """
    ] .
