gen:ShipLengthPropertyShape
    a sh:PropertyShape ;
    sh:path nltl:shipLength ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:PositiveMetreQuantityValueShape .

gen:IceClassDraughtPropertyShape
    a sh:PropertyShape ;
    sh:path nltl:iceClassDraught ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:PositiveMetreQuantityValueShape .

gen:ShipBreadthPropertyShape
    a sh:PropertyShape ;
    sh:path nltl:shipBreadth ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:PositiveMetreQuantityValueShape .

gen:PositiveMetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:ClampedHullGeometryTermPropertyShape
    a sh:PropertyShape ;
    sh:path nltl:clampedHullGeometryTerm ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:ClampedHullGeometryTermValueShape .

gen:ClampedHullGeometryTermValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "5"^^xsd:decimal ;
        sh:maxInclusive "20"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
