@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF027Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Exactly one valid construction stage date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one ice class is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:not gen:TRF027ApplicabilityShape
        ]
        gen:TRF027ApplicableRequirementsShape
    ) .

gen:TRF027ApplicabilityShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIa
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:maxExclusive "2003-09-01"^^xsd:date
    ] .

gen:TRF027ApplicableRequirementsShape
    a sh:NodeShape ;
    sh:property gen:CoefficientC3PropertyShape ;
    sh:property gen:CoefficientC4PropertyShape ;
    sh:property gen:CoefficientC5PropertyShape ;
    sh:property gen:CoefficientF1PropertyShape ;
    sh:property gen:CoefficientF2PropertyShape ;
    sh:property gen:CoefficientF3PropertyShape ;
    sh:property gen:CoefficientF4PropertyShape ;
    sh:property gen:CoefficientG1PropertyShape ;
    sh:property gen:CoefficientG2PropertyShape ;
    sh:property gen:CoefficientG3PropertyShape ;
    sh:property gen:ShipLengthPropertyShape ;
    sh:property gen:IceClassDraughtPropertyShape ;
    sh:property gen:ShipBreadthPropertyShape ;
    sh:property gen:ClampedHullGeometryTermPropertyShape ;
    sh:sparql [
        sh:message "The clamped hull geometry term must equal clamp(((L*T)/B^2)^3, 5, 20), using relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipLength/qudt:numericValue ?length ;
                      nltl:iceClassDraught/qudt:numericValue ?draught ;
                      nltl:shipBreadth/qudt:numericValue ?breadth ;
                      nltl:clampedHullGeometryTerm/qudt:numericValue ?actual .
                BIND((?length * ?draught) / (?breadth * ?breadth) AS ?ratio)
                BIND(?ratio * ?ratio * ?ratio AS ?raw)
                BIND(
                    IF(
                        ?raw < "5"^^xsd:decimal,
                        "5"^^xsd:decimal,
                        IF(
                            ?raw > "20"^^xsd:decimal,
                            "20"^^xsd:decimal,
                            ?raw
                        )
                    )
                    AS ?expected
                )
                BIND(ABS(?expected) * "0.000001"^^xsd:decimal AS ?relativeTolerance)
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?actual - ?expected) > ?tolerance)
            }
        """
    ] .

gen:CoefficientC3PropertyShape
    a sh:PropertyShape ;
    sh:path nltl:coefficientC3 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:CoefficientC3ValueShape .

gen:CoefficientC3ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:hasValue "460"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit
    ] .

gen:CoefficientC4PropertyShape
