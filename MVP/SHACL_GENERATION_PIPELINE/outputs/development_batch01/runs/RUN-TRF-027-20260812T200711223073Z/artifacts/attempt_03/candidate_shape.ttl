    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:hasValue "18.7"^^xsd:decimal
    ] ;
    sh:property [
