@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:ShipDirectAnalysisShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "At least one direct-analysis case must place the load at mid-span or mid-spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPosition ?position .
                    ?position qudt:numericValue ?positionValue ;
                              qudt:unit <http://qudt.org/vocab/unit/M> .
                    {
                        ?case nltl:span ?dimension .
                    }
                    UNION
                    {
                        ?case nltl:spacing ?dimension .
                    }
                    ?dimension qudt:numericValue ?dimensionValue ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (
                        xsd:decimal(?positionValue) =
                        xsd:decimal(?dimensionValue) / 2.0
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When load length cannot be determined from the arrangement, several direct-analysis cases with distinct load lengths and corresponding ca values must be checked." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasDirectAnalysisCase ?fallbackCase .
                    ?fallbackCase nltl:loadLengthDeterminedFromArrangement false .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case1, ?case2 .
                    ?case1 nltl:loadLengthDeterminedFromArrangement false ;
                           nltl:loadPatchLength ?length1 ;
                           nltl:iceLoadAreaFactorCa ?ca1 .
                    ?case2 nltl:loadLengthDeterminedFromArrangement false ;
                           nltl:loadPatchLength ?length2 ;
                           nltl:iceLoadAreaFactorCa ?ca2 .
                    ?length1 qudt:numericValue ?lengthValue1 ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?length2 qudt:numericValue ?lengthValue2 ;
                             qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?ca1 qudt:numericValue ?caValue1 ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?ca2 qudt:numericValue ?caValue2 ;
                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    FILTER (
                        ?case1 != ?case2 &&
                        xsd:decimal(?lengthValue1) !=
                        xsd:decimal(?lengthValue2)
                    )
                }
            }
        """
    ] .

gen:DirectAnalysisCaseShape a sh:NodeShape ;
    sh:targetClass nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times the ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressure ;
                      nltl:appliedIcePressure ?applied .
                ?pressure qudt:numericValue ?pressureValue ;
                          qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?applied qudt:numericValue ?appliedValue ;
                         qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                FILTER (
                    xsd:decimal(?appliedValue) !=
                    1.8 * xsd:decimal(?pressureValue)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A case whose load length is not determined from the arrangement must pair its load-patch length with a corresponding ca value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadLengthDeterminedFromArrangement false .
                FILTER NOT EXISTS {
                    $this nltl:loadPatchLength ?length ;
                          nltl:iceLoadAreaFactorCa ?ca .
                    ?length qudt:numericValue ?lengthValue ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?ca qudt:numericValue ?caValue ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                }
            }
        """
    ] .
