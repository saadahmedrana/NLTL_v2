@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:maxCount 1
    ] .

gen:LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:maxCount 1
    ] .

gen:DirectAnalysisCaseShape a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasDirectAnalysisCase ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:class nltl:loadPositionTypeValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:class nltl:loadPositionTypeValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times the pressure determined for the load patch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:appliedIcePressure ?appliedQuantity .
                ?pressureQuantity qudt:numericValue ?pressure .
                ?appliedQuantity qudt:numericValue ?applied .
                FILTER (?applied != (1.8 * ?pressure))
            }
        """
    ] ;
    sh:sparql [
        sh:message "A corresponding dimensionless ice load area factor ca is required when load length is not determined directly from the arrangement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:loadLengthDeterminedFromArrangement false .
                }
                FILTER NOT EXISTS {
                    $this nltl:iceLoadAreaFactorCa ?factorQuantity .
                    ?factorQuantity qudt:numericValue ?factor ;
                                    qudt:unit unit:UNITLESS .
                }
            }
        """
    ] .

gen:ShipDirectAnalysisShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "The ship must link a ship component to a direct analysis case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component a nltl:shipComponent ;
                               nltl:hasDirectAnalysisCase ?case .
                    ?case a nltl:directAnalysisCase .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A direct analysis case centred at the upper ice waterline is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A direct analysis case at half the load height below the lower ice waterline is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "At least two direct analysis cases at intermediate vertical positions are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component1, ?component2 .
                    ?component1 nltl:hasDirectAnalysisCase ?case1 .
                    ?component2 nltl:hasDirectAnalysisCase ?case2 .
                    ?case1 nltl:verticalLoadPositionType nltl:intermediateVerticalPosition .
                    ?case2 nltl:verticalLoadPositionType nltl:intermediateVerticalPosition .
                    FILTER (?case1 != ?case2)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A direct analysis case centred at mid-span or mid-spacing is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPositionType nltl:midSpanOrSpacingCenteredPosition .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An additional horizontal direct analysis position is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:horizontalLoadPositionType nltl:otherHorizontalPosition .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When load length cannot be determined from the arrangement, at least two distinct load lengths with corresponding ca values must be checked." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasComponent ?component .
                    ?component nltl:hasDirectAnalysisCase ?case .
                    ?case nltl:loadLengthDeterminedFromArrangement false .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?component1, ?component2 .
                    ?component1 nltl:hasDirectAnalysisCase ?case1 .
                    ?component2 nltl:hasDirectAnalysisCase ?case2 .
                    ?case1 nltl:loadLengthDeterminedFromArrangement false ;
                           nltl:loadPatchLength ?lengthQuantity1 ;
                           nltl:iceLoadAreaFactorCa ?factorQuantity1 .
                    ?case2 nltl:loadLengthDeterminedFromArrangement false ;
                           nltl:loadPatchLength ?lengthQuantity2 ;
                           nltl:iceLoadAreaFactorCa ?factorQuantity2 .
                    ?lengthQuantity1 qudt:numericValue ?length1 ;
                                     qudt:unit unit:M .
                    ?lengthQuantity2 qudt:numericValue ?length2 ;
                                     qudt:unit unit:M .
                    ?factorQuantity1 qudt:numericValue ?factor1 ;
                                     qudt:unit unit:UNITLESS .
                    ?factorQuantity2 qudt:numericValue ?factor2 ;
                                     qudt:unit unit:UNITLESS .
                    FILTER (?case1 != ?case2 && ?length1 != ?length2)
                }
            }
        """
    ] .
