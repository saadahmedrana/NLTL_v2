@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The analysis case must confirm that the load position minimizes structural capacity."
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The analysis case must evaluate the combined effects of bending and shear."
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:in (
            nltl:upperIceWaterlineCenteredPosition
            nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            nltl:intermediateVerticalPosition
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:in (
            nltl:midSpanOrSpacingCenteredPosition
            nltl:otherHorizontalPosition
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:UnitlessQuantityShape ;
        sh:maxCount 1
    ] .

gen:TRF030ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:upperIceWaterlineCenteredPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one analysis case must have its load centered at the upper ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one analysis case must be positioned half a load height below the lower ice waterline."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:intermediateVerticalPosition
            ]
        ] ;
        sh:qualifiedMinCount 2 ;
        sh:message "Several analysis cases must use intermediate vertical load positions."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one analysis case must use a mid-span or mid-spacing centered horizontal position."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:loadPatchLength ;
                sh:minCount 2
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:property [
                        sh:path nltl:iceLoadAreaFactorCa ;
                        sh:node gen:UnitlessQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 2
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times ice pressure within relative tolerance 1e-6 and absolute fallback 1e-12 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?basePressure ;
                      nltl:appliedIcePressure ?appliedPressure .
                ?basePressure qudt:numericValue ?baseValue .
                ?appliedPressure qudt:numericValue ?appliedValue .
                BIND((xsd:decimal("1.8") * ?baseValue) AS ?expected)
                BIND((xsd:decimal("0.000001") * ABS(?expected)) AS ?relativeTolerance)
                BIND(IF(
                    ?relativeTolerance > xsd:decimal("0.000000000001"),
                    ?relativeTolerance,
                    xsd:decimal("0.000000000001")
                ) AS ?tolerance)
                FILTER(ABS(?appliedValue - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "An upper-ice-waterline-centered case must place the vertical load at the upper ice waterline within relative tolerance 1e-6 and absolute fallback 1e-12 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:upperIceWaterlineReferencePosition ?reference .
                ?position qudt:numericValue ?positionValue .
                ?reference qudt:numericValue ?referenceValue .
                BIND((xsd:decimal("0.000001") * ABS(?referenceValue)) AS ?relativeTolerance)
                BIND(IF(
                    ?relativeTolerance > xsd:decimal("0.000000000001"),
                    ?relativeTolerance,
                    xsd:decimal("0.000000000001")
                ) AS ?tolerance)
                FILTER(ABS(?positionValue - ?referenceValue) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A lower-ice-waterline case must be half a load-patch height below the lower ice waterline within relative tolerance 1e-6 and absolute fallback 1e-12 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?height ;
                      nltl:hasDirectAnalysisCase ?case .
                ?height qudt:numericValue ?heightValue .
                ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?lowerReference .
                ?position qudt:numericValue ?positionValue .
                ?lowerReference qudt:numericValue ?lowerValue .
                BIND((?lowerValue - (xsd:decimal("0.5") * ?heightValue)) AS ?expected)
                BIND((xsd:decimal("0.000001") * ABS(?expected)) AS ?relativeTolerance)
                BIND(IF(
                    ?relativeTolerance > xsd:decimal("0.000000000001"),
                    ?relativeTolerance,
                    xsd:decimal("0.000000000001")
                ) AS ?tolerance)
                FILTER(ABS(?positionValue - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Intermediate vertical load positions must lie between the half-height-below-LIWL position and the upper ice waterline." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?height ;
                      nltl:hasDirectAnalysisCase ?case .
                ?height qudt:numericValue ?heightValue .
                ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?lowerReference ;
                      nltl:upperIceWaterlineReferencePosition ?upperReference .
                ?position qudt:numericValue ?positionValue .
                ?lowerReference qudt:numericValue ?lowerValue .
                ?upperReference qudt:numericValue ?upperValue .
                BIND((?lowerValue - (xsd:decimal("0.5") * ?heightValue)) AS ?lowerBound)
                FILTER(
                    ?positionValue <= ?lowerBound ||
                    ?positionValue >= ?upperValue
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Several distinct intermediate vertical load positions must be checked." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?positionValue) AS ?positionCount)
                    WHERE {
                        $this nltl:hasDirectAnalysisCase ?case .
                        ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                              nltl:verticalLoadPosition ?position .
                        ?position qudt:numericValue ?positionValue .
                    }
                    GROUP BY $this
                }
                FILTER(?positionCount < 2)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Several distinct horizontal load positions must be checked." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?positionValue) AS ?positionCount)
                    WHERE {
                        $this nltl:hasDirectAnalysisCase ?case .
                        ?case nltl:horizontalLoadPosition ?position .
                        ?position qudt:numericValue ?positionValue .
                    }
                    GROUP BY $this
                }
                FILTER(?positionCount < 2)
            }
        """
    ] .
