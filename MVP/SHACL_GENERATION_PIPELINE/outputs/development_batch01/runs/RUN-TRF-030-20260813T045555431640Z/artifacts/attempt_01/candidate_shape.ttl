@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The direct analysis case must evaluate the combined effects of bending and shear."
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The direct analysis case must confirm a capacity-minimizing load position."
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:in (
            nltl:upperIceWaterlineCenteredPosition
            nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            nltl:intermediateVerticalPosition
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:in (
            nltl:midSpanOrSpacingCenteredPosition
            nltl:otherHorizontalPosition
        ) ;
        sh:minCount 1
    ] .

gen:UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:upperIceWaterlineCenteredPosition ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] .

gen:LowerIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] .

gen:IntermediateVerticalCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:intermediateVerticalPosition ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] .

gen:MidSpanOrSpacingCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:hasValue nltl:midSpanOrSpacingCenteredPosition ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] .

gen:LoadLengthAreaFactorCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1
    ] .

gen:TRF030Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:message "Ice pressure p is required for the direct-analysis pressure calculation."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:message "Applied ice pressure is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "Load patch height is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:span ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:spacing ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:UpperIceWaterlineCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A direct-analysis case centered at the upper ice waterline is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:LowerIceWaterlineCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A direct-analysis case positioned half a load height below the lower ice waterline is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:IntermediateVerticalCaseShape ;
        sh:qualifiedMinCount 2 ;
        sh:message "Several intermediate vertical direct-analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:MidSpanOrSpacingCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A horizontal case centered at the mid-span or spacing is required."
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "It must be stated whether load length is determined directly from the structural arrangement."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue true ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue false ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape gen:LoadLengthAreaFactorCaseShape ;
                sh:qualifiedMinCount 2 ;
                sh:message "When load length cannot be determined from the arrangement, several cases pairing load length with the corresponding area factor ca are required."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times ice pressure p within a relative tolerance of 1e-6 or an absolute tolerance of 1e-12 near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressure .
                ?pressure qudt:numericValue ?pressureValue ;
                          qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                BIND((xsd:decimal(?pressureValue) * 1.8) AS ?expected)
                FILTER NOT EXISTS {
                    $this nltl:appliedIcePressure ?applied .
                    ?applied qudt:numericValue ?appliedValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (
                        ABS(xsd:decimal(?appliedValue) - ?expected) <= 0.000000000001 ||
                        ABS(xsd:decimal(?appliedValue) - ?expected) <=
                            (ABS(?expected) * 0.000001)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The upper-waterline-centered load position must equal its upper ice waterline reference position within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:upperIceWaterlineReferencePosition ?reference .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                ?reference qudt:numericValue ?referenceValue ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    ABS(xsd:decimal(?positionValue) - xsd:decimal(?referenceValue)) > 0.000000000001 &&
                    ABS(xsd:decimal(?positionValue) - xsd:decimal(?referenceValue)) >
                        (ABS(xsd:decimal(?referenceValue)) * 0.000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The lower-waterline case must be positioned at LIWL minus one half of the load patch height, within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?height ;
                      nltl:hasDirectAnalysisCase ?case .
                ?height qudt:numericValue ?heightValue ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?reference .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                ?reference qudt:numericValue ?referenceValue ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND(
                    (xsd:decimal(?referenceValue) - (0.5 * xsd:decimal(?heightValue)))
                    AS ?expected
                )
                FILTER (
                    ABS(xsd:decimal(?positionValue) - ?expected) > 0.000000000001 &&
                    ABS(xsd:decimal(?positionValue) - ?expected) >
                        (ABS(?expected) * 0.000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each intermediate vertical load position must lie between the lower and upper ice waterline references." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?lower ;
                      nltl:upperIceWaterlineReferencePosition ?upper .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
                ?lower qudt:numericValue ?lowerValue ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?upper qudt:numericValue ?upperValue ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (
                    xsd:decimal(?positionValue) <= xsd:decimal(?lowerValue) ||
                    xsd:decimal(?positionValue) >= xsd:decimal(?upperValue)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Intermediate checks must use at least two distinct vertical locations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?position .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?positionValue) < 2)
        """
    ] ;
    sh:sparql [
        sh:message "Direct analyses must check at least two distinct horizontal load locations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:horizontalLoadPosition ?position .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?positionValue) < 2)
        """
    ] ;
    sh:sparql [
        sh:message "When load length cannot be determined from the arrangement, at least two distinct load lengths with corresponding ca values must be checked." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadLengthDeterminedFromArrangement false ;
                      nltl:hasDirectAnalysisCase ?case .
                ?case nltl:loadPatchLength ?length ;
                      nltl:iceLoadAreaFactorCa ?areaFactor .
                ?length qudt:numericValue ?lengthValue ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                ?areaFactor qudt:numericValue ?areaFactorValue ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?lengthValue) < 2)
        """
    ] .
