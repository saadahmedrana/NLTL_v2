@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MeterQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DirectAnalysisCaseWithCaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each load length must be paired with one unitless ca value."
    ] .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each direct-analysis case requires one load-patch length in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:upperIceWaterlineCenteredPosition
            nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            nltl:intermediateVerticalPosition
        )
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:midSpanOrSpacingCenteredPosition
            nltl:otherHorizontalPosition
        )
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:MeterQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:MeterQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:upperIceWaterlineCenteredPosition
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineReferencePosition ;
                sh:node gen:MeterQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterlineReferencePosition ;
                sh:node gen:MeterQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:intermediateVerticalPosition
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterlineReferencePosition ;
                sh:node gen:MeterQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineReferencePosition ;
                sh:node gen:MeterQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition
            ]
        ]
        [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:otherHorizontalPosition
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "A UIWL-centred case must place the load at the UIWL reference position within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:upperIceWaterlineReferencePosition ?reference .
                ?position qudt:numericValue ?actual .
                ?reference qudt:numericValue ?expected .
                FILTER (
                    ABS(?actual - ?expected) >
                    (0.000001 * IF(ABS(?expected) > 1, ABS(?expected), 1))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A lower-waterline case must be positioned half a load height below LIWL within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasDirectAnalysisCase $this ;
                      nltl:loadPatchHeight ?height .
                $this nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?lowerReference .
                ?height qudt:numericValue ?heightValue .
                ?position qudt:numericValue ?actual .
                ?lowerReference qudt:numericValue ?lowerValue .
                BIND((?lowerValue - (0.5 * ?heightValue)) AS ?expected)
                FILTER (
                    ABS(?actual - ?expected) >
                    (0.000001 * IF(ABS(?expected) > 1, ABS(?expected), 1))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "An intermediate vertical load position must lie strictly between LIWL and UIWL." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?lowerReference ;
                      nltl:upperIceWaterlineReferencePosition ?upperReference .
                ?position qudt:numericValue ?positionValue .
                ?lowerReference qudt:numericValue ?lowerValue .
                ?upperReference qudt:numericValue ?upperValue .
                FILTER (
                    ?positionValue <= ?lowerValue ||
                    ?positionValue >= ?upperValue
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A mid-span or mid-spacing case must be centred at half the span or half the spacing within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasDirectAnalysisCase $this ;
                      nltl:span ?span ;
                      nltl:spacing ?spacing .
                $this nltl:horizontalLoadPositionType nltl:midSpanOrSpacingCenteredPosition ;
                      nltl:horizontalLoadPosition ?position .
                ?span qudt:numericValue ?spanValue .
                ?spacing qudt:numericValue ?spacingValue .
                ?position qudt:numericValue ?actual .
                BIND((0.5 * ?spanValue) AS ?spanCentre)
                BIND((0.5 * ?spacingValue) AS ?spacingCentre)
                FILTER (
                    ABS(?actual - ?spanCentre) >
                    (0.000001 * IF(ABS(?spanCentre) > 1, ABS(?spanCentre), 1)) &&
                    ABS(?actual - ?spacingCentre) >
                    (0.000001 * IF(ABS(?spacingCentre) > 1, ABS(?spacingCentre), 1))
                )
            }
        """
    ] .

gen:TRF030Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "One ice pressure p in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "One applied ice pressure in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "One load-patch height in metres is required."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:upperIceWaterlineCenteredPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one direct-analysis case must be centred at UIWL."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one direct-analysis case must be half a load height below LIWL."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:intermediateVerticalPosition
            ]
        ] ;
        sh:qualifiedMinCount 2 ;
        sh:message "Several intermediate vertical direct-analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A mid-span or mid-spacing horizontal case is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:otherHorizontalPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Additional horizontal load locations are required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:node gen:DirectAnalysisCaseWithCaShape ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times p within relative tolerance 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressure ;
                      nltl:appliedIcePressure ?applied .
                ?pressure qudt:numericValue ?pressureValue .
                ?applied qudt:numericValue ?actual .
                BIND((1.8 * ?pressureValue) AS ?expected)
                FILTER (
                    ABS(?actual - ?expected) >
                    (0.000001 * IF(ABS(?expected) > 1, ABS(?expected), 1))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Intermediate cases must use several distinct vertical positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?position .
                ?position qudt:numericValue ?positionValue .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?positionValue) < 2)
        """
    ] ;
    sh:sparql [
        sh:message "Direct analyses must use several distinct horizontal positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:horizontalLoadPosition ?position .
                ?position qudt:numericValue ?positionValue .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?positionValue) < 2)
        """
    ] ;
    sh:sparql [
        sh:message "When load length is not determined from the arrangement, several distinct case-level load lengths with corresponding ca values are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadLengthDeterminedFromArrangement false ;
                      nltl:hasDirectAnalysisCase ?case .
                ?case nltl:loadPatchLength ?loadLength ;
                      nltl:iceLoadAreaFactorCa ?ca .
                ?loadLength qudt:numericValue ?loadLengthValue .
                ?ca qudt:numericValue ?caValue .
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?loadLengthValue) < 2)
        """
    ] .
