@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:VerticalCaseBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:in (
            nltl:upperIceWaterlineCenteredPosition
            nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            nltl:intermediateVerticalPosition
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:maxCount 0
    ] .

gen:HorizontalCaseBranch a sh:NodeShape ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:in (
            nltl:midSpanOrSpacingCenteredPosition
            nltl:otherHorizontalPosition
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:maxCount 0
    ] .

gen:LoadLengthAreaFactorCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DirectAnalysisCaseShape a sh:NodeShape ;
    sh:targetClass nltl:directAnalysisCase ;
    sh:or (
        [ sh:node gen:VerticalCaseBranch ]
        [ sh:node gen:HorizontalCaseBranch ]
    ) ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ShipDirectAnalysisShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:node gen:VerticalCaseBranch
        ] ;
        sh:qualifiedMinCount 4 ;
        sh:message "At least four vertical analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:upperIceWaterlineCenteredPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A UIWL-centred vertical analysis case is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A vertical case half a load height below LIWL is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:verticalLoadPositionType ;
                sh:hasValue nltl:intermediateVerticalPosition
            ]
        ] ;
        sh:qualifiedMinCount 2 ;
        sh:message "At least two intermediate vertical analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:node gen:HorizontalCaseBranch
        ] ;
        sh:qualifiedMinCount 2 ;
        sh:message "At least two horizontal analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:midSpanOrSpacingCenteredPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A mid-span or mid-spacing horizontal case is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:horizontalLoadPositionType ;
                sh:hasValue nltl:otherHorizontalPosition
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An additional horizontal analysis position is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:qualifiedValueShape [
                    sh:node gen:LoadLengthAreaFactorCaseShape
                ] ;
                sh:qualifiedMinCount 2 ;
                sh:message "Several paired load-length and area-factor cases are required."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times the section 4.2.2 ice pressure within relative tolerance 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:appliedIcePressure ?appliedQuantity .
                ?pressureQuantity qudt:numericValue ?pressure .
                ?appliedQuantity qudt:numericValue ?applied .
                BIND (xsd:decimal(?pressure) * 1.8 AS ?expected)
                BIND (IF(ABS(?expected) * 0.000001 > 0.000000001,
                         ABS(?expected) * 0.000001,
                         0.000000001) AS ?tolerance)
                FILTER (ABS(xsd:decimal(?applied) - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The UIWL-centred load position must match its UIWL reference within relative tolerance 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                      nltl:verticalLoadPosition ?positionQuantity ;
                      nltl:upperIceWaterlineReferencePosition ?referenceQuantity .
                ?positionQuantity qudt:numericValue ?position .
                ?referenceQuantity qudt:numericValue ?reference .
                BIND (xsd:decimal(?reference) AS ?expected)
                BIND (IF(ABS(?expected) * 0.000001 > 0.000000001,
                         ABS(?expected) * 0.000001,
                         0.000000001) AS ?tolerance)
                FILTER (ABS(xsd:decimal(?position) - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The LIWL case must be positioned half a load-patch height below LIWL within relative tolerance 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?heightQuantity ;
                      nltl:hasDirectAnalysisCase ?case .
                ?heightQuantity qudt:numericValue ?height .
                ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                      nltl:verticalLoadPosition ?positionQuantity ;
                      nltl:lowerIceWaterlineReferencePosition ?referenceQuantity .
                ?positionQuantity qudt:numericValue ?position .
                ?referenceQuantity qudt:numericValue ?reference .
                BIND (xsd:decimal(?reference) - (0.5 * xsd:decimal(?height)) AS ?expected)
                BIND (IF(ABS(?expected) * 0.000001 > 0.000000001,
                         ABS(?expected) * 0.000001,
                         0.000000001) AS ?tolerance)
                FILTER (ABS(xsd:decimal(?position) - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Intermediate vertical positions must lie between the lower half-height position and UIWL." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?heightQuantity ;
                      nltl:hasDirectAnalysisCase ?case .
                ?heightQuantity qudt:numericValue ?height .
                ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?positionQuantity ;
                      nltl:lowerIceWaterlineReferencePosition ?lowerQuantity ;
                      nltl:upperIceWaterlineReferencePosition ?upperQuantity .
                ?positionQuantity qudt:numericValue ?position .
                ?lowerQuantity qudt:numericValue ?lower .
                ?upperQuantity qudt:numericValue ?upper .
                BIND (xsd:decimal(?lower) - (0.5 * xsd:decimal(?height)) AS ?lowerBound)
                BIND (xsd:decimal(?upper) AS ?upperBound)
                FILTER (xsd:decimal(?position) <= ?lowerBound ||
                        xsd:decimal(?position) >= ?upperBound)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Vertical analysis cases must use at least four distinct vertical positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?position) AS ?positionCount)
                    WHERE {
                        $this nltl:hasDirectAnalysisCase ?case .
                        ?case nltl:verticalLoadPosition ?quantity .
                        ?quantity qudt:numericValue ?position .
                    }
                    GROUP BY $this
                }
                FILTER (?positionCount < 4)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Horizontal analysis cases must use at least two distinct horizontal positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?position) AS ?positionCount)
                    WHERE {
                        $this nltl:hasDirectAnalysisCase ?case .
                        ?case nltl:horizontalLoadPosition ?quantity .
                        ?quantity qudt:numericValue ?position .
                    }
                    GROUP BY $this
                }
                FILTER (?positionCount < 2)
            }
        """
    ] ;
    sh:sparql [
        sh:message "When load length is not determined from the arrangement, at least two distinct paired load lengths and area factors are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadLengthDeterminedFromArrangement false .
                {
                    SELECT $this (COUNT(DISTINCT ?length) AS ?lengthCount)
                    WHERE {
                        $this nltl:hasDirectAnalysisCase ?case .
                        ?case nltl:loadPatchLength ?lengthQuantity ;
                              nltl:iceLoadAreaFactorCa ?factorQuantity .
                        ?lengthQuantity qudt:numericValue ?length .
                        ?factorQuantity qudt:numericValue ?factor .
                    }
                    GROUP BY $this
                }
                FILTER (?lengthCount < 2)
            }
        """
    ] .
