@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:upperIceWaterlineCenteredPosition ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:maxCount 0
    ] .

gen:LowerIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:maxCount 0
    ] .

gen:IntermediateVerticalCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:hasValue nltl:intermediateVerticalPosition ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:maxCount 0
    ] .

gen:HorizontalCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:midSpanOrSpacingCenteredPosition
            nltl:otherHorizontalPosition
        )
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:verticalLoadPositionType ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineReferencePosition ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:lowerIceWaterlineReferencePosition ;
        sh:maxCount 0
    ] .

gen:MidSpanOrSpacingCaseShape
    a sh:NodeShape ;
    sh:node gen:HorizontalCaseShape ;
    sh:property [
        sh:path nltl:horizontalLoadPositionType ;
        sh:hasValue nltl:midSpanOrSpacingCenteredPosition
    ] .

gen:PairedLoadLengthAreaFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PairedOrAbsentLoadLengthShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:node gen:PairedLoadLengthAreaFactorShape
        ]
        [
            sh:property [
                sh:path nltl:loadPatchLength ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:iceLoadAreaFactorCa ;
                sh:maxCount 0
            ]
        ]
    ) .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:node gen:UpperIceWaterlineCaseShape
        ]
        [
            sh:node gen:LowerIceWaterlineCaseShape
        ]
        [
            sh:node gen:IntermediateVerticalCaseShape
        ]
        [
            sh:node gen:HorizontalCaseShape
        ]
    ) .

gen:LoadLengthDeterminedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LoadLengthUndeterminedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:node gen:PairedOrAbsentLoadLengthShape
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:PairedLoadLengthAreaFactorShape ;
        sh:qualifiedMinCount 2 ;
        sh:message "At least two direct-analysis cases must pair load-patch length with the corresponding area factor."
    ] ;
    sh:sparql [
        sh:message "The checked load-patch lengths must include at least two distinct values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case1 ;
                          nltl:hasDirectAnalysisCase ?case2 .
                    ?case1 nltl:loadPatchLength ?length1 ;
                           nltl:iceLoadAreaFactorCa ?factor1 .
                    ?case2 nltl:loadPatchLength ?length2 ;
                           nltl:iceLoadAreaFactorCa ?factor2 .
                    ?length1 qudt:numericValue ?value1 .
                    ?length2 qudt:numericValue ?value2 .
                    FILTER (
                        ?case1 != ?case2 &&
                        xsd:decimal(?value1) != xsd:decimal(?value2)
                    )
                }
            }
        """
    ] .

gen:TRF030ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:UpperIceWaterlineCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A direct-analysis case centred at the upper ice waterline is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:LowerIceWaterlineCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A direct-analysis case half a load height below the lower ice waterline is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:IntermediateVerticalCaseShape ;
        sh:qualifiedMinCount 2 ;
        sh:message "At least two intermediate vertical direct-analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:HorizontalCaseShape ;
        sh:qualifiedMinCount 2 ;
        sh:message "At least two horizontal direct-analysis cases are required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:qualifiedValueShape gen:MidSpanOrSpacingCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A horizontal case centred at half the span or half the spacing is required."
    ] ;
    sh:or (
        [
            sh:node gen:LoadLengthDeterminedShape
        ]
        [
            sh:node gen:LoadLengthUndeterminedShape
        ]
    ) ;
    sh:sparql [
        sh:message "Applied ice pressure must equal 1.8 times the section 4.2.2 ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressure ;
                      nltl:appliedIcePressure ?applied .
                ?pressure qudt:numericValue ?pressureValue .
                ?applied qudt:numericValue ?appliedValue .
                BIND (1.8 * xsd:decimal(?pressureValue) AS ?expected)
                BIND (
                    IF (
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER (
                    ABS(xsd:decimal(?appliedValue) - ?expected) > ?tolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "An upper-ice-waterline case must be centred at its upper reference position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasDirectAnalysisCase ?case .
                ?case nltl:verticalLoadPositionType nltl:upperIceWaterlineCenteredPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:upperIceWaterlineReferencePosition ?reference .
                ?position qudt:numericValue ?positionValue .
                ?reference qudt:numericValue ?referenceValue .
                BIND (xsd:decimal(?referenceValue) AS ?expected)
                BIND (
                    IF (
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER (
                    ABS(xsd:decimal(?positionValue) - ?expected) > ?tolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A lower-ice-waterline case must be positioned half a load height below its lower reference." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?height ;
                      nltl:hasDirectAnalysisCase ?case .
                ?height qudt:numericValue ?heightValue .
                ?case nltl:verticalLoadPositionType nltl:halfLoadHeightBelowLowerIceWaterlinePosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?reference .
                ?position qudt:numericValue ?positionValue .
                ?reference qudt:numericValue ?referenceValue .
                BIND (
                    xsd:decimal(?referenceValue) -
                    (0.5 * xsd:decimal(?heightValue))
                    AS ?expected
                )
                BIND (
                    IF (
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER (
                    ABS(xsd:decimal(?positionValue) - ?expected) > ?tolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each intermediate vertical position must lie between the lower half-height position and the upper ice-waterline reference." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:loadPatchHeight ?height ;
                      nltl:hasDirectAnalysisCase ?case .
                ?height qudt:numericValue ?heightValue .
                ?case nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                      nltl:verticalLoadPosition ?position ;
                      nltl:lowerIceWaterlineReferencePosition ?lower ;
                      nltl:upperIceWaterlineReferencePosition ?upper .
                ?position qudt:numericValue ?positionValue .
                ?lower qudt:numericValue ?lowerValue .
                ?upper qudt:numericValue ?upperValue .
                BIND (
                    xsd:decimal(?lowerValue) -
                    (0.5 * xsd:decimal(?heightValue))
                    AS ?lowerBound
                )
                FILTER (
                    xsd:decimal(?positionValue) <= ?lowerBound ||
                    xsd:decimal(?positionValue) >= xsd:decimal(?upperValue)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Intermediate vertical cases must include at least two distinct positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case1 ;
                          nltl:hasDirectAnalysisCase ?case2 .
                    ?case1 nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                           nltl:verticalLoadPosition ?position1 .
                    ?case2 nltl:verticalLoadPositionType nltl:intermediateVerticalPosition ;
                           nltl:verticalLoadPosition ?position2 .
                    ?position1 qudt:numericValue ?value1 .
                    ?position2 qudt:numericValue ?value2 .
                    FILTER (
                        ?case1 != ?case2 &&
                        xsd:decimal(?value1) != xsd:decimal(?value2)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Horizontal direct-analysis cases must include at least two distinct positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasDirectAnalysisCase ?case1 ;
                          nltl:hasDirectAnalysisCase ?case2 .
                    ?case1 nltl:horizontalLoadPosition ?position1 ;
                           nltl:horizontalLoadPositionType ?type1 .
                    ?case2 nltl:horizontalLoadPosition ?position2 ;
                           nltl:horizontalLoadPositionType ?type2 .
                    ?position1 qudt:numericValue ?value1 .
                    ?position2 qudt:numericValue ?value2 .
                    FILTER (
                        ?case1 != ?case2 &&
                        xsd:decimal(?value1) != xsd:decimal(?value2)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A mid-span-or-spacing case must be positioned at half the span or half the spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:span ?span ;
                      nltl:spacing ?spacing ;
                      nltl:hasDirectAnalysisCase ?case .
                ?span qudt:numericValue ?spanValue .
                ?spacing qudt:numericValue ?spacingValue .
                ?case nltl:horizontalLoadPositionType nltl:midSpanOrSpacingCenteredPosition ;
                      nltl:horizontalLoadPosition ?position .
                ?position qudt:numericValue ?positionValue .
                BIND (0.5 * xsd:decimal(?spanValue) AS ?spanExpected)
                BIND (0.5 * xsd:decimal(?spacingValue) AS ?spacingExpected)
                BIND (
                    IF (
                        ABS(?spanExpected) * 0.000001 > 0.000000001,
                        ABS(?spanExpected) * 0.000001,
                        0.000000001
                    )
                    AS ?spanTolerance
                )
                BIND (
                    IF (
                        ABS(?spacingExpected) * 0.000001 > 0.000000001,
                        ABS(?spacingExpected) * 0.000001,
                        0.000000001
                    )
                    AS ?spacingTolerance
                )
                FILTER (
                    ABS(xsd:decimal(?positionValue) - ?spanExpected) > ?spanTolerance &&
                    ABS(xsd:decimal(?positionValue) - ?spacingExpected) > ?spacingTolerance
                )
            }
        """
    ] .
