@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:ClassificationSocietyScantlingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship that is not ice strengthened, when the regulation-required scantling is less than the classification-society-required scantling, the selected design scantling must be at least the classification-society-required scantling in the same unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?component
WHERE {
    $this nltl:iceStrengtheningStatus false ;
          nltl:hasComponent ?component .

    ?component nltl:regulationRequiredScantling ?regulationQuantity ;
               nltl:classificationSocietyRequiredScantling ?classificationQuantity .

    ?regulationQuantity qudt:numericValue ?regulationValue ;
                        qudt:unit ?unit .
    ?classificationQuantity qudt:numericValue ?classificationValue ;
                            qudt:unit ?unit .

    FILTER(
        xsd:decimal(?regulationValue) <
        xsd:decimal(?classificationValue)
    )

    FILTER NOT EXISTS {
        ?component nltl:selectedDesignScantling ?selectedQuantity .
        ?selectedQuantity qudt:numericValue ?selectedValue ;
                          qudt:unit ?unit .
        FILTER(
            xsd:decimal(?selectedValue) >=
            xsd:decimal(?classificationValue)
        )
    }
}
""" ;
    ] .
