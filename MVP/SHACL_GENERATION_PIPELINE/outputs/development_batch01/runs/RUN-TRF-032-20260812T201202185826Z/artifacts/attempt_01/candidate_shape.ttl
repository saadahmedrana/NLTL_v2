@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ScantlingSelectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:benchmarkEntity ;
    sh:property [
        sh:path nltl:iceStrengtheningStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a non-ice-strengthened entity, regulation and classification-society scantlings must be comparable; when the regulation scantling is lower, the selected design scantling must be at least the classification-society scantling in the same unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceStrengtheningStatus "false"^^xsd:boolean .

    OPTIONAL {
        $this nltl:regulationRequiredScantling ?regulationQuantity .
        OPTIONAL {
            ?regulationQuantity qudt:numericValue ?regulationValue .
        }
        OPTIONAL {
            ?regulationQuantity qudt:unit ?regulationUnit .
        }
    }

    OPTIONAL {
        $this nltl:classificationSocietyRequiredScantling ?classificationQuantity .
        OPTIONAL {
            ?classificationQuantity qudt:numericValue ?classificationValue .
        }
        OPTIONAL {
            ?classificationQuantity qudt:unit ?classificationUnit .
        }
    }

    OPTIONAL {
        $this nltl:selectedDesignScantling ?selectedQuantity .
        OPTIONAL {
            ?selectedQuantity qudt:numericValue ?selectedValue .
        }
        OPTIONAL {
            ?selectedQuantity qudt:unit ?selectedUnit .
        }
    }

    FILTER(
        IF(!BOUND(?regulationQuantity), true,
        IF(!BOUND(?regulationValue), true,
        IF(!BOUND(?regulationUnit), true,
        IF(datatype(?regulationValue) != xsd:decimal, true,
        IF(!isIRI(?regulationUnit), true,
        IF(!BOUND(?classificationQuantity), true,
        IF(!BOUND(?classificationValue), true,
        IF(!BOUND(?classificationUnit), true,
        IF(datatype(?classificationValue) != xsd:decimal, true,
        IF(!isIRI(?classificationUnit), true,
        IF(?regulationUnit != ?classificationUnit, true,
        IF(?regulationValue < ?classificationValue,
            IF(!BOUND(?selectedQuantity), true,
            IF(!BOUND(?selectedValue), true,
            IF(!BOUND(?selectedUnit), true,
            IF(datatype(?selectedValue) != xsd:decimal, true,
            IF(!isIRI(?selectedUnit), true,
            IF(?selectedUnit != ?classificationUnit, true,
               ?selectedValue < ?classificationValue
            )))))),
            false
        )))))))))))
    )
}
"""
    ] .
