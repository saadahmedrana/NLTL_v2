@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:EffectiveMemberCrossSectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:message "An effective member cross section must provide section modulus calculation input." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM3
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:message "An effective member cross section must provide shear area calculation input." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2
            ]
        ]
    ] .

gen:MemberSectionPropertyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:hasEffectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:hasEffectiveMemberCrossSection ;
        sh:class nltl:effectiveMemberCrossSection
    ] ;
    sh:property [
        sh:path nltl:memberNormalToPlating ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Member orientation relative to the plating is required to determine the applicable section-property calculation method."
    ] ;
    sh:sparql [
        sh:message "A member not normal to the plating must have classification-society section-property calculation evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:memberNormalToPlating ?normal .
                FILTER (?normal = "false"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] .
