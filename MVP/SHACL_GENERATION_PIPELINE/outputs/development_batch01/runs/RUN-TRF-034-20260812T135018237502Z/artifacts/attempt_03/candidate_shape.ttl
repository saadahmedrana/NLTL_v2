@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:EffectiveMemberCrossSectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:memberNormalToPlating ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The member must state exactly once whether it is normal to the plating."
    ] ;
    sh:property [
        sh:path nltl:hasEffectiveMemberCrossSection ;
        sh:class nltl:effectiveMemberCrossSection ;
        sh:minCount 1 ;
        sh:message "The member must have an effective member cross section." ;
        sh:node [
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:shearArea ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                        sh:minCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A member not normal to the plating must have classification-society section-property calculation evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:memberNormalToPlating ?normal .
                FILTER (?normal = "false"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A member not normal to the plating must be linked as a component of the ship in question." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:memberNormalToPlating ?normal .
                FILTER (?normal = "false"^^xsd:boolean)
                FILTER NOT EXISTS {
                    ?ship a nltl:ship ;
                          nltl:hasComponent $this .
                }
            }
        """
    ] .
