@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ApplicableMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:hasEffectiveMemberCrossSection ;
        sh:class nltl:effectiveMemberCrossSection ;
        sh:node gen:EffectiveMemberCrossSectionShape ;
        sh:minCount 1 ;
        sh:message "An applicable member must have an effective member cross section with section modulus and shear area."
    ] ;
    sh:property [
        sh:path nltl:memberNormalToPlating ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "Member orientation relative to the plating is required to determine whether classification-society calculation evidence is needed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:memberNormalToPlating ?orientation .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A member not normal to the plating must have classification-society section-property calculation evidence." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:memberNormalToPlating ?orientation .
                FILTER (?orientation = "false"^^xsd:boolean)
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                    ?evidence rdf:type nltl:evidenceArtifact .
                }
            }
        """
    ] .

gen:EffectiveMemberCrossSectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:SectionModulusValueShape ;
        sh:minCount 1 ;
        sh:message "The effective member cross section must provide a section modulus."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gen:ShearAreaValueShape ;
        sh:minCount 1 ;
        sh:message "The effective member cross section must provide a shear area."
    ] .

gen:SectionModulusValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3
    ] .

gen:ShearAreaValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2
    ] .
