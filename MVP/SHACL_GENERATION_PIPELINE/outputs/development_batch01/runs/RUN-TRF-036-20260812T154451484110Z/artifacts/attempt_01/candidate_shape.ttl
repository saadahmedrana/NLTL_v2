@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF036Shape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:iceClass ;
    sh:property [
        sh:path nltl:hasIceClassDesignParameterSet ;
        sh:minCount 1 ;
        sh:class nltl:iceClassDesignParameterSet ;
        sh:message "An ice-class design parameter set is required to establish the applicable ice-load heights." ;
        sh:node [
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:class qudt:QuantityValue ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:class qudt:QuantityValue ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Design ice load height must be less than the corresponding level ice thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasIceClassDesignParameterSet ?parameters .
                ?parameters nltl:levelIceThickness ?iceThickness ;
                            nltl:designIceLoadHeight ?loadHeight .
                ?iceThickness qudt:numericValue ?hi .
                ?loadHeight qudt:numericValue ?h .
                FILTER (xsd:decimal(?h) >= xsd:decimal(?hi))
            }
        """
    ] .
