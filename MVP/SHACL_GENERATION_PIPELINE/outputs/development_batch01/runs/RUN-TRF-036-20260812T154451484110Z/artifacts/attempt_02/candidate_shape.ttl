@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF036Table41Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For ice classes IA Super, IA, IB, and IC, the single ice-class design parameter set must contain the exact Table 4-1 level-ice thickness and design ice-load height values in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this nltl:iceClass ?iceClass .

                {
                    FILTER (?iceClass = nltl:iceClassIaSuper)
                    BIND ("1.0"^^xsd:decimal AS ?expectedHi)
                    BIND ("0.35"^^xsd:decimal AS ?expectedH)
                }
                UNION
                {
                    FILTER (?iceClass = nltl:iceClassIa)
                    BIND ("0.8"^^xsd:decimal AS ?expectedHi)
                    BIND ("0.30"^^xsd:decimal AS ?expectedH)
                }
                UNION
                {
                    FILTER (?iceClass = nltl:iceClassIb)
                    BIND ("0.6"^^xsd:decimal AS ?expectedHi)
                    BIND ("0.25"^^xsd:decimal AS ?expectedH)
                }
                UNION
                {
                    FILTER (?iceClass = nltl:iceClassIc)
                    BIND ("0.4"^^xsd:decimal AS ?expectedHi)
                    BIND ("0.22"^^xsd:decimal AS ?expectedH)
                }

                FILTER (
                    NOT EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set a nltl:iceClassDesignParameterSet ;
                             nltl:levelIceThickness ?hi ;
                             nltl:designIceLoadHeight ?h .

                        ?hi a qudt:QuantityValue ;
                            qudt:numericValue ?hiValue ;
                            qudt:unit unit:M .

                        ?h a qudt:QuantityValue ;
                           qudt:numericValue ?hValue ;
                           qudt:unit unit:M .

                        FILTER (
                            datatype(?hiValue) = xsd:decimal &&
                            datatype(?hValue) = xsd:decimal &&
                            ?hiValue = ?expectedHi &&
                            ?hValue = ?expectedH
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set1, ?set2 .
                        FILTER (?set1 != ?set2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?hi1, ?hi2 .
                        FILTER (?hi1 != ?hi2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:designIceLoadHeight ?h1, ?h2 .
                        FILTER (?h1 != ?h2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?hi .
                        ?hi qudt:numericValue ?hiValue1, ?hiValue2 .
                        FILTER (?hiValue1 != ?hiValue2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:designIceLoadHeight ?h .
                        ?h qudt:numericValue ?hValue1, ?hValue2 .
                        FILTER (?hValue1 != ?hValue2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:levelIceThickness ?hi .
                        ?hi qudt:unit ?hiUnit1, ?hiUnit2 .
                        FILTER (?hiUnit1 != ?hiUnit2)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasIceClassDesignParameterSet ?set .
                        ?set nltl:designIceLoadHeight ?h .
                        ?h qudt:unit ?hUnit1, ?hUnit2 .
                        FILTER (?hUnit1 != ?hUnit2)
                    }
                )
            }
        """
    ] .
