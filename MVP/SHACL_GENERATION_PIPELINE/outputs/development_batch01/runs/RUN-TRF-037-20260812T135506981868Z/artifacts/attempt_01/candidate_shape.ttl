@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UnitlessQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:PressureQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:PowerQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1
    ] .

gen:IcePressureCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gen:PressureQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:nominalIcePressureP0 ;
        sh:minCount 1 ;
        sh:node gen:PressureQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputFactorCd ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive "1"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClassFactorCp ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientA ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientB ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientK ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:node gen:PowerQuantityValueShape
    ] ;
    sh:sparql [
        sh:message "Ice pressure must equal c_d multiplied by c_p, c_a, and nominal ice pressure p_0." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:shipSizeEngineOutputFactorCd/qudt:numericValue ?cd ;
                      nltl:iceClassFactorCp/qudt:numericValue ?cp ;
                      nltl:iceLoadAreaFactorCa/qudt:numericValue ?ca ;
                      nltl:nominalIcePressureP0/qudt:numericValue ?p0 .
                FILTER (
                    xsd:decimal(?p) !=
                    (xsd:decimal(?cd) * xsd:decimal(?cp) *
                     xsd:decimal(?ca) * xsd:decimal(?p0))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Ship size and engine output factor c_d must equal the lesser of 1 and (a*k + b)/1000." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputFactorCd/qudt:numericValue ?cd ;
                      nltl:shipSizeEngineOutputCoefficientA/qudt:numericValue ?a ;
                      nltl:shipSizeEngineOutputCoefficientK/qudt:numericValue ?k ;
                      nltl:shipSizeEngineOutputCoefficientB/qudt:numericValue ?b .
                BIND (
                    ((xsd:decimal(?a) * xsd:decimal(?k)) + xsd:decimal(?b))
                    / xsd:decimal("1000")
                    AS ?calculatedCd
                )
                BIND (
                    IF (
                        ?calculatedCd > xsd:decimal("1"),
                        xsd:decimal("1"),
                        ?calculatedCd
                    )
                    AS ?expectedCd
                )
                FILTER (xsd:decimal(?cd) != ?expectedCd)
            }
        """
    ] .
