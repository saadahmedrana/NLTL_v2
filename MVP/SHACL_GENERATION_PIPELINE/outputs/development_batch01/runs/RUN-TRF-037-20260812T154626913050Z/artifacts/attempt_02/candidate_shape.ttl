@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:KilowattQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1
    ] .

gen:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:DesignIcePressureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gen:MegapascalQuantityShape ;
        sh:message "Design ice pressure must be provided in MPa."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputFactorCd ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The ship size and engine output factor c_d must be provided."
    ] ;
    sh:property [
        sh:path nltl:iceClassFactorCp ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The ice class factor c_p must be provided."
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The ice load area factor c_a must be provided."
    ] ;
    sh:property [
        sh:path nltl:nominalIcePressureP0 ;
        sh:minCount 1 ;
        sh:node gen:MegapascalQuantityShape ;
        sh:message "Nominal ice pressure p_0 must be provided in MPa."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientA ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Coefficient a must be provided."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientB ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Coefficient b must be provided."
    ] ;
    sh:property [
        sh:path nltl:continuousPropulsionPowerAvailableInIce ;
        sh:minCount 1 ;
        sh:node gen:KilowattQuantityShape ;
        sh:message "Continuous propulsion power available in ice must be provided in kW as operand k."
    ] ;
    sh:sparql [
        sh:message "Factor c_d must equal min((a*k+b)/1000, 1), with k expressed in kW." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputFactorCd ?cdQuantity ;
                      nltl:shipSizeEngineOutputCoefficientA ?aQuantity ;
                      nltl:shipSizeEngineOutputCoefficientB ?bQuantity ;
                      nltl:continuousPropulsionPowerAvailableInIce ?kQuantity .
                ?cdQuantity qudt:numericValue ?cd ;
                            qudt:unit unit:UNITLESS .
                ?aQuantity qudt:numericValue ?a ;
                           qudt:unit unit:UNITLESS .
                ?bQuantity qudt:numericValue ?b ;
                           qudt:unit unit:UNITLESS .
                ?kQuantity qudt:numericValue ?k ;
                           qudt:unit unit:KiloW .
                FILTER (
                    ?cd != IF(
                        ((?a * ?k + ?b) / 1000) > 1,
                        1,
                        ((?a * ?k + ?b) / 1000)
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Design ice pressure must equal c_d*c_p*c_a*p_0." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:shipSizeEngineOutputFactorCd ?cdQuantity ;
                      nltl:iceClassFactorCp ?cpQuantity ;
                      nltl:iceLoadAreaFactorCa ?caQuantity ;
                      nltl:nominalIcePressureP0 ?p0Quantity .
                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit unit:MegaPA .
                ?cdQuantity qudt:numericValue ?cd ;
                            qudt:unit unit:UNITLESS .
                ?cpQuantity qudt:numericValue ?cp ;
                            qudt:unit unit:UNITLESS .
                ?caQuantity qudt:numericValue ?ca ;
                            qudt:unit unit:UNITLESS .
                ?p0Quantity qudt:numericValue ?p0 ;
                            qudt:unit unit:MegaPA .
                FILTER (?pressure != (?cd * ?cp * ?ca * ?p0))
            }
        """
    ] .
