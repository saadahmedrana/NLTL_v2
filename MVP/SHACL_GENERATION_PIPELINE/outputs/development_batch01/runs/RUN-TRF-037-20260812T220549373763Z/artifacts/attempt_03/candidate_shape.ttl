@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:KilowattDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:MegapascalDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:IcePressureCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:continuousPropulsionPowerAvailableInIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:KilowattDecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientA ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:UnitlessDecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientB ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:UnitlessDecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputFactorCd ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive "1"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClassFactorCp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:UnitlessDecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:UnitlessDecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:nominalIcePressureP0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:MegapascalDecimalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:MegapascalDecimalQuantityShape
    ] ;
    sh:sparql [
        sh:message "The engine-output factor or design ice pressure does not match its formula within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:continuousPropulsionPowerAvailableInIce ?powerQuantity ;
                      nltl:shipSizeEngineOutputCoefficientA ?aQuantity ;
                      nltl:shipSizeEngineOutputCoefficientB ?bQuantity ;
                      nltl:shipSizeEngineOutputFactorCd ?cdQuantity ;
                      nltl:iceClassFactorCp ?cpQuantity ;
                      nltl:iceLoadAreaFactorCa ?caQuantity ;
                      nltl:nominalIcePressureP0 ?p0Quantity ;
                      nltl:icePressure ?pressureQuantity .

                ?powerQuantity qudt:numericValue ?power .
                ?aQuantity qudt:numericValue ?a .
                ?bQuantity qudt:numericValue ?b .
                ?cdQuantity qudt:numericValue ?cd .
                ?cpQuantity qudt:numericValue ?cp .
                ?caQuantity qudt:numericValue ?ca .
                ?p0Quantity qudt:numericValue ?p0 .
                ?pressureQuantity qudt:numericValue ?pressure .

                BIND((?a * ?power + ?b) / "1000"^^xsd:decimal AS ?expectedCd)
                BIND(
                    IF(
                        ABS(?expectedCd) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedCd) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    ) AS ?cdTolerance
                )
                BIND(?cd * ?cp * ?ca * ?p0 AS ?expectedPressure)
                BIND(
                    IF(
                        ABS(?expectedPressure) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedPressure) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    ) AS ?pressureTolerance
                )

                FILTER(
                    ABS(?cd - ?expectedCd) > ?cdTolerance ||
                    ABS(?pressure - ?expectedPressure) > ?pressureTolerance
                )
            }
        """
    ] .
