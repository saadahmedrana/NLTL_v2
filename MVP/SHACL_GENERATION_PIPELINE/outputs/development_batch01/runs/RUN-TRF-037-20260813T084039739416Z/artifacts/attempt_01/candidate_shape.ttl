@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:IcePressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1
    ] .

gen:IcePressureP0QuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:ShipSizeEngineOutputFactorShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxInclusive "1"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "A direct analysis case must provide the dimensionless ice load area factor c_a."
    ] .

gen:TRF037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:continuousPropulsionPowerAvailableInIce ;
        sh:minCount 1 ;
        sh:node gen:PowerQuantityShape ;
        sh:message "Continuous propulsion power available in ice must be provided in kW."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gen:IcePressureQuantityShape ;
        sh:message "Design ice pressure must be provided in MPa."
    ] ;
    sh:property [
        sh:path nltl:iceClassFactorCp ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The dimensionless ice class factor c_p must be provided."
    ] ;
    sh:property [
        sh:path nltl:nominalIcePressureP0 ;
        sh:minCount 1 ;
        sh:node gen:IcePressureP0QuantityShape ;
        sh:message "Nominal ice pressure p_0 must be provided in MPa."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientA ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The dimensionless coefficient a must be provided."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientB ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The dimensionless coefficient b must be provided."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientK ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "The dimensionless coefficient k must be provided."
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputFactorCd ;
        sh:minCount 1 ;
        sh:node gen:ShipSizeEngineOutputFactorShape ;
        sh:message "The dimensionless factor c_d must be provided and must not exceed 1."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:minCount 1 ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:message "A direct analysis case providing c_a must be linked to the ship."
    ] ;
    sh:sparql [
        sh:message "The reported c_d and design ice pressure must satisfy the prescribed formulas within relative tolerance 1e-6, with absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceClassFactorCp ?cpQuantity ;
                      nltl:nominalIcePressureP0 ?p0Quantity ;
                      nltl:shipSizeEngineOutputCoefficientA ?aQuantity ;
                      nltl:shipSizeEngineOutputCoefficientB ?bQuantity ;
                      nltl:shipSizeEngineOutputCoefficientK ?kQuantity ;
                      nltl:shipSizeEngineOutputFactorCd ?cdQuantity ;
                      nltl:hasDirectAnalysisCase ?case .

                ?case nltl:iceLoadAreaFactorCa ?caQuantity .

                ?pressureQuantity qudt:numericValue ?pressure .
                ?cpQuantity qudt:numericValue ?cp .
                ?p0Quantity qudt:numericValue ?p0 .
                ?aQuantity qudt:numericValue ?a .
                ?bQuantity qudt:numericValue ?b .
                ?kQuantity qudt:numericValue ?k .
                ?cdQuantity qudt:numericValue ?cd .
                ?caQuantity qudt:numericValue ?ca .

                BIND(
                    ((xsd:decimal(?a) * xsd:decimal(?k)) + xsd:decimal(?b))
                    / "1000"^^xsd:decimal
                    AS ?expectedCd
                )
                BIND(
                    xsd:decimal(?cd) * xsd:decimal(?cp) *
                    xsd:decimal(?ca) * xsd:decimal(?p0)
                    AS ?expectedPressure
                )
                BIND(
                    IF(
                        ABS(?expectedCd) * "0.000001"^^xsd:decimal >
                        "0.000000000001"^^xsd:decimal,
                        ABS(?expectedCd) * "0.000001"^^xsd:decimal,
                        "0.000000000001"^^xsd:decimal
                    )
                    AS ?cdTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedPressure) * "0.000001"^^xsd:decimal >
                        "0.000000000001"^^xsd:decimal,
                        ABS(?expectedPressure) * "0.000001"^^xsd:decimal,
                        "0.000000000001"^^xsd:decimal
                    )
                    AS ?pressureTolerance
                )
                FILTER(
                    ABS(xsd:decimal(?cd) - ?expectedCd) > ?cdTolerance ||
                    ABS(xsd:decimal(?pressure) - ?expectedPressure) > ?pressureTolerance
                )
            }
        """
    ] .
