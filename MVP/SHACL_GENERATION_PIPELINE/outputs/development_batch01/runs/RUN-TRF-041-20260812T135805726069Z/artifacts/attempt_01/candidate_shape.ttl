@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF041ShellPlatingThicknessShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasComponent ;
    sh:sparql [
        sh:message "Transversely framed shell plating requires correctly unitized inputs satisfying the transverse thickness formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:platingFramingOrientation nltl:transverseFramingOrientation .
                FILTER NOT EXISTS {
                    $this nltl:requiredShellPlatingThickness ?tNode ;
                          nltl:spacing ?sNode ;
                          nltl:transversePlatingFactorF1 ?f1Node ;
                          nltl:platingPressure ?pNode ;
                          nltl:yieldStrength ?yieldNode ;
                          nltl:corrosionAbrasionAddition ?tcNode .

                    ?tNode qudt:numericValue ?t ;
                           qudt:unit unit:MilliM .
                    ?sNode qudt:numericValue ?s ;
                           qudt:unit unit:M .
                    ?f1Node qudt:numericValue ?f1 ;
                            qudt:unit unit:UNITLESS .
                    ?pNode qudt:numericValue ?p ;
                           qudt:unit unit:MegaPA .
                    ?yieldNode qudt:numericValue ?yield ;
                               qudt:unit unit:MegaPA .
                    ?tcNode qudt:numericValue ?tc ;
                            qudt:unit unit:MilliM .

                    FILTER (
                        datatype(?t) = xsd:decimal &&
                        datatype(?s) = xsd:decimal &&
                        datatype(?f1) = xsd:decimal &&
                        datatype(?p) = xsd:decimal &&
                        datatype(?yield) = xsd:decimal &&
                        datatype(?tc) = xsd:decimal &&
                        ?s >= 0 &&
                        ?yield > 0 &&
                        (?f1 * ?p) >= 0 &&
                        ?t >= ?tc &&
                        ((?t - ?tc) * (?t - ?tc) * ?yield =
                         667 * 667 * ?s * ?s * ?f1 * ?p)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Longitudinally framed shell plating requires correctly unitized inputs satisfying the longitudinal thickness formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:platingFramingOrientation nltl:longitudinalFramingOrientation .
                FILTER NOT EXISTS {
                    $this nltl:requiredShellPlatingThickness ?tNode ;
                          nltl:spacing ?sNode ;
                          nltl:longitudinalPlatingFactorF2 ?f2Node ;
                          nltl:icePressure ?pNode ;
                          nltl:yieldStrength ?yieldNode ;
                          nltl:corrosionAbrasionAddition ?tcNode .

                    ?tNode qudt:numericValue ?t ;
                           qudt:unit unit:MilliM .
                    ?sNode qudt:numericValue ?s ;
                           qudt:unit unit:M .
                    ?f2Node qudt:numericValue ?f2 ;
                            qudt:unit unit:UNITLESS .
                    ?pNode qudt:numericValue ?p ;
                           qudt:unit unit:MegaPA .
                    ?yieldNode qudt:numericValue ?yield ;
                               qudt:unit unit:MegaPA .
                    ?tcNode qudt:numericValue ?tc ;
                            qudt:unit unit:MilliM .

                    FILTER (
                        datatype(?t) = xsd:decimal &&
                        datatype(?s) = xsd:decimal &&
                        datatype(?f2) = xsd:decimal &&
                        datatype(?p) = xsd:decimal &&
                        datatype(?yield) = xsd:decimal &&
                        datatype(?tc) = xsd:decimal &&
                        ?s >= 0 &&
                        (?f2 * ?yield) > 0 &&
                        ?p >= 0 &&
                        ?t >= ?tc &&
                        ((?t - ?tc) * (?t - ?tc) * ?f2 * ?yield =
                         667 * 667 * ?s * ?s * ?p)
                    )
                }
            }
        """
    ] .
