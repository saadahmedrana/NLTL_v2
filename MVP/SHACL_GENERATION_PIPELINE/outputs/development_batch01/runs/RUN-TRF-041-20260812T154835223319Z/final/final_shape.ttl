@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:ShellPlatingThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A transversely framed component requires spacing, transverse factor, plating pressure, yield strength, corrosion addition, and required thickness in the prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate nltl:platingFramingOrientation nltl:transverseFramingOrientation .
                FILTER NOT EXISTS {
                    ?plate nltl:spacing ?spacingQuantity ;
                           nltl:transversePlatingFactorF1 ?factorQuantity ;
                           nltl:platingPressure ?pressureQuantity ;
                           nltl:yieldStrength ?yieldQuantity ;
                           nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                           nltl:requiredShellPlatingThickness ?thicknessQuantity .
                    ?spacingQuantity qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                    ?factorQuantity qudt:numericValue ?factor ;
                                    qudt:unit unit:UNITLESS .
                    ?pressureQuantity qudt:numericValue ?pressure ;
                                      qudt:unit unit:MegaPA .
                    ?yieldQuantity qudt:numericValue ?yieldStrength ;
                                   qudt:unit unit:MegaPA .
                    ?corrosionQuantity qudt:numericValue ?corrosion ;
                                       qudt:unit unit:MilliM .
                    ?thicknessQuantity qudt:numericValue ?thickness ;
                                       qudt:unit unit:MilliM .
                    FILTER (
                        datatype(?spacing) = xsd:decimal &&
                        datatype(?factor) = xsd:decimal &&
                        datatype(?pressure) = xsd:decimal &&
                        datatype(?yieldStrength) = xsd:decimal &&
                        datatype(?corrosion) = xsd:decimal &&
                        datatype(?thickness) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For transverse framing, required shell plating thickness must equal 667*s*sqrt(f1*p_pl/sigma_y)+t_c." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate nltl:platingFramingOrientation nltl:transverseFramingOrientation ;
                       nltl:spacing ?spacingQuantity ;
                       nltl:transversePlatingFactorF1 ?factorQuantity ;
                       nltl:platingPressure ?pressureQuantity ;
                       nltl:yieldStrength ?yieldQuantity ;
                       nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                       nltl:requiredShellPlatingThickness ?thicknessQuantity .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit unit:UNITLESS .
                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit unit:MegaPA .
                ?yieldQuantity qudt:numericValue ?yieldStrength ;
                               qudt:unit unit:MegaPA .
                ?corrosionQuantity qudt:numericValue ?corrosion ;
                                   qudt:unit unit:MilliM .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                   qudt:unit unit:MilliM .
                FILTER (
                    datatype(?spacing) = xsd:decimal &&
                    datatype(?factor) = xsd:decimal &&
                    datatype(?pressure) = xsd:decimal &&
                    datatype(?yieldStrength) = xsd:decimal &&
                    datatype(?corrosion) = xsd:decimal &&
                    datatype(?thickness) = xsd:decimal
                )
                FILTER (
                    ?spacing <= 0 ||
                    ?factor < 0 ||
                    ?pressure < 0 ||
                    ?yieldStrength <= 0 ||
                    ?thickness < ?corrosion ||
                    ((?thickness - ?corrosion) * (?thickness - ?corrosion) * ?yieldStrength)
                        != (444889 * ?spacing * ?spacing * ?factor * ?pressure)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A longitudinally framed component requires spacing, longitudinal factor, plating pressure, yield strength, corrosion addition, and required thickness in the prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate nltl:platingFramingOrientation nltl:longitudinalFramingOrientation .
                FILTER NOT EXISTS {
                    ?plate nltl:spacing ?spacingQuantity ;
                           nltl:longitudinalPlatingFactorF2 ?factorQuantity ;
                           nltl:platingPressure ?pressureQuantity ;
                           nltl:yieldStrength ?yieldQuantity ;
                           nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                           nltl:requiredShellPlatingThickness ?thicknessQuantity .
                    ?spacingQuantity qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                    ?factorQuantity qudt:numericValue ?factor ;
                                    qudt:unit unit:UNITLESS .
                    ?pressureQuantity qudt:numericValue ?pressure ;
                                      qudt:unit unit:MegaPA .
                    ?yieldQuantity qudt:numericValue ?yieldStrength ;
                                   qudt:unit unit:MegaPA .
                    ?corrosionQuantity qudt:numericValue ?corrosion ;
                                       qudt:unit unit:MilliM .
                    ?thicknessQuantity qudt:numericValue ?thickness ;
                                       qudt:unit unit:MilliM .
                    FILTER (
                        datatype(?spacing) = xsd:decimal &&
                        datatype(?factor) = xsd:decimal &&
                        datatype(?pressure) = xsd:decimal &&
                        datatype(?yieldStrength) = xsd:decimal &&
                        datatype(?corrosion) = xsd:decimal &&
                        datatype(?thickness) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For longitudinal framing, required shell plating thickness must equal 667*s*sqrt(p/(f2*sigma_y))+t_c." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate nltl:platingFramingOrientation nltl:longitudinalFramingOrientation ;
                       nltl:spacing ?spacingQuantity ;
                       nltl:longitudinalPlatingFactorF2 ?factorQuantity ;
                       nltl:platingPressure ?pressureQuantity ;
                       nltl:yieldStrength ?yieldQuantity ;
                       nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                       nltl:requiredShellPlatingThickness ?thicknessQuantity .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit unit:UNITLESS .
                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit unit:MegaPA .
                ?yieldQuantity qudt:numericValue ?yieldStrength ;
                               qudt:unit unit:MegaPA .
                ?corrosionQuantity qudt:numericValue ?corrosion ;
                                   qudt:unit unit:MilliM .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                   qudt:unit unit:MilliM .
                FILTER (
                    datatype(?spacing) = xsd:decimal &&
                    datatype(?factor) = xsd:decimal &&
                    datatype(?pressure) = xsd:decimal &&
                    datatype(?yieldStrength) = xsd:decimal &&
                    datatype(?corrosion) = xsd:decimal &&
                    datatype(?thickness) = xsd:decimal
                )
                FILTER (
                    ?spacing <= 0 ||
                    ?factor <= 0 ||
                    ?pressure < 0 ||
                    ?yieldStrength <= 0 ||
                    ?thickness < ?corrosion ||
                    ((?thickness - ?corrosion) * (?thickness - ?corrosion) * ?factor * ?yieldStrength)
                        != (444889 * ?spacing * ?spacing * ?pressure)
                )
            }
        """
    ] .
