@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositiveMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositiveMegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:NonnegativeMegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:NonnegativeUnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositiveUnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ShellPlatingThicknessShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:platingFramingOrientation ;
    sh:targetSubjectsOf nltl:requiredShellPlatingThickness ;
    sh:targetSubjectsOf nltl:spacing ;
    sh:targetSubjectsOf nltl:yieldStrength ;
    sh:targetSubjectsOf nltl:corrosionAbrasionAddition ;
    sh:targetSubjectsOf nltl:transversePlatingFactorF1 ;
    sh:targetSubjectsOf nltl:longitudinalPlatingFactorF2 ;
    sh:targetSubjectsOf nltl:platingPressure ;
    sh:targetSubjectsOf nltl:icePressure ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:minCount 1 ;
        sh:in (
            nltl:transverseFramingOrientation
            nltl:longitudinalFramingOrientation
        )
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:node gs:MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gs:MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gs:PositiveMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:PositiveMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:platingFramingOrientation ;
                    sh:hasValue nltl:transverseFramingOrientation
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:transversePlatingFactorF1 ;
                sh:node gs:NonnegativeUnitlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:platingPressure ;
                sh:node gs:NonnegativeMegaPascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:platingFramingOrientation ;
                    sh:hasValue nltl:longitudinalFramingOrientation
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:longitudinalPlatingFactorF2 ;
                sh:node gs:PositiveUnitlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:icePressure ;
                sh:node gs:NonnegativeMegaPascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For transverse framing, shell plating thickness must satisfy formula 4.5 within relative tolerance 1e-6, with absolute fallback 1e-9 on the squared equation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:platingFramingOrientation nltl:transverseFramingOrientation ;
                      nltl:requiredShellPlatingThickness ?thicknessQuantity ;
                      nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:transversePlatingFactorF1 ?factorQuantity ;
                      nltl:platingPressure ?pressureQuantity .
                ?thicknessQuantity qudt:numericValue ?thickness .
                ?corrosionQuantity qudt:numericValue ?corrosion .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?factorQuantity qudt:numericValue ?factor .
                ?pressureQuantity qudt:numericValue ?pressure .
                BIND((?thickness - ?corrosion) / (667.0 * ?spacing) AS ?rootTerm)
                BIND(?rootTerm * ?rootTerm AS ?leftSide)
                BIND((?factor * ?pressure) / ?yieldStrength AS ?rightSide)
                BIND(
                    IF(
                        ABS(?rightSide) > 0.001,
                        0.000001 * ABS(?rightSide),
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(
                    ?thickness < ?corrosion ||
                    ABS(?leftSide - ?rightSide) > ?tolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For longitudinal framing, shell plating thickness must satisfy formula 4.6 within relative tolerance 1e-6, with absolute fallback 1e-9 on the squared equation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:platingFramingOrientation nltl:longitudinalFramingOrientation ;
                      nltl:requiredShellPlatingThickness ?thicknessQuantity ;
                      nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:longitudinalPlatingFactorF2 ?factorQuantity ;
                      nltl:icePressure ?pressureQuantity .
                ?thicknessQuantity qudt:numericValue ?thickness .
                ?corrosionQuantity qudt:numericValue ?corrosion .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?factorQuantity qudt:numericValue ?factor .
                ?pressureQuantity qudt:numericValue ?pressure .
                BIND((?thickness - ?corrosion) / (667.0 * ?spacing) AS ?rootTerm)
                BIND(?rootTerm * ?rootTerm AS ?leftSide)
                BIND(?pressure / (?factor * ?yieldStrength) AS ?rightSide)
                BIND(
                    IF(
                        ABS(?rightSide) > 0.001,
                        0.000001 * ABS(?rightSide),
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(
                    ?thickness < ?corrosion ||
                    ABS(?leftSide - ?rightSide) > ?tolerance
                )
            }
        """
    ] .
