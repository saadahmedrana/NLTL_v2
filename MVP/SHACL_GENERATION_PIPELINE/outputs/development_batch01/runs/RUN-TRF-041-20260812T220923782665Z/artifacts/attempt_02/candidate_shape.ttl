@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ShellPlatingThicknessShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:platingFramingOrientation ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:transverseFramingOrientation
            nltl:longitudinalFramingOrientation
        )
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:MegapascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:MillimetreQuantityShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:platingFramingOrientation ;
                sh:hasValue nltl:transverseFramingOrientation
            ] ;
            sh:property [
                sh:path nltl:transversePlatingFactorF1 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:UnitlessQuantityShape
            ] ;
            sh:property [
                sh:path nltl:platingPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:MegapascalQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:platingFramingOrientation ;
                sh:hasValue nltl:longitudinalFramingOrientation
            ] ;
            sh:property [
                sh:path nltl:longitudinalPlatingFactorF2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:UnitlessQuantityShape
            ] ;
            sh:property [
                sh:path nltl:icePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:MegapascalQuantityShape
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Shell plating thickness must satisfy the formula for the selected framing orientation within relative tolerance 1e-6, with absolute tolerance 1e-12 near zero; formula operands must define a real, non-zero-denominator calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:platingFramingOrientation ?orientation ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:corrosionAbrasionAddition ?corrosionQuantity ;
                      nltl:requiredShellPlatingThickness ?thicknessQuantity ;
                      ?factorProperty ?factorQuantity ;
                      ?pressureProperty ?pressureQuantity .

                ?spacingQuantity qudt:numericValue ?spacing .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?corrosionQuantity qudt:numericValue ?corrosionAddition .
                ?thicknessQuantity qudt:numericValue ?actualThickness .
                ?factorQuantity qudt:numericValue ?factor .
                ?pressureQuantity qudt:numericValue ?pressure .

                FILTER (
                    (?orientation = nltl:transverseFramingOrientation &&
                     ?factorProperty = nltl:transversePlatingFactorF1 &&
                     ?pressureProperty = nltl:platingPressure)
                    ||
                    (?orientation = nltl:longitudinalFramingOrientation &&
                     ?factorProperty = nltl:longitudinalPlatingFactorF2 &&
                     ?pressureProperty = nltl:icePressure)
                )

                BIND(
                    ?yieldStrength != 0.0 &&
                    (
                        ?orientation = nltl:transverseFramingOrientation ||
                        ?factor != 0.0
                    )
                    AS ?validDenominator
                )

                BIND(
                    IF(
                        ?validDenominator,
                        IF(
                            ?orientation = nltl:transverseFramingOrientation,
                            (?factor * ?pressure) / ?yieldStrength,
                            ?pressure / (?factor * ?yieldStrength)
                        ),
                        0.0
                    )
                    AS ?radicand
                )

                BIND(IF(?radicand >= 0.0, ?radicand, 0.0) AS ?safeRadicand)
                BIND(
                    667.0 * ?spacing * SQRT(?safeRadicand) + ?corrosionAddition
                    AS ?expectedThickness
                )
                BIND(
                    IF(
                        ABS(?expectedThickness) > 0.000000000001,
                        0.000001 * ABS(?expectedThickness),
                        0.000000000001
                    )
                    AS ?tolerance
                )

                FILTER (
                    !?validDenominator ||
                    ?radicand < 0.0 ||
                    ABS(?actualThickness - ?expectedThickness) > ?tolerance
                )
            }
        """
    ] .
