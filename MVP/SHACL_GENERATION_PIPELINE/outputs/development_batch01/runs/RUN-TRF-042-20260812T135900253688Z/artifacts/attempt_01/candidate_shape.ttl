@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:YieldStrengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A component with a specified normal- or high-strength hull structural steel grade requires yield strength data." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?component
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hullStructuralSteelGrade ?grade .
                VALUES ?grade {
                    nltl:normalStrengthHullStructuralSteel
                    nltl:highStrengthHullStructuralSteel
                }
                FILTER NOT EXISTS {
                    ?component nltl:yieldStrength ?quantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Yield strength must have decimal numeric data expressed in megapascals." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?component ?quantity
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hullStructuralSteelGrade ?grade ;
                           nltl:yieldStrength ?quantity .
                VALUES ?grade {
                    nltl:normalStrengthHullStructuralSteel
                    nltl:highStrengthHullStructuralSteel
                }
                FILTER (
                    NOT EXISTS {
                        ?quantity qudt:numericValue ?value .
                    }
                    ||
                    EXISTS {
                        ?quantity qudt:numericValue ?value .
                        FILTER (datatype(?value) != xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?quantity qudt:unit unit:MegaPA .
                    }
                    ||
                    EXISTS {
                        ?quantity qudt:unit ?otherUnit .
                        FILTER (?otherUnit != unit:MegaPA)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Yield strength must be 235 MPa for normal-strength hull structural steel and at least 315 MPa for high-strength hull structural steel." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?component ?value
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hullStructuralSteelGrade ?grade ;
                           nltl:yieldStrength ?quantity .
                ?quantity qudt:numericValue ?value ;
                          qudt:unit unit:MegaPA .
                FILTER (datatype(?value) = xsd:decimal)
                FILTER (
                    (?grade = nltl:normalStrengthHullStructuralSteel && ?value != 235)
                    ||
                    (?grade = nltl:highStrengthHullStructuralSteel && ?value < 315)
                )
            }
        """
    ] .
