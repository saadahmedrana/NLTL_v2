@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:HullStructuralSteelYieldStrengthShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:hullStructuralSteelGrade ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:message "Hull structural steel requires decimal yield-strength data in MegaPA." ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Normal-strength hull structural steel requires a yield strength of exactly 235 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hullStructuralSteelGrade
                          nltl:normalStrengthHullStructuralSteel ;
                      nltl:yieldStrength ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (?value != "235"^^xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "High-strength hull structural steel requires a yield strength of at least 315 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hullStructuralSteelGrade
                          nltl:highStrengthHullStructuralSteel ;
                      nltl:yieldStrength ?quantity .
                ?quantity qudt:numericValue ?value .
                FILTER (?value < "315"^^xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A nonstandard hull structural steel grade requires approved material evidence for use of its actual yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hullStructuralSteelGrade ?grade .
                FILTER (
                    ?grade != nltl:normalStrengthHullStructuralSteel &&
                    ?grade != nltl:highStrengthHullStructuralSteel
                )
                FILTER NOT EXISTS {
                    $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                }
            }
        """
    ] .
