@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF042YieldStrengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A normal-strength hull structural steel component must have a yield strength of 235 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hullStructuralSteelGrade nltl:normalStrengthHullStructuralSteel .
                FILTER NOT EXISTS {
                    ?component nltl:yieldStrength ?yieldStrength .
                    ?yieldStrength qudt:numericValue ?value ;
                                   qudt:unit unit:MegaPA .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value = 235
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A high-strength hull structural steel component must have a yield strength of at least 315 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:hullStructuralSteelGrade nltl:highStrengthHullStructuralSteel .
                FILTER NOT EXISTS {
                    ?component nltl:yieldStrength ?yieldStrength .
                    ?yieldStrength qudt:numericValue ?value ;
                                   qudt:unit unit:MegaPA .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value >= 315
                    )
                }
            }
        """
    ] .
