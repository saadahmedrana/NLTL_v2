@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:YieldStrengthShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:hullStructuralSteelGrade ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:message "Yield strength is required for the plate-thickness calculation." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal ;
                sh:message "Yield strength must have a decimal numeric value."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:message "Yield strength must be expressed in MPa."
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Unless an actual material value is approved, yield strength must be 235 MPa for normal-strength steel and at least 315 MPa for high-strength steel." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?yieldValue
            WHERE {
                $this nltl:hullStructuralSteelGrade ?grade ;
                      nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue ;
                               qudt:unit unit:MegaPA .
                FILTER (
                    ?grade IN (
                        nltl:normalStrengthHullStructuralSteel,
                        nltl:highStrengthHullStructuralSteel
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                }
                FILTER (
                    (?grade = nltl:normalStrengthHullStructuralSteel &&
                     ?yieldValue != 235.0)
                    ||
                    (?grade = nltl:highStrengthHullStructuralSteel &&
                     ?yieldValue < 315.0)
                )
            }
        """
    ] .
