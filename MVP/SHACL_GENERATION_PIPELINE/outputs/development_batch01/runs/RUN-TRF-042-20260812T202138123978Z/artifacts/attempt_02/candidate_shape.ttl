@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:YieldStrengthShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:hullStructuralSteelGrade ;
    sh:targetSubjectsOf nltl:yieldStrength ;
    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Hull structural steel grade is required to evaluate yield strength."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:message "Yield strength is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal ;
                sh:message "Yield strength requires a decimal numeric value."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:message "Yield strength must be expressed in MPa."
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The yield strength must be 235 MPa for normal-strength steel, at least 315 MPa for high-strength steel, or have an approved actual value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hullStructuralSteelGrade ?grade ;
                      nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue .

                FILTER NOT EXISTS {
                    $this nltl:materialApprovalStatus nltl:evidenceStateApproved .
                }

                FILTER (
                    (
                        ?grade = nltl:normalStrengthHullStructuralSteel
                        && ?yieldValue != 235
                    )
                    ||
                    (
                        ?grade = nltl:highStrengthHullStructuralSteel
                        && ?yieldValue < 315
                    )
                    ||
                    (
                        ?grade NOT IN (
                            nltl:normalStrengthHullStructuralSteel,
                            nltl:highStrengthHullStructuralSteel
                        )
                    )
                )
            }
        """
    ] .
