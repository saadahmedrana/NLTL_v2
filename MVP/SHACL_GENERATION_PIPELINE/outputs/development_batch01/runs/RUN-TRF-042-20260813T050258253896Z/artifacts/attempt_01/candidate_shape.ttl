@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MeterQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1
    ] .

gen:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .

gen:PlatingRequirementShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:designIceLoadHeight ;
    sh:targetSubjectsOf nltl:spacing ;
    sh:targetSubjectsOf nltl:longitudinalPlatingFactorF2 ;
    sh:targetSubjectsOf nltl:hullStructuralSteelGrade ;
    sh:targetSubjectsOf nltl:yieldStrength ;
    sh:targetSubjectsOf nltl:corrosionAbrasionAddition ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node gen:MeterQuantityShape ;
        sh:message "Design ice load height in metres is required for the f2 calculation."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node gen:MeterQuantityShape ;
        sh:message "Spacing in metres is required for the f2 calculation."
    ] ;
    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "A unitless longitudinal plating factor f2 is required."
    ] ;
    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:message "Hull structural steel grade is required to assess yield strength."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gen:MegapascalQuantityShape ;
        sh:message "Yield strength in MPa is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hullStructuralSteelGrade ;
                sh:hasValue nltl:normalStrengthHullStructuralSteel
            ]
        ]
        [
            sh:property [
                sh:path nltl:hullStructuralSteelGrade ;
                sh:hasValue nltl:highStrengthHullStructuralSteel
            ]
        ]
        [
            sh:property [
                sh:path nltl:materialApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "The corrosion and abrasion addition in millimetres is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:corrosionAbrasionAddition ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:hasValue "2"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:corrosionAbrasionAddition ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "2"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:specialSurfaceCoatingMaintained ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:materialApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For normal-strength steel yield strength must equal 235 MPa; for high-strength steel it must be at least 315 MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hullStructuralSteelGrade ?grade ;
                      nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yieldValue ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                FILTER (
                    (?grade = nltl:normalStrengthHullStructuralSteel &&
                     ?yieldValue != "235"^^xsd:decimal)
                    ||
                    (?grade = nltl:highStrengthHullStructuralSteel &&
                     ?yieldValue < "315"^^xsd:decimal)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The h/s ratio must be non-zero and no greater than 1.8, and f2 must match the applicable formula within relative tolerance 1e-6 or absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:longitudinalPlatingFactorF2 ?factorQuantity .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                BIND(IF(?spacing = "0"^^xsd:decimal,
                        "1"^^xsd:decimal,
                        ?spacing) AS ?safeSpacing)
                BIND((?height / ?safeSpacing) AS ?ratio)
                BIND(IF(?ratio = "0"^^xsd:decimal,
                        "1"^^xsd:decimal,
                        ?ratio) AS ?safeRatio)
                BIND(
                    IF(
                        ?ratio <= "1"^^xsd:decimal,
                        ("0.4"^^xsd:decimal / ?safeRatio) + "0.6"^^xsd:decimal,
                        IF(
                            ?ratio <= "1.8"^^xsd:decimal,
                            "1.4"^^xsd:decimal -
                            ("0.4"^^xsd:decimal * ?ratio),
                            "0"^^xsd:decimal
                        )
                    ) AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expected) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    ) AS ?tolerance
                )
                FILTER (
                    ?spacing = "0"^^xsd:decimal ||
                    ?ratio = "0"^^xsd:decimal ||
                    ?ratio > "1.8"^^xsd:decimal ||
                    ABS(?factor - ?expected) > ?tolerance
                )
            }
        """
    ] .
