@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PositiveMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveYieldStrengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CorrosionAdditionQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF042PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:PositiveMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Design ice load height must be one positive quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:PositiveMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Spacing must be one positive quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:node gen:UnitlessFactorQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The longitudinal plating factor f2 must be one unitless quantity."
    ] ;
    sh:property [
        sh:path nltl:hullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PositiveYieldStrengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength must be one positive quantity in megapascals."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gen:CorrosionAdditionQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The corrosion and abrasion addition must be one nonnegative quantity in millimetres."
    ] ;
    sh:property [
        sh:path nltl:specialSurfaceCoatingMaintained ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:hullStructuralSteelGrade ;
                sh:hasValue nltl:normalStrengthHullStructuralSteel ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path ( nltl:yieldStrength qudt:numericValue ) ;
                sh:hasValue 235.0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:hullStructuralSteelGrade ;
                sh:hasValue nltl:highStrengthHullStructuralSteel ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path ( nltl:yieldStrength qudt:numericValue ) ;
                sh:minInclusive 315.0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:hullStructuralSteelGrade ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:materialApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path ( nltl:yieldStrength qudt:numericValue ) ;
                sh:minExclusive 0.0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;

    sh:or (
        [
            sh:property [
                sh:path ( nltl:corrosionAbrasionAddition qudt:numericValue ) ;
                sh:hasValue 2.0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:corrosionAbrasionAddition qudt:numericValue ) ;
                sh:minInclusive 0.0 ;
                sh:maxExclusive 2.0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:specialSurfaceCoatingMaintained ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:materialApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "The ratio h/s must not exceed 1.8, and f2 must match the applicable formula within relative tolerance 1e-6 or absolute tolerance 1e-9 near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:longitudinalPlatingFactorF2 ?factorQuantity .
                ?heightQuantity qudt:numericValue ?heightRaw .
                ?spacingQuantity qudt:numericValue ?spacingRaw .
                ?factorQuantity qudt:numericValue ?factorRaw .
                BIND(xsd:decimal(?heightRaw) AS ?height)
                BIND(xsd:decimal(?spacingRaw) AS ?spacing)
                BIND(xsd:decimal(?factorRaw) AS ?factor)
                BIND((?height / ?spacing) AS ?ratio)
                BIND(
                    IF(
                        ?ratio <= 1.0,
                        (0.4 / ?ratio) + 0.6,
                        1.4 - (0.4 * ?ratio)
                    )
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) > 0.001,
                        0.000001 * ABS(?expected),
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(
                    ?ratio > 1.8 ||
                    ABS(?factor - ?expected) > ?tolerance
                )
            }
        """
    ] .
