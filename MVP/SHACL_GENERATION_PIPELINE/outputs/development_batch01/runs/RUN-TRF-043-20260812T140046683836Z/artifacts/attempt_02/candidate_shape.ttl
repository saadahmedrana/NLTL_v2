@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:VerticalExtensionOfFramingIceStrengtheningShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The framing-strengthening extents for the applicable ice class and hull region must meet Table 4-6 and be recorded as decimal quantities in metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?region
WHERE {
    $this nltl:iceClass ?iceClass .
    VALUES (?iceClass ?region ?minimumAbove ?minimumBelow) {
        (nltl:iceClassIaSuper nltl:bowRegion     "1.2"^^xsd:decimal "2.0"^^xsd:decimal)
        (nltl:iceClassIaSuper nltl:midbodyRegion "1.0"^^xsd:decimal "1.6"^^xsd:decimal)
        (nltl:iceClassIaSuper nltl:sternRegion   "1.0"^^xsd:decimal "1.6"^^xsd:decimal)
        (nltl:iceClassIa      nltl:bowRegion     "0.9"^^xsd:decimal "1.5"^^xsd:decimal)
        (nltl:iceClassIa      nltl:midbodyRegion "0.8"^^xsd:decimal "1.3"^^xsd:decimal)
        (nltl:iceClassIa      nltl:sternRegion   "0.8"^^xsd:decimal "1.3"^^xsd:decimal)
        (nltl:iceClassIb      nltl:bowRegion     "0.7"^^xsd:decimal "1.3"^^xsd:decimal)
        (nltl:iceClassIb      nltl:midbodyRegion "0.6"^^xsd:decimal "1.1"^^xsd:decimal)
        (nltl:iceClassIb      nltl:sternRegion   "0.6"^^xsd:decimal "1.1"^^xsd:decimal)
        (nltl:iceClassIc      nltl:bowRegion     "0.6"^^xsd:decimal "1.0"^^xsd:decimal)
        (nltl:iceClassIc      nltl:midbodyRegion "0.5"^^xsd:decimal "0.9"^^xsd:decimal)
        (nltl:iceClassIc      nltl:sternRegion   "0.5"^^xsd:decimal "0.9"^^xsd:decimal)
    }
    FILTER NOT EXISTS {
        $this nltl:hasComponent ?framing .
        ?framing nltl:hullRegion ?region ;
                 nltl:framingIceStrengtheningAboveUpperIceWaterline ?aboveQuantity ;
                 nltl:framingIceStrengtheningBelowLowerIceWaterline ?belowQuantity .
        ?aboveQuantity qudt:numericValue ?aboveValue ;
                       qudt:unit unit:M .
        ?belowQuantity qudt:numericValue ?belowValue ;
                       qudt:unit unit:M .
        FILTER(
            datatype(?aboveValue) = xsd:decimal &&
            datatype(?belowValue) = xsd:decimal &&
            ?aboveValue >= ?minimumAbove &&
            ?belowValue >= ?minimumBelow
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When an upper bow ice belt is required, the bow framing ice strengthening must reach the top of that belt." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:upperBowIceBeltRequired true .
    FILTER NOT EXISTS {
        $this nltl:hasComponent ?bowFraming .
        ?bowFraming nltl:hullRegion nltl:bowRegion ;
                    nltl:reachesUpperBowIceBeltTop true .
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Asserted termination at an adjacent boundary requires decimal extension evidence in millimetres not exceeding 250 mm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?component
WHERE {
    $this nltl:hasComponent ?component .
    ?component nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
    FILTER NOT EXISTS {
        ?component nltl:extensionBeyondAdjacentDeckOrTankBoundary ?extensionQuantity .
        ?extensionQuantity qudt:numericValue ?extensionValue ;
                           qudt:unit unit:MilliM .
        FILTER(
            datatype(?extensionValue) = xsd:decimal &&
            ?extensionValue <= "250"^^xsd:decimal
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Termination at an adjacent boundary is not permitted when the recorded extension exceeds 250 mm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?component ?extensionValue
WHERE {
    $this nltl:hasComponent ?component .
    ?component nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true ;
               nltl:extensionBeyondAdjacentDeckOrTankBoundary ?extensionQuantity .
    ?extensionQuantity qudt:numericValue ?extensionValue ;
                       qudt:unit unit:MilliM .
    FILTER(
        datatype(?extensionValue) = xsd:decimal &&
        ?extensionValue > "250"^^xsd:decimal
    )
}
""" ;
    ] .
