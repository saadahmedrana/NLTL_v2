@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF043Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Framing must reach the top of the upper bow ice belt when that belt is required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?component
WHERE {
    $this nltl:hasComponent ?component .
    ?component nltl:upperBowIceBeltRequired true .
    FILTER NOT EXISTS {
        ?component nltl:reachesUpperBowIceBeltTop true .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The extension beyond an adjacent deck or tank boundary must have a decimal value in millimetres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?component ?quantity
WHERE {
    $this nltl:hasComponent ?component .
    ?component nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
    FILTER NOT EXISTS {
        ?quantity qudt:numericValue ?value ;
                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        FILTER (datatype(?value) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Termination at the adjacent boundary is permitted when the extension beyond it is no more than 250 mm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?component
WHERE {
    $this nltl:hasComponent ?component .
    ?component nltl:extensionBeyondAdjacentDeckOrTankBoundary ?quantity .
    ?quantity qudt:numericValue ?value ;
              qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    FILTER (datatype(?value) = xsd:decimal && ?value <= 250)
    FILTER NOT EXISTS {
        ?component nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true .
    }
}
"""
    ] .
