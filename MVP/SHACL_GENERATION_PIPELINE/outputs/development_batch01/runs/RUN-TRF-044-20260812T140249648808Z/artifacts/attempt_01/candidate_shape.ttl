@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gen:MegaPascalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gen:FrameShearFactorQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:hasValue "1.2"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gen:SectionModulusQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3
    ] .

gen:ShearAreaQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2
    ] .

gen:MainOrIntermediateTransverseFrameCalculationShape a sh:NodeShape ;
    sh:targetSubjectsOf nltl:frameBoundaryConditionType ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:twoDeckFrameCondition
        ) ;
        sh:message "The frame boundary condition must be one of the applicable Table 4-7 conditions."
    ] ;

    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "A unitless frame boundary condition factor m0 is required."
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "A unitless frame moment factor mt is required."
    ] ;

    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:node gen:FrameShearFactorQuantityShape ;
        sh:message "The unitless frame shear distribution factor f3 must equal 1.2."
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Ice pressure in MPa is required for the frame calculation."
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Frame spacing in metres is required for the frame calculation."
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Design ice load height in metres is required for the frame calculation."
    ] ;

    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Effective frame span in metres is required for the frame calculation."
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Yield strength in MPa is required for the frame calculation."
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:message "Calculated section modulus in cubic centimetres is required."
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:node gen:ShearAreaQuantityShape ;
        sh:message "Calculated shear area in square centimetres is required."
    ] ;

    sh:sparql [
        sh:message "The frame moment factor is undefined because l is zero or 7 - 5*h/l is zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit unit:M .
                ?spanQuantity qudt:numericValue ?span ;
                              qudt:unit unit:M .
                {
                    FILTER (xsd:decimal(?span) = 0)
                }
                UNION
                {
                    FILTER (xsd:decimal(?span) != 0)
                    FILTER (
                        7.0 - 5.0 * xsd:decimal(?height) /
                        xsd:decimal(?span) = 0
                    )
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "frameMomentFactorMt must equal 7*m0/(7 - 5*h/l)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionFactorM0 ?m0Quantity ;
                      nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity .
                ?m0Quantity qudt:numericValue ?m0 ;
                            qudt:unit unit:UNITLESS .
                ?mtQuantity qudt:numericValue ?mt ;
                            qudt:unit unit:UNITLESS .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit unit:M .
                ?spanQuantity qudt:numericValue ?span ;
                              qudt:unit unit:M .
                FILTER (xsd:decimal(?span) != 0)
                BIND (
                    7.0 - 5.0 * xsd:decimal(?height) /
                    xsd:decimal(?span)
                    AS ?denominator
                )
                FILTER (?denominator != 0)
                BIND (
                    7.0 * xsd:decimal(?m0) / ?denominator
                    AS ?expectedMt
                )
                FILTER (xsd:decimal(?mt) != ?expectedMt)
            }
        """
    ] ;

    sh:sparql [
        sh:message "sectionModulus must equal p*s*h*l/(mt*yieldStrength)*10^6 cm3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity ;
                      nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:sectionModulus ?sectionQuantity .
                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit unit:MegaPA .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit unit:M .
                ?spanQuantity qudt:numericValue ?span ;
                              qudt:unit unit:M .
                ?mtQuantity qudt:numericValue ?mt ;
                            qudt:unit unit:UNITLESS .
                ?yieldQuantity qudt:numericValue ?yieldStrength ;
                               qudt:unit unit:MegaPA .
                ?sectionQuantity qudt:numericValue ?sectionModulus ;
                                 qudt:unit unit:CentiM3 .
                FILTER (
                    xsd:decimal(?mt) * xsd:decimal(?yieldStrength) != 0
                )
                BIND (
                    xsd:decimal(?pressure) *
                    xsd:decimal(?spacing) *
                    xsd:decimal(?height) *
                    xsd:decimal(?span) /
                    (
                        xsd:decimal(?mt) *
                        xsd:decimal(?yieldStrength)
                    ) *
                    1000000.0
                    AS ?expectedSectionModulus
                )
                FILTER (
                    xsd:decimal(?sectionModulus) !=
                    ?expectedSectionModulus
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "requiredShearArea must equal sqrt(3)*f3*p*h*s/(2*yieldStrength)*10^4 cm2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameShearDistributionFactorF3 ?f3Quantity ;
                      nltl:icePressure ?pressureQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:requiredShearArea ?areaQuantity .
                ?f3Quantity qudt:numericValue ?f3 ;
                            qudt:unit unit:UNITLESS .
                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit unit:MegaPA .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit unit:M .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?yieldQuantity qudt:numericValue ?yieldStrength ;
                               qudt:unit unit:MegaPA .
                ?areaQuantity qudt:numericValue ?area ;
                              qudt:unit unit:CentiM2 .
                FILTER (xsd:decimal(?yieldStrength) != 0)
                BIND (
                    xsd:decimal(?f3) *
                    xsd:decimal(?pressure) *
                    xsd:decimal(?height) *
                    xsd:decimal(?spacing) /
                    (2.0 * xsd:decimal(?yieldStrength)) *
                    10000.0
                    AS ?base
                )
                FILTER (
                    xsd:decimal(?area) * xsd:decimal(?area) !=
                    3.0 * ?base * ?base
                    ||
                    (?base > 0 && xsd:decimal(?area) < 0)
                    ||
                    (?base < 0 && xsd:decimal(?area) > 0)
                )
            }
        """
    ] .
