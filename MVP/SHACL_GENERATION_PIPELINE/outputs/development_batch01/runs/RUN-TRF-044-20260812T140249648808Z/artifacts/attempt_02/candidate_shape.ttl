@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CubicCentimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FrameSectionModulusAndShearAreaShape a sh:NodeShape ;
    sh:targetSubjectsOf nltl:frameBoundaryConditionType ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:frameBoundaryConditionTypeValue ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:twoDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
        )
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;

    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;

    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;

    sh:property [
        sh:path (
            nltl:frameShearDistributionFactorF3
            qudt:numericValue
        ) ;
        sh:hasValue "1.2"^^xsd:decimal ;
        sh:message "The frame shear distribution factor f3 must equal 1.2."
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] ;

    sh:sparql [
        sh:message "The boundary-condition factor m0 does not match Table 4-7." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Quantity .
                ?m0Quantity qudt:numericValue ?m0 .
                VALUES (?condition ?expectedM0) {
                    (nltl:bulkCarrierTopWingTankFrameCondition "12"^^xsd:decimal)
                    (nltl:singleDeckTankTopToMainDeckFrameCondition "8"^^xsd:decimal)
                    (nltl:twoDeckFrameCondition "10"^^xsd:decimal)
                    (nltl:multiDeckOrStringerContinuousFrameCondition "12"^^xsd:decimal)
                }
                FILTER (xsd:decimal(?m0) != ?expectedM0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Effective frame span must be nonzero for the mt calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:effectiveFrameSpan ?spanQuantity .
                ?spanQuantity qudt:numericValue ?span .
                FILTER (xsd:decimal(?span) = "0"^^xsd:decimal)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The frame moment factor mt must satisfy mt*(7*l - 5*h) = 7*m0*l." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Quantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity .
                ?mtQuantity qudt:numericValue ?mt .
                ?m0Quantity qudt:numericValue ?m0 .
                ?heightQuantity qudt:numericValue ?height .
                ?spanQuantity qudt:numericValue ?span .
                FILTER (
                    xsd:decimal(?mt) *
                    ("7"^^xsd:decimal * xsd:decimal(?span) -
                     "5"^^xsd:decimal * xsd:decimal(?height))
                    !=
                    "7"^^xsd:decimal * xsd:decimal(?m0) * xsd:decimal(?span)
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The section-modulus divisor mt times yield strength must be nonzero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:yieldStrength ?yieldQuantity .
                ?mtQuantity qudt:numericValue ?mt .
                ?yieldQuantity qudt:numericValue ?yield .
                FILTER (
                    xsd:decimal(?mt) * xsd:decimal(?yield)
                    = "0"^^xsd:decimal
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Section modulus must satisfy the prescribed frame formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:sectionModulus ?sectionQuantity ;
                      nltl:icePressure ?pressureQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity ;
                      nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:yieldStrength ?yieldQuantity .
                ?sectionQuantity qudt:numericValue ?section .
                ?pressureQuantity qudt:numericValue ?pressure .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?heightQuantity qudt:numericValue ?height .
                ?spanQuantity qudt:numericValue ?span .
                ?mtQuantity qudt:numericValue ?mt .
                ?yieldQuantity qudt:numericValue ?yield .
                FILTER (
                    xsd:decimal(?section) * xsd:decimal(?mt) * xsd:decimal(?yield)
                    !=
                    xsd:decimal(?pressure) * xsd:decimal(?spacing) *
                    xsd:decimal(?height) * xsd:decimal(?span) *
                    "1000000"^^xsd:decimal
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Yield strength must be nonzero for the shear-area calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?yield .
                FILTER (xsd:decimal(?yield) = "0"^^xsd:decimal)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Required shear area must satisfy the prescribed squared shear-area formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:requiredShearArea ?areaQuantity ;
                      nltl:frameShearDistributionFactorF3 ?f3Quantity ;
                      nltl:icePressure ?pressureQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:yieldStrength ?yieldQuantity .
                ?areaQuantity qudt:numericValue ?area .
                ?f3Quantity qudt:numericValue ?f3 .
                ?pressureQuantity qudt:numericValue ?pressure .
                ?heightQuantity qudt:numericValue ?height .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?yieldQuantity qudt:numericValue ?yield .
                FILTER (
                    xsd:decimal(?area) * xsd:decimal(?area) *
                    "4"^^xsd:decimal *
                    xsd:decimal(?yield) * xsd:decimal(?yield)
                    !=
                    "3"^^xsd:decimal *
                    xsd:decimal(?f3) * xsd:decimal(?f3) *
                    xsd:decimal(?pressure) * xsd:decimal(?pressure) *
                    xsd:decimal(?height) * xsd:decimal(?height) *
                    xsd:decimal(?spacing) * xsd:decimal(?spacing) *
                    "100000000"^^xsd:decimal
                )
            }
        """
    ] .
