@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gen:MegaPascalQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gen:SquareCentimetreQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2
    ] .

gen:CubicCentimetreQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3
    ] .

gen:FrameSectionModulusAndShearAreaShape a sh:NodeShape ;
    sh:targetSubjectsOf nltl:frameBoundaryConditionType ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:twoDeckFrameCondition
        )
    ] ;
    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "The frame moment factor, section modulus, and required shear area must satisfy the prescribed calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:frameBoundaryConditionFactorM0 ?m0Quantity ;
                          nltl:frameMomentFactorMt ?mtQuantity ;
                          nltl:icePressure ?pressureQuantity ;
                          nltl:spacing ?spacingQuantity ;
                          nltl:designIceLoadHeight ?heightQuantity ;
                          nltl:effectiveFrameSpan ?spanQuantity ;
                          nltl:yieldStrength ?yieldQuantity ;
                          nltl:sectionModulus ?modulusQuantity ;
                          nltl:requiredShearArea ?areaQuantity .

                    ?m0Quantity qudt:numericValue ?m0 ;
                                qudt:unit unit:UNITLESS .
                    ?mtQuantity qudt:numericValue ?mt ;
                                qudt:unit unit:UNITLESS .
                    ?pressureQuantity qudt:numericValue ?pressure ;
                                      qudt:unit unit:MegaPA .
                    ?spacingQuantity qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                    ?heightQuantity qudt:numericValue ?height ;
                                    qudt:unit unit:M .
                    ?spanQuantity qudt:numericValue ?span ;
                                  qudt:unit unit:M .
                    ?yieldQuantity qudt:numericValue ?yieldStrength ;
                                   qudt:unit unit:MegaPA .
                    ?modulusQuantity qudt:numericValue ?sectionModulus ;
                                     qudt:unit unit:CentiM3 .
                    ?areaQuantity qudt:numericValue ?shearArea ;
                                  qudt:unit unit:CentiM2 .

                    FILTER (
                        ?span != "0"^^xsd:decimal &&
                        ("7"^^xsd:decimal * ?span -
                         "5"^^xsd:decimal * ?height) != "0"^^xsd:decimal &&
                        ?mt *
                            ("7"^^xsd:decimal * ?span -
                             "5"^^xsd:decimal * ?height)
                            =
                        "7"^^xsd:decimal * ?m0 * ?span &&

                        ?mt * ?yieldStrength != "0"^^xsd:decimal &&
                        ?sectionModulus * ?mt * ?yieldStrength
                            =
                        ?pressure * ?spacing * ?height * ?span *
                            "1000000"^^xsd:decimal &&

                        ?yieldStrength != "0"^^xsd:decimal &&
                        (
                            ?shearArea * "2"^^xsd:decimal * ?yieldStrength
                        ) * (
                            ?shearArea * "2"^^xsd:decimal * ?yieldStrength
                        )
                            =
                        "3"^^xsd:decimal * (
                            "1.2"^^xsd:decimal * ?pressure * ?height *
                            ?spacing * "10000"^^xsd:decimal
                        ) * (
                            "1.2"^^xsd:decimal * ?pressure * ?height *
                            ?spacing * "10000"^^xsd:decimal
                        ) &&
                        (
                            ?shearArea * "2"^^xsd:decimal * ?yieldStrength
                        ) * (
                            "1.2"^^xsd:decimal * ?pressure * ?height *
                            ?spacing * "10000"^^xsd:decimal
                        ) >= "0"^^xsd:decimal
                    )
                }
            }
        """
    ] .
