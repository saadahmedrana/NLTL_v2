@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF044FrameCalculationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:frameBoundaryConditionType ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:twoDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
        ) ;
        sh:message "The frame boundary condition must be one of the Table 4-7 conditions."
    ] ;
    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Exactly one unitless frame boundary condition factor m0 is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:hasValue "5.7"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:hasValue "6.0"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:twoDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:hasValue "5.7"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:hasValue "5.0"^^xsd:decimal
                    ]
                ]
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Exactly one unitless frame moment factor mt is required."
    ] ;
    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "1.2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "The frame shear distribution factor f3 must equal 1.2."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Exactly one ice pressure in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Exactly one design ice load height in metres is required."
    ] ;
    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Exactly one effective frame span in metres is required."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Exactly one frame spacing in metres is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Exactly one yield strength in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape ;
        sh:message "Exactly one section modulus in cubic centimetres is required."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape ;
        sh:message "Exactly one required shear area in square centimetres is required."
    ] ;
    sh:sparql [
        sh:message "The frame moment factor must satisfy mt = 7*m0/(7 - 5*h/l)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionFactorM0/qudt:numericValue ?m0 ;
                      nltl:frameMomentFactorMt/qudt:numericValue ?mt ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:effectiveFrameSpan/qudt:numericValue ?l .
                FILTER (
                    (?l = 0) ||
                    ((7 - (5 * ?h / ?l)) = 0) ||
                    (
                        ?l != 0 &&
                        (7 - (5 * ?h / ?l)) != 0 &&
                        ?mt != (7 * ?m0 / (7 - (5 * ?h / ?l)))
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The section modulus must satisfy Z = p*s*h*l/(mt*yieldStrength)*10^6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:effectiveFrameSpan/qudt:numericValue ?l ;
                      nltl:frameMomentFactorMt/qudt:numericValue ?mt ;
                      nltl:yieldStrength/qudt:numericValue ?yield ;
                      nltl:sectionModulus/qudt:numericValue ?z .
                FILTER (
                    (?mt * ?yield = 0) ||
                    (
                        (?mt * ?yield != 0) &&
                        ?z != ((?p * ?s * ?h * ?l) / (?mt * ?yield) * 1000000)
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The required shear area must satisfy A = sqrt(3)*f3*p*h*s/(2*yieldStrength)*10^4." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameShearDistributionFactorF3/qudt:numericValue ?f3 ;
                      nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:yieldStrength/qudt:numericValue ?yield ;
                      nltl:requiredShearArea/qudt:numericValue ?area .
                BIND ((?f3 * ?p * ?h * ?s * 10000) / (2 * ?yield) AS ?base)
                FILTER (
                    (?yield = 0) ||
                    (
                        ?yield != 0 &&
                        (
                            (?area * ?area != 3 * ?base * ?base) ||
                            (?base = 0 && ?area != 0) ||
                            (?base != 0 && ?area * ?base <= 0)
                        )
                    )
                )
            }
        """
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gen:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:CentiM3
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:CentiM2
    ] .
