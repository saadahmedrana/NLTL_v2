@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:M0Value6Shape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "6"^^xsd:decimal ;
        sh:maxInclusive "6"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:M0Value7Shape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "7"^^xsd:decimal ;
        sh:maxInclusive "7"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:M0Value5Point7Shape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "5.7"^^xsd:decimal ;
        sh:maxInclusive "5.7"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:M0Value5Shape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "5"^^xsd:decimal ;
        sh:maxInclusive "5"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F3ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.2"^^xsd:decimal ;
        sh:maxInclusive "1.2"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FrameSectionModulusAndShearAreaShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:frameBoundaryConditionType ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:twoDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
        )
    ] ;

    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;

    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:F3ValueShape
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityShape
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityShape
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SectionModulusQuantityShape
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ShearAreaQuantityShape
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node gen:M0Value6Shape
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node gen:M0Value7Shape
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:twoDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node gen:M0Value5Point7Shape
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node gen:M0Value5Shape
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "Effective frame span must be non-zero for the frame calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:effectiveFrameSpan ?spanQuantity .
                ?spanQuantity qudt:numericValue ?l .
                FILTER (?l = 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Yield strength must be non-zero for the frame calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:yieldStrength ?yieldQuantity .
                ?yieldQuantity qudt:numericValue ?sigma .
                FILTER (?sigma = 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The denominator of the frame moment factor formula must be non-zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity .
                ?heightQuantity qudt:numericValue ?h .
                ?spanQuantity qudt:numericValue ?l .
                FILTER (?l != 0)
                FILTER ((7 - 5 * ?h / ?l) = 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "frameMomentFactorMt must equal 7*m0/(7 - 5*h/l)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionFactorM0 ?m0Quantity ;
                      nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity .
                ?m0Quantity qudt:numericValue ?m0 .
                ?mtQuantity qudt:numericValue ?mt .
                ?heightQuantity qudt:numericValue ?h .
                ?spanQuantity qudt:numericValue ?l .
                FILTER (?l != 0)
                FILTER ((7 - 5 * ?h / ?l) != 0)
                FILTER (?mt != (7 * ?m0 / (7 - 5 * ?h / ?l)))
            }
        """
    ] ;

    sh:sparql [
        sh:message "sectionModulus must equal p*s*h*l/(\u006dt*sigma_y)*10^6 cm3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:effectiveFrameSpan ?spanQuantity ;
                      nltl:frameMomentFactorMt ?mtQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:sectionModulus ?sectionQuantity .
                ?pressureQuantity qudt:numericValue ?p .
                ?spacingQuantity qudt:numericValue ?s .
                ?heightQuantity qudt:numericValue ?h .
                ?spanQuantity qudt:numericValue ?l .
                ?mtQuantity qudt:numericValue ?mt .
                ?yieldQuantity qudt:numericValue ?sigma .
                ?sectionQuantity qudt:numericValue ?z .
                FILTER (?mt != 0 && ?sigma != 0)
                FILTER (?z != (?p * ?s * ?h * ?l * 1000000 / (?mt * ?sigma)))
            }
        """
    ] ;

    sh:sparql [
        sh:message "requiredShearArea must equal sqrt(3)*1.2*p*h*s/(2*sigma_y)*10^4 cm2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:requiredShearArea ?areaQuantity .
                ?pressureQuantity qudt:numericValue ?p .
                ?spacingQuantity qudt:numericValue ?s .
                ?heightQuantity qudt:numericValue ?h .
                ?yieldQuantity qudt:numericValue ?sigma .
                ?areaQuantity qudt:numericValue ?area .
                FILTER (?sigma != 0)
                FILTER (
                    ?area < 0 ||
                    (?area * ?area) !=
                    (3 * ((1.2 * ?p * ?h * ?s * 10000) / (2 * ?sigma)) *
                         ((1.2 * ?p * ?h * ?s * 10000) / (2 * ?sigma)))
                )
            }
        """
    ] .
