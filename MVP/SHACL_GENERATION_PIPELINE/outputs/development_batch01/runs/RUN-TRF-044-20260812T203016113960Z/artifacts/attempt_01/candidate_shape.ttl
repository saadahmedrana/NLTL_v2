@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MeterQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FixedShearDistributionFactorShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:hasValue "1.2"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TransverseFrameSectionModulusAndShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:twoDeckFrameCondition
        )
    ] ;
    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:FixedShearDistributionFactorShape
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "Boundary factor, moment factor, section modulus, and shear area must satisfy clause 4.4.2.1; derived values use relative tolerance 1e-6 with absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Node ;
                      nltl:frameMomentFactorMt ?mtNode ;
                      nltl:frameShearDistributionFactorF3 ?f3Node ;
                      nltl:icePressure ?pressureNode ;
                      nltl:spacing ?spacingNode ;
                      nltl:designIceLoadHeight ?heightNode ;
                      nltl:effectiveFrameSpan ?spanNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:sectionModulus ?sectionNode ;
                      nltl:requiredShearArea ?areaNode .

                ?m0Node qudt:numericValue ?m0Raw .
                ?mtNode qudt:numericValue ?mtRaw .
                ?f3Node qudt:numericValue ?f3Raw .
                ?pressureNode qudt:numericValue ?pressureRaw .
                ?spacingNode qudt:numericValue ?spacingRaw .
                ?heightNode qudt:numericValue ?heightRaw .
                ?spanNode qudt:numericValue ?spanRaw .
                ?yieldNode qudt:numericValue ?yieldRaw .
                ?sectionNode qudt:numericValue ?sectionRaw .
                ?areaNode qudt:numericValue ?areaRaw .

                BIND(xsd:decimal(?m0Raw) AS ?m0)
                BIND(xsd:decimal(?mtRaw) AS ?mt)
                BIND(xsd:decimal(?f3Raw) AS ?f3)
                BIND(xsd:decimal(?pressureRaw) AS ?pressure)
                BIND(xsd:decimal(?spacingRaw) AS ?spacing)
                BIND(xsd:decimal(?heightRaw) AS ?height)
                BIND(xsd:decimal(?spanRaw) AS ?span)
                BIND(xsd:decimal(?yieldRaw) AS ?yieldStrength)
                BIND(xsd:decimal(?sectionRaw) AS ?sectionModulus)
                BIND(xsd:decimal(?areaRaw) AS ?shearArea)

                BIND(
                    IF(
                        ?condition = nltl:bulkCarrierTopWingTankFrameCondition,
                        7.0,
                        IF(
                            ?condition = nltl:singleDeckTankTopToMainDeckFrameCondition,
                            6.0,
                            IF(
                                ?condition = nltl:multiDeckOrStringerContinuousFrameCondition,
                                5.7,
                                5.0
                            )
                        )
                    )
                    AS ?expectedM0
                )

                BIND((7.0 - (5.0 * ?height / ?span)) AS ?momentDenominator)
                BIND((7.0 * ?expectedM0 / ?momentDenominator) AS ?expectedMt)
                BIND(
                    (?pressure * ?spacing * ?height * ?span
                     / (?expectedMt * ?yieldStrength)) * 1000000.0
                    AS ?expectedSectionModulus
                )
                BIND(
                    (1.7320508075688772 * 1.2 * ?pressure * ?height * ?spacing
                     / (2.0 * ?yieldStrength)) * 10000.0
                    AS ?expectedShearArea
                )

                FILTER(
                    ?span = 0.0 ||
                    ?yieldStrength = 0.0 ||
                    ?momentDenominator = 0.0 ||
                    ?m0 != ?expectedM0 ||
                    ?f3 != 1.2 ||
                    ABS(?mt - ?expectedMt) >
                        (0.000000001 + 0.000001 * ABS(?expectedMt)) ||
                    ABS(?sectionModulus - ?expectedSectionModulus) >
                        (0.000000001 + 0.000001 * ABS(?expectedSectionModulus)) ||
                    ABS(?shearArea - ?expectedShearArea) >
                        (0.000000001 + 0.000001 * ABS(?expectedShearArea))
                )
            }
        """
    ] .
