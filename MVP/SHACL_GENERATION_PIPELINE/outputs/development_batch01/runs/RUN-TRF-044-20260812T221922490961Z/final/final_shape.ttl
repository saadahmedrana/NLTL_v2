@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CubicCentimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MainOrIntermediateTransverseFrameCalculationShape a sh:NodeShape ;
    sh:targetClass nltl:mainTransverseFrame ;
    sh:targetClass nltl:intermediateTransverseFrame ;
    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:class nltl:frameBoundaryConditionTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:twoDeckFrameCondition
        ) ;
        sh:message "The frame must have one permitted boundary condition."
    ] ;
    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "The boundary-condition factor, moment factor, shear factor, section modulus, or required shear area is inconsistent with clause 4.4.2.1." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:frameBoundaryConditionType ?condition ;
          nltl:frameBoundaryConditionFactorM0 ?m0Quantity ;
          nltl:frameMomentFactorMt ?mtQuantity ;
          nltl:frameShearDistributionFactorF3 ?f3Quantity ;
          nltl:icePressure ?pressureQuantity ;
          nltl:spacing ?spacingQuantity ;
          nltl:designIceLoadHeight ?heightQuantity ;
          nltl:effectiveFrameSpan ?spanQuantity ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:sectionModulus ?sectionQuantity ;
          nltl:requiredShearArea ?areaQuantity .

    ?m0Quantity qudt:numericValue ?m0Raw .
    ?mtQuantity qudt:numericValue ?mtRaw .
    ?f3Quantity qudt:numericValue ?f3Raw .
    ?pressureQuantity qudt:numericValue ?pressureRaw .
    ?spacingQuantity qudt:numericValue ?spacingRaw .
    ?heightQuantity qudt:numericValue ?heightRaw .
    ?spanQuantity qudt:numericValue ?spanRaw .
    ?yieldQuantity qudt:numericValue ?yieldRaw .
    ?sectionQuantity qudt:numericValue ?sectionRaw .
    ?areaQuantity qudt:numericValue ?areaRaw .

    BIND(xsd:decimal(?m0Raw) AS ?m0)
    BIND(xsd:decimal(?mtRaw) AS ?mt)
    BIND(xsd:decimal(?f3Raw) AS ?f3)
    BIND(xsd:decimal(?pressureRaw) AS ?pressure)
    BIND(xsd:decimal(?spacingRaw) AS ?spacing)
    BIND(xsd:decimal(?heightRaw) AS ?height)
    BIND(xsd:decimal(?spanRaw) AS ?span)
    BIND(xsd:decimal(?yieldRaw) AS ?yieldStrength)
    BIND(xsd:decimal(?sectionRaw) AS ?sectionModulus)
    BIND(xsd:decimal(?areaRaw) AS ?shearArea)

    BIND(
        IF(
            ?condition = nltl:bulkCarrierTopWingTankFrameCondition,
            7.0,
            IF(
                ?condition = nltl:singleDeckTankTopToMainDeckFrameCondition,
                6.0,
                IF(
                    ?condition = nltl:multiDeckOrStringerContinuousFrameCondition,
                    5.7,
                    5.0
                )
            )
        ) AS ?expectedM0
    )

    BIND(IF(?span != 0.0, 7.0 - (5.0 * ?height / ?span), 0.0) AS ?momentDenominator)
    BIND(
        (?span != 0.0 && ?yieldStrength != 0.0 && ?momentDenominator != 0.0)
        AS ?calculationReady
    )
    BIND(
        IF(
            ?calculationReady,
            7.0 * ?expectedM0 / ?momentDenominator,
            0.0
        ) AS ?expectedMt
    )
    BIND(
        IF(
            ?calculationReady,
            (?pressure * ?spacing * ?height * ?span /
             (?expectedMt * ?yieldStrength)) * 1000000.0,
            0.0
        ) AS ?expectedSectionModulus
    )
    BIND(
        IF(
            ?calculationReady,
            (1.7320508075688772 * ?f3 * ?pressure * ?height * ?spacing /
             (2.0 * ?yieldStrength)) * 10000.0,
            0.0
        ) AS ?expectedShearArea
    )

    BIND(
        IF(
            ABS(?expectedMt) * 0.000001 > 0.000000001,
            ABS(?expectedMt) * 0.000001,
            0.000000001
        ) AS ?mtTolerance
    )
    BIND(
        IF(
            ABS(?expectedSectionModulus) * 0.000001 > 0.000000001,
            ABS(?expectedSectionModulus) * 0.000001,
            0.000000001
        ) AS ?sectionTolerance
    )
    BIND(
        IF(
            ABS(?expectedShearArea) * 0.000001 > 0.000000001,
            ABS(?expectedShearArea) * 0.000001,
            0.000000001
        ) AS ?areaTolerance
    )

    FILTER(
        !?calculationReady ||
        ?m0 != ?expectedM0 ||
        ?f3 != 1.2 ||
        ABS(?mt - ?expectedMt) > ?mtTolerance ||
        ABS(?sectionModulus - ?expectedSectionModulus) > ?sectionTolerance ||
        ABS(?shearArea - ?expectedShearArea) > ?areaTolerance
    )
}
"""
    ] .
