@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:TRF046UpperEndAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:frameStrengthenedPart ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:class nltl:supportingStructure ;
                sh:message "The upper end must be attached to a supporting structure."
            ]
        ]
    ] .
