@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF046FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame,
        nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape gen:TRF046StrengthenedPartShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The frame must have a strengthened part whose upper end is attached to a permitted supporting structure."
    ] .

gen:TRF046StrengthenedPartShape
    a sh:NodeShape ;
    sh:class nltl:frameStrengthenedPart ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:node gen:TRF046UpperEndShape ;
        sh:message "The strengthened part must have an upper end attached to a permitted supporting structure."
    ] .

gen:TRF046UpperEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] .
