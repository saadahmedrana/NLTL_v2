@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:MainFrameUpperEndAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper end of the main frame must be attached to a deck structure, tank boundary plating, or ice stringer." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasUpperEnd ?upperEnd .
                    ?upperEnd a nltl:frameEnd ;
                        nltl:hasAttachedSupportingStructure ?support .
                    ?support a ?supportType .
                    FILTER (?supportType IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:iceStringer
                    ))
                }
            }
        """
    ] .

gen:IntermediateIceFrameUpperEndAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper end of the intermediate ice frame must have the required direct attachment or the permitted horizontal-member connection arrangement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasUpperEnd ?directUpperEnd .
                    ?directUpperEnd a nltl:frameEnd ;
                        nltl:hasAttachedSupportingStructure ?directSupport .
                    ?directSupport a ?directSupportType .
                    FILTER (?directSupportType IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:iceStringer
                    ))
                }
                FILTER NOT EXISTS {
                    $this nltl:hasTerminationAboveSupportingStructure ?terminationSupport ;
                        nltl:hasUpperEnd ?alternativeUpperEnd .
                    ?terminationSupport a ?terminationSupportType ;
                        nltl:supportingStructureAtOrAboveIceBeltUpperLimit "true"^^xsd:boolean .
                    FILTER (?terminationSupportType IN (
                        nltl:deckStructure,
                        nltl:iceStringer
                    ))
                    ?alternativeUpperEnd a nltl:frameEnd ;
                        nltl:hasHorizontalConnectionMember ?horizontalMember .
                    ?horizontalMember a nltl:horizontalConnectionMember ;
                        nltl:connectsToAdjacentMainFrame ?adjacentMainFrame ;
                        nltl:sameScantlingsAsMainFrame "true"^^xsd:boolean .
                    ?adjacentMainFrame a nltl:mainFrame .
                }
            }
        """
    ] .
