@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:MainFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper end of the main frame's strengthened part must be attached to a deck structure, tank boundary plating, or ice stringer." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?strengthenedPart .
                    ?strengthenedPart a nltl:frameStrengthenedPart ;
                        nltl:hasUpperEnd ?upperEnd .
                    ?upperEnd nltl:hasAttachedSupportingStructure ?support .
                    ?support a ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:iceStringer
                        )
                    )
                }
            }
        """
    ] .

gs:IntermediateIceFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The strengthened part must have a compliant upper-end attachment or the permitted horizontal-member connection to at least two distinct adjacent main frames." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasComponent ?attachedPart .
                        ?attachedPart a nltl:frameStrengthenedPart ;
                            nltl:hasUpperEnd ?attachedUpperEnd .
                        ?attachedUpperEnd
                            nltl:hasAttachedSupportingStructure ?attachedSupport .
                        ?attachedSupport a ?attachedSupportType .
                        FILTER (
                            ?attachedSupportType IN (
                                nltl:deckStructure,
                                nltl:tankBoundaryPlating,
                                nltl:iceStringer
                            )
                        )
                    }
                    &&
                    NOT EXISTS {
                        $this
                            nltl:hasTerminationAboveSupportingStructure
                                ?terminationSupport ;
                            nltl:hasComponent ?connectedPart .
                        ?terminationSupport
                            a ?terminationSupportType ;
                            nltl:supportingStructureAtOrAboveIceBeltUpperLimit
                                "true"^^xsd:boolean .
                        FILTER (
                            ?terminationSupportType IN (
                                nltl:deckStructure,
                                nltl:iceStringer
                            )
                        )
                        ?connectedPart
                            a nltl:frameStrengthenedPart ;
                            nltl:hasUpperEnd ?connectedUpperEnd .
                        ?connectedUpperEnd
                            nltl:hasHorizontalConnectionMember
                                ?horizontalMember .
                        ?horizontalMember
                            a nltl:horizontalConnectionMember ;
                            nltl:sameScantlingsAsMainFrame
                                "true"^^xsd:boolean ;
                            nltl:connectsToAdjacentMainFrame
                                ?adjacentMainFrame1,
                                ?adjacentMainFrame2 .
                        ?adjacentMainFrame1 a nltl:mainFrame .
                        ?adjacentMainFrame2 a nltl:mainFrame .
                        FILTER (?adjacentMainFrame1 != ?adjacentMainFrame2)
                    }
                )
            }
        """
    ] .
