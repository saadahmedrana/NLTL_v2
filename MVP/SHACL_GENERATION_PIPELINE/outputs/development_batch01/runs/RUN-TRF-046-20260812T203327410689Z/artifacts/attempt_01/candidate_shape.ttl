@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MainFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node gen:RequiredUpperEndShape ;
        sh:message "Each main frame must have an upper end satisfying the attachment requirement."
    ] .

gen:IntermediateIceFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node gen:IntermediateUpperEndShape ;
        sh:message "Each intermediate ice frame must have an upper end satisfying the attachment requirement."
    ] .

gen:RequiredUpperEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:ordinaryFrameScantlingsUsed ;
                    sh:hasValue true
                ]
            ]
        ]
        [
            sh:node gen:TerminationAboveIceBeltShape
        ]
    ) .

gen:IntermediateUpperEndShape
    a sh:NodeShape ;
    sh:node gen:RequiredUpperEndShape ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:node gen:HorizontalConnectionMemberShape ;
        sh:message "Each horizontal connection member must connect to an adjacent main frame and have the same scantlings as the main frame."
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:hasHorizontalConnectionMember ;
                    sh:minCount 1
                ]
            ]
        ]
        [
            sh:node gen:TerminationAboveIceBeltShape
        ]
    ) .

gen:TerminationAboveIceBeltShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The frame end must terminate above a supporting structure situated at or above the upper limit of the ice belt."
    ] .

gen:HorizontalConnectionMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:minCount 1 ;
        sh:class nltl:mainFrame
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] .
