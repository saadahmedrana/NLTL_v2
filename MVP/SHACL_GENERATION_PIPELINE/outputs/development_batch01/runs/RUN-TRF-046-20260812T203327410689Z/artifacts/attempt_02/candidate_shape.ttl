@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:AllowedAttachedSupportShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:iceStringer ]
    ) .

gen:TerminationAboveIceBeltShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:iceStringer ]
    ) ;
    sh:property [
        sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
        sh:hasValue true
    ] .

gen:AttachedUpperEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:qualifiedValueShape gen:AllowedAttachedSupportShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] .

gen:OrdinaryScantlingsTerminationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:qualifiedValueShape gen:TerminationAboveIceBeltShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Ordinary frame scantlings require termination above a deck structure or ice stringer at or above the ice-belt upper limit."
    ] ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:hasValue true
    ] .

gen:HorizontalConnectionMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:minCount 2 ;
        sh:class nltl:mainFrame ;
        sh:message "The horizontal member must connect to at least two adjacent main frames."
    ] .

gen:IntermediateFrameHorizontalConnectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:qualifiedValueShape gen:TerminationAboveIceBeltShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The horizontal-connection alternative requires termination above a deck structure or ice stringer at or above the ice-belt upper limit."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:qualifiedValueShape gen:HorizontalConnectionMemberShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The intermediate frame upper end must have a conforming horizontal connection member."
    ] .

gen:MainFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                gen:AttachedUpperEndShape
                gen:OrdinaryScantlingsTerminationShape
            )
        ] ;
        sh:message "Each main-frame upper end must satisfy an attachment or permitted termination condition."
    ] .

gen:IntermediateIceFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                gen:AttachedUpperEndShape
                gen:OrdinaryScantlingsTerminationShape
                gen:IntermediateFrameHorizontalConnectionShape
            )
        ] ;
        sh:message "Each intermediate ice-frame upper end must satisfy an attachment or permitted termination condition."
    ] .
