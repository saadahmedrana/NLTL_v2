@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AllowedAttachmentEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ] ;
        sh:message "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] .

gen:TerminationAboveIceBeltShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:iceStringer ]
            ) ;
            sh:property [
                sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ] ;
        sh:message "Termination must be above a deck structure or ice stringer situated at or above the ice-belt upper limit."
    ] .

gen:HorizontalConnectionEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:minCount 1 ;
        sh:class nltl:horizontalConnectionMember ;
        sh:qualifiedValueShape [
            sh:class nltl:horizontalConnectionMember ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:minCount 2 ;
                sh:class nltl:mainFrame
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A horizontal connection member must have the main-frame scantlings and connect to at least two adjacent main frames."
    ] .

gen:MainTransverseFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:or (
        [
            sh:not [ sh:class nltl:mainFrame ]
        ]
        [
            sh:property [
                sh:path nltl:hasUpperEnd ;
                sh:minCount 1 ;
                sh:class nltl:frameEnd ;
                sh:message "A transverse main frame must have an upper end represented as a frame end."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape [
                            sh:class nltl:frameEnd ;
                            sh:node gen:AllowedAttachmentEndShape
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:ordinaryFrameScantlingsUsed ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape [
                            sh:class nltl:frameEnd ;
                            sh:node gen:TerminationAboveIceBeltShape
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
            )
        ]
    ) .

gen:IntermediateTransverseFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:or (
        [
            sh:not [ sh:class nltl:intermediateIceFrame ]
        ]
        [
            sh:property [
                sh:path nltl:hasUpperEnd ;
                sh:minCount 1 ;
                sh:class nltl:frameEnd ;
                sh:message "A transverse intermediate ice frame must have an upper end represented as a frame end."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape [
                            sh:class nltl:frameEnd ;
                            sh:node gen:AllowedAttachmentEndShape
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:ordinaryFrameScantlingsUsed ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape [
                            sh:class nltl:frameEnd ;
                            sh:node gen:TerminationAboveIceBeltShape
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape [
                            sh:class nltl:frameEnd ;
                            sh:node gen:TerminationAboveIceBeltShape ;
                            sh:node gen:HorizontalConnectionEndShape
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
            )
        ]
    ) .
