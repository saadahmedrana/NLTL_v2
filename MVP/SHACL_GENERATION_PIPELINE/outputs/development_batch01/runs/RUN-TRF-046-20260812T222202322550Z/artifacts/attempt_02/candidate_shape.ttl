@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF046FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:not [
                sh:or (
                    [ sh:class nltl:mainFrame ]
                    [ sh:class nltl:intermediateIceFrame ]
                )
            ]
        ]
        [
            sh:class nltl:mainFrame ;
            sh:class nltl:transverseFrame ;
            sh:node gs:BooleanEvidenceShape ;
            sh:node gs:OrdinaryScantlingsPermissionShape ;
            sh:property [
                sh:path nltl:hasUpperEnd ;
                sh:qualifiedValueShape gs:DirectlyAttachedUpperEndShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A main frame shall have an upper end attached to a deck structure, tank-boundary plating, or ice stringer."
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:class nltl:transverseFrame ;
            sh:node gs:BooleanEvidenceShape ;
            sh:node gs:OrdinaryScantlingsPermissionShape ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape gs:DirectlyAttachedUpperEndShape ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "An intermediate ice frame shall have an upper end attached to a deck structure, tank-boundary plating, or ice stringer."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:sameScantlingsAsMainFrame ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasUpperEnd ;
                        sh:qualifiedValueShape gs:HorizontalConnectionUpperEndShape ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "The intermediate-frame horizontal-member alternative requires termination above a deck or ice stringer and connection to an adjacent main frame."
                    ]
                ]
            )
        ]
    ) .

gs:BooleanEvidenceShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean
    ] .

gs:OrdinaryScantlingsPermissionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:ordinaryFrameScantlingsUsed ;
                    sh:hasValue true
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasUpperEnd ;
                sh:qualifiedValueShape gs:TerminatingUpperEndShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "Ordinary frame scantlings are permitted only above a qualifying deck or ice stringer at or above the ice-belt upper limit."
            ]
        ]
    ) .

gs:DirectlyAttachedUpperEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:qualifiedValueShape [ sh:class nltl:deckStructure ] ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:qualifiedValueShape [ sh:class nltl:tankBoundaryPlating ] ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:qualifiedValueShape [ sh:class nltl:iceStringer ] ;
                sh:qualifiedMinCount 1
            ]
        ]
    ) .

gs:TerminatingUpperEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasTerminationAboveSupportingStructure ;
                sh:qualifiedValueShape [ sh:class nltl:deckStructure ] ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasTerminationAboveSupportingStructure ;
                sh:qualifiedValueShape [ sh:class nltl:iceStringer ] ;
                sh:qualifiedMinCount 1
            ]
        ]
    ) .

gs:HorizontalConnectionUpperEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:node gs:TerminatingUpperEndShape ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:qualifiedValueShape gs:AdjacentMainFrameConnectionShape ;
        sh:qualifiedMinCount 1
    ] .

gs:AdjacentMainFrameConnectionShape
    a sh:NodeShape ;
    sh:class nltl:horizontalConnectionMember ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:qualifiedValueShape [ sh:class nltl:mainFrame ] ;
        sh:qualifiedMinCount 1
    ] .
