@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF046FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper end must be attached to an allowed supporting structure or satisfy the permitted intermediate-frame connection alternative." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a ?frameType .
    FILTER(?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))

    FILTER NOT EXISTS {
        {
            $this nltl:hasStrengthenedPart ?part ;
                  nltl:hasUpperEnd ?end .
            ?part a nltl:frameStrengthenedPart .
            ?end nltl:hasAttachedSupportingStructure ?support .
            ?support a ?supportType .
            FILTER(?supportType IN (
                nltl:deckStructure,
                nltl:tankBoundaryPlating,
                nltl:iceStringer
            ))
        }
        UNION
        {
            $this a nltl:intermediateIceFrame ;
                  nltl:hasStrengthenedPart ?part ;
                  nltl:hasUpperEnd ?end .
            ?part a nltl:frameStrengthenedPart .
            ?end nltl:hasTerminationAboveSupportingStructure ?support ;
                 nltl:hasHorizontalConnectionMember ?member .
            ?support a ?supportType ;
                     nltl:supportingStructureAtOrAboveIceBeltUpperLimit ?atOrAbove .
            FILTER(?supportType IN (nltl:deckStructure, nltl:iceStringer))
            FILTER(?atOrAbove = "true"^^xsd:boolean)

            ?member nltl:sameScantlingsAsMainFrame ?sameScantlings ;
                    nltl:connectsToAdjacentMainFrame ?adjacentFrame1 ;
                    nltl:connectsToAdjacentMainFrame ?adjacentFrame2 .
            FILTER(?sameScantlings = "true"^^xsd:boolean)
            FILTER(?adjacentFrame1 != ?adjacentFrame2)
            ?adjacentFrame1 a nltl:mainFrame .
            ?adjacentFrame2 a nltl:mainFrame .
        }
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ordinary frame scantlings may be used only where the frame terminates above a deck or ice stringer at or above the ice-belt upper limit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a ?frameType ;
          nltl:hasStrengthenedPart ?part .
    FILTER(?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))

    ?part nltl:ordinaryFrameScantlingsUsed ?used .
    FILTER(?used = "true"^^xsd:boolean)

    FILTER NOT EXISTS {
        $this nltl:hasUpperEnd ?end .
        ?end nltl:hasTerminationAboveSupportingStructure ?support .
        ?support a ?supportType ;
                 nltl:supportingStructureAtOrAboveIceBeltUpperLimit ?atOrAbove .
        FILTER(?supportType IN (nltl:deckStructure, nltl:iceStringer))
        FILTER(?atOrAbove = "true"^^xsd:boolean)
    }
}
"""
    ] .
