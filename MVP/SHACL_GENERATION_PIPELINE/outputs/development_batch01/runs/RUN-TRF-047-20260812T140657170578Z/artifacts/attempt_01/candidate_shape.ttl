@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LowerEndOfStrengthenedFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frameStrengthenedPart ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:message "A strengthened frame part shall identify its lower end."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each lower end shall be attached to a supporting structure unless the documented permitted horizontal-member alternative applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?lowerEnd
            WHERE {
                $this nltl:hasLowerEnd ?lowerEnd .
                FILTER NOT EXISTS {
                    ?lowerEnd nltl:hasAttachedSupportingStructure ?attachedStructure .
                    ?attachedStructure a nltl:supportingStructure .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasTerminationBelowSupportingStructure ?supportingStructure .
                    ?supportingStructure
                        a nltl:supportingStructure ;
                        nltl:supportingStructureAtOrBelowIceBeltLowerLimit "true"^^xsd:boolean .
                    ?lowerEnd nltl:hasComponent ?horizontalMember .
                    ?horizontalMember
                        a nltl:horizontalConnectionMember ;
                        nltl:sameScantlingsAsMainFrame "true"^^xsd:boolean .
                    $this nltl:mainFrameBelowIceBeltStrengthened "true"^^xsd:boolean .
                }
            }
        """
    ] .

gs:MainFrameBelowIceBeltStrengtheningStateShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:mainFrameBelowIceBeltStrengthened ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The recorded main-frame-below-ice-belt strengthening state shall be true."
    ] .
