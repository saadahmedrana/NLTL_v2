@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MainFrameLowerEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:qualifiedValueShape [
                    sh:or (
                        [ sh:class nltl:deckStructure ]
                        [ sh:class nltl:tankBoundaryPlating ]
                        [ sh:class nltl:tankTop ]
                        [ sh:class nltl:iceStringer ]
                    )
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "The lower end of a main frame must be attached to an allowed supporting structure."
            ]
        ]
    ] .

gen:IntermediateIceFrameLowerEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasAttachedSupportingStructure ;
                        sh:qualifiedValueShape [
                            sh:or (
                                [ sh:class nltl:deckStructure ]
                                [ sh:class nltl:tankBoundaryPlating ]
                                [ sh:class nltl:tankTop ]
                                [ sh:class nltl:iceStringer ]
                            )
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasTerminationBelowSupportingStructure ;
                        sh:qualifiedValueShape [
                            sh:or (
                                [ sh:class nltl:deckStructure ]
                                [ sh:class nltl:tankBoundaryPlating ]
                                [ sh:class nltl:tankTop ]
                                [ sh:class nltl:iceStringer ]
                            ) ;
                            sh:property [
                                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true
                            ]
                        ] ;
                        sh:qualifiedMinCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:hasHorizontalConnectionMember ;
                        sh:qualifiedValueShape [
                            sh:class nltl:horizontalConnectionMember ;
                            sh:property [
                                sh:path nltl:sameScantlingsAsMainFrame ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true
                            ] ;
                            sh:property [
                                sh:path nltl:connectsToAdjacentMainFrame ;
                                sh:qualifiedValueShape [
                                    sh:class nltl:mainFrame
                                ] ;
                                sh:qualifiedMinCount 2
                            ]
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "The lower end of an intermediate ice frame must use an allowed direct attachment or the permitted horizontal-member alternative." .

gen:MainFrameBelowIceBeltStrengtheningShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The main frame below the ice belt must be recorded as strengthened."
    ] .
