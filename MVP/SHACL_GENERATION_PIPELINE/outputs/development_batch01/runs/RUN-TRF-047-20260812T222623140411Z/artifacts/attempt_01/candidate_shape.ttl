@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:LowerEndOfTransverseFramingShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The strengthened lower end shall be attached to an approved supporting structure or use the permitted intermediate-frame connection alternative." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this a ?regulatedFrameType .
    FILTER (
        ?regulatedFrameType IN (
            nltl:mainFrame,
            nltl:intermediateIceFrame
        )
    )
    FILTER NOT EXISTS {
        {
            $this nltl:hasStrengthenedPart ?strengthenedPart ;
                  nltl:hasLowerEnd ?lowerEnd .
            ?lowerEnd nltl:hasAttachedSupportingStructure ?supportingStructure .
            ?supportingStructure a ?supportingStructureType .
            FILTER (
                ?supportingStructureType IN (
                    nltl:deckStructure,
                    nltl:tankBoundaryPlating,
                    nltl:tankTop,
                    nltl:iceStringer
                )
            )
        }
        UNION
        {
            $this a nltl:intermediateIceFrame ;
                  nltl:hasStrengthenedPart ?strengthenedPart ;
                  nltl:hasLowerEnd ?lowerEnd ;
                  nltl:supportingStructureAtOrBelowIceBeltLowerLimit true ;
                  nltl:sameScantlingsAsMainFrame true .
            ?lowerEnd nltl:hasTerminationBelowSupportingStructure ?supportingStructure ;
                      nltl:hasHorizontalConnectionMember ?horizontalMember .
            ?supportingStructure a ?supportingStructureType .
            FILTER (
                ?supportingStructureType IN (
                    nltl:deckStructure,
                    nltl:tankBoundaryPlating,
                    nltl:tankTop,
                    nltl:iceStringer
                )
            )
            ?horizontalMember nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
            ?adjacentMainFrame a nltl:mainFrame .
        }
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A main frame below the ice belt shall be recorded as ice strengthened." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this a nltl:mainFrame .
    FILTER NOT EXISTS {
        $this nltl:mainFrameBelowIceBeltStrengthened true .
    }
}
"""
    ] .
