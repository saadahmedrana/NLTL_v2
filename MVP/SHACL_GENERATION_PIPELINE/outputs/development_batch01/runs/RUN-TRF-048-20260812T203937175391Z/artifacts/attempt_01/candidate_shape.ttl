@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .

gs:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:maxCount 1
    ] .

gs:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:maxCount 1
    ] .

gs:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:maxCount 1
    ] .

gs:LongitudinalFrameCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gs:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gs:CubicCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameBoundaryConditionEvidence ;
                sh:class nltl:frameBoundaryConditionEvidence ;
                sh:minCount 1
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "Frame factors, section modulus, and effective shear area must satisfy clause 4.4.3; bracket area must be excluded. Derived values use relative tolerance 1e-6 with absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight/qudt:numericValue ?hRaw ;
                      nltl:spacing/qudt:numericValue ?sRaw ;
                      nltl:span/qudt:numericValue ?lRaw ;
                      nltl:icePressure/qudt:numericValue ?pRaw ;
                      nltl:yieldStrength/qudt:numericValue ?yieldRaw ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4Raw ;
                      nltl:longitudinalFrameShearFactorF5/qudt:numericValue ?f5Raw ;
                      nltl:frameMomentFactorM/qudt:numericValue ?mRaw ;
                      nltl:sectionModulus/qudt:numericValue ?zRaw ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actualRaw ;
                      nltl:grossFrameShearArea/qudt:numericValue ?grossRaw ;
                      nltl:bracketArea/qudt:numericValue ?bracketRaw ;
                      nltl:significantlyDifferentBoundaryConditions ?different .

                BIND(xsd:decimal(?hRaw) AS ?h)
                BIND(xsd:decimal(?sRaw) AS ?s)
                BIND(xsd:decimal(?lRaw) AS ?l)
                BIND(xsd:decimal(?pRaw) AS ?p)
                BIND(xsd:decimal(?yieldRaw) AS ?yield)
                BIND(xsd:decimal(?f4Raw) AS ?f4)
                BIND(xsd:decimal(?f5Raw) AS ?f5)
                BIND(xsd:decimal(?mRaw) AS ?m)
                BIND(xsd:decimal(?zRaw) AS ?z)
                BIND(xsd:decimal(?actualRaw) AS ?actual)
                BIND(xsd:decimal(?grossRaw) AS ?gross)
                BIND(xsd:decimal(?bracketRaw) AS ?bracket)

                BIND(IF(?s = 0, 1, ?s) AS ?safeS)
                BIND(IF(?yield = 0, 1, ?yield) AS ?safeYield)
                BIND(IF(?m = 0, 1, ?m) AS ?safeM)

                BIND((1 - (0.2 * ?h / ?safeS)) AS ?expectedF4)
                BIND((?f4 * ?p * ?h * ?l * ?l * 1000000 / (4 * ?safeM * ?safeYield)) AS ?expectedZ)
                BIND((1.7320508075688772 * ?f4 * ?f5 * ?p * ?h * ?l * 10000 / (2 * ?safeYield)) AS ?expectedArea)
                BIND((?gross - ?bracket) AS ?expectedActualFromGross)

                BIND(IF(ABS(?expectedF4) > 0.001, ABS(?expectedF4) * 0.000001, 0.000000001) AS ?f4Tolerance)
                BIND(IF(ABS(?expectedZ) > 0.001, ABS(?expectedZ) * 0.000001, 0.000000001) AS ?zTolerance)
                BIND(IF(ABS(?expectedArea) > 0.001, ABS(?expectedArea) * 0.000001, 0.000000001) AS ?areaTolerance)
                BIND(IF(ABS(?expectedActualFromGross) > 0.001, ABS(?expectedActualFromGross) * 0.000001, 0.000000001) AS ?exclusionTolerance)

                FILTER (
                    ?s = 0 ||
                    ?yield = 0 ||
                    ?m = 0 ||
                    ABS(?f4 - ?expectedF4) > ?f4Tolerance ||
                    ABS(?f5 - 2.16) > 0.00000216 ||
                    (?different = false && ABS(?m - 13.3) > 0.0000133) ||
                    (?different = true && ?m >= 13.3) ||
                    ABS(?z - ?expectedZ) > ?zTolerance ||
                    ABS(?actual - ?expectedArea) > ?areaTolerance ||
                    ABS(?actual - ?expectedActualFromGross) > ?exclusionTolerance
                )
            }
        """
    ] .
