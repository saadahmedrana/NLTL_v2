@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LongitudinalFrameScantlingShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasFrameBoundaryConditionEvidence ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:frameBoundaryConditionEvidence
    ] ;
    sh:sparql [
        sh:message "Frame calculation is non-conforming: denominator operands must be positive; f4, f5 and conditional m must be valid; section modulus and actual shear area must meet their calculated minima; and bracket area must be excluded. Derived-value tolerance is relative 1e-6 with absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualFrameShearArea/qudt:numericValue ?actualArea ;
                      nltl:bracketArea/qudt:numericValue ?bracketArea ;
                      nltl:grossFrameShearArea/qudt:numericValue ?grossArea ;
                      nltl:sectionModulus/qudt:numericValue ?sectionModulus ;
                      nltl:designIceLoadHeight/qudt:numericValue ?height ;
                      nltl:spacing/qudt:numericValue ?spacing ;
                      nltl:span/qudt:numericValue ?span ;
                      nltl:icePressure/qudt:numericValue ?pressure ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrength ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:longitudinalFrameShearFactorF5/qudt:numericValue ?f5 ;
                      nltl:significantlyDifferentBoundaryConditions ?different .

                BIND(IF(?spacing > 0, ?spacing, 1) AS ?safeSpacing)
                BIND(IF(?yieldStrength > 0, ?yieldStrength, 1) AS ?safeYieldStrength)
                BIND(IF(?m > 0, ?m, 1) AS ?safeM)

                BIND((1 - (0.2 * ?height / ?safeSpacing)) AS ?expectedF4)
                BIND((?f4 * ?pressure * ?height * ?span * ?span
                      / (4 * ?safeM * ?safeYieldStrength) * 1000000)
                     AS ?requiredSectionModulus)
                BIND((1.7320508075688772 * ?f4 * ?f5 * ?pressure * ?height * ?span
                      / (2 * ?safeYieldStrength) * 10000)
                     AS ?requiredShearArea)
                BIND((?grossArea - ?bracketArea) AS ?expectedActualArea)

                BIND(IF(
                    ABS(?expectedF4) * 0.000001 > 0.000000001,
                    ABS(?expectedF4) * 0.000001,
                    0.000000001
                ) AS ?f4Tolerance)
                BIND(IF(
                    ABS(?requiredSectionModulus) * 0.000001 > 0.000000001,
                    ABS(?requiredSectionModulus) * 0.000001,
                    0.000000001
                ) AS ?sectionTolerance)
                BIND(IF(
                    ABS(?requiredShearArea) * 0.000001 > 0.000000001,
                    ABS(?requiredShearArea) * 0.000001,
                    0.000000001
                ) AS ?shearTolerance)
                BIND(IF(
                    ABS(?expectedActualArea) * 0.000001 > 0.000000001,
                    ABS(?expectedActualArea) * 0.000001,
                    0.000000001
                ) AS ?exclusionTolerance)

                FILTER (
                    ?spacing <= 0 ||
                    ?yieldStrength <= 0 ||
                    ?m <= 0 ||
                    ABS(?f4 - ?expectedF4) > ?f4Tolerance ||
                    ?f5 != 2.16 ||
                    (
                        ?different = "false"^^xsd:boolean &&
                        ?m != 13.3
                    ) ||
                    (
                        ?different = "true"^^xsd:boolean &&
                        (
                            ?m >= 13.3 ||
                            NOT EXISTS {
                                $this nltl:hasFrameBoundaryConditionEvidence ?boundaryEvidence .
                                ?boundaryEvidence a nltl:frameBoundaryConditionEvidence .
                            }
                        )
                    ) ||
                    ?sectionModulus + ?sectionTolerance < ?requiredSectionModulus ||
                    ?actualArea + ?shearTolerance < ?requiredShearArea ||
                    ABS(?actualArea - ?expectedActualArea) > ?exclusionTolerance
                )
            }
        """
    ] .
