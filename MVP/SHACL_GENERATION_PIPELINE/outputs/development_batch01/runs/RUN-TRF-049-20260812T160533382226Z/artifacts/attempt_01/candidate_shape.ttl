@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FrameAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:sparql [
        sh:message "A frame within the ice-strengthened area must have effective attachment confirmed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea "true"^^xsd:boolean .
                FILTER NOT EXISTS {
                    $this nltl:effectiveAttachmentConfirmed "true"^^xsd:boolean .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A longitudinal frame associated with a supporting web frame or bulkhead must have a connection bracket." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this rdf:type nltl:longitudinalFrame .
                {
                    $this nltl:hasSupportingWebFrame ?support .
                }
                UNION
                {
                    $this nltl:hasSupportingBulkhead ?support .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A transverse frame terminating at a deck or ice stringer must have a frame attachment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this rdf:type nltl:transverseFrame ;
                      nltl:terminatesAtDeckOrIceStringer "true"^^xsd:boolean .
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A frame passing through a supporting structure must have both web-plate connection sides recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:passesThroughSupportingStructure "true"^^xsd:boolean .
                FILTER NOT EXISTS {
                    $this nltl:webPlateConnectionSideCount ?sideCount .
                    FILTER (
                        datatype(?sideCount) = xsd:integer &&
                        ?sideCount >= 2
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A frame with a connection bracket must provide frame web thickness in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    $this nltl:frameWebThickness ?frameQuantity .
                    ?frameQuantity qudt:numericValue ?frameThickness ;
                                   qudt:unit unit:MilliM .
                    FILTER (datatype(?frameThickness) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Connection bracket thickness must be at least the frame web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasConnectionBracket ?bracket ;
                      nltl:frameWebThickness ?frameQuantity .
                ?frameQuantity qudt:numericValue ?frameThickness ;
                               qudt:unit unit:MilliM .
                ?bracket nltl:bracketThickness ?bracketQuantity .
                ?bracketQuantity qudt:numericValue ?bracketThickness ;
                                 qudt:unit unit:MilliM .
                FILTER (
                    datatype(?frameThickness) = xsd:decimal &&
                    datatype(?bracketThickness) = xsd:decimal &&
                    ?bracketThickness < ?frameThickness
                )
            }
        """
    ] .

gen:ConnectionBracketShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasConnectionBracket ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM
            ]
        ] ;
        sh:message "A connection bracket must provide its thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The connection bracket edge must be stiffened against buckling."
    ] .
