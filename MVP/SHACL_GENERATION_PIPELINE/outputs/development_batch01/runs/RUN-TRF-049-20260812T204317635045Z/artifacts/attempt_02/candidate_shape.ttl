@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FrameAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:sparql [
        sh:message "A frame within the ice-strengthened area must have effective attachment confirmed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                OPTIONAL {
                    $this nltl:effectiveAttachmentConfirmed ?confirmed .
                }
                FILTER (
                    !BOUND(?confirmed) ||
                    DATATYPE(?confirmed) != xsd:boolean ||
                    ?confirmed != true
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A frame passing through a supporting structure must have both web-plate sides connected." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:passesThroughSupportingStructure true .
                OPTIONAL {
                    $this nltl:webPlateConnectionSideCount ?sideCount .
                }
                FILTER (
                    !BOUND(?sideCount) ||
                    DATATYPE(?sideCount) != xsd:integer ||
                    ?sideCount != 2
                )
            }
        """
    ] .

gen:LongitudinalFrameBracketShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:sparql [
        sh:message "A longitudinal frame within the ice-strengthened area and having a supporting web frame or bulkhead must have a connection bracket associated through its own frame attachment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                    ?bracket a nltl:connectionBracket .
                }
            }
        """
    ] .

gen:TransverseTerminatingBracketShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:sparql [
        sh:message "A connection bracket recorded for a terminating transverse frame must be associated through that frame's own attachment and typed as a connection bracket." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:terminatesAtDeckOrIceStringer true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    ?bracket a nltl:connectionBracket .
                }
            }
        """
    ] .

gen:InstalledConnectionBracketShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasConnectionBracket ;
    sh:class nltl:connectionBracket ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "An installed connection bracket must have its edge stiffened against buckling."
    ] ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM
            ]
        ] ;
        sh:message "An installed connection bracket must have a decimal thickness expressed in millimetres."
    ] ;
    sh:sparql [
        sh:message "Connection-bracket thickness must be at least the associated frame-web thickness, with both values expressed in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:bracketThickness ?bracketQuantity .
                ?bracketQuantity qudt:numericValue ?bracketThickness ;
                                 qudt:unit unit:MilliM .
                OPTIONAL {
                    ?frame nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket $this .
                    OPTIONAL {
                        ?frame nltl:frameWebThickness ?frameQuantity .
                        ?frameQuantity qudt:numericValue ?frameWebThickness ;
                                       qudt:unit unit:MilliM .
                        FILTER (DATATYPE(?frameWebThickness) = xsd:decimal)
                    }
                }
                FILTER (
                    !BOUND(?frame) ||
                    !BOUND(?frameWebThickness) ||
                    ?bracketThickness < ?frameWebThickness
                )
            }
        """
    ] .
