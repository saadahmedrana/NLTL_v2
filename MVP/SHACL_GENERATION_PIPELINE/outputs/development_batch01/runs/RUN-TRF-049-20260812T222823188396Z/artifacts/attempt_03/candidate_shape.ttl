@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:FrameAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:sparql [
        sh:message "A frame within the ice-strengthened area must have effective attachment confirmed." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true .
                FILTER NOT EXISTS {
                    $this nltl:effectiveAttachmentConfirmed true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each supporting web frame or bulkhead of an applicable longitudinal frame must share a bracketed attachment with that frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?support
            WHERE {
                $this a nltl:longitudinalFrame ;
                      nltl:withinIceStrengthenedArea true ;
                      (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable transverse frame terminating at a deck or ice stringer must have a connection bracket or similar attachment construction." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:transverseFrame ;
                      nltl:withinIceStrengthenedArea true ;
                      nltl:terminatesAtDeckOrIceStringer true .
                FILTER NOT EXISTS {
                    $this nltl:similarAttachmentConstructionPresent true .
                }
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A frame passing through a supporting structure must have its web plate connected on at least two sides." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:passesThroughSupportingStructure true .
                FILTER NOT EXISTS {
                    $this nltl:webPlateConnectionSideCount ?sideCount .
                    FILTER (
                        datatype(?sideCount) = xsd:integer &&
                        ?sideCount >= 2
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each bracket installed on an applicable frame must have its edge stiffened." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?bracket
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    ?bracket nltl:bracketEdgeStiffened true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each bracket installed on an applicable frame must be stiffened against buckling." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?bracket
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    ?bracket nltl:bucklingStiffening true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each bracket installed on an applicable frame must have a bracket thickness quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?bracket
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    ?bracket nltl:bracketThickness ?bracketQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable frame with an installed bracket must have a frame web thickness quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?bracket
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    $this nltl:frameWebThickness ?frameQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Bracket thickness must be a QUDT quantity with a decimal value in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this ?bracket ?bracketQuantity
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketQuantity .
                FILTER NOT EXISTS {
                    ?bracketQuantity a qudt:QuantityValue ;
                                     qudt:numericValue ?bracketValue ;
                                     qudt:unit unit:MilliM .
                    FILTER (datatype(?bracketValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Bracket thickness values must be decimal and use millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this ?bracket ?bracketQuantity
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketQuantity .
                ?bracketQuantity qudt:numericValue ?bracketValue ;
                                 qudt:unit ?bracketUnit .
                FILTER (
                    datatype(?bracketValue) != xsd:decimal ||
                    ?bracketUnit != unit:MilliM
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Frame web thickness must be a QUDT quantity with a decimal value in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this ?frameQuantity
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment ;
                      nltl:frameWebThickness ?frameQuantity .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    ?frameQuantity a qudt:QuantityValue ;
                                   qudt:numericValue ?frameValue ;
                                   qudt:unit unit:MilliM .
                    FILTER (datatype(?frameValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Frame web thickness values must be decimal and use millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this ?frameQuantity
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment ;
                      nltl:frameWebThickness ?frameQuantity .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?frameQuantity qudt:numericValue ?frameValue ;
                               qudt:unit ?frameUnit .
                FILTER (
                    datatype(?frameValue) != xsd:decimal ||
                    ?frameUnit != unit:MilliM
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Bracket thickness must be at least the frame web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this ?bracket
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      nltl:hasFrameAttachment ?attachment ;
                      nltl:frameWebThickness ?frameQuantity .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?bracket nltl:bracketThickness ?bracketQuantity .
                ?frameQuantity a qudt:QuantityValue ;
                               qudt:numericValue ?frameValue ;
                               qudt:unit unit:MilliM .
                ?bracketQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?bracketValue ;
                                 qudt:unit unit:MilliM .
                FILTER (
                    datatype(?frameValue) = xsd:decimal &&
                    datatype(?bracketValue) = xsd:decimal &&
                    ?bracketValue < ?frameValue
                )
            }
        """
    ] .
