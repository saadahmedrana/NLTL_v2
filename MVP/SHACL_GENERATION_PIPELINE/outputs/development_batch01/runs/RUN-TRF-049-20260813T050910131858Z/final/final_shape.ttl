@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:FrameApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must state whether it is within the ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node gen:InAreaFrameShape ;
            sh:node gen:FrameBracketRequirementsShape
        ]
    ) .

gen:LongitudinalFrameApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The longitudinal frame must state whether it is within the ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node gen:InAreaFrameShape ;
            sh:node gen:FrameBracketRequirementsShape ;
            sh:node gen:LongitudinalBracketAttachmentShape
        ]
    ) .

gen:TransverseFrameApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The transverse frame must state whether it is within the ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:node gen:InAreaFrameShape ;
            sh:node gen:FrameBracketRequirementsShape ;
            sh:node gen:TransverseTerminationShape
        ]
    ) .

gen:InAreaFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:minCount 1 ;
        sh:message "An in-area frame must have at least one frame attachment."
    ] ;
    sh:property [
        sh:path [
            sh:alternativePath (
                nltl:hasSupportingWebFrame
                nltl:hasSupportingBulkhead
            )
        ] ;
        sh:minCount 1 ;
        sh:message "An in-area frame must identify at least one supporting web frame or bulkhead."
    ] ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An in-area frame must state whether it passes through a supporting structure."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:webPlateConnectionSideCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue 2 ;
                sh:message "A frame passing through a supporting structure must have both web-plate sides connected."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Each identified supporting structure must share an effectively confirmed attachment with the frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:effectiveAttachmentConfirmed true .
                }
            }
        """
    ] .

gen:LongitudinalBracketAttachmentShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "A longitudinal frame must share a bracketed attachment with every identified supporting web frame and bulkhead." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] .

gen:TransverseTerminationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A transverse frame must state whether it terminates at a deck or ice stringer."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path (
                            nltl:hasFrameAttachment
                            nltl:hasConnectionBracket
                        ) ;
                        sh:minCount 1 ;
                        sh:message "A terminating transverse frame must have a bracket or similar attachment construction."
                    ]
                ]
                [
                    sh:property [
                        sh:path (
                            nltl:hasFrameAttachment
                            nltl:similarAttachmentConstructionPresent
                        ) ;
                        sh:hasValue true ;
                        sh:message "A terminating transverse frame must have a bracket or similar attachment construction."
                    ]
                ]
            )
        ]
    ) .

gen:FrameBracketRequirementsShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path (
                    nltl:hasFrameAttachment
                    nltl:hasConnectionBracket
                ) ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path (
                    nltl:hasFrameAttachment
                    nltl:hasConnectionBracket
                ) ;
                sh:minCount 1 ;
                sh:node gen:ConnectionBracketShape
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MillimetreQuantityShape ;
                sh:message "A frame with an installed bracket must have one frame-web thickness value in millimetres."
            ] ;
            sh:sparql [
                sh:message "Every installed bracket must be at least as thick as the frame web." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:frameWebThickness ?frameThickness .
                        ?frameThickness qudt:numericValue ?frameValue .
                        $this nltl:hasFrameAttachment ?attachment .
                        ?attachment nltl:hasConnectionBracket ?bracket .
                        ?bracket nltl:bracketThickness ?bracketThickness .
                        ?bracketThickness qudt:numericValue ?bracketValue .
                        FILTER (?bracketValue < ?frameValue)
                    }
                """
            ]
        ]
    ) .

gen:ConnectionBracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "An installed bracket must have one thickness value in millimetres."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The installed bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The installed bracket must be stiffened against buckling."
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .
