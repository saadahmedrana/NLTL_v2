@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FrameShellAttachmentShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:frameShellAttachment ;
    sh:property [
        sh:path nltl:frameShellWeldType ;
        sh:minCount 1 ;
        sh:hasValue nltl:doubleContinuousWeld ;
        sh:message "The frame-shell attachment shall use a double continuous weld."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shellPlateButtCrossing ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ]
        ]
        [
            sh:property [
                sh:path nltl:scallopingPresent ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false )
            ]
        ]
    ) ;
    sh:message "Scalloping shall not be present unless the attachment crosses a shell plate butt." .
