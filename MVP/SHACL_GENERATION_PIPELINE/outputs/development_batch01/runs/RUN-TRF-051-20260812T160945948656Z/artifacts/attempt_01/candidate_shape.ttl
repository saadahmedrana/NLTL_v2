@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:NonnegativeMillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:in ( unit:MilliM ) ;
        sh:minCount 1
    ] .

gen:NonnegativeMegapascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:in ( unit:MegaPA ) ;
        sh:minCount 1
    ] .

gen:TRF051FrameWebThicknessShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:frameWebThickness ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:node gen:NonnegativeMillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:adjacentFrameHeight ;
        sh:node gen:NonnegativeMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Adjacent frame height in millimetres is required for the web-thickness calculation."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:NonnegativeMegapascalQuantityShape ;
        sh:minCount 1 ;
        sh:message "Yield strength in megapascals is required for the web-thickness calculation."
    ] ;
    sh:property [
        sh:path nltl:netShellPlatingThickness ;
        sh:node gen:NonnegativeMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Net shell-plating thickness in millimetres is required for the web-thickness calculation."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:node gen:NonnegativeMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Corrosion and abrasion addition in millimetres is required for the web-thickness calculation."
    ] ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:profileSection
            nltl:flatBarSection
        ) ;
        sh:minCount 1 ;
        sh:message "Frame profile type must be profile section or flat bar section."
    ] ;
    sh:sparql [
        sh:message "Frame web thickness must be at least every applicable calculated minimum and 9 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameWebThickness ?webQuantity ;
                      nltl:adjacentFrameHeight ?heightQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:netShellPlatingThickness ?shellQuantity ;
                      nltl:corrosionAbrasionAddition ?additionQuantity ;
                      nltl:frameProfileType ?profileType .

                ?webQuantity qudt:numericValue ?web .
                ?heightQuantity qudt:numericValue ?height .
                ?yieldQuantity qudt:numericValue ?yield .
                ?shellQuantity qudt:numericValue ?shell .
                ?additionQuantity qudt:numericValue ?addition .

                BIND(
                    IF(?profileType = nltl:profileSection, 805, 282)
                    AS ?coefficient
                )

                FILTER(
                    ((?web * ?coefficient) * (?web * ?coefficient))
                        < ((?height * ?height) * ?yield)
                    ||
                    ?web < ((?shell - ?addition) / 2)
                    ||
                    ?web < 9
                )
            }
        """
    ] .
