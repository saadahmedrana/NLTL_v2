@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:ActualFrameWebThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:shipComponent ;
    sh:sparql [
        sh:message "Applicable frame thickness calculation inputs must be decimal quantities in the required units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:frameProfileType ?profile .
    FILTER (?profile IN (nltl:profileSection, nltl:flatBarSection))
    FILTER NOT EXISTS {
        $this nltl:inLieuOfFrame true .
    }
    FILTER (
        NOT EXISTS {
            $this nltl:frameWebThickness ?webQuantity .
            ?webQuantity qudt:numericValue ?webValue ;
                         qudt:unit unit:MilliM .
            FILTER (datatype(?webValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:adjacentFrameHeight ?heightQuantity .
            ?heightQuantity qudt:numericValue ?heightValue ;
                            qudt:unit unit:MilliM .
            FILTER (
                datatype(?heightValue) = xsd:decimal
                && ?heightValue > 0
            )
        }
        ||
        NOT EXISTS {
            $this nltl:yieldStrength ?yieldQuantity .
            ?yieldQuantity qudt:numericValue ?yieldValue ;
                           qudt:unit unit:MegaPA .
            FILTER (
                datatype(?yieldValue) = xsd:decimal
                && ?yieldValue >= 0
            )
        }
        ||
        NOT EXISTS {
            $this nltl:netShellPlatingThickness ?netQuantity .
            ?netQuantity qudt:numericValue ?netValue ;
                         qudt:unit unit:MilliM .
            FILTER (datatype(?netValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:corrosionAbrasionAddition ?corrosionQuantity .
            ?corrosionQuantity qudt:numericValue ?corrosionValue ;
                               qudt:unit unit:MilliM .
            FILTER (datatype(?corrosionValue) = xsd:decimal)
        }
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "Frame web thickness must satisfy the profile-dependent formula, half-net-plating, and 9 mm lower bounds." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:frameProfileType ?profile ;
          nltl:frameWebThickness ?webQuantity ;
          nltl:adjacentFrameHeight ?heightQuantity ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:netShellPlatingThickness ?netQuantity ;
          nltl:corrosionAbrasionAddition ?corrosionQuantity .

    FILTER (?profile IN (nltl:profileSection, nltl:flatBarSection))
    FILTER NOT EXISTS {
        $this nltl:inLieuOfFrame true .
    }

    ?webQuantity qudt:numericValue ?webValue ;
                 qudt:unit unit:MilliM .
    ?heightQuantity qudt:numericValue ?heightValue ;
                    qudt:unit unit:MilliM .
    ?yieldQuantity qudt:numericValue ?yieldValue ;
                   qudt:unit unit:MegaPA .
    ?netQuantity qudt:numericValue ?netValue ;
                 qudt:unit unit:MilliM .
    ?corrosionQuantity qudt:numericValue ?corrosionValue ;
                       qudt:unit unit:MilliM .

    FILTER (
        datatype(?webValue) = xsd:decimal
        && datatype(?heightValue) = xsd:decimal
        && datatype(?yieldValue) = xsd:decimal
        && datatype(?netValue) = xsd:decimal
        && datatype(?corrosionValue) = xsd:decimal
        && ?heightValue > 0
        && ?yieldValue >= 0
    )

    BIND(
        IF(
            ?profile = nltl:profileSection,
            805.0,
            282.0
        ) AS ?coefficient
    )

    FILTER (
        ?webValue < 9.0
        ||
        ?webValue < ((?netValue - ?corrosionValue) / 2.0)
        ||
        (?webValue * ?webValue * ?coefficient * ?coefficient)
            < (?heightValue * ?heightValue * ?yieldValue)
    )
}
""" ;
    ] .

gen:InLieuOfFramePlateThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:deckStructure ;
    sh:targetClass nltl:tankTop ;
    sh:targetClass nltl:bulkhead ;
    sh:sparql [
        sh:message "A structure used in lieu of a frame must provide decimal plate-thickness calculation inputs in the required units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:inLieuOfFrame true .
    FILTER (
        NOT EXISTS {
            $this nltl:thickness ?plateQuantity .
            ?plateQuantity qudt:numericValue ?plateValue ;
                           qudt:unit unit:MilliM .
            FILTER (datatype(?plateValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:adjacentFrameHeight ?heightQuantity .
            ?heightQuantity qudt:numericValue ?heightValue ;
                            qudt:unit unit:MilliM .
            FILTER (
                datatype(?heightValue) = xsd:decimal
                && ?heightValue > 0
            )
        }
        ||
        NOT EXISTS {
            $this nltl:yieldStrength ?yieldQuantity .
            ?yieldQuantity qudt:numericValue ?yieldValue ;
                           qudt:unit unit:MegaPA .
            FILTER (
                datatype(?yieldValue) = xsd:decimal
                && ?yieldValue >= 0
            )
        }
        ||
        NOT EXISTS {
            $this nltl:netShellPlatingThickness ?netQuantity .
            ?netQuantity qudt:numericValue ?netValue ;
                         qudt:unit unit:MilliM .
            FILTER (datatype(?netValue) = xsd:decimal)
        }
        ||
        NOT EXISTS {
            $this nltl:corrosionAbrasionAddition ?corrosionQuantity .
            ?corrosionQuantity qudt:numericValue ?corrosionValue ;
                               qudt:unit unit:MilliM .
            FILTER (datatype(?corrosionValue) = xsd:decimal)
        }
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "Plate thickness for a structure used in lieu of a frame must satisfy the C=805 formula, half-net-plating, and 9 mm lower bounds." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:inLieuOfFrame true ;
          nltl:thickness ?plateQuantity ;
          nltl:adjacentFrameHeight ?heightQuantity ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:netShellPlatingThickness ?netQuantity ;
          nltl:corrosionAbrasionAddition ?corrosionQuantity .

    ?plateQuantity qudt:numericValue ?plateValue ;
                   qudt:unit unit:MilliM .
    ?heightQuantity qudt:numericValue ?heightValue ;
                    qudt:unit unit:MilliM .
    ?yieldQuantity qudt:numericValue ?yieldValue ;
                   qudt:unit unit:MegaPA .
    ?netQuantity qudt:numericValue ?netValue ;
                 qudt:unit unit:MilliM .
    ?corrosionQuantity qudt:numericValue ?corrosionValue ;
                       qudt:unit unit:MilliM .

    FILTER (
        datatype(?plateValue) = xsd:decimal
        && datatype(?heightValue) = xsd:decimal
        && datatype(?yieldValue) = xsd:decimal
        && datatype(?netValue) = xsd:decimal
        && datatype(?corrosionValue) = xsd:decimal
        && ?heightValue > 0
        && ?yieldValue >= 0
    )

    FILTER (
        ?plateValue < 9.0
        ||
        ?plateValue < ((?netValue - ?corrosionValue) / 2.0)
        ||
        (?plateValue * ?plateValue * 805.0 * 805.0)
            < (?heightValue * ?heightValue * ?yieldValue)
    )
}
""" ;
    ] .
