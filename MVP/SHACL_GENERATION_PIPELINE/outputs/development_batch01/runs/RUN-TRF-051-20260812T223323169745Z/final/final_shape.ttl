@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:MilliM )
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:M )
    ] .

gen:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:MegaPA )
    ] .

gen:FrameWebOrInLieuPlateThicknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:hullStructure ;

    sh:property [
        sh:path nltl:adjacentFrameHeight ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "Adjacent frame height in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gen:MegapascalQuantityShape ;
        sh:message "Yield strength in megapascals is required."
    ] ;
    sh:property [
        sh:path nltl:netShellPlatingThickness ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "Net shell-plating thickness in millimetres is required."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "Corrosion and abrasion addition in millimetres is required."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:frameProfileType ;
                sh:minCount 1 ;
                sh:in ( nltl:profileSection )
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:inLieuOfFrame ;
                    sh:hasValue true
                ]
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:minCount 1 ;
                sh:node gen:MillimetreQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameProfileType ;
                sh:minCount 1 ;
                sh:in ( nltl:flatBarSection )
            ] ;
            sh:not [
                sh:property [
                    sh:path nltl:inLieuOfFrame ;
                    sh:hasValue true
                ]
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:minCount 1 ;
                sh:node gen:MillimetreQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:inLieuOfFrame ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankTop ]
                [ sh:class nltl:tankBottom ]
                [ sh:class nltl:bulkhead ]
            ) ;
            sh:property [
                sh:path nltl:thickness ;
                sh:minCount 1 ;
                sh:node gen:MetreQuantityShape
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "The frame web or in-lieu plate thickness is below one or more required lower bounds." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:adjacentFrameHeight ?heightQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:netShellPlatingThickness ?shellQuantity ;
                      nltl:corrosionAbrasionAddition ?additionQuantity ;
                      ?measuredProperty ?measuredQuantity .

                ?heightQuantity
                    qudt:numericValue ?height ;
                    qudt:unit unit:MilliM .
                ?yieldQuantity
                    qudt:numericValue ?yield ;
                    qudt:unit unit:MegaPA .
                ?shellQuantity
                    qudt:numericValue ?shellThickness ;
                    qudt:unit unit:MilliM .
                ?additionQuantity
                    qudt:numericValue ?addition ;
                    qudt:unit unit:MilliM .
                ?measuredQuantity qudt:numericValue ?measuredRaw .

                FILTER (
                    (
                        ?measuredProperty = nltl:frameWebThickness
                        && EXISTS {
                            $this nltl:frameProfileType nltl:profileSection .
                        }
                        && !EXISTS {
                            $this nltl:inLieuOfFrame true .
                        }
                        && EXISTS {
                            ?measuredQuantity qudt:unit unit:MilliM .
                        }
                    )
                    ||
                    (
                        ?measuredProperty = nltl:frameWebThickness
                        && EXISTS {
                            $this nltl:frameProfileType nltl:flatBarSection .
                        }
                        && !EXISTS {
                            $this nltl:inLieuOfFrame true .
                        }
                        && EXISTS {
                            ?measuredQuantity qudt:unit unit:MilliM .
                        }
                    )
                    ||
                    (
                        ?measuredProperty = nltl:thickness
                        && EXISTS {
                            $this nltl:inLieuOfFrame true .
                        }
                        && EXISTS {
                            $this a ?inLieuType .
                            FILTER (
                                ?inLieuType IN (
                                    nltl:deckStructure,
                                    nltl:tankTop,
                                    nltl:tankBottom,
                                    nltl:bulkhead
                                )
                            )
                        }
                        && EXISTS {
                            ?measuredQuantity qudt:unit unit:M .
                        }
                    )
                )

                BIND(
                    IF(
                        ?measuredProperty = nltl:thickness,
                        ?measuredRaw * 1000.0,
                        ?measuredRaw
                    )
                    AS ?measuredMillimetres
                )
                BIND(
                    IF(
                        ?measuredProperty = nltl:frameWebThickness
                        && EXISTS {
                            $this nltl:frameProfileType nltl:flatBarSection .
                        },
                        282.0,
                        805.0
                    )
                    AS ?coefficient
                )

                FILTER (
                    (
                        (?measuredMillimetres * ?coefficient)
                        * (?measuredMillimetres * ?coefficient)
                    )
                    <
                    (
                        (?height * ?height) * ?yield
                    )
                    ||
                    ?measuredMillimetres
                    <
                    ((?shellThickness - ?addition) / 2.0)
                    ||
                    ?measuredMillimetres < 9.0
                )
            }
        """
    ] .
