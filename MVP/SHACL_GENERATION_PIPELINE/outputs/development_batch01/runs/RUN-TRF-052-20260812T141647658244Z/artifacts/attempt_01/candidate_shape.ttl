@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:AntitrippingSupportShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable frame must have compliant antitripping support spacing and regional extent, or demonstrated equivalent support by direct calculation." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this ?frame
WHERE {
    $this nltl:hasComponent ?frame .

    {
        ?frame nltl:frameAsymmetrical ?asymmetrical .
        FILTER(
            DATATYPE(?asymmetrical) = xsd:boolean &&
            ?asymmetrical = true
        )
    }
    UNION
    {
        ?frame nltl:frameWebAngleToShell ?angleQuantity .
        ?angleQuantity
            qudt:numericValue ?angle ;
            qudt:unit unit:DEG .
        FILTER(
            DATATYPE(?angle) = xsd:decimal &&
            ?angle < 90
        )
    }

    FILTER NOT EXISTS {
        ?frame nltl:equivalentSupportStatusByDirectCalculation ?equivalent .
        FILTER(
            DATATYPE(?equivalent) = xsd:boolean &&
            ?equivalent = true
        )
    }

    FILTER NOT EXISTS {
        ?frame
            nltl:antitrippingSupportSpacing ?spacingQuantity ;
            nltl:frameSpan ?spanQuantity .

        ?spacingQuantity
            qudt:numericValue ?spacing ;
            qudt:unit unit:MilliM .

        ?spanQuantity
            qudt:numericValue ?span ;
            qudt:unit unit:M .

        FILTER(
            DATATYPE(?spacing) = xsd:decimal &&
            DATATYPE(?span) = xsd:decimal &&
            ?spacing <= 1300 &&
            (
                (
                    ?span > 4 &&
                    EXISTS {
                        ?frame nltl:hasAntitrippingSupportRegion
                            nltl:bowRegion,
                            nltl:midbodyRegion,
                            nltl:sternRegion .
                    }
                )
                ||
                (
                    ?span <= 4 &&
                    (
                        (
                            EXISTS {
                                $this nltl:iceClass nltl:iceClassIaSuper .
                            }
                            &&
                            EXISTS {
                                ?frame nltl:hasAntitrippingSupportRegion
                                    nltl:bowRegion,
                                    nltl:midbodyRegion,
                                    nltl:sternRegion .
                            }
                        )
                        ||
                        (
                            EXISTS {
                                $this nltl:iceClass nltl:iceClassIa .
                            }
                            &&
                            EXISTS {
                                ?frame nltl:hasAntitrippingSupportRegion
                                    nltl:bowRegion,
                                    nltl:midbodyRegion .
                            }
                        )
                        ||
                        (
                            EXISTS {
                                $this nltl:iceClass nltl:iceClassIb .
                            }
                            &&
                            EXISTS {
                                ?frame nltl:hasAntitrippingSupportRegion
                                    nltl:bowRegion .
                            }
                        )
                        ||
                        (
                            EXISTS {
                                $this nltl:iceClass nltl:iceClassIc .
                            }
                            &&
                            EXISTS {
                                ?frame nltl:hasAntitrippingSupportRegion
                                    nltl:bowRegion .
                            }
                        )
                        ||
                        EXISTS {
                            $this nltl:iceClass nltl:iceClassIi .
                        }
                        ||
                        EXISTS {
                            $this nltl:iceClass nltl:iceClassIii .
                        }
                    )
                )
            )
        )
    }
}
""" ;
    ] .
