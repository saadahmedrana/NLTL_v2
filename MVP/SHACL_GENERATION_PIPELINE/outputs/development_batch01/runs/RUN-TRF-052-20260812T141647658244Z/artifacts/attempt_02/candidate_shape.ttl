@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF052Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Frame asymmetry or web angle information is insufficient to determine applicability." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?frame
WHERE {
    $this nltl:hasComponent ?frame .
    ?frame ?frameProperty ?frameValue .
    VALUES ?frameProperty {
        nltl:frameAsymmetrical
        nltl:frameWebAngleToShell
        nltl:frameSpan
        nltl:antitrippingSupportSpacing
        nltl:hasAntitrippingSupportRegion
        nltl:equivalentSupportStatusByDirectCalculation
    }

    FILTER NOT EXISTS {
        ?frame nltl:equivalentSupportStatusByDirectCalculation ?equivalent .
        FILTER(
            DATATYPE(?equivalent) = xsd:boolean &&
            ?equivalent = true
        )
    }

    FILTER NOT EXISTS {
        {
            ?frame nltl:frameAsymmetrical ?asymmetrical .
            FILTER(
                DATATYPE(?asymmetrical) = xsd:boolean &&
                ?asymmetrical = true
            )
        }
        UNION
        {
            ?frame nltl:frameWebAngleToShell ?angleQuantity .
            ?angleQuantity
                qudt:numericValue ?angle ;
                qudt:unit unit:DEG .
            FILTER(
                DATATYPE(?angle) = xsd:decimal &&
                90 > ?angle
            )
        }
        UNION
        {
            ?frame
                nltl:frameAsymmetrical ?asymmetrical ;
                nltl:frameWebAngleToShell ?angleQuantity .
            ?angleQuantity
                qudt:numericValue ?angle ;
                qudt:unit unit:DEG .
            FILTER(
                DATATYPE(?asymmetrical) = xsd:boolean &&
                ?asymmetrical = false &&
                DATATYPE(?angle) = xsd:decimal &&
                ?angle >= 90
            )
        }
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable frame must have antitripping support spacing not exceeding 1300 mm or demonstrated equivalent support." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?frame
WHERE {
    $this nltl:hasComponent ?frame .

    {
        ?frame nltl:frameAsymmetrical ?asymmetrical .
        FILTER(
            DATATYPE(?asymmetrical) = xsd:boolean &&
            ?asymmetrical = true
        )
    }
    UNION
    {
        ?frame nltl:frameWebAngleToShell ?angleQuantity .
        ?angleQuantity
            qudt:numericValue ?angle ;
            qudt:unit unit:DEG .
        FILTER(
            DATATYPE(?angle) = xsd:decimal &&
            90 > ?angle
        )
    }

    FILTER NOT EXISTS {
        ?frame nltl:equivalentSupportStatusByDirectCalculation ?equivalent .
        FILTER(
            DATATYPE(?equivalent) = xsd:boolean &&
            ?equivalent = true
        )
    }

    FILTER NOT EXISTS {
        ?frame nltl:antitrippingSupportSpacing ?spacingQuantity .
        ?spacingQuantity
            qudt:numericValue ?spacing ;
            qudt:unit unit:MilliM .
        FILTER(
            DATATYPE(?spacing) = xsd:decimal &&
            1300 >= ?spacing
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Frame span, and ice class for a span not exceeding 4 m, are required to determine antitripping support scope." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?frame
WHERE {
    $this nltl:hasComponent ?frame .

    {
        ?frame nltl:frameAsymmetrical ?asymmetrical .
        FILTER(
            DATATYPE(?asymmetrical) = xsd:boolean &&
            ?asymmetrical = true
        )
    }
    UNION
    {
        ?frame nltl:frameWebAngleToShell ?angleQuantity .
        ?angleQuantity
            qudt:numericValue ?angle ;
            qudt:unit unit:DEG .
        FILTER(
            DATATYPE(?angle) = xsd:decimal &&
            90 > ?angle
        )
    }

    FILTER NOT EXISTS {
        ?frame nltl:equivalentSupportStatusByDirectCalculation ?equivalent .
        FILTER(
            DATATYPE(?equivalent) = xsd:boolean &&
            ?equivalent = true
        )
    }

    {
        FILTER NOT EXISTS {
            ?frame nltl:frameSpan ?spanQuantity .
            ?spanQuantity
                qudt:numericValue ?span ;
                qudt:unit unit:M .
            FILTER(DATATYPE(?span) = xsd:decimal)
        }
    }
    UNION
    {
        ?frame nltl:frameSpan ?spanQuantity .
        ?spanQuantity
            qudt:numericValue ?span ;
            qudt:unit unit:M .
        FILTER(
            DATATYPE(?span) = xsd:decimal &&
            4 >= ?span
        )
        FILTER NOT EXISTS {
            $this nltl:iceClass ?iceClass .
            VALUES ?iceClass {
                nltl:iceClassIaSuper
                nltl:iceClassIa
                nltl:iceClassIb
                nltl:iceClassIc
                nltl:iceClassIi
                nltl:iceClassIii
            }
        }
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The recorded antitripping support regions do not satisfy the scope required by frame span and ice class." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?frame
WHERE {
    $this nltl:hasComponent ?frame .

    {
        ?frame nltl:frameAsymmetrical ?asymmetrical .
        FILTER(
            DATATYPE(?asymmetrical) = xsd:boolean &&
            ?asymmetrical = true
        )
    }
    UNION
    {
        ?frame nltl:frameWebAngleToShell ?angleQuantity .
        ?angleQuantity
            qudt:numericValue ?angle ;
            qudt:unit unit:DEG .
        FILTER(
            DATATYPE(?angle) = xsd:decimal &&
            90 > ?angle
        )
    }

    FILTER NOT EXISTS {
        ?frame nltl:equivalentSupportStatusByDirectCalculation ?equivalent .
        FILTER(
            DATATYPE(?equivalent) = xsd:boolean &&
            ?equivalent = true
        )
    }

    ?frame nltl:frameSpan ?spanQuantity .
    ?spanQuantity
        qudt:numericValue ?span ;
        qudt:unit unit:M .
    FILTER(DATATYPE(?span) = xsd:decimal)

    {
        FILTER(?span > 4)
        FILTER NOT EXISTS {
            ?frame
                nltl:hasAntitrippingSupportRegion nltl:bowRegion ;
                nltl:hasAntitrippingSupportRegion nltl:midbodyRegion ;
                nltl:hasAntitrippingSupportRegion nltl:sternRegion .
        }
    }
    UNION
    {
        FILTER(4 >= ?span)
        $this nltl:iceClass nltl:iceClassIaSuper .
        FILTER NOT EXISTS {
            ?frame
                nltl:hasAntitrippingSupportRegion nltl:bowRegion ;
                nltl:hasAntitrippingSupportRegion nltl:midbodyRegion ;
                nltl:hasAntitrippingSupportRegion nltl:sternRegion .
        }
    }
    UNION
    {
        FILTER(4 >= ?span)
        $this nltl:iceClass nltl:iceClassIa .
        FILTER NOT EXISTS {
            ?frame
                nltl:hasAntitrippingSupportRegion nltl:bowRegion ;
                nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
        }
    }
    UNION
    {
        FILTER(4 >= ?span)
        $this nltl:iceClass ?iceClass .
        VALUES ?iceClass {
            nltl:iceClassIb
            nltl:iceClassIc
        }
        FILTER NOT EXISTS {
            ?frame nltl:hasAntitrippingSupportRegion nltl:bowRegion .
        }
    }
}
""" ;
    ] .
