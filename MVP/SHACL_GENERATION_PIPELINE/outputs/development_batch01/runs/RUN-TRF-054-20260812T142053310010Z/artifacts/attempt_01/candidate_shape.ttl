@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF054StringersOutsideIceBeltShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:sectionModulus ;
    sh:targetSubjectsOf nltl:requiredShearArea ;
    sh:sparql [
        sh:message "Required calculation quantities must have decimal values in the prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                VALUES (?property ?requiredUnit) {
                    (nltl:icePressure unit:MegaPA)
                    (nltl:designIceLoadHeight unit:M)
                    (nltl:designLineLoad unit:KiloN-PER-M)
                    (nltl:span unit:M)
                    (nltl:frameMomentFactorM unit:UNITLESS)
                    (nltl:yieldStrength unit:MegaPA)
                    (nltl:stringerOutsideIceBeltHeight unit:M)
                    (nltl:stringerSpan unit:M)
                    (nltl:outsideIceBeltFactor unit:UNITLESS)
                    (nltl:outsideIceBeltDistributionFactorF9 unit:UNITLESS)
                    (nltl:outsideIceBeltSafetyFactorF10 unit:UNITLESS)
                    (nltl:outsideIceBeltShearFactorF11 unit:UNITLESS)
                    (nltl:sectionModulus unit:CentiM3)
                    (nltl:requiredShearArea unit:CentiM2)
                }
                FILTER NOT EXISTS {
                    $this ?property ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit ?requiredUnit .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The design line load, outside-ice-belt factor, section modulus, or required shear area does not satisfy clause 4.5.2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:icePressure ?pQuantity ;
                          nltl:designIceLoadHeight ?hQuantity ;
                          nltl:designLineLoad ?lineQuantity ;
                          nltl:span ?spanQuantity ;
                          nltl:frameMomentFactorM ?mQuantity ;
                          nltl:yieldStrength ?yieldQuantity ;
                          nltl:stringerOutsideIceBeltHeight ?hsQuantity ;
                          nltl:stringerSpan ?lsQuantity ;
                          nltl:outsideIceBeltFactor ?outsideFactorQuantity ;
                          nltl:outsideIceBeltDistributionFactorF9 ?f9Quantity ;
                          nltl:outsideIceBeltSafetyFactorF10 ?f10Quantity ;
                          nltl:outsideIceBeltShearFactorF11 ?f11Quantity ;
                          nltl:sectionModulus ?zQuantity ;
                          nltl:requiredShearArea ?areaQuantity .

                    ?pQuantity qudt:numericValue ?p ;
                               qudt:unit unit:MegaPA .
                    ?hQuantity qudt:numericValue ?h ;
                               qudt:unit unit:M .
                    ?lineQuantity qudt:numericValue ?line ;
                                  qudt:unit unit:KiloN-PER-M .
                    ?spanQuantity qudt:numericValue ?span ;
                                  qudt:unit unit:M .
                    ?mQuantity qudt:numericValue ?m ;
                               qudt:unit unit:UNITLESS .
                    ?yieldQuantity qudt:numericValue ?yieldStrength ;
                                   qudt:unit unit:MegaPA .
                    ?hsQuantity qudt:numericValue ?hs ;
                                qudt:unit unit:M .
                    ?lsQuantity qudt:numericValue ?ls ;
                                qudt:unit unit:M .
                    ?outsideFactorQuantity qudt:numericValue ?outsideFactor ;
                                           qudt:unit unit:UNITLESS .
                    ?f9Quantity qudt:numericValue ?f9 ;
                                qudt:unit unit:UNITLESS .
                    ?f10Quantity qudt:numericValue ?f10 ;
                                 qudt:unit unit:UNITLESS .
                    ?f11Quantity qudt:numericValue ?f11 ;
                                 qudt:unit unit:UNITLESS .
                    ?zQuantity qudt:numericValue ?z ;
                               qudt:unit unit:CentiM3 .
                    ?areaQuantity qudt:numericValue ?area ;
                                  qudt:unit unit:CentiM2 .

                    FILTER(
                        datatype(?p) = xsd:decimal &&
                        datatype(?h) = xsd:decimal &&
                        datatype(?line) = xsd:decimal &&
                        datatype(?span) = xsd:decimal &&
                        datatype(?m) = xsd:decimal &&
                        datatype(?yieldStrength) = xsd:decimal &&
                        datatype(?hs) = xsd:decimal &&
                        datatype(?ls) = xsd:decimal &&
                        datatype(?outsideFactor) = xsd:decimal &&
                        datatype(?f9) = xsd:decimal &&
                        datatype(?f10) = xsd:decimal &&
                        datatype(?f11) = xsd:decimal &&
                        datatype(?z) = xsd:decimal &&
                        datatype(?area) = xsd:decimal
                    )

                    BIND(
                        IF(
                            (?p * ?h) < "0.15"^^xsd:decimal,
                            "150"^^xsd:decimal,
                            ?p * ?h * "1000"^^xsd:decimal
                        )
                        AS ?expectedLine
                    )
                    BIND(
                        "1"^^xsd:decimal - (?hs / ?ls)
                        AS ?expectedOutsideFactor
                    )
                    BIND(
                        ?f9 * ?f10 * (?line / "1000"^^xsd:decimal) *
                        ?span * ?span /
                        (?m * ?yieldStrength) *
                        ?outsideFactor * "1000000"^^xsd:decimal
                        AS ?expectedZ
                    )
                    BIND(
                        ?f9 * ?f10 * ?f11 *
                        (?line / "1000"^^xsd:decimal) * ?span /
                        ("2"^^xsd:decimal * ?yieldStrength) *
                        ?outsideFactor * "10000"^^xsd:decimal
                        AS ?areaWithoutRootThree
                    )
                    BIND(
                        "3"^^xsd:decimal *
                        ?areaWithoutRootThree * ?areaWithoutRootThree
                        AS ?expectedAreaSquared
                    )
                    BIND(
                        IF(
                            ABS(?expectedAreaSquared) > "1"^^xsd:decimal,
                            ABS(?expectedAreaSquared),
                            "1"^^xsd:decimal
                        )
                        AS ?areaScale
                    )

                    FILTER(
                        ?f9 = "0.80"^^xsd:decimal &&
                        ?f10 = "1.8"^^xsd:decimal &&
                        ?f11 = "1.2"^^xsd:decimal &&
                        ?line = ?expectedLine &&
                        ?outsideFactor = ?expectedOutsideFactor &&
                        ?z = ?expectedZ &&
                        ?area >= "0"^^xsd:decimal &&
                        ABS((?area * ?area) - ?expectedAreaSquared)
                            <= ("0.000001"^^xsd:decimal * ?areaScale)
                    )
                }
            }
        """
    ] .
