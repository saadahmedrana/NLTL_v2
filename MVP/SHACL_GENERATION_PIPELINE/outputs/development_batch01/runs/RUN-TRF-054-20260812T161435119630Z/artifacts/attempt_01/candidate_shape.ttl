@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:StringersOutsideIceBeltShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:sparql [
        sh:message "An ice stringer outside the ice belt that supports ice-strengthened frames must provide correctly unit-encoded inputs and satisfy the required section modulus and shear area formulae." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt true ;
                      nltl:supportsIceStrengthenedFrames true .
                FILTER NOT EXISTS {
                    $this nltl:icePressure ?pressureQuantity ;
                          nltl:designIceLoadHeight ?heightQuantity ;
                          nltl:designLineLoad ?lineLoadQuantity ;
                          nltl:span ?spanQuantity ;
                          nltl:frameMomentFactorM ?momentFactorQuantity ;
                          nltl:yieldStrength ?yieldStrengthQuantity ;
                          nltl:distanceToAdjacentIceStringer ?adjacentDistanceQuantity ;
                          nltl:distanceToIceBelt ?iceBeltDistanceQuantity ;
                          nltl:outsideIceBeltDistributionFactorF9 ?f9Quantity ;
                          nltl:outsideIceBeltSafetyFactorF10 ?f10Quantity ;
                          nltl:outsideIceBeltShearFactorF11 ?f11Quantity ;
                          nltl:outsideIceBeltFactor ?outsideFactorQuantity ;
                          nltl:sectionModulus ?sectionModulusQuantity ;
                          nltl:requiredShearArea ?shearAreaQuantity .

                    ?pressureQuantity
                        qudt:numericValue ?pressure ;
                        qudt:unit unit:MegaPA .
                    ?heightQuantity
                        qudt:numericValue ?height ;
                        qudt:unit unit:M .
                    ?lineLoadQuantity
                        qudt:numericValue ?lineLoad ;
                        qudt:unit unit:KiloN-PER-M .
                    ?spanQuantity
                        qudt:numericValue ?span ;
                        qudt:unit unit:M .
                    ?momentFactorQuantity
                        qudt:numericValue ?momentFactor ;
                        qudt:unit unit:UNITLESS .
                    ?yieldStrengthQuantity
                        qudt:numericValue ?yieldStrength ;
                        qudt:unit unit:MegaPA .
                    ?adjacentDistanceQuantity
                        qudt:numericValue ?adjacentDistance ;
                        qudt:unit unit:M .
                    ?iceBeltDistanceQuantity
                        qudt:numericValue ?iceBeltDistance ;
                        qudt:unit unit:M .
                    ?f9Quantity
                        qudt:numericValue ?f9 ;
                        qudt:unit unit:UNITLESS .
                    ?f10Quantity
                        qudt:numericValue ?f10 ;
                        qudt:unit unit:UNITLESS .
                    ?f11Quantity
                        qudt:numericValue ?f11 ;
                        qudt:unit unit:UNITLESS .
                    ?outsideFactorQuantity
                        qudt:numericValue ?outsideFactor ;
                        qudt:unit unit:UNITLESS .
                    ?sectionModulusQuantity
                        qudt:numericValue ?sectionModulus ;
                        qudt:unit unit:CentiM3 .
                    ?shearAreaQuantity
                        qudt:numericValue ?shearArea ;
                        qudt:unit unit:CentiM2 .

                    FILTER (
                        datatype(?pressure) = xsd:decimal &&
                        datatype(?height) = xsd:decimal &&
                        datatype(?lineLoad) = xsd:decimal &&
                        datatype(?span) = xsd:decimal &&
                        datatype(?momentFactor) = xsd:decimal &&
                        datatype(?yieldStrength) = xsd:decimal &&
                        datatype(?adjacentDistance) = xsd:decimal &&
                        datatype(?iceBeltDistance) = xsd:decimal &&
                        datatype(?f9) = xsd:decimal &&
                        datatype(?f10) = xsd:decimal &&
                        datatype(?f11) = xsd:decimal &&
                        datatype(?outsideFactor) = xsd:decimal &&
                        datatype(?sectionModulus) = xsd:decimal &&
                        datatype(?shearArea) = xsd:decimal
                    )

                    BIND(
                        IF(
                            (?pressure * ?height * 1000) < 150,
                            150,
                            (?pressure * ?height * 1000)
                        )
                        AS ?calculatedLineLoad
                    )
                    BIND(
                        (1 - (?iceBeltDistance / ?adjacentDistance))
                        AS ?calculatedOutsideFactor
                    )
                    BIND(
                        (
                            ?f9 * ?f10 * (?lineLoad / 1000) *
                            ?span * ?span /
                            (?momentFactor * ?yieldStrength) *
                            ?outsideFactor * 1000000
                        )
                        AS ?calculatedSectionModulus
                    )
                    BIND(
                        (
                            ?f9 * ?f10 * ?f11 * (?lineLoad / 1000) *
                            ?span /
                            (2 * ?yieldStrength) *
                            ?outsideFactor * 10000
                        )
                        AS ?shearAreaBase
                    )

                    FILTER (
                        ?f9 = 0.80 &&
                        ?f10 = 1.8 &&
                        ?f11 = 1.2 &&
                        ?lineLoad = ?calculatedLineLoad &&
                        ?outsideFactor = ?calculatedOutsideFactor &&
                        ?sectionModulus = ?calculatedSectionModulus &&
                        (?shearArea * ?shearArea) =
                            (3 * ?shearAreaBase * ?shearAreaBase) &&
                        (
                            (?shearArea = 0 && ?shearAreaBase = 0) ||
                            (?shearArea * ?shearAreaBase > 0)
                        )
                    )
                }
            }
        """
    ] .
