@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:StringerOutsideIceBeltShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:sparql [
        sh:message "Applicable stringers require decimal calculation inputs and results in the prescribed units, with nonzero divisors." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt true ;
                      nltl:supportsIceStrengthenedFrames true .
                FILTER (
                    NOT EXISTS {
                        $this nltl:icePressure ?pNode .
                        ?pNode qudt:numericValue ?p ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        FILTER (datatype(?p) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:designIceLoadHeight ?hNode .
                        ?hNode qudt:numericValue ?h ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?h) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:stringerSpan ?lNode .
                        ?lNode qudt:numericValue ?l ;
                               qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?l) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:frameMomentFactorM ?mNode .
                        ?mNode qudt:numericValue ?m ;
                               qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (datatype(?m) = xsd:decimal && ?m != 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldStrength ?yieldNode .
                        ?yieldNode qudt:numericValue ?yield ;
                                   qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                        FILTER (datatype(?yield) = xsd:decimal && ?yield != 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceToAdjacentIceStringer ?lsNode .
                        ?lsNode qudt:numericValue ?ls ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?ls) = xsd:decimal && ?ls != 0)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:distanceToIceBelt ?hsNode .
                        ?hsNode qudt:numericValue ?hs ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .
                        FILTER (datatype(?hs) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:sectionModulus ?zNode .
                        ?zNode qudt:numericValue ?z ;
                               qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                        FILTER (datatype(?z) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredShearArea ?areaNode .
                        ?areaNode qudt:numericValue ?area ;
                                  qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                        FILTER (datatype(?area) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Design line load must equal 1000 times the greater of ice pressure times design ice load height and 0.15, expressed in kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt true ;
                      nltl:supportsIceStrengthenedFrames true ;
                      nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:designLineLoad ?qNode .
                ?pNode qudt:numericValue ?p ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?qNode qudt:numericValue ?q ;
                       qudt:unit <http://qudt.org/vocab/unit/KiloN-PER-M> .
                FILTER (
                    datatype(?p) = xsd:decimal &&
                    datatype(?h) = xsd:decimal &&
                    datatype(?q) = xsd:decimal
                )
                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?lineLoadMNPerM)
                FILTER (?q != (1000 * ?lineLoadMNPerM))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Outside ice belt factor must equal 1 minus distance to ice belt divided by distance to the adjacent ice stringer." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt true ;
                      nltl:supportsIceStrengthenedFrames true ;
                      nltl:distanceToAdjacentIceStringer ?lsNode ;
                      nltl:distanceToIceBelt ?hsNode ;
                      nltl:outsideIceBeltFactor ?factorNode .
                ?lsNode qudt:numericValue ?ls ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                ?hsNode qudt:numericValue ?hs ;
                        qudt:unit <http://qudt.org/vocab/unit/M> .
                ?factorNode qudt:numericValue ?factor ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (
                    datatype(?ls) = xsd:decimal &&
                    datatype(?hs) = xsd:decimal &&
                    datatype(?factor) = xsd:decimal &&
                    ?ls != 0 &&
                    (?factor * ?ls) != (?ls - ?hs)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Section modulus must satisfy the prescribed stringer-outside-ice-belt formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt true ;
                      nltl:supportsIceStrengthenedFrames true ;
                      nltl:sectionModulus ?zNode .
                ?zNode qudt:numericValue ?z ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                FILTER (datatype(?z) = xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:icePressure ?pNode ;
                          nltl:designIceLoadHeight ?hNode ;
                          nltl:stringerSpan ?lNode ;
                          nltl:frameMomentFactorM ?mNode ;
                          nltl:yieldStrength ?yieldNode ;
                          nltl:distanceToAdjacentIceStringer ?lsNode ;
                          nltl:distanceToIceBelt ?hsNode .
                    ?pNode qudt:numericValue ?p ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    ?hNode qudt:numericValue ?h ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?lNode qudt:numericValue ?l ;
                           qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?mNode qudt:numericValue ?m ;
                           qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?yieldNode qudt:numericValue ?yield ;
                               qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    ?lsNode qudt:numericValue ?ls ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?hsNode qudt:numericValue ?hs ;
                            qudt:unit <http://qudt.org/vocab/unit/M> .
                    FILTER (
                        datatype(?p) = xsd:decimal &&
                        datatype(?h) = xsd:decimal &&
                        datatype(?l) = xsd:decimal &&
                        datatype(?m) = xsd:decimal &&
                        datatype(?yield) = xsd:decimal &&
                        datatype(?ls) = xsd:decimal &&
                        datatype(?hs) = xsd:decimal &&
                        ?m != 0 &&
                        ?yield != 0 &&
                        ?ls != 0
                    )
                    BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?lineLoadMNPerM)
                    BIND((1 - (?hs / ?ls)) AS ?outsideFactor)
                    BIND(
                        (
                            0.80 * 1.8 * ?lineLoadMNPerM *
                            ?l * ?l * ?outsideFactor * 1000000
                        ) / (?m * ?yield)
                        AS ?calculatedZ
                    )
                    FILTER (?z = ?calculatedZ)
                }
            }
        """
    ] .
