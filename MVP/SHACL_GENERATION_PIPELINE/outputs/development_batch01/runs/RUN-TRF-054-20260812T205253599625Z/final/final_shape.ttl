@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:StringerOutsideIceBeltShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:locatedOutsideIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean locatedOutsideIceBelt value is required."
    ] ;
    sh:property [
        sh:path nltl:supportsIceStrengthenedFrames ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean supportsIceStrengthenedFrames value is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue true
            ] ;
            sh:node gen:ApplicableStringerCalculationShape
        ]
    ) .

gen:ApplicableStringerCalculationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:KiloNewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:distanceToAdjacentIceStringer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveUnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltDistributionFactorF9 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:FactorF9QuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltSafetyFactorF10 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:FactorF10QuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltShearFactorF11 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:FactorF11QuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "The design line load, outside-ice-belt factor, section modulus, or required shear area is inconsistent with clause 4.5.2; derived values use relative tolerance 1e-6 with absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:designLineLoad/qudt:numericValue ?designLineLoadKiloNewtonPerMetre ;
                      nltl:distanceToAdjacentIceStringer/qudt:numericValue ?ls ;
                      nltl:distanceToIceBelt/qudt:numericValue ?hs ;
                      nltl:stringerSpan/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?sigmaY ;
                      nltl:outsideIceBeltDistributionFactorF9/qudt:numericValue ?f9 ;
                      nltl:outsideIceBeltSafetyFactorF10/qudt:numericValue ?f10 ;
                      nltl:outsideIceBeltShearFactorF11/qudt:numericValue ?f11 ;
                      nltl:outsideIceBeltFactor/qudt:numericValue ?outsideFactor ;
                      nltl:sectionModulus/qudt:numericValue ?sectionModulus ;
                      nltl:requiredShearArea/qudt:numericValue ?shearArea .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?designLineLoadMegaNewtonPerMetreExpected)
                BIND((?designLineLoadMegaNewtonPerMetreExpected * 1000) AS ?designLineLoadKiloNewtonPerMetreExpected)
                BIND((1 - (?hs / ?ls)) AS ?outsideFactorExpected)
                BIND(
                    (?f9 * ?f10 * ?designLineLoadMegaNewtonPerMetreExpected *
                     ?l * ?l * ?outsideFactorExpected * 1000000) /
                    (?m * ?sigmaY)
                    AS ?sectionModulusExpected
                )
                BIND(
                    (1.7320508075688772 * ?f9 * ?f10 * ?f11 *
                     ?designLineLoadMegaNewtonPerMetreExpected * ?l *
                     ?outsideFactorExpected * 10000) /
                    (2 * ?sigmaY)
                    AS ?shearAreaExpected
                )

                FILTER(
                    ABS(?designLineLoadKiloNewtonPerMetre - ?designLineLoadKiloNewtonPerMetreExpected) >
                        IF(
                            ABS(?designLineLoadKiloNewtonPerMetreExpected) * 0.000001 > 0.000000001,
                            ABS(?designLineLoadKiloNewtonPerMetreExpected) * 0.000001,
                            0.000000001
                        )
                    ||
                    ABS(?outsideFactor - ?outsideFactorExpected) >
                        IF(
                            ABS(?outsideFactorExpected) * 0.000001 > 0.000000001,
                            ABS(?outsideFactorExpected) * 0.000001,
                            0.000000001
                        )
                    ||
                    ABS(?sectionModulus - ?sectionModulusExpected) >
                        IF(
                            ABS(?sectionModulusExpected) * 0.000001 > 0.000000001,
                            ABS(?sectionModulusExpected) * 0.000001,
                            0.000000001
                        )
                    ||
                    ABS(?shearArea - ?shearAreaExpected) >
                        IF(
                            ABS(?shearAreaExpected) * 0.000001 > 0.000000001,
                            ABS(?shearAreaExpected) * 0.000001,
                            0.000000001
                        )
                )
            }
        """
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:PositiveMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gen:PositiveMegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gen:KiloNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN-PER-M
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:PositiveUnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:FactorF9QuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "0.80"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:FactorF10QuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "1.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:FactorF11QuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "1.2"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:CentiM3
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:CentiM2
    ] .
