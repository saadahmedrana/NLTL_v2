@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "A narrow deck strip serving as an ice stringer requires a section modulus value in cubic centimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:servesAsIceStringer true .
                FILTER NOT EXISTS {
                    $this nltl:sectionModulus ?quantity .
                    ?quantity qudt:numericValue ?numeric ;
                              qudt:unit unit:CentiM3 .
                    FILTER (datatype(?numeric) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A narrow deck strip serving as an ice stringer requires a shear-area requirement value in square centimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:servesAsIceStringer true .
                FILTER NOT EXISTS {
                    $this nltl:requiredShearArea ?quantity .
                    ?quantity qudt:numericValue ?numeric ;
                              qudt:unit unit:CentiM2 .
                    FILTER (datatype(?numeric) = xsd:decimal)
                }
            }
        """
    ] .
