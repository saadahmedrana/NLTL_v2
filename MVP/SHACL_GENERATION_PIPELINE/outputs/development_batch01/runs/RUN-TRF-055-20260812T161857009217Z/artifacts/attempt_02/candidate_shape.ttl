@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF055PartialShearAreaShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "The actual shear area must not be less than the required shear area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:narrowDeckStrip ;
                    nltl:servesAsIceStringer true ;
                    nltl:shearArea ?actualQuantity ;
                    nltl:requiredShearArea ?requiredQuantity .
                ?actualQuantity
                    qudt:numericValue ?actualValue ;
                    qudt:unit unit:M2 .
                ?requiredQuantity
                    qudt:numericValue ?requiredValue ;
                    qudt:unit unit:CentiM2 .
                FILTER (
                    xsd:decimal(?actualValue) * 10000
                    < xsd:decimal(?requiredValue)
                )
            }
        """
    ] .
