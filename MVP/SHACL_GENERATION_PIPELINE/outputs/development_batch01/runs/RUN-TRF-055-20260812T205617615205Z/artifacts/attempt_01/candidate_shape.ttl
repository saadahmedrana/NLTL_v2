@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:NarrowDeckStripComplianceShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:sparql [
        sh:message "Applicable narrow deck strips require decimal section-modulus and shear-area values in the prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true .
                FILTER (
                    !EXISTS {
                        $this nltl:actualSectionModulus ?actualZ .
                        ?actualZ qudt:numericValue ?actualZValue ;
                                 qudt:unit unit:CentiM3 .
                        FILTER (datatype(?actualZValue) = xsd:decimal)
                    }
                    ||
                    !EXISTS {
                        $this nltl:requiredSectionModulus ?requiredZ .
                        ?requiredZ qudt:numericValue ?requiredZValue ;
                                   qudt:unit unit:CentiM3 .
                        FILTER (datatype(?requiredZValue) = xsd:decimal)
                    }
                    ||
                    !EXISTS {
                        $this nltl:actualShearArea ?actualA .
                        ?actualA qudt:numericValue ?actualAValue ;
                                 qudt:unit unit:CentiM2 .
                        FILTER (datatype(?actualAValue) = xsd:decimal)
                    }
                    ||
                    !EXISTS {
                        $this nltl:requiredShearArea ?requiredA .
                        ?requiredA qudt:numericValue ?requiredAValue ;
                                   qudt:unit unit:CentiM2 .
                        FILTER (datatype(?requiredAValue) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The actual section modulus and shear area must not be less than their respective required values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:actualSectionModulus ?actualZ ;
                      nltl:requiredSectionModulus ?requiredZ ;
                      nltl:actualShearArea ?actualA ;
                      nltl:requiredShearArea ?requiredA .
                ?actualZ qudt:numericValue ?actualZValue ;
                         qudt:unit unit:CentiM3 .
                ?requiredZ qudt:numericValue ?requiredZValue ;
                           qudt:unit unit:CentiM3 .
                ?actualA qudt:numericValue ?actualAValue ;
                         qudt:unit unit:CentiM2 .
                ?requiredA qudt:numericValue ?requiredAValue ;
                           qudt:unit unit:CentiM2 .
                FILTER (
                    datatype(?actualZValue) = xsd:decimal &&
                    datatype(?requiredZValue) = xsd:decimal &&
                    datatype(?actualAValue) = xsd:decimal &&
                    datatype(?requiredAValue) = xsd:decimal &&
                    (
                        ?actualZValue < ?requiredZValue ||
                        ?actualAValue < ?requiredAValue
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A recorded permitted reduced line load must be a decimal value in kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:permittedReducedLineLoad ?reducedLoad .
                FILTER (
                    !EXISTS {
                        ?reducedLoad qudt:numericValue ?reducedValue ;
                                     qudt:unit unit:KiloN-PER-M .
                        FILTER (datatype(?reducedValue) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A permitted reduced line load must be at least 100 kN/m and less than 150 kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:permittedReducedLineLoad ?reducedLoad .
                ?reducedLoad qudt:numericValue ?reducedValue ;
                             qudt:unit unit:KiloN-PER-M .
                FILTER (
                    datatype(?reducedValue) = xsd:decimal &&
                    (
                        ?reducedValue < 100.0 ||
                        ?reducedValue >= 150.0
                    )
                )
            }
        """
    ] .
