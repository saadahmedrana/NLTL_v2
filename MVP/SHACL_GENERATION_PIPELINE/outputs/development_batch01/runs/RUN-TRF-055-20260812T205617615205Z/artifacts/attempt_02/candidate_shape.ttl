@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:CentiM3 )
    ] .

gen:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:CentiM2 )
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:M )
    ] .

gen:PermittedReducedLineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 100.0 ;
        sh:maxExclusive 150.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:KiloN-PER-M )
    ] .

gen:NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:or (
        [
            sh:not [
                sh:and (
                    [
                        sh:property [
                            sh:path nltl:abreastOfHatch ;
                            sh:hasValue true
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:servesAsIceStringer ;
                            sh:hasValue true
                        ]
                    ]
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:actualSectionModulus ;
                sh:minCount 1 ;
                sh:node gen:SectionModulusQuantityShape
            ] ;
            sh:property [
                sh:path nltl:requiredSectionModulus ;
                sh:minCount 1 ;
                sh:node gen:SectionModulusQuantityShape
            ] ;
            sh:property [
                sh:path nltl:actualShearArea ;
                sh:minCount 1 ;
                sh:node gen:ShearAreaQuantityShape
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:minCount 1 ;
                sh:node gen:ShearAreaQuantityShape
            ]
        ]
    ) ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:permittedReducedLineLoad ;
                    sh:minCount 1
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:permittedReducedLineLoad ;
                sh:minCount 1 ;
                sh:node gen:PermittedReducedLineLoadQuantityShape
            ] ;
            sh:property [
                sh:path nltl:hatchOpeningLength ;
                sh:minCount 1 ;
                sh:node gen:LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:shipBreadth ;
                sh:minCount 1 ;
                sh:node gen:LengthQuantityShape
            ] ;
            sh:property [
                sh:path nltl:scantlingApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Actual section modulus and shear area must meet their required values; a permitted reduced line load may be used only when hatch opening length exceeds ship breadth." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                OPTIONAL {
                    $this nltl:actualSectionModulus/qudt:numericValue ?actualSection .
                    $this nltl:requiredSectionModulus/qudt:numericValue ?requiredSection .
                }
                OPTIONAL {
                    $this nltl:actualShearArea/qudt:numericValue ?actualShear .
                    $this nltl:requiredShearArea/qudt:numericValue ?requiredShear .
                }
                OPTIONAL {
                    $this nltl:permittedReducedLineLoad ?reducedLoad .
                    $this nltl:hatchOpeningLength/qudt:numericValue ?hatchLength .
                    $this nltl:shipBreadth/qudt:numericValue ?breadth .
                }
                FILTER (
                    (
                        EXISTS {
                            $this nltl:abreastOfHatch true ;
                                  nltl:servesAsIceStringer true .
                        }
                        &&
                        (
                            (BOUND(?actualSection) && BOUND(?requiredSection)
                             && ?actualSection < ?requiredSection)
                            ||
                            (BOUND(?actualShear) && BOUND(?requiredShear)
                             && ?actualShear < ?requiredShear)
                        )
                    )
                    ||
                    (
                        BOUND(?reducedLoad)
                        && BOUND(?hatchLength)
                        && BOUND(?breadth)
                        && ?hatchLength <= ?breadth
                    )
                )
            }
        """
    ] .
