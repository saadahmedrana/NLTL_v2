@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:in ( unit:CentiM3 )
    ] .

gen:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:in ( unit:CentiM2 )
    ] .

gen:ReducedLineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 100.0 ;
        sh:maxExclusive 150.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:in ( unit:KiloN-PER-M )
    ] .

gen:NarrowDeckStripStrengthShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this a nltl:narrowDeckStrip ;
                      nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:message "Actual section modulus is required in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:message "Required section modulus is required in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:node gen:ShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:message "Actual shear area is required in square centimetres."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:ShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:message "Required shear area is required in square centimetres."
    ] ;
    sh:sparql [
        sh:message "Actual section modulus and shear area must not be less than their respective required values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualSectionNode ;
                      nltl:requiredSectionModulus ?requiredSectionNode ;
                      nltl:actualShearArea ?actualAreaNode ;
                      nltl:requiredShearArea ?requiredAreaNode .
                ?actualSectionNode qudt:numericValue ?actualSection .
                ?requiredSectionNode qudt:numericValue ?requiredSection .
                ?actualAreaNode qudt:numericValue ?actualArea .
                ?requiredAreaNode qudt:numericValue ?requiredArea .
                FILTER (
                    ?actualSection < ?requiredSection ||
                    ?actualArea < ?requiredArea
                )
            }
        """
    ] .

gen:VeryLongHatchReducedLineLoadShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this a nltl:narrowDeckStrip ;
                      nltl:abreastOfHatch true ;
                      nltl:servesAsIceStringer true ;
                      nltl:permittedReducedLineLoad ?reducedLoad .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "A reduced line load is permitted only for a very long hatch opening."
    ] ;
    sh:property [
        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The reduced line load must be approved by the classification society."
    ] ;
    sh:property [
        sh:path nltl:permittedReducedLineLoad ;
        sh:node gen:ReducedLineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:message "The permitted reduced line load must be at least 100 and less than 150 kN/m."
    ] .
