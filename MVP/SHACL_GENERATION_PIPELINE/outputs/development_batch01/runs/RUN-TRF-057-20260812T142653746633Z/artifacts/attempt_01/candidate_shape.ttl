@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:WebFrameIceLoadShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:iceLoadSourceType ;
    sh:sparql [
        sh:message "An applicable web-frame load calculation requires ice pressure expressed in MPa as an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER NOT EXISTS {
                    $this nltl:icePressure ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:MegaPA .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable web-frame load calculation requires ice load height expressed in metres as an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER NOT EXISTS {
                    $this nltl:iceLoadHeight ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable web-frame load calculation requires web-frame spacing expressed in metres as an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER NOT EXISTS {
                    $this nltl:webFrameSpacing ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:M .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The web-frame safety factor must be 1.8 and expressed as a unitless xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER NOT EXISTS {
                    $this nltl:webFrameSafetyFactor ?quantity .
                    ?quantity qudt:numericValue "1.8"^^xsd:decimal ;
                              qudt:unit unit:UNITLESS .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable web-frame load calculation requires the web-frame ice load expressed in kN as an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER NOT EXISTS {
                    $this nltl:webFrameIceLoad ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:KiloN .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Web-frame ice load must equal f_12 times the greater of p*h and 0.15 MN/m, times web-frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }

                FILTER EXISTS {
                    $this nltl:icePressure ?pressureQuantity ;
                          nltl:iceLoadHeight ?heightQuantity ;
                          nltl:webFrameSpacing ?spacingQuantity ;
                          nltl:webFrameSafetyFactor ?factorQuantity ;
                          nltl:webFrameIceLoad ?loadQuantity .

                    ?pressureQuantity qudt:numericValue ?pressure ;
                                      qudt:unit unit:MegaPA .
                    ?heightQuantity qudt:numericValue ?height ;
                                    qudt:unit unit:M .
                    ?spacingQuantity qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                    ?factorQuantity qudt:numericValue "1.8"^^xsd:decimal ;
                                    qudt:unit unit:UNITLESS .
                    ?loadQuantity qudt:numericValue ?load ;
                                  qudt:unit unit:KiloN .

                    FILTER(datatype(?pressure) = xsd:decimal)
                    FILTER(datatype(?height) = xsd:decimal)
                    FILTER(datatype(?spacing) = xsd:decimal)
                    FILTER(datatype(?load) = xsd:decimal)
                }

                FILTER NOT EXISTS {
                    $this nltl:icePressure ?pressureQuantity ;
                          nltl:iceLoadHeight ?heightQuantity ;
                          nltl:webFrameSpacing ?spacingQuantity ;
                          nltl:webFrameSafetyFactor ?factorQuantity ;
                          nltl:webFrameIceLoad ?loadQuantity .

                    ?pressureQuantity qudt:numericValue ?pressure ;
                                      qudt:unit unit:MegaPA .
                    ?heightQuantity qudt:numericValue ?height ;
                                    qudt:unit unit:M .
                    ?spacingQuantity qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                    ?factorQuantity qudt:numericValue ?factor ;
                                    qudt:unit unit:UNITLESS .
                    ?loadQuantity qudt:numericValue ?load ;
                                  qudt:unit unit:KiloN .

                    FILTER(datatype(?pressure) = xsd:decimal)
                    FILTER(datatype(?height) = xsd:decimal)
                    FILTER(datatype(?spacing) = xsd:decimal)
                    FILTER(datatype(?factor) = xsd:decimal)
                    FILTER(datatype(?load) = xsd:decimal)
                    FILTER(?factor = "1.8"^^xsd:decimal)

                    BIND(?pressure * ?height AS ?pressureHeight)
                    BIND(
                        IF(
                            ?pressureHeight < "0.15"^^xsd:decimal,
                            "0.15"^^xsd:decimal,
                            ?pressureHeight
                        ) AS ?effectiveLineLoad
                    )
                    BIND(
                        "1000"^^xsd:decimal * ?factor * ?effectiveLineLoad * ?spacing
                        AS ?requiredLoad
                    )
                    FILTER(?load = ?requiredLoad)
                }
            }
        """
    ] .
