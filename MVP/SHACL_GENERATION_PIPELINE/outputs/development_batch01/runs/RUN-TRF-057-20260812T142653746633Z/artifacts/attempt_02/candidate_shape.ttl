@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:WebFrameIceLoadShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable web-frame ice-load calculation requires decimal pressure, height, spacing, minimum line load, safety factor, and resulting load quantities in their prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER (
                    NOT EXISTS {
                        ?component nltl:icePressure ?pressureQuantity .
                        ?pressureQuantity qudt:numericValue ?pressure ;
                                          qudt:unit unit:MegaPA .
                        FILTER(datatype(?pressure) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:iceLoadHeight ?heightQuantity .
                        ?heightQuantity qudt:numericValue ?height ;
                                        qudt:unit unit:M .
                        FILTER(datatype(?height) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameSpacing ?spacingQuantity .
                        ?spacingQuantity qudt:numericValue ?spacing ;
                                         qudt:unit unit:M .
                        FILTER(datatype(?spacing) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:minimumLineLoad ?minimumQuantity .
                        ?minimumQuantity qudt:numericValue ?minimum ;
                                         qudt:unit unit:KiloN-PER-M .
                        FILTER(datatype(?minimum) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameSafetyFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factor ;
                                        qudt:unit unit:UNITLESS .
                        FILTER(datatype(?factor) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameIceLoad ?loadQuantity .
                        ?loadQuantity qudt:numericValue ?load ;
                                      qudt:unit unit:KiloN .
                        FILTER(datatype(?load) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The web-frame safety factor must equal 1.8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:webFrameSafetyFactor ?factorQuantity .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit unit:UNITLESS .
                FILTER(
                    datatype(?factor) = xsd:decimal &&
                    ?factor != "1.8"^^xsd:decimal
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The minimum line load must equal 150 kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:minimumLineLoad ?minimumQuantity .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?minimumQuantity qudt:numericValue ?minimum ;
                                 qudt:unit unit:KiloN-PER-M .
                FILTER(
                    datatype(?minimum) = xsd:decimal &&
                    ?minimum != "150"^^xsd:decimal
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The web-frame ice load must equal the safety factor multiplied by the greater of p*h and 150 kN/m, multiplied by the web-frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:icePressure ?pressureQuantity ;
                           nltl:iceLoadHeight ?heightQuantity ;
                           nltl:webFrameSpacing ?spacingQuantity ;
                           nltl:minimumLineLoad ?minimumQuantity ;
                           nltl:webFrameSafetyFactor ?factorQuantity ;
                           nltl:webFrameIceLoad ?loadQuantity .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?pressureQuantity qudt:numericValue ?pressure ;
                                  qudt:unit unit:MegaPA .
                ?heightQuantity qudt:numericValue ?height ;
                                qudt:unit unit:M .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?minimumQuantity qudt:numericValue ?minimum ;
                                 qudt:unit unit:KiloN-PER-M .
                ?factorQuantity qudt:numericValue ?factor ;
                                qudt:unit unit:UNITLESS .
                ?loadQuantity qudt:numericValue ?load ;
                              qudt:unit unit:KiloN .
                FILTER(
                    datatype(?pressure) = xsd:decimal &&
                    datatype(?height) = xsd:decimal &&
                    datatype(?spacing) = xsd:decimal &&
                    datatype(?minimum) = xsd:decimal &&
                    datatype(?factor) = xsd:decimal &&
                    datatype(?load) = xsd:decimal
                )
                BIND((?pressure * ?height * "1000"^^xsd:decimal) AS ?calculatedLineLoad)
                BIND(
                    IF(
                        ?calculatedLineLoad < ?minimum,
                        ?minimum,
                        ?calculatedLineLoad
                    ) AS ?governingLineLoad
                )
                BIND((?factor * ?governingLineLoad * ?spacing) AS ?requiredLoad)
                FILTER(?load != ?requiredLoad)
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable calculation requires decimal load-length and web-frame-spacing quantities in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER (
                    NOT EXISTS {
                        ?component nltl:loadLengthParameter ?lengthQuantity .
                        ?lengthQuantity qudt:numericValue ?length ;
                                        qudt:unit unit:M .
                        FILTER(datatype(?length) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameSpacing ?spacingQuantity .
                        ?spacingQuantity qudt:numericValue ?spacing ;
                                         qudt:unit unit:M .
                        FILTER(datatype(?spacing) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The load length parameter must equal twice the web-frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:loadLengthParameter ?lengthQuantity ;
                           nltl:webFrameSpacing ?spacingQuantity .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?lengthQuantity qudt:numericValue ?length ;
                                qudt:unit unit:M .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                FILTER(
                    datatype(?length) = xsd:decimal &&
                    datatype(?spacing) = xsd:decimal &&
                    ?length != ("2"^^xsd:decimal * ?spacing)
                )
            }
        """
    ] .
