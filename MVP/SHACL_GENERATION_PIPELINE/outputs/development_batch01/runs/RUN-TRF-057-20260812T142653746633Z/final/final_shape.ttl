@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:WebFrameIceLoadShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable web-frame ice-load calculation requires decimal quantities in the prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER (
                    NOT EXISTS {
                        ?component nltl:icePressure ?pressureNode .
                        ?pressureNode qudt:numericValue ?pressure ;
                                      qudt:unit unit:MegaPA .
                        FILTER(datatype(?pressure) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:iceLoadHeight ?heightNode .
                        ?heightNode qudt:numericValue ?height ;
                                    qudt:unit unit:M .
                        FILTER(datatype(?height) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameSpacing ?spacingNode .
                        ?spacingNode qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                        FILTER(datatype(?spacing) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameSafetyFactor ?factorNode .
                        ?factorNode qudt:numericValue ?factor ;
                                    qudt:unit unit:UNITLESS .
                        FILTER(datatype(?factor) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:minimumLineLoad ?minimumNode .
                        ?minimumNode qudt:numericValue ?minimum ;
                                     qudt:unit unit:KiloN-PER-M .
                        FILTER(datatype(?minimum) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameIceLoad ?loadNode .
                        ?loadNode qudt:numericValue ?load ;
                                  qudt:unit unit:KiloN .
                        FILTER(datatype(?load) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The web-frame safety factor must be 1.8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:webFrameSafetyFactor ?factorNode .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?factorNode qudt:numericValue ?factor ;
                            qudt:unit unit:UNITLESS .
                FILTER(
                    datatype(?factor) = xsd:decimal
                    && ?factor != "1.8"^^xsd:decimal
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The minimum line load must be 150 kN/m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:minimumLineLoad ?minimumNode .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?minimumNode qudt:numericValue ?minimum ;
                             qudt:unit unit:KiloN-PER-M .
                FILTER(
                    datatype(?minimum) = xsd:decimal
                    && ?minimum != "150"^^xsd:decimal
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The web-frame ice load must equal 1.8 times the greater of p*h and 150 kN/m, multiplied by the web-frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:icePressure ?pressureNode ;
                           nltl:iceLoadHeight ?heightNode ;
                           nltl:webFrameSpacing ?spacingNode ;
                           nltl:webFrameSafetyFactor ?factorNode ;
                           nltl:minimumLineLoad ?minimumNode ;
                           nltl:webFrameIceLoad ?loadNode .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?pressureNode qudt:numericValue ?pressure ;
                              qudt:unit unit:MegaPA .
                ?heightNode qudt:numericValue ?height ;
                            qudt:unit unit:M .
                ?spacingNode qudt:numericValue ?spacing ;
                             qudt:unit unit:M .
                ?factorNode qudt:numericValue ?factor ;
                            qudt:unit unit:UNITLESS .
                ?minimumNode qudt:numericValue ?minimum ;
                             qudt:unit unit:KiloN-PER-M .
                ?loadNode qudt:numericValue ?load ;
                          qudt:unit unit:KiloN .
                FILTER(
                    datatype(?pressure) = xsd:decimal
                    && datatype(?height) = xsd:decimal
                    && datatype(?spacing) = xsd:decimal
                    && datatype(?factor) = xsd:decimal
                    && datatype(?minimum) = xsd:decimal
                    && datatype(?load) = xsd:decimal
                )
                BIND(
                    IF(
                        (?pressure * ?height * "1000"^^xsd:decimal) < ?minimum,
                        ?minimum,
                        (?pressure * ?height * "1000"^^xsd:decimal)
                    ) AS ?effectiveLineLoad
                )
                BIND((?factor * ?effectiveLineLoad * ?spacing) AS ?expectedLoad)
                FILTER(?load != ?expectedLoad)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A represented load-length parameter requires decimal metre values for itself and the web-frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:loadLengthParameter ?lengthNode .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                FILTER(
                    NOT EXISTS {
                        ?lengthNode qudt:numericValue ?length ;
                                    qudt:unit unit:M .
                        FILTER(datatype(?length) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:webFrameSpacing ?spacingNode .
                        ?spacingNode qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                        FILTER(datatype(?spacing) = xsd:decimal)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The represented load-length parameter must equal twice the web-frame spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?component .
                ?component nltl:iceLoadSourceType ?source ;
                           nltl:loadLengthParameter ?lengthNode ;
                           nltl:webFrameSpacing ?spacingNode .
                VALUES ?source {
                    nltl:iceStringerLoadSource
                    nltl:longitudinalFramingLoadSource
                }
                ?lengthNode qudt:numericValue ?length ;
                            qudt:unit unit:M .
                ?spacingNode qudt:numericValue ?spacing ;
                             qudt:unit unit:M .
                FILTER(
                    datatype(?length) = xsd:decimal
                    && datatype(?spacing) = xsd:decimal
                    && ?length != ("2"^^xsd:decimal * ?spacing)
                )
            }
        """
    ] .
