@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF059EffectiveShearAreaShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:maximumCalculatedShearForce ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN
            ]
        ] ;
        sh:message "Maximum calculated shear force in kilonewtons is required."
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "Web frame shear factor alpha is required."
    ] ;
    sh:property [
        sh:path nltl:webFrameShearDistributionFactorF13 ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:hasValue "1.1"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "Web frame shear distribution factor f13 must be 1.1."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA
            ]
        ] ;
        sh:message "Yield strength in megapascals is required."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2
            ]
        ] ;
        sh:message "Required shear area in square centimetres is required."
    ] ;
    sh:sparql [
        sh:message "Required shear area must equal sqrt(3) times alpha times f13 times Q divided by yield strength, with the prescribed unit conversion." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce/qudt:numericValue ?qKiloN ;
                      nltl:webFrameShearFactorAlpha/qudt:numericValue ?alpha ;
                      nltl:webFrameShearDistributionFactorF13/qudt:numericValue ?f13 ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrengthMPa ;
                      nltl:requiredShearArea/qudt:numericValue ?areaCm2 .

                FILTER NOT EXISTS {
                    $this nltl:maximumCalculatedShearForce/qudt:numericValue ?candidateQKiloN ;
                          nltl:webFrameShearFactorAlpha/qudt:numericValue ?candidateAlpha ;
                          nltl:webFrameShearDistributionFactorF13/qudt:numericValue ?candidateF13 ;
                          nltl:yieldStrength/qudt:numericValue ?candidateYieldStrengthMPa ;
                          nltl:requiredShearArea/qudt:numericValue ?candidateAreaCm2 .

                    FILTER (
                        ?candidateAreaCm2 =
                        (
                            "1.7320508075688772"^^xsd:decimal *
                            ?candidateAlpha *
                            ?candidateF13 *
                            (?candidateQKiloN / "1000"^^xsd:decimal) /
                            ?candidateYieldStrengthMPa *
                            "10000"^^xsd:decimal
                        )
                    )
                }
            }
        """
    ] .
