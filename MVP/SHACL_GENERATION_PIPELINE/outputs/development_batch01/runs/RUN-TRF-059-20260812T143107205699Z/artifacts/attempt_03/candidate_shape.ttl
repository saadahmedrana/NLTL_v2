@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF059WebFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:requiredShearArea ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum calculated shear force is required in kN." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength is required in MPa." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "0"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:freeFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Free flange area is required in square centimetres." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:webPlateArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Web plate area is required in square centimetres." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "0"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The free-flange-to-web-area ratio is required." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 4-8 web-frame shear factor alpha is required." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:webFrameShearDistributionFactorF13 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The web-frame shear distribution factor f13 must be 1.1." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:hasValue "1.1"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "The free-flange-to-web-area ratio must equal free flange area divided by web plate area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeArea/qudt:numericValue ?freeFlangeArea ;
                      nltl:webPlateArea/qudt:numericValue ?webPlateArea ;
                      nltl:freeFlangeToWebAreaRatio/qudt:numericValue ?ratio .
                FILTER (?webPlateArea > "0"^^xsd:decimal)
                FILTER (?ratio != (?freeFlangeArea / ?webPlateArea))
            }
        """
    ] ;

    sh:sparql [
        sh:message "Alpha must be 1.0 when the free-flange-to-web-area ratio is at most 0.8, and 1.2 when the ratio exceeds 0.8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeToWebAreaRatio/qudt:numericValue ?ratio ;
                      nltl:webFrameShearFactorAlpha/qudt:numericValue ?alpha .
                FILTER (
                    (?ratio <= "0.8"^^xsd:decimal &&
                     ?alpha != "1.0"^^xsd:decimal)
                    ||
                    (?ratio > "0.8"^^xsd:decimal &&
                     ?alpha != "1.2"^^xsd:decimal)
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Required shear area must equal sqrt(3) times alpha times f13 times the maximum shear force in MN, divided by yield strength, times 10^4 square centimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:requiredShearArea/qudt:numericValue ?requiredArea ;
                      nltl:maximumCalculatedShearForce/qudt:numericValue ?shearForceKN ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrengthMPa ;
                      nltl:webFrameShearFactorAlpha/qudt:numericValue ?alpha ;
                      nltl:webFrameShearDistributionFactorF13/qudt:numericValue ?f13 .
                FILTER (?yieldStrengthMPa > "0"^^xsd:decimal)
                BIND (
                    "1.7320508075688772"^^xsd:decimal *
                    ?alpha *
                    ?f13 *
                    (?shearForceKN / "1000"^^xsd:decimal) /
                    ?yieldStrengthMPa *
                    "10000"^^xsd:decimal
                    AS ?calculatedArea
                )
                FILTER (?requiredArea != ?calculatedArea)
            }
        """
    ] .
