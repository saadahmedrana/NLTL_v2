@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF059WebFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:requiredShearArea ;
    sh:targetSubjectsOf nltl:maximumCalculatedShearForce ;
    sh:targetSubjectsOf nltl:webFrameShearFactorAlpha ;
    sh:targetSubjectsOf nltl:webFrameShearDistributionFactorF13 ;
    sh:targetSubjectsOf nltl:freeFlangeToWebAreaRatio ;
    sh:targetSubjectsOf nltl:freeFlangeArea ;
    sh:targetSubjectsOf nltl:webPlateArea ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:message "Required shear area is needed for the web-frame shear calculation." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:message "Maximum calculated shear force is needed in kilonewtons." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:message "Positive yield strength is needed in megapascals." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearDistributionFactorF13 ;
        sh:minCount 1 ;
        sh:message "Web-frame shear distribution factor f13 must be 1.1." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:hasValue "1.1"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:message "A non-negative dimensionless alpha factor is needed." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:freeFlangeToWebAreaRatio ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minInclusive "0"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:freeFlangeArea ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minInclusive "0"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:CentiM2 ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:webPlateArea ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minExclusive "0"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:CentiM2 ;
                        sh:minCount 1
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Alpha must be 1.0 when the free-flange to web-area ratio is at most 0.8, or 1.2 when it exceeds 0.8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:webFrameShearFactorAlpha ?alphaNode .
                    ?alphaNode qudt:numericValue ?alpha ;
                               qudt:unit unit:UNITLESS .
                    {
                        $this nltl:freeFlangeToWebAreaRatio ?ratioNode .
                        ?ratioNode qudt:numericValue ?directRatio ;
                                   qudt:unit unit:UNITLESS .
                        BIND(?directRatio AS ?ratio)
                    }
                    UNION
                    {
                        $this nltl:freeFlangeArea ?flangeNode ;
                              nltl:webPlateArea ?webNode .
                        ?flangeNode qudt:numericValue ?flange ;
                                    qudt:unit unit:CentiM2 .
                        ?webNode qudt:numericValue ?web ;
                                 qudt:unit unit:CentiM2 .
                        FILTER(?flange >= "0"^^xsd:decimal &&
                               ?web > "0"^^xsd:decimal)
                        BIND((?flange / ?web) AS ?ratio)
                    }
                    FILTER(
                        ?ratio >= "0"^^xsd:decimal &&
                        (
                            (?ratio <= "0.8"^^xsd:decimal &&
                             ?alpha = "1.0"^^xsd:decimal)
                            ||
                            (?ratio > "0.8"^^xsd:decimal &&
                             ?alpha = "1.2"^^xsd:decimal)
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Required shear area does not satisfy the web-frame shear-area formula with the applicable Table 4-8 alpha." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:requiredShearArea ?areaNode ;
                          nltl:maximumCalculatedShearForce ?forceNode ;
                          nltl:yieldStrength ?yieldNode ;
                          nltl:webFrameShearFactorAlpha ?alphaNode ;
                          nltl:webFrameShearDistributionFactorF13 ?f13Node .
                    ?areaNode qudt:numericValue ?area ;
                              qudt:unit unit:CentiM2 .
                    ?forceNode qudt:numericValue ?force ;
                               qudt:unit unit:KiloN .
                    ?yieldNode qudt:numericValue ?yield ;
                               qudt:unit unit:MegaPA .
                    ?alphaNode qudt:numericValue ?alpha ;
                               qudt:unit unit:UNITLESS .
                    ?f13Node qudt:numericValue ?f13 ;
                             qudt:unit unit:UNITLESS .
                    {
                        $this nltl:freeFlangeToWebAreaRatio ?ratioNode .
                        ?ratioNode qudt:numericValue ?directRatio ;
                                   qudt:unit unit:UNITLESS .
                        BIND(?directRatio AS ?ratio)
                    }
                    UNION
                    {
                        $this nltl:freeFlangeArea ?flangeNode ;
                              nltl:webPlateArea ?webNode .
                        ?flangeNode qudt:numericValue ?flange ;
                                    qudt:unit unit:CentiM2 .
                        ?webNode qudt:numericValue ?web ;
                                 qudt:unit unit:CentiM2 .
                        FILTER(?flange >= "0"^^xsd:decimal &&
                               ?web > "0"^^xsd:decimal)
                        BIND((?flange / ?web) AS ?ratio)
                    }
                    FILTER(
                        ?area >= "0"^^xsd:decimal &&
                        ?force >= "0"^^xsd:decimal &&
                        ?alpha >= "0"^^xsd:decimal &&
                        ?yield > "0"^^xsd:decimal &&
                        ?f13 = "1.1"^^xsd:decimal &&
                        (
                            (?ratio >= "0"^^xsd:decimal &&
                             ?ratio <= "0.8"^^xsd:decimal &&
                             ?alpha = "1.0"^^xsd:decimal)
                            ||
                            (?ratio > "0.8"^^xsd:decimal &&
                             ?alpha = "1.2"^^xsd:decimal)
                        ) &&
                        (
                            ?area * ?area * ?yield * ?yield
                            =
                            "300"^^xsd:decimal * ?alpha * ?alpha *
                            ?f13 * ?f13 * ?force * ?force
                        )
                    )
                }
            }
        """
    ] .
