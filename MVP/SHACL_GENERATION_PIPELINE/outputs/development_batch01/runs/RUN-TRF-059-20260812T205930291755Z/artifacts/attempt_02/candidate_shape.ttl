@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:WebFrameEffectiveShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "0"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearDistributionFactorF13 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The shear factor alpha must match Table 4-8, f13 must equal 1.1, and required shear area must match the formula within relative tolerance 1e-6 with absolute fallback 1e-9 cm2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumCalculatedShearForce ?qNode ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:webFrameShearDistributionFactorF13 ?f13Node ;
                      nltl:freeFlangeToWebAreaRatio ?ratioNode ;
                      nltl:webFrameShearFactorAlpha ?alphaNode ;
                      nltl:requiredShearArea ?areaNode .

                ?qNode qudt:numericValue ?qKiloN ;
                       qudt:unit unit:KiloN .
                ?yieldNode qudt:numericValue ?yieldMPa ;
                           qudt:unit unit:MegaPA .
                ?f13Node qudt:numericValue ?f13 ;
                         qudt:unit unit:UNITLESS .
                ?ratioNode qudt:numericValue ?ratio ;
                           qudt:unit unit:UNITLESS .
                ?alphaNode qudt:numericValue ?alpha ;
                           qudt:unit unit:UNITLESS .
                ?areaNode qudt:numericValue ?areaCm2 ;
                          qudt:unit unit:CentiM2 .

                BIND(
                    "1.7320508075688772"^^xsd:decimal *
                    ?alpha *
                    ?f13 *
                    (?qKiloN / "1000"^^xsd:decimal) /
                    ?yieldMPa *
                    "10000"^^xsd:decimal
                    AS ?expectedCm2
                )
                BIND(
                    ABS(?expectedCm2) * "0.000001"^^xsd:decimal
                    AS ?relativeTolerance
                )
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )

                FILTER(
                    ?f13 != "1.1"^^xsd:decimal ||
                    !(
                        (?ratio = "0"^^xsd:decimal && ?alpha = "1.5"^^xsd:decimal) ||
                        (?ratio = "0.2"^^xsd:decimal && ?alpha = "1.23"^^xsd:decimal) ||
                        (?ratio = "0.4"^^xsd:decimal && ?alpha = "1.16"^^xsd:decimal) ||
                        (?ratio = "0.6"^^xsd:decimal && ?alpha = "1.11"^^xsd:decimal) ||
                        (?ratio = "0.8"^^xsd:decimal && ?alpha = "1.09"^^xsd:decimal) ||
                        (?ratio = "1.0"^^xsd:decimal && ?alpha = "1.07"^^xsd:decimal) ||
                        (?ratio = "1.2"^^xsd:decimal && ?alpha = "1.06"^^xsd:decimal) ||
                        (?ratio = "1.4"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                        (?ratio = "1.6"^^xsd:decimal && ?alpha = "1.05"^^xsd:decimal) ||
                        (?ratio = "1.8"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal) ||
                        (?ratio = "2.0"^^xsd:decimal && ?alpha = "1.04"^^xsd:decimal)
                    ) ||
                    ABS(?areaCm2 - ?expectedCm2) > ?tolerance
                )
            }
        """
    ] .
