@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:ShipPropellerHullClearanceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerBladeTipHullClearance ;
        sh:minCount 1 ;
        sh:node g:ClearanceQuantityValueShape ;
        sh:message "Propeller blade tip hull clearance is required in metres."
    ] ;
    sh:property [
        sh:path nltl:minimumClearance ;
        sh:minCount 1 ;
        sh:node g:ClearanceQuantityValueShape ;
        sh:message "The minimum required clearance h0 is required in metres."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Propeller blade tip hull clearance shall be no less than the minimum clearance h0." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:propellerBladeTipHullClearance ?clearanceQuantity ;
          nltl:minimumClearance ?minimumQuantity .
    ?clearanceQuantity qudt:numericValue ?clearance .
    ?minimumQuantity qudt:numericValue ?minimum .
    FILTER(?clearance < ?minimum)
}
"""
    ] .

g:ClearanceQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "The clearance quantity shall have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:M ;
        sh:message "The clearance quantity shall use metre as its unit."
    ] .
