@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-076-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Required blade load cases are not recorded as covered for a CP or FP propeller." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:propellerType ?propellerType .
    FILTER(STR(?propellerType) IN ("CP", "FP"))
    FILTER NOT EXISTS {
        $this nltl:bladeLoadCaseCoverage ?coverage .
        FILTER(
            DATATYPE(?coverage) = xsd:boolean &&
            ?coverage = "true"^^xsd:boolean
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An FP propeller requires a boolean reversing-capability value to determine whether load case 5 applies." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:propellerType ?propellerType .
    FILTER(STR(?propellerType) = "FP")
    FILTER NOT EXISTS {
        $this nltl:propellerReversingCapability ?reversing .
        FILTER(DATATYPE(?reversing) = xsd:boolean)
    }
}
"""
    ] .
