@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IceLoadCycleCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one integer ice load cycle count is required."
    ] ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one integer class load cycle count is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one unitless decimal ice load cycle coefficient k1 is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one unitless decimal ice load cycle coefficient k2 is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one unitless decimal ice load cycle coefficient k3 is required."
    ] .

gs:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must have unit UNITLESS."
    ] .
