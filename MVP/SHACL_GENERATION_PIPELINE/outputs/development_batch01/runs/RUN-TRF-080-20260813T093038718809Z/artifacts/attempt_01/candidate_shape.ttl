@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF080Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:propellerIceInteractionComponent ;
                    sh:nodeKind sh:IRI
                ] ;
                sh:qualifiedMaxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:propellerIceInteractionComponent ;
                    sh:nodeKind sh:IRI
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An applicable propeller ice-interaction component must be identified."
            ] ;
            sh:property [
                sh:path nltl:iceLoadCycleCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:message "Ice load cycle count is required for the propeller-blade multiplication."
            ] ;
            sh:property [
                sh:path nltl:propellerBladeCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:message "Propeller blade count is required for the propeller-blade multiplication."
            ]
        ]
    ) .
