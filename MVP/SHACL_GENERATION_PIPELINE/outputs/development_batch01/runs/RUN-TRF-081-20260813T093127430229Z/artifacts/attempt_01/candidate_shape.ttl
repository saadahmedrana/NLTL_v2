@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ForceQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The force quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The force quantity must have exactly one unit, KiloN."
    ] .

gs:PropellerShaftDesignThrustShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one forward blade force is required for the thrust calculation."
    ] ;
    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one backward blade force is required for the thrust calculation."
    ] ;
    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one hydrodynamic bollard thrust is required for the thrust calculation."
    ] ;
    sh:property [
        sh:path nltl:forwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one forward ice thrust is required."
    ] ;
    sh:property [
        sh:path nltl:backwardIceThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one backward ice thrust is required."
    ] ;
    sh:property [
        sh:path nltl:forwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one forward propeller shaft design thrust is required."
    ] ;
    sh:property [
        sh:path nltl:backwardPropellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one backward propeller shaft design thrust is required."
    ] ;
    sh:property [
        sh:path nltl:propellerShaftDesignThrust ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityValueShape ;
        sh:message "Exactly one propeller shaft design thrust is required."
    ] ;
    sh:sparql [
        sh:message "Ice thrust and propeller shaft design thrust values must satisfy the prescribed formulas within relative tolerance 1e-6, with absolute tolerance 1e-9 near zero." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:forwardBladeForce/qudt:numericValue ?ff ;
          nltl:backwardBladeForce/qudt:numericValue ?fb ;
          nltl:hydrodynamicBollardThrust/qudt:numericValue ?bollard ;
          nltl:forwardIceThrust/qudt:numericValue ?tf ;
          nltl:backwardIceThrust/qudt:numericValue ?tb ;
          nltl:forwardPropellerShaftDesignThrust/qudt:numericValue ?forwardDesign ;
          nltl:backwardPropellerShaftDesignThrust/qudt:numericValue ?backwardDesign ;
          nltl:propellerShaftDesignThrust/qudt:numericValue ?design .

    BIND(1.1 * xsd:decimal(?ff) AS ?expectedTf)
    BIND(1.1 * xsd:decimal(?fb) AS ?expectedTb)
    BIND(xsd:decimal(?bollard) + 2.2 * xsd:decimal(?tf) AS ?expectedForwardDesign)
    BIND(1.5 * xsd:decimal(?tb) AS ?expectedBackwardDesign)
    BIND(
        IF(
            xsd:decimal(?forwardDesign) >= xsd:decimal(?backwardDesign),
            xsd:decimal(?forwardDesign),
            xsd:decimal(?backwardDesign)
        )
        AS ?expectedDesign
    )

    FILTER (
        ABS(xsd:decimal(?tf) - ?expectedTf) >
            IF(ABS(?expectedTf) * 0.000001 > 0.000000001,
               ABS(?expectedTf) * 0.000001,
               0.000000001)
        ||
        ABS(xsd:decimal(?tb) - ?expectedTb) >
            IF(ABS(?expectedTb) * 0.000001 > 0.000000001,
               ABS(?expectedTb) * 0.000001,
               0.000000001)
        ||
        ABS(xsd:decimal(?forwardDesign) - ?expectedForwardDesign) >
            IF(ABS(?expectedForwardDesign) * 0.000001 > 0.000000001,
               ABS(?expectedForwardDesign) * 0.000001,
               0.000000001)
        ||
        ABS(xsd:decimal(?backwardDesign) - ?expectedBackwardDesign) >
            IF(ABS(?expectedBackwardDesign) * 0.000001 > 0.000000001,
               ABS(?expectedBackwardDesign) * 0.000001,
               0.000000001)
        ||
        ABS(xsd:decimal(?design) - ?expectedDesign) >
            IF(ABS(?expectedDesign) * 0.000001 > 0.000000001,
               ABS(?expectedDesign) * 0.000001,
               0.000000001)
    )
}
"""
    ] .
