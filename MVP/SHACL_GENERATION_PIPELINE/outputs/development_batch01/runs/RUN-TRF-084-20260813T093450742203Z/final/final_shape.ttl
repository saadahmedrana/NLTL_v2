@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF084CPPropellerPitchShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:propellerType ?propellerType .
                FILTER(?propellerType = "CP"^^xsd:string)
            }
        """
    ] ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:hasValue "CP"^^xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A CP ship must have exactly one propeller type value identifying it as CP."
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A CP ship must state exactly once whether the bollard-condition pitch value is known."
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PitchQuantityInMetresShape ;
        sh:message "A CP ship must have exactly one valid propeller pitch at MCR in bollard condition."
    ] ;
    sh:or (
        gs:KnownBollardPitchBranch
        gs:DerivedBollardPitchBranch
    ) .

gs:PitchQuantityInMetresShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:KnownBollardPitchBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:DerivedBollardPitchBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrFreeRunning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PitchQuantityInMetresShape ;
        sh:message "When the bollard-condition pitch is not known, exactly one valid free-running pitch is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The bollard-condition pitch must equal 0.7 times the free-running pitch within a relative tolerance of 1e-6 and an absolute fallback of 1e-12 metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerPitchAtMcrBollard ?bollardQuantity ;
                    nltl:propellerPitchAtMcrFreeRunning ?freeRunningQuantity .
                ?bollardQuantity qudt:numericValue ?bollardPitch ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                ?freeRunningQuantity qudt:numericValue ?freeRunningPitch ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                BIND("0.7"^^xsd:decimal * ?freeRunningPitch AS ?expectedPitch)
                BIND(
                    IF(
                        ABS(?expectedPitch) * "0.000001"^^xsd:decimal > "0.000000000001"^^xsd:decimal,
                        ABS(?expectedPitch) * "0.000001"^^xsd:decimal,
                        "0.000000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?bollardPitch - ?expectedPitch) > ?tolerance)
            }
        """
    ] .
