@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:TRF091Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerIceMillingLoadSequence ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The propeller ice milling load sequence must be recorded."
    ] ;
    sh:property [
        sh:path nltl:propulsionLineStrengthEvaluation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The propulsion line strength evaluation must be recorded."
    ] ;
    sh:property [
        sh:path nltl:stallingAnalysisPurpose ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The stated purpose with respect to stalling analysis must be recorded."
    ] .
