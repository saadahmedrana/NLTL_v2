@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:BladeFailureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:message "Blade failure ultimate load must be provided." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:in ( unit:KiloN )
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:minCount 1 ;
        sh:message "Blade tip offset is required to evaluate blade failure status." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:in ( unit:M )
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:message "Propeller diameter is required to evaluate blade failure status." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:in ( unit:M )
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When blade tip offset exceeds 10 percent of propeller diameter, bladeFailureStatus must have exactly one value and that value must be true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:bladeTipOffset ?offsetQuantity ;
                      nltl:propellerDiameter ?diameterQuantity .
                ?offsetQuantity qudt:numericValue ?offset .
                ?diameterQuantity qudt:numericValue ?diameter .
                FILTER (?offset > (0.10 * ?diameter))
                FILTER (
                    NOT EXISTS {
                        $this nltl:bladeFailureStatus ?trueStatus .
                        FILTER (?trueStatus = true)
                    }
                    ||
                    EXISTS {
                        $this nltl:bladeFailureStatus ?nonTrueStatus .
                        FILTER (?nonTrueStatus != true)
                    }
                    ||
                    EXISTS {
                        $this nltl:bladeFailureStatus ?status1 ;
                              nltl:bladeFailureStatus ?status2 .
                        FILTER (!sameTerm(?status1, ?status2))
                    }
                )
            }
        """
    ] .
