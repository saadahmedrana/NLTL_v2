@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:EquivalentImpactSphereRadiusShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:nonHemisphericalImpactArea ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "For a non-hemispherical impact area, equivalentImpactSphereRadius must provide a decimal QuantityValue in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:nonHemisphericalImpactArea ?impactArea .
                FILTER NOT EXISTS {
                    $this nltl:equivalentImpactSphereRadius ?radius .
                    ?radius a qudt:QuantityValue ;
                            qudt:numericValue ?reportedRadius ;
                            qudt:unit unit:M .
                    FILTER (datatype(?reportedRadius) = xsd:decimal)
                }
            }
        """
    ] .
