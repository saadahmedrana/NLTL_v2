@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AirReceiverConsecutiveStartCapacityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionEngineReversedForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propulsion-engine reversal state must be recorded to determine the required consecutive-start capacity."
    ] ;
    sh:property [
        sh:path nltl:airReceiverConsecutiveStartCapacity ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "The air-receiver consecutive-start capacity must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:minInclusive "12"^^xsd:integer
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:minInclusive "6"^^xsd:integer
            ]
        ]
    ) ;
    sh:message "At least 12 consecutive starts are required when the propulsion engine is reversed for astern movement; otherwise at least 6 are required." .
