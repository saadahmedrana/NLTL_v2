@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:BallastWaterCoolingArrangementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:ballastWaterCoolingArrangement ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:ballastWaterCoolingArrangement ;
                sh:minCount 1 ;
                sh:datatype xsd:string
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:inletChest
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "A ship using ballast water for cooling must retain an inlet chest."
            ] ;
            sh:property [
                sh:path nltl:substituteArrangementStatus ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false ) ;
                sh:message "A ballast-water cooling arrangement must not be identified as a substitute for an inlet chest."
            ]
        ]
    ) .
