@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix shape: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

shape:TRF133ApplicabilityReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:message "A ship ice-class value is required to determine applicability of the clause 8 marking requirements."
    ] .
