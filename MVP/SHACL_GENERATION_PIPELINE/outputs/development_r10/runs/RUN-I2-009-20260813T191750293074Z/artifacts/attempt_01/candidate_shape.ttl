@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1
    ] .

gen:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node gen:DegreeQuantityShape ;
        sh:minCount 1 ;
        sh:message "Buttock angle in degrees is required to determine bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node gen:DegreeQuantityShape ;
        sh:minCount 1 ;
        sh:message "Normal frame angle in degrees is required to determine bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Bow-form applicability must be recorded as a boolean."
    ] ;
    sh:sparql [
        sh:message "Bow-form applicability must be true when the buttock angle is greater than 0 and less than 80 degrees and the normal frame angle is greater than 10 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:buttockAngle ?gammaQuantity ;
                      nltl:normalFrameAngle ?betaQuantity .
                ?gammaQuantity qudt:numericValue ?gamma ;
                               qudt:unit unit:DEG .
                ?betaQuantity qudt:numericValue ?beta ;
                              qudt:unit unit:DEG .
                FILTER (
                    datatype(?gamma) = xsd:decimal &&
                    datatype(?beta) = xsd:decimal &&
                    ?gamma > 0 &&
                    ?gamma < 80 &&
                    ?beta > 10
                )
                FILTER NOT EXISTS {
                    $this nltl:bowFormApplicability "true"^^xsd:boolean .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an other ice-strengthened area, average ice pressure, non-bow load-patch dimensions, and a load-patch aspect ratio of exactly 3.6 must be provided in the required units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasHullAreaAssignment ?assignment .
                ?assignment nltl:assignedHullArea nltl:otherIceStrengthenedArea .
                FILTER (
                    NOT EXISTS {
                        $this nltl:averageIcePressure ?pressureQuantity .
                        ?pressureQuantity qudt:numericValue ?pressure ;
                                          qudt:unit unit:MegaPA .
                        FILTER (datatype(?pressure) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:nonBowLoadPatchHeight ?heightQuantity .
                        ?heightQuantity qudt:numericValue ?height ;
                                        qudt:unit unit:M .
                        FILTER (datatype(?height) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:nonBowLoadPatchLength ?lengthQuantity .
                        ?lengthQuantity qudt:numericValue ?length ;
                                        qudt:unit unit:M .
                        FILTER (datatype(?length) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:loadPatchAspectRatio ?aspectRatioQuantity .
                        ?aspectRatioQuantity qudt:numericValue ?aspectRatio ;
                                             qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?aspectRatio) = xsd:decimal &&
                            ?aspectRatio >= 3.6 &&
                            ?aspectRatio <= 3.6
                        )
                    }
                )
            }
        """
    ] .
