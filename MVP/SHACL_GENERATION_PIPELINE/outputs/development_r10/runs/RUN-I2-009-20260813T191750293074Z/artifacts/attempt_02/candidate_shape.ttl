@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:class nltl:hullAreaAssignment
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:I2_009_PressureValueShape
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node gen:I2_009_LengthValueShape
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node gen:I2_009_LengthValueShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node gen:I2_009_FixedAspectRatioValueShape
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_009_AngleValueShape ;
        sh:message "Exactly one buttock angle in degrees is required to determine bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_009_AngleValueShape ;
        sh:message "Exactly one normal frame angle in degrees is required to determine bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean bow-form applicability value is required."
    ] ;
    sh:sparql [
        sh:message "Ships assigned an other ice-strengthened area require average ice pressure, non-bow load-patch height and length, and the fixed load-patch aspect ratio." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasHullAreaAssignment ?assignment .
                ?assignment nltl:assignedHullArea nltl:otherIceStrengthenedArea .
                OPTIONAL {
                    $this nltl:averageIcePressure ?pressure .
                }
                OPTIONAL {
                    $this nltl:nonBowLoadPatchHeight ?height .
                }
                OPTIONAL {
                    $this nltl:nonBowLoadPatchLength ?length .
                }
                OPTIONAL {
                    $this nltl:loadPatchAspectRatio ?aspectRatio .
                }
            }
            GROUP BY $this
            HAVING (
                COUNT(DISTINCT ?pressure) = 0 ||
                COUNT(DISTINCT ?height) = 0 ||
                COUNT(DISTINCT ?length) = 0 ||
                COUNT(DISTINCT ?aspectRatio) = 0
            )
        """
    ] ;
    sh:sparql [
        sh:message "bowFormApplicability must be true exactly when the buttock angle is greater than 0 and less than 80 degrees and the normal frame angle is greater than 10 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:buttockAngle ?gammaNode ;
                      nltl:normalFrameAngle ?betaNode ;
                      nltl:bowFormApplicability ?reported .
                ?gammaNode qudt:numericValue ?gamma .
                ?betaNode qudt:numericValue ?beta .
                BIND(
                    (?gamma > 0.0 && ?gamma < 80.0 && ?beta > 10.0)
                    AS ?expected
                )
                FILTER (?reported != ?expected)
            }
        """
    ] .

gen:I2_009_HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasHullAreaAssignment ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:minCount 1 ;
        sh:class nltl:hullAreaValue ;
        sh:message "Each linked hull-area assignment must identify its assigned hull area."
    ] .

gen:I2_009_PressureValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:maxCount 1
    ] .

gen:I2_009_LengthValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .

gen:I2_009_AngleValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:maxCount 1
    ] .

gen:I2_009_FixedAspectRatioValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:message "The non-bow load-patch aspect ratio must equal 3.6."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:maxCount 1
    ] .
