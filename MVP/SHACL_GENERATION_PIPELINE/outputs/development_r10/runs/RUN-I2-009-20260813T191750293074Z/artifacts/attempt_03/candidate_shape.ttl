@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:class nltl:hullAreaAssignment ;
        sh:node gen:I2_009_HullAreaAssignmentShape
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:I2_009_PressureValueShape
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node gen:I2_009_LengthValueShape
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node gen:I2_009_LengthValueShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node gen:I2_009_FixedAspectRatioValueShape
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:node gen:I2_009_AngleValueShape ;
        sh:message "Buttock angle is required to determine bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:node gen:I2_009_AngleValueShape ;
        sh:message "Normal frame angle is required to determine bow-form applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minExclusive 0.0 ;
                sh:maxExclusive 80.0
            ] ;
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:minExclusive 10.0
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:maxInclusive 0.0
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minInclusive 80.0
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:maxInclusive 10.0
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Other ice-strengthened areas require average ice pressure, non-bow load-patch dimensions, and the fixed load-patch aspect ratio." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasHullAreaAssignment ?assignment .
                ?assignment nltl:assignedHullArea ?area .
                FILTER (
                    ?area IN (
                        nltl:otherIceStrengthenedArea,
                        nltl:otherIceStrengthenedAreaValue
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:averageIcePressure ?pressure ;
                          nltl:nonBowLoadPatchHeight ?height ;
                          nltl:nonBowLoadPatchLength ?length ;
                          nltl:loadPatchAspectRatio ?aspectRatio .
                }
            }
        """
    ] .

gen:I2_009_HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:class nltl:hullAreaValue
    ] .

gen:I2_009_PressureValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA
    ] .

gen:I2_009_LengthValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gen:I2_009_AngleValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG
    ] .

gen:I2_009_FixedAspectRatioValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:message "The load-patch aspect ratio must be 3.6."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .
