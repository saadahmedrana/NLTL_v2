@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LineLoadQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNewtonQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCaseShape a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Each bow subregion case must have one mid-length position in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Each bow subregion case must have one calculated aspect ratio."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LineLoadQuantityShape ;
        sh:message "Each bow subregion case must have one calculated glancing-impact line load."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Each bow subregion case must have one calculated glancing-impact pressure."
    ] .

gen:BowSubregionCalculationShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Bow length is required to determine the four bow subregions."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must be divided into four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:BowSubregionCaseShape ;
        sh:message "Exactly four bow subregion calculation cases are required."
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "Calculated glancing-impact force values are required."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape ;
        sh:message "One selected maximum bow force is required."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LineLoadQuantityShape ;
        sh:message "One selected maximum bow line load is required."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "One selected maximum bow pressure is required."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "The average ice pressure calculated using the selected maxima is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The calculated load patch height is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The calculated load patch length is required."
    ] ;
    sh:sparql [
        sh:message "Each subregion mid-length position must be LBOW/8, 3*LBOW/8, 5*LBOW/8, or 7*LBOW/8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?bowQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?bowQuantity qudt:numericValue ?bow .
                ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
                ?positionQuantity qudt:numericValue ?position .
                BIND((?bow / 8) AS ?expected1)
                BIND(((3 * ?bow) / 8) AS ?expected2)
                BIND(((5 * ?bow) / 8) AS ?expected3)
                BIND(((7 * ?bow) / 8) AS ?expected4)
                BIND(IF(ABS(?expected1) * 0.000001 > 0.000000001,
                        ABS(?expected1) * 0.000001, 0.000000001) AS ?tolerance1)
                BIND(IF(ABS(?expected2) * 0.000001 > 0.000000001,
                        ABS(?expected2) * 0.000001, 0.000000001) AS ?tolerance2)
                BIND(IF(ABS(?expected3) * 0.000001 > 0.000000001,
                        ABS(?expected3) * 0.000001, 0.000000001) AS ?tolerance3)
                BIND(IF(ABS(?expected4) * 0.000001 > 0.000000001,
                        ABS(?expected4) * 0.000001, 0.000000001) AS ?tolerance4)
                FILTER (
                    ABS(?position - ?expected1) > ?tolerance1 &&
                    ABS(?position - ?expected2) > ?tolerance2 &&
                    ABS(?position - ?expected3) > ?tolerance3 &&
                    ABS(?position - ?expected4) > ?tolerance4
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow line load must equal the maximum subregion line load within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?selectedQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedQuantity qudt:numericValue ?selected .
                ?case nltl:glancingImpactLineLoad ?lineLoadQuantity .
                ?lineLoadQuantity qudt:numericValue ?lineLoad .
            }
            GROUP BY $this ?selected
            HAVING (
                ABS(?selected - MAX(?lineLoad)) >
                IF(
                    ABS(MAX(?lineLoad)) * 0.000001 > 0.000000001,
                    ABS(MAX(?lineLoad)) * 0.000001,
                    0.000000001
                )
            )
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow pressure must equal the maximum subregion pressure within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?selectedQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedQuantity qudt:numericValue ?selected .
                ?case nltl:glancingImpactPressure ?pressureQuantity .
                ?pressureQuantity qudt:numericValue ?pressure .
            }
            GROUP BY $this ?selected
            HAVING (
                ABS(?selected - MAX(?pressure)) >
                IF(
                    ABS(MAX(?pressure)) * 0.000001 > 0.000000001,
                    ABS(MAX(?pressure)) * 0.000001,
                    0.000000001
                )
            )
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum bow force must equal the maximum glancing-impact force after conversion from kN to MN, within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedQuantity ;
                      nltl:totalGlancingImpactForce ?forceQuantity .
                ?selectedQuantity qudt:numericValue ?selected .
                ?forceQuantity qudt:numericValue ?force .
            }
            GROUP BY $this ?selected
            HAVING (
                ABS(?selected - (MAX(?force) / 1000)) >
                IF(
                    ABS(MAX(?force) / 1000) * 0.000001 > 0.000000001,
                    ABS(MAX(?force) / 1000) * 0.000001,
                    0.000000001
                )
            )
        """
    ] .
