@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PositiveMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetrePositionQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveMegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveMegaNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveKiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveMegaNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveUnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetrePositionQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveUnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveKiloNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaNewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaPascalQuantityShape
    ] .

gen:BowSubregionCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:BowSubregionCalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaNewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PositiveMetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "Each bow subregion case must use one of the four mid-length positions LBOW/8, 3*LBOW/8, 5*LBOW/8, or 7*LBOW/8." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:bowLength ?bowQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?bowQuantity qudt:numericValue ?bowLength .
                ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
                ?positionQuantity qudt:numericValue ?position .
                BIND((?bowLength / 8) AS ?position1)
                BIND((3 * ?bowLength / 8) AS ?position2)
                BIND((5 * ?bowLength / 8) AS ?position3)
                BIND((7 * ?bowLength / 8) AS ?position4)
                FILTER(
                    ABS(?position - ?position1) >
                        (0.000001 * ABS(?position1) + 0.000000001) &&
                    ABS(?position - ?position2) >
                        (0.000001 * ABS(?position2) + 0.000000001) &&
                    ABS(?position - ?position3) >
                        (0.000001 * ABS(?position3) + 0.000000001) &&
                    ABS(?position - ?position4) >
                        (0.000001 * ABS(?position4) + 0.000000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The four bow subregion cases must occupy four distinct prescribed mid-length positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?slot) AS ?slotCount)
                    WHERE {
                        $this nltl:bowLength ?bowQuantity ;
                              nltl:hasBowSubregionCalculationCase ?case .
                        ?bowQuantity qudt:numericValue ?bowLength .
                        ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
                        ?positionQuantity qudt:numericValue ?position .
                        BIND((?bowLength / 8) AS ?position1)
                        BIND((3 * ?bowLength / 8) AS ?position2)
                        BIND((5 * ?bowLength / 8) AS ?position3)
                        BIND((7 * ?bowLength / 8) AS ?position4)
                        BIND(
                            IF(
                                ABS(?position - ?position1) <=
                                    (0.000001 * ABS(?position1) + 0.000000001),
                                1,
                                IF(
                                    ABS(?position - ?position2) <=
                                        (0.000001 * ABS(?position2) + 0.000000001),
                                    2,
                                    IF(
                                        ABS(?position - ?position3) <=
                                            (0.000001 * ABS(?position3) + 0.000000001),
                                        3,
                                        IF(
                                            ABS(?position - ?position4) <=
                                                (0.000001 * ABS(?position4) + 0.000000001),
                                            4,
                                            0
                                        )
                                    )
                                )
                            ) AS ?slot
                        )
                        FILTER(?slot != 0)
                    }
                    GROUP BY $this
                }
                FILTER(?slotCount != 4)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected bow force, line load, and pressure must equal the maxima from the four subregion cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                {
                    SELECT $this
                           (MAX(?forceMN) AS ?maximumForce)
                           (MAX(?lineLoad) AS ?maximumLineLoad)
                           (MAX(?pressure) AS ?maximumPressure)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:totalGlancingImpactForce ?forceQuantity ;
                              nltl:glancingImpactLineLoad ?lineLoadQuantity ;
                              nltl:glancingImpactPressure ?pressureQuantity .
                        ?forceQuantity qudt:numericValue ?forceKN .
                        ?lineLoadQuantity qudt:numericValue ?lineLoad .
                        ?pressureQuantity qudt:numericValue ?pressure .
                        BIND((?forceKN / 1000) AS ?forceMN)
                    }
                    GROUP BY $this
                }
                $this nltl:selectedMaximumBowForce ?selectedForceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoadQuantity ;
                      nltl:selectedMaximumBowPressure ?selectedPressureQuantity .
                ?selectedForceQuantity qudt:numericValue ?selectedForce .
                ?selectedLineLoadQuantity qudt:numericValue ?selectedLineLoad .
                ?selectedPressureQuantity qudt:numericValue ?selectedPressure .
                FILTER(
                    ABS(?selectedForce - ?maximumForce) >
                        (0.000001 * ABS(?maximumForce) + 0.000000001) ||
                    ABS(?selectedLineLoad - ?maximumLineLoad) >
                        (0.000001 * ABS(?maximumLineLoad) + 0.000000001) ||
                    ABS(?selectedPressure - ?maximumPressure) >
                        (0.000001 * ABS(?maximumPressure) + 0.000000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Average ice pressure and load patch dimensions must be calculated from the selected maximum pressure, line load, and force." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?forceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?lineLoadQuantity ;
                      nltl:selectedMaximumBowPressure ?pressureQuantity ;
                      nltl:averageIcePressure ?averagePressureQuantity ;
                      nltl:loadPatchHeight ?heightQuantity ;
                      nltl:loadPatchLength ?lengthQuantity .
                ?forceQuantity qudt:numericValue ?selectedForce .
                ?lineLoadQuantity qudt:numericValue ?selectedLineLoad .
                ?pressureQuantity qudt:numericValue ?selectedPressure .
                ?averagePressureQuantity qudt:numericValue ?reportedAveragePressure .
                ?heightQuantity qudt:numericValue ?reportedHeight .
                ?lengthQuantity qudt:numericValue ?reportedLength .
                FILTER(?selectedPressure > 0 && ?selectedLineLoad > 0)
                BIND(?selectedPressure AS ?expectedAveragePressure)
                BIND((?selectedLineLoad / ?expectedAveragePressure) AS ?expectedHeight)
                BIND((?selectedForce / ?selectedLineLoad) AS ?expectedLength)
                FILTER(
                    ABS(?reportedAveragePressure - ?expectedAveragePressure) >
                        (0.000001 * ABS(?expectedAveragePressure) + 0.000000001) ||
                    ABS(?reportedHeight - ?expectedHeight) >
                        (0.000001 * ABS(?expectedHeight) + 0.000000001) ||
                    ABS(?reportedLength - ?expectedLength) >
                        (0.000001 * ABS(?expectedLength) + 0.000000001)
                )
            }
        """
    ] .
