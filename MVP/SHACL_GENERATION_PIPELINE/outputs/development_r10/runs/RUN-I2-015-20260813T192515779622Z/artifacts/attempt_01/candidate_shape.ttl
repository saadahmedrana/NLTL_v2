@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:BowSubregionCalculationCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:betaIPrime ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:UnitlessQuantityShape
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineLengthLUI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ]
        ]
    ) .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:sparql [
        sh:message "The bow shape coefficient must not exceed the formula candidate 0.60, allowing a relative tolerance of 1e-6 with an absolute fallback of 1e-12." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:bowShapeCoefficient ?coefficientNode .
    ?coefficientNode qudt:numericValue ?coefficient .
    BIND("0.60"^^xsd:decimal AS ?limit)
    BIND(
        IF(
            ABS(?limit) * "0.000001"^^xsd:decimal > "0.000000000001"^^xsd:decimal,
            ABS(?limit) * "0.000001"^^xsd:decimal,
            "0.000000000001"^^xsd:decimal
        )
        AS ?tolerance
    )
    FILTER(?coefficient > (?limit + ?tolerance))
}
"""
    ] .

gen:TableLookupCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
