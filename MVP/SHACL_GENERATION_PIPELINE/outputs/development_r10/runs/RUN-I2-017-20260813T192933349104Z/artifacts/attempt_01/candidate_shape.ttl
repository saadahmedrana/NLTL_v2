@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipNonBowIceLoadShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonBowIceLoadCalculationCase ;
        sh:class nltl:nonBowIceLoadCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:node gen:NonBowIceLoadCalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "A non-bow ice-load calculation case is required."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:message "Average ice pressure in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:nonBowLineLoad ;
        sh:node gen:KiloNewtonPerMetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Non-bow line load in kN/m is required."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Non-bow load-patch height in metres is required."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Non-bow load-patch length in metres is required."
    ] .

gen:NonBowIceLoadCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:nonBowIceLoadCalculationCase ;
    sh:property [
        sh:path nltl:nonBowIceForce ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Non-bow ice force in kN is required."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceLineLoad ;
        sh:node gen:MegaNewtonPerMetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Non-bow ice line load in MN/m is required."
    ] ;
    sh:property [
        sh:path nltl:shipDisplacementFactor ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:message "The ship displacement factor is required."
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gen:KiloNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1
    ] .

gen:MegaNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1
    ] .
