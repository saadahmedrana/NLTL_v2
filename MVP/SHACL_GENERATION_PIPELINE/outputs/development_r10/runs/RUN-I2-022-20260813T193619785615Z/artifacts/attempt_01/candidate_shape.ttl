@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:MegaPA ) ;
        sh:minCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:M ) ;
        sh:minCount 1
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:MilliM ) ;
        sh:minCount 1
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:DEG ) ;
        sh:minCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:UNITLESS ) ;
        sh:minCount 1
    ] .

gen:StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gen:UnitlessQuantityShape
    ] .

gen:PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node gen:MillimetreQuantityShape
    ] .

gen:I2_022_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:PressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:StructuralMemberShape
    ] ;
    sh:sparql [
        sh:message "For linked plating with Omega at least 70 degrees, the reported net thickness must satisfy the stated formula within a 2e-6 relative tolerance in the squared ratio, with a 1e-12 absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plating ;
                      nltl:hasStructuralMember ?member ;
                      nltl:averageIcePressure ?pavgQuantity ;
                      nltl:loadPatchHeight ?bQuantity ;
                      nltl:peakPressureFactor ?ppfQuantity ;
                      nltl:yieldStrength ?yieldQuantity .
                ?plating a nltl:plating ;
                         nltl:framingAngleOmega ?omegaQuantity ;
                         nltl:iceLoadRequiredNetPlateThickness ?thicknessQuantity .
                ?member a nltl:structuralMember ;
                        nltl:frameSpacing ?spacingQuantity ;
                        nltl:selectedHullAreaFactor ?areaFactorQuantity .
                ?omegaQuantity qudt:numericValue ?omega ;
                               qudt:unit unit:DEG .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                   qudt:unit unit:MilliM .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?areaFactorQuantity qudt:numericValue ?areaFactor ;
                                    qudt:unit unit:UNITLESS .
                ?pavgQuantity qudt:numericValue ?pavg ;
                              qudt:unit unit:MegaPA .
                ?bQuantity qudt:numericValue ?b ;
                           qudt:unit unit:M .
                ?ppfQuantity qudt:numericValue ?ppf ;
                             qudt:unit unit:UNITLESS .
                ?yieldQuantity qudt:numericValue ?yieldStrength ;
                               qudt:unit unit:MegaPA .
                FILTER (
                    xsd:decimal(?omega) >= 70.0 &&
                    xsd:decimal(?spacing) > 0.0 &&
                    xsd:decimal(?b) > 0.0 &&
                    xsd:decimal(?yieldStrength) > 0.0
                )
                BIND (
                    (xsd:decimal(?areaFactor) * xsd:decimal(?ppf) *
                     xsd:decimal(?pavg)) / xsd:decimal(?yieldStrength)
                    AS ?expectedSquaredRatio
                )
                FILTER (?expectedSquaredRatio >= 0.0)
                BIND (
                    1.0 + xsd:decimal(?spacing) / (2.0 * xsd:decimal(?b))
                    AS ?denominator
                )
                BIND (
                    (xsd:decimal(?thickness) * ?denominator /
                     (500.0 * xsd:decimal(?spacing))) *
                    (xsd:decimal(?thickness) * ?denominator /
                     (500.0 * xsd:decimal(?spacing)))
                    AS ?reportedSquaredRatio
                )
                BIND (
                    IF (
                        0.000002 * ABS(?expectedSquaredRatio) > 0.000000000001,
                        0.000002 * ABS(?expectedSquaredRatio),
                        0.000000000001
                    )
                    AS ?tolerance
                )
                FILTER (
                    xsd:decimal(?thickness) < 0.0 ||
                    ABS(?reportedSquaredRatio - ?expectedSquaredRatio) > ?tolerance
                )
            }
        """
    ] .
