@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_023_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Linked plating must provide a decimal framing angle in degrees to determine applicability." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?plating .
    ?plating a nltl:plating .
    FILTER NOT EXISTS {
        ?plating nltl:framingAngleOmega ?omegaQuantity .
        ?omegaQuantity a qudt:QuantityValue ;
            qudt:numericValue ?omega ;
            qudt:unit unit:DEG .
        FILTER(DATATYPE(?omega) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Applicable plating with Omega at most 20 degrees lacks valid formula inputs or a reported net thickness with the required units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?plating .
    ?plating a nltl:plating ;
        nltl:framingAngleOmega ?omegaQuantity .
    ?omegaQuantity a qudt:QuantityValue ;
        qudt:numericValue ?omega ;
        qudt:unit unit:DEG .
    FILTER(DATATYPE(?omega) = xsd:decimal && ?omega <= "20"^^xsd:decimal)

    FILTER NOT EXISTS {
        $this nltl:averageIcePressure ?averagePressureQuantity ;
            nltl:frameSpan ?spanQuantity ;
            nltl:hullAreaFactor ?hullAreaFactorQuantity ;
            nltl:loadPatchHeight ?patchHeightQuantity ;
            nltl:peakPressureFactor ?peakPressureFactorQuantity ;
            nltl:yieldStrength ?yieldStrengthQuantity ;
            nltl:hasStructuralMember ?member .

        ?member a nltl:structuralMember ;
            nltl:frameSpacing ?spacingQuantity ;
            nltl:selectedHullAreaFactor ?selectedAreaFactorQuantity .

        ?plating nltl:iceLoadRequiredNetPlateThickness ?thicknessQuantity .

        ?averagePressureQuantity a qudt:QuantityValue ;
            qudt:numericValue ?averagePressure ;
            qudt:unit unit:MegaPA .
        ?spanQuantity a qudt:QuantityValue ;
            qudt:numericValue ?span ;
            qudt:unit unit:M .
        ?hullAreaFactorQuantity a qudt:QuantityValue ;
            qudt:numericValue ?hullAreaFactor ;
            qudt:unit unit:UNITLESS .
        ?patchHeightQuantity a qudt:QuantityValue ;
            qudt:numericValue ?patchHeight ;
            qudt:unit unit:M .
        ?peakPressureFactorQuantity a qudt:QuantityValue ;
            qudt:numericValue ?peakPressureFactor ;
            qudt:unit unit:UNITLESS .
        ?yieldStrengthQuantity a qudt:QuantityValue ;
            qudt:numericValue ?yieldStrength ;
            qudt:unit unit:MegaPA .
        ?spacingQuantity a qudt:QuantityValue ;
            qudt:numericValue ?spacing ;
            qudt:unit unit:M .
        ?selectedAreaFactorQuantity a qudt:QuantityValue ;
            qudt:numericValue ?selectedAreaFactor ;
            qudt:unit unit:UNITLESS .
        ?thicknessQuantity a qudt:QuantityValue ;
            qudt:numericValue ?reportedThickness ;
            qudt:unit unit:MilliM .

        FILTER(
            DATATYPE(?averagePressure) = xsd:decimal &&
            DATATYPE(?span) = xsd:decimal &&
            DATATYPE(?hullAreaFactor) = xsd:decimal &&
            DATATYPE(?patchHeight) = xsd:decimal &&
            DATATYPE(?peakPressureFactor) = xsd:decimal &&
            DATATYPE(?yieldStrength) = xsd:decimal &&
            DATATYPE(?spacing) = xsd:decimal &&
            DATATYPE(?selectedAreaFactor) = xsd:decimal &&
            DATATYPE(?reportedThickness) = xsd:decimal &&
            ?yieldStrength != "0"^^xsd:decimal &&
            ?span != "0"^^xsd:decimal &&
            ("1"^^xsd:decimal + ?spacing / ("2"^^xsd:decimal * ?span)) != "0"^^xsd:decimal &&
            ((?selectedAreaFactor * ?peakPressureFactor * ?averagePressure) / ?yieldStrength) >= "0"^^xsd:decimal &&
            (
                ?patchHeight >= ?spacing ||
                (
                    ?spacing != "0"^^xsd:decimal &&
                    (
                        ("2"^^xsd:decimal * ?patchHeight / ?spacing) -
                        ((?patchHeight / ?spacing) * (?patchHeight / ?spacing))
                    ) >= "0"^^xsd:decimal
                )
            )
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Reported net plate thickness must match the applicable I2.4.2 formula within a relative tolerance of 1e-6 or an absolute fallback of 1e-12 mm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?plating .
    ?plating a nltl:plating ;
        nltl:framingAngleOmega ?omegaQuantity ;
        nltl:iceLoadRequiredNetPlateThickness ?thicknessQuantity .

    ?omegaQuantity a qudt:QuantityValue ;
        qudt:numericValue ?omega ;
        qudt:unit unit:DEG .
    ?thicknessQuantity a qudt:QuantityValue ;
        qudt:numericValue ?reportedThickness ;
        qudt:unit unit:MilliM .

    FILTER(
        DATATYPE(?omega) = xsd:decimal &&
        ?omega <= "20"^^xsd:decimal &&
        DATATYPE(?reportedThickness) = xsd:decimal
    )

    FILTER NOT EXISTS {
        $this nltl:averageIcePressure ?averagePressureQuantity ;
            nltl:frameSpan ?spanQuantity ;
            nltl:hullAreaFactor ?hullAreaFactorQuantity ;
            nltl:loadPatchHeight ?patchHeightQuantity ;
            nltl:peakPressureFactor ?peakPressureFactorQuantity ;
            nltl:yieldStrength ?yieldStrengthQuantity ;
            nltl:hasStructuralMember ?member .

        ?member a nltl:structuralMember ;
            nltl:frameSpacing ?spacingQuantity ;
            nltl:selectedHullAreaFactor ?selectedAreaFactorQuantity .

        ?averagePressureQuantity a qudt:QuantityValue ;
            qudt:numericValue ?averagePressure ;
            qudt:unit unit:MegaPA .
        ?spanQuantity a qudt:QuantityValue ;
            qudt:numericValue ?span ;
            qudt:unit unit:M .
        ?hullAreaFactorQuantity a qudt:QuantityValue ;
            qudt:numericValue ?hullAreaFactor ;
            qudt:unit unit:UNITLESS .
        ?patchHeightQuantity a qudt:QuantityValue ;
            qudt:numericValue ?patchHeight ;
            qudt:unit unit:M .
        ?peakPressureFactorQuantity a qudt:QuantityValue ;
            qudt:numericValue ?peakPressureFactor ;
            qudt:unit unit:UNITLESS .
        ?yieldStrengthQuantity a qudt:QuantityValue ;
            qudt:numericValue ?yieldStrength ;
            qudt:unit unit:MegaPA .
        ?spacingQuantity a qudt:QuantityValue ;
            qudt:numericValue ?spacing ;
            qudt:unit unit:M .
        ?selectedAreaFactorQuantity a qudt:QuantityValue ;
            qudt:numericValue ?selectedAreaFactor ;
            qudt:unit unit:UNITLESS .

        FILTER(
            DATATYPE(?averagePressure) = xsd:decimal &&
            DATATYPE(?span) = xsd:decimal &&
            DATATYPE(?hullAreaFactor) = xsd:decimal &&
            DATATYPE(?patchHeight) = xsd:decimal &&
            DATATYPE(?peakPressureFactor) = xsd:decimal &&
            DATATYPE(?yieldStrength) = xsd:decimal &&
            DATATYPE(?spacing) = xsd:decimal &&
            DATATYPE(?selectedAreaFactor) = xsd:decimal &&
            ?yieldStrength != "0"^^xsd:decimal &&
            ?span != "0"^^xsd:decimal &&
            ("1"^^xsd:decimal + ?spacing / ("2"^^xsd:decimal * ?span)) != "0"^^xsd:decimal &&
            ((?selectedAreaFactor * ?peakPressureFactor * ?averagePressure) / ?yieldStrength) >= "0"^^xsd:decimal &&
            (
                ?patchHeight >= ?spacing ||
                (
                    ?spacing != "0"^^xsd:decimal &&
                    (
                        ("2"^^xsd:decimal * ?patchHeight / ?spacing) -
                        ((?patchHeight / ?spacing) * (?patchHeight / ?spacing))
                    ) >= "0"^^xsd:decimal
                )
            )
        )

        BIND(
            IF(
                ?patchHeight >= ?spacing,
                "1"^^xsd:decimal,
                SQRT(
                    ("2"^^xsd:decimal * ?patchHeight / ?spacing) -
                    ((?patchHeight / ?spacing) * (?patchHeight / ?spacing))
                )
            ) AS ?patchFactor
        )
        BIND(
            (
                "500"^^xsd:decimal * ?spacing *
                SQRT((?selectedAreaFactor * ?peakPressureFactor * ?averagePressure) / ?yieldStrength) *
                ?patchFactor
            ) /
            (
                "1"^^xsd:decimal +
                ?spacing / ("2"^^xsd:decimal * ?span)
            ) AS ?expectedThickness
        )
        BIND(
            IF(
                ABS(?expectedThickness) * "0.000001"^^xsd:decimal > "0.000000000001"^^xsd:decimal,
                ABS(?expectedThickness) * "0.000001"^^xsd:decimal,
                "0.000000000001"^^xsd:decimal
            ) AS ?tolerance
        )
        FILTER(ABS(?reportedThickness - ?expectedThickness) <= ?tolerance)
    }
}
"""
    ] .
