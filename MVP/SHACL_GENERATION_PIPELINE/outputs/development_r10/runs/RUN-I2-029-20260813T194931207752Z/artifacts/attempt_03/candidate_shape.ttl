@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal quantity value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:MilliM ) ;
        sh:minCount 1 ;
        sh:message "The thickness unit must be millimetres."
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal quantity value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:M ) ;
        sh:minCount 1 ;
        sh:message "The thickness unit must be metres."
    ] .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal section modulus value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:CentiM3 ) ;
        sh:minCount 1 ;
        sh:message "The section modulus unit must be cubic centimetres."
    ] .

gen:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal shear area value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:in ( unit:M2 ) ;
        sh:minCount 1 ;
        sh:message "The shear area unit must be square metres."
    ] .

gen:StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node gen:MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Net web thickness is required for the framing member."
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node gen:MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Net attached shell plate thickness is required for the framing member."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:flangeFitted ;
                sh:datatype xsd:boolean ;
                sh:in ( false ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:flangeFitted ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:netFlangeThickness ;
                sh:node gen:MillimetreQuantityShape ;
                sh:minCount 1 ;
                sh:message "Net flange thickness is required when a flange is fitted."
            ]
        ]
    ) .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:attachedShellPlatingIncludedInSectionModulus ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "Attached shell plating must be included in the section modulus calculation."
    ] ;
    sh:property [
        sh:path nltl:attachedShellPlatingExcludedFromShearArea ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "Attached shell plating must be excluded from the shear area calculation."
    ] .

gen:I2_029_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "At least one framing member must be identified for the calculation."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node gen:CalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "A calculation case is required."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:message "Section modulus is required."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gen:ShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:message "Shear area is required."
    ] ;
    sh:property [
        sh:path nltl:thickness ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Thickness is required."
    ] .
