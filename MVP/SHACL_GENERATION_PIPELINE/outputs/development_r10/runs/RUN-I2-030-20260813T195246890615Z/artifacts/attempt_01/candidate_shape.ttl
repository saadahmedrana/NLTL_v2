@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MillimetreValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM
    ] .

gs:MetreValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gs:SquareCentimetreValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2
    ] .

gs:CubicCentimetreValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3
    ] .

gs:DegreeValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG
    ] .

gs:StructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node gs:MetreValueShape
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:node gs:MillimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node gs:MillimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:node gs:CubicCentimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:node gs:SquareCentimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:node gs:MillimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:node gs:DegreeValueShape
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:node gs:MillimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:node gs:MillimetreValueShape
    ] .

gs:PlatingShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node gs:DegreeValueShape
    ] .

gs:InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node gs:CubicCentimetreValueShape
    ] .

gs:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:node gs:MillimetreValueShape
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:minCount 1 ;
        sh:class nltl:interpolationPoint ;
        sh:node gs:InterpolationPointShape
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:minCount 1 ;
        sh:class nltl:interpolationPoint ;
        sh:node gs:InterpolationPointShape
    ] .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node gs:CalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node gs:CubicCentimetreValueShape
    ] ;
    sh:sparql [
        sh:message "The plastic neutral-axis height does not satisfy the applicable formula within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?member ;
                      nltl:hasCalculationCase ?case .
                ?member a nltl:structuralMember ;
                        nltl:netLocalFrameFlangeArea/qudt:numericValue ?afn ;
                        nltl:webHeight/qudt:numericValue ?hw ;
                        nltl:netWebThickness/qudt:numericValue ?twn ;
                        nltl:netAttachedShellPlateThickness/qudt:numericValue ?tpn ;
                        nltl:frameSpacing/qudt:numericValue ?spacing .
                ?case nltl:plasticNeutralAxisHeight/qudt:numericValue ?zna .
                FILTER (
                    xsd:decimal(?afn) >
                    (xsd:decimal("10") * xsd:decimal(?tpn) * xsd:decimal(?spacing))
                )
                BIND(
                    IF(
                        xsd:decimal(?twn) != xsd:decimal("0"),
                        (
                            xsd:decimal("100") * xsd:decimal(?afn) +
                            xsd:decimal(?hw) * xsd:decimal(?twn) -
                            xsd:decimal("1000") * xsd:decimal(?tpn) * xsd:decimal(?spacing)
                        ) / (xsd:decimal("2") * xsd:decimal(?twn)),
                        xsd:decimal("0")
                    )
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * xsd:decimal("0.000001") > xsd:decimal("0.000000001"),
                        ABS(?expected) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?tolerance
                )
                FILTER (
                    xsd:decimal(?twn) = xsd:decimal("0") ||
                    ABS(xsd:decimal(?zna) - ?expected) > ?tolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The net effective plastic section modulus does not satisfy the applicable formula within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 cm3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?member ;
                      nltl:hasCalculationCase ?case .
                ?member a nltl:structuralMember ;
                        nltl:netLocalFrameFlangeArea/qudt:numericValue ?afn ;
                        nltl:webHeight/qudt:numericValue ?hw ;
                        nltl:netWebThickness/qudt:numericValue ?twn ;
                        nltl:netAttachedShellPlateThickness/qudt:numericValue ?tpn ;
                        nltl:frameSpacing/qudt:numericValue ?spacing ;
                        nltl:webAngleToShellPlate/qudt:numericValue ?phi ;
                        nltl:localFrameFlangeCentreHeight/qudt:numericValue ?hfc ;
                        nltl:webToFlangeCentreDistance/qudt:numericValue ?bw ;
                        nltl:netEffectivePlasticSectionModulus/qudt:numericValue ?zp .
                ?case nltl:plasticNeutralAxisHeight/qudt:numericValue ?zna .
                FILTER (
                    xsd:decimal(?afn) >
                    (xsd:decimal("10") * xsd:decimal(?tpn) * xsd:decimal(?spacing))
                )
                BIND(
                    xsd:decimal(?phi) * xsd:decimal("0.017453292519943295")
                    AS ?phiRadians
                )
                BIND(
                    xsd:decimal(?tpn) * xsd:decimal(?spacing) *
                    (xsd:decimal(?zna) + xsd:decimal(?tpn) / xsd:decimal("2")) *
                    math:sin(?phiRadians)
                    +
                    (
                        (
                            (xsd:decimal(?hw) - xsd:decimal(?zna)) *
                            (xsd:decimal(?hw) - xsd:decimal(?zna))
                            +
                            xsd:decimal(?zna) * xsd:decimal(?zna)
                        ) *
                        xsd:decimal(?twn) *
                        math:sin(?phiRadians)
                    ) / xsd:decimal("2000")
                    +
                    xsd:decimal(?afn) *
                    (
                        (xsd:decimal(?hfc) - xsd:decimal(?zna)) *
                        math:sin(?phiRadians)
                        -
                        xsd:decimal(?bw) * math:cos(?phiRadians)
                    ) / xsd:decimal("10")
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * xsd:decimal("0.000001") > xsd:decimal("0.000000001"),
                        ABS(?expected) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?tolerance
                )
                FILTER (ABS(xsd:decimal(?zp) - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a framing angle strictly between 20 and 70 degrees, section modulus must be the linear interpolation between the case endpoints within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 cm3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?plating ;
                      nltl:hasCalculationCase ?case ;
                      nltl:sectionModulus/qudt:numericValue ?reported .
                ?plating a nltl:plating ;
                         nltl:framingAngleOmega/qudt:numericValue ?omega .
                ?case nltl:interpolationLowerEndpoint ?lower ;
                      nltl:interpolationUpperEndpoint ?upper .
                ?lower nltl:sectionModulus/qudt:numericValue ?lowerValue .
                ?upper nltl:sectionModulus/qudt:numericValue ?upperValue .
                FILTER (
                    xsd:decimal(?omega) > xsd:decimal("20") &&
                    xsd:decimal(?omega) < xsd:decimal("70")
                )
                BIND(
                    xsd:decimal(?lowerValue) +
                    (
                        (xsd:decimal(?omega) - xsd:decimal("20")) /
                        xsd:decimal("50")
                    ) *
                    (xsd:decimal(?upperValue) - xsd:decimal(?lowerValue))
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * xsd:decimal("0.000001") > xsd:decimal("0.000000001"),
                        ABS(?expected) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?tolerance
                )
                FILTER (ABS(xsd:decimal(?reported) - ?expected) > ?tolerance)
            }
        """
    ] .
