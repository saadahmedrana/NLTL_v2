@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2_030_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable calculation record must provide framingAngleOmega in degrees to select the direct or interpolation branch." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?record
WHERE {
    $this nltl:hasComponent ?record ;
          nltl:hasCalculationCase ?record .
    ?record a nltl:structuralMember, nltl:plating, nltl:calculationCase ;
            nltl:netLocalFrameFlangeArea ?area ;
            nltl:netAttachedShellPlateThickness ?plateThickness ;
            nltl:frameSpacing ?spacing .
    ?area qudt:numericValue ?areaValue ;
          qudt:unit unit:CentiM2 .
    ?plateThickness qudt:numericValue ?plateThicknessValue ;
                    qudt:unit unit:MilliM .
    ?spacing qudt:numericValue ?spacingValue ;
             qudt:unit unit:M .
    FILTER(
        datatype(?areaValue) = xsd:decimal &&
        datatype(?plateThicknessValue) = xsd:decimal &&
        datatype(?spacingValue) = xsd:decimal &&
        (100 * ?areaValue) > (1000 * ?plateThicknessValue * ?spacingValue)
    )
    FILTER NOT EXISTS {
        ?record nltl:framingAngleOmega ?omega .
        ?omega qudt:numericValue ?omegaValue ;
               qudt:unit unit:DEG .
        FILTER(datatype(?omegaValue) = xsd:decimal)
    }
}
""" ;
    ] ;
    sh:sparql [
        sh:message "An applicable direct-formula record is missing a required decimal operand, result, or prescribed unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?record
WHERE {
    $this nltl:hasComponent ?record ;
          nltl:hasCalculationCase ?record .
    ?record a nltl:structuralMember, nltl:plating, nltl:calculationCase ;
            nltl:netLocalFrameFlangeArea ?area ;
            nltl:netAttachedShellPlateThickness ?plateThickness ;
            nltl:frameSpacing ?spacing ;
            nltl:framingAngleOmega ?omega .
    ?area qudt:numericValue ?areaValue ;
          qudt:unit unit:CentiM2 .
    ?plateThickness qudt:numericValue ?plateThicknessValue ;
                    qudt:unit unit:MilliM .
    ?spacing qudt:numericValue ?spacingValue ;
             qudt:unit unit:M .
    ?omega qudt:numericValue ?omegaValue ;
           qudt:unit unit:DEG .
    FILTER(
        datatype(?areaValue) = xsd:decimal &&
        datatype(?plateThicknessValue) = xsd:decimal &&
        datatype(?spacingValue) = xsd:decimal &&
        datatype(?omegaValue) = xsd:decimal &&
        (100 * ?areaValue) > (1000 * ?plateThicknessValue * ?spacingValue) &&
        (?omegaValue <= 20 || ?omegaValue >= 70)
    )
    FILTER NOT EXISTS {
        ?record nltl:localFrameFlangeCentreHeight ?flangeHeight ;
                nltl:netWebThickness ?webThickness ;
                nltl:plasticNeutralAxisHeight ?neutralAxis ;
                nltl:webAngleToShellPlate ?webAngle ;
                nltl:webHeight ?webHeight ;
                nltl:webToFlangeCentreDistance ?flangeDistance ;
                nltl:netEffectivePlasticSectionModulus ?plasticModulus .
        ?flangeHeight qudt:numericValue ?flangeHeightValue ;
                      qudt:unit unit:MilliM .
        ?webThickness qudt:numericValue ?webThicknessValue ;
                      qudt:unit unit:MilliM .
        ?neutralAxis qudt:numericValue ?neutralAxisValue ;
                     qudt:unit unit:MilliM .
        ?webAngle qudt:numericValue ?webAngleValue ;
                  qudt:unit unit:DEG .
        ?webHeight qudt:numericValue ?webHeightValue ;
                   qudt:unit unit:MilliM .
        ?flangeDistance qudt:numericValue ?flangeDistanceValue ;
                        qudt:unit unit:MilliM .
        ?plasticModulus qudt:numericValue ?plasticModulusValue ;
                        qudt:unit unit:CentiM3 .
        FILTER(
            datatype(?flangeHeightValue) = xsd:decimal &&
            datatype(?webThicknessValue) = xsd:decimal &&
            datatype(?neutralAxisValue) = xsd:decimal &&
            datatype(?webAngleValue) = xsd:decimal &&
            datatype(?webHeightValue) = xsd:decimal &&
            datatype(?flangeDistanceValue) = xsd:decimal &&
            datatype(?plasticModulusValue) = xsd:decimal &&
            ?webThicknessValue != 0
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        sh:message "An applicable oblique-framing record is missing required operands, results, interpolation endpoints, or prescribed units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?record
WHERE {
    $this nltl:hasComponent ?record ;
          nltl:hasCalculationCase ?record .
    ?record a nltl:structuralMember, nltl:plating, nltl:calculationCase ;
            nltl:netLocalFrameFlangeArea ?area ;
            nltl:netAttachedShellPlateThickness ?plateThickness ;
            nltl:frameSpacing ?spacing ;
            nltl:framingAngleOmega ?omega .
    ?area qudt:numericValue ?areaValue ;
          qudt:unit unit:CentiM2 .
    ?plateThickness qudt:numericValue ?plateThicknessValue ;
                    qudt:unit unit:MilliM .
    ?spacing qudt:numericValue ?spacingValue ;
             qudt:unit unit:M .
    ?omega qudt:numericValue ?omegaValue ;
           qudt:unit unit:DEG .
    FILTER(
        datatype(?areaValue) = xsd:decimal &&
        datatype(?plateThicknessValue) = xsd:decimal &&
        datatype(?spacingValue) = xsd:decimal &&
        datatype(?omegaValue) = xsd:decimal &&
        (100 * ?areaValue) > (1000 * ?plateThicknessValue * ?spacingValue) &&
        ?omegaValue > 20 &&
        ?omegaValue < 70
    )
    FILTER NOT EXISTS {
        ?record nltl:localFrameFlangeCentreHeight ?flangeHeight ;
                nltl:netWebThickness ?webThickness ;
                nltl:plasticNeutralAxisHeight ?neutralAxis ;
                nltl:webAngleToShellPlate ?webAngle ;
                nltl:webHeight ?webHeight ;
                nltl:webToFlangeCentreDistance ?flangeDistance ;
                nltl:netEffectivePlasticSectionModulus ?plasticModulus ;
                nltl:interpolationLowerEndpoint ?lowerEndpoint ;
                nltl:interpolationUpperEndpoint ?upperEndpoint .
        ?flangeHeight qudt:numericValue ?flangeHeightValue ;
                      qudt:unit unit:MilliM .
        ?webThickness qudt:numericValue ?webThicknessValue ;
                      qudt:unit unit:MilliM .
        ?neutralAxis qudt:numericValue ?neutralAxisValue ;
                     qudt:unit unit:MilliM .
        ?webAngle qudt:numericValue ?webAngleValue ;
                  qudt:unit unit:DEG .
        ?webHeight qudt:numericValue ?webHeightValue ;
                   qudt:unit unit:MilliM .
        ?flangeDistance qudt:numericValue ?flangeDistanceValue ;
                        qudt:unit unit:MilliM .
        ?plasticModulus qudt:numericValue ?plasticModulusValue ;
                        qudt:unit unit:CentiM3 .
        ?lowerEndpoint a nltl:interpolationPoint, nltl:plating ;
                       nltl:framingAngleOmega ?lowerAngle ;
                       nltl:sectionModulus ?lowerModulus .
        ?upperEndpoint a nltl:interpolationPoint, nltl:plating ;
                       nltl:framingAngleOmega ?upperAngle ;
                       nltl:sectionModulus ?upperModulus .
        ?lowerAngle qudt:numericValue ?lowerAngleValue ;
                    qudt:unit unit:DEG .
        ?upperAngle qudt:numericValue ?upperAngleValue ;
                    qudt:unit unit:DEG .
        ?lowerModulus qudt:numericValue ?lowerModulusValue ;
                      qudt:unit unit:CentiM3 .
        ?upperModulus qudt:numericValue ?upperModulusValue ;
                      qudt:unit unit:CentiM3 .
        FILTER(
            datatype(?flangeHeightValue) = xsd:decimal &&
            datatype(?webThicknessValue) = xsd:decimal &&
            datatype(?neutralAxisValue) = xsd:decimal &&
            datatype(?webAngleValue) = xsd:decimal &&
            datatype(?webHeightValue) = xsd:decimal &&
            datatype(?flangeDistanceValue) = xsd:decimal &&
            datatype(?plasticModulusValue) = xsd:decimal &&
            datatype(?lowerAngleValue) = xsd:decimal &&
            datatype(?upperAngleValue) = xsd:decimal &&
            datatype(?lowerModulusValue) = xsd:decimal &&
            datatype(?upperModulusValue) = xsd:decimal &&
            ?webThicknessValue != 0 &&
            ?lowerAngleValue < ?omegaValue &&
            ?omegaValue < ?upperAngleValue
        )
    }
}
""" ;
    ] ;
    sh:sparql [
        sh:message "plasticNeutralAxisHeight does not satisfy the required formula within a relative tolerance of 1e-6." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?record
WHERE {
    $this nltl:hasComponent ?record ;
          nltl:hasCalculationCase ?record .
    ?record a nltl:structuralMember, nltl:calculationCase ;
            nltl:netLocalFrameFlangeArea ?area ;
            nltl:netAttachedShellPlateThickness ?plateThickness ;
            nltl:frameSpacing ?spacing ;
            nltl:webHeight ?webHeight ;
            nltl:netWebThickness ?webThickness ;
            nltl:plasticNeutralAxisHeight ?neutralAxis .
    ?area qudt:numericValue ?areaValue ;
          qudt:unit unit:CentiM2 .
    ?plateThickness qudt:numericValue ?plateThicknessValue ;
                    qudt:unit unit:MilliM .
    ?spacing qudt:numericValue ?spacingValue ;
             qudt:unit unit:M .
    ?webHeight qudt:numericValue ?webHeightValue ;
               qudt:unit unit:MilliM .
    ?webThickness qudt:numericValue ?webThicknessValue ;
                  qudt:unit unit:MilliM .
    ?neutralAxis qudt:numericValue ?neutralAxisValue ;
                 qudt:unit unit:MilliM .
    FILTER(
        datatype(?areaValue) = xsd:decimal &&
        datatype(?plateThicknessValue) = xsd:decimal &&
        datatype(?spacingValue) = xsd:decimal &&
        datatype(?webHeightValue) = xsd:decimal &&
        datatype(?webThicknessValue) = xsd:decimal &&
        datatype(?neutralAxisValue) = xsd:decimal &&
        ?webThicknessValue != 0 &&
        (100 * ?areaValue) > (1000 * ?plateThicknessValue * ?spacingValue)
    )
    BIND(
        ((100 * ?areaValue) +
         (?webHeightValue * ?webThicknessValue) -
         (1000 * ?plateThicknessValue * ?spacingValue)) /
        (2 * ?webThicknessValue)
        AS ?expectedNeutralAxis
    )
    BIND(
        IF(
            ABS(?expectedNeutralAxis) * 0.000001 > 0.000000001,
            ABS(?expectedNeutralAxis) * 0.000001,
            0.000000001
        )
        AS ?neutralAxisTolerance
    )
    FILTER(ABS(?neutralAxisValue - ?expectedNeutralAxis) > ?neutralAxisTolerance)
}
""" ;
    ] ;
    sh:sparql [
        sh:message "netEffectivePlasticSectionModulus does not satisfy the direct formula within a relative tolerance of 1e-6." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
SELECT $this ?record
WHERE {
    $this nltl:hasComponent ?record ;
          nltl:hasCalculationCase ?record .
    ?record a nltl:structuralMember, nltl:plating, nltl:calculationCase ;
            nltl:frameSpacing ?spacing ;
            nltl:framingAngleOmega ?omega ;
            nltl:localFrameFlangeCentreHeight ?flangeHeight ;
            nltl:netAttachedShellPlateThickness ?plateThickness ;
            nltl:netEffectivePlasticSectionModulus ?plasticModulus ;
            nltl:netLocalFrameFlangeArea ?area ;
            nltl:netWebThickness ?webThickness ;
            nltl:plasticNeutralAxisHeight ?neutralAxis ;
            nltl:webAngleToShellPlate ?webAngle ;
            nltl:webHeight ?webHeight ;
            nltl:webToFlangeCentreDistance ?flangeDistance .
    ?spacing qudt:numericValue ?spacingValue ;
             qudt:unit unit:M .
    ?omega qudt:numericValue ?omegaValue ;
           qudt:unit unit:DEG .
    ?flangeHeight qudt:numericValue ?flangeHeightValue ;
                  qudt:unit unit:MilliM .
    ?plateThickness qudt:numericValue ?plateThicknessValue ;
                    qudt:unit unit:MilliM .
    ?plasticModulus qudt:numericValue ?plasticModulusValue ;
                    qudt:unit unit:CentiM3 .
    ?area qudt:numericValue ?areaValue ;
          qudt:unit unit:CentiM2 .
    ?webThickness qudt:numericValue ?webThicknessValue ;
                  qudt:unit unit:MilliM .
    ?neutralAxis qudt:numericValue ?neutralAxisValue ;
                 qudt:unit unit:MilliM .
    ?webAngle qudt:numericValue ?webAngleValue ;
              qudt:unit unit:DEG .
    ?webHeight qudt:numericValue ?webHeightValue ;
               qudt:unit unit:MilliM .
    ?flangeDistance qudt:numericValue ?flangeDistanceValue ;
                    qudt:unit unit:MilliM .
    FILTER(
        datatype(?spacingValue) = xsd:decimal &&
        datatype(?omegaValue) = xsd:decimal &&
        datatype(?flangeHeightValue) = xsd:decimal &&
        datatype(?plateThicknessValue) = xsd:decimal &&
        datatype(?plasticModulusValue) = xsd:decimal &&
        datatype(?areaValue) = xsd:decimal &&
        datatype(?webThicknessValue) = xsd:decimal &&
        datatype(?neutralAxisValue) = xsd:decimal &&
        datatype(?webAngleValue) = xsd:decimal &&
        datatype(?webHeightValue) = xsd:decimal &&
        datatype(?flangeDistanceValue) = xsd:decimal &&
        (100 * ?areaValue) > (1000 * ?plateThicknessValue * ?spacingValue) &&
        (?omegaValue <= 20 || ?omegaValue >= 70)
    )
    BIND((?webAngleValue * 0.017453292519943295) AS ?webAngleRadians)
    BIND(math:sin(?webAngleRadians) AS ?sinWebAngle)
    BIND(math:cos(?webAngleRadians) AS ?cosWebAngle)
    BIND(
        (?plateThicknessValue * ?spacingValue *
            (?neutralAxisValue + (?plateThicknessValue / 2)) *
            ?sinWebAngle)
        +
        (((((?webHeightValue - ?neutralAxisValue) *
             (?webHeightValue - ?neutralAxisValue)) +
            (?neutralAxisValue * ?neutralAxisValue)) *
           ?webThicknessValue * ?sinWebAngle) / 2000)
        +
        (?areaValue *
            (((?flangeHeightValue - ?neutralAxisValue) * ?sinWebAngle) -
             (?flangeDistanceValue * ?cosWebAngle)) / 10)
        AS ?expectedPlasticModulus
    )
    BIND(
        IF(
            ABS(?expectedPlasticModulus) * 0.000001 > 0.000000001,
            ABS(?expectedPlasticModulus) * 0.000001,
            0.000000001
        )
        AS ?plasticModulusTolerance
    )
    FILTER(
        ABS(?plasticModulusValue - ?expectedPlasticModulus) >
        ?plasticModulusTolerance
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "The oblique-framing section modulus is not the linear interpolation between its case endpoints within a relative tolerance of 1e-6." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?record
WHERE {
    $this nltl:hasComponent ?record ;
          nltl:hasCalculationCase ?record .
    ?record a nltl:structuralMember, nltl:plating, nltl:calculationCase ;
            nltl:netLocalFrameFlangeArea ?area ;
            nltl:netAttachedShellPlateThickness ?plateThickness ;
            nltl:frameSpacing ?spacing ;
            nltl:framingAngleOmega ?omega ;
            nltl:netEffectivePlasticSectionModulus ?plasticModulus ;
            nltl:interpolationLowerEndpoint ?lowerEndpoint ;
            nltl:interpolationUpperEndpoint ?upperEndpoint .
    ?area qudt:numericValue ?areaValue ;
          qudt:unit unit:CentiM2 .
    ?plateThickness qudt:numericValue ?plateThicknessValue ;
                    qudt:unit unit:MilliM .
    ?spacing qudt:numericValue ?spacingValue ;
             qudt:unit unit:M .
    ?omega qudt:numericValue ?omegaValue ;
           qudt:unit unit:DEG .
    ?plasticModulus qudt:numericValue ?plasticModulusValue ;
                    qudt:unit unit:CentiM3 .
    ?lowerEndpoint a nltl:interpolationPoint, nltl:plating ;
                   nltl:framingAngleOmega ?lowerAngle ;
                   nltl:sectionModulus ?lowerModulus .
    ?upperEndpoint a nltl:interpolationPoint, nltl:plating ;
                   nltl:framingAngleOmega ?upperAngle ;
                   nltl:sectionModulus ?upperModulus .
    ?lowerAngle qudt:numericValue ?lowerAngleValue ;
                qudt:unit unit:DEG .
    ?upperAngle qudt:numericValue ?upperAngleValue ;
                qudt:unit unit:DEG .
    ?lowerModulus qudt:numericValue ?lowerModulusValue ;
                  qudt:unit unit:CentiM3 .
    ?upperModulus qudt:numericValue ?upperModulusValue ;
                  qudt:unit unit:CentiM3 .
    FILTER(
        datatype(?areaValue) = xsd:decimal &&
        datatype(?plateThicknessValue) = xsd:decimal &&
        datatype(?spacingValue) = xsd:decimal &&
        datatype(?omegaValue) = xsd:decimal &&
        datatype(?plasticModulusValue) = xsd:decimal &&
        datatype(?lowerAngleValue) = xsd:decimal &&
        datatype(?upperAngleValue) = xsd:decimal &&
        datatype(?lowerModulusValue) = xsd:decimal &&
        datatype(?upperModulusValue) = xsd:decimal &&
        (100 * ?areaValue) > (1000 * ?plateThicknessValue * ?spacingValue) &&
        ?omegaValue > 20 &&
        ?omegaValue < 70 &&
        ?lowerAngleValue < ?omegaValue &&
        ?omegaValue < ?upperAngleValue
    )
    BIND(
        ?lowerModulusValue +
        ((?omegaValue - ?lowerAngleValue) *
         (?upperModulusValue - ?lowerModulusValue) /
         (?upperAngleValue - ?lowerAngleValue))
        AS ?expectedPlasticModulus
    )
    BIND(
        IF(
            ABS(?expectedPlasticModulus) * 0.000001 > 0.000000001,
            ABS(?expectedPlasticModulus) * 0.000001,
            0.000000001
        )
        AS ?interpolationTolerance
    )
    FILTER(
        ABS(?plasticModulusValue - ?expectedPlasticModulus) >
        ?interpolationTolerance
    )
}
""" ;
    ] .
