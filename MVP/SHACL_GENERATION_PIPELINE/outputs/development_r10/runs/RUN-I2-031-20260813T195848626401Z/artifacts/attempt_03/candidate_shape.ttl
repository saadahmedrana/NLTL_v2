@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ForceQuantityValueShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1
    ] .

gen:StructuralMemberEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:structuralLocationValue
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:node gen:ForceQuantityValueShape
    ] .

gen:I2_031_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:StructuralMemberEvidenceShape
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node gen:ForceQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:patchLoad ;
        sh:node gen:ForceQuantityValueShape
    ] ;
    sh:property [
        sh:path nltl:plasticCollapseMechanism ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A linked local frame requires structural-location information to determine applicability." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame .
    FILTER NOT EXISTS {
        ?member nltl:structuralLocation ?location .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable bottom or side local frame requires a midspan plastic-collapse load in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
            nltl:structuralLocation ?location .
    FILTER (
        ?location IN (
            nltl:bottomStructureLocation,
            nltl:sideStructureLocation
        )
    )
    FILTER NOT EXISTS {
        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
        ?collapseLoad qudt:numericValue ?collapseValue ;
                      qudt:unit unit:KiloN .
        FILTER(datatype(?collapseValue) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with an applicable bottom or side local frame requires a plastic-strength value in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
            nltl:structuralLocation ?location .
    FILTER (
        ?location IN (
            nltl:bottomStructureLocation,
            nltl:sideStructureLocation
        )
    )
    FILTER NOT EXISTS {
        $this nltl:plasticStrength ?strength .
        ?strength qudt:numericValue ?strengthValue ;
                  qudt:unit unit:KiloN .
        FILTER(datatype(?strengthValue) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with an applicable bottom or side local frame requires plastic-collapse-mechanism evidence." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
            nltl:structuralLocation ?location .
    FILTER (
        ?location IN (
            nltl:bottomStructureLocation,
            nltl:sideStructureLocation
        )
    )
    FILTER NOT EXISTS {
        $this nltl:plasticCollapseMechanism ?mechanism .
        FILTER(datatype(?mechanism) = xsd:string)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with an applicable bottom local frame requires patch-load evidence in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
            nltl:structuralLocation nltl:bottomStructureLocation .
    FILTER NOT EXISTS {
        $this nltl:patchLoad ?patchLoad .
        ?patchLoad qudt:numericValue ?patchValue ;
                   qudt:unit unit:KiloN .
        FILTER(datatype(?patchValue) = xsd:decimal)
    }
}
"""
    ] .
