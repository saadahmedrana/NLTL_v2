@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarClassCorrosionAbrasionAdditionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:class nltl:polarClassValue ;
                sh:minCount 1 ;
                sh:message "Polar Class applicability must be identified by a Polar Class value."
            ] ;
            sh:property [
                sh:path nltl:hasInternalIceStrengthenedStructure ;
                sh:class nltl:internalIceStrengthenedStructure ;
                sh:message "Linked internal ice-strengthened structures must have the canonical structure class."
            ] ;
            sh:property [
                sh:path nltl:corrosionAbrasionAddition ;
                sh:minCount 1 ;
                sh:node gen:MinimumCorrosionAbrasionAdditionValueShape ;
                sh:message "A Polar Class ship must have a corrosion/abrasion addition of at least 1.0 mm."
            ]
        ]
    ) .

gen:MinimumCorrosionAbrasionAdditionValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:message "The corrosion/abrasion addition must be at least 1.0 mm."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:MilliM ) ;
        sh:message "The corrosion/abrasion addition must be expressed in millimetres."
    ] .
