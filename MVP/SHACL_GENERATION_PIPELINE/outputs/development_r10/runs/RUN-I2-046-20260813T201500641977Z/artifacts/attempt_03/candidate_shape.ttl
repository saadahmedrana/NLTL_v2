@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarClassCorrosionAbrasionAdditionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasInternalIceStrengthenedStructure ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:internalIceStrengthenedStructure ;
        sh:message "Every linked internal ice-strengthened structure must be identified as an internal ice-strengthened structure."
    ] ;
    sh:sparql [
        sh:message "A Polar Class ship must have a ship-owned corrosion/abrasion addition of at least 1.0 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:polarClass ?polarClass .
                FILTER NOT EXISTS {
                    $this nltl:corrosionAbrasionAddition ?addition .
                    ?addition qudt:numericValue ?value ;
                              qudt:unit unit:MilliM .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value >= "1.0"^^xsd:decimal
                    )
                }
            }
        """
    ] .
