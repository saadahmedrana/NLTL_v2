@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "Polar Class is required for the Table 8 lookup."
    ] ;
    sh:property [
        sh:path nltl:materialClass ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Material class is required for the Table 8 lookup."
    ] ;
    sh:property [
        sh:path nltl:asBuiltThickness ;
        sh:minCount 1 ;
        sh:node gen:I2_048_AsBuiltThicknessShape ;
        sh:message "As-built thickness in metres is required."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:minCount 1 ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node gen:I2_048_SteelGradeCaseShape ;
        sh:equals nltl:hasTableLookupCase ;
        sh:message "Each steel-grade requirement case must be the corresponding Table 8 lookup case."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:I2_048_TableLookupCaseShape ;
        sh:message "A Table 8 lookup case is required."
    ] ;
    sh:sparql [
        sh:message "The actual hull structural steel grade must not rank below the required Table 8 grade." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasSteelGradeRequirementCase ?case .
                ?case nltl:actualHullStructuralSteelGrade ?actualGrade ;
                      nltl:requiredHullStructuralSteelGrade ?requiredGrade .
                ?actualGrade nltl:steelGradeOrderRank ?actualRank .
                ?requiredGrade nltl:steelGradeOrderRank ?requiredRank .
                FILTER (?actualRank < ?requiredRank)
            }
        """
    ] .

gen:I2_048_AsBuiltThicknessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:I2_048_SteelGradeCaseShape
    a sh:NodeShape ;
    sh:class nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:minCount 1 ;
        sh:node gen:I2_048_AsBuiltPlateThicknessShape ;
        sh:message "As-built plate thickness in millimetres is required for the Table 8 lookup."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:minCount 1 ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:message "Steel material class must be class one, two, or three."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:minCount 1 ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:message "Steel strength category must be normal strength or high tensile."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:class nltl:steelGradeValue ;
        sh:node gen:I2_048_SteelGradeValueShape ;
        sh:message "The actual hull structural steel grade and its order rank are required."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:class nltl:steelGradeValue ;
        sh:node gen:I2_048_SteelGradeValueShape ;
        sh:message "The required Table 8 steel grade and its order rank are required."
    ] .

gen:I2_048_AsBuiltPlateThicknessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

gen:I2_048_SteelGradeValueShape
    a sh:NodeShape ;
    sh:class nltl:steelGradeValue ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:minCount 1 ;
        sh:datatype xsd:integer
    ] .

gen:I2_048_TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:class nltl:tableReferenceValue ;
        sh:message "The steel-grade lookup must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Evidence of the Table 8 selection is required."
    ] .
