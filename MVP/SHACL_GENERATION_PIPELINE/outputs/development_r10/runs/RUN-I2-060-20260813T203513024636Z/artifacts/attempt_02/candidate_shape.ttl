@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2-060-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember
    ] ;
    sh:property [
        sh:path (
            nltl:hasStructuralMember
            nltl:hasCutout
        ) ;
        sh:class nltl:cutout ;
        sh:minCount 1 ;
        sh:message "A structural member in way of a cutout must be identified."
    ] ;
    sh:property [
        sh:path nltl:memberInstability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false ) ;
        sh:message "Loads carried by a member in way of a cutout must not cause instability."
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each cutout-linked structural member must be identified as being in way of a cutout." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER (
        NOT EXISTS {
            ?member nltl:memberInWayOfCutout true .
        }
        ||
        EXISTS {
            ?member nltl:memberInWayOfCutout ?inWay .
            FILTER (
                !isLiteral(?inWay)
                || datatype(?inWay) != xsd:boolean
                || ?inWay != true
            )
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each cutout-linked structural member must state whether stiffening is necessary." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER (
        NOT EXISTS {
            ?member nltl:stiffeningNecessary ?necessary .
            FILTER (
                isLiteral(?necessary)
                && datatype(?necessary) = xsd:boolean
            )
        }
        ||
        EXISTS {
            ?member nltl:stiffeningNecessary ?invalidNecessary .
            FILTER (
                !isLiteral(?invalidNecessary)
                || datatype(?invalidNecessary) != xsd:boolean
            )
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Structural stiffening evidence is required when stiffening is necessary." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout ;
            nltl:stiffeningNecessary true .
    FILTER NOT EXISTS {
        $this nltl:structuralStiffening ?evidence .
        FILTER (
            isLiteral(?evidence)
            && datatype(?evidence) = xsd:string
        )
    }
}
"""
    ] .
