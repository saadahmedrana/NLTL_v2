@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2-060-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked structural member with a cutout must be identified as being in way of the cutout." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER NOT EXISTS {
        ?member nltl:memberInWayOfCutout ?inWay .
        FILTER(
            DATATYPE(?inWay) = xsd:boolean &&
            ?inWay = true
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Loads carried by a structural member in way of a cutout must be recorded as not causing instability." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout ;
            nltl:memberInWayOfCutout ?inWay .
    FILTER(
        DATATYPE(?inWay) = xsd:boolean &&
        ?inWay = true
    )
    FILTER NOT EXISTS {
        $this nltl:memberInstability ?instability .
        FILTER(
            DATATYPE(?instability) = xsd:boolean &&
            ?instability = false
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A valid stiffening-necessity decision is required when a linked structural member is in way of a cutout." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout ;
            nltl:memberInWayOfCutout ?inWay .
    FILTER(
        DATATYPE(?inWay) = xsd:boolean &&
        ?inWay = true
    )
    FILTER NOT EXISTS {
        $this nltl:stiffeningNecessary ?necessary .
        FILTER(
            DATATYPE(?necessary) = xsd:boolean &&
            (?necessary = true || ?necessary = false)
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Structural stiffening evidence is required when stiffening is necessary." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:stiffeningNecessary ?necessary .
    ?member nltl:hasCutout ?cutout ;
            nltl:memberInWayOfCutout ?inWay .
    FILTER(
        DATATYPE(?inWay) = xsd:boolean &&
        ?inWay = true &&
        DATATYPE(?necessary) = xsd:boolean &&
        ?necessary = true
    )
    FILTER NOT EXISTS {
        $this nltl:structuralStiffening ?evidence .
        FILTER(DATATYPE(?evidence) = xsd:string)
    }
}
"""
    ] .
