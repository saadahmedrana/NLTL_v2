@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:NonlinearAnalysisReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each nonlinear calculation case must provide acceptance evidence and the required margin, deformation, and structural-dimension quantities with canonical units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER NOT EXISTS {
                    ?case rdf:type nltl:calculationCase ;
                          nltl:nonlinearAnalysisAcceptanceEvidence ?evidence ;
                          nltl:permanentLateralDeformation ?lateral ;
                          nltl:permanentOutOfPlaneDeformation ?outOfPlane ;
                          nltl:relevantStructuralDimension ?dimension .
                    ?evidence rdf:type nltl:evidenceArtifact .
                    $this nltl:fractureMargin ?fracture ;
                          nltl:majorBucklingMargin ?buckling ;
                          nltl:yieldingMargin ?yielding .
                    ?fracture rdf:type qudt:QuantityValue ;
                              qudt:numericValue ?fractureValue ;
                              qudt:unit unit:UNITLESS .
                    ?buckling rdf:type qudt:QuantityValue ;
                              qudt:numericValue ?bucklingValue ;
                              qudt:unit unit:UNITLESS .
                    ?yielding rdf:type qudt:QuantityValue ;
                              qudt:numericValue ?yieldingValue ;
                              qudt:unit unit:UNITLESS .
                    ?lateral rdf:type qudt:QuantityValue ;
                             qudt:numericValue ?lateralValue ;
                             qudt:unit unit:MilliM .
                    ?outOfPlane rdf:type qudt:QuantityValue ;
                                qudt:numericValue ?outOfPlaneValue ;
                                qudt:unit unit:MilliM .
                    ?dimension rdf:type qudt:QuantityValue ;
                               qudt:numericValue ?dimensionValue ;
                               qudt:unit unit:MilliM .
                    FILTER (
                        datatype(?fractureValue) = xsd:decimal &&
                        datatype(?bucklingValue) = xsd:decimal &&
                        datatype(?yieldingValue) = xsd:decimal &&
                        datatype(?lateralValue) = xsd:decimal &&
                        datatype(?outOfPlaneValue) = xsd:decimal &&
                        datatype(?dimensionValue) = xsd:decimal
                    )
                }
            }
        """
    ] .
