@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarShipCertificateScheduleShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCertificateForm ;
        sh:node [
            a sh:NodeShape ;
            sh:class nltl:requiredEquipmentRecords
        ] ;
        sh:message "A Polar Ship Certificate with required equipment records is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:minCount 1 ;
        sh:class nltl:solasCertificateSchedule ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:hasCertificateScheduleDateRecord ;
                sh:minCount 1 ;
                sh:class nltl:certificateScheduleDateRecord ;
                sh:message "The SOLAS certificate schedule requires a certificate schedule date record."
            ]
        ] ;
        sh:message "The applicable SOLAS certificate schedule is required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate validity dates are required."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate survey dates are required."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate endorsement dates are required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate supplement must be present."
    ] .
