@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO037Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:alternativeInstrumentApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "Alternative-instrument applicability must be recorded for an applicable ship."
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionCase ;
                sh:class nltl:loadingConditionCase ;
                sh:node gen:LoadingConditionComplianceCaseShape
            ]
        ]
    ) .

gen:LoadingConditionComplianceCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadingConditionIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Each loading-condition case must have an identifier."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasLoadingConditionCase ]
                    nltl:residualStabilityFactorSI
                ) ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "0.999999"^^xsd:decimal ;
                        sh:maxInclusive "1.000001"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:message "The residual stability factor must be within 1e-6 of 1."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:message "The residual stability factor must use the unitless unit."
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasLoadingConditionCase ]
                    nltl:alternativeInstrumentApplicable
                ) ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "The alternative route requires recorded applicability."
            ] ;
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasLoadingConditionCase ]
                    nltl:alternativeInstrumentResidualStabilityStatus
                ) ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "The alternative residual-stability status must be compliant."
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionResultEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Each alternative-route loading condition requires result evidence."
            ]
        ]
    ) .
