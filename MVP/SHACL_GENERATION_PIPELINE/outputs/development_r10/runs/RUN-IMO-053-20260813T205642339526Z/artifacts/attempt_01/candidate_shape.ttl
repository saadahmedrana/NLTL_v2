@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:ExtinguishingMediumCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:node gen:ExtinguishingMediumItemShape
    ] .

gen:ExtinguishingMediumItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extinguishingMediumCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each linked extinguishing medium shall be approved as compatible with the intended operation."
    ] .
