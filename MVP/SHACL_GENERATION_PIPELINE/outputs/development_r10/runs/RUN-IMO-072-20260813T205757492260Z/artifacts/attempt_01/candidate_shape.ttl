@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO072ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:lifeboat ;
                sh:node gen:IMO072LifeboatShape ;
                sh:message "Each linked lifeboat must have an assigned searchlight suitable for continuous use."
            ]
        ]
    ) .

gen:IMO072LifeboatShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:class nltl:searchlight ;
            sh:property [
                sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The lifeboat must have at least one assigned searchlight approved as suitable for continuous use."
    ] .
