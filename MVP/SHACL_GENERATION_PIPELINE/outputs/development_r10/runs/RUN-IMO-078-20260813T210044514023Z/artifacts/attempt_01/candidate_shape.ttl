@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPassenger ;
        sh:class nltl:passenger
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:class nltl:crewMember
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasPassenger ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasPassenger ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:passengerInstructionStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Passenger survival-equipment instruction status must be completed when passengers are present."
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasCrewMemberInventory ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasCrewMemberInventory ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:crewSurvivalEquipmentTrainingStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Crew survival-equipment training status must be completed when crew members are present."
            ]
        ]
    ) .
