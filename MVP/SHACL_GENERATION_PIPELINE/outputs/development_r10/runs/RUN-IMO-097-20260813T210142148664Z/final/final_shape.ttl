@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:releasedRescueBoatOrLifeboat ;
                        sh:in ( false )
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:releasedRescueBoatOrLifeboat ;
                        sh:in ( true )
                    ] ;
                    sh:property [
                        sh:path nltl:hasSurvivalCraft ;
                        sh:class nltl:survivalCraft ;
                        sh:node gen:SurvivalCraftCommunicationShape
                    ]
                ]
            )
        ]
    ) .

gen:SurvivalCraftCommunicationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:message "A released survival craft must carry a ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:class nltl:locationSignalDevice ;
        sh:message "A released survival craft must carry a location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:message "A released survival craft must carry an on-scene transmit/receive communication device."
    ] .
