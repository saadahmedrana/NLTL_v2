@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO104ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:class nltl:crewMember ;
        sh:node gs:IMO104CrewMemberShape
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:class nltl:crewMember ;
        sh:node gs:IMO104CrewMemberShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with a crew member having a PWOM-relevant assigned-duty item must record completed PWOM familiarization status." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this (nltl:hasCrewMember|nltl:hasCrewMemberInventory) ?crew .
    ?crew nltl:hasAssignedDuty ?duty .
    ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
    FILTER NOT EXISTS {
        $this nltl:polarWaterOperationalManualFamiliarizationStatus ?status .
        FILTER(
            datatype(?status) = xsd:boolean &&
            ?status = true
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each PWOM item relevant to a crew member's assigned duty must be included in that crew member's familiarization record." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?crew ?item
WHERE {
    $this (nltl:hasCrewMember|nltl:hasCrewMemberInventory) ?crew .
    ?crew nltl:hasAssignedDuty ?duty .
    ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
    FILTER NOT EXISTS {
        ?crew nltl:hasFamiliarizationRecord ?record .
        ?record nltl:familiarizationRecordItem ?item .
    }
}
"""
    ] .

gs:IMO104CrewMemberShape
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:class nltl:assignedDuty ;
        sh:node gs:IMO104AssignedDutyShape
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:class nltl:familiarizationRecord ;
        sh:node gs:IMO104FamiliarizationRecordShape
    ] .

gs:IMO104AssignedDutyShape
    a sh:NodeShape ;
    sh:class nltl:assignedDuty ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:class nltl:polarWaterOperationalManualItem
    ] .

gs:IMO104FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:class nltl:familiarizationRecord ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:class nltl:polarWaterOperationalManualItem
    ] .
