@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26-009Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion applicability must be recorded as a boolean."
    ] ;
    sh:property [
        sh:path nltl:iceAccumulationPreventionMeansPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
        sh:class nltl:navigationOrCommunicationAntenna ;
        sh:message "Every linked required navigation or communication antenna must be classified as a navigation or communication antenna."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ice accretion is likely and a required navigation or communication antenna is linked, ice accumulation prevention means must be recorded as present on the ship." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceAccretionLikely ?likely ;
          nltl:hasRequiredNavigationOrCommunicationAntenna ?antenna .
    FILTER(?likely = "true"^^xsd:boolean)
    FILTER NOT EXISTS {
        $this nltl:iceAccumulationPreventionMeansPresent ?prevention .
        FILTER(?prevention = "true"^^xsd:boolean)
    }
}
"""
    ] .
