@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:IMO26_009_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion applicability must be provided as a boolean."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ice accretion is likely, every linked required navigation or communication antenna must have ice-accumulation prevention present." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?antenna
WHERE {
    $this nltl:iceAccretionLikely ?likely ;
          nltl:hasRequiredNavigationOrCommunicationAntenna ?antenna .
    FILTER(
        datatype(?likely) = xsd:boolean &&
        ?likely = true
    )
    FILTER NOT EXISTS {
        ?antenna nltl:antennaIceAccumulationPreventionPresent ?present .
        FILTER(
            isLiteral(?present) &&
            datatype(?present) = xsd:boolean &&
            ?present = true
        )
    }
}
"""
    ] .
