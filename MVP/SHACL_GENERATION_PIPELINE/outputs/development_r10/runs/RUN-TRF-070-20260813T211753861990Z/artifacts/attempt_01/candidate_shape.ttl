@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyLocalStrength ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:class nltl:designCondition
    ] ;
    sh:sparql [
        sh:message "Applicable main-propulsion thruster load, service-life, operational-condition, or local-strength information is missing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                FILTER (
                    (
                        EXISTS {
                            $this nltl:mainPropulsionThruster ?mainForType .
                            FILTER (?mainForType = true)
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:thrusterType ?knownType .
                            FILTER (datatype(?knownType) = xsd:string)
                        }
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:thrusterType ?applicableTypeForMain .
                            FILTER (
                                ?applicableTypeForMain IN (
                                    "azimuthing",
                                    "fixed"
                                )
                            )
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:mainPropulsionThruster ?knownMain .
                            FILTER (datatype(?knownMain) = xsd:boolean)
                        }
                    )
                    ||
                    (
                        EXISTS {
                            $this nltl:mainPropulsionThruster ?applicableMain .
                            FILTER (?applicableMain = true)
                        }
                        &&
                        EXISTS {
                            $this nltl:thrusterType ?applicableType .
                            FILTER (
                                ?applicableType IN (
                                    "azimuthing",
                                    "fixed"
                                )
                            )
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:propellerIceInteractionLoad ?propellerLoad .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:thrusterBodyIceInteractionLoad ?bodyLoad .
                            }
                            ||
                            (
                                EXISTS {
                                    $this nltl:thrusterType ?azimuthingType .
                                    FILTER (?azimuthingType = "azimuthing")
                                }
                                &&
                                (
                                    NOT EXISTS {
                                        $this nltl:serviceLife ?serviceLife .
                                    }
                                    ||
                                    NOT EXISTS {
                                        $this nltl:hasDesignCondition ?condition .
                                        ?condition nltl:normalOperationalConditions ?normal .
                                        FILTER (?normal = true)
                                    }
                                )
                            )
                            ||
                            (
                                EXISTS {
                                    $this nltl:extremeLoad ?extremeLoad .
                                }
                                &&
                                (
                                    NOT EXISTS {
                                        $this nltl:localIcePressure ?localPressure .
                                    }
                                    ||
                                    NOT EXISTS {
                                        $this nltl:thrusterBodyLocalStrength ?sufficientStrength .
                                        FILTER (?sufficientStrength = true)
                                    }
                                    ||
                                    EXISTS {
                                        $this nltl:thrusterBodyLocalStrength ?insufficientStrength .
                                        FILTER (?insufficientStrength != true)
                                    }
                                )
                            )
                        )
                    )
                )
            }
        """
    ] .

gen:TRF070DesignConditionShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasDesignCondition ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean
    ] .

gen:TRF070ForceQuantityShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:extremeLoad ;
    sh:targetObjectsOf nltl:propellerIceInteractionLoad ;
    sh:targetObjectsOf nltl:thrusterBodyIceInteractionLoad ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A force quantity requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:message "A force quantity must use kilonewtons."
    ] .

gen:TRF070PressureQuantityShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:localIcePressure ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "Local ice pressure requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:message "Local ice pressure must use megapascals."
    ] .

gen:TRF070ServiceLifeQuantityShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:serviceLife ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "Service life requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:YR ;
        sh:message "Service life must use years."
    ] .
