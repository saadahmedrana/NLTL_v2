@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF070Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Main-propulsion-thruster applicability information is required."
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Thruster type is required to determine applicability."
    ] ;
    sh:or (
        gs:TRF070ApplicableShipShape
        gs:TRF070NonMainPropulsionShape
        gs:TRF070OtherThrusterTypeShape
    ) .

gs:TRF070NonMainPropulsionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:hasValue false ;
        sh:in ( false )
    ] .

gs:TRF070OtherThrusterTypeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:hasValue true ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:pattern "^(?!(azimuthing|fixed)$).*$" ;
        sh:flags "i"
    ] .

gs:TRF070ApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:hasValue true ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:pattern "^(azimuthing|fixed)$" ;
        sh:flags "i"
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [
            sh:class nltl:designCondition ;
            sh:property [
                sh:path nltl:normalOperationalConditions ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ] ;
        sh:message "An applicable ship requires a linked normal operational design condition."
    ] ;
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:minCount 1 ;
        sh:node gs:TRF070ForceQuantityShape ;
        sh:message "Propeller and ice interaction load is required in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:minCount 1 ;
        sh:node gs:TRF070ForceQuantityShape ;
        sh:message "Thruster-body and ice interaction load is required in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:extremeLoad ;
        sh:minCount 1 ;
        sh:node gs:TRF070ForceQuantityShape ;
        sh:message "Extreme load is required in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:minCount 1 ;
        sh:node gs:TRF070PressureQuantityShape ;
        sh:message "Local ice pressure is required in megapascals."
    ] ;
    sh:property [
        sh:path nltl:serviceLife ;
        sh:minCount 1 ;
        sh:node gs:TRF070ServiceLifeQuantityShape ;
        sh:message "Service life is required in years."
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyLocalStrength ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Thruster-body local strength shall be sufficient for local ice pressure."
    ] .

gs:TRF070ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1
    ] .

gs:TRF070PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1
    ] .

gs:TRF070ServiceLifeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:YR ;
        sh:minCount 1
    ] .
