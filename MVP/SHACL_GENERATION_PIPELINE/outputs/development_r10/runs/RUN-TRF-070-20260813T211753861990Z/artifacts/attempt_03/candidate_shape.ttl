@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Main-propulsion-thruster applicability must be recorded as a boolean."
    ] ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Thruster type must be recorded before applicability can be determined."
    ] ;
    sh:sparql [
        sh:message "A main-propulsion azimuthing or fixed thruster must record conforming propeller/ice and thruster-body/ice loads, service life, normal operational conditions, extreme load, local ice pressure, and a positive local-strength sufficiency determination." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:mainPropulsionThruster ?isMain ;
                      nltl:thrusterType ?type .
                FILTER (
                    datatype(?isMain) = xsd:boolean &&
                    ?isMain = true &&
                    datatype(?type) = xsd:string &&
                    LCASE(STR(?type)) IN ("azimuthing", "fixed")
                )
                FILTER NOT EXISTS {
                    $this nltl:propellerIceInteractionLoad ?propellerLoad ;
                          nltl:thrusterBodyIceInteractionLoad ?bodyLoad ;
                          nltl:serviceLife ?serviceLife ;
                          nltl:extremeLoad ?extremeLoad ;
                          nltl:localIcePressure ?localPressure ;
                          nltl:hasDesignCondition ?condition ;
                          nltl:thrusterBodyLocalStrength ?localStrength .

                    ?propellerLoad qudt:numericValue ?propellerValue ;
                                   qudt:unit unit:KiloN .
                    ?bodyLoad qudt:numericValue ?bodyValue ;
                              qudt:unit unit:KiloN .
                    ?serviceLife qudt:numericValue ?serviceLifeValue ;
                                 qudt:unit unit:YR .
                    ?extremeLoad qudt:numericValue ?extremeValue ;
                                 qudt:unit unit:KiloN .
                    ?localPressure qudt:numericValue ?pressureValue ;
                                   qudt:unit unit:MegaPA .
                    ?condition nltl:normalOperationalConditions ?normal .

                    FILTER (
                        datatype(?propellerValue) = xsd:decimal &&
                        datatype(?bodyValue) = xsd:decimal &&
                        datatype(?serviceLifeValue) = xsd:decimal &&
                        datatype(?extremeValue) = xsd:decimal &&
                        datatype(?pressureValue) = xsd:decimal &&
                        datatype(?normal) = xsd:boolean &&
                        ?normal = true &&
                        datatype(?localStrength) = xsd:boolean &&
                        ?localStrength = true
                    )
                }
            }
        """
    ] .
