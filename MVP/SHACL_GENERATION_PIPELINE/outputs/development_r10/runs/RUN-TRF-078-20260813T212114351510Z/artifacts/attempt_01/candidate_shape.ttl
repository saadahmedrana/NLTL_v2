@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ClassCycleLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] .

gen:PropellerLocationLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] .

gen:PropellerBladeLoadCycleShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerLocation ;
        sh:class nltl:propellerLocationValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gen:ClassCycleLookupCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Exactly one Table 6-6 lookup case is required for the selected ice-class cycle count."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gen:PropellerLocationLookupCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Exactly one Table 6-7 lookup case is required for the selected propeller-location factor."
    ] ;
    sh:sparql [
        sh:message "The ship values must agree with the selected values from Tables 6-6 and 6-7." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:classLoadCycleCount ?nClass ;
                      nltl:iceLoadCycleCoefficientK1 ?k1Quantity ;
                      nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase .
                ?k1Quantity qudt:numericValue ?k1 .
                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                           nltl:selectedIceClassCycleCount ?selectedClassQuantity .
                ?selectedClassQuantity qudt:numericValue ?selectedClass .
                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                              nltl:selectedPropellerLocationFactor ?selectedK1Quantity .
                ?selectedK1Quantity qudt:numericValue ?selectedK1 .
                FILTER (
                    xsd:decimal(?nClass) != ?selectedClass ||
                    ?k1 != ?selectedK1
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1 multiplied by k2, k3, N_class, and the load-spectrum count factor within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?reported ;
                      nltl:classLoadCycleCount ?nClass ;
                      nltl:iceLoadCycleCoefficientK1 ?k1Quantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Quantity ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?countFactorQuantity .
                ?k1Quantity qudt:numericValue ?k1 .
                ?k2Quantity qudt:numericValue ?k2 .
                ?k3Quantity qudt:numericValue ?k3 .
                ?countFactorQuantity qudt:numericValue ?countFactor .
                BIND (
                    ?k1 * ?k2 * ?k3 * xsd:decimal(?nClass) * ?countFactor
                    AS ?expected
                )
                BIND (
                    IF (
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER (
                    ABS(xsd:decimal(?reported) - ?expected) > ?tolerance
                )
            }
        """
    ] .
