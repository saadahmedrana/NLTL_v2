@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:Table6Dash6CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] .

gs:Table6Dash7CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] .

gs:TRF078Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerLocation ;
        sh:class nltl:propellerLocationValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gs:Table6Dash6CaseShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gs:Table6Dash7CaseShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:sparql [
        sh:message "The Table 6-6 selected ice-class cycle count must equal classLoadCycleCount." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:classLoadCycleCount ?classCount ;
                      nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash6 ;
                      nltl:selectedIceClassCycleCount ?selectedQuantity ;
                      nltl:lookupSelectionEvidence ?evidence .
                ?selectedQuantity qudt:numericValue ?selectedCount ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (xsd:decimal(?selectedCount) != xsd:decimal(?classCount))
            }
        """
    ] ;
    sh:sparql [
        sh:message "The Table 6-7 factor selected for the ship's propeller location must equal k1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerLocation ?location ;
                      nltl:iceLoadCycleCoefficientK1 ?k1Quantity ;
                      nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash7 ;
                      nltl:selectedPropellerLocationFactor ?selectedQuantity ;
                      nltl:lookupSelectionEvidence ?evidence .
                ?k1Quantity qudt:numericValue ?k1 ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?selectedQuantity qudt:numericValue ?selectedFactor ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (xsd:decimal(?selectedFactor) != xsd:decimal(?k1))
            }
        """
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1*k2*k3*classLoadCycleCount*propellerBladeLoadSpectrumCountFactor within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?actual ;
                      nltl:classLoadCycleCount ?classCount ;
                      nltl:iceLoadCycleCoefficientK1 ?k1Quantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Quantity ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnQuantity .
                ?k1Quantity qudt:numericValue ?k1 ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k2Quantity qudt:numericValue ?k2 ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k3Quantity qudt:numericValue ?k3 ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?nnQuantity qudt:numericValue ?nn ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                BIND (
                    xsd:decimal(?k1) *
                    xsd:decimal(?k2) *
                    xsd:decimal(?k3) *
                    xsd:decimal(?classCount) *
                    xsd:decimal(?nn)
                    AS ?expected
                )
                BIND (ABS(?expected) * 0.000001 AS ?relativeTolerance)
                BIND (
                    IF (
                        ?relativeTolerance > 0.000000000001,
                        ?relativeTolerance,
                        0.000000000001
                    )
                    AS ?tolerance
                )
                FILTER (ABS(xsd:decimal(?actual) - ?expected) > ?tolerance)
            }
        """
    ] .
