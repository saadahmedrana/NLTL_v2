@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF082Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bollardThrustKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bollard thrust knowledge status must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hydrodynamicBollardThrust ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:in ( unit:KiloN )
                    ]
                ] ;
                sh:message "Hydrodynamic bollard thrust taken from Table 6-8 must be recorded in kilonewtons."
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:class nltl:tableLookupCase ;
                sh:node gen:TRF082TableLookupCaseShape ;
                sh:message "An applicable Table 6-8 lookup case is required when bollard thrust is not known."
            ]
        ]
    ) .

gen:TRF082TableLookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:class nltl:tableReferenceValue ;
        sh:in ( nltl:traficomTable6Dash8 )
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact
    ] .
