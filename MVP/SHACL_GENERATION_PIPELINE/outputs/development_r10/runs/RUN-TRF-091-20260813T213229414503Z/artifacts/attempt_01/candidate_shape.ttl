@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:loadCasePurposeValue ;
                sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                sh:message "Each ice-milling sequence case shall identify propulsion-line strength evaluation as a purpose."
            ]
        ] ;
        sh:message "The ship shall identify an ice-milling sequence case."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each ice-milling sequence case shall be linked as the same ship's propulsion load case." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasIceMillingSequenceCase ?case .
    FILTER NOT EXISTS {
        $this nltl:hasPropulsionLoadCase ?case .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An ice-milling sequence case shall not identify stalling analysis as a purpose." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasIceMillingSequenceCase ?case .
    ?case nltl:loadCasePurpose nltl:stallingAnalysisPurposeValue .
}
"""
    ] .
