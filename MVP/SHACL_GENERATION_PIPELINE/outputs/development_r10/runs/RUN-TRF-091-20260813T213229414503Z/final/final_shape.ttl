@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF091Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:node [
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
                sh:message "Each ice-milling sequence case shall have the propulsion-line-strength-evaluation purpose."
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each ice-milling sequence case shall be a propulsion load case and shall not have the stalling-analysis purpose." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?case
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropulsionLoadCase ?case .
                    }
                    ||
                    EXISTS {
                        ?case nltl:loadCasePurpose nltl:stallingAnalysisPurposeValue .
                    }
                )
            }
        """
    ] .
