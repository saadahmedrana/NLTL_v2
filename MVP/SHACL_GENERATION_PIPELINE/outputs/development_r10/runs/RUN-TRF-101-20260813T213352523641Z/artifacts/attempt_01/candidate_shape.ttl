@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LoadApplicationRatioShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.8 ;
        sh:maxInclusive 0.8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeFailureLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:node gen:LoadApplicationRatioShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade failure load application radius ratio must be 0.8."
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade failure load must be applied in the weakest blade direction."
    ] .

gen:BladeFailureRequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade failure ultimate load must be recorded in kN."
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller diameter must be recorded in metres."
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade tip offset must be recorded in metres."
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade failure status must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:node gen:BladeFailureLoadCaseShape ;
        sh:minCount 1 ;
        sh:message "A load case applying the load at 0.8R in the weakest direction is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:approvedNonlinearBladeStressAnalysis ;
                sh:class nltl:approvalRecord ;
                sh:minCount 1 ;
                sh:message "An approved nonlinear blade stress analysis is required for the analysis alternative."
            ]
        ]
        [
            sh:property [
                sh:path nltl:bladeChordLengthAtWeakestSection ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeCylindricalRootRadius ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeMinimumYieldStrength ;
                sh:node gen:MegaPascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeUltimateTensileStrength ;
                sh:node gen:MegaPascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:bladeReferenceStrength1 ;
                sh:node gen:MegaPascalQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "The formula denominator 0.8*D - 2*r must be non-zero." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerDiameter/qudt:numericValue ?diameter ;
                              nltl:bladeCylindricalRootRadius/qudt:numericValue ?radius .
                        BIND (
                            xsd:decimal("0.8") * ?diameter -
                            xsd:decimal("2") * ?radius
                            AS ?denominator
                        )
                        FILTER (?denominator = xsd:decimal("0"))
                    }
                """
            ] ;
            sh:sparql [
                sh:message "The reported reference strength and blade failure load must satisfy the prescribed formulas within a relative tolerance of 1e-6 and an absolute fallback of 1e-12." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bladeChordLengthAtWeakestSection/qudt:numericValue ?chord ;
                              nltl:bladeMaximumThicknessAtWeakestSection/qudt:numericValue ?thickness ;
                              nltl:bladeCylindricalRootRadius/qudt:numericValue ?radius ;
                              nltl:propellerDiameter/qudt:numericValue ?diameter ;
                              nltl:bladeMinimumYieldStrength/qudt:numericValue ?yieldStrength ;
                              nltl:bladeUltimateTensileStrength/qudt:numericValue ?ultimateStrength ;
                              nltl:bladeReferenceStrength1/qudt:numericValue ?reportedReferenceStrength ;
                              nltl:bladeFailureUltimateLoad/qudt:numericValue ?reportedLoad .
                        BIND (
                            xsd:decimal("0.6") * ?yieldStrength +
                            xsd:decimal("0.4") * ?ultimateStrength
                            AS ?expectedReferenceStrength
                        )
                        BIND (
                            xsd:decimal("0.8") * ?diameter -
                            xsd:decimal("2") * ?radius
                            AS ?denominator
                        )
                        FILTER (?denominator != xsd:decimal("0"))
                        BIND (
                            xsd:decimal("300") * ?chord * ?thickness * ?thickness *
                            ?expectedReferenceStrength / ?denominator
                            AS ?expectedLoad
                        )
                        BIND (
                            IF(
                                ABS(?expectedReferenceStrength) * xsd:decimal("0.000001") >
                                xsd:decimal("0.000000000001"),
                                ABS(?expectedReferenceStrength) * xsd:decimal("0.000001"),
                                xsd:decimal("0.000000000001")
                            )
                            AS ?referenceTolerance
                        )
                        BIND (
                            IF(
                                ABS(?expectedLoad) * xsd:decimal("0.000001") >
                                xsd:decimal("0.000000000001"),
                                ABS(?expectedLoad) * xsd:decimal("0.000001"),
                                xsd:decimal("0.000000000001")
                            )
                            AS ?loadTolerance
                        )
                        FILTER (
                            ABS(?reportedReferenceStrength - ?expectedReferenceStrength) >
                                ?referenceTolerance ||
                            ABS(?reportedLoad - ?expectedLoad) > ?loadTolerance
                        )
                    }
                """
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Blade failure status must be true exactly when blade tip offset exceeds 10 percent of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset/qudt:numericValue ?offset ;
                      nltl:propellerDiameter/qudt:numericValue ?diameter ;
                      nltl:bladeFailureStatus ?status .
                FILTER (
                    ?status !=
                    (?offset > xsd:decimal("0.10") * ?diameter)
                )
            }
        """
    ] .
