@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF114ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceBlock ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The design ice block used for the thruster ice-impact assessment is required."
    ] ;
    sh:property [
        sh:path nltl:contactGeometry ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The estimated thruster contact geometry is required."
    ] ;
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The equivalent impact sphere radius must be recorded in metres."
    ] ;
    sh:property [
        sh:path nltl:iceOperatingSpeed ;
        sh:minCount 1 ;
        sh:node gen:KnotQuantityShape ;
        sh:message "The typical ice operating speed must be recorded in knots."
    ] ;
    sh:property [
        sh:path nltl:hasThrusterIceImpactLoadCase ;
        sh:minCount 1 ;
        sh:node gen:ThrusterIceImpactLoadCaseShape ;
        sh:message "At least one complete thruster ice-impact load case is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked thruster body must provide a resistance capacity in kilonewtons." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?thruster .
    ?thruster a nltl:thrusterBody .
    FILTER NOT EXISTS {
        ?thruster nltl:thrusterResistanceCapacity ?capacity .
        ?capacity a qudt:QuantityValue ;
            qudt:numericValue ?capacityValue ;
            qudt:unit unit:KiloN .
        FILTER(datatype(?capacityValue) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A thruster resistance capacity must not be less than its ice-impact load or demand." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?thruster ;
        nltl:hasThrusterIceImpactLoadCase ?loadCase .
    ?thruster a nltl:thrusterBody ;
        nltl:thrusterResistanceCapacity ?capacity .
    ?capacity qudt:numericValue ?capacityValue ;
        qudt:unit unit:KiloN .
    ?loadCase nltl:thrusterIceImpactDemand ?demand ;
        nltl:thrusterIceImpactLoad ?impactLoad .
    ?demand qudt:numericValue ?demandValue ;
        qudt:unit unit:KiloN .
    ?impactLoad qudt:numericValue ?impactLoadValue ;
        qudt:unit unit:KiloN .
    FILTER(
        datatype(?capacityValue) = xsd:decimal &&
        datatype(?demandValue) = xsd:decimal &&
        datatype(?impactLoadValue) = xsd:decimal &&
        (?capacityValue < ?demandValue || ?capacityValue < ?impactLoadValue)
    )
}
"""
    ] .

gen:ThrusterIceImpactLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:thrusterIceImpactLoadCase ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoadCaseIdentifier ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The applicable thruster ice-impact load case must be identified."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactDemand ;
        sh:minCount 1 ;
        sh:node gen:KilonewtonQuantityShape ;
        sh:message "The thruster ice-impact demand must be recorded in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoad ;
        sh:minCount 1 ;
        sh:node gen:KilonewtonQuantityShape ;
        sh:message "The thruster ice-impact load must be recorded in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:contactGeometryCorrespondenceEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Contact-geometry correspondence evidence is required for the load case."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoadedAreaEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Loaded-area evidence is required for the thruster ice-impact load case."
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:M
    ] .

gen:KnotQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:KN
    ] .

gen:KilonewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:KiloN
    ] .
