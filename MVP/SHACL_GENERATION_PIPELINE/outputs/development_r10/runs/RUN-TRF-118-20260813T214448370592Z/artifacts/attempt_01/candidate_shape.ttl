@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF118ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:nominalVonMisesStress ;
        sh:minCount 1 ;
        sh:node gen:TRF118StressQuantityShape
    ] ;
    sh:property [
        sh:path nltl:localStressConcentration ;
        sh:minCount 1 ;
        sh:node gen:TRF118UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gen:TRF118YieldSafetyFactorQuantityShape
    ] ;
    sh:property [
        sh:path nltl:thrusterExtremeLoad ;
        sh:minCount 1 ;
        sh:node gen:TRF118LoadQuantityShape
    ] ;
    sh:property [
        sh:path nltl:thrusterOperability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:repairRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false )
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node gen:TRF118ComponentShape
    ] ;
    sh:sparql [
        sh:message "Nominal stress must have a 1.3 margin against material yield strength, and locally concentrated stress must not exceed component material yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:nominalVonMisesStress ?nominalQuantity ;
                      nltl:localStressConcentration ?concentrationQuantity ;
                      nltl:hasComponent ?component .
                ?nominalQuantity qudt:numericValue ?nominalStress .
                ?concentrationQuantity qudt:numericValue ?concentration .
                ?component nltl:materialYieldStrength ?materialYieldQuantity ;
                           nltl:hasMaterialProperties ?materialProperties .
                ?materialYieldQuantity qudt:numericValue ?materialYieldStrength .
                ?materialProperties nltl:componentMaterialYieldStrength ?componentYieldQuantity .
                ?componentYieldQuantity qudt:numericValue ?componentYieldStrength .
                FILTER (
                    (?nominalStress * "1.3"^^xsd:decimal > ?materialYieldStrength)
                    ||
                    (?nominalStress * ?concentration > ?componentYieldStrength)
                )
            }
        """
    ] .

gen:TRF118ComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:materialYieldStrength ;
        sh:minCount 1 ;
        sh:node gen:TRF118StressQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:node gen:TRF118MaterialPropertiesShape
    ] .

gen:TRF118MaterialPropertiesShape
    a sh:NodeShape ;
    sh:class nltl:materialProperties ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:node gen:TRF118StressQuantityShape
    ] .

gen:TRF118StressQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:MegaPA )
    ] .

gen:TRF118UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:UNITLESS )
    ] .

gen:TRF118YieldSafetyFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 1.3 ;
        sh:maxInclusive 1.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:UNITLESS )
    ] .

gen:TRF118LoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:KiloN )
    ] .
