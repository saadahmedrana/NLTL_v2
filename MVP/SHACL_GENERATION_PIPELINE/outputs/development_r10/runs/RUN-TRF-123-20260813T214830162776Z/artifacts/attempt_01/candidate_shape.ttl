@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF123ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gs:YieldStrengthQuantityShape ;
        sh:message "Yield strength in MPa is required for the analysis."
    ] ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:class nltl:occasionalForceLoadCase ;
        sh:node gs:OccasionalForceLoadCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:node gs:PropellerShaftLineComponentShape
    ] .

gs:OccasionalForceLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The occasional-force load case must explicitly exclude the propeller blade."
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gs:SafetyFactorQuantityShape ;
        sh:message "A dimensionless component yield safety factor is required for the occasional-force load case."
    ] .

gs:PropellerShaftLineComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:materialYieldStrength ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gs:YieldStrengthQuantityShape ;
        sh:message "The component material yield strength in MPa is required."
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:class nltl:materialProperties ;
        sh:node gs:MaterialPropertiesShape ;
        sh:message "Material properties are required for each linked propeller shaft line component."
    ] .

gs:MaterialPropertiesShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gs:YieldStrengthQuantityShape ;
        sh:message "Component material yield strength in MPa is required on the material-properties node."
    ] .

gs:YieldStrengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gs:SafetyFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
