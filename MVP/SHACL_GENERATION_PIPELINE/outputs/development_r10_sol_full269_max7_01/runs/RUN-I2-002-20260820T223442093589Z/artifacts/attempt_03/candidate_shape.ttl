@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_002_ApplicableShipTarget
    a sh:SPARQLTarget ;
    sh:select """
        PREFIX nltl: <https://w3id.org/nltl/vocab#>
        SELECT DISTINCT ?this
        WHERE {
            ?this a nltl:ship ;
                  nltl:polarClass ?polarClass ;
                  nltl:urI1ComplianceStatus true .
        }
    """ .

gen:I2_002_ApplicableShipShape
    a sh:NodeShape ;
    sh:target gen:I2_002_ApplicableShipTarget ;
    sh:class nltl:ship .
