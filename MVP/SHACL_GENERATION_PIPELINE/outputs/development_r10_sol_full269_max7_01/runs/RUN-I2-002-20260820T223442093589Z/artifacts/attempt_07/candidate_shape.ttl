@prefix gen: <urn:nltl:generated-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2ApplicableShipTarget
    a sh:SPARQLTarget ;
    sh:select """
        PREFIX nltl: <https://w3id.org/nltl/vocab#>
        PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
        SELECT ?this
        WHERE {
            ?this a nltl:ship ;
                nltl:polarClass ?polarClass ;
                nltl:urI1ComplianceStatus ?status .
            FILTER(?status = "true"^^xsd:boolean)
        }
    """ .
