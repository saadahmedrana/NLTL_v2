@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2-006Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:asternIceOperationIntent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Astern ice operation intent must be recorded unambiguously."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "The aft section design basis must use the Bow and Bow Intermediate hull area requirements."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow" ;
                sh:message "The Bow hull area requirements must apply to the aft section."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:hasValue "Bow Intermediate" ;
                sh:message "The Bow Intermediate hull area requirements must apply to the aft section."
            ]
        ]
    ) .
