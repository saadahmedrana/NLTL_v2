@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_008_BowIceLoadReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Polar Class ship must provide the required ship-owned bow ice-load inputs and results and at least one bow subregion calculation case." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:polarClass ?polarClass .
    FILTER NOT EXISTS {
        $this nltl:averageIcePressure ?averagePressure ;
              nltl:lineLoad ?lineLoad ;
              nltl:loadPatchHeight ?patchHeight ;
              nltl:loadPatchLength ?patchLength ;
              nltl:localIcePressure ?localPressure ;
              nltl:shapeCoefficient ?shapeCoefficient ;
              nltl:totalGlancingImpactForce ?totalForce ;
              nltl:hasBowSubregionCalculationCase ?case .

        ?case a nltl:bowSubregionCalculationCase .

        ?averagePressure qudt:numericValue ?averagePressureValue ;
                         qudt:unit unit:MegaPA .
        ?lineLoad qudt:numericValue ?lineLoadValue ;
                  qudt:unit unit:KiloN-PER-M .
        ?patchHeight qudt:numericValue ?patchHeightValue ;
                     qudt:unit unit:M .
        ?patchLength qudt:numericValue ?patchLengthValue ;
                     qudt:unit unit:M .
        ?localPressure qudt:numericValue ?localPressureValue ;
                       qudt:unit unit:MegaPA .
        ?shapeCoefficient qudt:numericValue ?shapeCoefficientValue ;
                          qudt:unit unit:UNITLESS .
        ?totalForce qudt:numericValue ?totalForceValue ;
                    qudt:unit unit:KiloN .

        FILTER(
            datatype(?averagePressureValue) = xsd:decimal &&
            datatype(?lineLoadValue) = xsd:decimal &&
            datatype(?patchHeightValue) = xsd:decimal &&
            datatype(?patchLengthValue) = xsd:decimal &&
            datatype(?localPressureValue) = xsd:decimal &&
            datatype(?shapeCoefficientValue) = xsd:decimal &&
            datatype(?totalForceValue) = xsd:decimal
        )

        FILTER NOT EXISTS {
            ?averagePressure qudt:numericValue ?badAveragePressureValue .
            FILTER(datatype(?badAveragePressureValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?averagePressure qudt:unit ?badAveragePressureUnit .
            FILTER(?badAveragePressureUnit != unit:MegaPA)
        }
        FILTER NOT EXISTS {
            ?lineLoad qudt:numericValue ?badLineLoadValue .
            FILTER(datatype(?badLineLoadValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?lineLoad qudt:unit ?badLineLoadUnit .
            FILTER(?badLineLoadUnit != unit:KiloN-PER-M)
        }
        FILTER NOT EXISTS {
            ?patchHeight qudt:numericValue ?badPatchHeightValue .
            FILTER(datatype(?badPatchHeightValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?patchHeight qudt:unit ?badPatchHeightUnit .
            FILTER(?badPatchHeightUnit != unit:M)
        }
        FILTER NOT EXISTS {
            ?patchLength qudt:numericValue ?badPatchLengthValue .
            FILTER(datatype(?badPatchLengthValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?patchLength qudt:unit ?badPatchLengthUnit .
            FILTER(?badPatchLengthUnit != unit:M)
        }
        FILTER NOT EXISTS {
            ?localPressure qudt:numericValue ?badLocalPressureValue .
            FILTER(datatype(?badLocalPressureValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?localPressure qudt:unit ?badLocalPressureUnit .
            FILTER(?badLocalPressureUnit != unit:MegaPA)
        }
        FILTER NOT EXISTS {
            ?shapeCoefficient qudt:numericValue ?badShapeCoefficientValue .
            FILTER(datatype(?badShapeCoefficientValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?shapeCoefficient qudt:unit ?badShapeCoefficientUnit .
            FILTER(?badShapeCoefficientUnit != unit:UNITLESS)
        }
        FILTER NOT EXISTS {
            ?totalForce qudt:numericValue ?badTotalForceValue .
            FILTER(datatype(?badTotalForceValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?totalForce qudt:unit ?badTotalForceUnit .
            FILTER(?badTotalForceUnit != unit:KiloN)
        }
    }
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every bow subregion calculation case linked to a Polar Class ship must contain the required dimensionless shape coefficient, glancing-impact line load, and glancing-impact pressure." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:polarClass ?polarClass ;
          nltl:hasBowSubregionCalculationCase ?case .

    FILTER NOT EXISTS {
        ?case a nltl:bowSubregionCalculationCase ;
              nltl:bowShapeCoefficient ?bowCoefficient ;
              nltl:glancingImpactLineLoad ?impactLineLoad ;
              nltl:glancingImpactPressure ?impactPressure .

        ?bowCoefficient qudt:numericValue ?bowCoefficientValue ;
                        qudt:unit unit:UNITLESS .
        ?impactLineLoad qudt:numericValue ?impactLineLoadValue ;
                        qudt:unit unit:MegaN-M-PER-M2 .
        ?impactPressure qudt:numericValue ?impactPressureValue ;
                        qudt:unit unit:MegaPA .

        FILTER(
            datatype(?bowCoefficientValue) = xsd:decimal &&
            datatype(?impactLineLoadValue) = xsd:decimal &&
            datatype(?impactPressureValue) = xsd:decimal
        )

        FILTER NOT EXISTS {
            ?bowCoefficient qudt:numericValue ?badBowCoefficientValue .
            FILTER(datatype(?badBowCoefficientValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?bowCoefficient qudt:unit ?badBowCoefficientUnit .
            FILTER(?badBowCoefficientUnit != unit:UNITLESS)
        }
        FILTER NOT EXISTS {
            ?impactLineLoad qudt:numericValue ?badImpactLineLoadValue .
            FILTER(datatype(?badImpactLineLoadValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?impactLineLoad qudt:unit ?badImpactLineLoadUnit .
            FILTER(?badImpactLineLoadUnit != unit:MegaN-M-PER-M2)
        }
        FILTER NOT EXISTS {
            ?impactPressure qudt:numericValue ?badImpactPressureValue .
            FILTER(datatype(?badImpactPressureValue) != xsd:decimal)
        }
        FILTER NOT EXISTS {
            ?impactPressure qudt:unit ?badImpactPressureUnit .
            FILTER(?badImpactPressureUnit != unit:MegaPA)
        }
    }
}
""" ;
    ] .
