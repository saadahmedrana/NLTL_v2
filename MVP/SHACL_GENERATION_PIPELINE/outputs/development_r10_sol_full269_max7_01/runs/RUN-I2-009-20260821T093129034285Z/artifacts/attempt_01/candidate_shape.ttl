@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FixedAspectRatioQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6 ;
        sh:message "The load patch aspect ratio must be 3.6."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:HullAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] .

gen:OtherIceStrengthenedAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:hasValue nltl:otherIceStrengthenedArea ;
        sh:minCount 1
    ] .

gen:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:node gen:HullAreaAssignmentShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:qualifiedValueShape gen:OtherIceStrengthenedAreaAssignmentShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "An assignment for the other ice-strengthened area is required."
    ] ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gen:PressureQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node gen:FixedAspectRatioQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node gen:AngleQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node gen:AngleQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minExclusive 0 ;
                sh:maxExclusive 80
            ] ;
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:minExclusive 10
            ]
        ]
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:hasValue false
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                        sh:maxInclusive 0
                    ]
                ]
                [
                    sh:property [
                        sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                        sh:minInclusive 80
                    ]
                ]
                [
                    sh:property [
                        sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                        sh:maxInclusive 10
                    ]
                ]
            )
        ]
    ) ;
    sh:message "Bow-form applicability must agree with the buttock-angle and normal-frame-angle limits." .
