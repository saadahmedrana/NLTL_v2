@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:OtherIceAreaSelectorShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:hasValue nltl:otherIceStrengthenedArea
    ] .

gen:TypedOtherIceAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:hasValue nltl:otherIceStrengthenedArea
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:maxCount 1
    ] .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .

gen:AspectRatioQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:maxCount 1
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:maxCount 1
    ] .

gen:I2_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:node gen:AngleQuantityShape ;
        sh:message "The buttock angle must be supplied in degrees."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:node gen:AngleQuantityShape ;
        sh:message "The normal frame angle must be supplied in degrees."
    ] ;
    sh:property [
        sh:path nltl:bowFormApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bow-form applicability must be stated as one boolean value."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minExclusive 0 ;
                sh:maxExclusive 80
            ] ;
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:minExclusive 10
            ]
        ]
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:maxInclusive 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minInclusive 80
            ]
        ]
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:maxInclusive 10
            ]
        ]
    ) ;

    sh:or (
        [
            sh:property [
                sh:path nltl:hasHullAreaAssignment ;
                sh:qualifiedValueShape gen:TypedOtherIceAreaAssignmentShape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:otherIceStrengthenedAreaValue
            ] ;
            sh:property [
                sh:path nltl:averageIcePressure ;
                sh:minCount 1 ;
                sh:node gen:PressureQuantityShape ;
                sh:message "Average ice pressure is required for an other ice-strengthened area."
            ] ;
            sh:property [
                sh:path nltl:nonBowLoadPatchHeight ;
                sh:minCount 1 ;
                sh:node gen:LengthQuantityShape ;
                sh:message "Non-bow load-patch height is required for an other ice-strengthened area."
            ] ;
            sh:property [
                sh:path nltl:nonBowLoadPatchLength ;
                sh:minCount 1 ;
                sh:node gen:LengthQuantityShape ;
                sh:message "Non-bow load-patch length is required for an other ice-strengthened area."
            ] ;
            sh:property [
                sh:path nltl:loadPatchAspectRatio ;
                sh:minCount 1 ;
                sh:node gen:AspectRatioQuantityShape ;
                sh:message "The load-patch aspect ratio must be 3.6 for an other ice-strengthened area."
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasHullAreaAssignment ;
                sh:qualifiedValueShape gen:OtherIceAreaSelectorShape ;
                sh:qualifiedMaxCount 0
            ] ;
            sh:property [
                sh:path nltl:hullRegion ;
                sh:qualifiedValueShape [
                    sh:in ( nltl:otherIceStrengthenedAreaValue )
                ] ;
                sh:qualifiedMaxCount 0
            ]
        ]
    ) .
