@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2-010-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A Polar Class assignment is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:verticalSidedBowForm ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:bowVerticalSideStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethod ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A PC6 or PC7 ship must state whether its bow form has vertical sides." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc .
                FILTER (?pc IN (nltl:polarClassPc6, nltl:polarClassPc7))
                FILTER NOT EXISTS {
                    $this nltl:verticalSidedBowForm ?verticalForm .
                    FILTER (
                        DATATYPE(?verticalForm) = xsd:boolean &&
                        (?verticalForm = true || ?verticalForm = false)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A PC6 or PC7 ship must provide its bow vertical-side status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc .
                FILTER (?pc IN (nltl:polarClassPc6, nltl:polarClassPc7))
                FILTER NOT EXISTS {
                    $this nltl:bowVerticalSideStatus ?verticalStatus .
                    FILTER (
                        DATATYPE(?verticalStatus) = xsd:boolean &&
                        (?verticalStatus = true || ?verticalStatus = false)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The vertical-sided bow form and bow vertical-side status must agree for a PC6 or PC7 ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc ;
                    nltl:verticalSidedBowForm ?verticalForm ;
                    nltl:bowVerticalSideStatus ?verticalStatus .
                FILTER (?pc IN (nltl:polarClassPc6, nltl:polarClassPc7))
                FILTER (
                    DATATYPE(?verticalForm) = xsd:boolean &&
                    DATATYPE(?verticalStatus) = xsd:boolean &&
                    ?verticalForm != ?verticalStatus
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For a PC6 or PC7 ship, a normal frame angle from 0 through 10 degrees denotes a vertical-sided bow." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc ;
                    nltl:normalFrameAngle ?angle .
                ?angle qudt:numericValue ?angleValue ;
                    qudt:unit unit:DEG .
                FILTER (?pc IN (nltl:polarClassPc6, nltl:polarClassPc7))
                FILTER (
                    DATATYPE(?angleValue) = xsd:decimal &&
                    ?angleValue >= 0 &&
                    ?angleValue <= 10
                )
                FILTER NOT EXISTS {
                    $this nltl:verticalSidedBowForm true ;
                        nltl:bowVerticalSideStatus true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A PC6 or PC7 ship with a vertical-sided bow must use the design ice force method in I2.3.2.1 (iv)." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarClass ?pc ;
                    nltl:verticalSidedBowForm true .
                FILTER (?pc IN (nltl:polarClassPc6, nltl:polarClassPc7))
                FILTER NOT EXISTS {
                    $this nltl:bowDesignForceMethod ?method .
                    FILTER (
                        DATATYPE(?method) = xsd:string &&
                        STR(?method) = "I2.3.2.1 (iv)"
                    )
                }
            }
        """
    ] .
