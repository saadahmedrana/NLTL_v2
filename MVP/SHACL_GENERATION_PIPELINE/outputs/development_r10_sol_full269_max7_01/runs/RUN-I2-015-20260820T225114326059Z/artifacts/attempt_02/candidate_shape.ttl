@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked bow-subregion case explicitly classified for I2.3.1(v) must provide the required calculation inputs, lookup factors, and externally computed shape coefficient, and its ship must provide L_UI and beta_i_prime." ;
        sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this ?case
WHERE {
    $this nltl:hasBowSubregionCalculationCase ?case .
    ?case nltl:bowFormApplicabilityClassification
        nltl:i231vBowFormApplicability .

    FILTER (
        NOT EXISTS {
            ?case rdf:type nltl:bowSubregionCalculationCase .
        }

        ||

        NOT EXISTS {
            ?case nltl:bowSubregionMidLengthPosition ?midLength .
        }
        ||
        EXISTS {
            ?case nltl:bowSubregionMidLengthPosition ?midLength .
            FILTER (
                (!isIRI(?midLength) && !isBlank(?midLength))
                ||
                NOT EXISTS {
                    ?midLength qudt:numericValue ?midLengthValue .
                }
                ||
                EXISTS {
                    ?midLength qudt:numericValue ?midLengthValue .
                    FILTER (!isLiteral(?midLengthValue))
                }
                ||
                EXISTS {
                    ?midLength qudt:numericValue ?midLengthValue .
                    FILTER (
                        isLiteral(?midLengthValue) &&
                        datatype(?midLengthValue) != xsd:decimal
                    )
                }
                ||
                NOT EXISTS {
                    ?midLength qudt:unit unit:M .
                }
                ||
                EXISTS {
                    ?midLength qudt:unit ?midLengthUnit .
                    FILTER (?midLengthUnit != unit:M)
                }
            )
        }

        ||

        NOT EXISTS {
            ?case nltl:bowSubregionWaterlineAngle ?waterlineAngle .
        }
        ||
        EXISTS {
            ?case nltl:bowSubregionWaterlineAngle ?waterlineAngle .
            FILTER (
                (!isIRI(?waterlineAngle) && !isBlank(?waterlineAngle))
                ||
                NOT EXISTS {
                    ?waterlineAngle qudt:numericValue ?waterlineAngleValue .
                }
                ||
                EXISTS {
                    ?waterlineAngle qudt:numericValue ?waterlineAngleValue .
                    FILTER (!isLiteral(?waterlineAngleValue))
                }
                ||
                EXISTS {
                    ?waterlineAngle qudt:numericValue ?waterlineAngleValue .
                    FILTER (
                        isLiteral(?waterlineAngleValue) &&
                        datatype(?waterlineAngleValue) != xsd:decimal
                    )
                }
                ||
                NOT EXISTS {
                    ?waterlineAngle qudt:unit unit:DEG .
                }
                ||
                EXISTS {
                    ?waterlineAngle qudt:unit ?waterlineAngleUnit .
                    FILTER (?waterlineAngleUnit != unit:DEG)
                }
            )
        }

        ||

        NOT EXISTS {
            ?case nltl:bowShapeCoefficient ?shapeCoefficient .
        }
        ||
        EXISTS {
            ?case nltl:bowShapeCoefficient ?shapeCoefficient .
            FILTER (
                (!isIRI(?shapeCoefficient) && !isBlank(?shapeCoefficient))
                ||
                NOT EXISTS {
                    ?shapeCoefficient qudt:numericValue ?shapeCoefficientValue .
                }
                ||
                EXISTS {
                    ?shapeCoefficient qudt:numericValue ?shapeCoefficientValue .
                    FILTER (!isLiteral(?shapeCoefficientValue))
                }
                ||
                EXISTS {
                    ?shapeCoefficient qudt:numericValue ?shapeCoefficientValue .
                    FILTER (
                        isLiteral(?shapeCoefficientValue) &&
                        datatype(?shapeCoefficientValue) != xsd:decimal
                    )
                }
                ||
                NOT EXISTS {
                    ?shapeCoefficient qudt:unit unit:UNITLESS .
                }
                ||
                EXISTS {
                    ?shapeCoefficient qudt:unit ?shapeCoefficientUnit .
                    FILTER (?shapeCoefficientUnit != unit:UNITLESS)
                }
            )
        }

        ||

        NOT EXISTS {
            $this nltl:upperIceWaterlineLengthLUI ?upperIceLength .
        }
        ||
        EXISTS {
            $this nltl:upperIceWaterlineLengthLUI ?upperIceLength .
            FILTER (
                (!isIRI(?upperIceLength) && !isBlank(?upperIceLength))
                ||
                NOT EXISTS {
                    ?upperIceLength qudt:numericValue ?upperIceLengthValue .
                }
                ||
                EXISTS {
                    ?upperIceLength qudt:numericValue ?upperIceLengthValue .
                    FILTER (!isLiteral(?upperIceLengthValue))
                }
                ||
                EXISTS {
                    ?upperIceLength qudt:numericValue ?upperIceLengthValue .
                    FILTER (
                        isLiteral(?upperIceLengthValue) &&
                        datatype(?upperIceLengthValue) != xsd:decimal
                    )
                }
                ||
                NOT EXISTS {
                    ?upperIceLength qudt:unit unit:M .
                }
                ||
                EXISTS {
                    ?upperIceLength qudt:unit ?upperIceLengthUnit .
                    FILTER (?upperIceLengthUnit != unit:M)
                }
            )
        }

        ||

        NOT EXISTS {
            $this nltl:betaIPrime ?beta .
        }
        ||
        EXISTS {
            $this nltl:betaIPrime ?beta .
            FILTER (
                (!isIRI(?beta) && !isBlank(?beta))
                ||
                NOT EXISTS {
                    ?beta qudt:numericValue ?betaValue .
                }
                ||
                EXISTS {
                    ?beta qudt:numericValue ?betaValue .
                    FILTER (!isLiteral(?betaValue))
                }
                ||
                EXISTS {
                    ?beta qudt:numericValue ?betaValue .
                    FILTER (
                        isLiteral(?betaValue) &&
                        datatype(?betaValue) != xsd:decimal
                    )
                }
                ||
                NOT EXISTS {
                    ?beta qudt:unit unit:UNITLESS .
                }
                ||
                EXISTS {
                    ?beta qudt:unit ?betaUnit .
                    FILTER (?betaUnit != unit:UNITLESS)
                }
            )
        }

        ||

        NOT EXISTS {
            ?case nltl:hasFailureClassFactorLookupCase ?lookup .
        }
        ||
        EXISTS {
            ?case nltl:hasFailureClassFactorLookupCase ?lookup .
            FILTER (
                NOT EXISTS {
                    ?lookup rdf:type nltl:tableLookupCase .
                }

                ||

                NOT EXISTS {
                    ?lookup nltl:flexuralFailureClassFactor ?flexuralFactor .
                }
                ||
                EXISTS {
                    ?lookup nltl:flexuralFailureClassFactor ?flexuralFactor .
                    FILTER (
                        (!isIRI(?flexuralFactor) && !isBlank(?flexuralFactor))
                        ||
                        NOT EXISTS {
                            ?flexuralFactor qudt:numericValue ?flexuralValue .
                        }
                        ||
                        EXISTS {
                            ?flexuralFactor qudt:numericValue ?flexuralValue .
                            FILTER (!isLiteral(?flexuralValue))
                        }
                        ||
                        EXISTS {
                            ?flexuralFactor qudt:numericValue ?flexuralValue .
                            FILTER (
                                isLiteral(?flexuralValue) &&
                                datatype(?flexuralValue) != xsd:decimal
                            )
                        }
                        ||
                        NOT EXISTS {
                            ?flexuralFactor qudt:unit unit:UNITLESS .
                        }
                        ||
                        EXISTS {
                            ?flexuralFactor qudt:unit ?flexuralUnit .
                            FILTER (?flexuralUnit != unit:UNITLESS)
                        }
                    )
                }

                ||

                NOT EXISTS {
                    ?lookup nltl:crushingFailureClassFactor ?crushingFactor .
                }
                ||
                EXISTS {
                    ?lookup nltl:crushingFailureClassFactor ?crushingFactor .
                    FILTER (
                        (!isIRI(?crushingFactor) && !isBlank(?crushingFactor))
                        ||
                        NOT EXISTS {
                            ?crushingFactor qudt:numericValue ?crushingValue .
                        }
                        ||
                        EXISTS {
                            ?crushingFactor qudt:numericValue ?crushingValue .
                            FILTER (!isLiteral(?crushingValue))
                        }
                        ||
                        EXISTS {
                            ?crushingFactor qudt:numericValue ?crushingValue .
                            FILTER (
                                isLiteral(?crushingValue) &&
                                datatype(?crushingValue) != xsd:decimal
                            )
                        }
                        ||
                        NOT EXISTS {
                            ?crushingFactor qudt:unit unit:UNITLESS .
                        }
                        ||
                        EXISTS {
                            ?crushingFactor qudt:unit ?crushingUnit .
                            FILTER (?crushingUnit != unit:UNITLESS)
                        }
                    )
                }
            )
        }
    )
}
""" ;
    ] .
