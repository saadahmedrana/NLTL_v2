@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node gen:I2_015_ConditionalCaseShape
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:hasBowSubregionCalculationCase ;
                    sh:qualifiedValueShape [
                        sh:property [
                            sh:path nltl:bowFormApplicabilityClassification ;
                            sh:hasValue nltl:i231vBowFormApplicability
                        ]
                    ] ;
                    sh:qualifiedMinCount 1
                ]
            ]
        ]
        [
            sh:node gen:I2_015_ApplicableShipInputsShape
        ]
    ) .

gen:I2_015_ConditionalCaseShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:bowFormApplicabilityClassification ;
                    sh:hasValue nltl:i231vBowFormApplicability
                ]
            ]
        ]
        [
            sh:node gen:I2_015_ApplicableCaseShape
        ]
    ) .

gen:I2_015_ApplicableCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:node gen:I2_015_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:minCount 1 ;
        sh:node gen:I2_015_DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:minCount 1 ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:I2_015_FailureClassFactorLookupShape
    ] .

gen:I2_015_ApplicableShipInputsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:node gen:I2_015_MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape
    ] .

gen:I2_015_FailureClassFactorLookupShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape
    ] .

gen:I2_015_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:maxCount 1
    ] .

gen:I2_015_DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:maxCount 1
    ] .

gen:I2_015_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:maxCount 1
    ] .
