@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MegaNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The table lookup case must provide one unitless crushing failure class factor."
    ] ;
    sh:property [
        sh:path nltl:loadPatchDimensionClassFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The table lookup case must provide one unitless load patch dimension class factor."
    ] .

gs:NonBowIceLoadCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:nonBowIceLoadCalculationCase ;
    sh:property [
        sh:path nltl:shipDisplacementFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow ice-load calculation case must provide one unitless ship displacement factor."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceForce ;
        sh:node gs:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow ice-load calculation case must provide one non-bow ice force in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceLineLoad ;
        sh:node gs:MegaNewtonPerMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The non-bow ice-load calculation case must provide one non-bow ice line load in the canonical unit."
    ] .

gs:NonBowIceLoadShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide one upper ice waterline draught in metres."
    ] ;
    sh:property [
        sh:path nltl:displacementFactorThreshold ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide one displacement factor threshold in metres."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gs:TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one table lookup case containing the required class factors."
    ] ;
    sh:property [
        sh:path nltl:hasNonBowIceLoadCalculationCase ;
        sh:node gs:NonBowIceLoadCalculationCaseShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one non-bow ice-load calculation case."
    ] ;
    sh:sparql [
        sh:message "The reported non-bow ice force must equal 0.36 times CFC times DF, converted from meganewtons to kilonewtons, within the numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?tableCase ;
                      nltl:hasNonBowIceLoadCalculationCase ?calculationCase .
                ?tableCase nltl:crushingFailureClassFactor ?cfcQuantity .
                ?cfcQuantity qudt:numericValue ?cfc .
                ?calculationCase nltl:shipDisplacementFactor ?dfQuantity ;
                                 nltl:nonBowIceForce ?forceQuantity .
                ?dfQuantity qudt:numericValue ?df .
                ?forceQuantity qudt:numericValue ?reportedForce .
                BIND (
                    "360"^^xsd:decimal * ?cfc * ?df
                    AS ?expectedForce
                )
                BIND (
                    IF (
                        ABS(?expectedForce) * "0.000001"^^xsd:decimal
                            > "0.000000001"^^xsd:decimal,
                        ABS(?expectedForce) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?reportedForce - ?expectedForce) > ?tolerance)
            }
        """
    ] .
