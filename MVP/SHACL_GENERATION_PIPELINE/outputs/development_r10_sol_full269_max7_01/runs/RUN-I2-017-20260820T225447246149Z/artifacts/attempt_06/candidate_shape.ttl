@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:NonBowIceLoadShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:MetreQuantityShape ;
        sh:message "The ship must have one upper ice waterline draught in metres."
    ] ;
    sh:property [
        sh:path nltl:displacementFactorThreshold ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:MetreQuantityShape ;
        sh:message "The ship must have one displacement factor threshold in metres."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:tableLookupCase ;
        sh:node shape:NonBowTableLookupCaseShape ;
        sh:message "The ship must have one table lookup case containing the required class factors."
    ] ;
    sh:property [
        sh:path nltl:hasNonBowIceLoadCalculationCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:nonBowIceLoadCalculationCase ;
        sh:node shape:NonBowIceLoadCalculationCaseShape ;
        sh:message "The ship must have one non-bow ice load calculation case."
    ] ;
    sh:sparql [
        sh:message "The non-bow ice force must equal 0.36 times the crushing failure class factor and displacement factor, reported in kilonewtons within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?tableCase ;
                      nltl:hasNonBowIceLoadCalculationCase ?calculationCase .
                ?tableCase nltl:crushingFailureClassFactor ?cfcQuantity .
                ?cfcQuantity qudt:numericValue ?cfc .
                ?calculationCase nltl:shipDisplacementFactor ?dfQuantity ;
                                 nltl:nonBowIceForce ?forceQuantity .
                ?dfQuantity qudt:numericValue ?df .
                ?forceQuantity qudt:numericValue ?reportedForce .
                BIND((360.0 * ?cfc * ?df) AS ?expectedForce)
                BIND(IF(
                    ABS(?expectedForce) * 0.000001 > 0.000000001,
                    ABS(?expectedForce) * 0.000001,
                    0.000000001
                ) AS ?tolerance)
                FILTER(ABS(?reportedForce - ?expectedForce) > ?tolerance)
            }
        """
    ] .

shape:NonBowTableLookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:UnitlessQuantityShape ;
        sh:message "The table lookup case must contain one crushing failure class factor."
    ] ;
    sh:property [
        sh:path nltl:loadPatchDimensionClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:UnitlessQuantityShape ;
        sh:message "The table lookup case must contain one load patch dimension class factor."
    ] .

shape:NonBowIceLoadCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipDisplacementFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:UnitlessQuantityShape ;
        sh:message "The calculation case must contain one ship displacement factor."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:KilonewtonQuantityShape ;
        sh:message "The calculation case must contain one non-bow ice force in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node shape:NonBowLineLoadQuantityShape ;
        sh:message "The calculation case must contain one non-bow ice line load in the canonical unit."
    ] .

shape:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

shape:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

shape:KilonewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .

shape:NonBowLineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaN-M-PER-M2
    ] .
