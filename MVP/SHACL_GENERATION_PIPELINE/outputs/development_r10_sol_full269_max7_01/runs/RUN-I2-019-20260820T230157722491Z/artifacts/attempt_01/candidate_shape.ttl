@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipHullAreaFactorShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:StructuralMemberHullAreaShape
    ] ;
    sh:sparql [
        sh:message "Each structural member spanning one or more hull areas must have exactly one selected hull area factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER EXISTS {
                    ?member nltl:hasSpannedHullArea ?area .
                }
                OPTIONAL {
                    ?member nltl:selectedHullAreaFactor ?selected .
                }
            }
            GROUP BY $this ?member
            HAVING (COUNT(?selected) != 1)
        """
    ] ;
    sh:sparql [
        sh:message "The selected hull area factor must equal the maximum factor of all spanned hull areas within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasSpannedHullArea ?spannedArea ;
                        nltl:selectedHullAreaFactor ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selectedValue .
                {
                    SELECT ?member (MAX(?factorValue) AS ?expectedValue)
                    WHERE {
                        ?member nltl:hasSpannedHullArea ?area .
                        ?area nltl:hullAreaFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factorValue .
                    }
                    GROUP BY ?member
                }
                BIND(
                    IF(
                        ABS(?expectedValue) > "0.000000000001"^^xsd:decimal,
                        ABS(?expectedValue) * "0.000001"^^xsd:decimal,
                        "0.000000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?selectedValue - ?expectedValue) > ?tolerance)
            }
        """
    ] .

gen:StructuralMemberHullAreaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:class nltl:hullAreaValue ;
        sh:node gen:SpannedHullAreaShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gen:SelectedHullAreaFactorQuantityShape
    ] .

gen:SpannedHullAreaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:HullAreaFactorQuantityShape ;
        sh:message "Each spanned hull area must provide exactly one hull area factor."
    ] .

gen:HullAreaFactorQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SelectedHullAreaFactorQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
