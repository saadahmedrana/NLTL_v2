@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_019_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_019_StructuralMemberShape
    ] ;
    sh:sparql [
        sh:message "The selected hull area factor must equal the maximum factor of all spanned hull areas, within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:selectedHullAreaFactor ?selectedQuantity .
                ?selectedQuantity qudt:numericValue ?selectedValue .
                {
                    SELECT $this ?member (MAX(?factorValue) AS ?expectedValue)
                    WHERE {
                        $this nltl:hasStructuralMember ?member .
                        ?member nltl:hasSpannedHullArea ?spannedArea .
                        ?spannedArea nltl:hullAreaFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factorValue .
                    }
                    GROUP BY $this ?member
                }
                BIND(
                    IF(
                        ABS(?expectedValue) * "0.000001"^^xsd:decimal >
                            "0.000000000001"^^xsd:decimal,
                        ABS(?expectedValue) * "0.000001"^^xsd:decimal,
                        "0.000000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?selectedValue - ?expectedValue) > ?tolerance)
            }
        """
    ] .

gen:I2_019_StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasSpannedHullArea ;
        sh:class nltl:hullAreaValue ;
        sh:node gen:I2_019_HullAreaValueShape ;
        sh:minCount 1 ;
        sh:message "Each represented structural member must identify its spanned hull areas."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_019_SelectedFactorShape ;
        sh:message "Each represented structural member must have one selected hull area factor."
    ] .

gen:I2_019_HullAreaValueShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_019_HullAreaFactorShape ;
        sh:message "Each spanned hull area must have one hull area factor."
    ] .

gen:I2_019_HullAreaFactorShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_019_SelectedFactorShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
