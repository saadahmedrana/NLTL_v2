@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ObliquePlatingInterpolationShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasObliquePlatingInterpolationCase ;
        sh:class nltl:obliquePlatingInterpolationCase ;
        sh:minCount 1 ;
        sh:node gen:ObliquePlatingInterpolationCaseShape ;
        sh:message "The ship must provide an oblique plating interpolation case."
    ] .

gen:ObliquePlatingInterpolationCaseShape
    a sh:NodeShape ;
    sh:class nltl:obliquePlatingInterpolationCase ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleQuantityShape ;
        sh:message "The interpolation case must provide one framing angle in degrees."
    ] ;
    sh:or (
        gen:AngleAtOrBelowTwentyShape
        gen:AngleAtOrAboveSeventyShape
        gen:ApplicableInterpolationCaseShape
    ) .

gen:AngleAtOrBelowTwentyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive "20"^^xsd:decimal
            ]
        ]
    ] .

gen:AngleAtOrAboveSeventyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "70"^^xsd:decimal
            ]
        ]
    ] .

gen:ApplicableInterpolationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minExclusive "20"^^xsd:decimal ;
                sh:maxExclusive "70"^^xsd:decimal
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:longitudinalFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "An applicable interpolation case must provide the longitudinal-framing net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:transverseFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "An applicable interpolation case must provide the transverse-framing net plate thickness."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "An applicable interpolation case must provide one lower interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:InterpolationPointShape ;
        sh:message "An applicable interpolation case must provide one upper interpolation endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolatedNetPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "An applicable interpolation case must provide the externally calculated interpolated net plate thickness."
    ] .

gen:InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Each interpolation endpoint must provide one dimensionless coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DecimalQuantityShape ;
        sh:message "Each interpolation endpoint must provide one result value."
    ] .

gen:AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
