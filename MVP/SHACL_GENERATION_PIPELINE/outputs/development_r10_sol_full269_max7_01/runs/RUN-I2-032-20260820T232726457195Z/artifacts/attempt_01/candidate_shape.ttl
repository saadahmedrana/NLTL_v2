@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositivePressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TransverseFrameShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredTransverseFrameShearArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ApplicableShipCalculationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gs:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gs:SquareMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:PositivePressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:TransverseFrameShape
    ] ;
    sh:sparql [
        sh:message "Required transverse-frame shear area must match the I2.6.2 formula within relative tolerance 1e-6 (absolute fallback 1e-9 cm2), and actual shear area must be at least the required area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:averageIcePressure/qudt:numericValue ?averagePressure ;
                      nltl:frameSpan/qudt:numericValue ?frameSpan ;
                      nltl:loadPatchHeight/qudt:numericValue ?patchHeight ;
                      nltl:peakPressureFactor/qudt:numericValue ?peakFactor ;
                      nltl:shearArea/qudt:numericValue ?actualAreaM2 ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrength ;
                      nltl:hasStructuralMember ?member .
                ?member nltl:frameSpacing/qudt:numericValue ?frameSpacing ;
                        nltl:selectedHullAreaFactor/qudt:numericValue ?areaFactor ;
                        nltl:requiredTransverseFrameShearArea/qudt:numericValue ?reportedRequiredArea .
                BIND(IF(?frameSpan < ?patchHeight, ?frameSpan, ?patchHeight) AS ?limitedLength)
                BIND(
                    ("10000"^^xsd:decimal * "0.5"^^xsd:decimal *
                     ?limitedLength * ?frameSpacing *
                     (?areaFactor * ?peakFactor * ?averagePressure)) /
                    ("0.577"^^xsd:decimal * ?yieldStrength)
                    AS ?expectedRequiredArea
                )
                BIND(
                    IF(
                        ABS(?expectedRequiredArea) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedRequiredArea) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?formulaTolerance
                )
                FILTER(
                    ABS(?reportedRequiredArea - ?expectedRequiredArea) > ?formulaTolerance ||
                    (?actualAreaM2 * "10000"^^xsd:decimal) < ?reportedRequiredArea
                )
            }
        """
    ] .

gs:I2_032Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:maxCount 0
            ]
        ]
        [
            sh:node gs:ApplicableShipCalculationShape
        ]
    ) .
