@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositivePressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:HullAreaValueShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaValue ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "A hull area value used for the calculation must have one decimal unitless hull area factor."
    ] .

gen:StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredTransverseFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] .

gen:I2_032ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:minCount 1 ;
                sh:class nltl:structuralMember ;
                sh:node gen:StructuralMemberShape
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape gen:HullAreaValueShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A ship with a regulated structural member must link to a hull area value carrying the hull area factor."
            ] ;
            sh:property [
                sh:path nltl:averageIcePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PressureQuantityShape
            ] ;
            sh:property [
                sh:path nltl:frameSpan ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:span ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:loadPatchHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:MetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:peakPressureFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:UnitlessQuantityShape
            ] ;
            sh:property [
                sh:path nltl:shearArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:SquareMetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:yieldStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositivePressureQuantityShape
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For each linked structural member, the reported required transverse frame shear area must match the calculated A_t within relative tolerance 1e-6 with absolute fallback 1e-9 cm2, and the actual shear area converted to cm2 must be at least the exact calculated A_t." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:hasComponent ?area ;
                      nltl:averageIcePressure ?pavgQuantity ;
                      nltl:frameSpan ?frameSpanQuantity ;
                      nltl:loadPatchHeight ?heightQuantity ;
                      nltl:peakPressureFactor ?ppfQuantity ;
                      nltl:shearArea ?actualAreaQuantity ;
                      nltl:yieldStrength ?yieldQuantity .

                ?area a nltl:hullAreaValue ;
                      nltl:hullAreaFactor ?hullAreaFactorQuantity .

                ?hullAreaFactorQuantity
                    qudt:numericValue ?hullAreaFactor .

                ?member nltl:frameSpacing ?spacingQuantity ;
                        nltl:selectedHullAreaFactor ?selectedFactorQuantity ;
                        nltl:requiredTransverseFrameShearArea ?reportedAreaQuantity .

                ?pavgQuantity qudt:numericValue ?pavg .
                ?frameSpanQuantity qudt:numericValue ?frameSpan .
                ?heightQuantity qudt:numericValue ?height .
                ?ppfQuantity qudt:numericValue ?ppf .
                ?actualAreaQuantity qudt:numericValue ?actualArea .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?selectedFactorQuantity qudt:numericValue ?selectedFactor .
                ?reportedAreaQuantity qudt:numericValue ?reportedArea .

                BIND(
                    IF(?frameSpan <= ?height, ?frameSpan, ?height)
                    AS ?ll
                )
                BIND(
                    (
                        "10000"^^xsd:decimal *
                        "0.5"^^xsd:decimal *
                        ?ll *
                        ?spacing *
                        (?selectedFactor * ?ppf * ?pavg)
                    ) /
                    ("0.577"^^xsd:decimal * ?yieldStrength)
                    AS ?expectedArea
                )
                BIND(
                    IF(
                        ABS(?expectedArea) * "0.000001"^^xsd:decimal >
                            "0.000000001"^^xsd:decimal,
                        ABS(?expectedArea) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?reportedTolerance
                )
                FILTER(
                    ABS(?reportedArea - ?expectedArea) > ?reportedTolerance ||
                    (?actualArea * "10000"^^xsd:decimal) < ?expectedArea
                )
            }
        """
    ] .
