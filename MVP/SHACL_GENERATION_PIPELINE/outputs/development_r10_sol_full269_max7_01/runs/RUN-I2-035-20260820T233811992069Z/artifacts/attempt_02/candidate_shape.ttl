@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredLongitudinalFrameShearArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LongitudinalFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gs:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gs:SquareMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:StructuralMemberShape
    ] ;
    sh:sparql [
        sh:message "The required longitudinal-frame shear area must match the stated formula within tolerance, and the actual net effective shear area must be at least the calculated requirement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:averageIcePressure ?pavgQuantity ;
                      nltl:frameSpan ?spanQuantity ;
                      nltl:loadPatchHeight ?heightQuantity ;
                      nltl:peakPressureFactor ?ppfQuantity ;
                      nltl:shearArea ?actualQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:hasStructuralMember ?member .

                ?pavgQuantity qudt:numericValue ?pavg .
                ?spanQuantity qudt:numericValue ?b .
                ?heightQuantity qudt:numericValue ?a .
                ?ppfQuantity qudt:numericValue ?ppf .
                ?actualQuantity qudt:numericValue ?actual .
                ?yieldQuantity qudt:numericValue ?yield .

                ?member nltl:frameSpacing ?spacingQuantity ;
                        nltl:selectedHullAreaFactor ?factorQuantity ;
                        nltl:requiredLongitudinalFrameShearArea ?requiredQuantity .

                ?spacingQuantity qudt:numericValue ?s .
                ?factorQuantity qudt:numericValue ?af .
                ?requiredQuantity qudt:numericValue ?reportedRequired .

                BIND(IF(?s = 0, 1.0, ?s) AS ?safeSpacing)
                BIND(IF(?yield = 0, 1.0, ?yield) AS ?safeYield)
                BIND(?b / ?safeSpacing AS ?bPrime)
                BIND(IF(?bPrime < 2.0,
                        ?b * (1.0 - 0.25 * ?bPrime),
                        ?s) AS ?b2)
                BIND((1.0 - 0.3 / ?bPrime) AS ?ko)
                BIND(?ko * ?b2 AS ?b1)
                BIND(
                    10000.0 * (?af * ?ppf * ?pavg) * 0.5 * ?b1 * ?a
                    / (0.577 * ?safeYield)
                    AS ?expectedRequired
                )
                BIND(
                    IF(
                        ABS(?expectedRequired) * 0.000001 > 0.000000001,
                        ABS(?expectedRequired) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )

                FILTER(
                    ?s = 0 ||
                    ?yield = 0 ||
                    ?bPrime = 0 ||
                    ABS(?reportedRequired - ?expectedRequired) > ?tolerance ||
                    (?actual * 10000.0) < ?expectedRequired
                )
            }
        """
    ] .
