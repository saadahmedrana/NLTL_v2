@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked web frame or load-carrying stringer must have a structural-member load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType .
                FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))
                FILTER NOT EXISTS {
                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked web frame or load-carrying stringer must have a member-capacity quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType .
                FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))
                FILTER NOT EXISTS {
                    ?member nltl:memberCapacity ?capacity .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each member-capacity value must be a QUDT quantity with a decimal value in kilonewtons." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?capacity
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType ;
                    nltl:memberCapacity ?capacity .
                FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))
                FILTER NOT EXISTS {
                    ?capacity a qudt:QuantityValue ;
                        qudt:numericValue ?numericValue ;
                        qudt:unit unit:KiloN .
                    FILTER (datatype(?numericValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every load case of a linked web frame or load-carrying stringer must record the combined shear-bending effect and load-patch application location as strings." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType ;
                    nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))
                FILTER NOT EXISTS {
                    ?loadCase a nltl:loadCase ;
                        nltl:combinedShearBendingEffect ?combinedEffect ;
                        nltl:loadPatchApplicationLocation ?applicationLocation .
                    FILTER (
                        datatype(?combinedEffect) = xsd:string &&
                        datatype(?applicationLocation) = xsd:string
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with a linked web frame or load-carrying stringer must have an ice-load-patch design case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType .
                FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))
                FILTER NOT EXISTS {
                    $this nltl:hasIceLoadPatchDesignCase ?designCase .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable ice-load-patch design case must confirm member-capacity minimization." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?designCase
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                    nltl:hasIceLoadPatchDesignCase ?designCase .
                ?member a ?memberType .
                FILTER (?memberType IN (nltl:webFrame, nltl:loadCarryingStringer))
                FILTER NOT EXISTS {
                    ?designCase a nltl:iceLoadPatchDesignCase ;
                        nltl:memberCapacityMinimizationConfirmed ?confirmed .
                    FILTER (
                        datatype(?confirmed) = xsd:boolean &&
                        ?confirmed = true
                    )
                }
            }
        """
    ] .
