@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_040_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:message "Yield strength is required for the local web buckling assessment." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_040_StructuralMemberShape
    ] .

gen:I2_040_StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:structuralSectionType ;
        sh:class nltl:structuralSectionTypeValue ;
        sh:in (
            nltl:flatBarStructuralSection
            nltl:bulbSection
            nltl:teeSection
            nltl:angleSection
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each assessed structural member must select exactly one permitted structural section type."
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:message "Web height is required for the local web buckling assessment." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:message "Net web thickness is required as the externally assessed result and buckling input." ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
