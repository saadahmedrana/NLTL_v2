@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2-052-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node gen:I2-052-CalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "A linear-interpolation calculation case is required."
    ] ;
    sh:property [
        sh:path nltl:interpolatedValue ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The externally determined interpolated value is required."
    ] .

gen:I2-052-CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:node gen:I2-052-MetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "The hull-girder longitudinal position from aft is required."
    ] ;
    sh:property [
        sh:path nltl:interpolatedLongitudinalDistributionFactor ;
        sh:node gen:I2-052-UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated longitudinal distribution factor is required."
    ] ;
    sh:property [
        sh:path nltl:hasInterpolationPoint ;
        sh:class nltl:interpolationPoint ;
        sh:node gen:I2-052-InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "At least one interpolation point is required."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node gen:I2-052-InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "A lower interpolation endpoint is required."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node gen:I2-052-InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "An upper interpolation endpoint is required."
    ] .

gen:I2-052-InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationCoordinate ;
        sh:node gen:I2-052-DecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each interpolation point requires an interpolation coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointValue ;
        sh:node gen:I2-052-DecimalQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each interpolation point requires an interpolation value."
    ] .

gen:I2-052-DecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] .

gen:I2-052-MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2-052-UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
