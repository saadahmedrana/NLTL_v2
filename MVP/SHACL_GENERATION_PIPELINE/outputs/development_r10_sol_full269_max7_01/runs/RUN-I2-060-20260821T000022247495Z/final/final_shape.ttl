@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_060_StructuralMemberShape
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string
    ] ;
    sh:or (
        [
            sh:property [
                sh:path (
                    nltl:hasStructuralMember
                    nltl:hasCutout
                ) ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path (
                    nltl:hasStructuralMember
                    nltl:hasCutout
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:memberInstability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "Loads carried by members in way of cut-outs must not cause instability."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Structural stiffening information is required where stiffening is necessary." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                ?member nltl:stiffeningNecessary ?necessary .
                FILTER(
                    datatype(?necessary) = xsd:boolean &&
                    ?necessary = true
                )
                FILTER NOT EXISTS {
                    $this nltl:structuralStiffening ?stiffening .
                }
            }
        """
    ] .

gen:I2_060_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCutout ;
        sh:class nltl:cutout
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A member in way of a cut-out must state whether stiffening is necessary."
            ]
        ]
    ) .
