@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_062_DirectCalculationReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A direct calculation must be recorded as used when a load-carrying stringer or web frame forms part of a grillage system." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType ;
                    nltl:partOfGrillageSystem ?grillage .
                ?grillage a nltl:grillageSystem .
                FILTER (?memberType IN (nltl:loadCarryingStringer, nltl:webFrame))
                FILTER NOT EXISTS {
                    $this nltl:directCalculationUsed ?used .
                    FILTER (
                        ISLITERAL(?used) &&
                        DATATYPE(?used) = xsd:boolean &&
                        ?used = true
                    )
                }
            }
        """
    ] .
