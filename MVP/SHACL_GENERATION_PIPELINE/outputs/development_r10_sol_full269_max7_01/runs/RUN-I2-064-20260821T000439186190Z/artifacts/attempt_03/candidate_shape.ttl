@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_064_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:calculationMethodValue ;
                sh:message "Each calculation case must identify a typed calculation method."
            ]
        ] ;
        sh:message "The ship must provide at least one calculation case with calculation-method evidence."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with a linear calculation case must provide yield strength in MPa as an xsd:decimal quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasCalculationCase ?case .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER NOT EXISTS {
        $this nltl:yieldStrength ?quantity .
        ?quantity qudt:numericValue ?value ;
                  qudt:unit unit:MegaPA .
        FILTER(datatype(?value) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every represented yield-strength quantity for a linear calculation must have only decimal numeric values and the MPa unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?quantity
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?quantity .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER(
        NOT EXISTS {
            ?quantity qudt:numericValue ?validValue .
            FILTER(datatype(?validValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?quantity qudt:numericValue ?invalidValue .
            FILTER(datatype(?invalidValue) != xsd:decimal)
        }
        ||
        NOT EXISTS {
            ?quantity qudt:unit unit:MegaPA .
        }
        ||
        EXISTS {
            ?quantity qudt:unit ?otherUnit .
            FILTER(?otherUnit != unit:MegaPA)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship using the linear calculation method must identify at least one typed structural member." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this
WHERE {
    $this nltl:hasCalculationCase ?case .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER NOT EXISTS {
        $this nltl:hasStructuralMember ?member .
        ?member a nltl:structuralMember .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every structural member linked by a ship using the linear calculation method must be typed as a structural member." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?member
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER NOT EXISTS {
        ?member a nltl:structuralMember .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each structural member in a linear calculation must identify a typed flange element." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?member
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER NOT EXISTS {
        ?member nltl:hasStructuralMemberFlange ?flange .
        ?flange a nltl:structuralMemberFlange .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every linked flange in a linear calculation must be typed as a structural member flange." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?flange
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    FILTER NOT EXISTS {
        ?flange a nltl:structuralMemberFlange .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each structural member in a linear calculation must identify a typed web plate." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?member
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER NOT EXISTS {
        ?member nltl:hasStructuralMemberWeb ?web .
        ?web a nltl:structuralMemberWeb .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every linked web in a linear calculation must be typed as a structural member web." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?web
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    FILTER NOT EXISTS {
        ?web a nltl:structuralMemberWeb .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each flange in a linear calculation must provide nominal von Mises stress in MPa as an xsd:decimal quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?flange
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    FILTER NOT EXISTS {
        ?flange nltl:nominalFlangeVonMisesStress ?quantity .
        ?quantity qudt:numericValue ?value ;
                  qudt:unit unit:MegaPA .
        FILTER(datatype(?value) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every represented flange-stress quantity must have only decimal numeric values and the MPa unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?quantity
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    ?flange nltl:nominalFlangeVonMisesStress ?quantity .
    FILTER(
        NOT EXISTS {
            ?quantity qudt:numericValue ?validValue .
            FILTER(datatype(?validValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?quantity qudt:numericValue ?invalidValue .
            FILTER(datatype(?invalidValue) != xsd:decimal)
        }
        ||
        NOT EXISTS {
            ?quantity qudt:unit unit:MegaPA .
        }
        ||
        EXISTS {
            ?quantity qudt:unit ?otherUnit .
            FILTER(?otherUnit != unit:MegaPA)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each web in a linear calculation must provide nominal shear stress in MPa as an xsd:decimal quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?web
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    FILTER NOT EXISTS {
        ?web nltl:nominalShearStress ?quantity .
        ?quantity qudt:numericValue ?value ;
                  qudt:unit unit:MegaPA .
        FILTER(datatype(?value) = xsd:decimal)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every represented web-shear-stress quantity must have only decimal numeric values and the MPa unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?quantity
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    ?web nltl:nominalShearStress ?quantity .
    FILTER(
        NOT EXISTS {
            ?quantity qudt:numericValue ?validValue .
            FILTER(datatype(?validValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?quantity qudt:numericValue ?invalidValue .
            FILTER(datatype(?invalidValue) != xsd:decimal)
        }
        ||
        NOT EXISTS {
            ?quantity qudt:unit unit:MegaPA .
        }
        ||
        EXISTS {
            ?quantity qudt:unit ?otherUnit .
            FILTER(?otherUnit != unit:MegaPA)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each flange in a linear calculation must explicitly confirm satisfaction of the applicable buckling criteria." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?flange
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    FILTER NOT EXISTS {
        ?flange nltl:bucklingCriteriaSatisfied ?satisfied .
        FILTER(
            datatype(?satisfied) = xsd:boolean
            && ?satisfied = true
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A flange buckling-criteria value in a linear calculation must be the boolean value true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?flange ?satisfied
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    ?flange nltl:bucklingCriteriaSatisfied ?satisfied .
    FILTER(
        datatype(?satisfied) != xsd:boolean
        || ?satisfied != true
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each web in a linear calculation must explicitly confirm satisfaction of the applicable buckling criteria." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?web
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    FILTER NOT EXISTS {
        ?web nltl:bucklingCriteriaSatisfied ?satisfied .
        FILTER(
            datatype(?satisfied) = xsd:boolean
            && ?satisfied = true
        )
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A web buckling-criteria value in a linear calculation must be the boolean value true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?web ?satisfied
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    ?web nltl:bucklingCriteriaSatisfied ?satisfied .
    FILTER(
        datatype(?satisfied) != xsd:boolean
        || ?satisfied != true
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Nominal shear stress in a member web must be strictly less than yield strength divided by sqrt(3)." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?web ?stressValue
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?yieldQuantity qudt:numericValue ?yieldValue ;
                   qudt:unit unit:MegaPA .
    ?member nltl:hasStructuralMemberWeb ?web .
    ?web nltl:nominalShearStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue ;
                    qudt:unit unit:MegaPA .
    FILTER(
        datatype(?yieldValue) = xsd:decimal
        && datatype(?stressValue) = xsd:decimal
        && xsd:decimal(?stressValue) >=
           (xsd:decimal(?yieldValue) / 1.7320508075688772)
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Nominal von Mises stress in a member flange must be strictly less than 1.15 times yield strength." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?flange ?stressValue
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?yieldQuantity qudt:numericValue ?yieldValue ;
                   qudt:unit unit:MegaPA .
    ?member nltl:hasStructuralMemberFlange ?flange .
    ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue ;
                    qudt:unit unit:MegaPA .
    FILTER(
        datatype(?yieldValue) = xsd:decimal
        && datatype(?stressValue) = xsd:decimal
        && xsd:decimal(?stressValue) >=
           (1.15 * xsd:decimal(?yieldValue))
    )
}
"""
    ] .
