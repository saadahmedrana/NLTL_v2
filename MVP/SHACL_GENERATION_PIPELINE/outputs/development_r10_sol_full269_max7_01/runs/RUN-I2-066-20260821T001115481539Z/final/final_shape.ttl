@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IceStrengthenedAreaWeldingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasWeld ;
        sh:class nltl:weld ;
        sh:node gen:IceStrengthenedAreaWeldShape
    ] .

gen:IceStrengthenedAreaWeldShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each linked weld must state whether it is within an ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:weldType ;
                sh:minCount 1 ;
                sh:in ( nltl:doubleContinuousWeld ) ;
                sh:message "A weld within an ice-strengthened area must be of the double continuous type."
            ]
        ]
    ) .
