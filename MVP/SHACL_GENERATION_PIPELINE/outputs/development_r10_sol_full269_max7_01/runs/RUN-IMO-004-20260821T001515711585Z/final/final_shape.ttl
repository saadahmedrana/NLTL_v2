@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FirstYearIceClassificationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOriginType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceOriginValue
    ] ;
    sh:property [
        sh:path nltl:winterGrowthCount ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceTypeValue
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Sea ice of no more than one winter growth and thickness from 0.3 m to 2.0 m inclusive must be classified as first-year ice." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceOriginType nltl:seaIceOrigin ;
          nltl:winterGrowthCount ?growth ;
          nltl:iceThickness ?thickness .
    ?thickness qudt:numericValue ?thicknessValue ;
               qudt:unit unit:M .
    FILTER (
        datatype(?growth) = xsd:integer &&
        ?growth <= "1"^^xsd:integer &&
        datatype(?thicknessValue) = xsd:decimal &&
        ?thicknessValue >= "0.3"^^xsd:decimal &&
        ?thicknessValue <= "2.0"^^xsd:decimal
    )
    FILTER NOT EXISTS {
        $this nltl:iceTypeClassification nltl:firstYearIce .
    }
}
"""
    ] .
