@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO011Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:minCount 1 ;
        sh:message "At least one daily low temperature is required to calculate the mean daily low temperature." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single data period is required." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:YR ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single mean daily low temperature is required." ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "10"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "10"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:minCount 1 ;
                sh:message "A data period shorter than 10 years requires an approved Administration dataset."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Mean daily low temperature must equal the average of the represented daily low temperatures within relative tolerance 1e-6 or absolute tolerance 1e-12 near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:meanDailyLowTemperature ?meanQuantity .
                ?meanQuantity qudt:numericValue ?reportedMean .
                {
                    SELECT $this (AVG(xsd:decimal(?dailyValue)) AS ?expectedMean)
                    WHERE {
                        $this nltl:dailyLowTemperature ?dailyQuantity .
                        ?dailyQuantity qudt:numericValue ?dailyValue .
                    }
                    GROUP BY $this
                }
                FILTER (
                    ABS(xsd:decimal(?reportedMean) - ?expectedMean) >
                    IF(
                        ABS(?expectedMean) * "0.000001"^^xsd:decimal >
                            "0.000000000001"^^xsd:decimal,
                        ABS(?expectedMean) * "0.000001"^^xsd:decimal,
                        "0.000000000001"^^xsd:decimal
                    )
                )
            }
        """
    ] .
