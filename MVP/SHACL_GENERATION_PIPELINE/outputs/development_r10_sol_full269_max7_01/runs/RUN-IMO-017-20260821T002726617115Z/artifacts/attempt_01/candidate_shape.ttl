@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO017ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCertificateForm ;
        sh:message "A Polar Ship Certificate is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:minCount 1 ;
        sh:class nltl:solasCertificateSchedule ;
        sh:node gen:IMO017SolasCertificateScheduleShape ;
        sh:message "An applicable SOLAS certificate schedule is required."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:minCount 1 ;
        sh:class nltl:polarCertificateSupplement ;
        sh:node gen:IMO017PolarCertificateSupplementShape ;
        sh:message "A Polar Ship Certificate supplement is required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate supplement must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate validity dates are required."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate survey dates are required."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate endorsement dates are required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Ship Certificate validity dates must match the validity dates in the applicable SOLAS certificate schedule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?polarDate .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER(
                            YEAR(?scheduleDate) = YEAR(?polarDate) &&
                            MONTH(?scheduleDate) = MONTH(?polarDate) &&
                            DAY(?scheduleDate) = DAY(?polarDate)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                            nltl:certificateScheduleDate ?scheduleDate .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?polarDate .
                        FILTER(
                            YEAR(?scheduleDate) = YEAR(?polarDate) &&
                            MONTH(?scheduleDate) = MONTH(?polarDate) &&
                            DAY(?scheduleDate) = DAY(?polarDate)
                        )
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Ship Certificate survey dates must match the survey dates in the applicable SOLAS certificate schedule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                {
                    $this nltl:surveyDates ?polarDate .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER(
                            YEAR(?scheduleDate) = YEAR(?polarDate) &&
                            MONTH(?scheduleDate) = MONTH(?polarDate) &&
                            DAY(?scheduleDate) = DAY(?polarDate)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                            nltl:certificateScheduleDate ?scheduleDate .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?polarDate .
                        FILTER(
                            YEAR(?scheduleDate) = YEAR(?polarDate) &&
                            MONTH(?scheduleDate) = MONTH(?polarDate) &&
                            DAY(?scheduleDate) = DAY(?polarDate)
                        )
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Ship Certificate endorsement dates must match the endorsement dates in the applicable SOLAS certificate schedule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                {
                    $this nltl:endorsementDates ?polarDate .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER(
                            YEAR(?scheduleDate) = YEAR(?polarDate) &&
                            MONTH(?scheduleDate) = MONTH(?polarDate) &&
                            DAY(?scheduleDate) = DAY(?polarDate)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                            nltl:certificateScheduleDate ?scheduleDate .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?polarDate .
                        FILTER(
                            YEAR(?scheduleDate) = YEAR(?polarDate) &&
                            MONTH(?scheduleDate) = MONTH(?polarDate) &&
                            DAY(?scheduleDate) = DAY(?polarDate)
                        )
                    }
                }
            }
        """
    ] .

gen:IMO017SolasCertificateScheduleShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:class nltl:certificateScheduleDateRecord ;
        sh:node gen:IMO017CertificateScheduleDateRecordShape ;
        sh:message "The SOLAS certificate schedule must contain certificate schedule-date records."
    ] .

gen:IMO017CertificateScheduleDateRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Each certificate schedule-date record must contain a date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:minCount 1 ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:message "Each certificate schedule-date record must identify a validity, survey, or endorsement date category."
    ] .

gen:IMO017PolarCertificateSupplementShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:message "The Polar Ship Certificate supplement must include required equipment records."
    ] .
