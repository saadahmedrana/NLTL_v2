@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO-022-Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual shall be present."
    ] ;
    sh:property [
        sh:path nltl:capabilitiesSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The manual shall include ship-specific capabilities."
    ] ;
    sh:property [
        sh:path nltl:limitationsSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The manual shall include ship-specific limitations."
    ] ;
    sh:property [
        sh:path nltl:operationalAssessmentReference ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The manual shall reference the operational assessment required under paragraph 1.5."
    ] .
