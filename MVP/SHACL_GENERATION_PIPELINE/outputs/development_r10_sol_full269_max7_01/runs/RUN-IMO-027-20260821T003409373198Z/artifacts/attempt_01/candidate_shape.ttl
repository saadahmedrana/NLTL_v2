@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PWOMRiskProcedureCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualRiskProcedureCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The PWOM shall record coverage of the required risk-based procedures."
    ] ;
    sh:property [
        sh:path nltl:voyageLimitAvoidance ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The PWOM shall include risk-based procedures for voyage-limit avoidance."
    ] ;
    sh:property [
        sh:path nltl:environmentalForecastArrangements ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The PWOM shall include arrangements for receiving environmental forecasts."
    ] ;
    sh:property [
        sh:path nltl:informationLimitationMeasures ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The PWOM shall include measures addressing limitations of available information."
    ] ;
    sh:property [
        sh:path nltl:requiredEquipmentOperation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The PWOM shall include procedures for operation of required equipment."
    ] ;
    sh:property [
        sh:path nltl:environmentalFunctionalityMeasures ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The PWOM shall record coverage of applicable environmental functionality measures."
    ] .
