@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO027PWOMRiskProcedureCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualRiskProcedureCoverage ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "PWOM risk-based procedure coverage shall be recorded as true."
    ] ;
    sh:property [
        sh:path nltl:voyageLimitAvoidance ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "PWOM procedures shall specify voyage-limit avoidance."
    ] ;
    sh:property [
        sh:path nltl:environmentalForecastArrangements ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "PWOM procedures shall specify arrangements for receiving environmental forecasts."
    ] ;
    sh:property [
        sh:path nltl:informationLimitationMeasures ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "PWOM procedures shall address limitations of available information."
    ] ;
    sh:property [
        sh:path nltl:requiredEquipmentOperation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "PWOM procedures shall specify operation of required equipment."
    ] ;
    sh:property [
        sh:path nltl:environmentalFunctionalityMeasures ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "PWOM procedures shall cover applicable environmental functionality measures."
    ] .
