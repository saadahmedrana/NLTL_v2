@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO030Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "Ice-operation monitoring and safety procedures must be present when ice operations apply."
            ] ;
            sh:property [
                sh:path nltl:escortRequirementsPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "Escort-requirement applicability must be recorded when ice operations apply."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:independentOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:minLength 1 ;
                        sh:message "Independent-operation limits must be specified when escort requirements do not apply."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:escortRequirementsPresent ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:escortedOperationLimits ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:minLength 1 ;
                        sh:message "Escorted-operation limits must be specified when escort requirements apply."
                    ]
                ]
            )
        ]
    ) ;
    sh:message "The ice-operation applicability state and all procedures and limitations required by the applicable branch must be recorded." .
