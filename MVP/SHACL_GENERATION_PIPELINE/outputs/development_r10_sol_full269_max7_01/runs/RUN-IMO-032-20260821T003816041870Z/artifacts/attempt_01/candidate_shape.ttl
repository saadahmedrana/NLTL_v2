@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ScantlingApprovalShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryA ;
                sh:in ( nltl:polarShipCategoryA )
            ] ;
            sh:node gen:CommonScantlingApprovalShape
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryB ;
                sh:in ( nltl:polarShipCategoryB )
            ] ;
            sh:node gen:CommonScantlingApprovalShape
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:in ( nltl:polarShipCategoryC )
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:in ( true )
            ] ;
            sh:node gen:CommonScantlingApprovalShape ;
            sh:property [
                sh:path nltl:operatingIceType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An ice-strengthened category C ship requires its operating-area ice type."
            ] ;
            sh:property [
                sh:path nltl:operatingIceConcentration ;
                sh:minCount 1 ;
                sh:node gen:OperatingIceConcentrationValueShape ;
                sh:message "An ice-strengthened category C ship requires its operating-area ice concentration."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:in ( nltl:polarShipCategoryC )
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:in ( false )
            ]
        ]
    ) .

gen:CommonScantlingApprovalShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "Applicable ship scantlings require approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Applicable ship scantlings require an approving authority."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Applicable ship scantlings require an approval standard."
    ] .

gen:OperatingIceConcentrationValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS ;
        sh:in ( unit:UNITLESS )
    ] .
