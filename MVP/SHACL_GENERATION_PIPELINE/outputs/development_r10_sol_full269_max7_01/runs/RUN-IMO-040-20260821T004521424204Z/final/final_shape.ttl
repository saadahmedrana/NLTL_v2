@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO040Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:message "Any supplied ice-accretion-likely value must be boolean."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When ice accretion is likely, every linked relevant hatch or door must have associated ice or snow removal or prevention means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?hatchOrDoor
            WHERE {
                $this nltl:iceAccretionLikely ?likely ;
                      nltl:hasRelevantHatchOrDoor ?hatchOrDoor .
                FILTER(?likely = "true"^^xsd:boolean)
                FILTER NOT EXISTS {
                    ?hatchOrDoor nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                }
            }
        """
    ] .
