@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO049ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:class nltl:polarShipCategoryValue
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryA
            ] ;
            sh:node gs:IMO049ApprovalEvidenceShape
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryB
            ] ;
            sh:node gs:IMO049ApprovalEvidenceShape
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:node gs:IMO049ApprovalEvidenceShape ;
            sh:node gs:IMO049CategoryCIceEvidenceShape
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:hasValue nltl:polarShipCategoryC
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:message "The ship category and ice-strengthening state must establish an applicable category A, category B, ice-strengthened category C, or non-ice-strengthened category C branch." .

gs:IMO049ApprovalEvidenceShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "Required scantling approval evidence must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "The approving authority must be identified."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "The approval standard must be identified."
    ] ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string
    ] .

gs:IMO049CategoryCIceEvidenceShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:message "An ice-strengthened category C ship must identify the operating ice type."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "An ice-strengthened category C ship must provide unitless operating ice concentration evidence."
    ] .
