@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipExtinguishingMediumCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:extinguishingMediumItem ;
        sh:node gen:ExtinguishingMediumItemCompatibilityShape ;
        sh:message "Each linked extinguishing medium must be an extinguishing-medium item suitable for its intended operation."
    ] .

gen:ExtinguishingMediumItemCompatibilityShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extinguishingMediumCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( "true"^^xsd:boolean ) ;
        sh:message "The extinguishing medium must have an approved compatibility status."
    ] .
