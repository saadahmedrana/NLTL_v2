@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO055Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:valveExposed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:valveType ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Exposed isolating, pressure, or vacuum valves must be protected from ice accretion and continuously accessible." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:valveExposed ?exposed ;
                      nltl:valveType ?type .
                FILTER(?exposed = "true"^^xsd:boolean)
                FILTER(?type IN (
                    "isolating"^^xsd:string,
                    "pressure"^^xsd:string,
                    "vacuum"^^xsd:string
                ))
                FILTER(
                    NOT EXISTS {
                        $this nltl:iceAccretionProtectionPresent ?protection .
                        FILTER(
                            DATATYPE(?protection) = xsd:boolean &&
                            ?protection = "true"^^xsd:boolean
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:iceAccretionProtectionPresent ?otherProtection .
                        FILTER(
                            DATATYPE(?otherProtection) != xsd:boolean ||
                            ?otherProtection != "true"^^xsd:boolean
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:continuouslyAccessible ?accessibility .
                        FILTER(
                            DATATYPE(?accessibility) = xsd:boolean &&
                            ?accessibility = "true"^^xsd:boolean
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:continuouslyAccessible ?otherAccessibility .
                        FILTER(
                            DATATYPE(?otherAccessibility) != xsd:boolean ||
                            ?otherAccessibility != "true"^^xsd:boolean
                        )
                    }
                )
            }
        """
    ] .
