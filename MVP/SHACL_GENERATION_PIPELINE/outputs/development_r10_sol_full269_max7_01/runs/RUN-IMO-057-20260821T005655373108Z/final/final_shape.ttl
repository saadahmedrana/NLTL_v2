@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gen:IMO057Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each fire pump must have a containing compartment." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?pump
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER NOT EXISTS {
        ?pump nltl:hasContainingCompartment ?compartment .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each containing compartment of a fire pump must be identified as a compartment." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?compartment
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER NOT EXISTS {
        ?compartment a nltl:compartment .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each containing compartment of a fire pump must have a maintained temperature." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?compartment
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER NOT EXISTS {
        ?compartment nltl:maintainedTemperature ?temperature .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each maintained temperature must be represented as a QUDT quantity value." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this ?temperature
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    ?compartment nltl:maintainedTemperature ?temperature .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER NOT EXISTS {
        ?temperature a qudt:QuantityValue .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each maintained temperature must have a numeric value." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this ?temperature
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    ?compartment nltl:maintainedTemperature ?temperature .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER NOT EXISTS {
        ?temperature qudt:numericValue ?numericValue .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each maintained temperature must use degrees Celsius." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
SELECT $this ?temperature
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    ?compartment nltl:maintainedTemperature ?temperature .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER NOT EXISTS {
        ?temperature qudt:unit unit:DEG_C .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A maintained temperature must not report a unit other than degrees Celsius." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
SELECT $this ?temperature ?reportedUnit
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    ?compartment nltl:maintainedTemperature ?temperature .
    ?temperature qudt:unit ?reportedUnit .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER(?reportedUnit != unit:DEG_C)
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every reported maintained-temperature numeric value must be numeric and greater than 0 degrees Celsius." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this ?temperature ?numericValue
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpType ;
          nltl:hasContainingCompartment ?compartment .
    ?compartment nltl:maintainedTemperature ?temperature .
    ?temperature qudt:numericValue ?numericValue .
    FILTER(?pumpType IN (
        nltl:firePump,
        nltl:emergencyFirePump,
        nltl:waterMistPump,
        nltl:waterSprayPump
    ))
    FILTER(!isNumeric(?numericValue) || ?numericValue <= 0)
}
"""
    ] .
