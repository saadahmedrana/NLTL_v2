@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExposedFireMainSectionShape
    a sh:NodeShape ;
    sh:class nltl:exposedFireMainSectionItem ;
    sh:property [
        sh:path nltl:fireMainSectionIsolationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Each exposed fire-main section must have isolation capability set to true."
    ] ;
    sh:property [
        sh:path nltl:fireMainSectionDrainageMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Each exposed fire-main section must have drainage means present set to true."
    ] .

gen:ShipFireMainShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedFireMainSection ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:exposedFireMainSectionItem ;
        sh:node gen:ExposedFireMainSectionShape ;
        sh:message "Every linked exposed fire-main section must satisfy the isolation and drainage requirements."
    ] .
