@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipEscapeRouteShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasExposedEscapeRoute ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasExposedEscapeRoute ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:exposedEscapeRoute ;
                sh:node gen:ExposedEscapeRouteShape ;
                sh:message "Every linked exposed escape route must have ice and snow mitigation evidence."
            ] ;
            sh:property [
                sh:path nltl:accessibleStatus ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "A ship with an exposed escape route must record accessible status as true."
            ] ;
            sh:property [
                sh:path nltl:safeStatus ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "A ship with an exposed escape route must record safe status as true."
            ] ;
            sh:property [
                sh:path nltl:iceSnowMitigationCoverage ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "A ship with an exposed escape route must record ice and snow mitigation coverage as true."
            ]
        ]
    ) .

gen:ExposedEscapeRouteShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceArtifact ;
        sh:message "The exposed escape route must have documented ice and snow mitigation evidence."
    ] .
