@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO064ThermalProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personOnBoard ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 0 ;
        sh:message "A non-negative persons-on-board count is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:personOnBoard ;
                sh:minInclusive 0 ;
                sh:maxInclusive 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:personOnBoard ;
                sh:minInclusive 1
            ] ;
            sh:property [
                sh:path nltl:assignedThermalProtection ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Thermal protection must be assigned when persons are on board."
            ] ;
            sh:property [
                sh:path nltl:thermalProtectionApprovalStatus ;
                sh:minCount 1 ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:message "Assigned thermal protection must have approved adequacy status."
            ] ;
            sh:property [
                sh:path nltl:intendedVoyage ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The intended voyage is required for thermal-protection adequacy."
            ] ;
            sh:property [
                sh:path nltl:anticipatedCold ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Anticipated cold conditions are required for thermal-protection adequacy."
            ] ;
            sh:property [
                sh:path nltl:anticipatedWind ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Anticipated wind conditions are required for thermal-protection adequacy."
            ] ;
            sh:property [
                sh:path nltl:immersionPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "Polar-water immersion potential must be stated when persons are on board."
            ]
        ]
    ) ;
    sh:message "A ship carrying persons must provide approved thermal protection accounting for the voyage, cold, wind, and immersion potential." .
