@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO064ThermalProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:personOnBoard ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:message "The persons-on-board count must be a single non-negative integer."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:personOnBoard ;
                sh:minInclusive 0 ;
                sh:maxInclusive 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:personOnBoard ;
                sh:minInclusive 1
            ] ;
            sh:property [
                sh:path nltl:assignedThermalProtection ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Thermal-protection equipment must be assigned when persons are on board."
            ] ;
            sh:property [
                sh:path nltl:thermalProtectionApprovalStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Assigned thermal protection must have approved adequacy status."
            ] ;
            sh:property [
                sh:path nltl:intendedVoyage ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:minLength 1 ;
                sh:message "A non-empty intended-voyage context is required."
            ] ;
            sh:property [
                sh:path nltl:anticipatedCold ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:minLength 1 ;
                sh:message "A non-empty anticipated-cold context is required."
            ] ;
            sh:property [
                sh:path nltl:anticipatedWind ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:minLength 1 ;
                sh:message "A non-empty anticipated-wind context is required."
            ] ;
            sh:property [
                sh:path nltl:immersionPotential ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Polar-water immersion potential must be recorded when persons are on board."
            ]
        ]
    ) .
