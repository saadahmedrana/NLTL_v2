@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO068Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO068ApplicableBranch
        gen:IMO068NotApplicableBranch
    ) .

gen:IMO068ApplicableBranch
    a sh:NodeShape ;
    sh:or (
        gen:IMO068IceCoveredOperationBranch
        gen:IMO068DirectIceEvacuationBranch
    ) ;
    sh:property [
        sh:path nltl:safeEvacuationMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Safe evacuation means must be present when the requirement applies."
    ] ;
    sh:property [
        sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "Survival equipment deployment must have approved status when the requirement applies."
    ] .

gen:IMO068IceCoveredOperationBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] .

gen:IMO068DirectIceEvacuationBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] .

gen:IMO068NotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false )
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false )
    ] .
