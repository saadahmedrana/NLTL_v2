@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:PassengerShipSurvivalEquipmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:class nltl:personOnBoardMember ;
        sh:node gs:PersonSurvivalEquipmentShape ;
        sh:message "Every linked person on board must have exactly one qualifying personal survival equipment assignment."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A passenger ship using an immersion-suit assignment must record exactly one sizeCompatibilityStatus value equal to true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasPersonOnBoardMember ?person .
                    ?person nltl:hasPersonalSurvivalEquipmentAssignment ?assignment .
                    ?assignment nltl:assignedPersonalSurvivalEquipment ?equipment .
                    ?equipment a nltl:immersionSuitEquipment .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus "true"^^xsd:boolean .
                    }
                    ||
                    EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status .
                        FILTER (!sameTerm(?status, "true"^^xsd:boolean))
                    }
                )
            }
        """
    ] .

gs:PersonSurvivalEquipmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:personalSurvivalEquipmentAssignment ;
        sh:node gs:SurvivalEquipmentAssignmentShape ;
        sh:message "Each person on board must have exactly one personal survival equipment assignment."
    ] .

gs:SurvivalEquipmentAssignmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:personalSurvivalEquipment ;
        sh:node gs:SurvivalEquipmentAlternativeShape ;
        sh:message "Each assignment must select exactly one immersion suit or thermal protective aid."
    ] .

gs:SurvivalEquipmentAlternativeShape
    a sh:NodeShape ;
    sh:xone (
        [
            sh:class nltl:immersionSuitEquipment
        ]
        [
            sh:class nltl:thermalProtectiveAidEquipment
        ]
    ) .
