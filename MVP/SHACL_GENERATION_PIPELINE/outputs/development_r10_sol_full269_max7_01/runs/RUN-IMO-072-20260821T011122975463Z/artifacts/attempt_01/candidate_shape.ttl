@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO072ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Extended-darkness operation must be explicitly recorded as false for the non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Extended-darkness operation must be explicitly recorded as true for the applicable branch."
            ] ;
            sh:property [
                sh:path nltl:continuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Continuous-use suitability status must be true during extended-darkness operation."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gs:IMO072LifeboatShape ;
                sh:message "Every linked lifeboat must have a suitable assigned searchlight."
            ]
        ]
    ) .

gs:IMO072LifeboatShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:qualifiedValueShape [
            sh:class nltl:searchlight ;
            sh:property [
                sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The lifeboat must have at least one assigned searchlight suitable for continuous use."
    ] .
