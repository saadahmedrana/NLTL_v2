@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO072Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:nodeKind sh:IRI ;
                sh:node gen:IMO072LifeboatShape ;
                sh:message "Each linked lifeboat must have at least one assigned searchlight suitable for continuous use."
            ]
        ]
    ) ;
    sh:message "Extended-darkness applicability must be stated, and applicable ships must satisfy the lifeboat searchlight requirement." .

gen:IMO072LifeboatShape
    a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:nodeKind sh:IRI ;
        sh:qualifiedValueShape gen:IMO072SuitableSearchlightShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The lifeboat must have at least one assigned searchlight suitable for continuous use."
    ] .

gen:IMO072SuitableSearchlightShape
    a sh:NodeShape ;
    sh:class nltl:searchlight ;
    sh:property [
        sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The assigned searchlight must be recorded as suitable for continuous use."
    ] .
