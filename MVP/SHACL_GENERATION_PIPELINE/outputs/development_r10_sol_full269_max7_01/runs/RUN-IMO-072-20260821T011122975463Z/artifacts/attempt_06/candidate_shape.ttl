@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipExtendedDarknessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:lifeboat ;
                sh:node gen:LifeboatSearchlightShape
            ]
        ]
    ) .

gen:LifeboatSearchlightShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:class nltl:searchlight ;
            sh:property [
                sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each lifeboat must have at least one assigned searchlight suitable for continuous use."
    ] .
