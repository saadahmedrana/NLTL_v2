@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO073ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:node gen:IMO073LifeboatShape
    ] .

gen:IMO073LifeboatShape
    a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:lifeboatTypeClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:partiallyEnclosedLifeboat
            nltl:totallyEnclosedLifeboat
        ) ;
        sh:message "Each lifeboat must be classified as partially enclosed or totally enclosed."
    ] .
