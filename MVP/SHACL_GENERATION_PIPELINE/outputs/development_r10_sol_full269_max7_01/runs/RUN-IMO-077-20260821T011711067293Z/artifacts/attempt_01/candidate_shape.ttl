@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO077Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether additional equipment is carried in the survival craft."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:survivalCraftAvailableCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:personsCapacityRequirement ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:additionalEquipmentCapacityRequirement ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:launchingApplianceCapacity ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloGM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:loadedSurvivalCraftRequirement ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloGM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Survival-craft capacity must cover persons and additional equipment, and launching-appliance capacity must cover the loaded survival craft." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:survivalCraftAvailableCapacity ?availableCapacity ;
          nltl:personsCapacityRequirement ?personsCapacity ;
          nltl:additionalEquipmentCapacityRequirement ?additionalCapacity ;
          nltl:launchingApplianceCapacity ?launchingQuantity ;
          nltl:loadedSurvivalCraftRequirement ?loadedQuantity .
    ?launchingQuantity qudt:numericValue ?launchingCapacity .
    ?loadedQuantity qudt:numericValue ?loadedRequirement .
    FILTER (
        ?availableCapacity < (?personsCapacity + ?additionalCapacity) ||
        ?launchingCapacity < ?loadedRequirement
    )
}
"""
            ]
        ]
    ) .
