@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AntennaIcePreventionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The required antenna must have ice accumulation prevention present."
    ] .

gen:ShipAntennaIcePreventionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:class nltl:navigationOrCommunicationAntenna ;
                sh:node gen:AntennaIcePreventionShape
            ]
        ]
    ) .
