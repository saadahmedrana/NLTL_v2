@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The low-air-temperature applicability state must be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:survivalCraft ;
                sh:node gen:IMO097ReleasedSurvivalCraftShape
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:lifeboat ;
                sh:node gen:IMO097LifeboatRelationshipShape
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:lifeboat ;
                sh:node gen:IMO097LifeboatRelationshipShape
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:otherSurvivalCraft
            ]
        ]
    ) .

gen:IMO097ReleasedSurvivalCraftShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each released survival craft must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each released survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each released survival craft must carry at least one on-scene transmit-and-receive communication device."
    ] .

gen:IMO097LifeboatRelationshipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:equipmentItem
    ] .
