@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "The low-air-temperature applicability value must be recorded as false for this branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The low-air-temperature applicability value must be recorded as true for this branch."
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "The release-state value must be recorded as false for this branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The low-air-temperature applicability value must be recorded as true for this branch."
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The release-state value must be recorded as true for this branch."
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:class nltl:survivalCraft ;
                sh:node gen:IMO097ReleasedSurvivalCraftShape ;
                sh:message "Every represented released survival craft must carry the required communication devices."
            ]
        ]
    ) .

gen:IMO097ReleasedSurvivalCraftShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "A released survival craft must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "A released survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "A released survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
