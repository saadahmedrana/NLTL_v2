@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipSurvivalCraftCommunicationsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:class nltl:survivalCraft ;
                sh:node gen:ApplicableSurvivalCraftShape
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gen:ApplicableLifeboatShape ;
                sh:node gen:ApplicableSurvivalCraftShape
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gen:ApplicableLifeboatShape ;
                sh:node gen:ApplicableSurvivalCraftShape
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:class nltl:otherSurvivalCraft
            ]
        ]
    ) .

gen:ApplicableSurvivalCraftShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable represented craft must carry a ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable represented craft must carry a location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each applicable represented craft must carry an on-scene communication device."
    ] .

gen:ApplicableLifeboatShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:class nltl:equipmentItem ;
        sh:minCount 1 ;
        sh:message "Each applicable represented lifeboat must have a distress-alert device."
    ] .
