@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO100VoyagePlanHazardCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:voyagePlanPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The ship must have a voyage plan recorded as present."
    ] ;
    sh:property [
        sh:path nltl:identifiedIntendedVoyageHazard ;
        sh:datatype xsd:string ;
        sh:message "Each identified intended-voyage hazard must be recorded as a string."
    ] ;
    sh:property [
        sh:path nltl:voyagePlanHazardCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The voyage plan must address every identified intended-voyage hazard."
    ] .
