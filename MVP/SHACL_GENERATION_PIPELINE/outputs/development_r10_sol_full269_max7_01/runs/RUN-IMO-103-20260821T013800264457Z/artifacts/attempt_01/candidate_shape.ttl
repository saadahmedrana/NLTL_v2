@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO103Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:administrationPermissionStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Use of an alternate qualified person requires Administration permission."
            ] ;
            sh:property [
                sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The alternate qualified person must comply with STCW Convention regulation II/2."
            ] ;
            sh:property [
                sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The alternate qualified person must comply with STCW Code section A-II/2."
            ] ;
            sh:property [
                sh:path nltl:advancedPolarTrainingStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The applicable advanced polar training requirements must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:watchCoverageStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Appropriately trained persons must cover all watches."
            ] ;
            sh:property [
                sh:path nltl:restComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Administration minimum hours of rest requirements must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:iceCondition ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The operating ice condition is required to assess basic-training safeguards."
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Ice concentration is required as a dimensionless quantity to assess basic-training safeguards."
            ] ;
            sh:property [
                sh:path nltl:designatedOfficerBasicTrainingStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The applicable basic-training safeguards for designated officers must be satisfied."
            ]
        ]
    ) .
