@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipPWOMFamiliarizationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "PWOM familiarization status must be recorded as completed."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:crewMember ;
        sh:node gen:CrewMemberPWOMFamiliarizationShape ;
        sh:message "The ship must identify its crew members."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:crewMember ;
        sh:node gen:CrewMemberPWOMFamiliarizationShape ;
        sh:message "The ship must provide its crew member inventory."
    ] .

gen:CrewMemberPWOMFamiliarizationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:assignedDuty ;
        sh:node gen:AssignedDutyPWOMShape ;
        sh:message "Each crew member must have an assigned duty."
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:familiarizationRecord ;
        sh:node gen:FamiliarizationRecordPWOMShape ;
        sh:message "Each crew member must have a familiarization record."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The crew member's familiarization records must cover every PWOM item relevant to the member's assigned duties." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?item
            WHERE {
                $this nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    $this nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """
    ] .

gen:AssignedDutyPWOMShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "Each assigned duty must identify its relevant PWOM items."
    ] .

gen:FamiliarizationRecordPWOMShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarWaterOperationalManualItem ;
        sh:message "Each familiarization record must identify the covered PWOM items."
    ] .
