@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship's PWOM familiarization status must be recorded as true."
    ] ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:crewMember ;
        sh:node gen:CrewMemberShape
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:crewMember ;
        sh:node gen:CrewMemberShape
    ] .

gen:CrewMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:assignedDuty ;
        sh:node gen:AssignedDutyShape
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:familiarizationRecord ;
        sh:node gen:FamiliarizationRecordShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The crew member lacks a familiarization record covering a PWOM item relevant to an assigned duty." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?item
            WHERE {
                $this nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    $this nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """
    ] .

gen:AssignedDutyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarWaterOperationalManualItem
    ] .

gen:FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:familiarizationRecordItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarWaterOperationalManualItem
    ] .
