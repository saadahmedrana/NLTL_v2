@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_105_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The operating area is required to determine whether the Arctic waters prohibition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "In Arctic waters, oil or oily mixture discharge to sea must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?value
            WHERE {
                $this nltl:operatingArea ?area .
                FILTER(STR(?area) = "Arctic_waters")
                OPTIONAL {
                    $this nltl:oilOrOilyMixtureDischargeToSea ?value .
                }
                FILTER(
                    !BOUND(?value) ||
                    DATATYPE(?value) != xsd:boolean ||
                    ?value != false
                )
            }
        """
    ] .
