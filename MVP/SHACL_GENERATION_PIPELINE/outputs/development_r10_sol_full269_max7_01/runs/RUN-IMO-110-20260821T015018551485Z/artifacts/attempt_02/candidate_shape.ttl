@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO-110-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Ship type is required as an xsd:string to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction date is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:deadweight ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:TON_Metric ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Deadweight in metric tonnes is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable Category A or B oil tanker must have compliant double-bottom and wing-tank protection statuses." ;
        sh:select """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this rdf:type nltl:oilTanker ;
          nltl:shipCategory ?category ;
          nltl:shipType ?shipType ;
          nltl:constructionDate ?constructionDate ;
          nltl:deadweight ?deadweight .

    ?deadweight qudt:numericValue ?deadweightValue ;
                qudt:unit unit:TON_Metric .

    FILTER(
        ?category IN (
            nltl:polarShipCategoryA,
            nltl:polarShipCategoryB
        )
    )
    FILTER(
        datatype(?shipType) = xsd:string &&
        STR(?shipType) = "oil tanker"
    )
    FILTER(
        datatype(?constructionDate) = xsd:date &&
        YEAR(?constructionDate) >= 2017
    )
    FILTER(
        datatype(?deadweightValue) = xsd:decimal &&
        ?deadweightValue < 5000
    )
    FILTER(
        NOT EXISTS {
            $this nltl:entireCargoTankLengthDoubleBottomProtectionStatus ?doubleBottomStatus .
            FILTER(
                datatype(?doubleBottomStatus) = xsd:boolean &&
                ?doubleBottomStatus = true
            )
        }
        ||
        NOT EXISTS {
            $this nltl:wingTankProtectionStatus ?wingTankStatus .
            FILTER(
                datatype(?wingTankStatus) = xsd:boolean &&
                ?wingTankStatus = true
            )
        }
    )
}
"""
    ] .
