@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO111Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ship category is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Construction date is required for a Category A or B ship." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipCategory ?category .
    FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
    FILTER NOT EXISTS {
        $this nltl:constructionDate ?constructionDate .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Tank type is required for a Category A or B ship constructed on or after 1 January 2017." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?constructionDate .
    FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
    FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
    FILTER NOT EXISTS {
        $this nltl:tankType ?tankType .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Individual tank capacity is required for an applicable oil residue or oily bilge water holding tank." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?constructionDate ;
          nltl:tankType ?tankType .
    FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
    FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
    FILTER(?tankType IN (
        "oil_residue_tank"^^xsd:string,
        "oily_bilge_water_holding_tank"^^xsd:string
    ))
    FILTER NOT EXISTS {
        $this nltl:individualTankCapacity ?capacity .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable tank exceeding 30 cubic metres must be separated from the outer shell by at least 0.76 metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:shipCategory ?category ;
          nltl:constructionDate ?constructionDate ;
          nltl:tankType ?tankType ;
          nltl:individualTankCapacity ?capacity .
    ?capacity qudt:numericValue ?capacityValue ;
              qudt:unit unit:M3 .
    FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
    FILTER(?constructionDate >= "2017-01-01"^^xsd:date)
    FILTER(?tankType IN (
        "oil_residue_tank"^^xsd:string,
        "oily_bilge_water_holding_tank"^^xsd:string
    ))
    FILTER(?capacityValue > "30"^^xsd:decimal)
    FILTER NOT EXISTS {
        $this nltl:tankOuterShellSeparation ?separation .
        ?separation qudt:numericValue ?separationValue ;
                    qudt:unit unit:M .
        FILTER(?separationValue >= "0.76"^^xsd:decimal)
    }
}
"""
    ] .
