@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO-114-Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarShipCategoryValue ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarShipCategoryValue ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:maxExclusive "2017-01-01"^^xsd:date ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:minInclusive "2017-01-01"^^xsd:date ;
                        sh:minCount 1
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
                                sh:datatype xsd:boolean ;
                                sh:in ( false ) ;
                                sh:minCount 1
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
                                sh:datatype xsd:boolean ;
                                sh:in ( true ) ;
                                sh:minCount 1
                            ] ;
                            sh:or (
                                [
                                    sh:property [
                                        sh:path nltl:cargoTankType ;
                                        sh:datatype xsd:string ;
                                        sh:minCount 1 ;
                                        sh:or (
                                            [ sh:maxLength 0 ]
                                            [ sh:minLength 2 ]
                                            [
                                                sh:minLength 1 ;
                                                sh:maxLength 1 ;
                                                sh:pattern "^[^3]$"
                                            ]
                                        )
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:cargoTankType ;
                                        sh:datatype xsd:string ;
                                        sh:in ( "3"^^xsd:string ) ;
                                        sh:minCount 1
                                    ] ;
                                    sh:property [
                                        sh:path nltl:administrationCarriageApprovalStatus ;
                                        sh:nodeKind sh:IRI ;
                                        sh:class nltl:evidenceState ;
                                        sh:in ( nltl:evidenceStateApproved ) ;
                                        sh:minCount 1 ;
                                        sh:message "Applicable carriage requires Administration approval."
                                    ] ;
                                    sh:property [
                                        sh:path nltl:applicableCertificatePolarOperationEntryPresent ;
                                        sh:datatype xsd:boolean ;
                                        sh:in ( true ) ;
                                        sh:minCount 1 ;
                                        sh:message "Applicable carriage requires the polar-operation certificate entry."
                                    ]
                                ]
                            )
                        ]
                    )
                ]
            )
        ]
    ) .
