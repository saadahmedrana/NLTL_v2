@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:NauticalMileQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MI_N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DistanceOverThreeNauticalMilesShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "3"^^xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MI_N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IceConcentrationAboveOneTenthShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "1"^^xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IMO115ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The sewage discharge type must be recorded."
    ] ;
    sh:property [
        sh:path nltl:comminutedAndDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The comminuted-and-disinfected applicability state must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:comminutedAndDisinfected ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:comminutedAndDisinfected ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Comminuted and disinfected sewage discharge must comply with MARPOL Annex IV regulation 11.1.1."
            ] ;
            sh:property [
                sh:path nltl:distanceToNearestIceShelfOrFastIce ;
                sh:minCount 1 ;
                sh:node gen:DistanceOverThreeNauticalMilesShape ;
                sh:message "Distance to the nearest ice shelf or fast ice must be more than three nautical miles."
            ] ;
            sh:property [
                sh:path nltl:nearbyIceConcentration ;
                sh:minCount 1 ;
                sh:node gen:IceConcentrationAboveOneTenthShape ;
                sh:message "Nearby ice concentration exceeding one tenth must be recorded."
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:minCount 1 ;
                sh:node gen:IceConcentrationAboveOneTenthShape ;
                sh:message "Ice concentration for the relevant area must exceed one tenth."
            ] ;
            sh:property [
                sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
                sh:minCount 1 ;
                sh:node gen:NauticalMileQuantityShape ;
                sh:message "Distance from an area with ice concentration above one tenth must be recorded."
            ]
        ]
    ) .
