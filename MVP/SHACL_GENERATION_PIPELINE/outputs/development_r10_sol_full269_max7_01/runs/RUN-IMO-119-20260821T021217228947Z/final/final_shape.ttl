@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO119Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property gen:CategoryCPropertyShape
        ]
        [
            sh:property gen:CategoryABPropertyShape ;
            sh:property gen:IceAtMostOneTenthPropertyShape
        ]
        [
            sh:property gen:CategoryABPropertyShape ;
            sh:property gen:IceAboveOneTenthPropertyShape ;
            sh:property gen:ExtendedPeriodFalsePropertyShape
        ]
        [
            sh:property gen:CategoryABPropertyShape ;
            sh:property gen:IceAboveOneTenthPropertyShape ;
            sh:property gen:ExtendedPeriodTruePropertyShape ;
            sh:property gen:SewageDischargeFalsePropertyShape
        ]
        [
            sh:property gen:CategoryABPropertyShape ;
            sh:property gen:IceAboveOneTenthPropertyShape ;
            sh:property gen:ExtendedPeriodTruePropertyShape ;
            sh:property gen:SewageDischargeTruePropertyShape ;
            sh:property gen:ApprovedTreatmentPlantPropertyShape ;
            sh:property gen:MarpolAnnexIvCertificationPropertyShape ;
            sh:property gen:MarpolCertificationPropertyShape ;
            sh:property gen:AdministrationApprovalPropertyShape
        ]
    ) .

gen:CategoryCPropertyShape a sh:PropertyShape ;
    sh:path nltl:shipCategory ;
    sh:nodeKind sh:IRI ;
    sh:in ( nltl:polarShipCategoryC ) ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gen:CategoryABPropertyShape a sh:PropertyShape ;
    sh:path nltl:shipCategory ;
    sh:nodeKind sh:IRI ;
    sh:in (
        nltl:polarShipCategoryA
        nltl:polarShipCategoryB
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gen:IceAtMostOneTenthPropertyShape a sh:PropertyShape ;
    sh:path nltl:iceConcentration ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:IceAtMostOneTenthValueShape .

gen:IceAtMostOneTenthValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:maxInclusive "1"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IceAboveOneTenthPropertyShape a sh:PropertyShape ;
    sh:path nltl:iceConcentration ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node gen:IceAboveOneTenthValueShape .

gen:IceAboveOneTenthValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "1"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ExtendedPeriodFalsePropertyShape a sh:PropertyShape ;
    sh:path nltl:extendedPeriodOperation ;
    sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gen:ExtendedPeriodTruePropertyShape a sh:PropertyShape ;
    sh:path nltl:extendedPeriodOperation ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gen:SewageDischargeFalsePropertyShape a sh:PropertyShape ;
    sh:path nltl:sewageDischargeOccurs ;
    sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gen:SewageDischargeTruePropertyShape a sh:PropertyShape ;
    sh:path nltl:sewageDischargeOccurs ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:minCount 1 ;
    sh:maxCount 1 .

gen:ApprovedTreatmentPlantPropertyShape a sh:PropertyShape ;
    sh:path nltl:approvedSewageTreatmentPlantUsed ;
    sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Applicable sewage discharge must use an approved sewage treatment plant." .

gen:MarpolAnnexIvCertificationPropertyShape a sh:PropertyShape ;
    sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
    sh:nodeKind sh:IRI ;
    sh:in ( nltl:evidenceStateApproved ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Applicable sewage discharge requires approved MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification." .

gen:MarpolCertificationPropertyShape a sh:PropertyShape ;
    sh:path nltl:marpolCertificationStatus ;
    sh:nodeKind sh:IRI ;
    sh:in ( nltl:evidenceStateApproved ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Applicable sewage discharge requires approved MARPOL certification status." .

gen:AdministrationApprovalPropertyShape a sh:PropertyShape ;
    sh:path nltl:administrationDischargeApprovalStatus ;
    sh:nodeKind sh:IRI ;
    sh:in ( nltl:evidenceStateApproved ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Applicable sewage discharge requires approval by the Administration." .
