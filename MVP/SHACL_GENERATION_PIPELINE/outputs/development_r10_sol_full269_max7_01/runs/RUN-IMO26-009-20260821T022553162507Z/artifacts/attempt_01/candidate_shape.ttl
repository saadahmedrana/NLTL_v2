@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipAntennaIcePreventionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IceAccretionNotLikelyShape
        gen:IceAccretionLikelyShape
    ) .

gen:IceAccretionNotLikelyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( false ) ;
        sh:message "Ice-accretion applicability must be explicitly recorded as false for the non-applicable branch."
    ] .

gen:IceAccretionLikelyShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Ice-accretion applicability must be explicitly recorded as true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
        sh:minCount 1 ;
        sh:class nltl:navigationOrCommunicationAntenna ;
        sh:node gen:RequiredAntennaIcePreventionShape ;
        sh:message "When ice accretion is likely, each required navigation or communication antenna must have ice-accumulation prevention."
    ] .

gen:RequiredAntennaIcePreventionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The required antenna must record ice-accumulation prevention as present."
    ] .
