@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26-013Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:gnssCompassOrEquivalentCount ;
        sh:datatype xsd:integer
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship proceeding above 80 degrees latitude must have at least one GNSS compass or equivalent and connections to benchmark entities representing both main and emergency power." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:plannedOrActualLatitude ?latitudeQuantity .
                ?latitudeQuantity
                    qudt:numericValue ?latitude ;
                    qudt:unit unit:DEG .
                FILTER(?latitude > "80"^^xsd:decimal)
                FILTER(
                    NOT EXISTS {
                        $this nltl:gnssCompassOrEquivalentCount ?count .
                        FILTER(
                            datatype(?count) = xsd:integer &&
                            ?count >= 1
                        )
                    } ||
                    NOT EXISTS {
                        $this nltl:connectedToMainPower ?mainPower .
                        ?mainPower a nltl:benchmarkEntity .
                    } ||
                    NOT EXISTS {
                        $this nltl:connectedToEmergencyPower ?emergencyPower .
                        ?emergencyPower a nltl:benchmarkEntity .
                    }
                )
            }
        """
    ] .
