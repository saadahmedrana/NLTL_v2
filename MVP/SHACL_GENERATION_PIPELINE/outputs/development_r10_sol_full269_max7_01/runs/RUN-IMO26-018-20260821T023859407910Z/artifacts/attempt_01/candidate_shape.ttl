@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO26_018_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Polar Code chapter 11-1 applicability must be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanningTopicCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "When chapter 11-1 applies, voyage planning must cover all nine clause 11-1.3 topics."
            ] ;
            sh:property [
                sh:path nltl:safetyManagementSystemImplemented ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When chapter 11-1 applies, safety-management-system status must be recorded."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:safetyManagementSystemImplemented ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:safetyManagementSystemImplemented ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:documentedPolarOperationProcedurePresent ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true ;
                        sh:message "If no safety management system is implemented, a documented polar operation procedure must be present."
                    ]
                ]
            )
        ]
    ) .
