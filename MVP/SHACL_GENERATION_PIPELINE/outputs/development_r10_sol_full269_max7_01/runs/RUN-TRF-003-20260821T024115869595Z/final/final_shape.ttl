@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF003Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2012-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:minInclusive "2012-01-01"^^xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRegulationEdition2010
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:minInclusive "2019-01-01"^^xsd:date
            ]
        ]
    ) ;
    sh:message "The construction contract date must establish applicability; ships contracted from 2012-01-01 through 2018-12-31 must identify the 2010 Ice Class Regulations as applicable." .
