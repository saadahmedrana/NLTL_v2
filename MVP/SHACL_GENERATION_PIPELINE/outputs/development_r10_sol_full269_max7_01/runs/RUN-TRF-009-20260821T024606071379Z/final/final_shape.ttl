@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF009Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:message "The ship's ice class is required to determine applicability."
    ] ;
    sh:sparql [
        sh:message "An IA Super or IA ship must provide a valid construction-stage date to determine applicability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER (datatype(?constructionDate) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable ship must provide a valid delivery date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .
                FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER (datatype(?constructionDate) = xsd:date)
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?deliveryDate .
                    FILTER (datatype(?deliveryDate) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable ship must provide a valid assessment date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .
                FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER (datatype(?constructionDate) = xsd:date)
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?assessmentDate .
                    FILTER (datatype(?assessmentDate) = xsd:date)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "By 1 January of the twentieth year after delivery, the applicable ship must use the section 3.2.2 or section 3.2.4 compliance method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER (datatype(?constructionDate) = xsd:date)
                FILTER (datatype(?deliveryDate) = xsd:date)
                FILTER (datatype(?assessmentDate) = xsd:date)
                FILTER (
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
                )
                FILTER (YEAR(?assessmentDate) >= YEAR(?deliveryDate) + 20)
                FILTER NOT EXISTS {
                    $this nltl:engineOutputComplianceMethod ?method .
                    FILTER (
                        ?method IN (
                            nltl:traficom2017Section3Point2Point2Method,
                            nltl:traficom2017Section3Point2Point4Method
                        )
                    )
                }
            }
        """
    ] .
