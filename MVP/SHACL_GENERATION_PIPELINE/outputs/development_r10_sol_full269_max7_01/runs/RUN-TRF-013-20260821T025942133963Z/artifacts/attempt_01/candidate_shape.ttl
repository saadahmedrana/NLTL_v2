@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF013ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ice-strengthened applicability state must be recorded."
    ] ;
    sh:or (
        gen:TRF013NotIceStrengthenedShape
        gen:TRF013IceStrengthenedShape
    ) .

gen:TRF013NotIceStrengthenedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:in ( false ) ;
        sh:minCount 1
    ] .

gen:TRF013IceStrengthenedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "An ice class is required for an ice-strengthened ship."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "An upper ice waterline is required for an ice-strengthened ship."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "A lower ice waterline is required for an ice-strengthened ship."
    ] ;
    sh:property [
        sh:path nltl:operatingForeDraught ;
        sh:minCount 1 ;
        sh:node gen:TRF013MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:operatingAftDraught ;
        sh:minCount 1 ;
        sh:node gen:TRF013MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:node gen:TRF013MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:node gen:TRF013MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:node gen:TRF013MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:node gen:TRF013MetreQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Operating fore and aft draughts must be within the corresponding inclusive minimum and maximum ice-class draught bounds." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:shipIceStrengthened true ;
          nltl:operatingForeDraught ?operatingFore ;
          nltl:operatingAftDraught ?operatingAft ;
          nltl:minimumIceClassDraughtFore ?minimumFore ;
          nltl:maximumIceClassDraughtFore ?maximumFore ;
          nltl:minimumIceClassDraughtAft ?minimumAft ;
          nltl:maximumIceClassDraughtAft ?maximumAft .
    ?operatingFore qudt:numericValue ?operatingForeValue .
    ?operatingAft qudt:numericValue ?operatingAftValue .
    ?minimumFore qudt:numericValue ?minimumForeValue .
    ?maximumFore qudt:numericValue ?maximumForeValue .
    ?minimumAft qudt:numericValue ?minimumAftValue .
    ?maximumAft qudt:numericValue ?maximumAftValue .
    FILTER (
        ?operatingForeValue < ?minimumForeValue ||
        ?operatingForeValue > ?maximumForeValue ||
        ?operatingAftValue < ?minimumAftValue ||
        ?operatingAftValue > ?maximumAftValue
    )
}
"""
    ] .

gen:TRF013MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
