@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF013Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state exactly once whether it is ice-strengthened."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1 ;
                sh:message "An ice-strengthened ship must have an ice class."
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:message "An ice-strengthened ship must have an upper ice waterline."
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:message "An ice-strengthened ship must have a lower ice waterline."
            ] ;
            sh:property [
                sh:path nltl:operatingForeDraught ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:operatingAftDraught ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtFore ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumIceClassDraughtAft ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtFore ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:minimumIceClassDraughtAft ;
                sh:node gs:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The operating fore and aft draughts must be within their inclusive minimum and maximum ice-class draught bounds." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:operatingForeDraught ?operatingForeNode ;
          nltl:operatingAftDraught ?operatingAftNode ;
          nltl:minimumIceClassDraughtFore ?minimumForeNode ;
          nltl:maximumIceClassDraughtFore ?maximumForeNode ;
          nltl:minimumIceClassDraughtAft ?minimumAftNode ;
          nltl:maximumIceClassDraughtAft ?maximumAftNode .
    ?operatingForeNode qudt:numericValue ?operatingFore .
    ?operatingAftNode qudt:numericValue ?operatingAft .
    ?minimumForeNode qudt:numericValue ?minimumFore .
    ?maximumForeNode qudt:numericValue ?maximumFore .
    ?minimumAftNode qudt:numericValue ?minimumAft .
    ?maximumAftNode qudt:numericValue ?maximumAft .
    FILTER (
        xsd:decimal(?operatingFore) < xsd:decimal(?minimumFore) ||
        xsd:decimal(?operatingFore) > xsd:decimal(?maximumFore) ||
        xsd:decimal(?operatingAft) < xsd:decimal(?minimumAft) ||
        xsd:decimal(?operatingAft) > xsd:decimal(?maximumAft)
    )
}
"""
            ]
        ]
    ) .
