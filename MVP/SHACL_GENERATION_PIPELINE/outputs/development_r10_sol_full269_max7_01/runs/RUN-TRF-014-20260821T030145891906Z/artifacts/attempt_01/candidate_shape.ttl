@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IceDraughtRestrictionDocumentShape
    a sh:NodeShape ;
    sh:class nltl:iceDraughtRestrictionDocument .

gen:TRF014Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship must have a recorded ice class."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:nodeKind sh:IRI ;
        sh:node gen:ClassCertificateShape ;
        sh:minCount 1 ;
        sh:message "A class certificate containing all six maximum and minimum ice-class draughts is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:nodeKind sh:IRI ;
        sh:node gen:IceDraughtRestrictionDocumentShape ;
        sh:minCount 1 ;
        sh:message "The draught restrictions for operation in ice must be documented."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-draught restriction documentation must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice-draught restriction documentation must be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The construction date is required to determine the applicable marking rule."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The summer load-line fresh-water draught is required to determine marking applicability."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The upper ice waterline draught is required to determine marking applicability."
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:MetreQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the summer load line is above the UIWL and the marking deadline applies, a warning triangle and an ice-class draught mark are required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionDate ?constructionDate ;
          nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?summerQuantity qudt:numericValue ?summerValue ;
                    qudt:unit unit:M .
    ?uiwlQuantity qudt:numericValue ?uiwlValue ;
                  qudt:unit unit:M .

    BIND(YEAR(?constructionDate) AS ?constructionYear)
    BIND(MONTH(?constructionDate) AS ?constructionMonth)
    BIND(DAY(?constructionDate) AS ?constructionDay)

    FILTER(?summerValue < ?uiwlValue)
    FILTER(
        ?constructionYear > 2007 ||
        (
            ?constructionYear = 2007 &&
            (
                ?constructionMonth > 7 ||
                (?constructionMonth = 7 && ?constructionDay >= 1)
            )
        ) ||
        (
            (
                ?constructionYear < 2007 ||
                (
                    ?constructionYear = 2007 &&
                    (
                        ?constructionMonth < 7 ||
                        (?constructionMonth = 7 && ?constructionDay < 1)
                    )
                )
            ) &&
            NOT EXISTS {
                $this nltl:firstScheduledDryDockingDate ?futureDockingDate .
                FILTER(
                    YEAR(?futureDockingDate) > YEAR(NOW()) ||
                    (
                        YEAR(?futureDockingDate) = YEAR(NOW()) &&
                        (
                            MONTH(?futureDockingDate) > MONTH(NOW()) ||
                            (
                                MONTH(?futureDockingDate) = MONTH(NOW()) &&
                                DAY(?futureDockingDate) > DAY(NOW())
                            )
                        )
                    )
                )
            }
        )
    )
    FILTER NOT EXISTS {
        $this nltl:warningTrianglePresent true ;
              nltl:iceClassDraughtMarkPresent true ;
              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable ice-class draught mark must indicate the maximum permissible ice-class draught amidships from a linked class certificate." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionDate ?constructionDate ;
          nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?summerQuantity qudt:numericValue ?summerValue ;
                    qudt:unit unit:M .
    ?uiwlQuantity qudt:numericValue ?uiwlValue ;
                  qudt:unit unit:M .

    BIND(YEAR(?constructionDate) AS ?constructionYear)
    BIND(MONTH(?constructionDate) AS ?constructionMonth)
    BIND(DAY(?constructionDate) AS ?constructionDay)

    FILTER(?summerValue < ?uiwlValue)
    FILTER(
        ?constructionYear > 2007 ||
        (
            ?constructionYear = 2007 &&
            (
                ?constructionMonth > 7 ||
                (?constructionMonth = 7 && ?constructionDay >= 1)
            )
        ) ||
        (
            (
                ?constructionYear < 2007 ||
                (
                    ?constructionYear = 2007 &&
                    (
                        ?constructionMonth < 7 ||
                        (?constructionMonth = 7 && ?constructionDay < 1)
                    )
                )
            ) &&
            NOT EXISTS {
                $this nltl:firstScheduledDryDockingDate ?futureDockingDate .
                FILTER(
                    YEAR(?futureDockingDate) > YEAR(NOW()) ||
                    (
                        YEAR(?futureDockingDate) = YEAR(NOW()) &&
                        (
                            MONTH(?futureDockingDate) > MONTH(NOW()) ||
                            (
                                MONTH(?futureDockingDate) = MONTH(NOW()) &&
                                DAY(?futureDockingDate) > DAY(NOW())
                            )
                        )
                    )
                )
            }
        )
    )

    $this nltl:warningTrianglePresent true ;
          nltl:iceClassDraughtMarkPresent true ;
          nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
    ?markQuantity qudt:numericValue ?markValue ;
                  qudt:unit unit:M .

    FILTER NOT EXISTS {
        $this nltl:hasClassCertificate ?certificate .
        ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
        ?maximumQuantity qudt:numericValue ?expectedValue ;
                         qudt:unit unit:M .
        BIND(IF(ABS(?expectedValue) * 0.000001 > 0.000000001,
                ABS(?expectedValue) * 0.000001,
                0.000000001) AS ?tolerance)
        FILTER(ABS(?markValue - ?expectedValue) <= ?tolerance)
    }
}
"""
    ] .
