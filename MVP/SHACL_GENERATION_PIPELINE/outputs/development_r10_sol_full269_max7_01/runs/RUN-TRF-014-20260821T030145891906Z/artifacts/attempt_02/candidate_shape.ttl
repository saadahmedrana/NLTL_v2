@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] .

gen:CompleteDraughtMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-class draught mark must equal the linked class certificate's maximum ice-class draught amidships." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this ?mark ?certificateMaximum
WHERE {
    $this nltl:iceClassDraughtMarkDraughtAmidships ?mark .
    ?mark qudt:numericValue ?markValue .
    $this nltl:hasClassCertificate ?certificate .
    ?certificate nltl:maximumIceClassDraughtAmidships ?certificateMaximum .
    ?certificateMaximum qudt:numericValue ?certificateValue .
    FILTER (?markValue != ?certificateValue)
}
"""
    ] .

gen:SummerLoadLineNotHigherShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The summer load line is higher than the upper ice waterline, so marking evidence is required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summer .
    ?summer qudt:numericValue ?summerValue .
    $this nltl:upperIceWaterlineDraught ?uiwl .
    ?uiwl qudt:numericValue ?uiwlValue .
    FILTER (?summerValue < ?uiwlValue)
}
"""
    ] .

gen:Pre2007PendingDryDockingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The unmarked pre-1 July 2007 ship must have a higher summer load line and a first scheduled dry docking date that is still in the future." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summer .
    ?summer qudt:numericValue ?summerValue .
    $this nltl:upperIceWaterlineDraught ?uiwl .
    ?uiwl qudt:numericValue ?uiwlValue .
    $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
    FILTER (
        ?summerValue >= ?uiwlValue ||
        YEAR(?dryDockingDate) < YEAR(NOW()) ||
        (
            YEAR(?dryDockingDate) = YEAR(NOW()) &&
            MONTH(?dryDockingDate) < MONTH(NOW())
        ) ||
        (
            YEAR(?dryDockingDate) = YEAR(NOW()) &&
            MONTH(?dryDockingDate) = MONTH(NOW()) &&
            DAY(?dryDockingDate) <= DAY(NOW())
        )
    )
}
"""
    ] .

gen:TRF014Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:node gen:ClassCertificateShape ;
        sh:minCount 1 ;
        sh:message "A class certificate containing all maximum and minimum ice-class draughts is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:message "Documented restrictions on draughts when operating in ice are required."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "The ice-draught restriction documentation must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "The ice-draught restriction documentation must be readily available to the master."
    ] ;
    sh:or (
        gen:CompleteDraughtMarkingShape
        gen:SummerLoadLineNotHigherShape
        gen:Pre2007PendingDryDockingShape
    ) ;
    sh:message "The ship must provide the required warning triangle and ice-class draught mark, or establish a permitted non-marking condition." .
