@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:node gen:ClassCertificateShape ;
        sh:message "A class certificate containing all maximum and minimum ice-class draughts is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:message "The ice draught restrictions must be documented."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice draught restriction documentation must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice draught restriction documentation must be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A construction date is required to determine the applicable marking rule."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape ;
        sh:message "The summer load-line fresh-water draught is required to determine marking applicability."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape ;
        sh:message "The upper ice waterline draught is required to determine marking applicability."
    ] ;
    sh:or (
        gen:SummerLoadLineNotHigherShape
        gen:Post2007MarkingShape
        gen:Pre2007MarkingOrDryDockingShape
    ) .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:minCount 1 ;
        sh:node gen:LengthQuantityShape
    ] .

gen:SummerLoadLineNotHigherShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This alternative applies only when the summer load-line fresh-water draught is numerically greater than or equal to the upper ice waterline draught." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?summerQuantity qudt:numericValue ?summerValue .
    ?uiwlQuantity qudt:numericValue ?uiwlValue .
    FILTER (?summerValue < ?uiwlValue)
}
"""
    ] .

gen:Post2007MarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:node gen:TriggeringDraughtConditionShape ;
    sh:node gen:CompleteMarkingShape .

gen:Pre2007MarkingOrDryDockingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:node gen:TriggeringDraughtConditionShape ;
    sh:or (
        gen:CompleteMarkingShape
        gen:Pre2007DryDockingScheduleShape
    ) .

gen:Pre2007DryDockingScheduleShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "For an unmarked pre-1 July 2007 ship, the first scheduled dry-docking date on or after the cutoff must be recorded."
    ] .

gen:TriggeringDraughtConditionShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This marking alternative applies only when the summer load-line fresh-water draught is numerically less than the upper ice waterline draught." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?summerQuantity qudt:numericValue ?summerValue .
    ?uiwlQuantity qudt:numericValue ?uiwlValue .
    FILTER (?summerValue >= ?uiwlValue)
}
"""
    ] .

gen:CompleteMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A warning triangle is required."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An ice-class draught mark is required."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthQuantityShape ;
        sh:message "The amidships draught represented by the ice-class draught mark is required."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:maximumIceClassDraughtAmidships ;
                sh:minCount 1 ;
                sh:node gen:LengthQuantityShape
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-class draught mark must equal the class certificate's maximum ice-class draught amidships." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
          nltl:hasClassCertificate ?certificate .
    ?markQuantity qudt:numericValue ?markValue .
    ?certificate nltl:maximumIceClassDraughtAmidships ?certificateQuantity .
    ?certificateQuantity qudt:numericValue ?certificateValue .
    FILTER (?markValue != ?certificateValue)
}
"""
    ] .
