@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetricTonneQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:TON_Metric ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BallastTankConstraintShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:situatedAboveLowerIceWaterline ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:situatedAboveLowerIceWaterline ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:situatedAboveLowerIceWaterline ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:usedToReachLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:usedToReachLowerIceWaterline ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:usedToReachLowerIceWaterline ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:freezingPreventionPresent ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "A ballast tank above LIWL that is needed to reach LIWL shall have freezing prevention."
                    ]
                ]
            )
        ]
    ) .

gen:ShipTRF016Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The navigating-in-ice applicability state must be recorded."
    ] ;

    sh:property [
        sh:path nltl:propellerHighestPointSubmerged ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The highest point of the propeller shall be submerged."
    ] ;

    sh:property [
        sh:path nltl:hasBallastTank ;
        sh:class nltl:ballastTank ;
        sh:node gen:BallastTankConstraintShape
    ] ;

    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "At least one upper ice waterline is required to determine UIWL displacement."
    ] ;

    sh:property [
        sh:path nltl:displacementAtUpperIceWaterline ;
        sh:node gen:MetricTonneQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:forwardDraught ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "When navigating in ice, draught amidships shall be at least the LIWL draught amidships." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?draughtQuantity ;
                              nltl:liwlDraughtAmidships ?liwlQuantity .
                        ?draughtQuantity qudt:numericValue ?draught .
                        ?liwlQuantity qudt:numericValue ?liwl .
                        FILTER (?draught < ?liwl)
                    }
                """
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "Every linked UIWL shall have exactly one decimal displacement expressed in metric tonnes." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasUpperIceWaterline ?waterline .
                OPTIONAL {
                    ?waterline nltl:waterlineDisplacement ?quantity .
                    OPTIONAL {
                        ?quantity qudt:numericValue ?value .
                    }
                    OPTIONAL {
                        ?quantity qudt:unit ?unit .
                    }
                }
            }
            GROUP BY $this ?waterline
            HAVING (
                COUNT(DISTINCT ?quantity) != 1 ||
                COUNT(DISTINCT ?value) != 1 ||
                COUNT(DISTINCT ?unit) != 1 ||
                MAX(
                    IF(
                        BOUND(?value),
                        IF(DATATYPE(?value) = xsd:decimal, 1, 0),
                        0
                    )
                ) != 1 ||
                MAX(
                    IF(
                        BOUND(?unit),
                        IF(?unit = <http://qudt.org/vocab/unit/TON_Metric>, 1, 0),
                        0
                    )
                ) != 1
            )
        """
    ] ;

    sh:sparql [
        sh:message "UIWL displacement shall equal the greatest displacement among the linked UIWL waterlines within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 tonnes." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:displacementAtUpperIceWaterline ?reportedQuantity .
                ?reportedQuantity qudt:numericValue ?reported .
                {
                    SELECT $this (MAX(?candidate) AS ?expected)
                    WHERE {
                        $this nltl:hasUpperIceWaterline ?waterline .
                        ?waterline nltl:waterlineDisplacement ?candidateQuantity .
                        ?candidateQuantity qudt:numericValue ?candidate .
                    }
                    GROUP BY $this
                }
                BIND(
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?reported - ?expected) > ?tolerance)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Forward draught shall be at least the lesser of (2 + 0.00025 times UIWL displacement) times level ice thickness and four times level ice thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:forwardDraught ?forwardQuantity ;
                      nltl:levelIceThickness ?iceQuantity ;
                      nltl:displacementAtUpperIceWaterline ?displacementQuantity .
                ?forwardQuantity qudt:numericValue ?forwardDraught .
                ?iceQuantity qudt:numericValue ?iceThickness .
                ?displacementQuantity qudt:numericValue ?displacement .
                BIND(
                    (2.0 + (0.00025 * ?displacement)) * ?iceThickness
                    AS ?displacementLimit
                )
                BIND(4.0 * ?iceThickness AS ?fourThicknessLimit)
                BIND(
                    IF(
                        ?displacementLimit < ?fourThicknessLimit,
                        ?displacementLimit,
                        ?fourThicknessLimit
                    )
                    AS ?minimumForwardDraught
                )
                FILTER (?forwardDraught < ?minimumForwardDraught)
            }
        """
    ] .
