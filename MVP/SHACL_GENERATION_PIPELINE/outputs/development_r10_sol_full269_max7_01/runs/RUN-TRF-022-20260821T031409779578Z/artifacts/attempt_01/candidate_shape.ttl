@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KilogramPerSquareMetreSquareSecondQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KilogramPerSquareSecondQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonPerSquareMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonPerMetreToPowerOnePointFiveQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF022ComplexReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowRakeAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:waterlineAngleAtQuarterBreadth ;
        sh:minCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:node gen:KilogramPerSquareMetreSquareSecondQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:node gen:KilogramPerSquareMetreSquareSecondQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:node gen:KilogramPerSquareSecondQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:node gen:NewtonPerSquareMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:node gen:NewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:node gen:NewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:node gen:NewtonPerSquareMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:node gen:NewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:node gen:NewtonPerMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:node gen:NewtonPerMetreToPowerOnePointFiveQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flareAngle ;
        sh:minCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] .
