@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF023Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF023NonApplicableIceClassBranch
        gen:TRF023NonApplicableEditionBranch
        gen:TRF023ApplicableBranch
    ) ;
    sh:message "The ship must establish a non-applicable branch or, when ice class IB or IC is subject to the 1985 rules, satisfy the required minimum engine output." .

gen:TRF023NonApplicableIceClassBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

gen:TRF023NonApplicableEditionBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassRegulationEdition2002
            nltl:iceClassRegulationEdition2008
            nltl:iceClassRegulationEdition2010
            nltl:iceClassRegulationEdition2017
            nltl:iceClassRegulationEdition2021
        )
    ] .

gen:TRF023ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassRuleEdition1985
        )
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloW
            ]
        ] ;
        sh:message "An applicable ship must provide one maximum continuous rating power in kilowatts."
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloW
            ]
        ] ;
        sh:message "An applicable ship must provide one required power value under the 1985 rules in kilowatts."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?mcrQuantity ;
                      nltl:requiredPowerUnder1985Rules ?requiredQuantity .
                ?mcrQuantity qudt:numericValue ?mcr .
                ?requiredQuantity qudt:numericValue ?required .
                FILTER(?mcr < ?required)
            }
        """
    ] .
