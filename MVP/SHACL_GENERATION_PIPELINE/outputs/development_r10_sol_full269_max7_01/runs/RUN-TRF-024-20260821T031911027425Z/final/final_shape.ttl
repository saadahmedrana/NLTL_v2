@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF024Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "The ship's ice class is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIa
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:minInclusive "2003-09-01"^^xsd:date ;
                sh:message "The construction-stage date is required and must establish that the ship reached that stage on or after 1 September 2003."
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIa
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:sparql [
                sh:message "The assessment date must be before 1 January of the year twenty years after the delivery year for this alternative." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:deliveryDate ?delivery ;
          nltl:assessmentDate ?assessment .
    FILTER(
        datatype(?delivery) = xsd:date &&
        datatype(?assessment) = xsd:date &&
        YEAR(?assessment) >= YEAR(?delivery) + 20
    )
}
"""
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIa
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date
            ] ;
            sh:property [
                sh:path nltl:engineOutputComplianceMethod ;
                sh:hasValue nltl:traficom2017Section3Point2Point2Method ;
                sh:message "Compliance with the requirements in section 3.2.2 is required by the applicable deadline."
            ] ;
            sh:sparql [
                sh:message "This alternative applies only from 1 January of the year twenty years after the delivery year." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:deliveryDate ?delivery ;
          nltl:assessmentDate ?assessment .
    FILTER(
        datatype(?delivery) = xsd:date &&
        datatype(?assessment) = xsd:date &&
        YEAR(?assessment) < YEAR(?delivery) + 20
    )
}
"""
            ]
        ]
    ) .
