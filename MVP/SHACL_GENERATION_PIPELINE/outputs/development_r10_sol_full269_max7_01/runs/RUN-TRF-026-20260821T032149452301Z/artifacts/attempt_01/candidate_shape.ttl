@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DecimalQuantityInNewtonShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalQuantityInMetreShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalQuantityInNewtonPerMetreShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalQuantityInNewtonPerSquareMetreShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalQuantityInNewtonPerMetrePowerOnePointFiveShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF026ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship must have exactly one controlled ice-class value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientF1 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonPerSquareMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientF2 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonPerMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientF3 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonPerMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientF4 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonPerSquareMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientG1 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientG2 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonPerMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:coefficientG3 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonPerMetrePowerOnePointFiveShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:shipBreadth ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:shipLength ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceClassDraught ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInMetreShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:brashIceResistanceCoefficientC1 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:brashIceResistanceCoefficientC2 ;
                sh:class qudt:QuantityValue ;
                sh:node gen:DecimalQuantityInNewtonShape ;
                sh:minCount 1
            ]
        ]
    ) .
