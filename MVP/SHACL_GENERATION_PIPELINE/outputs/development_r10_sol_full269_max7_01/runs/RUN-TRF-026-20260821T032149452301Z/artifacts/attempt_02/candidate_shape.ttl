@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF026Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "Exactly one controlled ice class is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bulbousBowPresent ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            )
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:bulbousBowPresent ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:coefficientF1 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonPerSquareMetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:coefficientF2 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonPerMetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:coefficientF3 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonPerMetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:coefficientF4 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonPerSquareMetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:coefficientG1 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:coefficientG2 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonPerMetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:coefficientG3 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonPerMetrePowerOnePointFiveQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:shipBreadth ;
                        sh:minCount 1 ;
                        sh:node gen:MetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:shipLength ;
                        sh:minCount 1 ;
                        sh:node gen:MetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:iceClassDraught ;
                        sh:minCount 1 ;
                        sh:node gen:MetreQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:brashIceResistanceCoefficientC1 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonQuantityValueShape
                    ] ;
                    sh:property [
                        sh:path nltl:brashIceResistanceCoefficientC2 ;
                        sh:minCount 1 ;
                        sh:node gen:NewtonQuantityValueShape
                    ] ;
                    sh:message "An IA Super ship with a bulb requires all declared C1 and C2 calculation inputs and externally computed results."
                ]
            )
        ]
    ) .

gen:NewtonQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonPerMetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonPerSquareMetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:NewtonPerMetrePowerOnePointFiveQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
