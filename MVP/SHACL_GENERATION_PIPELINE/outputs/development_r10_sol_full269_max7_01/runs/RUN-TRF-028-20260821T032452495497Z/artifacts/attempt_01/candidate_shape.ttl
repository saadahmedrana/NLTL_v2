@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF028ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The approval status for the alternative Ke or RCH determination must be recorded."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:message "The approval lifecycle or revocation status must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:qualifiedValueShape [
                    sh:class nltl:alternativeCalculationEvidence
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "Alternative-calculation evidence is required for this determination method."
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:qualifiedValueShape [
                    sh:class nltl:modelTestEvidence
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "Model-test evidence is required for this determination method."
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:node gen:EngineOutputCoefficientKeValueShape ;
                sh:message "An externally determined Ke result must be provided."
            ]
        ]
        [
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:minCount 1 ;
                sh:node gen:BrashIceChannelResistanceRchValueShape ;
                sh:message "An externally determined RCH result must be provided."
            ]
        ]
    ) .

gen:EngineOutputCoefficientKeValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The Ke result must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Ke result must use the unit UNITLESS."
    ] .

gen:BrashIceChannelResistanceRchValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The RCH result must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:N ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The RCH result must use the unit N."
    ] .
