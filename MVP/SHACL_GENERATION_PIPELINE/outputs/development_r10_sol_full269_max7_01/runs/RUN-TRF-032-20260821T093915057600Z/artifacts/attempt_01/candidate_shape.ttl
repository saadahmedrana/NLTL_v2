@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF032Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengtheningStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether it has been ice strengthened."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:regulationRequiredScantling ;
                sh:minCount 1 ;
                sh:node gen:ScantlingQuantityShape ;
                sh:message "A regulation-required scantling is required for a ship that has not been ice strengthened."
            ] ;
            sh:property [
                sh:path nltl:classificationSocietyRequiredScantling ;
                sh:minCount 1 ;
                sh:node gen:ScantlingQuantityShape ;
                sh:message "A classification-society-required scantling is required for a ship that has not been ice strengthened."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the regulation-required scantling is less than the classification-society-required scantling, the selected design scantling must equal the latter." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false ;
          nltl:regulationRequiredScantling ?regulationScantling ;
          nltl:classificationSocietyRequiredScantling ?classificationScantling .
    ?regulationScantling qudt:numericValue ?regulationValue .
    ?classificationScantling qudt:numericValue ?classificationValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER NOT EXISTS {
        $this nltl:selectedDesignScantling ?selectedScantling .
        ?selectedScantling qudt:numericValue ?selectedValue .
        FILTER (?selectedValue = ?classificationValue)
    }
}
"""
    ] .

gen:ScantlingQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
