@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IceClassDesignParameterSetShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:or (
        [
            sh:property [
                sh:path [ sh:inversePath nltl:hasIceClassDesignParameterSet ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:ship ;
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:iceClassIaSuper )
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LevelIceThickness1_0
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DesignIceLoadHeight0_35
            ]
        ]
        [
            sh:property [
                sh:path [ sh:inversePath nltl:hasIceClassDesignParameterSet ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:ship ;
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:iceClassIa )
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LevelIceThickness0_8
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DesignIceLoadHeight0_30
            ]
        ]
        [
            sh:property [
                sh:path [ sh:inversePath nltl:hasIceClassDesignParameterSet ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:ship ;
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:iceClassIb )
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LevelIceThickness0_6
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DesignIceLoadHeight0_25
            ]
        ]
        [
            sh:property [
                sh:path [ sh:inversePath nltl:hasIceClassDesignParameterSet ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:ship ;
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:iceClassIc )
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LevelIceThickness0_4
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:DesignIceLoadHeight0_22
            ]
        ]
    ) .

gen:LevelIceThickness1_0
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "1.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LevelIceThickness0_8
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.8"^^xsd:decimal ;
        sh:maxInclusive "0.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

