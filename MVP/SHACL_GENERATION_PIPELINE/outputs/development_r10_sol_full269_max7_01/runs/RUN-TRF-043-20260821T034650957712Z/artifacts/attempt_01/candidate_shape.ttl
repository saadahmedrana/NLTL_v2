@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF043FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The frame must identify its applicable ice class."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIi nltl:iceClassIii )
            ]
        ]
        [
            sh:node gen:ApplicableFrameCommonShape ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:node gen:IaSuperTableShape
        ]
        [
            sh:node gen:ApplicableFrameCommonShape ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                )
            ] ;
            sh:node gen:IaIbIcTableShape
        ]
    ) ;
    sh:message "The frame must satisfy the applicable Table 4-6 vertical strengthening requirements or the explicit boundary-termination exception." .

gen:ApplicableFrameCommonShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullRegion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bowRegion
            nltl:midbodyRegion
            nltl:sternRegion
        ) ;
        sh:message "An applicable frame must identify its bow, midbody, or stern region."
    ] ;
    sh:node gen:UpperBowIceBeltConditionShape ;
    sh:node gen:BoundaryTerminationStateShape .

gen:UpperBowIceBeltConditionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:upperBowIceBeltRequired ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:upperBowIceBeltRequired ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:reachesUpperBowIceBeltTop ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "The upper-bow ice-belt applicability state must be recorded, and required strengthening must reach the belt top." .

gen:BoundaryTerminationStateShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) ;
    sh:message "Boundary termination may be asserted only when the extension beyond the adjacent boundary is no more than 250 mm." .

gen:ExplicitBoundaryTerminationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal ;
                sh:maxInclusive 250
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MilliM
            ]
        ]
    ] .

gen:IaSuperTableShape
    a sh:NodeShape ;
    sh:node gen:AboveUiwl12OrBoundaryExceptionShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:bowRegion
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:reachesTankTopOrBelowFloorTop ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:node gen:ExplicitBoundaryTerminationShape
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:midbodyRegion
            ] ;
            sh:node gen:BelowLiwl20OrBoundaryExceptionShape
        ]
        [
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:sternRegion
            ] ;
            sh:node gen:BelowLiwl16OrBoundaryExceptionShape
        ]
    ) .

gen:IaIbIcTableShape
    a sh:NodeShape ;
    sh:node gen:AboveUiwl10OrBoundaryExceptionShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:bowRegion
            ] ;
            sh:node gen:BelowLiwl16OrBoundaryExceptionShape
        ]
        [
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:midbodyRegion
            ] ;
            sh:node gen:BelowLiwl13OrBoundaryExceptionShape
        ]
        [
            sh:property [
                sh:path nltl:hullRegion ;
                sh:hasValue nltl:sternRegion
            ] ;
            sh:node gen:BelowLiwl10OrBoundaryExceptionShape
        ]
    ) .

gen:AboveUiwl12OrBoundaryExceptionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 1.2
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) .

gen:AboveUiwl10OrBoundaryExceptionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingIceStrengtheningAboveUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 1.0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) .

gen:BelowLiwl20OrBoundaryExceptionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 2.0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) .

gen:BelowLiwl16OrBoundaryExceptionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 1.6
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) .

