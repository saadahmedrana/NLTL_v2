    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 1.3
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) .

gen:BelowLiwl10OrBoundaryExceptionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:framingIceStrengtheningBelowLowerIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive 1.0
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:node gen:ExplicitBoundaryTerminationShape
        ]
    ) .
