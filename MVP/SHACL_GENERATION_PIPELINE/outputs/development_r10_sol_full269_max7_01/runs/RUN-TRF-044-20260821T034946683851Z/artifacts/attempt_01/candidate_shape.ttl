@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:AreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TransverseFrameSectionModulusAndShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:twoDeckFrameCondition
        ) ;
        sh:message "A supported frame boundary condition is required."
    ] ;

    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:message "The frame boundary condition factor m0 is required."
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape ;
        sh:message "The calculated frame moment factor mt is required."
    ] ;

    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node gs:DimensionlessQuantityShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive "1.2"^^xsd:decimal ;
                sh:maxInclusive "1.2"^^xsd:decimal
            ]
        ] ;
        sh:message "The frame shear distribution factor f3 must be 1.2."
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PressureQuantityShape ;
        sh:message "Ice pressure is required for the calculation."
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape ;
        sh:message "Frame spacing is required for the calculation."
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape ;
        sh:message "Design ice load height is required for the calculation."
    ] ;

    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape ;
        sh:message "Effective frame span is required for the calculation."
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PressureQuantityShape ;
        sh:message "Yield strength is required for the calculation."
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:SectionModulusQuantityShape ;
        sh:message "The calculated section modulus is required."
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaQuantityShape ;
        sh:message "The calculated required shear area is required."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "7"^^xsd:decimal ;
                        sh:maxInclusive "7"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "6"^^xsd:decimal ;
                        sh:maxInclusive "6"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "5.7"^^xsd:decimal ;
                        sh:maxInclusive "5.7"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:twoDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "5"^^xsd:decimal ;
                        sh:maxInclusive "5"^^xsd:decimal
                    ]
                ]
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "The reported mt, section modulus, or required shear area does not match the prescribed calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionFactorM0/qudt:numericValue ?m0 ;
                      nltl:frameMomentFactorMt/qudt:numericValue ?reportedMt ;
                      nltl:frameShearDistributionFactorF3/qudt:numericValue ?f3 ;
                      nltl:icePressure/qudt:numericValue ?p ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:effectiveFrameSpan/qudt:numericValue ?l ;
                      nltl:yieldStrength/qudt:numericValue ?sigmaY ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND((7 - (5 * ?h / ?l)) AS ?denominator)
                BIND((7 * ?m0 / ?denominator) AS ?expectedMt)
                BIND((?p * ?s * ?h * ?l / (?expectedMt * ?sigmaY)) * 1000000 AS ?expectedZ)
                BIND((1.7320508075688772 * ?f3 * ?p * ?h * ?s / (2 * ?sigmaY)) * 10000 AS ?expectedA)

                BIND(
                    IF(
                        ABS(?expectedMt) * 0.000001 > 0.000000001,
                        ABS(?expectedMt) * 0.000001,
                        0.000000001
                    ) AS ?mtTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedZ) * 0.000001 > 0.000000001,
                        ABS(?expectedZ) * 0.000001,
                        0.000000001
                    ) AS ?zTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedA) * 0.000001 > 0.000000001,
                        ABS(?expectedA) * 0.000001,
                        0.000000001
                    ) AS ?aTolerance
                )

                FILTER (
                    ?l = 0 ||
                    ?sigmaY = 0 ||
                    ?denominator = 0 ||
                    ABS(?reportedMt - ?expectedMt) > ?mtTolerance ||
                    ABS(?reportedZ - ?expectedZ) > ?zTolerance ||
                    ABS(?reportedA - ?expectedA) > ?aTolerance
                )
            }
        """
    ] .
