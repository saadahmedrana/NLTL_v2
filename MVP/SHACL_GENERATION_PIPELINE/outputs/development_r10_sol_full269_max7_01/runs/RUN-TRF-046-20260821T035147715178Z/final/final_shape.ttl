@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The strengthened upper end of a main frame or intermediate ice frame must be attached to a deck structure, tank boundary plating, or ice stringer." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a ?frameType .
    FILTER (?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))
    FILTER NOT EXISTS {
        $this nltl:hasStrengthenedPart ?strengthenedPart ;
              nltl:hasUpperEnd ?upperEnd .
        ?strengthenedPart a nltl:frameStrengthenedPart .
        ?upperEnd a nltl:frameEnd ;
                  nltl:hasAttachedSupportingStructure ?supportingStructure .
        ?supportingStructure a ?supportingStructureType .
        FILTER (?supportingStructureType IN (
            nltl:deckStructure,
            nltl:tankBoundaryPlating,
            nltl:iceStringer
        ))
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ordinary-frame scantlings may be used only where the frame terminates above a deck or ice stringer at or above the ice-belt upper limit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a ?frameType ;
          nltl:hasStrengthenedPart ?strengthenedPart .
    FILTER (?frameType IN (nltl:mainFrame, nltl:intermediateIceFrame))
    ?strengthenedPart
        nltl:ordinaryFrameScantlingsUsed "true"^^xsd:boolean .
    FILTER NOT EXISTS {
        $this nltl:hasUpperEnd ?upperEnd .
        ?upperEnd
            nltl:hasTerminationAboveSupportingStructure ?supportingStructure .
        ?supportingStructure
            a ?supportingStructureType ;
            nltl:supportingStructureAtOrAboveIceBeltUpperLimit "true"^^xsd:boolean .
        FILTER (?supportingStructureType IN (
            nltl:deckStructure,
            nltl:iceStringer
        ))
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An intermediate-frame horizontal connection used under this permission must connect to an adjacent main frame, have the same scantlings as the main frame, and occur above qualifying supporting structure." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:intermediateIceFrame ;
          nltl:hasUpperEnd ?upperEnd .
    ?upperEnd nltl:hasHorizontalConnectionMember ?horizontalMember .
    FILTER NOT EXISTS {
        ?upperEnd
            nltl:hasTerminationAboveSupportingStructure ?supportingStructure .
        ?supportingStructure
            a ?supportingStructureType ;
            nltl:supportingStructureAtOrAboveIceBeltUpperLimit "true"^^xsd:boolean .
        FILTER (?supportingStructureType IN (
            nltl:deckStructure,
            nltl:iceStringer
        ))
        ?horizontalMember
            a nltl:horizontalConnectionMember ;
            nltl:sameScantlingsAsMainFrame "true"^^xsd:boolean ;
            nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
        ?adjacentMainFrame a nltl:mainFrame .
    }
}
"""
    ] .

gen:StrengthenedPartStateShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasStrengthenedPart ;
    sh:property [
        sh:path nltl:ordinaryFrameScantlingsUsed ;
        sh:datatype xsd:boolean
    ] .

gen:SupportingStructureStateShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasTerminationAboveSupportingStructure ;
    sh:property [
        sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
        sh:datatype xsd:boolean
    ] .

gen:HorizontalConnectionMemberStateShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasHorizontalConnectionMember ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean
    ] .
