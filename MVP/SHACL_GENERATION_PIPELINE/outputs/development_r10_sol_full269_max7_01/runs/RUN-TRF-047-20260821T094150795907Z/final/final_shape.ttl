@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AllowedLowerSupportingStructureShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:tankTop ]
        [ sh:class nltl:iceStringer ]
    ) .

gen:StrengthenedPartShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "The frame must identify its strengthened part."
    ] .

gen:AttachedLowerEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:qualifiedValueShape gen:AllowedLowerSupportingStructureShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The lower end must be attached to a deck structure, tank boundary plating, tank top, or ice stringer."
    ] .

gen:NormalLowerEndAttachmentShape
    a sh:NodeShape ;
    sh:node gen:StrengthenedPartShape ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:node gen:AttachedLowerEndShape ;
        sh:message "The strengthened frame must have a conforming attached lower end."
    ] .

gen:StrengthenedAdjacentMainFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The adjacent main frame below the ice belt must be ice strengthened."
    ] .

gen:HorizontalConnectionMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:class nltl:mainFrame ;
        sh:minCount 1 ;
        sh:node gen:StrengthenedAdjacentMainFrameShape ;
        sh:message "The horizontal member must connect to an adjacent ice-strengthened main frame."
    ] .

gen:ExceptionalLowerEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:qualifiedValueShape gen:AllowedLowerSupportingStructureShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "The lower end must terminate below a permitted supporting structure."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:class nltl:horizontalConnectionMember ;
        sh:minCount 1 ;
        sh:node gen:HorizontalConnectionMemberShape ;
        sh:message "The lower end must have a horizontal member connected to an adjacent main frame."
    ] .

gen:IntermediateFrameExceptionalConnectionShape
    a sh:NodeShape ;
    sh:node gen:StrengthenedPartShape ;
    sh:property [
        sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The supporting structure must be at or below the lower limit of the ice belt."
    ] ;
    sh:property [
        sh:path nltl:sameScantlingsAsMainFrame ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The horizontal connection member must have the same scantlings as the main frames."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:node gen:ExceptionalLowerEndShape ;
        sh:message "The intermediate ice frame must have a conforming exceptional lower-end connection."
    ] .

gen:MainFrameLowerEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:node gen:NormalLowerEndAttachmentShape ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The main frame below the lower edge of the ice belt must be ice strengthened."
    ] .

gen:IntermediateIceFrameLowerEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:or (
        [ sh:node gen:NormalLowerEndAttachmentShape ]
        [ sh:node gen:IntermediateFrameExceptionalConnectionShape ]
    ) ;
    sh:message "The intermediate ice frame must use either the normal lower-end attachment or the permitted horizontal-member alternative." .
