@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:AreaQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LengthQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PressureQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SectionModulusQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LongitudinalFrameCalculationShape a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gs:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gs:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:PressureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:minInclusive 2.16 ;
            sh:maxInclusive 2.16
        ]
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gs:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:node gs:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:node gs:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:node gs:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:minInclusive 13.3 ;
                    sh:maxInclusive 13.3
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:maxExclusive 13.3
                ]
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "Spacing, yield strength, and frame moment factor must be non-zero for the longitudinal-frame calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:spacing/qudt:numericValue ?s ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m .
                FILTER (
                    ?s = "0"^^xsd:decimal ||
                    ?sigma = "0"^^xsd:decimal ||
                    ?m = "0"^^xsd:decimal
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The reported f4, section modulus, gross shear area, and bracket-excluded actual shear area must satisfy the prescribed formulas within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:icePressure/qudt:numericValue ?p ;
                      nltl:yieldStrength/qudt:numericValue ?sigma ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?f4 ;
                      nltl:longitudinalFrameShearFactorF5/qudt:numericValue ?f5 ;
                      nltl:sectionModulus/qudt:numericValue ?z ;
                      nltl:grossFrameShearArea/qudt:numericValue ?grossArea ;
                      nltl:bracketArea/qudt:numericValue ?bracketArea ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actualArea .

                FILTER (
                    ?s != "0"^^xsd:decimal &&
                    ?sigma != "0"^^xsd:decimal &&
                    ?m != "0"^^xsd:decimal
                )

                BIND (
                    "1"^^xsd:decimal -
                    ("0.2"^^xsd:decimal * ?h / ?s)
                    AS ?expectedF4
                )
                BIND (
                    ?f4 * ?p * ?h * ?l * ?l /
                    ("4"^^xsd:decimal * ?m * ?sigma) *
                    "1000000"^^xsd:decimal
                    AS ?expectedZ
                )
                BIND (
                    "1.7320508075688772935"^^xsd:decimal *
                    ?f4 * ?f5 * ?p * ?h * ?l /
                    ("2"^^xsd:decimal * ?sigma) *
                    "10000"^^xsd:decimal
                    AS ?expectedGrossArea
                )
                BIND (
                    ?grossArea - ?bracketArea
                    AS ?expectedActualArea
                )

                BIND (
                    IF (
                        ABS(?expectedF4) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedF4) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?f4Tolerance
                )
                BIND (
                    IF (
                        ABS(?expectedZ) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedZ) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?zTolerance
                )
                BIND (
                    IF (
                        ABS(?expectedGrossArea) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedGrossArea) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?grossAreaTolerance
                )
                BIND (
                    IF (
                        ABS(?expectedActualArea) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedActualArea) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?actualAreaTolerance
                )

                FILTER (
                    ABS(?f4 - ?expectedF4) > ?f4Tolerance ||
                    ABS(?z - ?expectedZ) > ?zTolerance ||
                    ABS(?grossArea - ?expectedGrossArea) > ?grossAreaTolerance ||
                    ABS(?actualArea - ?expectedActualArea) > ?actualAreaTolerance
                )
            }
        """
    ] .
