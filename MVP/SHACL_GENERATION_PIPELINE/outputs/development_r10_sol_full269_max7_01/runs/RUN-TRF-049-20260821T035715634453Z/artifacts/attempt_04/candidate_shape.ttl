@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FrameAttachmentRequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        gen:FrameOutsideIceStrengthenedAreaShape
        gen:ApplicableFrameShape
    ) .

gen:FrameOutsideIceStrengthenedAreaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

gen:ApplicableFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasSupportingWebFrame ;
        sh:class nltl:supportingStructure ;
        sh:node gen:SupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:hasSupportingBulkhead ;
        sh:class nltl:supportingStructure ;
        sh:node gen:SupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:class nltl:frameAttachment ;
        sh:node gen:FrameAttachmentShape
    ] ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:webPlateConnectionSideCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Every listed supporting web frame or bulkhead must be paired with a frame attachment." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        ?attachment nltl:hasAttachedSupportingStructure ?support .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each supporting web frame or bulkhead of a longitudinal frame must be paired with an attachment having a connection bracket." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this rdf:type/rdfs:subClassOf* nltl:longitudinalFrame .
    $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        ?attachment nltl:hasAttachedSupportingStructure ?support ;
                    nltl:hasConnectionBracket ?bracket .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "A transverse frame must state whether it terminates at a deck or ice stringer." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this rdf:type/rdfs:subClassOf* nltl:transverseFrame .
    FILTER NOT EXISTS {
        $this nltl:terminatesAtDeckOrIceStringer ?termination .
        FILTER(datatype(?termination) = xsd:boolean)
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "A transverse frame has conflicting termination-state values." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this rdf:type/rdfs:subClassOf* nltl:transverseFrame ;
          nltl:terminatesAtDeckOrIceStringer ?firstTermination ;
          nltl:terminatesAtDeckOrIceStringer ?secondTermination .
    FILTER(!sameTerm(?firstTermination, ?secondTermination))
}
"""
    ] ;
    sh:sparql [
        sh:message "A transverse frame terminating at a deck or ice stringer requires a bracket or similar attachment construction." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this rdf:type/rdfs:subClassOf* nltl:transverseFrame ;
          nltl:terminatesAtDeckOrIceStringer true .
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        FILTER(
            EXISTS {
                ?attachment nltl:hasConnectionBracket ?bracket .
            }
            ||
            EXISTS {
                ?attachment nltl:similarAttachmentConstructionPresent true .
            }
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each installed bracket must be at least as thick as every recorded frame-web thickness." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasFrameAttachment ?attachment .
    ?attachment nltl:hasConnectionBracket ?bracket .
    FILTER(
        !EXISTS {
            $this nltl:frameWebThickness ?frameQuantity .
            ?frameQuantity qudt:numericValue ?frameThickness ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER(datatype(?frameThickness) = xsd:decimal)
        }
        ||
        !EXISTS {
            ?bracket nltl:bracketThickness ?bracketQuantity .
            ?bracketQuantity qudt:numericValue ?bracketThickness ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER(datatype(?bracketThickness) = xsd:decimal)
        }
        ||
        EXISTS {
            $this nltl:frameWebThickness ?frameQuantity .
            ?frameQuantity qudt:numericValue ?frameThickness ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            ?bracket nltl:bracketThickness ?bracketQuantity .
            ?bracketQuantity qudt:numericValue ?bracketThickness ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER(
                datatype(?frameThickness) = xsd:decimal
                &&
                datatype(?bracketThickness) = xsd:decimal
                &&
                ?bracketThickness < ?frameThickness
            )
        }
    )
}
"""
    ] .

gen:FrameAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure ;
        sh:node gen:SupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:class nltl:connectionBracket ;
        sh:node gen:ConnectionBracketShape
    ] ;
    sh:sparql [
        sh:message "Each attachment paired with a supporting structure must confirm effective attachment." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasAttachedSupportingStructure ?support .
    FILTER NOT EXISTS {
        $this nltl:effectiveAttachmentConfirmed true .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each paired supporting structure must reciprocally identify the same frame attachment." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasAttachedSupportingStructure ?support .
    FILTER NOT EXISTS {
        ?support nltl:hasSupportingStructureAttachment $this .
    }
}
"""
    ] .

gen:SupportingStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasSupportingStructureAttachment ;
        sh:class nltl:frameAttachment
    ] .

gen:ConnectionBracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .
