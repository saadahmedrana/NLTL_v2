@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .

gen:ConnectionBracketShape
    a sh:NodeShape ;
    sh:class nltl:connectionBracket ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape ;
        sh:message "A connection bracket must have one thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The bracket must be stiffened against buckling."
    ] .

gen:FrameAttachmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure
    ] ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:similarAttachmentConstructionPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:class nltl:connectionBracket ;
        sh:node gen:ConnectionBracketShape
    ] ;
    sh:sparql [
        sh:message "Each attachment-to-support relationship must identify the same attachment from the supporting structure." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?support
WHERE {
  $this nltl:hasAttachedSupportingStructure ?support .
  FILTER NOT EXISTS {
    ?support nltl:hasSupportingStructureAttachment $this .
  }
}
"""
    ] .

gen:TerminatingTransverseAttachmentShape
    a sh:NodeShape ;
    sh:node gen:FrameAttachmentShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:class nltl:connectionBracket ;
                sh:minCount 1 ;
                sh:node gen:ConnectionBracketShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:similarAttachmentConstructionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

gen:FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The frame must state whether it is within the ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasSupportingWebFrame ;
                sh:class nltl:supportingStructure
            ] ;
            sh:property [
                sh:path nltl:hasSupportingBulkhead ;
                sh:class nltl:supportingStructure
            ] ;
            sh:property [
                sh:path [
                    sh:alternativePath (
                        nltl:frameAttachment
                        nltl:hasFrameAttachment
                    )
                ] ;
                sh:node gen:FrameAttachmentShape
            ] ;
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:maxCount 1 ;
                sh:node gen:MillimetreQuantityShape
            ] ;
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The frame must state whether it passes through a supporting structure."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:passesThroughSupportingStructure ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:webPlateConnectionSideCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive 2 ;
                        sh:message "A frame passing through a supporting structure must have both web-plate sides connected."
                    ]
                ]
            ) ;
            sh:sparql [
                sh:message "Every linked supporting web frame or bulkhead must be paired with an effectively confirmed frame attachment." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?support
WHERE {
  $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
  FILTER NOT EXISTS {
    $this (nltl:frameAttachment|nltl:hasFrameAttachment) ?attachment .
    ?attachment nltl:hasAttachedSupportingStructure ?support ;
                nltl:effectiveAttachmentConfirmed true .
    ?support nltl:hasSupportingStructureAttachment ?attachment .
  }
}
"""
            ] ;
            sh:sparql [
                sh:message "A frame web thickness in millimetres is required when a connection bracket is installed." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?bracket
WHERE {
  $this (nltl:frameAttachment|nltl:hasFrameAttachment) ?attachment .
  ?attachment nltl:hasConnectionBracket ?bracket .
  FILTER NOT EXISTS {
    $this nltl:frameWebThickness ?frameThickness .
    ?frameThickness qudt:numericValue ?frameValue ;
                    qudt:unit unit:MilliM .
    FILTER(datatype(?frameValue) = xsd:decimal)
  }
}
"""
            ] ;
            sh:sparql [
                sh:message "A connection bracket must be at least as thick as the frame web." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?bracket
WHERE {
  $this (nltl:frameAttachment|nltl:hasFrameAttachment) ?attachment ;
        nltl:frameWebThickness ?frameThickness .
  ?attachment nltl:hasConnectionBracket ?bracket .
  ?frameThickness qudt:numericValue ?frameValue ;
                  qudt:unit unit:MilliM .
  ?bracket nltl:bracketThickness ?bracketThickness .
  ?bracketThickness qudt:numericValue ?bracketValue ;
                    qudt:unit unit:MilliM .
  FILTER(datatype(?frameValue) = xsd:decimal)
  FILTER(datatype(?bracketValue) = xsd:decimal)
  FILTER(?bracketValue < ?frameValue)
}
"""
            ]
        ]
    ) .

gen:LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:sparql [
                sh:message "A longitudinal frame must be bracket-attached to each linked supporting web frame and bulkhead." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?support
WHERE {
  $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
  FILTER NOT EXISTS {
    $this (nltl:frameAttachment|nltl:hasFrameAttachment) ?attachment .
    ?attachment nltl:hasAttachedSupportingStructure ?support ;
                nltl:hasConnectionBracket ?bracket .
    ?support nltl:hasSupportingStructureAttachment ?attachment .
    ?bracket a nltl:connectionBracket .
  }
}
"""
            ]
        ]
    ) .

gen:TransverseFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A transverse frame must state whether it terminates at a deck or ice stringer."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:terminatesAtDeckOrIceStringer ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path [
                            sh:alternativePath (
                                nltl:frameAttachment
                                nltl:hasFrameAttachment
                            )
                        ] ;
                        sh:minCount 1 ;
                        sh:node gen:TerminatingTransverseAttachmentShape ;
                        sh:message "Each relevant terminating-frame attachment must have a bracket or confirmed similar construction."
                    ]
                ]
            )
        ]
    ) .
