@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF051HullStructureShape
    a sh:NodeShape ;
    sh:targetClass nltl:hullStructure ;
    sh:property [
        sh:path nltl:adjacentFrameHeight ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node g:MillimetreQuantityShape ;
        sh:message "Adjacent frame height is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node g:MegapascalQuantityShape ;
        sh:message "Yield strength is required in megapascals."
    ] ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:class nltl:frameProfileTypeValue ;
        sh:minCount 1 ;
        sh:message "Frame profile type is required."
    ] ;
    sh:property [
        sh:path nltl:netShellPlatingThickness ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node g:MillimetreQuantityShape ;
        sh:message "Net shell-plating thickness is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node g:MillimetreQuantityShape ;
        sh:message "Corrosion and abrasion addition is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:inLieuOfFrame ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The in-lieu-of-frame indicator is required."
    ] ;
    sh:property [
        sh:path nltl:frameWebThickness ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node g:FrameWebThicknessQuantityShape ;
        sh:message "Frame web thickness is required and shall be at least 9 mm."
    ] .

g:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:FrameWebThicknessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 9.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
