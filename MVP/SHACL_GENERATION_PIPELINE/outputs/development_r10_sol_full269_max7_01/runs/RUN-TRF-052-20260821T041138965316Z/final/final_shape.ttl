@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AntitrippingSupportShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        gen:EquivalentSupportAlternativeShape
        gen:AsymmetricalFrameSupportShape
        gen:AngledFrameSupportShape
        gen:AntitrippingSupportNotApplicableShape
    ) ;
    sh:message "The frame must have compliant antitripping support, demonstrated equivalent support, or values establishing that the support rule is not applicable." .

gen:EquivalentSupportAlternativeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

gen:AsymmetricalFrameSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:node gen:ConventionalAntitrippingSupportShape .

gen:AngledFrameSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxExclusive 90.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ]
    ] ;
    sh:node gen:ConventionalAntitrippingSupportShape .

gen:AntitrippingSupportNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 90.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ]
    ] .

gen:ConventionalAntitrippingSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive 1300.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MilliM
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:or (
        gen:LongSpanAllRegionsShape
        gen:ShortSpanScopeShape
    ) .

gen:LongSpanAllRegionsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive 4.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:midbodyRegion
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:sternRegion
    ] .

gen:ShortSpanScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive 4.0
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;
    sh:or (
        gen:IceClassIaSuperScopeShape
        gen:IceClassIaScopeShape
        gen:IceClassIbScopeShape
        gen:IceClassIcScopeShape
        gen:IceClassIiScopeShape
        gen:IceClassIiiScopeShape
    ) .

gen:IceClassIaSuperScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:midbodyRegion
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:sternRegion
    ] .

gen:IceClassIaScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIa
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:midbodyRegion
    ] .

gen:IceClassIbScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIb
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion
    ] .

gen:IceClassIcScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIc
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion
    ] .

gen:IceClassIiScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIi
    ] .

gen:IceClassIiiScopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIii
    ] .
