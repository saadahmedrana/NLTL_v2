@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MeterQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DistributionFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.80 ;
        sh:maxInclusive 0.80 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SafetyFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.8 ;
        sh:maxInclusive 1.8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ShearFactorQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.2 ;
        sh:maxInclusive 1.2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IceStringerOutsideIceBeltShape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:distanceToAdjacentIceStringer ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltDistributionFactorF9 ;
        sh:node gen:DistributionFactorQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltSafetyFactorF10 ;
        sh:node gen:SafetyFactorQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltShearFactorF11 ;
        sh:node gen:ShearFactorQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:node gen:LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:node gen:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:AreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Design line load, outside-ice-belt factor, section modulus, or required shear area is inconsistent with clause 4.5.2; calculated results use a relative tolerance of 1e-6 with an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:stringerSpan ?spanQuantity ;
                      nltl:distanceToAdjacentIceStringer ?adjacentDistanceQuantity ;
                      nltl:distanceToIceBelt ?iceBeltDistanceQuantity ;
                      nltl:frameMomentFactorM ?momentFactorQuantity ;
                      nltl:yieldStrength ?yieldStrengthQuantity ;
                      nltl:outsideIceBeltDistributionFactorF9 ?f9Quantity ;
                      nltl:outsideIceBeltSafetyFactorF10 ?f10Quantity ;
                      nltl:outsideIceBeltShearFactorF11 ?f11Quantity ;
                      nltl:designLineLoad ?lineLoadQuantity ;
                      nltl:outsideIceBeltFactor ?outsideFactorQuantity ;
                      nltl:sectionModulus ?sectionModulusQuantity ;
                      nltl:requiredShearArea ?shearAreaQuantity .

                ?pressureQuantity qudt:numericValue ?pressure .
                ?heightQuantity qudt:numericValue ?height .
                ?spanQuantity qudt:numericValue ?span .
                ?adjacentDistanceQuantity qudt:numericValue ?adjacentDistance .
                ?iceBeltDistanceQuantity qudt:numericValue ?iceBeltDistance .
                ?momentFactorQuantity qudt:numericValue ?momentFactor .
                ?yieldStrengthQuantity qudt:numericValue ?yieldStrength .
                ?f9Quantity qudt:numericValue ?f9 .
                ?f10Quantity qudt:numericValue ?f10 .
                ?f11Quantity qudt:numericValue ?f11 .
                ?lineLoadQuantity qudt:numericValue ?reportedLineLoad .
                ?outsideFactorQuantity qudt:numericValue ?reportedOutsideFactor .
                ?sectionModulusQuantity qudt:numericValue ?reportedSectionModulus .
                ?shearAreaQuantity qudt:numericValue ?reportedShearArea .

                BIND(
                    (?adjacentDistance = 0 || ?momentFactor = 0 || ?yieldStrength = 0)
                    AS ?invalidDenominator
                )
                BIND(
                    IF(
                        (?pressure * ?height) < 0.15,
                        0.15,
                        (?pressure * ?height)
                    )
                    AS ?expectedLineLoadMN
                )
                BIND((?expectedLineLoadMN * 1000) AS ?expectedLineLoadKN)
                BIND(
                    IF(
                        ?invalidDenominator,
                        0,
                        (1 - (?iceBeltDistance / ?adjacentDistance))
                    )
                    AS ?expectedOutsideFactor
                )
                BIND(
                    IF(
                        ?invalidDenominator,
                        0,
                        (?f9 * ?f10 * ?expectedLineLoadMN * ?span * ?span
                         / (?momentFactor * ?yieldStrength)
                         * ?expectedOutsideFactor * 1000000)
                    )
                    AS ?expectedSectionModulus
                )
                BIND(
                    IF(
                        ?invalidDenominator,
                        0,
                        (1.7320508075688772 * ?f9 * ?f10 * ?f11
                         * ?expectedLineLoadMN * ?span
                         / (2 * ?yieldStrength)
                         * ?expectedOutsideFactor * 10000)
                    )
                    AS ?expectedShearArea
                )
                BIND(
                    IF(
                        ABS(?expectedLineLoadKN) * 0.000001 > 0.000000001,
                        ABS(?expectedLineLoadKN) * 0.000001,
                        0.000000001
                    )
                    AS ?lineLoadTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedOutsideFactor) * 0.000001 > 0.000000001,
                        ABS(?expectedOutsideFactor) * 0.000001,
                        0.000000001
                    )
                    AS ?outsideFactorTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedSectionModulus) * 0.000001 > 0.000000001,
                        ABS(?expectedSectionModulus) * 0.000001,
                        0.000000001
                    )
                    AS ?sectionModulusTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedShearArea) * 0.000001 > 0.000000001,
                        ABS(?expectedShearArea) * 0.000001,
                        0.000000001
                    )
                    AS ?shearAreaTolerance
                )
                FILTER(
                    ?invalidDenominator ||
                    ABS(?reportedLineLoad - ?expectedLineLoadKN) > ?lineLoadTolerance ||
                    ABS(?reportedOutsideFactor - ?expectedOutsideFactor) > ?outsideFactorTolerance ||
                    ABS(?reportedSectionModulus - ?expectedSectionModulus) > ?sectionModulusTolerance ||
                    ABS(?reportedShearArea - ?expectedShearArea) > ?shearAreaTolerance
                )
            }
        """
    ] .
