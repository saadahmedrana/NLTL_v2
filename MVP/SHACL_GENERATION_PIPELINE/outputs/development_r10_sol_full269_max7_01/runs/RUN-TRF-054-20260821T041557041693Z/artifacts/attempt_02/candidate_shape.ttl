@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF054Shape
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:locatedOutsideIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice stringer must state whether it is located outside the ice belt."
    ] ;
    sh:property [
        sh:path nltl:supportsIceStrengthenedFrames ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ice stringer must state whether it supports ice-strengthened frames."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:icePressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PressureValueShape
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LengthValueShape
            ] ;
            sh:property [
                sh:path nltl:designLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LineLoadValueShape
            ] ;
            sh:property [
                sh:path nltl:stringerSpan ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositiveLengthValueShape
            ] ;
            sh:property [
                sh:path nltl:distanceToAdjacentIceStringer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositiveLengthValueShape
            ] ;
            sh:property [
                sh:path nltl:distanceToIceBelt ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:LengthValueShape
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositiveUnitlessValueShape
            ] ;
            sh:property [
                sh:path nltl:yieldStrength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:PositivePressureValueShape
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltDistributionFactorF9 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:F9ValueShape
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltSafetyFactorF10 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:F10ValueShape
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltShearFactorF11 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:F11ValueShape
            ] ;
            sh:property [
                sh:path nltl:outsideIceBeltFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:UnitlessValueShape
            ] ;
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:SectionModulusValueShape
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:AreaValueShape
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Applicable ice-stringer line load, outside-belt factor, section modulus, or required shear area does not match the prescribed calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt "true"^^xsd:boolean ;
                      nltl:supportsIceStrengthenedFrames "true"^^xsd:boolean ;
                      nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:designLineLoad/qudt:numericValue ?reportedLineLoad ;
                      nltl:stringerSpan/qudt:numericValue ?l ;
                      nltl:distanceToAdjacentIceStringer/qudt:numericValue ?ls ;
                      nltl:distanceToIceBelt/qudt:numericValue ?hs ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrength ;
                      nltl:outsideIceBeltDistributionFactorF9/qudt:numericValue ?f9 ;
                      nltl:outsideIceBeltSafetyFactorF10/qudt:numericValue ?f10 ;
                      nltl:outsideIceBeltShearFactorF11/qudt:numericValue ?f11 ;
                      nltl:outsideIceBeltFactor/qudt:numericValue ?reportedOutsideFactor ;
                      nltl:sectionModulus/qudt:numericValue ?reportedSectionModulus ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedShearArea .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?lineLoadMNPerM)
                BIND((?lineLoadMNPerM * 1000) AS ?expectedLineLoad)
                BIND((1 - (?hs / ?ls)) AS ?expectedOutsideFactor)
                BIND((?f9 * ?f10 * ?lineLoadMNPerM * ?l * ?l
                      / (?m * ?yieldStrength)
                      * ?expectedOutsideFactor * 1000000)
                     AS ?expectedSectionModulus)
                BIND((1.7320508075688772 * ?f9 * ?f10 * ?f11
                      * ?lineLoadMNPerM * ?l
                      / (2 * ?yieldStrength)
                      * ?expectedOutsideFactor * 10000)
                     AS ?expectedShearArea)

                BIND(IF(ABS(?expectedLineLoad) * 0.000001 > 0.000000001,
                        ABS(?expectedLineLoad) * 0.000001,
                        0.000000001) AS ?lineLoadTolerance)
                BIND(IF(ABS(?expectedOutsideFactor) * 0.000001 > 0.000000001,
                        ABS(?expectedOutsideFactor) * 0.000001,
                        0.000000001) AS ?outsideFactorTolerance)
                BIND(IF(ABS(?expectedSectionModulus) * 0.000001 > 0.000000001,
                        ABS(?expectedSectionModulus) * 0.000001,
                        0.000000001) AS ?sectionModulusTolerance)
                BIND(IF(ABS(?expectedShearArea) * 0.000001 > 0.000000001,
                        ABS(?expectedShearArea) * 0.000001,
                        0.000000001) AS ?shearAreaTolerance)

                FILTER (
                    ABS(?reportedLineLoad - ?expectedLineLoad) > ?lineLoadTolerance ||
                    ABS(?reportedOutsideFactor - ?expectedOutsideFactor) > ?outsideFactorTolerance ||
                    ABS(?reportedSectionModulus - ?expectedSectionModulus) > ?sectionModulusTolerance ||
                    ABS(?reportedShearArea - ?expectedShearArea) > ?shearAreaTolerance
                )
            }
        """
    ] .

gen:LengthValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveLengthValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositivePressureValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LineLoadValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveUnitlessValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F9ValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.80 ;
        sh:maxInclusive 0.80 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F10ValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.8 ;
        sh:maxInclusive 1.8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:F11ValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.2 ;
        sh:maxInclusive 1.2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
