@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:VolumeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:StandardLineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 150.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ReducedLineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 100.0 ;
        sh:maxExclusive 150.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF055NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:actualSectionModulus ;
                sh:node gen:VolumeQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:requiredSectionModulus ;
                sh:node gen:VolumeQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:actualShearArea ;
                sh:node gen:AreaQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:node gen:AreaQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:designLineLoad ;
                        sh:node gen:StandardLineLoadQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:veryLongHatchOpening ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:permittedReducedLineLoad ;
                        sh:node gen:ReducedLineLoadQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ) ;
            sh:sparql [
                sh:message "Actual section modulus and shear area must not be less than their respective required values." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:actualSectionModulus ?actualSectionNode ;
                              nltl:requiredSectionModulus ?requiredSectionNode ;
                              nltl:actualShearArea ?actualShearNode ;
                              nltl:requiredShearArea ?requiredShearNode .
                        ?actualSectionNode qudt:numericValue ?actualSection .
                        ?requiredSectionNode qudt:numericValue ?requiredSection .
                        ?actualShearNode qudt:numericValue ?actualShear .
                        ?requiredShearNode qudt:numericValue ?requiredShear .
                        FILTER (
                            xsd:decimal(?actualSection) < xsd:decimal(?requiredSection) ||
                            xsd:decimal(?actualShear) < xsd:decimal(?requiredShear)
                        )
                    }
                """
            ]
        ]
    ) .
