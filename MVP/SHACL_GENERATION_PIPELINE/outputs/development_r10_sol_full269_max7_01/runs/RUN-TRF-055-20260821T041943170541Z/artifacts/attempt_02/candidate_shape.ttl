@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:SectionModulusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ShearAreaQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:StandardLineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 150.0 ;
        sh:maxInclusive 150.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ReducedLineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 100.0 ;
        sh:maxExclusive 150.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ApplicableDeckStripComplianceShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:actualSectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Actual section modulus is required for an applicable narrow deck strip."
    ] ;
    sh:property [
        sh:path nltl:requiredSectionModulus ;
        sh:node gen:SectionModulusQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Required section modulus is required for an applicable narrow deck strip."
    ] ;
    sh:property [
        sh:path nltl:actualShearArea ;
        sh:node gen:ShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Actual shear area is required for an applicable narrow deck strip."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:ShearAreaQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Required shear area is required for an applicable narrow deck strip."
    ] ;
    sh:sparql [
        sh:message "Actual section modulus and shear area must be at least their respective required values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:actualSectionModulus ?actualSectionNode ;
                      nltl:requiredSectionModulus ?requiredSectionNode ;
                      nltl:actualShearArea ?actualShearNode ;
                      nltl:requiredShearArea ?requiredShearNode .
                ?actualSectionNode qudt:numericValue ?actualSection .
                ?requiredSectionNode qudt:numericValue ?requiredSection .
                ?actualShearNode qudt:numericValue ?actualShear .
                ?requiredShearNode qudt:numericValue ?requiredShear .
                FILTER (
                    ?actualSection < ?requiredSection ||
                    ?actualShear < ?requiredShear
                )
            }
        """
    ] .

gen:NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:node gen:ApplicableDeckStripComplianceShape ;
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:designLineLoad ;
                sh:node gen:StandardLineLoadQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The unreduced design line load must equal 150 kN/m."
            ]
        ]
        [
            sh:node gen:ApplicableDeckStripComplianceShape ;
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A reduced line load requires classification-society approval."
            ] ;
            sh:property [
                sh:path nltl:permittedReducedLineLoad ;
                sh:node gen:ReducedLineLoadQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The approved reduced line load must be at least 100 kN/m and less than 150 kN/m."
            ]
        ]
    ) .
