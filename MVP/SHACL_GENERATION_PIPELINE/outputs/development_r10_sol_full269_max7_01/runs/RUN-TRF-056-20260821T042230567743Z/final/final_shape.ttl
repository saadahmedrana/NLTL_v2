@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:WeatherdeckHatchShape
    a sh:NodeShape ;
    sh:class nltl:weatherdeckHatch ;
    sh:property [
        sh:path nltl:hatchOpeningLength ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Each linked weatherdeck hatch must provide its hatch opening length in metres so that applicability can be determined."
    ] ;
    sh:property [
        sh:path nltl:shipSideDeflection ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasHatchCoverDesignEvidence ;
        sh:class nltl:hatchCoverDesignEvidence
    ] ;
    sh:property [
        sh:path nltl:hasHatchFittingDesignEvidence ;
        sh:class nltl:hatchFittingDesignEvidence
    ] .

gen:ShipHatchDesignShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasWeatherdeckHatch ;
        sh:class nltl:weatherdeckHatch ;
        sh:node gen:WeatherdeckHatchShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ship breadth in metres is required when a weatherdeck hatch is represented." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT DISTINCT $this
WHERE {
    $this nltl:hasWeatherdeckHatch ?hatch .
    FILTER NOT EXISTS {
        $this nltl:shipBreadth ?breadthQuantity .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A weatherdeck hatch longer than half the ship breadth must represent ship-side deflection and both hatch-cover and hatch-fitting design evidence." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this ?hatch
WHERE {
    $this nltl:shipBreadth ?breadthQuantity ;
          nltl:hasWeatherdeckHatch ?hatch .

    ?breadthQuantity qudt:numericValue ?breadth .
    ?hatch nltl:hatchOpeningLength ?openingQuantity .
    ?openingQuantity qudt:numericValue ?openingLength .

    FILTER(
        xsd:decimal(?openingLength) >
        (xsd:decimal(?breadth) / xsd:decimal("2"))
    )

    FILTER(
        NOT EXISTS {
            ?hatch nltl:shipSideDeflection ?sideDeflection .
        }
        ||
        NOT EXISTS {
            ?hatch nltl:hasHatchCoverDesignEvidence ?coverEvidence .
        }
        ||
        NOT EXISTS {
            ?hatch nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
        }
    )
}
"""
    ] .
