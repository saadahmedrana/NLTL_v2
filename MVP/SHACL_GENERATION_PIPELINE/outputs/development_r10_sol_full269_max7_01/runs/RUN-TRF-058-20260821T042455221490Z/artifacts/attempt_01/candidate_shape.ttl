@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:WebFrameIceLoadAdjustmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:supportedStringerOutsideIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The web frame must state whether its supported stringer is outside the ice belt."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:supportedStringerOutsideIceBelt ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportedStringerOutsideIceBelt ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceLoadForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ForceQuantityShape ;
                sh:message "Ice load force is required when the supported stringer is outside the ice belt."
            ] ;
            sh:property [
                sh:path nltl:adjustedIceLoadForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ForceQuantityShape ;
                sh:message "Adjusted ice load force is required when the supported stringer is outside the ice belt."
            ] ;
            sh:property [
                sh:path nltl:stringerOutsideIceBeltHeight ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:LengthQuantityShape ;
                sh:message "Stringer outside-ice-belt height is required for the ice-load adjustment."
            ] ;
            sh:property [
                sh:path nltl:stringerSpan ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:LengthQuantityShape ;
                sh:message "Stringer span is required for the ice-load adjustment."
            ] ;
            sh:sparql [
                sh:message "Stringer span must be nonzero and adjusted ice load force must equal ice load force multiplied by (1 - hs/ls), within relative tolerance 1e-6 and absolute fallback 1e-9 kN." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceLoadForce/qudt:numericValue ?force ;
                              nltl:adjustedIceLoadForce/qudt:numericValue ?adjusted ;
                              nltl:stringerOutsideIceBeltHeight/qudt:numericValue ?height ;
                              nltl:stringerSpan/qudt:numericValue ?span .
                        BIND(IF(?span = 0, 0, ?force * (1 - (?height / ?span))) AS ?expected)
                        BIND(IF(ABS(?expected) * 0.000001 > 0.000000001,
                                ABS(?expected) * 0.000001,
                                0.000000001) AS ?tolerance)
                        FILTER(?span = 0 || ABS(?adjusted - ?expected) > ?tolerance)
                    }
                """
            ]
        ]
    ) .

gs:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .

gs:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .
