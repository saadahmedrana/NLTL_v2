@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF059WebFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:freeFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one free-flange area in square centimetres."
    ] ;
    sh:property [
        sh:path nltl:webPlateArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one positive web-plate area in square centimetres."
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one dimensionless free-flange-to-web area ratio."
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one dimensionless shear factor alpha."
    ] ;
    sh:property [
        sh:path nltl:webFrameShearDistributionFactorF13 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.1"^^xsd:decimal ;
                sh:maxInclusive "1.1"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The dimensionless web-frame shear distribution factor f13 must equal 1.1."
    ] ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one maximum calculated shear force in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one positive yield strength in megapascals."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A web frame must have one required shear area in square centimetres."
    ] ;
    sh:sparql [
        sh:message "The area ratio, Table 4-8 alpha value, and calculated required shear area must be mutually consistent." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:freeFlangeArea ?afQuantity ;
                      nltl:webPlateArea ?awQuantity ;
                      nltl:freeFlangeToWebAreaRatio ?ratioQuantity ;
                      nltl:webFrameShearFactorAlpha ?alphaQuantity ;
                      nltl:maximumCalculatedShearForce ?forceQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?afQuantity qudt:numericValue ?af .
                ?awQuantity qudt:numericValue ?aw .
                ?ratioQuantity qudt:numericValue ?ratio .
                ?alphaQuantity qudt:numericValue ?alpha .
                ?forceQuantity qudt:numericValue ?forceKN .
                ?yieldQuantity qudt:numericValue ?yieldMPa .
                ?areaQuantity qudt:numericValue ?reportedArea .

                BIND(?af / ?aw AS ?expectedRatio)
                BIND(
                    IF(
                        ABS(?expectedRatio) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedRatio) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?ratioTolerance
                )

                BIND(
                    IF(?ratio = "0"^^xsd:decimal, "1.5"^^xsd:decimal,
                    IF(?ratio = "0.2"^^xsd:decimal, "1.23"^^xsd:decimal,
                    IF(?ratio = "0.4"^^xsd:decimal, "1.16"^^xsd:decimal,
                    IF(?ratio = "0.6"^^xsd:decimal, "1.11"^^xsd:decimal,
                    IF(?ratio = "0.8"^^xsd:decimal, "1.09"^^xsd:decimal,
                    IF(?ratio = "1.0"^^xsd:decimal, "1.07"^^xsd:decimal,
                    IF(?ratio = "1.2"^^xsd:decimal, "1.06"^^xsd:decimal,
                    IF(?ratio = "1.4"^^xsd:decimal, "1.05"^^xsd:decimal,
                    IF(?ratio = "1.6"^^xsd:decimal, "1.05"^^xsd:decimal,
                    IF(?ratio = "1.8"^^xsd:decimal, "1.04"^^xsd:decimal,
                    IF(?ratio = "2.0"^^xsd:decimal, "1.04"^^xsd:decimal,
                        "-1"^^xsd:decimal
                    )))))))))))
                    AS ?expectedAlpha
                )

                BIND(
                    "1.7320508075688772"^^xsd:decimal *
                    ?expectedAlpha *
                    "1.1"^^xsd:decimal *
                    (?forceKN / "1000"^^xsd:decimal) /
                    ?yieldMPa *
                    "10000"^^xsd:decimal
                    AS ?expectedArea
                )

                BIND(
                    IF(
                        ABS(?expectedArea) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expectedArea) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?areaTolerance
                )

                FILTER(
                    ?ratio NOT IN (
                        "0"^^xsd:decimal,
                        "0.2"^^xsd:decimal,
                        "0.4"^^xsd:decimal,
                        "0.6"^^xsd:decimal,
                        "0.8"^^xsd:decimal,
                        "1.0"^^xsd:decimal,
                        "1.2"^^xsd:decimal,
                        "1.4"^^xsd:decimal,
                        "1.6"^^xsd:decimal,
                        "1.8"^^xsd:decimal,
                        "2.0"^^xsd:decimal
                    ) ||
                    ABS(?ratio - ?expectedRatio) > ?ratioTolerance ||
                    ?alpha != ?expectedAlpha ||
                    ABS(?reportedArea - ?expectedArea) > ?areaTolerance
                )
            }
        """
    ] .
