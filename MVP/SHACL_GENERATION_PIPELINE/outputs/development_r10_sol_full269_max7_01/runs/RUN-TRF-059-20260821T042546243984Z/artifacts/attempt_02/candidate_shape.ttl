@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF059WebFrameShearAreaShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:freeFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webPlateArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:freeFlangeToWebAreaRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0"^^xsd:decimal ;
                sh:maxInclusive "2.0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearFactorAlpha ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameShearDistributionFactorF13 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.1"^^xsd:decimal ;
                sh:maxInclusive "1.1"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumCalculatedShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minExclusive "0"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "The flange-to-web ratio, table-selected alpha, and required shear area must agree within a relative tolerance of 1e-6 with a 1e-9 absolute floor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:freeFlangeArea/qudt:numericValue ?freeFlangeArea ;
                      nltl:webPlateArea/qudt:numericValue ?webPlateArea ;
                      nltl:freeFlangeToWebAreaRatio/qudt:numericValue ?reportedRatio ;
                      nltl:webFrameShearFactorAlpha/qudt:numericValue ?reportedAlpha ;
                      nltl:webFrameShearDistributionFactorF13/qudt:numericValue ?f13 ;
                      nltl:maximumCalculatedShearForce/qudt:numericValue ?shearForceKN ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrengthMPa ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedArea .

                FILTER (?webPlateArea > 0 && ?yieldStrengthMPa > 0)

                BIND (?freeFlangeArea / ?webPlateArea AS ?expectedRatio)
                BIND (
                    IF (
                        ABS(?expectedRatio) * 0.000001 > 0.000000001,
                        ABS(?expectedRatio) * 0.000001,
                        0.000000001
                    )
                    AS ?ratioTolerance
                )

                BIND (
                    IF (?expectedRatio <= 0.2,
                        1.5 + ((?expectedRatio - 0.0) / 0.2) * (1.23 - 1.5),
                    IF (?expectedRatio <= 0.4,
                        1.23 + ((?expectedRatio - 0.2) / 0.2) * (1.16 - 1.23),
                    IF (?expectedRatio <= 0.6,
                        1.16 + ((?expectedRatio - 0.4) / 0.2) * (1.11 - 1.16),
                    IF (?expectedRatio <= 0.8,
                        1.11 + ((?expectedRatio - 0.6) / 0.2) * (1.09 - 1.11),
                    IF (?expectedRatio <= 1.0,
                        1.09 + ((?expectedRatio - 0.8) / 0.2) * (1.07 - 1.09),
                    IF (?expectedRatio <= 1.2,
                        1.07 + ((?expectedRatio - 1.0) / 0.2) * (1.06 - 1.07),
                    IF (?expectedRatio <= 1.4,
                        1.06 + ((?expectedRatio - 1.2) / 0.2) * (1.05 - 1.06),
                    IF (?expectedRatio <= 1.6,
                        1.05 + ((?expectedRatio - 1.4) / 0.2) * (1.05 - 1.05),
                    IF (?expectedRatio <= 1.8,
                        1.05 + ((?expectedRatio - 1.6) / 0.2) * (1.04 - 1.05),
                        1.04 + ((?expectedRatio - 1.8) / 0.2) * (1.04 - 1.04)
                    )))))))))
                    AS ?expectedAlpha
                )

                BIND (
                    IF (
                        ABS(?expectedAlpha) * 0.000001 > 0.000000001,
                        ABS(?expectedAlpha) * 0.000001,
                        0.000000001
                    )
                    AS ?alphaTolerance
                )

                BIND (
                    1.7320508075688772 * ?expectedAlpha * ?f13 *
                    (?shearForceKN / 1000.0) / ?yieldStrengthMPa * 10000.0
                    AS ?expectedArea
                )
                BIND (
                    IF (
                        ABS(?expectedArea) * 0.000001 > 0.000000001,
                        ABS(?expectedArea) * 0.000001,
                        0.000000001
                    )
                    AS ?areaTolerance
                )

                FILTER (
                    ?expectedRatio < 0.0 ||
                    ?expectedRatio > 2.0 ||
                    ABS(?reportedRatio - ?expectedRatio) > ?ratioTolerance ||
                    ABS(?reportedAlpha - ?expectedAlpha) > ?alphaTolerance ||
                    ABS(?reportedArea - ?expectedArea) > ?areaTolerance
                )
            }
        """
    ] .
