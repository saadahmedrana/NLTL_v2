@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF062ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerBladeTipHullClearance ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "Propeller blade tip hull clearance in metres is required."
    ] ;
    sh:property [
        sh:path nltl:minimumClearance ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "Minimum required clearance in metres is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Propeller blade tip hull clearance shall be no less than the minimum clearance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?clearance
WHERE {
    $this nltl:propellerBladeTipHullClearance ?clearanceQuantity ;
          nltl:minimumClearance ?minimumQuantity .
    ?clearanceQuantity qudt:numericValue ?clearance .
    ?minimumQuantity qudt:numericValue ?minimum .
    FILTER (?clearance < ?minimum)
}
"""
    ] .
