@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIb
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIc
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIi
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIii
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIa
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:message "Ice-knife practicability must be recorded for an IA or IA Super ship."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:qualifiedValueShape [
                            sh:or (
                                [
                                    sh:class nltl:iceKnife ;
                                    sh:property [
                                        sh:path nltl:extendsBelowLowerIceWaterline ;
                                        sh:minCount 1 ;
                                        sh:datatype xsd:boolean ;
                                        sh:hasValue true
                                    ]
                                ]
                                [
                                    sh:class nltl:equivalentRudderProtectionMeans
                                ]
                            )
                        ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "A practicable ice knife extending below the lower ice waterline, or equivalent rudder protection, is required."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:qualifiedValueShape [
                            sh:class nltl:equivalentRudderProtectionMeans
                        ] ;
                        sh:qualifiedMinCount 1 ;
                        sh:message "Equivalent rudder protection is required when an ice knife is not practicable."
                    ]
                ]
            )
        ]
    ) ;
    sh:message "The ship's ice class and applicable rudder-protection alternative must satisfy clause 5." .
