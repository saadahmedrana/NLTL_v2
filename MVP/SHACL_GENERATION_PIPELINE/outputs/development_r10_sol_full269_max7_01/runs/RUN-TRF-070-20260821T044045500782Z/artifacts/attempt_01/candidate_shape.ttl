@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Thruster type is required to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:extremeLoad ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:ForceQuantityShape ;
        sh:message "Extreme-load input is required."
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:PressureQuantityShape ;
        sh:message "Local ice-pressure input is required."
    ] ;
    sh:property [
        sh:path nltl:propellerIceInteractionLoad ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:ForceQuantityShape ;
        sh:message "Propeller/ice interaction-load input is required."
    ] ;
    sh:property [
        sh:path nltl:serviceLife ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:ServiceLifeQuantityShape ;
        sh:message "Service-life input is required."
    ] ;
    sh:property [
        sh:path nltl:thrusterBodyIceInteractionLoad ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:ForceQuantityShape ;
        sh:message "Thruster-body/ice interaction-load input is required."
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:class nltl:designCondition ;
        sh:minCount 1 ;
        sh:node gen:TRF070DesignConditionShape ;
        sh:message "A design condition with the required readiness data is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Design-condition local strength capacity must be at least the applicable local ice pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?condition
            WHERE {
                $this nltl:localIcePressure ?pressureQuantity ;
                      nltl:hasDesignCondition ?condition .
                ?pressureQuantity qudt:numericValue ?pressure .
                ?condition nltl:designConditionLocalStrengthCapacity ?capacityQuantity .
                ?capacityQuantity qudt:numericValue ?capacity .
                FILTER(xsd:decimal(?capacity) < xsd:decimal(?pressure))
            }
        """
    ] .

gen:TRF070DesignConditionShape
    a sh:NodeShape ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The normal-operational-conditions applicability value is required."
    ] ;
    sh:property [
        sh:path nltl:designConditionLocalStrengthCapacity ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node gen:ForceQuantityShape ;
        sh:message "The externally assessed local-strength capacity is required."
    ] .

gen:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ServiceLifeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:YR ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
