@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:PropellerBladeLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each propeller blade load case must have exactly one integer load case number."
    ] .

g:LoadCase1Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] .

g:LoadCase2Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] .

g:LoadCase3Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] .

g:LoadCase4Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] .

g:LoadCase5Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5
    ] .

g:PropellerBladeLoadCaseCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node g:PropellerBladeLoadCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape g:LoadCase1Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 1 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape g:LoadCase2Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 2 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape g:LoadCase3Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 3 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape g:LoadCase4Shape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller blade load case 4 must be covered."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "CP"
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "FP"
            ] ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "FP"
            ] ;
            sh:property [
                sh:path nltl:propellerReversingCapability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasPropellerBladeLoadCase ;
                sh:qualifiedValueShape g:LoadCase5Shape ;
                sh:qualifiedMinCount 1 ;
                sh:message "Load case 5 must be covered for a reversing FP propeller."
            ]
        ]
    ) ;
    sh:message "The propeller type and reversing capability must select a permitted load-case coverage branch." .
