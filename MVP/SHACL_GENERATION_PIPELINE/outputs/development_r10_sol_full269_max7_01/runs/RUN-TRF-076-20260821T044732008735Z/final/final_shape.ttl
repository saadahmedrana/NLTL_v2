@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF076ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one propeller type is required to determine applicability."
    ] ;
    sh:or (
        gen:TRF076OtherPropellerShape
        gen:TRF076CPPropellerShape
        gen:TRF076FPPropellerShape
    ) .

gen:TRF076OtherPropellerShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:not [
            sh:in (
                "CP"^^xsd:string
                "FP"^^xsd:string
            )
        ]
    ] .

gen:TRF076CPPropellerShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "CP"^^xsd:string
    ] ;
    sh:node gen:TRF076CasesOneToFourShape .

gen:TRF076FPPropellerShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:hasValue "FP"^^xsd:string
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An FP propeller requires an explicit reversing-capability value."
    ] ;
    sh:node gen:TRF076CasesOneToFourShape ;
    sh:or (
        gen:TRF076NonReversingFPShape
        gen:TRF076ReversingFPShape
    ) .

gen:TRF076NonReversingFPShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:hasValue false
    ] .

gen:TRF076ReversingFPShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:TRF076LoadCaseFiveShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A reversing FP propeller must cover load case 5."
    ] .

gen:TRF076CasesOneToFourShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gen:TRF076BladeLoadCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:TRF076LoadCaseOneShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 1 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:TRF076LoadCaseTwoShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 2 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:TRF076LoadCaseThreeShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 3 must be covered."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:qualifiedValueShape gen:TRF076LoadCaseFourShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "Load case 4 must be covered."
    ] .

gen:TRF076BladeLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "Each represented propeller blade load case requires an integer case number."
    ] .

gen:TRF076LoadCaseOneShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] .

gen:TRF076LoadCaseTwoShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] .

gen:TRF076LoadCaseThreeShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 3 ;
        sh:maxInclusive 3
    ] .

gen:TRF076LoadCaseFourShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] .

gen:TRF076LoadCaseFiveShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:minInclusive 5 ;
        sh:maxInclusive 5
    ] .
