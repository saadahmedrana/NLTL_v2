@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:Table6Dash6CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] .

gen:Table6Dash7CaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] .

gen:TRF078Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gen:Table6Dash6CaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-6 lookup case with an ice-class key and selected cycle count is required."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gen:Table6Dash7CaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-7 lookup case with a propeller-location key and selected factor is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "Every linked Table 6-6 case must be typed, have exactly that table reference, and contain conforming ice-class and cycle-count values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash6 .
                FILTER (
                    NOT EXISTS {
                        ?case a nltl:tableLookupCase ;
                              nltl:iceClass ?iceClass ;
                              nltl:selectedIceClassCycleCount ?countQuantity .
                        ?iceClass a nltl:iceClassValue .
                        ?countQuantity a qudt:QuantityValue ;
                                       qudt:numericValue ?countValue ;
                                       qudt:unit unit:UNITLESS .
                        FILTER (
                            isIRI(?iceClass) &&
                            datatype(?countValue) = xsd:decimal
                        )
                    } ||
                    EXISTS {
                        ?case nltl:tableReference ?otherReference .
                        FILTER (?otherReference != nltl:traficomTable6Dash6)
                    } ||
                    EXISTS {
                        ?case nltl:iceClass ?invalidIceClass .
                        FILTER (
                            !isIRI(?invalidIceClass) ||
                            NOT EXISTS {
                                ?invalidIceClass a nltl:iceClassValue .
                            }
                        )
                    } ||
                    EXISTS {
                        ?case nltl:selectedIceClassCycleCount ?quantity .
                        ?quantity qudt:numericValue ?invalidValue .
                        FILTER (datatype(?invalidValue) != xsd:decimal)
                    } ||
                    EXISTS {
                        ?case nltl:selectedIceClassCycleCount ?quantity .
                        ?quantity qudt:unit ?invalidUnit .
                        FILTER (?invalidUnit != unit:UNITLESS)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every linked Table 6-7 case must be typed, have exactly that table reference, and contain conforming propeller-location and factor values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash7 .
                FILTER (
                    NOT EXISTS {
                        ?case a nltl:tableLookupCase ;
                              nltl:tableLookupPropellerLocation ?location ;
                              nltl:selectedPropellerLocationFactor ?factorQuantity .
                        ?location a nltl:propellerLocationValue .
                        ?factorQuantity a qudt:QuantityValue ;
                                        qudt:numericValue ?factorValue ;
                                        qudt:unit unit:UNITLESS .
                        FILTER (
                            isIRI(?location) &&
                            datatype(?factorValue) = xsd:decimal
                        )
                    } ||
                    EXISTS {
                        ?case nltl:tableReference ?otherReference .
                        FILTER (?otherReference != nltl:traficomTable6Dash7)
                    } ||
                    EXISTS {
                        ?case nltl:tableLookupPropellerLocation ?invalidLocation .
                        FILTER (
                            !isIRI(?invalidLocation) ||
                            NOT EXISTS {
                                ?invalidLocation a nltl:propellerLocationValue .
                            }
                        )
                    } ||
                    EXISTS {
                        ?case nltl:selectedPropellerLocationFactor ?quantity .
                        ?quantity qudt:numericValue ?invalidValue .
                        FILTER (datatype(?invalidValue) != xsd:decimal)
                    } ||
                    EXISTS {
                        ?case nltl:selectedPropellerLocationFactor ?quantity .
                        ?quantity qudt:unit ?invalidUnit .
                        FILTER (?invalidUnit != unit:UNITLESS)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1 multiplied by k2, k3, N_class, and n_n within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Quantity ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnQuantity ;
                      nltl:iceLoadCycleCount ?reportedCount .

                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                           nltl:selectedIceClassCycleCount ?classCountQuantity .

                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                              nltl:selectedPropellerLocationFactor ?k1Quantity .

                ?k1Quantity qudt:numericValue ?k1 .
                ?k2Quantity qudt:numericValue ?k2 .
                ?k3Quantity qudt:numericValue ?k3 .
                ?classCountQuantity qudt:numericValue ?classCount .
                ?nnQuantity qudt:numericValue ?nn .

                BIND (
                    xsd:decimal(?k1) *
                    xsd:decimal(?k2) *
                    xsd:decimal(?k3) *
                    xsd:decimal(?classCount) *
                    xsd:decimal(?nn)
                    AS ?expectedCount
                )
                BIND (
                    ABS(?expectedCount) * "0.000001"^^xsd:decimal
                    AS ?relativeTolerance
                )
                BIND (
                    IF (
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (
                    ABS(xsd:decimal(?reportedCount) - ?expectedCount) > ?tolerance
                )
            }
        """
    ] .
