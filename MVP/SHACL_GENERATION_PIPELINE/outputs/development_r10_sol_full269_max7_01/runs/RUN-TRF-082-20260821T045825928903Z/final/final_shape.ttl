@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF082Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gen:HydrodynamicBollardThrustValueShape ;
        sh:message "Hydrodynamic bollard thrust must be recorded in kilonewtons."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardThrustKnown ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false )
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:qualifiedValueShape [
                    sh:class nltl:tableLookupCase ;
                    sh:node gen:TRF082TableLookupCaseShape
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "When bollard thrust is not known, a Table 6-8 lookup case is required."
            ]
        ]
    ) .

gen:HydrodynamicBollardThrustValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .

gen:TRF082TableLookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The required Table 6-8 lookup must be marked as applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:class nltl:tableReferenceValue ;
        sh:in ( nltl:traficomTable6Dash8 ) ;
        sh:message "The lookup must reference TRAFICOM Table 6-8."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Evidence supporting the Table 6-8 lookup selection is required."
    ] .
