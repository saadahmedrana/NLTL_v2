@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PropellerDiameterValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BollardPropellerSpeedValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:REV-PER-MIN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:Table6Dash9LookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:lookupInputQuantity ;
        sh:minCount 1 ;
        sh:node gen:PropellerDiameterValueShape
    ] ;
    sh:property [
        sh:path nltl:lookupResultQuantity ;
        sh:minCount 1 ;
        sh:node gen:BollardPropellerSpeedValueShape
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:in ( nltl:traficomTable6Dash9 )
    ] ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] .

gen:TRF085Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bollardPropellerSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether its bollard propeller speed is known."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:Table6Dash9LookupCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
                sh:minCount 1 ;
                sh:node gen:BollardPropellerSpeedValueShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:propellerDiameter ;
                sh:minCount 1 ;
                sh:node gen:PropellerDiameterValueShape
            ] ;
            sh:property [
                sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
                sh:minCount 1 ;
                sh:node gen:BollardPropellerSpeedValueShape
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:hasTableLookupCase
                    nltl:lookupInputQuantity
                ) ;
                sh:minCount 1 ;
                sh:equals nltl:propellerDiameter ;
                sh:node gen:PropellerDiameterValueShape
            ] ;
            sh:property [
                sh:path (
                    nltl:hasTableLookupCase
                    nltl:lookupResultQuantity
                ) ;
                sh:minCount 1 ;
                sh:equals nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
                sh:node gen:BollardPropellerSpeedValueShape
            ]
        ]
    ) ;
    sh:message "Use the known bollard propeller speed, or provide a consistent Table 6-9 lookup case linked to the diameter and selected speed." .
