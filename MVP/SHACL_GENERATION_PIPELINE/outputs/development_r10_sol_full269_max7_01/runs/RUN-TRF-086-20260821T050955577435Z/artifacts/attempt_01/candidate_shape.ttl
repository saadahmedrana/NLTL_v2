@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PropellerPitchRequirementShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:propellerType ?propellerType .
                FILTER(?propellerType = "CP"^^xsd:string)
            }
        """
    ] ;
    sh:or (
        gen:KnownBollardPitchShape
        gen:UnknownBollardPitchShape
    ) ;
    sh:message "A CP propeller must state whether its MCR bollard pitch is known and satisfy the corresponding pitch requirement." .

gen:KnownBollardPitchShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PitchQuantityShape
    ] .

gen:UnknownBollardPitchShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PitchQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrFreeRunning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PitchQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the MCR bollard pitch is not known, it must equal 0.7 times the MCR free-running pitch within a relative tolerance of 1e-6 and an absolute fallback of 1e-12 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:pitchValueKnown false ;
                    nltl:propellerPitchAtMcrBollard ?bollardPitch ;
                    nltl:propellerPitchAtMcrFreeRunning ?freeRunningPitch .
                ?bollardPitch qudt:numericValue ?bollardValue .
                ?freeRunningPitch qudt:numericValue ?freeRunningValue .
                BIND((0.7 * ?freeRunningValue) AS ?expectedValue)
                BIND(IF(ABS(?expectedValue) * 0.000001 > 0.000000000001,
                        ABS(?expectedValue) * 0.000001,
                        0.000000000001) AS ?tolerance)
                FILTER(ABS(?bollardValue - ?expectedValue) > ?tolerance)
            }
        """
    ] .

gen:PitchQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
