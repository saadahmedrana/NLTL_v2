@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF086Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A CP propeller requires a boolean indication of whether its bollard-condition pitch value is known." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType .
                FILTER(?propellerType = "CP"^^xsd:string)
                FILTER NOT EXISTS {
                    $this nltl:pitchValueKnown ?known .
                    FILTER(datatype(?known) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the CP propeller pitch is known, a valid bollard-condition MCR pitch in metres is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType ;
                      nltl:pitchValueKnown ?known .
                FILTER(?propellerType = "CP"^^xsd:string)
                FILTER(datatype(?known) = xsd:boolean && ?known = true)
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?pitch .
                    ?pitch a qudt:QuantityValue ;
                           qudt:numericValue ?value ;
                           qudt:unit unit:M .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] .
