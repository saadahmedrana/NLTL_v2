@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:node gs:TRF091IceMillingSequenceCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship shall provide an ice-milling load-sequence case."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each ice-milling sequence case shall also be linked as the same propulsion load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?case
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?case .
                }
            }
        """
    ] .

gs:TRF091IceMillingSequenceCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCasePurposeValue ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:minCount 1 ;
        sh:message "The ice-milling load-sequence case shall be used for propulsion-line strength evaluation."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-milling load-sequence case shall not have the stalling-analysis purpose." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?purpose
            WHERE {
                $this nltl:loadCasePurpose ?purpose .
                FILTER (?purpose = nltl:stallingAnalysisPurposeValue)
            }
        """
    ] .
