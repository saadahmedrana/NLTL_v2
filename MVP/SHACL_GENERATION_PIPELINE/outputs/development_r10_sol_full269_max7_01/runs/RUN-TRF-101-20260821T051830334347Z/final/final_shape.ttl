@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MeterQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KilonewtonQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF101LoadApplicationRatioShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.8 ;
        sh:maxInclusive 0.8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF101LoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
        sh:node gen:TRF101LoadApplicationRatioShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade-failure load case must apply the load at radius ratio 0.8."
    ] ;
    sh:property [
        sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The blade-failure load must be confirmed as acting in the weakest direction."
    ] .

gen:TRF101FormulaShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The reported reference strength and blade-failure load must satisfy the prescribed formulas within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection ?chordQuantity ;
                      nltl:bladeMaximumThicknessAtWeakestSection ?thicknessQuantity ;
                      nltl:bladeCylindricalRootRadius ?rootRadiusQuantity ;
                      nltl:bladeMinimumYieldStrength ?yieldQuantity ;
                      nltl:bladeUltimateTensileStrength ?ultimateStrengthQuantity ;
                      nltl:bladeReferenceStrength1 ?reportedReferenceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:bladeFailureUltimateLoad ?reportedLoadQuantity .

                ?chordQuantity qudt:numericValue ?chordValue .
                ?thicknessQuantity qudt:numericValue ?thicknessValue .
                ?rootRadiusQuantity qudt:numericValue ?rootRadiusValue .
                ?yieldQuantity qudt:numericValue ?yieldValue .
                ?ultimateStrengthQuantity qudt:numericValue ?ultimateStrengthValue .
                ?reportedReferenceQuantity qudt:numericValue ?reportedReferenceValue .
                ?diameterQuantity qudt:numericValue ?diameterValue .
                ?reportedLoadQuantity qudt:numericValue ?reportedLoadValue .

                BIND(xsd:decimal(?chordValue) AS ?chord)
                BIND(xsd:decimal(?thicknessValue) AS ?thickness)
                BIND(xsd:decimal(?rootRadiusValue) AS ?rootRadius)
                BIND(xsd:decimal(?yieldValue) AS ?yieldStrength)
                BIND(xsd:decimal(?ultimateStrengthValue) AS ?ultimateStrength)
                BIND(xsd:decimal(?reportedReferenceValue) AS ?reportedReferenceStrength)
                BIND(xsd:decimal(?diameterValue) AS ?diameter)
                BIND(xsd:decimal(?reportedLoadValue) AS ?reportedLoad)

                BIND((0.6 * ?yieldStrength + 0.4 * ?ultimateStrength) AS ?expectedReferenceStrength)
                BIND((0.8 * ?diameter - 2.0 * ?rootRadius) AS ?denominator)
                BIND(
                    IF(
                        ?denominator = 0,
                        0,
                        300.0 * ?chord * ?thickness * ?thickness *
                        ?expectedReferenceStrength / ?denominator
                    )
                    AS ?expectedLoad
                )
                BIND(
                    IF(
                        ABS(?expectedReferenceStrength) * 0.000001 > 0.000000001,
                        ABS(?expectedReferenceStrength) * 0.000001,
                        0.000000001
                    )
                    AS ?referenceTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedLoad) * 0.000001 > 0.000000001,
                        ABS(?expectedLoad) * 0.000001,
                        0.000000001
                    )
                    AS ?loadTolerance
                )

                FILTER (
                    ?denominator = 0 ||
                    ABS(?reportedReferenceStrength - ?expectedReferenceStrength) > ?referenceTolerance ||
                    ABS(?reportedLoad - ?expectedLoad) > ?loadTolerance
                )
            }
        """
    ] .

gen:TRF101ApprovedAnalysisShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:approvedNonlinearBladeStressAnalysis ;
        sh:class nltl:approvalRecord ;
        sh:minCount 1 ;
        sh:message "An approved nonlinear blade stress analysis is required for the analysis alternative."
    ] .

gen:TRF101ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:node gen:MeterQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:node gen:KilonewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bladeFailureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:qualifiedValueShape [
            sh:class nltl:loadCase ;
            sh:node gen:TRF101LoadCaseShape
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one blade-failure load case must apply the load at 0.8R in the weakest direction."
    ] ;
    sh:or (
        [
            sh:node gen:TRF101ApprovedAnalysisShape
        ]
        [
            sh:node gen:TRF101FormulaShape
        ]
    ) ;
    sh:sparql [
        sh:message "Blade failure status must be true when blade tip offset exceeds 10 percent of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?tipOffsetQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:bladeFailureStatus ?failureStatus .
                ?tipOffsetQuantity qudt:numericValue ?tipOffsetValue .
                ?diameterQuantity qudt:numericValue ?diameterValue .
                BIND(xsd:decimal(?tipOffsetValue) AS ?tipOffset)
                BIND(xsd:decimal(?diameterValue) AS ?diameter)
                FILTER (
                    ?tipOffset > 0.10 * ?diameter &&
                    ?failureStatus != true
                )
            }
        """
    ] .
