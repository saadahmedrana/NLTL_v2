@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF104Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:node gs:TRF104PropellerShaftLineComponentShape ;
        sh:message "Each linked propeller shaft line component must satisfy the blade-loss damage constraint."
    ] .

gs:TRF104PropellerShaftLineComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:significantDamageFromBladeLoss ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false ) ;
        sh:message "Propeller blade loss must not cause significant damage to the propeller shaft line component."
    ] .
