@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF112ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:node gen:TRF112PropellerShaftLineComponentShape ;
        sh:minCount 1 ;
        sh:message "At least one propeller shaft-line component with bending and torsional yield safety factors is required."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:class nltl:loadCase ;
        sh:qualifiedValueShape gen:TRF112BladeFailureLoadCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one propulsion load case must represent blade failure and provide the required ultimate and combined loads."
    ] .

gen:TRF112BladeFailureLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:hasValue nltl:bladeFailureLoadCase
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:class qudt:QuantityValue ;
        sh:node gen:TRF112ForceQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:combinedAxialBendingTorsionLoad ;
        sh:class qudt:QuantityValue ;
        sh:node gen:TRF112ForceQuantityShape ;
        sh:minCount 1
    ] .

gen:TRF112PropellerShaftLineComponentShape
    a sh:NodeShape ;
    sh:class nltl:propellerShaftLineComponent ;
    sh:property [
        sh:path nltl:bendingYieldSafetyFactor ;
        sh:class qudt:QuantityValue ;
        sh:node gen:TRF112MinimumYieldSafetyFactorShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated bending yield safety factor must be at least 1.0."
    ] ;
    sh:property [
        sh:path nltl:torsionalYieldSafetyFactor ;
        sh:class qudt:QuantityValue ;
        sh:node gen:TRF112MinimumYieldSafetyFactorShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated torsional yield safety factor must be at least 1.0."
    ] .

gen:TRF112ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF112MinimumYieldSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
