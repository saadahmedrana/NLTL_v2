@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF120Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented thruster natural-frequency calculation path must identify a thruster body and a calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?thruster ?case
            WHERE {
                $this nltl:hasComponent ?thruster .
                ?thruster nltl:hasNaturalFrequencyCalculationCase ?case .
                FILTER (
                    NOT EXISTS { ?thruster a nltl:thrusterBody . } ||
                    NOT EXISTS { ?case a nltl:calculationCase . }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented thruster natural-frequency calculation case must specify only longitudinal or transverse vibration direction." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?thruster ?case
            WHERE {
                $this nltl:hasComponent ?thruster .
                ?thruster nltl:hasNaturalFrequencyCalculationCase ?case .
                FILTER (
                    NOT EXISTS {
                        ?case nltl:vibrationDirection ?direction .
                        FILTER (
                            ?direction IN (
                                nltl:longitudinalDirection,
                                nltl:transverseDirection
                            )
                        )
                    } ||
                    EXISTS {
                        ?case nltl:vibrationDirection ?direction .
                        FILTER (
                            ?direction NOT IN (
                                nltl:longitudinalDirection,
                                nltl:transverseDirection
                            )
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Damping information must be provided as an xsd:string when a longitudinal or transverse thruster natural-frequency calculation is represented." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasComponent ?thruster .
                ?thruster nltl:hasNaturalFrequencyCalculationCase ?case .
                ?case nltl:vibrationDirection ?direction .
                FILTER (
                    ?direction IN (
                        nltl:longitudinalDirection,
                        nltl:transverseDirection
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:damping ?damping .
                        FILTER (datatype(?damping) = xsd:string)
                    } ||
                    EXISTS {
                        $this nltl:damping ?damping .
                        FILTER (datatype(?damping) != xsd:string)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Water added mass must be represented by a QUDT quantity value in kilograms for each applicable thruster natural-frequency calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasComponent ?thruster .
                ?thruster nltl:hasNaturalFrequencyCalculationCase ?case .
                ?case nltl:vibrationDirection ?direction .
                FILTER (
                    ?direction IN (
                        nltl:longitudinalDirection,
                        nltl:transverseDirection
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:waterAddedMass ?quantity .
                    } ||
                    EXISTS {
                        $this nltl:waterAddedMass ?quantity .
                        FILTER (
                            NOT EXISTS {
                                ?quantity a qudt:QuantityValue .
                            } ||
                            NOT EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (datatype(?value) = xsd:decimal)
                            } ||
                            EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (datatype(?value) != xsd:decimal)
                            } ||
                            NOT EXISTS {
                                ?quantity qudt:unit unit:KiloGM .
                            } ||
                            EXISTS {
                                ?quantity qudt:unit ?actualUnit .
                                FILTER (!sameTerm(?actualUnit, unit:KiloGM))
                            }
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Thruster natural frequency must be represented by a QUDT quantity value in hertz for each applicable calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasComponent ?thruster .
                ?thruster nltl:hasNaturalFrequencyCalculationCase ?case .
                ?case nltl:vibrationDirection ?direction .
                FILTER (
                    ?direction IN (
                        nltl:longitudinalDirection,
                        nltl:transverseDirection
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:thrusterNaturalFrequency ?quantity .
                    } ||
                    EXISTS {
                        $this nltl:thrusterNaturalFrequency ?quantity .
                        FILTER (
                            NOT EXISTS {
                                ?quantity a qudt:QuantityValue .
                            } ||
                            NOT EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (datatype(?value) = xsd:decimal)
                            } ||
                            EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (datatype(?value) != xsd:decimal)
                            } ||
                            NOT EXISTS {
                                ?quantity qudt:unit unit:HZ .
                            } ||
                            EXISTS {
                                ?quantity qudt:unit ?actualUnit .
                                FILTER (!sameTerm(?actualUnit, unit:HZ))
                            }
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ship attachment stiffness must be represented on the thruster body by a QUDT quantity value in kilonewtons per metre." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?thruster ?case
            WHERE {
                $this nltl:hasComponent ?thruster .
                ?thruster nltl:hasNaturalFrequencyCalculationCase ?case .
                ?case nltl:vibrationDirection ?direction .
                FILTER (
                    ?direction IN (
                        nltl:longitudinalDirection,
                        nltl:transverseDirection
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?thruster nltl:shipAttachmentStiffness ?quantity .
                    } ||
                    EXISTS {
                        ?thruster nltl:shipAttachmentStiffness ?quantity .
                        FILTER (
                            NOT EXISTS {
                                ?quantity a qudt:QuantityValue .
                            } ||
                            NOT EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (datatype(?value) = xsd:decimal)
                            } ||
                            EXISTS {
                                ?quantity qudt:numericValue ?value .
                                FILTER (datatype(?value) != xsd:decimal)
                            } ||
                            NOT EXISTS {
                                ?quantity qudt:unit unit:KiloN-PER-M .
                            } ||
                            EXISTS {
                                ?quantity qudt:unit ?actualUnit .
                                FILTER (!sameTerm(?actualUnit, unit:KiloN-PER-M))
                            }
                        )
                    }
                )
            }
        """
    ] .
