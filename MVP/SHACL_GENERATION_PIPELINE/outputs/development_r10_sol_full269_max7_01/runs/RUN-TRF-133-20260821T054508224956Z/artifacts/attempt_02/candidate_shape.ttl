@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF133ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:in (
            nltl:iceClassIa
            nltl:iceClassIaSuper
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship must have a recognized Finnish-Swedish ice class."
    ] ;
    sh:property [
        sh:path nltl:timberLoadLineMarkApplicable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "The timber-load-line applicability selector must be explicitly provided."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:minCount 1 ;
        sh:class nltl:warningTriangleMarking ;
        sh:node gen:TRF133WarningTriangleMarkingShape ;
        sh:message "A conforming warning-triangle marking is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:minCount 1 ;
        sh:class nltl:iceClassDraughtMarking ;
        sh:node gen:TRF133IceClassDraughtMarkingShape ;
        sh:message "A conforming ice-class draught marking is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:timberLoadLineMarkApplicable ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasIceClassDraughtMarking ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:draughtMarkAftReferencePoint ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:timberLoadLineVerticalReference
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:timberLoadLineMarkApplicable ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasIceClassDraughtMarking ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:draughtMarkAftReferencePoint ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue nltl:loadLineRingCentreReference
                    ]
                ]
            ]
        ]
    ) .

gen:TRF133WarningTriangleMarkingShape
    a sh:NodeShape ;
    sh:class nltl:warningTriangleMarking ;
    sh:property [
        sh:path nltl:warningTriangleUpperEdgeVerticallyAboveIceMark ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The warning-triangle upper edge must be vertically above the ICE mark."
    ] ;
    sh:property [
        sh:path nltl:markingAtOrBelowDeckLine ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The warning-triangle marking must not be higher than the deck line."
    ] ;
    sh:property [
        sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF133VerticalOffset1000mmShape
    ] ;
    sh:property [
        sh:path nltl:warningTriangleSideLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF133SideLength300mmShape
    ] ;
    sh:node gen:TRF133CommonMarkingShape .

gen:TRF133IceClassDraughtMarkingShape
    a sh:NodeShape ;
    sh:class nltl:iceClassDraughtMarking ;
    sh:property [
        sh:path nltl:draughtMarkAftOffset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF133AftOffset540mmShape
    ] ;
    sh:property [
        sh:path nltl:draughtMarkAftReferencePoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:markingReferencePointValue ;
        sh:in (
            nltl:loadLineRingCentreReference
            nltl:timberLoadLineVerticalReference
        )
    ] ;
    sh:property [
        sh:path nltl:letterDimensionsEqualLoadLineMark ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "All letter dimensions must equal those used in the load-line mark."
    ] ;
    sh:node gen:TRF133CommonMarkingShape .

gen:TRF133CommonMarkingShape
    a sh:NodeShape ;
    sh:class nltl:hullStructure ;
    sh:property [
        sh:path nltl:markingPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF133PlateThicknessShape
    ] ;
    sh:property [
        sh:path nltl:markingWeldedToShipSide ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:reflectingMarkingColour ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:reflectingMarkingColourValue ;
        sh:in (
            nltl:redReflectingMarkingColour
            nltl:yellowReflectingMarkingColour
        )
    ] ;
    sh:property [
        sh:path nltl:markingPlainlyVisibleInIceConditions ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] .

gen:TRF133PlateThicknessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "5"^^xsd:decimal ;
        sh:maxInclusive "8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .

gen:TRF133VerticalOffset1000mmShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "1000"^^xsd:decimal ;
        sh:maxInclusive "1000"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .

gen:TRF133SideLength300mmShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "300"^^xsd:decimal ;
        sh:maxInclusive "300"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .

gen:TRF133AftOffset540mmShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "540"^^xsd:decimal ;
        sh:maxInclusive "540"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .
