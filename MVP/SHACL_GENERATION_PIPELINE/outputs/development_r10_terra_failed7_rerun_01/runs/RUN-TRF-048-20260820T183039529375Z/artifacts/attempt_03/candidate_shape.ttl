@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:LengthQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:PressureQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:ShearFactorQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 2.16 ;
        sh:maxInclusive 2.16
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:AreaQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF048LongitudinalFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:ShearFactorQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:SectionModulusQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:AreaQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:AreaQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:AreaQuantityShape>
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameBoundaryConditionEvidence ;
                sh:minCount 1 ;
                sh:class nltl:frameBoundaryConditionEvidence ;
                sh:message "Boundary-condition evidence is required when a smaller frame moment factor is used."
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "frameMomentFactorM must be 13.3 unless significantly different boundary conditions require a smaller factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:significantlyDifferentBoundaryConditions ?different ;
                      nltl:frameMomentFactorM ?m .
                ?m qudt:numericValue ?mVal .
                FILTER(
                    (?different = false && ?mVal != 13.3) ||
                    (?different = true && ?mVal >= 13.3)
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "longitudinalFrameLoadDistributionFactorF4 must equal 1 - 0.2 times designIceLoadHeight divided by spacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?h ;
                      nltl:spacing ?s ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4 .
                ?h qudt:numericValue ?hVal .
                ?s qudt:numericValue ?sVal .
                ?f4 qudt:numericValue ?f4Val .
                BIND(IF(?sVal = 0, 0.0, 1.0 - (0.2 * ?hVal / ?sVal)) AS ?expected)
                FILTER(
                    ?sVal = 0 ||
                    ABS(?f4Val - ?expected) > (0.000000001 + (0.000001 * ABS(?expected)))
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "sectionModulus must equal f4 times ice pressure, load height, and span squared divided by 4 times m and yield strength, multiplied by 10^6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameLoadDistributionFactorF4 ?f4 ;
                      nltl:icePressure ?p ;
                      nltl:designIceLoadHeight ?h ;
                      nltl:span ?l ;
                      nltl:frameMomentFactorM ?m ;
                      nltl:yieldStrength ?sigma ;
                      nltl:sectionModulus ?z .
                ?f4 qudt:numericValue ?f4Val .
                ?p qudt:numericValue ?pVal .
                ?h qudt:numericValue ?hVal .
                ?l qudt:numericValue ?lVal .
                ?m qudt:numericValue ?mVal .
                ?sigma qudt:numericValue ?sigmaVal .
                ?z qudt:numericValue ?zVal .
                BIND(
                    IF(
                        (?mVal = 0 || ?sigmaVal = 0),
                        0.0,
                        ((?f4Val * ?pVal * ?hVal * ?lVal * ?lVal) / (4.0 * ?mVal * ?sigmaVal)) * 1000000.0
                    )
                    AS ?expected
                )
                FILTER(
                    ?mVal = 0 ||
                    ?sigmaVal = 0 ||
                    ABS(?zVal - ?expected) > (0.000000001 + (0.000001 * ABS(?expected)))
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "actualFrameShearArea must equal sqrt(3) times f4 times 2.16 times ice pressure, load height, and span divided by twice the yield strength, multiplied by 10^4." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:longitudinalFrameLoadDistributionFactorF4 ?f4 ;
                      nltl:icePressure ?p ;
                      nltl:designIceLoadHeight ?h ;
                      nltl:span ?l ;
                      nltl:yieldStrength ?sigma ;
                      nltl:actualFrameShearArea ?a .
                ?f4 qudt:numericValue ?f4Val .
                ?p qudt:numericValue ?pVal .
                ?h qudt:numericValue ?hVal .
                ?l qudt:numericValue ?lVal .
                ?sigma qudt:numericValue ?sigmaVal .
                ?a qudt:numericValue ?aVal .
                BIND(
                    IF(
                        ?sigmaVal = 0,
                        0.0,
                        ((1.7320508075688772 * ?f4Val * 2.16 * ?pVal * ?hVal * ?lVal) / (2.0 * ?sigmaVal)) * 10000.0
                    )
                    AS ?expected
                )
                FILTER(
                    ?sigmaVal = 0 ||
                    ABS(?aVal - ?expected) > (0.000000001 + (0.000001 * ABS(?expected)))
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "actualFrameShearArea must equal grossFrameShearArea minus bracketArea." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea ?gross ;
                      nltl:bracketArea ?bracket ;
                      nltl:actualFrameShearArea ?actual .
                ?gross qudt:numericValue ?grossVal .
                ?bracket qudt:numericValue ?bracketVal .
                ?actual qudt:numericValue ?actualVal .
                BIND((?grossVal - ?bracketVal) AS ?expected)
                FILTER(
                    ABS(?actualVal - ?expected) > (0.000000001 + (0.000001 * ABS(?expected)))
                )
            }
        """
    ] .
