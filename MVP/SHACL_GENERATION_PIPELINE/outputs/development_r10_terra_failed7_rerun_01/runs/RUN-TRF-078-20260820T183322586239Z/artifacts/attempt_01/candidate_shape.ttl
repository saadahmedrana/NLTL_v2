@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF078DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF078TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:node gen:TRF078DimensionlessQuantityShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ] ;
            sh:property [
                sh:path nltl:tableLookupPropellerLocation ;
                sh:class nltl:propellerLocationValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:node gen:TRF078DimensionlessQuantityShape
            ]
        ]
    ) .

gen:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gen:TRF078TableLookupCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-6 lookup case is required."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-7 lookup case is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:node gen:TRF078DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1 multiplied by k2, k3, N_class, and n_n within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK2 ?k2q ;
                      nltl:iceLoadCycleCoefficientK3 ?k3q ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnq ;
                      nltl:iceLoadCycleCount ?nice ;
                      nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase .

                ?k2q qudt:numericValue ?k2 .
                ?k3q qudt:numericValue ?k3 .
                ?nnq qudt:numericValue ?nn .

                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                           nltl:selectedIceClassCycleCount ?classCountq .
                ?classCountq qudt:numericValue ?nclass .

                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                              nltl:selectedPropellerLocationFactor ?k1q .
                ?k1q qudt:numericValue ?k1 .

                BIND((?k1 * ?k2 * ?k3 * ?nclass * ?nn) AS ?expected)
                FILTER(ABS(?nice - ?expected) > ((0.000001 * ABS(?expected)) + 0.000000001))
            }
        """
    ] .
