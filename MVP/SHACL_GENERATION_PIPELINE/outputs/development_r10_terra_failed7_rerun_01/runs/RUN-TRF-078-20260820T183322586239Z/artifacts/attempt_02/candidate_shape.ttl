@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF078DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF078TableLookupCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:node gen:TRF078DimensionlessQuantityShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ] ;
            sh:property [
                sh:path nltl:tableLookupPropellerLocation ;
                sh:class nltl:propellerLocationValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:node gen:TRF078DimensionlessQuantityShape ;
                sh:minCount 1
            ]
        ]
    ) .

gen:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-6 lookup case with its ice-class selection is required."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-7 lookup case with its propeller-location selection is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gen:TRF078DimensionlessQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1 multiplied by k2, k3, N_class, and n_n within the calculation tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Quantity ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnQuantity ;
                      nltl:iceLoadCycleCount ?nice .

                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                           nltl:selectedIceClassCycleCount ?nClassQuantity .

                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                              nltl:selectedPropellerLocationFactor ?k1Quantity .

                ?k1Quantity qudt:numericValue ?k1 .
                ?k2Quantity qudt:numericValue ?k2 .
                ?k3Quantity qudt:numericValue ?k3 .
                ?nClassQuantity qudt:numericValue ?nClass .
                ?nnQuantity qudt:numericValue ?nn .

                BIND(
                    (xsd:decimal(?k1) * xsd:decimal(?k2) * xsd:decimal(?k3) *
                     xsd:decimal(?nClass) * xsd:decimal(?nn))
                    AS ?expected
                )

                FILTER(
                    ABS(xsd:decimal(?nice) - ?expected) >
                    ((ABS(?expected) * 0.000001) + 0.000001)
                )
            }
        """
    ] .
