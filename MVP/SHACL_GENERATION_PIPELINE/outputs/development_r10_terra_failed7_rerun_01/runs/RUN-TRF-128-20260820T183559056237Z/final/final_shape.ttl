@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-128Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ice class is required to determine the applicable compressor charging limit."
    ] ;

    sh:property [
        sh:path nltl:propulsionEngineReversalRequiredForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The propulsion-engine reversal condition is required to determine the applicable compressor charging limit."
    ] ;

    sh:property [
        sh:path nltl:compressorChargeTime ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:HR ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Compressor charge time must be represented as a decimal quantity in hours."
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Compressor charge time exceeds the applicable maximum of 0.5 hour for IA Super ships requiring propulsion-engine reversal astern, or 1 hour otherwise." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propulsionEngineReversalRequiredForAstern ?reversalRequired ;
                      nltl:compressorChargeTime ?chargeTime .
                ?chargeTime qudt:numericValue ?time ;
                            qudt:unit unit:HR .

                FILTER (
                    (
                        ?iceClass = nltl:iceClassIaSuper &&
                        ?reversalRequired = "true"^^xsd:boolean &&
                        ?time > "0.5"^^xsd:decimal
                    )
                    ||
                    (
                        (
                            ?iceClass != nltl:iceClassIaSuper ||
                            ?reversalRequired != "true"^^xsd:boolean
                        ) &&
                        ?time > "1.0"^^xsd:decimal
                    )
                )
            }
        """
    ] .
