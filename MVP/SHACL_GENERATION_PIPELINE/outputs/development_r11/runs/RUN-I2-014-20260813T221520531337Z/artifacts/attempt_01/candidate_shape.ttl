@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LineLoadQuantityShape
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must be divided into four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:BowSubregionCaseShape ;
        sh:message "Exactly four bow subregion calculation cases are required."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LineLoadQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:KiloNewtonQuantityShape
    ] ;
    sh:sparql [
        sh:message "Each subregion midpoint must be at 1/8, 3/8, 5/8, or 7/8 of the bow length within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:bowLength ?lengthQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?lengthQuantity qudt:numericValue ?length .
                ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
                ?positionQuantity qudt:numericValue ?position .
                FILTER (
                    ABS(?position - (?length / 8)) >
                        (xsd:decimal("0.000001") * ABS(?length / 8) + xsd:decimal("0.000000000001")) &&
                    ABS(?position - ((3 * ?length) / 8)) >
                        (xsd:decimal("0.000001") * ABS((3 * ?length) / 8) + xsd:decimal("0.000000000001")) &&
                    ABS(?position - ((5 * ?length) / 8)) >
                        (xsd:decimal("0.000001") * ABS((5 * ?length) / 8) + xsd:decimal("0.000000000001")) &&
                    ABS(?position - ((7 * ?length) / 8)) >
                        (xsd:decimal("0.000001") * ABS((7 * ?length) / 8) + xsd:decimal("0.000000000001"))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The four calculation cases must represent all four distinct bow subregion midpoint positions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?lengthQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?lengthQuantity qudt:numericValue ?length .
                ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
                ?positionQuantity qudt:numericValue ?position .
                BIND(
                    IF(
                        ABS(?position - (?length / 8)) <=
                            (xsd:decimal("0.000001") * ABS(?length / 8) + xsd:decimal("0.000000000001")),
                        1,
                        IF(
                            ABS(?position - ((3 * ?length) / 8)) <=
                                (xsd:decimal("0.000001") * ABS((3 * ?length) / 8) + xsd:decimal("0.000000000001")),
                            2,
                            IF(
                                ABS(?position - ((5 * ?length) / 8)) <=
                                    (xsd:decimal("0.000001") * ABS((5 * ?length) / 8) + xsd:decimal("0.000000000001")),
                                3,
                                IF(
                                    ABS(?position - ((7 * ?length) / 8)) <=
                                        (xsd:decimal("0.000001") * ABS((7 * ?length) / 8) + xsd:decimal("0.000000000001")),
                                    4,
                                    0
                                )
                            )
                        )
                    ) AS ?midpointBucket
                )
                FILTER (?midpointBucket IN (1, 2, 3, 4))
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?midpointBucket) != 4)
        """
    ] ;
    sh:sparql [
        sh:message "The selected bow force, line load, and pressure must equal their respective maxima across the four subregion cases within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoadQuantity ;
                      nltl:selectedMaximumBowPressure ?selectedPressureQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?selectedForceQuantity qudt:numericValue ?selectedForce .
                ?selectedLineLoadQuantity qudt:numericValue ?selectedLineLoad .
                ?selectedPressureQuantity qudt:numericValue ?selectedPressure .
                ?case nltl:bowSubregionCalculatedForce ?forceQuantity ;
                      nltl:glancingImpactLineLoad ?lineLoadQuantity ;
                      nltl:glancingImpactPressure ?pressureQuantity .
                ?forceQuantity qudt:numericValue ?force .
                ?lineLoadQuantity qudt:numericValue ?lineLoad .
                ?pressureQuantity qudt:numericValue ?pressure .
            }
            GROUP BY $this ?selectedForce ?selectedLineLoad ?selectedPressure
            HAVING (
                ABS(?selectedForce - MAX(?force)) >
                    (xsd:decimal("0.000001") * ABS(MAX(?force)) + xsd:decimal("0.000000000001")) ||
                ABS(?selectedLineLoad - MAX(?lineLoad)) >
                    (xsd:decimal("0.000001") * ABS(MAX(?lineLoad)) + xsd:decimal("0.000000000001")) ||
                ABS(?selectedPressure - MAX(?pressure)) >
                    (xsd:decimal("0.000001") * ABS(MAX(?pressure)) + xsd:decimal("0.000000000001"))
            )
        """
    ] .
