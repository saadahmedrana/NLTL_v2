@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MeterQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonPerMeterQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonPerMeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonPerMeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:sparql [
        sh:message "Each subregion glancing-impact line load and pressure must match its calculated line load and pressure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowSubregionCalculatedLineLoad ?calculatedLineLoad ;
                      nltl:glancingImpactLineLoad ?glancingLineLoad ;
                      nltl:bowSubregionCalculatedPressure ?calculatedPressure ;
                      nltl:glancingImpactPressure ?glancingPressure .
                ?calculatedLineLoad qudt:numericValue ?calculatedQ .
                ?glancingLineLoad qudt:numericValue ?glancingQ .
                ?calculatedPressure qudt:numericValue ?calculatedP .
                ?glancingPressure qudt:numericValue ?glancingP .
                BIND((ABS(?calculatedQ) * 0.000001 + 0.000000001) AS ?qTolerance)
                BIND((ABS(?calculatedP) * 0.000001 + 0.000000001) AS ?pTolerance)
                FILTER (
                    ABS(?glancingQ - ?calculatedQ) > ?qTolerance ||
                    ABS(?glancingP - ?calculatedP) > ?pTolerance
                )
            }
        """
    ] .

gen:BowSubregionRequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:BowSubregionCalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonPerMeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:KiloNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MeterQuantityShape
    ] ;
    sh:sparql [
        sh:message "The four subregion mid-length positions must be one-eighth, three-eighths, five-eighths, and seven-eighths of the bow length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?bowLength ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?bowLength qudt:numericValue ?length .
                ?case nltl:bowSubregionMidLengthPosition ?position .
                ?position qudt:numericValue ?midpoint .
                BIND((?length / 8) AS ?p1)
                BIND((3 * ?length / 8) AS ?p2)
                BIND((5 * ?length / 8) AS ?p3)
                BIND((7 * ?length / 8) AS ?p4)
                BIND((ABS(?p1) * 0.000001 + 0.000000001) AS ?t1)
                BIND((ABS(?p2) * 0.000001 + 0.000000001) AS ?t2)
                BIND((ABS(?p3) * 0.000001 + 0.000000001) AS ?t3)
                BIND((ABS(?p4) * 0.000001 + 0.000000001) AS ?t4)
            }
            GROUP BY $this ?p1 ?p2 ?p3 ?p4 ?t1 ?t2 ?t3 ?t4
            HAVING (
                SUM(IF(ABS(?midpoint - ?p1) <= ?t1, 1, 0)) != 1 ||
                SUM(IF(ABS(?midpoint - ?p2) <= ?t2, 1, 0)) != 1 ||
                SUM(IF(ABS(?midpoint - ?p3) <= ?t3, 1, 0)) != 1 ||
                SUM(IF(ABS(?midpoint - ?p4) <= ?t4, 1, 0)) != 1
            )
        """
    ] ;
    sh:sparql [
        sh:message "The selected bow force, line load, and pressure must be the maxima of the four calculated subregion values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForce ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoad ;
                      nltl:selectedMaximumBowPressure ?selectedPressure .
                ?selectedForce qudt:numericValue ?selectedF .
                ?selectedLineLoad qudt:numericValue ?selectedQ .
                ?selectedPressure qudt:numericValue ?selectedP .
                {
                    SELECT $this
                           (MAX(?forceValue) AS ?maximumF)
                           (MAX(?lineLoadValue) AS ?maximumQ)
                           (MAX(?pressureValue) AS ?maximumP)
                    WHERE {
                        $this nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?force ;
                              nltl:bowSubregionCalculatedLineLoad ?lineLoad ;
                              nltl:bowSubregionCalculatedPressure ?pressure .
                        ?force qudt:numericValue ?forceValue .
                        ?lineLoad qudt:numericValue ?lineLoadValue .
                        ?pressure qudt:numericValue ?pressureValue .
                    }
                    GROUP BY $this
                }
                BIND((ABS(?maximumF) * 0.000001 + 0.000000001) AS ?fTolerance)
                BIND((ABS(?maximumQ) * 0.000001 + 0.000000001) AS ?qTolerance)
                BIND((ABS(?maximumP) * 0.000001 + 0.000000001) AS ?pTolerance)
                FILTER (
                    ABS(?selectedF - ?maximumF) > ?fTolerance ||
                    ABS(?selectedQ - ?maximumQ) > ?qTolerance ||
                    ABS(?selectedP - ?maximumP) > ?pTolerance
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected maximum force, line load, and pressure must derive the total force, average pressure, load-patch height, and load-patch length." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForce ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoad ;
                      nltl:selectedMaximumBowPressure ?selectedPressure ;
                      nltl:totalGlancingImpactForce ?totalForce ;
                      nltl:averageIcePressure ?averagePressure ;
                      nltl:loadPatchHeight ?patchHeight ;
                      nltl:loadPatchLength ?patchLength .
                ?selectedForce qudt:numericValue ?selectedF .
                ?selectedLineLoad qudt:numericValue ?selectedQ .
                ?selectedPressure qudt:numericValue ?selectedP .
                ?totalForce qudt:numericValue ?reportedTotalF .
                ?averagePressure qudt:numericValue ?reportedPavg .
                ?patchHeight qudt:numericValue ?reportedHeight .
                ?patchLength qudt:numericValue ?reportedLength .
                BIND((?selectedF * 1000) AS ?expectedTotalF)
                BIND(?selectedP AS ?expectedPavg)
                BIND((?selectedQ / ?selectedP) AS ?expectedHeight)
                BIND((?selectedF / ?selectedQ) AS ?expectedLength)
                BIND((ABS(?expectedTotalF) * 0.000001 + 0.000000001) AS ?totalFTolerance)
                BIND((ABS(?expectedPavg) * 0.000001 + 0.000000001) AS ?pavgTolerance)
                BIND((ABS(?expectedHeight) * 0.000001 + 0.000000001) AS ?heightTolerance)
                BIND((ABS(?expectedLength) * 0.000001 + 0.000000001) AS ?lengthTolerance)
                FILTER (
                    ?selectedQ = 0 ||
                    ?selectedP = 0 ||
                    ABS(?reportedTotalF - ?expectedTotalF) > ?totalFTolerance ||
                    ABS(?reportedPavg - ?expectedPavg) > ?pavgTolerance ||
                    ABS(?reportedHeight - ?expectedHeight) > ?heightTolerance ||
                    ABS(?reportedLength - ?expectedLength) > ?lengthTolerance
                )
            }
        """
    ] .
