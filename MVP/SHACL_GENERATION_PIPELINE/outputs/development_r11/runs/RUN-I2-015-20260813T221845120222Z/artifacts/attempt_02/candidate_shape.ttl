@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DecimalMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveDecimalMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalDegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalUnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveDecimalUnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "0"^^xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FailureClassFactorLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:node gen:DecimalUnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gen:PositiveDecimalUnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gen:DecimalMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:node gen:DecimalDegreeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gen:DecimalUnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:FailureClassFactorLookupCaseShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:BowSubregionCalculationCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:betaIPrime ;
                sh:node gen:PositiveDecimalUnitlessQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineLengthLUI ;
                sh:node gen:PositiveDecimalMetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineDraughtDUI ;
                sh:node gen:PositiveDecimalMetreQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "bowShapeCoefficient must equal min(f_ai1, f_ai2, 0.60) within relative tolerance 1e-6 or absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?case
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case ;
                      nltl:betaIPrime/qudt:numericValue ?beta ;
                      nltl:upperIceWaterlineLengthLUI/qudt:numericValue ?lui ;
                      nltl:upperIceWaterlineDraughtDUI/qudt:numericValue ?dui .

                ?case nltl:bowSubregionMidLengthPosition/qudt:numericValue ?x ;
                      nltl:bowSubregionWaterlineAngle/qudt:numericValue ?alpha ;
                      nltl:bowShapeCoefficient/qudt:numericValue ?reported ;
                      nltl:hasFailureClassFactorLookupCase ?lookup .

                ?lookup nltl:flexuralFailureClassFactor/qudt:numericValue ?cff ;
                        nltl:crushingFailureClassFactor/qudt:numericValue ?cfc .

                BIND((?x / ?lui) AS ?positionRatio)
                BIND(
                    (
                        (
                            "0.097"^^xsd:decimal -
                            (
                                "0.68"^^xsd:decimal *
                                (?positionRatio - "0.15"^^xsd:decimal) *
                                (?positionRatio - "0.15"^^xsd:decimal)
                            )
                        ) *
                        ?alpha /
                        math:pow(?beta, "0.5"^^xsd:decimal)
                    )
                    AS ?fai1
                )
                BIND(math:sin(?beta) AS ?sinBeta)
                BIND(
                    (
                        ?sinBeta *
                        ?cfc *
                        math:pow(?dui, "0.64"^^xsd:decimal)
                    )
                    AS ?denominator
                )
                BIND(
                    IF(
                        ABS(?denominator) > "0.000000000000001"^^xsd:decimal,
                        "1.2"^^xsd:decimal * ?cff / ?denominator,
                        "0"^^xsd:decimal
                    )
                    AS ?fai2
                )
                BIND(
                    IF(
                        ?fai1 <= ?fai2 && ?fai1 <= "0.60"^^xsd:decimal,
                        ?fai1,
                        IF(
                            ?fai2 <= "0.60"^^xsd:decimal,
                            ?fai2,
                            "0.60"^^xsd:decimal
                        )
                    )
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * "0.000001"^^xsd:decimal >
                        "0.000000001"^^xsd:decimal,
                        ABS(?expected) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(
                    ABS(?denominator) <= "0.000000000000001"^^xsd:decimal ||
                    ABS(?reported - ?expected) > ?tolerance
                )
            }
        """
    ] .
