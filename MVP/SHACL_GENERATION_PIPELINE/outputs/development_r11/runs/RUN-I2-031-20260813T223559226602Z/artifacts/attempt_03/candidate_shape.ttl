@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal numeric value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:KiloN ) ;
        sh:message "The quantity unit must be kN."
    ] .

gen:ApplicableLocalFrameShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasStructuralMember ?this .
                ?this a nltl:localFrame ;
                      nltl:structuralLocation ?location .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?this nltl:transverseFrameOrientation true .
                        }
                    )
                )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "An applicable local frame requires a midspan plastic collapse load in kN."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:minCount 1 ;
        sh:node gen:ApplicableLoadCaseShape ;
        sh:message "An applicable local frame requires a structural-member load case."
    ] .

gen:ApplicableLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "An applicable load case requires combined shear and bending demand in kN."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each bottom-frame load case must specify only the patch orientation with dimension b parallel to the frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:bottomStructureLocation ;
                        nltl:hasStructuralMemberLoadCase $this .
                FILTER (
                    (NOT EXISTS {
                        $this nltl:loadPatchOrientation
                            nltl:loadPatchHeightParallelToFrame .
                    }) ||
                    EXISTS {
                        $this nltl:loadPatchOrientation ?orientation .
                        FILTER (
                            ?orientation !=
                            nltl:loadPatchHeightParallelToFrame
                        )
                    }
                )
            }
        """
    ] .

gen:ApplicableShipShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                      nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
            }
        """
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "Plastic strength is required in kN for applicable local frames."
    ] ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:frameProfileTypeValue ;
        sh:message "A frame profile type relationship is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Combined shear and bending demand must not exceed the ship-owned plastic strength in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?member ?loadCase
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:plasticStrength ?strengthQuantity .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                ?loadCase nltl:combinedShearAndBendingDemand
                    ?demandQuantity .
                ?demandQuantity
                    qudt:numericValue ?demand ;
                    qudt:unit unit:KiloN .
                ?strengthQuantity
                    qudt:numericValue ?strength ;
                    qudt:unit unit:KiloN .
                FILTER (
                    xsd:decimal(?demand) > xsd:decimal(?strength)
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Plastic strength must equal the magnitude of the midspan plastic collapse load within relative tolerance 1e-6 or absolute fallback 1e-12 kN near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:plasticStrength ?strengthQuantity .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:midspanPlasticCollapseLoad
                            ?collapseQuantity .
                FILTER (
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                ?strengthQuantity
                    qudt:numericValue ?strength ;
                    qudt:unit unit:KiloN .
                ?collapseQuantity
                    qudt:numericValue ?collapse ;
                    qudt:unit unit:KiloN .
                FILTER (
                    ABS(
                        xsd:decimal(?strength) -
                        ABS(xsd:decimal(?collapse))
                    ) >
                    IF(
                        ABS(xsd:decimal(?collapse)) > 0.000001,
                        ABS(xsd:decimal(?collapse)) * 0.000001,
                        0.000000000001
                    )
                )
            }
        """
    ] .

gen:BottomFrameShipShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this a nltl:ship ;
                      nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation
                            nltl:bottomStructureLocation .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:patchLoad ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "A ship with an applicable bottom local frame requires a patch load in kN."
    ] .
