@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_034_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gs:I2_034_MemberConditionalShape
    ] ;
    sh:or (
        gs:I2_034_NoApplicableMembersShape
        gs:I2_034_ApplicableShipShape
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Combined shear and bending demand exceeds plastic strength, or plastic strength differs from the midspan plastic-collapse load beyond tolerance." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?member ?loadCase
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:plasticStrength ?strengthQuantity .
    ?member nltl:sideStructureApplicability "true"^^xsd:boolean ;
            nltl:longitudinalFrameOrientation "true"^^xsd:boolean ;
            nltl:midspanPlasticCollapseLoad ?collapseQuantity ;
            nltl:hasStructuralMemberLoadCase ?loadCase .
    ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
    ?strengthQuantity qudt:numericValue ?strength ;
                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
    ?collapseQuantity qudt:numericValue ?collapse ;
                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
    ?demandQuantity qudt:numericValue ?demand ;
                    qudt:unit <http://qudt.org/vocab/unit/KiloN> .
    FILTER(
        ABS(?strength - ?collapse) >
            IF(
                ABS(?collapse) * 0.000001 > 0.000000000001,
                ABS(?collapse) * 0.000001,
                0.000000000001
            )
        ||
        ?demand > ?strength
    )
}
"""
    ] .

gs:I2_034_NoApplicableMembersShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:I2_034_NonApplicableMemberShape
    ] .

gs:I2_034_ApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:qualifiedValueShape gs:I2_034_ApplicableMemberShape ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:class qudt:QuantityValue ;
        sh:node gs:I2_034_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Plastic strength is required when an applicable longitudinal side-structure member exists."
    ] .

gs:I2_034_MemberConditionalShape
    a sh:NodeShape ;
    sh:or (
        gs:I2_034_NonApplicableMemberShape
        gs:I2_034_ApplicableMemberShape
    ) .

gs:I2_034_NonApplicableMemberShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sideStructureApplicability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:sideStructureApplicability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:longitudinalFrameOrientation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .

gs:I2_034_ApplicableMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sideStructureApplicability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:class qudt:QuantityValue ;
        sh:node gs:I2_034_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Midspan plastic-collapse load is required for an applicable member."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:class nltl:loadCase ;
        sh:node gs:I2_034_LoadCaseShape ;
        sh:minCount 1 ;
        sh:message "An applicable member requires a structural-member load case."
    ] .

gs:I2_034_LoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:class qudt:QuantityValue ;
        sh:node gs:I2_034_KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:message "Combined shear and bending demand is required for the load case."
    ] .

gs:I2_034_KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .
