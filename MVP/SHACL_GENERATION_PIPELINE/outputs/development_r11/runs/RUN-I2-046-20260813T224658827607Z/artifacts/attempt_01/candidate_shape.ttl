@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

g:I2_046_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each linked plated internal ice-strengthened structure of a Polar Class ship must have a corrosion/abrasion allowance of at least 1.0 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:polarClass ?polarClass ;
                      nltl:hasInternalIceStrengthenedStructure ?plating ;
                      nltl:hasPlating ?plating .
                FILTER NOT EXISTS {
                    ?plating nltl:corrosionAbrasionAllowance ?allowance .
                    ?allowance qudt:numericValue ?value ;
                               qudt:unit unit:MilliM .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value >= 1.0
                    )
                }
            }
        """
    ] .
