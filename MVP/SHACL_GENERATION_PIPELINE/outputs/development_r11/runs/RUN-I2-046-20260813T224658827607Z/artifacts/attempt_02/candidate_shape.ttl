@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipCorrosionAbrasionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:class nltl:polarClassValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasInternalIceStrengthenedStructure ;
                sh:class nltl:internalIceStrengthenedStructure ;
                sh:minCount 1 ;
                sh:message "Polar Class ships must identify the internal ice-strengthened structures to which the corrosion/abrasion addition applies."
            ] ;
            sh:property [
                sh:path nltl:asBuiltThickness ;
                sh:minCount 1 ;
                sh:node gen:AsBuiltThicknessQuantityShape ;
                sh:message "Polar Class ships must provide as-built thickness in metres."
            ] ;
            sh:property [
                sh:path nltl:corrosionAbrasionAddition ;
                sh:minCount 1 ;
                sh:node gen:MinimumCorrosionAbrasionQuantityShape ;
                sh:message "The corrosion/abrasion addition must be at least 1.0 mm."
            ] ;
            sh:property [
                sh:path nltl:hasPlating ;
                sh:node gen:PlatingCorrosionAbrasionShape
            ]
        ]
    ) .

gen:AsBuiltThicknessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1
    ] .

gen:MinimumCorrosionAbrasionQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1
    ] .

gen:PlatingCorrosionAbrasionShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:corrosionAbrasionAllowance ;
        sh:minCount 1 ;
        sh:node gen:MinimumCorrosionAbrasionQuantityShape ;
        sh:message "Linked plating must have a corrosion/abrasion allowance of at least 1.0 mm."
    ] .
