@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:in ( unit:MilliM )
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:in ( unit:UNITLESS )
    ] .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationMethodValue
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:node gen:MillimetreQuantityShape
    ] .

gen:I2_065Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:calculationCase ;
        sh:node gen:CalculationCaseShape
    ] ;
    sh:property [
        sh:path nltl:fractureMargin ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:majorBucklingMargin ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldingMargin ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:sparql [
        sh:message "Each nonlinear calculation case requires acceptance evidence, unitless fracture, major-buckling and yielding margins, millimetre deformation and structural-dimension values, and a satisfied minor-deformation assessment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:fractureMargin ?fractureMargin ;
                          nltl:majorBucklingMargin ?majorBucklingMargin ;
                          nltl:yieldingMargin ?yieldingMargin .
                    ?case nltl:nonlinearAnalysisAcceptanceEvidence ?evidence ;
                          nltl:permanentLateralDeformation ?lateralDeformation ;
                          nltl:permanentOutOfPlaneDeformation ?outOfPlaneDeformation ;
                          nltl:relevantStructuralDimension ?structuralDimension ;
                          nltl:minorPermanentDeformationAssessmentSatisfied ?assessment .
                    FILTER (
                        datatype(?assessment) = xsd:boolean &&
                        ?assessment = "true"^^xsd:boolean
                    )
                }
            }
        """
    ] .
