@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO102ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:crewRole ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredPolarTrainingLevel ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasCrewMemberInventory ;
        sh:class nltl:crewMember
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:in ( "Ice free" )
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "master"
                    "chief mate"
                    "officers in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:in ( "Not applicable" )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:in ( "Open waters" )
            ] ;
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:in ( nltl:openWaterIceCondition )
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "master"
                    "chief mate"
                    "officers in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:in ( "Basic training" )
            ] ;
            sh:property [
                sh:path nltl:hasCrewMemberInventory ;
                sh:node gs:IMO102ApplicableCrewShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:in ( "Open waters" )
            ] ;
            sh:property [
                sh:path nltl:iceConditionClassification ;
                sh:minCount 1 ;
                sh:in ( nltl:openWaterIceCondition )
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in (
                    "master"
                    "chief mate"
                    "officers in charge of a navigational watch"
                )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:in ( "Not applicable" )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:in ( "Other waters" )
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in ( "master" "chief mate" )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:in ( "Advanced training" )
            ] ;
            sh:property [
                sh:path nltl:hasCrewMemberInventory ;
                sh:node gs:IMO102ApplicableCrewShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCondition ;
                sh:in ( "Other waters" )
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:in ( "Tankers" "Passenger ships" "Other" )
            ] ;
            sh:property [
                sh:path nltl:crewRole ;
                sh:in ( "officers in charge of a navigational watch" )
            ] ;
            sh:property [
                sh:path nltl:requiredPolarTrainingLevel ;
                sh:in ( "Basic training" )
            ] ;
            sh:property [
                sh:path nltl:hasCrewMemberInventory ;
                sh:node gs:IMO102ApplicableCrewShape
            ]
        ]
    ) ;
    sh:message "Ice condition, ship type, crew role, and required polar training level must conform to the clause 12.3.1 matrix." .

gs:IMO102ApplicableCrewShape
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable crew member must have a shared polar training record with a valid STCW qualification and matching required and recorded training levels." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER NOT EXISTS {
        $this nltl:hasCrewTrainingRecord ?record ;
              nltl:hasPolarTrainingRecord ?record .
        ?record a nltl:polarTrainingRecord ;
                nltl:stcwQualificationValid "true"^^xsd:boolean ;
                nltl:requiredTrainingLevel ?level ;
                nltl:trainingRecordLevel ?level .
        ?level a nltl:trainingLevelValue .
    }
}
"""
    ] .
