@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF069Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicable propulsion machinery must record maximum ice torque in kN·m and a design condition covering the required normal-service ice-load scope and exclusions." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:propellerType ?propellerType ;
          nltl:pitchType ?pitchType .

    FILTER (
        ?iceClass IN (
            nltl:iceClassIaSuper,
            nltl:iceClassIa,
            nltl:iceClassIb,
            nltl:iceClassIc
        )
    )
    FILTER (
        ?propellerType IN (
            "open"^^xsd:string,
            "ducted"^^xsd:string
        )
    )
    FILTER (
        ?pitchType IN (
            "controllable"^^xsd:string,
            "fixed"^^xsd:string
        )
    )

    FILTER NOT EXISTS {
        $this nltl:maximumIceTorque ?torque ;
              nltl:hasDesignCondition ?condition .

        ?torque a qudt:QuantityValue ;
                qudt:numericValue ?torqueValue ;
                qudt:unit unit:KiloN-M .

        ?condition
            nltl:normalOperationalConditions ?normalOperations ;
            nltl:normalServiceLifePropellerIceLoadCondition ?serviceLifeLoads ;
            nltl:fixedPitchPropellerReversalLoadIncluded ?reversalLoads ;
            nltl:stoppedPropellerDraggingOutsideLoadModel ?stoppedDraggingExcluded ;
            nltl:radialIceEntryOutsideLoadModel ?radialEntryExcluded .

        FILTER (
            datatype(?torqueValue) = xsd:decimal &&
            datatype(?normalOperations) = xsd:boolean &&
            ?normalOperations = true &&
            datatype(?serviceLifeLoads) = xsd:boolean &&
            ?serviceLifeLoads = true &&
            datatype(?reversalLoads) = xsd:boolean &&
            ?reversalLoads = true &&
            datatype(?stoppedDraggingExcluded) = xsd:boolean &&
            ?stoppedDraggingExcluded = true &&
            datatype(?radialEntryExcluded) = xsd:boolean &&
            ?radialEntryExcluded = true
        )
    }
}
"""
    ] .
