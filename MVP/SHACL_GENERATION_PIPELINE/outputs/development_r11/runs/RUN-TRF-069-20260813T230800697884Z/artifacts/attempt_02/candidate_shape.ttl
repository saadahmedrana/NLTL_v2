@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF069Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ice class is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Propeller type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:pitchType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Pitch type is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Applicable propulsion machinery shall record maximum ice torque and a typed design condition covering the prescribed service-life load scope." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:propellerType ?propellerType ;
          nltl:pitchType ?pitchType .

    FILTER (
        ?iceClass IN (
            nltl:iceClassIaSuper,
            nltl:iceClassIa,
            nltl:iceClassIb,
            nltl:iceClassIc
        )
        && ?propellerType IN ("open", "ducted")
        && ?pitchType IN ("controllable", "fixed")
    )

    FILTER NOT EXISTS {
        $this nltl:maximumIceTorque ?torque ;
              nltl:hasDesignCondition ?condition .

        ?torque a qudt:QuantityValue ;
                qudt:numericValue ?torqueValue ;
                qudt:unit unit:KiloN-M .

        ?condition a nltl:designCondition ;
                   nltl:normalOperationalConditions ?normal ;
                   nltl:normalServiceLifePropellerIceLoadCondition ?serviceLife ;
                   nltl:fixedPitchPropellerReversalLoadIncluded ?reversal ;
                   nltl:stoppedPropellerDraggingOutsideLoadModel ?draggingOutside ;
                   nltl:radialIceEntryOutsideLoadModel ?radialOutside .

        FILTER (
            datatype(?torqueValue) = xsd:decimal
            && datatype(?normal) = xsd:boolean
            && datatype(?serviceLife) = xsd:boolean
            && datatype(?reversal) = xsd:boolean
            && datatype(?draggingOutside) = xsd:boolean
            && datatype(?radialOutside) = xsd:boolean
            && ?normal = true
            && ?serviceLife = true
            && ?reversal = true
            && ?draggingOutside = true
            && ?radialOutside = true
        )
    }
}
"""
    ] .
