@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070ThrusterRequirementsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The main-propulsion-thruster applicability status must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:thrusterType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A main propulsion thruster must identify its thruster type."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "An azimuthing or fixed main propulsion thruster must provide the normal-operation design condition, service life, applicable ice loads and pressure in the required units, and a positive local-strength status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:mainPropulsionThruster ?main ;
                      nltl:thrusterType ?type .
                FILTER (
                    datatype(?main) = xsd:boolean &&
                    ?main = true &&
                    LCASE(STR(?type)) IN ("azimuthing", "fixed")
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasDesignCondition ?condition .
                        ?condition a nltl:designCondition ;
                                   nltl:normalOperationalConditions ?normal .
                        FILTER (
                            datatype(?normal) = xsd:boolean &&
                            ?normal = true
                        )
                    } ||
                    NOT EXISTS {
                        $this nltl:propellerIceInteractionLoad ?propellerLoad .
                        ?propellerLoad qudt:numericValue ?propellerValue ;
                                       qudt:unit unit:KiloN .
                        FILTER (datatype(?propellerValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:thrusterBodyIceInteractionLoad ?bodyLoad .
                        ?bodyLoad qudt:numericValue ?bodyValue ;
                                  qudt:unit unit:KiloN .
                        FILTER (datatype(?bodyValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:serviceLife ?serviceLife .
                        ?serviceLife qudt:numericValue ?serviceLifeValue ;
                                     qudt:unit unit:YR .
                        FILTER (datatype(?serviceLifeValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:extremeLoad ?extremeLoad .
                        ?extremeLoad qudt:numericValue ?extremeValue ;
                                     qudt:unit unit:KiloN .
                        FILTER (datatype(?extremeValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:localIcePressure ?localPressure .
                        ?localPressure qudt:numericValue ?pressureValue ;
                                       qudt:unit unit:MegaPA .
                        FILTER (datatype(?pressureValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        $this nltl:thrusterBodyLocalStrength ?strength .
                        FILTER (
                            datatype(?strength) = xsd:boolean &&
                            ?strength = true
                        )
                    }
                )
            }
        """
    ] .
