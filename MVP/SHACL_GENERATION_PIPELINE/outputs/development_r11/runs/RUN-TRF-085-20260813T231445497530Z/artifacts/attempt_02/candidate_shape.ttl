@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal numeric value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:M ) ;
        sh:message "The quantity unit must be metre."
    ] .

gen:RevolutionsPerMinuteQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A decimal numeric value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:REV-PER-MIN ) ;
        sh:message "The rotational-speed unit must be revolutions per minute."
    ] .

gen:Table6Dash9LookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The Table 6-9 lookup must be recorded as applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:in ( nltl:traficomTable6Dash9 ) ;
        sh:message "The lookup must reference TRAFICOM Table 6-9."
    ] ;
    sh:property [
        sh:path nltl:lookupInputQuantity ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The lookup case requires a propeller-diameter input in metres."
    ] ;
    sh:property [
        sh:path nltl:lookupResultQuantity ;
        sh:minCount 1 ;
        sh:node gen:RevolutionsPerMinuteQuantityShape ;
        sh:message "The lookup case requires a rotational-speed result in revolutions per minute."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Evidence for the Table 6-9 selection is required."
    ] .

gen:TRF085Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The known-speed alternative requires a true known-speed state."
            ] ;
            sh:property [
                sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
                sh:minCount 1 ;
                sh:node gen:RevolutionsPerMinuteQuantityShape ;
                sh:message "The known bollard-condition propeller speed at MCR is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:bollardPropellerSpeedKnown ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "The Table 6-9 alternative requires a false known-speed state."
            ] ;
            sh:property [
                sh:path nltl:propellerDiameter ;
                sh:minCount 1 ;
                sh:node gen:MetreQuantityShape ;
                sh:message "Propeller diameter in metres is required for the Table 6-9 lookup."
            ] ;
            sh:property [
                sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
                sh:minCount 1 ;
                sh:node gen:RevolutionsPerMinuteQuantityShape ;
                sh:message "The selected Table 6-9 rotational speed is required."
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:qualifiedValueShape gen:Table6Dash9LookupCaseShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "A complete TRAFICOM Table 6-9 lookup case is required."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The same Table 6-9 lookup case must pair the ship's propeller diameter with its selected rotational speed." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:bollardPropellerSpeedKnown false ;
          nltl:propellerDiameter ?diameter ;
          nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed .

    ?diameter qudt:numericValue ?diameterValue ;
              qudt:unit unit:M .
    ?speed qudt:numericValue ?speedValue ;
           qudt:unit unit:REV-PER-MIN .

    FILTER NOT EXISTS {
        $this nltl:hasTableLookupCase ?case .

        ?case nltl:tableLookupApplied true ;
              nltl:tableReference nltl:traficomTable6Dash9 ;
              nltl:lookupInputQuantity ?input ;
              nltl:lookupResultQuantity ?result ;
              nltl:lookupSelectionEvidence ?evidence .

        ?input qudt:numericValue ?inputValue ;
               qudt:unit unit:M .
        ?result qudt:numericValue ?resultValue ;
                qudt:unit unit:REV-PER-MIN .

        FILTER (
            ABS(xsd:decimal(?inputValue) - xsd:decimal(?diameterValue))
                <= IF(
                    ABS(xsd:decimal(?diameterValue)) * 0.000001 > 0.000000001,
                    ABS(xsd:decimal(?diameterValue)) * 0.000001,
                    0.000000001
                )
            &&
            ABS(xsd:decimal(?speedValue) - xsd:decimal(?resultValue))
                <= IF(
                    ABS(xsd:decimal(?resultValue)) * 0.000001 > 0.000000001,
                    ABS(xsd:decimal(?resultValue)) * 0.000001,
                    0.000000001
                )
        )
    }
}
"""
            ]
        ]
    ) .
