@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF114ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceBlock ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The design ice block used for the thruster impact assessment is required."
    ] ;
    sh:property [
        sh:path nltl:iceOperatingSpeed ;
        sh:minCount 1 ;
        sh:node gen:KnotSpeedQuantityShape ;
        sh:message "The ice operating speed is required in knots."
    ] ;
    sh:property [
        sh:path nltl:contactGeometry ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Exactly one contact geometry must be stated."
    ] ;
    sh:property [
        sh:path nltl:hasThrusterIceImpactLoadCase ;
        sh:minCount 1 ;
        sh:class nltl:thrusterIceImpactLoadCase ;
        sh:node gen:TRF114LoadCaseShape ;
        sh:message "A complete thruster ice impact load case is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:contactGeometry ;
                sh:hasValue "hemispherical"^^xsd:string
            ]
        ]
        [
            sh:property [
                sh:path nltl:equivalentImpactSphereRadius ;
                sh:minCount 1 ;
                sh:node gen:MetreLengthQuantityShape ;
                sh:message "A non-hemispherical contact geometry requires an equivalent impact sphere radius in metres."
            ] ;
            sh:property [
                sh:path nltl:hasThrusterIceImpactLoadCase ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:contactGeometryCorrespondenceEvidence ;
                        sh:minCount 1 ;
                        sh:class nltl:evidenceArtifact ;
                        sh:message "A non-hemispherical contact geometry requires correspondence evidence for each impact load case."
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Thruster resistance capacity must not be less than the impact load or impact demand for the same load case and thruster body." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasThrusterIceImpactLoadCase ?case .
    ?case nltl:thrusterImpactCaseAppliesToBody ?body ;
          nltl:thrusterIceImpactLoad ?load ;
          nltl:thrusterIceImpactDemand ?demand .
    ?body nltl:thrusterResistanceCapacity ?capacity .
    ?load qudt:numericValue ?loadValue .
    ?demand qudt:numericValue ?demandValue .
    ?capacity qudt:numericValue ?capacityValue .
    FILTER (
        xsd:decimal(?capacityValue) < xsd:decimal(?loadValue) ||
        xsd:decimal(?capacityValue) < xsd:decimal(?demandValue)
    )
}
"""
    ] .

gen:TRF114LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:thrusterIceImpactLoadCase ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoad ;
        sh:minCount 1 ;
        sh:node gen:KilonewtonForceQuantityShape ;
        sh:message "The thruster ice impact load is required in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactDemand ;
        sh:minCount 1 ;
        sh:node gen:KilonewtonForceQuantityShape ;
        sh:message "The thruster ice impact demand is required in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoadedAreaEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Loaded-area evidence is required for the thruster ice impact load case."
    ] ;
    sh:property [
        sh:path nltl:thrusterImpactCaseAppliesToBody ;
        sh:minCount 1 ;
        sh:class nltl:thrusterBody ;
        sh:node gen:TRF114ThrusterBodyShape ;
        sh:message "The impact load case must identify the applicable thruster body."
    ] .

gen:TRF114ThrusterBodyShape
    a sh:NodeShape ;
    sh:class nltl:thrusterBody ;
    sh:property [
        sh:path nltl:thrusterResistanceCapacity ;
        sh:minCount 1 ;
        sh:node gen:KilonewtonForceQuantityShape ;
        sh:message "The thruster body resistance capacity is required in kilonewtons."
    ] .

gen:KnotSpeedQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:KN )
    ] .

gen:MetreLengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:M )
    ] .

gen:KilonewtonForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:KiloN )
    ] .
