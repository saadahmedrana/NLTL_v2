@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:I2_015_BowSubregionCaseShape
    ] ;
    sh:sparql [
        sh:message "An applicable bow subregion case requires the available formula operands and their prescribed units on the ship, case, and shared failure-class-factor lookup case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?case
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                      nltl:i231vBowFormApplicability .
                FILTER (
                    NOT EXISTS {
                        $this nltl:upperIceWaterlineLengthLUI ?luiQuantity .
                        ?luiQuantity qudt:numericValue ?lui ;
                                     qudt:unit unit:M .
                        FILTER (DATATYPE(?lui) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:betaIPrime ?betaQuantity .
                        ?betaQuantity qudt:numericValue ?beta ;
                                      qudt:unit unit:UNITLESS .
                        FILTER (DATATYPE(?beta) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:bowSubregionMidLengthPosition ?xQuantity .
                        ?xQuantity qudt:numericValue ?x ;
                                   qudt:unit unit:M .
                        FILTER (DATATYPE(?x) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:bowSubregionWaterlineAngle ?alphaQuantity .
                        ?alphaQuantity qudt:numericValue ?alpha ;
                                       qudt:unit unit:DEG .
                        FILTER (DATATYPE(?alpha) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:bowShapeCoefficient ?resultQuantity .
                        ?resultQuantity qudt:numericValue ?result ;
                                        qudt:unit unit:UNITLESS .
                        FILTER (DATATYPE(?result) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?case nltl:hasFailureClassFactorLookupCase ?lookup .
                        ?lookup nltl:flexuralFailureClassFactor ?cffQuantity ;
                                nltl:crushingFailureClassFactor ?cfcQuantity .
                        ?cffQuantity qudt:numericValue ?cff ;
                                     qudt:unit unit:UNITLESS .
                        ?cfcQuantity qudt:numericValue ?cfc ;
                                     qudt:unit unit:UNITLESS .
                        FILTER (
                            DATATYPE(?cff) = xsd:decimal
                            &&
                            DATATYPE(?cfc) = xsd:decimal
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an applicable bow form, bowShapeCoefficient must not exceed 0.60 within a relative tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?case ?result
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                          nltl:i231vBowFormApplicability ;
                      nltl:bowShapeCoefficient ?resultQuantity .
                ?resultQuantity qudt:numericValue ?result ;
                                qudt:unit unit:UNITLESS .
                FILTER (
                    DATATYPE(?result) = xsd:decimal
                    &&
                    ?result > "0.6000006"^^xsd:decimal
                )
            }
        """
    ] .

gen:I2_015_BowSubregionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:I2_015_FailureClassFactorLookupShape
    ] .

gen:I2_015_FailureClassFactorLookupShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gen:UnitlessQuantityShape
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .
