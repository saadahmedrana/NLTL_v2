@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_015_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each applicable bow-subregion case requires decimal formula operands and result in their prescribed units, linked through one failure-class-factor lookup case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                    nltl:i231vBowFormApplicability .
                FILTER NOT EXISTS {
                    $this
                        nltl:betaIPrime ?betaQuantity ;
                        nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                        nltl:upperIceWaterlineDraughtDUI ?draughtQuantity .
                    ?betaQuantity
                        qudt:numericValue ?beta ;
                        qudt:unit unit:UNITLESS .
                    ?lengthQuantity
                        qudt:numericValue ?length ;
                        qudt:unit unit:M .
                    ?draughtQuantity
                        qudt:numericValue ?draught ;
                        qudt:unit unit:M .

                    ?case
                        nltl:bowSubregionMidLengthPosition ?positionQuantity ;
                        nltl:bowSubregionWaterlineAngle ?angleQuantity ;
                        nltl:bowShapeCoefficient ?coefficientQuantity ;
                        nltl:hasFailureClassFactorLookupCase ?lookupCase .
                    ?positionQuantity
                        qudt:numericValue ?position ;
                        qudt:unit unit:M .
                    ?angleQuantity
                        qudt:numericValue ?angle ;
                        qudt:unit unit:DEG .
                    ?coefficientQuantity
                        qudt:numericValue ?coefficient ;
                        qudt:unit unit:UNITLESS .

                    ?lookupCase
                        nltl:flexuralFailureClassFactor ?flexuralQuantity ;
                        nltl:crushingFailureClassFactor ?crushingQuantity .
                    ?flexuralQuantity
                        qudt:numericValue ?flexural ;
                        qudt:unit unit:UNITLESS .
                    ?crushingQuantity
                        qudt:numericValue ?crushing ;
                        qudt:unit unit:UNITLESS .

                    FILTER (
                        datatype(?beta) = xsd:decimal &&
                        datatype(?length) = xsd:decimal &&
                        datatype(?draught) = xsd:decimal &&
                        datatype(?position) = xsd:decimal &&
                        datatype(?angle) = xsd:decimal &&
                        datatype(?coefficient) = xsd:decimal &&
                        datatype(?flexural) = xsd:decimal &&
                        datatype(?crushing) = xsd:decimal &&
                        ?length != 0 &&
                        ?beta > 0 &&
                        ?draught > 0 &&
                        ?crushing != 0
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an I2.3.1(v) bow case, bowShapeCoefficient must equal min(f_ai1, f_ai2, 0.60), using relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this
                    nltl:hasBowSubregionCalculationCase ?case ;
                    nltl:betaIPrime ?betaQuantity ;
                    nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                    nltl:upperIceWaterlineDraughtDUI ?draughtQuantity .
                ?case
                    nltl:bowFormApplicabilityClassification
                        nltl:i231vBowFormApplicability ;
                    nltl:bowSubregionMidLengthPosition ?positionQuantity ;
                    nltl:bowSubregionWaterlineAngle ?angleQuantity ;
                    nltl:bowShapeCoefficient ?coefficientQuantity ;
                    nltl:hasFailureClassFactorLookupCase ?lookupCase .
                ?lookupCase
                    nltl:flexuralFailureClassFactor ?flexuralQuantity ;
                    nltl:crushingFailureClassFactor ?crushingQuantity .

                ?betaQuantity
                    qudt:numericValue ?beta ;
                    qudt:unit unit:UNITLESS .
                ?lengthQuantity
                    qudt:numericValue ?length ;
                    qudt:unit unit:M .
                ?draughtQuantity
                    qudt:numericValue ?draught ;
                    qudt:unit unit:M .
                ?positionQuantity
                    qudt:numericValue ?position ;
                    qudt:unit unit:M .
                ?angleQuantity
                    qudt:numericValue ?angle ;
                    qudt:unit unit:DEG .
                ?coefficientQuantity
                    qudt:numericValue ?reported ;
                    qudt:unit unit:UNITLESS .
                ?flexuralQuantity
                    qudt:numericValue ?flexural ;
                    qudt:unit unit:UNITLESS .
                ?crushingQuantity
                    qudt:numericValue ?crushing ;
                    qudt:unit unit:UNITLESS .

                FILTER (
                    datatype(?beta) = xsd:decimal &&
                    datatype(?length) = xsd:decimal &&
                    datatype(?draught) = xsd:decimal &&
                    datatype(?position) = xsd:decimal &&
                    datatype(?angle) = xsd:decimal &&
                    datatype(?reported) = xsd:decimal &&
                    datatype(?flexural) = xsd:decimal &&
                    datatype(?crushing) = xsd:decimal &&
                    ?length != 0 &&
                    ?beta > 0 &&
                    ?draught > 0 &&
                    ?crushing != 0 &&
                    math:sin(?beta) != 0
                )

                BIND (
                    (0.097 - 0.68 * ((?position / ?length) - 0.15) *
                    ((?position / ?length) - 0.15)) * ?angle
                    AS ?n
                )
                BIND (
                    1.2 * ?flexural /
                    (math:sin(?beta) * ?crushing)
                    AS ?k
                )

                BIND (?n * ?n AS ?n2)
                BIND (?n2 * ?n2 AS ?n4)
                BIND (?n4 * ?n4 AS ?n8)
                BIND (?n8 * ?n8 AS ?n16)
                BIND (?n16 * ?n16 AS ?n32)
                BIND (?n32 * ?n16 * ?n2 AS ?n50)

                BIND (?k * ?k AS ?k2)
                BIND (?k2 * ?k2 AS ?k4)
                BIND (?k4 * ?k4 AS ?k8)
                BIND (?k8 * ?k8 AS ?k16)
                BIND (?k16 * ?k8 * ?k AS ?k25)
                BIND (?k25 * ?k25 AS ?k50)

                BIND (?beta * ?beta AS ?beta2)
                BIND (?beta2 * ?beta2 AS ?beta4)
                BIND (?beta4 * ?beta4 AS ?beta8)
                BIND (?beta8 * ?beta8 AS ?beta16)
                BIND (?beta16 * ?beta8 * ?beta AS ?beta25)

                BIND (?draught * ?draught AS ?d2)
                BIND (?d2 * ?d2 AS ?d4)
                BIND (?d4 * ?d4 AS ?d8)
                BIND (?d8 * ?d8 AS ?d16)
                BIND (?d16 * ?d16 AS ?d32)

                BIND (?reported * ?reported AS ?r2)
                BIND (?r2 * ?r2 AS ?r4)
                BIND (?r4 * ?r4 AS ?r8)
                BIND (?r8 * ?r8 AS ?r16)
                BIND (?r16 * ?r16 AS ?r32)
                BIND (?r32 * ?r16 * ?r2 AS ?r50)

                BIND (?n50 * ?d32 AS ?f1Magnitude50)
                BIND (?k50 * ?beta25 AS ?f2Magnitude50)

                BIND (
                    IF(
                        ?n < 0 && ?k >= 0,
                        true,
                        IF(
                            ?n >= 0 && ?k < 0,
                            false,
                            IF(
                                ?n >= 0,
                                ?f1Magnitude50 <= ?f2Magnitude50,
                                ?f1Magnitude50 >= ?f2Magnitude50
                            )
                        )
                    )
                    AS ?f1LeF2
                )
                BIND (
                    IF(
                        ?n < 0 && ?k >= 0,
                        false,
                        IF(
                            ?n >= 0 && ?k < 0,
                            true,
                            IF(
                                ?n >= 0,
                                ?f2Magnitude50 <= ?f1Magnitude50,
                                ?f2Magnitude50 >= ?f1Magnitude50
                            )
                        )
                    )
                    AS ?f2LeF1
                )

                BIND (
                    (?n < 0 || ?n2 <= 0.36 * ?beta)
                    AS ?f1LeCeiling
                )
                BIND (
                    (?k < 0 || ?k25 <=
                        0.00000284302880299296701512019968 * ?d16)
                    AS ?f2LeCeiling
                )
                BIND (
                    (?n >= 0 && ?n2 >= 0.36 * ?beta)
                    AS ?ceilingLeF1
                )
                BIND (
                    (?k >= 0 && ?k25 >=
                        0.00000284302880299296701512019968 * ?d16)
                    AS ?ceilingLeF2
                )

                BIND (
                    (
                        (?reported = 0 && ?n = 0) ||
                        (
                            (?reported > 0 && ?n > 0) ||
                            (?reported < 0 && ?n < 0)
                        ) &&
                        (
                            (
                                ?r2 * ?beta >=
                                    ?n2 * 0.999998000001 &&
                                ?r2 * ?beta <=
                                    ?n2 * 1.000002000001
                            ) ||
                            (
                                (ABS(?reported) - 0.000000001 <= 0 ||
                                 (ABS(?reported) - 0.000000001) *
                                 (ABS(?reported) - 0.000000001) *
                                 ?beta <= ?n2) &&
                                ?n2 <=
                                    (ABS(?reported) + 0.000000001) *
                                    (ABS(?reported) + 0.000000001) *
                                    ?beta
                            )
                        )
                    )
                    AS ?matchesF1
                )

                BIND (
                    IF(
                        ABS(?reported) > 0.000000001,
                        ABS(?reported) - 0.000000001,
                        0
                    )
                    AS ?rLow
                )
                BIND (
                    ABS(?reported) + 0.000000001
                    AS ?rHigh
                )
                BIND (?rLow * ?rLow AS ?rl2)
                BIND (?rl2 * ?rl2 AS ?rl4)
                BIND (?rl4 * ?rl4 AS ?rl8)
                BIND (?rl8 * ?rl8 AS ?rl16)
                BIND (?rl16 * ?rl16 AS ?rl32)
                BIND (?rl32 * ?rl16 * ?rl2 AS ?rl50)
                BIND (?rHigh * ?rHigh AS ?rh2)
                BIND (?rh2 * ?rh2 AS ?rh4)
                BIND (?rh4 * ?rh4 AS ?rh8)
                BIND (?rh8 * ?rh8 AS ?rh16)
                BIND (?rh16 * ?rh16 AS ?rh32)
                BIND (?rh32 * ?rh16 * ?rh2 AS ?rh50)

                BIND (
                    (
                        (?reported = 0 && ?k = 0) ||
                        (
                            (?reported > 0 && ?k > 0) ||
                            (?reported < 0 && ?k < 0)
                        ) &&
                        (
                            (
                                ?r50 * ?d32 >=
                                    ?k50 * 0.999950001224980400230297760183 &&
                                ?r50 * ?d32 <=
                                    ?k50 * 1.000050001225019600230302240184
                            ) ||
                            (
                                ?rl50 * ?d32 <= ?k50 &&
                                ?k50 <= ?rh50 * ?d32
                            )
                        )
                    )
                    AS ?matchesF2
                )

                BIND (
                    ABS(?reported - 0.60) <= 0.0000006
                    AS ?matchesCeiling
                )

                FILTER (
                    !(
                        (?f1LeF2 && ?f1LeCeiling && ?matchesF1) ||
                        (?f2LeF1 && ?f2LeCeiling && ?matchesF2) ||
                        (?ceilingLeF1 && ?ceilingLeF2 && ?matchesCeiling)
                    )
                )
            }
        """
    ] .
