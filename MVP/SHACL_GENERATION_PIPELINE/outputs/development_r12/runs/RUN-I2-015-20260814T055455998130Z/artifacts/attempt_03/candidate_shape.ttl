@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_015_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each applicable bow-subregion case must have complete, correctly unitized formula inputs, a linked failure-class lookup case, and a reported bow shape coefficient." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case .
                ?case nltl:bowFormApplicabilityClassification
                    nltl:i231vBowFormApplicability .
                FILTER NOT EXISTS {
                    $this nltl:upperIceWaterlineLengthLUI ?luiQuantity ;
                          nltl:upperIceWaterlineDraughtDUI ?duiQuantity ;
                          nltl:betaIPrime ?betaQuantity .
                    ?case nltl:bowSubregionMidLengthPosition ?xQuantity ;
                          nltl:bowSubregionWaterlineAngle ?alphaQuantity ;
                          nltl:bowShapeCoefficient ?reportedQuantity ;
                          nltl:hasFailureClassFactorLookupCase ?lookupCase .
                    ?lookupCase nltl:flexuralFailureClassFactor ?cffQuantity ;
                                nltl:crushingFailureClassFactor ?cfcQuantity .

                    ?luiQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?lui ;
                                 qudt:unit unit:M .
                    ?duiQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?dui ;
                                 qudt:unit unit:M .
                    ?betaQuantity a qudt:QuantityValue ;
                                  qudt:numericValue ?beta ;
                                  qudt:unit unit:UNITLESS .
                    ?xQuantity a qudt:QuantityValue ;
                               qudt:numericValue ?x ;
                               qudt:unit unit:M .
                    ?alphaQuantity a qudt:QuantityValue ;
                                   qudt:numericValue ?alpha ;
                                   qudt:unit unit:DEG .
                    ?reportedQuantity a qudt:QuantityValue ;
                                      qudt:numericValue ?reported ;
                                      qudt:unit unit:UNITLESS .
                    ?cffQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?cff ;
                                 qudt:unit unit:UNITLESS .
                    ?cfcQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?cfc ;
                                 qudt:unit unit:UNITLESS .

                    FILTER (
                        datatype(?lui) = xsd:decimal &&
                        datatype(?dui) = xsd:decimal &&
                        datatype(?beta) = xsd:decimal &&
                        datatype(?x) = xsd:decimal &&
                        datatype(?alpha) = xsd:decimal &&
                        datatype(?reported) = xsd:decimal &&
                        datatype(?cff) = xsd:decimal &&
                        datatype(?cfc) = xsd:decimal &&
                        ?lui != 0 &&
                        ?dui > 0 &&
                        ?beta > 0 &&
                        ?cfc != 0 &&
                        math:sin(?beta) != 0
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For an applicable bow-subregion case, bowShapeCoefficient must equal min(f_ai1, f_ai2, 0.60) within the required numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasBowSubregionCalculationCase ?case ;
                      nltl:upperIceWaterlineLengthLUI ?luiQuantity ;
                      nltl:upperIceWaterlineDraughtDUI ?duiQuantity ;
                      nltl:betaIPrime ?betaQuantity .
                ?case nltl:bowFormApplicabilityClassification
                          nltl:i231vBowFormApplicability ;
                      nltl:bowSubregionMidLengthPosition ?xQuantity ;
                      nltl:bowSubregionWaterlineAngle ?alphaQuantity ;
                      nltl:bowShapeCoefficient ?reportedQuantity ;
                      nltl:hasFailureClassFactorLookupCase ?lookupCase .
                ?lookupCase nltl:flexuralFailureClassFactor ?cffQuantity ;
                            nltl:crushingFailureClassFactor ?cfcQuantity .

                ?luiQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?lui ;
                             qudt:unit unit:M .
                ?duiQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?dui ;
                             qudt:unit unit:M .
                ?betaQuantity a qudt:QuantityValue ;
                              qudt:numericValue ?beta ;
                              qudt:unit unit:UNITLESS .
                ?xQuantity a qudt:QuantityValue ;
                           qudt:numericValue ?x ;
                           qudt:unit unit:M .
                ?alphaQuantity a qudt:QuantityValue ;
                               qudt:numericValue ?alpha ;
                               qudt:unit unit:DEG .
                ?reportedQuantity a qudt:QuantityValue ;
                                  qudt:numericValue ?reported ;
                                  qudt:unit unit:UNITLESS .
                ?cffQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?cff ;
                             qudt:unit unit:UNITLESS .
                ?cfcQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?cfc ;
                             qudt:unit unit:UNITLESS .

                FILTER (
                    datatype(?lui) = xsd:decimal &&
                    datatype(?dui) = xsd:decimal &&
                    datatype(?beta) = xsd:decimal &&
                    datatype(?x) = xsd:decimal &&
                    datatype(?alpha) = xsd:decimal &&
                    datatype(?reported) = xsd:decimal &&
                    datatype(?cff) = xsd:decimal &&
                    datatype(?cfc) = xsd:decimal &&
                    ?lui != 0 &&
                    ?dui > 0 &&
                    ?beta > 0 &&
                    ?cfc != 0 &&
                    math:sin(?beta) != 0
                )

                BIND(
                    (
                        0.097 -
                        0.68 * ((?x / ?lui) - 0.15) * ((?x / ?lui) - 0.15)
                    ) * ?alpha / math:pow(?beta, 0.5)
                    AS ?fai1
                )
                BIND(
                    1.2 * ?cff /
                    (
                        math:sin(?beta) *
                        ?cfc *
                        math:pow(?dui, 0.64)
                    )
                    AS ?fai2
                )
                BIND(
                    IF(
                        ?fai1 <= ?fai2 && ?fai1 <= 0.60,
                        ?fai1,
                        IF(?fai2 <= 0.60, ?fai2, 0.60)
                    )
                    AS ?expected
                )
                BIND(
                    IF(
                        0.000001 * ABS(?expected) > 0.000000001,
                        0.000001 * ABS(?expected),
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?reported - ?expected) > ?tolerance)
            }
        """
    ] .
