@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_022_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:class nltl:plating ;
        sh:node [
            sh:property [
                sh:path nltl:platingHullAreaClassification ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI
            ] ;
            sh:property [
                sh:path nltl:framingAngleOmega ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:hasValue unit:DEG
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Applicable plating requires the linked structural member, formula operands, result value, and prescribed units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasPlating ?plating .
                ?plating nltl:platingHullAreaClassification ?area ;
                         nltl:framingAngleOmega ?omegaQuantity .
                ?omegaQuantity qudt:numericValue ?omega ;
                               qudt:unit unit:DEG .
                FILTER(
                    ?area IN (
                        nltl:bowIntermediateBottomHullArea,
                        nltl:midbodyBottomHullArea,
                        nltl:sternBottomHullArea
                    )
                    && datatype(?omega) = xsd:decimal
                    && ?omega >= 70
                )
                FILTER NOT EXISTS {
                    ?plating nltl:platingSupportedByStructuralMember ?member ;
                             nltl:iceLoadRequiredNetPlateThickness ?thicknessQuantity .
                    ?member nltl:frameSpacing ?spacingQuantity ;
                            nltl:selectedHullAreaFactor ?areaFactorQuantity .
                    $this nltl:peakPressureFactor ?peakFactorQuantity ;
                          nltl:averageIcePressure ?averagePressureQuantity ;
                          nltl:yieldStrength ?yieldStrengthQuantity ;
                          nltl:loadPatchHeight ?patchHeightQuantity .
                    ?thicknessQuantity qudt:numericValue ?thickness ;
                                       qudt:unit unit:MilliM .
                    ?spacingQuantity qudt:numericValue ?spacing ;
                                     qudt:unit unit:M .
                    ?areaFactorQuantity qudt:numericValue ?areaFactor ;
                                        qudt:unit unit:UNITLESS .
                    ?peakFactorQuantity qudt:numericValue ?peakFactor ;
                                        qudt:unit unit:UNITLESS .
                    ?averagePressureQuantity qudt:numericValue ?averagePressure ;
                                             qudt:unit unit:MegaPA .
                    ?yieldStrengthQuantity qudt:numericValue ?yieldStrength ;
                                           qudt:unit unit:MegaPA .
                    ?patchHeightQuantity qudt:numericValue ?patchHeight ;
                                         qudt:unit unit:M .
                    FILTER(
                        datatype(?thickness) = xsd:decimal
                        && datatype(?spacing) = xsd:decimal
                        && datatype(?areaFactor) = xsd:decimal
                        && datatype(?peakFactor) = xsd:decimal
                        && datatype(?averagePressure) = xsd:decimal
                        && datatype(?yieldStrength) = xsd:decimal
                        && datatype(?patchHeight) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable plating has inputs outside the mathematical domain of the net-thickness formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasPlating ?plating ;
                      nltl:peakPressureFactor ?peakFactorQuantity ;
                      nltl:averageIcePressure ?averagePressureQuantity ;
                      nltl:yieldStrength ?yieldStrengthQuantity ;
                      nltl:loadPatchHeight ?patchHeightQuantity .
                ?plating nltl:platingHullAreaClassification ?area ;
                         nltl:framingAngleOmega ?omegaQuantity ;
                         nltl:platingSupportedByStructuralMember ?member .
                ?member nltl:frameSpacing ?spacingQuantity ;
                        nltl:selectedHullAreaFactor ?areaFactorQuantity .
                ?omegaQuantity qudt:numericValue ?omega ;
                               qudt:unit unit:DEG .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?areaFactorQuantity qudt:numericValue ?areaFactor ;
                                    qudt:unit unit:UNITLESS .
                ?peakFactorQuantity qudt:numericValue ?peakFactor ;
                                    qudt:unit unit:UNITLESS .
                ?averagePressureQuantity qudt:numericValue ?averagePressure ;
                                         qudt:unit unit:MegaPA .
                ?yieldStrengthQuantity qudt:numericValue ?yieldStrength ;
                                       qudt:unit unit:MegaPA .
                ?patchHeightQuantity qudt:numericValue ?patchHeight ;
                                     qudt:unit unit:M .
                FILTER(
                    ?area IN (
                        nltl:bowIntermediateBottomHullArea,
                        nltl:midbodyBottomHullArea,
                        nltl:sternBottomHullArea
                    )
                    && datatype(?omega) = xsd:decimal
                    && datatype(?spacing) = xsd:decimal
                    && datatype(?areaFactor) = xsd:decimal
                    && datatype(?peakFactor) = xsd:decimal
                    && datatype(?averagePressure) = xsd:decimal
                    && datatype(?yieldStrength) = xsd:decimal
                    && datatype(?patchHeight) = xsd:decimal
                    && ?omega >= 70
                    && (
                        ?spacing < 0
                        || ?patchHeight <= 0
                        || ?yieldStrength <= 0
                        || (?areaFactor * ?peakFactor * ?averagePressure) < 0
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Net plate thickness must satisfy the I2.4.2 formula within relative tolerance 1e-6, with an absolute fallback of 1e-9 mm near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasPlating ?plating ;
                      nltl:peakPressureFactor ?peakFactorQuantity ;
                      nltl:averageIcePressure ?averagePressureQuantity ;
                      nltl:yieldStrength ?yieldStrengthQuantity ;
                      nltl:loadPatchHeight ?patchHeightQuantity .
                ?plating nltl:platingHullAreaClassification ?area ;
                         nltl:framingAngleOmega ?omegaQuantity ;
                         nltl:platingSupportedByStructuralMember ?member ;
                         nltl:iceLoadRequiredNetPlateThickness ?thicknessQuantity .
                ?member nltl:frameSpacing ?spacingQuantity ;
                        nltl:selectedHullAreaFactor ?areaFactorQuantity .
                ?omegaQuantity qudt:numericValue ?omega ;
                               qudt:unit unit:DEG .
                ?thicknessQuantity qudt:numericValue ?thickness ;
                                   qudt:unit unit:MilliM .
                ?spacingQuantity qudt:numericValue ?spacing ;
                                 qudt:unit unit:M .
                ?areaFactorQuantity qudt:numericValue ?areaFactor ;
                                    qudt:unit unit:UNITLESS .
                ?peakFactorQuantity qudt:numericValue ?peakFactor ;
                                    qudt:unit unit:UNITLESS .
                ?averagePressureQuantity qudt:numericValue ?averagePressure ;
                                         qudt:unit unit:MegaPA .
                ?yieldStrengthQuantity qudt:numericValue ?yieldStrength ;
                                       qudt:unit unit:MegaPA .
                ?patchHeightQuantity qudt:numericValue ?patchHeight ;
                                     qudt:unit unit:M .
                FILTER(
                    ?area IN (
                        nltl:bowIntermediateBottomHullArea,
                        nltl:midbodyBottomHullArea,
                        nltl:sternBottomHullArea
                    )
                    && datatype(?omega) = xsd:decimal
                    && datatype(?thickness) = xsd:decimal
                    && datatype(?spacing) = xsd:decimal
                    && datatype(?areaFactor) = xsd:decimal
                    && datatype(?peakFactor) = xsd:decimal
                    && datatype(?averagePressure) = xsd:decimal
                    && datatype(?yieldStrength) = xsd:decimal
                    && datatype(?patchHeight) = xsd:decimal
                    && ?omega >= 70
                    && ?spacing >= 0
                    && ?patchHeight > 0
                    && ?yieldStrength > 0
                    && (?areaFactor * ?peakFactor * ?averagePressure) >= 0
                )
                BIND(
                    1 + (?spacing / (2 * ?patchHeight))
                    AS ?denominator
                )
                BIND(
                    ((500 * ?spacing) / ?denominator)
                    * ((500 * ?spacing) / ?denominator)
                    * ((?areaFactor * ?peakFactor * ?averagePressure) / ?yieldStrength)
                    AS ?expectedSquared
                )
                FILTER(
                    ?thickness < 0
                    || (
                        ?expectedSquared > 0.000000000000000001
                        && (
                            (?thickness * ?thickness)
                                < (?expectedSquared * 0.999999 * 0.999999)
                            || (?thickness * ?thickness)
                                > (?expectedSquared * 1.000001 * 1.000001)
                        )
                    )
                    || (
                        ?expectedSquared <= 0.000000000000000001
                        && ABS(?thickness) > 0.000000001
                    )
                )
            }
        """
    ] .
