@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:I2_030_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A linked local-frame section calculation case, structural member, and plating are required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER NOT EXISTS {
        $this nltl:hasStructuralMember ?member ;
              nltl:hasPlating ?plating ;
              nltl:hasCalculationCase ?case .
        ?member a nltl:structuralMember ;
                nltl:hasLocalFrameSectionCalculationCase ?case .
        ?plating a nltl:plating .
        ?case a nltl:calculationCase ;
              a nltl:localFrameSectionCalculationCase ;
              nltl:sectionCalculationCaseStructuralMember ?member ;
              nltl:sectionCalculationCasePlating ?plating .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each linked local-frame section calculation case must use the same linked structural member and plating." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case .
    FILTER NOT EXISTS {
        $this nltl:hasCalculationCase ?case ;
              nltl:hasPlating ?plating .
        ?member a nltl:structuralMember .
        ?plating a nltl:plating .
        ?case a nltl:calculationCase ;
              a nltl:localFrameSectionCalculationCase ;
              nltl:sectionCalculationCaseStructuralMember ?member ;
              nltl:sectionCalculationCasePlating ?plating .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each calculation case requires decimal flange area, attached-plate thickness, frame spacing, and framing angle in the specified units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating .
    FILTER NOT EXISTS {
        ?member nltl:netLocalFrameFlangeArea ?afq ;
                nltl:netAttachedShellPlateThickness ?tpq ;
                nltl:frameSpacing ?sq .
        ?afq qudt:numericValue ?af ;
             qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
        ?tpq qudt:numericValue ?tp ;
             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        ?sq qudt:numericValue ?s ;
            qudt:unit <http://qudt.org/vocab/unit/M> .
        ?plating nltl:framingAngleOmega ?omegaq .
        ?omegaq qudt:numericValue ?omega ;
                qudt:unit <http://qudt.org/vocab/unit/DEG> .
        FILTER (
            datatype(?af) = xsd:decimal &&
            datatype(?tp) = xsd:decimal &&
            datatype(?s) = xsd:decimal &&
            datatype(?omega) = xsd:decimal
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "When the local-frame area exceeds the attached-plate-flange area, web height, nonzero web thickness, and plastic neutral-axis height are required in millimetres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case ;
            nltl:netLocalFrameFlangeArea ?afq ;
            nltl:netAttachedShellPlateThickness ?tpq ;
            nltl:frameSpacing ?sq .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating .
    ?afq qudt:numericValue ?af ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
    ?tpq qudt:numericValue ?tp ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?sq qudt:numericValue ?s ;
        qudt:unit <http://qudt.org/vocab/unit/M> .
    FILTER (
        datatype(?af) = xsd:decimal &&
        datatype(?tp) = xsd:decimal &&
        datatype(?s) = xsd:decimal &&
        ?af > (10.0 * ?tp * ?s)
    )
    FILTER NOT EXISTS {
        ?member nltl:webHeight ?hwq ;
                nltl:netWebThickness ?twq .
        ?hwq qudt:numericValue ?hw ;
             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        ?twq qudt:numericValue ?tw ;
             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        ?case nltl:plasticNeutralAxisHeight ?znaq .
        ?znaq qudt:numericValue ?zna ;
              qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        FILTER (
            datatype(?hw) = xsd:decimal &&
            datatype(?tw) = xsd:decimal &&
            datatype(?zna) = xsd:decimal &&
            ?tw != 0.0
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "The reported plastic neutral-axis height must agree with the I2.5.8 formula within relative tolerance 1e-6 or absolute tolerance 1e-9 mm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case ;
            nltl:netLocalFrameFlangeArea ?afq ;
            nltl:webHeight ?hwq ;
            nltl:netWebThickness ?twq ;
            nltl:netAttachedShellPlateThickness ?tpq ;
            nltl:frameSpacing ?sq .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating ;
          nltl:plasticNeutralAxisHeight ?znaq .
    ?afq qudt:numericValue ?af ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
    ?hwq qudt:numericValue ?hw ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?twq qudt:numericValue ?tw ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?tpq qudt:numericValue ?tp ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?sq qudt:numericValue ?s ;
        qudt:unit <http://qudt.org/vocab/unit/M> .
    ?znaq qudt:numericValue ?zna ;
          qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    FILTER (
        datatype(?af) = xsd:decimal &&
        datatype(?hw) = xsd:decimal &&
        datatype(?tw) = xsd:decimal &&
        datatype(?tp) = xsd:decimal &&
        datatype(?s) = xsd:decimal &&
        datatype(?zna) = xsd:decimal &&
        ?af > (10.0 * ?tp * ?s) &&
        ?tw != 0.0
    )
    BIND(
        ((100.0 * ?af + ?hw * ?tw - 1000.0 * ?tp * ?s) / (2.0 * ?tw))
        AS ?expectedZna
    )
    BIND(
        IF(
            ABS(?expectedZna) * 0.000001 > 0.000000001,
            ABS(?expectedZna) * 0.000001,
            0.000000001
        )
        AS ?tolerance
    )
    FILTER (ABS(?zna - ?expectedZna) > ?tolerance)
}
"""
    ] ;
    sh:sparql [
        sh:message "Outside the oblique-framing interpolation range, the direct section-modulus calculation requires the flange height, web angle, flange-centre distance, and reported result in their specified units." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case ;
            nltl:netLocalFrameFlangeArea ?afq ;
            nltl:netAttachedShellPlateThickness ?tpq ;
            nltl:frameSpacing ?sq .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating .
    ?plating nltl:framingAngleOmega ?omegaq .
    ?afq qudt:numericValue ?af ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
    ?tpq qudt:numericValue ?tp ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?sq qudt:numericValue ?s ;
        qudt:unit <http://qudt.org/vocab/unit/M> .
    ?omegaq qudt:numericValue ?omega ;
            qudt:unit <http://qudt.org/vocab/unit/DEG> .
    FILTER (
        datatype(?af) = xsd:decimal &&
        datatype(?tp) = xsd:decimal &&
        datatype(?s) = xsd:decimal &&
        datatype(?omega) = xsd:decimal &&
        ?af > (10.0 * ?tp * ?s) &&
        (?omega <= 20.0 || ?omega >= 70.0)
    )
    FILTER NOT EXISTS {
        ?member nltl:localFrameFlangeCentreHeight ?hfcq ;
                nltl:webAngleToShellPlate ?phiq ;
                nltl:webToFlangeCentreDistance ?bwq ;
                nltl:netEffectivePlasticSectionModulus ?zpq .
        ?hfcq qudt:numericValue ?hfc ;
              qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        ?phiq qudt:numericValue ?phi ;
              qudt:unit <http://qudt.org/vocab/unit/DEG> .
        ?bwq qudt:numericValue ?bw ;
             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
        ?zpq qudt:numericValue ?zp ;
             qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
        FILTER (
            datatype(?hfc) = xsd:decimal &&
            datatype(?phi) = xsd:decimal &&
            datatype(?bw) = xsd:decimal &&
            datatype(?zp) = xsd:decimal
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "The reported net effective plastic section modulus must agree with the direct I2.5.9 formula within relative tolerance 1e-6 or absolute tolerance 1e-9 cm3." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case ;
            nltl:netLocalFrameFlangeArea ?afq ;
            nltl:webHeight ?hwq ;
            nltl:netWebThickness ?twq ;
            nltl:netAttachedShellPlateThickness ?tpq ;
            nltl:frameSpacing ?sq ;
            nltl:localFrameFlangeCentreHeight ?hfcq ;
            nltl:webAngleToShellPlate ?phiq ;
            nltl:webToFlangeCentreDistance ?bwq ;
            nltl:netEffectivePlasticSectionModulus ?zpq .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating .
    ?plating nltl:framingAngleOmega ?omegaq .
    ?afq qudt:numericValue ?af ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
    ?hwq qudt:numericValue ?hw ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?twq qudt:numericValue ?tw ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?tpq qudt:numericValue ?tp ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?sq qudt:numericValue ?s ;
        qudt:unit <http://qudt.org/vocab/unit/M> .
    ?hfcq qudt:numericValue ?hfc ;
          qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?phiq qudt:numericValue ?phi ;
          qudt:unit <http://qudt.org/vocab/unit/DEG> .
    ?bwq qudt:numericValue ?bw ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?zpq qudt:numericValue ?zp ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
    ?omegaq qudt:numericValue ?omega ;
            qudt:unit <http://qudt.org/vocab/unit/DEG> .
    FILTER (
        datatype(?af) = xsd:decimal &&
        datatype(?hw) = xsd:decimal &&
        datatype(?tw) = xsd:decimal &&
        datatype(?tp) = xsd:decimal &&
        datatype(?s) = xsd:decimal &&
        datatype(?hfc) = xsd:decimal &&
        datatype(?phi) = xsd:decimal &&
        datatype(?bw) = xsd:decimal &&
        datatype(?zp) = xsd:decimal &&
        datatype(?omega) = xsd:decimal &&
        ?af > (10.0 * ?tp * ?s) &&
        ?tw != 0.0 &&
        (?omega <= 20.0 || ?omega >= 70.0)
    )
    BIND(
        ((100.0 * ?af + ?hw * ?tw - 1000.0 * ?tp * ?s) / (2.0 * ?tw))
        AS ?expectedZna
    )
    BIND((?phi * 0.017453292519943295) AS ?phiRadians)
    BIND(
        (
            ?tp * ?s * (?expectedZna + ?tp / 2.0) * math:sin(?phiRadians)
            +
            (
                (
                    ((?hw - ?expectedZna) * (?hw - ?expectedZna))
                    +
                    (?expectedZna * ?expectedZna)
                )
                * ?tw
                * math:sin(?phiRadians)
            ) / 2000.0
            +
            ?af
            *
            (
                (?hfc - ?expectedZna) * math:sin(?phiRadians)
                -
                ?bw * math:cos(?phiRadians)
            ) / 10.0
        )
        AS ?expectedZp
    )
    BIND(
        IF(
            ABS(?expectedZp) * 0.000001 > 0.000000001,
            ABS(?expectedZp) * 0.000001,
            0.000000001
        )
        AS ?tolerance
    )
    FILTER (ABS(?zp - ?expectedZp) > ?tolerance)
}
"""
    ] ;
    sh:sparql [
        sh:message "For 20 deg < Omega < 70 deg, linked 20-degree and 70-degree interpolation endpoints and a reported section modulus are required." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case ;
            nltl:netLocalFrameFlangeArea ?afq ;
            nltl:netAttachedShellPlateThickness ?tpq ;
            nltl:frameSpacing ?sq .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating .
    ?plating nltl:framingAngleOmega ?omegaq .
    ?afq qudt:numericValue ?af ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
    ?tpq qudt:numericValue ?tp ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?sq qudt:numericValue ?s ;
        qudt:unit <http://qudt.org/vocab/unit/M> .
    ?omegaq qudt:numericValue ?omega ;
            qudt:unit <http://qudt.org/vocab/unit/DEG> .
    FILTER (
        datatype(?af) = xsd:decimal &&
        datatype(?tp) = xsd:decimal &&
        datatype(?s) = xsd:decimal &&
        datatype(?omega) = xsd:decimal &&
        ?af > (10.0 * ?tp * ?s) &&
        ?omega > 20.0 &&
        ?omega < 70.0
    )
    FILTER NOT EXISTS {
        ?member nltl:netEffectivePlasticSectionModulus ?zpq .
        ?zpq qudt:numericValue ?zp ;
             qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
        ?case nltl:interpolationLowerEndpoint ?lower ;
              nltl:interpolationUpperEndpoint ?upper .
        ?lower a nltl:interpolationPoint ;
               nltl:interpolationPointCoordinate ?lowerCoordinateQ ;
               nltl:interpolationPointResult ?lowerResultQ .
        ?upper a nltl:interpolationPoint ;
               nltl:interpolationPointCoordinate ?upperCoordinateQ ;
               nltl:interpolationPointResult ?upperResultQ .
        ?lowerCoordinateQ qudt:numericValue ?lowerCoordinate ;
                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        ?upperCoordinateQ qudt:numericValue ?upperCoordinate ;
                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
        ?lowerResultQ qudt:numericValue ?lowerResult ;
                      qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
        ?upperResultQ qudt:numericValue ?upperResult ;
                      qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
        FILTER (
            datatype(?zp) = xsd:decimal &&
            datatype(?lowerCoordinate) = xsd:decimal &&
            datatype(?upperCoordinate) = xsd:decimal &&
            datatype(?lowerResult) = xsd:decimal &&
            datatype(?upperResult) = xsd:decimal &&
            ?lowerCoordinate = 20.0 &&
            ?upperCoordinate = 70.0
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "For 20 deg < Omega < 70 deg, the reported section modulus must equal the linear interpolation between the linked endpoint results within relative tolerance 1e-6 or absolute tolerance 1e-9 cm3." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:hasPlating ?plating ;
          nltl:hasCalculationCase ?case .
    ?member nltl:hasLocalFrameSectionCalculationCase ?case ;
            nltl:netLocalFrameFlangeArea ?afq ;
            nltl:netAttachedShellPlateThickness ?tpq ;
            nltl:frameSpacing ?sq ;
            nltl:netEffectivePlasticSectionModulus ?zpq .
    ?case nltl:sectionCalculationCaseStructuralMember ?member ;
          nltl:sectionCalculationCasePlating ?plating ;
          nltl:interpolationLowerEndpoint ?lower ;
          nltl:interpolationUpperEndpoint ?upper .
    ?plating nltl:framingAngleOmega ?omegaq .
    ?lower nltl:interpolationPointCoordinate ?lowerCoordinateQ ;
           nltl:interpolationPointResult ?lowerResultQ .
    ?upper nltl:interpolationPointCoordinate ?upperCoordinateQ ;
           nltl:interpolationPointResult ?upperResultQ .
    ?afq qudt:numericValue ?af ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
    ?tpq qudt:numericValue ?tp ;
         qudt:unit <http://qudt.org/vocab/unit/MilliM> .
    ?sq qudt:numericValue ?s ;
        qudt:unit <http://qudt.org/vocab/unit/M> .
    ?omegaq qudt:numericValue ?omega ;
            qudt:unit <http://qudt.org/vocab/unit/DEG> .
    ?zpq qudt:numericValue ?zp ;
         qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
    ?lowerCoordinateQ qudt:numericValue ?lowerCoordinate ;
                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
    ?upperCoordinateQ qudt:numericValue ?upperCoordinate ;
                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
    ?lowerResultQ qudt:numericValue ?lowerResult ;
                  qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
    ?upperResultQ qudt:numericValue ?upperResult ;
                  qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
    FILTER (
        datatype(?af) = xsd:decimal &&
        datatype(?tp) = xsd:decimal &&
        datatype(?s) = xsd:decimal &&
        datatype(?omega) = xsd:decimal &&
        datatype(?zp) = xsd:decimal &&
        datatype(?lowerCoordinate) = xsd:decimal &&
        datatype(?upperCoordinate) = xsd:decimal &&
        datatype(?lowerResult) = xsd:decimal &&
        datatype(?upperResult) = xsd:decimal &&
        ?af > (10.0 * ?tp * ?s) &&
        ?omega > 20.0 &&
        ?omega < 70.0 &&
        ?lowerCoordinate = 20.0 &&
        ?upperCoordinate = 70.0
    )
    BIND(
        (
            ?lowerResult
            +
            ((?omega - ?lowerCoordinate) / (?upperCoordinate - ?lowerCoordinate))
            * (?upperResult - ?lowerResult)
        )
        AS ?expectedZp
    )
    BIND(
        IF(
            ABS(?expectedZp) * 0.000001 > 0.000000001,
            ABS(?expectedZp) * 0.000001,
            0.000000001
        )
        AS ?tolerance
    )
    FILTER (ABS(?zp - ?expectedZp) > ?tolerance)
}
"""
    ] .
