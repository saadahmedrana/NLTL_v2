@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:StructuralMemberModelShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:structuralLocationValue
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase
    ] .

gen:LongitudinalSideFrameStrengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:frameProfileTypeValue
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:structuralMember ;
        sh:node gen:StructuralMemberModelShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each longitudinal side structural member must provide a midspan plastic-collapse load." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation .
    FILTER NOT EXISTS {
        ?member nltl:midspanPlasticCollapseLoad ?collapse .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each midspan plastic-collapse load of an applicable member must have decimal numeric values in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?collapse
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation ;
            nltl:midspanPlasticCollapseLoad ?collapse .
    FILTER (
        NOT EXISTS {
            ?collapse qudt:numericValue ?collapseValue .
            FILTER(datatype(?collapseValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?collapse qudt:numericValue ?badCollapseValue .
            FILTER(datatype(?badCollapseValue) != xsd:decimal)
        }
        ||
        NOT EXISTS {
            ?collapse qudt:unit unit:KiloN .
        }
        ||
        EXISTS {
            ?collapse qudt:unit ?badCollapseUnit .
            FILTER(?badCollapseUnit != unit:KiloN)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with an applicable longitudinal side member must provide plastic strength." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation .
    FILTER NOT EXISTS {
        $this nltl:plasticStrength ?strength .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Plastic strength for an applicable longitudinal side member must have decimal numeric values in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?strength
WHERE {
    $this nltl:hasStructuralMember ?member ;
          nltl:plasticStrength ?strength .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation .
    FILTER (
        NOT EXISTS {
            ?strength qudt:numericValue ?strengthValue .
            FILTER(datatype(?strengthValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?strength qudt:numericValue ?badStrengthValue .
            FILTER(datatype(?badStrengthValue) != xsd:decimal)
        }
        ||
        NOT EXISTS {
            ?strength qudt:unit unit:KiloN .
        }
        ||
        EXISTS {
            ?strength qudt:unit ?badStrengthUnit .
            FILTER(?badStrengthUnit != unit:KiloN)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each represented load case of an applicable longitudinal side member must provide combined shear-and-bending demand." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation ;
            nltl:hasStructuralMemberLoadCase ?loadCase .
    FILTER NOT EXISTS {
        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Combined shear-and-bending demand must have decimal numeric values in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase ?demand
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation ;
            nltl:hasStructuralMemberLoadCase ?loadCase .
    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    FILTER (
        NOT EXISTS {
            ?demand qudt:numericValue ?demandValue .
            FILTER(datatype(?demandValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?demand qudt:numericValue ?badDemandValue .
            FILTER(datatype(?badDemandValue) != xsd:decimal)
        }
        ||
        NOT EXISTS {
            ?demand qudt:unit unit:KiloN .
        }
        ||
        EXISTS {
            ?demand qudt:unit ?badDemandUnit .
            FILTER(?badDemandUnit != unit:KiloN)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Plastic strength must equal the applicable member's midspan plastic-collapse load within relative tolerance 1e-6 and absolute fallback 1e-12 kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?collapse
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation ;
            nltl:midspanPlasticCollapseLoad ?collapse .
    ?collapse qudt:numericValue ?collapseValue ;
              qudt:unit unit:KiloN .
    FILTER(datatype(?collapseValue) = xsd:decimal)
    FILTER NOT EXISTS {
        $this nltl:plasticStrength ?strength .
        ?strength qudt:numericValue ?strengthValue ;
                  qudt:unit unit:KiloN .
        FILTER(datatype(?strengthValue) = xsd:decimal)
        BIND(
            IF(
                ABS(?collapseValue) * 0.000001 > 0.000000000001,
                ABS(?collapseValue) * 0.000001,
                0.000000000001
            )
            AS ?tolerance
        )
        FILTER(ABS(?strengthValue - ?collapseValue) <= ?tolerance)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Combined shear-and-bending demand must not exceed the corresponding plastic strength." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase ?demand
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:longitudinalFrameOrientation true ;
            nltl:structuralLocation nltl:sideStructureLocation ;
            nltl:midspanPlasticCollapseLoad ?collapse ;
            nltl:hasStructuralMemberLoadCase ?loadCase .
    ?collapse qudt:numericValue ?collapseValue ;
              qudt:unit unit:KiloN .
    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    ?demand qudt:numericValue ?demandValue ;
            qudt:unit unit:KiloN .
    FILTER(datatype(?collapseValue) = xsd:decimal)
    FILTER(datatype(?demandValue) = xsd:decimal)
    FILTER NOT EXISTS {
        $this nltl:plasticStrength ?strength .
        ?strength qudt:numericValue ?strengthValue ;
                  qudt:unit unit:KiloN .
        FILTER(datatype(?strengthValue) = xsd:decimal)
        BIND(
            IF(
                ABS(?collapseValue) * 0.000001 > 0.000000000001,
                ABS(?collapseValue) * 0.000001,
                0.000000000001
            )
            AS ?tolerance
        )
        FILTER(ABS(?strengthValue - ?collapseValue) <= ?tolerance)
        FILTER(?demandValue <= ?strengthValue)
    }
}
"""
    ] .
