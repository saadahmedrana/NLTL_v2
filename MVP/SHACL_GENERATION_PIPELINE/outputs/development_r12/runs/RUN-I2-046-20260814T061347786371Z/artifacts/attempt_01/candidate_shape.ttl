@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:I2_046_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarClassValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasInternalIceStrengthenedStructure ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:internalIceStrengthenedStructure ;
                sh:node shape:I2_046_InternalStructureShape
            ]
        ]
    ) .

shape:I2_046_InternalStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:node shape:I2_046_CorrosionAbrasionAdditionShape ;
        sh:message "Each represented internal ice-strengthened structure must have a corrosion/abrasion addition of at least 1.0 mm."
    ] .

shape:I2_046_CorrosionAbrasionAdditionShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:minCount 1 ;
        sh:message "The corrosion/abrasion addition must be at least 1.0 mm."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:message "The corrosion/abrasion addition must use millimetres."
    ] .
