@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF114ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperatingSpeed ;
        sh:minCount 1 ;
        sh:node gen:KnotQuantityShape ;
        sh:message "A typical ice operating speed in knots is required."
    ] ;
    sh:property [
        sh:path nltl:hasThrusterIceImpactLoadCase ;
        sh:minCount 1 ;
        sh:class nltl:thrusterIceImpactLoadCase ;
        sh:node gen:TRF114CommonImpactCaseShape ;
        sh:message "At least one complete thruster ice impact load case is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasThrusterIceImpactLoadCase ;
                sh:minCount 1 ;
                sh:node gen:TRF114HemisphericalCaseShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:equivalentImpactSphereRadius ;
                sh:minCount 1 ;
                sh:node gen:MetreQuantityShape ;
                sh:message "An equivalent impact sphere radius is required for non-hemispherical contact geometry."
            ] ;
            sh:property [
                sh:path nltl:hasThrusterIceImpactLoadCase ;
                sh:minCount 1 ;
                sh:node gen:TRF114GeometryAlternativeCaseShape
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Thruster resistance capacity must be at least the applicable impact demand and recorded impact load for each linked case and body." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?case ?body
WHERE {
    $this nltl:hasThrusterIceImpactLoadCase ?case .
    ?case nltl:thrusterImpactCaseAppliesToBody ?body ;
          nltl:thrusterIceImpactDemand ?demandQuantity ;
          nltl:thrusterIceImpactLoad ?loadQuantity .
    ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
    ?demandQuantity qudt:numericValue ?demand ;
                    qudt:unit unit:KiloN .
    ?loadQuantity qudt:numericValue ?load ;
                  qudt:unit unit:KiloN .
    ?capacityQuantity qudt:numericValue ?capacity ;
                      qudt:unit unit:KiloN .
    FILTER (
        xsd:decimal(?capacity) < xsd:decimal(?demand) ||
        xsd:decimal(?capacity) < xsd:decimal(?load)
    )
}
"""
    ] .

gen:TRF114CommonImpactCaseShape
    a sh:NodeShape ;
    sh:class nltl:thrusterIceImpactLoadCase ;
    sh:property [
        sh:path nltl:designIceBlockTableReference ;
        sh:minCount 1 ;
        sh:hasValue nltl:traficomTable6Dash3Reference ;
        sh:message "The design ice block must reference TRAFICOM Table 6-3."
    ] ;
    sh:property [
        sh:path nltl:impactLoadCaseTableReference ;
        sh:minCount 1 ;
        sh:hasValue nltl:traficomTable6Dash16Reference ;
        sh:message "The impact load case must reference TRAFICOM Table 6-16."
    ] ;
    sh:property [
        sh:path nltl:contactGeometryClassification ;
        sh:minCount 1 ;
        sh:class nltl:contactGeometryValue ;
        sh:in (
            nltl:hemisphericalContactGeometry
            nltl:nonHemisphericalContactGeometry
        ) ;
        sh:message "Contact geometry must be classified as hemispherical or non-hemispherical."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoadedAreaEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Loaded-area evidence is required for the impact load case."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactDemand ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "The applicable thruster ice impact demand in kilonewtons is required."
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoad ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "The recorded thruster ice impact load in kilonewtons is required."
    ] ;
    sh:property [
        sh:path nltl:thrusterImpactCaseAppliesToBody ;
        sh:minCount 1 ;
        sh:class nltl:thrusterBody ;
        sh:node gen:TRF114ThrusterBodyShape ;
        sh:message "The impact load case must identify the applicable thruster body."
    ] .

gen:TRF114HemisphericalCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:contactGeometryClassification ;
        sh:minCount 1 ;
        sh:hasValue nltl:hemisphericalContactGeometry
    ] .

gen:TRF114GeometryAlternativeCaseShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:contactGeometryClassification ;
                sh:minCount 1 ;
                sh:hasValue nltl:hemisphericalContactGeometry
            ]
        ]
        [
            sh:property [
                sh:path nltl:contactGeometryClassification ;
                sh:minCount 1 ;
                sh:hasValue nltl:nonHemisphericalContactGeometry
            ] ;
            sh:property [
                sh:path nltl:contactGeometryCorrespondenceEvidence ;
                sh:minCount 1 ;
                sh:class nltl:evidenceArtifact ;
                sh:message "Correspondence evidence is required for non-hemispherical contact geometry."
            ]
        ]
    ) .

gen:TRF114ThrusterBodyShape
    a sh:NodeShape ;
    sh:class nltl:thrusterBody ;
    sh:property [
        sh:path nltl:thrusterResistanceCapacity ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "Thruster resistance capacity in kilonewtons is required."
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:KiloN
    ] .

gen:KnotQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:KN
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:M
    ] .
