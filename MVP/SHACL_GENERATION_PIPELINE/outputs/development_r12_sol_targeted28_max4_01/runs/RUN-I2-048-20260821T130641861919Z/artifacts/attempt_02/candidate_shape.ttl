@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:node gs:I2_048_SteelGradeRequirementCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gs:I2_048_SteelGradeRequirementCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSteelGradeRequirementCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasSteelGradeRequirementCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                ) ;
                sh:message "A ship with a steel-grade requirement case must identify exactly one Polar Class."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each steel-grade requirement case must be the same case linked through hasTableLookupCase." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
SELECT $this ?case
WHERE {
    $this nltl:hasSteelGradeRequirementCase ?case .
    FILTER NOT EXISTS {
        $this nltl:hasTableLookupCase ?case .
    }
}
"""
    ] .

gs:I2_048_SteelGradeRequirementCaseShape
    a sh:NodeShape ;
    sh:class nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:message "The steel-grade requirement case must identify the assessed plating."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_048_ThicknessShape ;
        sh:message "The Table 8 case must provide one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:message "The Table 8 case must identify one permitted steel material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:message "The Table 8 case must identify one permitted steel strength category."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "The steel-grade lookup must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Evidence of the Table 8 lookup selection is required."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:node gs:I2_048_RankedSteelGradeShape ;
        sh:message "The Table 8 case must identify one required hull structural steel grade with an order rank."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:node gs:I2_048_RankedSteelGradeShape ;
        sh:message "The Table 8 case must identify one actual hull structural steel grade with an order rank."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual hull structural steel grade must not rank below the Table 8 required grade." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?actualGrade ?requiredGrade
WHERE {
    $this nltl:actualHullStructuralSteelGrade ?actualGrade ;
          nltl:requiredHullStructuralSteelGrade ?requiredGrade .
    ?actualGrade nltl:steelGradeOrderRank ?actualRank .
    ?requiredGrade nltl:steelGradeOrderRank ?requiredRank .
    FILTER(xsd:integer(?actualRank) < xsd:integer(?requiredRank))
}
"""
    ] .

gs:I2_048_ThicknessShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .

gs:I2_048_RankedSteelGradeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeOrderRank ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ] .
