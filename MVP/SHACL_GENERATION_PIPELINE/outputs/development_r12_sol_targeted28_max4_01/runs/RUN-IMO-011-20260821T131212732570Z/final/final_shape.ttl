@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO011ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDailyLowTemperatureObservation ;
        sh:class nltl:dailyLowTemperatureObservation ;
        sh:node gen:IMO011DailyLowTemperatureObservationShape ;
        sh:minCount 1 ;
        sh:message "At least one dated daily low-temperature observation is required."
    ] ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:node gen:IMO011DataPeriodValueShape ;
        sh:minCount 1 ;
        sh:message "The daily low-temperature dataset coverage period is required."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:node gen:IMO011TemperatureValueShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated mean daily low temperature is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minInclusive "10"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxExclusive "10"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "A dataset covering less than 10 years requires Administration approval."
            ]
        ]
    ) .

gen:IMO011DailyLowTemperatureObservationShape
    a sh:NodeShape ;
    sh:class nltl:dailyLowTemperatureObservation ;
    sh:property [
        sh:path nltl:dailyTemperatureObservationDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Each daily low-temperature observation requires a calendar date."
    ] ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:node gen:IMO011TemperatureValueShape ;
        sh:minCount 1 ;
        sh:message "Each daily low-temperature observation requires a temperature value."
    ] .

gen:IMO011TemperatureValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG_C ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Temperature values must use degrees Celsius."
    ] .

gen:IMO011DataPeriodValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:YR ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The data coverage period must use years."
    ] .
