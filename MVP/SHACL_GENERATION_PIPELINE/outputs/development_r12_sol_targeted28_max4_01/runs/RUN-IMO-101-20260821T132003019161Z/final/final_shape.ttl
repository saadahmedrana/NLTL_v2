@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarRoutePlanningShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarRoutePlan ;
        sh:minCount 1 ;
        sh:class nltl:polarRoutePlan ;
        sh:node gen:PolarRoutePlanCoverageShape ;
        sh:message "The ship must have a polar route plan covering all required voyage-planning topics."
    ] .

gen:PolarRoutePlanCoverageShape
    a sh:NodeShape ;
    sh:class nltl:polarRoutePlan ;
    sh:property [
        sh:path nltl:voyagePlanningTopicCoverage ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The polar route plan must record complete coverage of the required voyage-planning topics."
    ] .
