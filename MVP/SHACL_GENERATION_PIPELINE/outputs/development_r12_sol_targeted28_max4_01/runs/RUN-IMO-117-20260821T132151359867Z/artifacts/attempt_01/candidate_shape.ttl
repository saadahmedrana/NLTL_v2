@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO117ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:sewageDischargeUsesTreatmentPlant ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sewageTreatmentPlantApprovalStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "The sewage treatment plant must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification must be approved."
            ] ;
            sh:property [
                sh:path nltl:marpolCertificationStatus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "MARPOL certification must have approved status."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "MARPOL Annex IV regulation 11.1.2 discharge compliance must be true."
            ] ;
            sh:property [
                sh:path nltl:marpolDischargeStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "MARPOL discharge compliance must be true."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:class nltl:dischargeDistanceRecords ;
                sh:minCount 1 ;
                sh:node gen:IMO117DischargeDistanceRecordShape ;
                sh:message "A conforming discharge-distance record is required."
            ]
        ]
    ) .

gen:IMO117DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:message "Distance to the nearest land, ice shelf, or fast ice must be recorded."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:node gen:IMO117NauticalMileQuantityShape ;
        sh:message "Distance to an area with ice concentration greater than one tenth must be recorded."
    ] .

gen:IMO117NauticalMileQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MI_N
    ] .
