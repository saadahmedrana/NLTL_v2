@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:CargoResidueDischargeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:residueNotRecoverableByCommonMethods ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Cargo residue must not be recoverable using commonly available methods."
    ] ;
    sh:property [
        sh:path nltl:shipEnRoute ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must be en route."
    ] ;
    sh:property [
        sh:path nltl:harmfulSubstancePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Harmful substances must not be present."
    ] ;
    sh:property [
        sh:path nltl:departureAndDestinationWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The departure and destination ports must be within Arctic waters."
    ] ;
    sh:property [
        sh:path nltl:routeRemainsWithinArctic ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The route must remain within Arctic waters."
    ] ;
    sh:property [
        sh:path nltl:adequateReceptionFacilitiesAvailable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "Adequate reception facilities must be unavailable."
    ] ;
    sh:property [
        sh:path nltl:hasDischargeDistanceRecord ;
        sh:class nltl:dischargeDistanceRecords ;
        sh:node gen:DischargeDistanceRecordShape ;
        sh:minCount 1 ;
        sh:message "A discharge-distance record is required."
    ] .

gen:DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasDischargeDistanceRecord ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:class qudt:QuantityValue ;
        sh:node gen:MinimumDischargeDistanceShape ;
        sh:minCount 1 ;
        sh:message "The distance to the nearest land, ice shelf, or fast ice is required."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:class qudt:QuantityValue ;
        sh:node gen:IceConcentrationAreaDistanceShape ;
        sh:minCount 1 ;
        sh:message "The distance from an area with ice concentration greater than one tenth is required."
    ] .

gen:MinimumDischargeDistanceShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 12.0 ;
        sh:message "The discharge distance must be at least 12 nautical miles."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MI_N ;
        sh:message "The discharge distance unit must be the nautical mile."
    ] .

gen:IceConcentrationAreaDistanceShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The recorded distance must have a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MI_N ;
        sh:message "The recorded distance unit must be the nautical mile."
    ] .
