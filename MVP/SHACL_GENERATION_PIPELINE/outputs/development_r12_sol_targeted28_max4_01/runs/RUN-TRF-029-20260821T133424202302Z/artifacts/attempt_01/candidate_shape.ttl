@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF029Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Whether direct analysis is used must be stated."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:prescribedProcedureApplicability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "When direct analysis is used, the prescribed procedure must be recorded as inapplicable."
            ] ;
            sh:property [
                sh:path nltl:directAnalysisApprovalStatus ;
                sh:minCount 1 ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:message "When direct analysis is used, its approval status must be approved."
            ] ;
            sh:property [
                sh:path nltl:structuralArrangement ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When direct analysis is used, the structural arrangement or detail must be recorded."
            ]
        ]
    ) .
