@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF048LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:frameBoundaryConditionTypeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single frame boundary condition type is required."
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The significantly different boundary conditions selector is required."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gs:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gs:CubicCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:sparql [
        sh:message "For a continuous beam with brackets without significantly different boundary conditions, frameMomentFactorM must be 13.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType
                          nltl:continuousBeamWithBracketsFrameCondition ;
                      nltl:significantlyDifferentBoundaryConditions false ;
                      nltl:frameMomentFactorM ?mQuantity .
                ?mQuantity qudt:numericValue ?m .
                FILTER (?m != 13.3)
            }
        """
    ] ;

    sh:sparql [
        sh:message "Spacing, frame moment factor, and yield strength must be non-zero for the required calculations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:spacing ?spacingQuantity ;
                      nltl:frameMomentFactorM ?momentQuantity ;
                      nltl:yieldStrength ?yieldQuantity .
                ?spacingQuantity qudt:numericValue ?s .
                ?momentQuantity qudt:numericValue ?m .
                ?yieldQuantity qudt:numericValue ?sigma .
                FILTER (?s = 0 || ?m = 0 || ?sigma = 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The reported load distribution factor, section modulus, and required shear area must agree with the prescribed formulas within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:designIceLoadHeight ?heightQuantity ;
                      nltl:spacing ?spacingQuantity ;
                      nltl:span ?spanQuantity ;
                      nltl:frameMomentFactorM ?momentQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Quantity ;
                      nltl:sectionModulus ?sectionQuantity ;
                      nltl:requiredShearArea ?areaQuantity .

                ?pressureQuantity qudt:numericValue ?p .
                ?heightQuantity qudt:numericValue ?h .
                ?spacingQuantity qudt:numericValue ?s .
                ?spanQuantity qudt:numericValue ?l .
                ?momentQuantity qudt:numericValue ?m .
                ?yieldQuantity qudt:numericValue ?sigma .
                ?f4Quantity qudt:numericValue ?reportedF4 .
                ?sectionQuantity qudt:numericValue ?reportedZ .
                ?areaQuantity qudt:numericValue ?reportedA .

                FILTER (?s != 0 && ?m != 0 && ?sigma != 0)

                BIND ((1 - 0.2 * ?h / ?s) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l /
                       (4 * ?m * ?sigma)) * 1000000 AS ?expectedZ)
                BIND ((1.7320508075688772 * ?expectedF4 * 2.16 *
                       ?p * ?h * ?l / (2 * ?sigma)) * 10000 AS ?expectedA)

                BIND (
                    IF (
                        ABS(?expectedF4) * 0.000001 > 0.000000000001,
                        ABS(?expectedF4) * 0.000001,
                        0.000000000001
                    ) AS ?f4Tolerance
                )
                BIND (
                    IF (
                        ABS(?expectedZ) * 0.000001 > 0.000000000001,
                        ABS(?expectedZ) * 0.000001,
                        0.000000000001
                    ) AS ?zTolerance
                )
                BIND (
                    IF (
                        ABS(?expectedA) * 0.000001 > 0.000000000001,
                        ABS(?expectedA) * 0.000001,
                        0.000000000001
                    ) AS ?aTolerance
                )

                FILTER (
                    ABS(?reportedF4 - ?expectedF4) > ?f4Tolerance ||
                    ABS(?reportedZ - ?expectedZ) > ?zTolerance ||
                    ABS(?reportedA - ?expectedA) > ?aTolerance
                )
            }
        """
    ] .
