@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF070ThrusterReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "azimuthing" "fixed" ) ;
        sh:message "Thruster type must identify an azimuthing or fixed thruster."
    ] ;
    sh:property [
        sh:path nltl:mainPropulsionThruster ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Main-propulsion applicability must be stated as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:propellerIceInteractionLoad ;
                sh:minCount 1 ;
                sh:node gen:KiloNewtonQuantityShape ;
                sh:message "A propeller/ice interaction load is required for an applicable main-propulsion thruster."
            ] ;
            sh:property [
                sh:path nltl:thrusterBodyIceInteractionLoad ;
                sh:minCount 1 ;
                sh:node gen:KiloNewtonQuantityShape ;
                sh:message "A thruster-body/ice interaction load is required for an applicable main-propulsion thruster."
            ] ;
            sh:property [
                sh:path nltl:localIcePressure ;
                sh:minCount 1 ;
                sh:node gen:MegaPascalQuantityShape ;
                sh:message "Local ice pressure is required for an applicable main-propulsion thruster."
            ] ;
            sh:property [
                sh:path nltl:hasDesignCondition ;
                sh:minCount 1 ;
                sh:node gen:TRF070DesignConditionReadinessShape ;
                sh:message "An applicable main-propulsion thruster requires a design condition with local-strength capacity."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Design-condition local-strength capacity must be at least the applicable local ice pressure." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:localIcePressure ?pressureQuantity .
                        ?pressureQuantity qudt:numericValue ?pressure .
                        $this nltl:hasDesignCondition ?condition .
                        ?condition nltl:designConditionLocalStrengthCapacity ?capacityQuantity .
                        ?capacityQuantity qudt:numericValue ?capacity .
                        FILTER(xsd:decimal(?capacity) < xsd:decimal(?pressure))
                    }
                """
            ]
        ]
    ) ;
    sh:message "The thruster applicability information and the corresponding readiness data are incomplete or non-conforming." .

gen:TRF070DesignConditionReadinessShape
    a sh:NodeShape ;
    sh:class nltl:designCondition ;
    sh:property [
        sh:path nltl:designConditionLocalStrengthCapacity ;
        sh:minCount 1 ;
        sh:node gen:KiloNewtonQuantityShape ;
        sh:message "The design condition requires an externally assessed local-strength capacity."
    ] .

gen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .
