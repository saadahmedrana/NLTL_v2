@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_001_ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:minInclusive "2021-01-01"^^xsd:date
            ]
            [
                sh:maxExclusive "2021-01-01"^^xsd:date
            ]
        ) ;
        sh:message "The ship's construction contract date must be a single xsd:date that identifies whether the UR I2 Rev.4 applicability cutoff of 2021-01-01 is met."
    ] .
