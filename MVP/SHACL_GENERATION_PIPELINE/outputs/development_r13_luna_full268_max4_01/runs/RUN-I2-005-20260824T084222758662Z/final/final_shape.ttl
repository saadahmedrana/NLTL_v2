@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-005> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;
        sh:minCount 1 ;
        sh:message "The ship must identify its bottom/lower-region boundary point." ;
        sh:node [
            sh:class nltl:hullBoundaryPoint ;
            sh:property [
                sh:path nltl:shellInclinationAngle ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The boundary point must have one shell inclination angle." ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minInclusive "7"^^xsd:decimal ;
                        sh:maxInclusive "7"^^xsd:decimal ;
                        sh:message "The shell inclination angle must be exactly 7 degrees."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:DEG ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The shell inclination angle must use degrees."
                    ]
                ]
            ]
        ]
    ] .
