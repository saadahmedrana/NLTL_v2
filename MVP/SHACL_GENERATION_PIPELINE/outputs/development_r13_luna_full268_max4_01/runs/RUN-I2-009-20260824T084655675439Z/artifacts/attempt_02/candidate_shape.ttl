@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-009-QuantityValue>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-009-HullAreaAssignment>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:in (
            nltl:otherIceStrengthenedArea
            nltl:otherIceStrengthenedAreaValue
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        )
    ] .

<urn:nltl:generated-shape:I2-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:hasHullAreaAssignment ;
        sh:node <urn:nltl:generated-shape:I2-009-HullAreaAssignment>
    ] ;

    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node [
            sh:node <urn:nltl:generated-shape:I2-009-QuantityValue> ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt-unit:MegaPA
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:node [
            sh:node <urn:nltl:generated-shape:I2-009-QuantityValue> ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt-unit:UNITLESS
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:node [
            sh:node <urn:nltl:generated-shape:I2-009-QuantityValue> ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt-unit:M
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:node [
            sh:node <urn:nltl:generated-shape:I2-009-QuantityValue> ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt-unit:M
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:buttockAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node <urn:nltl:generated-shape:I2-009-QuantityValue> ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt-unit:DEG
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:node <urn:nltl:generated-shape:I2-009-QuantityValue> ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue qudt-unit:DEG
            ]
        ]
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an applicable bow form, buttock angle must be greater than 0 degrees and less than 80 degrees, and normal frame angle must be greater than 10 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudt-unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:buttockAngle/qudt:numericValue ?gamma .
                $this nltl:normalFrameAngle/qudt:numericValue ?beta .
                FILTER (?gamma <= 0 || ?gamma >= 80 || ?beta <= 10)
            }
        """
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For every other ice-strengthened area, average ice pressure, non-bow load-patch height and length, and load-patch aspect ratio must be provided independently of hull shape, with aspect ratio exactly 3.6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudt-unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasHullAreaAssignment ?assignment .
                ?assignment nltl:assignedHullArea ?area .
                FILTER (?area IN (
                    nltl:otherIceStrengthenedArea,
                    nltl:otherIceStrengthenedAreaValue
                ))
                FILTER (
                    NOT EXISTS {
                        $this nltl:averageIcePressure ?pressure .
                        ?pressure qudt:numericValue ?pressureValue .
                        ?pressure qudt:unit qudt-unit:MegaPA .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nonBowLoadPatchHeight ?height .
                        ?height qudt:numericValue ?heightValue .
                        ?height qudt:unit qudt-unit:M .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:nonBowLoadPatchLength ?length .
                        ?length qudt:numericValue ?lengthValue .
                        ?length qudt:unit qudt-unit:M .
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:loadPatchAspectRatio ?aspect .
                        ?aspect qudt:numericValue ?aspectValue .
                        ?aspect qudt:unit qudt-unit:UNITLESS .
                        FILTER (?aspectValue >= 3.6 && ?aspectValue <= 3.6)
                    }
                )
            }
        """
    ] .
</urn:nltl:generated-shape:I2-009-ShipShape>
