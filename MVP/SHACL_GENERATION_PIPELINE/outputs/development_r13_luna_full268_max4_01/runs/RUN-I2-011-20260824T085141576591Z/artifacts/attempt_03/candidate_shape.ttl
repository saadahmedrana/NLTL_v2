@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_011_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single Polar Class value is required to determine applicability of I2.3.1(vii)."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc1
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc2
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc3
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc4
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc5
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc6
            ] ;
            sh:node gs:I2_011_ApplicableShape
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:hasValue nltl:polarClassPc7
            ] ;
            sh:node gs:I2_011_ApplicableShape
        ]
    ) .

gs:I2_011_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An applicable PC6 or PC7 ship must record that a bulbous bow is present."
    ] ;
    sh:property [
        sh:path nltl:shapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ShapeCoefficientQuantity ;
        sh:message "The applicable ship must provide shapeCoefficient equal to 0.6 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_LoadPatchAspectRatioQuantity ;
        sh:message "The applicable ship must provide loadPatchAspectRatio equal to 1.3 and dimensionless."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ForceQuantity ;
        sh:message "The I2.3.2.1(iii) bow design force is required in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_ForceQuantity ;
        sh:message "The I2.3.2.1(iv) bow design force is required in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:I2_011_BowDesignForceQuantity ;
        sh:message "The applicable ship must provide a bow design force in kN."
    ] ;
    sh:sparql [
        sh:message "The bow design force must not be less than either referenced force after converting the MN operands to kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowDesignForce ?resultQuantity ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?iiiQuantity ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?ivQuantity .
                ?resultQuantity qudt:numericValue ?result .
                ?iiiQuantity qudt:numericValue ?iii .
                ?ivQuantity qudt:numericValue ?iv .
                FILTER (
                    ?result < (?iii * 1000) ||
                    ?result < (?iv * 1000)
                )
            }
        """
    ] .

gs:I2_011_ShapeCoefficientQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.6"^^xsd:decimal ;
        sh:maxInclusive "0.6"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gs:I2_011_LoadPatchAspectRatioQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.3"^^xsd:decimal ;
        sh:maxInclusive "1.3"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gs:I2_011_ForceQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:MegaN
    ] .

gs:I2_011_BowDesignForceQuantity
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:KiloN
    ] .
