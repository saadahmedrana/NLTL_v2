@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:I2_014_BowSubregionCaseShape
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Selected maximum bow force, line load, and pressure must each equal the maximum reported value among the four bow subregion calculation cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceNode ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineNode ;
                      nltl:selectedMaximumBowPressure ?selectedPressureNode .
                ?selectedForceNode <http://qudt.org/schema/qudt/numericValue> ?selectedForce .
                ?selectedLineNode <http://qudt.org/schema/qudt/numericValue> ?selectedLine .
                ?selectedPressureNode <http://qudt.org/schema/qudt/numericValue> ?selectedPressure .

                FILTER (
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?matchingForceCase .
                        ?matchingForceCase nltl:bowSubregionCalculatedForce ?matchingForceNode .
                        ?matchingForceNode <http://qudt.org/schema/qudt/numericValue> ?matchingForce .
                        FILTER (?matchingForce = ?selectedForce)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?greaterForceCase .
                        ?greaterForceCase nltl:bowSubregionCalculatedForce ?greaterForceNode .
                        ?greaterForceNode <http://qudt.org/schema/qudt/numericValue> ?greaterForce .
                        FILTER (?greaterForce > ?selectedForce)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?matchingLineCase .
                        ?matchingLineCase nltl:bowSubregionCalculatedLineLoad ?matchingLineNode .
                        ?matchingLineNode <http://qudt.org/schema/qudt/numericValue> ?matchingLine .
                        FILTER (?matchingLine = ?selectedLine)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?greaterLineCase .
                        ?greaterLineCase nltl:bowSubregionCalculatedLineLoad ?greaterLineNode .
                        ?greaterLineNode <http://qudt.org/schema/qudt/numericValue> ?greaterLine .
                        FILTER (?greaterLine > ?selectedLine)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?matchingPressureCase .
                        ?matchingPressureCase nltl:bowSubregionCalculatedPressure ?matchingPressureNode .
                        ?matchingPressureNode <http://qudt.org/schema/qudt/numericValue> ?matchingPressure .
                        FILTER (?matchingPressure = ?selectedPressure)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasBowSubregionCalculationCase ?greaterPressureCase .
                        ?greaterPressureCase nltl:bowSubregionCalculatedPressure ?greaterPressureNode .
                        ?greaterPressureNode <http://qudt.org/schema/qudt/numericValue> ?greaterPressure .
                        FILTER (?greaterPressure > ?selectedPressure)
                    }
                )
            }
        """
    ] .

gen:I2_014_BowSubregionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] .
