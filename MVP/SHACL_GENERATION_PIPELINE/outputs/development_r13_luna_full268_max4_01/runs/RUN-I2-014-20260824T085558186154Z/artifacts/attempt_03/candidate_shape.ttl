@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_014_BowSubregionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4
    ] ;

    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node [
            sh:class nltl:bowSubregionCalculationCase ;

            sh:property [
                sh:path nltl:bowSubregionCalculationEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionMidLengthPosition ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionAspectRatio ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedForce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;

            sh:property [
                sh:path nltl:bowSubregionCalculatedPressure ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaPA ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M-PER-M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "The four bow subregion cases must have distinct midpoint positions covering the four equal-length subregions of bowLength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bowLength ?blq ;
                      nltl:hasBowSubregionCalculationCase ?c1, ?c2, ?c3, ?c4 .
                FILTER (?c1 != ?c2 && ?c1 != ?c3 && ?c1 != ?c4 &&
                        ?c2 != ?c3 && ?c2 != ?c4 && ?c3 != ?c4)
                ?blq qudt:numericValue ?bl .
                ?c1 nltl:bowSubregionMidLengthPosition ?p1 .
                ?c2 nltl:bowSubregionMidLengthPosition ?p2 .
                ?c3 nltl:bowSubregionMidLengthPosition ?p3 .
                ?c4 nltl:bowSubregionMidLengthPosition ?p4 .
                ?p1 qudt:numericValue ?m1 .
                ?p2 qudt:numericValue ?m2 .
                ?p3 qudt:numericValue ?m3 .
                ?p4 qudt:numericValue ?m4 .
                FILTER (
                    ABS(?m1 - ?m2) > (ABS(?bl) * 1e-6 + 1e-9) &&
                    ABS(?m1 - ?m3) > (ABS(?bl) * 1e-6 + 1e-9) &&
                    ABS(?m1 - ?m4) > (ABS(?bl) * 1e-6 + 1e-9) &&
                    ABS(?m2 - ?m3) > (ABS(?bl) * 1e-6 + 1e-9) &&
                    ABS(?m2 - ?m4) > (ABS(?bl) * 1e-6 + 1e-9) &&
                    ABS(?m3 - ?m4) > (ABS(?bl) * 1e-6 + 1e-9)
                )
                FILTER (
                    (
                        ABS(?m1 - (?bl / 8)) <= (ABS(?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m1 - (3 * ?bl / 8)) <= (ABS(3 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m1 - (5 * ?bl / 8)) <= (ABS(5 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m1 - (7 * ?bl / 8)) <= (ABS(7 * ?bl / 8) * 1e-6 + 1e-9)
                    ) &&
                    (
                        ABS(?m2 - (?bl / 8)) <= (ABS(?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m2 - (3 * ?bl / 8)) <= (ABS(3 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m2 - (5 * ?bl / 8)) <= (ABS(5 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m2 - (7 * ?bl / 8)) <= (ABS(7 * ?bl / 8) * 1e-6 + 1e-9)
                    ) &&
                    (
                        ABS(?m3 - (?bl / 8)) <= (ABS(?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m3 - (3 * ?bl / 8)) <= (ABS(3 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m3 - (5 * ?bl / 8)) <= (ABS(5 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m3 - (7 * ?bl / 8)) <= (ABS(7 * ?bl / 8) * 1e-6 + 1e-9)
                    ) &&
                    (
                        ABS(?m4 - (?bl / 8)) <= (ABS(?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m4 - (3 * ?bl / 8)) <= (ABS(3 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m4 - (5 * ?bl / 8)) <= (ABS(5 * ?bl / 8) * 1e-6 + 1e-9) ||
                        ABS(?m4 - (7 * ?bl / 8)) <= (ABS(7 * ?bl / 8) * 1e-6 + 1e-9)
                    )
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "selectedMaximumBowForce must equal the maximum reported bow subregion force within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?sq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?sq qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedForce ?fq .
                ?fq qudt:numericValue ?candidate .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?higherCase .
                    ?higherCase nltl:bowSubregionCalculatedForce ?higherQ .
                    ?higherQ qudt:numericValue ?higher .
                    FILTER (?higher > ?candidate)
                }
                FILTER (ABS(?selected - ?candidate) >
                        (ABS(?candidate) * 1e-6 + 1e-9))
            }
        """
    ] ;

    sh:sparql [
        sh:message "selectedMaximumBowLineLoad must equal the maximum reported bow subregion line load within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowLineLoad ?sq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?sq qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedLineLoad ?lq .
                ?lq qudt:numericValue ?candidate .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?higherCase .
                    ?higherCase nltl:bowSubregionCalculatedLineLoad ?higherQ .
                    ?higherQ qudt:numericValue ?higher .
                    FILTER (?higher > ?candidate)
                }
                FILTER (ABS(?selected - ?candidate) >
                        (ABS(?candidate) * 1e-6 + 1e-9))
            }
        """
    ] ;

    sh:sparql [
        sh:message "selectedMaximumBowPressure must equal the maximum reported bow subregion pressure within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:selectedMaximumBowPressure ?sq ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?sq qudt:numericValue ?selected .
                ?case nltl:bowSubregionCalculatedPressure ?pq .
                ?pq qudt:numericValue ?candidate .
                FILTER NOT EXISTS {
                    $this nltl:hasBowSubregionCalculationCase ?higherCase .
                    ?higherCase nltl:bowSubregionCalculatedPressure ?higherQ .
                    ?higherQ qudt:numericValue ?higher .
                    FILTER (?higher > ?candidate)
                }
                FILTER (ABS(?selected - ?candidate) >
                        (ABS(?candidate) * 1e-6 + 1e-9))
            }
        """
    ] .
