@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-019> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:node [
                    sh:class nltl:hullAreaValue ;
                    sh:property [
                        sh:path nltl:hullAreaFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A structural member spanning a hull area must have a selected hull area factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasSpannedHullArea ?area .
                FILTER NOT EXISTS {
                    ?member nltl:selectedHullAreaFactor ?selected .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The selected hull area factor must equal the maximum spanned hull area factor within the stated numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:selectedHullAreaFactor ?selectedQuantity ;
                        nltl:hasSpannedHullArea ?area .
                ?selectedQuantity qudt:numericValue ?selected .
                ?area nltl:hullAreaFactor ?factorQuantity .
                ?factorQuantity qudt:numericValue ?candidate .
                FILTER NOT EXISTS {
                    ?member nltl:hasSpannedHullArea ?otherArea .
                    ?otherArea nltl:hullAreaFactor ?otherFactorQuantity .
                    ?otherFactorQuantity qudt:numericValue ?other .
                    FILTER (?other > ?candidate)
                }
                BIND(IF(?candidate < 0, -?candidate, ?candidate) AS ?scale)
                BIND((?scale * 0.000001) + 0.000000000001 AS ?tolerance)
                BIND(IF((?selected - ?candidate) < 0,
                        -(?selected - ?candidate),
                        (?selected - ?candidate)) AS ?difference)
                FILTER (?difference > ?tolerance)
            }
        """
    ] .
