@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-022-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node <urn:nltl:generated-shape:I2-022-PlatingShape>
    ] ;
    sh:or (
        <urn:nltl:generated-shape:I2-022-NonApplicableShipShape>
        <urn:nltl:generated-shape:I2-022-ApplicableShipShape>
    ) .

<urn:nltl:generated-shape:I2-022-PlatingShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:platingHullAreaClassification ;
        sh:class nltl:hullAreaValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:generated-shape:I2-022-ApplicablePlatingShape>
        <urn:nltl:generated-shape:I2-022-NonApplicablePlatingShape>
    ) .

<urn:nltl:generated-shape:I2-022-ApplicablePlatingShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:platingHullAreaClassification ;
        sh:in (
            nltl:bowIntermediateBottomHullArea
            nltl:midbodyBottomHullArea
            nltl:sternBottomHullArea
        )
    ] ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive 70
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Applicable plating shall provide the externally calculated net ice-load plate thickness."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-022-StructuralMemberShape> ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:I2-022-NonApplicablePlatingShape>
    a sh:NodeShape ;
    sh:sparql [
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:framingAngleOmega ?angle .
                ?angle qudt:numericValue ?angleValue .
                $this nltl:platingHullAreaClassification ?area .
                FILTER (
                    ?angleValue >= 70 &&
                    ?area IN (
                        nltl:bowIntermediateBottomHullArea,
                        nltl:midbodyBottomHullArea,
                        nltl:sternBottomHullArea
                    )
                )
            }
        """ ;
        sh:message "A plating with Omega at least 70 degrees in BI_b, M_b, or S_b is applicable to the net-thickness readiness requirement."
    ] .

<urn:nltl:generated-shape:I2-022-NonApplicableShipShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node <urn:nltl:generated-shape:I2-022-NonApplicablePlatingShape>
    ] .

<urn:nltl:generated-shape:I2-022-ApplicableShipShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node <urn:nltl:generated-shape:I2-022-ApplicablePlatingShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-022-StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
