@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gen:I2_026_StructuralMemberShape ;
        sh:message "Each structural member must provide support information needed to establish the applicable framing-member support condition."
    ] .

gen:I2_026_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMemberSupport ;
        sh:minCount 1 ;
        sh:node gen:I2_026_MemberSupportShape ;
        sh:message "A structural member must identify its member support."
    ] ;
    sh:property [
        sh:path nltl:continuousThroughSupport ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The structural member must state whether it is continuous through the support."
    ] ;
    sh:property [
        sh:path nltl:connectionBracketPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The member support must state whether a connection bracket is present."
    ] ;
    sh:property [
        sh:path nltl:demonstratedRotationalRestraint ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The member support must state whether significant rotational restraint is demonstrated."
    ] ;
    sh:property [
        sh:path nltl:terminatesWithinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The structural member must state whether it terminates within the ice-strengthened area."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:continuousThroughSupport ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:node [
                    sh:property [
                        sh:path nltl:frameSupportCondition ;
                        sh:hasValue nltl:fixedFrameSupport
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:connectionBracketPresent ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:node [
                    sh:property [
                        sh:path nltl:frameSupportCondition ;
                        sh:hasValue nltl:fixedFrameSupport
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:demonstratedRotationalRestraint ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:significantRotationalRestraintEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ]
            ] ;
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:node [
                    sh:property [
                        sh:path nltl:frameSupportCondition ;
                        sh:hasValue nltl:fixedFrameSupport
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:terminatesWithinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:node [
                    sh:property [
                        sh:path nltl:frameSupportCondition ;
                        sh:hasValue nltl:fixedFrameSupport
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:continuousThroughSupport ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:connectionBracketPresent ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:demonstratedRotationalRestraint ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:terminatesWithinIceStrengthenedArea ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:node [
                    sh:property [
                        sh:path nltl:frameSupportCondition ;
                        sh:hasValue nltl:simpleFrameSupport
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "The framing-member support condition must be fixed when continuity, a connection bracket, demonstrated rotational restraint, or termination within the ice-strengthened area applies; otherwise it must be simple." .

gen:I2_026_MemberSupportShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A member support must identify one frame support condition."
    ] .
