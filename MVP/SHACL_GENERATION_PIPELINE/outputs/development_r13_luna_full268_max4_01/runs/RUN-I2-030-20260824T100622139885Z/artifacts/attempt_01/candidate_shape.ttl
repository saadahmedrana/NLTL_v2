@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:QuantityValueDecimalShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMillimetreQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueDecimalShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthMetreQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueDecimalShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaCentiMetreQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueDecimalShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleDegreeQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueDecimalShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:node gen:QuantityValueDecimalShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:InterpolationPointShape
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each interpolation point requires one dimensionless coordinate."
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:node gen:QuantityValueDecimalShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each interpolation point requires one externally computed result."
    ] .

gen:StructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node [
            sh:node gen:QuantityValueDecimalShape ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each structural member requires one externally computed net effective plastic section modulus."
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:node gen:AreaCentiMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node gen:AngleDegreeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:node gen:LocalFrameSectionCalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "Each structural member requires a local-frame section calculation case."
    ] .

gen:PlatingShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node gen:AngleDegreeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The plating requires one framing angle omega to establish the applicable calculation branch."
    ] .

gen:LocalFrameSectionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:node gen:PlatingShape ;
        sh:minCount 1 ;
        sh:message "Each local-frame section calculation case requires its linked plating."
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "Each local-frame section calculation case requires its linked structural member."
    ] .

gen:CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node gen:LengthMillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each calculation case requires one externally computed plastic neutral axis height."
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:node gen:InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "Each calculation case requires an interpolation lower endpoint."
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:node gen:InterpolationPointShape ;
        sh:minCount 1 ;
        sh:message "Each calculation case requires an interpolation upper endpoint."
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1
    ] .

gen:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node gen:CalculationCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship requires a calculation case documenting the externally performed section assessment."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "The ship requires the structural member inputs used by the section assessment."
    ] .
