@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_046_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "polarClassRequirementsApplicable must be recorded exactly once as a boolean."
    ] ;
    sh:or (
        [
            sh:node gen:I2_046_ApplicableShipShape
        ]
        [
            sh:property [
                sh:path nltl:polarClassRequirementsApplicable ;
                sh:hasValue false ;
                sh:message "A non-applicable polar class requirement must be explicitly marked false."
            ]
        ]
    ) .

gen:I2_046_ApplicableShipShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:polarClassRequirementsApplicable ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "An applicable ship must provide exactly one valid polar class."
    ] ;
    sh:property [
        sh:path nltl:hasInternalIceStrengthenedStructure ;
        sh:class nltl:internalIceStrengthenedStructure ;
        sh:node gen:I2_046_InternalStructureShape ;
        sh:message "Every linked internal ice strengthened structure must satisfy the corrosion/abrasion addition requirement."
    ] .

gen:I2_046_InternalStructureShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:internalStructureCorrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_046_QuantityShape ;
        sh:message "Each applicable internal ice strengthened structure must have exactly one corrosion/abrasion addition."
    ] .

gen:I2_046_QuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:message "The corrosion/abrasion addition must be at least 1.0 mm."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:message "The corrosion/abrasion addition must use exactly one millimetre unit."
    ] .
