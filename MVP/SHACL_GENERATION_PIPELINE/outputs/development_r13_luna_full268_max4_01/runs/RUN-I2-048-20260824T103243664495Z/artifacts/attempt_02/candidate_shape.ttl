@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must have exactly one supported Polar Class."
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:node nltl:SteelGradeRequirementCaseShape ;
        sh:nodeKind sh:IRI
    ] .

<urn:nltl:generated-shape:I2-048-SteelGradeRequirementCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented steel-grade requirement case must identify exactly one plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Each steel-grade requirement case must have one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must have exactly one supported material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must have exactly one supported steel-strength category."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each steel-grade requirement case must have exactly one supported actual steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:maxCount 1 ;
        sh:message "An applicable table row must have at most one supported required steel grade."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required steel grade does not match the applicable IACS UR I2 Table 8 row, or a NOT_APPLICABLE row has a required grade." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness ?q ;
        nltl:steelMaterialClass ?mc ;
        nltl:steelStrengthCategory ?sc ;
        nltl:tableReference nltl:iacsUrI2Table8 .
  ?q qudt:numericValue ?th ;
     qudt:unit <http://qudt.org/vocab/unit/MilliM> .
  FILTER (
    !(
      (
        ?th <= 10 &&
        (
          (?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5) &&
           ?mc = nltl:steelMaterialClassOne &&
           ?sc = nltl:normalStrengthSteelCategory &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeB } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong1 . FILTER (?wrong1 != nltl:steelGradeB) })
          ||
          (?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5) &&
           ?mc = nltl:steelMaterialClassOne &&
           ?sc = nltl:highTensileSteelCategory &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeAh } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong2 . FILTER (?wrong2 != nltl:steelGradeAh) })
          ||
          (?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) &&
           ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) &&
           ?sc = nltl:normalStrengthSteelCategory &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeB } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong3 . FILTER (?wrong3 != nltl:steelGradeB) })
          ||
          (?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) &&
           ?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) &&
           ?sc = nltl:highTensileSteelCategory &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeAh } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong4 . FILTER (?wrong4 != nltl:steelGradeAh) })
          ||
          (?mc = nltl:steelMaterialClassThree &&
           ?sc = nltl:normalStrengthSteelCategory &&
           ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeE } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong5 . FILTER (?wrong5 != nltl:steelGradeE) })
          ||
          (?mc = nltl:steelMaterialClassThree &&
           ?sc = nltl:highTensileSteelCategory &&
           ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeEh } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong6 . FILTER (?wrong6 != nltl:steelGradeEh) })
          ||
          (?mc = nltl:steelMaterialClassThree &&
           ?sc = nltl:normalStrengthSteelCategory &&
           ?pc IN (nltl:polarClassPc4,nltl:polarClassPc5) &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeE } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong7 . FILTER (?wrong7 != nltl:steelGradeE) })
          ||
          (?mc = nltl:steelMaterialClassThree &&
           ?sc = nltl:highTensileSteelCategory &&
           ?pc IN (nltl:polarClassPc4,nltl:polarClassPc5) &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeEh } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong8 . FILTER (?wrong8 != nltl:steelGradeEh) })
          ||
          (?mc = nltl:steelMaterialClassThree &&
           ?sc = nltl:normalStrengthSteelCategory &&
           ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeB } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong9 . FILTER (?wrong9 != nltl:steelGradeB) })
          ||
          (?mc = nltl:steelMaterialClassThree &&
           ?sc = nltl:highTensileSteelCategory &&
           ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeAh } &&
           NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?wrong10 . FILTER (?wrong10 != nltl:steelGradeAh) })
        )
      )
      ||
      (
        ?th > 10 && ?th <= 15 &&
        (
          (?mc = nltl:steelMaterialClassTwo && ?sc = nltl:normalStrengthSteelCategory &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeD })
          ||
          (?mc = nltl:steelMaterialClassTwo && ?sc = nltl:highTensileSteelCategory &&
           EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeDh })
        )
      )
      ||
      (
        ?th > 15 && ?th <= 35 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) &&
        EXISTS { $this nltl:requiredHullStructuralSteelGrade nltl:steelGradeE }
      )
      ||
      (
        ?th > 35 && ?th <= 45 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) &&
        NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?na }
      )
      ||
      (
        ?th > 45 && ?th <= 50 &&
        ?mc = nltl:steelMaterialClassThree &&
        ?sc = nltl:normalStrengthSteelCategory &&
        ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5) &&
        NOT EXISTS { $this nltl:requiredHullStructuralSteelGrade ?na2 }
      )
    )
  )
}
""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual steel grade must be at least the required grade within the same steel-strength family." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  $this nltl:actualHullStructuralSteelGrade ?actual ;
        nltl:requiredHullStructuralSteelGrade ?required ;
        nltl:steelStrengthCategory ?category .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  ?required nltl:steelGradeOrderRank ?requiredRank .
  FILTER (
    !(
      (
        ?category = nltl:normalStrengthSteelCategory &&
        ?actual IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE) &&
        ?required IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE) &&
        ?actualRank >= ?requiredRank
      )
      ||
      (
        ?category = nltl:highTensileSteelCategory &&
        ?actual IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh) &&
        ?required IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh) &&
        ?actualRank >= ?requiredRank
      )
    )
  )
}
""" ;
    ] .
