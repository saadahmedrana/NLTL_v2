@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-048-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        )
    ] ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:node <urn:nltl:generated-shape:I2-048-CaseShape>
    ] .

<urn:nltl:generated-shape:I2-048-CaseShape>
    a sh:NodeShape ;
    sh:class nltl:steelGradeRequirementCase ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:iacsUrI2Table8
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        )
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:highTensileSteelCategory
            nltl:normalStrengthSteelCategory
        )
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:maxCount 1 ;
        sh:in (
            nltl:steelGradeAh
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeDh
            nltl:steelGradeE
            nltl:steelGradeEh
            nltl:steelGradeFh
        )
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:node [
            a sh:NodeShape ;
            sh:class nltl:steelGradeValue ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:node [
            a sh:NodeShape ;
            sh:class nltl:steelGradeValue ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable Table 8 selection is missing or has the wrong required steel grade." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness/qudt:numericValue ?t ;
        nltl:steelMaterialClass ?mc ;
        nltl:steelStrengthCategory ?sc .
  FILTER(?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,
                 nltl:polarClassPc4,nltl:polarClassPc5))
  FILTER(?t <= 50)
  FILTER NOT EXISTS {
    $this nltl:requiredHullStructuralSteelGrade ?grade .
    FILTER(
      (
        ?grade = nltl:steelGradeB &&
        ?sc = nltl:normalStrengthSteelCategory &&
        (
          (?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?t <= 15) ||
          (?mc = nltl:steelMaterialClassThree && ?t <= 10)
        )
      ) ||
      (
        ?grade = nltl:steelGradeAh &&
        ?sc = nltl:highTensileSteelCategory &&
        (
          (?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?t <= 15) ||
          (?mc = nltl:steelMaterialClassThree && ?t <= 10)
        )
      ) ||
      (
        ?grade = nltl:steelGradeD &&
        ?sc = nltl:normalStrengthSteelCategory &&
        (
          (?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?t > 10 && ?t <= 35) ||
          (?mc = nltl:steelMaterialClassThree && ?t > 10 && ?t <= 35) ||
          (?mc = nltl:steelMaterialClassOne && ?t > 15 && ?t <= 40)
        )
      ) ||
      (
        ?grade = nltl:steelGradeDh &&
        ?sc = nltl:highTensileSteelCategory &&
        (
          (?mc IN (nltl:steelMaterialClassOne,nltl:steelMaterialClassTwo) && ?t > 10 && ?t <= 35) ||
          (?mc = nltl:steelMaterialClassThree && ?t > 10 && ?t <= 35) ||
          (?mc = nltl:steelMaterialClassOne && ?t > 15 && ?t <= 40)
        )
      ) ||
      (
        ?grade = nltl:steelGradeE &&
        ?sc = nltl:normalStrengthSteelCategory &&
        (
          (?mc = nltl:steelMaterialClassTwo && ?t > 30) ||
          (?mc = nltl:steelMaterialClassOne && ?t > 40) ||
          (?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5) && ?t <= 35) ||
          (?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) && ?t > 35)
        )
      ) ||
      (
        ?grade = nltl:steelGradeEh &&
        ?sc = nltl:highTensileSteelCategory &&
        (
          (?mc = nltl:steelMaterialClassTwo && ?t > 30) ||
          (?mc = nltl:steelMaterialClassOne && ?t > 40) ||
          (?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3,nltl:polarClassPc4,nltl:polarClassPc5) && ?t <= 35) ||
          (?mc = nltl:steelMaterialClassThree && ?pc IN (nltl:polarClassPc6,nltl:polarClassPc7) && ?t > 35)
        )
      ) ||
      (
        ?grade = nltl:steelGradeFh &&
        ?sc = nltl:highTensileSteelCategory &&
        ?mc = nltl:steelMaterialClassThree &&
        (
          (?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) && ?t > 35) ||
          (?pc IN (nltl:polarClassPc4,nltl:polarClassPc5) && ?t > 40)
        )
      )
    )
  }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A NOT_APPLICABLE Table 8 combination must not contain a required steel grade." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  ?ship nltl:hasSteelGradeRequirementCase $this ;
        nltl:polarClass ?pc .
  $this nltl:asBuiltPlateThickness/qudt:numericValue ?t ;
        nltl:steelMaterialClass nltl:steelMaterialClassThree ;
        nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
        nltl:requiredHullStructuralSteelGrade ?grade .
  FILTER(
    (?pc IN (nltl:polarClassPc1,nltl:polarClassPc2,nltl:polarClassPc3) &&
     ?t > 35 && ?t <= 50) ||
    (?pc IN (nltl:polarClassPc4,nltl:polarClassPc5) &&
     ?t > 40 && ?t <= 50)
  )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The actual steel grade must rank at least as high as the required grade within the same steel strength category." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
  $this nltl:steelStrengthCategory ?sc ;
        nltl:actualHullStructuralSteelGrade ?actual ;
        nltl:requiredHullStructuralSteelGrade ?required .
  ?actual nltl:steelGradeOrderRank ?actualRank .
  ?required nltl:steelGradeOrderRank ?requiredRank .
  FILTER(
    (?sc = nltl:highTensileSteelCategory &&
     (?actual NOT IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh) ||
      ?required NOT IN (nltl:steelGradeAh,nltl:steelGradeDh,nltl:steelGradeEh,nltl:steelGradeFh) ||
      ?actualRank < ?requiredRank)) ||
    (?sc = nltl:normalStrengthSteelCategory &&
     (?actual NOT IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE) ||
      ?required NOT IN (nltl:steelGradeB,nltl:steelGradeD,nltl:steelGradeE) ||
      ?actualRank < ?requiredRank))
  )
}
"""
    ] .
