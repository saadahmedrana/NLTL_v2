@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-064-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-064-YieldStrengthShape> ;
        sh:message "The ship shall provide one yield-strength value in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-064-CalculationCaseShape> ;
        sh:message "The ship shall identify an applicable linear calculation case."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-064-YieldStrengthShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-064-CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:linearCalculationMethodValue ;
        sh:message "The applicable calculation case shall identify the linear calculation method."
    ] .

<urn:nltl:generated-shape:I2-064-StructuralMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasStructuralMemberWeb ;
        sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberWebShape>
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberFlange ;
        sh:node <urn:nltl:generated-shape:I2-064-StructuralMemberFlangeShape>
    ] .

<urn:nltl:generated-shape:I2-064-StructuralMemberWebShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMemberWeb ;
    sh:property [
        sh:path nltl:nominalShearStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-064-StressQuantityShape> ;
        sh:message "Each represented structural-member web shall provide one nominal shear stress in MPa."
    ] ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The buckling criteria shall be satisfied for each represented structural-member web."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Nominal shear stress shall be less than yield strength divided by square root of three." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb $this .
                ?ship nltl:yieldStrength ?yield .
                ?yield qudt:numericValue ?yieldValue ;
                       qudt:unit unit:MegaPA .
                $this nltl:nominalShearStress ?stress .
                ?stress qudt:numericValue ?stressValue ;
                        qudt:unit unit:MegaPA .
                FILTER (?stressValue >= (?yieldValue / 1.7320508075688772))
            }
        """
    ] .

<urn:nltl:generated-shape:I2-064-StructuralMemberFlangeShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMemberFlange ;
    sh:property [
        sh:path nltl:nominalFlangeVonMisesStress ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-064-StressQuantityShape> ;
        sh:message "Each represented structural-member flange shall provide one nominal von Mises stress in MPa."
    ] ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The buckling criteria shall be satisfied for each represented structural-member flange."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Nominal flange von Mises stress shall be less than 1.15 times yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange $this .
                ?ship nltl:yieldStrength ?yield .
                ?yield qudt:numericValue ?yieldValue ;
                       qudt:unit unit:MegaPA .
                $this nltl:nominalFlangeVonMisesStress ?stress .
                ?stress qudt:numericValue ?stressValue ;
                        qudt:unit unit:MegaPA .
                FILTER (?stressValue >= (1.15 * ?yieldValue))
            }
        """
    ] .

<urn:nltl:generated-shape:I2-064-StressQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
