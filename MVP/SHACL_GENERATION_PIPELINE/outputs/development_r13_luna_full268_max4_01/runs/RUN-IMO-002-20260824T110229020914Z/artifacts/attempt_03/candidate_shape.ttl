@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO002ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryA
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryA
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:not [
                    sh:hasValue nltl:thinFirstYearIceWithPossibleOldIceInclusions
                ] ;
                sh:not [
                    sh:hasValue nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "A ship designed for at least thin first-year ice with possible old-ice inclusions must be category B unless it is category A." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?ice .
                FILTER (
                    ?ice = nltl:thinFirstYearIceWithPossibleOldIceInclusions ||
                    ?ice = nltl:mediumFirstYearIceWithPossibleOldIceInclusions
                )
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryA
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryB
                    } ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (?category != nltl:polarShipCategoryB)
                    }
                )
            }
        """
    ] .
