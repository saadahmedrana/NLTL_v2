@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

g:IMO_003_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must declare its design ice condition."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:openWaterIceCondition
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarShipCategoryValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:message "A ship designed for open water must have Polar Code category C."
            ]
        ]
        [
            sh:property [
                sh:path nltl:designIceCondition ;
                sh:hasValue nltl:iceConditionLessSevereThanCategoryAAndB
            ] ;
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarShipCategoryValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue nltl:polarShipCategoryC ;
                sh:message "A ship designed for ice conditions less severe than categories A and B must have Polar Code category C."
            ]
        ]
    ) .
