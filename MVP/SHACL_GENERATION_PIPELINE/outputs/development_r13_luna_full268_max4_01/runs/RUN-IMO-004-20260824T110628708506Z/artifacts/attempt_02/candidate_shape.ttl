@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-004> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:winterGrowthCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Winter growth count must be a single integer when provided."
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1 ;
                sh:message "Ice thickness numeric value must be a single decimal."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:maxCount 1 ;
                sh:message "Ice thickness must use the canonical metre unit."
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For sea ice with no more than one winter growth and thickness from 0.3 m through 2.0 m inclusive, ice type classification must be exactly first-year ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceOriginType nltl:seaIceOrigin ;
                       nltl:winterGrowthCount ?growth ;
                       nltl:iceThickness ?thickness .

                ?thickness qudt:numericValue ?numeric ;
                           qudt:unit unit:M .

                FILTER (datatype(?growth) = xsd:integer)
                FILTER (?growth <= 1)
                FILTER (datatype(?numeric) = xsd:decimal)
                FILTER (?numeric >= "0.3"^^xsd:decimal)
                FILTER (?numeric <= "2.0"^^xsd:decimal)

                FILTER (
                    NOT EXISTS {
                        $this nltl:iceTypeClassification nltl:firstYearIce
                    }
                    ||
                    EXISTS {
                        $this nltl:iceTypeClassification ?classification .
                        FILTER (?classification != nltl:firstYearIce)
                    }
                )
            }
        """
    ]
.
