@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO005IceConditionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide one ice condition." ;
    ] ;
    sh:property [
        sh:path nltl:totalIcePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ship must provide one total-ice-presence observation." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice condition 'ice free waters' is permitted only when total ice present is false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:totalIcePresent ?present ;
                      nltl:iceCondition ?condition .
                FILTER (
                    DATATYPE(?present) = xsd:boolean &&
                    ?present = true &&
                    STR(?condition) = "ice free waters"
                )
            }
        """ ;
    ] .
