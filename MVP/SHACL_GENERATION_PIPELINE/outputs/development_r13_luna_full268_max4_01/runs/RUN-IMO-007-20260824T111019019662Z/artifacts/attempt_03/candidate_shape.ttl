@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_007_OpenWaterConditionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the ice condition is open water, sea ice concentration must be a decimal below 1 with unit UNITLESS, and ice of land origin must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceConditionClassification nltl:openWaterIceCondition .
                FILTER (
                    NOT EXISTS {
                        $this nltl:seaIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?numericValue ;
                            qudt:unit unit:UNITLESS .
                        FILTER (
                            datatype(?numericValue) = xsd:decimal &&
                            ?numericValue < 1
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:iceOfLandOriginPresent ?landOriginPresent .
                        FILTER (
                            datatype(?landOriginPresent) = xsd:boolean &&
                            ?landOriginPresent = false
                        )
                    }
                )
            }
        """ ;
    ] .
