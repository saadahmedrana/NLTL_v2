@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-018> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceCapabilityMethodologyApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The applicability decision must be true for this branch."
            ] ;
            sh:property [
                sh:path nltl:certificateMethodologyReferencePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice capability methodology is applicable, the certificate must reference the methodology."
            ] ;
            sh:property [
                sh:path nltl:administrationAcceptanceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice capability methodology is applicable, Administration acceptance must be recorded as approved."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCapabilityMethodologyApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
    ) .
