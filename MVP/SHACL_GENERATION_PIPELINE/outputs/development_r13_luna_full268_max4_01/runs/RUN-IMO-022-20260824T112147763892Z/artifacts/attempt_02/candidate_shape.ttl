@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-022-PWOMFunctionalRequirementsShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall record that a Polar Water Operational Manual is present."
    ] ;
    sh:property [
        sh:path nltl:capabilitiesSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The PWOM shall include ship-specific capabilities."
    ] ;
    sh:property [
        sh:path nltl:limitationsSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The PWOM shall include ship-specific limitations."
    ] ;
    sh:property [
        sh:path nltl:operationalAssessmentReference ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "(^|[^0-9])1[.]5([^0-9]|$)" ;
        sh:message "The PWOM operational assessment reference shall identify paragraph 1.5."
    ] .
