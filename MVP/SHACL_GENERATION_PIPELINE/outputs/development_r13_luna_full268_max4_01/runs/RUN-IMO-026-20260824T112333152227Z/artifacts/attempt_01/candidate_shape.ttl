@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_026_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCapabilityMethodologyApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must state whether the ice capability methodology is applicable."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceCapabilityMethodologyApplicable ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceCapabilityMethodologyApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:polarWaterOperationalManualIceCapabilityMethodologyPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When the ice capability methodology is applicable, the PWOM must contain that methodology."
            ]
        ]
    ) .
