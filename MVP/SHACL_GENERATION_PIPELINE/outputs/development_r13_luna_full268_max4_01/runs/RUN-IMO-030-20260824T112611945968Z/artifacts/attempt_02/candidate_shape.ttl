@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO030Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO030NotApplicable
        gen:IMO030Applicable
    ) .

gen:IMO030NotApplicable a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "iceOperationApplicable must be explicitly false when the ice-operation procedure constraint is not applicable."
    ] .

gen:IMO030Applicable a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceOperationApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "iceOperationApplicable must be explicitly true to apply the ice-operation procedure constraint."
    ] ;
    sh:property [
        sh:path nltl:iceSafetyMonitoringProcedurePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Ice-operation monitoring and safety procedures must be present."
    ] ;
    sh:property [
        sh:path nltl:escortRequirementsPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Applicable escort or icebreaker-assistance requirements must be present."
    ] ;
    sh:or (
        gen:IMO030IndependentLimits
        gen:IMO030EscortedLimits
    ) .

gen:IMO030IndependentLimits a sh:NodeShape ;
    sh:property [
        sh:path nltl:independentOperationLimits ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Independent-operation limitations must be specified when that operating mode applies."
    ] .

gen:IMO030EscortedLimits a sh:NodeShape ;
    sh:property [
        sh:path nltl:escortedOperationLimits ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Escorted-operation limitations must be specified when that operating mode applies."
    ] .
