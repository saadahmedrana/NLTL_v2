@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-031> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:exposedStructureMaterial ;
        sh:datatype xsd:string ;
        sh:message "Each represented exposed-structure material must be recorded as a string."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"^^xsd:string
            "recognized organization accepted by the Administration"^^xsd:string
        ) ;
        sh:message "The approving authority must be the Administration or a recognized organization accepted by the Administration."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"^^xsd:string
            "another standard offering an equivalent level of safety"^^xsd:string
        ) ;
        sh:message "The approval standard must be acceptable to the Organization or offer an equivalent level of safety."
    ] ;
    sh:property [
        sh:path nltl:materialApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The material approval status must be Approved."
    ] ;
    sh:property [
        sh:path nltl:polarServiceTemperature ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The polar service temperature must be a decimal quantity expressed in degrees Celsius."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When an exposed-structure material is represented, approving authority, approval standard, approved status, and polar service temperature must be provided for its approval basis." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:exposedStructureMaterial ?material .
                }
                FILTER NOT EXISTS {
                    $this nltl:approvingAuthority ?authority ;
                          nltl:approvalStandard ?standard ;
                          nltl:materialApprovalStatus nltl:evidenceStateApproved ;
                          nltl:polarServiceTemperature ?temperature .
                }
            }
        """
    ] .
