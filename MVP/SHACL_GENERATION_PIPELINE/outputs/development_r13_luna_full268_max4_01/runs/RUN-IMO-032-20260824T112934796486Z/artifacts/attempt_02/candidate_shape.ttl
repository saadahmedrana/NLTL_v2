@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ApprovalABShape a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:message "The scantling approval record must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1 ;
        sh:message "The scantling approval must be by the Administration or an accepted recognized organization."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:minCount 1 ;
        sh:message "The approval standard must be Organization-acceptable or offer an equivalent level of safety."
    ] .

gen:ApprovalCShape a sh:NodeShape ;
    sh:class nltl:approvalRecord ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:minCount 1 ;
        sh:message "The scantling approval record must have approved status."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:minCount 1 ;
        sh:message "The scantling approval must be by the Administration or an accepted recognized organization."
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:hasValue "acceptable standard adequate for operating ice type and concentration" ;
        sh:minCount 1 ;
        sh:message "The Category C approval standard must be adequate for the operating ice type and concentration."
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Ice-strengthened Category C approval must state the operating ice type."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Ice-strengthened Category C approval must state the dimensionless operating ice concentration."
    ] .

gen:CategoryABBranchShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:class nltl:approvalRecord ;
        sh:node gen:ApprovalABShape ;
        sh:minCount 1 ;
        sh:message "Category A or B ships must have a conforming scantling approval record."
    ] .

gen:CategoryCIceStrengthenedBranchShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:hasValue true ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:class nltl:approvalRecord ;
        sh:node gen:ApprovalCShape ;
        sh:minCount 1 ;
        sh:message "Ice-strengthened Category C ships must have a conforming scantling approval record with operating-area ice context."
    ] .

gen:CategoryCNotIceStrengthenedBranchShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:hasValue nltl:polarShipCategoryC ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:hasValue false ;
        sh:minCount 1
    ] .

gen:IMO032ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:message "The ship category is required to determine the applicable approval branch."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ice-strengthening status is required to determine Category C applicability."
    ] ;
    sh:or (
        gen:CategoryABBranchShape
        gen:CategoryCIceStrengthenedBranchShape
        gen:CategoryCNotIceStrengthenedBranchShape
    ) .
