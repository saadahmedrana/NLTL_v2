@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO043ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node gs:IMO043InstallationShape ;
        sh:class nltl:machineryInstallationItem ;
        sh:message "Each linked machinery installation must satisfy the applicable-hazard and protection-evidence constraints."
    ] .

gs:IMO043InstallationShape
    a sh:NodeShape ;
    sh:targetClass nltl:machineryInstallationItem ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:node gs:IMO043AssociatedEquipmentShape ;
        sh:class nltl:associatedEquipmentItem
    ] ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:class nltl:applicableHazardValue ;
        sh:minCount 1 ;
        sh:message "A machinery installation must identify at least one applicable controlled hazard."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "A machinery installation with applicable hazards must have protection evidence."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every applicable hazard must be one of the six controlled Polar Code hazard alternatives." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:hasApplicableHazard ?hazard .
                FILTER (
                    ?hazard NOT IN (
                        nltl:iceAccretionHazard,
                        nltl:snowAccumulationHazard,
                        nltl:seawaterIceIngestionHazard,
                        nltl:liquidFreezingOrViscosityIncreaseHazard,
                        nltl:seawaterIntakeTemperatureHazard,
                        nltl:snowIngestionHazard
                    )
                )
            }
        """
    ] .

gs:IMO043AssociatedEquipmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:associatedEquipmentItem ;
    sh:class nltl:associatedEquipmentItem .
