@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO047TemperatureQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A temperature quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A temperature quantity must use the canonical Celsius unit."
    ] .

gen:IMO047Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasEssentialEngine ;
        sh:class nltl:essentialEngine ;
        sh:minCount 1 ;
        sh:message "The ship must identify its essential engine for this requirement."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperatureControlPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Combustion-air temperature control must be present."
    ] ;
    sh:property [
        sh:path nltl:combustionAirTemperature ;
        sh:node gen:IMO047TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The combustion-air temperature must be recorded in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMinAirTemperature ;
        sh:node gen:IMO047TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The manufacturer's minimum air-temperature criterion must be recorded in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:manufacturerMaxAirTemperature ;
        sh:node gen:IMO047TemperatureQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The manufacturer's maximum air-temperature criterion must be recorded in degrees Celsius."
    ] ;
    sh:sparql [
        sh:message "The combustion-air temperature must be within the manufacturer's inclusive minimum and maximum criteria." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:combustionAirTemperature ?temperatureNode .
    $this nltl:manufacturerMinAirTemperature ?minimumNode .
    $this nltl:manufacturerMaxAirTemperature ?maximumNode .
    ?temperatureNode qudt:numericValue ?temperatureValue .
    ?minimumNode qudt:numericValue ?minimumValue .
    ?maximumNode qudt:numericValue ?maximumValue .
    FILTER (
        ?minimumValue > ?maximumValue ||
        ?temperatureValue < ?minimumValue ||
        ?temperatureValue > ?maximumValue
    )
}
"""
    ] .
