@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_047_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For each linked essential engine, combustion-air temperature control must be present and true, and the combustion-air temperature must be within the single manufacturer-specified inclusive Celsius range." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasEssentialEngine ?engine .

                FILTER (
                    NOT EXISTS {
                        $this nltl:combustionAirTemperatureControlPresent ?control .
                        FILTER (
                            datatype(?control) = xsd:boolean &&
                            ?control = true
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:combustionAirTemperatureControlPresent ?control1 .
                        $this nltl:combustionAirTemperatureControlPresent ?control2 .
                        FILTER (?control1 != ?control2)
                    }
                    ||
                    EXISTS {
                        $this nltl:combustionAirTemperature ?temp1 .
                        $this nltl:combustionAirTemperature ?temp2 .
                        FILTER (?temp1 != ?temp2)
                    }
                    ||
                    EXISTS {
                        $this nltl:manufacturerMinAirTemperature ?min1 .
                        $this nltl:manufacturerMinAirTemperature ?min2 .
                        FILTER (?min1 != ?min2)
                    }
                    ||
                    EXISTS {
                        $this nltl:manufacturerMaxAirTemperature ?max1 .
                        $this nltl:manufacturerMaxAirTemperature ?max2 .
                        FILTER (?max1 != ?max2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:combustionAirTemperature ?temp .
                        $this nltl:manufacturerMinAirTemperature ?min .
                        $this nltl:manufacturerMaxAirTemperature ?max .

                        ?temp qudt:numericValue ?temperatureValue ;
                              qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                        ?min qudt:numericValue ?minimumValue ;
                             qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                        ?max qudt:numericValue ?maximumValue ;
                             qudt:unit <http://qudt.org/vocab/unit/DEG_C> .

                        FILTER (
                            datatype(?temperatureValue) = xsd:decimal &&
                            datatype(?minimumValue) = xsd:decimal &&
                            datatype(?maximumValue) = xsd:decimal &&
                            ?temperatureValue >= ?minimumValue &&
                            ?temperatureValue <= ?maximumValue
                        )
                    }
                )
            }
        """
    ] .
