@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-049-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machineryComponentType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must identify the applicable machinery component type." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryA ;
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-049-category-ab-component> ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryB ;
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-049-category-ab-component> ;
            ] ;
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:hasValue nltl:polarShipCategoryC ;
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:hasComponent ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:IMO-049-category-c-component> ;
            ] ;
        ]
    ) ;
    sh:message "The ship must satisfy the applicable category-conditioned scantling approval requirements." .

<urn:nltl:generated-shape:IMO-049-category-ab-component> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:class nltl:approvalRecord ;
        sh:node <urn:nltl:generated-shape:IMO-049-category-ab-approval> ;
        sh:message "Each applicable machinery component must have approval evidence." ;
    ] .

<urn:nltl:generated-shape:IMO-049-category-ab-approval> a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The scantling approval evidence must have approved status." ;
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "Approval must be issued by the Administration or a recognized organization accepted by it." ;
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        ) ;
        sh:message "Approval must use an Organization-acceptable standard or an equivalent-safety standard." ;
    ] .

<urn:nltl:generated-shape:IMO-049-category-c-component> a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:class nltl:approvalRecord ;
        sh:node <urn:nltl:generated-shape:IMO-049-category-c-approval> ;
        sh:message "Each applicable machinery component must have approval evidence." ;
    ] .

<urn:nltl:generated-shape:IMO-049-category-c-approval> a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:hasValue nltl:evidenceStateApproved ;
        sh:message "The scantling approval evidence must have approved status." ;
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        ) ;
        sh:message "Approval must be issued by the Administration or a recognized organization accepted by it." ;
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Category C approval must use an acceptable standard adequate for the operating ice conditions." ;
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Category C approval evidence must identify the operating ice type." ;
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue qudt:UNITLESS ;
            ]
        ] ;
        sh:message "Category C approval evidence must identify the operating ice concentration as a dimensionless quantity." ;
    ] .
