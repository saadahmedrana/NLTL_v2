@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO_059_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node [
            sh:class nltl:equipmentItem ;
            sh:property [
                sh:path nltl:hasStorageLocation ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:physicalStorageLocation ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:storageTemperatureClass ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:storageTemperatureClassValue ;
                        sh:hasValue nltl:warmStorageLocation ;
                        sh:minCount 1 ;
                        sh:message "Each firefighter outfit must be stored at a warm-class storage location."
                    ]
                ] ;
                sh:message "Each firefighter outfit must have a storage location."
            ]
        ]
    ] .
