@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_062_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:accessibleStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record accessible status as true."
    ] ;
    sh:property [
        sh:path nltl:safeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record safe status as true."
    ] ;
    sh:property [
        sh:path nltl:iceSnowMitigationCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record ice and snow mitigation coverage as true."
    ] ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:node gen:IMO_062_ExposedEscapeRouteShape
    ] .

gen:IMO_062_ExposedEscapeRouteShape a sh:NodeShape ;
    sh:class nltl:exposedEscapeRoute ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each exposed escape route must have documented ice and snow mitigation evidence."
    ] .
