@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-062-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:node <urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape>
    ] .

<urn:nltl:generated-shape:IMO-062-ExposedEscapeRouteShape>
    a sh:NodeShape ;
    sh:targetClass nltl:exposedEscapeRoute ;
    sh:property [
        sh:path nltl:escapeRouteAccessibleStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each exposed escape route must be accessible."
    ] ;
    sh:property [
        sh:path nltl:escapeRouteSafeStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each exposed escape route must be safe."
    ] ;
    sh:property [
        sh:path nltl:hasEscapeRouteIceSnowMitigationEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each exposed escape route must have documented ice and snow mitigation evidence."
    ] .
