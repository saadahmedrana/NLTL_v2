@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-070-ship>
    a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each passenger ship must indicate that the assigned survival equipment is properly sized."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:node [
            a sh:NodeShape ;
            sh:class nltl:personOnBoardMember ;
            sh:property [
                sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class nltl:personalSurvivalEquipmentAssignment ;
                    sh:property [
                        sh:path nltl:assignedPersonalSurvivalEquipment ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:or (
                            [
                                sh:class nltl:immersionSuitEquipment
                            ]
                            [
                                sh:class nltl:thermalProtectiveAidEquipment
                            ]
                        ) ;
                        sh:message "Each person on board must have one properly sized immersion suit or one thermal protective aid."
                    ]
                ] ;
                sh:message "Each person on board must have a personal survival equipment assignment."
            ]
        ]
    ] .
