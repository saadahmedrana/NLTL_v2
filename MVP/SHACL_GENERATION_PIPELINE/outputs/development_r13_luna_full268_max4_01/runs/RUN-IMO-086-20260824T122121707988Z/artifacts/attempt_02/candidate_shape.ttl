@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:IMO_086_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 2 ;
        sh:message "The ship shall have at least two non-magnetic heading means."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each non-magnetic heading means shall be connected to the target ship's main and emergency power sources and shall be independent from another distinct heading means on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .

                FILTER NOT EXISTS {
                    ?means nltl:connectedToMainPower ?mainPower .
                    $this nltl:connectedToMainPower ?mainPower .
                }

                FILTER NOT EXISTS {
                    ?means nltl:connectedToEmergencyPower ?emergencyPower .
                    $this nltl:connectedToEmergencyPower ?emergencyPower .
                }

                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?otherMeans .
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                }
            }
        """
    ] .
