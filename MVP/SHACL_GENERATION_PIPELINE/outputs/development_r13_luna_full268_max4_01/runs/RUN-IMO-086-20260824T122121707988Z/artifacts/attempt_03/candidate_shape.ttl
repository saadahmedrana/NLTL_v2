@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-086-ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 2 ;
        sh:node <urn:nltl:generated-shape:IMO-086-HeadingMeansShape> ;
        sh:message "The ship shall have at least two non-magnetic heading means, each satisfying the required connections and independence relationship."
    ] ;
    sh:sparql [
        sh:message "Each selected non-magnetic heading means shall be independent from another distinct heading means belonging to the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?means .
                    FILTER NOT EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?other .
                        FILTER (?other != ?means)
                        ?means nltl:independentFromHeadingMeans ?other .
                    }
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-086-HeadingMeansShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectedToMainPower ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each non-magnetic heading means shall have a main-power connection."
    ] ;
    sh:property [
        sh:path nltl:connectedToEmergencyPower ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each non-magnetic heading means shall have an emergency-power connection."
    ] ;
    sh:property [
        sh:path nltl:independentFromHeadingMeans ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:nonMagneticHeadingMeans ;
        sh:minCount 1 ;
        sh:message "Each non-magnetic heading means shall identify an independent heading means."
    ] .
