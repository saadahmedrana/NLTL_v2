@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_087_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:plannedOrActualLatitude ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "0"^^xsd:decimal ;
                        sh:maxInclusive "80"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:plannedOrActualLatitude ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minExclusive "80"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:gnssCompassOrEquivalentCount ;
                sh:minCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:message "Ships proceeding over 80 degrees require at least one GNSS compass or equivalent."
            ] ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:minCount 1 ;
                sh:node nltl:benchmarkEntity ;
                sh:message "The GNSS compass or equivalent must be connected to the ship's main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:minCount 1 ;
                sh:node nltl:benchmarkEntity ;
                sh:message "The GNSS compass or equivalent must be connected to the ship's emergency power."
            ]
        ]
    ) .
