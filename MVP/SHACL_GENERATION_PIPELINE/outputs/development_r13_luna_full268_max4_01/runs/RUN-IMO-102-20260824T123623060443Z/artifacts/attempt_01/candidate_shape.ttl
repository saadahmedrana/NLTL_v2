@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-102-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceConditionClassification ;
        sh:class nltl:iceConditionValue ;
        sh:in (
            nltl:iceFreeIceCondition
            nltl:openWaterIceCondition
            nltl:otherWatersIceCondition
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one controlled ice condition classification."
    ] ;
    sh:property [
        sh:path nltl:polarTrainingShipTypeClassification ;
        sh:class nltl:polarTrainingShipTypeValue ;
        sh:in (
            nltl:tankerPolarTrainingShipType
            nltl:passengerShipPolarTrainingShipType
            nltl:otherShipPolarTrainingType
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one controlled polar training ship type."
    ] .

<urn:nltl:generated-shape:IMO-102-CrewMemberShape>
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasCrewMemberInventory ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:polarTrainingCrewRoleClassification ;
        sh:class nltl:polarTrainingCrewRoleValue ;
        sh:in (
            nltl:masterPolarTrainingRole
            nltl:chiefMatePolarTrainingRole
            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented crew member must have exactly one controlled polar training role."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicable crew member must have a training record whose required and recorded training levels match the 12.3.1 matrix and whose STCW qualification is valid." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                ?ship nltl:hasCrewMemberInventory $this ;
                      nltl:iceConditionClassification ?ice ;
                      nltl:polarTrainingShipTypeClassification ?shipType .
                $this nltl:polarTrainingCrewRoleClassification ?role .

                FILTER (
                    (
                        ?ice = nltl:openWaterIceCondition &&
                        ?shipType IN (
                            nltl:tankerPolarTrainingShipType,
                            nltl:passengerShipPolarTrainingShipType
                        )
                    ) ||
                    (
                        ?ice = nltl:otherWatersIceCondition &&
                        ?role IN (
                            nltl:masterPolarTrainingRole,
                            nltl:chiefMatePolarTrainingRole,
                            nltl:officerInChargeOfNavigationalWatchPolarTrainingRole
                        )
                    )
                )

                FILTER NOT EXISTS {
                    $this (
                        nltl:hasCrewTrainingRecord |
                        nltl:hasPolarTrainingRecord
                    ) ?record .
                    ?record nltl:requiredTrainingLevel ?requiredLevel ;
                            nltl:trainingRecordLevel ?recordedLevel ;
                            nltl:stcwQualificationValid true .

                    FILTER (
                        (
                            ?ice = nltl:openWaterIceCondition &&
                            ?shipType IN (
                                nltl:tankerPolarTrainingShipType,
                                nltl:passengerShipPolarTrainingShipType
                            ) &&
                            ?requiredLevel = nltl:basicPolarTrainingLevel &&
                            ?recordedLevel = nltl:basicPolarTrainingLevel
                        ) ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role IN (
                                nltl:masterPolarTrainingRole,
                                nltl:chiefMatePolarTrainingRole
                            ) &&
                            ?requiredLevel = nltl:advancedPolarTrainingLevel &&
                            ?recordedLevel = nltl:advancedPolarTrainingLevel
                        ) ||
                        (
                            ?ice = nltl:otherWatersIceCondition &&
                            ?role = nltl:officerInChargeOfNavigationalWatchPolarTrainingRole &&
                            ?requiredLevel = nltl:basicPolarTrainingLevel &&
                            ?recordedLevel = nltl:basicPolarTrainingLevel
                        )
                    )
                }
            }
        """
    ] .

<urn:nltl:generated-shape:IMO-102-PolarTrainingRecordShape>
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasCrewTrainingRecord ;
    sh:targetObjectsOf nltl:hasPolarTrainingRecord ;
    sh:class nltl:polarTrainingRecord ;
    sh:property [
        sh:path nltl:requiredTrainingLevel ;
        sh:class nltl:trainingLevelValue ;
        sh:in (
            nltl:basicPolarTrainingLevel
            nltl:advancedPolarTrainingLevel
            nltl:polarTrainingNotApplicable
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A polar training record must have exactly one controlled required training level."
    ] ;
    sh:property [
        sh:path nltl:trainingRecordLevel ;
        sh:class nltl:trainingLevelValue ;
        sh:in (
            nltl:basicPolarTrainingLevel
            nltl:advancedPolarTrainingLevel
            nltl:polarTrainingNotApplicable
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A polar training record must have exactly one controlled recorded training level."
    ] ;
    sh:property [
        sh:path nltl:stcwQualificationValid ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A polar training record must state exactly one STCW qualification validity value."
    ] .
