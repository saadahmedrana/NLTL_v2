@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_103_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:alternateQualifiedPersonUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The alternate-qualified-person applicability status must be recorded as a single boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:alternateQualifiedPersonUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:administrationPermissionStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Administration permission must be approved when an alternate qualified person is used."
            ] ;
            sh:property [
                sh:path nltl:stcwConventionRegulationIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "STCW Convention regulation II/2 compliance must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:stcwCodeSectionAIi2ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "STCW Code section A-II/2 compliance must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:advancedPolarTrainingStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Advanced polar training must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:watchCoverageStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Sufficient trained watch coverage must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:restComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Administration minimum rest requirements must be satisfied."
            ] ;
            sh:property [
                sh:path nltl:shipType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in ( "passenger ship" "tanker" "cargo ship other than tanker" )
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:shipType ;
                        sh:in ( "passenger ship" "tanker" )
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:iceCondition ;
                                sh:datatype xsd:string ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:in ( "open waters" "bergy waters" )
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:iceCondition ;
                                sh:datatype xsd:string ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:sparql [
                                sh:select """
                                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                                    SELECT $this
                                    WHERE {
                                        $this nltl:iceCondition ?condition .
                                        FILTER (STR(?condition) NOT IN ("open waters", "bergy waters"))
                                    }
                                """ ;
                                sh:message "For passenger ships and tankers operating in waters other than open waters or bergy waters, the designated officers must meet basic training requirements."
                            ] ;
                            sh:property [
                                sh:path nltl:designatedOfficerBasicTrainingStatus ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:shipType ;
                        sh:hasValue "cargo ship other than tanker"
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:iceConcentration ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node [
                                    sh:class qudt:QuantityValue ;
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:maxInclusive "0.2"^^xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:hasValue unit:UNITLESS ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ]
                                ]
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:iceConcentration ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node [
                                    sh:class qudt:QuantityValue ;
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:minExclusive "0.2"^^xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:hasValue unit:UNITLESS ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ]
                                ]
                            ] ;
                            sh:property [
                                sh:path nltl:designatedOfficerBasicTrainingStatus ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true ;
                                sh:message "For cargo ships other than tankers operating with ice concentration greater than 2/10, the designated officers must meet basic training requirements."
                            ]
                        ]
                    )
                ]
            )
        ]
    ) .
