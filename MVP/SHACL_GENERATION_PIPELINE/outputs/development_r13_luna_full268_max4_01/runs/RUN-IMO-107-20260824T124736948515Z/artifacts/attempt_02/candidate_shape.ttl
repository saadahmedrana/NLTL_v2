@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO107PolarOperationCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the ship operates in polar waters, Oil Record Book, manual, and pollution emergency plan polar coverage indicators must be present as boolean values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:shipOperatesInPolarWaters true .
                }
                FILTER (
                    NOT EXISTS {
                        $this nltl:oilRecordBookPolarCoverage ?oilCoverage .
                        FILTER (datatype(?oilCoverage) = xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:oilRecordBookPolarCoverage ?oilCoverage .
                        FILTER (datatype(?oilCoverage) != xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:manualPolarCoverage ?manualCoverage .
                        FILTER (datatype(?manualCoverage) = xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:manualPolarCoverage ?manualCoverage .
                        FILTER (datatype(?manualCoverage) != xsd:boolean)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:pollutionEmergencyPlanPolarCoverage ?planCoverage .
                        FILTER (datatype(?planCoverage) = xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:pollutionEmergencyPlanPolarCoverage ?planCoverage .
                        FILTER (datatype(?planCoverage) != xsd:boolean)
                    }
                )
            }
        """ ;
    ] .
