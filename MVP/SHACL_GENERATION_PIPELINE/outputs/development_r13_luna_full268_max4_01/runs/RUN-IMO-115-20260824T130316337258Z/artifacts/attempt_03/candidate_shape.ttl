@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-115> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "When sewage discharge type is comminuted_and_disinfected, the ship must record MARPOL compliance, a distance greater than 3 nautical miles from ice shelf or fast ice, and a paired area-distance and ice-concentration record with concentration exceeding 0.1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType "comminuted_and_disinfected"^^xsd:string .
                FILTER (
                    NOT EXISTS {
                        $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true .
                        $this nltl:distanceToNearestIceShelfOrFastIce ?nearestDistance .
                        ?nearestDistance qudt:numericValue ?nearestValue ;
                                         qudt:unit unit:MI_N .
                        FILTER ( ?nearestValue > "3"^^xsd:decimal )

                        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                        ?areaDistance qudt:numericValue ?areaDistanceValue ;
                                      qudt:unit unit:MI_N .

                        $this nltl:nearbyIceConcentration ?nearbyConcentration .
                        ?nearbyConcentration qudt:numericValue ?nearbyValue ;
                                              qudt:unit unit:UNITLESS .
                        FILTER ( ?nearbyValue > "0.1"^^xsd:decimal )

                        $this nltl:iceConcentration ?areaConcentration .
                        ?areaConcentration qudt:numericValue ?areaValue ;
                                           qudt:unit unit:UNITLESS .
                        FILTER ( ?areaValue > "0.1"^^xsd:decimal )
                    }
                    ||
                    EXISTS {
                        $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?status .
                        FILTER ( ?status != true )
                    }
                )
            }
        """
    ] .
