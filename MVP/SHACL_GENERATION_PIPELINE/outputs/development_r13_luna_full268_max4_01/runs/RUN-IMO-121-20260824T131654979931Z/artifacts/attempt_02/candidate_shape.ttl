@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

[
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When food waste is discharged to sea, it must be comminuted or ground, pass through a screen with openings no greater than 25 mm, and not be contaminated by other garbage." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:foodWasteDischargeToSea ?discharge .
                        FILTER (datatype(?discharge) != xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:foodWasteDischargeToSea ?discharge .
                        FILTER (
                            datatype(?discharge) = xsd:boolean
                            && ?discharge = true
                        )
                    }
                )

                FILTER (
                    EXISTS {
                        $this nltl:foodWasteDischargeToSea ?discharge .
                        FILTER (
                            datatype(?discharge) = xsd:boolean
                            && ?discharge = true
                        )
                    }
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:foodWasteComminutedOrGround true
                    }
                    ||
                    EXISTS {
                        $this nltl:foodWasteComminutedOrGround ?comminuted .
                        FILTER (
                            datatype(?comminuted) != xsd:boolean
                            ||
                            (
                                datatype(?comminuted) = xsd:boolean
                                && ?comminuted != true
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:contaminatedByOtherGarbage false
                    }
                    ||
                    EXISTS {
                        $this nltl:contaminatedByOtherGarbage ?contaminated .
                        FILTER (
                            datatype(?contaminated) != xsd:boolean
                            ||
                            (
                                datatype(?contaminated) = xsd:boolean
                                && ?contaminated != false
                            )
                        )
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:requiredScreenOpening ?opening .
                        ?opening a qudt:QuantityValue ;
                            qudt:numericValue ?value ;
                            qudt:unit unit:MilliM .
                        FILTER (
                            datatype(?value) = xsd:decimal
                            && ?value <= 25
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:requiredScreenOpening ?opening .
                        FILTER NOT EXISTS {
                            ?opening a qudt:QuantityValue ;
                                qudt:numericValue ?value ;
                                qudt:unit unit:MilliM .
                            FILTER (
                                datatype(?value) = xsd:decimal
                                && ?value <= 25
                            )
                        }
                    }
                )
            }
        """ ;
    ] ;
] .
