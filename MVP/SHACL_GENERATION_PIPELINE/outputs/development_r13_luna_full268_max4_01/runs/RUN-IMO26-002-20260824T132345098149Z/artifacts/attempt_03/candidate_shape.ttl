@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix qudtunit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudtunit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:GrossTonnageQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudtunit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:Chapter9Dash1ApplicabilityShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue nltl:fishingVessel ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:lengthOverall ;
                sh:node gen:LengthQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue nltl:pleasureYacht ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node gen:GrossTonnageQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:engagedInTrade ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path rdf:type ;
                sh:hasValue nltl:cargoShip ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node gen:GrossTonnageQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX qudtunit: <http://qudt.org/vocab/unit/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter9Dash1Applicable ?result .
                FILTER (
                    (
                        ?result = true &&
                        (
                            EXISTS {
                                $this rdf:type nltl:fishingVessel .
                                $this nltl:lengthOverall ?lengthQuantity .
                                ?lengthQuantity qudt:numericValue ?length ;
                                    qudt:unit qudtunit:M .
                                FILTER (?length >= 24)
                            }
                            ||
                            EXISTS {
                                $this rdf:type nltl:pleasureYacht .
                                $this nltl:grossTonnage ?grossQuantity .
                                ?grossQuantity qudt:numericValue ?gross ;
                                    qudt:unit qudtunit:UNITLESS .
                                $this nltl:engagedInTrade false .
                                FILTER (?gross >= 300)
                            }
                            ||
                            EXISTS {
                                $this rdf:type nltl:cargoShip .
                                $this nltl:grossTonnage ?grossQuantity .
                                ?grossQuantity qudt:numericValue ?gross ;
                                    qudt:unit qudtunit:UNITLESS .
                                FILTER (?gross >= 300 && ?gross < 500)
                            }
                        )
                    )
                    ||
                    (
                        ?result = false &&
                        !EXISTS {
                            $this rdf:type nltl:fishingVessel .
                            $this nltl:lengthOverall ?lengthQuantity .
                            ?lengthQuantity qudt:numericValue ?length ;
                                qudt:unit qudtunit:M .
                            FILTER (?length >= 24)
                        }
                        &&
                        !EXISTS {
                            $this rdf:type nltl:pleasureYacht .
                            $this nltl:grossTonnage ?grossQuantity .
                            ?grossQuantity qudt:numericValue ?gross ;
                                qudt:unit qudtunit:UNITLESS .
                            $this nltl:engagedInTrade false .
                            FILTER (?gross >= 300)
                        }
                        &&
                        !EXISTS {
                            $this rdf:type nltl:cargoShip .
                            $this nltl:grossTonnage ?grossQuantity .
                            ?grossQuantity qudt:numericValue ?gross ;
                                qudt:unit qudtunit:UNITLESS .
                            FILTER (?gross >= 300 && ?gross < 500)
                        }
                    )
                )
            }
        """
    ] .
