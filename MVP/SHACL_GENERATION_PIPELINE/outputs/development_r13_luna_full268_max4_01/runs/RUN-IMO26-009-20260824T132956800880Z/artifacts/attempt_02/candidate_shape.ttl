@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must provide one ice-accretion applicability value."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:IMO26-009-ApplicableShipShape>
        <urn:nltl:generated-shape:IMO26-009-NotApplicableShipShape>
    ) .

<urn:nltl:generated-shape:IMO26-009-ApplicableShipShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
        sh:minCount 1 ;
        sh:class nltl:navigationOrCommunicationAntenna ;
        sh:node <urn:nltl:generated-shape:IMO26-009-AntennaShape> ;
        sh:message "When ice accretion is likely, at least one required navigation or communication antenna must be recorded and each such antenna must have ice-accumulation prevention."
    ] .

<urn:nltl:generated-shape:IMO26-009-NotApplicableShipShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:hasValue false
    ] .

<urn:nltl:generated-shape:IMO26-009-AntennaShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each required navigation or communication antenna must have means to prevent ice accumulation."
    ] .
