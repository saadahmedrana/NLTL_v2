@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO26_012_Static> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When at least two non-magnetic heading means are represented, each must be connected to main and emergency power and be independent from another distinct heading means on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:hasNonMagneticHeadingMeans ?m1 ;
                      nltl:hasNonMagneticHeadingMeans ?m2 .

                FILTER (?m1 != ?m2)

                FILTER EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?m .

                    FILTER NOT EXISTS {
                        ?m a nltl:nonMagneticHeadingMeans ;
                           nltl:connectedToMainPower ?mainPower ;
                           nltl:connectedToEmergencyPower ?emergencyPower ;
                           nltl:independentFromHeadingMeans ?other .

                        ?mainPower a nltl:benchmarkEntity .
                        ?emergencyPower a nltl:benchmarkEntity .
                        ?other a nltl:nonMagneticHeadingMeans .

                        FILTER (?other != ?m)

                        $this nltl:hasNonMagneticHeadingMeans ?other .
                    }
                }
            }
        """ ;
    ] .
