@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-014> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:visualIceDetectionIlluminationMeansCount ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2
            ]
        ]
    ) ;
    sh:message "The ship must either operate solely in continuous daylight or have at least two means of illumination to aid visual detection of ice." .
