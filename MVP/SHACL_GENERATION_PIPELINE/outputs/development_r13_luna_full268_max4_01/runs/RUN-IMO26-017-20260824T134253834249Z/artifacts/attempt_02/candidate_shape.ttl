@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_017_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:voyagePlanPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "An applicable ship must have a voyage plan."
            ] ;
            sh:property [
                sh:path nltl:intendedVoyageHazard ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "An applicable ship must record each intended voyage hazard."
            ] ;
            sh:property [
                sh:path nltl:voyagePlanCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Every intended voyage hazard must be covered by the voyage plan."
            ] ;
            sh:sparql [
                sh:message "Every recorded intended voyage hazard must have voyage-plan coverage set to true." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:polarCodeChapter11Dash1Applicable "true"^^xsd:boolean ;
                              nltl:intendedVoyageHazard ?hazard ;
                              nltl:voyagePlanCoverage ?coverage .
                        FILTER (?coverage != "true"^^xsd:boolean)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeChapter11Dash1Applicable ;
                sh:hasValue false
            ]
        ]
    ) .
