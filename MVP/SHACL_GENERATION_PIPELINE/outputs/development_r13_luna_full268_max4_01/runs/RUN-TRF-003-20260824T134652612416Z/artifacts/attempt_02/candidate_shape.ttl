@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:minInclusive "2012-01-01"^^xsd:date ;
        sh:maxExclusive "2019-01-01"^^xsd:date ;
        sh:message "A ship must have a construction contract date on or after 2012-01-01 and before 2019-01-01."
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iceClassRegulationEdition2010 ;
        sh:minCount 1 ;
        sh:message "A ship contracted during the specified period must identify the 2010 Ice Class Regulations as the applicable regulation edition."
    ] .
