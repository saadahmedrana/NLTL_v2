@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF004_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "2010-01-01"^^xsd:date ;
                sh:maxExclusive "2012-01-01"^^xsd:date ;
                sh:message "A ship contracted for construction from 1 January 2010 through 31 December 2011 must have a valid construction contract date in this interval."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRegulationEdition2008 ;
                sh:minCount 1 ;
                sh:message "Ships contracted for construction from 1 January 2010 through 31 December 2011 must identify the 2008 Ice Class Regulations as the applicable regulation edition."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:or (
                    [
                        sh:maxExclusive "2010-01-01"^^xsd:date
                    ]
                    [
                        sh:minInclusive "2012-01-01"^^xsd:date
                    ]
                ) ;
                sh:message "A ship outside the 1 January 2010 to 1 January 2012 applicability interval must have a construction contract date establishing that it is outside the interval."
            ]
        ]
    ) .
