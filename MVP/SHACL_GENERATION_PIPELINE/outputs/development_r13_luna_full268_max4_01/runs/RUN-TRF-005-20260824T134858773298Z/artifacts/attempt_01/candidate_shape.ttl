@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-005-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction contract date is required to determine which ice-class regulation edition applies."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction stage date is required to determine which ice-class regulation edition applies."
    ] ;
    sh:sparql [
        sh:message "Ships with a construction stage on or after 1 September 2003 and a construction contract before 1 January 2010 must identify the 2002 Ice Class Regulations as the applicable regulation edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .

                FILTER (
                    (
                        YEAR(?stageDate) > 2003 ||
                        (
                            YEAR(?stageDate) = 2003 &&
                            (
                                MONTH(?stageDate) > 9 ||
                                (
                                    MONTH(?stageDate) = 9 &&
                                    DAY(?stageDate) >= 1
                                )
                            )
                        )
                    ) &&
                    (
                        YEAR(?contractDate) < 2010 ||
                        (
                            YEAR(?contractDate) = 2010 &&
                            (
                                MONTH(?contractDate) < 1 ||
                                (
                                    MONTH(?contractDate) = 1 &&
                                    DAY(?contractDate) < 1
                                )
                            )
                        )
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                              nltl:iceClassRegulationEdition2002 .
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?edition .
                        FILTER (
                            ?edition != nltl:iceClassRegulationEdition2002
                        )
                    }
                )
            }
        """
    ] .
