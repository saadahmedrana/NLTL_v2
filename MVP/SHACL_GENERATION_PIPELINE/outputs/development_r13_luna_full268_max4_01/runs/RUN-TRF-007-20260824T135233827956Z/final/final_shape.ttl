@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF007ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:message "Every supplied assessmentDate must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:message "Every supplied constructionStageDate must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date ;
        sh:message "Every supplied deliveryDate must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue
    ] ;
    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:engineOutputComplianceMethodValue ;
        sh:in (
            nltl:traficom2017Section3Point2Point2Method
            nltl:traficom2017Section3Point2Point4Method
        ) ;
        sh:maxCount 1 ;
        sh:message "A supplied engineOutputComplianceMethod must be exactly one of the two permitted 2017 methods."
    ] ;
    sh:sparql [
        sh:message "Ships of ice class IA Super or IA must provide constructionStageDate to establish applicability of the deadline rule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIaSuper ||
                    ?iceClass = nltl:iceClassIa
                )
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?constructionStageDate .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable ship must have a deliveryDate, assessmentDate, and one permitted engine output compliance method, and assessmentDate must be no later than 1 January twenty years after delivery." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionStageDate .

                FILTER (
                    ?iceClass = nltl:iceClassIaSuper ||
                    ?iceClass = nltl:iceClassIa
                )
                FILTER (?constructionStageDate < "2003-09-01"^^xsd:date)

                FILTER (
                    NOT EXISTS {
                        $this nltl:deliveryDate ?deliveryDate .
                    } ||
                    NOT EXISTS {
                        $this nltl:assessmentDate ?assessmentDate .
                    } ||
                    NOT EXISTS {
                        $this nltl:engineOutputComplianceMethod ?method .
                    } ||
                    EXISTS {
                        $this nltl:deliveryDate ?deliveryDate2 ;
                              nltl:assessmentDate ?assessmentDate2 .

                        FILTER (
                            YEAR(?assessmentDate2) > YEAR(?deliveryDate2) + 20 ||
                            (
                                YEAR(?assessmentDate2) = YEAR(?deliveryDate2) + 20 &&
                                (
                                    MONTH(?assessmentDate2) > 1 ||
                                    (
                                        MONTH(?assessmentDate2) = 1 &&
                                        DAY(?assessmentDate2) > 1
                                    )
                                )
                            )
                        )
                    }
                )
            }
        """
    ] .
