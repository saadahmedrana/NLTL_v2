@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have exactly one ice class to determine applicability."
    ] ;
    sh:or (
        [
            sh:sparql [
                sh:message "This branch applies to ships that are not ice class IA or IA Super." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass IN (
                                nltl:iceClassIa,
                                nltl:iceClassIaSuper
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIaSuper
                )
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:maxInclusive "2003-08-31"^^xsd:date ;
                sh:message "For ice class IA or IA Super, the construction stage date must be before 1 September 2003."
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The delivery date is required to determine the twenty-year compliance deadline."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The assessment date is required to evaluate the compliance deadline."
            ] ;
            sh:property [
                sh:path nltl:engineOutputComplianceMethod ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    nltl:traficom2017Section3Point2Point2Method
                    nltl:traficom2017Section3Point2Point4Method
                ) ;
                sh:message "The applicable 2017 Ice Class Regulations compliance method must be section 3.2.2 or section 3.2.4."
            ] ;
            sh:sparql [
                sh:message "For an applicable ship, compliance must be established no later than 1 January of the year twenty years after delivery." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?deliveryDate .
                        $this nltl:assessmentDate ?assessmentDate .
                        FILTER (
                            YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
                            ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                &&
                                MONTH(?assessmentDate) > 1
                            )
                            ||
                            (
                                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                                &&
                                MONTH(?assessmentDate) = 1
                                &&
                                DAY(?assessmentDate) > 1
                            )
                        )
                    }
                """
            ]
        ]
    ) .
