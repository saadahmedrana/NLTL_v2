@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-011-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The UIWL must contain exactly the maximum intended-waterline vertical coordinate at every represented longitudinal position, with bidirectional point coverage and a relative tolerance of 1e-6 plus an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this ?x
                           (MAX(?expectedValue) AS ?expectedMax)
                           (MIN(?reportedValue) AS ?reportedMin)
                           (MAX(?reportedValue) AS ?reportedMax)
                           (COUNT(?expectedValue) AS ?expectedCount)
                           (COUNT(?reportedValue) AS ?reportedCount)
                    WHERE {
                        $this nltl:hasIntendedIceOperatingWaterline ?intendedWaterline ;
                              nltl:hasUpperIceWaterline ?upperWaterline .

                        $this
                            (nltl:hasIntendedIceOperatingWaterline|
                             nltl:hasUpperIceWaterline)
                            ?seedWaterline .
                        ?seedWaterline nltl:hasWaterlineProfilePoint ?seedPoint .
                        ?seedPoint nltl:longitudinalPosition ?seedLongitudinal ;
                                   nltl:verticalCoordinate ?seedVertical .
                        ?seedLongitudinal qudt:numericValue ?seedX ;
                                          qudt:unit <http://qudt.org/vocab/unit/M> .
                        ?seedVertical qudt:numericValue ?seedY ;
                                     qudt:unit <http://qudt.org/vocab/unit/M> .

                        OPTIONAL {
                            ?intendedWaterline nltl:hasWaterlineProfilePoint ?intendedPoint .
                            ?intendedPoint nltl:longitudinalPosition ?intendedLongitudinal ;
                                           nltl:verticalCoordinate ?intendedVertical .
                            ?intendedLongitudinal qudt:numericValue ?x ;
                                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                            ?intendedVertical qudt:numericValue ?expectedValue ;
                                               qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (?x = ?seedX)
                        }

                        OPTIONAL {
                            ?upperWaterline nltl:hasWaterlineProfilePoint ?reportedPoint .
                            ?reportedPoint nltl:longitudinalPosition ?reportedLongitudinal ;
                                          nltl:verticalCoordinate ?reportedVertical .
                            ?reportedLongitudinal qudt:numericValue ?reportedX ;
                                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                            ?reportedVertical qudt:numericValue ?reportedValue ;
                                               qudt:unit <http://qudt.org/vocab/unit/M> .
                            FILTER (?reportedX = ?seedX)
                        }

                        BIND(?seedX AS ?x)
                    }
                    GROUP BY $this ?x
                }

                FILTER (
                    ?expectedCount = 0 ||
                    ?reportedCount = 0 ||
                    ABS(?reportedMin - ?expectedMax) >
                        (ABS(?expectedMax) * 0.000001 + 0.000000001) ||
                    ABS(?reportedMax - ?expectedMax) >
                        (ABS(?expectedMax) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-011-IceWaterlineShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceWaterline ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:waterlineProfilePoint ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF-011-WaterlineProfilePointShape>
    a sh:NodeShape ;
    sh:targetClass nltl:waterlineProfilePoint ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
