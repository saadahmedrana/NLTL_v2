@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthMShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:class nltl:classCertificate ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        gen:TRF014PostCutoffShape
        gen:TRF014PreCompleteShape
        gen:TRF014PreDockingShape
    ) .

gen:TRF014CertificateShape a sh:NodeShape ;
    sh:targetClass nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014PostCutoffShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The summer load line fresh water draught must be above the upper ice waterline draught when post-cutoff marking applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                      nltl:upperIceWaterlineDraught ?uiwlNode .
                ?summerNode <http://qudt.org/schema/qudt/numericValue> ?summer .
                ?uiwlNode <http://qudt.org/schema/qudt/numericValue> ?uiwl .
                FILTER (?summer <= ?uiwl)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The amidships ice-class draught mark must equal the certificate maximum amidships draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasClassCertificate ?certificate ;
                          nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                    ?markNode qudt:numericValue ?markValue ;
                              qudt:unit unit:M .
                    ?certificate nltl:maximumIceClassDraughtAmidships ?certificateNode .
                    ?certificateNode qudt:numericValue ?certificateValue ;
                                   qudt:unit unit:M .
                    FILTER (?markValue = ?certificateValue)
                }
            }
        """
    ] .

gen:TRF014PreCompleteShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:LengthMShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The summer load line fresh water draught must be above the upper ice waterline draught when pre-cutoff marking applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                      nltl:upperIceWaterlineDraught ?uiwlNode .
                ?summerNode <http://qudt.org/schema/qudt/numericValue> ?summer .
                ?uiwlNode <http://qudt.org/schema/qudt/numericValue> ?uiwl .
                FILTER (?summer <= ?uiwl)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The amidships ice-class draught mark must equal the certificate maximum amidships draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:hasClassCertificate ?certificate ;
                          nltl:iceClassDraughtMarkDraughtAmidships ?markNode .
                    ?markNode qudt:numericValue ?markValue ;
                              qudt:unit unit:M .
                    ?certificate nltl:maximumIceClassDraughtAmidships ?certificateNode .
                    ?certificateNode qudt:numericValue ?certificateValue ;
                                   qudt:unit unit:M .
                    FILTER (?markValue = ?certificateValue)
                }
            }
        """
    ] .

gen:TRF014PreDockingShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2007-07-01"^^xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The summer load line fresh water draught must be above the upper ice waterline draught when pre-cutoff docking logic applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:summerLoadLineFreshWaterDraught ?summerNode ;
                      nltl:upperIceWaterlineDraught ?uiwlNode .
                ?summerNode <http://qudt.org/schema/qudt/numericValue> ?summer .
                ?uiwlNode <http://qudt.org/schema/qudt/numericValue> ?uiwl .
                FILTER (?summer <= ?uiwl)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the first scheduled dry docking date is on or before the assessment date, the required markings and certificate draught equality must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:firstScheduledDryDockingDate ?dockingDate ;
                      nltl:assessmentDate ?assessmentDate .
                FILTER (?dockingDate <= ?assessmentDate)
                FILTER NOT EXISTS {
                    $this nltl:iceClassDraughtMarkPresent true ;
                          nltl:warningTrianglePresent true ;
                          nltl:iceClassDraughtMarkDraughtAmidships ?markNode ;
                          nltl:hasClassCertificate ?certificate .
                    ?markNode qudt:numericValue ?markValue ;
                              qudt:unit unit:M .
                    ?certificate nltl:maximumIceClassDraughtAmidships ?certificateNode .
                    ?certificateNode qudt:numericValue ?certificateValue ;
                                   qudt:unit unit:M .
                    FILTER (?markValue = ?certificateValue)
                }
            }
        """
    ] .
