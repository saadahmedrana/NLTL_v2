@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF023Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For an ice class IB or IC ship subject to the 1985 ice class regulations, maximum continuous rating power and required power under the 1985 rules must be present as kW quantities." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    FILTER (
        NOT EXISTS {
            $this nltl:maximumContinuousRatingPower ?maximumQuantity .
            ?maximumQuantity qudt:numericValue ?maximumValue ;
                              qudt:unit qudt:KiloW .
        }
        ||
        EXISTS {
            $this nltl:maximumContinuousRatingPower ?maximumQuantity .
            FILTER NOT EXISTS {
                ?maximumQuantity qudt:numericValue ?maximumValue ;
                                  qudt:unit qudt:KiloW .
            }
        }
        ||
        EXISTS {
            $this nltl:maximumContinuousRatingPower ?maximumQuantity .
            ?maximumQuantity qudt:unit ?maximumUnit .
            FILTER (?maximumUnit != qudt:KiloW)
        }
        ||
        NOT EXISTS {
            $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
            ?requiredQuantity qudt:numericValue ?requiredValue ;
                              qudt:unit qudt:KiloW .
        }
        ||
        EXISTS {
            $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
            FILTER NOT EXISTS {
                ?requiredQuantity qudt:numericValue ?requiredValue ;
                                  qudt:unit qudt:KiloW .
            }
        }
        ||
        EXISTS {
            $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
            ?requiredQuantity qudt:unit ?requiredUnit .
            FILTER (?requiredUnit != qudt:KiloW)
        }
    )
}
""" ;
    ] ;
    sh:sparql [
        sh:message "For an ice class IB or IC ship subject to the 1985 ice class regulations, maximum continuous rating power must be at least the required power under the 1985 rules." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this ?maximumValue ?requiredValue
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          nltl:maximumContinuousRatingPower ?maximumQuantity ;
          nltl:requiredPowerUnder1985Rules ?requiredQuantity .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    ?maximumQuantity qudt:numericValue ?maximumValue ;
                     qudt:unit qudt:KiloW .
    ?requiredQuantity qudt:numericValue ?requiredValue ;
                     qudt:unit qudt:KiloW .
    FILTER (?maximumValue < ?requiredValue)
}
""" ;
    ] .
