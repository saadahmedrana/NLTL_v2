@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-024> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIb nltl:iceClassIc nltl:iceClassIi nltl:iceClassIii ) ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:message "For ice classes IB, IC, II, or III, the ship must identify the applicable ice class."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2003-09-01"^^xsd:date ;
                sh:message "For ice class IA or IA Super, the construction stage date must be on or after 1 September 2003 for this applicability branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in ( nltl:iceClassIa nltl:iceClassIaSuper ) ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI
            ] ;
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxExclusive "2003-09-01"^^xsd:date ;
                sh:message "For this applicability branch, the construction stage date must be before 1 September 2003."
            ] ;
            sh:property [
                sh:path nltl:deliveryDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "A delivery date is required for a ship in the pre-1 September 2003 IA or IA Super branch."
            ] ;
            sh:property [
                sh:path nltl:assessmentDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:message "An assessment date is required for a ship in the pre-1 September 2003 IA or IA Super branch."
            ] ;
            sh:sparql [
                sh:message "The assessment date must be no later than 1 January in the year twenty years after the delivery year." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        FILTER (
                            YEAR(?assessment) > YEAR(?delivery) + 20
                            ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                && MONTH(?assessment) > 1
                            )
                            ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20
                                && MONTH(?assessment) = 1
                                && DAY(?assessment) > 1
                            )
                        )
                    }
                """
            ]
        ]
    ) .
