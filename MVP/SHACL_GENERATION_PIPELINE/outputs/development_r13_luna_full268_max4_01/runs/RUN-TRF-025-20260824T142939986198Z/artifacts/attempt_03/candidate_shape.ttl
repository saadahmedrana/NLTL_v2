@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF025ComplexReadinessShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The ship must have exactly one permitted ice class."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must specify exactly one bulbous-bow presence value."
    ] ;
    sh:sparql [
        sh:message "An applicable IA Super ship without a bulb must provide positive B, L, and T operands with their declared units and all formula coefficients." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                       nltl:bulbousBowPresent false .
                FILTER NOT EXISTS {
                    $this nltl:shipBreadth ?b ;
                           nltl:shipLength ?l ;
                           nltl:iceClassDraught ?t ;
                           nltl:coefficientF1 ?f1 ;
                           nltl:coefficientF2 ?f2 ;
                           nltl:coefficientF3 ?f3 ;
                           nltl:coefficientF4 ?f4 ;
                           nltl:coefficientG1 ?g1 ;
                           nltl:coefficientG2 ?g2 ;
                           nltl:coefficientG3 ?g3 .
                    ?b qudt:numericValue ?bv ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?l qudt:numericValue ?lv ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?t qudt:numericValue ?tv ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                    ?f1 qudt:numericValue ?f1v ;
                        qudt:unit <http://qudt.org/vocab/unit/N-PER-M2> .
                    ?f2 qudt:numericValue ?f2v ;
                        qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                    ?f3 qudt:numericValue ?f3v ;
                        qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                    ?f4 qudt:numericValue ?f4v ;
                        qudt:unit <http://qudt.org/vocab/unit/N-PER-M2> .
                    ?g1 qudt:numericValue ?g1v ;
                        qudt:unit <http://qudt.org/vocab/unit/N> .
                    ?g2 qudt:numericValue ?g2v ;
                        qudt:unit <http://qudt.org/vocab/unit/N-PER-M> .
                    ?g3 qudt:numericValue ?g3v ;
                        qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .
                    FILTER(
                        ?bv > 0 &&
                        ?lv > 0 &&
                        ?tv > 0 &&
                        ?f1v > 0 &&
                        ?f2v > 0 &&
                        ?f3v > 0 &&
                        ?f4v > 0 &&
                        ?g1v > 0 &&
                        ?g2v > 0 &&
                        ?g3v > 0
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable C1 and C2 results must be provided in newtons and agree with the declared source calculation within the required relative tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper ;
                       nltl:bulbousBowPresent false ;
                       nltl:shipBreadth ?b ;
                       nltl:shipLength ?l ;
                       nltl:iceClassDraught ?t ;
                       nltl:coefficientF1 ?f1 ;
                       nltl:coefficientF2 ?f2 ;
                       nltl:coefficientF3 ?f3 ;
                       nltl:coefficientF4 ?f4 ;
                       nltl:coefficientG1 ?g1 ;
                       nltl:coefficientG2 ?g2 ;
                       nltl:coefficientG3 ?g3 ;
                       nltl:brashIceResistanceCoefficientC1 ?c1 ;
                       nltl:brashIceResistanceCoefficientC2 ?c2 .
                ?b qudt:numericValue ?bv .
                ?l qudt:numericValue ?lv .
                ?t qudt:numericValue ?tv .
                ?f1 qudt:numericValue ?f1v .
                ?f2 qudt:numericValue ?f2v .
                ?f3 qudt:numericValue ?f3v .
                ?f4 qudt:numericValue ?f4v .
                ?g1 qudt:numericValue ?g1v .
                ?g2 qudt:numericValue ?g2v .
                ?g3 qudt:numericValue ?g3v .
                ?c1 qudt:numericValue ?c1v ;
                    qudt:unit <http://qudt.org/vocab/unit/N> .
                ?c2 qudt:numericValue ?c2v ;
                    qudt:unit <http://qudt.org/vocab/unit/N> .
                BIND(
                    ?f1v * (?bv * ?lv) / (2 * ?tv / ?bv + 1) +
                    1.84 * (?f2v * ?bv + ?f3v * ?lv + ?f4v * ?bv * ?lv)
                    AS ?expectedC1
                )
                BIND(
                    3.52 * (?g1v + ?g2v * ?bv) +
                    ?g3v * (1 + 1.2 * ?tv / ?bv) * ?bv * ?bv /
                    math:sqrt(?lv)
                    AS ?expectedC2
                )
                FILTER(
                    ABS(?c1v - ?expectedC1) >
                    IF(ABS(?expectedC1) * 0.000001 > 0.000000001,
                       ABS(?expectedC1) * 0.000001,
                       0.000000001)
                    ||
                    ABS(?c2v - ?expectedC2) >
                    IF(ABS(?expectedC2) * 0.000001 > 0.000000001,
                       ABS(?expectedC2) * 0.000001,
                       0.000000001)
                )
            }
        """
    ] .
