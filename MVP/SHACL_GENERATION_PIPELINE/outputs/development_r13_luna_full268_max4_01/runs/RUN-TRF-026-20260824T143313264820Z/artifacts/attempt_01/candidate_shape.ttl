@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix gen: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF026ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property gen:TRF026IceClassShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property gen:TRF026F1Shape ;
            sh:property gen:TRF026F2Shape ;
            sh:property gen:TRF026F3Shape ;
            sh:property gen:TRF026F4Shape ;
            sh:property gen:TRF026G1Shape ;
            sh:property gen:TRF026G2Shape ;
            sh:property gen:TRF026G3Shape ;
            sh:property gen:TRF026BreadthShape ;
            sh:property gen:TRF026LengthShape ;
            sh:property gen:TRF026DraughtShape ;
            sh:property gen:TRF026C1Shape ;
            sh:property gen:TRF026C2Shape
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
    ) .

gen:TRF026IceClassShape
    a sh:PropertyShape ;
    sh:path nltl:iceClass ;
    sh:class nltl:iceClassValue ;
    sh:in (
        nltl:iceClassIaSuper
        nltl:iceClassIa
        nltl:iceClassIb
        nltl:iceClassIc
        nltl:iceClassIi
        nltl:iceClassIii
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Exactly one permitted ice class is required." .

gen:TRF026F1Shape
    a sh:PropertyShape ;
    sh:path nltl:coefficientF1 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node [
        sh:class qudt:QuantityValue ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/N-PER-M2> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

