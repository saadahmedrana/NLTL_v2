@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF028Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The approved alternative Ke or RCH method must have approval status true."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateDraft
            nltl:evidenceStateExpired
            nltl:evidenceStateRejected
            nltl:evidenceStateRevoked
            nltl:evidenceStateSubmitted
            nltl:evidenceStateUnderReview
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The alternative method must have a permitted approval or revocation status."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:node gen:AlternativeCalculationEvidenceShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:node gen:KeQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:node gen:ModelTestEvidenceShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:node gen:RchQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) ;
    sh:message "The ship must provide approved evidence and the corresponding externally determined Ke or RCH result for the permitted alternative method." .

gen:AlternativeCalculationEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:evidenceArtifact ;
    sh:class nltl:alternativeCalculationEvidence .

gen:ModelTestEvidenceShape
    a sh:NodeShape ;
    sh:class nltl:evidenceArtifact ;
    sh:class nltl:modelTestEvidence .

gen:KeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:RchQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/N> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
