@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:TRF-028> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:approvalStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must have an approved alternative Ke or RCH determination."
    ] ;
    sh:property [
        sh:path nltl:approvalRevocationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:evidenceStateApproved
            nltl:evidenceStateRevoked
        ) ;
        sh:message "The approval status must be Approved or Revoked."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:alternativeCalculationEvidence
                ]
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:UNITLESS
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:alternativeCalculationEvidence
                ]
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:N
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:modelTestEvidence
                ]
            ] ;
            sh:property [
                sh:path nltl:engineOutputCoefficientKe ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:UNITLESS
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEvidence ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:modelTestEvidence
                ]
            ] ;
            sh:property [
                sh:path nltl:brashIceChannelResistanceRch ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:N
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "The ship must provide approved alternative-calculation or model-test evidence together with an alternative Ke or RCH result." .
