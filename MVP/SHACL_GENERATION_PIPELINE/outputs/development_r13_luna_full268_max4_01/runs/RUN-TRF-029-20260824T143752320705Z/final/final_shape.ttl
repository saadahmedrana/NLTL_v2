@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF029Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each ship must state whether direct analysis is used."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:prescribedProcedureApplicability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "When direct analysis is used, the prescribed analytical procedure must be marked not applicable."
            ] ;
            sh:property [
                sh:path nltl:directAnalysisApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "When direct analysis is used, its approval status must be Approved."
            ] ;
            sh:property [
                sh:path nltl:structuralArrangement ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When direct analysis is used, the structural arrangement must be specified."
            ]
        ]
    ) .
