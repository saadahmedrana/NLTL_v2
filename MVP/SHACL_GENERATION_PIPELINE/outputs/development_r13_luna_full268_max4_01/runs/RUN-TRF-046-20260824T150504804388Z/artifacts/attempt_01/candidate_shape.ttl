@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF046FrameShape a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:node [
                    sh:or (
                        [ sh:class nltl:deckStructure ]
                        [ sh:class nltl:tankBoundaryPlating ]
                        [ sh:class nltl:iceStringer ]
                    )
                ] ;
                sh:message "The upper end shall be attached to a deck, tank boundary plating, or ice stringer."
            ]
        ] ;
        sh:message "The frame shall have an upper end attached to an eligible supporting structure."
    ] .
