@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF046FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [ sh:class nltl:mainFrame ]
        [ sh:class nltl:intermediateIceFrame ]
    ) ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:frameStrengthenedPart
        ] ;
        sh:message "A main frame or intermediate ice frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:frameEnd ;
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:qualifiedMinCount 1 ;
                sh:qualifiedValueShape [
                    sh:or (
                        [ sh:class nltl:deckStructure ]
                        [ sh:class nltl:tankBoundaryPlating ]
                        [ sh:class nltl:iceStringer ]
                    )
                ] ;
                sh:message "The strengthened upper end must be attached to a deck, tank boundary plating, or ice stringer."
            ]
        ] ;
        sh:message "A main frame or intermediate ice frame must identify its upper end."
    ] .
