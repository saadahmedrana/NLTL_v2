@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF046FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:class nltl:mainFrame ;
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:frameStrengthenedPart ;
                    sh:property [
                        sh:path nltl:ordinaryFrameScantlingsUsed ;
                        sh:datatype xsd:boolean
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasUpperEnd ;
                sh:minCount 1 ;
                sh:node gen:TRF046UpperEndShape
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:property [
                sh:path nltl:hasStrengthenedPart ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:frameStrengthenedPart ;
                    sh:property [
                        sh:path nltl:ordinaryFrameScantlingsUsed ;
                        sh:datatype xsd:boolean
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasUpperEnd ;
                sh:minCount 1 ;
                sh:node gen:TRF046UpperEndShape
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A supporting structure marked at or above the ice-belt upper limit must be the structure attached to the frame upper end." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasUpperEnd ?end .
                ?end nltl:hasTerminationAboveSupportingStructure ?support .
                ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .
                FILTER NOT EXISTS {
                    ?end nltl:hasAttachedSupportingStructure ?support .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A strengthened part above a qualifying supporting structure must use ordinary non-ice-strengthened frame scantlings." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStrengthenedPart ?part ;
                      nltl:hasUpperEnd ?end .
                ?end nltl:hasTerminationAboveSupportingStructure ?support ;
                     nltl:hasAttachedSupportingStructure ?support .
                ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .
                FILTER NOT EXISTS {
                    ?part nltl:ordinaryFrameScantlingsUsed true .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A qualifying intermediate frame must have the permitted horizontal connection member with the same scantlings as the main frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:intermediateIceFrame ;
                      nltl:hasStrengthenedPart ?part ;
                      nltl:hasUpperEnd ?end .
                ?end nltl:hasTerminationAboveSupportingStructure ?support ;
                     nltl:hasAttachedSupportingStructure ?support .
                ?support nltl:supportingStructureAtOrAboveIceBeltUpperLimit true .
                ?part nltl:ordinaryFrameScantlingsUsed true .
                FILTER NOT EXISTS {
                    ?end nltl:hasHorizontalConnectionMember ?member .
                    ?member nltl:connectsToAdjacentMainFrame ?mainFrame ;
                            nltl:sameScantlingsAsMainFrame true .
                }
            }
        """
    ] .

gen:TRF046UpperEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:iceStringer ]
            )
        ]
    ] ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:node [
            sh:class nltl:supportingStructure ;
            sh:property [
                sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                sh:datatype xsd:boolean
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:node [
            sh:class nltl:horizontalConnectionMember ;
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:minCount 1 ;
                sh:node [ sh:class nltl:mainFrame ]
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean
            ]
        ]
    ] .
