@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF047FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:node gen:TRF047StrengthenedPartShape ;
        sh:message "Each represented strengthened main or intermediate ice frame part must satisfy the applicable lower-end attachment rule."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A horizontal-connection alternative requires the frame-level ice-strengthening and same-scantlings facts to be true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStrengthenedPart ?part .
                ?part a nltl:intermediateIceFrame .
                FILTER NOT EXISTS {
                    ?part a nltl:mainFrame .
                }
                ?part nltl:hasLowerEnd ?lowerEnd .
                ?lowerEnd nltl:hasTerminationBelowSupportingStructure ?termination ;
                          nltl:hasHorizontalConnectionMember ?member .
                ?termination a ?terminationType .
                FILTER (
                    ?terminationType IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:tankTop,
                        nltl:iceStringer
                    )
                )
                ?member nltl:connectsToAdjacentMainFrame ?adjacentMainFrame .
                ?adjacentMainFrame a nltl:mainFrame .
                FILTER (
                    NOT EXISTS {
                        $this nltl:supportingStructureAtOrBelowIceBeltLowerLimit true
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:sameScantlingsAsMainFrame true
                    }
                )
            }
        """
    ] .

gen:TRF047StrengthenedPartShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:class nltl:mainFrame ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node gen:TRF047DirectLowerEndShape
            ]
        ]
        [
            sh:class nltl:intermediateIceFrame ;
            sh:not [
                sh:class nltl:mainFrame
            ] ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node gen:TRF047IntermediateLowerEndShape
            ]
        ]
    ) .

gen:TRF047DirectLowerEndShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:tankTop ]
                [ sh:class nltl:iceStringer ]
            )
        ]
    ] .

gen:TRF047IntermediateLowerEndShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasAttachedSupportingStructure ;
                sh:minCount 1 ;
                sh:node [
                    sh:or (
                        [ sh:class nltl:deckStructure ]
                        [ sh:class nltl:tankBoundaryPlating ]
                        [ sh:class nltl:tankTop ]
                        [ sh:class nltl:iceStringer ]
                    )
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasTerminationBelowSupportingStructure ;
                sh:minCount 1 ;
                sh:node gen:TRF047TerminationShape
            ] ;
            sh:property [
                sh:path nltl:hasHorizontalConnectionMember ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:horizontalConnectionMember ;
                    sh:property [
                        sh:path nltl:connectsToAdjacentMainFrame ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:mainFrame
                        ]
                    ]
                ]
            ]
        ]
    ) .

gen:TRF047TerminationShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:tankTop ]
        [ sh:class nltl:iceStringer ]
    ) .
