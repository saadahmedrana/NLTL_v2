@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF049FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:minCount 1 ;
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "An ice-strengthened frame must be effectively attached to each linked supporting structure, and the applicable frame attachment conditions must be satisfied." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        FILTER NOT EXISTS {
            ?attachment nltl:effectiveAttachmentConfirmed true
        }
    }

    FILTER NOT EXISTS {
        $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?supporting .
        FILTER NOT EXISTS {
            $this nltl:hasFrameAttachment ?attachment .
            ?attachment nltl:hasAttachedSupportingStructure ?supporting .
            ?attachment nltl:effectiveAttachmentConfirmed true
        }
    }

    FILTER (
        EXISTS {
            $this rdf:type nltl:longitudinalFrame
        }
        &&
        EXISTS {
            $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?longitudinalSupport
        }
        &&
        EXISTS {
            $this nltl:hasFrameAttachment ?longitudinalAttachment .
            ?longitudinalAttachment nltl:hasAttachedSupportingStructure ?longitudinalSupport .
        }
        &&
        NOT EXISTS {
            $this rdf:type nltl:longitudinalFrame .
            $this (nltl:hasSupportingBulkhead|nltl:hasSupportingWebFrame) ?longitudinalSupport .
            FILTER NOT EXISTS {
                $this nltl:hasFrameAttachment ?longitudinalAttachment .
                ?longitudinalAttachment nltl:hasAttachedSupportingStructure ?longitudinalSupport .
                ?longitudinalAttachment nltl:hasConnectionBracket ?bracket
            }
        }
    )

    FILTER NOT EXISTS {
        $this rdf:type nltl:transverseFrame .
        $this nltl:terminatesAtDeckOrIceStringer true .
        $this nltl:hasFrameAttachment ?terminationAttachment .
        FILTER NOT EXISTS {
            {
                ?terminationAttachment nltl:hasConnectionBracket ?terminationBracket
            }
            UNION
            {
                ?terminationAttachment nltl:similarAttachmentConstructionPresent true
            }
        }
    }

    FILTER NOT EXISTS {
        $this nltl:passesThroughSupportingStructure true .
        FILTER NOT EXISTS {
            $this nltl:webPlateConnectionSideCount ?sideCount .
            FILTER (
                DATATYPE(?sideCount) = xsd:integer &&
                xsd:integer(?sideCount) >= 2
            )
        }
    }

    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?bracketAttachment .
        ?bracketAttachment nltl:hasConnectionBracket ?bracket .
        FILTER NOT EXISTS {
            ?bracket nltl:bracketEdgeStiffened true
        }
    }

    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?bracketAttachment2 .
        ?bracketAttachment2 nltl:hasConnectionBracket ?bracket2 .
        FILTER NOT EXISTS {
            ?bracket2 nltl:bucklingStiffening true
        }
    }

    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?thicknessAttachment .
        ?thicknessAttachment nltl:hasConnectionBracket ?thicknessBracket .
        FILTER NOT EXISTS {
            ?thicknessBracket nltl:bracketThickness ?bracketQuantity .
            ?bracketQuantity qudt:numericValue ?bracketValue ;
                             qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER (DATATYPE(?bracketValue) = xsd:decimal)
        }
    }

    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?comparisonAttachment .
        ?comparisonAttachment nltl:hasConnectionBracket ?comparisonBracket .
        FILTER NOT EXISTS {
            ?comparisonBracket nltl:bracketThickness ?bracketQuantity2 .
            ?bracketQuantity2 qudt:numericValue ?bracketValue2 ;
                              qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER (DATATYPE(?bracketValue2) = xsd:decimal)
            $this nltl:frameWebThickness ?frameQuantity .
            ?frameQuantity qudt:numericValue ?frameValue ;
                           qudt:unit <http://qudt.org/vocab/unit/MilliM> .
            FILTER (
                DATATYPE(?frameValue) = xsd:decimal &&
                xsd:decimal(?bracketValue2) >= xsd:decimal(?frameValue)
            )
        }
    }
}
"""
            ]
        ]
    ) .
