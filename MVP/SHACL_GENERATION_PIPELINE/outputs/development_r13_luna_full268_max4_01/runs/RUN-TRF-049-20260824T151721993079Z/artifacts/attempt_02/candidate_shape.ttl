@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

nltlgen:TRF049FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        nltlgen:TRF049NonApplicableFrameShape
        nltlgen:TRF049ApplicableFrameShape
    ) .

nltlgen:TRF049NonApplicableFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] .

nltlgen:TRF049ApplicableFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame is within the ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:node nltlgen:TRF049FrameAttachmentShape ;
        sh:minCount 1 ;
        sh:message "An applicable frame must have an effective frame attachment."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every linked supporting structure must have an attachment linked to this frame and to the supporting structure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this ?supportingLink ?supportingStructure .
                FILTER (?supportingLink IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?supportingStructure nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?supportingStructure .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A longitudinal frame must be attached by a bracket to every linked supporting web frame and bulkhead." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this a nltl:longitudinalFrame ;
                      ?supportingLink ?supportingStructure .
                FILTER (?supportingLink IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?supportingStructure nltl:hasSupportingStructureAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?supportingStructure ;
                                nltl:hasConnectionBracket ?bracket .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A transverse frame terminating at a deck or ice stringer must have a bracket or similar attachment construction." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this a nltl:transverseFrame ;
                      nltl:terminatesAtDeckOrIceStringer true ;
                      nltl:hasFrameAttachment ?attachment .
                FILTER NOT EXISTS {
                    {
                        ?attachment nltl:hasConnectionBracket ?bracket .
                    }
                    UNION
                    {
                        ?attachment nltl:similarAttachmentConstructionPresent true .
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A frame running through a supporting structure must have both web-plate connection sides connected." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:passesThroughSupportingStructure true .
                FILTER NOT EXISTS {
                    $this nltl:webPlateConnectionSideCount 2 .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A bracket must have at least the frame web thickness and must be stiffened against buckling." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment ;
                      nltl:frameWebThickness ?frameThickness .
                ?attachment nltl:hasConnectionBracket ?bracket .
                FILTER NOT EXISTS {
                    ?frameThickness qudt:numericValue ?frameValue ;
                                    qudt:unit unit:MilliM .
                    ?bracket nltl:bracketThickness ?bracketThickness ;
                             nltl:bracketEdgeStiffened true ;
                             nltl:bucklingStiffening true .
                    ?bracketThickness qudt:numericValue ?bracketValue ;
                                      qudt:unit unit:MilliM .
                    FILTER (?bracketValue >= ?frameValue)
                }
            }
        """
    ] .

nltlgen:TRF049FrameAttachmentShape
    a sh:NodeShape ;
    sh:class nltl:frameAttachment ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The frame attachment must be confirmed effective."
    ] .
