@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .

<urn:nltl:generated-shape:TRF-052> a sh:NodeShape ;
    sh:targetClass nltl:frame ;

    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] ;

    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:class nltl:hullRegionValue ;
        sh:in (
            nltl:bowRegion
            nltl:midbodyRegion
            nltl:sternRegion
            nltl:otherIceStrengthenedAreaValue
        )
    ] ;

    sh:sparql [
        sh:message "When the frame is asymmetrical or its web angle to the shell is below 90 degrees, antitripping support spacing must not exceed 1300 mm unless an equivalent alternative arrangement is demonstrated." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER (
                    EXISTS {
                        $this nltl:frameAsymmetrical true .
                    }
                    ||
                    EXISTS {
                        $this nltl:frameWebAngleToShell ?angleNode .
                        ?angleNode qudt:numericValue ?angle .
                        FILTER (?angle < 90)
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                    ?spacingNode qudt:numericValue ?spacing .
                    ?spacingNode qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    FILTER (?spacing <= 1300)
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "Without a demonstrated equivalent alternative arrangement, the required antitripping support regions must match the frame span and ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                $this nltl:iceClass ?iceClass .
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true .
                }
                FILTER (
                    (
                        ?span > 4 &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:sternRegion .
                            }
                        )
                    )
                    ||
                    (
                        ?span <= 4 &&
                        ?iceClass = nltl:iceClassIaSuper &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:sternRegion .
                            }
                        )
                    )
                    ||
                    (
                        ?span <= 4 &&
                        ?iceClass = nltl:iceClassIa &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion .
                            }
                        )
                    )
                    ||
                    (
                        ?span <= 4 &&
                        (
                            ?iceClass = nltl:iceClassIb ||
                            ?iceClass = nltl:iceClassIc
                        ) &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion .
                        }
                    )
                )
            }
        """
    ] .
