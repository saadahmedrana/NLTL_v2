@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix nltlg: <urn:nltl:generated-shape:> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlg:LengthMillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

nltlg:LengthMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

nltlg:AngleDegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

nltlg:TRF052FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltlg:LengthMetreQuantityShape ;
        sh:message "A frame span in metres is required to select the applicable support scope."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "The frame ice class must be one of the permitted canonical ice-class values."
    ] ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:maxCount 1 ;
        sh:node nltlg:AngleDegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:maxCount 1 ;
        sh:node nltlg:LengthMillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:in (
            nltl:bowRegion
            nltl:midbodyRegion
            nltl:sternRegion
        )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the frame is asymmetrical or its web angle to the shell is below 90 degrees, antitripping support spacing must not exceed 1300 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:frameAsymmetrical true
                    }
                    ||
                    EXISTS {
                        $this nltl:frameWebAngleToShell ?angleNode .
                        ?angleNode qudt:numericValue ?angle .
                        FILTER ( ?angle < 90 )
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                    ?spacingNode qudt:numericValue ?spacing .
                    FILTER ( ?spacing <= 1300 )
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required antitripping support regions must be represented for the frame span and ice class." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:equivalentSupportStatusByDirectCalculation true
                }
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                FILTER (
                    (
                        ?span > 4
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:sternRegion
                            }
                        )
                    )
                    ||
                    (
                        ?span <= 4
                        &&
                        EXISTS {
                            $this nltl:iceClass nltl:iceClassIaSuper
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                        }
                    )
                    ||
                    (
                        ?span <= 4
                        &&
                        EXISTS {
                            $this nltl:iceClass nltl:iceClassIaSuper
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                        }
                    )
                    ||
                    (
                        ?span <= 4
                        &&
                        EXISTS {
                            $this nltl:iceClass nltl:iceClassIa
                        }
                        &&
                        (
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                            }
                        )
                    )
                    ||
                    (
                        ?span <= 4
                        &&
                        (
                            EXISTS {
                                $this nltl:iceClass nltl:iceClassIb
                            }
                            ||
                            EXISTS {
                                $this nltl:iceClass nltl:iceClassIc
                            }
                        )
                        &&
                        NOT EXISTS {
                            $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                        }
                    )
                )
            }
        """
    ] .
