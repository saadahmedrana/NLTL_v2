@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF055_NarrowDeckStripShape
    a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Abreast-of-hatch applicability must be recorded as one boolean value."
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice-stringer applicability must be recorded as one boolean value."
    ] ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Very-long-hatch status must be recorded as one boolean value."
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:node gen:ForcePerLengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Design line load must be supplied as one kN/m quantity."
    ] ;
    sh:property [
        sh:path nltl:hatchOpeningLength ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Hatch opening length must be supplied as one metre quantity."
    ] ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:class nltl:evidenceState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Scantling approval status must identify one evidence state."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:VolumeQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Section modulus must be supplied as one cm^3 quantity."
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:node gen:LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ship breadth must be supplied as one metre quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:actualSectionModulus ;
                sh:node gen:VolumeQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:requiredSectionModulus ;
                sh:node gen:VolumeQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:actualShearArea ;
                sh:node gen:AreaQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:node gen:AreaQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "Actual section modulus must be at least the required section modulus and actual shear area must be at least the required shear area." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX sh: <http://www.w3.org/ns/shacl#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:actualSectionModulus ?actualZ .
                        ?actualZ qudt:numericValue ?actualZValue .
                        $this nltl:requiredSectionModulus ?requiredZ .
                        ?requiredZ qudt:numericValue ?requiredZValue .
                        $this nltl:actualShearArea ?actualA .
                        ?actualA qudt:numericValue ?actualAValue .
                        $this nltl:requiredShearArea ?requiredA .
                        ?requiredA qudt:numericValue ?requiredAValue .
                        FILTER (?actualZValue < ?requiredZValue || ?actualAValue < ?requiredAValue)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:permittedReducedLineLoad ;
                sh:node gen:ReducedLineLoadQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) .

gen:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

gen:ForcePerLengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M>
    ] .

gen:VolumeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
    ] .

gen:AreaQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2>
    ] .

gen:ReducedLineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.10 ;
        sh:maxExclusive 0.15
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M>
    ] .
