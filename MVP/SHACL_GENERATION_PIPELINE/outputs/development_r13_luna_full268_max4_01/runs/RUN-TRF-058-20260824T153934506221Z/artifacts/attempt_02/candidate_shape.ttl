@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-058-WebFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:supportedStringerOutsideIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "supportedStringerOutsideIceBelt must be provided as a single boolean applicability value." ;
        sh:or (
            [
                sh:property [
                    sh:path nltl:supportedStringerOutsideIceBelt ;
                    sh:hasValue true
                ]
            ]
            [
                sh:property [
                    sh:path nltl:supportedStringerOutsideIceBelt ;
                    sh:hasValue false
                ]
            ]
        )
    ] ;
    sh:property [
        sh:path nltl:iceLoadForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "iceLoadForce must be a single force quantity in kN."
    ] ;
    sh:property [
        sh:path nltl:stringerOutsideIceBeltHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "stringerOutsideIceBeltHeight must be a single length quantity in m."
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "stringerSpan must be a single length quantity in m."
    ] ;
    sh:property [
        sh:path nltl:adjustedIceLoadForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "adjustedIceLoadForce must be a single force quantity in kN."
    ] ;
    sh:sparql [
        sh:message "When the supported stringer is outside the ice belt, adjustedIceLoadForce must equal iceLoadForce multiplied by (1 - stringerOutsideIceBeltHeight / stringerSpan); otherwise it must equal iceLoadForce." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:supportedStringerOutsideIceBelt ?outside ;
                      nltl:iceLoadForce ?forceNode ;
                      nltl:stringerOutsideIceBeltHeight ?heightNode ;
                      nltl:stringerSpan ?spanNode ;
                      nltl:adjustedIceLoadForce ?adjustedNode .

                ?forceNode qudt:numericValue ?force .
                ?heightNode qudt:numericValue ?height .
                ?spanNode qudt:numericValue ?span .
                ?adjustedNode qudt:numericValue ?adjusted .

                BIND(
                    IF(
                        ?outside = true,
                        (?force * (1 - (?height / ?span))),
                        ?force
                    )
                    AS ?expected
                )
                BIND(
                    IF(?expected >= 0, ?expected, -?expected)
                    AS ?absoluteExpected
                )
                BIND(
                    IF((?adjusted - ?expected) >= 0,
                       (?adjusted - ?expected),
                       -(?adjusted - ?expected))
                    AS ?absoluteDifference
                )
                BIND(
                    IF(?absoluteExpected > 0.000001,
                       (?absoluteExpected * 0.000001),
                       0.000001)
                    AS ?tolerance
                )

                FILTER(
                    (?outside = true &&
                     ?absoluteDifference > ?tolerance)
                    ||
                    (?outside = false &&
                     ?adjusted != ?force)
                )
            }
        """
    ] .
