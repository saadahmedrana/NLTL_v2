@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF060Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:node gen:CentiM2Quantity ;
        sh:minCount 1 ;
        sh:message "Actual web-frame cross-sectional area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:CentiM2Quantity ;
        sh:minCount 1 ;
        sh:message "Required shear area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:CentiM3Quantity ;
        sh:minCount 1 ;
        sh:message "Section modulus is required in cm3."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gen:M2Quantity ;
        sh:minCount 1 ;
        sh:message "Shear area is required in m2."
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:node gen:CentiM2Quantity ;
        sh:minCount 1 ;
        sh:message "Web-frame free-flange area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:node gen:KiloNQuantity ;
        sh:minCount 1 ;
        sh:message "Web-frame ice load is required in kN."
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:node gen:MegaNewtonMetreQuantity ;
        sh:minCount 1 ;
        sh:message "The externally computed maximum ice-load bending moment is required in MN m."
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:node gen:MetreQuantity ;
        sh:minCount 1 ;
        sh:message "Web-frame span is required in m."
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:node gen:CentiM2Quantity ;
        sh:minCount 1 ;
        sh:message "Web-frame web area is required in cm2."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:MegaPaQuantity ;
        sh:minCount 1 ;
        sh:message "Yield strength is required in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node gen:TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:message "A Table 4-8 lookup case is required."
    ] .

gen:TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:class nltl:tableReferenceValue ;
        sh:in ( nltl:traficomTable4Dash8 ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The lookup case must reference TRAFICOM Table 4-8."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Table-selection evidence is required for the lookup case."
    ] .

gen:CentiM2Quantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CentiM3Quantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:M2Quantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KiloNQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonMetreQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPaQuantity
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
