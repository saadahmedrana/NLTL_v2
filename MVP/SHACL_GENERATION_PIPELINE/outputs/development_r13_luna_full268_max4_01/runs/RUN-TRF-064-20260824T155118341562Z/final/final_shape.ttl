@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The detached-strut applicability indicator must be recorded exactly once."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:class nltl:shipComponent
    ] ;
    sh:or (
        gen:TRF064NormalEnclosureBranch
        gen:TRF064DetachedStrutBranch
    ) .

gen:TRF064NormalEnclosureBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked side-propeller shafting assembly must be a ship component and be enclosed by plated bossing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasSidePropellerShafting ?shaft .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?shaft .
                    ?shaft a nltl:shipComponent .
                    ?shaft nltl:enclosedByPlatedBossing ?bossing .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked stern tube must be a ship component and be enclosed by plated bossing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasSternTube ?sternTube .
                FILTER NOT EXISTS {
                    $this nltl:hasComponent ?sternTube .
                    ?sternTube a nltl:shipComponent .
                    ?sternTube nltl:enclosedByPlatedBossing ?bossing .
                }
            }
        """
    ] .

gen:TRF064DetachedStrutBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:minCount 1 ;
        sh:node gen:TRF064DetachedStrutShape ;
        sh:message "A detached strut must provide design, hull-attachment, and strength evidence."
    ] .

gen:TRF064DetachedStrutShape
    a sh:NodeShape ;
    sh:class nltl:detachedStrutStructure ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:strutDesignEvidence
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:strutHullAttachmentEvidence
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:strutStrengthEvidence
        ]
    ] .
