@prefix nltlgen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:Trf070ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:mainPropulsionThruster ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:thrusterType ;
                sh:datatype xsd:string ;
                sh:in ( "azimuthing" "fixed" ) ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:thrusterType ;
                        sh:hasValue "fixed" ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propellerIceInteractionLoad ;
                        sh:node nltlgen:KiloNewtonQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:thrusterBodyIceInteractionLoad ;
                        sh:node nltlgen:KiloNewtonQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:thrusterType ;
                        sh:hasValue "azimuthing" ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:propellerIceInteractionLoad ;
                        sh:node nltlgen:KiloNewtonQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:thrusterBodyIceInteractionLoad ;
                        sh:node nltlgen:KiloNewtonQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:serviceLife ;
                        sh:node nltlgen:YearQuantityShape ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:hasDesignCondition ;
                        sh:class nltl:designCondition ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node nltlgen:AzimuthingDesignConditionShape
                    ] ;
                    sh:property [
                        sh:path nltl:extremeLoad ;
                        sh:maxCount 1 ;
                        sh:node nltlgen:KiloNewtonQuantityShape
                    ] ;
                    sh:property [
                        sh:path nltl:hasDesignCondition ;
                        sh:or (
                            [
                                sh:property [
                                    sh:path nltl:normalOperationalConditions ;
                                    sh:hasValue true ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ]
                            ]
                            [
                                sh:property [
                                    sh:path nltl:designConditionLocalStrengthCapacity ;
                                    sh:node nltlgen:KiloNewtonQuantityShape ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ] ;
                                sh:property [
                                    sh:path nltl:normalOperationalConditions ;
                                    sh:hasValue true ;
                                    sh:minCount 1 ;
                                    sh:maxCount 1
                                ]
                            ]
                        )
                    ] ;
                    sh:sparql [
                        sh:message "For an azimuthing main-propulsion thruster, the thruster-body ice-interaction load must equal the expected service-life load recorded on the normal-operational design condition." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:mainPropulsionThruster true .
                                $this nltl:thrusterType "azimuthing" .
                                $this nltl:thrusterBodyIceInteractionLoad ?bodyLoad .
                                $this nltl:hasDesignCondition ?condition .
                                ?condition nltl:normalOperationalConditions true .
                                ?condition nltl:designConditionExpectedLoad ?expectedLoad .
                                ?bodyLoad qudt:numericValue ?bodyValue ;
                                          qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                                ?expectedLoad qudt:numericValue ?expectedValue ;
                                             qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                                FILTER ( xsd:decimal(?bodyValue) != xsd:decimal(?expectedValue) )
                            }
                        """
                    ]
                ]
            )
        ]
    ) .

nltlgen:AzimuthingDesignConditionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:normalOperationalConditions ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designConditionExpectedLoad ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:YearQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/YR> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltlgen:ExtremeLoadStrengthReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeLoad ;
        sh:node nltlgen:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:localIcePressure ;
        sh:node nltlgen:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasDesignCondition ;
        sh:class nltl:designCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:designConditionLocalStrengthCapacity ;
                sh:node nltlgen:KiloNewtonQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

nltlgen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
