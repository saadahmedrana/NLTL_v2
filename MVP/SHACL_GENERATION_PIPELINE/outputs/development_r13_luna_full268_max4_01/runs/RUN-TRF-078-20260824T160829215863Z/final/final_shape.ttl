@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:nodeKind sh:IRI ;
        sh:node gen:TRF078TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:qualifiedValueShape gen:TRF078Table6Dash6CaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true ;
        sh:message "The ship shall have a Table 6-6 lookup case." ;
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:nodeKind sh:IRI ;
        sh:node gen:TRF078TableLookupCaseShape ;
        sh:minCount 1 ;
        sh:qualifiedValueShape gen:TRF078Table6Dash7CaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShapesDisjoint true ;
        sh:message "The ship shall have a Table 6-7 lookup case." ;
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078UnitlessQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078UnitlessQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078UnitlessQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount shall equal k1 * k2 * k3 * N_class * n_n, within a relative and absolute tolerance of 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case6 ;
                      nltl:hasTableLookupCase ?case7 ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:iceLoadCycleCount ?reported .

                ?case6 nltl:tableReference nltl:traficomTable6Dash6 ;
                        nltl:iceClass ?iceClass ;
                        nltl:selectedIceClassCycleCount ?nclassNode .

                ?case7 nltl:tableReference nltl:traficomTable6Dash7 ;
                        nltl:selectedPropellerLocationFactor ?k1Node .

                ?k2Node qudt:numericValue ?k2 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k3Node qudt:numericValue ?k3 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?nnNode qudt:numericValue ?nn ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?nclassNode qudt:numericValue ?nclass ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?k1Node qudt:numericValue ?k1 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                BIND((?k1 * ?k2 * ?k3 * ?nclass * ?nn) AS ?expected)
                FILTER (
                    (?reported - ?expected > ((?expected * 0.000001) + 0.000001)) ||
                    (?expected - ?reported > ((?expected * 0.000001) + 0.000001))
                )
            }
        """
    ] .

gen:TRF078TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tableReferenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each table lookup case shall have exactly one table reference." ;
    ] .

gen:TRF078Table6Dash6CaseShape
    a sh:NodeShape ;
    sh:node gen:TRF078TableLookupCaseShape ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-6 lookup case shall use an ice-class selection key." ;
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078UnitlessQuantityShape ;
        sh:message "The Table 6-6 lookup case shall provide N_class." ;
    ] .

gen:TRF078Table6Dash7CaseShape
    a sh:NodeShape ;
    sh:node gen:TRF078TableLookupCaseShape ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The Table 6-7 lookup case shall use a propeller-location selection key." ;
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF078UnitlessQuantityShape ;
        sh:message "The Table 6-7 lookup case shall provide k1." ;
    ] .

gen:TRF078UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
