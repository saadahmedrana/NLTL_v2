@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

gs:TRF_079_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerImmersionFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerShaftCentrelineDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCoefficientK2 must equal the prescribed piecewise function of propellerImmersionFunction, where propellerImmersionFunction is derived from propellerShaftCentrelineDepth, designIceThickness, and propellerDiameter; calculated decimal results are checked within a relative tolerance of 1e-6 with a 1e-6 absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:propellerImmersionFunction ?immersionNode ;
                      nltl:propellerShaftCentrelineDepth ?depthNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .

                ?iceNode qudt:numericValue ?ice .
                ?diameterNode qudt:numericValue ?diameter .
                ?immersionNode qudt:numericValue ?reportedF .
                ?depthNode qudt:numericValue ?h0 .
                ?k2Node qudt:numericValue ?reportedK2 .

                BIND (((?h0 - ?ice) / (?diameter / 2)) - 1 AS ?calculatedF)

                BIND (
                    IF(
                        ?calculatedF < 0,
                        0.8 - ?calculatedF,
                        IF(
                            ?calculatedF <= 1,
                            0.8 - (0.4 * ?calculatedF),
                            IF(
                                ?calculatedF <= 2.5,
                                0.6 - (0.2 * ?calculatedF),
                                0.1
                            )
                        )
                    ) AS ?expectedK2
                )

                BIND (
                    IF(
                        (?expectedK2 * 0.000001) > 0.000001,
                        ?expectedK2 * 0.000001,
                        0.000001
                    ) AS ?tolerance
                )

                FILTER (
                    ?reportedF != ?calculatedF ||
                    ?reportedK2 < (?expectedK2 - ?tolerance) ||
                    ?reportedK2 > (?expectedK2 + ?tolerance)
                )
            }
        """
    ] .
