@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-086> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a CP propeller, a known pitch requires a bollard-condition MCR pitch; an unknown pitch requires bollard pitch equal to 0.7 times the free-running MCR pitch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType ;
                      nltl:pitchValueKnown ?pitchKnown .
                FILTER (
                    (
                        ?propellerType = "CP"^^xsd:string &&
                        ?pitchKnown = true &&
                        NOT EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?bollard .
                            ?bollard rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?bollardValue ;
                                     qudt:unit unit:M .
                            FILTER (datatype(?bollardValue) = xsd:decimal)
                        }
                    )
                    ||
                    (
                        ?propellerType = "CP"^^xsd:string &&
                        ?pitchKnown = false &&
                        NOT EXISTS {
                            $this nltl:propellerPitchAtMcrBollard ?bollard ;
                                  nltl:propellerPitchAtMcrFreeRunning ?freeRunning .
                            ?bollard rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?bollardValue ;
                                     qudt:unit unit:M .
                            ?freeRunning rdf:type qudt:QuantityValue ;
                                          qudt:numericValue ?freeRunningValue ;
                                          qudt:unit unit:M .
                            FILTER (
                                datatype(?bollardValue) = xsd:decimal &&
                                datatype(?freeRunningValue) = xsd:decimal
                            )
                            BIND((0.7 * ?freeRunningValue) AS ?expectedValue)
                            FILTER (
                                ABS(?bollardValue - ?expectedValue) <=
                                (0.000001 * ABS(?expectedValue))
                                ||
                                ABS(?bollardValue - ?expectedValue) <= 0.000001
                            )
                        }
                    )
                )
            }
        """
    ] .
