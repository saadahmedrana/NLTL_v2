@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

nltl:TRF091_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:node nltl:TRF091_LoadCasePurposeShape ;
        sh:message "The ship shall identify an ice-milling sequence case used for the propulsion-line strength evaluation."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node nltl:TRF091_LoadCasePurposeShape ;
        sh:message "The ship shall identify a propulsion load case for the strength evaluation."
    ] .

nltl:TRF091_LoadCasePurposeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:minCount 1 ;
        sh:message "The load case shall be designated for propulsion-line strength evaluation."
    ] ;
    sh:not [
        sh:property [
            sh:path nltl:loadCasePurpose ;
            sh:hasValue nltl:stallingAnalysisPurposeValue
        ]
    ] ;
    sh:message "The load case shall not be designated for propulsion-system stalling analysis." .
