@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-101> a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:bladeChordLengthAtWeakestSection ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeCylindricalRootRadius ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeMaximumThicknessAtWeakestSection ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeMinimumYieldStrength ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeUltimateTensileStrength ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeReferenceStrength1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:bladeTipOffset ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;

    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:bladeFailureLoadApplicationRadiusRatio ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:property [
                    sh:path qudt:numericValue ;
                    sh:datatype xsd:decimal ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:minInclusive 0.8 ;
                    sh:maxInclusive 0.8
                ] ;
                sh:property [
                    sh:path qudt:unit ;
                    sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                    sh:minCount 1 ;
                    sh:maxCount 1
                ]
            ] ;
            sh:property [
                sh:path nltl:bladeFailureLoadWeakestDirectionConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:approvedNonlinearBladeStressAnalysis ;
                sh:minCount 1
            ]
        ]
        [
            sh:sparql [
                sh:message "Blade failure ultimate load and reference strength must match the prescribed direct calculation within a relative tolerance of 1e-6 with an absolute fallback of 1e-12." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:bladeChordLengthAtWeakestSection ?cNode ;
                              nltl:bladeCylindricalRootRadius ?rNode ;
                              nltl:bladeMaximumThicknessAtWeakestSection ?tNode ;
                              nltl:bladeMinimumYieldStrength ?yieldNode ;
                              nltl:bladeUltimateTensileStrength ?ultimateNode ;
                              nltl:bladeReferenceStrength1 ?refNode ;
                              nltl:bladeFailureUltimateLoad ?loadNode ;
                              nltl:propellerDiameter ?diameterNode .
                        ?cNode qudt:numericValue ?c .
                        ?rNode qudt:numericValue ?r .
                        ?tNode qudt:numericValue ?t .
                        ?yieldNode qudt:numericValue ?yield .
                        ?ultimateNode qudt:numericValue ?ultimate .
                        ?refNode qudt:numericValue ?ref .
                        ?loadNode qudt:numericValue ?load .
                        ?diameterNode qudt:numericValue ?diameter .
                        BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedRef)
                        BIND ((300 * ?c * ?t * ?t * ?expectedRef) /
                              ((0.8 * ?diameter) - (2 * ?r)) AS ?expectedLoad)
                        BIND (IF(?expectedRef >= 0,
                                 (1e-6 * ?expectedRef) + 1e-12,
                                 (1e-6 * (-?expectedRef)) + 1e-12) AS ?refTolerance)
                        BIND (IF(?expectedLoad >= 0,
                                 (1e-6 * ?expectedLoad) + 1e-12,
                                 (1e-6 * (-?expectedLoad)) + 1e-12) AS ?loadTolerance)
                        FILTER (
                            (?ref > (?expectedRef + ?refTolerance)) ||
                            (?ref < (?expectedRef - ?refTolerance)) ||
                            (?load > (?expectedLoad + ?loadTolerance)) ||
                            (?load < (?expectedLoad - ?loadTolerance))
                        )
                    }
                """
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "Blade failure status must be true exactly when blade tip offset exceeds 10% of propeller diameter." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeTipOffset ?offsetNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:bladeFailureStatus ?status .
                ?offsetNode qudt:numericValue ?offset .
                ?diameterNode qudt:numericValue ?diameter .
                FILTER (
                    (?offset > (0.10 * ?diameter) && ?status != true) ||
                    (?offset <= (0.10 * ?diameter) && ?status != false)
                )
            }
        """
    ] .
