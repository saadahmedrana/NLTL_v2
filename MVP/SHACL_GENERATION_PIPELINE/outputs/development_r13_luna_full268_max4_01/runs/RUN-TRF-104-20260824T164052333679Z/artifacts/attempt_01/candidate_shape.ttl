@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-104-ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:pyramidStrengthPrinciple ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship shall record that its propulsion line is designed according to the pyramid strength principle."
    ] .

<urn:nltl:generated-shape:TRF-104-shaft-line-component>
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasPropellerShaftLineComponent ;
    sh:property [
        sh:path nltl:significantDamageFromBladeLoss ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Each linked propeller shaft line component shall state whether significant damage from propeller blade loss occurs."
    ] ;
    sh:sparql [
        sh:message "Loss of the propeller blade shall not cause significant damage to a linked propeller shaft line component." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:significantDamageFromBladeLoss ?damage .
                FILTER (?damage = "true"^^xsd:boolean)
            }
        """
    ] .
