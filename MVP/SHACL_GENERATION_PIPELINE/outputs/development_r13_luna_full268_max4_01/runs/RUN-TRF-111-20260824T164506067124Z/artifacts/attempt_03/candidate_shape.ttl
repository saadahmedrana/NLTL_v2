@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ExtremeIceForceShape ;
        sh:message "The ship must provide the externally calculated extreme ice force in kN."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:node gs:LoadCaseShape
    ] .

gs:ExtremeIceForceShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:KiloN
    ] .

gs:LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class nltl:shaftLineLoadCaseTypeValue
        ] ;
        sh:message "Each propulsion load case must identify a shaft-line load-case type value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:hasValue nltl:extremeOperationalLoadCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ExtremeOperationalSafetyFactorShape ;
                sh:message "An extreme operational load case must have a component yield safety factor of at least 1.3."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:hasValue nltl:fatigueLoadCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path [
                    sh:inversePath nltl:hasPropulsionLoadCase
                ] ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasPropellerShaftLineComponent ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class nltl:shipComponent ;
                            sh:property [
                                sh:path nltl:fatigueSafetyFactor ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node gs:FatigueSafetyFactorShape ;
                                sh:message "Each linked propeller shaft-line component must have a fatigue safety factor of at least 1.5."
                            ]
                        ]
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:hasValue nltl:bladeFailureLoadCase ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:componentYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:BladeFailureSafetyFactorShape ;
                sh:message "A blade-failure load case must have a component yield safety factor of at least 1.0."
            ]
        ]
    ) .

gs:ExtremeOperationalSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gs:FatigueSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.5
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .

gs:BladeFailureSafetyFactorShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:UNITLESS
    ] .
