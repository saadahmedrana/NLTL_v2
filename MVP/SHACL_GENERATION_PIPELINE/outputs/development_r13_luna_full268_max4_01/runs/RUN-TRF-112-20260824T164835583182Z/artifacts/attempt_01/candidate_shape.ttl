@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-112-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:propellerShaftLineComponent ;
            sh:property [
                sh:path nltl:bendingYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:torsionalYieldSafetyFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable blade-failure load case must provide decimal ultimate and combined axial, bending, and torsion loads in kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:hasPropulsionLoadCase ?loadCase .
    ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
    FILTER (
        NOT EXISTS {
            ?loadCase nltl:bladeFailureUltimateLoad ?ultimate .
            ?ultimate qudt:numericValue ?ultimateValue ;
                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
            FILTER (datatype(?ultimateValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?loadCase nltl:bladeFailureUltimateLoad ?badUltimate .
            FILTER NOT EXISTS {
                ?badUltimate qudt:numericValue ?validUltimateValue ;
                             qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (datatype(?validUltimateValue) = xsd:decimal)
            }
        }
        ||
        NOT EXISTS {
            ?loadCase nltl:combinedAxialBendingTorsionLoad ?combined .
            ?combined qudt:numericValue ?combinedValue ;
                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
            FILTER (datatype(?combinedValue) = xsd:decimal)
        }
        ||
        EXISTS {
            ?loadCase nltl:combinedAxialBendingTorsionLoad ?badCombined .
            FILTER NOT EXISTS {
                ?badCombined qudt:numericValue ?validCombinedValue ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (datatype(?validCombinedValue) = xsd:decimal)
            }
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For each applicable blade-failure load case, bending and torsional yield safety factors must be at least 1.0." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:hasPropulsionLoadCase ?loadCase ;
          nltl:hasPropellerShaftLineComponent ?component .
    ?loadCase nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
    FILTER (
        NOT EXISTS {
            ?component nltl:bendingYieldSafetyFactor ?bending .
            ?bending qudt:numericValue ?bendingValue ;
                     qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
            FILTER (datatype(?bendingValue) = xsd:decimal && ?bendingValue >= 1.0)
        }
        ||
        EXISTS {
            ?component nltl:bendingYieldSafetyFactor ?badBending .
            FILTER NOT EXISTS {
                ?badBending qudt:numericValue ?validBendingValue ;
                            qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (datatype(?validBendingValue) = xsd:decimal && ?validBendingValue >= 1.0)
            }
        }
        ||
        NOT EXISTS {
            ?component nltl:torsionalYieldSafetyFactor ?torsional .
            ?torsional qudt:numericValue ?torsionalValue ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
            FILTER (datatype(?torsionalValue) = xsd:decimal && ?torsionalValue >= 1.0)
        }
        ||
        EXISTS {
            ?component nltl:torsionalYieldSafetyFactor ?badTorsional .
            FILTER NOT EXISTS {
                ?badTorsional qudt:numericValue ?validTorsionalValue ;
                              qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (datatype(?validTorsionalValue) = xsd:decimal && ?validTorsionalValue >= 1.0)
            }
        }
    )
}
"""
    ] .
