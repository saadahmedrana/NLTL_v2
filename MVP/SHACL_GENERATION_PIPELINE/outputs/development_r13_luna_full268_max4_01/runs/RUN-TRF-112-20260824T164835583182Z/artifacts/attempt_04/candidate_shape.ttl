@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-112> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:shaftLineLoadCaseType ;
                sh:class nltl:shaftLineLoadCaseTypeValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each supplied propulsion load case must identify exactly one shaft line load case type."
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "An applicable total-blade-failure load case must provide exactly one decimal blade failure ultimate load QuantityValue in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?lc .
                ?lc nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                FILTER (
                    NOT EXISTS {
                        ?lc nltl:bladeFailureUltimateLoad ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:KiloN .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?lc nltl:bladeFailureUltimateLoad ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        ?lc nltl:bladeFailureUltimateLoad ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (str(?v1) != str(?v2))
                    }
                    ||
                    EXISTS {
                        ?lc nltl:bladeFailureUltimateLoad ?q .
                        ?q qudt:numericValue ?v .
                        FILTER (datatype(?v) != xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?lc nltl:bladeFailureUltimateLoad ?q .
                        ?q qudt:unit ?u .
                        FILTER (?u != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable total-blade-failure load case must provide exactly one decimal combined axial, bending, and torsion load QuantityValue in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?lc .
                ?lc nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                FILTER (
                    NOT EXISTS {
                        ?lc nltl:combinedAxialBendingTorsionLoad ?q .
                        ?q qudt:numericValue ?v ;
                           qudt:unit unit:KiloN .
                        FILTER (datatype(?v) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?lc nltl:combinedAxialBendingTorsionLoad ?q1, ?q2 .
                        FILTER (?q1 != ?q2)
                    }
                    ||
                    EXISTS {
                        ?lc nltl:combinedAxialBendingTorsionLoad ?q .
                        ?q qudt:numericValue ?v1, ?v2 .
                        FILTER (str(?v1) != str(?v2))
                    }
                    ||
                    EXISTS {
                        ?lc nltl:combinedAxialBendingTorsionLoad ?q .
                        ?q qudt:numericValue ?v .
                        FILTER (datatype(?v) != xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?lc nltl:combinedAxialBendingTorsionLoad ?q .
                        ?q qudt:unit ?u .
                        FILTER (?u != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each supplied propeller shaft line component applicable to a total-blade-failure load case must have exactly one bending and one torsional yield safety factor, each dimensionless and at least 1.0." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasPropulsionLoadCase ?lc .
                ?lc nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .
                $this nltl:hasPropellerShaftLineComponent ?component .
                FILTER (
                    NOT EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bq .
                        ?bq qudt:numericValue ?bv ;
                            qudt:unit unit:UNITLESS .
                        FILTER (datatype(?bv) = xsd:decimal && ?bv >= 1.0)
                    }
                    ||
                    EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bq1, ?bq2 .
                        FILTER (?bq1 != ?bq2)
                    }
                    ||
                    EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bq .
                        ?bq qudt:numericValue ?bv1, ?bv2 .
                        FILTER (str(?bv1) != str(?bv2))
                    }
                    ||
                    EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bq .
                        ?bq qudt:numericValue ?bv .
                        FILTER (datatype(?bv) != xsd:decimal || ?bv < 1.0)
                    }
                    ||
                    EXISTS {
                        ?component nltl:bendingYieldSafetyFactor ?bq .
                        ?bq qudt:unit ?bu .
                        FILTER (?bu != unit:UNITLESS)
                    }
                    ||
                    NOT EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?tq .
                        ?tq qudt:numericValue ?tv ;
                            qudt:unit unit:UNITLESS .
                        FILTER (datatype(?tv) = xsd:decimal && ?tv >= 1.0)
                    }
                    ||
                    EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?tq1, ?tq2 .
                        FILTER (?tq1 != ?tq2)
                    }
                    ||
                    EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?tq .
                        ?tq qudt:numericValue ?tv1, ?tv2 .
                        FILTER (str(?tv1) != str(?tv2))
                    }
                    ||
                    EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?tq .
                        ?tq qudt:numericValue ?tv .
                        FILTER (datatype(?tv) != xsd:decimal || ?tv < 1.0)
                    }
                    ||
                    EXISTS {
                        ?component nltl:torsionalYieldSafetyFactor ?tq .
                        ?tq qudt:unit ?tu .
                        FILTER (?tu != unit:UNITLESS)
                    }
                )
            }
        """
    ] .
