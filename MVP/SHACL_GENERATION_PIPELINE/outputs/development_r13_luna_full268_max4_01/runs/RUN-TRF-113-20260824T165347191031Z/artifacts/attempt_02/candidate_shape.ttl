@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-113-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:steeringMechanism
        ] ;
        sh:message "The ship must identify its steering mechanism subject to the blade plastic-bending design condition."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:thrusterFitting
        ] ;
        sh:message "The ship must identify the fitting of the thruster unit subject to the blade plastic-bending design condition."
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:thrusterBody
        ] ;
        sh:message "The ship must identify the thruster body subject to the blade plastic-bending design condition."
    ] ;
    sh:property [
        sh:path nltl:bladePlasticBending ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the plastic-bending-without-damage design condition."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeOrientation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "The ship must record the propeller blade orientation producing the maximum component load."
    ] ;
    sh:property [
        sh:path nltl:bladeLossLoad ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:KiloN
            ]
        ] ;
        sh:message "The ship must record the blade-loss load in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "The ship must provide evidence for the blade-loss design condition."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:loadCase ;
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ] ;
        sh:message "A propulsion load case must confirm that the selected blade orientation produces the maximum load on the component studied."
    ] ;
    sh:sparql [
        sh:message "The plastic-bending design evidence, selected blade orientation, blade-loss load, and confirmed maximum-load case must be present together for the ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this a nltl:ship ;
                      nltl:bladePlasticBending ?bending ;
                      nltl:propellerBladeOrientation ?orientation ;
                      nltl:bladeLossLoad ?load ;
                      nltl:thrusterBladeLossDesignEvidence ?evidence ;
                      nltl:hasPropulsionLoadCase ?case .
                ?case a nltl:loadCase ;
                      nltl:maximumComponentLoadBladeOrientationConfirmed true .
                ?evidence a nltl:evidenceArtifact .
                ?load a qudt:QuantityValue ;
                      qudt:numericValue ?numericValue ;
                      qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER (datatype(?bending) = xsd:string)
                FILTER (datatype(?orientation) = xsd:string)
                FILTER (datatype(?numericValue) = xsd:decimal)
            }
        """
    ] .
