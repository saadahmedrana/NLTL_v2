@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-123-QuantityValueMPa>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-123-QuantityValueUnitless>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-123-MaterialProperties>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-123-QuantityValueMPa>
    ] .

<urn:nltl:generated-shape:TRF-123-AssessedComponent>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:occasionalForceComponentStress ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-123-QuantityValueMPa>
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-123-MaterialProperties>
    ] .

<urn:nltl:generated-shape:TRF-123-OccasionalForceCase>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:occasionalForceCaseAssessedComponent ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-123-AssessedComponent>
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF-123-LoadCase>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-123-QuantityValueUnitless>
    ] .

<urn:nltl:generated-shape:TRF-123-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:node [
            sh:node <urn:nltl:generated-shape:TRF-123-OccasionalForceCase> ;
            sh:node <urn:nltl:generated-shape:TRF-123-LoadCase>
        ]
    ] ;
    sh:sparql [
        sh:message "For each applicable occasional-force case and assessed component, stress must not exceed the material yield strength reduced by the component safety factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:hasOccasionalForceLoadCase ?case .
                ?case nltl:propellerBladeExcludedFromOccasionalForceScope false .
                ?case nltl:occasionalForceCaseAssessedComponent ?component .
                ?component nltl:occasionalForceComponentStress ?stressValue .
                ?stressValue qudt:numericValue ?stress ;
                    qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?component nltl:hasMaterialProperties ?material .
                ?material nltl:componentMaterialYieldStrength ?yieldValue .
                ?yieldValue qudt:numericValue ?yield ;
                    qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?case nltl:componentYieldSafetyFactor ?factorValue .
                ?factorValue qudt:numericValue ?factor ;
                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER (?factor > 0 && ?stress > (?yield / ?factor))
            }
        """
    ] .
