@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-131-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:inletChest
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The ship must have at least one inlet chest." ;
    ] ;
    sh:property [
        sh:path nltl:substituteArrangementStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "A ballast-water cooling arrangement must not be accepted as a substitute for an inlet chest." ;
    ] .
