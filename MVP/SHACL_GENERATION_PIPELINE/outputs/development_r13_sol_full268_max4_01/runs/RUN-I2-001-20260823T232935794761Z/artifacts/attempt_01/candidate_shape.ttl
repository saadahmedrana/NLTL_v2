@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2-001Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:message "Ships contracted on or after 1 January 2021 must record UR I2 Rev.4 as applicable." ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:maxExclusive "2021-01-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:minCount 1 ;
                sh:datatype xsd:date ;
                sh:minInclusive "2021-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:urI2RevisionApplicability ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ]
        ]
    ) .
