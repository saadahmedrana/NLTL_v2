@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:AverageIcePressureValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FixedAspectRatioValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:OtherIceStrengthenedAreaAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:hullAreaAssignment ;
    sh:property [
        sh:path nltl:assignedHullArea ;
        sh:hasValue nltl:otherIceStrengthenedArea ;
        sh:minCount 1
    ] .

gen:I2_009_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:buttockAngle ;
        sh:node gen:AngleValueShape ;
        sh:minCount 1 ;
        sh:message "The buttock angle is required to determine bow-form applicability."
    ] ;
    sh:property [
        sh:path nltl:normalFrameAngle ;
        sh:node gen:AngleValueShape ;
        sh:minCount 1 ;
        sh:message "The normal frame angle is required to determine bow-form applicability."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                sh:minExclusive 0 ;
                sh:maxExclusive 80
            ] ;
            sh:property [
                sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                sh:minExclusive 10
            ]
        ]
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                        sh:maxInclusive 0
                    ]
                ]
                [
                    sh:property [
                        sh:path ( nltl:buttockAngle qudt:numericValue ) ;
                        sh:minInclusive 80
                    ]
                ]
                [
                    sh:property [
                        sh:path ( nltl:normalFrameAngle qudt:numericValue ) ;
                        sh:maxInclusive 10
                    ]
                ]
            )
        ]
    ) ;

    sh:or (
        [
            sh:property [
                sh:path nltl:hasHullAreaAssignment ;
                sh:qualifiedValueShape gen:OtherIceStrengthenedAreaAssignmentShape ;
                sh:qualifiedMaxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasHullAreaAssignment ;
                sh:qualifiedValueShape gen:OtherIceStrengthenedAreaAssignmentShape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:averageIcePressure ;
                sh:node gen:AverageIcePressureValueShape ;
                sh:minCount 1 ;
                sh:message "Average ice pressure is required for an other ice-strengthened area."
            ] ;
            sh:property [
                sh:path nltl:nonBowLoadPatchHeight ;
                sh:node gen:LengthValueShape ;
                sh:minCount 1 ;
                sh:message "Non-bow load patch height is required for an other ice-strengthened area."
            ] ;
            sh:property [
                sh:path nltl:nonBowLoadPatchLength ;
                sh:node gen:LengthValueShape ;
                sh:minCount 1 ;
                sh:message "Non-bow load patch length is required for an other ice-strengthened area."
            ] ;
            sh:property [
                sh:path nltl:loadPatchAspectRatio ;
                sh:node gen:FixedAspectRatioValueShape ;
                sh:minCount 1 ;
                sh:message "The load patch aspect ratio shall be 3.6 for an other ice-strengthened area."
            ]
        ]
    ) .
