@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Each bow subregion calculation case must report one mid-length position in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionAspectRatio ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Each bow subregion calculation case must report one aspect ratio."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape ;
        sh:message "Each bow subregion calculation case must report one calculated force in meganewtons."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonPerMetreQuantityShape ;
        sh:message "Each bow subregion calculation case must report one calculated line load in the canonical unit."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculatedPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "Each bow subregion calculation case must report one calculated pressure in megapascals."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCalculationEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Each bow subregion calculation case must carry calculation evidence."
    ] .

gen:I2_014_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "The ship must provide one bow length in metres."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:BowSubregionCalculationCaseShape ;
        sh:message "The ship must have exactly four bow subregion calculation cases."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape ;
        sh:message "The maximum calculated bow force must be selected."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonPerMetreQuantityShape ;
        sh:message "The maximum calculated bow line load must be selected."
    ] ;
    sh:property [
        sh:path nltl:selectedMaximumBowPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaPascalQuantityShape ;
        sh:message "The maximum calculated bow pressure must be selected."
    ] ;
    sh:sparql [
        sh:message "Each subregion mid-length position must correspond to one of the four equal-length bow subregion midpoints." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?case
            WHERE {
                $this nltl:bowLength ?lengthQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case .
                ?lengthQuantity qudt:numericValue ?length .
                ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
                ?positionQuantity qudt:numericValue ?position .
                BIND(?length / 8.0 AS ?p1)
                BIND((3.0 * ?length) / 8.0 AS ?p2)
                BIND((5.0 * ?length) / 8.0 AS ?p3)
                BIND((7.0 * ?length) / 8.0 AS ?p4)
                BIND(IF(ABS(?p1) * 0.000001 > 0.000000001,
                        ABS(?p1) * 0.000001, 0.000000001) AS ?t1)
                BIND(IF(ABS(?p2) * 0.000001 > 0.000000001,
                        ABS(?p2) * 0.000001, 0.000000001) AS ?t2)
                BIND(IF(ABS(?p3) * 0.000001 > 0.000000001,
                        ABS(?p3) * 0.000001, 0.000000001) AS ?t3)
                BIND(IF(ABS(?p4) * 0.000001 > 0.000000001,
                        ABS(?p4) * 0.000001, 0.000000001) AS ?t4)
                FILTER(
                    ABS(?position - ?p1) > ?t1 &&
                    ABS(?position - ?p2) > ?t2 &&
                    ABS(?position - ?p3) > ?t3 &&
                    ABS(?position - ?p4) > ?t4
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The four bow subregion cases must represent four distinct equal-length subregion midpoints." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:bowLength ?lengthQuantity ;
                      nltl:hasBowSubregionCalculationCase ?case1 ;
                      nltl:hasBowSubregionCalculationCase ?case2 .
                FILTER(?case1 != ?case2)
                ?lengthQuantity qudt:numericValue ?length .
                ?case1 nltl:bowSubregionMidLengthPosition ?positionQuantity1 .
                ?case2 nltl:bowSubregionMidLengthPosition ?positionQuantity2 .
                ?positionQuantity1 qudt:numericValue ?position1 .
                ?positionQuantity2 qudt:numericValue ?position2 .
                BIND(?length / 8.0 AS ?p1)
                BIND((3.0 * ?length) / 8.0 AS ?p2)
                BIND((5.0 * ?length) / 8.0 AS ?p3)
                BIND((7.0 * ?length) / 8.0 AS ?p4)
                BIND(IF(ABS(?p1) * 0.000001 > 0.000000001,
                        ABS(?p1) * 0.000001, 0.000000001) AS ?t1)
                BIND(IF(ABS(?p2) * 0.000001 > 0.000000001,
                        ABS(?p2) * 0.000001, 0.000000001) AS ?t2)
                BIND(IF(ABS(?p3) * 0.000001 > 0.000000001,
                        ABS(?p3) * 0.000001, 0.000000001) AS ?t3)
                BIND(IF(ABS(?p4) * 0.000001 > 0.000000001,
                        ABS(?p4) * 0.000001, 0.000000001) AS ?t4)
                FILTER(
                    (ABS(?position1 - ?p1) <= ?t1 &&
                     ABS(?position2 - ?p1) <= ?t1) ||
                    (ABS(?position1 - ?p2) <= ?t2 &&
                     ABS(?position2 - ?p2) <= ?t2) ||
                    (ABS(?position1 - ?p3) <= ?t3 &&
                     ABS(?position2 - ?p3) <= ?t3) ||
                    (ABS(?position1 - ?p4) <= ?t4 &&
                     ABS(?position2 - ?p4) <= ?t4)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Selected bow force, line load and pressure must equal the respective maxima reported by the four subregion cases within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:selectedMaximumBowForce ?selectedForceQuantity ;
                      nltl:selectedMaximumBowLineLoad ?selectedLineLoadQuantity ;
                      nltl:selectedMaximumBowPressure ?selectedPressureQuantity .
                ?selectedForceQuantity qudt:numericValue ?selectedForce .
                ?selectedLineLoadQuantity qudt:numericValue ?selectedLineLoad .
                ?selectedPressureQuantity qudt:numericValue ?selectedPressure .
                {
                    SELECT ?ship
                           (MAX(?force) AS ?maximumForce)
                           (MAX(?lineLoad) AS ?maximumLineLoad)
                           (MAX(?pressure) AS ?maximumPressure)
                    WHERE {
                        ?ship nltl:hasBowSubregionCalculationCase ?case .
                        ?case nltl:bowSubregionCalculatedForce ?forceQuantity ;
                              nltl:bowSubregionCalculatedLineLoad ?lineLoadQuantity ;
                              nltl:bowSubregionCalculatedPressure ?pressureQuantity .
                        ?forceQuantity qudt:numericValue ?force .
                        ?lineLoadQuantity qudt:numericValue ?lineLoad .
                        ?pressureQuantity qudt:numericValue ?pressure .
                    }
                    GROUP BY ?ship
                }
                FILTER(?ship = $this)
                BIND(IF(ABS(?maximumForce) * 0.000001 > 0.000000001,
                        ABS(?maximumForce) * 0.000001, 0.000000001)
                     AS ?forceTolerance)
                BIND(IF(ABS(?maximumLineLoad) * 0.000001 > 0.000000001,
                        ABS(?maximumLineLoad) * 0.000001, 0.000000001)
                     AS ?lineLoadTolerance)
                BIND(IF(ABS(?maximumPressure) * 0.000001 > 0.000000001,
                        ABS(?maximumPressure) * 0.000001, 0.000000001)
                     AS ?pressureTolerance)
                FILTER(
                    ABS(?selectedForce - ?maximumForce) > ?forceTolerance ||
                    ABS(?selectedLineLoad - ?maximumLineLoad) > ?lineLoadTolerance ||
                    ABS(?selectedPressure - ?maximumPressure) > ?pressureTolerance
                )
            }
        """
    ] .
