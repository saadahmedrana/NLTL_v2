@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_015_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:node gen:I2_015_MetreQuantityShape ;
        sh:message "Upper ice waterline length L_UI is required for the applicable bow-shape calculation."
    ] ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape ;
        sh:message "Beta i prime is required for the applicable bow-shape calculation."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:I2_015_BowSubregionCalculationCaseShape ;
        sh:message "A bow subregion calculation case is required."
    ] .

gen:I2_015_BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:minCount 1 ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:class nltl:bowFormApplicabilityValue ;
        sh:message "The calculation case must identify applicability to the bow forms defined in I2.3.1(v)."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:node gen:I2_015_MetreQuantityShape ;
        sh:message "Bow subregion mid-length position is required."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:minCount 1 ;
        sh:node gen:I2_015_DegreeQuantityShape ;
        sh:message "Bow subregion waterline angle is required."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:minCount 1 ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:I2_015_FailureClassFactorLookupCaseShape ;
        sh:message "A failure-class-factor lookup case is required."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape ;
        sh:message "The externally computed bow shape coefficient is required."
    ] .

gen:I2_015_FailureClassFactorLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape ;
        sh:message "The flexural failure class factor is required."
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_015_UnitlessQuantityShape ;
        sh:message "The crushing failure class factor is required."
    ] .

gen:I2_015_MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:I2_015_DegreeQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG
    ] .

gen:I2_015_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
