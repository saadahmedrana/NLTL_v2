@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_017_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:node gen:I2_017_LengthQuantityShape ;
        sh:message "Upper ice waterline draught is required for readiness."
    ] ;
    sh:property [
        sh:path nltl:displacementFactorThreshold ;
        sh:minCount 1 ;
        sh:node gen:I2_017_LengthQuantityShape ;
        sh:message "Displacement factor threshold is required for readiness."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:I2_017_TableLookupCaseShape ;
        sh:message "A table lookup case containing the required class factors is required."
    ] ;
    sh:property [
        sh:path nltl:hasNonBowIceLoadCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:I2_017_NonBowIceLoadCalculationCaseShape ;
        sh:message "A non-bow ice-load calculation case with externally computed results is required."
    ] .

gen:I2_017_TableLookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_017_UnitlessQuantityShape ;
        sh:message "The crushing failure class factor is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchDimensionClassFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_017_UnitlessQuantityShape ;
        sh:message "The load patch dimension class factor is required."
    ] .

gen:I2_017_NonBowIceLoadCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:nonBowIceLoadCalculationCase ;
    sh:property [
        sh:path nltl:shipDisplacementFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_017_UnitlessQuantityShape ;
        sh:message "The externally computed ship displacement factor is required."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceForce ;
        sh:minCount 1 ;
        sh:node gen:I2_017_ForceQuantityShape ;
        sh:message "The externally computed non-bow ice force is required."
    ] ;
    sh:property [
        sh:path nltl:nonBowIceLineLoad ;
        sh:minCount 1 ;
        sh:node gen:I2_017_LineLoadQuantityShape ;
        sh:message "The externally computed non-bow ice line load is required."
    ] .

gen:I2_017_LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_017_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_017_ForceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_017_LineLoadQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
