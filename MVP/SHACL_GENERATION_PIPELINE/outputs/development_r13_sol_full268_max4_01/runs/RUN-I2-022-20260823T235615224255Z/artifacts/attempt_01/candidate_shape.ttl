@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_022_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:class nltl:plating ;
        sh:node gen:I2_022_PlatingShape ;
        sh:minCount 1 ;
        sh:message "At least one plating record is required, and every linked plating must contain sufficient applicability and readiness information."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasPlating ;
                sh:node gen:I2_022_NonApplicablePlatingShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:averageIcePressure ;
                sh:node gen:I2_022_PressureQuantityShape ;
                sh:minCount 1 ;
                sh:message "Average ice pressure is required when any linked plating has a framing angle of at least 70 degrees."
            ] ;
            sh:property [
                sh:path nltl:peakPressureFactor ;
                sh:node gen:I2_022_UnitlessQuantityShape ;
                sh:minCount 1 ;
                sh:message "Peak pressure factor is required when any linked plating has a framing angle of at least 70 degrees."
            ] ;
            sh:property [
                sh:path nltl:yieldStrength ;
                sh:node gen:I2_022_PressureQuantityShape ;
                sh:minCount 1 ;
                sh:message "Yield strength is required when any linked plating has a framing angle of at least 70 degrees."
            ] ;
            sh:property [
                sh:path nltl:loadPatchHeight ;
                sh:node gen:I2_022_MetreQuantityShape ;
                sh:minCount 1 ;
                sh:message "Load patch height is required when any linked plating has a framing angle of at least 70 degrees."
            ]
        ]
    ) .

gen:I2_022_PlatingShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:platingHullAreaClassification ;
        sh:class nltl:hullAreaValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "The plating hull-area classification is required to establish the plating applicability context."
    ] ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node gen:I2_022_DegreeQuantityShape ;
        sh:minCount 1 ;
        sh:message "The framing angle is required to determine whether the plating calculation is applicable."
    ] ;
    sh:or (
        [
            sh:node gen:I2_022_NonApplicablePlatingShape
        ]
        [
            sh:node gen:I2_022_ApplicablePlatingReadinessShape
        ]
    ) .

gen:I2_022_NonApplicablePlatingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:node gen:I2_022_DegreeQuantityShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxExclusive "70"^^xsd:decimal ;
                sh:minCount 1
            ]
        ]
    ] .

gen:I2_022_ApplicablePlatingReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:node gen:I2_022_DegreeQuantityShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "70"^^xsd:decimal ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_022_SupportingStructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "Applicable plating requires a supporting structural member with the required calculation inputs."
    ] ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:node gen:I2_022_MillimetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "The externally calculated required net plate thickness is required for applicable plating."
    ] .

gen:I2_022_SupportingStructuralMemberShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node gen:I2_022_MetreQuantityShape ;
        sh:minCount 1 ;
        sh:message "Frame spacing is required for the supporting structural member."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:node gen:I2_022_UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:message "The selected hull-area factor is required for the supporting structural member."
    ] .

gen:I2_022_DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_022_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_022_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_022_PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_022_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
