@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_022_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:class nltl:plating ;
        sh:node gen:I2_022_PlatingApplicabilityShape
    ] .

gen:I2_022_PlatingApplicabilityShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node gen:I2_022_AngleQuantityShape ;
        sh:message "Framing angle Omega is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:framingAngleOmega qudt:numericValue ) ;
                sh:maxExclusive 70.0
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:framingAngleOmega qudt:numericValue ) ;
                sh:minInclusive 70.0
            ] ;
            sh:node gen:I2_022_PlatingReadinessShape
        ]
        [
            sh:property [
                sh:path nltl:platingHullAreaClassification ;
                sh:hasValue nltl:bowIntermediateBottomHullArea
            ] ;
            sh:property [
                sh:path ( nltl:framingAngleOmega qudt:numericValue ) ;
                sh:minInclusive 70.0
            ] ;
            sh:node gen:I2_022_PlatingReadinessShape
        ]
        [
            sh:property [
                sh:path nltl:platingHullAreaClassification ;
                sh:hasValue nltl:midbodyBottomHullArea
            ] ;
            sh:property [
                sh:path ( nltl:framingAngleOmega qudt:numericValue ) ;
                sh:minInclusive 70.0
            ] ;
            sh:node gen:I2_022_PlatingReadinessShape
        ]
        [
            sh:property [
                sh:path nltl:platingHullAreaClassification ;
                sh:hasValue nltl:sternBottomHullArea
            ] ;
            sh:property [
                sh:path ( nltl:framingAngleOmega qudt:numericValue ) ;
                sh:minInclusive 70.0
            ] ;
            sh:node gen:I2_022_PlatingReadinessShape
        ]
    ) .

gen:I2_022_PlatingReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gen:I2_022_MillimetreQuantityShape ;
        sh:message "Applicable plating requires an externally computed net plate thickness result."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_022_StructuralMemberReadinessShape ;
        sh:message "Applicable plating requires its supporting structural member."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:peakPressureFactor
        ) ;
        sh:minCount 1 ;
        sh:node gen:I2_022_UnitlessQuantityShape ;
        sh:message "Peak pressure factor is required for the external calculation."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:averageIcePressure
        ) ;
        sh:minCount 1 ;
        sh:node gen:I2_022_MegapascalQuantityShape ;
        sh:message "Average ice pressure is required for the external calculation."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:yieldStrength
        ) ;
        sh:minCount 1 ;
        sh:node gen:I2_022_MegapascalQuantityShape ;
        sh:message "Yield strength is required for the external calculation."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasPlating ]
            nltl:loadPatchHeight
        ) ;
        sh:minCount 1 ;
        sh:node gen:I2_022_MetreQuantityShape ;
        sh:message "Load patch height is required for the external calculation."
    ] .

gen:I2_022_StructuralMemberReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node gen:I2_022_MetreQuantityShape ;
        sh:message "Frame spacing is required for the external calculation."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:node gen:I2_022_UnitlessQuantityShape ;
        sh:message "Selected hull area factor is required for the external calculation."
    ] .

gen:I2_022_AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG
    ] .

gen:I2_022_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:I2_022_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .

gen:I2_022_MegapascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gen:I2_022_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
