@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_022_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPlating ;
        sh:node gs:I2_022_PlatingShape
    ] ;
    sh:or (
        gs:I2_022_NoApplicablePlatingShape
        gs:I2_022_ShipOperandReadinessShape
    ) .

gs:I2_022_NoApplicablePlatingShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ship-level formula inputs are required when linked plating has a framing angle of at least 70 degrees." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasPlating ?plating .
    ?plating nltl:framingAngleOmega ?omegaQuantity .
    ?omegaQuantity qudt:numericValue ?omega ;
                   qudt:unit <http://qudt.org/vocab/unit/DEG> .
    FILTER(datatype(?omega) = xsd:decimal && ?omega >= 70)
    FILTER(
        NOT EXISTS {
            ?plating nltl:platingHullAreaClassification ?classifiedArea .
        }
        ||
        EXISTS {
            ?plating nltl:platingHullAreaClassification
                nltl:bowIntermediateBottomHullArea .
        }
        ||
        EXISTS {
            ?plating nltl:platingHullAreaClassification
                nltl:midbodyBottomHullArea .
        }
        ||
        EXISTS {
            ?plating nltl:platingHullAreaClassification
                nltl:sternBottomHullArea .
        }
        ||
        EXISTS {
            ?plating nltl:platingHullAreaClassification ?otherArea .
            FILTER(
                ?otherArea NOT IN (
                    nltl:bowIntermediateBottomHullArea,
                    nltl:midbodyBottomHullArea,
                    nltl:sternBottomHullArea
                )
            )
        }
    )
}
"""
    ] .

gs:I2_022_ShipOperandReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:node gs:I2_022_UnitlessQuantityShape ;
        sh:message "Peak pressure factor is required for applicable plating."
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node gs:I2_022_MegaPascalQuantityShape ;
        sh:message "Average ice pressure is required for applicable plating."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gs:I2_022_MegaPascalQuantityShape ;
        sh:message "Yield strength is required for applicable plating."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:node gs:I2_022_MetreQuantityShape ;
        sh:message "Load patch height is required for applicable plating."
    ] .

gs:I2_022_PlatingShape
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node gs:I2_022_DegreeQuantityShape ;
        sh:message "Framing angle is required to determine plating applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path (
                    nltl:framingAngleOmega
                    qudt:numericValue
                ) ;
                sh:maxExclusive 70
            ]
        ]
        gs:I2_022_ApplicablePlatingReadinessShape
    ) .

gs:I2_022_ApplicablePlatingReadinessShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceLoadRequiredNetPlateThickness ;
        sh:minCount 1 ;
        sh:node gs:I2_022_MillimetreQuantityShape ;
        sh:message "Externally computed net plate thickness is required for applicable plating."
    ] ;
    sh:property [
        sh:path nltl:platingSupportedByStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember ;
        sh:node gs:I2_022_StructuralMemberReadinessShape ;
        sh:message "Applicable plating requires a linked supporting structural member."
    ] .

gs:I2_022_StructuralMemberReadinessShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node gs:I2_022_MetreQuantityShape ;
        sh:message "Frame spacing is required on the supporting structural member."
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:node gs:I2_022_UnitlessQuantityShape ;
        sh:message "Selected hull-area factor is required on the supporting structural member."
    ] .

gs:I2_022_DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_022_MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_022_MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_022_MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_022_UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
