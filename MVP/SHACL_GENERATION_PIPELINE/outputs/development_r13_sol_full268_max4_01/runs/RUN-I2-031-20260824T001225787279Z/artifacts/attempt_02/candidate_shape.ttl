@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_031_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:frameProfileType ;
        sh:minCount 1 ;
        sh:class nltl:frameProfileTypeValue ;
        sh:message "The ship must identify its frame profile type."
    ] ;
    sh:sparql [
        sh:message "Each linked local frame must provide structural-location selection evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame .
                FILTER NOT EXISTS {
                    ?member nltl:structuralLocation ?location .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each structural location of a linked local frame must be a structural-location value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?location
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location .
                FILTER NOT EXISTS {
                    ?location a nltl:structuralLocationValue .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A side local frame must state whether its orientation is transverse." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:sideStructureLocation .
                FILTER NOT EXISTS {
                    ?member nltl:transverseFrameOrientation ?orientation .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every transverse-frame-orientation value on a side local frame must be an xsd:boolean." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?orientation
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:transverseFrameOrientation ?orientation .
                FILTER(datatype(?orientation) != xsd:boolean)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable local frame must have a structural-member load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER NOT EXISTS {
                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each load case linked from an applicable local frame must be a load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER NOT EXISTS {
                    ?loadCase a nltl:loadCase .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable local frame must provide plastic strength and midspan plastic-collapse load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(
                    NOT EXISTS {
                        ?member nltl:plasticStrength ?strength .
                    } ||
                    NOT EXISTS {
                        ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each plastic-strength and midspan-collapse-load quantity must have one or more decimal numeric values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?quantity
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        ?quantityProperty ?quantity .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(
                    ?quantityProperty IN (
                        nltl:plasticStrength,
                        nltl:midspanPlasticCollapseLoad
                    )
                )
                FILTER NOT EXISTS {
                    ?quantity qudt:numericValue ?numericValue .
                    FILTER(datatype(?numericValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every numeric value of plastic strength or midspan collapse load must be an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?quantity ?numericValue
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        ?quantityProperty ?quantity .
                ?quantity qudt:numericValue ?numericValue .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(
                    ?quantityProperty IN (
                        nltl:plasticStrength,
                        nltl:midspanPlasticCollapseLoad
                    )
                )
                FILTER(datatype(?numericValue) != xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Plastic strength and midspan plastic-collapse load must use unit KiloN without conflicting units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?quantity
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        ?quantityProperty ?quantity .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(
                    ?quantityProperty IN (
                        nltl:plasticStrength,
                        nltl:midspanPlasticCollapseLoad
                    )
                )
                FILTER(
                    NOT EXISTS {
                        ?quantity qudt:unit unit:KiloN .
                    } ||
                    EXISTS {
                        ?quantity qudt:unit ?otherUnit .
                        FILTER(?otherUnit != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Plastic strength must equal the midspan plastic-collapse load within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?strengthValue
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:plasticStrength ?strengthQuantity .
                ?strengthQuantity qudt:numericValue ?strengthValue ;
                                  qudt:unit ?strengthUnit .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(datatype(?strengthValue) = xsd:decimal)
                FILTER NOT EXISTS {
                    ?member nltl:midspanPlasticCollapseLoad ?collapseQuantity .
                    ?collapseQuantity qudt:numericValue ?collapseValue ;
                                      qudt:unit ?collapseUnit .
                    FILTER(datatype(?collapseValue) = xsd:decimal)
                    FILTER(?collapseUnit = ?strengthUnit)
                    FILTER(
                        ABS(?strengthValue - ?collapseValue) <=
                        IF(
                            ABS(?collapseValue) * 0.000001 > 0.000000000001,
                            ABS(?collapseValue) * 0.000001,
                            0.000000000001
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every load case of an applicable local frame must provide combined shear-and-bending demand." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER NOT EXISTS {
                    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every combined shear-and-bending demand must have one or more decimal numeric values and a unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase ?demand
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(
                    NOT EXISTS {
                        ?demand qudt:numericValue ?demandValue .
                        FILTER(datatype(?demandValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        ?demand qudt:unit ?demandUnit .
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every numeric value of a combined shear-and-bending demand must be an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase ?demandValue
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(datatype(?demandValue) != xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every combined shear-and-bending demand must use the same unit as the member plastic strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase ?demand
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase ;
                        nltl:plasticStrength ?strength .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(
                    NOT EXISTS {
                        ?demand qudt:unit ?demandUnit .
                        ?strength qudt:unit ?strengthUnit .
                        FILTER(?demandUnit = ?strengthUnit)
                    } ||
                    EXISTS {
                        ?demand qudt:unit ?representedDemandUnit .
                        ?strength qudt:unit ?representedStrengthUnit .
                        FILTER(?representedDemandUnit != ?representedStrengthUnit)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Combined shear-and-bending demand must not exceed the member plastic strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase ?demandValue ?strengthValue
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location ;
                        nltl:hasStructuralMemberLoadCase ?loadCase ;
                        nltl:plasticStrength ?strength .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit ?demandUnit .
                ?strength qudt:numericValue ?strengthValue ;
                          qudt:unit ?strengthUnit .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(datatype(?demandValue) = xsd:decimal)
                FILTER(datatype(?strengthValue) = xsd:decimal)
                FILTER(?demandUnit = ?strengthUnit)
                FILTER(?demandValue > ?strengthValue)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ship with an applicable local frame must identify the plastic-collapse mechanism." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:plasticCollapseMechanism ?mechanism .
                    FILTER(datatype(?mechanism) = xsd:string)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every represented plastic-collapse mechanism must be an xsd:string." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?mechanism
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:plasticCollapseMechanism ?mechanism .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation ?location .
                FILTER(
                    ?location = nltl:bottomStructureLocation ||
                    (
                        ?location = nltl:sideStructureLocation &&
                        EXISTS {
                            ?member nltl:transverseFrameOrientation true .
                        }
                    )
                )
                FILTER(datatype(?mechanism) != xsd:string)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ship with an applicable bottom local frame must provide the patch load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:bottomStructureLocation .
                FILTER NOT EXISTS {
                    $this nltl:patchLoad ?patchLoad .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every patch-load quantity required for a bottom local frame must have decimal magnitude in unit KiloN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?patchLoad
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:patchLoad ?patchLoad .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:bottomStructureLocation .
                FILTER(
                    NOT EXISTS {
                        ?patchLoad qudt:numericValue ?patchValue .
                        FILTER(datatype(?patchValue) = xsd:decimal)
                    } ||
                    NOT EXISTS {
                        ?patchLoad qudt:unit unit:KiloN .
                    } ||
                    EXISTS {
                        ?patchLoad qudt:unit ?otherUnit .
                        FILTER(?otherUnit != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every numeric value of a required bottom patch load must be an xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?patchLoad ?patchValue
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:patchLoad ?patchLoad .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:bottomStructureLocation .
                ?patchLoad qudt:numericValue ?patchValue .
                FILTER(datatype(?patchValue) != xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every load case of a bottom local frame must state that the patch-load height is parallel to the frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:bottomStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER NOT EXISTS {
                    ?loadCase nltl:loadPatchOrientation nltl:loadPatchHeightParallelToFrame .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bottom-frame load case must not contain a conflicting patch-load orientation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?member ?loadCase ?orientation
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a nltl:localFrame ;
                        nltl:structuralLocation nltl:bottomStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?loadCase nltl:loadPatchOrientation ?orientation .
                FILTER(?orientation != nltl:loadPatchHeightParallelToFrame)
            }
        """
    ] .
