@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_031_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked local frame must provide structural-location selection evidence." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame .
    FILTER NOT EXISTS {
        ?member nltl:structuralLocation ?location .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each structural-location value of a linked local frame must be a structural location value." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?location
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location .
    FILTER NOT EXISTS {
        ?location a nltl:structuralLocationValue .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A side local frame must provide a boolean transverse-frame orientation selector." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation nltl:sideStructureLocation .
    FILTER NOT EXISTS {
        ?member nltl:transverseFrameOrientation ?orientation .
        FILTER(datatype(?orientation) = xsd:boolean)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every transverse-frame orientation value on a side local frame must be an xsd:boolean." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?orientation
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation nltl:sideStructureLocation ;
        nltl:transverseFrameOrientation ?orientation .
    FILTER(datatype(?orientation) != xsd:boolean)
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable local frame must have one plastic-strength quantity and one midspan-plastic-collapse-load quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER(
        NOT EXISTS {
            ?member nltl:plasticStrength ?plasticStrength .
        } ||
        NOT EXISTS {
            ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
        } ||
        EXISTS {
            ?member nltl:plasticStrength ?plasticStrength1, ?plasticStrength2 .
            FILTER(!sameTerm(?plasticStrength1, ?plasticStrength2))
        } ||
        EXISTS {
            ?member nltl:midspanPlasticCollapseLoad ?collapseLoad1, ?collapseLoad2 .
            FILTER(!sameTerm(?collapseLoad1, ?collapseLoad2))
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Plastic strength must be a single-decimal-value quantity expressed in kilonewtons." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?quantity
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:plasticStrength ?quantity .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER(
        NOT EXISTS {
            ?quantity qudt:numericValue ?number .
            FILTER(datatype(?number) = xsd:decimal)
        } ||
        EXISTS {
            ?quantity qudt:numericValue ?number .
            FILTER(datatype(?number) != xsd:decimal)
        } ||
        EXISTS {
            ?quantity qudt:numericValue ?number1, ?number2 .
            FILTER(!sameTerm(?number1, ?number2))
        } ||
        NOT EXISTS {
            ?quantity qudt:unit unit:KiloN .
        } ||
        EXISTS {
            ?quantity qudt:unit ?unit .
            FILTER(?unit != unit:KiloN)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Midspan plastic-collapse load must be a single-decimal-value quantity expressed in kilonewtons." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?quantity
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:midspanPlasticCollapseLoad ?quantity .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER(
        NOT EXISTS {
            ?quantity qudt:numericValue ?number .
            FILTER(datatype(?number) = xsd:decimal)
        } ||
        EXISTS {
            ?quantity qudt:numericValue ?number .
            FILTER(datatype(?number) != xsd:decimal)
        } ||
        EXISTS {
            ?quantity qudt:numericValue ?number1, ?number2 .
            FILTER(!sameTerm(?number1, ?number2))
        } ||
        NOT EXISTS {
            ?quantity qudt:unit unit:KiloN .
        } ||
        EXISTS {
            ?quantity qudt:unit ?unit .
            FILTER(?unit != unit:KiloN)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Plastic strength must equal the midspan plastic-collapse load within relative tolerance 1e-6 and absolute fallback 1e-9 kN." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:plasticStrength ?strengthQuantity ;
        nltl:midspanPlasticCollapseLoad ?collapseQuantity .
    ?strengthQuantity
        qudt:numericValue ?strength ;
        qudt:unit unit:KiloN .
    ?collapseQuantity
        qudt:numericValue ?collapseLoad ;
        qudt:unit unit:KiloN .
    FILTER(
        datatype(?strength) = xsd:decimal &&
        datatype(?collapseLoad) = xsd:decimal
    )
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER(
        ABS(?strength - ?collapseLoad) >
        IF(
            ABS(?collapseLoad) * 0.000001 > 0.000000001,
            ABS(?collapseLoad) * 0.000001,
            0.000000001
        )
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable local frame must have at least one structural-member load case typed as a load case." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER NOT EXISTS {
        ?member nltl:hasStructuralMemberLoadCase ?loadCase .
        ?loadCase a nltl:loadCase .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every load case linked to an applicable local frame must be typed as a load case." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:hasStructuralMemberLoadCase ?loadCase .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER NOT EXISTS {
        ?loadCase a nltl:loadCase .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each load case of an applicable local frame must provide combined shear-and-bending demand." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:hasStructuralMemberLoadCase ?loadCase .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER NOT EXISTS {
        ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every combined shear-and-bending demand must have exactly one decimal numeric value and one unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase ?demand
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:hasStructuralMemberLoadCase ?loadCase .
    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER(
        NOT EXISTS {
            ?demand qudt:numericValue ?number .
            FILTER(datatype(?number) = xsd:decimal)
        } ||
        EXISTS {
            ?demand qudt:numericValue ?number .
            FILTER(datatype(?number) != xsd:decimal)
        } ||
        EXISTS {
            ?demand qudt:numericValue ?number1, ?number2 .
            FILTER(!sameTerm(?number1, ?number2))
        } ||
        NOT EXISTS {
            ?demand qudt:unit ?unit .
            FILTER(isIRI(?unit))
        } ||
        EXISTS {
            ?demand qudt:unit ?unit1, ?unit2 .
            FILTER(!sameTerm(?unit1, ?unit2))
        } ||
        EXISTS {
            ?demand qudt:unit ?unit .
            FILTER(!isIRI(?unit))
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each combined shear-and-bending demand must use the plastic-strength unit and must not exceed the member plastic strength." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase ?demand
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation ?location ;
        nltl:plasticStrength ?strengthQuantity ;
        nltl:hasStructuralMemberLoadCase ?loadCase .
    ?strengthQuantity
        qudt:numericValue ?strength ;
        qudt:unit ?strengthUnit .
    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
    ?demand
        qudt:numericValue ?demandValue ;
        qudt:unit ?demandUnit .
    FILTER(
        datatype(?strength) = xsd:decimal &&
        datatype(?demandValue) = xsd:decimal
    )
    FILTER(
        ?location = nltl:bottomStructureLocation ||
        (
            ?location = nltl:sideStructureLocation &&
            EXISTS {
                ?member nltl:transverseFrameOrientation ?orientation .
                FILTER(
                    datatype(?orientation) = xsd:boolean &&
                    ?orientation = true
                )
            }
        )
    )
    FILTER(
        !sameTerm(?demandUnit, ?strengthUnit) ||
        ?demandValue > ?strength
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every bottom local-frame load case must specify the patch height parallel to the frame." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation nltl:bottomStructureLocation ;
        nltl:hasStructuralMemberLoadCase ?loadCase .
    FILTER NOT EXISTS {
        ?loadCase nltl:loadPatchOrientation nltl:loadPatchHeightParallelToFrame .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A bottom local-frame load case must not specify a load-patch orientation other than patch height parallel to the frame." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?member ?loadCase ?orientation
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member a nltl:localFrame ;
        nltl:structuralLocation nltl:bottomStructureLocation ;
        nltl:hasStructuralMemberLoadCase ?loadCase .
    ?loadCase nltl:loadPatchOrientation ?orientation .
    FILTER(?orientation != nltl:loadPatchHeightParallelToFrame)
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with an applicable bottom local frame must provide one patch-load quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER EXISTS {
        $this nltl:hasStructuralMember ?member .
        ?member a nltl:localFrame ;
            nltl:structuralLocation nltl:bottomStructureLocation .
    }
    FILTER(
        NOT EXISTS {
            $this nltl:patchLoad ?patchLoad .
        } ||
        EXISTS {
            $this nltl:patchLoad ?patchLoad1, ?patchLoad2 .
            FILTER(!sameTerm(?patchLoad1, ?patchLoad2))
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Patch load must be a single-decimal-value quantity expressed in kilonewtons." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?patchLoad
WHERE {
    FILTER EXISTS {
        $this nltl:hasStructuralMember ?member .
        ?member a nltl:localFrame ;
            nltl:structuralLocation nltl:bottomStructureLocation .
    }
    $this nltl:patchLoad ?patchLoad .
    FILTER(
        NOT EXISTS {
            ?patchLoad qudt:numericValue ?number .
            FILTER(datatype(?number) = xsd:decimal)
        } ||
        EXISTS {
            ?patchLoad qudt:numericValue ?number .
            FILTER(datatype(?number) != xsd:decimal)
        } ||
        EXISTS {
            ?patchLoad qudt:numericValue ?number1, ?number2 .
            FILTER(!sameTerm(?number1, ?number2))
        } ||
        NOT EXISTS {
            ?patchLoad qudt:unit unit:KiloN .
        } ||
        EXISTS {
            ?patchLoad qudt:unit ?unit .
            FILTER(?unit != unit:KiloN)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with an applicable local frame must provide a string describing the plastic-collapse mechanism." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    FILTER EXISTS {
        $this nltl:hasStructuralMember ?member .
        ?member a nltl:localFrame ;
            nltl:structuralLocation ?location .
        FILTER(
            ?location = nltl:bottomStructureLocation ||
            (
                ?location = nltl:sideStructureLocation &&
                EXISTS {
                    ?member nltl:transverseFrameOrientation ?orientation .
                    FILTER(
                        datatype(?orientation) = xsd:boolean &&
                        ?orientation = true
                    )
                }
            )
        )
    }
    FILTER NOT EXISTS {
        $this nltl:plasticCollapseMechanism ?mechanism .
        FILTER(datatype(?mechanism) = xsd:string)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every plastic-collapse-mechanism value must be an xsd:string." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?mechanism
WHERE {
    FILTER EXISTS {
        $this nltl:hasStructuralMember ?member .
        ?member a nltl:localFrame ;
            nltl:structuralLocation ?location .
        FILTER(
            ?location = nltl:bottomStructureLocation ||
            (
                ?location = nltl:sideStructureLocation &&
                EXISTS {
                    ?member nltl:transverseFrameOrientation ?orientation .
                    FILTER(
                        datatype(?orientation) = xsd:boolean &&
                        ?orientation = true
                    )
                }
            )
        )
    }
    $this nltl:plasticCollapseMechanism ?mechanism .
    FILTER(datatype(?mechanism) != xsd:string)
}
"""
    ] .
