@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_031_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:localFrame ;
        sh:node gen:I2_031_LinkedLocalFrameShape
    ] ;
    sh:sparql [
        sh:message "A side local frame requires a boolean transverse-frame orientation selector." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation nltl:sideStructureLocation .
                FILTER NOT EXISTS {
                    ?member nltl:transverseFrameOrientation ?orientation .
                    FILTER(DATATYPE(?orientation) = xsd:boolean)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable local frame requires a structural-member load case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                FILTER NOT EXISTS {
                    ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable local frame requires plastic strength expressed as a decimal quantity in kilonewtons." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                FILTER NOT EXISTS {
                    ?member nltl:plasticStrength ?strength .
                    ?strength qudt:numericValue ?value ;
                              qudt:unit unit:KiloN .
                    FILTER(DATATYPE(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every represented plastic-strength quantity for an applicable local frame must contain only decimal values and the kilonewton unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                ?member nltl:plasticStrength ?strength .
                FILTER(
                    NOT EXISTS {
                        ?strength qudt:numericValue ?value .
                        FILTER(DATATYPE(?value) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?strength qudt:numericValue ?badValue .
                        FILTER(DATATYPE(?badValue) != xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?strength qudt:unit unit:KiloN .
                    }
                    ||
                    EXISTS {
                        ?strength qudt:unit ?badUnit .
                        FILTER(?badUnit != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable local frame requires a midspan plastic-collapse load expressed as a decimal quantity in kilonewtons." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                FILTER NOT EXISTS {
                    ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                    ?collapseLoad qudt:numericValue ?value ;
                                  qudt:unit unit:KiloN .
                    FILTER(DATATYPE(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every represented midspan plastic-collapse load for an applicable local frame must contain only decimal values and the kilonewton unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                ?member nltl:midspanPlasticCollapseLoad ?collapseLoad .
                FILTER(
                    NOT EXISTS {
                        ?collapseLoad qudt:numericValue ?value .
                        FILTER(DATATYPE(?value) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?collapseLoad qudt:numericValue ?badValue .
                        FILTER(DATATYPE(?badValue) != xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?collapseLoad qudt:unit unit:KiloN .
                    }
                    ||
                    EXISTS {
                        ?collapseLoad qudt:unit ?badUnit .
                        FILTER(?badUnit != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Plastic strength must equal the midspan plastic-collapse load within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                ?member nltl:plasticStrength ?strength ;
                        nltl:midspanPlasticCollapseLoad ?collapseLoad .
                ?strength qudt:numericValue ?strengthValue ;
                          qudt:unit unit:KiloN .
                ?collapseLoad qudt:numericValue ?collapseValue ;
                              qudt:unit unit:KiloN .
                FILTER(
                    DATATYPE(?strengthValue) = xsd:decimal
                    && DATATYPE(?collapseValue) = xsd:decimal
                )
                BIND(ABS(?collapseValue) * 0.000001 AS ?relativeTolerance)
                BIND(
                    IF(
                        ?relativeTolerance > 0.000000001,
                        ?relativeTolerance,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?strengthValue - ?collapseValue) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each load case of an applicable local frame requires a combined shear-and-bending demand quantity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                ?member nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER NOT EXISTS {
                    ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every combined shear-and-bending demand of an applicable load case must have decimal numeric data and exactly the plastic-strength unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                ?member nltl:plasticStrength ?strength ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?strength qudt:unit ?strengthUnit .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                FILTER(
                    NOT EXISTS {
                        ?demand qudt:numericValue ?value .
                        FILTER(DATATYPE(?value) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?demand qudt:numericValue ?badValue .
                        FILTER(DATATYPE(?badValue) != xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?demand qudt:unit ?matchingUnit .
                        FILTER(?matchingUnit = ?strengthUnit)
                    }
                    ||
                    EXISTS {
                        ?demand qudt:unit ?differentUnit .
                        FILTER(?differentUnit != ?strengthUnit)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Combined shear-and-bending demand must not exceed the plastic strength of the applicable member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                FILTER(
                    EXISTS {
                        ?member nltl:structuralLocation nltl:bottomStructureLocation .
                    }
                    ||
                    EXISTS {
                        ?member nltl:structuralLocation nltl:sideStructureLocation ;
                                nltl:transverseFrameOrientation true .
                    }
                )
                ?member nltl:plasticStrength ?strength ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?strength qudt:numericValue ?strengthValue ;
                          qudt:unit ?commonUnit .
                ?loadCase nltl:combinedShearAndBendingDemand ?demand .
                ?demand qudt:numericValue ?demandValue ;
                        qudt:unit ?commonUnit .
                FILTER(
                    DATATYPE(?strengthValue) = xsd:decimal
                    && DATATYPE(?demandValue) = xsd:decimal
                    && ?demandValue > ?strengthValue
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every bottom-frame load case must specify the load-patch height parallel to the frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation nltl:bottomStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                FILTER NOT EXISTS {
                    ?loadCase nltl:loadPatchOrientation
                              nltl:loadPatchHeightParallelToFrame .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A bottom-frame load case must not contain a conflicting load-patch orientation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation nltl:bottomStructureLocation ;
                        nltl:hasStructuralMemberLoadCase ?loadCase .
                ?loadCase nltl:loadPatchOrientation ?orientation .
                FILTER(?orientation != nltl:loadPatchHeightParallelToFrame)
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ship with an applicable bottom local frame requires a patch-load quantity expressed as a decimal value in kilonewtons." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasStructuralMember ?member .
                    ?member nltl:structuralLocation nltl:bottomStructureLocation .
                }
                FILTER NOT EXISTS {
                    $this nltl:patchLoad ?patchLoad .
                    ?patchLoad qudt:numericValue ?value ;
                               qudt:unit unit:KiloN .
                    FILTER(DATATYPE(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every patch load represented for an applicable bottom local frame must contain only decimal values and the kilonewton unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasStructuralMember ?member .
                    ?member nltl:structuralLocation nltl:bottomStructureLocation .
                }
                $this nltl:patchLoad ?patchLoad .
                FILTER(
                    NOT EXISTS {
                        ?patchLoad qudt:numericValue ?value .
                        FILTER(DATATYPE(?value) = xsd:decimal)
                    }
                    ||
                    EXISTS {
                        ?patchLoad qudt:numericValue ?badValue .
                        FILTER(DATATYPE(?badValue) != xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        ?patchLoad qudt:unit unit:KiloN .
                    }
                    ||
                    EXISTS {
                        ?patchLoad qudt:unit ?badUnit .
                        FILTER(?badUnit != unit:KiloN)
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ship with an applicable local frame requires a textual plastic-collapse mechanism definition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasStructuralMember ?member .
                    FILTER(
                        EXISTS {
                            ?member nltl:structuralLocation
                                    nltl:bottomStructureLocation .
                        }
                        ||
                        EXISTS {
                            ?member nltl:structuralLocation
                                    nltl:sideStructureLocation ;
                                    nltl:transverseFrameOrientation true .
                        }
                    )
                }
                FILTER NOT EXISTS {
                    $this nltl:plasticCollapseMechanism ?mechanism .
                    FILTER(DATATYPE(?mechanism) = xsd:string)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every represented plastic-collapse mechanism for an applicable local frame must be an xsd:string." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                FILTER EXISTS {
                    $this nltl:hasStructuralMember ?member .
                    FILTER(
                        EXISTS {
                            ?member nltl:structuralLocation
                                    nltl:bottomStructureLocation .
                        }
                        ||
                        EXISTS {
                            ?member nltl:structuralLocation
                                    nltl:sideStructureLocation ;
                                    nltl:transverseFrameOrientation true .
                        }
                    )
                }
                $this nltl:plasticCollapseMechanism ?mechanism .
                FILTER(DATATYPE(?mechanism) != xsd:string)
            }
        """
    ] .

gen:I2_031_LinkedLocalFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:minCount 1 ;
        sh:class nltl:structuralLocationValue ;
        sh:message "Each linked local frame requires structural-location selection evidence."
    ] ;
    sh:property [
        sh:path nltl:transverseFrameOrientation ;
        sh:datatype xsd:boolean
    ] .
