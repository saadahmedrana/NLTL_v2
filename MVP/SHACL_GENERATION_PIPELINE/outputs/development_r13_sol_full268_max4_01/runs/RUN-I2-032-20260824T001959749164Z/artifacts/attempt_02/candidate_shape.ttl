@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareMetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegapascalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredTransverseFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] .

gen:HullAreaValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] .

gen:I2_032_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegapascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegapascalQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:StructuralMemberShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape [
            sh:class nltl:hullAreaValue ;
            sh:node gen:HullAreaValueShape
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Exactly one linked hull-area value must provide the hull area factor."
    ] ;
    sh:sparql [
        sh:message "The span and hull-area-factor selections must be consistent, the required shear area must match the formula within tolerance, and A_w must be at least A_t." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:averageIcePressure/qudt:numericValue ?averagePressure ;
                      nltl:frameSpan/qudt:numericValue ?frameSpan ;
                      nltl:span/qudt:numericValue ?span ;
                      nltl:loadPatchHeight/qudt:numericValue ?patchHeight ;
                      nltl:peakPressureFactor/qudt:numericValue ?peakFactor ;
                      nltl:shearArea/qudt:numericValue ?actualArea ;
                      nltl:yieldStrength/qudt:numericValue ?yieldStrength ;
                      nltl:hasStructuralMember ?member ;
                      nltl:hasComponent ?hullAreaValue .

                ?member nltl:frameSpacing/qudt:numericValue ?spacing ;
                        nltl:selectedHullAreaFactor/qudt:numericValue ?selectedAreaFactor ;
                        nltl:requiredTransverseFrameShearArea/qudt:numericValue ?reportedRequiredArea .

                ?hullAreaValue a nltl:hullAreaValue ;
                    nltl:hullAreaFactor/qudt:numericValue ?hullAreaFactor .

                BIND(IF(?frameSpan <= ?patchHeight, ?frameSpan, ?patchHeight) AS ?LL)
                BIND(IF(
                    ?yieldStrength = "0"^^xsd:decimal,
                    "1"^^xsd:decimal,
                    ?yieldStrength
                ) AS ?safeYieldStrength)
                BIND(
                    (
                        "10000"^^xsd:decimal *
                        "0.5"^^xsd:decimal *
                        ?LL *
                        ?spacing *
                        ?selectedAreaFactor *
                        ?peakFactor *
                        ?averagePressure
                    ) /
                    ("0.577"^^xsd:decimal * ?safeYieldStrength)
                    AS ?expectedRequiredArea
                )
                BIND(IF(
                    ABS(?expectedRequiredArea) * "0.000001"^^xsd:decimal >
                        "0.000000000001"^^xsd:decimal,
                    ABS(?expectedRequiredArea) * "0.000001"^^xsd:decimal,
                    "0.000000000001"^^xsd:decimal
                ) AS ?resultTolerance)
                BIND(IF(
                    ABS(?frameSpan) * "0.000001"^^xsd:decimal >
                        "0.000000000001"^^xsd:decimal,
                    ABS(?frameSpan) * "0.000001"^^xsd:decimal,
                    "0.000000000001"^^xsd:decimal
                ) AS ?spanTolerance)
                BIND(IF(
                    ABS(?hullAreaFactor) * "0.000001"^^xsd:decimal >
                        "0.000000000001"^^xsd:decimal,
                    ABS(?hullAreaFactor) * "0.000001"^^xsd:decimal,
                    "0.000000000001"^^xsd:decimal
                ) AS ?factorTolerance)

                FILTER(
                    ?yieldStrength = "0"^^xsd:decimal ||
                    ABS(?span - ?frameSpan) > ?spanTolerance ||
                    ABS(?selectedAreaFactor - ?hullAreaFactor) > ?factorTolerance ||
                    ABS(?reportedRequiredArea - ?expectedRequiredArea) > ?resultTolerance ||
                    (?actualArea * "10000"^^xsd:decimal) < ?expectedRequiredArea
                )
            }
        """
    ] .
