@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_037_StructuralMemberShape ;
        sh:minCount 1 ;
        sh:message "A structural member and its load case are required."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:class nltl:iceLoadPatchDesignCase ;
        sh:node gen:I2_037_IceLoadPatchDesignCaseShape ;
        sh:minCount 1 ;
        sh:message "An ice load patch design case is required."
    ] .

gen:I2_037_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:memberCapacity ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The structural member capacity in kilonewtons is required."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:class nltl:loadCase ;
        sh:node gen:I2_037_LoadCaseShape ;
        sh:minCount 1 ;
        sh:message "A load case is required for the structural member."
    ] .

gen:I2_037_LoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearBendingEffect ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The combined bending and shear effect is required."
    ] ;
    sh:property [
        sh:path nltl:loadPatchApplicationLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The load patch application location is required."
    ] .

gen:I2_037_IceLoadPatchDesignCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:memberCapacityMinimizationConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The design case must confirm that the load patch location minimizes member capacity under combined bending and shear."
    ] .
