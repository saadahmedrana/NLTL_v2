@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node gen:I2_048_SteelGradeRequirementCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSteelGradeRequirementCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarClassValue ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                ) ;
                sh:message "A ship having a represented steel-grade requirement case must have exactly one valid Polar Class."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The Table 8 required grade or the actual-grade comparison is inconsistent with the case selectors." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this ?case
WHERE {
    $this nltl:hasSteelGradeRequirementCase ?case ;
          nltl:polarClass ?pc .

    ?case nltl:asBuiltPlateThickness ?thickness ;
          nltl:steelMaterialClass ?materialClass ;
          nltl:steelStrengthCategory ?strengthCategory ;
          nltl:actualHullStructuralSteelGrade ?actualGrade .

    ?thickness qudt:numericValue ?thicknessMm .
    ?actualGrade nltl:steelGradeOrderRank ?actualRank .

    OPTIONAL {
        ?case nltl:requiredHullStructuralSteelGrade ?requiredGrade .
    }

    BIND(
        IF(?thicknessMm <= 10, 1,
        IF(?thicknessMm <= 15, 2,
        IF(?thicknessMm <= 20, 3,
        IF(?thicknessMm <= 25, 4,
        IF(?thicknessMm <= 30, 5,
        IF(?thicknessMm <= 35, 6,
        IF(?thicknessMm <= 40, 7,
        IF(?thicknessMm <= 45, 8,
        IF(?thicknessMm <= 50, 9, 0)))))))))
        AS ?band
    )

    BIND(
        IF(?band = 0, 0,
        IF(?materialClass = nltl:steelMaterialClassOne,
            IF(?pc IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3,
                    nltl:polarClassPc4,
                    nltl:polarClassPc5
                ),
                IF(?band <= 2, 1, IF(?band <= 7, 2, 3)),
                IF(?band <= 4, 1, 2)
            ),
        IF(?materialClass = nltl:steelMaterialClassTwo,
            IF(?pc IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3,
                    nltl:polarClassPc4,
                    nltl:polarClassPc5
                ),
                IF(?band = 1, 1, IF(?band <= 4, 2, 3)),
                IF(?band <= 4, 1, 2)
            ),
            IF(?pc IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3
                ),
                IF(
                    ?strengthCategory = nltl:normalStrengthSteelCategory &&
                    ?band >= 7,
                    0,
                    IF(?band <= 6, 3, 4)
                ),
                IF(?pc IN (
                        nltl:polarClassPc4,
                        nltl:polarClassPc5
                    ),
                    IF(
                        ?strengthCategory = nltl:normalStrengthSteelCategory &&
                        ?band = 9,
                        0,
                        IF(
                            ?strengthCategory = nltl:highTensileSteelCategory &&
                            ?band = 9,
                            4,
                            3
                        )
                    ),
                    IF(?band = 1, 1, IF(?band <= 4, 2, 3))
                )
            )
        )))
        AS ?expectedRank
    )

    BIND(
        IF(?strengthCategory = nltl:normalStrengthSteelCategory,
            IF(?expectedRank = 1, nltl:steelGradeB,
            IF(?expectedRank = 2, nltl:steelGradeD,
                                  nltl:steelGradeE)),
            IF(?expectedRank = 1, nltl:steelGradeAh,
            IF(?expectedRank = 2, nltl:steelGradeDh,
            IF(?expectedRank = 3, nltl:steelGradeEh,
                                  nltl:steelGradeFh)))
        )
        AS ?expectedGrade
    )

    FILTER(
        ?band = 0 ||
        (?expectedRank = 0 && BOUND(?requiredGrade)) ||
        (?expectedRank > 0 &&
            (!BOUND(?requiredGrade) || ?requiredGrade != ?expectedGrade)
        ) ||
        (?expectedRank > 0 &&
            (
                (?strengthCategory = nltl:normalStrengthSteelCategory &&
                    ?actualGrade NOT IN (
                        nltl:steelGradeB,
                        nltl:steelGradeD,
                        nltl:steelGradeE
                    )
                ) ||
                (?strengthCategory = nltl:highTensileSteelCategory &&
                    ?actualGrade NOT IN (
                        nltl:steelGradeAh,
                        nltl:steelGradeDh,
                        nltl:steelGradeEh,
                        nltl:steelGradeFh
                    )
                ) ||
                ?actualRank < ?expectedRank
            )
        )
    )
}
"""
    ] .

gen:I2_048_SteelGradeRequirementCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:message "Each represented steel-grade requirement case must identify exactly one assessed plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "Each represented steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:node gen:I2_048_ThicknessShape ;
        sh:message "Each represented case must provide exactly one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        )
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        )
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:node gen:I2_048_SteelGradeRankShape
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:in (
            nltl:steelGradeB
            nltl:steelGradeD
            nltl:steelGradeE
            nltl:steelGradeAh
            nltl:steelGradeDh
            nltl:steelGradeEh
            nltl:steelGradeFh
        ) ;
        sh:node gen:I2_048_SteelGradeRankShape ;
        sh:message "At most one permitted Table 8 required steel grade may be reported for a case."
    ] .

gen:I2_048_ThicknessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue unit:MilliM
    ] .

gen:I2_048_SteelGradeRankShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:in ( nltl:steelGradeB ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:maxInclusive 1
            ]
        ]
        [
            sh:in ( nltl:steelGradeD ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ]
        ]
        [
            sh:in ( nltl:steelGradeE ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 3 ;
                sh:maxInclusive 3
            ]
        ]
        [
            sh:in ( nltl:steelGradeAh ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:maxInclusive 1
            ]
        ]
        [
            sh:in ( nltl:steelGradeDh ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ]
        ]
        [
            sh:in ( nltl:steelGradeEh ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 3 ;
                sh:maxInclusive 3
            ]
        ]
        [
            sh:in ( nltl:steelGradeFh ) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 4 ;
                sh:maxInclusive 4
            ]
        ]
    ) .
