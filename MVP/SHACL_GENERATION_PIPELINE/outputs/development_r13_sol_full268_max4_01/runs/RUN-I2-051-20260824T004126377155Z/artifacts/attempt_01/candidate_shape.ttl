@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_051_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node gen:I2_051_CalculationCaseShape
    ] ;
    sh:sparql [
        sh:message "Design vertical ice shear force in kN must equal 1000 times the longitudinal distribution factor times the bow ice force in MN, within relative tolerance 1e-6." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?bowForceQuantity ;
                      nltl:designVerticalIceShearForce ?shearForceQuantity ;
                      nltl:longitudinalDistributionFactor ?factorQuantity .
                ?bowForceQuantity qudt:numericValue ?bowForce .
                ?shearForceQuantity qudt:numericValue ?shearForce .
                ?factorQuantity qudt:numericValue ?factor .
                BIND((?factor * ?bowForce * "1000"^^xsd:decimal) AS ?expected)
                BIND((ABS(?expected) * "0.000001"^^xsd:decimal) AS ?relativeTolerance)
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?shearForce - ?expected) > ?tolerance)
            }
        """
    ] .

gen:I2_051_CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shearForceDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:positiveShearForce
    ] ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "For positive shear force, the longitudinal distribution factor must be 0.0 from the aft end through 0.6 LUI and 1.0 from 0.9 LUI through the forward end." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?lengthQuantity ;
                      nltl:longitudinalDistributionFactor ?factorQuantity .
                $this nltl:shearForceDirection nltl:positiveShearForce ;
                      nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                ?lengthQuantity qudt:numericValue ?length .
                ?factorQuantity qudt:numericValue ?factor .
                ?positionQuantity qudt:numericValue ?position .
                FILTER(
                    (
                        ?position >= "0"^^xsd:decimal &&
                        ?position <= ("0.6"^^xsd:decimal * ?length) &&
                        ?factor != "0.0"^^xsd:decimal
                    )
                    ||
                    (
                        ?position >= ("0.9"^^xsd:decimal * ?length) &&
                        ?position <= ?length &&
                        ?factor != "1.0"^^xsd:decimal
                    )
                )
            }
        """
    ] .
