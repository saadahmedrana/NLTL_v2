@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DecimalMegaNewtonValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalKiloNewtonValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalMetreValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DecimalUnitlessValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ZeroDistributionFactorValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.0"^^xsd:decimal ;
        sh:maxInclusive "0.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:OneDistributionFactorValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "1.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PositiveShearCalculationCaseShape a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:shearForceDirection ;
        sh:hasValue nltl:positiveShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The calculation case must identify the positive shear-force direction."
    ] ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DecimalMetreValueShape ;
        sh:message "The calculation case must provide one longitudinal position from aft in metres."
    ] .

gen:DesignVerticalIceShearForceShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DecimalMegaNewtonValueShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DecimalKiloNewtonValueShape
    ] ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DecimalUnitlessValueShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DecimalMetreValueShape
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node gen:PositiveShearCalculationCaseShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:longitudinalDistributionFactor ;
                sh:node gen:ZeroDistributionFactorValueShape
            ] ;
            sh:sparql [
                sh:message "For positions from the aft end through 0.6 LUI, the longitudinal distribution factor must be 0.0." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:upperIceWaterlineLengthLUI ?lengthValue ;
                              nltl:hasCalculationCase ?case .
                        ?lengthValue qudt:numericValue ?length .
                        ?case nltl:hullGirderLongitudinalPositionFromAft ?positionValue .
                        ?positionValue qudt:numericValue ?position .
                        FILTER (
                            ?position < "0.0"^^xsd:decimal ||
                            ?position > ("0.6"^^xsd:decimal * ?length)
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:longitudinalDistributionFactor ;
                sh:node gen:OneDistributionFactorValueShape
            ] ;
            sh:sparql [
                sh:message "For positions from 0.9 LUI through the forward end of LUI, the longitudinal distribution factor must be 1.0." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:upperIceWaterlineLengthLUI ?lengthValue ;
                              nltl:hasCalculationCase ?case .
                        ?lengthValue qudt:numericValue ?length .
                        ?case nltl:hullGirderLongitudinalPositionFromAft ?positionValue .
                        ?positionValue qudt:numericValue ?position .
                        FILTER (
                            ?position < ("0.9"^^xsd:decimal * ?length) ||
                            ?position > ?length
                        )
                    }
                """
            ]
        ]
        [
            sh:sparql [
                sh:message "An intermediate positive-shear calculation case must lie strictly between 0.6 LUI and 0.9 LUI." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:upperIceWaterlineLengthLUI ?lengthValue ;
                              nltl:hasCalculationCase ?case .
                        ?lengthValue qudt:numericValue ?length .
                        ?case nltl:hullGirderLongitudinalPositionFromAft ?positionValue .
                        ?positionValue qudt:numericValue ?position .
                        FILTER (
                            ?position <= ("0.6"^^xsd:decimal * ?length) ||
                            ?position >= ("0.9"^^xsd:decimal * ?length)
                        )
                    }
                """
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "The design vertical ice shear force must equal the longitudinal distribution factor multiplied by the design vertical ice force at bow." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?bowForceValue ;
                      nltl:designVerticalIceShearForce ?shearForceValue ;
                      nltl:longitudinalDistributionFactor ?factorValue .
                ?bowForceValue qudt:numericValue ?bowForce .
                ?shearForceValue qudt:numericValue ?shearForce .
                ?factorValue qudt:numericValue ?factor .
                BIND (
                    (?factor * ?bowForce * "1000.0"^^xsd:decimal)
                    AS ?expectedShearForce
                )
                BIND (
                    IF (
                        ABS(?expectedShearForce) * "0.000001"^^xsd:decimal >
                        "0.000001"^^xsd:decimal,
                        ABS(?expectedShearForce) * "0.000001"^^xsd:decimal,
                        "0.000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?shearForce - ?expectedShearForce) > ?tolerance)
            }
        """
    ] .
