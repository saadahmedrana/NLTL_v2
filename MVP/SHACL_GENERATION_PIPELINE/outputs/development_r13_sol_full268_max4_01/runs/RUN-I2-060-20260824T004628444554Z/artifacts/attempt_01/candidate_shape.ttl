@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_060_StructuralMemberShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasStructuralMember nltl:hasCutout ) ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:hasStructuralMember nltl:hasCutout ) ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:cutout
            ] ;
            sh:property [
                sh:path nltl:memberInstability ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false ) ;
                sh:message "Loads carried by members in way of cut-outs must not cause instability."
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Structural stiffening must be recorded when it is necessary for a member in way of a cut-out." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?member
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout ;
                        nltl:stiffeningNecessary ?necessary .
                FILTER(?necessary = true)
                FILTER NOT EXISTS {
                    $this nltl:structuralStiffening ?stiffening .
                    FILTER(datatype(?stiffening) = xsd:string)
                }
            }
        """
    ] .

gen:I2_060_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCutout ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:cutout
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:message "The need for stiffening must be determined for a member in way of a cut-out."
            ]
        ]
    ) .
