@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node gen:I2_060_StructuralMemberShape
    ] ;
    sh:property [
        sh:path nltl:memberInstability ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string ;
        sh:minLength 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with a structural member in way of a cutout must record that member instability is false." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout .
    FILTER (
        NOT EXISTS {
            $this nltl:memberInstability ?instability .
            FILTER (
                isLiteral(?instability) &&
                datatype(?instability) = xsd:boolean &&
                ?instability = false
            )
        }
        ||
        EXISTS {
            $this nltl:memberInstability ?unstable .
            FILTER (
                isLiteral(?unstable) &&
                datatype(?unstable) = xsd:boolean &&
                ?unstable = true
            )
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Non-empty structural stiffening information is required when stiffening is necessary for a member in way of a cutout." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout ;
            nltl:stiffeningNecessary ?necessary .
    FILTER (
        isLiteral(?necessary) &&
        datatype(?necessary) = xsd:boolean &&
        ?necessary = true
    )
    FILTER NOT EXISTS {
        $this nltl:structuralStiffening ?stiffening .
        FILTER (
            isLiteral(?stiffening) &&
            datatype(?stiffening) = xsd:string &&
            STRLEN(STR(?stiffening)) >= 1
        )
    }
}
"""
    ] .

gen:I2_060_StructuralMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCutout ;
        sh:class nltl:cutout
    ] ;
    sh:property [
        sh:path nltl:stiffeningNecessary ;
        sh:datatype xsd:boolean
    ] .
