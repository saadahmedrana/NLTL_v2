@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ShipCutoutStabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A recorded structural stiffening description must be a non-empty string."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasStructuralMember nltl:hasCutout ) ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path ( nltl:hasStructuralMember nltl:hasCutout ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:memberInstability ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "Loads carried by members in way of cut-outs must not cause instability."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Structural stiffening must be recorded with non-empty content when a cutout member requires stiffening." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasStructuralMember ?member .
    ?member nltl:hasCutout ?cutout ;
            nltl:stiffeningNecessary ?necessary .
    FILTER(DATATYPE(?necessary) = xsd:boolean && ?necessary = true)
    FILTER NOT EXISTS {
        $this nltl:structuralStiffening ?stiffening .
        FILTER(
            DATATYPE(?stiffening) = xsd:string &&
            STRLEN(STR(?stiffening)) >= 1
        )
    }
}
"""
    ] .

gen:CutoutMemberShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasStructuralMember ;
    sh:property [
        sh:path nltl:hasCutout ;
        sh:class nltl:cutout
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasCutout ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each linked structural member having a cutout must state exactly once whether stiffening is necessary."
            ]
        ]
    ) .
