@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_064_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:class nltl:calculationCase ;
        sh:node gen:I2_064_CalculationCaseShape ;
        sh:message "At least one calculation case with calculation-method evidence is required."
    ] ;
    sh:sparql [
        sh:message "A linear calculation requires exactly one ship yield-strength quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:hasCalculationCase ?case .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    OPTIONAL { $this nltl:yieldStrength ?quantity . }
}
GROUP BY $this
HAVING (COUNT(DISTINCT ?quantity) != 1)
"""
    ] ;
    sh:sparql [
        sh:message "The yield-strength quantity must have exactly one decimal numeric value and one unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?quantity
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?quantity .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    OPTIONAL { ?quantity qudt:numericValue ?value . }
    OPTIONAL { ?quantity qudt:unit ?unitValue . }
}
GROUP BY $this ?quantity
HAVING (
    COUNT(DISTINCT ?value) != 1 ||
    COUNT(DISTINCT ?unitValue) != 1
)
"""
    ] ;
    sh:sparql [
        sh:message "The yield strength must be an xsd:decimal value expressed in megapascals." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?quantity .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?quantity qudt:numericValue ?value ;
              qudt:unit ?unitValue .
    FILTER(
        DATATYPE(?value) != xsd:decimal ||
        ?unitValue != unit:MegaPA
    )
}
"""
    ] ;
    sh:sparql [
        sh:message "Each represented structural-member path must use a structural member." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    FILTER NOT EXISTS { ?member a nltl:structuralMember . }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each represented flange path must use a structural-member flange." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    FILTER NOT EXISTS { ?flange a nltl:structuralMemberFlange . }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each represented web path must use a structural-member web." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    FILTER NOT EXISTS { ?web a nltl:structuralMemberWeb . }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each represented flange or web requires one positive buckling-criteria result for a linear calculation." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?element
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member (nltl:hasStructuralMemberFlange|nltl:hasStructuralMemberWeb) ?element .
    OPTIONAL { ?element nltl:bucklingCriteriaSatisfied ?satisfied . }
}
GROUP BY $this ?element
HAVING (COUNT(DISTINCT ?satisfied) != 1)
"""
    ] ;
    sh:sparql [
        sh:message "The buckling-criteria result must be the boolean value true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member (nltl:hasStructuralMemberFlange|nltl:hasStructuralMemberWeb) ?element .
    ?element nltl:bucklingCriteriaSatisfied ?satisfied .
    FILTER(
        DATATYPE(?satisfied) != xsd:boolean ||
        ?satisfied != true
    )
}
"""
    ] ;
    sh:sparql [
        sh:message "Each represented web requires exactly one nominal-shear-stress quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?web
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    OPTIONAL { ?web nltl:nominalShearStress ?quantity . }
}
GROUP BY $this ?web
HAVING (COUNT(DISTINCT ?quantity) != 1)
"""
    ] ;
    sh:sparql [
        sh:message "Each nominal shear-stress quantity must have exactly one decimal numeric value and one unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?web ?quantity
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    ?web nltl:nominalShearStress ?quantity .
    OPTIONAL { ?quantity qudt:numericValue ?value . }
    OPTIONAL { ?quantity qudt:unit ?unitValue . }
}
GROUP BY $this ?web ?quantity
HAVING (
    COUNT(DISTINCT ?value) != 1 ||
    COUNT(DISTINCT ?unitValue) != 1
)
"""
    ] ;
    sh:sparql [
        sh:message "Nominal shear stress must be an xsd:decimal value expressed in megapascals." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberWeb ?web .
    ?web nltl:nominalShearStress ?quantity .
    ?quantity qudt:numericValue ?value ;
              qudt:unit ?unitValue .
    FILTER(
        DATATYPE(?value) != xsd:decimal ||
        ?unitValue != unit:MegaPA
    )
}
"""
    ] ;
    sh:sparql [
        sh:message "Nominal web shear stress must be less than yield strength divided by sqrt(3)." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?yieldQuantity qudt:numericValue ?yieldValue ;
                   qudt:unit unit:MegaPA .
    ?member nltl:hasStructuralMemberWeb ?web .
    ?web nltl:nominalShearStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue ;
                    qudt:unit unit:MegaPA .
    FILTER(
        DATATYPE(?yieldValue) = xsd:decimal &&
        DATATYPE(?stressValue) = xsd:decimal &&
        ?stressValue >= (?yieldValue / 1.7320508075688772)
    )
}
"""
    ] ;
    sh:sparql [
        sh:message "Each represented flange requires exactly one nominal von Mises stress quantity." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?flange
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    OPTIONAL { ?flange nltl:nominalFlangeVonMisesStress ?quantity . }
}
GROUP BY $this ?flange
HAVING (COUNT(DISTINCT ?quantity) != 1)
"""
    ] ;
    sh:sparql [
        sh:message "Each nominal flange von Mises stress quantity must have exactly one decimal numeric value and one unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?flange ?quantity
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    ?flange nltl:nominalFlangeVonMisesStress ?quantity .
    OPTIONAL { ?quantity qudt:numericValue ?value . }
    OPTIONAL { ?quantity qudt:unit ?unitValue . }
}
GROUP BY $this ?flange ?quantity
HAVING (
    COUNT(DISTINCT ?value) != 1 ||
    COUNT(DISTINCT ?unitValue) != 1
)
"""
    ] ;
    sh:sparql [
        sh:message "Nominal flange von Mises stress must be an xsd:decimal value expressed in megapascals." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?member nltl:hasStructuralMemberFlange ?flange .
    ?flange nltl:nominalFlangeVonMisesStress ?quantity .
    ?quantity qudt:numericValue ?value ;
              qudt:unit ?unitValue .
    FILTER(
        DATATYPE(?value) != xsd:decimal ||
        ?unitValue != unit:MegaPA
    )
}
"""
    ] ;
    sh:sparql [
        sh:message "Nominal flange von Mises stress must be less than 1.15 times yield strength." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasCalculationCase ?case ;
          nltl:yieldStrength ?yieldQuantity ;
          nltl:hasStructuralMember ?member .
    ?case nltl:calculationMethod nltl:linearCalculationMethodValue .
    ?yieldQuantity qudt:numericValue ?yieldValue ;
                   qudt:unit unit:MegaPA .
    ?member nltl:hasStructuralMemberFlange ?flange .
    ?flange nltl:nominalFlangeVonMisesStress ?stressQuantity .
    ?stressQuantity qudt:numericValue ?stressValue ;
                    qudt:unit unit:MegaPA .
    FILTER(
        DATATYPE(?yieldValue) = xsd:decimal &&
        DATATYPE(?stressValue) = xsd:decimal &&
        ?stressValue >= (1.15 * ?yieldValue)
    )
}
"""
    ] .

gen:I2_064_CalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:calculationMethodValue ;
        sh:message "Each calculation case must identify exactly one calculation method."
    ] .
