@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:IMO008Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "The ship must have an IRI-valued ice type classification."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Thin first-year ice thickness must be between 0.3 m and 0.7 m inclusive, represented as a decimal QUDT QuantityValue in metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this
                           (COUNT(DISTINCT ?allQuantity) AS ?allCount)
                           (COUNT(DISTINCT ?validQuantity) AS ?validCount)
                    WHERE {
                        $this nltl:iceTypeClassification nltl:thinFirstYearIce .

                        OPTIONAL {
                            $this nltl:iceThickness ?allQuantity .
                        }

                        OPTIONAL {
                            $this nltl:iceThickness ?validQuantity .
                            ?validQuantity a qudt:QuantityValue ;
                                qudt:numericValue ?value ;
                                qudt:unit unit:M .

                            FILTER(
                                datatype(?value) = xsd:decimal &&
                                ?value >= "0.3"^^xsd:decimal &&
                                ?value <= "0.7"^^xsd:decimal
                            )

                            FILTER NOT EXISTS {
                                ?validQuantity qudt:numericValue ?otherValue .
                                FILTER(!sameTerm(?otherValue, ?value))
                            }

                            FILTER NOT EXISTS {
                                ?validQuantity qudt:unit ?otherUnit .
                                FILTER(?otherUnit != unit:M)
                            }
                        }
                    }
                    GROUP BY $this
                }

                FILTER(?allCount = 0 || ?validCount != ?allCount)
            }
        """
    ] .
