@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO011Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDailyLowTemperatureObservation ;
        sh:minCount 1 ;
        sh:class nltl:dailyLowTemperatureObservation ;
        sh:node [
            sh:property [
                sh:path nltl:dailyTemperatureObservationDate ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:date ;
                sh:message "Each daily low-temperature observation requires one calendar date."
            ] ;
            sh:property [
                sh:path nltl:dailyLowTemperature ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:DEG_C
                    ]
                ] ;
                sh:message "Each daily low-temperature observation requires one value in degrees Celsius."
            ]
        ] ;
        sh:message "The ship requires dated daily low-temperature observations."
    ] ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:YR
            ]
        ] ;
        sh:message "The ship requires one data period expressed in years."
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG_C
            ]
        ] ;
        sh:message "The externally calculated mean daily low temperature is required in degrees Celsius."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "10"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "10"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:minCount 1 ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:message "A data period shorter than ten years requires Administration approval."
            ]
        ]
    ) .
