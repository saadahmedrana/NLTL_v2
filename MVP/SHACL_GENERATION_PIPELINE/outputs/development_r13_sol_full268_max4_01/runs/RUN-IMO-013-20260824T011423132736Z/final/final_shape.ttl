@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LowAirTemperatureClassificationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:lowestMdlt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The ship must provide one lowest MDLT value in degrees Celsius."
    ] ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide one low-air-temperature operating classification."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with a lowest MDLT below -10 degrees Celsius must be classified as operating in low air temperature." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:lowestMdlt ?lowestMdlt ;
          nltl:shipOperatesInLowAirTemperature ?classification .
    ?lowestMdlt qudt:numericValue ?temperature ;
                qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
    FILTER (
        ?temperature < "-10"^^xsd:decimal &&
        ?classification != "true"^^xsd:boolean
    )
}
"""
    ] .
