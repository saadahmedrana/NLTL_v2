@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarShipCertificateShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarCodeApplies ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "Polar Code applicability must be explicitly recorded as false for this branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarCodeApplies ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Polar Code applicability must be explicitly recorded as true for this branch."
            ] ;
            sh:property [
                sh:path nltl:polarShipCertificatePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "A ship to which the Polar Code applies must have a Polar Ship Certificate on board."
            ] ;
            sh:property [
                sh:path nltl:polarShipCertificateStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The Polar Ship Certificate must be valid."
            ]
        ]
    ) .
