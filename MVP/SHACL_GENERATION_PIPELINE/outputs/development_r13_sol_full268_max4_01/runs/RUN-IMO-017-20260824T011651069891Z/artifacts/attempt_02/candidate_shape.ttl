@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO017ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:message "A Polar Ship Certificate is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node gen:IMO017SolasCertificateScheduleShape ;
        sh:message "An applicable SOLAS certificate schedule is required."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:class nltl:polarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node gen:IMO017PolarCertificateSupplementShape ;
        sh:message "A Polar Certificate supplement is required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Polar Certificate supplement presence must be recorded as true."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Certificate validity, survey, and endorsement dates must match the corresponding SOLAS schedule dates in both directions." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    {
        $this ?polarProperty ?polarDate .
        FILTER (
            ?polarProperty = nltl:polarCertificateValidityDates ||
            ?polarProperty = nltl:surveyDates ||
            ?polarProperty = nltl:endorsementDates
        )
        FILTER NOT EXISTS {
            $this nltl:hasSolasCertificateSchedule ?schedule .
            ?schedule nltl:hasCertificateScheduleDateRecord ?record .
            ?record nltl:certificateScheduleDateType ?scheduleType ;
                    nltl:certificateScheduleDate ?scheduleDate .
            FILTER (
                (?polarProperty = nltl:polarCertificateValidityDates &&
                 ?scheduleType = nltl:validityDateCategory) ||
                (?polarProperty = nltl:surveyDates &&
                 ?scheduleType = nltl:surveyDateCategory) ||
                (?polarProperty = nltl:endorsementDates &&
                 ?scheduleType = nltl:endorsementDateCategory)
            )
            FILTER (
                YEAR(?polarDate) = YEAR(?scheduleDate) &&
                MONTH(?polarDate) = MONTH(?scheduleDate) &&
                DAY(?polarDate) = DAY(?scheduleDate)
            )
        }
    }
    UNION
    {
        $this nltl:hasSolasCertificateSchedule ?schedule .
        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
        ?record nltl:certificateScheduleDateType ?scheduleType ;
                nltl:certificateScheduleDate ?scheduleDate .
        FILTER (
            ?scheduleType = nltl:validityDateCategory ||
            ?scheduleType = nltl:surveyDateCategory ||
            ?scheduleType = nltl:endorsementDateCategory
        )
        FILTER NOT EXISTS {
            $this ?polarProperty ?polarDate .
            FILTER (
                (?scheduleType = nltl:validityDateCategory &&
                 ?polarProperty = nltl:polarCertificateValidityDates) ||
                (?scheduleType = nltl:surveyDateCategory &&
                 ?polarProperty = nltl:surveyDates) ||
                (?scheduleType = nltl:endorsementDateCategory &&
                 ?polarProperty = nltl:endorsementDates)
            )
            FILTER (
                YEAR(?polarDate) = YEAR(?scheduleDate) &&
                MONTH(?polarDate) = MONTH(?scheduleDate) &&
                DAY(?polarDate) = DAY(?scheduleDate)
            )
        }
    }
}
"""
    ] .

gen:IMO017SolasCertificateScheduleShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:class nltl:certificateScheduleDateRecord ;
        sh:minCount 1 ;
        sh:node gen:IMO017CertificateScheduleDateRecordShape ;
        sh:message "The SOLAS certificate schedule must contain a schedule-date record."
    ] .

gen:IMO017CertificateScheduleDateRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A certificate schedule-date record must contain a date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:class nltl:certificateScheduleDateCategory ;
        sh:minCount 1 ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:message "A certificate schedule-date record must identify its validity, survey, or endorsement category."
    ] .

gen:IMO017PolarCertificateSupplementShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:message "The Polar Certificate supplement must include required equipment records."
    ] .
