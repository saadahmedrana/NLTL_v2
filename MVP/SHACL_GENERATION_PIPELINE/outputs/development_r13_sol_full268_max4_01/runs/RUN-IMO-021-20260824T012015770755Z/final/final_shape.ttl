@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:OperationalAssessmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operationalAssessmentPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "An operational assessment shall be present."
    ] ;
    sh:property [
        sh:path nltl:assessedLowAirTemperature ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal ;
                sh:message "The assessed low air temperature shall have a decimal numeric value."
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG_C ;
                sh:message "The assessed low air temperature shall use degrees Celsius."
            ]
        ] ;
        sh:message "The operational assessment shall cover low-air-temperature operation."
    ] ;
    sh:property [
        sh:path nltl:assessedIceOperation ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The operational assessment shall cover operation in ice."
    ] ;
    sh:property [
        sh:path nltl:assessedHighLatitude ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The operational assessment shall cover operation in high latitude."
    ] ;
    sh:property [
        sh:path nltl:assessedAbandonment ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The operational assessment shall cover potential abandonment onto ice or land."
    ] ;
    sh:property [
        sh:path nltl:assessedCodeHazards ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The operational assessment shall cover applicable Introduction section 3 hazards."
    ] ;
    sh:property [
        sh:path nltl:assessedAdditionalHazards ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The operational assessment shall cover any identified additional hazards."
    ] .
