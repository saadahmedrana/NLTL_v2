@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO034ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceAccretionMinimizationDesignPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:requiredIceRemovalMeansPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:administrationRequiredIceRemovalMeans ;
        sh:datatype xsd:string
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceAccretionMinimizationDesignPresent ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:requiredIceRemovalMeansPresent ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:message "Ice-accretion likelihood must be stated; when likely, ice-minimization design and required ice-removal means must both be present." .
