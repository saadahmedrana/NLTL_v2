@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarWaterOperationalManualIcingAllowanceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarWaterOperationalManualRecord ;
        sh:class nltl:documentRecord ;
        sh:minCount 1 ;
        sh:message "A Polar Water Operational Manual record is required."
    ] ;
    sh:property [
        sh:path nltl:hasStabilityCalculationRecord ;
        sh:class nltl:documentRecord ;
        sh:minCount 1 ;
        sh:message "A stability calculation record is required."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship must record that icing allowance information is present in the Polar Water Operational Manual."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:equals nltl:stabilityCalculationIcingAllowanceValues ;
        sh:message "The icing allowance values in the Polar Water Operational Manual must match the stability calculation icing allowance values."
    ] ;
    sh:property [
        sh:path nltl:stabilityCalculationIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Stability calculation icing allowance values are required."
    ] .
