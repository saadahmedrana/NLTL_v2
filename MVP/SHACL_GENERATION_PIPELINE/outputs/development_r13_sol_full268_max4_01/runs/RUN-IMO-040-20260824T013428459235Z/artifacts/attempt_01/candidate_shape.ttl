@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO040Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                        sh:minCount 1 ;
                        sh:message "Each relevant hatch or door must have associated ice or snow removal or prevention means when ice accretion is likely."
                    ]
                ]
            ]
        ]
    ) .
