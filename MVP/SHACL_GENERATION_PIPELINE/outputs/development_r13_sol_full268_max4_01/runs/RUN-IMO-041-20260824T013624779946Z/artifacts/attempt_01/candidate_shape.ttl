@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:HydraulicOpeningProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:openingActuationType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Opening actuation type is required to determine whether hydraulic-fluid protection is applicable."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A hydraulically operated opening requires hydraulic-fluid freezing or excessive-viscosity control to be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:openingActuationType ?actuationType .
                FILTER (?actuationType = "hydraulic"^^xsd:string)
                FILTER NOT EXISTS {
                    $this nltl:hydraulicFluidFreezingOrViscosityControlPresent ?protectionPresent .
                    FILTER (?protectionPresent = true)
                }
            }
        """
    ] .
