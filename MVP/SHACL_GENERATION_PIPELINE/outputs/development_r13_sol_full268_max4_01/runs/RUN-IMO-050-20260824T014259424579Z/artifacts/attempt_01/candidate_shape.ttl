@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:FireSafetyComponentProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fireSafetyComponentExposed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Fire-safety component exposure status is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:fireSafetyComponentExposed ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:fireSafetyComponentExposed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceAndSnowProtectionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Ice and snow protection must be present when a fire-safety component is exposed."
            ]
        ]
    ) .
