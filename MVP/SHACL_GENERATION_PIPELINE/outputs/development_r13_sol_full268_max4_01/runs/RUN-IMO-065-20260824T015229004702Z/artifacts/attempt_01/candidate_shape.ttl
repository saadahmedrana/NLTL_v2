@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DayQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single decimal numeric value is required."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DAY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must have the single unit DAY."
    ] .

gen:SurvivalResourceCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:abandonmentEnvironment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "At least one assessed abandonment environment is required."
    ] ;
    sh:property [
        sh:path nltl:maximumExpectedRescueTime ;
        sh:node gen:DayQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single maximum expected rescue time in days is required."
    ] ;
    sh:property [
        sh:path nltl:survivalSupportDuration ;
        sh:node gen:DayQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single survival support duration in days is required."
    ] ;
    sh:property [
        sh:path nltl:habitableEnvironmentPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A habitable environment must be provided."
    ] ;
    sh:property [
        sh:path nltl:weatherProtectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Protection from cold, wind, and sun must be provided."
    ] ;
    sh:property [
        sh:path nltl:accommodationSpacePresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Accommodation space must be provided."
    ] ;
    sh:property [
        sh:path nltl:sustenanceMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Means of sustenance must be provided."
    ] ;
    sh:property [
        sh:path nltl:safeAccessExitPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Safe access and exit points must be provided."
    ] ;
    sh:property [
        sh:path nltl:rescueCommunicationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Means of communication with rescue assets must be provided."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Survival support duration must be at least the maximum expected rescue time." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:survivalSupportDuration ?supportQuantity ;
                      nltl:maximumExpectedRescueTime ?rescueQuantity .
                ?supportQuantity qudt:numericValue ?supportDuration .
                ?rescueQuantity qudt:numericValue ?rescueTime .
                FILTER(xsd:decimal(?supportDuration) < xsd:decimal(?rescueTime))
            }
        """
    ] .
