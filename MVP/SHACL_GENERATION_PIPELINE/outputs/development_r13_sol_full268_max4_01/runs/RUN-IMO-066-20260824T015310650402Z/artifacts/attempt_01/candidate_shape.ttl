@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066IceAccretionProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's exposure to ice accretion must be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:class nltl:protectedItem ;
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:escapeRouteProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed ship must identify an escape route with associated ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:class nltl:protectedItem ;
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:musterStationProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed ship must identify a muster station with associated ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:class nltl:protectedItem ;
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:embarkationAreaProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed ship must identify an embarkation area with associated ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:class nltl:protectedItem ;
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:survivalCraftProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed ship must identify survival craft with associated ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:class nltl:protectedItem ;
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:launchingApplianceProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed ship must identify a launching appliance with associated ice or snow removal or prevention means."
            ] ;
            sh:property [
                sh:path nltl:hasProtectedItem ;
                sh:qualifiedValueShape [
                    sh:class nltl:protectedItem ;
                    sh:property [
                        sh:path nltl:protectedItemCategory ;
                        sh:hasValue nltl:survivalCraftAccessProtectedItem
                    ] ;
                    sh:property [
                        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
                        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                        sh:minCount 1
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "An exposed ship must identify survival-craft access with associated ice or snow removal or prevention means."
            ] ;
            sh:sparql [
                sh:message "Every protected item in a regulated category must have associated ice or snow removal or prevention means." ;
                sh:select """
                    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this ?item
                    WHERE {
                        $this nltl:shipExposedToIceAccretion true .
                        $this nltl:hasProtectedItem ?item .
                        ?item nltl:protectedItemCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:escapeRouteProtectedItem,
                                nltl:musterStationProtectedItem,
                                nltl:embarkationAreaProtectedItem,
                                nltl:survivalCraftProtectedItem,
                                nltl:launchingApplianceProtectedItem,
                                nltl:survivalCraftAccessProtectedItem
                            )
                        )
                        FILTER NOT EXISTS {
                            ?item rdf:type nltl:protectedItem .
                            ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                            ?means rdf:type nltl:iceSnowRemovalOrPreventionMeans .
                        }
                    }
                """
            ]
        ]
    ) .
