@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's exposure to ice accretion must be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipExposedToIceAccretion ;
                sh:hasValue true
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Each linked protected item in a regulated category must have an associated ice or snow removal or prevention means." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this ?item
                    WHERE {
                        $this nltl:hasProtectedItem ?item .
                        ?item nltl:protectedItemCategory ?category .
                        FILTER (
                            ?category IN (
                                nltl:escapeRouteProtectedItem,
                                nltl:musterStationProtectedItem,
                                nltl:embarkationAreaProtectedItem,
                                nltl:survivalCraftProtectedItem,
                                nltl:launchingApplianceProtectedItem,
                                nltl:survivalCraftAccessProtectedItem
                            )
                        )
                        FILTER NOT EXISTS {
                            ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                            ?means a nltl:iceSnowRemovalOrPreventionMeans .
                        }
                    }
                """
            ]
        ]
    ) .
