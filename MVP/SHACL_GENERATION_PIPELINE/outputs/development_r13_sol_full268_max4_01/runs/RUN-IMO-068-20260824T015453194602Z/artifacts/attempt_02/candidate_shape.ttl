@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO068ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ice-covered-waters applicability selector is required and must be boolean."
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The direct-evacuation-onto-ice applicability selector is required and must be boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInIceCoveredWaters ;
                sh:in ( false )
            ] ;
            sh:property [
                sh:path nltl:directEvacuationOntoIceApplicable ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInIceCoveredWaters ;
                sh:hasValue true
            ] ;
            sh:node gen:IMO068ApplicableEvacuationShape
        ]
        [
            sh:property [
                sh:path nltl:directEvacuationOntoIceApplicable ;
                sh:hasValue true
            ] ;
            sh:node gen:IMO068ApplicableEvacuationShape
        ]
    ) .

gen:IMO068ApplicableEvacuationShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:safeEvacuationMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Safe evacuation means must be present when the evacuation requirement applies."
    ] ;
    sh:property [
        sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "Survival equipment deployment must have approved status when the evacuation requirement applies."
    ] .
