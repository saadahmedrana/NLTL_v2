@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ImmersionSuitTypeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:immersionSuitRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Immersion-suit applicability must be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:immersionSuitTypeClassification ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:insulatedImmersionSuit )
            ]
        ]
    ) ;
    sh:message "Where immersion suits are required, the immersion-suit type classification must be insulated." .
