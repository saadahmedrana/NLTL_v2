@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_082_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "SOLAS regulation V/22.1.9.4 compliance status must be recorded as true."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:bridgeConfigurationValue ;
        sh:minCount 1 ;
        sh:message "A bridge configuration type is required to determine the astern-view requirement."
    ] ;
    sh:property [
        sh:path nltl:clearViewAsternStatus ;
        sh:datatype xsd:boolean ;
        sh:message "Clear view astern status must be a boolean value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The bridge configuration requires every clear view astern status to be true, with at least one true status recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                    nltl:asternViewRequiredBridgeConfiguration .
                FILTER (
                    NOT EXISTS {
                        $this nltl:clearViewAsternStatus
                            "true"^^xsd:boolean .
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?asternStatus .
                        FILTER (?asternStatus = "false"^^xsd:boolean)
                    }
                )
            }
        """
    ] .
