@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO087Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "A planned or actual latitude in degrees is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Above 80 degrees latitude, the ship must have a GNSS compass or equivalent count of at least one and connections to both main and emergency power." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:plannedOrActualLatitude ?latitudeQuantity .
    ?latitudeQuantity qudt:numericValue ?latitude ;
                      qudt:unit unit:DEG .
    FILTER(datatype(?latitude) = xsd:decimal && ?latitude > 80)
    FILTER(
        NOT EXISTS {
            $this nltl:gnssCompassOrEquivalentCount ?count .
            FILTER(datatype(?count) = xsd:integer && ?count >= 1)
        }
        ||
        NOT EXISTS {
            $this nltl:connectedToMainPower ?mainPower .
            FILTER(isIRI(?mainPower))
        }
        ||
        NOT EXISTS {
            $this nltl:connectedToEmergencyPower ?emergencyPower .
            FILTER(isIRI(?emergencyPower))
        }
    )
}
"""
    ] .
