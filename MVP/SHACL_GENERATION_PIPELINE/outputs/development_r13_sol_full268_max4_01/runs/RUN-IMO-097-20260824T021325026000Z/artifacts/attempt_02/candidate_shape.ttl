@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The low-air-temperature applicability value must be recorded once."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:class nltl:lifeboat
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:class nltl:otherSurvivalCraft
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:class nltl:survivalCraft
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gen:IMO097ReleasedCraftShape
            ]
        ]
    ) ;
    sh:message "A low-temperature ship must record the release-selection state and validate every selected released rescue boat or lifeboat." .

gen:IMO097ReleasedCraftShape
    a sh:NodeShape ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each selected released craft must carry a ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:message "Each selected released craft must have a ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:class nltl:locationSignalDevice ;
        sh:minCount 1 ;
        sh:message "Each selected released craft must have a location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:message "Each selected released craft must have an on-scene transmit/receive communication device."
    ] .
