@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:PolarCodeOilDischargeExceptionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:dischargedMaterialTypeValue ;
        sh:message "A discharge material classification is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For clean or segregated ballast discharge, Polar Code paragraph 1.1.1 applicability must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (
                    ?material IN (
                        nltl:cleanBallastMaterial,
                        nltl:segregatedBallastMaterial
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
                        FILTER (
                            isLiteral(?applicable) &&
                            datatype(?applicable) = xsd:boolean &&
                            STR(?applicable) IN ("false", "0")
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?otherApplicable .
                        FILTER (
                            !isLiteral(?otherApplicable) ||
                            datatype(?otherApplicable) != xsd:boolean ||
                            STR(?otherApplicable) NOT IN ("false", "0")
                        )
                    }
                )
            }
        """
    ] .
