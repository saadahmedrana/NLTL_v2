@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:PolarCodeOilDischargeExceptionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:dischargedMaterialTypeValue ;
        sh:message "Each supplied discharge material classification must be an IRI classified as a discharged material type value."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For clean or segregated ballast, paragraph 1.1.1 oil-discharge applicability must be recorded as false." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?material ?app
WHERE {
    $this nltl:dischargedMaterialClassification ?material .
    FILTER (
        ?material IN (
            nltl:cleanBallastMaterial,
            nltl:segregatedBallastMaterial
        )
    )
    OPTIONAL {
        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?app .
    }
    FILTER (
        !BOUND(?app) ||
        DATATYPE(?app) != xsd:boolean ||
        ?app != false
    )
}
"""
    ] .
