@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO108Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC )
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                )
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:minCount 1 ;
                        sh:datatype xsd:date ;
                        sh:maxExclusive "2017-01-01"^^xsd:date
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:minCount 1 ;
                        sh:datatype xsd:date ;
                        sh:minInclusive "2017-01-01"^^xsd:date
                    ] ;
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:aggregateOilFuelCapacity ;
                                sh:minCount 1 ;
                                sh:node gs:AggregateCapacityAtLeast600
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:aggregateOilFuelCapacity ;
                                sh:minCount 1 ;
                                sh:node gs:AggregateCapacityBelow600
                            ] ;
                            sh:or (
                                [
                                    sh:property [
                                        sh:path nltl:individualOilFuelTankCapacity ;
                                        sh:minCount 1 ;
                                        sh:node gs:IndividualCapacityAtMost30
                                    ]
                                ]
                                [
                                    sh:property [
                                        sh:path nltl:individualOilFuelTankCapacity ;
                                        sh:minCount 1 ;
                                        sh:node gs:IndividualCapacityAbove30
                                    ] ;
                                    sh:property [
                                        sh:path nltl:oilFuelTankOuterShellSeparation ;
                                        sh:minCount 1 ;
                                        sh:node gs:OuterShellSeparationAtLeast076
                                    ]
                                ]
                            )
                        ]
                    )
                ]
            )
        ]
    ) .

gs:AggregateCapacityAtLeast600
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "600"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M3
    ] .

gs:AggregateCapacityBelow600
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:maxExclusive "600"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M3
    ] .

gs:IndividualCapacityAtMost30
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:maxInclusive "30"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M3
    ] .

gs:IndividualCapacityAbove30
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "30"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M3
    ] .

gs:OuterShellSeparationAtLeast076
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0.76"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .
