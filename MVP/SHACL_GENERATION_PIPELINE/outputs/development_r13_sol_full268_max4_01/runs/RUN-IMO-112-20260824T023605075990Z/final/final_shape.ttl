@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO112Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The operating area must be recorded to determine whether the Arctic-waters prohibition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "In Arctic waters, every recorded NLS discharge-to-sea value must be boolean false, and such a value must be present." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:operatingArea ?area .
    FILTER(?area = "Arctic_waters"^^xsd:string)
    FILTER(
        NOT EXISTS {
            $this nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ?permitted .
            FILTER(
                DATATYPE(?permitted) = xsd:boolean &&
                ?permitted = false
            )
        }
        ||
        EXISTS {
            $this nltl:noxiousLiquidSubstanceOrNoxiousLiquidSubstanceMixtureDischargeToSea ?recorded .
            FILTER(
                DATATYPE(?recorded) != xsd:boolean ||
                ?recorded != false
            )
        }
    )
}
"""
    ] .
