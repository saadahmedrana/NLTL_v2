@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:IMO-114Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:cargoTankType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:administrationCarriageApprovalStatus ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path nltl:applicableCertificatePolarOperationEntryPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable Category A or B ship carrying the specified NLS in a type 3 cargo tank must have Administration approval and a polar-operation certificate entry." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:shipCategory ?shipCategory ;
          nltl:constructionDate ?constructionDate ;
          nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3Tank ;
          nltl:cargoTankType ?cargoTankType .

    FILTER(
        ?shipCategory IN (
            nltl:polarShipCategoryA,
            nltl:polarShipCategoryB
        )
    )
    FILTER(?requiresType3Tank = true)
    FILTER(?cargoTankType = "3"^^xsd:string)
    FILTER(
        YEAR(?constructionDate) > 2017 ||
        (
            YEAR(?constructionDate) = 2017 &&
            (
                MONTH(?constructionDate) > 1 ||
                (
                    MONTH(?constructionDate) = 1 &&
                    DAY(?constructionDate) >= 1
                )
            )
        )
    )

    FILTER NOT EXISTS {
        $this nltl:administrationCarriageApprovalStatus
                  nltl:evidenceStateApproved ;
              nltl:applicableCertificatePolarOperationEntryPresent
                  ?certificateEntry .
        FILTER(?certificateEntry = true)
    }
}
"""
    ] .
