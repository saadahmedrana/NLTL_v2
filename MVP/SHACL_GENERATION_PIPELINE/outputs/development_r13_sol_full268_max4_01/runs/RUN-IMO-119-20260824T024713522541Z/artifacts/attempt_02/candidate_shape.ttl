@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IceConcentrationAtMostOneShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:maxInclusive "1"^^xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IceConcentrationAboveOneShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minExclusive "1"^^xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:IMO119Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:node gen:IceConcentrationAtMostOneShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:node gen:IceConcentrationAboveOneShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:extendedPeriodOperation ;
                sh:datatype xsd:boolean ;
                sh:in ( "false"^^xsd:boolean ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:node gen:IceConcentrationAboveOneShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:extendedPeriodOperation ;
                sh:datatype xsd:boolean ;
                sh:in ( "true"^^xsd:boolean ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:sewageDischargeOccurs ;
                sh:datatype xsd:boolean ;
                sh:in ( "false"^^xsd:boolean ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:iceConcentration ;
                sh:node gen:IceConcentrationAboveOneShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:extendedPeriodOperation ;
                sh:datatype xsd:boolean ;
                sh:in ( "true"^^xsd:boolean ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:sewageDischargeOccurs ;
                sh:datatype xsd:boolean ;
                sh:in ( "true"^^xsd:boolean ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:approvedSewageTreatmentPlantUsed ;
                sh:datatype xsd:boolean ;
                sh:in ( "true"^^xsd:boolean ) ;
                sh:minCount 1 ;
                sh:message "Applicable sewage discharges must use an approved sewage treatment plant."
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:minCount 1 ;
                sh:message "The sewage treatment plant must have approved MARPOL Annex IV regulation 9.1.1 or 9.2.1 certification status."
            ] ;
            sh:property [
                sh:path nltl:administrationDischargeApprovalStatus ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:minCount 1 ;
                sh:message "The applicable sewage discharge must be approved by the Administration."
            ]
        ]
    ) .
