@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:NauticalMileDistanceValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MI_N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessConcentrationValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:FoodWasteDischargeDistanceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatingArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Operating area is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:arcticWaters ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Arctic-waters applicability value is required."
    ] ;
    sh:property [
        sh:path nltl:foodWasteDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Food-waste discharge status is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:node gen:NauticalMileDistanceValueShape
    ] ;
    sh:property [
        sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
        sh:node gen:NauticalMileDistanceValueShape
    ] ;
    sh:property [
        sh:path nltl:nearbyIceConcentration ;
        sh:node gen:UnitlessConcentrationValueShape
    ] ;
    sh:property [
        sh:path nltl:iceConcentration ;
        sh:node gen:UnitlessConcentrationValueShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For food-waste discharge in Arctic waters, the nearest-land, ice-shelf, or fast-ice distance must be at least 12 nautical miles, and the distance from an area with ice concentration above one tenth must be recorded." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:operatingArea ?area ;
          nltl:arcticWaters ?arcticArea ;
          nltl:foodWasteDischargeToSea ?discharge .
    FILTER(
        ?area = ?arcticArea &&
        ?discharge = "true"^^xsd:boolean
    )
    FILTER NOT EXISTS {
        $this nltl:distanceToNearestLandIceShelfOrFastIce ?nearestDistance ;
              nltl:nearbyIceConcentration ?nearbyConcentration ;
              nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?iceAreaDistance .
        ?nearestDistance qudt:numericValue ?nearestValue ;
                         qudt:unit unit:MI_N .
        ?nearbyConcentration qudt:numericValue ?concentrationValue ;
                             qudt:unit unit:UNITLESS .
        ?iceAreaDistance qudt:numericValue ?iceAreaDistanceValue ;
                         qudt:unit unit:MI_N .
        FILTER(
            datatype(?nearestValue) = xsd:decimal &&
            datatype(?concentrationValue) = xsd:decimal &&
            datatype(?iceAreaDistanceValue) = xsd:decimal &&
            ?nearestValue >= "12"^^xsd:decimal &&
            ?concentrationValue > "1"^^xsd:decimal
        )
    }
}
"""
    ] .
