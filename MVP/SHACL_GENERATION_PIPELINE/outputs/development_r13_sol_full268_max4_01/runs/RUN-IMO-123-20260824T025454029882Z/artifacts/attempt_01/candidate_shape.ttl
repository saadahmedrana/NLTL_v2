@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:CargoResidueDischargeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:residueNotRecoverableByCommonMethods ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Cargo residue must not be recoverable using commonly available methods."
            ] ;
            sh:property [
                sh:path nltl:shipEnRoute ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The ship must be en route."
            ] ;
            sh:property [
                sh:path nltl:harmfulSubstancePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "Harmful substances must not be present."
            ] ;
            sh:property [
                sh:path nltl:departureAndDestinationWithinArctic ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The departure and destination ports must be within Arctic waters."
            ] ;
            sh:property [
                sh:path nltl:routeRemainsWithinArctic ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The route must remain within Arctic waters."
            ] ;
            sh:property [
                sh:path nltl:adequateReceptionFacilitiesAvailable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "Adequate reception facilities must be unavailable."
            ] ;
            sh:property [
                sh:path nltl:hasDischargeDistanceRecord ;
                sh:minCount 1 ;
                sh:class nltl:dischargeDistanceRecords ;
                sh:node gen:DischargeDistanceRecordShape ;
                sh:message "Each discharge-distance record must contain both required distances."
            ]
        ]
    ) .

gen:DischargeDistanceRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:distanceToNearestLandIceShelfOrFastIce ;
        sh:minCount 1 ;
        sh:node gen:MinimumDischargeDistanceQuantityShape ;
        sh:message "Distance to the nearest land, ice shelf, or fast ice must be at least 12 nautical miles."
    ] ;
    sh:property [
        sh:path nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ;
        sh:minCount 1 ;
        sh:node gen:IceConcentrationAreaDistanceQuantityShape ;
        sh:message "Distance from an area with ice concentration greater than one tenth must be recorded."
    ] .

gen:MinimumDischargeDistanceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "12"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MI_N
    ] .

gen:IceConcentrationAreaDistanceQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MI_N
    ] .
