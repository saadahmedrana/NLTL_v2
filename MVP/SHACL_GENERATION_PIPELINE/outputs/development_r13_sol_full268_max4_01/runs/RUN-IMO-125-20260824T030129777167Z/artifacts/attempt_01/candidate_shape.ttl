@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PolarGarbageDocumentCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "The ship must explicitly indicate that it does not operate in polar waters."
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "This branch applies when the ship operates in polar waters."
            ] ;
            sh:property [
                sh:path nltl:garbageRecordBookPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The Garbage Record Book must cover operation in polar waters."
            ] ;
            sh:property [
                sh:path nltl:garbageManagementPlanPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "The Garbage Management Plan must cover operation in polar waters."
            ] ;
            sh:property [
                sh:path nltl:garbagePlacardPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Garbage placards must cover operation in polar waters."
            ]
        ]
    ) .
