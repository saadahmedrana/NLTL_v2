@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:Chapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "A fishing vessel with length overall of at least 24 m must have Chapter 9-1 applicability set to true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:fishingVessel ;
                    nltl:lengthOverall ?lengthQuantity .
                ?lengthQuantity qudt:numericValue ?length ;
                    qudt:unit unit:M .
                FILTER(?length >= "24"^^xsd:decimal)
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
                    FILTER(
                        datatype(?applicable) = xsd:boolean &&
                        ?applicable = true
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A pleasure yacht of at least 300 gross tonnage that is not engaged in trade must have Chapter 9-1 applicability set to true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:pleasureYacht ;
                    nltl:grossTonnage ?tonnageQuantity ;
                    nltl:engagedInTrade ?engaged .
                ?tonnageQuantity qudt:numericValue ?tonnage ;
                    qudt:unit unit:UNITLESS .
                FILTER(?tonnage >= "300"^^xsd:decimal)
                FILTER(
                    datatype(?engaged) = xsd:boolean &&
                    ?engaged = false
                )
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
                    FILTER(
                        datatype(?applicable) = xsd:boolean &&
                        ?applicable = true
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A cargo ship from 300 gross tonnage up to but excluding 500 gross tonnage must have Chapter 9-1 applicability set to true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:cargoShip ;
                    nltl:grossTonnage ?tonnageQuantity .
                ?tonnageQuantity qudt:numericValue ?tonnage ;
                    qudt:unit unit:UNITLESS .
                FILTER(
                    ?tonnage >= "300"^^xsd:decimal &&
                    ?tonnage < "500"^^xsd:decimal
                )
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
                    FILTER(
                        datatype(?applicable) = xsd:boolean &&
                        ?applicable = true
                    )
                }
            }
        """
    ] .

gen:FishingVesselApplicabilityInputShape
    a sh:NodeShape ;
    sh:targetClass nltl:fishingVessel ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ] ;
        sh:message "A fishing vessel requires one decimal length-overall value in metres to determine Chapter 9-1 applicability."
    ] .

gen:PleasureYachtApplicabilityInputShape
    a sh:NodeShape ;
    sh:targetClass nltl:pleasureYacht ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "A pleasure yacht requires one decimal gross-tonnage value to determine Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A pleasure yacht requires one boolean trade-status value to determine Chapter 9-1 applicability."
    ] .

gen:CargoShipApplicabilityInputShape
    a sh:NodeShape ;
    sh:targetClass nltl:cargoShip ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ] ;
        sh:message "A cargo ship requires one decimal gross-tonnage value to determine Chapter 9-1 applicability."
    ] .
