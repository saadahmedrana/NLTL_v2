@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthOverallValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:M )
    ] .

gen:GrossTonnageValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:in ( unit:UNITLESS )
    ] .

gen:Chapter9_1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:node gen:LengthOverallValueShape
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node gen:GrossTonnageValueShape
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A fishing vessel with length overall of at least 24 m must record Chapter 9-1 as applicable." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:fishingVessel ;
          nltl:lengthOverall ?length .
    ?length qudt:numericValue ?lengthValue ;
            qudt:unit unit:M .
    FILTER(?lengthValue >= 24)
    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
        FILTER(?applicable = true)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A pleasure yacht of at least 300 gross tonnage that is not engaged in trade must record Chapter 9-1 as applicable." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:pleasureYacht ;
          nltl:grossTonnage ?grossTonnage ;
          nltl:engagedInTrade ?engagedInTrade .
    ?grossTonnage qudt:numericValue ?grossTonnageValue ;
                  qudt:unit unit:UNITLESS .
    FILTER(?grossTonnageValue >= 300)
    FILTER(?engagedInTrade = false)
    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
        FILTER(?applicable = true)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A cargo ship from 300 gross tonnage up to but not including 500 gross tonnage must record Chapter 9-1 as applicable." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this a nltl:cargoShip ;
          nltl:grossTonnage ?grossTonnage .
    ?grossTonnage qudt:numericValue ?grossTonnageValue ;
                  qudt:unit unit:UNITLESS .
    FILTER(?grossTonnageValue >= 300)
    FILTER(?grossTonnageValue < 500)
    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter9Dash1Applicable ?applicable .
        FILTER(?applicable = true)
    }
}
"""
    ] .
