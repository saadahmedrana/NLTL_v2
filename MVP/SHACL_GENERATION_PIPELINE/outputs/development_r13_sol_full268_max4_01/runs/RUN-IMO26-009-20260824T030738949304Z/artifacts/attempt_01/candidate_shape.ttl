@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26-009ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion applicability must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:minCount 1 ;
                sh:class nltl:navigationOrCommunicationAntenna ;
                sh:node gen:IMO26-009AntennaShape ;
                sh:message "When ice accretion is likely, each required navigation or communication antenna must be identified and protected against ice accumulation."
            ]
        ]
    ) .

gen:IMO26-009AntennaShape
    a sh:NodeShape ;
    sh:class nltl:navigationOrCommunicationAntenna ;
    sh:property [
        sh:path nltl:antennaIceAccumulationPreventionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The required antenna must have ice-accumulation prevention present."
    ] .
