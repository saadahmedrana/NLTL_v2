@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:BelowHullSensorIceProtectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:requiredSensorProjectsBelowHull ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must state whether required sensors project below the hull."
    ] ;
    sh:property [
        sh:path nltl:sensorIceProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When required sensors project below the hull, sensor ice protection must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:requiredSensorProjectsBelowHull ?projectsBelowHull .
                FILTER(?projectsBelowHull = true)
                FILTER NOT EXISTS {
                    $this nltl:sensorIceProtectionPresent ?iceProtection .
                    FILTER(?iceProtection = true)
                }
            }
        """
    ] .
