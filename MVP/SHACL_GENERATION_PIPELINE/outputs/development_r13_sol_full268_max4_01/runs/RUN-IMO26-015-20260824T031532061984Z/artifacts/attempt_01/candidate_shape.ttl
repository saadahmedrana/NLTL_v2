@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_015_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Applicable ;
        sh:datatype xsd:boolean ;
        sh:message "Polar Code chapter 11 applicability must be represented as a boolean."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship marked as subject to Polar Code chapter 11 must be certified in accordance with SOLAS chapter I." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:polarCodeChapter11Applicable ?chapter11Applicable .
    FILTER(?chapter11Applicable = "true"^^xsd:boolean)
    FILTER NOT EXISTS {
        $this nltl:solasChapterICertified ?solasCertified .
        FILTER(?solasCertified = "true"^^xsd:boolean)
    }
}
"""
    ] .
