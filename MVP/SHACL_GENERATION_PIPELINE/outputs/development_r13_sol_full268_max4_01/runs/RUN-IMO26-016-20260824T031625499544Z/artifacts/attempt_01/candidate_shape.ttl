@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:Chapter11Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A qualifying ship operating in polar waters must have Polar Code chapter 11-1 applicability set to true." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:shipOperatesInPolarWaters ?polar .
    FILTER(DATATYPE(?polar) = xsd:boolean && ?polar = true)

    {
        $this a nltl:fishingVessel ;
            nltl:lengthOverall ?lengthQuantity .
        ?lengthQuantity
            qudt:numericValue ?length ;
            qudt:unit unit:M .
        FILTER(DATATYPE(?length) = xsd:decimal && ?length >= 24)
    }
    UNION
    {
        $this a nltl:pleasureYacht ;
            nltl:grossTonnage ?tonnageQuantity ;
            nltl:engagedInTrade ?tradeStatus .
        ?tonnageQuantity
            qudt:numericValue ?tonnage ;
            qudt:unit unit:UNITLESS .
        FILTER(
            DATATYPE(?tonnage) = xsd:decimal &&
            ?tonnage >= 300 &&
            DATATYPE(?tradeStatus) = xsd:boolean &&
            ?tradeStatus = false
        )
    }
    UNION
    {
        $this a nltl:cargoShip ;
            nltl:grossTonnage ?tonnageQuantity .
        ?tonnageQuantity
            qudt:numericValue ?tonnage ;
            qudt:unit unit:UNITLESS .
        FILTER(
            DATATYPE(?tonnage) = xsd:decimal &&
            ?tonnage >= 300 &&
            ?tonnage < 500
        )
    }

    FILTER NOT EXISTS {
        $this nltl:polarCodeChapter11Dash1Applicable ?applicable .
        FILTER(
            DATATYPE(?applicable) = xsd:boolean &&
            ?applicable = true
        )
    }
}
""" ;
    ] .
