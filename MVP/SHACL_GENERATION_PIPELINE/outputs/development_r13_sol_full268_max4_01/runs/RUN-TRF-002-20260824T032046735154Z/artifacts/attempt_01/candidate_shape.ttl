@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF002Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Ships contracted on or after 1 January 2019 and before 5 July 2021 shall use the 2017 Ice Class Regulations." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    (
                        YEAR(?date) > 2019 ||
                        (YEAR(?date) = 2019 && MONTH(?date) > 1) ||
                        (YEAR(?date) = 2019 && MONTH(?date) = 1 && DAY(?date) >= 1)
                    ) &&
                    (
                        YEAR(?date) < 2021 ||
                        (YEAR(?date) = 2021 && MONTH(?date) < 7) ||
                        (YEAR(?date) = 2021 && MONTH(?date) = 7 && DAY(?date) < 5)
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2017 .
                }
            }
        """
    ] .
