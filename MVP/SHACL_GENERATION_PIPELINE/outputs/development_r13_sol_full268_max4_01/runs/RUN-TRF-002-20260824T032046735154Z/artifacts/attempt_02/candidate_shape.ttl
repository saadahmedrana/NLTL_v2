@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF002Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date ;
        sh:message "Any supplied construction contract date must be an xsd:date."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship contracted on or after 1 January 2019 but before 5 July 2021 must identify the 2017 Ice Class Regulations as applicable." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:constructionContractDate ?date .
    FILTER (
        (
            YEAR(?date) > 2019 ||
            (
                YEAR(?date) = 2019 &&
                (
                    MONTH(?date) > 1 ||
                    (MONTH(?date) = 1 && DAY(?date) >= 1)
                )
            )
        ) &&
        (
            YEAR(?date) < 2021 ||
            (
                YEAR(?date) = 2021 &&
                (
                    MONTH(?date) < 7 ||
                    (MONTH(?date) = 7 && DAY(?date) < 5)
                )
            )
        )
    )
    FILTER NOT EXISTS {
        $this nltl:applicableIceClassRegulationEdition
            nltl:iceClassRegulationEdition2017 .
    }
}
"""
    ] .
