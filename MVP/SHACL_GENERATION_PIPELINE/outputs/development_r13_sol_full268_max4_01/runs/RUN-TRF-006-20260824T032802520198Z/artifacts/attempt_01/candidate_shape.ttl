@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction-stage date is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:maxExclusive "1986-11-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2003-09-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:message "An ice class is required for a ship in the applicable construction-stage cohort."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:in ( nltl:iceClassRuleEdition1985 ) ;
                sh:message "The applicable ice-class regulation edition must be the 1985 rules."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:in ( "false"^^xsd:boolean )
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:minCount 1 ;
                        sh:in ( nltl:iceClassRuleEdition1985 ) ;
                        sh:message "Without an owner request for the 2008 requirements, the engine-output regulation edition must be the 1985 rules."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:in ( "true"^^xsd:boolean )
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:minCount 1 ;
                        sh:in ( nltl:iceClassRegulationEdition2008 ) ;
                        sh:message "When the owner has requested the 2008 engine-output requirements, the engine-output regulation edition must be the 2008 edition."
                    ]
                ]
            )
        ]
    ) ;
    sh:message "The construction-stage cohort and regulation-edition selection are inconsistent." .
