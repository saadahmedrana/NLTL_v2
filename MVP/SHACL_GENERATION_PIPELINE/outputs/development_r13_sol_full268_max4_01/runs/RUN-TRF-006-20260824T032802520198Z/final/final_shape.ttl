@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF006Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction-stage date is required to determine whether the 1985 Ice Class Rules apply."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:maxExclusive "1986-11-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minInclusive "2003-09-01"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionStageDate ;
                sh:minInclusive "1986-11-01"^^xsd:date ;
                sh:maxExclusive "2003-09-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:iceClass ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:message "The ship's ice class is required for the applicable construction-stage cohort."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:iceClassRuleEdition1985 ) ;
                sh:minCount 1 ;
                sh:message "The applicable ice-class regulation edition must be the 1985 Ice Class Rules."
            ] ;
            sh:property [
                sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:message "The owner's request decision is required for selecting the engine-output regulation edition."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:in ( "false"^^xsd:boolean )
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:iceClassRuleEdition1985 ) ;
                        sh:minCount 1 ;
                        sh:message "Without an owner request, the engine-output regulation edition must be the 1985 Ice Class Rules."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:ownerRequested2008EngineOutputRequirements ;
                        sh:datatype xsd:boolean ;
                        sh:in ( "true"^^xsd:boolean )
                    ] ;
                    sh:property [
                        sh:path nltl:engineOutputRegulationEdition ;
                        sh:nodeKind sh:IRI ;
                        sh:in (
                            nltl:iceClassRuleEdition1985
                            nltl:iceClassRegulationEdition2008
                        ) ;
                        sh:minCount 1 ;
                        sh:message "With an owner request, the engine-output regulation edition may be either the 1985 Rules or the 2008 Regulations."
                    ]
                ]
            )
        ]
    ) .
