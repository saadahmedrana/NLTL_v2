@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF009Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship must identify its ice class."
    ] ;
    sh:or (
        [
            sh:not [
                sh:or (
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIaSuper
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIa
                        ]
                    ]
                )
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIa
                    ]
                ]
            ) ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:constructionStageDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:minInclusive "2003-09-01"^^xsd:date
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionStageDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:maxExclusive "2003-09-01"^^xsd:date
                    ] ;
                    sh:property [
                        sh:path nltl:deliveryDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:message "A delivery date is required to determine the compliance deadline."
                    ] ;
                    sh:property [
                        sh:path nltl:assessmentDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:message "An assessment date is required to evaluate the compliance deadline."
                    ] ;
                    sh:sparql [
                        sh:message "Once the twenty-year deadline has been reached, the ship must comply using the section 3.2.2 or section 3.2.4 method." ;
                        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:deliveryDate ?delivery ;
          nltl:assessmentDate ?assessment .
    FILTER(YEAR(?assessment) >= YEAR(?delivery) + 20)
    FILTER NOT EXISTS {
        $this nltl:engineOutputComplianceMethod ?method .
        FILTER(?method IN (
            nltl:traficom2017Section3Point2Point2Method,
            nltl:traficom2017Section3Point2Point4Method
        ))
    }
}
"""
                    ]
                ]
            )
        ]
    ) .
