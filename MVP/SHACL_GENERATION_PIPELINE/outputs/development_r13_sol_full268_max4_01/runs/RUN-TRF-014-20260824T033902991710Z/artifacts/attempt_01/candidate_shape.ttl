@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthInMetresShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:ClassCertificateDraughtShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1
    ] .

gen:TRF014Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:classCertificate ;
        sh:node gen:ClassCertificateDraughtShape ;
        sh:minCount 1 ;
        sh:message "A class certificate indicating all maximum and minimum ice-class draughts fore, amidships, and aft is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:message "Ice-operation draught restrictions must be documented."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The draught-restriction documentation must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The draught-restriction documentation must be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine the applicable marking rule."
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1 ;
        sh:message "The summer load line fresh-water draught is required to determine marking applicability."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:LengthInMetresShape ;
        sh:minCount 1 ;
        sh:message "The upper ice waterline draught is required to determine marking applicability."
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:LengthInMetresShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the summer fresh-water load-line draught exceeds the UIWL, the required warning triangle and ice-class draught mark must be provided when the applicable construction or dry-docking deadline has been reached; the mark draught must equal the certificate maximum amidships draught." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
                      nltl:upperIceWaterlineDraught ?uiwlQuantity ;
                      nltl:hasClassCertificate ?certificate .

                ?summerQuantity qudt:numericValue ?summerDraught .
                ?uiwlQuantity qudt:numericValue ?uiwlDraught .
                ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
                ?maximumQuantity qudt:numericValue ?maximumDraught .

                BIND(
                    YEAR(?constructionDate) > 2007 ||
                    (
                        YEAR(?constructionDate) = 2007 &&
                        (
                            MONTH(?constructionDate) > 7 ||
                            (
                                MONTH(?constructionDate) = 7 &&
                                DAY(?constructionDate) >= 1
                            )
                        )
                    )
                    AS ?builtOnOrAfterCutoff
                )

                BIND(
                    EXISTS {
                        $this nltl:warningTrianglePresent true ;
                              nltl:iceClassDraughtMarkPresent true ;
                              nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
                        ?markQuantity qudt:numericValue ?markDraught .
                        FILTER(xsd:decimal(?markDraught) = xsd:decimal(?maximumDraught))
                    }
                    AS ?completeMarking
                )

                FILTER(xsd:decimal(?summerDraught) > xsd:decimal(?uiwlDraught))

                FILTER(
                    (
                        ?builtOnOrAfterCutoff = true &&
                        ?completeMarking = false
                    )
                    ||
                    (
                        ?builtOnOrAfterCutoff = false &&
                        ?completeMarking = false &&
                        (
                            NOT EXISTS {
                                $this nltl:assessmentDate ?assessmentDate .
                            }
                            ||
                            NOT EXISTS {
                                $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
                            }
                            ||
                            EXISTS {
                                $this nltl:assessmentDate ?assessmentDate ;
                                      nltl:firstScheduledDryDockingDate ?dryDockingDate .
                                FILTER(
                                    YEAR(?dryDockingDate) < YEAR(?assessmentDate) ||
                                    (
                                        YEAR(?dryDockingDate) = YEAR(?assessmentDate) &&
                                        (
                                            MONTH(?dryDockingDate) < MONTH(?assessmentDate) ||
                                            (
                                                MONTH(?dryDockingDate) = MONTH(?assessmentDate) &&
                                                DAY(?dryDockingDate) <= DAY(?assessmentDate)
                                            )
                                        )
                                    )
                                )
                            }
                        )
                    )
                )
            }
        """
    ] .
