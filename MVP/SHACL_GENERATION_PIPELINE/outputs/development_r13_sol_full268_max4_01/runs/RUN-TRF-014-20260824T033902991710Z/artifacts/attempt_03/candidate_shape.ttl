@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single assessment date is required."
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single construction date is required."
    ] ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship's ice class is required."
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:nodeKind sh:IRI ;
        sh:node gen:TRF014ClassCertificateShape ;
        sh:minCount 1 ;
        sh:message "A class certificate containing all maximum and minimum ice-class draughts is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:minCount 1 ;
        sh:message "Ice-operation draught restrictions must be documented."
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The draught-restriction documentation must be retained on board."
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The draught-restriction documentation must be readily available to the master."
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single summer load-line fresh-water draught is required."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A single upper ice waterline draught is required."
    ] ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:node gen:TRF014SummerLoadLineNotAboveUIWLShape
        ]
        [
            sh:and (
                [
                    sh:node gen:TRF014SummerLoadLineAboveUIWLShape
                ]
                [
                    sh:node gen:TRF014CompleteMarkingShape
                ]
            )
        ]
        [
            sh:and (
                [
                    sh:node gen:TRF014SummerLoadLineAboveUIWLShape
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:maxExclusive "2007-07-01"^^xsd:date ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:firstScheduledDryDockingDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:assessmentDate ;
                        sh:lessThan nltl:firstScheduledDryDockingDate
                    ]
                ]
            )
        ]
    ) ;
    sh:message "When the summer fresh-water load line is above the UIWL, complete markings are required, except that a pre-1 July 2007 ship may await its first scheduled dry docking while that date is later than the assessment date." .

gen:TRF014ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014LengthMetresShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014SummerLoadLineAboveUIWLShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The summer fresh-water load line must be above the upper ice waterline in this branch." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?summerQuantity qudt:numericValue ?summerDraught .
    ?uiwlQuantity qudt:numericValue ?uiwlDraught .
    FILTER (?summerDraught <= ?uiwlDraught)
}
"""
    ] .

gen:TRF014SummerLoadLineNotAboveUIWLShape
    a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The summer fresh-water load line must be at or below the upper ice waterline in this branch." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summerQuantity ;
          nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?summerQuantity qudt:numericValue ?summerDraught .
    ?uiwlQuantity qudt:numericValue ?uiwlDraught .
    FILTER (?summerDraught > ?uiwlDraught)
}
"""
    ] .

gen:TRF014CompleteMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A warning triangle is required."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An ice-class draught mark is required."
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:TRF014LengthMetresShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The amidships draught represented by the ice-class draught mark is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-class draught mark must represent the maximum permissible ice-class draught amidships." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity ;
          nltl:hasClassCertificate ?certificate .
    ?markQuantity qudt:numericValue ?reportedDraught .
    ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
    ?maximumQuantity qudt:numericValue ?expectedDraught .
    BIND(
        IF(
            ABS(?expectedDraught) * "0.000001"^^xsd:decimal >
                "0.000000001"^^xsd:decimal,
            ABS(?expectedDraught) * "0.000001"^^xsd:decimal,
            "0.000000001"^^xsd:decimal
        )
        AS ?tolerance
    )
    FILTER (ABS(?reportedDraught - ?expectedDraught) > ?tolerance)
}
"""
    ] .
