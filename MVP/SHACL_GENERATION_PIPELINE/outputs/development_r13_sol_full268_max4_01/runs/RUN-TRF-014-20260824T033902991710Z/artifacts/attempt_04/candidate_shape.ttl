@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF014ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasClassCertificate ;
        sh:class nltl:classCertificate ;
        sh:node gen:TRF014ClassCertificateShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceDraughtRestrictionDocument ;
        sh:class nltl:iceDraughtRestrictionDocument ;
        sh:node gen:TRF014IceDraughtRestrictionDocumentShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:retainedOnBoard ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:readilyAvailableToMaster ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:summerLoadLineFreshWaterDraught ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:node gen:TRF014SummerLoadLineNotAboveUIWLShape
        ]
        [
            sh:node gen:TRF014SummerLoadLineAboveUIWLShape ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:minInclusive "2007-07-01"^^xsd:date ;
                        sh:minCount 1
                    ] ;
                    sh:node gen:TRF014CompleteMarkingShape
                ]
                [
                    sh:property [
                        sh:path nltl:constructionDate ;
                        sh:datatype xsd:date ;
                        sh:maxExclusive "2007-07-01"^^xsd:date ;
                        sh:minCount 1
                    ] ;
                    sh:or (
                        [
                            sh:node gen:TRF014CompleteMarkingShape
                        ]
                        [
                            sh:node gen:TRF014DryDockingAfterAssessmentShape
                        ]
                        [
                            sh:node gen:TRF014DryDockingOnOrBeforeAssessmentShape ;
                            sh:node gen:TRF014CompleteMarkingShape
                        ]
                    )
                ]
            )
        ]
    ) .

gen:TRF014ClassCertificateShape
    a sh:NodeShape ;
    sh:class nltl:classCertificate ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtFore ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAmidships ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:maximumIceClassDraughtAft ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtFore ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAmidships ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:minimumIceClassDraughtAft ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] .

gen:TRF014IceDraughtRestrictionDocumentShape
    a sh:NodeShape ;
    sh:class nltl:iceDraughtRestrictionDocument .

gen:TRF014MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF014CompleteMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:warningTrianglePresent ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkPresent ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClassDraughtMarkDraughtAmidships ;
        sh:node gen:TRF014MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "The amidships ice-class draught mark must match the certificate maximum amidships draught within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClassDraughtMarkDraughtAmidships ?markQuantity .
    ?markQuantity qudt:numericValue ?markDraught .
    $this nltl:hasClassCertificate ?certificate .
    ?certificate nltl:maximumIceClassDraughtAmidships ?maximumQuantity .
    ?maximumQuantity qudt:numericValue ?expectedDraught .
    FILTER(
        ABS(?markDraught - ?expectedDraught) >
        IF(
            ABS(?expectedDraught) > "0.000001"^^xsd:decimal,
            "0.000001"^^xsd:decimal * ABS(?expectedDraught),
            "0.000000000001"^^xsd:decimal
        )
    )
}
"""
    ] .

gen:TRF014SummerLoadLineAboveUIWLShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "The marking-required branch applies only when the summer fresh-water draught is greater than the upper ice waterline draught." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summerQuantity .
    ?summerQuantity qudt:numericValue ?summerDraught .
    $this nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?uiwlQuantity qudt:numericValue ?uiwlDraught .
    FILTER(?summerDraught <= ?uiwlDraught)
}
"""
    ] .

gen:TRF014SummerLoadLineNotAboveUIWLShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "The no-marking branch applies only when the summer fresh-water draught is less than or equal to the upper ice waterline draught." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:summerLoadLineFreshWaterDraught ?summerQuantity .
    ?summerQuantity qudt:numericValue ?summerDraught .
    $this nltl:upperIceWaterlineDraught ?uiwlQuantity .
    ?uiwlQuantity qudt:numericValue ?uiwlDraught .
    FILTER(?summerDraught > ?uiwlDraught)
}
"""
    ] .

gen:TRF014DryDockingAfterAssessmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "Missing marking evidence is permitted only while the assessment date is before the first scheduled dry-docking date." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
    $this nltl:assessmentDate ?assessmentDate .
    FILTER(?dryDockingDate <= ?assessmentDate)
}
"""
    ] .

gen:TRF014DryDockingOnOrBeforeAssessmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:firstScheduledDryDockingDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "This branch applies when the first scheduled dry-docking date is on or before the assessment date." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:firstScheduledDryDockingDate ?dryDockingDate .
    $this nltl:assessmentDate ?assessmentDate .
    FILTER(?dryDockingDate > ?assessmentDate)
}
"""
    ] .
