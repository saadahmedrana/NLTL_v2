@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PowerQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:EngineOutputShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionOutputRestrictionApplies ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether propulsion output restriction applies must be stated."
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:node gen:PowerQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Engine output P must be provided as a single power value in kilowatts."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:propulsionMachineryContinuousOutput ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Unrestricted propulsion machinery continuous output must be provided in kilowatts."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:node gen:PowerQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Restricted propulsion output must be provided in kilowatts when restriction applies."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Engine output P must equal the applicable continuous or restricted propulsion output within relative tolerance 1e-6 and absolute fallback 1e-12 kW." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propulsionOutputRestrictionApplies ?restricted ;
          nltl:maximumContinuousRatingPower ?reportedNode .
    ?reportedNode qudt:numericValue ?reported .
    BIND(
        IF(
            ?restricted = "true"^^xsd:boolean,
            nltl:restrictedPropulsionOutput,
            nltl:propulsionMachineryContinuousOutput
        ) AS ?expectedProperty
    )
    $this ?expectedProperty ?expectedNode .
    ?expectedNode qudt:numericValue ?expected .
    BIND(ABS(?expected) * "0.000001"^^xsd:decimal AS ?relativeTolerance)
    BIND(
        IF(
            ?relativeTolerance > "0.000000000001"^^xsd:decimal,
            ?relativeTolerance,
            "0.000000000001"^^xsd:decimal
        ) AS ?tolerance
    )
    FILTER(ABS(?reported - ?expected) > ?tolerance)
}
"""
    ] .
