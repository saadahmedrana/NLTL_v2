@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF017EngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:KilowattQuantityValueShape
            ] ;
            sh:property [
                sh:path nltl:propulsionMachineryContinuousOutput ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:KilowattQuantityValueShape
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The engine output P must equal the propulsion machinery continuous output when propulsion output restriction does not apply." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?reported ;
                              nltl:propulsionMachineryContinuousOutput ?selected .
                        ?reported qudt:numericValue ?reportedValue .
                        ?selected qudt:numericValue ?expectedValue .
                        FILTER(?reportedValue != ?expectedValue)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionOutputRestrictionApplies ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:KilowattQuantityValueShape
            ] ;
            sh:property [
                sh:path nltl:restrictedPropulsionOutput ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:KilowattQuantityValueShape
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The engine output P must equal the restricted propulsion output when propulsion output restriction applies." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:maximumContinuousRatingPower ?reported ;
                              nltl:restrictedPropulsionOutput ?selected .
                        ?reported qudt:numericValue ?reportedValue .
                        ?selected qudt:numericValue ?expectedValue .
                        FILTER(?reportedValue != ?expectedValue)
                    }
                """
            ]
        ]
    ) .

gen:KilowattQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
