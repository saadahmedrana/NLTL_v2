@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF023ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship of ice class IB or IC governed by the 1985 rules must provide decimal maximum continuous rating power and required 1985-rules power values in kilowatts." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    FILTER (
        !EXISTS {
            $this nltl:maximumContinuousRatingPower ?mcrQuantity .
            ?mcrQuantity qudt:numericValue ?mcrValue ;
                         qudt:unit unit:KiloW .
            FILTER (datatype(?mcrValue) = xsd:decimal)
        }
        ||
        !EXISTS {
            $this nltl:requiredPowerUnder1985Rules ?requiredQuantity .
            ?requiredQuantity qudt:numericValue ?requiredValue ;
                              qudt:unit unit:KiloW .
            FILTER (datatype(?requiredValue) = xsd:decimal)
        }
    )
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Power values used for compliance with the 1985 ice-class rules must use the kilowatt unit." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          ?powerProperty ?quantity .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    FILTER (?powerProperty IN (
        nltl:maximumContinuousRatingPower,
        nltl:requiredPowerUnder1985Rules
    ))
    ?quantity qudt:unit ?unit .
    FILTER (?unit != unit:KiloW)
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Power values used for compliance with the 1985 ice-class rules must have decimal numeric values." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          ?powerProperty ?quantity .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    FILTER (?powerProperty IN (
        nltl:maximumContinuousRatingPower,
        nltl:requiredPowerUnder1985Rules
    ))
    ?quantity qudt:numericValue ?numericValue .
    FILTER (datatype(?numericValue) != xsd:decimal)
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power under those rules." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceClass ?iceClass ;
          nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
          nltl:maximumContinuousRatingPower ?mcrQuantity ;
          nltl:requiredPowerUnder1985Rules ?requiredQuantity .
    FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
    ?mcrQuantity qudt:numericValue ?mcrValue ;
                 qudt:unit unit:KiloW .
    ?requiredQuantity qudt:numericValue ?requiredValue ;
                      qudt:unit unit:KiloW .
    FILTER (datatype(?mcrValue) = xsd:decimal)
    FILTER (datatype(?requiredValue) = xsd:decimal)
    FILTER (?mcrValue < ?requiredValue)
}
"""
    ] .
