@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MegaPascalQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:verticalLoadPosition ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Each direct analysis case requires a vertical load position in metres."
    ] ;
    sh:property [
        sh:path nltl:horizontalLoadPosition ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Each direct analysis case requires a horizontal load position in metres."
    ] ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Each direct analysis case requires its corresponding load patch length."
    ] ;
    sh:property [
        sh:path nltl:capacityMinimizingLoadPositionConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The direct analysis case must confirm a capacity-minimizing load position."
    ] ;
    sh:property [
        sh:path nltl:combinedBendingAndShearEvaluated ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The direct analysis case must confirm evaluation of combined bending and shear."
    ] .

gen:UndeterminedLoadLengthCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:loadPatchLength ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Each case requires its own load patch length when load length is not determined from the arrangement."
    ] ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:node gen:UnitlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Each case requires its corresponding ice load area factor when load length is not determined from the arrangement."
    ] .

gen:TRF030Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:MegaPascalQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Ice pressure is required as a direct-analysis input."
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:node gen:MetreQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Load patch height is required as a direct-analysis input."
    ] ;
    sh:property [
        sh:path nltl:appliedIcePressure ;
        sh:node gen:MegaPascalQuantityValueShape ;
        sh:minCount 1 ;
        sh:message "The externally determined applied ice pressure is required."
    ] ;
    sh:property [
        sh:path nltl:loadLengthDeterminedFromArrangement ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one load-length determination selector is required."
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:class nltl:directAnalysisCase ;
        sh:node gen:DirectAnalysisCaseShape ;
        sh:minCount 2 ;
        sh:message "At least two direct analysis cases with paired vertical and horizontal positions are required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:loadLengthDeterminedFromArrangement ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasDirectAnalysisCase ;
                sh:node gen:UndeterminedLoadLengthCaseShape
            ]
        ]
    ) .
