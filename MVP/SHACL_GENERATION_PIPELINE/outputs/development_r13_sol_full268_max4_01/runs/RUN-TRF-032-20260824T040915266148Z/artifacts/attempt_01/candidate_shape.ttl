@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF032Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengtheningStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice strengthening status must be recorded unambiguously."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:regulationRequiredScantling ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ]
                ] ;
                sh:message "A regulation-required scantling value is required for a ship that has not been ice strengthened."
            ] ;
            sh:property [
                sh:path nltl:classificationSocietyRequiredScantling ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ]
                ] ;
                sh:message "A classification-society-required scantling value is required for a ship that has not been ice strengthened."
            ] ;
            sh:property [
                sh:path nltl:selectedDesignScantling ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ]
                ] ;
                sh:message "A selected design scantling is required for a ship that has not been ice strengthened."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "Where the regulation-required scantling is less than the classification-society-required scantling, the selected design scantling must be at least the classification-society-required scantling." ;
                sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:iceStrengtheningStatus false ;
          nltl:regulationRequiredScantling ?regulationQuantity ;
          nltl:classificationSocietyRequiredScantling ?classificationQuantity .
    ?regulationQuantity qudt:numericValue ?regulationValue .
    ?classificationQuantity qudt:numericValue ?classificationValue .
    FILTER (
        xsd:decimal(?regulationValue) <
        xsd:decimal(?classificationValue)
    )
    FILTER NOT EXISTS {
        $this nltl:selectedDesignScantling ?selectedQuantity .
        ?selectedQuantity qudt:numericValue ?selectedValue .
        FILTER (
            xsd:decimal(?selectedValue) >=
            xsd:decimal(?classificationValue)
        )
    }
}
"""
            ]
        ]
    ) .
