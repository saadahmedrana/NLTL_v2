@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:KnotQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF040Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Ice class is required to determine the applicable strengthening branch."
    ] ;

    sh:property [
        sh:path nltl:openWaterServiceSpeed ;
        sh:node gen:KnotQuantityShape ;
        sh:minCount 1 ;
        sh:message "Open-water service speed in knots is required to determine upper-bow strengthening applicability."
    ] ;

    sh:property [
        sh:path nltl:designOperationSpeedInIce ;
        sh:node gen:KnotQuantityShape ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:thickness ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;

    sh:property [
        sh:path nltl:bowRegionEquivalent ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path nltl:forefootShellStrengtheningStatus ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path nltl:midbodyEquivalent ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path nltl:upperBowIceBeltStrengtheningStatus ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path nltl:bulwarkStrengthStatus ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path nltl:freeingPortStrengthStatus ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path nltl:sidescuttleInIceBelt ;
        sh:datatype xsd:boolean ;
        sh:in ( false ) ;
        sh:minCount 1 ;
        sh:message "Sidescuttles shall not be situated in the ice belt."
    ] ;

    sh:property [
        sh:path nltl:weatherDeckBelowIceBeltUpperLimit ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The weather-deck position relative to the ice-belt upper limit is required."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIaSuper
            ] ;
            sh:property [
                sh:path nltl:spacing ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:bowRegionEquivalent ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:forefootShellStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "An IA Super ship requires bow-region-equivalent forefoot shell strengthening."
            ]
        ]
    ) ;

    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                )
            ] ;
            sh:property [
                sh:path nltl:openWaterServiceSpeed ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:maxExclusive "18"^^xsd:decimal ;
                        sh:minCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                )
            ] ;
            sh:property [
                sh:path nltl:openWaterServiceSpeed ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "18"^^xsd:decimal ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:shipLength ;
                sh:node gen:MetreQuantityShape ;
                sh:minCount 1 ;
                sh:message "Ship length in metres is required for the applicable upper-bow longitudinal strengthening extent."
            ] ;
            sh:property [
                sh:path nltl:midbodyEquivalent ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:upperBowIceBeltStrengtheningStatus ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "An IA Super or IA ship at 18 knots or more requires midbody-equivalent upper-bow ice-belt strengthening."
            ]
        ]
    ) ;

    sh:or (
        [
            sh:property [
                sh:path nltl:weatherDeckBelowIceBeltUpperLimit ;
                sh:datatype xsd:boolean ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:weatherDeckBelowIceBeltUpperLimit ;
                sh:datatype xsd:boolean ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:bulwarkStrengthStatus ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "Where the weather deck is below the ice-belt upper limit, the bulwark shall meet the ice-belt shell strength requirement."
            ] ;
            sh:property [
                sh:path nltl:freeingPortStrengthStatus ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "Where the weather deck is below the ice-belt upper limit, freeing-port construction shall meet the ice-belt shell strength requirement."
            ]
        ]
    ) .
