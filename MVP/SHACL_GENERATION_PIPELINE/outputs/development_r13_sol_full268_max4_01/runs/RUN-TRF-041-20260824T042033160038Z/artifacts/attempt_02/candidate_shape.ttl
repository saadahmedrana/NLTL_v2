@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF041PlatingReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:platingFramingOrientation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:transverseFramingOrientation
            nltl:longitudinalFramingOrientation
        ) ;
        sh:message "Plating framing orientation must be exactly one of transverse or longitudinal."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node gen:MetreQuantityValueShape ;
        sh:message "Spacing is required in metres."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityValueShape ;
        sh:message "Ice pressure is required in megapascals."
    ] ;
    sh:property [
        sh:path nltl:platingPressure ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityValueShape ;
        sh:message "Plating pressure is required in megapascals."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gen:MegaPascalQuantityValueShape ;
        sh:message "Yield strength is required in megapascals."
    ] ;
    sh:property [
        sh:path nltl:transversePlatingFactorF1 ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape ;
        sh:message "Transverse plating factor f1 is required."
    ] ;
    sh:property [
        sh:path nltl:longitudinalPlatingFactorF2 ;
        sh:minCount 1 ;
        sh:node gen:UnitlessQuantityValueShape ;
        sh:message "Longitudinal plating factor f2 is required."
    ] ;
    sh:property [
        sh:path nltl:corrosionAbrasionAddition ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityValueShape ;
        sh:message "Corrosion and abrasion addition is required in millimetres."
    ] ;
    sh:property [
        sh:path nltl:requiredShellPlatingThickness ;
        sh:minCount 1 ;
        sh:node gen:MillimetreQuantityValueShape ;
        sh:message "The externally calculated required shell plating thickness is required in millimetres."
    ] .

gen:MetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:MegaPascalQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gen:UnitlessQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gen:MillimetreQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .
