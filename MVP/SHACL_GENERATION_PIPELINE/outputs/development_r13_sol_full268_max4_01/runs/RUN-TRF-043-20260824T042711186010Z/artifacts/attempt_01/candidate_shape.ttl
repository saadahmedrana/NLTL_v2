@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF043ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFramingIceStrengtheningTerminationCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:framingIceStrengtheningTerminationCase ;
        sh:node gen:TRF043TerminationCaseShape
    ] .

gen:TRF043TerminationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MilliM
            ]
        ] ;
        sh:message "A termination case must record the extension beyond the adjacent boundary in millimetres."
    ] ;
    sh:property [
        sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:terminationAdjacentBoundary ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:or (
                [ sh:class nltl:deckStructure ]
                [ sh:class nltl:tankBoundaryPlating ]
                [ sh:class nltl:tankTop ]
            )
        ] ;
        sh:message "The adjacent boundary must be a deck structure, tank boundary plating, or tank top."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 250.0
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted ;
                sh:minCount 1 ;
                sh:in ( true )
            ]
        ]
        [
            sh:property [
                sh:path nltl:extensionBeyondAdjacentDeckOrTankBoundary ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minExclusive 250.0
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "For an extension of 250 mm or less, termination at the adjacent boundary must be recorded as permitted." .
