@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF044TransverseFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each transverse frame must have exactly one supported boundary-condition type."
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:bulkCarrierTopWingTankFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "7"^^xsd:decimal ;
                        sh:maxInclusive "7"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:singleDeckTankTopToMainDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "6"^^xsd:decimal ;
                        sh:maxInclusive "6"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:multiDeckOrStringerContinuousFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "5.7"^^xsd:decimal ;
                        sh:maxInclusive "5.7"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:twoDeckFrameCondition
            ] ;
            sh:property [
                sh:path nltl:frameBoundaryConditionFactorM0 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "5"^^xsd:decimal ;
                        sh:maxInclusive "5"^^xsd:decimal
                    ]
                ]
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "The frame calculation has a zero divisor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight/qudt:numericValue ?hValue ;
                      nltl:span/qudt:numericValue ?lValue ;
                      nltl:yieldStrength/qudt:numericValue ?sigmaValue .
                BIND(xsd:decimal(?hValue) AS ?h)
                BIND(xsd:decimal(?lValue) AS ?l)
                BIND(xsd:decimal(?sigmaValue) AS ?sigma)
                FILTER(
                    ?l = 0 ||
                    ?sigma = 0 ||
                    (?l != 0 && (7 - 5 * ?h / ?l) = 0)
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The reported moment factor, section modulus, or required shear area does not match the prescribed calculation within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?pValue ;
                      nltl:spacing/qudt:numericValue ?sValue ;
                      nltl:designIceLoadHeight/qudt:numericValue ?hValue ;
                      nltl:span/qudt:numericValue ?lValue ;
                      nltl:frameBoundaryConditionFactorM0/qudt:numericValue ?m0Value ;
                      nltl:yieldStrength/qudt:numericValue ?sigmaValue ;
                      nltl:frameMomentFactorMt/qudt:numericValue ?reportedMtValue ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZValue ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedAValue .

                BIND(xsd:decimal(?pValue) AS ?p)
                BIND(xsd:decimal(?sValue) AS ?s)
                BIND(xsd:decimal(?hValue) AS ?h)
                BIND(xsd:decimal(?lValue) AS ?l)
                BIND(xsd:decimal(?m0Value) AS ?m0)
                BIND(xsd:decimal(?sigmaValue) AS ?sigma)
                BIND(xsd:decimal(?reportedMtValue) AS ?reportedMt)
                BIND(xsd:decimal(?reportedZValue) AS ?reportedZ)
                BIND(xsd:decimal(?reportedAValue) AS ?reportedA)

                FILTER(?l != 0 && ?sigma != 0)
                BIND((7 - 5 * ?h / ?l) AS ?mtDenominator)
                FILTER(?mtDenominator != 0)

                BIND((7 * ?m0 / ?mtDenominator) AS ?expectedMt)
                FILTER(?expectedMt != 0)
                BIND((?p * ?s * ?h * ?l / (?expectedMt * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 1.2 * ?p * ?h * ?s / (2 * ?sigma) * 10000) AS ?expectedA)

                BIND(IF(ABS(?expectedMt) * 0.000001 > 0.000000001,
                        ABS(?expectedMt) * 0.000001,
                        0.000000001) AS ?mtTolerance)
                BIND(IF(ABS(?expectedZ) * 0.000001 > 0.000000001,
                        ABS(?expectedZ) * 0.000001,
                        0.000000001) AS ?zTolerance)
                BIND(IF(ABS(?expectedA) * 0.000001 > 0.000000001,
                        ABS(?expectedA) * 0.000001,
                        0.000000001) AS ?aTolerance)

                FILTER(
                    ABS(?reportedMt - ?expectedMt) > ?mtTolerance ||
                    ABS(?reportedZ - ?expectedZ) > ?zTolerance ||
                    ABS(?reportedA - ?expectedA) > ?aTolerance
                )
            }
        """
    ] .
