@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MainFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "A main frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:node gen:DirectAttachmentEndShape ;
        sh:message "Each upper end of a main frame must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] .

gen:IntermediateIceFrameUpperEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:class nltl:frameStrengthenedPart ;
        sh:minCount 1 ;
        sh:message "An intermediate ice frame must identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasUpperEnd ;
        sh:class nltl:frameEnd ;
        sh:minCount 1 ;
        sh:or (
            [
                sh:node gen:DirectAttachmentEndShape
            ]
            [
                sh:node gen:QualifiedHorizontalConnectionEndShape
            ]
        ) ;
        sh:message "Each upper end of an intermediate ice frame must use a permitted direct attachment or qualifying horizontal-member connection."
    ] .

gen:DirectAttachmentEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:qualifiedValueShape [
            sh:or (
                [
                    sh:class nltl:deckStructure
                ]
                [
                    sh:class nltl:tankBoundaryPlating
                ]
                [
                    sh:class nltl:iceStringer
                ]
            )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The upper end must be attached to a deck structure, tank boundary plating, or ice stringer."
    ] .

gen:QualifiedHorizontalConnectionEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:property [
        sh:path nltl:hasTerminationAboveSupportingStructure ;
        sh:qualifiedValueShape [
            sh:or (
                [
                    sh:class nltl:deckStructure
                ]
                [
                    sh:class nltl:iceStringer
                ]
            ) ;
            sh:property [
                sh:path nltl:supportingStructureAtOrAboveIceBeltUpperLimit ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The upper end must terminate above a deck or ice stringer recorded at or above the ice-belt upper limit."
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:qualifiedValueShape [
            sh:class nltl:horizontalConnectionMember ;
            sh:property [
                sh:path nltl:connectsToAdjacentMainFrame ;
                sh:class nltl:mainFrame ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The upper end must have a horizontal member connected to an adjacent main frame and having the same scantlings as the main frame."
    ] .
