@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MainFrameLowerEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:mainFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:class nltl:frameStrengthenedPart ;
        sh:message "A main frame shall identify its strengthened part."
    ] ;
    sh:property [
        sh:path nltl:hasLowerEnd ;
        sh:minCount 1 ;
        sh:node gen:AttachedLowerEndShape ;
        sh:message "The lower end of a main frame shall be attached to a permitted supporting structure."
    ] ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The main frame below the lower edge of the ice belt shall be ice strengthened."
    ] .

gen:IntermediateIceFrameLowerEndShape
    a sh:NodeShape ;
    sh:targetClass nltl:intermediateIceFrame ;
    sh:property [
        sh:path nltl:hasStrengthenedPart ;
        sh:minCount 1 ;
        sh:class nltl:frameStrengthenedPart ;
        sh:message "An intermediate ice frame shall identify its strengthened part."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node gen:AttachedLowerEndShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportingStructureAtOrBelowIceBeltLowerLimit ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sameScantlingsAsMainFrame ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerEnd ;
                sh:minCount 1 ;
                sh:node gen:AlternativeConnectedLowerEndShape
            ]
        ]
    ) .

gen:AttachedLowerEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:minCount 1 ;
        sh:node gen:PermittedSupportingStructureShape
    ] .

gen:AlternativeConnectedLowerEndShape
    a sh:NodeShape ;
    sh:class nltl:frameEnd ;
    sh:property [
        sh:path nltl:hasTerminationBelowSupportingStructure ;
        sh:minCount 1 ;
        sh:node gen:PermittedSupportingStructureShape
    ] ;
    sh:property [
        sh:path nltl:hasHorizontalConnectionMember ;
        sh:minCount 1 ;
        sh:class nltl:horizontalConnectionMember ;
        sh:node gen:HorizontalConnectionMemberShape
    ] .

gen:PermittedSupportingStructureShape
    a sh:NodeShape ;
    sh:or (
        [ sh:class nltl:deckStructure ]
        [ sh:class nltl:tankBoundaryPlating ]
        [ sh:class nltl:tankTop ]
        [ sh:class nltl:iceStringer ]
    ) .

gen:HorizontalConnectionMemberShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:connectsToAdjacentMainFrame ;
        sh:minCount 1 ;
        sh:class nltl:mainFrame ;
        sh:node gen:StrengthenedAdjacentMainFrameShape
    ] .

gen:StrengthenedAdjacentMainFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:mainFrameBelowIceBeltStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .
