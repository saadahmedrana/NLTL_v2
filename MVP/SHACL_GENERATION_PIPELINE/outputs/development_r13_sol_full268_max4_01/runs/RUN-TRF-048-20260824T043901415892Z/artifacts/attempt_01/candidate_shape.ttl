@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF048LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A frame boundary-condition type is required."
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "The significantly-different-boundary-conditions selector is required."
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaPA
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM3
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM2
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM2
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM2
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:CentiM2
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "For a continuous beam with brackets and no significantly different boundary conditions, frameMomentFactorM must be 13.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType
                          nltl:continuousBeamWithBracketsFrameCondition ;
                      nltl:significantlyDifferentBoundaryConditions false ;
                      nltl:frameMomentFactorM ?mQuantity .
                ?mQuantity qudt:numericValue ?m .
                FILTER (
                    ?m < xsd:decimal("13.3") ||
                    ?m > xsd:decimal("13.3")
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The reported load-distribution factor, section modulus, required shear area, or bracket-excluded actual shear area does not satisfy clause 4.4.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pQuantity ;
                      nltl:designIceLoadHeight ?hQuantity ;
                      nltl:spacing ?sQuantity ;
                      nltl:span ?lQuantity ;
                      nltl:frameMomentFactorM ?mQuantity ;
                      nltl:yieldStrength ?yieldQuantity ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Quantity ;
                      nltl:sectionModulus ?zQuantity ;
                      nltl:requiredShearArea ?aQuantity ;
                      nltl:grossFrameShearArea ?grossQuantity ;
                      nltl:bracketArea ?bracketQuantity ;
                      nltl:actualFrameShearArea ?actualQuantity .

                ?pQuantity qudt:numericValue ?p .
                ?hQuantity qudt:numericValue ?h .
                ?sQuantity qudt:numericValue ?s .
                ?lQuantity qudt:numericValue ?l .
                ?mQuantity qudt:numericValue ?m .
                ?yieldQuantity qudt:numericValue ?yieldStrength .
                ?f4Quantity qudt:numericValue ?reportedF4 .
                ?zQuantity qudt:numericValue ?reportedZ .
                ?aQuantity qudt:numericValue ?reportedA .
                ?grossQuantity qudt:numericValue ?grossArea .
                ?bracketQuantity qudt:numericValue ?bracketArea .
                ?actualQuantity qudt:numericValue ?actualArea .

                BIND (
                    xsd:decimal("1") -
                    (xsd:decimal("0.2") * ?h / ?s)
                    AS ?expectedF4
                )
                BIND (
                    (
                        ?expectedF4 * ?p * ?h * ?l * ?l
                        /
                        (xsd:decimal("4") * ?m * ?yieldStrength)
                    ) * xsd:decimal("1000000")
                    AS ?expectedZ
                )
                BIND (
                    (
                        xsd:decimal("1.7320508075688772935") *
                        ?expectedF4 *
                        xsd:decimal("2.16") *
                        ?p * ?h * ?l
                        /
                        (xsd:decimal("2") * ?yieldStrength)
                    ) * xsd:decimal("10000")
                    AS ?expectedA
                )
                BIND (?grossArea - ?bracketArea AS ?expectedActualArea)

                BIND (
                    IF (
                        ABS(?expectedF4) * xsd:decimal("0.000001") >
                        xsd:decimal("0.000000001"),
                        ABS(?expectedF4) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?f4Tolerance
                )
                BIND (
                    IF (
                        ABS(?expectedZ) * xsd:decimal("0.000001") >
                        xsd:decimal("0.000000001"),
                        ABS(?expectedZ) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?zTolerance
                )
                BIND (
                    IF (
                        ABS(?expectedA) * xsd:decimal("0.000001") >
                        xsd:decimal("0.000000001"),
                        ABS(?expectedA) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?aTolerance
                )
                BIND (
                    IF (
                        ABS(?expectedActualArea) * xsd:decimal("0.000001") >
                        xsd:decimal("0.000000001"),
                        ABS(?expectedActualArea) * xsd:decimal("0.000001"),
                        xsd:decimal("0.000000001")
                    )
                    AS ?actualAreaTolerance
                )

                FILTER (
                    ?s = xsd:decimal("0") ||
                    ?m = xsd:decimal("0") ||
                    ?yieldStrength = xsd:decimal("0") ||
                    ABS(?reportedF4 - ?expectedF4) > ?f4Tolerance ||
                    ABS(?reportedZ - ?expectedZ) > ?zTolerance ||
                    ABS(?reportedA - ?expectedA) > ?aTolerance ||
                    ABS(?actualArea - ?expectedActualArea) > ?actualAreaTolerance
                )
            }
        """
    ] .
