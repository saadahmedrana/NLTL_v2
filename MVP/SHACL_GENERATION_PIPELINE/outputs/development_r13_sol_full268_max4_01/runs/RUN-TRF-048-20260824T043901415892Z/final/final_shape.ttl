@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:LengthMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureMegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AreaSquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SectionModulusCubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LongitudinalFrameCalculationShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A longitudinal frame must identify one boundary-condition type."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:not [
                    sh:in (
                        nltl:continuousBeamWithBracketsFrameCondition
                    )
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:continuousBeamWithBracketsFrameCondition
            ] ;
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:frameMomentFactorM
                    qudt:numericValue
                ) ;
                sh:minInclusive 13.3 ;
                sh:maxInclusive 13.3 ;
                sh:message "For a continuous beam with brackets without significantly different boundary conditions, m must equal 13.3."
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameBoundaryConditionType ;
                sh:hasValue nltl:continuousBeamWithBracketsFrameCondition
            ] ;
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path (
                    nltl:frameMomentFactorM
                    qudt:numericValue
                ) ;
                sh:maxExclusive 13.3 ;
                sh:message "For significantly different continuous-beam boundary conditions, m must be smaller than 13.3."
            ]
        ]
    ) ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:node gen:PressureMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:node gen:LengthMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:PressureMegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:node gen:DimensionlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:SectionModulusCubicCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:AreaSquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:node gen:AreaSquareCentimetreQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:node gen:AreaSquareCentimetreQuantityShape ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:node gen:AreaSquareCentimetreQuantityShape ;
        sh:maxCount 1
    ] ;

    sh:sparql [
        sh:message "The reported f4, section modulus, or required shear area does not match the prescribed calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                      nltl:designIceLoadHeight/qudt:numericValue ?h ;
                      nltl:spacing/qudt:numericValue ?s ;
                      nltl:span/qudt:numericValue ?l ;
                      nltl:frameMomentFactorM/qudt:numericValue ?m ;
                      nltl:yieldStrength/qudt:numericValue ?yield ;
                      nltl:longitudinalFrameLoadDistributionFactorF4/qudt:numericValue ?reportedF4 ;
                      nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                      nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(IF(?s = 0, 1, ?s) AS ?safeS)
                BIND(IF(?m = 0, 1, ?m) AS ?safeM)
                BIND(IF(?yield = 0, 1, ?yield) AS ?safeYield)

                BIND(1 - (0.2 * ?h / ?safeS) AS ?expectedF4)
                BIND(
                    (?expectedF4 * ?p * ?h * ?l * ?l
                     / (4 * ?safeM * ?safeYield)) * 1000000
                    AS ?expectedZ
                )
                BIND(
                    (1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l
                     / (2 * ?safeYield)) * 10000
                    AS ?expectedA
                )

                BIND(IF(?expectedF4 < 0, -?expectedF4, ?expectedF4) AS ?magnitudeF4)
                BIND(IF(?expectedZ < 0, -?expectedZ, ?expectedZ) AS ?magnitudeZ)
                BIND(IF(?expectedA < 0, -?expectedA, ?expectedA) AS ?magnitudeA)

                BIND(
                    IF(
                        (?magnitudeF4 * 0.000001) > 0.000000001,
                        ?magnitudeF4 * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceF4
                )
                BIND(
                    IF(
                        (?magnitudeZ * 0.000001) > 0.000000001,
                        ?magnitudeZ * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceZ
                )
                BIND(
                    IF(
                        (?magnitudeA * 0.000001) > 0.000000001,
                        ?magnitudeA * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceA
                )

                FILTER (
                    ?s = 0 ||
                    ?m = 0 ||
                    ?yield = 0 ||
                    ?reportedF4 < (?expectedF4 - ?toleranceF4) ||
                    ?reportedF4 > (?expectedF4 + ?toleranceF4) ||
                    ?reportedZ < (?expectedZ - ?toleranceZ) ||
                    ?reportedZ > (?expectedZ + ?toleranceZ) ||
                    ?reportedA < (?expectedA - ?toleranceA) ||
                    ?reportedA > (?expectedA + ?toleranceA)
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Actual frame shear area must equal gross frame shear area minus bracket area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:grossFrameShearArea/qudt:numericValue ?gross ;
                      nltl:bracketArea/qudt:numericValue ?bracket ;
                      nltl:actualFrameShearArea/qudt:numericValue ?actual .

                BIND(?gross - ?bracket AS ?expectedActual)
                BIND(
                    IF(?expectedActual < 0, -?expectedActual, ?expectedActual)
                    AS ?magnitudeActual
                )
                BIND(
                    IF(
                        (?magnitudeActual * 0.000001) > 0.000000001,
                        ?magnitudeActual * 0.000001,
                        0.000000001
                    )
                    AS ?toleranceActual
                )

                FILTER (
                    ?actual < (?expectedActual - ?toleranceActual) ||
                    ?actual > (?expectedActual + ?toleranceActual)
                )
            }
        """
    ] .
