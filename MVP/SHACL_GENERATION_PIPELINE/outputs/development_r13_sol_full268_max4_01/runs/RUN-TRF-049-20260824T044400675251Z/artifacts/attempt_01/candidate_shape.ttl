@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF049FrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:node gen:TRF049IceAreaFrameShape
        ]
    ) .

gen:TRF049IceAreaFrameShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:webPlateConnectionSideCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 2 ;
                sh:message "A frame passing through a supporting structure must have its web plate connected on both sides."
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path (
                    nltl:hasFrameAttachment
                    nltl:hasConnectionBracket
                ) ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gen:TRF049MillimetreQuantityShape ;
                sh:message "Frame web thickness is required when a connection bracket is installed."
            ]
        ]
    ) ;
    sh:property [
        sh:path (
            nltl:hasFrameAttachment
            nltl:hasConnectionBracket
        ) ;
        sh:node gen:TRF049ConnectionBracketShape
    ] ;
    sh:sparql [
        sh:message "Each linked supporting web frame or bulkhead must share an effectively confirmed attachment with the frame." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this ?support
WHERE {
    $this (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        ?attachment a nltl:frameEnd ;
            nltl:hasAttachedSupportingStructure ?support ;
            nltl:effectiveAttachmentConfirmed true .
        ?support nltl:hasSupportingStructureAttachment ?attachment .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "Each supporting web frame or bulkhead of a longitudinal frame must be attached through a connection bracket." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this ?support
WHERE {
    $this a nltl:longitudinalFrame ;
        (nltl:hasSupportingWebFrame|nltl:hasSupportingBulkhead) ?support .
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        ?attachment a nltl:frameEnd ;
            nltl:hasAttachedSupportingStructure ?support ;
            nltl:effectiveAttachmentConfirmed true ;
            nltl:hasConnectionBracket ?bracket .
        ?support nltl:hasSupportingStructureAttachment ?attachment .
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "A transverse frame must state whether it terminates at a deck or ice stringer." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
    $this a nltl:transverseFrame .
    FILTER NOT EXISTS {
        $this nltl:terminatesAtDeckOrIceStringer ?terminates .
        FILTER(
            datatype(?terminates) = <http://www.w3.org/2001/XMLSchema#boolean>
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "The deck or stringer termination selector of a transverse frame must be single-valued." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
    $this a nltl:transverseFrame ;
        nltl:terminatesAtDeckOrIceStringer ?first, ?second .
    FILTER(?first != ?second)
}
"""
    ] ;
    sh:sparql [
        sh:message "A transverse frame terminating at a deck or ice stringer requires a bracket or a similar attachment construction." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>

SELECT $this
WHERE {
    $this a nltl:transverseFrame ;
        nltl:terminatesAtDeckOrIceStringer true .
    FILTER NOT EXISTS {
        $this nltl:hasFrameAttachment ?attachment .
        ?attachment ?means ?evidence .
        FILTER(
            ?means = nltl:hasConnectionBracket ||
            (?means = nltl:similarAttachmentConstructionPresent && ?evidence = true)
        )
    }
}
"""
    ] ;
    sh:sparql [
        sh:message "A connection bracket must be at least as thick as the frame web plate." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT $this ?bracket
WHERE {
    $this nltl:hasFrameAttachment ?attachment ;
        nltl:frameWebThickness ?frameThickness .
    ?attachment nltl:hasConnectionBracket ?bracket .
    ?frameThickness qudt:numericValue ?frameValue .
    ?bracket nltl:bracketThickness ?bracketThickness .
    ?bracketThickness qudt:numericValue ?bracketValue .
    FILTER(?bracketValue < ?frameValue)
}
"""
    ] .

gen:TRF049ConnectionBracketShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF049MillimetreQuantityShape ;
        sh:message "A connection bracket must have one thickness value in millimetres."
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The connection bracket edge must be stiffened."
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The connection bracket must be stiffened against buckling."
    ] .

gen:TRF049MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MilliM
    ] .
