@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MegaPascalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:KiloNewtonPerMetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF054ApplicableIceStringerShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this a nltl:iceStringer ;
                    nltl:locatedOutsideIceBelt true ;
                    nltl:supportsIceStrengthenedFrames true .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:node gs:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:MegaPascalQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:distanceToAdjacentIceStringer ;
        sh:node gs:MetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:node gs:KiloNewtonPerMetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:node gs:UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gs:CubicCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gs:SquareCentimetreQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "The design line load, outside-ice-belt factor, section modulus, and required shear area must match the prescribed formulas within relative tolerance 1e-6 or absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:icePressure/qudt:numericValue ?p ;
                    nltl:designIceLoadHeight/qudt:numericValue ?h ;
                    nltl:stringerSpan/qudt:numericValue ?l ;
                    nltl:frameMomentFactorM/qudt:numericValue ?m ;
                    nltl:yieldStrength/qudt:numericValue ?sigma ;
                    nltl:distanceToIceBelt/qudt:numericValue ?hs ;
                    nltl:distanceToAdjacentIceStringer/qudt:numericValue ?ls ;
                    nltl:designLineLoad/qudt:numericValue ?reportedLineKN ;
                    nltl:outsideIceBeltFactor/qudt:numericValue ?reportedFactor ;
                    nltl:sectionModulus/qudt:numericValue ?reportedZ ;
                    nltl:requiredShearArea/qudt:numericValue ?reportedA .

                BIND(IF((?p * ?h) < 0.15, 0.15, (?p * ?h)) AS ?lineMN)
                BIND((?lineMN * 1000) AS ?expectedLineKN)
                BIND((?m = 0 || ?sigma = 0 || ?ls = 0) AS ?invalidDenominator)
                BIND(IF(?ls = 0, 0, (1 - (?hs / ?ls))) AS ?expectedFactor)
                BIND(
                    IF(
                        ?invalidDenominator,
                        0,
                        (0.80 * 1.8 * ?lineMN * ?l * ?l
                         / (?m * ?sigma)
                         * ?expectedFactor * 1000000)
                    )
                    AS ?expectedZ
                )
                BIND(
                    IF(
                        (?sigma = 0 || ?ls = 0),
                        0,
                        (1.7320508075688772 * 0.80 * 1.8 * 1.2
                         * ?lineMN * ?l
                         / (2 * ?sigma)
                         * ?expectedFactor * 10000)
                    )
                    AS ?expectedA
                )

                BIND(IF(ABS(?expectedLineKN) * 0.000001 > 0.000000001,
                        ABS(?expectedLineKN) * 0.000001,
                        0.000000001) AS ?lineTolerance)
                BIND(IF(ABS(?expectedFactor) * 0.000001 > 0.000000001,
                        ABS(?expectedFactor) * 0.000001,
                        0.000000001) AS ?factorTolerance)
                BIND(IF(ABS(?expectedZ) * 0.000001 > 0.000000001,
                        ABS(?expectedZ) * 0.000001,
                        0.000000001) AS ?zTolerance)
                BIND(IF(ABS(?expectedA) * 0.000001 > 0.000000001,
                        ABS(?expectedA) * 0.000001,
                        0.000000001) AS ?aTolerance)

                FILTER(
                    ?invalidDenominator
                    || ABS(?reportedLineKN - ?expectedLineKN) > ?lineTolerance
                    || ABS(?reportedFactor - ?expectedFactor) > ?factorTolerance
                    || ABS(?reportedZ - ?expectedZ) > ?zTolerance
                    || ABS(?reportedA - ?expectedA) > ?aTolerance
                )
            }
        """
    ] .
