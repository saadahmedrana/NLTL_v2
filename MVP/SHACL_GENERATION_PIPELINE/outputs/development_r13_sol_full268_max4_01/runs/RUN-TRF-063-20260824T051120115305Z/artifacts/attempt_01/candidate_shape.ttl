@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF063ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:minCount 1 ;
                sh:datatype xsd:integer ;
                sh:in (
                    "2"^^xsd:integer
                    "3"^^xsd:integer
                )
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:sidePropellerStrengtheningEnvelope ;
                sh:node gen:TRF063EnvelopeShape ;
                sh:message "Twin and triple screw ships must have a compliant side-propeller strengthening envelope."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:minCount 1 ;
                sh:datatype xsd:integer ;
                sh:maxInclusive "1"^^xsd:integer
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:minCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive "4"^^xsd:integer
            ]
        ]
    ) .

gen:TRF063EnvelopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:strengtheningEnvelopeBoundary ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:tankTop ;
        sh:message "The strengthening envelope boundary must be a tank top."
    ] ;
    sh:property [
        sh:path nltl:strengtheningForwardExtent ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gen:TRF063MinimumExtentQuantityShape ;
        sh:message "The forward strengthening extent must be at least 1.5 metres."
    ] ;
    sh:property [
        sh:path nltl:strengtheningAftExtent ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gen:TRF063MinimumExtentQuantityShape ;
        sh:message "The aft strengthening extent must be at least 1.5 metres."
    ] .

gen:TRF063MinimumExtentQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "1.5"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .
