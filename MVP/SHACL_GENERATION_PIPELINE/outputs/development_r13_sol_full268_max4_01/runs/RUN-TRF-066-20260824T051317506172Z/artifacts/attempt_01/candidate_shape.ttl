@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "The ship's ice class is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                )
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIa
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:hasValue nltl:iceClassIaSuper
                    ]
                ]
            ) ;
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Ice-knife practicability must be stated for an IA or IA Super ship."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:minCount 1 ;
                        sh:node gen:PermittedRudderProtectionShape ;
                        sh:message "A practicable ice knife extending below the lower ice waterline, or equivalent protection, is required."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:minCount 1 ;
                        sh:node gen:EquivalentRudderProtectionShape ;
                        sh:message "Equivalent rudder protection is required when an ice knife is not practicable."
                    ]
                ]
            )
        ]
    ) .

gen:PermittedRudderProtectionShape
    a sh:NodeShape ;
    sh:class nltl:rudderProtectionArrangement ;
    sh:or (
        [
            sh:class nltl:iceKnife ;
            sh:property [
                sh:path nltl:extendsBelowLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ice knife must extend below the lower ice waterline."
            ]
        ]
        [
            sh:class nltl:equivalentRudderProtectionMeans
        ]
    ) .

gen:EquivalentRudderProtectionShape
    a sh:NodeShape ;
    sh:class nltl:rudderProtectionArrangement ;
    sh:class nltl:equivalentRudderProtectionMeans .
