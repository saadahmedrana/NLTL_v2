@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:in (
                    nltl:iceClassIa
                    nltl:iceClassIaSuper
                ) ;
                sh:message "The applicable ice class must be IA or IA Super."
            ] ;
            sh:property [
                sh:path nltl:lowerIceWaterline ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The lower ice waterline is required for an IA or IA Super ship."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:in ( true ) ;
                        sh:message "Ice-knife practicability must be recorded for an IA or IA Super ship."
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [
                            sh:or (
                                [
                                    sh:class nltl:iceKnife ;
                                    sh:property [
                                        sh:path nltl:extendsBelowLowerIceWaterline ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:in ( true ) ;
                                        sh:message "The ice knife must extend below the lower ice waterline."
                                    ]
                                ]
                                [
                                    sh:class nltl:equivalentRudderProtectionMeans
                                ]
                            )
                        ] ;
                        sh:message "A practicable ice knife extending below the lower ice waterline, or equivalent rudder protection means, is required."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:iceKnifePracticable ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:in ( false ) ;
                        sh:message "Ice-knife practicability must be recorded for an IA or IA Super ship."
                    ] ;
                    sh:property [
                        sh:path nltl:hasRudderProtectionArrangement ;
                        sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [
                            sh:class nltl:equivalentRudderProtectionMeans
                        ] ;
                        sh:message "Equivalent rudder protection means are required when an ice knife is not practicable."
                    ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:minCount 1 ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
                sh:message "The non-applicable ice class must be IB, IC, II, or III."
            ]
        ]
    ) .
