@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:and (
                [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:iceClass ;
                                sh:hasValue nltl:iceClassIa
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:iceClass ;
                                sh:hasValue nltl:iceClassIaSuper
                            ]
                        ]
                    )
                ]
                [
                    sh:property [
                        sh:path nltl:lowerIceWaterline ;
                        sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:message "The lower ice waterline is required for an IA or IA Super ship."
                    ]
                ]
                [
                    sh:or (
                        [
                            sh:and (
                                [
                                    sh:property [
                                        sh:path nltl:iceKnifePracticable ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:hasValue true
                                    ]
                                ]
                                [
                                    sh:or (
                                        [ sh:node gen:TRF066IceKnifeProtectionShape ]
                                        [ sh:node gen:TRF066EquivalentProtectionShape ]
                                    )
                                ]
                            )
                        ]
                        [
                            sh:and (
                                [
                                    sh:property [
                                        sh:path nltl:iceKnifePracticable ;
                                        sh:datatype xsd:boolean ;
                                        sh:minCount 1 ;
                                        sh:hasValue false
                                    ]
                                ]
                                [ sh:node gen:TRF066EquivalentProtectionShape ]
                            )
                        ]
                    )
                ]
            )
        ]
        [
            sh:not [
                sh:or (
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIa
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:iceClass ;
                            sh:hasValue nltl:iceClassIaSuper
                        ]
                    ]
                )
            ]
        ]
    ) .

gen:TRF066IceKnifeProtectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:qualifiedValueShape [
            sh:class nltl:iceKnife ;
            sh:property [
                sh:path nltl:extendsBelowLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The ice knife must extend below the lower ice waterline."
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An ice knife extending below the lower ice waterline is required."
    ] .

gen:TRF066EquivalentProtectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRudderProtectionArrangement ;
        sh:qualifiedValueShape [
            sh:class nltl:equivalentRudderProtectionMeans
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "An equivalent rudder protection means is required when an ice knife is not used."
    ] .
