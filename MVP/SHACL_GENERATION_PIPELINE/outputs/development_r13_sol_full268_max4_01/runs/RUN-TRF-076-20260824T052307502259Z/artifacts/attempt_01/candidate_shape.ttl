@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF076ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one propeller type is required to determine applicability."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "CP and FP propellers must cover propeller blade load cases 1 through 4." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType .
                FILTER(?propellerType IN ("CP", "FP"))
                FILTER NOT EXISTS {
                    $this nltl:hasPropellerBladeLoadCase ?case1 .
                    ?case1 nltl:propellerBladeLoadCaseNumber ?number1 .
                    FILTER(?number1 = 1)

                    $this nltl:hasPropellerBladeLoadCase ?case2 .
                    ?case2 nltl:propellerBladeLoadCaseNumber ?number2 .
                    FILTER(?number2 = 2)

                    $this nltl:hasPropellerBladeLoadCase ?case3 .
                    ?case3 nltl:propellerBladeLoadCaseNumber ?number3 .
                    FILTER(?number3 = 3)

                    $this nltl:hasPropellerBladeLoadCase ?case4 .
                    ?case4 nltl:propellerBladeLoadCaseNumber ?number4 .
                    FILTER(?number4 = 4)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An FP propeller must have one consistent boolean reversing-capability value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "FP" .
                FILTER(
                    NOT EXISTS {
                        $this nltl:propellerReversingCapability ?reversing .
                        FILTER(datatype(?reversing) = xsd:boolean)
                    }
                    ||
                    EXISTS {
                        $this nltl:propellerReversingCapability ?invalidReversing .
                        FILTER(datatype(?invalidReversing) != xsd:boolean)
                    }
                    ||
                    (
                        EXISTS {
                            $this nltl:propellerReversingCapability true .
                        }
                        &&
                        EXISTS {
                            $this nltl:propellerReversingCapability false .
                        }
                    )
                )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A reversing FP propeller must also cover propeller blade load case 5." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType "FP" ;
                      nltl:propellerReversingCapability true .
                FILTER NOT EXISTS {
                    $this nltl:hasPropellerBladeLoadCase ?case5 .
                    ?case5 nltl:propellerBladeLoadCaseNumber ?number5 .
                    FILTER(?number5 = 5)
                }
            }
        """
    ] .

gen:TRF076PropellerBladeLoadCaseShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasPropellerBladeLoadCase ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "Each represented propeller blade load case must have an integer load case number."
    ] .
