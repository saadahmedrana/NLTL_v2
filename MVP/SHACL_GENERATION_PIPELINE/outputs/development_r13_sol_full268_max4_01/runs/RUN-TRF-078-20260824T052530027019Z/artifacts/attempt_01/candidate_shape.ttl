@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:IceClassTableLookupShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash6 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedIceClassCycleCount ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] .

gs:PropellerLocationTableLookupShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash7 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableLookupPropellerLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedPropellerLocationFactor ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] .

gs:TRF078Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gs:IceClassTableLookupShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-6 lookup case with an ice-class key and selected cycle count is required."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape gs:PropellerLocationTableLookupShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A Table 6-7 lookup case with a propeller-location key and selected location factor is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:node gs:UnitlessDecimalQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1 * k2 * k3 * N_class * n_n within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Quantity ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnQuantity ;
                      nltl:iceLoadCycleCount ?nice .

                ?classCase a nltl:tableLookupCase ;
                           nltl:tableReference nltl:traficomTable6Dash6 ;
                           nltl:iceClass ?iceClass ;
                           nltl:selectedIceClassCycleCount ?nClassQuantity .
                ?iceClass a nltl:iceClassValue .

                ?locationCase a nltl:tableLookupCase ;
                              nltl:tableReference nltl:traficomTable6Dash7 ;
                              nltl:tableLookupPropellerLocation ?location ;
                              nltl:selectedPropellerLocationFactor ?k1Quantity .
                ?location a nltl:propellerLocationValue .

                ?k1Quantity qudt:numericValue ?k1 ;
                            qudt:unit unit:UNITLESS .
                ?k2Quantity qudt:numericValue ?k2 ;
                            qudt:unit unit:UNITLESS .
                ?k3Quantity qudt:numericValue ?k3 ;
                            qudt:unit unit:UNITLESS .
                ?nClassQuantity qudt:numericValue ?nClass ;
                                qudt:unit unit:UNITLESS .
                ?nnQuantity qudt:numericValue ?nn ;
                            qudt:unit unit:UNITLESS .

                FILTER (
                    datatype(?k1) = xsd:decimal &&
                    datatype(?k2) = xsd:decimal &&
                    datatype(?k3) = xsd:decimal &&
                    datatype(?nClass) = xsd:decimal &&
                    datatype(?nn) = xsd:decimal &&
                    datatype(?nice) = xsd:integer
                )

                BIND((?k1 * ?k2 * ?k3 * ?nClass * ?nn) AS ?expected)
                BIND(
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001
                    )
                    AS ?tolerance
                )
                FILTER(ABS(xsd:decimal(?nice) - ?expected) > ?tolerance)
            }
        """
    ] .
