@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF079SubmersionFactorShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Design ice thickness must be provided as one decimal quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Propeller diameter must be provided as one decimal quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:propellerShaftCentrelineDepth ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape ;
        sh:message "Propeller shaft centreline depth must be provided as one decimal quantity in metres."
    ] ;
    sh:property [
        sh:path nltl:propellerImmersionFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Propeller immersion function must be provided as one decimal unitless quantity."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape ;
        sh:message "Ice load cycle coefficient k2 must be provided as one decimal unitless quantity."
    ] ;
    sh:sparql [
        sh:message "The immersion function and coefficient k2 must satisfy equations 6.16 and 6.15; propeller diameter must be non-zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designIceThickness ?iceNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:propellerShaftCentrelineDepth ?depthNode ;
                      nltl:propellerImmersionFunction ?functionNode ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node .
                ?iceNode qudt:numericValue ?ice .
                ?diameterNode qudt:numericValue ?diameter .
                ?depthNode qudt:numericValue ?depth .
                ?functionNode qudt:numericValue ?reportedF .
                ?k2Node qudt:numericValue ?reportedK2 .

                BIND(
                    IF(
                        ?diameter = "0"^^xsd:decimal,
                        "0"^^xsd:decimal,
                        ((?depth - ?ice) / (?diameter / "2"^^xsd:decimal)) - "1"^^xsd:decimal
                    )
                    AS ?expectedF
                )
                BIND(
                    IF(
                        ?expectedF < "0"^^xsd:decimal,
                        "0.8"^^xsd:decimal - ?expectedF,
                        IF(
                            ?expectedF <= "1"^^xsd:decimal,
                            "0.8"^^xsd:decimal - ("0.4"^^xsd:decimal * ?expectedF),
                            IF(
                                ?expectedF <= "2.5"^^xsd:decimal,
                                "0.6"^^xsd:decimal - ("0.2"^^xsd:decimal * ?expectedF),
                                "0.1"^^xsd:decimal
                            )
                        )
                    )
                    AS ?expectedK2
                )
                BIND(
                    IF(
                        ABS(?expectedF) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
                        ABS(?expectedF) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?fTolerance
                )
                BIND(
                    IF(
                        ABS(?expectedK2) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
                        ABS(?expectedK2) * "0.000001"^^xsd:decimal,
                        "0.000000001"^^xsd:decimal
                    )
                    AS ?k2Tolerance
                )
                FILTER(
                    ?diameter = "0"^^xsd:decimal ||
                    ABS(?reportedF - ?expectedF) > ?fTolerance ||
                    ABS(?reportedK2 - ?expectedK2) > ?k2Tolerance
                )
            }
        """
    ] .
