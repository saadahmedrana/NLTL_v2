@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF085ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF085KnownSpeedShape
        gen:TRF085UnknownSpeedShape
    ) .

gen:TRF085KnownSpeedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardPropellerSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The known-speed alternative requires bollardPropellerSpeedKnown to be true."
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF085PropellerSpeedValueShape ;
        sh:message "The known bollard propeller speed at maximum continuous rating is required."
    ] .

gen:TRF085UnknownSpeedShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bollardPropellerSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The Table 6-9 alternative requires bollardPropellerSpeedKnown to be false."
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF085PropellerDiameterValueShape ;
        sh:message "Propeller diameter is required for the Table 6-9 lookup."
    ] ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF085PropellerSpeedValueShape ;
        sh:message "The propeller speed selected from Table 6-9 is required."
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:class nltl:tableLookupCase ;
        sh:node gen:TRF085TableLookupCaseShape ;
        sh:message "A Table 6-9 lookup case is required when bollard propeller speed is not known."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each Table 6-9 case must use the ship's propeller diameter and return its reported bollard propeller speed." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:bollardPropellerSpeedKnown false ;
          nltl:propellerDiameter ?diameter ;
          nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ?speed ;
          nltl:hasTableLookupCase ?case .
    ?diameter qudt:numericValue ?diameterValue .
    ?speed qudt:numericValue ?speedValue .
    ?case nltl:lookupInputQuantity ?lookupInput ;
          nltl:lookupResultQuantity ?lookupResult .
    ?lookupInput qudt:numericValue ?lookupDiameterValue .
    ?lookupResult qudt:numericValue ?lookupSpeedValue .
    FILTER (
        ?diameterValue != ?lookupDiameterValue ||
        ?speedValue != ?lookupSpeedValue
    )
}
"""
    ] .

gen:TRF085TableLookupCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Table 6-9 lookup case must record that the lookup was applied."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:in ( nltl:traficomTable6Dash9 ) ;
        sh:message "The lookup case must reference TRAFICOM Table 6-9."
    ] ;
    sh:property [
        sh:path nltl:lookupInputQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF085LookupQuantityShape ;
        sh:message "The Table 6-9 lookup input quantity is required."
    ] ;
    sh:property [
        sh:path nltl:lookupResultQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF085LookupQuantityShape ;
        sh:message "The Table 6-9 lookup result quantity is required."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Evidence supporting the Table 6-9 selection is required."
    ] .

gen:TRF085PropellerDiameterValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:TRF085PropellerSpeedValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:REV-PER-MIN
    ] .

gen:TRF085LookupQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
