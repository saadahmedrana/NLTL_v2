@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PitchQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller pitch quantity must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propeller pitch quantity must use metres."
    ] .

gen:PropellerPitchAtMcrShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Propeller type is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "This branch applies only when the propeller type is not CP." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType ?propellerType .
                        FILTER(?propellerType = "CP"^^xsd:string)
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "CP"^^xsd:string
            ] ;
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A CP propeller must state whether its bollard-condition pitch is known."
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrBollard ;
                sh:node gen:PitchQuantityShape ;
                sh:minCount 1 ;
                sh:message "A known CP propeller pitch at MCR in bollard condition is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerType ;
                sh:hasValue "CP"^^xsd:string
            ] ;
            sh:property [
                sh:path nltl:pitchValueKnown ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A CP propeller must state whether its bollard-condition pitch is known."
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrFreeRunning ;
                sh:node gen:PitchQuantityShape ;
                sh:minCount 1 ;
                sh:message "Free-running propeller pitch at MCR is required when the bollard-condition pitch is not known."
            ] ;
            sh:property [
                sh:path nltl:propellerPitchAtMcrBollard ;
                sh:node gen:PitchQuantityShape ;
                sh:minCount 1 ;
                sh:message "Calculated bollard-condition propeller pitch at MCR is required."
            ] ;
            sh:sparql [
                a sh:SPARQLConstraint ;
                sh:message "The bollard-condition pitch must equal 0.7 times the free-running pitch within the numerical tolerance." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerPitchAtMcrFreeRunning ?freePitch ;
                              nltl:propellerPitchAtMcrBollard ?bollardPitch .
                        ?freePitch qudt:numericValue ?freeValue .
                        ?bollardPitch qudt:numericValue ?bollardValue .
                        BIND(
                            xsd:decimal(?freeValue) * "0.7"^^xsd:decimal
                            AS ?expected
                        )
                        BIND(
                            IF(
                                ABS(?expected) > "0.000001"^^xsd:decimal,
                                ABS(?expected) * "0.000001"^^xsd:decimal,
                                "0.000000000001"^^xsd:decimal
                            )
                            AS ?tolerance
                        )
                        FILTER(
                            ABS(xsd:decimal(?bollardValue) - ?expected) > ?tolerance
                        )
                    }
                """
            ]
        ]
    ) ;
    sh:message "A CP propeller must provide either its known bollard-condition pitch or the required calculated pitch." .
