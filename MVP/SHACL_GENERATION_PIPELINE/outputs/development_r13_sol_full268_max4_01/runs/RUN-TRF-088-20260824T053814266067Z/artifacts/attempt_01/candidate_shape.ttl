@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:TRF088Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque knowledge status must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:maximumEngineTorqueKnown ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:maximumEngineTorqueKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:maximumEngineTorque ;
                sh:minCount 1 ;
                sh:node g:TRF088MaximumEngineTorqueValueShape ;
                sh:message "When maximum engine torque is unknown, an assigned maximum engine torque value is required."
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:qualifiedValueShape g:TRF088Table6Dash10LookupCaseShape ;
                sh:qualifiedMinCount 1 ;
                sh:message "When maximum engine torque is unknown, a completed Table 6-10 lookup case is required."
            ]
        ]
    ) .

g:TRF088MaximumEngineTorqueValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

g:TRF088Table6Dash10LookupCaseShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash10 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] .
