@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:node gen:TRF091IceMillingSequenceCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify an ice-milling load-sequence case."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each ice-milling sequence case must also be a propulsion load case of the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?case
            WHERE {
                $this nltl:hasIceMillingSequenceCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasPropulsionLoadCase ?case .
                }
            }
        """
    ] .

gen:TRF091IceMillingSequenceCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:loadCasePurpose ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose ;
        sh:message "The ice-milling load sequence must be used for propulsion-line strength evaluation."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The ice-milling load sequence must not be designated for stalling analysis." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:loadCasePurpose nltl:stallingAnalysisPurposeValue .
            }
        """
    ] .
