@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF111ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extremeIceForce ;
        sh:minCount 1 ;
        sh:node gs:ExtremeIceForceValueShape ;
        sh:message "Extreme ice force input is required."
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:node gs:PropellerShaftLineComponentShape ;
        sh:message "A propeller shaft-line component with a compliant fatigue safety factor is required."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:class nltl:loadCase ;
        sh:node gs:PropulsionLoadCaseShape ;
        sh:message "Each propulsion load case must represent a permitted shaft-line load-case type and satisfy its applicable direct checks."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape gs:ExtremeOperationalLoadCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "An extreme operational load case with a yield safety factor of at least 1.3 is required."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape gs:FatigueLoadCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A fatigue load case is required."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape gs:BladeFailureLoadCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A blade-failure load case with a yield safety factor of at least 1.0 is required."
    ] .

gs:ExtremeIceForceValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PropellerShaftLineComponentShape
    a sh:NodeShape ;
    sh:class nltl:propellerShaftLineComponent ;
    sh:property [
        sh:path nltl:fatigueSafetyFactor ;
        sh:minCount 1 ;
        sh:node gs:FatigueSafetyFactorValueShape ;
        sh:message "The component fatigue safety factor must be at least 1.5."
    ] .

gs:FatigueSafetyFactorValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.5 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:YieldSafetyFactorAtLeast1_3ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:YieldSafetyFactorAtLeast1_0ValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ExtremeOperationalLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:class nltl:shaftLineLoadCaseTypeValue ;
        sh:hasValue nltl:extremeOperationalLoadCase ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gs:YieldSafetyFactorAtLeast1_3ValueShape
    ] .

gs:FatigueLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:class nltl:shaftLineLoadCaseTypeValue ;
        sh:hasValue nltl:fatigueLoadCase ;
        sh:minCount 1
    ] .

gs:BladeFailureLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:class nltl:shaftLineLoadCaseTypeValue ;
        sh:hasValue nltl:bladeFailureLoadCase ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gs:YieldSafetyFactorAtLeast1_0ValueShape
    ] .

gs:PropulsionLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:or (
        gs:ExtremeOperationalLoadCaseShape
        gs:FatigueLoadCaseShape
        gs:BladeFailureLoadCaseShape
    ) .
