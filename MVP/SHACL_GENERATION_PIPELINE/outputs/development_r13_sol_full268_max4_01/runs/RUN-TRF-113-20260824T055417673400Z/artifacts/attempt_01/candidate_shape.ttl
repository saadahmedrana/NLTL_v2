@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF113Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Thruster blade-loss design evidence is required."
    ] ;
    sh:property [
        sh:path [
            sh:alternativePath (
                nltl:hasLoadCase
                nltl:hasPropulsionLoadCase
            )
        ] ;
        sh:minCount 1 ;
        sh:class nltl:loadCase ;
        sh:node [
            sh:property [
                sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "The load case must confirm the blade orientation causing the maximum component load."
            ]
        ] ;
        sh:message "A load case addressing the maximum-load blade orientation is required."
    ] .
