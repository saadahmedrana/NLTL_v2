@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:TRF118ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterExtremeLoad ;
        sh:minCount 1 ;
        sh:node shape:ForceQuantityShape ;
        sh:message "Thruster extreme load input is required."
    ] ;
    sh:property [
        sh:path nltl:yieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node shape:DimensionlessQuantityShape ;
        sh:message "Yield safety factor input is required."
    ] ;
    sh:property [
        sh:path nltl:nominalVonMisesStress ;
        sh:minCount 1 ;
        sh:node shape:StressQuantityShape ;
        sh:message "Nominal von Mises stress input is required."
    ] ;
    sh:property [
        sh:path nltl:localStressConcentration ;
        sh:minCount 1 ;
        sh:node shape:DimensionlessQuantityShape ;
        sh:message "Local stress concentration input is required."
    ] ;
    sh:property [
        sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ;
        sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
        sh:minCount 1 ;
        sh:node shape:TRF118AssessmentShape ;
        sh:message "A factored extreme-load operability assessment is required."
    ] .

shape:TRF118AssessmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assessedThrusterComponent ;
        sh:class nltl:shipComponent ;
        sh:minCount 1 ;
        sh:node shape:TRF118AssessedComponentShape ;
        sh:message "The assessed thruster component is required."
    ] ;
    sh:property [
        sh:path nltl:assessedFactoredExtremeLoad ;
        sh:minCount 1 ;
        sh:node shape:ForceQuantityShape ;
        sh:message "The assessed factored extreme load result is required."
    ] ;
    sh:property [
        sh:path nltl:assessmentOperabilityMaintained ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assessment must confirm that operability is maintained."
    ] ;
    sh:property [
        sh:path nltl:assessmentRepairRequired ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The assessment must confirm that repair is not required."
    ] .

shape:TRF118AssessedComponentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:class nltl:materialProperties ;
        sh:minCount 1 ;
        sh:node shape:TRF118MaterialPropertiesShape ;
        sh:message "Material properties are required for the assessed component."
    ] .

shape:TRF118MaterialPropertiesShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:node shape:StressQuantityShape ;
        sh:message "Component material yield strength input is required."
    ] .

shape:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

shape:StressQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

shape:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
