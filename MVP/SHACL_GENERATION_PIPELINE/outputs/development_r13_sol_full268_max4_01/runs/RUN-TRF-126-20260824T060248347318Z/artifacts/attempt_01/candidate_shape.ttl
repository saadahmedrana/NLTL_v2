@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF126AirReceiverStartCapacityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:message "The air receiver shall support at least 12 consecutive starts when the propulsion engine is reversed for astern, and at least 6 otherwise." ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 12 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minInclusive 6 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
