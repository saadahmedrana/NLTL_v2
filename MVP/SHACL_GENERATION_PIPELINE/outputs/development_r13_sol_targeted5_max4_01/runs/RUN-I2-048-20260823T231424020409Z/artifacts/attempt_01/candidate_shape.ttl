@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_048_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasSteelGradeRequirementCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarClassValue ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                ) ;
                sh:message "A ship with a represented steel-grade requirement case must identify its Polar Class."
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:hasSteelGradeRequirementCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeRequirementCase ;
        sh:node gen:I2_048_SteelGradeRequirementCaseShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The required Table 8 grade is missing or incorrect, or the actual grade ranks below the required grade within its steel-strength category." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this ?case
WHERE {
    $this nltl:hasSteelGradeRequirementCase ?case ;
          nltl:polarClass ?pc .

    ?case nltl:asBuiltPlateThickness ?thickness ;
          nltl:steelMaterialClass ?materialClass ;
          nltl:steelStrengthCategory ?strengthCategory ;
          nltl:actualHullStructuralSteelGrade ?actualGrade .

    ?thickness qudt:numericValue ?thicknessValueRaw ;
               qudt:unit <http://qudt.org/vocab/unit/MilliM> .

    ?actualGrade nltl:steelGradeOrderRank ?actualRank .

    OPTIONAL {
        ?case nltl:requiredHullStructuralSteelGrade ?requiredGrade .
        ?requiredGrade nltl:steelGradeOrderRank ?requiredRank .
    }

    BIND(xsd:decimal(?thicknessValueRaw) AS ?thicknessValue)

    BIND(
        IF(
            ?materialClass = nltl:steelMaterialClassOne &&
            ?pc IN (
                nltl:polarClassPc1,
                nltl:polarClassPc2,
                nltl:polarClassPc3,
                nltl:polarClassPc4,
                nltl:polarClassPc5
            ),
            IF(
                ?thicknessValue <= 15,
                1,
                IF(
                    ?thicknessValue <= 40,
                    2,
                    IF(?thicknessValue <= 50, 3, 0)
                )
            ),
            IF(
                ?materialClass = nltl:steelMaterialClassOne &&
                ?pc IN (
                    nltl:polarClassPc6,
                    nltl:polarClassPc7
                ),
                IF(
                    ?thicknessValue <= 35,
                    1,
                    IF(?thicknessValue <= 50, 2, 0)
                ),
                IF(
                    ?materialClass = nltl:steelMaterialClassTwo &&
                    ?pc IN (
                        nltl:polarClassPc1,
                        nltl:polarClassPc2,
                        nltl:polarClassPc3,
                        nltl:polarClassPc4,
                        nltl:polarClassPc5
                    ),
                    IF(
                        ?thicknessValue <= 10,
                        1,
                        IF(
                            ?thicknessValue <= 25,
                            2,
                            IF(?thicknessValue <= 50, 3, 0)
                        )
                    ),
                    IF(
                        ?materialClass = nltl:steelMaterialClassTwo &&
                        ?pc IN (
                            nltl:polarClassPc6,
                            nltl:polarClassPc7
                        ),
                        IF(
                            ?thicknessValue <= 25,
                            1,
                            IF(?thicknessValue <= 50, 2, 0)
                        ),
                        IF(
                            ?materialClass = nltl:steelMaterialClassThree &&
                            ?pc IN (
                                nltl:polarClassPc1,
                                nltl:polarClassPc2,
                                nltl:polarClassPc3
                            ),
                            IF(
                                ?thicknessValue <= 35,
                                3,
                                IF(
                                    ?thicknessValue <= 50 &&
                                    ?strengthCategory = nltl:highTensileSteelCategory,
                                    4,
                                    0
                                )
                            ),
                            IF(
                                ?materialClass = nltl:steelMaterialClassThree &&
                                ?pc IN (
                                    nltl:polarClassPc4,
                                    nltl:polarClassPc5
                                ),
                                IF(
                                    ?thicknessValue <= 45,
                                    3,
                                    IF(
                                        ?thicknessValue <= 50 &&
                                        ?strengthCategory = nltl:highTensileSteelCategory,
                                        4,
                                        0
                                    )
                                ),
                                IF(
                                    ?materialClass = nltl:steelMaterialClassThree &&
                                    ?pc IN (
                                        nltl:polarClassPc6,
                                        nltl:polarClassPc7
                                    ),
                                    IF(
                                        ?thicknessValue <= 10,
                                        1,
                                        IF(
                                            ?thicknessValue <= 25,
                                            2,
                                            IF(?thicknessValue <= 50, 3, 0)
                                        )
                                    ),
                                    0
                                )
                            )
                        )
                    )
                )
            )
        )
        AS ?tableRank
    )

    BIND(
        IF(
            ?strengthCategory = nltl:normalStrengthSteelCategory,
            IF(
                ?tableRank = 1,
                nltl:steelGradeB,
                IF(
                    ?tableRank = 2,
                    nltl:steelGradeD,
                    IF(
                        ?tableRank = 3,
                        nltl:steelGradeE,
                        nltl:iacsUrI2Table8
                    )
                )
            ),
            IF(
                ?strengthCategory = nltl:highTensileSteelCategory,
                IF(
                    ?tableRank = 1,
                    nltl:steelGradeAh,
                    IF(
                        ?tableRank = 2,
                        nltl:steelGradeDh,
                        IF(
                            ?tableRank = 3,
                            nltl:steelGradeEh,
                            IF(
                                ?tableRank = 4,
                                nltl:steelGradeFh,
                                nltl:iacsUrI2Table8
                            )
                        )
                    )
                ),
                nltl:iacsUrI2Table8
            )
        )
        AS ?expectedGrade
    )

    FILTER(
        ?tableRank > 0 &&
        (
            !BOUND(?requiredGrade) ||
            ?requiredGrade != ?expectedGrade ||
            !BOUND(?requiredRank) ||
            ?actualRank < ?requiredRank
        )
    )
}
"""
    ] .

gen:I2_048_SteelGradeRequirementCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:steelGradeRequirementCasePlating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:plating ;
        sh:message "Each steel-grade requirement case must identify exactly one assessed plating."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue nltl:iacsUrI2Table8 ;
        sh:message "The steel-grade requirement case must reference IACS UR I2 Table 8."
    ] ;
    sh:property [
        sh:path nltl:asBuiltPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_048_ThicknessShape ;
        sh:message "Each steel-grade requirement case must provide exactly one as-built plate thickness in millimetres."
    ] ;
    sh:property [
        sh:path nltl:steelMaterialClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelMaterialClassValue ;
        sh:in (
            nltl:steelMaterialClassOne
            nltl:steelMaterialClassTwo
            nltl:steelMaterialClassThree
        ) ;
        sh:message "Each steel-grade requirement case must identify one permitted steel material class."
    ] ;
    sh:property [
        sh:path nltl:steelStrengthCategory ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelStrengthCategoryValue ;
        sh:in (
            nltl:normalStrengthSteelCategory
            nltl:highTensileSteelCategory
        ) ;
        sh:message "Each steel-grade requirement case must identify one permitted steel-strength category."
    ] ;
    sh:property [
        sh:path nltl:actualHullStructuralSteelGrade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:node gen:I2_048_Table8GradeShape ;
        sh:message "Each steel-grade requirement case must identify exactly one actual Table 8 steel grade."
    ] ;
    sh:property [
        sh:path nltl:requiredHullStructuralSteelGrade ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:steelGradeValue ;
        sh:node gen:I2_048_Table8GradeShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:steelStrengthCategory ;
                sh:hasValue nltl:normalStrengthSteelCategory
            ] ;
            sh:property [
                sh:path nltl:actualHullStructuralSteelGrade ;
                sh:in (
                    nltl:steelGradeB
                    nltl:steelGradeD
                    nltl:steelGradeE
                )
            ] ;
            sh:property [
                sh:path nltl:requiredHullStructuralSteelGrade ;
                sh:in (
                    nltl:steelGradeB
                    nltl:steelGradeD
                    nltl:steelGradeE
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:steelStrengthCategory ;
                sh:hasValue nltl:highTensileSteelCategory
            ] ;
            sh:property [
                sh:path nltl:actualHullStructuralSteelGrade ;
                sh:in (
                    nltl:steelGradeAh
                    nltl:steelGradeDh
                    nltl:steelGradeEh
                    nltl:steelGradeFh
                )
            ] ;
            sh:property [
                sh:path nltl:requiredHullStructuralSteelGrade ;
                sh:in (
                    nltl:steelGradeAh
                    nltl:steelGradeDh
                    nltl:steelGradeEh
                    nltl:steelGradeFh
                )
            ]
        ]
    ) .

gen:I2_048_ThicknessShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue unit:MilliM
    ] .

gen:I2_048_Table8GradeShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:in (nltl:steelGradeB) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:maxInclusive 1
            ]
        ]
        [
            sh:in (nltl:steelGradeD) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ]
        ]
        [
            sh:in (nltl:steelGradeE) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 3 ;
                sh:maxInclusive 3
            ]
        ]
        [
            sh:in (nltl:steelGradeAh) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 1 ;
                sh:maxInclusive 1
            ]
        ]
        [
            sh:in (nltl:steelGradeDh) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ]
        ]
        [
            sh:in (nltl:steelGradeEh) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 3 ;
                sh:maxInclusive 3
            ]
        ]
        [
            sh:in (nltl:steelGradeFh) ;
            sh:property [
                sh:path nltl:steelGradeOrderRank ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:datatype xsd:integer ;
                sh:minInclusive 4 ;
                sh:maxInclusive 4
            ]
        ]
    ) .
