@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO032ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO032CategoryAOrBShape
        gen:IMO032IceStrengthenedCategoryCShape
        gen:IMO032NonIceStrengthenedCategoryCShape
    ) .

gen:IMO032CategoryAOrBShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        )
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:class nltl:approvalRecord ;
        sh:node gen:IMO032CategoryAOrBApprovalRecordShape ;
        sh:message "Category A or B scantlings require a conforming approval record."
    ] .

gen:IMO032CategoryAOrBApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "The scantling approval status must be approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "standard acceptable to the Organization"
            "another standard offering an equivalent level of safety"
        )
    ] .

gen:IMO032IceStrengthenedCategoryCShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:in ( nltl:polarShipCategoryC )
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:hasApprovalRecord ;
        sh:minCount 1 ;
        sh:class nltl:approvalRecord ;
        sh:node gen:IMO032CategoryCApprovalRecordShape ;
        sh:message "An ice-strengthened category C ship requires a conforming approval record."
    ] .

gen:IMO032NonIceStrengthenedCategoryCShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:minCount 1 ;
        sh:in ( nltl:polarShipCategoryC )
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( false )
    ] .

gen:IMO032CategoryCApprovalRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:scantlingApprovalStatus ;
        sh:minCount 1 ;
        sh:in ( nltl:evidenceStateApproved ) ;
        sh:message "The scantling approval status must be approved."
    ] ;
    sh:property [
        sh:path nltl:approvingAuthority ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "Administration"
            "recognized organization accepted by the Administration"
        )
    ] ;
    sh:property [
        sh:path nltl:approvalStandard ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in (
            "acceptable standard adequate for operating ice type and concentration"
        )
    ] ;
    sh:property [
        sh:path nltl:operatingIceType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Category C approval must identify the operating-area ice type."
    ] ;
    sh:property [
        sh:path nltl:operatingIceConcentration ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node gen:IMO032OperatingIceConcentrationShape ;
        sh:message "Category C approval must identify the operating-area ice concentration."
    ] .

gen:IMO032OperatingIceConcentrationShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
