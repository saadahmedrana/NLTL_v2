@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF012ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:class nltl:iceWaterline ;
        sh:node gs:TRF012IceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "At least one intended ice-operating waterline with profile data is required."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:class nltl:iceWaterline ;
        sh:node gs:TRF012IceWaterlineShape ;
        sh:minCount 1 ;
        sh:message "The externally determined lower ice waterline with profile data is required."
    ] .

gs:TRF012IceWaterlineShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:class nltl:waterlineProfilePoint ;
        sh:node gs:TRF012WaterlineProfilePointShape ;
        sh:minCount 1 ;
        sh:message "Each represented ice waterline requires at least one profile point."
    ] .

gs:TRF012WaterlineProfilePointShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:class qudt:QuantityValue ;
        sh:node gs:TRF012LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each waterline profile point requires a longitudinal position in metres."
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:class qudt:QuantityValue ;
        sh:node gs:TRF012LengthQuantityShape ;
        sh:minCount 1 ;
        sh:message "Each waterline profile point requires a vertical coordinate in metres."
    ] .

gs:TRF012LengthQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "The length quantity requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The length quantity must have metre as its single unit."
    ] .
