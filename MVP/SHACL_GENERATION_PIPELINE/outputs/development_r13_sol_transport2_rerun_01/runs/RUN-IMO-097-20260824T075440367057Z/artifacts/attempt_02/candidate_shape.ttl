@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:node gen:IMO097ReleasedLifeboatShape
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:node gen:IMO097ReleasedLifeboatShape
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:node gen:IMO097ReleasedSurvivalCraftShape
            ] ;
            sh:property [
                sh:path nltl:hasOtherSurvivalCraft ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:otherSurvivalCraft
            ]
        ]
    ) ;
    sh:message "Low-temperature applicability and release status must select a permitted branch; released craft must carry the required communication devices." .

gen:IMO097ReleasedLifeboatShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:class nltl:shipToShoreDistressAlertDevice
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
    ] .

gen:IMO097ReleasedSurvivalCraftShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:class nltl:shipToShoreDistressAlertDevice
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each released survival craft must carry at least one ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:class nltl:locationSignalDevice
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each released survival craft must carry at least one location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:qualifiedValueShape [
            sh:nodeKind sh:IRI ;
            sh:class nltl:onSceneCommunicationDevice
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Each released survival craft must carry at least one on-scene transmit/receive communication device."
    ] .
