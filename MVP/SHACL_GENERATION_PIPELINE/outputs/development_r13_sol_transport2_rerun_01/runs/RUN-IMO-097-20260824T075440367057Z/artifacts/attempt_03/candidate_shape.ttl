@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:SurvivalCraftCommunicationShape
    a sh:NodeShape ;
    sh:class nltl:survivalCraft ;
    sh:property [
        sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
        sh:minCount 1 ;
        sh:class nltl:shipToShoreDistressAlertDevice ;
        sh:message "Each applicable survival craft must carry a ship-to-shore distress-alert device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasLocationSignalDevice ;
        sh:minCount 1 ;
        sh:class nltl:locationSignalDevice ;
        sh:message "Each applicable survival craft must carry a location-signal device."
    ] ;
    sh:property [
        sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
        sh:minCount 1 ;
        sh:class nltl:onSceneCommunicationDevice ;
        sh:message "Each applicable survival craft must carry an on-scene transmit/receive communication device."
    ] .

gs:LifeboatOwnerShape
    a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:class nltl:survivalCraft .

gs:LifeboatCommunicationShape
    a sh:NodeShape ;
    sh:node gs:LifeboatOwnerShape ;
    sh:node gs:SurvivalCraftCommunicationShape ;
    sh:property [
        sh:path nltl:hasDistressAlertDevice ;
        sh:minCount 1 ;
        sh:class nltl:equipmentItem ;
        sh:message "Each applicable released rescue boat or lifeboat must have a distress-alert device."
    ] .

gs:IMO097RequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's low-air-temperature operating status must be recorded unambiguously."
    ] ;
    sh:property [
        sh:path nltl:hasSurvivalCraft ;
        sh:class nltl:survivalCraft
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:node gs:LifeboatOwnerShape
    ] ;
    sh:property [
        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
        sh:node gs:LifeboatOwnerShape
    ] ;
    sh:property [
        sh:path nltl:hasOtherSurvivalCraft ;
        sh:class nltl:otherSurvivalCraft
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasSurvivalCraft ;
                sh:node gs:SurvivalCraftCommunicationShape
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:node gs:LifeboatCommunicationShape
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:node gs:LifeboatCommunicationShape
            ]
        ]
    ) .
