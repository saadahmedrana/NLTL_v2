@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO111Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO111CategoryOutsideABBranch
        gen:IMO111Pre2017Branch
        gen:IMO111OtherTankTypeBranch
        gen:IMO111SmallTankBranch
        gen:IMO111ApplicableTankBranch
    ) ;
    sh:message "Category A or B ships constructed on or after 2017-01-01 must provide valid tank applicability data; every represented relevant tank over 30 m3 must have outer-shell separation of at least 0.76 m." .

gen:IMO111CategoryABShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:polarShipCategoryA
            nltl:polarShipCategoryB
        ) ;
        sh:minCount 1
    ] .

gen:IMO111DateOnOrAfter2017Shape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1
    ] .

gen:IMO111RelevantTankTypeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every represented tank type must map to oilResidueTank or oilyBilgeWaterHoldingTank in this branch." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:tankType ?tankType .
    FILTER(
        DATATYPE(?tankType) != xsd:string ||
        STR(?tankType) NOT IN (
            STR(nltl:oilResidueTank),
            STR(nltl:oilyBilgeWaterHoldingTank)
        )
    )
}
"""
    ] .

gen:IMO111CategoryOutsideABBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryC ) ;
        sh:minCount 1
    ] .

gen:IMO111Pre2017Branch
    a sh:NodeShape ;
    sh:node gen:IMO111CategoryABShape ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:maxExclusive "2017-01-01"^^xsd:date ;
        sh:minCount 1
    ] .

gen:IMO111OtherTankTypeBranch
    a sh:NodeShape ;
    sh:node gen:IMO111CategoryABShape ;
    sh:node gen:IMO111DateOnOrAfter2017Shape ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This non-applicability branch requires an explicitly represented tank type outside the two regulated tank alternatives." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:tankType ?tankType .
    FILTER(
        DATATYPE(?tankType) != xsd:string ||
        STR(?tankType) IN (
            STR(nltl:oilResidueTank),
            STR(nltl:oilyBilgeWaterHoldingTank)
        )
    )
}
"""
    ] .

gen:IMO111SmallTankBranch
    a sh:NodeShape ;
    sh:node gen:IMO111CategoryABShape ;
    sh:node gen:IMO111DateOnOrAfter2017Shape ;
    sh:node gen:IMO111RelevantTankTypeShape ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxInclusive "30"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gen:IMO111ApplicableTankBranch
    a sh:NodeShape ;
    sh:node gen:IMO111CategoryABShape ;
    sh:node gen:IMO111DateOnOrAfter2017Shape ;
    sh:node gen:IMO111RelevantTankTypeShape ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minExclusive "30"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "0.76"^^xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
