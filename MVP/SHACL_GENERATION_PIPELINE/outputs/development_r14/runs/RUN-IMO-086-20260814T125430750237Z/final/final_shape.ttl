@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-086-HeadingMeansShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasNonMagneticHeadingMeans ;
        sh:qualifiedMinCount 2 ;
        sh:qualifiedValueShape [
            sh:class nltl:nonMagneticHeadingMeans
        ] ;
        sh:node [
            sh:class nltl:nonMagneticHeadingMeans ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:minCount 1 ;
                sh:message "Each non-magnetic heading means must be connected to main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:minCount 1 ;
                sh:message "Each non-magnetic heading means must be connected to emergency power."
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Each non-magnetic heading means must be independent from another distinct non-magnetic heading means on the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this ?means
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?other .
                    $this nltl:hasNonMagneticHeadingMeans ?other .
                    FILTER (?other != ?means)
                }
            }
        """
    ] .
