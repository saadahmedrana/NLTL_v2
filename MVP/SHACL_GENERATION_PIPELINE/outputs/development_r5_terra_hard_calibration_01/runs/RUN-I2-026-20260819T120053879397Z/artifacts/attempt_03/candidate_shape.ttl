@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-026ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node <urn:nltl:generated-shape:I2-026StructuralMemberShape>
    ] .

<urn:nltl:generated-shape:I2-026StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSupportCondition ;
        sh:minCount 1 ;
        sh:in ( nltl:fixedFrameSupport nltl:simpleFrameSupport ) ;
        sh:message "A framing member must record its applicable frame support condition."
    ] ;
    sh:property [
        sh:path nltl:significantRotationalRestraintEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Significant rotational-restraint evidence must be an evidence artifact."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:fixedFrameSupport
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:continuousThroughSupport ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasMemberSupport ;
                        sh:qualifiedValueShape [
                            sh:class nltl:memberSupport ;
                            sh:property [
                                sh:path nltl:connectionBracketPresent ;
                                sh:datatype xsd:boolean ;
                                sh:hasValue true
                            ]
                        ] ;
                        sh:qualifiedMinCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:significantRotationalRestraintEvidence ;
                        sh:class nltl:evidenceArtifact ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:terminatesWithinIceStrengthenedArea ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ]
                ]
            )
        ]
        [
            sh:property [
                sh:path nltl:frameSupportCondition ;
                sh:hasValue nltl:simpleFrameSupport
            ] ;
            sh:property [
                sh:path nltl:hasMemberSupport ;
                sh:qualifiedValueShape [
                    sh:class nltl:memberSupport ;
                    sh:property [
                        sh:path nltl:connectionBracketPresent ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "Simple support requires a member support with connectionBracketPresent explicitly recorded as false."
            ] ;
            sh:not [
                sh:or (
                    [
                        sh:property [
                            sh:path nltl:continuousThroughSupport ;
                            sh:datatype xsd:boolean ;
                            sh:hasValue true
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:terminatesWithinIceStrengthenedArea ;
                            sh:datatype xsd:boolean ;
                            sh:hasValue true
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:hasMemberSupport ;
                            sh:qualifiedValueShape [
                                sh:class nltl:memberSupport ;
                                sh:property [
                                    sh:path nltl:connectionBracketPresent ;
                                    sh:datatype xsd:boolean ;
                                    sh:hasValue true
                                ]
                            ] ;
                            sh:qualifiedMinCount 1
                        ]
                    ]
                    [
                        sh:property [
                            sh:path nltl:significantRotationalRestraintEvidence ;
                            sh:class nltl:evidenceArtifact ;
                            sh:minCount 1
                        ]
                    ]
                )
            ]
        ]
    ) ;
    sh:message "The recorded frame support condition is not supported by the member's continuity, support connection, rotational-restraint evidence, or ice-strengthened-area termination condition."
    .
