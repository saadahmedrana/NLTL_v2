@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_011_MDLTShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dailyLowTemperature ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:meanDailyLowTemperature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:dataPeriod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:YR ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "10"^^xsd:decimal
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:dataPeriod ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "10"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:administrationDatasetApprovalStatus ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:evidenceStateApproved ) ;
                sh:minCount 1 ;
                sh:message "An Administration-approved dataset status is required when the data period is less than 10 years."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "meanDailyLowTemperature must equal the mean of dailyLowTemperature values within a relative tolerance of 1e-6 and an absolute fallback of 1e-9."
        ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    SELECT $this (AVG(?dailyValue) AS ?expected)
                    WHERE {
                        $this nltl:dailyLowTemperature ?dailyQuantity .
                        ?dailyQuantity qudt:numericValue ?dailyValue ;
                                       qudt:unit unit:DEG_C .
                    }
                    GROUP BY $this
                }
                $this nltl:meanDailyLowTemperature ?meanQuantity .
                ?meanQuantity qudt:numericValue ?reported ;
                              qudt:unit unit:DEG_C .
                BIND(
                    (0.000001 * IF(?expected < 0, (?expected * -1), ?expected))
                    + 0.000000001
                    AS ?tolerance
                )
                FILTER(
                    ?reported > (?expected + ?tolerance)
                    || ?reported < (?expected - ?tolerance)
                )
            }
        """
    ] .
