@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO017ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A Polar certificate supplement must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCertificateForm ;
        sh:message "A Polar Ship Certificate record is required."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node gs:IMO017SupplementShape ;
        sh:message "A Polar certificate supplement with required equipment records is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:node gs:IMO017SolasScheduleShape
    ] ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date
    ] ;
    sh:sparql [
        sh:message "Each Polar certificate validity date must match a validity-date record in the linked SOLAS certificate schedule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:polarCertificateValidityDates ?value .
                FILTER NOT EXISTS {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType ?dateType .
                    FILTER(?dateType = STR(nltl:polarCertificateValidityDates))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each validity-date record in a linked SOLAS certificate schedule must match a Polar certificate validity date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDate ?value ;
                        nltl:certificateScheduleDateType ?dateType .
                FILTER(?dateType = STR(nltl:polarCertificateValidityDates))
                FILTER NOT EXISTS {
                    $this nltl:polarCertificateValidityDates ?value
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each survey date must match a survey-date record in the linked SOLAS certificate schedule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:surveyDates ?value .
                FILTER NOT EXISTS {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType ?dateType .
                    FILTER(?dateType = STR(nltl:surveyDates))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each survey-date record in a linked SOLAS certificate schedule must match a survey date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDate ?value ;
                        nltl:certificateScheduleDateType ?dateType .
                FILTER(?dateType = STR(nltl:surveyDates))
                FILTER NOT EXISTS {
                    $this nltl:surveyDates ?value
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each endorsement date must match an endorsement-date record in the linked SOLAS certificate schedule." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:endorsementDates ?value .
                FILTER NOT EXISTS {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?value ;
                            nltl:certificateScheduleDateType ?dateType .
                    FILTER(?dateType = STR(nltl:endorsementDates))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each endorsement-date record in a linked SOLAS certificate schedule must match an endorsement date." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:hasSolasCertificateSchedule ?schedule .
                ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                ?record nltl:certificateScheduleDate ?value ;
                        nltl:certificateScheduleDateType ?dateType .
                FILTER(?dateType = STR(nltl:endorsementDates))
                FILTER NOT EXISTS {
                    $this nltl:endorsementDates ?value
                }
            }
        """
    ] .

gs:IMO017SupplementShape
    a sh:NodeShape ;
    sh:class nltl:polarCertificateSupplement ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:message "The Polar certificate supplement must include required equipment records."
    ] .

gs:IMO017SolasScheduleShape
    a sh:NodeShape ;
    sh:class nltl:solasCertificateSchedule ;
    sh:property [
        sh:path nltl:hasCertificateScheduleDateRecord ;
        sh:node gs:IMO017ScheduleDateRecordShape
    ] .

gs:IMO017ScheduleDateRecordShape
    a sh:NodeShape ;
    sh:class nltl:certificateScheduleDateRecord ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A certificate schedule date record requires its date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A certificate schedule date record requires its date type."
    ] .
