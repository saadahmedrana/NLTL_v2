@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-035Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarWaterOperationalManualRecord ;
        sh:minCount 1 ;
        sh:class nltl:documentRecord ;
        sh:message "A Polar Water Operational Manual record is required."
    ] ;
    sh:property [
        sh:path nltl:hasStabilityCalculationRecord ;
        sh:minCount 1 ;
        sh:class nltl:documentRecord ;
        sh:message "A stability calculation record is required."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The PWOM shall state that icing allowance information is present."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:equals nltl:stabilityCalculationIcingAllowanceValues ;
        sh:message "PWOM icing allowance values shall match the stability calculation icing allowance values."
    ] ;
    sh:property [
        sh:path nltl:stabilityCalculationIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1
    ] .
