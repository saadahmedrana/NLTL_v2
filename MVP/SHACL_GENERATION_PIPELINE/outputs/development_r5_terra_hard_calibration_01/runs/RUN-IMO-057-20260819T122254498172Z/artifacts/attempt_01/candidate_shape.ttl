@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO057FirePumpCompartmentTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each linked fire pump must have a containing compartment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?pump nltl:hasContainingCompartment ?compartment .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each containing compartment of a linked fire pump must have a maintained temperature." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?compartment nltl:maintainedTemperature ?temperature .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maintained temperature must be represented by a QUDT quantity value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                ?compartment nltl:maintainedTemperature ?temperature .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?temperature a qudt:QuantityValue .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maintained temperature must use the canonical degree Celsius unit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                ?compartment nltl:maintainedTemperature ?temperature .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?temperature qudt:unit unit:DEG_C .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maintained temperature must not use a unit other than degree Celsius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                ?compartment nltl:maintainedTemperature ?temperature .
                ?temperature qudt:unit ?actualUnit .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER (?actualUnit != unit:DEG_C)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maintained temperature must have a decimal numeric value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                ?compartment nltl:maintainedTemperature ?temperature .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?temperature qudt:numericValue ?value .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maintained temperature numeric values must be xsd:decimal." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                ?compartment nltl:maintainedTemperature ?temperature .
                ?temperature qudt:numericValue ?value .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER (datatype(?value) != xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Containing compartments of linked fire pumps must be maintained above 0 degrees Celsius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                ?compartment nltl:maintainedTemperature ?temperature .
                ?temperature qudt:numericValue ?value .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER (
                    datatype(?value) = xsd:decimal &&
                    ?value <= "0"^^xsd:decimal
                )
            }
        """
    ] .
