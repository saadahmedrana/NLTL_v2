@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO057FirePumpCompartmentTemperatureShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each fire pump shall be located in a compartment with a maintained temperature above 0 deg C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?pump ?compartment ?temperature ?value
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType .
                FILTER(?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))

                OPTIONAL {
                    ?pump nltl:hasContainingCompartment ?compartment .
                }
                OPTIONAL {
                    ?compartment nltl:maintainedTemperature ?temperature .
                }
                OPTIONAL {
                    ?temperature a ?quantityType .
                    FILTER(?quantityType = qudt:QuantityValue)
                }
                OPTIONAL {
                    ?temperature qudt:numericValue ?value .
                }
                OPTIONAL {
                    ?temperature qudt:unit ?unit .
                }

                FILTER(
                    !BOUND(?compartment) ||
                    !BOUND(?temperature) ||
                    !BOUND(?quantityType) ||
                    !BOUND(?value) ||
                    !BOUND(?unit) ||
                    (BOUND(?unit) && ?unit != unit:DEG_C) ||
                    (
                        BOUND(?value) &&
                        (
                            !isLiteral(?value) ||
                            datatype(?value) != xsd:decimal ||
                            (
                                isLiteral(?value) &&
                                datatype(?value) = xsd:decimal &&
                                ?value <= "0"^^xsd:decimal
                            )
                        )
                    )
                )
            }
        """
    ] .
