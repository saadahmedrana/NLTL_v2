@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:IMO106OilDischargeExceptionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "For clean ballast or segregated ballast discharge, paragraph 1.1.1 oil-discharge prohibition applicability must be false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (?material IN (
                    nltl:cleanBallastMaterial,
                    nltl:segregatedBallastMaterial
                ))
                OPTIONAL {
                    $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
                }
                FILTER (!BOUND(?applicable) || ?applicable != false)
            }
        """
    ] .
