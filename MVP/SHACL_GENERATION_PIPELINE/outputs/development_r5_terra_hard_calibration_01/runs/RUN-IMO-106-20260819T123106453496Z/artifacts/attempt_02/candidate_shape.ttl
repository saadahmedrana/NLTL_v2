@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-106-ExceptionClassificationShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For clean or segregated ballast discharge, paragraph 1.1.1 applicability must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (?material IN (
                    nltl:cleanBallastMaterial,
                    nltl:segregatedBallastMaterial
                ))
                FILTER NOT EXISTS {
                    $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable false .
                }
            }
        """
    ] .
