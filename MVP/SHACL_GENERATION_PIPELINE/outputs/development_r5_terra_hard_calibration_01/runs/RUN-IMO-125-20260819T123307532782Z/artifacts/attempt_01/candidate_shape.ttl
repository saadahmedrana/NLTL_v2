@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-125-PolarGarbageDocumentCoverageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Provide whether the ship operates in polar waters."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInPolarWaters ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:garbageRecordBookPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "For a ship operating in polar waters, the Garbage Record Book shall cover polar operation."
            ] ;
            sh:property [
                sh:path nltl:garbageManagementPlanPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "For a ship operating in polar waters, the Garbage Management Plan shall cover polar operation."
            ] ;
            sh:property [
                sh:path nltl:garbagePlacardPolarCoverage ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "For a ship operating in polar waters, garbage placards shall cover polar operation."
            ]
        ]
    ) .
