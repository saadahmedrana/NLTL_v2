@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-060Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable4Dash8 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:lookupSelectionEvidence ;
                sh:minCount 1 ;
                sh:class nltl:evidenceArtifact
            ] ;
            sh:property [
                sh:path nltl:webFrameTable4Dash8GammaFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Web-frame formula operands and results must satisfy the prescribed bending moment, area, required-shear-area conversion, and section-modulus relationships within relative tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:webFrameIceLoad ?loadQ ;
                      nltl:webFrameSpan ?spanQ ;
                      nltl:webFrameMaximumIceLoadBendingMoment ?momentQ ;
                      nltl:webFrameFreeFlangeArea ?flangeQ ;
                      nltl:webFrameWebArea ?webQ ;
                      nltl:actualWebFrameCrossSectionalArea ?actualQ ;
                      nltl:shearArea ?shearQ ;
                      nltl:requiredShearArea ?requiredQ ;
                      nltl:yieldStrength ?yieldQ ;
                      nltl:sectionModulus ?sectionQ ;
                      nltl:hasTableLookupCase ?case .
                ?case nltl:webFrameTable4Dash8GammaFactor ?gammaQ .
                ?loadQ qudt:numericValue ?load .
                ?spanQ qudt:numericValue ?span .
                ?momentQ qudt:numericValue ?moment .
                ?flangeQ qudt:numericValue ?flange .
                ?webQ qudt:numericValue ?web .
                ?actualQ qudt:numericValue ?actual .
                ?shearQ qudt:numericValue ?shear .
                ?requiredQ qudt:numericValue ?required .
                ?yieldQ qudt:numericValue ?yield .
                ?sectionQ qudt:numericValue ?section .
                ?gammaQ qudt:numericValue ?gamma .

                BIND((0.193 * (?load / 1000.0) * ?span) AS ?expectedMoment)
                BIND((?flange + ?web) AS ?expectedActual)
                BIND((?shear * 10000.0) AS ?expectedRequired)
                BIND((?gamma * ?required / ?actual) AS ?ratio)
                BIND((?section * ?yield / 1000000.0) AS ?sectionScaled)
                BIND((?sectionScaled * ?sectionScaled * (1.0 - (?ratio * ?ratio))) AS ?reportedSquared)
                BIND((?moment * ?moment) AS ?expectedSquared)

                FILTER (
                    ABS(?moment - ?expectedMoment) >
                        ((ABS(?expectedMoment) * 0.000001) + 0.000000001) ||
                    ABS(?actual - ?expectedActual) >
                        ((ABS(?expectedActual) * 0.000001) + 0.000000001) ||
                    ABS(?required - ?expectedRequired) >
                        ((ABS(?expectedRequired) * 0.000001) + 0.000000001) ||
                    ABS(?reportedSquared - ?expectedSquared) >
                        ((ABS(?expectedSquared) * 0.000002) + 0.000000001)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Section-modulus calculation requires non-zero yield strength, positive actual web-frame area, a valid square-root envelope, and a section-modulus sign consistent with the bending moment and yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:actualWebFrameCrossSectionalArea ?actualQ ;
                      nltl:requiredShearArea ?requiredQ ;
                      nltl:yieldStrength ?yieldQ ;
                      nltl:sectionModulus ?sectionQ ;
                      nltl:webFrameMaximumIceLoadBendingMoment ?momentQ ;
                      nltl:hasTableLookupCase ?case .
                ?case nltl:webFrameTable4Dash8GammaFactor ?gammaQ .
                ?actualQ qudt:numericValue ?actual .
                ?requiredQ qudt:numericValue ?required .
                ?yieldQ qudt:numericValue ?yield .
                ?sectionQ qudt:numericValue ?section .
                ?momentQ qudt:numericValue ?moment .
                ?gammaQ qudt:numericValue ?gamma .
                BIND((?gamma * ?required / ?actual) AS ?ratio)
                FILTER (
                    ?actual <= 0 ||
                    ?yield = 0 ||
                    (1.0 - (?ratio * ?ratio)) <= 0 ||
                    ((?section * ?moment / ?yield) < 0)
                )
            }
        """
    ] .
