@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF069Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable propulsion-machinery case requires maximum ice torque and a design condition covering the prescribed load scope." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType .

                FILTER(
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ) &&
                    ?propellerType IN (
                        "open"^^xsd:string,
                        "ducted"^^xsd:string
                    ) &&
                    ?pitchType IN (
                        "controllable"^^xsd:string,
                        "fixed"^^xsd:string
                    )
                )

                FILTER NOT EXISTS {
                    $this nltl:maximumIceTorque ?maximumTorque ;
                          nltl:hasDesignCondition ?condition .

                    ?maximumTorque qudt:numericValue ?torqueValue ;
                                   qudt:unit unit:KiloN-M .
                    FILTER(datatype(?torqueValue) = xsd:decimal)

                    ?condition nltl:normalOperationalConditions true ;
                               nltl:normalServiceLifePropellerIceLoadCondition true ;
                               nltl:fixedPitchPropellerReversalLoadIncluded true ;
                               nltl:stoppedPropellerDraggingOutsideLoadModel false ;
                               nltl:radialIceEntryOutsideLoadModel false .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each design condition for an applicable propulsion-machinery case must record the prescribed load-scope statements." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType ;
                      nltl:hasDesignCondition ?condition .

                FILTER(
                    ?iceClass IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ) &&
                    ?propellerType IN (
                        "open"^^xsd:string,
                        "ducted"^^xsd:string
                    ) &&
                    ?pitchType IN (
                        "controllable"^^xsd:string,
                        "fixed"^^xsd:string
                    )
                )

                FILTER NOT EXISTS {
                    ?condition nltl:normalOperationalConditions true ;
                               nltl:normalServiceLifePropellerIceLoadCondition true ;
                               nltl:fixedPitchPropellerReversalLoadIncluded true ;
                               nltl:stoppedPropellerDraggingOutsideLoadModel false ;
                               nltl:radialIceEntryOutsideLoadModel false .
                }
            }
        """
    ] .
