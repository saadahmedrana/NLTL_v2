@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:AreaCm2QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:AreaM2QuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SectionModulusQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ForceQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:BendingMomentQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:YieldStrengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:WebFrameTableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:in ( nltl:traficomTable4Dash8 )
    ] ;
    sh:property [
        sh:path nltl:webFrameTable4Dash8GammaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] .

gs:TRF060WebFrameSectionModulusShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gs:WebFrameTableLookupCaseShape
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:BendingMomentQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaCm2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaCm2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaCm2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaCm2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaM2QuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:YieldStrengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:SectionModulusQuantityShape
    ] ;
    sh:sparql [
        sh:message "Web-frame calculation inputs must yield a defined section-modulus expression." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:webFrameIceLoad ?fQ ;
                      nltl:webFrameSpan ?lQ ;
                      nltl:webFrameFreeFlangeArea ?afQ ;
                      nltl:webFrameWebArea ?awQ ;
                      nltl:requiredShearArea ?requiredQ ;
                      nltl:yieldStrength ?sigmaQ ;
                      nltl:hasTableLookupCase ?case .
                ?fQ qudt:numericValue ?f .
                ?lQ qudt:numericValue ?l .
                ?afQ qudt:numericValue ?af .
                ?awQ qudt:numericValue ?aw .
                ?requiredQ qudt:numericValue ?required .
                ?sigmaQ qudt:numericValue ?sigma .
                ?case nltl:webFrameTable4Dash8GammaFactor ?gammaQ .
                ?gammaQ qudt:numericValue ?gamma .
                BIND((?af + ?aw) AS ?expectedArea)
                BIND((1 - ((?gamma * ?required / ?expectedArea) * (?gamma * ?required / ?expectedArea))) AS ?radicand)
                FILTER(?expectedArea = 0 || ?sigma = 0 || ?radicand <= 0)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Web-frame bending moment, cross-sectional area, section modulus, and shear area do not satisfy clause 4.6.2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:webFrameIceLoad ?fQ ;
                      nltl:webFrameSpan ?lQ ;
                      nltl:webFrameMaximumIceLoadBendingMoment ?mQ ;
                      nltl:webFrameFreeFlangeArea ?afQ ;
                      nltl:webFrameWebArea ?awQ ;
                      nltl:actualWebFrameCrossSectionalArea ?areaQ ;
                      nltl:requiredShearArea ?requiredQ ;
                      nltl:shearArea ?shearQ ;
                      nltl:yieldStrength ?sigmaQ ;
                      nltl:sectionModulus ?sectionQ ;
                      nltl:hasTableLookupCase ?case .
                ?fQ qudt:numericValue ?f .
                ?lQ qudt:numericValue ?l .
                ?mQ qudt:numericValue ?m .
                ?afQ qudt:numericValue ?af .
                ?awQ qudt:numericValue ?aw .
                ?areaQ qudt:numericValue ?area .
                ?requiredQ qudt:numericValue ?required .
                ?shearQ qudt:numericValue ?shear .
                ?sigmaQ qudt:numericValue ?sigma .
                ?sectionQ qudt:numericValue ?section .
                ?case nltl:webFrameTable4Dash8GammaFactor ?gammaQ .
                ?gammaQ qudt:numericValue ?gamma .
                BIND((0.193 * (?f * 0.001) * ?l) AS ?expectedMoment)
                BIND((?af + ?aw) AS ?expectedArea)
                BIND((1 - ((?gamma * ?required / ?expectedArea) * (?gamma * ?required / ?expectedArea))) AS ?radicand)
                BIND((?expectedMoment / ?sigma) * 1000000 AS ?expectedSectionScale)
                BIND((?expectedSectionScale * ?expectedSectionScale) / ?radicand AS ?expectedSectionSquared)
                BIND((ABS(?expectedMoment) * 0.000001) + 0.000000001 AS ?momentTolerance)
                BIND((ABS(?expectedArea) * 0.000001) + 0.000000001 AS ?areaTolerance)
                BIND((ABS(?expectedSectionScale) * 0.000001) + 0.000000001 AS ?sectionTolerance)
                BIND((?section - ?sectionTolerance) AS ?sectionLower)
                BIND((?section + ?sectionTolerance) AS ?sectionUpper)
                FILTER(
                    ABS(?m - ?expectedMoment) > ?momentTolerance ||
                    ABS(?area - ?expectedArea) > ?areaTolerance ||
                    (
                        (?expectedSectionScale > 0 &&
                         !(
                            ?sectionUpper >= 0 &&
                            (?sectionLower <= 0 || (?sectionLower * ?sectionLower) <= ?expectedSectionSquared) &&
                            (?sectionUpper * ?sectionUpper) >= ?expectedSectionSquared
                         )) ||
                        (?expectedSectionScale < 0 &&
                         !(
                            ?sectionLower <= 0 &&
                            (?sectionUpper >= 0 || (?sectionUpper * ?sectionUpper) <= ?expectedSectionSquared) &&
                            (?sectionLower * ?sectionLower) >= ?expectedSectionSquared
                         )) ||
                        (?expectedSectionScale = 0 &&
                         !(?sectionLower <= 0 && ?sectionUpper >= 0))
                    ) ||
                    (?shear * 10000) < ?required
                )
            }
        """
    ] .
