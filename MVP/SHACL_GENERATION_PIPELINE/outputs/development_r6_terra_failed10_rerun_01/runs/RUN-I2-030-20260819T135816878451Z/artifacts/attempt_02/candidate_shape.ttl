@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-030ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:localFrameSectionCalculationCase ;
        sh:node <urn:nltl:generated-shape:I2-030LocalFrameCaseShape>
    ] .

<urn:nltl:generated-shape:I2-030QuantityDecimalShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:I2-030AreaQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030MetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030DegreeQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-030StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030AreaQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030MetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node <urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node <urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node <urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node <urn:nltl:generated-shape:I2-030DegreeQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node <urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node <urn:nltl:generated-shape:I2-030SectionModulusQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-030PlatingShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030DegreeQuantityShape>
    ] .

<urn:nltl:generated-shape:I2-030InterpolationPointShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030QuantityDecimalShape>
    ] .

<urn:nltl:generated-shape:I2-030LocalFrameCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:minCount 1 ;
        sh:class nltl:structuralMember ;
        sh:node <urn:nltl:generated-shape:I2-030StructuralMemberShape>
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:minCount 1 ;
        sh:class nltl:plating ;
        sh:node <urn:nltl:generated-shape:I2-030PlatingShape>
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node <urn:nltl:generated-shape:I2-030MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2-030InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:I2-030InterpolationPointShape>
    ] ;
    sh:sparql [
        sh:message "The section calculation case structural member must link this local-frame section calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                FILTER NOT EXISTS {
                    ?member nltl:hasLocalFrameSectionCalculationCase $this .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "plasticNeutralAxisHeight is required when 100 times netLocalFrameFlangeArea exceeds 1000 times netAttachedShellPlateThickness times frameSpacing." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:netLocalFrameFlangeArea/qudt:numericValue ?afn ;
                        nltl:netAttachedShellPlateThickness/qudt:numericValue ?tpn ;
                        nltl:frameSpacing/qudt:numericValue ?s .
                FILTER (100 * ?afn > 1000 * ?tpn * ?s)
                FILTER NOT EXISTS {
                    $this nltl:plasticNeutralAxisHeight ?zna .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "plasticNeutralAxisHeight must equal the required local-frame neutral-axis formula within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:plasticNeutralAxisHeight/qudt:numericValue ?reported .
                ?member nltl:netLocalFrameFlangeArea/qudt:numericValue ?afn ;
                        nltl:webHeight/qudt:numericValue ?hw ;
                        nltl:netWebThickness/qudt:numericValue ?twn ;
                        nltl:netAttachedShellPlateThickness/qudt:numericValue ?tpn ;
                        nltl:frameSpacing/qudt:numericValue ?s .
                FILTER (100 * ?afn > 1000 * ?tpn * ?s)
                BIND ((100 * ?afn + ?hw * ?twn - 1000 * ?tpn * ?s) / (2 * ?twn) AS ?expected)
                FILTER (ABS(?reported - ?expected) > ((ABS(?expected) * 0.000001) + 0.000000001))
            }
        """
    ] ;
    sh:sparql [
        sh:message "netEffectivePlasticSectionModulus is required when the local-frame area applicability condition holds." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:netLocalFrameFlangeArea/qudt:numericValue ?afn ;
                        nltl:netAttachedShellPlateThickness/qudt:numericValue ?tpn ;
                        nltl:frameSpacing/qudt:numericValue ?s .
                FILTER (100 * ?afn > 1000 * ?tpn * ?s)
                FILTER NOT EXISTS {
                    ?member nltl:netEffectivePlasticSectionModulus ?zp .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "netEffectivePlasticSectionModulus must equal the required local-frame section-modulus formula within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 cm3." ;
        sh:select """
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:plasticNeutralAxisHeight/qudt:numericValue ?zna .
                ?member nltl:netEffectivePlasticSectionModulus/qudt:numericValue ?reported ;
                        nltl:netLocalFrameFlangeArea/qudt:numericValue ?afn ;
                        nltl:webHeight/qudt:numericValue ?hw ;
                        nltl:netWebThickness/qudt:numericValue ?twn ;
                        nltl:netAttachedShellPlateThickness/qudt:numericValue ?tpn ;
                        nltl:frameSpacing/qudt:numericValue ?s ;
                        nltl:localFrameFlangeCentreHeight/qudt:numericValue ?hfc ;
                        nltl:webAngleToShellPlate/qudt:numericValue ?phi ;
                        nltl:webToFlangeCentreDistance/qudt:numericValue ?bw .
                FILTER (100 * ?afn > 1000 * ?tpn * ?s)
                BIND (?phi * 3.141592653589793 / 180 AS ?phiRadians)
                BIND (
                    ?tpn * ?s * (?zna + ?tpn / 2) * math:sin(?phiRadians) +
                    (((((?hw - ?zna) * (?hw - ?zna)) + (?zna * ?zna)) * ?twn * math:sin(?phiRadians)) / 2000) +
                    (?afn * (((?hfc - ?zna) * math:sin(?phiRadians)) - (?bw * math:cos(?phiRadians))) / 10)
                    AS ?expected
                )
                FILTER (ABS(?reported - ?expected) > ((ABS(?expected) * 0.000001) + 0.000000001))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Linear-interpolation endpoints are required for oblique framing where framingAngleOmega is greater than 20 degrees and less than 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega/qudt:numericValue ?omega .
                FILTER (?omega > 20 && ?omega < 70)
                FILTER NOT EXISTS {
                    $this nltl:interpolationLowerEndpoint ?lower .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Linear-interpolation endpoints are required for oblique framing where framingAngleOmega is greater than 20 degrees and less than 70 degrees." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega/qudt:numericValue ?omega .
                FILTER (?omega > 20 && ?omega < 70)
                FILTER NOT EXISTS {
                    $this nltl:interpolationUpperEndpoint ?upper .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For oblique framing, interpolation endpoints must have increasing coordinates and netEffectivePlasticSectionModulus must equal the linear interpolation result within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCasePlating ?plating ;
                      nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:interpolationLowerEndpoint ?lower ;
                      nltl:interpolationUpperEndpoint ?upper .
                ?plating nltl:framingAngleOmega/qudt:numericValue ?omega .
                ?member nltl:netEffectivePlasticSectionModulus/qudt:numericValue ?reported .
                ?lower nltl:interpolationPointCoordinate/qudt:numericValue ?lowerCoordinate ;
                       nltl:interpolationPointResult/qudt:numericValue ?lowerResult .
                ?upper nltl:interpolationPointCoordinate/qudt:numericValue ?upperCoordinate ;
                       nltl:interpolationPointResult/qudt:numericValue ?upperResult .
                FILTER (?omega > 20 && ?omega < 70)
                BIND (?lowerResult + ((?omega - ?lowerCoordinate) * (?upperResult - ?lowerResult) / (?upperCoordinate - ?lowerCoordinate)) AS ?expected)
                FILTER (
                    ?upperCoordinate <= ?lowerCoordinate ||
                    ABS(?reported - ?expected) > ((ABS(?expected) * 0.000001) + 0.000000001)
                )
            }
        """
    ] .
