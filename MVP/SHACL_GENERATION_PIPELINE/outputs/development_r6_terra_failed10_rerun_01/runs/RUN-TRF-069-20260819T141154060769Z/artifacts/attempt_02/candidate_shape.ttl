@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-069Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable propulsion-machinery ship requires a linked design condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER(?pitchType IN (
                    "controllable"^^xsd:string,
                    "fixed"^^xsd:string
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasDesignCondition ?designCondition .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An applicable propulsion-machinery ship requires maximum ice torque as a decimal quantity in kN*m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER(?pitchType IN (
                    "controllable"^^xsd:string,
                    "fixed"^^xsd:string
                ))
                FILTER NOT EXISTS {
                    $this nltl:maximumIceTorque ?torque .
                    ?torque a qudt:QuantityValue ;
                        qudt:numericValue ?value ;
                        qudt:unit unit:KiloN-M .
                    FILTER(datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each applicable design condition must record normal operational and normal service-life propeller/ice loads, include fixed-pitch reversal loads, and exclude stopped-propeller dragging and radial ice-entry loads from the prescribed load model." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType ;
                      nltl:hasDesignCondition ?designCondition .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER(?pitchType IN (
                    "controllable"^^xsd:string,
                    "fixed"^^xsd:string
                ))
                FILTER NOT EXISTS {
                    ?designCondition
                        nltl:normalOperationalConditions true ;
                        nltl:normalServiceLifePropellerIceLoadCondition true ;
                        nltl:fixedPitchPropellerReversalLoadIncluded true ;
                        nltl:stoppedPropellerDraggingOutsideLoadModel false ;
                        nltl:radialIceEntryOutsideLoadModel false .
                }
            }
        """
    ] .
