@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-128-AirCompressorChargingShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:airReceiverCapacity ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:M3
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:compressorChargeTime ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:HR
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;

    sh:property [
        sh:path nltl:propulsionEngineReversalRequiredForAstern ;
        sh:datatype xsd:boolean
    ] ;

    sh:sparql [
        sh:message "IA Super ships require propulsionEngineReversalRequiredForAstern to select the applicable charging-time limit." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceClass nltl:iceClassIaSuper .
                FILTER NOT EXISTS {
                    $this nltl:propulsionEngineReversalRequiredForAstern ?reversal .
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "Compressor charge time exceeds the applicable limit of 1 hour, or 0.5 hour for IA Super ships requiring propulsion-engine reversal for astern operation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:airReceiverCapacity ?receiver ;
                      nltl:compressorChargeTime ?chargeTime .
                ?receiver qudt:numericValue ?capacity .
                ?chargeTime qudt:numericValue ?time .
                FILTER (
                    (
                        ?time > 0.5 &&
                        EXISTS {
                            $this nltl:iceClass nltl:iceClassIaSuper ;
                                  nltl:propulsionEngineReversalRequiredForAstern true .
                        }
                    )
                    ||
                    (
                        ?time > 1.0 &&
                        !EXISTS {
                            $this nltl:iceClass nltl:iceClassIaSuper ;
                                  nltl:propulsionEngineReversalRequiredForAstern true .
                        }
                    )
                )
            }
        """
    ] .
