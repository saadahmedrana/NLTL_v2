@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:I2_002PolarClassApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A ship classified as Polar Class PC1-PC7 must have UR I1 compliance status true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:polarClass ?polarClass .
                FILTER (?polarClass IN (
                    nltl:polarClassPc1,
                    nltl:polarClassPc2,
                    nltl:polarClassPc3,
                    nltl:polarClassPc4,
                    nltl:polarClassPc5,
                    nltl:polarClassPc6,
                    nltl:polarClassPc7
                ))
                FILTER NOT EXISTS {
                    $this nltl:urI1ComplianceStatus "true"^^xsd:boolean .
                }
            }
        """
    ] .
