@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-011ApplicabilityReadinessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarClassValue ;
        sh:message "Polar Class is required to establish applicability of the bow design-force rule."
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Bulbous-bow status is required to establish applicability of the bow design-force rule."
    ] .

<urn:nltl:generated-shape:I2-011ApplicableBowForceShape>
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:polarClass ?polarClass ;
                    nltl:bulbousBowPresent true .
                FILTER (?polarClass IN (nltl:polarClassPc6, nltl:polarClassPc7))
            }
        """
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaN
            ]
        ] ;
        sh:message "The I2.3.2.1(iii) bow design force, with fa = 0.6 and AR = 1.3, is required in MN."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:MegaN
            ]
        ] ;
        sh:message "The I2.3.2.1(iv) bow design force is required in MN."
    ] ;
    sh:sparql [
        sh:message "The I2.3.2.1(iv) bow design force must not be less than the I2.3.2.1(iii) bow design force."
        ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?partIvForce ;
                      nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?partIiiForce .
                ?partIvForce qudt:numericValue ?partIvValue .
                ?partIiiForce qudt:numericValue ?partIiiValue .
                FILTER (?partIvValue < ?partIiiValue)
            }
        """
    ] .
