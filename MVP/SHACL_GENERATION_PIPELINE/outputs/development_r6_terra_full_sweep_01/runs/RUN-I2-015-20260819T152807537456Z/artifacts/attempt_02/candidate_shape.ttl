@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:I2-015ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node <urn:nltl:generated-shape:I2-015BowSubregionCaseShape>
    ] ;
    sh:sparql [
        sh:message "Applicable bow-subregion calculation cases require all formula operands, the linked lookup factors, and the reported bow shape coefficient in their required units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                    nltl:hasBowSubregionCalculationCase ?case .
                ?case a nltl:bowSubregionCalculationCase ;
                    nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability .
                FILTER NOT EXISTS {
                    ?case nltl:bowSubregionMidLengthPosition ?xQuantity ;
                          nltl:bowSubregionWaterlineAngle ?alphaQuantity ;
                          nltl:bowShapeCoefficient ?reportedQuantity ;
                          nltl:hasFailureClassFactorLookupCase ?lookup .
                    ?lookup a nltl:tableLookupCase ;
                            nltl:flexuralFailureClassFactor ?cffQuantity ;
                            nltl:crushingFailureClassFactor ?cfcQuantity .
                    $this nltl:betaIPrime ?betaQuantity ;
                          nltl:upperIceWaterlineLengthLUI ?luiQuantity ;
                          nltl:upperIceWaterlineDraughtDUI ?duiQuantity .
                    ?xQuantity a qudt:QuantityValue ;
                               qudt:numericValue ?x ;
                               qudt:unit unit:M .
                    ?alphaQuantity a qudt:QuantityValue ;
                                   qudt:numericValue ?alpha ;
                                   qudt:unit unit:DEG .
                    ?reportedQuantity a qudt:QuantityValue ;
                                      qudt:numericValue ?reported ;
                                      qudt:unit unit:UNITLESS .
                    ?cffQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?cff ;
                                 qudt:unit unit:UNITLESS .
                    ?cfcQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?cfc ;
                                 qudt:unit unit:UNITLESS .
                    ?betaQuantity a qudt:QuantityValue ;
                                  qudt:numericValue ?beta ;
                                  qudt:unit unit:UNITLESS .
                    ?luiQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?lui ;
                                 qudt:unit unit:M .
                    ?duiQuantity a qudt:QuantityValue ;
                                 qudt:numericValue ?dui ;
                                 qudt:unit unit:M .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable bow-subregion calculation cases have formula operands that make the specified bow shape coefficient calculation undefined." ;
        sh:select """
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                    nltl:hasBowSubregionCalculationCase ?case ;
                    nltl:betaIPrime ?betaQuantity ;
                    nltl:upperIceWaterlineLengthLUI ?luiQuantity ;
                    nltl:upperIceWaterlineDraughtDUI ?duiQuantity .
                ?case a nltl:bowSubregionCalculationCase ;
                      nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability ;
                      nltl:hasFailureClassFactorLookupCase ?lookup .
                ?lookup a nltl:tableLookupCase ;
                        nltl:crushingFailureClassFactor ?cfcQuantity .
                ?betaQuantity qudt:numericValue ?beta ;
                              qudt:unit unit:UNITLESS .
                ?luiQuantity qudt:numericValue ?lui ;
                             qudt:unit unit:M .
                ?duiQuantity qudt:numericValue ?dui ;
                             qudt:unit unit:M .
                ?cfcQuantity qudt:numericValue ?cfc ;
                             qudt:unit unit:UNITLESS .
                FILTER (
                    ?beta <= 0 ||
                    ?lui = 0 ||
                    ?dui <= 0 ||
                    ?cfc = 0 ||
                    math:sin(?beta) = 0
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "bowShapeCoefficient must equal min(f_ai1, f_ai2, 0.60) within relative tolerance 1e-6 and absolute tolerance 1e-9." ;
        sh:select """
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this a nltl:ship ;
                    nltl:hasBowSubregionCalculationCase ?case ;
                    nltl:betaIPrime ?betaQuantity ;
                    nltl:upperIceWaterlineLengthLUI ?luiQuantity ;
                    nltl:upperIceWaterlineDraughtDUI ?duiQuantity .
                ?case a nltl:bowSubregionCalculationCase ;
                      nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability ;
                      nltl:bowSubregionMidLengthPosition ?xQuantity ;
                      nltl:bowSubregionWaterlineAngle ?alphaQuantity ;
                      nltl:bowShapeCoefficient ?reportedQuantity ;
                      nltl:hasFailureClassFactorLookupCase ?lookup .
                ?lookup a nltl:tableLookupCase ;
                        nltl:flexuralFailureClassFactor ?cffQuantity ;
                        nltl:crushingFailureClassFactor ?cfcQuantity .
                ?xQuantity a qudt:QuantityValue ;
                           qudt:numericValue ?x ;
                           qudt:unit unit:M .
                ?alphaQuantity a qudt:QuantityValue ;
                               qudt:numericValue ?alpha ;
                               qudt:unit unit:DEG .
                ?reportedQuantity a qudt:QuantityValue ;
                                  qudt:numericValue ?reported ;
                                  qudt:unit unit:UNITLESS .
                ?cffQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?cff ;
                             qudt:unit unit:UNITLESS .
                ?cfcQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?cfc ;
                             qudt:unit unit:UNITLESS .
                ?betaQuantity a qudt:QuantityValue ;
                              qudt:numericValue ?beta ;
                              qudt:unit unit:UNITLESS .
                ?luiQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?lui ;
                             qudt:unit unit:M .
                ?duiQuantity a qudt:QuantityValue ;
                             qudt:numericValue ?dui ;
                             qudt:unit unit:M .
                FILTER(
                    ABS(
                        ?reported -
                        IF(
                            (0.097 - 0.68 * ((?x / ?lui - 0.15) * (?x / ?lui - 0.15))) * ?alpha / SQRT(?beta)
                            < 1.2 * ?cff / (math:sin(?beta) * ?cfc * math:pow(?dui, 0.64)),
                            IF(
                                (0.097 - 0.68 * ((?x / ?lui - 0.15) * (?x / ?lui - 0.15))) * ?alpha / SQRT(?beta) < 0.60,
                                (0.097 - 0.68 * ((?x / ?lui - 0.15) * (?x / ?lui - 0.15))) * ?alpha / SQRT(?beta),
                                0.60
                            ),
                            IF(
                                1.2 * ?cff / (math:sin(?beta) * ?cfc * math:pow(?dui, 0.64)) < 0.60,
                                1.2 * ?cff / (math:sin(?beta) * ?cfc * math:pow(?dui, 0.64)),
                                0.60
                            )
                        )
                    ) >
                    (
                        0.000000001 +
                        0.000001 * ABS(
                            IF(
                                (0.097 - 0.68 * ((?x / ?lui - 0.15) * (?x / ?lui - 0.15))) * ?alpha / SQRT(?beta)
                                < 1.2 * ?cff / (math:sin(?beta) * ?cfc * math:pow(?dui, 0.64)),
                                IF(
                                    (0.097 - 0.68 * ((?x / ?lui - 0.15) * (?x / ?lui - 0.15))) * ?alpha / SQRT(?beta) < 0.60,
                                    (0.097 - 0.68 * ((?x / ?lui - 0.15) * (?x / ?lui - 0.15))) * ?alpha / SQRT(?beta),
                                    0.60
                                ),
                                IF(
                                    1.2 * ?cff / (math:sin(?beta) * ?cfc * math:pow(?dui, 0.64)) < 0.60,
                                    1.2 * ?cff / (math:sin(?beta) * ?cfc * math:pow(?dui, 0.64)),
                                    0.60
                                )
                            )
                        )
                    )
                )
            }
        """
    ] .

<urn:nltl:generated-shape:I2-015BowSubregionCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:class nltl:bowFormApplicabilityValue
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:class nltl:tableLookupCase
    ] .
