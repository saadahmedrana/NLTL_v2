@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:LengthQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:ForceQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:LineLoadQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TableLookupCaseShape>
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:loadPatchDimensionClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape>
    ] .

<urn:nltl:generated-shape:NonBowIceLoadCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:nonBowIceLoadCalculationCase ;
    sh:property [
        sh:path nltl:shipDisplacementFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:nonBowIceForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:ForceQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:nonBowIceLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:LineLoadQuantityShape>
    ] .

<urn:nltl:generated-shape:I2_017NonBowIceLoadShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasNonBowIceLoadCalculationCase ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:upperIceWaterlineDraughtDUI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:LengthQuantityShape>
            ] ;
            sh:property [
                sh:path nltl:displacementFactorThreshold ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:LengthQuantityShape>
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TableLookupCaseShape>
            ] ;
            sh:property [
                sh:path nltl:hasNonBowIceLoadCalculationCase ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:NonBowIceLoadCalculationCaseShape>
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Each non-bow ice-load calculation case must report nonBowIceForce equal to 0.36 times crushingFailureClassFactor times shipDisplacementFactor, expressed in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this ?case
            WHERE {
                $this nltl:hasNonBowIceLoadCalculationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasTableLookupCase ?table .
                    ?table nltl:crushingFailureClassFactor ?cfcQuantity .
                    ?cfcQuantity qudt:numericValue ?cfc .
                    ?case nltl:shipDisplacementFactor ?dfQuantity ;
                          nltl:nonBowIceForce ?forceQuantity .
                    ?dfQuantity qudt:numericValue ?df .
                    ?forceQuantity qudt:numericValue ?force .
                    BIND ((360.0 * ?cfc * ?df) AS ?expectedForce)
                    FILTER (
                        ABS(?force - ?expectedForce) <=
                        (0.000000001 + (0.000001 * ABS(?expectedForce)))
                    )
                }
            }
        """
    ] .
