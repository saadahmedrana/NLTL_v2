@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_017_NonBowIceLoadShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:displacementFactorThreshold ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node [
            sh:class nltl:tableLookupCase ;
            sh:property [
                sh:path nltl:crushingFailureClassFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:loadPatchDimensionClassFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hasNonBowIceLoadCalculationCase ;
        sh:node [
            sh:class nltl:nonBowIceLoadCalculationCase ;
            sh:property [
                sh:path nltl:shipDisplacementFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:nonBowIceForce ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:nonBowIceLineLoad ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MegaN-M-PER-M2 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "Each non-bow ice load calculation case requires its ship inputs, lookup factors, and derived results." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this nltl:hasNonBowIceLoadCalculationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:upperIceWaterlineDraughtDUI ?dui ;
                          nltl:displacementFactorThreshold ?threshold ;
                          nltl:hasTableLookupCase ?table .
                    ?dui qudt:numericValue ?duiValue ;
                         qudt:unit unit:M .
                    ?threshold qudt:numericValue ?thresholdValue ;
                               qudt:unit unit:M .
                    ?table nltl:crushingFailureClassFactor ?cfc ;
                           nltl:loadPatchDimensionClassFactor ?cfd .
                    ?cfc qudt:numericValue ?cfcValue ;
                         qudt:unit unit:UNITLESS .
                    ?cfd qudt:numericValue ?cfdValue ;
                         qudt:unit unit:UNITLESS .
                    ?case nltl:shipDisplacementFactor ?df ;
                          nltl:nonBowIceForce ?force ;
                          nltl:nonBowIceLineLoad ?lineLoad .
                    ?df qudt:numericValue ?dfValue ;
                        qudt:unit unit:UNITLESS .
                    ?force qudt:numericValue ?forceValue ;
                           qudt:unit unit:KiloN .
                    ?lineLoad qudt:numericValue ?lineLoadValue ;
                              qudt:unit unit:MegaN-M-PER-M2 .
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "nonBowIceForce must equal 0.36 times crushingFailureClassFactor times shipDisplacementFactor, expressed in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:hasNonBowIceLoadCalculationCase ?case ;
                      nltl:hasTableLookupCase ?table .
                ?case nltl:shipDisplacementFactor ?df ;
                      nltl:nonBowIceForce ?force .
                ?table nltl:crushingFailureClassFactor ?cfc .
                ?df qudt:numericValue ?dfValue .
                ?force qudt:numericValue ?forceValue .
                ?cfc qudt:numericValue ?cfcValue .
                BIND((360.0 * ?cfcValue * ?dfValue) AS ?expectedForce)
                FILTER (
                    ABS(?forceValue - ?expectedForce) >
                    ((ABS(?expectedForce) * 0.000001) + 0.000000001)
                )
            }
        """
    ] .
