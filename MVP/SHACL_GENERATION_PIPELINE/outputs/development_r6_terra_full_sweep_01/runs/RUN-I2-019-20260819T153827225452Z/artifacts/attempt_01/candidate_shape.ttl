@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2_019_HullAreaFactorShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:hasSpannedHullArea ;
                        sh:maxCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:hasSpannedHullArea ;
                        sh:minCount 2 ;
                        sh:node [
                            sh:class nltl:benchmarkEntity ;
                            sh:property [
                                sh:path nltl:hullAreaFactor ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:node [
                                    sh:class qudt:QuantityValue ;
                                    sh:property [
                                        sh:path qudt:numericValue ;
                                        sh:datatype xsd:decimal ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ] ;
                                    sh:property [
                                        sh:path qudt:unit ;
                                        sh:hasValue unit:UNITLESS ;
                                        sh:minCount 1 ;
                                        sh:maxCount 1
                                    ]
                                ]
                            ]
                        ]
                    ] ;
                    sh:property [
                        sh:path nltl:spansHullArea ;
                        sh:minCount 2 ;
                        sh:message "A member spanning multiple hull areas must identify the hull areas spanned."
                    ] ;
                    sh:property [
                        sh:path nltl:selectedHullAreaFactor ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ] ;
                    sh:sparql [
                        sh:message "selectedHullAreaFactor must equal the largest hullAreaFactor of the hull areas spanned, within a relative tolerance of 1e-6 and an absolute fallback of 1e-12." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:selectedHullAreaFactor ?selectedQuantity ;
                                      nltl:hasSpannedHullArea ?area .
                                ?selectedQuantity qudt:numericValue ?selectedValue ;
                                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                ?area nltl:hullAreaFactor ?factorQuantity .
                                ?factorQuantity qudt:numericValue ?factorValue ;
                                                qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                FILTER NOT EXISTS {
                                    $this nltl:hasSpannedHullArea ?otherArea .
                                    ?otherArea nltl:hullAreaFactor ?otherFactorQuantity .
                                    ?otherFactorQuantity qudt:numericValue ?otherFactorValue ;
                                                         qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                                    FILTER (?otherFactorValue > ?factorValue)
                                }
                                FILTER (
                                    ABS(?selectedValue - ?factorValue) >
                                    (0.000001 * IF(ABS(?factorValue) > 0.000001,
                                                   ABS(?factorValue),
                                                   0.000001))
                                )
                            }
                        """
                    ]
                ]
            )
        ]
    ] .
