@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-024ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-024FramingAngleValueShape>
    ] ;
    sh:or (
        <urn:nltl:generated-shape:I2-024NonObliqueBranchShape>
        <urn:nltl:generated-shape:I2-024ObliqueBranchShape>
    ) .

<urn:nltl:generated-shape:I2-024FramingAngleValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-024NonObliqueBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:node [
            sh:or (
                [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 20.0
                    ]
                ]
                [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive 70.0
                    ]
                ]
            )
        ]
    ] .

<urn:nltl:generated-shape:I2-024ObliqueBranchShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:framingAngle ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minExclusive 20.0 ;
                sh:maxExclusive 70.0
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-024CalculationCaseShape> ;
        sh:message "Obliquely-framed plating requires interpolation calculation inputs."
    ] ;
    sh:property [
        sh:path nltl:hasObliquePlatingInterpolationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-024InterpolationCaseShape> ;
        sh:message "Obliquely-framed plating requires an interpolation case with an interpolated net plate thickness."
    ] .

<urn:nltl:generated-shape:I2-024CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:minCount 1 ;
        sh:class nltl:interpolationPoint
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:minCount 1 ;
        sh:class nltl:interpolationPoint
    ] ;
    sh:property [
        sh:path nltl:longitudinalFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-024MillimetreThicknessShape>
    ] ;
    sh:property [
        sh:path nltl:transverseFramingNetPlateThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-024MillimetreThicknessShape>
    ] .

<urn:nltl:generated-shape:I2-024InterpolationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:obliquePlatingInterpolationCase ;
    sh:property [
        sh:path nltl:interpolatedNetPlateThickness ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-024MillimetreThicknessShape>
    ] .

<urn:nltl:generated-shape:I2-024MillimetreThicknessShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
