@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:MillimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:MetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:SquareCentimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:CubicCentimetreQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:DegreeQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:InterpolationResultQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:LocalFrameMemberShape>
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:node <urn:nltl:generated-shape:SquareCentimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node <urn:nltl:generated-shape:MetreQuantityShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node <urn:nltl:generated-shape:DegreeQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node <urn:nltl:generated-shape:CubicCentimetreQuantityShape>
    ] .

<urn:nltl:generated-shape:LocalFramePlatingShape>
    a sh:NodeShape ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node <urn:nltl:generated-shape:DegreeQuantityShape>
    ] .

<urn:nltl:generated-shape:InterpolationPointShape>
    a sh:NodeShape ;
    sh:class nltl:interpolationPoint ;
    sh:property [
        sh:path nltl:interpolationPointCoordinate ;
        sh:node <urn:nltl:generated-shape:UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationPointResult ;
        sh:node <urn:nltl:generated-shape:InterpolationResultQuantityShape>
    ] .

<urn:nltl:generated-shape:LocalFrameCalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:localFrameSectionCalculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node <urn:nltl:generated-shape:LocalFrameMemberShape> ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:class nltl:plating ;
        sh:node <urn:nltl:generated-shape:LocalFramePlatingShape>
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node <urn:nltl:generated-shape:MillimetreQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationLowerEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:InterpolationPointShape>
    ] ;
    sh:property [
        sh:path nltl:interpolationUpperEndpoint ;
        sh:class nltl:interpolationPoint ;
        sh:node <urn:nltl:generated-shape:InterpolationPointShape>
    ] .

<urn:nltl:generated-shape:I2_030Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:localFrameSectionCalculationCase ;
        sh:node <urn:nltl:generated-shape:LocalFrameCalculationCaseShape>
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:node [
            sh:property [
                sh:path nltl:hasLocalFrameSectionCalculationCase ;
                sh:class nltl:localFrameSectionCalculationCase ;
                sh:node <urn:nltl:generated-shape:LocalFrameCalculationCaseShape>
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Each local-frame section calculation case must be linked to the ship as its calculation case." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasLocalFrameSectionCalculationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasCalculationCase ?case .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each ship calculation case for this requirement must be an actual local-frame section calculation case of a linked structural member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:hasStructuralMember ?member .
                    ?member nltl:hasLocalFrameSectionCalculationCase ?case .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The applicable local-frame calculation requires the reported z_na and Z_p inputs, results, and framing angle in their required units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:sectionCalculationCaseStructuralMember ?member .
                ?member nltl:netLocalFrameFlangeArea ?aQ ;
                        nltl:netAttachedShellPlateThickness ?tpQ ;
                        nltl:frameSpacing ?sQ .
                ?aQ qudt:numericValue ?a ;
                    qudt:unit unit:CentiM2 .
                ?tpQ qudt:numericValue ?tp ;
                     qudt:unit unit:MilliM .
                ?sQ qudt:numericValue ?s ;
                    qudt:unit unit:M .
                FILTER (
                    datatype(?a) = xsd:decimal &&
                    datatype(?tp) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    100 * ?a > 1000 * ?tp * ?s
                )
                FILTER NOT EXISTS {
                    ?case nltl:sectionCalculationCasePlating ?plating ;
                          nltl:plasticNeutralAxisHeight ?zQ .
                    ?plating nltl:framingAngleOmega ?omegaQ .
                    ?member nltl:webHeight ?hwQ ;
                            nltl:netWebThickness ?twQ ;
                            nltl:localFrameFlangeCentreHeight ?hfcQ ;
                            nltl:webAngleToShellPlate ?phiQ ;
                            nltl:webToFlangeCentreDistance ?bwQ ;
                            nltl:netEffectivePlasticSectionModulus ?zpQ .
                    ?zQ qudt:numericValue ?z ;
                        qudt:unit unit:MilliM .
                    ?omegaQ qudt:numericValue ?omega ;
                            qudt:unit unit:DEG .
                    ?hwQ qudt:numericValue ?hw ;
                         qudt:unit unit:MilliM .
                    ?twQ qudt:numericValue ?tw ;
                         qudt:unit unit:MilliM .
                    ?hfcQ qudt:numericValue ?hfc ;
                          qudt:unit unit:MilliM .
                    ?phiQ qudt:numericValue ?phi ;
                          qudt:unit unit:DEG .
                    ?bwQ qudt:numericValue ?bw ;
                         qudt:unit unit:MilliM .
                    ?zpQ qudt:numericValue ?zp ;
                         qudt:unit unit:CentiM3 .
                    FILTER (
                        datatype(?z) = xsd:decimal &&
                        datatype(?omega) = xsd:decimal &&
                        datatype(?hw) = xsd:decimal &&
                        datatype(?tw) = xsd:decimal &&
                        datatype(?hfc) = xsd:decimal &&
                        datatype(?phi) = xsd:decimal &&
                        datatype(?bw) = xsd:decimal &&
                        datatype(?zp) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Reported plasticNeutralAxisHeight must equal the applicable z_na formula within relative tolerance 1e-6 and absolute fallback 1e-9 mm." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:plasticNeutralAxisHeight ?zQ .
                ?member nltl:netLocalFrameFlangeArea ?aQ ;
                        nltl:netAttachedShellPlateThickness ?tpQ ;
                        nltl:frameSpacing ?sQ ;
                        nltl:webHeight ?hwQ ;
                        nltl:netWebThickness ?twQ .
                ?aQ qudt:numericValue ?a ; qudt:unit unit:CentiM2 .
                ?tpQ qudt:numericValue ?tp ; qudt:unit unit:MilliM .
                ?sQ qudt:numericValue ?s ; qudt:unit unit:M .
                ?hwQ qudt:numericValue ?hw ; qudt:unit unit:MilliM .
                ?twQ qudt:numericValue ?tw ; qudt:unit unit:MilliM .
                ?zQ qudt:numericValue ?z ; qudt:unit unit:MilliM .
                FILTER (
                    datatype(?a) = xsd:decimal &&
                    datatype(?tp) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    datatype(?hw) = xsd:decimal &&
                    datatype(?tw) = xsd:decimal &&
                    datatype(?z) = xsd:decimal &&
                    100 * ?a > 1000 * ?tp * ?s &&
                    ?tw != 0
                )
                BIND ((100 * ?a + ?hw * ?tw - 1000 * ?tp * ?s) / (2 * ?tw) AS ?expected)
                FILTER (ABS(?z - ?expected) > (0.000001 * IF(ABS(?expected) > 0.000000001, ABS(?expected), 0.000000001)))
            }
        """
    ] ;
    sh:sparql [
        sh:message "Oblique framing requires lower and upper interpolation endpoints with coordinates and results." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:sectionCalculationCasePlating ?plating .
                ?member nltl:netLocalFrameFlangeArea ?aQ ;
                        nltl:netAttachedShellPlateThickness ?tpQ ;
                        nltl:frameSpacing ?sQ .
                ?plating nltl:framingAngleOmega ?omegaQ .
                ?aQ qudt:numericValue ?a ; qudt:unit unit:CentiM2 .
                ?tpQ qudt:numericValue ?tp ; qudt:unit unit:MilliM .
                ?sQ qudt:numericValue ?s ; qudt:unit unit:M .
                ?omegaQ qudt:numericValue ?omega ; qudt:unit unit:DEG .
                FILTER (
                    datatype(?a) = xsd:decimal &&
                    datatype(?tp) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    datatype(?omega) = xsd:decimal &&
                    100 * ?a > 1000 * ?tp * ?s &&
                    ?omega > 20 && ?omega < 70
                )
                FILTER NOT EXISTS {
                    ?case nltl:interpolationLowerEndpoint ?lower ;
                          nltl:interpolationUpperEndpoint ?upper .
                    ?lower nltl:interpolationPointCoordinate ?lowerCoordQ ;
                           nltl:interpolationPointResult ?lowerResultQ .
                    ?upper nltl:interpolationPointCoordinate ?upperCoordQ ;
                           nltl:interpolationPointResult ?upperResultQ .
                    ?lowerCoordQ qudt:numericValue ?lowerCoord ;
                                 qudt:unit unit:UNITLESS .
                    ?upperCoordQ qudt:numericValue ?upperCoord ;
                                 qudt:unit unit:UNITLESS .
                    ?lowerResultQ qudt:numericValue ?lowerResult .
                    ?upperResultQ qudt:numericValue ?upperResult .
                    FILTER (
                        datatype(?lowerCoord) = xsd:decimal &&
                        datatype(?upperCoord) = xsd:decimal &&
                        datatype(?lowerResult) = xsd:decimal &&
                        datatype(?upperResult) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Oblique interpolation endpoints must satisfy lowerCoordinate < Omega < upperCoordinate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:sectionCalculationCasePlating ?plating ;
                      nltl:interpolationLowerEndpoint ?lower ;
                      nltl:interpolationUpperEndpoint ?upper .
                ?member nltl:netLocalFrameFlangeArea ?aQ ;
                        nltl:netAttachedShellPlateThickness ?tpQ ;
                        nltl:frameSpacing ?sQ .
                ?plating nltl:framingAngleOmega ?omegaQ .
                ?lower nltl:interpolationPointCoordinate ?lowerCoordQ .
                ?upper nltl:interpolationPointCoordinate ?upperCoordQ .
                ?aQ qudt:numericValue ?a ; qudt:unit unit:CentiM2 .
                ?tpQ qudt:numericValue ?tp ; qudt:unit unit:MilliM .
                ?sQ qudt:numericValue ?s ; qudt:unit unit:M .
                ?omegaQ qudt:numericValue ?omega ; qudt:unit unit:DEG .
                ?lowerCoordQ qudt:numericValue ?lowerCoord ; qudt:unit unit:UNITLESS .
                ?upperCoordQ qudt:numericValue ?upperCoord ; qudt:unit unit:UNITLESS .
                FILTER (
                    datatype(?a) = xsd:decimal &&
                    datatype(?tp) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    datatype(?omega) = xsd:decimal &&
                    datatype(?lowerCoord) = xsd:decimal &&
                    datatype(?upperCoord) = xsd:decimal &&
                    100 * ?a > 1000 * ?tp * ?s &&
                    ?omega > 20 && ?omega < 70
                )
                FILTER (!(?lowerCoord < ?omega && ?omega < ?upperCoord))
            }
        """
    ] ;
    sh:sparql [
        sh:message "For non-oblique framing, netEffectivePlasticSectionModulus must equal the Z_p formula using the reported plasticNeutralAxisHeight, within relative tolerance 1e-6 and absolute fallback 1e-9 cm3." ;
        sh:select """
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:sectionCalculationCasePlating ?plating ;
                      nltl:plasticNeutralAxisHeight ?zQ .
                ?plating nltl:framingAngleOmega ?omegaQ .
                ?member nltl:netLocalFrameFlangeArea ?aQ ;
                        nltl:netAttachedShellPlateThickness ?tpQ ;
                        nltl:frameSpacing ?sQ ;
                        nltl:webHeight ?hwQ ;
                        nltl:netWebThickness ?twQ ;
                        nltl:localFrameFlangeCentreHeight ?hfcQ ;
                        nltl:webAngleToShellPlate ?phiQ ;
                        nltl:webToFlangeCentreDistance ?bwQ ;
                        nltl:netEffectivePlasticSectionModulus ?zpQ .
                ?zQ qudt:numericValue ?z ; qudt:unit unit:MilliM .
                ?omegaQ qudt:numericValue ?omega ; qudt:unit unit:DEG .
                ?aQ qudt:numericValue ?a ; qudt:unit unit:CentiM2 .
                ?tpQ qudt:numericValue ?tp ; qudt:unit unit:MilliM .
                ?sQ qudt:numericValue ?s ; qudt:unit unit:M .
                ?hwQ qudt:numericValue ?hw ; qudt:unit unit:MilliM .
                ?twQ qudt:numericValue ?tw ; qudt:unit unit:MilliM .
                ?hfcQ qudt:numericValue ?hfc ; qudt:unit unit:MilliM .
                ?phiQ qudt:numericValue ?phi ; qudt:unit unit:DEG .
                ?bwQ qudt:numericValue ?bw ; qudt:unit unit:MilliM .
                ?zpQ qudt:numericValue ?zp ; qudt:unit unit:CentiM3 .
                FILTER (
                    datatype(?z) = xsd:decimal &&
                    datatype(?omega) = xsd:decimal &&
                    datatype(?a) = xsd:decimal &&
                    datatype(?tp) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    datatype(?hw) = xsd:decimal &&
                    datatype(?tw) = xsd:decimal &&
                    datatype(?hfc) = xsd:decimal &&
                    datatype(?phi) = xsd:decimal &&
                    datatype(?bw) = xsd:decimal &&
                    datatype(?zp) = xsd:decimal &&
                    100 * ?a > 1000 * ?tp * ?s &&
                    (?omega <= 20 || ?omega >= 70)
                )
                BIND ((?phi * 3.141592653589793 / 180.0) AS ?phiRadians)
                BIND (
                    ?tp * ?s * (?z + ?tp / 2.0) * math:sin(?phiRadians) +
                    (((?hw - ?z) * (?hw - ?z) + ?z * ?z) * ?tw * math:sin(?phiRadians)) / 2000.0 +
                    ?a * ((?hfc - ?z) * math:sin(?phiRadians) - ?bw * math:cos(?phiRadians)) / 10.0
                    AS ?expected
                )
                FILTER (ABS(?zp - ?expected) > (0.000001 * IF(ABS(?expected) > 0.000000001, ABS(?expected), 0.000000001)))
            }
        """
    ] ;
    sh:sparql [
        sh:message "For oblique framing, netEffectivePlasticSectionModulus must equal the linear interpolation result within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:sectionCalculationCasePlating ?plating ;
                      nltl:interpolationLowerEndpoint ?lower ;
                      nltl:interpolationUpperEndpoint ?upper .
                ?member nltl:netLocalFrameFlangeArea ?aQ ;
                        nltl:netAttachedShellPlateThickness ?tpQ ;
                        nltl:frameSpacing ?sQ ;
                        nltl:netEffectivePlasticSectionModulus ?zpQ .
                ?plating nltl:framingAngleOmega ?omegaQ .
                ?lower nltl:interpolationPointCoordinate ?lowerCoordQ ;
                       nltl:interpolationPointResult ?lowerResultQ .
                ?upper nltl:interpolationPointCoordinate ?upperCoordQ ;
                       nltl:interpolationPointResult ?upperResultQ .
                ?aQ qudt:numericValue ?a ; qudt:unit unit:CentiM2 .
                ?tpQ qudt:numericValue ?tp ; qudt:unit unit:MilliM .
                ?sQ qudt:numericValue ?s ; qudt:unit unit:M .
                ?zpQ qudt:numericValue ?zp ; qudt:unit unit:CentiM3 .
                ?omegaQ qudt:numericValue ?omega ; qudt:unit unit:DEG .
                ?lowerCoordQ qudt:numericValue ?lowerCoord ; qudt:unit unit:UNITLESS .
                ?upperCoordQ qudt:numericValue ?upperCoord ; qudt:unit unit:UNITLESS .
                ?lowerResultQ qudt:numericValue ?lowerResult .
                ?upperResultQ qudt:numericValue ?upperResult .
                FILTER (
                    datatype(?a) = xsd:decimal &&
                    datatype(?tp) = xsd:decimal &&
                    datatype(?s) = xsd:decimal &&
                    datatype(?zp) = xsd:decimal &&
                    datatype(?omega) = xsd:decimal &&
                    datatype(?lowerCoord) = xsd:decimal &&
                    datatype(?upperCoord) = xsd:decimal &&
                    datatype(?lowerResult) = xsd:decimal &&
                    datatype(?upperResult) = xsd:decimal &&
                    100 * ?a > 1000 * ?tp * ?s &&
                    ?omega > 20 && ?omega < 70 &&
                    ?lowerCoord < ?omega && ?omega < ?upperCoord
                )
                BIND (
                    ?lowerResult + ((?omega - ?lowerCoord) * (?upperResult - ?lowerResult) / (?upperCoord - ?lowerCoord))
                    AS ?expected
                )
                FILTER (ABS(?zp - ?expected) > (0.000001 * IF(ABS(?expected) > 0.000000001, ABS(?expected), 0.000000001)))
            }
        """
    ] .
