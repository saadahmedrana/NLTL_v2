@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MegaPAQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareMetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SquareCentimetreQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:I2_032StructuralMemberShape a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:selectedHullAreaFactor ;
        sh:minCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredTransverseFrameShearArea ;
        sh:minCount 1 ;
        sh:node gs:SquareCentimetreQuantityShape
    ] .

gs:I2_032Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node gs:MegaPAQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadPatchHeight ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:minCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:node gs:SquareMetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gs:MegaPAQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node gs:I2_032StructuralMemberShape
    ] ;
    sh:sparql [
        sh:message "For each structural member, requiredTransverseFrameShearArea must match the I2.6.2 formula and shearArea must be at least that required area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member ;
                      nltl:averageIcePressure ?averagePressureQ ;
                      nltl:frameSpan ?frameSpanQ ;
                      nltl:loadPatchHeight ?loadPatchHeightQ ;
                      nltl:peakPressureFactor ?peakPressureFactorQ ;
                      nltl:shearArea ?shearAreaQ ;
                      nltl:yieldStrength ?yieldStrengthQ .

                ?member nltl:frameSpacing ?frameSpacingQ ;
                        nltl:selectedHullAreaFactor ?areaFactorQ ;
                        nltl:requiredTransverseFrameShearArea ?requiredAreaQ .

                ?averagePressureQ qudt:numericValue ?averagePressure .
                ?frameSpanQ qudt:numericValue ?frameSpan .
                ?loadPatchHeightQ qudt:numericValue ?loadPatchHeight .
                ?peakPressureFactorQ qudt:numericValue ?peakPressureFactor .
                ?shearAreaQ qudt:numericValue ?actualShearArea .
                ?yieldStrengthQ qudt:numericValue ?yieldStrength .
                ?frameSpacingQ qudt:numericValue ?frameSpacing .
                ?areaFactorQ qudt:numericValue ?areaFactor .
                ?requiredAreaQ qudt:numericValue ?requiredShearArea .

                BIND(
                    IF(?frameSpan <= ?loadPatchHeight, ?frameSpan, ?loadPatchHeight)
                    AS ?lesserLength
                )
                BIND(
                    (5000.0 * ?lesserLength * ?frameSpacing *
                     (?areaFactor * ?peakPressureFactor * ?averagePressure)) /
                    (0.577 * ?yieldStrength)
                    AS ?expectedRequiredShearArea
                )
                BIND(
                    (ABS(?expectedRequiredShearArea) * 0.000001 + 0.000000001)
                    AS ?formulaTolerance
                )

                FILTER(
                    ABS(?requiredShearArea - ?expectedRequiredShearArea) > ?formulaTolerance ||
                    (?actualShearArea * 10000.0) < ?requiredShearArea
                )
            }
        """
    ] .
