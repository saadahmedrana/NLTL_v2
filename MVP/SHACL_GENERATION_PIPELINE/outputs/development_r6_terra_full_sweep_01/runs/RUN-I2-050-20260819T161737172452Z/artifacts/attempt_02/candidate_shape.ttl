@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ForceQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:DimensionlessQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:AngleQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TableLookupCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:longitudinalStrengthClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] .

gs:I2_050_DesignVerticalIceForceAtBowShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateOne ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateTwo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:ForceQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hullFormCoefficientKh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceStrengthCoefficientKI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AngleQuantityShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:class nltl:tableLookupCase ;
        sh:node gs:TableLookupCaseShape
    ] ;
    sh:sparql [
        sh:message "designVerticalIceForceAtBowCandidateTwo must equal 1.20 times the flexural failure class factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case ;
                      nltl:designVerticalIceForceAtBowCandidateTwo ?fib2Quantity .
                ?case nltl:flexuralFailureClassFactor ?cffQuantity .
                ?fib2Quantity qudt:numericValue ?fib2 .
                ?cffQuantity qudt:numericValue ?cff .
                BIND((1.20 * ?cff) AS ?expectedFib2)
                BIND(ABS(?fib2 - ?expectedFib2) AS ?difference)
                BIND((0.000000001 + (0.000001 * ABS(?expectedFib2))) AS ?tolerance)
                FILTER(?difference > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "designVerticalIceForceAtBow must equal the minimum of the two design vertical ice force candidates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?fibQuantity ;
                      nltl:designVerticalIceForceAtBowCandidateOne ?fib1Quantity ;
                      nltl:designVerticalIceForceAtBowCandidateTwo ?fib2Quantity .
                ?fibQuantity qudt:numericValue ?fib .
                ?fib1Quantity qudt:numericValue ?fib1 .
                ?fib2Quantity qudt:numericValue ?fib2 .
                BIND(IF(?fib1 <= ?fib2, ?fib1, ?fib2) AS ?expectedFib)
                BIND(ABS(?fib - ?expectedFib) AS ?difference)
                BIND((0.000000001 + (0.000001 * ABS(?expectedFib))) AS ?tolerance)
                FILTER(?difference > ?tolerance)
            }
        """
    ] .
