@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ForceValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessValueShape
    ] ;
    sh:property [
        sh:path nltl:longitudinalStrengthClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessValueShape
    ] .

gen:I2_050DesignVerticalIceForceAtBowShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ForceValueShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateOne ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ForceValueShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateTwo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:ForceValueShape
    ] ;
    sh:property [
        sh:path nltl:iceStrengthCoefficientKI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessValueShape
    ] ;
    sh:property [
        sh:path nltl:hullFormCoefficientKh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessValueShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:LengthValueShape
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:AngleValueShape
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:minCount 1 ;
        sh:node gen:TableLookupCaseShape
    ] ;
    sh:sparql [
        sh:message "designVerticalIceForceAtBowCandidateOne must conform to the F_IB1 formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBowCandidateOne ?fib1q ;
                      nltl:iceStrengthCoefficientKI ?kiq ;
                      nltl:hullFormCoefficientKh ?khq ;
                      nltl:upperIceWaterlineDraughtDUI ?duiq ;
                      nltl:stemAngle ?angleq ;
                      nltl:hasTableLookupCase ?case .
                ?fib1q qudt:numericValue ?fib1 .
                ?kiq qudt:numericValue ?ki .
                ?khq qudt:numericValue ?kh .
                ?duiq qudt:numericValue ?dui .
                ?angleq qudt:numericValue ?angle .
                ?case nltl:longitudinalStrengthClassFactor ?cflq .
                ?cflq qudt:numericValue ?cfl .
                BIND(math:sin((?angle * 3.141592653589793) / 180.0) AS ?s)
                BIND((?dui * ?kh) AS ?dk)
                BIND(0.534 AS ?a)
                BIND(
                    (?a * ?a * ?a * ?a * ?a * ?a * ?a * ?a * ?a * ?a *
                     ?a * ?a * ?a * ?a * ?a * ?a * ?a * ?a * ?a * ?a) *
                    (?ki * ?ki * ?ki) *
                    (?s * ?s * ?s * ?s) *
                    (?dk * ?dk * ?dk * ?dk * ?dk * ?dk * ?dk * ?dk * ?dk * ?dk) *
                    (?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl *
                     ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl * ?cfl)
                    AS ?expectedPower
                )
                BIND(
                    ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 *
                    ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1 * ?fib1
                    AS ?reportedPower
                )
                BIND((ABS(?expectedPower) * 0.0000200001900013) + 0.000000000000000001 AS ?upperTolerance)
                BIND((ABS(?expectedPower) * 0.0000199998100011) + 0.000000000000000001 AS ?lowerTolerance)
                FILTER(
                    ?reportedPower > (?expectedPower + ?upperTolerance) ||
                    ?reportedPower < (?expectedPower - ?lowerTolerance)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "designVerticalIceForceAtBowCandidateTwo must equal 1.20 times the flexural failure class factor." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBowCandidateTwo ?fib2q ;
                      nltl:hasTableLookupCase ?case .
                ?fib2q qudt:numericValue ?fib2 .
                ?case nltl:flexuralFailureClassFactor ?cffq .
                ?cffq qudt:numericValue ?cff .
                BIND((1.20 * ?cff) AS ?expectedFib2)
                BIND((ABS(?expectedFib2) * 0.000001) + 0.000000001 AS ?tolerance)
                FILTER(ABS(?fib2 - ?expectedFib2) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "designVerticalIceForceAtBow must equal the minimum of the two design vertical ice force candidates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?fibq ;
                      nltl:designVerticalIceForceAtBowCandidateOne ?fib1q ;
                      nltl:designVerticalIceForceAtBowCandidateTwo ?fib2q .
                ?fibq qudt:numericValue ?fib .
                ?fib1q qudt:numericValue ?fib1 .
                ?fib2q qudt:numericValue ?fib2 .
                BIND(IF(?fib1 <= ?fib2, ?fib1, ?fib2) AS ?expectedFib)
                BIND((ABS(?expectedFib) * 0.000001) + 0.000000001 AS ?tolerance)
                FILTER(ABS(?fib - ?expectedFib) > ?tolerance)
            }
        """
    ] .
