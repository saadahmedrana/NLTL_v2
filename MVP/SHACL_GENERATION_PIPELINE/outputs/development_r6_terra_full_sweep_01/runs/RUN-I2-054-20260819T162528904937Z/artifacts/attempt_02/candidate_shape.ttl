@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipOperandsShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

gs:HullGirderBendingMomentCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:caseHullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:caseBendingMomentDistributionFactor ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:caseDesignVerticalIceBendingMoment ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaN-M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path [ sh:inversePath nltl:hasHullGirderBendingMomentCalculationCase ] ;
        sh:node gs:ShipOperandsShape
    ] ;
    sh:sparql [
        sh:message "Hull-girder position, upper ice waterline length, and stem angle must permit the required bending-moment calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:caseHullGirderLongitudinalPositionFromAft ?position .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit unit:M .
                ?ship nltl:hasHullGirderBendingMomentCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?length ;
                      nltl:stemAngle ?angle .
                ?length qudt:numericValue ?lengthValue ;
                        qudt:unit unit:M .
                ?angle qudt:numericValue ?angleValue ;
                       qudt:unit unit:DEG .
                BIND(math:sin(?angleValue * 0.017453292519943295) AS ?sine)
                FILTER(?positionValue < 0 || ?positionValue > ?lengthValue ||
                       ?lengthValue <= 0 || ?sine <= 0)
            }
        """
    ] ;
    sh:sparql [
        sh:message "caseBendingMomentDistributionFactor must follow the specified longitudinal distribution." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:caseHullGirderLongitudinalPositionFromAft ?position ;
                      nltl:caseBendingMomentDistributionFactor ?factor .
                ?position qudt:numericValue ?positionValue ;
                          qudt:unit unit:M .
                ?factor qudt:numericValue ?factorValue ;
                        qudt:unit unit:UNITLESS .
                ?ship nltl:hasHullGirderBendingMomentCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?length .
                ?length qudt:numericValue ?lengthValue ;
                        qudt:unit unit:M .
                FILTER(?lengthValue > 0 && ?positionValue >= 0 && ?positionValue <= ?lengthValue)
                BIND(?positionValue / ?lengthValue AS ?relativePosition)
                BIND(
                    IF(?relativePosition <= 0.5,
                       2.0 * ?relativePosition,
                       IF(?relativePosition <= 0.7,
                          1.0,
                          IF(?relativePosition <= 0.95,
                             1.0 - 2.8 * (?relativePosition - 0.7),
                             0.3 - 6.0 * (?relativePosition - 0.95)
                          )
                       )
                    )
                    AS ?expectedFactor
                )
                FILTER(
                    ABS(?factorValue - ?expectedFactor) >
                    (0.000000001 + 0.000001 * ABS(?expectedFactor))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "caseDesignVerticalIceBendingMoment must equal 0.1 times C_m times L_UI times sin(stemAngle)^(-0.2) times F_IB within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:caseBendingMomentDistributionFactor ?factor ;
                      nltl:caseDesignVerticalIceBendingMoment ?moment .
                ?factor qudt:numericValue ?factorValue ;
                        qudt:unit unit:UNITLESS .
                ?moment qudt:numericValue ?reportedMoment ;
                        qudt:unit unit:MegaN-M .
                ?ship nltl:hasHullGirderBendingMomentCalculationCase $this ;
                      nltl:upperIceWaterlineLengthLUI ?length ;
                      nltl:stemAngle ?angle ;
                      nltl:designVerticalIceForceAtBow ?force .
                ?length qudt:numericValue ?lengthValue ;
                        qudt:unit unit:M .
                ?angle qudt:numericValue ?angleValue ;
                       qudt:unit unit:DEG .
                ?force qudt:numericValue ?forceValue ;
                       qudt:unit unit:MegaN .
                BIND(math:sin(?angleValue * 0.017453292519943295) AS ?sine)
                FILTER(?sine > 0)
                BIND(
                    0.1 * ?factorValue * ?lengthValue *
                    math:exp(-0.2 * math:log(?sine)) * ?forceValue
                    AS ?expectedMoment
                )
                FILTER(
                    ABS(?reportedMoment - ?expectedMoment) >
                    (0.000000001 + 0.000001 * ABS(?expectedMoment))
                )
            }
        """
    ] .

gs:I2_054Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasHullGirderBendingMomentCalculationCase ;
        sh:node gs:HullGirderBendingMomentCalculationCaseShape
    ] .
