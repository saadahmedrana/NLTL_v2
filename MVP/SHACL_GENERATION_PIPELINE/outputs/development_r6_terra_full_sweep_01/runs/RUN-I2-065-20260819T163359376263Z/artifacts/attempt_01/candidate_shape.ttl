@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2_065ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node gs:I2_065CalculationCaseShape
    ] .

gs:I2_065CalculationCaseShape
    a sh:NodeShape ;
    sh:or (
        gs:I2_065NonlinearCalculationCaseShape
        gs:I2_065DirectCalculationCaseShape
        gs:I2_065PrescribedProcedureCalculationCaseShape
    ) .

gs:I2_065NonlinearCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:nonlinearCalculationMethodValue
    ] ;
    sh:property [
        sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:message "A nonlinear calculation case requires nonlinear analysis acceptance evidence."
    ] ;
    sh:property [
        sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "A nonlinear calculation case must record that the minor permanent deformation assessment is satisfied."
    ] ;
    sh:property [
        sh:path nltl:permanentLateralDeformation ;
        sh:minCount 1 ;
        sh:node gs:I2_065MillimetreQuantityShape ;
        sh:message "A nonlinear calculation case requires permanent lateral deformation."
    ] ;
    sh:property [
        sh:path nltl:permanentOutOfPlaneDeformation ;
        sh:minCount 1 ;
        sh:node gs:I2_065MillimetreQuantityShape ;
        sh:message "A nonlinear calculation case requires permanent out-of-plane deformation."
    ] ;
    sh:property [
        sh:path nltl:relevantStructuralDimension ;
        sh:minCount 1 ;
        sh:node gs:I2_065MillimetreQuantityShape ;
        sh:message "A nonlinear calculation case requires the relevant structural dimension."
    ] ;
    sh:property [
        sh:path [
            sh:inversePath nltl:hasCalculationCase
        ] ;
        sh:node gs:I2_065ShipMarginShape
    ] .

gs:I2_065DirectCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:directCalculationMethodValue
    ] .

gs:I2_065PrescribedProcedureCalculationCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:prescribedAnalyticalProcedure
    ] .

gs:I2_065ShipMarginShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fractureMargin ;
        sh:minCount 1 ;
        sh:node gs:I2_065UnitlessQuantityShape ;
        sh:message "A ship evaluated by nonlinear calculation requires a fracture margin."
    ] ;
    sh:property [
        sh:path nltl:majorBucklingMargin ;
        sh:minCount 1 ;
        sh:node gs:I2_065UnitlessQuantityShape ;
        sh:message "A ship evaluated by nonlinear calculation requires a major buckling margin."
    ] ;
    sh:property [
        sh:path nltl:yieldingMargin ;
        sh:minCount 1 ;
        sh:node gs:I2_065UnitlessQuantityShape ;
        sh:message "A ship evaluated by nonlinear calculation requires a yielding margin."
    ] .

gs:I2_065MillimetreQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

gs:I2_065UnitlessQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
