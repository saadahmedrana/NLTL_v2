@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-065QuantityMilliMShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-065QuantityUnitlessShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:I2-065NonlinearCalculationCaseShape>
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:calculationMethod ;
                sh:hasValue nltl:nonlinearCalculationMethodValue
            ] ;
            sh:property [
                sh:path nltl:nonlinearAnalysisAcceptanceEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "A nonlinear calculation case requires nonlinear analysis acceptance evidence."
            ] ;
            sh:property [
                sh:path nltl:minorPermanentDeformationAssessmentSatisfied ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:minCount 1 ;
                sh:message "A nonlinear calculation case requires a satisfied minor permanent deformation assessment."
            ] ;
            sh:property [
                sh:path nltl:permanentLateralDeformation ;
                sh:node <urn:nltl:generated-shape:I2-065QuantityMilliMShape> ;
                sh:minCount 1 ;
                sh:message "A nonlinear calculation case requires permanent lateral deformation in mm."
            ] ;
            sh:property [
                sh:path nltl:permanentOutOfPlaneDeformation ;
                sh:node <urn:nltl:generated-shape:I2-065QuantityMilliMShape> ;
                sh:minCount 1 ;
                sh:message "A nonlinear calculation case requires permanent out-of-plane deformation in mm."
            ] ;
            sh:property [
                sh:path nltl:relevantStructuralDimension ;
                sh:node <urn:nltl:generated-shape:I2-065QuantityMilliMShape> ;
                sh:minCount 1 ;
                sh:message "A nonlinear calculation case requires the relevant structural dimension in mm."
            ]
        ]
        [
            sh:not [
                sh:property [
                    sh:path nltl:calculationMethod ;
                    sh:hasValue nltl:nonlinearCalculationMethodValue
                ]
            ]
        ]
    ) .

<urn:nltl:generated-shape:I2-065ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:node <urn:nltl:generated-shape:I2-065NonlinearCalculationCaseShape>
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:hasCalculationCase ;
                    sh:qualifiedValueShape [
                        sh:property [
                            sh:path nltl:calculationMethod ;
                            sh:hasValue nltl:nonlinearCalculationMethodValue
                        ]
                    ] ;
                    sh:qualifiedMinCount 1
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:fractureMargin ;
                sh:node <urn:nltl:generated-shape:I2-065QuantityUnitlessShape> ;
                sh:minCount 1 ;
                sh:message "A ship with a nonlinear calculation case requires a fracture margin."
            ] ;
            sh:property [
                sh:path nltl:majorBucklingMargin ;
                sh:node <urn:nltl:generated-shape:I2-065QuantityUnitlessShape> ;
                sh:minCount 1 ;
                sh:message "A ship with a nonlinear calculation case requires a major buckling margin."
            ] ;
            sh:property [
                sh:path nltl:yieldingMargin ;
                sh:node <urn:nltl:generated-shape:I2-065QuantityUnitlessShape> ;
                sh:minCount 1 ;
                sh:message "A ship with a nonlinear calculation case requires a yielding margin."
            ]
        ]
    ) .
