@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_066WeldTypeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:weldType ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:in ( "double continuous" ) ;
        sh:message "Represented weld types shall be double continuous."
    ] .
