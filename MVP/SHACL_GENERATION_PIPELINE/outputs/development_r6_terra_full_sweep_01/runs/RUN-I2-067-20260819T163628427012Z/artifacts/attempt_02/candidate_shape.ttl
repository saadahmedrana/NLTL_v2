@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_067_StrengthContinuityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:node [
            sh:property [
                sh:path nltl:structuralConnection ;
                sh:node [
                    sh:property [
                        sh:path nltl:strengthContinuityStatus ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:message "Strength continuity must be ensured at each structural connection."
                    ]
                ]
            ]
        ]
    ] .
