@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-067-StrengthContinuityShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:structuralConnection ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:benchmarkEntity
    ] ;
    sh:property [
        sh:path nltl:strengthContinuityStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "Each structural connection requires recorded confirmation that continuity of strength is ensured." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:structuralConnection ?connection .
                FILTER NOT EXISTS {
                    $this nltl:strengthContinuityStatus true .
                }
            }
        """
    ] .
