@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO-001-CategoryAConditionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A design ice condition is required to determine the applicable Polar Code category."
    ] ;
    sh:sparql [
        sh:message "A ship designed for operation in at least medium first-year ice shall have Category A as its ship category." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?iceCondition .
                FILTER(?iceCondition = "at least medium first-year ice")

                OPTIONAL {
                    $this nltl:shipCategory ?category .
                }
                FILTER(!BOUND(?category) || ?category != nltl:polarShipCategoryA)
            }
        """
    ] .
