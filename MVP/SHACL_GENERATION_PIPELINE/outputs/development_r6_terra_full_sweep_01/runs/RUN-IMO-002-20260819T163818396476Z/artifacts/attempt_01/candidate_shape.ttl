@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:IMO002CategoryBShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A ship designed to operate in at least thin first-year ice and not classified as Category A shall be classified as Category B." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?iceCondition ;
                      nltl:shipCategory ?category .
                FILTER(STR(?iceCondition) = "at least thin first-year ice")
                FILTER NOT EXISTS {
                    $this nltl:shipCategory nltl:polarShipCategoryA .
                }
                FILTER(?category != nltl:polarShipCategoryB)
            }
        """
    ] .
