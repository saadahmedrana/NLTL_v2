@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO002CategoryBShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "A ship designed for at least thin first-year ice, optionally including old-ice inclusions, and not declared Category A must be declared Category B." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?iceCondition .
                FILTER(
                    datatype(?iceCondition) = xsd:string &&
                    REGEX(
                        ?iceCondition,
                        "^(at least )?(thin|medium|thick)[ -]first[ -]year[ -]ice( (with|including|which may include) (possible )?old[ -]ice[ -]inclusions?)?$",
                        "i"
                    )
                )
                OPTIONAL {
                    $this nltl:shipCategory ?category .
                }
                FILTER(
                    !BOUND(?category) ||
                    (
                        ?category != nltl:polarShipCategoryA &&
                        ?category != nltl:polarShipCategoryB
                    )
                )
            }
        """
    ] .
