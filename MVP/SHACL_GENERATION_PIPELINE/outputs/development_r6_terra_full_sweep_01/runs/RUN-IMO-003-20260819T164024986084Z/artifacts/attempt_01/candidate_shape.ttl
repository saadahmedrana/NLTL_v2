@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO003PolarCategoryCShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCategoryValue
    ] ;
    sh:sparql [
        sh:message "A ship designed for open water shall be declared as Polar Ship Category C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER(STR(?condition) = "open water")
                FILTER(
                    !EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER(?category != nltl:polarShipCategoryC)
                    }
                )
            }
        """
    ] .
