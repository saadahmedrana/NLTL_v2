@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-005-IceFreeWatersShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceCondition ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:totalIcePresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When iceCondition is 'ice free waters', totalIcePresent must be recorded as false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition .
                FILTER(?condition = "ice free waters")
                FILTER NOT EXISTS {
                    $this nltl:totalIcePresent ?icePresent .
                    FILTER(?icePresent = false)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The term 'ice free waters' must not be used when totalIcePresent is true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:iceCondition ?condition ;
                      nltl:totalIcePresent ?icePresent .
                FILTER(?condition = "ice free waters")
                FILTER(?icePresent != false)
            }
        """
    ] .
