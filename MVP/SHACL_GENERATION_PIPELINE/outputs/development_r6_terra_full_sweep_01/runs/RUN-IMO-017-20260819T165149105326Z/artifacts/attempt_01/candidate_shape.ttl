@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:CertificateScheduleDateRecordShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:certificateScheduleDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A certificate schedule date record must provide a certificate schedule date."
    ] ;
    sh:property [
        sh:path nltl:certificateScheduleDateType ;
        sh:minCount 1 ;
        sh:in (
            nltl:validityDateCategory
            nltl:surveyDateCategory
            nltl:endorsementDateCategory
        ) ;
        sh:message "A certificate schedule date record must use a validity, survey, or endorsement date category."
    ] .

gen:PolarCertificateSupplementShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasRequiredEquipmentRecords ;
        sh:class nltl:requiredEquipmentRecords ;
        sh:minCount 1 ;
        sh:message "The Polar Ship Certificate supplement must record required equipment."
    ] .

gen:IMO017PolarCertificateScheduleShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate validity dates must be recorded."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate survey dates must be recorded."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Polar Ship Certificate endorsement dates must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:class nltl:polarShipCertificateForm ;
        sh:minCount 1 ;
        sh:message "A Polar Ship Certificate must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:hasCertificateScheduleDateRecord ;
                sh:class nltl:certificateScheduleDateRecord ;
                sh:node gen:CertificateScheduleDateRecordShape
            ]
        ] ;
        sh:message "An applicable SOLAS certificate schedule must be recorded."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Ship Certificate supplement must be recorded as present."
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:class nltl:polarCertificateSupplement ;
        sh:minCount 1 ;
        sh:node gen:PolarCertificateSupplementShape ;
        sh:message "The Polar Ship Certificate must include a supplement with required equipment records."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding SOLAS certificate schedule dates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                {
                    $this nltl:polarCertificateValidityDates ?polarDate .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER(?scheduleDate = ?polarDate)
                    }
                }
                UNION
                {
                    $this nltl:surveyDates ?polarDate .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER(?scheduleDate = ?polarDate)
                    }
                }
                UNION
                {
                    $this nltl:endorsementDates ?polarDate .
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                                nltl:certificateScheduleDate ?scheduleDate .
                        FILTER(?scheduleDate = ?polarDate)
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:validityDateCategory ;
                            nltl:certificateScheduleDate ?scheduleDate .
                    FILTER NOT EXISTS {
                        $this nltl:polarCertificateValidityDates ?polarDate .
                        FILTER(?polarDate = ?scheduleDate)
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:surveyDateCategory ;
                            nltl:certificateScheduleDate ?scheduleDate .
                    FILTER NOT EXISTS {
                        $this nltl:surveyDates ?polarDate .
                        FILTER(?polarDate = ?scheduleDate)
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDateType nltl:endorsementDateCategory ;
                            nltl:certificateScheduleDate ?scheduleDate .
                    FILTER NOT EXISTS {
                        $this nltl:endorsementDates ?polarDate .
                        FILTER(?polarDate = ?scheduleDate)
                    }
                }
            }
        """
    ] .
