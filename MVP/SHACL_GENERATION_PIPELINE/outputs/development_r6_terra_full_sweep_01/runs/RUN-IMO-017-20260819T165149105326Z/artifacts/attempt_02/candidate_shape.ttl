@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO017PolarCertificateHarmonizationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:hasPolarCertificateSupplement ;
        sh:minCount 1 ;
        sh:class nltl:polarCertificateSupplement ;
        sh:node [
            sh:property [
                sh:path nltl:hasRequiredEquipmentRecords ;
                sh:minCount 1 ;
                sh:class nltl:requiredEquipmentRecords ;
                sh:message "The Polar certificate supplement must include required equipment records."
            ]
        ] ;
        sh:message "A Polar certificate supplement is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:class nltl:solasCertificateSchedule ;
        sh:node [
            sh:property [
                sh:path nltl:hasCertificateScheduleDateRecord ;
                sh:class nltl:certificateScheduleDateRecord ;
                sh:node [
                    sh:property [
                        sh:path nltl:certificateScheduleDateType ;
                        sh:minCount 1 ;
                        sh:in (
                            nltl:validityDateCategory
                            nltl:surveyDateCategory
                            nltl:endorsementDateCategory
                        )
                    ] ;
                    sh:property [
                        sh:path nltl:certificateScheduleDate ;
                        sh:minCount 1 ;
                        sh:datatype xsd:date
                    ]
                ]
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Polar Ship Certificate validity, survey, and endorsement dates must match the corresponding categorized SOLAS certificate schedule dates." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                {
                    $this ?polarDateProperty ?date .
                    FILTER(
                        ?polarDateProperty IN (
                            nltl:polarCertificateValidityDates,
                            nltl:surveyDates,
                            nltl:endorsementDates
                        )
                    )
                    FILTER NOT EXISTS {
                        $this nltl:hasSolasCertificateSchedule ?schedule .
                        ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                        ?record nltl:certificateScheduleDate ?date ;
                                nltl:certificateScheduleDateType ?dateType .
                        FILTER(
                            (?polarDateProperty = nltl:polarCertificateValidityDates &&
                             ?dateType = nltl:validityDateCategory) ||
                            (?polarDateProperty = nltl:surveyDates &&
                             ?dateType = nltl:surveyDateCategory) ||
                            (?polarDateProperty = nltl:endorsementDates &&
                             ?dateType = nltl:endorsementDateCategory)
                        )
                    }
                }
                UNION
                {
                    $this nltl:hasSolasCertificateSchedule ?schedule .
                    ?schedule nltl:hasCertificateScheduleDateRecord ?record .
                    ?record nltl:certificateScheduleDate ?date ;
                            nltl:certificateScheduleDateType ?dateType .
                    FILTER(
                        ?dateType IN (
                            nltl:validityDateCategory,
                            nltl:surveyDateCategory,
                            nltl:endorsementDateCategory
                        )
                    )
                    FILTER NOT EXISTS {
                        $this ?polarDateProperty ?date .
                        FILTER(
                            (?dateType = nltl:validityDateCategory &&
                             ?polarDateProperty = nltl:polarCertificateValidityDates) ||
                            (?dateType = nltl:surveyDateCategory &&
                             ?polarDateProperty = nltl:surveyDates) ||
                            (?dateType = nltl:endorsementDateCategory &&
                             ?polarDateProperty = nltl:endorsementDates)
                        )
                    }
                }
            }
        """
    ] .
