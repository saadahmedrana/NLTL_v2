@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-022Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "A Polar Water Operational Manual shall be present."
    ] ;
    sh:property [
        sh:path nltl:capabilitiesSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual shall include ship-specific capabilities."
    ] ;
    sh:property [
        sh:path nltl:limitationsSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual shall include ship-specific limitations."
    ] ;
    sh:property [
        sh:path nltl:operationalAssessmentReference ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "An operational assessment reference is required."
    ] .
