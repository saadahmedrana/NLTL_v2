@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO035IcingAllowanceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarWaterOperationalManualRecord ;
        sh:minCount 1 ;
        sh:class nltl:documentRecord ;
        sh:message "A Polar Water Operational Manual record is required."
    ] ;
    sh:property [
        sh:path nltl:hasStabilityCalculationRecord ;
        sh:minCount 1 ;
        sh:class nltl:documentRecord ;
        sh:message "A stability calculation record is required."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceInformationPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The Polar Water Operational Manual shall state that icing allowance information is present."
    ] ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Polar Water Operational Manual icing allowance values are required."
    ] ;
    sh:property [
        sh:path nltl:stabilityCalculationIcingAllowanceValues ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Stability calculation icing allowance values are required."
    ] ;
    sh:sparql [
        sh:message "Each Polar Water Operational Manual icing allowance value shall match a stability calculation icing allowance value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:polarWaterOperationalManualIcingAllowanceValues ?pwomValue .
                FILTER NOT EXISTS {
                    $this nltl:stabilityCalculationIcingAllowanceValues ?stabilityValue .
                    FILTER(?pwomValue = ?stabilityValue)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each stability calculation icing allowance value shall match a Polar Water Operational Manual icing allowance value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:stabilityCalculationIcingAllowanceValues ?stabilityValue .
                FILTER NOT EXISTS {
                    $this nltl:polarWaterOperationalManualIcingAllowanceValues ?pwomValue .
                    FILTER(?stabilityValue = ?pwomValue)
                }
            }
        """
    ] .
