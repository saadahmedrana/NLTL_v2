@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-040-IceAccretionMeansShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice accretion likelihood must be recorded to determine applicability."
    ] ;
    sh:sparql [
        sh:message "When ice accretion is likely, every relevant hatch or door must have associated ice or snow removal or prevention means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true ;
                      nltl:hasRelevantHatchOrDoor ?hatch .
                FILTER NOT EXISTS {
                    ?hatch a nltl:relevantHatchOrDoorItem ;
                           nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                    ?means a nltl:iceSnowRemovalOrPreventionMeans .
                }
            }
        """
    ] .
