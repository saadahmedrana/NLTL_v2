@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO043ShipHazardCoverageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:node <urn:nltl:generated-shape:IMO043InstallationHazardCoverageShape>
    ] .

<urn:nltl:generated-shape:IMO043InstallationHazardCoverageShape>
    a sh:NodeShape ;
    sh:sparql [
        sh:message "A machinery installation with an asserted applicable listed hazard requires hazard-protection evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this nltl:hasApplicableHazard ?value .
                FILTER (
                    ?value IN (
                        nltl:iceAccretionHazard,
                        nltl:snowAccumulationHazard,
                        nltl:seawaterIceIngestionHazard,
                        nltl:liquidFreezingOrViscosityIncreaseHazard,
                        nltl:seawaterIntakeTemperatureHazard,
                        nltl:snowIngestionHazard
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:hasHazardProtectionEvidence ?evidence .
                }
            }
        """
    ] ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:node <urn:nltl:generated-shape:IMO043AssociatedEquipmentHazardCoverageShape>
    ] .

<urn:nltl:generated-shape:IMO043AssociatedEquipmentHazardCoverageShape>
    a sh:NodeShape ;
    sh:sparql [
        sh:message "Associated equipment linked to an installation with an asserted applicable listed hazard requires installation hazard-protection evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                ?installation nltl:hasAssociatedEquipment $this ;
                              nltl:hasApplicableHazard ?value .
                FILTER (
                    ?value IN (
                        nltl:iceAccretionHazard,
                        nltl:snowAccumulationHazard,
                        nltl:seawaterIceIngestionHazard,
                        nltl:liquidFreezingOrViscosityIncreaseHazard,
                        nltl:seawaterIntakeTemperatureHazard,
                        nltl:snowIngestionHazard
                    )
                )
                FILTER NOT EXISTS {
                    ?installation nltl:hasHazardProtectionEvidence ?evidence .
                }
            }
        """
    ] .
