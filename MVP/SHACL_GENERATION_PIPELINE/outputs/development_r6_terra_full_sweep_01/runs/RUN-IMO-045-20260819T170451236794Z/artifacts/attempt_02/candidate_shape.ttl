@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-045-MachinerySeawaterSupplyShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machinerySeawaterSupply ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:iceIngestionPreventionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:machinerySeawaterSupply ;
                    sh:hasValue true
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:iceIngestionPreventionPresent ;
                        sh:hasValue true
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                        sh:hasValue nltl:evidenceStateApproved
                    ]
                ]
            )
        ]
    ) ;
    sh:message "A machinery seawater supply requires ice-ingestion prevention or an approved alternate functionality arrangement." .
