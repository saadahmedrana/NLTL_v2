@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO057FirePumpCompartmentTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each linked fire pump must have a containing compartment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?pump nltl:hasContainingCompartment ?compartment .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each containing compartment of a linked fire pump must have a maintained temperature above 0 degrees C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                FILTER (?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?compartment nltl:maintainedTemperature ?temperature .
                    ?temperature qudt:numericValue ?value ;
                                 qudt:unit unit:DEG_C .
                    FILTER (
                        datatype(?value) = xsd:decimal &&
                        ?value > "0"^^xsd:decimal
                    )
                }
            }
        """
    ] .
