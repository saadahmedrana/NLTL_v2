@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-059-FirefighterOutfitStorageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFirefighterOutfit ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:firefighterOutfitItem ;
        sh:node [
            sh:property [
                sh:path nltl:hasStorageLocation ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:physicalStorageLocation ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:storageTemperatureClass ;
                        sh:minCount 1 ;
                        sh:in ( nltl:warmStorageLocation ) ;
                        sh:message "The storage location for a firefighter outfit must be classified as warm."
                    ]
                ]
            ]
        ]
    ] .
