@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:IMO071ImmersionSuitShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:immersionSuitRequired ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Immersion-suit applicability must be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:immersionSuitRequired ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:immersionSuitTypeClassification ;
                sh:hasValue nltl:insulatedImmersionSuit ;
                sh:message "Where immersion suits are required, their type classification must be insulated."
            ]
        ]
    ) .
