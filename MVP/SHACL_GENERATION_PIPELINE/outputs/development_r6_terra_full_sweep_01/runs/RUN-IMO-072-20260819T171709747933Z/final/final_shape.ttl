@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO-072-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:continuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Continuous-use suitability status must be approved for extended darkness operation."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:node gs:IMO-072-LifeboatShape
            ]
        ]
    ) .

gs:IMO-072-LifeboatShape
    a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:minCount 1 ;
        sh:node gs:IMO-072-SearchlightShape ;
        sh:message "Each lifeboat must have an assigned searchlight during extended darkness operation."
    ] .

gs:IMO-072-SearchlightShape
    a sh:NodeShape ;
    sh:class nltl:searchlight .
