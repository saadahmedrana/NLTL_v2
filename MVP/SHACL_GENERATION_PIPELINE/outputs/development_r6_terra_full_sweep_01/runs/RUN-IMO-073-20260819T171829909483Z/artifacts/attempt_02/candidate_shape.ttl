@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO-073-LifeboatTypeShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:lifeboat ;
        sh:node [
            sh:property [
                sh:path nltl:lifeboatTypeClassification ;
                sh:in (
                    nltl:partiallyEnclosedLifeboat
                    nltl:totallyEnclosedLifeboat
                ) ;
                sh:message "Lifeboat type classification must be partially enclosed or totally enclosed."
            ]
        ]
    ] .
