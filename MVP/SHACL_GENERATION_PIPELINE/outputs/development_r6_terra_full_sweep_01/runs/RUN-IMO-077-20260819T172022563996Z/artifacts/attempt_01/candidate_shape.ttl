@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-077Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Specify whether additional equipment is carried in the survival craft."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:survivalCraftAvailableCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:message "Provide survival craft available capacity when additional equipment is carried in the survival craft."
            ] ;
            sh:property [
                sh:path nltl:personsCapacityRequirement ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:message "Provide the persons capacity requirement when additional equipment is carried in the survival craft."
            ] ;
            sh:property [
                sh:path nltl:additionalEquipmentCapacityRequirement ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:message "Provide the additional equipment capacity requirement when additional equipment is carried in the survival craft."
            ] ;
            sh:property [
                sh:path nltl:launchingApplianceCapacity ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloGM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Provide launching appliance capacity in kilograms when additional equipment is carried in the survival craft."
            ] ;
            sh:property [
                sh:path nltl:loadedSurvivalCraftRequirement ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloGM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "Provide the loaded survival craft requirement in kilograms when additional equipment is carried in the survival craft."
            ] ;
            sh:sparql [
                sh:message "Survival craft capacity or launching appliance capacity is insufficient for the required persons and additional equipment." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:additionalEquipmentCarriedInSurvivalCraft true ;
                              nltl:survivalCraftAvailableCapacity ?available ;
                              nltl:personsCapacityRequirement ?persons ;
                              nltl:additionalEquipmentCapacityRequirement ?additional ;
                              nltl:launchingApplianceCapacity ?launchingQuantity ;
                              nltl:loadedSurvivalCraftRequirement ?loadedQuantity .
                        ?launchingQuantity qudt:numericValue ?launching .
                        ?loadedQuantity qudt:numericValue ?loaded .
                        FILTER (
                            ?available < (?persons + ?additional) ||
                            ?launching < ?loaded
                        )
                    }
                """
            ]
        ]
        [
            sh:property [
                sh:path nltl:additionalEquipmentCarriedInSurvivalCraft ;
                sh:hasValue false
            ]
        ]
    ) .
