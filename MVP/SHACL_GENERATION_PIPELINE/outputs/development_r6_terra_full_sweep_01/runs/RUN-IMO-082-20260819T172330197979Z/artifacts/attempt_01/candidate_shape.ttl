@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO082Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "SOLAS regulation V/22.1.9.4 compliance status must be compliant."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:bridgeConfigurationValue ;
        sh:minCount 1 ;
        sh:message "Bridge configuration is required to determine astern-view applicability."
    ] ;
    sh:sparql [
        sh:message "A bridge configuration requiring an astern view must have a compliant clear-view-astern status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                    nltl:asternViewRequiredBridgeConfiguration .
                FILTER (
                    NOT EXISTS {
                        $this nltl:clearViewAsternStatus true .
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?status .
                        FILTER (
                            !isLiteral(?status)
                            || datatype(?status) != xsd:boolean
                            || (STR(?status) != "true" && STR(?status) != "1")
                        )
                    }
                )
            }
        """
    ] .
