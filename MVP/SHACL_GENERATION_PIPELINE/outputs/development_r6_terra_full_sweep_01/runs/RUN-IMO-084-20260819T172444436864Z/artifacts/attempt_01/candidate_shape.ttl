@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-084Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:requiredSensorProjectsBelowHull ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Record whether required sensors project below the hull."
    ] ;
    sh:property [
        sh:path nltl:sensorIceProtectionPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:requiredSensorProjectsBelowHull ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:requiredSensorProjectsBelowHull ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:sensorIceProtectionPresent ;
                sh:hasValue true ;
                sh:message "Sensors projecting below the hull must be protected against ice."
            ]
        ]
    ) .
