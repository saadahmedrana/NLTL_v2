@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO097SurvivalCraftCommunicationShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:releasedRescueBoatOrLifeboat ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:releasedRescueBoatOrLifeboat ;
                        sh:datatype xsd:boolean ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                        sh:node [
                            sh:class nltl:lifeboat ;
                            sh:class nltl:survivalCraft ;
                            sh:property [
                                sh:path nltl:hasDistressAlertDevice ;
                                sh:minCount 1 ;
                                sh:class nltl:equipmentItem
                            ] ;
                            sh:property [
                                sh:path nltl:survivalCraftHasShipToShoreDistressAlertDevice ;
                                sh:qualifiedValueShape [
                                    sh:class nltl:shipToShoreDistressAlertDevice
                                ] ;
                                sh:qualifiedMinCount 1
                            ] ;
                            sh:property [
                                sh:path nltl:survivalCraftHasLocationSignalDevice ;
                                sh:qualifiedValueShape [
                                    sh:class nltl:locationSignalDevice
                                ] ;
                                sh:qualifiedMinCount 1
                            ] ;
                            sh:property [
                                sh:path nltl:survivalCraftHasOnSceneCommunicationDevice ;
                                sh:qualifiedValueShape [
                                    sh:class nltl:onSceneCommunicationDevice
                                ] ;
                                sh:qualifiedMinCount 1
                            ]
                        ]
                    ] ;
                    sh:sparql [
                        sh:message "Each required released rescue boat or lifeboat must also be linked as a lifeboat." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:hasRequiredRescueBoatOrLifeboat ?craft .
                                FILTER NOT EXISTS {
                                    $this nltl:hasLifeboat ?craft .
                                }
                            }
                        """
                    ]
                ]
            )
        ]
    ) .
