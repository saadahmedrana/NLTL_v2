@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO098SurvivalCraftCommunicationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInLowAirTemperature ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Record whether the ship operates in low air temperature."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Each other survival craft must carry at least one location-signal device and one on-scene transmit/receive communication device when the ship operates in low air temperature." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this ?craft
            WHERE {
                $this nltl:shipOperatesInLowAirTemperature true ;
                      nltl:hasOtherSurvivalCraft ?craft .

                {
                    FILTER NOT EXISTS {
                        ?craft nltl:hasLocationSignalDevice ?locationDevice .
                        ?locationDevice a nltl:locationSignalDevice .
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        ?craft nltl:hasOnSceneCommunicationDevice ?communicationDevice .
                        ?communicationDevice a nltl:onSceneCommunicationDevice .
                    }
                }
            }
        """
    ] .
