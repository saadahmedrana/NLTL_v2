@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-108Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI
    ] ;

    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;

    sh:property [
        sh:path nltl:aggregateOilFuelCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:individualOilFuelTankCapacity ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:oilFuelTankOuterShellSeparation ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "For applicable Category A or B ships, oil fuel tanks over 30 m3 require outer-shell separation of at least 0.76 m." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?date ;
                      nltl:aggregateOilFuelCapacity ?aggregate ;
                      nltl:individualOilFuelTankCapacity ?individual .

                ?aggregate qudt:numericValue ?aggregateValue ;
                           qudt:unit unit:M3 .

                ?individual qudt:numericValue ?individualValue ;
                            qudt:unit unit:M3 .

                FILTER (
                    ?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB) &&
                    (
                        YEAR(?date) > 2017 ||
                        (YEAR(?date) = 2017 && MONTH(?date) > 1) ||
                        (YEAR(?date) = 2017 && MONTH(?date) = 1 && DAY(?date) >= 1)
                    ) &&
                    ?aggregateValue < "600"^^xsd:decimal &&
                    ?individualValue > "30"^^xsd:decimal
                )

                OPTIONAL {
                    $this nltl:oilFuelTankOuterShellSeparation ?separation .
                    ?separation qudt:numericValue ?separationValue ;
                                qudt:unit unit:M .
                }

                FILTER (
                    !BOUND(?separation) ||
                    ?separationValue < "0.76"^^xsd:decimal
                )
            }
        """
    ] .
