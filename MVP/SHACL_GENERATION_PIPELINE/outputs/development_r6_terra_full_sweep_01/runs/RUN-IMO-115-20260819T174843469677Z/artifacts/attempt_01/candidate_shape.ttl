@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-115-SewageDischargeShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:comminutedAndDisinfected ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "Comminuted and disinfected sewage discharge requires MARPOL Annex IV regulation 11.1.1 compliance status true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:sewageDischargeType ?dischargeType .
                        FILTER (
                            datatype(?dischargeType) = xsd:string &&
                            str(?dischargeType) = "comminuted_and_disinfected"
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:comminutedAndDisinfected ?isComminutedAndDisinfected .
                        FILTER (
                            datatype(?isComminutedAndDisinfected) = xsd:boolean &&
                            ?isComminutedAndDisinfected = true
                        )
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?status .
                    FILTER (
                        datatype(?status) = xsd:boolean &&
                        ?status = true
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Comminuted and disinfected sewage discharge requires a distance greater than 3 nautical miles from the nearest ice shelf or fast ice." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:sewageDischargeType ?dischargeType .
                        FILTER (
                            datatype(?dischargeType) = xsd:string &&
                            str(?dischargeType) = "comminuted_and_disinfected"
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:comminutedAndDisinfected ?isComminutedAndDisinfected .
                        FILTER (
                            datatype(?isComminutedAndDisinfected) = xsd:boolean &&
                            ?isComminutedAndDisinfected = true
                        )
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:distanceToNearestIceShelfOrFastIce ?distance .
                    ?distance a qudt:QuantityValue ;
                        qudt:numericValue ?distanceValue ;
                        qudt:unit unit:MI_N .
                    FILTER (
                        datatype(?distanceValue) = xsd:decimal &&
                        ?distanceValue > "3"^^xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Comminuted and disinfected sewage discharge requires nearby ice concentration data exceeding one tenth." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:sewageDischargeType ?dischargeType .
                        FILTER (
                            datatype(?dischargeType) = xsd:string &&
                            str(?dischargeType) = "comminuted_and_disinfected"
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:comminutedAndDisinfected ?isComminutedAndDisinfected .
                        FILTER (
                            datatype(?isComminutedAndDisinfected) = xsd:boolean &&
                            ?isComminutedAndDisinfected = true
                        )
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:nearbyIceConcentration ?concentration .
                    ?concentration a qudt:QuantityValue ;
                        qudt:numericValue ?concentrationValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?concentrationValue) = xsd:decimal &&
                        ?concentrationValue > "1"^^xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Comminuted and disinfected sewage discharge requires a recorded distance from an area with ice concentration above one tenth." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER (
                    EXISTS {
                        $this nltl:sewageDischargeType ?dischargeType .
                        FILTER (
                            datatype(?dischargeType) = xsd:string &&
                            str(?dischargeType) = "comminuted_and_disinfected"
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:comminutedAndDisinfected ?isComminutedAndDisinfected .
                        FILTER (
                            datatype(?isComminutedAndDisinfected) = xsd:boolean &&
                            ?isComminutedAndDisinfected = true
                        )
                    }
                )
                FILTER NOT EXISTS {
                    $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?distance .
                    ?distance a qudt:QuantityValue ;
                        qudt:numericValue ?distanceValue ;
                        qudt:unit unit:MI_N .
                    FILTER (datatype(?distanceValue) = xsd:decimal)
                }
            }
        """
    ] .
