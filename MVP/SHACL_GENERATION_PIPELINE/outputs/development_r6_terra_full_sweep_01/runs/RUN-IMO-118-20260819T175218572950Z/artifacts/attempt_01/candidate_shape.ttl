@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO118SewageDischargeShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction date is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:class nltl:passengerShip
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:message "Ship category or passenger-ship classification is required to determine applicability."
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Applicable ships must not discharge sewage to sea unless the discharge complies with Polar Code paragraph 4.2.1.3." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?date .
                FILTER(
                    YEAR(?date) > 2017 ||
                    (YEAR(?date) = 2017 && MONTH(?date) > 1) ||
                    (YEAR(?date) = 2017 && MONTH(?date) = 1 && DAY(?date) >= 1)
                )
                {
                    $this a nltl:passengerShip .
                }
                UNION
                {
                    $this nltl:shipCategory ?category .
                    FILTER(?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                }
                FILTER NOT EXISTS {
                    $this nltl:sewageDischargeToSea false .
                }
                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus true .
                }
            }
        """
    ] .
