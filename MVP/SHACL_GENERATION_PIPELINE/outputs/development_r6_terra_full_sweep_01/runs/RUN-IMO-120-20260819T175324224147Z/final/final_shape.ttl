@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_120_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For food-waste discharge in Arctic_waters, record Arctic-waters information, a nearest land/ice distance of at least 12 nautical miles, and the distance from ice concentration above one tenth." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:operatingArea "Arctic_waters"^^xsd:string ;
                      nltl:foodWasteDischargeToSea true .

                FILTER NOT EXISTS {
                    $this nltl:arcticWaters ?arcticWaters ;
                          nltl:distanceToNearestLandIceShelfOrFastIce ?nearestDistance ;
                          nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?iceAreaDistance ;
                          nltl:nearbyIceConcentration ?nearbyConcentration .

                    FILTER (datatype(?arcticWaters) = xsd:string)

                    ?nearestDistance a qudt:QuantityValue ;
                        qudt:numericValue ?nearestDistanceValue ;
                        qudt:unit unit:MI_N .
                    FILTER (
                        datatype(?nearestDistanceValue) = xsd:decimal &&
                        ?nearestDistanceValue >= "12"^^xsd:decimal
                    )

                    ?iceAreaDistance a qudt:QuantityValue ;
                        qudt:numericValue ?iceAreaDistanceValue ;
                        qudt:unit unit:MI_N .
                    FILTER (datatype(?iceAreaDistanceValue) = xsd:decimal)

                    ?nearbyConcentration a qudt:QuantityValue ;
                        qudt:numericValue ?nearbyConcentrationValue ;
                        qudt:unit unit:UNITLESS .
                    FILTER (
                        datatype(?nearbyConcentrationValue) = xsd:decimal &&
                        ?nearbyConcentrationValue > "1"^^xsd:decimal
                    )
                }
            }
        """
    ] .
