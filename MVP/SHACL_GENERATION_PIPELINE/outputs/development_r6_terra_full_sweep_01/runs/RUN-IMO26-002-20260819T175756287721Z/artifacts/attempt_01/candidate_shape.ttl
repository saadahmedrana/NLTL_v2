@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:Chapter9Dash1ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A fishing vessel with length overall of 24 m or more must record that Polar Code chapter 9-1 is applicable." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:fishingVessel ;
                    nltl:lengthOverall ?lengthQuantity .
                ?lengthQuantity qudt:numericValue ?length ;
                    qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER(datatype(?length) = xsd:decimal && ?length >= 24.0)
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter9Dash1Applicable "true"^^xsd:boolean .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A pleasure yacht of 300 gross tonnage or more that is not engaged in trade must record that Polar Code chapter 9-1 is applicable." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:pleasureYacht ;
                    nltl:engagedInTrade "false"^^xsd:boolean ;
                    nltl:grossTonnage ?tonnageQuantity .
                ?tonnageQuantity qudt:numericValue ?tonnage ;
                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER(datatype(?tonnage) = xsd:decimal && ?tonnage >= 300.0)
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter9Dash1Applicable "true"^^xsd:boolean .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A cargo ship of 300 gross tonnage or more but below 500 gross tonnage must record that Polar Code chapter 9-1 is applicable." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:cargoShip ;
                    nltl:grossTonnage ?tonnageQuantity .
                ?tonnageQuantity qudt:numericValue ?tonnage ;
                    qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                FILTER(datatype(?tonnage) = xsd:decimal &&
                       ?tonnage >= 300.0 &&
                       ?tonnage < 500.0)
                FILTER NOT EXISTS {
                    $this nltl:polarCodeChapter9Dash1Applicable "true"^^xsd:boolean .
                }
            }
        """
    ] .

gen:FishingVesselApplicabilityInputsShape
    a sh:NodeShape ;
    sh:targetClass nltl:fishingVessel ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M>
            ]
        ]
    ] .

gen:PleasureYachtApplicabilityInputsShape
    a sh:NodeShape ;
    sh:targetClass nltl:pleasureYacht ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean
    ] .

gen:CargoShipApplicabilityInputsShape
    a sh:NodeShape ;
    sh:targetClass nltl:cargoShip ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
            ]
        ]
    ] .
