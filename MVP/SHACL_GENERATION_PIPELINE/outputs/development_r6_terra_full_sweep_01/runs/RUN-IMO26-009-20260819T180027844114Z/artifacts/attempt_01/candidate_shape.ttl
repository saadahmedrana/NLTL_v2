@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:IMO26_009Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion likelihood must be recorded to determine antenna ice-prevention applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ] ;
            sh:sparql [
                sh:message "Each required navigation or communication antenna must have ice-accumulation prevention present when ice accretion is likely." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceAccretionLikely true ;
                              nltl:hasRequiredNavigationOrCommunicationAntenna ?antenna .
                        FILTER NOT EXISTS {
                            ?antenna nltl:antennaIceAccumulationPreventionPresent true .
                        }
                    }
                """
            ]
        ]
    ) .
