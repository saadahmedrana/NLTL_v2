@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-012ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A ship of 500 gross tonnage or more must have at least two non-magnetic heading means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?grossTonnage .
                ?grossTonnage qudt:numericValue ?tonnage ;
                              qudt:unit unit:UNITLESS .
                FILTER(datatype(?tonnage) = xsd:decimal && ?tonnage >= 500)
                OPTIONAL {
                    $this nltl:hasNonMagneticHeadingMeans ?means .
                }
            }
            GROUP BY $this
            HAVING(COUNT(DISTINCT ?means) < 2)
        """
    ] ;
    sh:sparql [
        sh:message "Each linked heading means on a ship of 500 gross tonnage or more must be a non-magnetic heading means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?means
            WHERE {
                $this nltl:grossTonnage ?grossTonnage ;
                      nltl:hasNonMagneticHeadingMeans ?means .
                ?grossTonnage qudt:numericValue ?tonnage ;
                              qudt:unit unit:UNITLESS .
                FILTER(datatype(?tonnage) = xsd:decimal && ?tonnage >= 500)
                FILTER NOT EXISTS {
                    ?means a nltl:nonMagneticHeadingMeans .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each non-magnetic heading means must be connected to main power." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?means
            WHERE {
                $this nltl:grossTonnage ?grossTonnage ;
                      nltl:hasNonMagneticHeadingMeans ?means .
                ?grossTonnage qudt:numericValue ?tonnage ;
                              qudt:unit unit:UNITLESS .
                FILTER(datatype(?tonnage) = xsd:decimal && ?tonnage >= 500)
                FILTER NOT EXISTS {
                    ?means nltl:connectedToMainPower ?power .
                    FILTER(isIRI(?power))
                    ?power a nltl:benchmarkEntity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each non-magnetic heading means must be connected to emergency power." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?means
            WHERE {
                $this nltl:grossTonnage ?grossTonnage ;
                      nltl:hasNonMagneticHeadingMeans ?means .
                ?grossTonnage qudt:numericValue ?tonnage ;
                              qudt:unit unit:UNITLESS .
                FILTER(datatype(?tonnage) = xsd:decimal && ?tonnage >= 500)
                FILTER NOT EXISTS {
                    ?means nltl:connectedToEmergencyPower ?power .
                    FILTER(isIRI(?power))
                    ?power a nltl:benchmarkEntity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each non-magnetic heading means must be independent from another distinct heading means of the same ship." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?means
            WHERE {
                $this nltl:grossTonnage ?grossTonnage ;
                      nltl:hasNonMagneticHeadingMeans ?means .
                ?grossTonnage qudt:numericValue ?tonnage ;
                              qudt:unit unit:UNITLESS .
                FILTER(datatype(?tonnage) = xsd:decimal && ?tonnage >= 500)
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?other .
                    FILTER(?other != ?means)
                    $this nltl:hasNonMagneticHeadingMeans ?other .
                    ?other a nltl:nonMagneticHeadingMeans .
                }
            }
        """
    ] .
