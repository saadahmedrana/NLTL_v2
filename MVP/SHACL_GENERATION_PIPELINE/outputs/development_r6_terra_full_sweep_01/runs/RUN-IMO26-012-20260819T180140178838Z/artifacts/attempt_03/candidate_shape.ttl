@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:IMO26_012_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:UNITLESS
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Ships of 500 gross tonnage and upwards must have at least two non-magnetic heading means; each linked means must be independent of another linked means and connected to main and emergency power." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:grossTonnage ?grossTonnage .
                ?grossTonnage qudt:numericValue ?grossTonnageValue .
                FILTER(?grossTonnageValue >= 500)

                FILTER NOT EXISTS {
                    $this nltl:hasNonMagneticHeadingMeans ?means1, ?means2 .
                    ?means1 a nltl:nonMagneticHeadingMeans .
                    ?means2 a nltl:nonMagneticHeadingMeans .
                    FILTER(?means1 != ?means2)

                    FILTER NOT EXISTS {
                        $this nltl:hasNonMagneticHeadingMeans ?means .

                        FILTER NOT EXISTS {
                            ?means a nltl:nonMagneticHeadingMeans ;
                                nltl:connectedToMainPower ?mainPower ;
                                nltl:connectedToEmergencyPower ?emergencyPower ;
                                nltl:independentFromHeadingMeans ?otherMeans .

                            ?mainPower a nltl:benchmarkEntity .
                            ?emergencyPower a nltl:benchmarkEntity .
                            $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                            FILTER(?otherMeans != ?means)
                        }
                    }
                }
            }
        """
    ] .
