@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-014Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operatesOnlyInContinuousDaylight ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Record whether the ship operates only in continuous daylight."
    ] ;
    sh:property [
        sh:path nltl:visualIceDetectionIlluminationMeansCount ;
        sh:datatype xsd:integer
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:visualIceDetectionIlluminationMeansCount ;
                sh:minCount 1 ;
                sh:minInclusive 2
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "A ship not operating only in continuous daylight must have at least two means of illumination for visual ice detection." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:operatesOnlyInContinuousDaylight false .
                FILTER NOT EXISTS {
                    $this nltl:visualIceDetectionIlluminationMeansCount ?count .
                    FILTER(datatype(?count) = xsd:integer && ?count >= 2)
                }
            }
        """
    ] .
