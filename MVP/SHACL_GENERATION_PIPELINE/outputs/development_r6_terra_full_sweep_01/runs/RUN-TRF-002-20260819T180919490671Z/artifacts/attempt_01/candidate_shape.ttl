@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF002IceClassRegulations2017Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "Ships contracted from 1 January 2019 through 4 July 2021 must identify the 2017 Ice Class Regulations as the applicable edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (
                    (YEAR(?contractDate) > 2019 ||
                     (YEAR(?contractDate) = 2019 &&
                      (MONTH(?contractDate) > 1 ||
                       (MONTH(?contractDate) = 1 && DAY(?contractDate) >= 1))))
                    &&
                    (YEAR(?contractDate) < 2021 ||
                     (YEAR(?contractDate) = 2021 &&
                      (MONTH(?contractDate) < 7 ||
                       (MONTH(?contractDate) = 7 && DAY(?contractDate) < 5))))
                )
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2017 .
                }
            }
        """
    ] .
