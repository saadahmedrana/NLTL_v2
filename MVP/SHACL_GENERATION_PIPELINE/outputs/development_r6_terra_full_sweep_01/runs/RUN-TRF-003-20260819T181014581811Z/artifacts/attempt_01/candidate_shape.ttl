@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:TRF003IceClassRegulations2010Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:datatype xsd:date
    ] ;
    sh:sparql [
        sh:message "Ships contracted from 1 January 2012 through 31 December 2018 must identify the 2010 Ice Class Regulations as the applicable edition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (
                    (YEAR(?contractDate) > 2012 ||
                     (YEAR(?contractDate) = 2012 &&
                      (MONTH(?contractDate) > 1 ||
                       (MONTH(?contractDate) = 1 && DAY(?contractDate) >= 1))))
                    &&
                    (YEAR(?contractDate) < 2019 ||
                     (YEAR(?contractDate) = 2019 &&
                      (MONTH(?contractDate) < 1 ||
                       (MONTH(?contractDate) = 1 && DAY(?contractDate) < 1))))
                )
                FILTER (
                    !EXISTS {
                        $this nltl:applicableIceClassRegulationEdition
                            nltl:iceClassRegulationEdition2010 .
                    }
                    ||
                    EXISTS {
                        $this nltl:applicableIceClassRegulationEdition ?otherEdition .
                        FILTER (?otherEdition != nltl:iceClassRegulationEdition2010)
                    }
                )
            }
        """
    ] .
