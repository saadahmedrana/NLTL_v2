@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF005Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:TRF005ApplicableBranch
        gen:TRF005StageBeforeBranch
        gen:TRF005ContractAfterBranch
    ) ;
    sh:message "Establish applicability of the 2002 Ice Class Regulations using construction dates and, when applicable, identify the 2002 regulation edition." .

gen:TRF005ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:minCount 1 ;
        sh:in ( nltl:iceClassRegulationEdition2002 ) ;
        sh:message "Ships within the applicability dates must identify the 2002 Ice Class Regulations as the applicable regulation edition."
    ] ;
    sh:sparql [
        sh:message "The applicable branch requires every construction stage date to be on or after 1 September 2003 and every construction contract date to be before 1 January 2010." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate ;
                      nltl:constructionContractDate ?contractDate .
                FILTER (
                    !(
                        YEAR(?stageDate) > 2003 ||
                        (
                            YEAR(?stageDate) = 2003 &&
                            (
                                MONTH(?stageDate) > 9 ||
                                (MONTH(?stageDate) = 9 && DAY(?stageDate) >= 1)
                            )
                        )
                    ) ||
                    !(
                        YEAR(?contractDate) < 2010
                    )
                )
            }
        """
    ] .

gen:TRF005StageBeforeBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:sparql [
        sh:message "The non-applicable stage-date branch requires every construction stage date to be before 1 September 2003." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionStageDate ?stageDate .
                FILTER (
                    !(
                        YEAR(?stageDate) < 2003 ||
                        (
                            YEAR(?stageDate) = 2003 &&
                            (
                                MONTH(?stageDate) < 9 ||
                                (MONTH(?stageDate) = 9 && DAY(?stageDate) < 1)
                            )
                        )
                    )
                )
            }
        """
    ] .

gen:TRF005ContractAfterBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionContractDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:sparql [
        sh:message "The non-applicable contract-date branch requires every construction contract date to be on or after 1 January 2010." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?contractDate .
                FILTER (
                    !(
                        YEAR(?contractDate) > 2010 ||
                        (
                            YEAR(?contractDate) = 2010 &&
                            (
                                MONTH(?contractDate) > 1 ||
                                (MONTH(?contractDate) = 1 && DAY(?contractDate) >= 1)
                            )
                        )
                    )
                )
            }
        """
    ] .
