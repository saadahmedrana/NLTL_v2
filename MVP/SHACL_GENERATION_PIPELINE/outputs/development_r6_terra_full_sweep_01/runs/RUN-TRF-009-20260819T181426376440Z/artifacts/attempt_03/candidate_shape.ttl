@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-009-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI
    ] ;

    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date
    ] ;

    sh:property [
        sh:path nltl:deliveryDate ;
        sh:datatype xsd:date
    ] ;

    sh:property [
        sh:path nltl:assessmentDate ;
        sh:datatype xsd:date
    ] ;

    sh:property [
        sh:path nltl:engineOutputComplianceMethod ;
        sh:nodeKind sh:IRI
    ] ;

    sh:sparql [
        sh:message "An IA Super or IA ship requires a valid construction stage date to determine whether TRF-009 applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER NOT EXISTS {
                    $this nltl:constructionStageDate ?constructionDate .
                    FILTER(DATATYPE(?constructionDate) = xsd:date)
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "An applicable ship requires a valid delivery date to establish the TRF-009 compliance deadline." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER(DATATYPE(?constructionDate) = xsd:date)
                FILTER(
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:deliveryDate ?deliveryDate .
                    FILTER(DATATYPE(?deliveryDate) = xsd:date)
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "An applicable ship must use the 2017 Ice Class Regulations section 3.2.2 or section 3.2.4 compliance method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER(DATATYPE(?constructionDate) = xsd:date)
                FILTER(
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:engineOutputComplianceMethod ?method .
                    FILTER(
                        ?method IN (
                            nltl:traficom2017Section3Point2Point2Method,
                            nltl:traficom2017Section3Point2Point4Method
                        )
                    )
                }
            }
        """
    ] ;

    sh:sparql [
        sh:message "An applicable ship must have an assessment date no later than 1 January in the year twenty years after its delivery year." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:constructionStageDate ?constructionDate ;
                      nltl:deliveryDate ?deliveryDate .
                FILTER(?iceClass IN (nltl:iceClassIaSuper, nltl:iceClassIa))
                FILTER(DATATYPE(?constructionDate) = xsd:date)
                FILTER(DATATYPE(?deliveryDate) = xsd:date)
                FILTER(
                    YEAR(?constructionDate) < 2003 ||
                    (YEAR(?constructionDate) = 2003 && MONTH(?constructionDate) < 9)
                )
                FILTER NOT EXISTS {
                    $this nltl:assessmentDate ?assessmentDate .
                    FILTER(DATATYPE(?assessmentDate) = xsd:date)
                    FILTER(
                        YEAR(?assessmentDate) < YEAR(?deliveryDate) + 20 ||
                        (
                            YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                            MONTH(?assessmentDate) = 1 &&
                            DAY(?assessmentDate) <= 1
                        )
                    )
                }
            }
        """
    ] .
