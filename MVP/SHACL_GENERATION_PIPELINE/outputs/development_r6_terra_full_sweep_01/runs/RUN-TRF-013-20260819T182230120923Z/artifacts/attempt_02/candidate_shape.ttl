@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:MetreLengthQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF013IceClassDraughtShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:message "An applicable ice class must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "An upper ice waterline must be recorded."
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:class nltl:iceWaterline ;
        sh:minCount 1 ;
        sh:message "A lower ice waterline must be recorded."
    ] ;
    sh:property [
        sh:path nltl:draughtAtForePerpendicular ;
        sh:minCount 1 ;
        sh:node gs:MetreLengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:draughtAtAftPerpendicular ;
        sh:minCount 1 ;
        sh:node gs:MetreLengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:operatingForeDraught ;
        sh:minCount 1 ;
        sh:node gs:MetreLengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:operatingAftDraught ;
        sh:minCount 1 ;
        sh:node gs:MetreLengthQuantityShape
    ] ;
    sh:sparql [
        sh:message "Operating fore and aft draughts must lie inclusively between the corresponding minimum and maximum ice-class draughts." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>

            SELECT $this
            WHERE {
                $this ?operatingProperty ?operatingQuantity .
                ?operatingQuantity qudt:numericValue ?operatingValue ;
                    qudt:unit unit:M .

                FILTER (
                    ?operatingProperty IN (
                        nltl:operatingForeDraught,
                        nltl:operatingAftDraught
                    )
                )

                FILTER NOT EXISTS {
                    $this ?iceClassDraughtProperty ?lowerQuantity ;
                        ?iceClassDraughtProperty ?upperQuantity .

                    FILTER (
                        (?operatingProperty = nltl:operatingForeDraught &&
                         ?iceClassDraughtProperty = nltl:draughtAtForePerpendicular) ||
                        (?operatingProperty = nltl:operatingAftDraught &&
                         ?iceClassDraughtProperty = nltl:draughtAtAftPerpendicular)
                    )

                    ?lowerQuantity qudt:numericValue ?lowerValue ;
                        qudt:unit unit:M .
                    ?upperQuantity qudt:numericValue ?upperValue ;
                        qudt:unit unit:M .

                    FILTER (
                        ?lowerValue <= ?operatingValue &&
                        ?operatingValue <= ?upperValue
                    )
                }
            }
        """
    ] .
