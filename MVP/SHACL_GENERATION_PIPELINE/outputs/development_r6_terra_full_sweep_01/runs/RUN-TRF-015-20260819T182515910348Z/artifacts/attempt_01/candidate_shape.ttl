@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-015Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:upperIceWaterlineDraught ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:operatingDraught ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:maximumPermittedIceTrim ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:operatingTrim ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:intendedRouteSeaWaterSalinity ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue nltl:gramPerKilogramSalinityUnit ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:loadingCalculationSeaWaterSalinity ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue nltl:gramPerKilogramSalinityUnit ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Navigating in ice requires complete draught, trim, and salinity inputs with the required units." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                FILTER EXISTS { $this nltl:navigatingInIce true }
                FILTER NOT EXISTS {
                    $this nltl:upperIceWaterlineDraught ?uiwl ;
                          nltl:operatingDraught ?draught ;
                          nltl:maximumPermittedIceTrim ?maximumTrim ;
                          nltl:operatingTrim ?trim ;
                          nltl:intendedRouteSeaWaterSalinity ?routeSalinity ;
                          nltl:loadingCalculationSeaWaterSalinity ?loadingSalinity .
                    ?uiwl rdf:type qudt:QuantityValue ;
                          qudt:numericValue ?uiwlValue ;
                          qudt:unit unit:M .
                    ?draught rdf:type qudt:QuantityValue ;
                             qudt:numericValue ?draughtValue ;
                             qudt:unit unit:M .
                    ?maximumTrim rdf:type qudt:QuantityValue ;
                                 qudt:numericValue ?maximumTrimValue ;
                                 qudt:unit unit:M .
                    ?trim rdf:type qudt:QuantityValue ;
                          qudt:numericValue ?trimValue ;
                          qudt:unit unit:M .
                    ?routeSalinity rdf:type qudt:QuantityValue ;
                                   qudt:numericValue ?routeSalinityValue ;
                                   qudt:unit nltl:gramPerKilogramSalinityUnit .
                    ?loadingSalinity rdf:type qudt:QuantityValue ;
                                     qudt:numericValue ?loadingSalinityValue ;
                                     qudt:unit nltl:gramPerKilogramSalinityUnit .
                    FILTER(
                        datatype(?uiwlValue) = xsd:decimal &&
                        datatype(?draughtValue) = xsd:decimal &&
                        datatype(?maximumTrimValue) = xsd:decimal &&
                        datatype(?trimValue) = xsd:decimal &&
                        datatype(?routeSalinityValue) = xsd:decimal &&
                        datatype(?loadingSalinityValue) = xsd:decimal
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When navigating in ice, operating draught and trim must not exceed their permitted limits, and loading salinity must equal intended-route salinity." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:navigatingInIce true ;
                      nltl:upperIceWaterlineDraught ?uiwl ;
                      nltl:operatingDraught ?draught ;
                      nltl:maximumPermittedIceTrim ?maximumTrim ;
                      nltl:operatingTrim ?trim ;
                      nltl:intendedRouteSeaWaterSalinity ?routeSalinity ;
                      nltl:loadingCalculationSeaWaterSalinity ?loadingSalinity .
                ?uiwl qudt:numericValue ?uiwlValue .
                ?draught qudt:numericValue ?draughtValue .
                ?maximumTrim qudt:numericValue ?maximumTrimValue .
                ?trim qudt:numericValue ?trimValue .
                ?routeSalinity qudt:numericValue ?routeSalinityValue .
                ?loadingSalinity qudt:numericValue ?loadingSalinityValue .
                FILTER(
                    datatype(?uiwlValue) = xsd:decimal &&
                    datatype(?draughtValue) = xsd:decimal &&
                    datatype(?maximumTrimValue) = xsd:decimal &&
                    datatype(?trimValue) = xsd:decimal &&
                    datatype(?routeSalinityValue) = xsd:decimal &&
                    datatype(?loadingSalinityValue) = xsd:decimal
                )
                FILTER(
                    ?draughtValue > ?uiwlValue ||
                    ?trimValue > ?maximumTrimValue ||
                    ?loadingSalinityValue != ?routeSalinityValue
                )
            }
        """
    ] .
