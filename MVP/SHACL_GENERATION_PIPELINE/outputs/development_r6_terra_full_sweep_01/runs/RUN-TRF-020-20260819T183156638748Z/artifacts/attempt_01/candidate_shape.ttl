@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF020Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "constructionStageDate is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "iceClass is required to determine applicability."
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF020Pre2003Branch>
        <urn:nltl:generated-shape:TRF020NonEligibleIceClassBranch>
        <urn:nltl:generated-shape:TRF020ApplicableBranch>
    ) .

<urn:nltl:generated-shape:TRF020Pre2003Branch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:minInclusive "0001-01-01"^^xsd:date ;
        sh:maxExclusive "2003-09-01"^^xsd:date
    ] .

<urn:nltl:generated-shape:TRF020NonEligibleIceClassBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

<urn:nltl:generated-shape:TRF020ApplicableBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:minInclusive "2003-09-01"^^xsd:date
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        )
    ] ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propulsionSystemType ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in (
            nltl:conventionalPropulsionSystem
            nltl:electricPropulsionMachinery
            nltl:hydraulicPropulsionMachinery
        )
    ] ;
    sh:property [
        sh:path nltl:propellerPitchControlType ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:in (
            nltl:controllablePitch
            nltl:fixedPitch
        )
    ] ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020UnitlessQuantity>
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020MetreQuantity>
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceAtUpperIceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020NumericQuantity>
    ] ;
    sh:property [
        sh:path nltl:brashIceChannelResistanceAtLowerIceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020NumericQuantity>
    ] ;
    sh:property [
        sh:path nltl:minimumRequiredPowerAtUpperIceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020KiloWattQuantity>
    ] ;
    sh:property [
        sh:path nltl:minimumRequiredPowerAtLowerIceWaterline ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020KiloWattQuantity>
    ] ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020KiloWattQuantity>
    ] ;
    sh:property [
        sh:path nltl:hasUpperIceWaterline ;
        sh:minCount 1 ;
        sh:class nltl:iceWaterline ;
        sh:node <urn:nltl:generated-shape:TRF020UpperIceWaterlineShape>
    ] ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:minCount 1 ;
        sh:class nltl:iceWaterline
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF020KeOneLow>
        <urn:nltl:generated-shape:TRF020KeOneHigh>
        <urn:nltl:generated-shape:TRF020KeTwoLow>
        <urn:nltl:generated-shape:TRF020KeTwoHigh>
        <urn:nltl:generated-shape:TRF020KeThreeLow>
        <urn:nltl:generated-shape:TRF020KeThreeHigh>
    ) ;
    sh:sparql [
        sh:message "minimumRequiredPowerAtUpperIceWaterline must conform to P_min = K_e*(R_CH/1000)^(3/2)/D_p within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputCoefficientKe ?keNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:brashIceChannelResistanceAtUpperIceWaterline ?resistanceNode ;
                      nltl:minimumRequiredPowerAtUpperIceWaterline ?powerNode .
                ?keNode qudt:numericValue ?ke .
                ?diameterNode qudt:numericValue ?diameter .
                ?resistanceNode qudt:numericValue ?resistance .
                ?powerNode qudt:numericValue ?power .
                FILTER (?diameter > 0 && ?resistance >= 0 && ?power >= 0)
                BIND (?resistance / 1000 AS ?base)
                BIND ((?ke * ?ke * ?base * ?base * ?base) / (?diameter * ?diameter) AS ?expectedSquared)
                BIND (ABS(?power * ?power - ?expectedSquared) AS ?difference)
                BIND ((0.000002 * ABS(?expectedSquared)) + 0.000000000001 AS ?tolerance)
                FILTER (?difference > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "minimumRequiredPowerAtLowerIceWaterline must conform to P_min = K_e*(R_CH/1000)^(3/2)/D_p within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:engineOutputCoefficientKe ?keNode ;
                      nltl:propellerDiameter ?diameterNode ;
                      nltl:brashIceChannelResistanceAtLowerIceWaterline ?resistanceNode ;
                      nltl:minimumRequiredPowerAtLowerIceWaterline ?powerNode .
                ?keNode qudt:numericValue ?ke .
                ?diameterNode qudt:numericValue ?diameter .
                ?resistanceNode qudt:numericValue ?resistance .
                ?powerNode qudt:numericValue ?power .
                FILTER (?diameter > 0 && ?resistance >= 0 && ?power >= 0)
                BIND (?resistance / 1000 AS ?base)
                BIND ((?ke * ?ke * ?base * ?base * ?base) / (?diameter * ?diameter) AS ?expectedSquared)
                BIND (ABS(?power * ?power - ?expectedSquared) AS ?difference)
                BIND ((0.000002 * ABS(?expectedSquared)) + 0.000000000001 AS ?tolerance)
                FILTER (?difference > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "maximumContinuousRatingPower must be at least both required power results." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:maximumContinuousRatingPower ?mcrNode ;
                      nltl:minimumRequiredPowerAtUpperIceWaterline ?upperNode ;
                      nltl:minimumRequiredPowerAtLowerIceWaterline ?lowerNode .
                ?mcrNode qudt:numericValue ?mcr .
                ?upperNode qudt:numericValue ?upperPower .
                ?lowerNode qudt:numericValue ?lowerPower .
                FILTER (?mcr < ?upperPower || ?mcr < ?lowerPower)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF020UpperIceWaterlineShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:upperIceWaterlineLength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020MetreQuantity>
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineBreadth ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF020MetreQuantity>
    ] .

<urn:nltl:generated-shape:TRF020NumericQuantity>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] .

<urn:nltl:generated-shape:TRF020UnitlessQuantity>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF020MetreQuantity>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF020KiloWattQuantity>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF020KeOneLow>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerPitchControlType ;
                sh:hasValue nltl:controllablePitch
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionSystemType ;
                sh:in (
                    nltl:electricPropulsionMachinery
                    nltl:hydraulicPropulsionMachinery
                )
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive 2.03 ;
                sh:maxInclusive 2.03
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF020KeOneHigh>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:minInclusive 1 ;
        sh:maxInclusive 1
    ] ;
    sh:property [
        sh:path nltl:propellerPitchControlType ;
        sh:hasValue nltl:fixedPitch
    ] ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minInclusive 2.26 ;
                sh:maxInclusive 2.26
            ]
        ]
    ] .

