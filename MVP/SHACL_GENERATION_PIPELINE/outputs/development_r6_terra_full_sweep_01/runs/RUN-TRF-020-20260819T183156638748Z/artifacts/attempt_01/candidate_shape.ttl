                sh:minInclusive 1.44 ;
                sh:maxInclusive 1.44
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF020KeTwoHigh>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:minInclusive 2 ;
        sh:maxInclusive 2
    ] ;
    sh:property [
        sh:path nltl:propellerPitchControlType ;
        sh:hasValue nltl:fixedPitch
    ] ;
    sh:property [
        sh:path nltl:engineOutputCoefficientKe ;
