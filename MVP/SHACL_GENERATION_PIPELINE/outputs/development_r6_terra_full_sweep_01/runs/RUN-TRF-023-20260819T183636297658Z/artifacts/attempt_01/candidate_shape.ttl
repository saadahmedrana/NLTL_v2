@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF023IceClass1985MinimumEngineOutputShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A ship retaining ice class IB or IC under the 1985 ice class rules requires a maximum continuous rating power in kW with an xsd:decimal numeric value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:iceClass ?iceClass .
                FILTER(?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?mcrPower .
                    ?mcrPower qudt:numericValue ?mcrValue ;
                              qudt:unit unit:KiloW .
                    FILTER(datatype(?mcrValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ship retaining ice class IB or IC under the 1985 ice class rules requires the applicable minimum engine output in kW with an xsd:decimal numeric value." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:iceClass ?iceClass .
                FILTER(?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                FILTER NOT EXISTS {
                    $this nltl:requiredPowerUnder1985Rules ?requiredPower .
                    ?requiredPower qudt:numericValue ?requiredValue ;
                                   qudt:unit unit:KiloW .
                    FILTER(datatype(?requiredValue) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power shall be at least the required power under the 1985 rules for ice class IB or IC." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:iceClass ?iceClass ;
                      nltl:maximumContinuousRatingPower ?mcrPower ;
                      nltl:requiredPowerUnder1985Rules ?requiredPower .
                FILTER(?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))

                ?mcrPower qudt:numericValue ?mcrValue ;
                          qudt:unit unit:KiloW .
                ?requiredPower qudt:numericValue ?requiredValue ;
                               qudt:unit unit:KiloW .

                FILTER(datatype(?mcrValue) = xsd:decimal)
                FILTER(datatype(?requiredValue) = xsd:decimal)
                FILTER(?mcrValue < ?requiredValue)
            }
        """
    ] .
