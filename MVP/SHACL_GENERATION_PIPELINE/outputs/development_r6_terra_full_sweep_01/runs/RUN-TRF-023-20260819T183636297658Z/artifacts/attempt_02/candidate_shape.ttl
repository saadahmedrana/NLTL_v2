@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

<urn:nltl:generated-shape:TRF023Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <urn:nltl:generated-shape:TRF023NonApplicableEditionShape>
        <urn:nltl:generated-shape:TRF023NonApplicableIceClassShape>
        <urn:nltl:generated-shape:TRF023ApplicableCaseShape>
    ) ;
    sh:message "Provide explicit ice-class or regulation-edition evidence to determine applicability." ;
    sh:sparql [
        sh:message "For ice class IB or IC under the 1985 rules, MCR and required power must be represented in KiloW with numeric values." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                FILTER NOT EXISTS {
                    $this nltl:maximumContinuousRatingPower ?mcr ;
                          nltl:requiredPowerUnder1985Rules ?required .
                    ?mcr qudt:unit unit:KiloW ;
                         qudt:numericValue ?mcrValue .
                    ?required qudt:unit unit:KiloW ;
                              qudt:numericValue ?requiredValue .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Maximum continuous rating power must be at least the required power under the 1985 rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            SELECT $this
            WHERE {
                $this nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
                      nltl:iceClass ?iceClass ;
                      nltl:maximumContinuousRatingPower ?mcr ;
                      nltl:requiredPowerUnder1985Rules ?required .
                FILTER (?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))
                ?mcr qudt:unit unit:KiloW ;
                     qudt:numericValue ?mcrValue .
                ?required qudt:unit unit:KiloW ;
                          qudt:numericValue ?requiredValue .
                FILTER (?mcrValue < ?requiredValue)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF023NonApplicableEditionShape>
    a sh:NodeShape ;
    sh:or (
        [ sh:property [
            sh:path nltl:applicableIceClassRegulationEdition ;
            sh:hasValue nltl:iceClassRegulationEdition2002
        ] ]
        [ sh:property [
            sh:path nltl:applicableIceClassRegulationEdition ;
            sh:hasValue nltl:iceClassRegulationEdition2008
        ] ]
        [ sh:property [
            sh:path nltl:applicableIceClassRegulationEdition ;
            sh:hasValue nltl:iceClassRegulationEdition2010
        ] ]
        [ sh:property [
            sh:path nltl:applicableIceClassRegulationEdition ;
            sh:hasValue nltl:iceClassRegulationEdition2017
        ] ]
        [ sh:property [
            sh:path nltl:applicableIceClassRegulationEdition ;
            sh:hasValue nltl:iceClassRegulationEdition2021
        ] ]
    ) .

<urn:nltl:generated-shape:TRF023NonApplicableIceClassShape>
    a sh:NodeShape ;
    sh:or (
        [ sh:property [
            sh:path nltl:iceClass ;
            sh:hasValue nltl:iceClassIa
        ] ]
        [ sh:property [
            sh:path nltl:iceClass ;
            sh:hasValue nltl:iceClassIaSuper
        ] ]
        [ sh:property [
            sh:path nltl:iceClass ;
            sh:hasValue nltl:iceClassIi
        ] ]
        [ sh:property [
            sh:path nltl:iceClass ;
            sh:hasValue nltl:iceClassIii
        ] ]
    ) .

<urn:nltl:generated-shape:TRF023ApplicableIceClassShape>
    a sh:NodeShape ;
    sh:or (
        [ sh:property [
            sh:path nltl:iceClass ;
            sh:hasValue nltl:iceClassIb
        ] ]
        [ sh:property [
            sh:path nltl:iceClass ;
            sh:hasValue nltl:iceClassIc
        ] ]
    ) .

<urn:nltl:generated-shape:TRF023ApplicableCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:applicableIceClassRegulationEdition ;
        sh:hasValue nltl:iceClassRuleEdition1985
    ] ;
    sh:node <urn:nltl:generated-shape:TRF023ApplicableIceClassShape> ;
    sh:property [
        sh:path nltl:maximumContinuousRatingPower ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:requiredPowerUnder1985Rules ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KiloW ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
