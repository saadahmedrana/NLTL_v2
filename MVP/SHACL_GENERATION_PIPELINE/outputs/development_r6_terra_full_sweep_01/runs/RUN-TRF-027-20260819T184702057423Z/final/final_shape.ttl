@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qv: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:TRF027Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:message "Exactly one controlled ice class is required."
    ] ;
    sh:or (
        gs:TRF027ApplicableShape
        gs:TRF027IaOnOrAfterCutoffShape
        gs:TRF027OtherIceClassShape
    ) .

gs:TRF027ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:maxExclusive "2003-09-01"^^xsd:date ;
        sh:message "An IA Super or IA ship requires a construction stage date to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:coefficientC3 ;
        sh:minCount 1 ;
        sh:node gs:C3ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC4 ;
        sh:minCount 1 ;
        sh:node gs:C4ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientC5 ;
        sh:minCount 1 ;
        sh:node gs:C5ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF1 ;
        sh:minCount 1 ;
        sh:node gs:F1ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF2 ;
        sh:minCount 1 ;
        sh:node gs:F2ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF3 ;
        sh:minCount 1 ;
        sh:node gs:F3ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientF4 ;
        sh:minCount 1 ;
        sh:node gs:F4ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG1 ;
        sh:minCount 1 ;
        sh:node gs:G1ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG2 ;
        sh:minCount 1 ;
        sh:node gs:G2ValueShape
    ] ;
    sh:property [
        sh:path nltl:coefficientG3 ;
        sh:minCount 1 ;
        sh:node gs:G3ValueShape
    ] ;
    sh:property [
        sh:path nltl:shipLength ;
        sh:minCount 1 ;
        sh:node gs:MetreValueShape
    ] ;
    sh:property [
        sh:path nltl:iceClassDraught ;
        sh:minCount 1 ;
        sh:node gs:MetreValueShape
    ] ;
    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:node gs:PositiveMetreValueShape ;
        sh:message "Ship breadth must be greater than zero for the clamped hull geometry calculation."
    ] ;
    sh:property [
        sh:path nltl:clampedHullGeometryTerm ;
        sh:minCount 1 ;
        sh:node gs:UnitlessValueShape
    ] ;
    sh:sparql [
        sh:message "clampedHullGeometryTerm must equal the value of ((L*T)/B^2)^3 clamped to the inclusive range 5 to 20, within a relative tolerance of 1e-6 and an absolute tolerance of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qv: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:shipLength ?lengthNode ;
                      nltl:iceClassDraught ?draughtNode ;
                      nltl:shipBreadth ?breadthNode ;
                      nltl:clampedHullGeometryTerm ?termNode .
                ?lengthNode qv:numericValue ?l .
                ?draughtNode qv:numericValue ?t .
                ?breadthNode qv:numericValue ?b .
                ?termNode qv:numericValue ?reported .
                FILTER (?b > 0)
                BIND((?l * ?t) / (?b * ?b) AS ?base)
                BIND((?base * ?base * ?base) AS ?raw)
                BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                BIND((1e-9 + (1e-6 * ABS(?expected))) AS ?tolerance)
                FILTER (ABS(?reported - ?expected) > ?tolerance)
            }
        """
    ] .

gs:TRF027IaOnOrAfterCutoffShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in ( nltl:iceClassIaSuper nltl:iceClassIa )
    ] ;
    sh:property [
        sh:path nltl:constructionStageDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "2003-09-01"^^xsd:date
    ] .

gs:TRF027OtherIceClassShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        )
    ] .

gs:C3ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "460"^^xsd:decimal ;
        sh:maxInclusive "460"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:C4ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "18.7"^^xsd:decimal ;
        sh:maxInclusive "18.7"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue nltl:kilogramPerSquareMetreSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:C5ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "825"^^xsd:decimal ;
        sh:maxInclusive "825"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue nltl:kilogramPerSquareSecondUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:F1ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "10.3"^^xsd:decimal ;
        sh:maxInclusive "10.3"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:F2ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "45.8"^^xsd:decimal ;
        sh:maxInclusive "45.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:F3ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "2.94"^^xsd:decimal ;
        sh:maxInclusive "2.94"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:F4ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "5.8"^^xsd:decimal ;
        sh:maxInclusive "5.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:N-PER-M2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:G1ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "1530"^^xsd:decimal ;
        sh:maxInclusive "1530"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:N ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:G2ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "170"^^xsd:decimal ;
        sh:maxInclusive "170"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:N-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:G3ValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "400"^^xsd:decimal ;
        sh:maxInclusive "400"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue nltl:newtonPerMetreToPowerOnePointFiveUnit ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MetreValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositiveMetreValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive "0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:UnitlessValueShape
    a sh:NodeShape ;
    sh:class qv:QuantityValue ;
    sh:property [
        sh:path qv:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qv:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
