@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF032ScantlingShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengtheningStatus ;
        sh:datatype xsd:boolean ;
        sh:in ( true false ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice strengthening status must be explicitly recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue false
            ] ;
            sh:sparql [
                sh:message "When regulation-required scantling is less than classification-society-required scantling for a ship not ice strengthened, selected design scantling must be a QuantityValue numerically equal to the classification-society-required scantling within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:iceStrengtheningStatus false ;
                              nltl:regulationRequiredScantling ?regulationQuantity ;
                              nltl:classificationSocietyRequiredScantling ?classificationQuantity .

                        ?regulationQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?regulationValue .

                        ?classificationQuantity a qudt:QuantityValue ;
                            qudt:numericValue ?classificationValue .

                        FILTER(
                            datatype(?regulationValue) = xsd:decimal &&
                            datatype(?classificationValue) = xsd:decimal &&
                            ?regulationValue < ?classificationValue
                        )

                        BIND(
                            IF(
                                ABS(?classificationValue) * 0.000001 > 0.000000001,
                                ABS(?classificationValue) * 0.000001,
                                0.000000001
                            )
                            AS ?tolerance
                        )

                        FILTER NOT EXISTS {
                            $this nltl:selectedDesignScantling ?selectedQuantity .
                            ?selectedQuantity a qudt:QuantityValue ;
                                qudt:numericValue ?selectedValue .
                            FILTER(
                                datatype(?selectedValue) = xsd:decimal &&
                                ABS(?selectedValue - ?classificationValue) <= ?tolerance
                            )
                        }
                    }
                """
            ]
        ]
    ) .
