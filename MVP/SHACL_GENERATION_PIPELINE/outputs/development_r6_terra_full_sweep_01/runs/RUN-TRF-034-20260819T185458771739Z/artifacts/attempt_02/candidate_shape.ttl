@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-034EffectiveMemberCrossSectionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3>
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue <http://qudt.org/vocab/unit/M2>
            ]
        ]
    ] ;

    sh:property [
        sh:path [
            sh:inversePath nltl:hasEffectiveMemberCrossSection
        ] ;
        sh:minCount 1 ;
        sh:class nltl:hullStructure ;
        sh:node [
            sh:property [
                sh:path nltl:memberNormalToPlating ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "Classification society section-property calculation evidence is required when the member is not normal to plating." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                ?hull nltl:hasEffectiveMemberCrossSection $this ;
                      nltl:memberNormalToPlating false .
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                    ?evidence a nltl:evidenceArtifact .
                }
            }
        """
    ] .
