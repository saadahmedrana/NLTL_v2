@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-036Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceClassDesignParameterSet ;
    sh:property [
        sh:path ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ;
        sh:minCount 1 ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
        ) ;
        sh:message "The owning ship must have an ice class covered by Table 4-1."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:levelIceThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ;
                sh:hasValue nltl:iceClassIaSuper ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive 0.35 ;
                        sh:maxInclusive 0.35
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 1.0
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ;
                sh:hasValue nltl:iceClassIa ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive 0.30 ;
                        sh:maxInclusive 0.30
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 0.8
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ;
                sh:hasValue nltl:iceClassIb ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive 0.25 ;
                        sh:maxInclusive 0.25
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 0.6
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path ( [ sh:inversePath nltl:hasIceClassDesignParameterSet ] nltl:iceClass ) ;
                sh:hasValue nltl:iceClassIc ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:designIceLoadHeight ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive 0.22 ;
                        sh:maxInclusive 0.22
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxInclusive 0.4
                    ]
                ]
            ]
        ]
    ) .
