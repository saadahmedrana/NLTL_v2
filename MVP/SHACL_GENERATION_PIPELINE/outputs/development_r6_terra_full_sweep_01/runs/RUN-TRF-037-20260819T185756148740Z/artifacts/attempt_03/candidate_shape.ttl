@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:PowerQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloW ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DirectAnalysisCaseShape
    a sh:NodeShape ;
    sh:class nltl:directAnalysisCase ;
    sh:property [
        sh:path nltl:iceLoadAreaFactorCa ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] .

gen:TRF037Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:continuousPropulsionPowerAvailableInIce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PowerQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasDirectAnalysisCase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DirectAnalysisCaseShape
    ] ;
    sh:property [
        sh:path nltl:iceClassFactorCp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:nominalIcePressureP0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientA ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientB ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputCoefficientK ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:shipSizeEngineOutputFactorCd ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:PressureQuantityShape
    ] ;
    sh:sparql [
        sh:message "shipSizeEngineOutputFactorCd must equal min(1, (a*k+b)/1000) within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputCoefficientA ?aNode ;
                      nltl:shipSizeEngineOutputCoefficientB ?bNode ;
                      nltl:shipSizeEngineOutputCoefficientK ?kNode ;
                      nltl:shipSizeEngineOutputFactorCd ?cdNode .
                ?aNode qudt:numericValue ?a .
                ?bNode qudt:numericValue ?b .
                ?kNode qudt:numericValue ?k .
                ?cdNode qudt:numericValue ?cd .
                BIND ((?a * ?k + ?b) / 1000.0 AS ?rawCd)
                BIND (IF(?rawCd > 1.0, 1.0, ?rawCd) AS ?expectedCd)
                FILTER (ABS(?cd - ?expectedCd) > ((0.000001 * ABS(?expectedCd)) + 0.000000001))
            }
        """
    ] ;
    sh:sparql [
        sh:message "icePressure must equal shipSizeEngineOutputFactorCd multiplied by iceClassFactorCp, iceLoadAreaFactorCa, and nominalIcePressureP0 within tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:shipSizeEngineOutputFactorCd ?cdNode ;
                      nltl:iceClassFactorCp ?cpNode ;
                      nltl:nominalIcePressureP0 ?p0Node ;
                      nltl:icePressure ?pressureNode ;
                      nltl:hasDirectAnalysisCase ?case .
                ?case nltl:iceLoadAreaFactorCa ?caNode .
                ?cdNode qudt:numericValue ?cd .
                ?cpNode qudt:numericValue ?cp .
                ?caNode qudt:numericValue ?ca .
                ?p0Node qudt:numericValue ?p0 .
                ?pressureNode qudt:numericValue ?pressure .
                BIND ((?cd * ?cp * ?ca * ?p0) AS ?expectedPressure)
                FILTER (ABS(?pressure - ?expectedPressure) > ((0.000001 * ABS(?expectedPressure)) + 0.000000001))
            }
        """
    ] .
