@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-044Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;

    sh:property [
        sh:path nltl:frameBoundaryConditionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:bulkCarrierTopWingTankFrameCondition
            nltl:singleDeckTankTopToMainDeckFrameCondition
            nltl:multiDeckOrStringerContinuousFrameCondition
            nltl:twoDeckFrameCondition
        )
    ] ;

    sh:property [
        sh:path nltl:frameBoundaryConditionFactorM0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:frameMomentFactorMt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:frameShearDistributionFactorF3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "1.2"^^xsd:decimal ;
                sh:maxInclusive "1.2"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:effectiveFrameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MegaPA ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:sparql [
        sh:message "frameBoundaryConditionFactorM0 must match Table 4-7 for the selected frame boundary condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionType ?condition ;
                      nltl:frameBoundaryConditionFactorM0 ?m0Value .
                ?m0Value qudt:numericValue ?m0 .
                FILTER (
                    (?condition = nltl:bulkCarrierTopWingTankFrameCondition && ?m0 != 7) ||
                    (?condition = nltl:singleDeckTankTopToMainDeckFrameCondition && ?m0 != 6) ||
                    (?condition = nltl:multiDeckOrStringerContinuousFrameCondition && ?m0 != 5.7) ||
                    (?condition = nltl:twoDeckFrameCondition && ?m0 != 5)
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "Effective frame span must not be zero for the TRF-044 calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:effectiveFrameSpan ?spanValue .
                ?spanValue qudt:numericValue ?span .
                FILTER (?span = 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "The m_t denominator 7 - 5*h/l must not be zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?heightValue ;
                      nltl:effectiveFrameSpan ?spanValue .
                ?heightValue qudt:numericValue ?height .
                ?spanValue qudt:numericValue ?span .
                FILTER (?span != 0)
                FILTER ((7 - (5 * ?height / ?span)) = 0)
            }
        """
    ] ;

    sh:sparql [
        sh:message "m_t, section modulus, and required shear area must match the TRF-044 formulae within relative tolerance 1e-6 and absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:frameBoundaryConditionFactorM0 ?m0Value ;
                      nltl:frameMomentFactorMt ?mtValue ;
                      nltl:icePressure ?pressureValue ;
                      nltl:spacing ?spacingValue ;
                      nltl:designIceLoadHeight ?heightValue ;
                      nltl:effectiveFrameSpan ?spanValue ;
                      nltl:yieldStrength ?yieldValue ;
                      nltl:sectionModulus ?sectionValue ;
                      nltl:requiredShearArea ?areaValue .
                ?m0Value qudt:numericValue ?m0 .
                ?mtValue qudt:numericValue ?mt .
                ?pressureValue qudt:numericValue ?pressure .
                ?spacingValue qudt:numericValue ?spacing .
                ?heightValue qudt:numericValue ?height .
                ?spanValue qudt:numericValue ?span .
                ?yieldValue qudt:numericValue ?yield .
                ?sectionValue qudt:numericValue ?section .
                ?areaValue qudt:numericValue ?area .
                FILTER (?span != 0)
                FILTER ((7 - (5 * ?height / ?span)) != 0)
                BIND((7 * ?m0 / (7 - (5 * ?height / ?span))) AS ?expectedMt)
                BIND((?pressure * ?spacing * ?height * ?span / (?expectedMt * ?yield) * 1000000) AS ?expectedSection)
                BIND((1.7320508075688772 * 1.2 * ?pressure * ?height * ?spacing / (2 * ?yield) * 10000) AS ?expectedArea)
                FILTER (
                    ABS(?mt - ?expectedMt) > (ABS(?expectedMt) * 0.000001 + 0.000000001) ||
                    ABS(?section - ?expectedSection) > (ABS(?expectedSection) * 0.000001 + 0.000000001) ||
                    ABS(?area - ?expectedArea) > (ABS(?expectedArea) * 0.000001 + 0.000000001)
                )
            }
        """
    ] .
