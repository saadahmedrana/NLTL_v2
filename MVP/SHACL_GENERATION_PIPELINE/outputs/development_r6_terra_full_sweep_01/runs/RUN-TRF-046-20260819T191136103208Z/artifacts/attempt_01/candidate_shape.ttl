@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix gs: <urn:nltl:generated-shape:> .

gs:TRF046FrameUpperEndAttachmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        sh:message "A main frame or intermediate ice frame requires a strengthened part whose upper end is attached to a deck, tank boundary plating, or ice stringer." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this a ?frameKind .
                FILTER (?frameKind IN (nltl:mainFrame, nltl:intermediateIceFrame))

                FILTER NOT EXISTS {
                    $this nltl:hasStrengthenedPart ?part ;
                          nltl:hasUpperEnd ?end .
                    ?part a nltl:frameStrengthenedPart .
                    ?end nltl:hasAttachedSupportingStructure ?structure .
                    ?structure a ?structureKind .
                    FILTER (?structureKind IN (
                        nltl:deckStructure,
                        nltl:tankBoundaryPlating,
                        nltl:iceStringer
                    ))
                }
            }
        """
    ] .
