@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF047FrameLowerEndShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:sparql [
        sh:message "Each lower end of a strengthened main-frame part shall be attached to an allowed supporting structure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this a nltl:mainFrame ;
                    nltl:hasStrengthenedPart ?part ;
                    nltl:hasLowerEnd ?value .
                FILTER NOT EXISTS {
                    ?value nltl:hasAttachedSupportingStructure ?support .
                    ?support a ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:tankTop,
                            nltl:iceStringer
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each lower end of a strengthened intermediate ice-frame part shall be attached to an allowed supporting structure or use the permitted horizontal-member alternative." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this ?value
            WHERE {
                $this a nltl:intermediateIceFrame ;
                    nltl:hasStrengthenedPart ?part ;
                    nltl:hasLowerEnd ?value .
                FILTER NOT EXISTS {
                    ?value nltl:hasAttachedSupportingStructure ?support .
                    ?support a ?supportType .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:tankTop,
                            nltl:iceStringer
                        )
                    )
                }
                FILTER NOT EXISTS {
                    ?value nltl:hasTerminationBelowSupportingStructure ?support ;
                           nltl:hasHorizontalConnectionMember ?member .
                    ?support a ?supportType ;
                             nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .
                    ?member a nltl:horizontalConnectionMember ;
                            nltl:connectsToAdjacentMainFrame ?adjacentMainFrame ;
                            nltl:sameScantlingsAsMainFrame true .
                    ?adjacentMainFrame a nltl:mainFrame .
                    FILTER (
                        ?supportType IN (
                            nltl:deckStructure,
                            nltl:tankBoundaryPlating,
                            nltl:tankTop,
                            nltl:iceStringer
                        )
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A main frame below the lower edge of the ice belt shall be recorded as ice strengthened." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:mainFrame .
                FILTER NOT EXISTS {
                    $this nltl:mainFrameBelowIceBeltStrengthened true .
                }
            }
        """
    ] .
