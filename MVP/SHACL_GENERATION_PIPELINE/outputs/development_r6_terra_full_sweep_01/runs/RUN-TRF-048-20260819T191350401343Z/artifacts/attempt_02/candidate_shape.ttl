@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-048-AreaQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-LengthQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-PositiveLengthQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-PressureQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-PositivePressureQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-SectionModulusQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-UnitlessQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-PositiveUnitlessQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-F5Quantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 2.16 ;
        sh:maxInclusive 2.16
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-M13-3Quantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive 13.3 ;
        sh:maxInclusive 13.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-SmallerMQuantity>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0 ;
        sh:maxExclusive 13.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF-048-LongitudinalFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-LengthQuantity>
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-PressureQuantity>
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-LengthQuantity>
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-PositiveLengthQuantity> ;
        sh:message "Frame spacing must be a positive decimal length in metres."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-PositivePressureQuantity> ;
        sh:message "Yield strength must be a positive decimal pressure in MPa."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-UnitlessQuantity>
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-F5Quantity>
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-PositiveUnitlessQuantity> ;
        sh:message "Frame moment factor m must be a positive decimal dimensionless value."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-SectionModulusQuantity>
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-AreaQuantity>
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-AreaQuantity>
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-048-AreaQuantity>
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Boundary-condition status is required to select the frame moment factor rule."
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-048-M13-3Quantity>
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameBoundaryConditionEvidence ;
                sh:minCount 1 ;
                sh:class nltl:frameBoundaryConditionEvidence ;
                sh:message "Evidence of significantly different boundary conditions is required when using a smaller frame moment factor."
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-048-SmallerMQuantity>
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "f4, section modulus, and actual frame shear area must conform to the prescribed formulae; actual frame shear area excludes bracket area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hQ ;
                      nltl:icePressure ?pQ ;
                      nltl:span ?lQ ;
                      nltl:spacing ?sQ ;
                      nltl:yieldStrength ?syQ ;
                      nltl:frameMomentFactorM ?mQ ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Q ;
                      nltl:longitudinalFrameShearFactorF5 ?f5Q ;
                      nltl:sectionModulus ?zQ ;
                      nltl:grossFrameShearArea ?grossQ ;
                      nltl:bracketArea ?bracketQ ;
                      nltl:actualFrameShearArea ?actualQ .

                ?hQ qudt:numericValue ?h .
                ?pQ qudt:numericValue ?p .
                ?lQ qudt:numericValue ?l .
                ?sQ qudt:numericValue ?s .
                ?syQ qudt:numericValue ?sy .
                ?mQ qudt:numericValue ?m .
                ?f4Q qudt:numericValue ?f4 .
                ?f5Q qudt:numericValue ?f5 .
                ?zQ qudt:numericValue ?z .
                ?grossQ qudt:numericValue ?gross .
                ?bracketQ qudt:numericValue ?bracket .
                ?actualQ qudt:numericValue ?actual .

                BIND((1.0 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND((?expectedF4 * ?p * ?h * ?l * ?l / (4.0 * ?m * ?sy) * 1000000.0) AS ?expectedZ)
                BIND((1.7320508075688772 * ?expectedF4 * ?f5 * ?p * ?h * ?l / (2.0 * ?sy) * 10000.0) AS ?expectedA)
                BIND((?gross - ?bracket) AS ?expectedActual)

                FILTER (
                    ABS(?f4 - ?expectedF4) > ((ABS(?expectedF4) * 0.000001) + 0.000000001) ||
                    ABS(?z - ?expectedZ) > ((ABS(?expectedZ) * 0.000001) + 0.000000001) ||
                    ABS(?actual - ?expectedA) > ((ABS(?expectedA) * 0.000001) + 0.000000001) ||
                    ABS(?actual - ?expectedActual) > ((ABS(?expectedActual) * 0.000001) + 0.000000001)
                )
            }
        """
    ] .
