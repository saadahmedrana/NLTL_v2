@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF049QuantityMillimetresShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM>
    ] .

<urn:nltl:generated-shape:TRF049ConnectionBracketShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bracketThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF049QuantityMillimetresShape>
    ] ;
    sh:property [
        sh:path nltl:bracketEdgeStiffened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:bucklingStiffening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] .

<urn:nltl:generated-shape:TRF049FrameAttachmentEvidenceShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:effectiveAttachmentConfirmed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasAttachedSupportingStructure ;
        sh:class nltl:supportingStructure ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasConnectionBracket ;
        sh:class nltl:connectionBracket ;
        sh:node <urn:nltl:generated-shape:TRF049ConnectionBracketShape>
    ] .

<urn:nltl:generated-shape:TRF049FrameBracketAndThicknessShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:hasFrameAttachment ;
        sh:class nltl:frameAttachment ;
        sh:node [
            sh:property [
                sh:path nltl:hasConnectionBracket ;
                sh:class nltl:connectionBracket ;
                sh:node <urn:nltl:generated-shape:TRF049ConnectionBracketShape>
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path ( nltl:hasFrameAttachment nltl:hasConnectionBracket ) ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:frameWebThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF049QuantityMillimetresShape>
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Bracket thickness must be at least the frame web thickness in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasFrameAttachment ?attachment ;
                      nltl:frameWebThickness ?webThickness .
                ?attachment nltl:hasConnectionBracket ?bracket .
                ?webThickness qudt:numericValue ?webValue ;
                              qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?bracket nltl:bracketThickness ?bracketThickness .
                ?bracketThickness qudt:numericValue ?bracketValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                FILTER (?bracketValue < ?webValue)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF049IceAreaAttachmentShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:withinIceStrengthenedArea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:withinIceStrengthenedArea ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:class nltl:frameAttachment ;
                sh:node <urn:nltl:generated-shape:TRF049FrameAttachmentEvidenceShape>
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "Each declared supporting web frame or bulkhead must share an attachment with the frame." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      ?supportProperty ?support .
                FILTER (?supportProperty IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?support .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF049LongitudinalFrameAttachmentShape>
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:sparql [
        sh:message "A longitudinal frame must be attached by a bracket to each declared supporting web frame and bulkhead." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:withinIceStrengthenedArea true ;
                      ?supportProperty ?support .
                FILTER (?supportProperty IN (
                    nltl:hasSupportingWebFrame,
                    nltl:hasSupportingBulkhead
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasFrameAttachment ?attachment .
                    ?attachment nltl:hasAttachedSupportingStructure ?support ;
                                nltl:hasConnectionBracket ?bracket .
                    ?support nltl:hasSupportingStructureAttachment ?attachment .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF049TransverseFrameTerminationShape>
    a sh:NodeShape ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:terminatesAtDeckOrIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:terminatesAtDeckOrIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasFrameAttachment ;
                sh:minCount 1 ;
                sh:class nltl:frameAttachment ;
                sh:node [
                    sh:or (
                        [
                            sh:property [
                                sh:path nltl:hasConnectionBracket ;
                                sh:minCount 1 ;
                                sh:class nltl:connectionBracket
                            ]
                        ]
                        [
                            sh:property [
                                sh:path nltl:similarAttachmentConstructionPresent ;
                                sh:datatype xsd:boolean ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:hasValue true
                            ]
                        ]
                    )
                ]
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF049FrameThroughSupportingStructureShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:targetClass nltl:transverseFrame ;
    sh:property [
        sh:path nltl:passesThroughSupportingStructure ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:passesThroughSupportingStructure ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:webPlateConnectionSideCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ]
        ]
    ) .
