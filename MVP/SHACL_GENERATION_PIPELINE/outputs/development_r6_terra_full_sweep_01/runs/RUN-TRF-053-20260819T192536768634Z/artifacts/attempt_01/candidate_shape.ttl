@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF053IceStringerShape>
    a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:locatedWithinIceBelt ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "locatedWithinIceBelt is required to determine applicability of the stringer calculation."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:locatedWithinIceBelt ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:locatedWithinIceBelt ;
                sh:hasValue true
            ] ;
            sh:node <urn:nltl:generated-shape:TRF053FormulaInputsShape>
        ]
    ) .

<urn:nltl:generated-shape:TRF053FormulaInputsShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureMPaQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthMQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:LineLoadQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthMQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PositiveUnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:PositivePressureMPaQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceStringerDistributionFactorF6 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceStringerSafetyFactorF7 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceStringerShearFactorF8 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:SectionModulusQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:ShearAreaQuantityShape>
    ] ;
    sh:sparql [
        sh:message "Design line load, section modulus, and required shear area must conform to the 4.5.1 calculation within a relative tolerance of 1e-6 and absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQ ;
                      nltl:designIceLoadHeight ?heightQ ;
                      nltl:designLineLoad ?lineLoadQ ;
                      nltl:span ?spanQ ;
                      nltl:frameMomentFactorM ?momentQ ;
                      nltl:yieldStrength ?yieldQ ;
                      nltl:iceStringerDistributionFactorF6 ?f6Q ;
                      nltl:iceStringerSafetyFactorF7 ?f7Q ;
                      nltl:iceStringerShearFactorF8 ?f8Q ;
                      nltl:sectionModulus ?sectionQ ;
                      nltl:requiredShearArea ?areaQ .
                ?pressureQ qudt:numericValue ?pressure .
                ?heightQ qudt:numericValue ?height .
                ?lineLoadQ qudt:numericValue ?lineLoad .
                ?spanQ qudt:numericValue ?span .
                ?momentQ qudt:numericValue ?moment .
                ?yieldQ qudt:numericValue ?yield .
                ?f6Q qudt:numericValue ?f6 .
                ?f7Q qudt:numericValue ?f7 .
                ?f8Q qudt:numericValue ?f8 .
                ?sectionQ qudt:numericValue ?section .
                ?areaQ qudt:numericValue ?area .
                FILTER (?moment > 0 && ?yield > 0)
                BIND(IF((?pressure * ?height) < 0.15, 0.15, (?pressure * ?height)) AS ?expectedLineLoad)
                BIND((?f6 * ?f7 * ?expectedLineLoad * ?span * ?span / (?moment * ?yield) * 1000000) AS ?expectedSection)
                BIND((1.7320508075688772 * ?f6 * ?f7 * ?f8 * ?expectedLineLoad * ?span / (2 * ?yield) * 10000) AS ?expectedArea)
                FILTER (
                    ABS(?lineLoad - ?expectedLineLoad) > ((0.000001 * ABS(?expectedLineLoad)) + 0.000000001) ||
                    ABS(?section - ?expectedSection) > ((0.000001 * ABS(?expectedSection)) + 0.000000001) ||
                    ABS(?area - ?expectedArea) > ((0.000001 * ABS(?expectedArea)) + 0.000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:LengthMQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:PressureMPaQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:PositivePressureMPaQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:LineLoadQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:PositiveUnitlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:ShearAreaQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
