@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LengthQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gs:PositiveLengthQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gs:PressureQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gs:PositivePressureQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

gs:DimensionlessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gs:PositiveDimensionlessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gs:LineLoadQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN-PER-M
    ] .

gs:SectionModulusQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:CentiM3
    ] .

gs:ShearAreaQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:CentiM2
    ] .

gs:F9QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.80 ;
        sh:maxInclusive 0.80
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gs:F10QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.8 ;
        sh:maxInclusive 1.8
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gs:F11QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.2 ;
        sh:maxInclusive 1.2
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

gs:TRF054ApplicableCalculationShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:locatedOutsideIceBelt ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:supportsIceStrengthenedFrames ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gs:PressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:node gs:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designLineLoad ;
        sh:minCount 1 ;
        sh:node gs:LineLoadQuantityShape
    ] ;
    sh:property [
        sh:path nltl:stringerSpan ;
        sh:minCount 1 ;
        sh:node gs:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:distanceToAdjacentIceStringer ;
        sh:minCount 1 ;
        sh:node gs:PositiveLengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:distanceToIceBelt ;
        sh:minCount 1 ;
        sh:node gs:LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:node gs:PositiveDimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:node gs:PositivePressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltDistributionFactorF9 ;
        sh:minCount 1 ;
        sh:node gs:F9QuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltSafetyFactorF10 ;
        sh:minCount 1 ;
        sh:node gs:F10QuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltShearFactorF11 ;
        sh:minCount 1 ;
        sh:node gs:F11QuantityShape
    ] ;
    sh:property [
        sh:path nltl:outsideIceBeltFactor ;
        sh:minCount 1 ;
        sh:node gs:DimensionlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node gs:SectionModulusQuantityShape
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:minCount 1 ;
        sh:node gs:ShearAreaQuantityShape
    ] .

gs:TRF054IceStringerShape a sh:NodeShape ;
    sh:targetClass nltl:iceStringer ;
    sh:property [
        sh:path nltl:locatedOutsideIceBelt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Located-outside-ice-belt status is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:supportsIceStrengthenedFrames ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Ice-strengthened-frame support status is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:locatedOutsideIceBelt ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:supportsIceStrengthenedFrames ;
                sh:hasValue false
            ]
        ]
        gs:TRF054ApplicableCalculationShape
    ) ;
    sh:sparql [
        sh:message "For an outside-ice-belt stringer supporting ice-strengthened frames, design line load, outside-ice-belt factor, section modulus, and required shear area must conform to clause 4.5.2." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:locatedOutsideIceBelt true ;
                      nltl:supportsIceStrengthenedFrames true ;
                      nltl:icePressure ?pressureQ ;
                      nltl:designIceLoadHeight ?heightQ ;
                      nltl:designLineLoad ?lineQ ;
                      nltl:stringerSpan ?spanQ ;
                      nltl:distanceToAdjacentIceStringer ?adjacentQ ;
                      nltl:distanceToIceBelt ?beltQ ;
                      nltl:frameMomentFactorM ?momentQ ;
                      nltl:yieldStrength ?yieldQ ;
                      nltl:outsideIceBeltFactor ?factorQ ;
                      nltl:sectionModulus ?sectionQ ;
                      nltl:requiredShearArea ?areaQ .

                ?pressureQ qudt:numericValue ?pressure .
                ?heightQ qudt:numericValue ?height .
                ?lineQ qudt:numericValue ?line .
                ?spanQ qudt:numericValue ?span .
                ?adjacentQ qudt:numericValue ?adjacent .
                ?beltQ qudt:numericValue ?belt .
                ?momentQ qudt:numericValue ?moment .
                ?yieldQ qudt:numericValue ?yield .
                ?factorQ qudt:numericValue ?factor .
                ?sectionQ qudt:numericValue ?section .
                ?areaQ qudt:numericValue ?area .

                BIND(IF((?pressure * ?height * 1000) < 150,
                        150,
                        (?pressure * ?height * 1000)) AS ?expectedLine)
                BIND((1 - (?belt / ?adjacent)) AS ?expectedFactor)
                BIND((0.80 * 1.8 * (?expectedLine / 1000) * ?span * ?span /
                      (?moment * ?yield) * ?expectedFactor * 1000000) AS ?expectedSection)
                BIND((1.7320508075688772 * 0.80 * 1.8 * 1.2 *
                      (?expectedLine / 1000) * ?span /
                      (2 * ?yield) * ?expectedFactor * 10000) AS ?expectedArea)

                FILTER(
                    ABS(?line - ?expectedLine) >
                        (0.000001 * ABS(?expectedLine) + 0.000000001) ||
                    ABS(?factor - ?expectedFactor) >
                        (0.000001 * ABS(?expectedFactor) + 0.000000001) ||
                    ABS(?section - ?expectedSection) >
                        (0.000001 * ABS(?expectedSection) + 0.000000001) ||
                    ABS(?area - ?expectedArea) >
                        (0.000001 * ABS(?expectedArea) + 0.000000001)
                )
            }
        """
    ] .
