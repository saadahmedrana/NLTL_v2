@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:SectionModulusValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ShearAreaValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:ReducedLineLoadValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.10 ;
        sh:maxExclusive 0.15 ;
        sh:message "The permitted reduced line-load value for a very long hatch must be at least 0.10 and less than 0.15."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF055NarrowDeckStripShape a sh:NodeShape ;
    sh:targetClass nltl:narrowDeckStrip ;
    sh:property [
        sh:path nltl:abreastOfHatch ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether the narrow deck strip is abreast of a hatch must be recorded."
    ] ;
    sh:property [
        sh:path nltl:servesAsIceStringer ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether the narrow deck strip serves as an ice stringer must be recorded."
    ] ;
    sh:property [
        sh:path nltl:veryLongHatchOpening ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether the hatch opening is very long must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:abreastOfHatch ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:servesAsIceStringer ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:actualSectionModulus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:SectionModulusValueShape
            ] ;
            sh:property [
                sh:path nltl:requiredSectionModulus ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:SectionModulusValueShape
            ] ;
            sh:property [
                sh:path nltl:actualShearArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ShearAreaValueShape
            ] ;
            sh:property [
                sh:path nltl:requiredShearArea ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ShearAreaValueShape
            ] ;
            sh:sparql [
                sh:message "Actual section modulus and actual shear area must each be at least their corresponding required value." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:actualSectionModulus ?actualSectionModulus ;
                              nltl:requiredSectionModulus ?requiredSectionModulus ;
                              nltl:actualShearArea ?actualShearArea ;
                              nltl:requiredShearArea ?requiredShearArea .
                        ?actualSectionModulus qudt:numericValue ?actualSectionModulusValue .
                        ?requiredSectionModulus qudt:numericValue ?requiredSectionModulusValue .
                        ?actualShearArea qudt:numericValue ?actualShearAreaValue .
                        ?requiredShearArea qudt:numericValue ?requiredShearAreaValue .
                        FILTER (
                            ?actualSectionModulusValue < ?requiredSectionModulusValue ||
                            ?actualShearAreaValue < ?requiredShearAreaValue
                        )
                    }
                """
            ]
        ]
    ) ;
    sh:or (
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:veryLongHatchOpening ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:reducedLineLoadApprovedByClassificationSociety ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "A reduced line load for a very long hatch requires classification-society approval."
            ] ;
            sh:property [
                sh:path nltl:permittedReducedLineLoad ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:ReducedLineLoadValueShape ;
                sh:message "A permitted reduced line-load value is required for a very long hatch."
            ]
        ]
    ) .
