@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF056WeatherdeckHatchShape>
    a sh:NodeShape ;
    sh:targetClass nltl:weatherdeckHatch ;

    sh:property [
        sh:path nltl:hatchOpeningLength ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:shipBreadth ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:shipSideDeflection ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;

    sh:property [
        sh:path nltl:hasHatchCoverDesignEvidence ;
        sh:class nltl:hatchCoverDesignEvidence
    ] ;

    sh:property [
        sh:path nltl:hasHatchFittingDesignEvidence ;
        sh:class nltl:hatchFittingDesignEvidence
    ] ;

    sh:sparql [
        sh:message "For a hatch opening longer than half the ship breadth, ship-side deflection and hatch cover and fitting design evidence are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hatchOpeningLength ?openingQuantity ;
                      nltl:shipBreadth ?breadthQuantity .
                ?openingQuantity qudt:numericValue ?opening ;
                                 qudt:unit <http://qudt.org/vocab/unit/M> .
                ?breadthQuantity qudt:numericValue ?breadth ;
                                  qudt:unit <http://qudt.org/vocab/unit/M> .
                FILTER (?opening > (?breadth / 2))
                FILTER NOT EXISTS {
                    $this nltl:shipSideDeflection ?deflection ;
                          nltl:hasHatchCoverDesignEvidence ?coverEvidence ;
                          nltl:hasHatchFittingDesignEvidence ?fittingEvidence .
                }
            }
        """
    ] .
