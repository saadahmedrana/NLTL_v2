@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF057WebFrameIceLoadShape
    a sh:NodeShape ;
    sh:targetClass nltl:webFrame ;
    sh:property [
        sh:path nltl:iceLoadSourceType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:iceStringerLoadSource
            nltl:longitudinalFramingLoadSource
        ) ;
        sh:message "Ice load source type must be ice stringer or longitudinal framing."
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:node gs:IcePressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadHeight ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameSpacing ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:loadLengthParameter ;
        sh:minCount 1 ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameSafetyFactor ;
        sh:minCount 1 ;
        sh:node gs:SafetyFactorQuantityShape
    ] ;
    sh:property [
        sh:path nltl:minimumLineLoad ;
        sh:minCount 1 ;
        sh:node gs:LineLoadQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:minCount 1 ;
        sh:node gs:IceLoadQuantityShape
    ] ;
    sh:sparql [
        sh:message "Load length, minimum line load, and web frame ice load must conform to the specified ice-load calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pressureQuantity ;
                      nltl:iceLoadHeight ?heightQuantity ;
                      nltl:webFrameSpacing ?spacingQuantity ;
                      nltl:loadLengthParameter ?lengthQuantity ;
                      nltl:webFrameSafetyFactor ?factorQuantity ;
                      nltl:minimumLineLoad ?lineQuantity ;
                      nltl:webFrameIceLoad ?loadQuantity .

                ?pressureQuantity qudt:numericValue ?pressure .
                ?heightQuantity qudt:numericValue ?height .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?lengthQuantity qudt:numericValue ?length .
                ?factorQuantity qudt:numericValue ?factor .
                ?lineQuantity qudt:numericValue ?line .
                ?loadQuantity qudt:numericValue ?load .

                BIND(?pressure * ?height AS ?pressureHeight)
                BIND(
                    IF(
                        ?pressureHeight < "0.15"^^xsd:decimal,
                        "0.15"^^xsd:decimal,
                        ?pressureHeight
                    )
                    AS ?baseLineLoad
                )
                BIND("2.0"^^xsd:decimal * ?spacing AS ?expectedLength)
                BIND("1000.0"^^xsd:decimal * ?baseLineLoad AS ?expectedLine)
                BIND(
                    ?factor * ?baseLineLoad * ?spacing * "1000.0"^^xsd:decimal
                    AS ?expectedLoad
                )

                FILTER(
                    ABS(?length - ?expectedLength) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedLength) + "0.000001"^^xsd:decimal)
                    ||
                    ABS(?line - ?expectedLine) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedLine) + "0.000001"^^xsd:decimal)
                    ||
                    ABS(?load - ?expectedLoad) >
                        ("0.000001"^^xsd:decimal * ABS(?expectedLoad) + "0.000001"^^xsd:decimal)
                )
            }
        """
    ] .

gs:IcePressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SafetyFactorQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "1.8"^^xsd:decimal ;
        sh:maxInclusive "1.8"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN-PER-M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:IceLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
