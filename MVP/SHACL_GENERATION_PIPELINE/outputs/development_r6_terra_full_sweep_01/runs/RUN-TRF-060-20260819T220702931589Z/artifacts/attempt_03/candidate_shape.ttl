@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF060QuantityValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060AreaCm2Shape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060AreaM2Shape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060SectionModulusShape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060ForceShape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060MomentShape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060LengthShape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060StressShape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060DimensionlessShape a sh:NodeShape ;
    sh:node gs:TRF060QuantityValueShape ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060TableLookupCaseShape a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasTableLookupCase ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable4Dash8 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameTable4Dash8GammaFactor ;
        sh:node gs:TRF060DimensionlessShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TRF060ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:node gs:TRF060ForceShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:node gs:TRF060LengthShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:node gs:TRF060MomentShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:node gs:TRF060AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:node gs:TRF060AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:node gs:TRF060AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gs:TRF060AreaCm2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node gs:TRF060AreaM2Shape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:TRF060StressShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gs:TRF060SectionModulusShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Web-frame maximum ice-load bending moment must equal 0.193 times ice load in MN times span." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:webFrameIceLoad ?loadNode ;
                      nltl:webFrameSpan ?spanNode ;
                      nltl:webFrameMaximumIceLoadBendingMoment ?momentNode .
                ?loadNode qudt:numericValue ?load .
                ?spanNode qudt:numericValue ?span .
                ?momentNode qudt:numericValue ?moment .
                BIND((0.000193 * ?load * ?span) AS ?expectedMoment)
                FILTER (
                    ABS(?moment - ?expectedMoment) >
                    (0.000000001 + (0.000001 * ABS(?expectedMoment)))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Actual web-frame cross-sectional area must equal free flange area plus web area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:webFrameFreeFlangeArea ?flangeNode ;
                      nltl:webFrameWebArea ?webNode ;
                      nltl:actualWebFrameCrossSectionalArea ?actualNode .
                ?flangeNode qudt:numericValue ?flange .
                ?webNode qudt:numericValue ?web .
                ?actualNode qudt:numericValue ?actual .
                BIND((?flange + ?web) AS ?expectedArea)
                FILTER (
                    ABS(?actual - ?expectedArea) >
                    (0.000000001 + (0.000001 * ABS(?expectedArea)))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The section-modulus formula requires positive yield strength and actual area, and gamma times required shear area divided by actual area to have absolute value less than one." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasTableLookupCase ?case ;
                      nltl:yieldStrength ?yieldNode ;
                      nltl:requiredShearArea ?requiredNode ;
                      nltl:actualWebFrameCrossSectionalArea ?actualNode .
                ?case nltl:webFrameTable4Dash8GammaFactor ?gammaNode .
                ?yieldNode qudt:numericValue ?yield .
                ?requiredNode qudt:numericValue ?requiredArea .
                ?actualNode qudt:numericValue ?actualArea .
                ?gammaNode qudt:numericValue ?gamma .
                FILTER (
                    ?yield <= 0 ||
                    ?actualArea <= 0 ||
                    ABS((?gamma * ?requiredArea) / ?actualArea) >= 1
                )
            }
        """
    ] .
