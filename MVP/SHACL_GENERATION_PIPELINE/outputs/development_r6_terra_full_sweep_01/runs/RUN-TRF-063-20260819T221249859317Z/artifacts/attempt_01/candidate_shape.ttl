@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:TRF063ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerCount ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
        sh:class nltl:sidePropellerStrengtheningEnvelope ;
        sh:node shape:TRF063StrengtheningEnvelopeShape
    ] ;
    sh:sparql [
        sh:message "Twin and triple screw ships require a side propeller strengthening envelope." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:propellerCount ?propellerCount .
                FILTER (?propellerCount IN (2, 3))
                FILTER NOT EXISTS {
                    $this nltl:hasSidePropellerStrengtheningEnvelope ?envelope .
                }
            }
        """
    ] .

shape:TRF063StrengtheningEnvelopeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:strengtheningForwardExtent ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node shape:TRF063ForwardExtentQuantityShape
    ] ;
    sh:property [
        sh:path nltl:strengtheningAftExtent ;
        sh:minCount 1 ;
        sh:class qudt:QuantityValue ;
        sh:node shape:TRF063AftExtentQuantityShape
    ] .

shape:TRF063ForwardExtentQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.5 ;
        sh:maxInclusive 1.5
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

shape:TRF063AftExtentQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.5 ;
        sh:maxInclusive 1.5
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .
