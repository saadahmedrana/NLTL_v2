@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:TRF-064Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node [
            sh:class nltl:sidePropellerShaftingAssembly ;
            sh:property [
                sh:path nltl:enclosedByPlatedBossing ;
                sh:minCount 1 ;
                sh:class nltl:platedBossingStructure ;
                sh:message "Side propeller shafting shall be enclosed within a plated bossing."
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node [
            sh:class nltl:sternTube ;
            sh:property [
                sh:path nltl:enclosedByPlatedBossing ;
                sh:minCount 1 ;
                sh:class nltl:platedBossingStructure ;
                sh:message "A side-propeller stern tube shall be enclosed within a plated bossing."
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:node [
            sh:class nltl:detachedStrutStructure ;
            sh:property [
                sh:path nltl:hasStrutDesignEvidence ;
                sh:minCount 1 ;
                sh:class nltl:strutDesignEvidence ;
                sh:message "A detached strut requires design evidence."
            ] ;
            sh:property [
                sh:path nltl:hasStrutStrengthEvidence ;
                sh:minCount 1 ;
                sh:class nltl:strutStrengthEvidence ;
                sh:message "A detached strut requires strength evidence."
            ] ;
            sh:property [
                sh:path nltl:hasStrutHullAttachmentEvidence ;
                sh:minCount 1 ;
                sh:class nltl:strutHullAttachmentEvidence ;
                sh:message "A detached strut requires hull-attachment evidence."
            ]
        ]
    ] .
