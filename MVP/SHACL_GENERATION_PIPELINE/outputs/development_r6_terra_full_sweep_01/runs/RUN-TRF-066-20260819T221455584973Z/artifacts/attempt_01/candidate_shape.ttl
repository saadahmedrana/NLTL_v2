@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF066RudderProtectionShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:iceClass ?iceClass .
                FILTER (?iceClass IN (nltl:iceClassIa, nltl:iceClassIaSuper))
            }
        """
    ] ;
    sh:property [
        sh:path nltl:iceKnifePracticable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Record whether an ice knife is practicable."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:qualifiedValueShape [
                    sh:class nltl:iceKnife ;
                    sh:property [
                        sh:path nltl:extendsBelowLowerIceWaterline ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "When an ice knife is practicable, provide an ice knife extending below the lower ice waterline."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceKnifePracticable ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasRudderProtectionArrangement ;
                sh:qualifiedValueShape [
                    sh:class nltl:equivalentRudderProtectionMeans
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "When an ice knife is not practicable, provide equivalent rudder protection means."
            ]
        ]
    ) .
