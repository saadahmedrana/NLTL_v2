@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-069Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For the applicable ice class and propeller configuration, a linked design condition must cover normal service-life propeller/ice loads, include fixed-pitch reversal loads, and record stopped-propeller dragging and radial ice entry as outside the load-model scope." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType .

                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER(?pitchType IN (
                    "controllable"^^xsd:string,
                    "fixed"^^xsd:string
                ))

                FILTER NOT EXISTS {
                    $this nltl:hasDesignCondition ?condition .
                    ?condition nltl:normalOperationalConditions true ;
                               nltl:normalServiceLifePropellerIceLoadCondition true ;
                               nltl:fixedPitchPropellerReversalLoadIncluded true ;
                               nltl:stoppedPropellerDraggingOutsideLoadModel true ;
                               nltl:radialIceEntryOutsideLoadModel true .
                }
            }
        """
    ] .
