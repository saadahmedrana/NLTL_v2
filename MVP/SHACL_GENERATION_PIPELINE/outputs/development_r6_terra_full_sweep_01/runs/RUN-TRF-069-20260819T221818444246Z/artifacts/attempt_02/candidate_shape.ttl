@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF069ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable propulsion-machinery configuration requires a linked design condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER(?pitchType IN (
                    "controllable"^^xsd:string,
                    "fixed"^^xsd:string
                ))
                FILTER NOT EXISTS {
                    $this nltl:hasDesignCondition ?designCondition .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable design condition shall cover normal service-life propeller/ice loads under normal operational conditions and record the specified excluded load-model cases." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?designCondition
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType ?pitchType ;
                      nltl:hasDesignCondition ?designCondition .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER(?pitchType IN (
                    "controllable"^^xsd:string,
                    "fixed"^^xsd:string
                ))
                FILTER NOT EXISTS {
                    ?designCondition
                        nltl:normalOperationalConditions true ;
                        nltl:normalServiceLifePropellerIceLoadCondition true ;
                        nltl:stoppedPropellerDraggingOutsideLoadModel true ;
                        nltl:radialIceEntryOutsideLoadModel true .
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A fixed-pitch applicable propulsion configuration shall include fixed-pitch propeller reversal loads in each linked design condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?designCondition
            WHERE {
                $this nltl:iceClass ?iceClass ;
                      nltl:propellerType ?propellerType ;
                      nltl:pitchType "fixed"^^xsd:string ;
                      nltl:hasDesignCondition ?designCondition .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc
                ))
                FILTER(?propellerType IN (
                    "open"^^xsd:string,
                    "ducted"^^xsd:string
                ))
                FILTER NOT EXISTS {
                    ?designCondition
                        nltl:fixedPitchPropellerReversalLoadIncluded true .
                }
            }
        """
    ] .
