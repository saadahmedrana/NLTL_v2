@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-070ThrusterIceLoadShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "An applicable main-propulsion azimuthing or fixed thruster requires a linked normal-operational design condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER NOT EXISTS {
                    $this nltl:hasDesignCondition ?condition .
                    ?condition a nltl:designCondition ;
                               nltl:normalOperationalConditions true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable thruster assessment requires extreme, propeller/ice, and thruster-body/ice loads in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?property
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER (?property IN (
                    nltl:extremeLoad,
                    nltl:propellerIceInteractionLoad,
                    nltl:thrusterBodyIceInteractionLoad
                ))
                FILTER NOT EXISTS {
                    $this ?property ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable thruster assessment requires local ice pressure in MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER NOT EXISTS {
                    $this nltl:localIcePressure ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Applicable thruster assessment requires service life in years." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER NOT EXISTS {
                    $this nltl:serviceLife ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit <http://qudt.org/vocab/unit/YR> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each represented applicable force load must have a decimal numeric value in kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?property ?quantity
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType ;
                      ?property ?quantity .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER (?property IN (
                    nltl:extremeLoad,
                    nltl:propellerIceInteractionLoad,
                    nltl:thrusterBodyIceInteractionLoad
                ))
                FILTER NOT EXISTS {
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each represented local ice pressure must have a decimal numeric value in MPa." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?quantity
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType ;
                      nltl:localIcePressure ?quantity .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER NOT EXISTS {
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each represented service life must have a decimal numeric value in years." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this ?quantity
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType ;
                      nltl:serviceLife ?quantity .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER NOT EXISTS {
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit <http://qudt.org/vocab/unit/YR> .
                    FILTER (datatype(?value) = xsd:decimal)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The local strength of an applicable thruster body designed for extreme loads must be recorded as sufficient." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:mainPropulsionThruster true ;
                      nltl:thrusterType ?thrusterType ;
                      nltl:extremeLoad ?extremeLoad .
                FILTER (?thrusterType IN ("azimuthing"^^xsd:string, "fixed"^^xsd:string))
                FILTER NOT EXISTS {
                    $this nltl:thrusterBodyLocalStrength true .
                }
            }
        """
    ] .
