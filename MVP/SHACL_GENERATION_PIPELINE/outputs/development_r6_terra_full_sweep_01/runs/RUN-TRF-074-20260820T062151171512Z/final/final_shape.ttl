@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-074-PropellerSubmersion>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "For ice class IB or IC, provide propulsion designed for IA or metre-valued propeller depth at least hi." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER(?iceClass IN (nltl:iceClassIb, nltl:iceClassIc))

                FILTER NOT EXISTS {
                    $this nltl:propulsionSystemDesignedForIceClass nltl:iceClassIa .
                }

                FILTER NOT EXISTS {
                    $this nltl:ballastConditionPropellerTopDepth ?depthQuantity ;
                          nltl:requiredPropellerSubmersionDepthHi ?hiQuantity .

                    ?depthQuantity qudt:numericValue ?depth ;
                                   qudt:unit unit:M .
                    ?hiQuantity qudt:numericValue ?hi ;
                                qudt:unit unit:M .

                    FILTER(datatype(?depth) = xsd:decimal)
                    FILTER(datatype(?hi) = xsd:decimal)
                    FILTER(?depth >= ?hi)
                }
            }
        """
    ] .
