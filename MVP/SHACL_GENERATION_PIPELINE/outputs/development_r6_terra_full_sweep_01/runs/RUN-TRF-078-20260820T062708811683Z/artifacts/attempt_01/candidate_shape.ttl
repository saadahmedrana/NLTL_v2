@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-078ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:propellerLocation ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-078LookupCaseShape>
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:sparql [
        sh:message "The selected Table 6-6 and Table 6-7 values and the calculated ice load cycle count must agree with equation 6.14." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:classLoadCycleCount ?nclass ;
                      nltl:iceLoadCycleCoefficientK1 ?k1q ;
                      nltl:iceLoadCycleCoefficientK2 ?k2q ;
                      nltl:iceLoadCycleCoefficientK3 ?k3q ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnq ;
                      nltl:hasTableLookupCase ?classCase ;
                      nltl:hasTableLookupCase ?locationCase .

                ?k1q qudt:numericValue ?k1 .
                ?k2q qudt:numericValue ?k2 .
                ?k3q qudt:numericValue ?k3 .
                ?nnq qudt:numericValue ?nn .

                ?classCase nltl:tableReference nltl:traficomTable6Dash6 ;
                           nltl:selectedIceClassCycleCount ?selectedClassQ .
                ?selectedClassQ qudt:numericValue ?selectedClass .

                ?locationCase nltl:tableReference nltl:traficomTable6Dash7 ;
                              nltl:selectedPropellerLocationFactor ?selectedK1Q .
                ?selectedK1Q qudt:numericValue ?selectedK1 .

                BIND((xsd:decimal(?k1) * xsd:decimal(?k2) * xsd:decimal(?k3) *
                      xsd:decimal(?nclass) * xsd:decimal(?nn)) AS ?expected)

                FILTER (
                    ABS(xsd:decimal(?selectedClass) - xsd:decimal(?nclass)) >
                    (0.000001 * ABS(xsd:decimal(?nclass)) + 0.000000001) ||
                    ABS(xsd:decimal(?selectedK1) - xsd:decimal(?k1)) >
                    (0.000001 * ABS(xsd:decimal(?k1)) + 0.000000001) ||
                    ABS(xsd:decimal(?nice) - ?expected) >
                    (0.000001 * ABS(?expected) + 0.000000001)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF-078LookupCaseShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:traficomTable6Dash6
            nltl:traficomTable6Dash7
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceArtifact
    ] .

<urn:nltl:generated-shape:TRF-078DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
