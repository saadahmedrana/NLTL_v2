@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF078ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:propellerLocation ;
        sh:class nltl:propellerLocationValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1*k2*k3*classLoadCycleCount*propellerBladeLoadSpectrumCountFactor within a relative tolerance of 1e-6 and absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:classLoadCycleCount ?nclass ;
                      nltl:iceLoadCycleCoefficientK1 ?k1q ;
                      nltl:iceLoadCycleCoefficientK2 ?k2q ;
                      nltl:iceLoadCycleCoefficientK3 ?k3q ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnq .
                ?k1q qudt:numericValue ?k1 .
                ?k2q qudt:numericValue ?k2 .
                ?k3q qudt:numericValue ?k3 .
                ?nnq qudt:numericValue ?nn .
                BIND((?k1 * ?k2 * ?k3 * xsd:decimal(?nclass) * ?nn) AS ?expected)
                BIND(IF(ABS(?expected) * 0.000001 > 0.000000001,
                        ABS(?expected) * 0.000001,
                        0.000000001) AS ?tolerance)
                FILTER(ABS(xsd:decimal(?nice) - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The Table 6-6 selected ice class cycle count must correspond to classLoadCycleCount." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:classLoadCycleCount ?nclass ;
                      nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash6 ;
                      nltl:selectedIceClassCycleCount ?selectedq .
                ?selectedq qudt:numericValue ?selected .
                FILTER(?selected != xsd:decimal(?nclass))
            }
        """
    ] ;
    sh:sparql [
        sh:message "The Table 6-7 selected propeller location factor must correspond to iceLoadCycleCoefficientK1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK1 ?k1q ;
                      nltl:hasTableLookupCase ?case .
                ?k1q qudt:numericValue ?k1 .
                ?case nltl:tableReference nltl:traficomTable6Dash7 ;
                      nltl:selectedPropellerLocationFactor ?selectedq .
                ?selectedq qudt:numericValue ?selected .
                FILTER(?selected != ?k1)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF078TableLookupCaseShape>
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasTableLookupCase ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ) .
