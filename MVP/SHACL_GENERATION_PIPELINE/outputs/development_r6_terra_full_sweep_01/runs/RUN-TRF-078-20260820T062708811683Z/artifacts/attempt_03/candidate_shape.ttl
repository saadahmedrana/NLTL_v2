@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:TableLookupCaseEvidenceShape
    a sh:NodeShape ;
    sh:targetClass nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] .

gs:TRF078ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:propellerLocation ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:UnitlessQuantityShape
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:class nltl:tableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node gs:UnitlessQuantityShape
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:sparql [
        sh:message "Ice load cycle count, selected table values, and coefficients must satisfy N_ice = k_1*k_2*k_3*N_class*n_n within relative tolerance 1e-6 and absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:classLoadCycleCount ?nclass ;
                      nltl:iceLoadCycleCoefficientK1 ?k1q ;
                      nltl:iceLoadCycleCoefficientK2 ?k2q ;
                      nltl:iceLoadCycleCoefficientK3 ?k3q ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnq ;
                      nltl:hasTableLookupCase ?nclassCase, ?k1Case .

                ?k1q qudt:numericValue ?k1 .
                ?k2q qudt:numericValue ?k2 .
                ?k3q qudt:numericValue ?k3 .
                ?nnq qudt:numericValue ?nn .

                ?nclassCase nltl:tableReference nltl:traficomTable6Dash6 ;
                            nltl:selectedIceClassCycleCount ?selectedNclassQ .
                ?selectedNclassQ qudt:numericValue ?selectedNclass .

                ?k1Case nltl:tableReference nltl:traficomTable6Dash7 ;
                        nltl:selectedPropellerLocationFactor ?selectedK1Q .
                ?selectedK1Q qudt:numericValue ?selectedK1 .

                BIND((?k1 * ?k2 * ?k3 * xsd:decimal(?nclass) * ?nn) AS ?expectedNice)

                FILTER (
                    ABS(xsd:decimal(?nclass) - ?selectedNclass) >
                        ((0.000001 * ABS(?selectedNclass)) + 0.000000001)
                    ||
                    ABS(?k1 - ?selectedK1) >
                        ((0.000001 * ABS(?selectedK1)) + 0.000000001)
                    ||
                    ABS(xsd:decimal(?nice) - ?expectedNice) >
                        ((0.000001 * ABS(?expectedNice)) + 0.000000001)
                )
            }
        """
    ] .
