@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-079Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerDiameter ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerShaftCentrelineDepth ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerImmersionFunction ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "propellerDiameter must be non-zero when validating the propeller immersion function." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerShaftCentrelineDepth ?h0Quantity ;
                      nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerImmersionFunction ?functionQuantity .
                ?h0Quantity qudt:numericValue ?h0 .
                ?iceQuantity qudt:numericValue ?ice .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?functionQuantity qudt:numericValue ?function .
                FILTER (?diameter = "0"^^xsd:decimal)
            }
        """
    ] ;
    sh:sparql [
        sh:message "propellerImmersionFunction must equal (propellerShaftCentrelineDepth - designIceThickness) / (propellerDiameter / 2) - 1 within relative tolerance 1e-6 and absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerShaftCentrelineDepth ?h0Quantity ;
                      nltl:designIceThickness ?iceQuantity ;
                      nltl:propellerDiameter ?diameterQuantity ;
                      nltl:propellerImmersionFunction ?functionQuantity .
                ?h0Quantity qudt:numericValue ?h0 .
                ?iceQuantity qudt:numericValue ?ice .
                ?diameterQuantity qudt:numericValue ?diameter .
                ?functionQuantity qudt:numericValue ?function .
                FILTER (?diameter != "0"^^xsd:decimal)
                BIND (((?h0 - ?ice) / (?diameter / "2"^^xsd:decimal)) - "1"^^xsd:decimal AS ?expected)
                BIND ((ABS(?expected) * "0.000001"^^xsd:decimal) + "0.000000001"^^xsd:decimal AS ?tolerance)
                FILTER (ABS(?function - ?expected) > ?tolerance)
            }
        """
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCoefficientK2 must equal the applicable piecewise value derived from propellerImmersionFunction within relative tolerance 1e-6 and absolute tolerance 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerImmersionFunction ?functionQuantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity .
                ?functionQuantity qudt:numericValue ?function .
                ?k2Quantity qudt:numericValue ?k2 .
                BIND (
                    IF(
                        ?function < "0"^^xsd:decimal,
                        "0.8"^^xsd:decimal - ?function,
                        IF(
                            ?function <= "1"^^xsd:decimal,
                            "0.8"^^xsd:decimal - ("0.4"^^xsd:decimal * ?function),
                            IF(
                                ?function <= "2.5"^^xsd:decimal,
                                "0.6"^^xsd:decimal - ("0.2"^^xsd:decimal * ?function),
                                "0.1"^^xsd:decimal
                            )
                        )
                    ) AS ?expected
                )
                BIND ((ABS(?expected) * "0.000001"^^xsd:decimal) + "0.000000001"^^xsd:decimal AS ?tolerance)
                FILTER (ABS(?k2 - ?expected) > ?tolerance)
            }
        """
    ] .
