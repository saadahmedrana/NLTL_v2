@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF083Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ;
        sh:minCount 1 ;
        sh:node gs:TRF083RotationalSpeedShape ;
        sh:message "Provide the propeller rotational speed at MCR in bollard condition."
    ] ;
    sh:property [
        sh:path nltl:rotationalSpeedKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Provide exactly one rotational-speed-known selector."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:rotationalSpeedKnown ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:rotationalSpeedKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:minCount 1 ;
                sh:class nltl:tableLookupCase ;
                sh:node gs:TRF083TableLookupCaseShape ;
                sh:message "When rotational speed is unknown, provide a Table 6-9 lookup case."
            ]
        ]
    ) .

gs:TRF083RotationalSpeedShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:REV-PER-MIN
    ] .

gs:TRF083TableLookupCaseShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableLookupApplied ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:in ( nltl:traficomTable6Dash9 ) ;
        sh:message "The lookup case must cite TRAFICOM Table 6-9."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Provide evidence for the Table 6-9 lookup selection."
    ] .
