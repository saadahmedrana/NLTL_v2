@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-084Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:pitchValueKnown ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrBollard ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:propellerPitchAtMcrFreeRunning ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "CP propellers require pitchValueKnown to establish the applicable branch." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType .
                FILTER(?propellerType = "CP"^^xsd:string)
                FILTER NOT EXISTS {
                    $this nltl:pitchValueKnown ?known .
                    FILTER(?known IN (true, false))
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "CP propellers require a propeller pitch at MCR in bollard condition." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType .
                FILTER(?propellerType = "CP"^^xsd:string)
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrBollard ?bollardPitch .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When the CP propeller bollard pitch is not known, a free-running MCR pitch is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:propellerType ?propellerType ;
                      nltl:pitchValueKnown false .
                FILTER(?propellerType = "CP"^^xsd:string)
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrFreeRunning ?freeRunningPitch .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each CP bollard pitch must equal 0.7 times a free-running MCR pitch within a 1e-6 relative tolerance and 1e-9 absolute fallback." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?bollardPitch
            WHERE {
                $this nltl:propellerType ?propellerType ;
                      nltl:pitchValueKnown false ;
                      nltl:propellerPitchAtMcrBollard ?bollardPitch .
                FILTER(?propellerType = "CP"^^xsd:string)
                ?bollardPitch qudt:numericValue ?bollardValue .
                FILTER NOT EXISTS {
                    $this nltl:propellerPitchAtMcrFreeRunning ?freeRunningPitch .
                    ?freeRunningPitch qudt:numericValue ?freeRunningValue .
                    BIND((0.7 * xsd:decimal(?freeRunningValue)) AS ?expectedValue)
                    BIND(ABS(xsd:decimal(?bollardValue) - ?expectedValue) AS ?difference)
                    BIND((0.000000001 + (0.000001 * ABS(?expectedValue))) AS ?tolerance)
                    FILTER(?difference <= ?tolerance)
                }
            }
        """
    ] .
