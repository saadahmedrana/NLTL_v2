@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-088Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Maximum engine torque known status is required to determine whether Table 6-10 applies."
    ] ;
    sh:sparql [
        sh:message "When maximum engine torque is unknown, a decimal maximum torque in kN*m and an evidenced Table 6-10 lookup case are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:maximumEngineTorqueKnown false .
                FILTER NOT EXISTS {
                    $this nltl:maximumEngineTorque ?torque ;
                          nltl:hasTableLookupCase ?case .

                    ?torque qudt:numericValue ?torqueValue ;
                            qudt:unit <http://qudt.org/vocab/unit/KiloN-M> .

                    ?case a nltl:tableLookupCase ;
                          nltl:tableReference nltl:traficomTable6Dash10 ;
                          nltl:lookupSelectionEvidence ?evidence .

                    ?evidence a nltl:evidenceArtifact .

                    FILTER(datatype(?torqueValue) = xsd:decimal)
                }
            }
        """
    ] .
