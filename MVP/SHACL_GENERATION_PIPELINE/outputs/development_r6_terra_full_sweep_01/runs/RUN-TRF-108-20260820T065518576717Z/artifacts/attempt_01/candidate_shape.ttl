@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-108StressLifeCurveSelectionShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:stressLifeCurveKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "State whether the stress-life curve is known."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:stressLifeCurveKnown ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:stressLifeCurveType ;
                        sh:datatype xsd:string ;
                        sh:minCount 1
                    ]
                ] ;
                sh:message "A known stress-life curve requires a selected curve type."
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Provide evidence that the selected stress-life curve corresponds with the blade material properties."
            ]
        ]
        [
            sh:property [
                sh:path nltl:stressLifeCurveKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:hasValue nltl:twoSlopeStressLifeCurve ;
                sh:message "When the stress-life curve is unknown, select the two-slope stress-life curve."
            ]
        ]
    ) .
