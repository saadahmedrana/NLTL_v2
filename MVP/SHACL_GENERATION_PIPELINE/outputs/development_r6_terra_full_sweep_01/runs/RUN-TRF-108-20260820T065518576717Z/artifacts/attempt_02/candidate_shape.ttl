@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-108Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:stressLifeCurveKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:stressLifeCurveKnown ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:minCount 1 ;
                sh:class nltl:stressLifeCurveTypeValue
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveType ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
                sh:minCount 1 ;
                sh:class nltl:evidenceArtifact ;
                sh:message "Correspondence evidence is required when the stress-life curve is known."
            ]
        ]
        [
            sh:property [
                sh:path nltl:stressLifeCurveKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelection ;
                sh:minCount 1 ;
                sh:class nltl:stressLifeCurveTypeValue ;
                sh:hasValue nltl:twoSlopeStressLifeCurve ;
                sh:message "Use the two-slope stress-life curve when the stress-life curve is unknown."
            ]
        ]
    ) .
