@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-109-IceLoadCycleRangeShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minInclusive 5000000 ;
        sh:maxInclusive 100000000 ;
        sh:message "Ice load cycle count used for calculating rho shall be between 5000000 and 100000000 inclusive."
    ] .
