@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:KiloNQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:UnitlessYieldSafetyFactorShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:BladeFailureLoadCaseShape a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:hasValue nltl:bladeFailureLoadCase ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gen:UnitlessYieldSafetyFactorShape
    ] .

gen:ShaftComponentYieldSafetyShape a sh:NodeShape ;
    sh:class nltl:shipComponent ;
    sh:property [
        sh:path nltl:bendingYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gen:UnitlessYieldSafetyFactorShape
    ] ;
    sh:property [
        sh:path nltl:torsionalYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gen:UnitlessYieldSafetyFactorShape
    ] .

gen:TRF112Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:node gen:KiloNQuantityShape
    ] ;
    sh:property [
        sh:path nltl:combinedAxialBendingTorsionLoad ;
        sh:minCount 1 ;
        sh:node gen:KiloNQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node gen:UnitlessYieldSafetyFactorShape
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape gen:BladeFailureLoadCaseShape
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:node gen:ShaftComponentYieldSafetyShape
    ] ;
    sh:sparql [
        sh:message "The selected blade-failure load case must retain a component yield safety factor of at least 1.0 for the declared blade-failure and combined-load inputs." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bladeFailureUltimateLoad ?bladeLoad ;
                      nltl:combinedAxialBendingTorsionLoad ?combinedLoad ;
                      nltl:yieldSafetyFactor ?yieldFactor ;
                      nltl:hasPropulsionLoadCase ?case .
                ?bladeLoad qudt:numericValue ?bladeValue .
                ?combinedLoad qudt:numericValue ?combinedValue .
                ?yieldFactor qudt:numericValue ?yieldValue .
                ?case nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase ;
                      nltl:componentYieldSafetyFactor ?caseFactor .
                ?caseFactor qudt:numericValue ?caseValue .
                FILTER (
                    ?caseValue < "1.0"^^xsd:decimal
                )
            }
        """
    ] .
