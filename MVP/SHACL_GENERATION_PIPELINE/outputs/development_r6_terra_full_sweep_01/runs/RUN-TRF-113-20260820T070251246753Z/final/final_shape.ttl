@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-113Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:thrusterBladeLossDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact ;
        sh:message "Provide thruster blade-loss design evidence."
    ] ;
    sh:property [
        sh:path nltl:hasLoadCase ;
        sh:node <urn:nltl:generated-shape:TRF-113LoadCaseShape>
    ] .

<urn:nltl:generated-shape:TRF-113LoadCaseShape>
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:maximumComponentLoadBladeOrientationConfirmed ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( "true"^^xsd:boolean ) ;
        sh:message "Confirm that blade-loss loading uses the propeller blade orientation causing maximum component load."
    ] .
