@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF114Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasThrusterIceImpactLoadCase ;
        sh:node <urn:nltl:generated-shape:TRF114ImpactCaseShape>
    ] ;
    sh:property [
        sh:path nltl:iceOperatingSpeed ;
        sh:node <urn:nltl:generated-shape:TRF114IceSpeedQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:node <urn:nltl:generated-shape:TRF114RadiusQuantityShape>
    ] ;
    sh:sparql [
        sh:message "Ice operating speed is required when a thruster ice impact load case is represented." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                FILTER NOT EXISTS {
                    $this nltl:iceOperatingSpeed ?speed .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "An equivalent impact sphere radius is required when a linked impact case has non-hemispherical contact geometry." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER NOT EXISTS {
                    $this nltl:equivalentImpactSphereRadius ?radius .
                }
            }
        """
    ] .

<urn:nltl:generated-shape:TRF114ImpactCaseShape>
    a sh:NodeShape ;
    sh:class nltl:thrusterIceImpactLoadCase ;
    sh:property [
        sh:path nltl:designIceBlockTableReference ;
        sh:minCount 1 ;
        sh:hasValue nltl:traficomTable6Dash3Reference
    ] ;
    sh:property [
        sh:path nltl:impactLoadCaseTableReference ;
        sh:minCount 1 ;
        sh:hasValue nltl:traficomTable6Dash16Reference
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoad ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF114ForceQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactDemand ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF114ForceQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:thrusterIceImpactLoadedAreaEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact
    ] ;
    sh:property [
        sh:path nltl:thrusterImpactCaseAppliesToBody ;
        sh:minCount 1 ;
        sh:class nltl:thrusterBody ;
        sh:node <urn:nltl:generated-shape:TRF114ThrusterBodyShape>
    ] ;
    sh:property [
        sh:path nltl:contactGeometryClassification ;
        sh:minCount 1 ;
        sh:in (
            nltl:hemisphericalContactGeometry
            nltl:nonHemisphericalContactGeometry
        )
    ] ;
    sh:or (
        <urn:nltl:generated-shape:TRF114HemisphericalGeometryShape>
        <urn:nltl:generated-shape:TRF114NonHemisphericalGeometryShape>
    ) ;
    sh:sparql [
        sh:message "Non-hemispherical contact geometry requires correspondence evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER NOT EXISTS {
                    $this nltl:contactGeometryCorrespondenceEvidence ?evidence .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Thruster resistance capacity must be greater than or equal to the ice impact demand." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:thrusterIceImpactDemand ?demandQuantity ;
                      nltl:thrusterImpactCaseAppliesToBody ?body .
                ?demandQuantity qudt:numericValue ?demandValue ;
                                qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
                ?capacityQuantity qudt:numericValue ?capacityValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/KiloN> .
                FILTER(?capacityValue < ?demandValue)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF114HemisphericalGeometryShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:contactGeometryClassification ;
        sh:hasValue nltl:hemisphericalContactGeometry
    ] .

<urn:nltl:generated-shape:TRF114NonHemisphericalGeometryShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:contactGeometryClassification ;
        sh:hasValue nltl:nonHemisphericalContactGeometry
    ] ;
    sh:property [
        sh:path nltl:contactGeometryCorrespondenceEvidence ;
        sh:minCount 1 ;
        sh:class nltl:evidenceArtifact
    ] .

<urn:nltl:generated-shape:TRF114ThrusterBodyShape>
    a sh:NodeShape ;
    sh:class nltl:thrusterBody ;
    sh:property [
        sh:path nltl:thrusterResistanceCapacity ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF114ForceQuantityShape>
    ] .

<urn:nltl:generated-shape:TRF114ForceQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF114IceSpeedQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF114RadiusQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
