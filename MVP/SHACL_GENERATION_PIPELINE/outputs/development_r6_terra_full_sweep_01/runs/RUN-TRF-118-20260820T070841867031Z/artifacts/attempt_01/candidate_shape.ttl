@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF118ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasFactoredExtremeLoadOperabilityAssessment ;
        sh:minCount 1 ;
        sh:class nltl:factoredExtremeLoadOperabilityAssessment ;
        sh:node <urn:nltl:generated-shape:TRF118AssessmentShape>
    ] ;
    sh:property [
        sh:path nltl:thrusterExtremeLoad ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF118ForceQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:yieldSafetyFactor ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF118FactorQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:nominalVonMisesStress ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF118StressQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:localStressConcentration ;
        sh:node <urn:nltl:generated-shape:TRF118RatioQuantityShape>
    ] .

<urn:nltl:generated-shape:TRF118AssessmentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:assessedThrusterComponent ;
        sh:minCount 1 ;
        sh:class nltl:shipComponent ;
        sh:node <urn:nltl:generated-shape:TRF118ComponentShape>
    ] ;
    sh:property [
        sh:path nltl:assessedFactoredExtremeLoad ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF118ForceQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:assessmentOperabilityMaintained ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:assessmentRepairRequired ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue false
    ] ;
    sh:sparql [
        sh:message "The assessed factored extreme load and stress margins do not meet the required calculation criteria." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasFactoredExtremeLoadOperabilityAssessment $this ;
                      nltl:thrusterExtremeLoad ?extremeLoad ;
                      nltl:yieldSafetyFactor ?factorValue ;
                      nltl:nominalVonMisesStress ?nominalStress .
                $this nltl:assessedThrusterComponent ?component ;
                      nltl:assessedFactoredExtremeLoad ?assessedLoad .
                ?component nltl:hasMaterialProperties ?materialProperties .
                ?materialProperties nltl:componentMaterialYieldStrength ?yieldStrength .
                ?extremeLoad qudt:numericValue ?extreme .
                ?factorValue qudt:numericValue ?factor .
                ?nominalStress qudt:numericValue ?nominal .
                ?yieldStrength qudt:numericValue ?yield .
                ?assessedLoad qudt:numericValue ?reported .
                OPTIONAL {
                    ?ship nltl:localStressConcentration ?localStress .
                    ?localStress qudt:numericValue ?local .
                }
                FILTER (
                    ABS(?reported - (?extreme * ?factor)) >
                    ((0.000001 * ABS(?extreme * ?factor)) + 0.000000001)
                    ||
                    ?nominal > (?yield / ?factor)
                    ||
                    (BOUND(?local) && ?local > ?yield)
                )
            }
        """
    ] .

<urn:nltl:generated-shape:TRF118ComponentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:class nltl:materialProperties ;
        sh:node <urn:nltl:generated-shape:TRF118MaterialPropertiesShape>
    ] .

<urn:nltl:generated-shape:TRF118MaterialPropertiesShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF118StressQuantityShape>
    ] .

<urn:nltl:generated-shape:TRF118ForceQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .

<urn:nltl:generated-shape:TRF118StressQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .

<urn:nltl:generated-shape:TRF118RatioQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

<urn:nltl:generated-shape:TRF118FactorQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.3 ;
        sh:maxInclusive 1.3
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .
