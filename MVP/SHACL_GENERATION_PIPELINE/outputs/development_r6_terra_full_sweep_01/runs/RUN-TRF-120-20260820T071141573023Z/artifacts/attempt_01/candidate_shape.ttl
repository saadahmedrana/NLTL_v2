@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF120ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:damping ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:waterAddedMass ;
        sh:node gen:TRF120MassQuantityShape
    ] ;
    sh:property [
        sh:path nltl:thrusterNaturalFrequency ;
        sh:node gen:TRF120FrequencyQuantityShape
    ] ;
    sh:sparql [
        sh:message "A longitudinal or transverse thruster natural-frequency calculation requires damping, water added mass, and thruster natural frequency on the ship, and ship attachment stiffness on the thruster body." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?body .
                ?body a nltl:thrusterBody ;
                    nltl:hasNaturalFrequencyCalculationCase ?case .
                ?case nltl:vibrationDirection ?direction .
                FILTER(?direction IN (
                    nltl:longitudinalDirection,
                    nltl:transverseDirection
                ))
                FILTER(
                    !EXISTS { $this nltl:damping ?damping } ||
                    !EXISTS { $this nltl:waterAddedMass ?addedMass } ||
                    !EXISTS { $this nltl:thrusterNaturalFrequency ?frequency } ||
                    !EXISTS { ?body nltl:shipAttachmentStiffness ?stiffness }
                )
            }
        """
    ] .

gen:TRF120ThrusterBodyShape
    a sh:NodeShape ;
    sh:targetClass nltl:thrusterBody ;
    sh:property [
        sh:path nltl:shipAttachmentStiffness ;
        sh:node gen:TRF120StiffnessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hasNaturalFrequencyCalculationCase ;
        sh:node gen:TRF120CalculationCaseShape
    ] .

gen:TRF120CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:vibrationDirection ;
        sh:minCount 1 ;
        sh:in (
            nltl:longitudinalDirection
            nltl:transverseDirection
        ) ;
        sh:message "A thruster natural-frequency calculation case must identify the longitudinal or transverse vibration direction."
    ] .

gen:TRF120MassQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloGM
    ] .

gen:TRF120FrequencyQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:HZ
    ] .

gen:TRF120StiffnessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN-PER-M
    ] .
