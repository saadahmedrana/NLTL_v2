@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-126Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive "12"^^xsd:integer ;
                sh:message "Air receiver capacity must provide at least 12 consecutive starts when the propulsion engine must be reversed for astern movement."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive "6"^^xsd:integer ;
                sh:message "Air receiver capacity must provide at least 6 consecutive starts when the propulsion engine does not need to be reversed for astern movement."
            ]
        ]
    ) .
