@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-126Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionEngineReversedForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 12
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:minInclusive 6
            ]
        ]
    ) .
