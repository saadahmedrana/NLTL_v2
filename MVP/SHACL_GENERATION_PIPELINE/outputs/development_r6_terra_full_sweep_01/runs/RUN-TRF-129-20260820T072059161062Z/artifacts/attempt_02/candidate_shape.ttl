@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:TRF129CoolingWaterSupplyShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceNavigationCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Ice-navigation condition information is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Navigating-in-ice status is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:coolingWaterSupplySecured ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When navigating in ice, the cooling water supply shall be secured." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceNavigationCondition ?condition ;
                      nltl:navigatingInIce true .
                FILTER NOT EXISTS {
                    $this nltl:coolingWaterSupplySecured true .
                }
            }
        """
    ] .
