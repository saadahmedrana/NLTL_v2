@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-133Shape> a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT ?this
            WHERE {
                ?this a nltl:ship ;
                    nltl:iceClass ?iceClass .
                FILTER(?iceClass IN (
                    nltl:iceClassIaSuper,
                    nltl:iceClassIa,
                    nltl:iceClassIb,
                    nltl:iceClassIc,
                    nltl:iceClassIi,
                    nltl:iceClassIii
                ))
            }
        """
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangle ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-133MarkFinishShape>
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-133WarningTriangleMarkingShape>
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF-133IceClassDraughtMarkingShape>
    ] .

<urn:nltl:generated-shape:TRF-133MarkFinishShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:markingPlateThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "5"^^xsd:decimal ;
                sh:maxInclusive "8"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:markingWeldedToShipSide ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:reflectingMarkingColour ;
        sh:minCount 1 ;
        sh:in (
            nltl:redReflectingMarkingColour
            nltl:yellowReflectingMarkingColour
        )
    ] ;
    sh:property [
        sh:path nltl:markingPlainlyVisibleInIceConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] .

<urn:nltl:generated-shape:TRF-133WarningTriangleMarkingShape> a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-133MarkFinishShape> ;
    sh:property [
        sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "1000"^^xsd:decimal ;
                sh:maxInclusive "1000"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:markingAtOrBelowDeckLine ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:warningTriangleSideLength ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "300"^^xsd:decimal ;
                sh:maxInclusive "300"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

<urn:nltl:generated-shape:TRF-133IceClassDraughtMarkingShape> a sh:NodeShape ;
    sh:node <urn:nltl:generated-shape:TRF-133MarkFinishShape> ;
    sh:property [
        sh:path nltl:letterDimensionsEqualLoadLineMark ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] ;
    sh:property [
        sh:path nltl:draughtMarkAftOffset ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:minInclusive "540"^^xsd:decimal ;
                sh:maxInclusive "540"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:hasValue nltl:loadLineRingCentreReference ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:hasValue nltl:timberLoadLineVerticalReference ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ) .
