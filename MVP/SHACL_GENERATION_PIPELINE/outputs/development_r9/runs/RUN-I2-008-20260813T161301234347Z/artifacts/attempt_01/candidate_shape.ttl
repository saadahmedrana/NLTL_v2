@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2-008-ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarClassValue ;
                sh:minCount 1 ;
                sh:message "The Polar Class applicability value must be an IACS Polar Class value."
            ] ;
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:bowSubregionCalculationCase ;
                sh:node gen:I2-008-BowSubregionCaseShape ;
                sh:minCount 1 ;
                sh:message "A Polar Class ship must provide a bow subregion calculation case."
            ]
        ]
    ) .

gen:I2-008-BowSubregionCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:node gen:I2-008-UnitlessQuantityShape ;
        sh:minCount 1 ;
        sh:message "The bow subregion calculation case must provide the bow shape coefficient."
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:node gen:I2-008-ForceQuantityShape ;
        sh:minCount 1 ;
        sh:message "The bow subregion calculation case must provide the total glancing impact force."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:node gen:I2-008-LineLoadQuantityShape ;
        sh:minCount 1 ;
        sh:message "The bow subregion calculation case must provide the glancing impact line load."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:node gen:I2-008-PressureQuantityShape ;
        sh:minCount 1 ;
        sh:message "The bow subregion calculation case must provide the glancing impact pressure."
    ] .

gen:I2-008-UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gen:I2-008-ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN
    ] .

gen:I2-008-LineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN-M-PER-M2
    ] .

gen:I2-008-PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA
    ] .
