@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_008_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "A Polar Class value from PC1 through PC7 is required."
    ] ;
    sh:property [
        sh:path nltl:bowShape ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The actual bow shape is required for the bow calculation."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:class nltl:bowSubregionCalculationCase ;
        sh:node gen:I2_008_BowSubregionCaseShape ;
        sh:minCount 1 ;
        sh:message "At least one complete bow-subregion calculation case is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                )
            ] ;
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:qualifiedValueShape [
                    sh:class nltl:bowSubregionCalculationCase ;
                    sh:node gen:I2_008_BowSubregionCaseShape ;
                    sh:property [
                        sh:path nltl:hullArea ;
                        sh:hasValue "Bow"
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "A Bow-area calculation case is required for Polar Classes PC1 through PC5."
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                )
            ] ;
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:qualifiedValueShape [
                    sh:class nltl:bowSubregionCalculationCase ;
                    sh:node gen:I2_008_BowSubregionCaseShape ;
                    sh:property [
                        sh:path nltl:hullArea ;
                        sh:hasValue "Bow"
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "A Bow-area calculation case is required for Polar Classes PC6 and PC7."
            ] ;
            sh:property [
                sh:path nltl:hasBowSubregionCalculationCase ;
                sh:qualifiedValueShape [
                    sh:class nltl:bowSubregionCalculationCase ;
                    sh:node gen:I2_008_BowSubregionCaseShape ;
                    sh:property [
                        sh:path nltl:hullArea ;
                        sh:hasValue "Bow Intermediate Icebelt"
                    ]
                ] ;
                sh:qualifiedMinCount 1 ;
                sh:message "A Bow Intermediate Icebelt calculation case is required for Polar Classes PC6 and PC7."
            ]
        ]
    ) .

gen:I2_008_BowSubregionCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:hullArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each bow-subregion calculation case must identify its hull area."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_008_BowShapeCoefficientValueShape ;
        sh:message "Each bow-subregion calculation case requires one bow shape coefficient."
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_008_TotalGlancingImpactForceValueShape ;
        sh:message "Each bow-subregion calculation case requires one total glancing impact force."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_008_GlancingImpactLineLoadValueShape ;
        sh:message "Each bow-subregion calculation case requires one glancing impact line load."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:I2_008_GlancingImpactPressureValueShape ;
        sh:message "Each bow-subregion calculation case requires one glancing impact pressure."
    ] .

gen:I2_008_BowShapeCoefficientValueShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_TotalGlancingImpactForceValueShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_GlancingImpactLineLoadValueShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:I2_008_GlancingImpactPressureValueShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
