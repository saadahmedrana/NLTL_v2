@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2-010Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "Exactly one recognized Polar Class value is required."
    ] ;
    sh:property [
        sh:path nltl:verticalSidedBowForm ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "The vertical-sided-bow status must not have conflicting values."
    ] ;
    sh:property [
        sh:path nltl:bowDesignForceMethod ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "The bow design force method must not have conflicting values."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                )
            ]
        ]
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                )
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:verticalSidedBowForm ;
                        sh:hasValue true
                    ] ;
                    sh:property [
                        sh:path nltl:bowDesignForceMethod ;
                        sh:minCount 1 ;
                        sh:hasValue "I2.3.2.1 (iv)"^^xsd:string
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:normalFrameAngle ;
                        sh:qualifiedValueShape gen:I2-010QualifyingNormalFrameAngleShape ;
                        sh:qualifiedMinCount 1
                    ] ;
                    sh:property [
                        sh:path nltl:bowDesignForceMethod ;
                        sh:minCount 1 ;
                        sh:hasValue "I2.3.2.1 (iv)"^^xsd:string
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:verticalSidedBowForm ;
                        sh:hasValue false
                    ] ;
                    sh:property [
                        sh:path nltl:normalFrameAngle ;
                        sh:minCount 1 ;
                        sh:node gen:I2-010NonQualifyingNormalFrameAngleShape
                    ]
                ]
            )
        ]
    ) ;
    sh:message "For PC6 or PC7, a vertical-sided bow or a normal frame angle from 0 through 10 DEG requires bow design force method I2.3.2.1 (iv); otherwise explicit non-applicability evidence is required." .

gen:I2-010QualifyingNormalFrameAngleShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 10.0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG
    ] .

gen:I2-010NonQualifyingNormalFrameAngleShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:DEG
    ] ;
    sh:or (
        [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxExclusive 0.0
            ]
        ]
        [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minExclusive 10.0
            ]
        ]
    ) .
