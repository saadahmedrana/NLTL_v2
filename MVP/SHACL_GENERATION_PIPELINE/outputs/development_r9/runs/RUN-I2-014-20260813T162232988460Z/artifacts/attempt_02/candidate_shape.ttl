@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:BowSubregionRequirementShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:bowLength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:BowLengthQuantityShape ;
        sh:message "A positive bow length in metres is required for the four-subregion calculation."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 4 ;
        sh:maxInclusive 4 ;
        sh:message "The bow region must have four subregions."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:node gen:BowSubregionCalculationCaseShape ;
        sh:message "Exactly four bow subregion calculation cases are required."
    ] ;
    sh:sparql [
        sh:message "The four calculation cases must correspond to the mid-length positions LBOW/8, 3*LBOW/8, 5*LBOW/8, and 7*LBOW/8 within a relative tolerance of 1e-6 and an absolute fallback of 1e-9 metres." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:bowLength ?lengthQuantity ;
          nltl:hasBowSubregionCalculationCase ?case .
    ?lengthQuantity qudt:numericValue ?length .
    ?case nltl:bowSubregionMidLengthPosition ?positionQuantity .
    ?positionQuantity qudt:numericValue ?position .

    BIND((?length / 8.0) AS ?expected1)
    BIND(((3.0 * ?length) / 8.0) AS ?expected2)
    BIND(((5.0 * ?length) / 8.0) AS ?expected3)
    BIND(((7.0 * ?length) / 8.0) AS ?expected4)

    BIND(IF(ABS(?expected1) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
            ABS(?expected1) * "0.000001"^^xsd:decimal,
            "0.000000001"^^xsd:decimal) AS ?tolerance1)
    BIND(IF(ABS(?expected2) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
            ABS(?expected2) * "0.000001"^^xsd:decimal,
            "0.000000001"^^xsd:decimal) AS ?tolerance2)
    BIND(IF(ABS(?expected3) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
            ABS(?expected3) * "0.000001"^^xsd:decimal,
            "0.000000001"^^xsd:decimal) AS ?tolerance3)
    BIND(IF(ABS(?expected4) * "0.000001"^^xsd:decimal > "0.000000001"^^xsd:decimal,
            ABS(?expected4) * "0.000001"^^xsd:decimal,
            "0.000000001"^^xsd:decimal) AS ?tolerance4)

    BIND(
        IF(ABS(?position - ?expected1) <= ?tolerance1, 1,
        IF(ABS(?position - ?expected2) <= ?tolerance2, 2,
        IF(ABS(?position - ?expected3) <= ?tolerance3, 3,
        IF(ABS(?position - ?expected4) <= ?tolerance4, 4, 0))))
        AS ?slot
    )
}
GROUP BY $this
HAVING (
       SUM(IF(?slot = 1, 1, 0)) < 1
    || SUM(IF(?slot = 2, 1, 0)) < 1
    || SUM(IF(?slot = 3, 1, 0)) < 1
    || SUM(IF(?slot = 4, 1, 0)) < 1
)
"""
    ] .

gen:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MidLengthPositionQuantityShape ;
        sh:message "Each bow subregion case requires one mid-length position in metres."
    ] ;
    sh:property [
        sh:path nltl:totalGlancingImpactForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:GlancingImpactForceQuantityShape ;
        sh:message "Each bow subregion case requires one glancing impact force in kilonewtons."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactLineLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:GlancingImpactLineLoadQuantityShape ;
        sh:message "Each bow subregion case requires one glancing impact line load in MN/m."
    ] ;
    sh:property [
        sh:path nltl:glancingImpactPressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:GlancingImpactPressureQuantityShape ;
        sh:message "Each bow subregion case requires one glancing impact pressure in MPa."
    ] .

gen:BowLengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:MidLengthPositionQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

gen:GlancingImpactForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .

gen:GlancingImpactLineLoadQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaN-M-PER-M2
    ] .

gen:GlancingImpactPressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaPA
    ] .
