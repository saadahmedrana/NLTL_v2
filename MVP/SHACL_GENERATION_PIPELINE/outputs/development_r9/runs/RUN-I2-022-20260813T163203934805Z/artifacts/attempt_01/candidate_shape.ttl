@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:PressureQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA
    ] .

gs:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS
    ] .

gs:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG
    ] .

gs:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M
    ] .

gs:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM
    ] .

gs:I2_022ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:node gs:PressureQuantityShape
    ] ;
    sh:property [
        sh:path nltl:peakPressureFactor ;
        sh:node gs:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gs:PressureQuantityShape
    ] ;
    sh:property [
        sh:path ( nltl:hasComponent nltl:framingAngleOmega ) ;
        sh:node gs:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path ( nltl:hasComponent nltl:frameSpacing ) ;
        sh:node gs:MetreQuantityShape
    ] ;
    sh:property [
        sh:path ( nltl:hasComponent nltl:iceLoadRequiredNetPlateThickness ) ;
        sh:node gs:MillimetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "Applicable transversely-framed plating must provide its ice-load required net plate thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate a nltl:plating ;
                       nltl:framingAngleOmega ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angle ;
                               qudt:unit unit:DEG .
                FILTER (?angle >= 70)
                FILTER NOT EXISTS {
                    ?plate nltl:iceLoadRequiredNetPlateThickness ?thicknessQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Average ice pressure is required when plating with framing angle of at least 70 degrees is present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate a nltl:plating ;
                       nltl:framingAngleOmega ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angle ;
                               qudt:unit unit:DEG .
                FILTER (?angle >= 70)
                FILTER NOT EXISTS {
                    $this nltl:averageIcePressure ?pressureQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Peak pressure factor is required when plating with framing angle of at least 70 degrees is present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate a nltl:plating ;
                       nltl:framingAngleOmega ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angle ;
                               qudt:unit unit:DEG .
                FILTER (?angle >= 70)
                FILTER NOT EXISTS {
                    $this nltl:peakPressureFactor ?factorQuantity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Yield strength is required when plating with framing angle of at least 70 degrees is present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:hasComponent ?plate .
                ?plate a nltl:plating ;
                       nltl:framingAngleOmega ?angleQuantity .
                ?angleQuantity qudt:numericValue ?angle ;
                               qudt:unit unit:DEG .
                FILTER (?angle >= 70)
                FILTER NOT EXISTS {
                    $this nltl:yieldStrength ?strengthQuantity .
                }
            }
        """
    ] .
