@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:I2-029Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node g:SectionModulusValueShape
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node g:ShearAreaValueShape
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:shearArea ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:sectionModulus ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:qualifiedValueShape g:FramingMemberNetInputShape ;
                sh:qualifiedMinCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:shearArea ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:qualifiedValueShape g:FramingMemberNetInputShape ;
                sh:qualifiedMinCount 1
            ]
        ]
    ) ;
    sh:message "A reported section modulus or shear area requires a structural member with net web and attached shell plate thickness inputs." .

g:FramingMemberNetInputShape
    a sh:NodeShape ;
    sh:class nltl:structuralMember ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:node g:MillimetreThicknessValueShape
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:node g:MillimetreThicknessValueShape
    ] ;
    sh:property [
        sh:path nltl:netFlangeThickness ;
        sh:node g:MillimetreThicknessValueShape
    ] .

g:MillimetreThicknessValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM
    ] .

g:SectionModulusValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3
    ] .

g:ShearAreaValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M2
    ] .
