@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_030_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasComponent ;
        sh:qualifiedValueShape gen:I2_030_CalculationCaseShape ;
        sh:qualifiedMinCount 1 ;
        sh:message "A local-frame calculation case with sufficient applicability information is required."
    ] .

gen:I2_030_CalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:shipComponent ;
    sh:class nltl:calculationCase ;
    sh:class nltl:structuralMember ;
    sh:class nltl:plating ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:SquareCentimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:or (
        gen:I2_030_NotApplicableShape
        gen:I2_030_ApplicableShape
    ) .

gen:I2_030_NotApplicableShape
    a sh:NodeShape ;
    sh:sparql [
        sh:message "This alternative applies only when the local-frame area does not exceed the attached-plate-flange area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:netLocalFrameFlangeArea ?areaQuantity ;
                      nltl:netAttachedShellPlateThickness ?plateThicknessQuantity ;
                      nltl:frameSpacing ?spacingQuantity .
                ?areaQuantity qudt:numericValue ?area .
                ?plateThicknessQuantity qudt:numericValue ?plateThickness .
                ?spacingQuantity qudt:numericValue ?spacing .
                FILTER (
                    100.0 * xsd:double(?area) >
                    1000.0 * xsd:double(?plateThickness) * xsd:double(?spacing)
                )
            }
        """
    ] .

gen:I2_030_ApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MillimetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:CubicCentimetreQuantityShape
    ] ;
    sh:sparql [
        sh:message "The formula alternative applies only when the local-frame area exceeds the attached-plate-flange area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:netLocalFrameFlangeArea ?areaQuantity ;
                      nltl:netAttachedShellPlateThickness ?plateThicknessQuantity ;
                      nltl:frameSpacing ?spacingQuantity .
                ?areaQuantity qudt:numericValue ?area .
                ?plateThicknessQuantity qudt:numericValue ?plateThickness .
                ?spacingQuantity qudt:numericValue ?spacing .
                FILTER (
                    100.0 * xsd:double(?area) <=
                    1000.0 * xsd:double(?plateThickness) * xsd:double(?spacing)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Net web thickness must be non-zero when the plastic neutral-axis formula applies." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:netLocalFrameFlangeArea ?areaQuantity ;
                      nltl:netAttachedShellPlateThickness ?plateThicknessQuantity ;
                      nltl:frameSpacing ?spacingQuantity ;
                      nltl:netWebThickness ?webThicknessQuantity .
                ?areaQuantity qudt:numericValue ?area .
                ?plateThicknessQuantity qudt:numericValue ?plateThickness .
                ?spacingQuantity qudt:numericValue ?spacing .
                ?webThicknessQuantity qudt:numericValue ?webThickness .
                FILTER (
                    100.0 * xsd:double(?area) >
                    1000.0 * xsd:double(?plateThickness) * xsd:double(?spacing)
                )
                FILTER (xsd:double(?webThickness) = 0.0)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The reported plastic neutral-axis height or direct-angle net effective plastic section modulus is inconsistent with the prescribed formula." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            SELECT $this
            WHERE {
                $this nltl:netLocalFrameFlangeArea ?areaQuantity ;
                      nltl:netAttachedShellPlateThickness ?plateThicknessQuantity ;
                      nltl:frameSpacing ?spacingQuantity ;
                      nltl:netWebThickness ?webThicknessQuantity ;
                      nltl:webHeight ?webHeightQuantity ;
                      nltl:localFrameFlangeCentreHeight ?flangeHeightQuantity ;
                      nltl:webToFlangeCentreDistance ?flangeDistanceQuantity ;
                      nltl:webAngleToShellPlate ?webAngleQuantity ;
                      nltl:framingAngleOmega ?omegaQuantity ;
                      nltl:plasticNeutralAxisHeight ?neutralAxisQuantity ;
                      nltl:netEffectivePlasticSectionModulus ?sectionModulusQuantity .

                ?areaQuantity qudt:numericValue ?areaValue .
                ?plateThicknessQuantity qudt:numericValue ?plateThicknessValue .
                ?spacingQuantity qudt:numericValue ?spacingValue .
                ?webThicknessQuantity qudt:numericValue ?webThicknessValue .
                ?webHeightQuantity qudt:numericValue ?webHeightValue .
                ?flangeHeightQuantity qudt:numericValue ?flangeHeightValue .
                ?flangeDistanceQuantity qudt:numericValue ?flangeDistanceValue .
                ?webAngleQuantity qudt:numericValue ?webAngleValue .
                ?omegaQuantity qudt:numericValue ?omegaValue .
                ?neutralAxisQuantity qudt:numericValue ?neutralAxisValue .
                ?sectionModulusQuantity qudt:numericValue ?sectionModulusValue .

                BIND(xsd:double(?areaValue) AS ?area)
                BIND(xsd:double(?plateThicknessValue) AS ?plateThickness)
                BIND(xsd:double(?spacingValue) AS ?spacing)
                BIND(xsd:double(?webThicknessValue) AS ?webThickness)
                BIND(xsd:double(?webHeightValue) AS ?webHeight)
                BIND(xsd:double(?flangeHeightValue) AS ?flangeHeight)
                BIND(xsd:double(?flangeDistanceValue) AS ?flangeDistance)
                BIND(xsd:double(?webAngleValue) AS ?webAngle)
                BIND(xsd:double(?omegaValue) AS ?omega)
                BIND(xsd:double(?neutralAxisValue) AS ?reportedNeutralAxis)
                BIND(xsd:double(?sectionModulusValue) AS ?reportedSectionModulus)

                FILTER (100.0 * ?area > 1000.0 * ?plateThickness * ?spacing)
                FILTER (?webThickness != 0.0)

                BIND(
                    (100.0 * ?area +
                     ?webHeight * ?webThickness -
                     1000.0 * ?plateThickness * ?spacing) /
                    (2.0 * ?webThickness)
                    AS ?expectedNeutralAxis
                )
                BIND(
                    IF(
                        ABS(?expectedNeutralAxis) * 0.000001 > 0.000000001,
                        ABS(?expectedNeutralAxis) * 0.000001,
                        0.000000001
                    )
                    AS ?neutralAxisTolerance
                )
                BIND(?webAngle * 0.017453292519943295 AS ?webAngleRadians)
                BIND(math:sin(?webAngleRadians) AS ?webAngleSine)
                BIND(math:cos(?webAngleRadians) AS ?webAngleCosine)
                BIND(
                    ?plateThickness * ?spacing *
                        (?expectedNeutralAxis + ?plateThickness / 2.0) *
                        ?webAngleSine
                    +
                    (
                        (
                            (?webHeight - ?expectedNeutralAxis) *
                            (?webHeight - ?expectedNeutralAxis)
                            +
                            ?expectedNeutralAxis * ?expectedNeutralAxis
                        )
                        * ?webThickness * ?webAngleSine
                    ) / 2000.0
                    +
                    ?area *
                    (
                        (?flangeHeight - ?expectedNeutralAxis) * ?webAngleSine
                        -
                        ?flangeDistance * ?webAngleCosine
                    ) / 10.0
                    AS ?expectedSectionModulus
                )
                BIND(
                    IF(
                        ABS(?expectedSectionModulus) * 0.000001 > 0.000000001,
                        ABS(?expectedSectionModulus) * 0.000001,
                        0.000000001
                    )
                    AS ?sectionModulusTolerance
                )
                FILTER (
                    ABS(?reportedNeutralAxis - ?expectedNeutralAxis) >
                        ?neutralAxisTolerance
                    ||
                    (
                        ! (?omega > 20.0 && ?omega < 70.0)
                        &&
                        ABS(?reportedSectionModulus - ?expectedSectionModulus) >
                            ?sectionModulusTolerance
                    )
                )
            }
        """
    ] .

gen:MillimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SquareCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:CubicCentimetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
