@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:ShipStructuralMemberShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:structuralMember ;
        sh:message "Each identified structural member must be an IRI classified as a structural member."
    ] .

gs:StructuralMemberShape
    a sh:NodeShape ;
    sh:targetObjectsOf nltl:hasStructuralMember ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node gs:PlasticStrengthQuantityShape ;
        sh:message "A reported plastic strength must be a valid quantity in kilonewtons."
    ] .

gs:PlasticStrengthQuantityShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "Plastic strength requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:message "Plastic strength must use kilonewtons."
    ] .

gs:LoadCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:loadCase ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node gs:CombinedDemandQuantityShape ;
        sh:message "A reported combined shear and bending demand must be a valid quantity."
    ] ;
    sh:property [
        sh:path nltl:loadPatchOrientation ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:loadPatchHeightParallelToFrame ) ;
        sh:message "A reported load patch orientation must specify the patch height parallel to the frame."
    ] .

gs:CombinedDemandQuantityShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "Combined shear and bending demand requires a decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "Combined shear and bending demand requires a unit."
    ] .
