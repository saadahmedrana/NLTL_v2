@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2-037ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceLoadPatch ;
        sh:minCount 1 ;
        sh:message "The ship must identify the ice load patch to be withstood."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceLoadPatchDesignCase ;
        sh:node gen:I2-037DesignCaseShape ;
        sh:minCount 1 ;
        sh:message "The ship must identify an ice load patch design case."
    ] .

gen:I2-037DesignCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:memberCapacityMinimizationConfirmed ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "The design case must confirm that the load patch location minimizes member capacity under the combined effects of bending and shear."
    ] .
