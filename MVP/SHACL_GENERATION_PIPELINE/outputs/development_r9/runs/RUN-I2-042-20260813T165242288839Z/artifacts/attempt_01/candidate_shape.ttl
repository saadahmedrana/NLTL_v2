@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_042_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each structural member must have exactly one flange width expressed as one decimal quantity value in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?member
            WHERE {
                $this nltl:hasComponent ?member .
                ?member a nltl:structuralMember .
                FILTER (
                    NOT EXISTS {
                        ?member nltl:flangeWidth ?flangeWidth .
                    }
                    ||
                    EXISTS {
                        ?member nltl:flangeWidth ?flangeWidth1, ?flangeWidth2 .
                        FILTER (!sameTerm(?flangeWidth1, ?flangeWidth2))
                    }
                    ||
                    EXISTS {
                        ?member nltl:flangeWidth ?flangeWidth .
                        FILTER (
                            NOT EXISTS {
                                ?flangeWidth a qudt:QuantityValue .
                            }
                            ||
                            NOT EXISTS {
                                ?flangeWidth qudt:numericValue ?flangeWidthValue .
                                FILTER (datatype(?flangeWidthValue) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                ?flangeWidth qudt:numericValue ?flangeWidthValue1, ?flangeWidthValue2 .
                                FILTER (!sameTerm(?flangeWidthValue1, ?flangeWidthValue2))
                            }
                            ||
                            NOT EXISTS {
                                ?flangeWidth qudt:unit unit:MilliM .
                            }
                            ||
                            EXISTS {
                                ?flangeWidth qudt:unit ?flangeWidthUnit1, ?flangeWidthUnit2 .
                                FILTER (!sameTerm(?flangeWidthUnit1, ?flangeWidthUnit2))
                            }
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each structural member must have exactly one net web thickness expressed as one decimal quantity value in millimetres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?member
            WHERE {
                $this nltl:hasComponent ?member .
                ?member a nltl:structuralMember .
                FILTER (
                    NOT EXISTS {
                        ?member nltl:netWebThickness ?netWebThickness .
                    }
                    ||
                    EXISTS {
                        ?member nltl:netWebThickness ?netWebThickness1, ?netWebThickness2 .
                        FILTER (!sameTerm(?netWebThickness1, ?netWebThickness2))
                    }
                    ||
                    EXISTS {
                        ?member nltl:netWebThickness ?netWebThickness .
                        FILTER (
                            NOT EXISTS {
                                ?netWebThickness a qudt:QuantityValue .
                            }
                            ||
                            NOT EXISTS {
                                ?netWebThickness qudt:numericValue ?netWebThicknessValue .
                                FILTER (datatype(?netWebThicknessValue) = xsd:decimal)
                            }
                            ||
                            EXISTS {
                                ?netWebThickness qudt:numericValue ?netWebThicknessValue1, ?netWebThicknessValue2 .
                                FILTER (!sameTerm(?netWebThicknessValue1, ?netWebThicknessValue2))
                            }
                            ||
                            NOT EXISTS {
                                ?netWebThickness qudt:unit unit:MilliM .
                            }
                            ||
                            EXISTS {
                                ?netWebThickness qudt:unit ?netWebThicknessUnit1, ?netWebThicknessUnit2 .
                                FILTER (!sameTerm(?netWebThicknessUnit1, ?netWebThicknessUnit2))
                            }
                        )
                    }
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "The flange width must not be less than five times the net web thickness." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this ?member
            WHERE {
                $this nltl:hasComponent ?member .
                ?member a nltl:structuralMember ;
                    nltl:flangeWidth ?flangeWidth ;
                    nltl:netWebThickness ?netWebThickness .
                ?flangeWidth
                    a qudt:QuantityValue ;
                    qudt:numericValue ?flangeWidthValue ;
                    qudt:unit unit:MilliM .
                ?netWebThickness
                    a qudt:QuantityValue ;
                    qudt:numericValue ?netWebThicknessValue ;
                    qudt:unit unit:MilliM .
                FILTER (
                    datatype(?flangeWidthValue) = xsd:decimal &&
                    datatype(?netWebThicknessValue) = xsd:decimal &&
                    ?flangeWidthValue < (5 * ?netWebThicknessValue)
                )
            }
        """
    ] .
