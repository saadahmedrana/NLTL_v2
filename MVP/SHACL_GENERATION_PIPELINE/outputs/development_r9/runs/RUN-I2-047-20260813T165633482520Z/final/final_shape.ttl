@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:I2-047Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengthenedStructureStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice-strengthened structure applicability status must be recorded exactly once."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengthenedStructureStatus ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengthenedStructureStatus ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:gaugedThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "An applicable ship must provide one gauged thickness in metres."
            ] ;
            sh:property [
                sh:path nltl:iceLoadRequiredNetPlateThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "An applicable ship must provide one required net plate thickness in millimetres."
            ] ;
            sh:property [
                sh:path nltl:steelRenewalRequired ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable ship must provide exactly one steel-renewal decision."
            ] ;
            sh:sparql [
                sh:message "Steel renewal must be required when gauged thickness is less than required net thickness plus 0.5 mm." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:gaugedThickness ?gaugedQuantity ;
                              nltl:iceLoadRequiredNetPlateThickness ?requiredQuantity ;
                              nltl:steelRenewalRequired ?renewalRequired .
                        ?gaugedQuantity qudt:numericValue ?gaugedMetres .
                        ?requiredQuantity qudt:numericValue ?requiredMillimetres .
                        FILTER (
                            (?gaugedMetres * 1000.0) < (?requiredMillimetres + 0.5)
                            && ?renewalRequired != true
                        )
                    }
                """
            ]
        ]
    ) .
