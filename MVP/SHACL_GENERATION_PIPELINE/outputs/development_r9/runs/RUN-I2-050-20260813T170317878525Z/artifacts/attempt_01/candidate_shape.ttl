@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ForceQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DimensionlessQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:LengthQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:AngleQuantityValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DesignVerticalIceForceAtBowShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:node gen:ForceQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateOne ;
        sh:node gen:ForceQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateTwo ;
        sh:node gen:ForceQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hullFormCoefficientKh ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceStrengthCoefficientKI ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:node gen:LengthQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:node gen:AngleQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Design vertical ice force at the bow must equal the minimum of its two candidate forces within a relative tolerance of 1e-6 and an absolute fallback of 1e-12 MN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:designVerticalIceForceAtBow ?force ;
                      nltl:designVerticalIceForceAtBowCandidateOne ?candidateOne ;
                      nltl:designVerticalIceForceAtBowCandidateTwo ?candidateTwo .
                ?force qudt:numericValue ?actual .
                ?candidateOne qudt:numericValue ?valueOne .
                ?candidateTwo qudt:numericValue ?valueTwo .
                BIND(IF(?valueOne <= ?valueTwo, ?valueOne, ?valueTwo) AS ?expected)
                BIND(ABS(?expected) * "0.000001"^^xsd:decimal AS ?relativeTolerance)
                BIND(
                    IF(
                        ?relativeTolerance > "0.000000000001"^^xsd:decimal,
                        ?relativeTolerance,
                        "0.000000000001"^^xsd:decimal
                    )
                    AS ?tolerance
                )
                FILTER(ABS(?actual - ?expected) > ?tolerance)
            }
        """
    ] .

gen:IceForceClassFactorCaseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:crushingFailureClassFactor ;
    sh:targetSubjectsOf nltl:flexuralFailureClassFactor ;
    sh:targetSubjectsOf nltl:longitudinalStrengthClassFactor ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalStrengthClassFactor ;
        sh:node gen:DimensionlessQuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
