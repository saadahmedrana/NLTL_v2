@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:UnitlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MegaNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MetreQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DegreeQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:DesignVerticalIceForceAtBowShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:longitudinalStrengthClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:hullFormCoefficientKh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:iceStrengthCoefficientKI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessQuantityShape
    ] ;
    sh:property [
        sh:path nltl:stemAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:DegreeQuantityShape
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraughtDUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MetreQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateOne ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBowCandidateTwo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:MegaNewtonQuantityShape
    ] ;
    sh:sparql [
        sh:message "The two candidate bow forces and final bow force must satisfy the prescribed formulas within relative tolerance 1e-6 and absolute fallback 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX math: <http://www.w3.org/2005/xpath-functions/math#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:crushingFailureClassFactor ?cfcQuantity ;
                      nltl:flexuralFailureClassFactor ?cffQuantity ;
                      nltl:longitudinalStrengthClassFactor ?cflQuantity ;
                      nltl:hullFormCoefficientKh ?khQuantity ;
                      nltl:iceStrengthCoefficientKI ?kiQuantity ;
                      nltl:stemAngle ?angleQuantity ;
                      nltl:upperIceWaterlineDraughtDUI ?draughtQuantity ;
                      nltl:designVerticalIceForceAtBowCandidateOne ?fib1Quantity ;
                      nltl:designVerticalIceForceAtBowCandidateTwo ?fib2Quantity ;
                      nltl:designVerticalIceForceAtBow ?fibQuantity .

                ?cfcQuantity qudt:numericValue ?cfc .
                ?cffQuantity qudt:numericValue ?cff .
                ?cflQuantity qudt:numericValue ?cfl .
                ?khQuantity qudt:numericValue ?kh .
                ?kiQuantity qudt:numericValue ?ki .
                ?angleQuantity qudt:numericValue ?angleDegrees .
                ?draughtQuantity qudt:numericValue ?draught .
                ?fib1Quantity qudt:numericValue ?fib1 .
                ?fib2Quantity qudt:numericValue ?fib2 .
                ?fibQuantity qudt:numericValue ?fib .

                BIND((?angleDegrees * 3.141592653589793) / 180.0 AS ?angleRadians)
                BIND(
                    0.534
                    * math:pow(?ki, 0.15)
                    * math:pow(math:sin(?angleRadians), 0.2)
                    * math:pow((?draught * ?kh), 0.5)
                    * ?cfl
                    AS ?expectedFib1
                )
                BIND(1.20 * ?cff AS ?expectedFib2)
                BIND(
                    IF(
                        ?expectedFib1 <= ?expectedFib2,
                        ?expectedFib1,
                        ?expectedFib2
                    )
                    AS ?expectedFib
                )
                BIND(
                    IF(
                        ABS(?expectedFib1) * 0.000001 > 0.000000001,
                        ABS(?expectedFib1) * 0.000001,
                        0.000000001
                    )
                    AS ?fib1Tolerance
                )
                BIND(
                    IF(
                        ABS(?expectedFib2) * 0.000001 > 0.000000001,
                        ABS(?expectedFib2) * 0.000001,
                        0.000000001
                    )
                    AS ?fib2Tolerance
                )
                BIND(
                    IF(
                        ABS(?expectedFib) * 0.000001 > 0.000000001,
                        ABS(?expectedFib) * 0.000001,
                        0.000000001
                    )
                    AS ?fibTolerance
                )

                FILTER(
                    ABS(?fib1 - ?expectedFib1) > ?fib1Tolerance ||
                    ABS(?fib2 - ?expectedFib2) > ?fib2Tolerance ||
                    ABS(?fib - ?expectedFib) > ?fibTolerance
                )
            }
        """
    ] .
