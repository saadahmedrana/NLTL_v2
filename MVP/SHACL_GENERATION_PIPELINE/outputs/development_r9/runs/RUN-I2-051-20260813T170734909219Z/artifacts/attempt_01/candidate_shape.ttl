@prefix g: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:PositiveShearForceCaseShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?this nltl:shearForceDirection nltl:positiveShearForce .
            }
        """
    ] ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:shearForceDirection ;
        sh:hasValue nltl:positiveShearForce ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hullGirderLongitudinalPositionFromAft ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:PositionQuantityShape
    ] ;
    sh:property [
        sh:path nltl:longitudinalDistributionFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:DistributionFactorQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceShearForce ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:ShearForceQuantityShape
    ] ;
    sh:property [
        sh:path [ sh:inversePath nltl:hasComponent ] ;
        sh:minCount 1 ;
        sh:class nltl:ship ;
        sh:node g:PositiveShearForceShipInputsShape ;
        sh:message "A positive shear-force calculation case requires a parent ship with LUI and FIB inputs."
    ] ;
    sh:sparql [
        sh:message "The design vertical ice shear force must equal Cf multiplied by FIB, converted from MN to kN, within relative tolerance 1e-6 and absolute fallback 1e-9 kN." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                ?ship nltl:hasComponent $this ;
                      nltl:designVerticalIceForceAtBow ?fibQuantity .
                ?fibQuantity qudt:numericValue ?fib .
                $this nltl:shearForceDirection nltl:positiveShearForce ;
                      nltl:longitudinalDistributionFactor ?factorQuantity ;
                      nltl:designVerticalIceShearForce ?shearQuantity .
                ?factorQuantity qudt:numericValue ?cf .
                ?shearQuantity qudt:numericValue ?reportedShear .
                BIND((?cf * ?fib * 1000.0) AS ?expectedShear)
                BIND(
                    IF(
                        ABS(?expectedShear) * 0.000001 > 0.000000001,
                        ABS(?expectedShear) * 0.000001,
                        0.000000001
                    ) AS ?tolerance
                )
                FILTER(ABS(?reportedShear - ?expectedShear) > ?tolerance)
            }
        """
    ] .

g:AftPositiveShearRegionShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?ship nltl:hasComponent ?this ;
                      nltl:upperIceWaterlineLengthLUI ?luiQuantity .
                ?this nltl:shearForceDirection nltl:positiveShearForce ;
                      nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                ?luiQuantity qudt:numericValue ?lui .
                ?positionQuantity qudt:numericValue ?position .
                FILTER(?position >= 0.0 && ?position <= (0.6 * ?lui))
            }
        """
    ] ;
    sh:property [
        sh:path ( nltl:longitudinalDistributionFactor qudt:numericValue ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "0.0"^^xsd:decimal ;
        sh:maxInclusive "0.0"^^xsd:decimal ;
        sh:message "For positive shear force from the aft end through 0.6 LUI, Cf must equal 0.0."
    ] .

g:ForwardPositiveShearRegionShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT ?this
            WHERE {
                ?ship nltl:hasComponent ?this ;
                      nltl:upperIceWaterlineLengthLUI ?luiQuantity .
                ?this nltl:shearForceDirection nltl:positiveShearForce ;
                      nltl:hullGirderLongitudinalPositionFromAft ?positionQuantity .
                ?luiQuantity qudt:numericValue ?lui .
                ?positionQuantity qudt:numericValue ?position .
                FILTER(?position >= (0.9 * ?lui) && ?position <= ?lui)
            }
        """
    ] ;
    sh:property [
        sh:path ( nltl:longitudinalDistributionFactor qudt:numericValue ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "1.0"^^xsd:decimal ;
        sh:message "For positive shear force from 0.9 LUI through the forward end of LUI, Cf must equal 1.0."
    ] .

g:PositiveShearForceShipInputsShape
    a sh:NodeShape ;
    sh:class nltl:ship ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:LUIQuantityShape
    ] ;
    sh:property [
        sh:path nltl:designVerticalIceForceAtBow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node g:BowForceQuantityShape
    ] .

g:PositionQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

g:LUIQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:M
    ] .

g:DistributionFactorQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:UNITLESS
    ] .

g:BowForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:MegaN
    ] .

g:ShearForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue unit:KiloN
    ] .
