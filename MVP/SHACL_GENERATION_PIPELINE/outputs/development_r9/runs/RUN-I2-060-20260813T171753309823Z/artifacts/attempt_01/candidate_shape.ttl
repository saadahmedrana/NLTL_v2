@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:memberInstability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false ) ;
        sh:message "Member instability must be recorded as false."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node gen:I2_060_StiffeningDecisionShape ;
        sh:message "A structural member and its stiffening-necessity decision are required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:minCount 1 ;
                sh:node gen:I2_060_StiffeningNotNecessaryShape
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasStructuralMember ;
                sh:qualifiedValueShape gen:I2_060_StiffeningNecessaryShape ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:structuralStiffening ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Structural stiffening must be recorded when it is necessary."
            ]
        ]
    ) .

gen:I2_060_StiffeningDecisionShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ]
        ]
    ) .

gen:I2_060_StiffeningNotNecessaryShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:stiffeningNecessary ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( false )
    ] .

gen:I2_060_StiffeningNecessaryShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:stiffeningNecessary ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true )
    ] .
