@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:I2_061_CalculationMethodShape
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A direct calculation method must not replace the prescribed analytical procedure." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:directCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:calculationMethod nltl:prescribedAnalyticalProcedure .
                }
            }
        """
    ] .
