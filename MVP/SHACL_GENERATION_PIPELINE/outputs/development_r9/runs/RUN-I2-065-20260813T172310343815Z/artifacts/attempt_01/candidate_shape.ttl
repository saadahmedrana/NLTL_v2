@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:NonlinearStructuralEvaluationShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "A ship modeled as a calculation case must identify its calculation method." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this a nltl:calculationCase .
                FILTER NOT EXISTS {
                    $this nltl:calculationMethod ?method .
                    ?method a nltl:calculationMethodValue .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A non-linear structural evaluation lacks complete typed data for buckling, plastic and permanent deformation, or the required unitless fracture, major buckling, and yielding margins." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER NOT EXISTS {
                    $this nltl:nonlinearCalculationMethod ?nonlinearMethod ;
                          nltl:bucklingResponse ?buckling ;
                          nltl:plasticDeformation ?plastic ;
                          nltl:permanentDeformation ?permanent ;
                          nltl:fractureMargin ?fracture ;
                          nltl:majorBucklingMargin ?majorBuckling ;
                          nltl:yieldingMargin ?yielding .

                    FILTER (
                        datatype(?nonlinearMethod) = xsd:string &&
                        datatype(?buckling) = xsd:string &&
                        datatype(?plastic) = xsd:string &&
                        datatype(?permanent) = xsd:string
                    )

                    ?fracture a qudt:QuantityValue ;
                              qudt:numericValue ?fractureValue ;
                              qudt:unit unit:UNITLESS .
                    ?majorBuckling a qudt:QuantityValue ;
                                   qudt:numericValue ?majorBucklingValue ;
                                   qudt:unit unit:UNITLESS .
                    ?yielding a qudt:QuantityValue ;
                              qudt:numericValue ?yieldingValue ;
                              qudt:unit unit:UNITLESS .

                    FILTER (
                        datatype(?fractureValue) = xsd:decimal &&
                        datatype(?majorBucklingValue) = xsd:decimal &&
                        datatype(?yieldingValue) = xsd:decimal
                    )
                }
            }
        """
    ] .
