@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ThinFirstYearIceShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:message "Ice type classification is required to determine whether the thickness range applies."
    ] ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path nltl:iceTypeClassification ;
                    sh:hasValue nltl:thinFirstYearIce
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceTypeClassification ;
                sh:hasValue nltl:thinFirstYearIce
            ] ;
            sh:property [
                sh:path nltl:iceThickness ;
                sh:minCount 1 ;
                sh:message "Thin first-year ice requires at least one ice thickness value." ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minCount 1 ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "0.3"^^xsd:decimal ;
                        sh:maxInclusive "0.7"^^xsd:decimal ;
                        sh:message "Thin first-year ice thickness must be between 0.3 m and 0.7 m inclusive."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:in ( unit:M ) ;
                        sh:message "Thin first-year ice thickness must use metre as its unit."
                    ]
                ]
            ]
        ]
    ) .
