@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO017ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPolarShipCertificate ;
        sh:minCount 1 ;
        sh:class nltl:polarShipCertificateForm ;
        sh:node gen:IMO017PolarCertificateShape ;
        sh:message "A Polar Ship Certificate with the required dates, supplement, and equipment records is required."
    ] ;
    sh:property [
        sh:path nltl:hasSolasCertificateSchedule ;
        sh:minCount 1 ;
        sh:class nltl:solasCertificateSchedule ;
        sh:node gen:IMO017SolasScheduleShape ;
        sh:message "The applicable SOLAS certificate schedule is required."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each Polar Ship Certificate date or endorsement must occur in each applicable SOLAS certificate schedule." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasPolarShipCertificate ?polarCertificate .
    $this nltl:hasSolasCertificateSchedule ?solasSchedule .
    ?polarCertificate ?dateProperty ?dateValue .
    FILTER (
        ?dateProperty IN (
            nltl:polarCertificateValidityDates,
            nltl:surveyDates,
            nltl:endorsementDates
        )
    )
    FILTER NOT EXISTS {
        ?solasSchedule ?dateProperty ?dateValue .
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each applicable SOLAS certificate schedule date or endorsement must occur in each Polar Ship Certificate." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasPolarShipCertificate ?polarCertificate .
    $this nltl:hasSolasCertificateSchedule ?solasSchedule .
    ?solasSchedule ?dateProperty ?dateValue .
    FILTER (
        ?dateProperty IN (
            nltl:polarCertificateValidityDates,
            nltl:surveyDates,
            nltl:endorsementDates
        )
    )
    FILTER NOT EXISTS {
        ?polarCertificate ?dateProperty ?dateValue .
    }
}
"""
    ] .

gen:IMO017PolarCertificateShape
    a sh:NodeShape ;
    sh:class nltl:benchmarkEntity ;
    sh:class nltl:polarShipCertificateForm ;
    sh:class nltl:requiredEquipmentRecords ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate validity dates are required."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate survey dates are required."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Polar Ship Certificate endorsement dates are required."
    ] ;
    sh:property [
        sh:path nltl:polarCertificateSupplementPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "The Polar Ship Certificate supplement must be present."
    ] .

gen:IMO017SolasScheduleShape
    a sh:NodeShape ;
    sh:class nltl:benchmarkEntity ;
    sh:class nltl:solasCertificateSchedule ;
    sh:property [
        sh:path nltl:polarCertificateValidityDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "SOLAS certificate validity dates are required for harmonization."
    ] ;
    sh:property [
        sh:path nltl:surveyDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "SOLAS certificate survey dates are required for harmonization."
    ] ;
    sh:property [
        sh:path nltl:endorsementDates ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "SOLAS certificate endorsement dates are required for harmonization."
    ] .
