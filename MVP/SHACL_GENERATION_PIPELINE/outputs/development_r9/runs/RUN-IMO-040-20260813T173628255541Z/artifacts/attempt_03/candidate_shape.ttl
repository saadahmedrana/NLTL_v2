@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO040ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one boolean ice-accretion-likelihood value is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRelevantHatchOrDoor ;
                sh:minCount 1 ;
                sh:class nltl:relevantHatchOrDoorItem ;
                sh:node gen:IMO040RelevantHatchOrDoorShape ;
                sh:message "When ice accretion is likely, each relevant hatch or door must be linked to removal or prevention means."
            ]
        ]
    ) .

gen:IMO040RelevantHatchOrDoorShape
    a sh:NodeShape ;
    sh:class nltl:equipmentItem ;
    sh:property [
        sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:class nltl:iceSnowRemovalOrPreventionMeans ;
        sh:message "The relevant hatch or door must have associated ice or snow removal or prevention means."
    ] .
