@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:CelsiusQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The temperature quantity must have exactly one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG_C ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The temperature quantity must have exactly one degree Celsius unit."
    ] .

gen:EssentialEngineCombustionAirTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasEssentialEngine ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasEssentialEngine ;
                sh:class nltl:essentialEngine ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:combustionAirTemperatureControlPresent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Combustion air temperature control must be present for a ship with an essential engine."
            ] ;
            sh:property [
                sh:path nltl:combustionAirTemperature ;
                sh:node gen:CelsiusQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Exactly one combustion air temperature in degrees Celsius is required."
            ] ;
            sh:property [
                sh:path nltl:manufacturerMinAirTemperature ;
                sh:node gen:CelsiusQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Exactly one manufacturer minimum air temperature in degrees Celsius is required."
            ] ;
            sh:property [
                sh:path nltl:manufacturerMaxAirTemperature ;
                sh:node gen:CelsiusQuantityShape ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Exactly one manufacturer maximum air temperature in degrees Celsius is required."
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Combustion air temperature must be within the inclusive manufacturer temperature limits." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasEssentialEngine ?engine ;
          nltl:combustionAirTemperature ?temperatureQuantity ;
          nltl:manufacturerMinAirTemperature ?minimumQuantity ;
          nltl:manufacturerMaxAirTemperature ?maximumQuantity .
    ?temperatureQuantity qudt:numericValue ?temperature .
    ?minimumQuantity qudt:numericValue ?minimum .
    ?maximumQuantity qudt:numericValue ?maximum .
    FILTER (
        ?temperature < ?minimum ||
        ?temperature > ?maximum
    )
}
"""
    ] .
