@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO051Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLocalControlItem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:localControlItem ;
        sh:node gs:IMO051LocalControlItemShape ;
        sh:message "A local equipment or machinery control inventory is required."
    ] .

gs:IMO051LocalControlItemShape
    a sh:NodeShape ;
    sh:class nltl:benchmarkEntity ;
    sh:property [
        sh:path nltl:freezingSnowIceProtectionPresent ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Each local control item shall have protection against freezing, snow accumulation, and ice accretion."
    ] ;
    sh:property [
        sh:path nltl:continuouslyAccessible ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Each local control item shall remain continuously accessible."
    ] .
