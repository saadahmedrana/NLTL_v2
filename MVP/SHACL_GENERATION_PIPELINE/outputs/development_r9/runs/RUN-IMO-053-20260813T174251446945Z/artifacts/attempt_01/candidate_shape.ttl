@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExtinguishingMediumCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:extinguishingMediumItem ;
        sh:message "Each linked extinguishing medium must be an identified extinguishing medium item."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasExtinguishingMedium ;
                sh:maxCount 0
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasExtinguishingMedium ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:intendedOperationCompatibilityStatus ;
                sh:minCount 1 ;
                sh:datatype xsd:boolean ;
                sh:in ( true ) ;
                sh:message "The intended-operation compatibility status must be approved."
            ]
        ]
    ) .
