@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <urn:nltl:generated-shape:> .

shape:ExtinguishingMediumShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:extinguishingMediumItem ;
        sh:message "Each linked extinguishing medium must be an extinguishing medium item."
    ] .
