@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExtinguishingMediumCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:extinguishingMediumItem ;
        sh:node gen:ApprovedExtinguishingMediumShape ;
        sh:message "Each ship shall link at least one extinguishing medium item, and every linked item shall be approved for intended operation."
    ] .

gen:ApprovedExtinguishingMediumShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:intendedOperationCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Each extinguishing medium item shall have an intended-operation compatibility status of true."
    ] .
