@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExposedFireMainSectionShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:isolationCapability ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Each exposed fire-main section shall have isolation capability."
    ] ;
    sh:property [
        sh:path nltl:drainageMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Each exposed fire-main section shall have drainage means."
    ] .

gen:ShipExposedFireMainSectionsShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedFireMainSection ;
        sh:node gen:ExposedFireMainSectionShape
    ] .
