@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExposedEscapeRouteSafetyShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedEscapeRoute ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:exposedEscapeRoute ;
        sh:message "At least one exposed escape route must be recorded."
    ] ;
    sh:property [
        sh:path nltl:accessibleStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Accessible status must be recorded as true."
    ] ;
    sh:property [
        sh:path nltl:safeStatus ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Safe status must be recorded as true."
    ] ;
    sh:property [
        sh:path nltl:iceSnowMitigationCoverage ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:message "Ice and snow mitigation coverage must be documented as true."
    ] .
