@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PassengerShipSurvivalEquipmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:passengerShip ;
    sh:property [
        sh:path nltl:sizeCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Passenger-ship survival equipment shall be recorded as properly sized."
    ] ;
    sh:property [
        sh:path nltl:hasPersonOnBoardMember ;
        sh:minCount 1 ;
        sh:class nltl:personOnBoardMember ;
        sh:node gen:PersonSurvivalEquipmentAssignmentShape ;
        sh:message "A passenger ship shall record each person on board and a qualifying survival-equipment assignment for each person."
    ] .

gen:PersonSurvivalEquipmentAssignmentShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:qualifiedValueShape gen:QualifyingSurvivalEquipmentAssignmentShape ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Each person on board shall have one qualifying immersion-suit or thermal-protective-aid assignment."
    ] .

gen:QualifyingSurvivalEquipmentAssignmentShape
    a sh:NodeShape ;
    sh:class nltl:personalSurvivalEquipmentAssignment ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class nltl:personalSurvivalEquipment ;
        sh:node gen:PermittedPersonalSurvivalEquipmentShape
    ] .

gen:PermittedPersonalSurvivalEquipmentShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:class nltl:immersionSuitEquipment
        ]
        [
            sh:class nltl:thermalProtectiveAidEquipment
        ]
    ) .
