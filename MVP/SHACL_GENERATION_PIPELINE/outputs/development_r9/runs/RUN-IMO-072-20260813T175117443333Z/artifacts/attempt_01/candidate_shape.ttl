@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ExtendedDarknessLifeboatSearchlightShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false ) ;
                sh:message "Extended-darkness applicability must be explicitly false for this branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:extendedDarknessOperation ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true ) ;
                sh:message "Extended-darkness applicability must be explicitly true for this branch."
            ] ;
            sh:property [
                sh:path nltl:hasLifeboat ;
                sh:class nltl:lifeboat ;
                sh:node gen:ExtendedDarknessLifeboatShape ;
                sh:message "Each linked lifeboat must have an assigned searchlight approved for continuous use."
            ]
        ]
    ) .

gen:ExtendedDarknessLifeboatShape
    a sh:NodeShape ;
    sh:class nltl:lifeboat ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:qualifiedValueShape [
            sh:class nltl:searchlight ;
            sh:property [
                sh:path nltl:continuousUseSuitabilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "The lifeboat must have an assigned searchlight approved for continuous use."
    ] .
