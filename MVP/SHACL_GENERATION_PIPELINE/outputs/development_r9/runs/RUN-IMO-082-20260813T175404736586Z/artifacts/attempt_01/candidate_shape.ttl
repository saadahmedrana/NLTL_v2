@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO082ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:minCount 1 ;
        sh:message "The ship shall comply with SOLAS regulation V/22.1.9.4."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:bridgeConfigurationValue ;
        sh:minCount 1 ;
        sh:message "A bridge configuration type is required to determine the astern-view condition."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship with the astern-view-required bridge configuration shall have a compliant clear-view-astern status." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:bridgeConfigurationType
        nltl:asternViewRequiredBridgeConfiguration .
    FILTER (
        NOT EXISTS {
            $this nltl:clearViewAsternStatus ?status .
            FILTER (
                datatype(?status) = xsd:boolean &&
                ?status = true
            )
        }
        ||
        EXISTS {
            $this nltl:clearViewAsternStatus ?otherStatus .
            FILTER (
                datatype(?otherStatus) != xsd:boolean ||
                ?otherStatus != true
            )
        }
    )
}
"""
    ] .
