@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO097Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( false )
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInLowAirTemperature ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:releasedRescueBoatOrLifeboat ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:in ( true )
            ] ;
            sh:property [
                sh:path nltl:hasRequiredRescueBoatOrLifeboat ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:lifeboat ;
                sh:node [
                    sh:property [
                        sh:path nltl:hasDistressAlertDevice ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:class nltl:equipmentItem ;
                        sh:message "Each released rescue boat or lifeboat must carry at least one ship-to-shore distress-alert device."
                    ]
                ]
            ]
        ]
    ) .
