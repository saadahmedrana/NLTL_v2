@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO104ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCrewMember ;
        sh:node gen:IMO104CrewMemberShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A crew member with a duty-linked PWOM item must have a completed familiarization record." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this ?crew ?duty ?item
WHERE {
    $this nltl:hasCrewMember ?crew .
    ?crew nltl:hasAssignedDuty ?duty .
    ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
    FILTER NOT EXISTS {
        ?crew nltl:hasFamiliarizationRecord ?record .
        ?record nltl:polarWaterOperationalManualFamiliarizationStatus ?status .
        FILTER(
            datatype(?status) = xsd:boolean &&
            ?status = true
        )
    }
}
"""
    ] .

gen:IMO104CrewMemberShape
    a sh:NodeShape ;
    sh:class nltl:crewMember ;
    sh:property [
        sh:path nltl:hasAssignedDuty ;
        sh:node gen:IMO104AssignedDutyShape
    ] ;
    sh:property [
        sh:path nltl:hasFamiliarizationRecord ;
        sh:node gen:IMO104FamiliarizationRecordShape
    ] .

gen:IMO104AssignedDutyShape
    a sh:NodeShape ;
    sh:class nltl:assignedDuty ;
    sh:property [
        sh:path nltl:hasRelevantPolarWaterOperationalManualItem ;
        sh:node gen:IMO104PWOMItemShape
    ] .

gen:IMO104PWOMItemShape
    a sh:NodeShape ;
    sh:class nltl:polarWaterOperationalManualItem .

gen:IMO104FamiliarizationRecordShape
    a sh:NodeShape ;
    sh:class nltl:familiarizationRecord ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualFamiliarizationStatus ;
        sh:datatype xsd:boolean
    ] .
