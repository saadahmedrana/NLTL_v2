@prefix shape: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

shape:IMO106Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:dischargedMaterialClassification ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:dischargedMaterialTypeValue ;
        sh:message "Discharge material classification is required to determine whether the oil-discharge prohibition applies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For clean or segregated ballast, paragraph 1.1.1 oil-discharge prohibition applicability must be false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT DISTINCT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (
                    ?material IN (
                        nltl:cleanBallastMaterial,
                        nltl:segregatedBallastMaterial
                    )
                )
                OPTIONAL {
                    $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?applicable .
                }
                FILTER (
                    !BOUND(?applicable) ||
                    DATATYPE(?applicable) != xsd:boolean ||
                    ?applicable != false
                )
            }
        """
    ] .
