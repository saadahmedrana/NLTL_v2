@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO111Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path nltl:tankType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:individualTankCapacity ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M3
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:tankOuterShellSeparation ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "Category A or B ships require a construction date to determine applicability." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                FILTER NOT EXISTS {
                    $this nltl:constructionDate ?constructionDate .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Category A or B ships constructed on or after 1 January 2017 require tank type information." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate .
                FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                FILTER (
                    YEAR(?constructionDate) > 2017 ||
                    (
                        YEAR(?constructionDate) = 2017 &&
                        (
                            MONTH(?constructionDate) > 1 ||
                            (
                                MONTH(?constructionDate) = 1 &&
                                DAY(?constructionDate) >= 1
                            )
                        )
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:tankType ?tankType .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A regulated tank type requires its individual capacity in cubic metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:tankType ?tankType .
                FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                FILTER (
                    YEAR(?constructionDate) > 2017 ||
                    (
                        YEAR(?constructionDate) = 2017 &&
                        (
                            MONTH(?constructionDate) > 1 ||
                            (
                                MONTH(?constructionDate) = 1 &&
                                DAY(?constructionDate) >= 1
                            )
                        )
                    )
                )
                FILTER (
                    ?tankType IN (
                        "oil_residue_tank"^^xsd:string,
                        "oily_bilge_water_holding_tank"^^xsd:string
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:individualTankCapacity ?capacity .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A regulated tank exceeding 30 cubic metres must have an outer-shell separation of at least 0.76 metres." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:tankType ?tankType ;
                      nltl:individualTankCapacity ?capacity .
                ?capacity qudt:numericValue ?capacityValue ;
                          qudt:unit unit:M3 .
                FILTER (?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB))
                FILTER (
                    YEAR(?constructionDate) > 2017 ||
                    (
                        YEAR(?constructionDate) = 2017 &&
                        (
                            MONTH(?constructionDate) > 1 ||
                            (
                                MONTH(?constructionDate) = 1 &&
                                DAY(?constructionDate) >= 1
                            )
                        )
                    )
                )
                FILTER (
                    ?tankType IN (
                        "oil_residue_tank"^^xsd:string,
                        "oily_bilge_water_holding_tank"^^xsd:string
                    )
                )
                FILTER (?capacityValue > "30"^^xsd:decimal)
                FILTER (
                    NOT EXISTS {
                        $this nltl:tankOuterShellSeparation ?separation .
                    } ||
                    EXISTS {
                        $this nltl:tankOuterShellSeparation ?separation .
                        ?separation qudt:numericValue ?distance ;
                                    qudt:unit unit:M .
                        FILTER (?distance < "0.76"^^xsd:decimal)
                    }
                )
            }
        """
    ] .
