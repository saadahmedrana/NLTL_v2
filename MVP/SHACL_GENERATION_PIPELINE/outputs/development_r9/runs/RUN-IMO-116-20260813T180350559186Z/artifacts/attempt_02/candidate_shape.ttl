@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO116Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one sewage discharge type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:notComminutedOrDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one not-comminuted-or-disinfected applicability flag is required."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:sewageDischargeType ;
                sh:hasValue "not_comminuted_or_disinfected"^^xsd:string
            ] ;
            sh:property [
                sh:path nltl:notComminutedOrDisinfected ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "MARPOL Annex IV regulation 11.1.1 compliance must be true for this discharge."
            ] ;
            sh:property [
                sh:path nltl:distanceToNearestIceShelfOrFastIce ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minExclusive "12"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:message "Distance to the nearest ice shelf or fast ice must exceed 12 nautical miles."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:in ( unit:MI_N ) ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:nearbyIceConcentration ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minExclusive "1"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:message "Nearby ice concentration must exceed one tenth."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:in ( unit:UNITLESS ) ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:in ( unit:MI_N ) ;
                        sh:minCount 1
                    ]
                ] ;
                sh:message "Distance from an area with ice concentration above one tenth must be recorded."
            ]
        ]
        [
            sh:property [
                sh:path nltl:notComminutedOrDisinfected ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The discharge type and not-comminuted-or-disinfected flag are inconsistent." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:sewageDischargeType ?dischargeType ;
          nltl:notComminutedOrDisinfected ?flag .
    FILTER(
        (?dischargeType = "not_comminuted_or_disinfected"^^xsd:string && ?flag = false) ||
        (?dischargeType != "not_comminuted_or_disinfected"^^xsd:string && ?flag = true)
    )
}
"""
    ] .
