@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_009_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice-accretion applicability must be recorded as one boolean value."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasRequiredNavigationOrCommunicationAntenna ;
                sh:minCount 1 ;
                sh:class nltl:navigationOrCommunicationAntenna ;
                sh:node gen:IMO26_009_AntennaShape ;
                sh:message "When ice accretion is likely, required navigation or communication antennas and their ice-prevention state must be recorded."
            ]
        ]
    ) .

gen:IMO26_009_AntennaShape
    a sh:NodeShape ;
    sh:class nltl:navigationOrCommunicationAntenna ;
    sh:property [
        sh:path nltl:iceAccumulationPreventionMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Each required navigation or communication antenna must have ice-accumulation prevention means present."
    ] .
