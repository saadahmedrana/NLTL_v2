@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:CentiM2QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1
    ] .

gen:CentiM3QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
        sh:minCount 1
    ] .

gen:KiloNQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1
    ] .

gen:MetreQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1
    ] .

gen:MegaNMQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
        sh:minCount 1
    ] .

gen:MegaPAQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1
    ] .

gen:UnitlessQuantityShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1
    ] .

gen:WebFrameCalculationShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:node gen:CentiM2QuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:node gen:CentiM2QuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:node gen:CentiM2QuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:node gen:KiloNQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:node gen:MetreQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:node gen:MegaNMQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node gen:CentiM2QuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node gen:MegaPAQuantityShape ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node gen:CentiM3QuantityShape ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "The reported bending moment or actual cross-sectional area does not match the required formula." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:webFrameIceLoad ?loadQuantity ;
          nltl:webFrameSpan ?spanQuantity ;
          nltl:webFrameMaximumIceLoadBendingMoment ?momentQuantity ;
          nltl:webFrameFreeFlangeArea ?flangeQuantity ;
          nltl:webFrameWebArea ?webQuantity ;
          nltl:actualWebFrameCrossSectionalArea ?actualAreaQuantity .

    ?loadQuantity qudt:numericValue ?loadRaw .
    ?spanQuantity qudt:numericValue ?spanRaw .
    ?momentQuantity qudt:numericValue ?momentRaw .
    ?flangeQuantity qudt:numericValue ?flangeRaw .
    ?webQuantity qudt:numericValue ?webRaw .
    ?actualAreaQuantity qudt:numericValue ?actualAreaRaw .

    BIND(xsd:decimal(?loadRaw) AS ?loadKN)
    BIND(xsd:decimal(?spanRaw) AS ?spanM)
    BIND(xsd:decimal(?momentRaw) AS ?momentMNm)
    BIND(xsd:decimal(?flangeRaw) AS ?flangeCM2)
    BIND(xsd:decimal(?webRaw) AS ?webCM2)
    BIND(xsd:decimal(?actualAreaRaw) AS ?actualAreaCM2)

    BIND(0.193 * (?loadKN / 1000) * ?spanM AS ?expectedMomentMNm)
    BIND(?flangeCM2 + ?webCM2 AS ?expectedActualAreaCM2)

    BIND(
        IF(
            ABS(?expectedMomentMNm) > 0.000000000001,
            ABS(?expectedMomentMNm) * 0.000001,
            0.000000000001
        ) AS ?momentTolerance
    )
    BIND(
        IF(
            ABS(?expectedActualAreaCM2) > 0.000000000001,
            ABS(?expectedActualAreaCM2) * 0.000001,
            0.000000000001
        ) AS ?areaTolerance
    )

    FILTER(
        ABS(?momentMNm - ?expectedMomentMNm) > ?momentTolerance ||
        ABS(?actualAreaCM2 - ?expectedActualAreaCM2) > ?areaTolerance
    )
}
"""
    ] .

gen:WebFrameGammaLookupCaseShape a sh:NodeShape ;
    sh:targetSubjectsOf nltl:webFrameTable4Dash8GammaFactor ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:webFrameTable4Dash8GammaFactor ;
        sh:node gen:UnitlessQuantityShape
    ] .
