@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gs:TRF064Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:class nltl:detachedStrutStructure
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:class nltl:sidePropellerShaftingAssembly
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:class nltl:sternTube
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:minCount 1 ;
                sh:class nltl:detachedStrutStructure
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasSidePropellerShafting ;
                sh:node [
                    sh:property [
                        sh:path nltl:enclosedByPlatedBossing ;
                        sh:minCount 1 ;
                        sh:class nltl:platedBossingStructure ;
                        sh:message "Side propeller shafting shall be enclosed within a plated bossing."
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasSternTube ;
                sh:node [
                    sh:property [
                        sh:path nltl:enclosedByPlatedBossing ;
                        sh:minCount 1 ;
                        sh:class nltl:platedBossingStructure ;
                        sh:message "A stern tube associated with the normal arrangement shall be enclosed within a plated bossing."
                    ]
                ]
            ]
        ]
    ) .
