@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF069ApplicabilityReadinessShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Ice class is required to determine whether the propulsion-machinery rule applies."
    ] ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Propeller type is required to determine whether the propulsion-machinery rule applies."
    ] ;
    sh:property [
        sh:path nltl:pitchType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Pitch type is required to determine whether the propulsion-machinery rule applies."
    ] .
