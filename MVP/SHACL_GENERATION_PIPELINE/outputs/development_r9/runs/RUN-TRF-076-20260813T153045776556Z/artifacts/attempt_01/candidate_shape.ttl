@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:PropellerBladeLoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:propellerBladeLoadCase ;
    sh:property [
        sh:path nltl:propellerBladeLoadCaseNumber ;
        sh:datatype xsd:integer
    ] .

gen:PropellerBladeLoadCaseCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propellerType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "Propeller type is required to determine load-case applicability."
    ] ;
    sh:property [
        sh:path nltl:propellerReversingCapability ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:hasPropellerBladeLoadCase ;
        sh:node gen:PropellerBladeLoadCaseShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "CP and FP propellers must cover propeller blade load cases 1 through 4." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propellerType ?type .
    FILTER(STR(?type) IN ("CP", "FP"))
    FILTER NOT EXISTS {
        $this nltl:hasPropellerBladeLoadCase ?case1 .
        ?case1 a nltl:propellerBladeLoadCase ;
               nltl:propellerBladeLoadCaseNumber ?number1 .
        FILTER(DATATYPE(?number1) = xsd:integer && ?number1 = 1)

        $this nltl:hasPropellerBladeLoadCase ?case2 .
        ?case2 a nltl:propellerBladeLoadCase ;
               nltl:propellerBladeLoadCaseNumber ?number2 .
        FILTER(DATATYPE(?number2) = xsd:integer && ?number2 = 2)

        $this nltl:hasPropellerBladeLoadCase ?case3 .
        ?case3 a nltl:propellerBladeLoadCase ;
               nltl:propellerBladeLoadCaseNumber ?number3 .
        FILTER(DATATYPE(?number3) = xsd:integer && ?number3 = 3)

        $this nltl:hasPropellerBladeLoadCase ?case4 .
        ?case4 a nltl:propellerBladeLoadCase ;
               nltl:propellerBladeLoadCaseNumber ?number4 .
        FILTER(DATATYPE(?number4) = xsd:integer && ?number4 = 4)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "FP propellers require a reversing-capability value to determine whether load case 5 applies." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propellerType ?type .
    FILTER(STR(?type) = "FP")
    FILTER NOT EXISTS {
        $this nltl:propellerReversingCapability ?reversing .
        FILTER(DATATYPE(?reversing) = xsd:boolean)
    }
}
"""
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A reversing FP propeller must also cover propeller blade load case 5." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:propellerType ?type ;
          nltl:propellerReversingCapability ?reversing .
    FILTER(STR(?type) = "FP")
    FILTER(DATATYPE(?reversing) = xsd:boolean && ?reversing = true)
    FILTER NOT EXISTS {
        $this nltl:hasPropellerBladeLoadCase ?case5 .
        ?case5 a nltl:propellerBladeLoadCase ;
               nltl:propellerBladeLoadCaseNumber ?number5 .
        FILTER(DATATYPE(?number5) = xsd:integer && ?number5 = 5)
    }
}
"""
    ] .
