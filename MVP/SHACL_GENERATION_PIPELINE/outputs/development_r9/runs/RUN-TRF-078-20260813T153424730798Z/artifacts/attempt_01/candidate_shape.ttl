@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF078LoadCycleShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one integer ice load cycle count is required."
    ] ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Exactly one integer class load cycle count is required."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:message "Coefficient k1 must be one unitless decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:message "Coefficient k2 must be one unitless decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:message "Coefficient k3 must be one unitless decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:UnitlessDecimalQuantityShape ;
        sh:message "The propeller blade load spectrum count factor must be one unitless decimal quantity."
    ] ;
    sh:sparql [
        sh:message "The ice load cycle count must equal k1 times k2 times k3 times the class load cycle count times the load spectrum count factor, within a relative tolerance of 1e-6 and an absolute fallback of 1e-12." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:classLoadCycleCount ?nclass ;
                      nltl:iceLoadCycleCoefficientK1 ?k1Quantity ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Quantity ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Quantity ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnQuantity .
                ?k1Quantity qudt:numericValue ?k1 .
                ?k2Quantity qudt:numericValue ?k2 .
                ?k3Quantity qudt:numericValue ?k3 .
                ?nnQuantity qudt:numericValue ?nn .
                BIND(
                    xsd:decimal(?k1) * xsd:decimal(?k2) *
                    xsd:decimal(?k3) * xsd:decimal(?nclass) *
                    xsd:decimal(?nn)
                    AS ?expected
                )
                BIND(
                    IF(
                        ABS(?expected) * 0.000001 > 0.000000000001,
                        ABS(?expected) * 0.000001,
                        0.000000000001
                    )
                    AS ?tolerance
                )
                FILTER(ABS(xsd:decimal(?nice) - ?expected) > ?tolerance)
            }
        """
    ] .

gen:UnitlessDecimalQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
