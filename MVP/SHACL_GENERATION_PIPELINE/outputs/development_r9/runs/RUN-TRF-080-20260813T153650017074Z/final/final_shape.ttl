@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF080Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:propellerIceInteractionComponent
                ] ;
                sh:qualifiedMinCount 1
            ] ;
            sh:property [
                sh:path nltl:iceLoadCycleCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable ship must provide exactly one integer ice-load cycle count."
            ] ;
            sh:property [
                sh:path nltl:propellerBladeCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "An applicable ship must provide exactly one integer propeller-blade count."
            ] ;
            sh:property [
                sh:path nltl:effectiveIceLoadCycleCount ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:nodeKind sh:IRI ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:message "An applicable ship must provide exactly one decimal effective cycle count in unitless units."
            ]
        ]
        [
            sh:property [
                sh:path nltl:hasComponent ;
                sh:qualifiedValueShape [
                    sh:class nltl:propellerIceInteractionComponent
                ] ;
                sh:qualifiedMaxCount 0
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "The effective ice-load cycle count must equal the ice-load cycle count multiplied by the propeller-blade count, within relative tolerance 1e-6 and absolute fallback 1e-12." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?component ;
          nltl:iceLoadCycleCount ?nice ;
          nltl:propellerBladeCount ?bladeCount ;
          nltl:effectiveIceLoadCycleCount ?effectiveQuantity .
    ?component a nltl:propellerIceInteractionComponent .
    ?effectiveQuantity qudt:numericValue ?reported .
    BIND(xsd:decimal(?nice) * xsd:decimal(?bladeCount) AS ?expected)
    BIND(
        IF(
            ABS(?expected) * 0.000001 > 0.000000000001,
            ABS(?expected) * 0.000001,
            0.000000000001
        ) AS ?tolerance
    )
    FILTER(ABS(xsd:decimal(?reported) - ?expected) > ?tolerance)
}
"""
    ] .
