@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

gen:TRF091Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:hasValue nltl:propulsionLineStrengthEvaluationPurpose
            ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "At least one propulsion load case must use the ice-milling load sequence for propulsion-line strength evaluation."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:hasValue nltl:stallingAnalysisPurposeValue
            ]
        ] ;
        sh:qualifiedMaxCount 0 ;
        sh:message "The ice-milling propulsion load sequence must not be designated for stalling analysis."
    ] .
