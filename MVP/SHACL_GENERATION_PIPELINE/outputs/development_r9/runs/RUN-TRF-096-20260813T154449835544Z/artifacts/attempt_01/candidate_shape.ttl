@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:EngineSpeedDropQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:REV-PER-MIN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:MaximumTorqueDuringSpeedDropQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:SpeedDropLoadAssessmentShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:engineStandstillReached ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether engine standstill was reached must be recorded unambiguously."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:engineStandstillReached ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:engineStandstillReached ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:engineSpeedDrop ;
                sh:node gen:EngineSpeedDropQuantityShape ;
                sh:minCount 1 ;
                sh:message "A speed drop reaching engine standstill requires a speed-drop quantity in revolutions per minute."
            ] ;
            sh:property [
                sh:path nltl:maximumTorqueDuringSpeedDrop ;
                sh:node gen:MaximumTorqueDuringSpeedDropQuantityShape ;
                sh:minCount 1 ;
                sh:message "The maximum value occurring during the speed-drop process must be recorded in the required unit."
            ] ;
            sh:property [
                sh:path nltl:maximumTorqueUsedForLoadAssessment ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:maxCount 1 ;
                sh:message "The maximum value occurring during the speed drop must be used for load assessment."
            ]
        ]
    ) .
