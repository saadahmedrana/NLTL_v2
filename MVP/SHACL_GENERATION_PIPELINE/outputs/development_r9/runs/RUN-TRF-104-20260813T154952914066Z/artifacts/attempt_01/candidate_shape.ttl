@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF104PropulsionLineStrengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:class nltl:propellerShaftLineComponent ;
        sh:node gs:TRF104ShaftLineComponentShape ;
        sh:message "Each propeller shaft line component must demonstrate that propeller blade loss causes no significant damage."
    ] .

gs:TRF104ShaftLineComponentShape
    a sh:NodeShape ;
    sh:class nltl:propellerShaftLineComponent ;
    sh:property [
        sh:path nltl:significantDamageFromBladeLoss ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:in ( false ) ;
        sh:message "Significant damage from propeller blade loss must be false."
    ] .
