@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:StressLifeCurveSelectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:stressLifeCurveType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "A known stress-life curve type must be recorded."
            ] ;
            sh:property [
                sh:path nltl:propellerBladeMaterialProperty ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "The propeller blade material property must be recorded for stress-life curve selection."
            ] ;
            sh:property [
                sh:path nltl:stressLifeCurveSelectionCorrespondenceEvidence ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Evidence that the selected stress-life curve corresponds with the blade material properties is required."
            ]
        ]
        [
            sh:property [
                sh:path nltl:stressLifeCurveType ;
                sh:maxCount 0
            ] ;
            sh:property [
                sh:path nltl:twoSlopeSnCurveUsed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When the stress-life curve type is unknown, use of the two-slope SN curve must be recorded as true."
            ]
        ]
    ) .
