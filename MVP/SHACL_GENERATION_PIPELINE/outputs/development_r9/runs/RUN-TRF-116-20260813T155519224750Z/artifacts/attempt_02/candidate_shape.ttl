@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:TRF116Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:nonHemisphericalImpactContactArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:designIceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive 0 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "designIceThickness must equal sqrt(nonHemisphericalImpactContactArea / pi) within relative tolerance 1e-6, with an absolute fallback of 1e-12 m near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:nonHemisphericalImpactContactArea ?areaQuantity ;
                      nltl:designIceThickness ?thicknessQuantity .
                ?areaQuantity qudt:numericValue ?area .
                ?thicknessQuantity qudt:numericValue ?reportedThickness .
                BIND(
                    ?area / "3.141592653589793"^^xsd:decimal
                    AS ?expectedThicknessSquared
                )
                FILTER(
                    (
                        ?expectedThicknessSquared > "0.000000000001"^^xsd:decimal
                        &&
                        (
                            (?reportedThickness * ?reportedThickness)
                                < (?expectedThicknessSquared * "0.999998000001"^^xsd:decimal)
                            ||
                            (?reportedThickness * ?reportedThickness)
                                > (?expectedThicknessSquared * "1.000002000001"^^xsd:decimal)
                        )
                    )
                    ||
                    (
                        ?expectedThicknessSquared <= "0.000000000001"^^xsd:decimal
                        &&
                        ?reportedThickness > "0.000000000001"^^xsd:decimal
                        &&
                        (
                            (?reportedThickness - "0.000000000001"^^xsd:decimal)
                            *
                            (?reportedThickness - "0.000000000001"^^xsd:decimal)
                        ) > ?expectedThicknessSquared
                    )
                )
            }
        """
    ] .
