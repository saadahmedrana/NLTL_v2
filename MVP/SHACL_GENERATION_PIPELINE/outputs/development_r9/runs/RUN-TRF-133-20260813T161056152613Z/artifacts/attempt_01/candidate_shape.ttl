@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF133ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "An ice class is required to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:node gen:TRF133WarningTriangleMarkingShape ;
        sh:minCount 1 ;
        sh:message "A conforming warning triangle marking is required."
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node gen:TRF133IceClassDraughtMarkingShape ;
        sh:minCount 1 ;
        sh:message "A conforming ice class draught marking is required."
    ] .

gen:TRF133WarningTriangleMarkingShape
    a sh:NodeShape ;
    sh:class nltl:warningTriangleMarking ;
    sh:node gen:TRF133CommonMarkingShape ;
    sh:property [
        sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "1000"^^xsd:decimal ;
                sh:maxInclusive "1000"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The warning triangle must be 1,000 mm above the Summer Load Line in fresh water."
    ] ;
    sh:property [
        sh:path nltl:markingAtOrBelowDeckLine ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The warning triangle must not be higher than the deck line."
    ] ;
    sh:property [
        sh:path nltl:warningTriangleSideLength ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "300"^^xsd:decimal ;
                sh:maxInclusive "300"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1
            ]
        ] ;
        sh:message "Each warning triangle side must be 300 mm long."
    ] .

gen:TRF133IceClassDraughtMarkingShape
    a sh:NodeShape ;
    sh:class nltl:iceClassDraughtMarking ;
    sh:node gen:TRF133CommonMarkingShape ;
    sh:property [
        sh:path nltl:draughtMarkAftOffset ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "540"^^xsd:decimal ;
                sh:maxInclusive "540"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The ice class draught mark must have an aft offset of 540 mm."
    ] ;
    sh:property [
        sh:path nltl:letterDimensionsEqualLoadLineMark ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Letter dimensions must equal those used in the load line mark."
    ] .

gen:TRF133CommonMarkingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:markingPlateThickness ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minInclusive "5"^^xsd:decimal ;
                sh:maxInclusive "8"^^xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:MilliM ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The marking plate thickness must be between 5 mm and 8 mm."
    ] ;
    sh:property [
        sh:path nltl:markingWeldedToShipSide ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The marking must be welded to the ship side."
    ] ;
    sh:property [
        sh:path nltl:reflectingMarkingColour ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:redReflectingMarkingColour
            nltl:yellowReflectingMarkingColour
        ) ;
        sh:minCount 1 ;
        sh:message "The marking must have a red or yellow reflecting colour."
    ] ;
    sh:property [
        sh:path nltl:markingPlainlyVisibleInIceConditions ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "The marking must be plainly visible in ice conditions."
    ] .
