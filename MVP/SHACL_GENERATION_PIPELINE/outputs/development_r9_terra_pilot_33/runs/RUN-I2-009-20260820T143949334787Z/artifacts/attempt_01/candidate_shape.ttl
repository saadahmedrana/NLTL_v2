@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:OtherIceStrengthenedAreaParametersShape>
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT DISTINCT ?this
            WHERE {
                ?this nltl:hasHullAreaAssignment ?assignment .
                ?assignment nltl:assignedHullArea nltl:otherIceStrengthenedArea .
            }
        """
    ] ;
    sh:property [
        sh:path nltl:averageIcePressure ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:AverageIcePressureValueShape> ;
        sh:message "An average ice pressure value is required for an other ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchLength ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:NonBowLoadPatchLengthValueShape> ;
        sh:message "A non-bow load patch length is required for an other ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:nonBowLoadPatchHeight ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:NonBowLoadPatchHeightValueShape> ;
        sh:message "A non-bow load patch height is required for an other ice-strengthened area."
    ] ;
    sh:property [
        sh:path nltl:loadPatchAspectRatio ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:FixedLoadPatchAspectRatioShape> ;
        sh:message "The load patch aspect ratio for an other ice-strengthened area shall be 3.6."
    ] .

<urn:nltl:generated-shape:AverageIcePressureValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA>
    ] .

<urn:nltl:generated-shape:NonBowLoadPatchLengthValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:NonBowLoadPatchHeightValueShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:generated-shape:FixedLoadPatchAspectRatioShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 3.6 ;
        sh:maxInclusive 3.6
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

<urn:nltl:generated-shape:BowFormApplicabilityShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:bowFormApplicability ;
    sh:or (
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:bowFormApplicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:buttockAngle ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:QualifyingButtockAngleShape> ;
                sh:message "A bow-form applicability assertion requires a positive buttock angle below 80 deg."
            ] ;
            sh:property [
                sh:path nltl:normalFrameAngle ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:QualifyingNormalFrameAngleShape> ;
                sh:message "A bow-form applicability assertion requires a normal frame angle greater than 10 deg."
            ]
        ]
    ) .

<urn:nltl:generated-shape:QualifyingButtockAngleShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:maxExclusive 80
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .

<urn:nltl:generated-shape:QualifyingNormalFrameAngleShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 10
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG>
    ] .
