@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-030ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:class nltl:calculationCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:I2-030CalculationCaseShape>
    ] .

<urn:nltl:generated-shape:I2-030StructuralMemberShape>
    a sh:NodeShape ;
    sh:targetClass nltl:structuralMember ;
    sh:property [
        sh:path nltl:hasLocalFrameSectionCalculationCase ;
        sh:class nltl:localFrameSectionCalculationCase ;
        sh:node <urn:nltl:generated-shape:I2-030LocalFrameCaseShape>
    ] ;
    sh:property [
        sh:path nltl:netLocalFrameFlangeArea ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netAttachedShellPlateThickness ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:frameSpacing ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netWebThickness ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:localFrameFlangeCentreHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webAngleToShellPlate ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:webToFlangeCentreDistance ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:netEffectivePlasticSectionModulus ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

<urn:nltl:generated-shape:I2-030PlatingShape>
    a sh:NodeShape ;
    sh:targetClass nltl:plating ;
    sh:property [
        sh:path nltl:framingAngleOmega ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

<urn:nltl:generated-shape:I2-030CalculationCaseShape>
    a sh:NodeShape ;
    sh:targetClass nltl:calculationCase ;
    sh:property [
        sh:path nltl:plasticNeutralAxisHeight ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

<urn:nltl:generated-shape:I2-030LocalFrameCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:sectionCalculationCaseStructuralMember ;
        sh:class nltl:structuralMember ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path nltl:netLocalFrameFlangeArea ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:netAttachedShellPlateThickness ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:frameSpacing ;
                sh:minCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:sectionCalculationCasePlating ;
        sh:class nltl:plating ;
        sh:minCount 1
    ] ;
    sh:sparql [
        sh:message "Where the local-frame area exceeds the attached-plate-flange area, the required calculation inputs and externally calculated results must be present on their declared owners." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCaseStructuralMember ?member ;
                      nltl:sectionCalculationCasePlating ?plating .

                ?member nltl:netLocalFrameFlangeArea ?areaQ ;
                        nltl:netAttachedShellPlateThickness ?plateThicknessQ ;
                        nltl:frameSpacing ?spacingQ .
                ?areaQ qudt:numericValue ?area ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM2> .
                ?plateThicknessQ qudt:numericValue ?plateThickness ;
                                 qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                ?spacingQ qudt:numericValue ?spacing ;
                          qudt:unit <http://qudt.org/vocab/unit/M> .

                FILTER (100 * ?area > 1000 * ?plateThickness * ?spacing)

                FILTER NOT EXISTS {
                    ?member nltl:webHeight ?webHeightQ ;
                            nltl:netWebThickness ?webThicknessQ ;
                            nltl:localFrameFlangeCentreHeight ?flangeHeightQ ;
                            nltl:webAngleToShellPlate ?webAngleQ ;
                            nltl:webToFlangeCentreDistance ?webDistanceQ ;
                            nltl:netEffectivePlasticSectionModulus ?sectionModulusQ .

                    ?webHeightQ qudt:numericValue ?webHeight ;
                                qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?webThicknessQ qudt:numericValue ?webThickness ;
                                   qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?flangeHeightQ qudt:numericValue ?flangeHeight ;
                                   qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?webAngleQ qudt:numericValue ?webAngle ;
                               qudt:unit <http://qudt.org/vocab/unit/DEG> .
                    ?webDistanceQ qudt:numericValue ?webDistance ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                    ?sectionModulusQ qudt:numericValue ?sectionModulus ;
                                     qudt:unit <http://qudt.org/vocab/unit/CentiM3> .

                    $this nltl:plasticNeutralAxisHeight ?neutralAxisQ .
                    ?neutralAxisQ qudt:numericValue ?neutralAxis ;
                                  qudt:unit <http://qudt.org/vocab/unit/MilliM> .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "For oblique framing with 20 degrees < omega < 70 degrees, linear-interpolation endpoint coordinates and results must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sectionCalculationCasePlating ?plating .
                ?plating nltl:framingAngleOmega ?omegaQ .
                ?omegaQ qudt:numericValue ?omega ;
                        qudt:unit <http://qudt.org/vocab/unit/DEG> .

                FILTER (?omega > 20 && ?omega < 70)

                FILTER NOT EXISTS {
                    $this nltl:interpolationLowerEndpoint ?lower ;
                          nltl:interpolationUpperEndpoint ?upper .

                    ?lower nltl:interpolationPointCoordinate ?lowerCoordinateQ ;
                           nltl:interpolationPointResult ?lowerResultQ .
                    ?upper nltl:interpolationPointCoordinate ?upperCoordinateQ ;
                           nltl:interpolationPointResult ?upperResultQ .

                    ?lowerCoordinateQ qudt:numericValue ?lowerCoordinate ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?upperCoordinateQ qudt:numericValue ?upperCoordinate ;
                                      qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                    ?lowerResultQ qudt:numericValue ?lowerResult .
                    ?upperResultQ qudt:numericValue ?upperResult .
                }
            }
        """
    ] .
