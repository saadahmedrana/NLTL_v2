@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:I2_060ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:memberInstability ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:structuralStiffening ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:property [
                sh:path nltl:stiffeningNecessary ;
                sh:datatype xsd:boolean
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A ship with a structural member having a cutout must record that member instability is false." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                FILTER NOT EXISTS {
                    $this nltl:memberInstability ?instability .
                    FILTER (?instability = false)
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A ship with a structural member having a cutout must not record member instability as true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout .
                $this nltl:memberInstability ?instability .
                FILTER (?instability = true)
            }
        """
    ] ;
    sh:sparql [
        sh:message "Structural stiffening must be recorded where stiffening is necessary for a member having a cutout." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:hasCutout ?cutout ;
                        nltl:stiffeningNecessary ?necessary .
                FILTER (?necessary = true)
                FILTER NOT EXISTS {
                    $this nltl:structuralStiffening ?stiffening .
                }
            }
        """
    ] .
