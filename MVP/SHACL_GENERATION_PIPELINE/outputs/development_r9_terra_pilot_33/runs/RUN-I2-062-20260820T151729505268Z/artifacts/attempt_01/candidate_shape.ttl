@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-062DirectCalculationShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node [
            sh:class nltl:structuralMember ;
            sh:property [
                sh:path nltl:partOfGrillageSystem ;
                sh:class nltl:grillageSystem
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "A direct calculation must be recorded as used when a load carrying stringer or web frame forms part of a grillage system." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType ;
                    nltl:partOfGrillageSystem ?grillage .
                ?grillage a nltl:grillageSystem .
                FILTER (?memberType IN (nltl:loadCarryingStringer, nltl:webFrame))
                FILTER NOT EXISTS {
                    $this nltl:directCalculationUsed ?used .
                    FILTER (datatype(?used) = xsd:boolean && ?used = true)
                }
            }
        """
    ] .
