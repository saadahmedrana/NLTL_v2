@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-021-OperationalAssessmentCoverageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:operationalAssessmentPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "An operational assessment shall exist."
    ] ;
    sh:property [
        sh:path nltl:assessedLowAirTemperature ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG_C ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The operational assessment shall cover low-air-temperature operation."
    ] ;
    sh:property [
        sh:path nltl:assessedIceOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover ice operation."
    ] ;
    sh:property [
        sh:path nltl:assessedHighLatitude ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover high-latitude operation."
    ] ;
    sh:property [
        sh:path nltl:assessedAbandonment ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover abandonment onto ice or land."
    ] ;
    sh:property [
        sh:path nltl:assessedCodeHazards ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover applicable Introduction section 3 hazards."
    ] ;
    sh:property [
        sh:path nltl:assessedAdditionalHazards ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The operational assessment shall cover identified additional hazards."
    ] .
