@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-034-IceAccretionMeansShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceAccretionLikely ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-accretion likelihood must be recorded to establish applicability."
    ] ;
    sh:property [
        sh:path nltl:iceAccretionMinimizationDesignPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:requiredIceRemovalMeansPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:administrationRequiredIceRemovalMeans ;
        sh:datatype xsd:string
    ] ;
    sh:sparql [
        sh:message "Where ice accretion is likely, ice-accretion minimization design, required ice-removal means, and Administration-required ice-removal means must be recorded." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceAccretionLikely true .
                FILTER (
                    !EXISTS {
                        $this nltl:iceAccretionMinimizationDesignPresent true .
                    }
                    ||
                    !EXISTS {
                        $this nltl:requiredIceRemovalMeansPresent true .
                    }
                    ||
                    !EXISTS {
                        $this nltl:administrationRequiredIceRemovalMeans ?means .
                        FILTER (datatype(?means) = xsd:string)
                    }
                )
            }
        """
    ] .
