@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:generated-shape:IMO057FirePumpCompartmentTemperatureShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        sh:message "Each fire pump must be assigned to a containing compartment." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump rdf:type ?pumpType .
                FILTER(?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?pump nltl:hasContainingCompartment ?compartment .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Each fire pump compartment must have a maintained temperature above 0 deg C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump rdf:type ?pumpType ;
                    nltl:hasContainingCompartment ?compartment .
                FILTER(?pumpType IN (
                    nltl:firePump,
                    nltl:emergencyFirePump,
                    nltl:waterMistPump,
                    nltl:waterSprayPump
                ))
                FILTER NOT EXISTS {
                    ?compartment rdf:type nltl:compartment ;
                        nltl:maintainedTemperature ?temperatureValue .
                    ?temperatureValue qudt:numericValue ?temperature ;
                        qudt:unit unit:DEG_C .
                    FILTER(
                        datatype(?temperature) = xsd:decimal &&
                        ?temperature > "0"^^xsd:decimal
                    )
                }
            }
        """
    ] .
