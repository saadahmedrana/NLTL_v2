@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-017Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Dash1Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:voyagePlanPresent ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:intendedVoyageHazard ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path nltl:voyagePlanCoverage ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        sh:message "When Polar Code chapter 11-1 applies, a voyage plan must be recorded as present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter11Dash1Applicable true .
                FILTER NOT EXISTS {
                    $this nltl:voyagePlanPresent true .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "When Polar Code chapter 11-1 applies, intended voyage hazards must be covered by the voyage plan." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter11Dash1Applicable true ;
                      nltl:intendedVoyageHazard ?hazard .
                FILTER NOT EXISTS {
                    $this nltl:voyagePlanCoverage true .
                }
            }
        """
    ] .
