@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-029DirectAnalysisShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Record whether direct analysis is used."
    ] ;
    sh:property [
        sh:path nltl:prescribedProcedureApplicability ;
        sh:datatype xsd:boolean
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:directAnalysisApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Direct analysis may be used only when its substitution has been approved."
            ] ;
            sh:property [
                sh:path nltl:structuralArrangement ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Identify the structural arrangement or detail for which direct analysis is used."
            ]
        ]
    ) .
