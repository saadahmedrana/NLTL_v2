@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gen: <urn:nltl:generated-shape:> .

gen:TRF029DirectAnalysisShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:directAnalysisUsed ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:directAnalysisApprovalStatus ;
        sh:maxCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:prescribedProcedureApplicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:message "Direct analysis requires prescribed procedures to be inapplicable."
            ] ;
            sh:property [
                sh:path nltl:directAnalysisApprovalStatus ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "Direct analysis requires approved determination."
            ] ;
            sh:property [
                sh:path nltl:structuralArrangement ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Direct analysis requires the relevant structural arrangement."
            ]
        ]
        [
            sh:property [
                sh:path nltl:directAnalysisUsed ;
                sh:hasValue false
            ]
        ]
    ) .
