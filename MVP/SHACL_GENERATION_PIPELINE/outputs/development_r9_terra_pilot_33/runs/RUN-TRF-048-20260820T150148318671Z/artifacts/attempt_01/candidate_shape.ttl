@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:LengthQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:PressureQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:UnitlessQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:ShearFactorQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 2.16 ;
        sh:maxInclusive 2.16
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:AreaQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:SectionModulusQuantityShape>
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF048LongitudinalFrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;

    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:LengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:PressureQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:ShearFactorQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:UnitlessQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:SectionModulusQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:generated-shape:AreaQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive 13.3 ;
                        sh:maxInclusive 13.3
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive 13.3
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:hasFrameBoundaryConditionEvidence ;
                sh:minCount 1 ;
                sh:class nltl:frameBoundaryConditionEvidence ;
                sh:message "Evidence is required when significantly different boundary conditions require a smaller moment factor."
            ]
        ]
    ) ;

    sh:sparql [
        sh:message "The f4 factor, section modulus, or actual frame shear area does not conform to the required calculation."
        ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#designIceLoadHeight> ?hQ ;
                      <https://w3id.org/nltl/vocab#spacing> ?sQ ;
                      <https://w3id.org/nltl/vocab#span> ?lQ ;
                      <https://w3id.org/nltl/vocab#icePressure> ?pQ ;
                      <https://w3id.org/nltl/vocab#yieldStrength> ?syQ ;
                      <https://w3id.org/nltl/vocab#longitudinalFrameLoadDistributionFactorF4> ?f4Q ;
                      <https://w3id.org/nltl/vocab#longitudinalFrameShearFactorF5> ?f5Q ;
                      <https://w3id.org/nltl/vocab#frameMomentFactorM> ?mQ ;
                      <https://w3id.org/nltl/vocab#sectionModulus> ?zQ ;
                      <https://w3id.org/nltl/vocab#actualFrameShearArea> ?aQ .

                ?hQ <http://qudt.org/schema/qudt/numericValue> ?h .
                ?sQ <http://qudt.org/schema/qudt/numericValue> ?s .
                ?lQ <http://qudt.org/schema/qudt/numericValue> ?l .
                ?pQ <http://qudt.org/schema/qudt/numericValue> ?p .
                ?syQ <http://qudt.org/schema/qudt/numericValue> ?sy .
                ?f4Q <http://qudt.org/schema/qudt/numericValue> ?f4 .
                ?f5Q <http://qudt.org/schema/qudt/numericValue> ?f5 .
                ?mQ <http://qudt.org/schema/qudt/numericValue> ?m .
                ?zQ <http://qudt.org/schema/qudt/numericValue> ?z .
                ?aQ <http://qudt.org/schema/qudt/numericValue> ?a .

                BIND((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND((?f4 * ?p * ?h * ?l * ?l / (4 * ?m * ?sy) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * ?f4 * ?f5 * ?p * ?h * ?l / (2 * ?sy) * 10000) AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) > ((0.000001 * ABS(?expectedF4)) + 0.000000001) ||
                    ABS(?z - ?expectedZ) > ((0.000001 * ABS(?expectedZ)) + 0.000000001) ||
                    ABS(?a - ?expectedA) > ((0.000001 * ABS(?expectedA)) + 0.000000001)
                )
            }
        """
    ] .
