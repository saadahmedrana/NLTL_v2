@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:LengthQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositiveLengthQuantity a sh:NodeShape ;
    sh:node gs:LengthQuantity ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minExclusive 0
    ] .

gs:AreaQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM2 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:SectionModulusQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:CentiM3 ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PressureQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:MegaPA ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositivePressureQuantity a sh:NodeShape ;
    sh:node gs:PressureQuantity ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minExclusive 0
    ] .

gs:UnitlessQuantity a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gs:PositiveUnitlessQuantity a sh:NodeShape ;
    sh:node gs:UnitlessQuantity ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minExclusive 0
    ] .

gs:Factor133Quantity a sh:NodeShape ;
    sh:node gs:PositiveUnitlessQuantity ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minInclusive 13.3 ;
        sh:maxInclusive 13.3
    ] .

gs:SmallerThan133Quantity a sh:NodeShape ;
    sh:node gs:PositiveUnitlessQuantity ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:maxExclusive 13.3
    ] .

gs:F5Quantity a sh:NodeShape ;
    sh:node gs:UnitlessQuantity ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minInclusive 2.16 ;
        sh:maxInclusive 2.16
    ] .

gs:TRF048LongitudinalFrameShape a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositiveLengthQuantity
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositiveLengthQuantity
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:LengthQuantity
    ] ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PressureQuantity
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositivePressureQuantity
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:PositiveUnitlessQuantity
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:UnitlessQuantity
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:F5Quantity
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:SectionModulusQuantity
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaQuantity
    ] ;
    sh:property [
        sh:path nltl:grossFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaQuantity
    ] ;
    sh:property [
        sh:path nltl:bracketArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gs:AreaQuantity
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:node gs:Factor133Quantity
            ]
        ]
        [
            sh:property [
                sh:path nltl:significantlyDifferentBoundaryConditions ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:frameMomentFactorM ;
                sh:node gs:SmallerThan133Quantity
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "f4, section modulus, effective shear area, and actual frame shear area must satisfy the required frame calculations and bracket-area exclusion." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceLoadHeight ?hQ ;
                      nltl:spacing ?sQ ;
                      nltl:span ?lQ ;
                      nltl:icePressure ?pQ ;
                      nltl:yieldStrength ?sigmaQ ;
                      nltl:frameMomentFactorM ?mQ ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Q ;
                      nltl:sectionModulus ?zQ ;
                      nltl:actualFrameShearArea ?actualQ ;
                      nltl:grossFrameShearArea ?grossQ ;
                      nltl:bracketArea ?bracketQ .

                ?hQ qudt:numericValue ?h .
                ?sQ qudt:numericValue ?s .
                ?lQ qudt:numericValue ?l .
                ?pQ qudt:numericValue ?p .
                ?sigmaQ qudt:numericValue ?sigma .
                ?mQ qudt:numericValue ?m .
                ?f4Q qudt:numericValue ?f4 .
                ?zQ qudt:numericValue ?z .
                ?actualQ qudt:numericValue ?actual .
                ?grossQ qudt:numericValue ?gross .
                ?bracketQ qudt:numericValue ?bracket .

                BIND((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND((?expectedF4 * ?p * ?h * ?l * ?l / (4 * ?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * ?expectedF4 * 2.16 * ?p * ?h * ?l / (2 * ?sigma) * 10000) AS ?expectedA)
                BIND((?gross - ?bracket) AS ?expectedActual)

                BIND(IF(?expectedF4 >= 0,
                    ((?expectedF4 * 0.000001) + 0.000000001),
                    (((0 - ?expectedF4) * 0.000001) + 0.000000001)) AS ?tolF4)
                BIND(IF(?expectedZ >= 0,
                    ((?expectedZ * 0.000001) + 0.000000001),
                    (((0 - ?expectedZ) * 0.000001) + 0.000000001)) AS ?tolZ)
                BIND(IF(?expectedA >= 0,
                    ((?expectedA * 0.000001) + 0.000000001),
                    (((0 - ?expectedA) * 0.000001) + 0.000000001)) AS ?tolA)
                BIND(IF(?expectedActual >= 0,
                    ((?expectedActual * 0.000001) + 0.000000001),
                    (((0 - ?expectedActual) * 0.000001) + 0.000000001)) AS ?tolActual)

                FILTER(
                    ?f4 < (?expectedF4 - ?tolF4) ||
                    ?f4 > (?expectedF4 + ?tolF4) ||
                    ?z < (?expectedZ - ?tolZ) ||
                    ?z > (?expectedZ + ?tolZ) ||
                    ?actual < (?expectedA - ?tolA) ||
                    ?actual > (?expectedA + ?tolA) ||
                    ?actual < (?expectedActual - ?tolActual) ||
                    ?actual > (?expectedActual + ?tolActual)
                )
            }
        """
    ] .
