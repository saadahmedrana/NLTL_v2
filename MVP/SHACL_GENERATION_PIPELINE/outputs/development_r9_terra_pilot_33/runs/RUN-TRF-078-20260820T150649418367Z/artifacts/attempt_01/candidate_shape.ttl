@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF078QuantityShape> a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:generated-shape:TRF078TableLookupCaseShape> a sh:NodeShape ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:minCount 1 ;
        sh:in (
            nltl:traficomTable6Dash6
            nltl:traficomTable6Dash7
        )
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
            ]
        ]
        [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
            ]
        ]
    ) .

<urn:nltl:generated-shape:TRF078ShipShape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK1 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK2 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
    ] ;
    sh:property [
        sh:path nltl:iceLoadCycleCoefficientK3 ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
    ] ;
    sh:property [
        sh:path nltl:propellerBladeLoadSpectrumCountFactor ;
        sh:minCount 1 ;
        sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
    ] ;
    sh:property [
        sh:path nltl:propellerLocation ;
        sh:class nltl:propellerLocationValue ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node <urn:nltl:generated-shape:TRF078TableLookupCaseShape> ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash6
            ] ;
            sh:property [
                sh:path nltl:selectedIceClassCycleCount ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path nltl:tableReference ;
                sh:hasValue nltl:traficomTable6Dash7
            ] ;
            sh:property [
                sh:path nltl:selectedPropellerLocationFactor ;
                sh:minCount 1 ;
                sh:node <urn:nltl:generated-shape:TRF078QuantityShape>
            ]
        ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:sparql [
        sh:message "The Table 6-6 selected ice class cycle count must correspond to classLoadCycleCount." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:classLoadCycleCount ?nclass ;
                      nltl:hasTableLookupCase ?case .
                ?case nltl:tableReference nltl:traficomTable6Dash6 ;
                      nltl:selectedIceClassCycleCount ?selected .
                ?selected qudt:numericValue ?selectedValue .
                FILTER (?selectedValue != ?nclass)
            }
        """
    ] ;
    sh:sparql [
        sh:message "The Table 6-7 selected propeller location factor must correspond to iceLoadCycleCoefficientK1." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCoefficientK1 ?k1Node ;
                      nltl:hasTableLookupCase ?case .
                ?k1Node qudt:numericValue ?k1 .
                ?case nltl:tableReference nltl:traficomTable6Dash7 ;
                      nltl:selectedPropellerLocationFactor ?selected .
                ?selected qudt:numericValue ?selectedValue .
                FILTER (?selectedValue != ?k1)
            }
        """
    ] ;
    sh:sparql [
        sh:message "iceLoadCycleCount must equal k1*k2*k3*Nclass*n_n within numerical tolerance." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:iceLoadCycleCoefficientK1 ?k1Node ;
                      nltl:iceLoadCycleCoefficientK2 ?k2Node ;
                      nltl:iceLoadCycleCoefficientK3 ?k3Node ;
                      nltl:propellerBladeLoadSpectrumCountFactor ?nnNode ;
                      nltl:hasTableLookupCase ?case .
                ?k1Node qudt:numericValue ?k1 .
                ?k2Node qudt:numericValue ?k2 .
                ?k3Node qudt:numericValue ?k3 .
                ?nnNode qudt:numericValue ?nn .
                ?case nltl:tableReference nltl:traficomTable6Dash6 ;
                      nltl:selectedIceClassCycleCount ?nclassNode .
                ?nclassNode qudt:numericValue ?nclass .
                BIND((?k1 * ?k2 * ?k3 * ?nclass * ?nn) AS ?expected)
                FILTER (ABS(?nice - ?expected) > ((0.000001 * ABS(?expected)) + 0.000000001))
            }
        """
    ] .
