@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF114ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceOperatingSpeed ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:KN ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasThrusterIceImpactLoadCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:thrusterIceImpactLoadCase ;
            sh:property [
                sh:path nltl:designIceBlockTableReference ;
                sh:hasValue nltl:traficomTable6Dash3Reference ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:impactLoadCaseTableReference ;
                sh:hasValue nltl:traficomTable6Dash16Reference ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:thrusterImpactCaseAppliesToBody ;
                sh:class nltl:thrusterBody ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path nltl:thrusterResistanceCapacity ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minCount 1
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:KiloN ;
                                sh:minCount 1 ;
                                sh:maxCount 1
                            ]
                        ]
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:thrusterIceImpactLoad ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:thrusterIceImpactDemand ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:KiloN ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:thrusterIceImpactLoadedAreaEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:contactGeometryClassification ;
                sh:class nltl:contactGeometryValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:contactGeometryClassification ;
                        sh:hasValue nltl:hemisphericalContactGeometry
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:contactGeometryClassification ;
                        sh:hasValue nltl:nonHemisphericalContactGeometry
                    ] ;
                    sh:property [
                        sh:path nltl:contactGeometryCorrespondenceEvidence ;
                        sh:class nltl:evidenceArtifact ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ] ;
    sh:sparql [
        sh:message "A non-hemispherical contact geometry requires an equivalent impact sphere radius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER NOT EXISTS {
                    $this nltl:equivalentImpactSphereRadius ?radius .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Thruster resistance capacity must be at least the externally assessed ice impact demand." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:thrusterIceImpactDemand ?demandQuantity ;
                      nltl:thrusterImpactCaseAppliesToBody ?body .
                ?body nltl:thrusterResistanceCapacity ?capacityQuantity .
                ?demandQuantity qudt:numericValue ?demand .
                ?capacityQuantity qudt:numericValue ?capacity .
                FILTER (?capacity < ?demand)
            }
        """
    ] .

<urn:nltl:generated-shape:TRF114EquivalentImpactSphereRadiusShape>
    a sh:NodeShape ;
    sh:targetSubjectsOf nltl:equivalentImpactSphereRadius ;
    sh:property [
        sh:path nltl:equivalentImpactSphereRadius ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .
