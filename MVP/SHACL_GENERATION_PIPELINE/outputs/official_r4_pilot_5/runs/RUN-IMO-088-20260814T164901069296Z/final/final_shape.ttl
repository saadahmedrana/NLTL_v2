@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_088_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Continuous-daylight-only operation must be recorded as true for the exception."
            ]
        ]
        [
            sh:property [
                sh:path nltl:operatesOnlyInContinuousDaylight ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Operation outside continuous daylight must be recorded as false."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bridgeControlledRotatableNarrowBeamSearchlightCount ;
                        sh:datatype xsd:integer ;
                        sh:minInclusive 2 ;
                        sh:minCount 1 ;
                        sh:message "At least two bridge-controlled rotatable narrow-beam searchlights are required."
                    ] ;
                    sh:property [
                        sh:path nltl:searchlightCoverageArc ;
                        sh:minCount 1 ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "360"^^xsd:decimal ;
                                sh:minCount 1 ;
                                sh:message "The searchlight coverage arc must be at least 360 degrees."
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:DEG ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                                sh:message "The searchlight coverage arc must be expressed in degrees."
                            ]
                        ]
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternateVisualIceDetectionMeansApprovalStatus ;
                        sh:nodeKind sh:IRI ;
                        sh:in ( nltl:evidenceStateApproved ) ;
                        sh:minCount 1 ;
                        sh:message "The alternate visual ice-detection means must have approved status."
                    ]
                ]
            )
        ]
    ) .
