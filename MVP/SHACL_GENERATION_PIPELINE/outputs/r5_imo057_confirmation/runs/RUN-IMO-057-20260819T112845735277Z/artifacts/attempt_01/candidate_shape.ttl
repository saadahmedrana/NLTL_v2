@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO057FirePumpCompartmentTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Each linked fire, emergency-fire, water-mist, or water-spray pump must be located in a compartment maintained above 0 degrees Celsius." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT $this
WHERE {
    $this nltl:hasComponent ?pump .
    ?pump a ?pumpClass .
    FILTER (
        ?pumpClass IN (
            nltl:firePump,
            nltl:emergencyFirePump,
            nltl:waterMistPump,
            nltl:waterSprayPump
        )
    )

    FILTER (
        NOT EXISTS {
            ?pump nltl:hasContainingCompartment ?anyCompartment .
        }
        ||
        EXISTS {
            ?pump nltl:hasContainingCompartment ?compartment .

            FILTER (
                NOT EXISTS {
                    ?compartment a nltl:compartment .
                }
                ||
                NOT EXISTS {
                    ?compartment nltl:maintainedTemperature ?anyTemperature .
                }
                ||
                EXISTS {
                    ?compartment nltl:maintainedTemperature ?temperature .

                    FILTER (
                        NOT EXISTS {
                            ?temperature a qudt:QuantityValue .
                        }
                        ||
                        NOT EXISTS {
                            ?temperature qudt:numericValue ?validValue .
                            FILTER (
                                datatype(?validValue) = xsd:decimal
                                && ?validValue > "0"^^xsd:decimal
                            )
                        }
                        ||
                        EXISTS {
                            ?temperature qudt:numericValue ?wrongDatatypeValue .
                            FILTER (datatype(?wrongDatatypeValue) != xsd:decimal)
                        }
                        ||
                        EXISTS {
                            ?temperature qudt:numericValue ?nonPositiveValue .
                            FILTER (
                                datatype(?nonPositiveValue) = xsd:decimal
                                && ?nonPositiveValue <= "0"^^xsd:decimal
                            )
                        }
                        ||
                        EXISTS {
                            ?temperature qudt:numericValue ?firstValue,
                                                           ?secondValue .
                            FILTER (!sameTerm(?firstValue, ?secondValue))
                        }
                        ||
                        NOT EXISTS {
                            ?temperature qudt:unit unit:DEG_C .
                        }
                        ||
                        EXISTS {
                            ?temperature qudt:unit ?wrongUnit .
                            FILTER (?wrongUnit != unit:DEG_C)
                        }
                    )
                }
            )
        }
    )
}
""" ;
    ] .
