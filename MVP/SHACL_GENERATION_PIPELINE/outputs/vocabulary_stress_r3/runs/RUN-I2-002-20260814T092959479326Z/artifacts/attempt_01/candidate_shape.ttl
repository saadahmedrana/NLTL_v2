@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:I2-002-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:urI2Applicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:message "A non-applicable ship must declare UR I2 applicability as false."
            ]
        ]
        [
            sh:property [
                sh:path nltl:urI2Applicability ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "An applicable ship must declare UR I2 applicability as true."
            ] ;
            sh:property [
                sh:path nltl:polarClass ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:polarClassValue ;
                sh:in (
                    nltl:polarClassPc1
                    nltl:polarClassPc2
                    nltl:polarClassPc3
                    nltl:polarClassPc4
                    nltl:polarClassPc5
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                ) ;
                sh:minCount 1 ;
                sh:message "An applicable ship must identify a permitted Polar Class value."
            ] ;
            sh:property [
                sh:path nltl:urI1ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:message "An applicable ship must comply with UR I1."
            ]
        ]
    ) .
