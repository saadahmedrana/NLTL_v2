@prefix ss: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ss:DimensionlessQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ss:LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ss:AngleQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:DEG ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ss:BowShapeCoefficientQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:maxInclusive "0.60"^^xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

ss:FailureClassFactorLookupShape
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:flexuralFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:DimensionlessQuantityShape ;
        sh:message "Each lookup case must provide one flexural failure class factor."
    ] ;
    sh:property [
        sh:path nltl:crushingFailureClassFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:DimensionlessQuantityShape ;
        sh:message "Each lookup case must provide one crushing failure class factor."
    ] .

ss:BowSubregionCalculationCaseShape
    a sh:NodeShape ;
    sh:class nltl:bowSubregionCalculationCase ;
    sh:property [
        sh:path nltl:bowFormApplicabilityClassification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:i231vBowFormApplicability ;
        sh:message "The bow subregion calculation case must identify applicability to bow forms defined in I2.3.1(v)."
    ] ;
    sh:property [
        sh:path nltl:bowShapeCoefficient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:BowShapeCoefficientQuantityShape ;
        sh:message "The bow subregion calculation case must provide a dimensionless bow shape coefficient not exceeding 0.60."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionMidLengthPosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:LengthQuantityShape ;
        sh:message "The bow subregion calculation case must provide its mid-length position in metres."
    ] ;
    sh:property [
        sh:path nltl:bowSubregionWaterlineAngle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:AngleQuantityShape ;
        sh:message "The bow subregion calculation case must provide its waterline angle in degrees."
    ] ;
    sh:property [
        sh:path nltl:hasFailureClassFactorLookupCase ;
        sh:minCount 1 ;
        sh:node ss:FailureClassFactorLookupShape ;
        sh:message "The bow subregion calculation case must provide a linked failure-class-factor lookup case."
    ] .

ss:ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:betaIPrime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:DimensionlessQuantityShape ;
        sh:message "The ship must provide betaIPrime as a dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLengthLUI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node ss:LengthQuantityShape ;
        sh:message "The ship must provide the upper ice waterline length L_UI in metres."
    ] ;
    sh:property [
        sh:path nltl:hasBowSubregionCalculationCase ;
        sh:node ss:BowSubregionCalculationCaseShape
    ] .
