@prefix stress: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

stress:HullAreaFactorShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hullAreaFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node stress:StructuralMemberHullAreaShape
    ] .

stress:StructuralMemberHullAreaShape
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:spansHullArea ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:hullRegionValue
                ]
            ] ;
            sh:property [
                sh:path nltl:hasSpannedHullArea ;
                sh:minCount 1 ;
                sh:node [
                    sh:class nltl:hullAreaValue
                ]
            ] ;
            sh:property [
                sh:path nltl:selectedHullAreaFactor ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:spansHullArea ;
                sh:maxCount 0
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "The selected hull area factor must equal the hull area factor used for the structural member." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                ?ship nltl:hasStructuralMember $this ;
                      nltl:hullAreaFactor ?hullFactorNode .
                $this nltl:spansHullArea ?region ;
                      nltl:selectedHullAreaFactor ?selectedFactorNode .
                ?hullFactorNode qudt:numericValue ?hullFactorValue .
                ?selectedFactorNode qudt:numericValue ?selectedFactorValue .
                FILTER (?selectedFactorValue != ?hullFactorValue)
            }
        """
    ] .
