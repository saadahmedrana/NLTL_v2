@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:LongitudinalSideFrameShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:structuralLocation ;
        sh:class nltl:structuralLocationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented structural member must identify its structural location."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameOrientation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented structural member must identify whether it is longitudinally framed."
    ] ;
    sh:property [
        sh:path nltl:midspanPlasticCollapseLoad ;
        sh:node nltl:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented structural member must provide its midspan plastic collapse load."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberLoadCase ;
        sh:node nltl:StructuralMemberLoadCaseShape
    ] .

nltl:StructuralMemberLoadCaseShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:combinedShearAndBendingDemand ;
        sh:node nltl:QuantityValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Each represented structural-member load case must provide its combined shear-and-bending demand."
    ] .

nltl:QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:KiloNewtonQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:ShipLongitudinalSideFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plasticStrength ;
        sh:node nltl:KiloNewtonQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide the plastic strength used for the longitudinal side-frame check."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node nltl:LongitudinalSideFrameShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For every represented longitudinal structural member in a side structure, the combined shear-and-bending demand must not exceed the plastic strength or the midspan plastic collapse load." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member nltl:structuralLocation nltl:sideStructureLocation ;
                        nltl:longitudinalFrameOrientation true ;
                        nltl:hasStructuralMemberLoadCase ?loadCase ;
                        nltl:midspanPlasticCollapseLoad ?midspanQuantity .
                ?loadCase nltl:combinedShearAndBendingDemand ?demandQuantity .
                $this nltl:plasticStrength ?strengthQuantity .
                ?demandQuantity qudt:numericValue ?demand .
                ?midspanQuantity qudt:numericValue ?midspanLoad .
                ?strengthQuantity qudt:numericValue ?strength .
                FILTER (?demand > ?midspanLoad || ?demand > ?strength)
            }
        """
    ] .
