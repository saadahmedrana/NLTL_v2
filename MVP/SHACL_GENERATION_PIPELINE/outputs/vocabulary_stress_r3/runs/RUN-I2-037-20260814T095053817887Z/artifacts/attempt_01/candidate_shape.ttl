@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:I2-037-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceLoadPatch ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatch
        ] ;
        sh:message "The ship must identify the ice load patch used for the design."
    ] ;
    sh:property [
        sh:path nltl:hasIceLoadPatchDesignCase ;
        sh:minCount 1 ;
        sh:node [
            sh:class nltl:iceLoadPatchDesignCase ;
            sh:property [
                sh:path nltl:memberCapacityMinimizationConfirmed ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "The design case must confirm that member capacity is minimised under the combined bending and shear effects."
            ]
        ] ;
        sh:message "The ship must identify a design case for applying the ice load patch at the governing member-capacity location."
    ] ;
    sh:property [
        sh:path nltl:loadPatchApplicationLocation ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The ship must specify the location where the ice load patch is applied."
    ] .
