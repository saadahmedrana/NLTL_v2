@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The quantity must use MPa."
    ] .

<urn:nltl:stress-shape:CalculationCaseShape>
    a sh:NodeShape ;
    sh:class nltl:calculationCase ;
    sh:property [
        sh:path nltl:calculationMethod ;
        sh:hasValue nltl:directCalculationMethodValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The calculation case must identify the direct linear calculation method."
    ] .

<urn:nltl:stress-shape:WebShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:nominalShearStress ;
        sh:node <urn:nltl:stress-shape:QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A member web must provide one nominal shear stress in MPa."
    ] ;
    sh:sparql [
        sh:message "Nominal shear stress in a member web must be less than yield strength divided by square root of three." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:nominalShearStress ?stressValueNode .
                ?stressValueNode qudt:numericValue ?stress .
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberWeb $this .
                ?ship nltl:yieldStrength ?yieldValueNode .
                ?yieldValueNode qudt:numericValue ?yield .
                FILTER (?stress >= (?yield / 1.7320508075688772935))
            }
        """
    ] .

<urn:nltl:stress-shape:FlangeShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:nominalFlangeVonMisesStress ;
        sh:node <urn:nltl:stress-shape:QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A member flange must provide one nominal von Mises stress in MPa."
    ] ;
    sh:sparql [
        sh:message "Nominal von Mises stress in a member flange must be less than 1.15 times yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:nominalFlangeVonMisesStress ?stressValueNode .
                ?stressValueNode qudt:numericValue ?stress .
                ?ship nltl:hasStructuralMember ?member .
                ?member nltl:hasStructuralMemberFlange $this .
                ?ship nltl:yieldStrength ?yieldValueNode .
                ?yieldValueNode qudt:numericValue ?yield .
                FILTER (?stress >= (1.15 * ?yield))
            }
        """
    ] .

<urn:nltl:stress-shape:StructuralMemberShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStructuralMemberWeb ;
        sh:node <urn:nltl:stress-shape:WebShape>
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMemberFlange ;
        sh:node <urn:nltl:stress-shape:FlangeShape>
    ] ;
    sh:property [
        sh:path nltl:bucklingCriteriaSatisfied ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The applicable buckling criteria must be satisfied."
    ] .

<urn:nltl:stress-shape:ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node <urn:nltl:stress-shape:QuantityValueShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Yield strength must be provided in MPa."
    ] ;
    sh:property [
        sh:path nltl:hasCalculationCase ;
        sh:node <urn:nltl:stress-shape:CalculationCaseShape> ;
        sh:minCount 1 ;
        sh:message "A direct linear calculation case must be provided."
    ] ;
    sh:property [
        sh:path nltl:hasStructuralMember ;
        sh:node <urn:nltl:stress-shape:StructuralMemberShape>
    ] .
