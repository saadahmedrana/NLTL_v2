@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO_003_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:designIceCondition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A ship must provide its design ice condition to determine the applicable category rule."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ship designed for open water or less severe ice conditions must have ship category C." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:designIceCondition ?condition .
                FILTER (
                    regex(str(?condition), "open[[:space:]]+water", "i")
                    ||
                    regex(
                        str(?condition),
                        "less[[:space:]]+severe.*categor(y|ies).*a.*b",
                        "i"
                    )
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryC .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?otherCategory .
                        FILTER (?otherCategory != nltl:polarShipCategoryC)
                    }
                )
            }
        """
    ] .
