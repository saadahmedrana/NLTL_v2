@prefix nltlShape: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlShape:IMO008ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:minCount 1 ;
        sh:message "A ship must provide an ice type classification to determine the applicable ice-thickness rule."
    ] ;
    sh:or (
        nltlShape:ThinFirstYearIceBranch
        nltlShape:FirstYearIceBranch
        nltlShape:MediumFirstYearIceBranch
    ) .

nltlShape:ThinFirstYearIceBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:hasValue nltl:thinFirstYearIce ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:iceThickness ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive "0.3"^^xsd:decimal ;
                sh:maxInclusive "0.7"^^xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "For thin first-year ice, ice thickness must be between 0.3 m and 0.7 m inclusive."
    ] .

nltlShape:FirstYearIceBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:hasValue nltl:firstYearIce ;
        sh:minCount 1
    ] .

nltlShape:MediumFirstYearIceBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceTypeClassification ;
        sh:hasValue nltl:mediumFirstYearIce ;
        sh:minCount 1
    ] .
