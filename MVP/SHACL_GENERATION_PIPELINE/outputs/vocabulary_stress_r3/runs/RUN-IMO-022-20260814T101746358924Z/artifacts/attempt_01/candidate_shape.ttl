@prefix gen: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_022_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarWaterOperationalManualPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall record that its Polar Water Operational Manual is present."
    ] ;
    sh:property [
        sh:path nltl:capabilitiesSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual shall include ship-specific capabilities."
    ] ;
    sh:property [
        sh:path nltl:limitationsSectionPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The Polar Water Operational Manual shall include ship-specific limitations."
    ] ;
    sh:property [
        sh:path nltl:operationalAssessmentReference ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "The Polar Water Operational Manual shall include a reference linking the capabilities and limitations to the required operational assessment."
    ] .
