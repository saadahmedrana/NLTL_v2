@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO_037_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1 ;
                sh:message "Category A or B is required to establish applicability."
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minInclusive "2017-01-01"^^xsd:date ;
                sh:minCount 1 ;
                sh:message "A construction date on or after 2017-01-01 is required to establish applicability."
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:alternativeInstrumentApplicable ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true ;
                    ] ;
                    sh:property [
                        sh:path nltl:alternativeInstrumentResidualStabilityStatus ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue true ;
                        sh:message "The alternative instrument residual stability status must be compliant."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:alternativeInstrumentApplicable ;
                        sh:datatype xsd:boolean ;
                        sh:minCount 1 ;
                        sh:hasValue false ;
                    ] ;
                    sh:property [
                        sh:path nltl:residualStabilityFactorSI ;
                        sh:node [
                            sh:class qudt:QuantityValue ;
                            sh:property [
                                sh:path qudt:numericValue ;
                                sh:datatype xsd:decimal ;
                                sh:minInclusive "1"^^xsd:decimal ;
                                sh:maxInclusive "1"^^xsd:decimal ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                            ] ;
                            sh:property [
                                sh:path qudt:unit ;
                                sh:hasValue unit:UNITLESS ;
                                sh:minCount 1 ;
                                sh:maxCount 1 ;
                            ]
                        ] ;
                        sh:minCount 1 ;
                        sh:message "The residual stability factor s_i must equal one."
                    ]
                )
            )
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in ( nltl:polarShipCategoryC ) ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1 ;
            ] ;
            sh:property [
                sh:path nltl:constructionDate ;
                sh:datatype xsd:date ;
                sh:maxInclusive "2016-12-31"^^xsd:date ;
                sh:minCount 1 ;
            ]
        )
    ) ;
    sh:property [
        sh:path nltl:hasLoadingConditionCase ;
        sh:node [
            sh:class nltl:loadingConditionCase ;
            sh:property [
                sh:path nltl:loadingConditionIdentifier ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "Each loading condition case must have an identifier."
            ] ;
            sh:property [
                sh:path nltl:hasLoadingConditionResultEvidence ;
                sh:node [
                    sh:class nltl:evidenceArtifact
                ] ;
                sh:minCount 1 ;
                sh:message "Each loading condition case must link to result evidence."
            ]
        ]
    ] .
