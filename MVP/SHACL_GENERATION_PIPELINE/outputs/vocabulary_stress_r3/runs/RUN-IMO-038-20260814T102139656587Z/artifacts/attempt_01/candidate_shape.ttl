@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO-038-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:damageCenterForwardOfMaxBreadth ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:damageCenterForwardOfMaxBreadth ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:allowedVerticalPosition ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A permitted vertical damage position must be recorded."
    ] ;
    sh:property [
        sh:path nltl:damageCenterForwardOfMaxBreadth ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The damage-center position applicability value is required."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineLength ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Upper ice waterline length is required."
    ] ;
    sh:property [
        sh:path ( nltl:upperIceWaterlineLength qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:upperIceWaterlineLength qudt:unit ) ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Upper ice waterline draught is required."
    ] ;
    sh:property [
        sh:path ( nltl:upperIceWaterlineDraught qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:upperIceWaterlineDraught qudt:unit ) ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:longitudinalDamageExtent ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Longitudinal damage extent is required."
    ] ;
    sh:property [
        sh:path ( nltl:longitudinalDamageExtent qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:longitudinalDamageExtent qudt:unit ) ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:transversePenetration ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Transverse penetration is required."
    ] ;
    sh:property [
        sh:path ( nltl:transversePenetration qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 760 ;
        sh:maxInclusive 760
    ] ;
    sh:property [
        sh:path ( nltl:transversePenetration qudt:unit ) ;
        sh:hasValue qudt:MilliM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalDamageExtent ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Vertical damage extent is required."
    ] ;
    sh:property [
        sh:path ( nltl:verticalDamageExtent qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:verticalDamageExtent qudt:unit ) ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:selectedVerticalDamagePosition ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Selected vertical damage position is required."
    ] ;
    sh:property [
        sh:path ( nltl:selectedVerticalDamagePosition qudt:numericValue ) ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( nltl:selectedVerticalDamagePosition qudt:unit ) ;
        sh:hasValue qudt:M ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Damage extents and vertical position do not satisfy the required formulas and inclusive range." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this
                    nltl:damageCenterForwardOfMaxBreadth ?forward ;
                    nltl:upperIceWaterlineLength ?lengthNode ;
                    nltl:upperIceWaterlineDraught ?draughtNode ;
                    nltl:longitudinalDamageExtent ?longitudinalNode ;
                    nltl:verticalDamageExtent ?verticalNode ;
                    nltl:selectedVerticalDamagePosition ?positionNode .

                ?lengthNode qudt:numericValue ?length .
                ?draughtNode qudt:numericValue ?draught .
                ?longitudinalNode qudt:numericValue ?longitudinal .
                ?verticalNode qudt:numericValue ?vertical .
                ?positionNode qudt:numericValue ?position .

                BIND(
                    IF(?forward = true,
                       0.045 * ?length,
                       0.015 * ?length)
                    AS ?expectedLongitudinal
                )
                BIND(
                    IF(0.20 * ?draught < ?expectedLongitudinal,
                       0.20 * ?draught,
                       ?expectedLongitudinal)
                    AS ?expectedVertical
                )

                FILTER(
                    ABS(?longitudinal - ?expectedLongitudinal) >
                        (0.000001 * ABS(?expectedLongitudinal) + 0.000000001)
                    ||
                    ABS(?vertical - ?expectedVertical) >
                        (0.000001 * ABS(?expectedVertical) + 0.000000001)
                    ||
                    ?position < 0
                    ||
                    ?position > (1.20 * ?draught)
                )
            }
        """
    ] .
