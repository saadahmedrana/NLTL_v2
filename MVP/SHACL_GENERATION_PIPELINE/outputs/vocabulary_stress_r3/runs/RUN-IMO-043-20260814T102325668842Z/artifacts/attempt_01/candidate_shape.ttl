@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<urn:nltl:stress-shape:IMO-043-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasMachineryInstallation ;
        sh:class nltl:machineryInstallationItem ;
        sh:node <urn:nltl:stress-shape:IMO-043-MachineryInstallationShape> ;
        sh:message "Each linked machinery installation must be represented and checked for applicable hazard protection coverage."
    ] .

<urn:nltl:stress-shape:IMO-043-MachineryInstallationShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasApplicableHazard ;
        sh:in (
            nltl:iceAccretionHazard
            nltl:snowAccumulationHazard
            nltl:seawaterIceIngestionHazard
            nltl:liquidFreezingOrViscosityIncreaseHazard
            nltl:seawaterIntakeTemperatureHazard
            nltl:snowIngestionHazard
        ) ;
        sh:message "Any declared applicable hazard must be one of the permitted Polar Code machinery hazards."
    ] ;
    sh:property [
        sh:path nltl:hasAssociatedEquipment ;
        sh:class nltl:associatedEquipmentItem ;
        sh:message "Each associated equipment item must be represented as an associated equipment item."
    ] ;
    sh:property [
        sh:path nltl:hasHazardProtectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:message "Each machinery installation must provide hazard protection evidence for its applicable hazards."
    ] .
