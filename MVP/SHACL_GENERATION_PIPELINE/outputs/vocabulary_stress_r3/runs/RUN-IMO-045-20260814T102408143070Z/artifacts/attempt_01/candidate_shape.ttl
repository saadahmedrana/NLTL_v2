@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO045ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:machinerySeawaterSupply ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The machinery seawater supply applicability value must be recorded as one boolean." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue false ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:iceIngestionPreventionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Each machinery seawater supply must have ice-ingestion prevention." ;
            ]
        ]
        [
            sh:property [
                sh:path nltl:machinerySeawaterSupply ;
                sh:hasValue true ;
            ] ;
            sh:property [
                sh:path nltl:alternateFunctionalityArrangementApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved ;
                sh:message "An alternative functionality arrangement for the machinery seawater supply must have approved status." ;
            ]
        ]
    ) .
