@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

nltl:IMO_052_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasRequiredAccessItem ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:requiredAccessItem ;
        sh:node [
            sh:property [
                sh:path nltl:hasIceOrSnowRemovalOrPreventionMeans ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceSnowRemovalOrPreventionMeans ;
                sh:minCount 1 ;
                sh:message "Each required access item shall have an associated ice or snow removal or prevention means."
            ]
        ]
    ] .
