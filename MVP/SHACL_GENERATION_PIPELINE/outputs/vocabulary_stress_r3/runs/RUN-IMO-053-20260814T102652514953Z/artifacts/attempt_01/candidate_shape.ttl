@prefix g: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO053ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExtinguishingMedium ;
        sh:node g:IMO053ExtinguishingMediumItemShape ;
        sh:message "Each linked extinguishing medium must have an approved intended-operation compatibility status."
    ] .

g:IMO053ExtinguishingMediumItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:intendedOperationCompatibilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "The extinguishing medium must have intended-operation compatibility status approved."
    ] .
