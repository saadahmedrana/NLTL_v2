@prefix gen: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_057_FirePumpCompartmentTemperatureShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every fire pump, emergency fire pump, water-mist pump, and water-spray pump must have a containing compartment maintained above 0 degrees Celsius." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasComponent ?pump .
                ?pump a ?pumpType .
                FILTER (
                    ?pumpType IN (
                        nltl:firePump,
                        nltl:emergencyFirePump,
                        nltl:waterMistPump,
                        nltl:waterSprayPump
                    )
                )
                FILTER (
                    NOT EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                    }
                    ||
                    EXISTS {
                        ?pump nltl:hasContainingCompartment ?compartment .
                        FILTER NOT EXISTS {
                            ?compartment nltl:maintainedTemperature ?temperature .
                            ?temperature qudt:numericValue ?value ;
                                         qudt:unit unit:DEG_C .
                            FILTER (
                                datatype(?value) = xsd:decimal &&
                                ?value > 0
                            )
                        }
                    }
                )
            }
        """ ;
    ] .
