@prefix g: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

g:IMO058ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasExposedFireMainSection ;
        sh:node g:IMO058ExposedFireMainSectionShape ;
        sh:message "Each linked exposed fire-main section must satisfy the isolation and drainage requirements."
    ] .

g:IMO058ExposedFireMainSectionShape
    a sh:NodeShape ;
    sh:class nltl:exposedFireMainSectionItem ;
    sh:property [
        sh:path nltl:fireMainSectionIsolationCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The exposed fire-main section must have isolation capability."
    ] ;
    sh:property [
        sh:path nltl:fireMainSectionDrainageMeansPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The exposed fire-main section must have drainage means."
    ] .
