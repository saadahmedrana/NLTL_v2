@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO-066-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship's ice-accretion exposure applicability must be recorded."
    ] ;
    sh:or (
        <urn:nltl:stress-shape:IMO-066-NotExposedBranch>
        <urn:nltl:stress-shape:IMO-066-ExposedBranch>
    ) .

<urn:nltl:stress-shape:IMO-066-NotExposedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:hasValue false
    ] .

<urn:nltl:stress-shape:IMO-066-ExposedBranch>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipExposedToIceAccretion ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:stress-shape:IMO-066-EscapeRouteItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:stress-shape:IMO-066-MusterStationItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:stress-shape:IMO-066-EmbarkationAreaItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:stress-shape:IMO-066-SurvivalCraftItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:stress-shape:IMO-066-LaunchingApplianceItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path nltl:hasProtectedItem ;
        sh:qualifiedValueShape <urn:nltl:stress-shape:IMO-066-SurvivalCraftAccessItem> ;
        sh:qualifiedMinCount 1
    ] ;
    sh:sparql [
        sh:message "Every represented required protected item must have associated ice or snow removal or prevention means." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasProtectedItem ?item .
                ?item nltl:protectedItemCategory ?category .
                FILTER (
                    ?category IN (
                        nltl:escapeRouteProtectedItem,
                        nltl:musterStationProtectedItem,
                        nltl:embarkationAreaProtectedItem,
                        nltl:survivalCraftProtectedItem,
                        nltl:launchingApplianceProtectedItem,
                        nltl:survivalCraftAccessProtectedItem
                    )
                )
                FILTER NOT EXISTS {
                    ?item nltl:hasIceSnowRemovalOrPreventionMeans ?means .
                }
            }
        """
    ] .

<urn:nltl:stress-shape:IMO-066-EscapeRouteItem>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:escapeRouteProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each escape route must have associated ice or snow removal or prevention means."
    ] .

<urn:nltl:stress-shape:IMO-066-MusterStationItem>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:musterStationProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each muster station must have associated ice or snow removal or prevention means."
    ] .

<urn:nltl:stress-shape:IMO-066-EmbarkationAreaItem>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:embarkationAreaProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each embarkation area must have associated ice or snow removal or prevention means."
    ] .

<urn:nltl:stress-shape:IMO-066-SurvivalCraftItem>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each survival craft must have associated ice or snow removal or prevention means."
    ] .

<urn:nltl:stress-shape:IMO-066-LaunchingApplianceItem>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:launchingApplianceProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each launching appliance must have associated ice or snow removal or prevention means."
    ] .

<urn:nltl:stress-shape:IMO-066-SurvivalCraftAccessItem>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:protectedItemCategory ;
        sh:hasValue nltl:survivalCraftAccessProtectedItem ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasIceSnowRemovalOrPreventionMeans ;
        sh:minCount 1 ;
        sh:message "Each survival-craft access must have associated ice or snow removal or prevention means."
    ] .
