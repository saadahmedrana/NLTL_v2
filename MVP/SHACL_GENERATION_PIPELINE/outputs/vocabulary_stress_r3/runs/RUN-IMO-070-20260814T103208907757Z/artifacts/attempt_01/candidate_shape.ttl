@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO070_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:class nltl:passengerShip ;
            sh:property [
                sh:path nltl:sizeCompatibilityStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "Each applicable passenger ship must establish compatible sizing."
            ] ;
            sh:property [
                sh:path nltl:hasPersonOnBoardMember ;
                sh:node <urn:nltl:stress-shape:IMO070_PersonOnBoardMemberShape> ;
                sh:message "Each person on board must have one compatible immersion suit or thermal protective aid assignment."
            ]
        ]
        [
            sh:not [
                sh:class nltl:passengerShip
            ]
        ]
    ) .

<urn:nltl:stress-shape:IMO070_PersonOnBoardMemberShape>
    a sh:NodeShape ;
    sh:class nltl:personOnBoardMember ;
    sh:property [
        sh:path nltl:hasPersonalSurvivalEquipmentAssignment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:IMO070_AssignmentShape> ;
        sh:message "Each person on board must have exactly one personal survival equipment assignment."
    ] .

<urn:nltl:stress-shape:IMO070_AssignmentShape>
    a sh:NodeShape ;
    sh:class nltl:personalSurvivalEquipmentAssignment ;
    sh:property [
        sh:path nltl:assignedPersonalSurvivalEquipment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:IMO070_EquipmentShape> ;
        sh:message "The assignment must identify exactly one immersion suit or thermal protective aid."
    ] .

<urn:nltl:stress-shape:IMO070_EquipmentShape>
    a sh:NodeShape ;
    sh:class nltl:personalSurvivalEquipment ;
    sh:or (
        [
            sh:class nltl:immersionSuitEquipment
        ]
        [
            sh:class nltl:thermalProtectiveAidEquipment
        ]
    ) ;
    sh:message "Assigned personal survival equipment must be an immersion suit or a thermal protective aid."
    .
