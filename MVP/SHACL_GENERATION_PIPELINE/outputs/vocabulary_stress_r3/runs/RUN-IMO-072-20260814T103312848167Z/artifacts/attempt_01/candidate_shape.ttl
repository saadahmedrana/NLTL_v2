@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ss: <urn:nltl:stress-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ss:ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Extended darkness operation must be recorded as a single boolean value."
    ] ;
    sh:or (
        ss:ExtendedDarknessApplicableShape
        ss:ExtendedDarknessNotApplicableShape
    ) .

ss:ExtendedDarknessApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:continuousUseSuitabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When extended darkness operation applies, continuous-use suitability must be approved."
    ] ;
    sh:property [
        sh:path nltl:hasLifeboat ;
        sh:class nltl:lifeboat ;
        sh:node ss:LifeboatShape ;
        sh:message "Each linked lifeboat must have an assigned searchlight suitable for continuous use."
    ] .

ss:ExtendedDarknessNotApplicableShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:extendedDarknessOperation ;
        sh:hasValue false
    ] .

ss:LifeboatShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasAssignedSearchlight ;
        sh:class nltl:searchlight ;
        sh:minCount 1 ;
        sh:node ss:SearchlightShape ;
        sh:message "Each lifeboat must have an assigned searchlight."
    ] .

ss:SearchlightShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:searchlightContinuousUseSuitabilityStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:in ( true ) ;
        sh:message "Each assigned searchlight must be approved for continuous use."
    ] .
