@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix nltlgen: <urn:nltl:stress-shape:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltlgen:IMO_074_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:abandonmentOntoIceOrLandPotential ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The ship must provide the abandonment onto ice or land potential assessment."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:groupSurvivalEquipmentCarried ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:abandonmentOntoIceOrLandPotential ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:normalLifeSavingEquivalentFunctionalityApprovalStatus ;
                sh:class nltl:evidenceState ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved
            ]
        ]
    ) ;
    sh:message "When abandonment onto ice or land is possible, the ship must carry group survival equipment or have approved equivalent functionality from its normal life-saving appliances." .
