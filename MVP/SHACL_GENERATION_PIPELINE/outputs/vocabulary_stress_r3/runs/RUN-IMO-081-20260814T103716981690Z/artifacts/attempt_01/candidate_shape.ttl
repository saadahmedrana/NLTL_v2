@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stress: <urn:nltl:stress-shape:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

stress:IMO_081_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "Construction date is required and must be an xsd:date."
    ] ;
    sh:property [
        sh:path nltl:shipIceStrengthened ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice-strengthening status is required and must be an xsd:boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:maxInclusive "2016-12-31"^^xsd:date
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionDate ;
                sh:minInclusive "2017-01-01"^^xsd:date
            ] ;
            sh:property [
                sh:path nltl:shipIceStrengthened ;
                sh:hasValue true
            ] ;
            sh:or (
                [
                    sh:property [
                        sh:path nltl:independentEchoSoundingDeviceCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:echoSoundingDeviceCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 1
                    ] ;
                    sh:property [
                        sh:path nltl:independentTransducerCount ;
                        sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 2
                    ]
                ]
            ) ;
            sh:message "Applicable ships require either at least two independent echo-sounding devices or at least one echo-sounding device with at least two independent transducers."
        ]
    ) ;
    sh:message "For ships constructed on or after 1 January 2017 and ice strengthened, one permitted echo-sounding equipment alternative must be satisfied." .
