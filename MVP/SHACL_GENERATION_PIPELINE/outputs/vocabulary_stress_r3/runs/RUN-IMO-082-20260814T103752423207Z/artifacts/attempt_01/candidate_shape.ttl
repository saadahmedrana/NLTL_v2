@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO_082_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:solasRegulationV22Point1Point9Point4ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The ship shall comply with SOLAS regulation V/22.1.9.4."
    ] ;
    sh:property [
        sh:path nltl:bridgeConfigurationType ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A bridge configuration is required to determine whether clear astern view is applicable."
    ] ;
    sh:sparql [
        sh:message "Where the bridge configuration requires astern view, clear astern view status shall be true with boolean datatype." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:bridgeConfigurationType
                      nltl:asternViewRequiredBridgeConfiguration .
                FILTER (
                    NOT EXISTS {
                        $this nltl:clearViewAsternStatus ?ok .
                        FILTER (
                            datatype(?ok) = xsd:boolean &&
                            ?ok = true
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:clearViewAsternStatus ?bad .
                        FILTER NOT (
                            datatype(?bad) = xsd:boolean &&
                            ?bad = true
                        )
                    }
                )
            }
        """
    ] .
