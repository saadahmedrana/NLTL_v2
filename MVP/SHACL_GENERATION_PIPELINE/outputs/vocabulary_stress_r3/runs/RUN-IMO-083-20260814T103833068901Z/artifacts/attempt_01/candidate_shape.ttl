@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO_083_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false ;
                sh:message "iceAccretionLikely must be false for the non-applicable branch."
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "iceAccretionLikely must be true for the applicable branch."
            ] ;
            sh:property [
                sh:path nltl:requiredNavigationOrCommunicationAntenna ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "At least one required navigation or communication antenna must be identified when ice accretion is likely."
            ] ;
            sh:property [
                sh:path nltl:iceAccumulationPreventionMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "Means to prevent ice accumulation on required navigation or communication antennas must be present when ice accretion is likely."
            ]
        ]
    ) .
