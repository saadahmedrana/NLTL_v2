@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<nltl:IMO-113-PolarDocumentCoverageShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        <nltl:IMO-113-PolarOperationApplicableShape>
        <nltl:IMO-113-PolarOperationNotApplicableShape>
    ) .

<nltl:IMO-113-PolarOperationApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "The polar-waters applicability indicator must be true for the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:cargoRecordBookPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Polar operation coverage must be recorded in the applicable Cargo Record Book."
    ] ;
    sh:property [
        sh:path nltl:manualPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Polar operation coverage must be recorded in the applicable Manual."
    ] ;
    sh:property [
        sh:path nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "Polar operation coverage must be recorded in the applicable NLS or marine pollution emergency plan."
    ] .

<nltl:IMO-113-PolarOperationNotApplicableShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "The polar-waters applicability indicator must be false for the non-applicable branch."
    ] .
