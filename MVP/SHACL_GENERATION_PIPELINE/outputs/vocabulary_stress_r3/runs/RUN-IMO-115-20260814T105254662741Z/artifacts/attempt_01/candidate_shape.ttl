@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:IMO115Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For comminuted and disinfected sewage, MARPOL Annex IV regulation 11.1.1 compliance, a distance greater than 3 nautical miles from ice shelf or fast ice, and a recorded distance from areas with ice concentration exceeding 1/10 are required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:sewageDischargeType ?dischargeType .
                FILTER(?dischargeType = "comminuted_and_disinfected")

                FILTER(
                    ! EXISTS {
                        $this nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ?status .
                        FILTER(?status = true)
                    }
                    ||
                    ! EXISTS {
                        $this nltl:distanceToNearestIceShelfOrFastIce ?distance .
                        ?distance qudt:numericValue ?distanceValue ;
                                  qudt:unit unit:MI_N .
                        FILTER(datatype(?distanceValue) = xsd:decimal)
                        FILTER(?distanceValue > "3"^^xsd:decimal)
                        FILTER NOT EXISTS {
                            ?distance qudt:numericValue ?otherDistanceValue .
                            FILTER(?otherDistanceValue != ?distanceValue)
                        }
                        FILTER NOT EXISTS {
                            ?distance qudt:unit ?otherDistanceUnit .
                            FILTER(?otherDistanceUnit != unit:MI_N)
                        }
                    }
                    ||
                    ! EXISTS {
                        $this nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ?areaDistance .
                        ?areaDistance qudt:numericValue ?areaDistanceValue ;
                                      qudt:unit unit:MI_N .
                        FILTER(datatype(?areaDistanceValue) = xsd:decimal)
                        FILTER NOT EXISTS {
                            ?areaDistance qudt:numericValue ?otherAreaDistanceValue .
                            FILTER(?otherAreaDistanceValue != ?areaDistanceValue)
                        }
                        FILTER NOT EXISTS {
                            ?areaDistance qudt:unit ?otherAreaDistanceUnit .
                            FILTER(?otherAreaDistanceUnit != unit:MI_N)
                        }
                    }
                    ||
                    ! EXISTS {
                        $this nltl:nearbyIceConcentration ?concentration .
                        ?concentration qudt:numericValue ?concentrationValue ;
                                        qudt:unit unit:UNITLESS .
                        FILTER(datatype(?concentrationValue) = xsd:decimal)
                        FILTER(?concentrationValue > "0.1"^^xsd:decimal)
                        FILTER NOT EXISTS {
                            ?concentration qudt:numericValue ?otherConcentrationValue .
                            FILTER(?otherConcentrationValue != ?concentrationValue)
                        }
                        FILTER NOT EXISTS {
                            ?concentration qudt:unit ?otherConcentrationUnit .
                            FILTER(?otherConcentrationUnit != unit:UNITLESS)
                        }
                    }
                )
            }
        """
    ] .
