@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO-116-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:sewageDischargeType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A sewage discharge type is required to determine applicability."
    ] ;
    sh:property [
        sh:path nltl:notComminutedOrDisinfected ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The sewage treatment applicability status must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:notComminutedOrDisinfected ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true ;
                sh:message "MARPOL Annex IV regulation 11.1.1 compliance is required for the applicable discharge."
            ] ;
            sh:property [
                sh:path nltl:distanceToNearestIceShelfOrFastIce ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive "12"^^xsd:decimal ;
                        sh:message "The distance from the nearest ice shelf or fast ice must be greater than 12 nautical miles."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MI_N ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:nearbyIceConcentration ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:minExclusive "0.1"^^xsd:decimal ;
                        sh:message "The recorded nearby ice concentration must represent an area exceeding one tenth."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:UNITLESS ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MI_N ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:notComminutedOrDisinfected ;
                sh:hasValue false
            ]
        ]
    ) .
