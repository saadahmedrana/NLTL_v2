@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO_118_ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine applicability of the sewage-discharge rule."
    ] ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:message "A ship category is required to determine applicability of the sewage-discharge rule."
    ] ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "A ship type is required to determine applicability of the sewage-discharge rule."
    ] ;
    sh:property [
        sh:path nltl:sewageDischargeToSea ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Sewage discharge to sea must be recorded."
    ] ;
    sh:property [
        sh:path nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Paragraph 4.2.1.3 compliance status must be recorded for the sewage-discharge exception."
    ] ;
    sh:sparql [
        sh:message "For ships constructed on or after 1 January 2017 that are Category A, Category B, or passenger ships, sewage discharge to sea is prohibited unless paragraph 4.2.1.3 compliance is recorded."
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:shipCategory ?shipCategory ;
                      nltl:shipType ?shipType ;
                      nltl:sewageDischargeToSea ?dischargeToSea .

                FILTER (
                    ?constructionDate >= "2017-01-01"^^xsd:date
                    && (
                        ?shipCategory IN (
                            nltl:polarShipCategoryA,
                            nltl:polarShipCategoryB
                        )
                        || ?shipType = "passenger_ship"
                    )
                    && ?dischargeToSea = true
                )

                FILTER NOT EXISTS {
                    $this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus true
                }
            }
        """
    ] .
