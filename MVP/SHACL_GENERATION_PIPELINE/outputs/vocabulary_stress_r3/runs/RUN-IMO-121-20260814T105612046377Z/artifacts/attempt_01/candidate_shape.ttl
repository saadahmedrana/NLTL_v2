@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO_121Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:foodWasteDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Food waste discharge to sea must be explicitly recorded as false when the conditional requirement is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:foodWasteDischargeToSea ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Food waste discharge to sea must be explicitly recorded as true to invoke the applicable food-waste constraints."
            ] ;
            sh:property [
                sh:path nltl:foodWasteComminutedOrGround ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Food waste discharged to sea must be comminuted or ground."
            ] ;
            sh:property [
                sh:path nltl:contaminatedByOtherGarbage ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Food waste discharged to sea must not be contaminated by other garbage."
            ] ;
            sh:property [
                sh:path nltl:requiredScreenOpening ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:maxInclusive "25"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The required screen opening must be no greater than 25 mm."
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:message "The required screen opening must be expressed in millimetres."
                    ]
                ]
            ]
        )
    ;
    sh:message "If food waste is discharged to sea, it must be comminuted or ground, pass through a screen with openings no greater than 25 mm, and not be contaminated by other garbage." .
