@prefix gen: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO26_002_Chapter_9_1_ApplicabilityShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ship type is required for Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:lengthOverall ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Length overall is required in metres for Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Gross tonnage is required as a unitless quantity for Chapter 9-1 applicability."
    ] ;
    sh:property [
        sh:path nltl:engagedInTrade ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Trade status is required for pleasure-yacht applicability."
    ] ;
    sh:property [
        sh:path nltl:polarCodeChapter9Dash1Applicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Chapter 9-1 applicability must be recorded."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Chapter 9-1 applicability does not match the ship type, dimensions, gross tonnage, and trade status." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipType ?shipType ;
                      nltl:lengthOverall ?lengthQuantity ;
                      nltl:grossTonnage ?tonnageQuantity ;
                      nltl:engagedInTrade ?engaged ;
                      nltl:polarCodeChapter9Dash1Applicable ?applicable .

                ?lengthQuantity qudt:numericValue ?length ;
                                qudt:unit <http://qudt.org/vocab/unit/M> .

                ?tonnageQuantity qudt:numericValue ?tonnage ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .

                FILTER (
                    (?applicable = true &&
                     !(
                        (?shipType = "fishing_vessel" &&
                         ?length >= 24) ||
                        (?shipType = "pleasure_yacht" &&
                         ?tonnage >= 300 &&
                         ?engaged = false) ||
                        (?shipType = "cargo_ship" &&
                         ?tonnage >= 300 &&
                         ?tonnage < 500)
                     )) ||
                    (?applicable = false &&
                     (
                        (?shipType = "fishing_vessel" &&
                         ?length >= 24) ||
                        (?shipType = "pleasure_yacht" &&
                         ?tonnage >= 300 &&
                         ?engaged = false) ||
                        (?shipType = "cargo_ship" &&
                         ?tonnage >= 300 &&
                         ?tonnage < 500)
                     ))
                )
            }
        """
    ] .
