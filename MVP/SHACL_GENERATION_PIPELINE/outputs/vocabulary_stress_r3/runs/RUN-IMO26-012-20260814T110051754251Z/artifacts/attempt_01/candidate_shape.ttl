@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO26_012_Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:grossTonnage ;
        sh:datatype qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:minInclusive "500"^^xsd:decimal
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:nonMagneticHeadingMeansCount ;
                sh:datatype xsd:integer ;
                sh:minInclusive 2 ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "At least two non-magnetic means to determine and display heading are required for ships of 500 gross tonnage and upwards."
            ] ;
            sh:property [
                sh:path nltl:headingMeansIndependent ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The non-magnetic heading means shall be independent."
            ] ;
            sh:property [
                sh:path nltl:connectedToMainPower ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:minCount 2 ;
                sh:message "Each of the two non-magnetic heading means shall be connected to main power."
            ] ;
            sh:property [
                sh:path nltl:connectedToEmergencyPower ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:benchmarkEntity ;
                sh:minCount 2 ;
                sh:message "Each of the two non-magnetic heading means shall be connected to emergency power."
            ]
        ]
        [
            sh:property [
                sh:path nltl:grossTonnage ;
                sh:node [
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:maxExclusive "500"^^xsd:decimal
                    ]
                ]
            ]
        ]
    ) .
