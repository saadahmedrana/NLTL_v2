@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO26-013-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:plannedOrActualLatitude ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:minCount 1 ;
                sh:datatype xsd:decimal
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue unit:DEG
            ]
        ]
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a planned or actual latitude over 80 degrees, the ship must have at least one GNSS compass or equivalent connected to both main and emergency power." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:plannedOrActualLatitude ?latitudeQuantity .
                ?latitudeQuantity qudt:numericValue ?latitudeValue .
                ?latitudeQuantity qudt:unit <http://qudt.org/vocab/unit/DEG> .
                FILTER (xsd:decimal(?latitudeValue) > 80)

                {
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:gnssCompassOrEquivalentCount ?count .
                            FILTER (xsd:integer(?count) >= 1)
                        }
                    }
                }

                UNION

                {
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:connectedToMainPower ?mainPowerConnection .
                        }
                    }
                }

                UNION

                {
                    SELECT $this
                    WHERE {
                        FILTER NOT EXISTS {
                            $this nltl:connectedToEmergencyPower ?emergencyPowerConnection .
                        }
                    }
                }
            }
        """
    ] .
