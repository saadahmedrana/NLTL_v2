@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:IMO26-015-ship> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarCodeChapter11Applicable ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path nltl:solasChapterICertified ;
        sh:datatype xsd:boolean
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When Polar Code chapter 11 is applicable, SOLAS chapter I certification must be true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>

            SELECT $this
            WHERE {
                $this nltl:polarCodeChapter11Applicable ?applicable .
                FILTER (?applicable = true)
                FILTER NOT EXISTS {
                    $this nltl:solasChapterICertified ?certified .
                    FILTER (?certified = true)
                }
            }
        """
    ] .
