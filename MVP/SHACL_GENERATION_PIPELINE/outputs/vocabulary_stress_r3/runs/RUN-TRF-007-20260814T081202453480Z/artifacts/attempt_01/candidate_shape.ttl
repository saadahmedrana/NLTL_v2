@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF-007> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceClassValue ;
        sh:minCount 1 ;
        sh:message "The ship's ice class is required to determine applicability."
    ] ;
    sh:or (
        [
            sh:sparql [
                sh:message "The conditional requirement is not applicable because the ship does not have ice class IA Super or IA." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceClass ?iceClass .
                        FILTER (
                            ?iceClass NOT IN (
                                nltl:iceClassIaSuper,
                                nltl:iceClassIa
                            )
                        )
                    }
                """
            ]
        ]
        [
            sh:sparql [
                sh:message "The conditional requirement is not applicable because the keel was laid or construction reached a similar stage on or after 1 September 2003." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:constructionStageDate ?stageDate .
                        FILTER (
                            datatype(?stageDate) = xsd:date &&
                            ?stageDate >= "2003-09-01"^^xsd:date
                        )
                    }
                """
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path nltl:iceClass ;
                        sh:in (
                            nltl:iceClassIaSuper
                            nltl:iceClassIa
                        )
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:constructionStageDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:maxExclusive "2003-09-01"^^xsd:date ;
                        sh:message "An applicable ship must have a construction stage date before 1 September 2003."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:engineOutputComplianceMethod ;
                        sh:nodeKind sh:IRI ;
                        sh:in (
                            nltl:traficom2017Section3Point2Point2Method
                            nltl:traficom2017Section3Point2Point4Method
                        ) ;
                        sh:minCount 1 ;
                        sh:message "An applicable ship must identify compliance with section 3.2.2 or section 3.2.4 of the 2017 Ice Class Regulations."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:deliveryDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:message "An applicable ship must have a delivery date to establish the twenty-year deadline."
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:assessmentDate ;
                        sh:datatype xsd:date ;
                        sh:minCount 1 ;
                        sh:message "An applicable ship must have an assessment date to verify the compliance deadline."
                    ]
                ]
                [
                    sh:sparql [
                        sh:message "The applicable ship must comply no later than 1 January of the year in which twenty years have elapsed since delivery." ;
                        sh:select """
                            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                $this nltl:deliveryDate ?deliveryDate ;
                                      nltl:assessmentDate ?assessmentDate .
                                FILTER (
                                    YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20 ||
                                    (
                                        YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20 &&
                                        (
                                            MONTH(?assessmentDate) > 1 ||
                                            (
                                                MONTH(?assessmentDate) = 1 &&
                                                DAY(?assessmentDate) > 1
                                            )
                                        )
                                    )
                                )
                            }
                        """
                    ]
                ]
            )
        )
    ) .
