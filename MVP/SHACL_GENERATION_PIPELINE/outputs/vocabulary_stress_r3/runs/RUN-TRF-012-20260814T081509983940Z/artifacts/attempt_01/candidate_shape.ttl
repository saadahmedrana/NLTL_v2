@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF012ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasLowerIceWaterline ;
        sh:class nltl:iceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:TRF012IceWaterlineShape ;
        sh:message "The ship must identify exactly one lower ice waterline with a validated profile."
    ] ;
    sh:property [
        sh:path nltl:hasIntendedIceOperatingWaterline ;
        sh:class nltl:iceWaterline ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node nltl:TRF012IceWaterlineShape ;
        sh:message "At least one intended ice-operating waterline is required to establish the lower envelope."
    ] ;
    sh:sparql [
        sh:message "Every lower-ice-waterline profile point must correspond to an intended ice-operating waterline point at the same longitudinal position and vertical coordinate." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasLowerIceWaterline ?liwl .
                ?liwl nltl:hasWaterlineProfilePoint ?lowerPoint .
                ?lowerPoint nltl:longitudinalPosition ?lowerXQuantity ;
                    nltl:verticalCoordinate ?lowerYQuantity .
                ?lowerXQuantity <http://qudt.org/schema/qudt/numericValue> ?lowerX .
                ?lowerYQuantity <http://qudt.org/schema/qudt/numericValue> ?lowerY .
                FILTER NOT EXISTS {
                    $this nltl:hasIntendedIceOperatingWaterline ?intended .
                    ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                    ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                        nltl:verticalCoordinate ?intendedYQuantity .
                    ?intendedXQuantity <http://qudt.org/schema/qudt/numericValue> ?intendedX .
                    ?intendedYQuantity <http://qudt.org/schema/qudt/numericValue> ?intendedY .
                    FILTER (
                        xsd:decimal(?intendedX) = xsd:decimal(?lowerX) &&
                        xsd:decimal(?intendedY) = xsd:decimal(?lowerY)
                    )
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "No intended ice-operating waterline may have a lower vertical coordinate than the lower ice waterline at the same longitudinal position." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasLowerIceWaterline ?liwl ;
                    nltl:hasIntendedIceOperatingWaterline ?intended .
                ?liwl nltl:hasWaterlineProfilePoint ?lowerPoint .
                ?lowerPoint nltl:longitudinalPosition ?lowerXQuantity ;
                    nltl:verticalCoordinate ?lowerYQuantity .
                ?lowerXQuantity <http://qudt.org/schema/qudt/numericValue> ?lowerX .
                ?lowerYQuantity <http://qudt.org/schema/qudt/numericValue> ?lowerY .
                ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity ;
                    nltl:verticalCoordinate ?intendedYQuantity .
                ?intendedXQuantity <http://qudt.org/schema/qudt/numericValue> ?intendedX .
                ?intendedYQuantity <http://qudt.org/schema/qudt/numericValue> ?intendedY .
                FILTER (
                    xsd:decimal(?intendedX) = xsd:decimal(?lowerX) &&
                    xsd:decimal(?intendedY) < xsd:decimal(?lowerY)
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every intended ice-operating waterline profile position must be represented on the lower ice waterline." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasLowerIceWaterline ?liwl ;
                    nltl:hasIntendedIceOperatingWaterline ?intended .
                ?intended nltl:hasWaterlineProfilePoint ?intendedPoint .
                ?intendedPoint nltl:longitudinalPosition ?intendedXQuantity .
                ?intendedXQuantity <http://qudt.org/schema/qudt/numericValue> ?intendedX .
                FILTER NOT EXISTS {
                    ?liwl nltl:hasWaterlineProfilePoint ?lowerPoint .
                    ?lowerPoint nltl:longitudinalPosition ?lowerXQuantity .
                    ?lowerXQuantity <http://qudt.org/schema/qudt/numericValue> ?lowerX .
                    FILTER (xsd:decimal(?lowerX) = xsd:decimal(?intendedX))
                }
            }
        """
    ] .

nltl:TRF012IceWaterlineShape
    a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:hasWaterlineProfilePoint ;
        sh:class nltl:waterlineProfilePoint ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:node nltl:TRF012ProfilePointShape ;
        sh:message "An ice waterline must have at least one validated waterline profile point."
    ] .

nltl:TRF012ProfilePointShape
    a sh:NodeShape ;
    sh:class nltl:waterlineProfilePoint ;
    sh:property [
        sh:path nltl:longitudinalPosition ;
        sh:node nltl:TRF012LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:verticalCoordinate ;
        sh:node nltl:TRF012LengthQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF012LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
