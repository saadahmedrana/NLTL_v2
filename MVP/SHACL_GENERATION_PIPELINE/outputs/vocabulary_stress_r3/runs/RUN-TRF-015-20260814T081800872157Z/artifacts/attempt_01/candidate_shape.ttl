@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF-015-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:intendedRouteSeaWaterSalinity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue nltl:gramPerKilogramSalinityUnit ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:loadingCalculationSeaWaterSalinity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue nltl:gramPerKilogramSalinityUnit ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:or (
        <urn:nltl:stress-shape:TRF-015-IceNavigationShape>
        <urn:nltl:stress-shape:TRF-015-NonIceNavigationShape>
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The loading-calculation sea-water salinity must equal the intended-route salinity, and when navigating in ice the operating draught and trim must not exceed their permitted limits." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:navigatingInIce ?ice ;
                      nltl:intendedRouteSeaWaterSalinity ?intendedNode ;
                      nltl:loadingCalculationSeaWaterSalinity ?loadingNode .
                ?intendedNode qudt:numericValue ?intendedValue ;
                              qudt:unit nltl:gramPerKilogramSalinityUnit .
                ?loadingNode qudt:numericValue ?loadingValue ;
                             qudt:unit nltl:gramPerKilogramSalinityUnit .
                FILTER (
                    ?loadingValue != ?intendedValue ||
                    (
                        ?ice = true &&
                        {
                            SELECT $this
                            WHERE {
                                $this nltl:operatingDraught ?draughtNode ;
                                      nltl:upperIceWaterlineDraught ?uiwlNode ;
                                      nltl:operatingTrim ?trimNode ;
                                      nltl:maximumPermittedIceTrim ?maxTrimNode .
                                ?draughtNode qudt:numericValue ?draughtValue ;
                                             qudt:unit unit:M .
                                ?uiwlNode qudt:numericValue ?uiwlValue ;
                                          qudt:unit unit:M .
                                ?trimNode qudt:numericValue ?trimValue ;
                                          qudt:unit unit:M .
                                ?maxTrimNode qudt:numericValue ?maxTrimValue ;
                                             qudt:unit unit:M .
                                FILTER (
                                    ?draughtValue > ?uiwlValue ||
                                    ?trimValue > ?maxTrimValue
                                )
                            }
                        }
                    )
                )
            }
        """
    ] .

<urn:nltl:stress-shape:TRF-015-IceNavigationShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:operatingDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDraught ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:operatingTrim ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:maximumPermittedIceTrim ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] .

<urn:nltl:stress-shape:TRF-015-NonIceNavigationShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:navigatingInIce ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
