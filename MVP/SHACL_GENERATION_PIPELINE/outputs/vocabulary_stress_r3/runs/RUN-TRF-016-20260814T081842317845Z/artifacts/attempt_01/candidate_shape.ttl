@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF-016> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:navigatingInIce ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasLowerIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasUpperIceWaterline ;
                sh:class nltl:iceWaterline ;
                sh:minCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF-016-UpperIceWaterline>
            ] ;
            sh:property [
                sh:path nltl:draughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF-016-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:liwlDraughtAmidships ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF-016-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:forwardDraught ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF-016-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:levelIceThickness ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF-016-LengthQuantity>
            ] ;
            sh:property [
                sh:path nltl:displacementAtUpperIceWaterline ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF-016-MassQuantity>
            ] ;
            sh:property [
                sh:path nltl:propellerHighestPointSubmerged ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasBallastTank ;
                sh:node <urn:nltl:stress-shape:TRF-016-BallastTank>
            ] ;
            sh:sparql [
                sh:message "When navigating in ice, amidships draught must reach the LIWL draught and forward draught must satisfy the UIWL displacement and level-ice-thickness formula." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
                    PREFIX q: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:draughtAmidships ?amidshipsQ ;
                              nltl:liwlDraughtAmidships ?liwlQ ;
                              nltl:forwardDraught ?forwardQ ;
                              nltl:levelIceThickness ?iceQ ;
                              nltl:displacementAtUpperIceWaterline ?shipDispQ .

                        ?amidshipsQ q:numericValue ?amidships .
                        ?liwlQ q:numericValue ?liwl .
                        ?forwardQ q:numericValue ?forward .
                        ?iceQ q:numericValue ?ice .
                        ?shipDispQ q:numericValue ?shipDisp .

                        {
                            SELECT ?ship (MAX(?waterlineDisp) AS ?maxDisp)
                            WHERE {
                                ?ship nltl:hasUpperIceWaterline ?waterline .
                                ?waterline nltl:waterlineDisplacement ?waterlineDispQ .
                                ?waterlineDispQ q:numericValue ?waterlineDisp .
                            }
                            GROUP BY ?ship
                        }

                        BIND(
                            IF(
                                ((2.0 + (0.00025 * ?maxDisp)) * ?ice)
                                < (4.0 * ?ice),
                                ((2.0 + (0.00025 * ?maxDisp)) * ?ice),
                                (4.0 * ?ice)
                            ) AS ?requiredForward
                        )

                        FILTER(
                            (?amidships < ?liwl)
                            ||
                            (
                                ABS(?shipDisp - ?maxDisp)
                                >
                                IF(
                                    ABS(?maxDisp) > 0.000001,
                                    0.000001 * ABS(?maxDisp),
                                    0.000001
                                )
                            )
                            ||
                            (
                                ?forward
                                +
                                IF(
                                    ABS(?requiredForward) > 0.000001,
                                    0.000001 * ABS(?requiredForward),
                                    0.000001
                                )
                                < ?requiredForward
                            )
                        )
                    }
                """
            ]
        ]
    ] .

<urn:nltl:stress-shape:TRF-016-LengthQuantity> a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/M>
    ] .

<urn:nltl:stress-shape:TRF-016-MassQuantity> a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path q:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/TON_Metric>
    ] .

<urn:nltl:stress-shape:TRF-016-UpperIceWaterline> a sh:NodeShape ;
    sh:class nltl:iceWaterline ;
    sh:property [
        sh:path nltl:waterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF-016-MassQuantity>
    ] .

<urn:nltl:stress-shape:TRF-016-BallastTank> a sh:NodeShape ;
    sh:class nltl:ballastTank ;
    sh:or (
        [
            sh:property [
                sh:path nltl:situatedAboveLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:usedToReachLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:situatedAboveLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:usedToReachLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:situatedAboveLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:usedToReachLowerIceWaterline ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:freezingPreventionPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
    ] .
