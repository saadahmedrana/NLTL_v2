@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:GeneratedQuantityValueShape a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloW> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

nltl:TRF023ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIaSuper
                    nltl:iceClassIa
                    nltl:iceClassIb
                    nltl:iceClassIc
                    nltl:iceClassIi
                    nltl:iceClassIii
                ) ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:in (
                    nltl:iceClassRegulationEdition2002
                    nltl:iceClassRegulationEdition2008
                    nltl:iceClassRegulationEdition2010
                    nltl:iceClassRegulationEdition2017
                    nltl:iceClassRegulationEdition2021
                ) ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassRegulationEditionValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:in (
                    nltl:iceClassIb
                    nltl:iceClassIc
                ) ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:hasValue nltl:iceClassRuleEdition1985 ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:iceClassRegulationEditionValue ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:maximumContinuousRatingPower ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:GeneratedQuantityValueShape
            ] ;
            sh:property [
                sh:path nltl:requiredPowerUnder1985Rules ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node nltl:GeneratedQuantityValueShape
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "For ice class IB or IC under the 1985 rules, maximum continuous rating power must be at least the required power under the 1985 rules." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?iceClass .
                FILTER (
                    ?iceClass = nltl:iceClassIb ||
                    ?iceClass = nltl:iceClassIc
                )

                $this nltl:applicableIceClassRegulationEdition
                    nltl:iceClassRuleEdition1985 .

                $this nltl:maximumContinuousRatingPower ?maximumPowerNode .
                ?maximumPowerNode qudt:numericValue ?maximumPower .

                $this nltl:requiredPowerUnder1985Rules ?requiredPowerNode .
                ?requiredPowerNode qudt:numericValue ?requiredPower .

                FILTER (
                    xsd:decimal(?maximumPower) <
                    xsd:decimal(?requiredPower)
                )
            }
        """
    ] .
