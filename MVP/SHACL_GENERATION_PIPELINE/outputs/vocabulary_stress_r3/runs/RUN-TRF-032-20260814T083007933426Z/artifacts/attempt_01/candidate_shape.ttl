@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF_032_ShipScantlingShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceStrengtheningStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "Ice strengthening status is required to determine applicability of the scantling rule."
    ] ;
    sh:property [
        sh:path nltl:regulationRequiredScantling ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The regulation-required scantling must be provided as a decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:classificationSocietyRequiredScantling ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The classification-society-required scantling must be provided as a decimal quantity."
    ] ;
    sh:property [
        sh:path nltl:selectedDesignScantling ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The selected design scantling, when supplied, must be a decimal quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceStrengtheningStatus ;
                sh:hasValue true
            ]
        ]
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For a ship that has not been ice strengthened, when the regulation-required scantling is less than the classification-society-required scantling, the selected design scantling must use the classification-society-required scantling." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceStrengtheningStatus false ;
                      nltl:regulationRequiredScantling ?regulation ;
                      nltl:classificationSocietyRequiredScantling ?classification .
                ?regulation qudt:numericValue ?regulationValue .
                ?classification qudt:numericValue ?classificationValue .
                FILTER (?regulationValue < ?classificationValue)
                FILTER (
                    NOT EXISTS {
                        $this nltl:selectedDesignScantling ?selected
                    }
                    ||
                    EXISTS {
                        $this nltl:selectedDesignScantling ?selected .
                        ?selected qudt:numericValue ?selectedValue .
                        FILTER (?selectedValue != ?classificationValue)
                    }
                )
            }
        """
    ] .
