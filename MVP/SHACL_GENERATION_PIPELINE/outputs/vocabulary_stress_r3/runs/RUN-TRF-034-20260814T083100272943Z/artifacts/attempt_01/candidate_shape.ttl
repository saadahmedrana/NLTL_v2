@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix ss: <urn:nltl:stress-shape:> .

ss:EffectiveMemberCrossSectionShape
    a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:CentiM3 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "An effective member cross section must provide section modulus in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:minCount 1 ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M2 ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "An effective member cross section must provide shear area in square metres."
    ] ;
    sh:property [
        sh:path (
            [ sh:inversePath nltl:hasEffectiveMemberCrossSection ]
            nltl:memberNormalToPlating
        ) ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "The member normal-to-plating applicability input is required for the effective member cross section."
    ] ;
    sh:sparql [
        sh:message "A member not normal to the plating must have classification-society section-property calculation evidence." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?hull nltl:hasEffectiveMemberCrossSection $this ;
                      nltl:memberNormalToPlating ?normal .
                FILTER (?normal = false)
                FILTER NOT EXISTS {
                    $this nltl:hasClassificationSocietySectionPropertyCalculationEvidence ?evidence .
                }
            }
        """
    ] .
