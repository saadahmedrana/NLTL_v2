@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF048LongitudinalFrameShape
    a sh:NodeShape ;
    sh:targetClass nltl:longitudinalFrame ;
    sh:property [
        sh:path nltl:icePressure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Ice pressure must be provided as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:designIceLoadHeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Design ice load height must be provided as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:spacing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame spacing must be provided as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:span ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame span must be provided as a single metre quantity."
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Yield strength must be provided as a single MPa quantity."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameLoadDistributionFactorF4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The longitudinal frame load distribution factor f4 must be provided as a single dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:longitudinalFrameShearFactorF5 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 2.16 ;
                sh:maxInclusive 2.16
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The longitudinal frame shear factor f5 must equal 2.16."
    ] ;
    sh:property [
        sh:path nltl:frameMomentFactorM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "The frame moment factor m must be provided as a single dimensionless quantity."
    ] ;
    sh:property [
        sh:path nltl:significantlyDifferentBoundaryConditions ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:hasValue false ;
                sh:property [
                    sh:path ( nltl:frameMomentFactorM qudt:numericValue ) ;
                    sh:minInclusive 13.3 ;
                    sh:maxInclusive 13.3
                ]
            ]
            [
                sh:hasValue true ;
                sh:property [
                    sh:path ( nltl:frameMomentFactorM qudt:numericValue ) ;
                    sh:maxExclusive 13.3
                ]
            ]
        ) ;
        sh:message "Boundary-condition status must select m = 13.3, or a smaller m when boundary conditions are significantly different."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Section modulus must be provided as a single cubic-centimetre quantity."
    ] ;
    sh:property [
        sh:path nltl:actualFrameShearArea ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Actual frame shear area must be provided as a single square-centimetre quantity."
    ] ;
    sh:sparql [
        sh:message "f4, section modulus, and actual frame shear area must satisfy the prescribed formulas; the actual shear-area formula excludes bracket area." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:spacing ?sNode ;
                      nltl:span ?lNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:longitudinalFrameLoadDistributionFactorF4 ?f4Node ;
                      nltl:longitudinalFrameShearFactorF5 ?f5Node ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:actualFrameShearArea ?aNode .

                ?pNode qudt:numericValue ?p ;
                       qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?hNode qudt:numericValue ?h ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?sNode qudt:numericValue ?s ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?lNode qudt:numericValue ?l ;
                       qudt:unit <http://qudt.org/vocab/unit/M> .
                ?sigmaNode qudt:numericValue ?sigma ;
                           qudt:unit <http://qudt.org/vocab/unit/MegaPA> .
                ?f4Node qudt:numericValue ?f4 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?f5Node qudt:numericValue ?f5 ;
                        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?mNode qudt:numericValue ?m ;
                       qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                ?zNode qudt:numericValue ?z ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM3> .
                ?aNode qudt:numericValue ?a ;
                       qudt:unit <http://qudt.org/vocab/unit/CentiM2> .

                BIND ((1 - (0.2 * ?h / ?s)) AS ?expectedF4)
                BIND ((?expectedF4 * ?p * ?h * ?l * ?l /
                       (4 * ?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND ((1.7320508075688773 * ?expectedF4 * ?f5 * ?p * ?h * ?l /
                       (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER (
                    ABS(?f4 - ?expectedF4) >
                        (0.000001 * ABS(?expectedF4) + 0.000000001)
                    ||
                    ABS(?z - ?expectedZ) >
                        (0.000001 * ABS(?expectedZ) + 0.000000001)
                    ||
                    ABS(?a - ?expectedA) >
                        (0.000001 * ABS(?expectedA) + 0.000000001)
                )
            }
        """
    ] .
