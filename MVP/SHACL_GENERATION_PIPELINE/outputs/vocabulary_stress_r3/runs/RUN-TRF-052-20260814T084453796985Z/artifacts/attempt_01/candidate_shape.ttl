@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF052FrameShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:or (
        <urn:nltl:stress-shape:TRF052AlternativeShape>
        <urn:nltl:stress-shape:TRF052StandardShape>
    ) .

<urn:nltl:stress-shape:TRF052AlternativeShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "An alternative arrangement requires demonstrated equivalent support by direct calculation."
    ] .

<urn:nltl:stress-shape:TRF052StandardShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:node <urn:nltl:stress-shape:LengthAngleQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node <urn:nltl:stress-shape:FrameSpanQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:antitrippingSupportSpacing ;
        sh:node <urn:nltl:stress-shape:SpacingQuantityShape> ;
        sh:maxCount 1
    ] ;
    sh:or (
        <urn:nltl:stress-shape:TRF052SpanGreaterThanFourShape>
        <urn:nltl:stress-shape:TRF052SpanAtMostFourShape>
    ) ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "When the frame is asymmetrical or its web angle to the shell is less than 90 degrees, antitripping support spacing must not exceed 1300 mm." ;
        sh:select """
PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:frameAsymmetrical ?asymmetrical .
    $this nltl:frameWebAngleToShell ?angleQuantity .
    ?angleQuantity qudt:numericValue ?angle .
    FILTER (?asymmetrical = true || ?angle < 90)
    FILTER NOT EXISTS {
        $this nltl:antitrippingSupportSpacing ?spacingQuantity .
        ?spacingQuantity qudt:numericValue ?spacing .
        FILTER (?spacing <= 1300)
    }
}
"""
    ] .

<urn:nltl:stress-shape:TRF052SpanGreaterThanFourShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:minExclusive 4
            ]
        ]
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:midbodyRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:sternRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:otherIceStrengthenedAreaValue ;
        sh:minCount 1
    ] .

<urn:nltl:stress-shape:TRF052SpanAtMostFourShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:maxInclusive 4
            ]
        ]
    ] ;
    sh:or (
        <urn:nltl:stress-shape:TRF052IaSuperScopeShape>
        <urn:nltl:stress-shape:TRF052IaScopeShape>
        <urn:nltl:stress-shape:TRF052IbIcScopeShape>
    ) .

<urn:nltl:stress-shape:TRF052IaSuperScopeShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIaSuper ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:midbodyRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:sternRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:otherIceStrengthenedAreaValue ;
        sh:minCount 1
    ] .

<urn:nltl:stress-shape:TRF052IaScopeShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:hasValue nltl:iceClassIa ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:midbodyRegion ;
        sh:minCount 1
    ] .

<urn:nltl:stress-shape:TRF052IbIcScopeShape>
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIb ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceClass ;
                sh:hasValue nltl:iceClassIc ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:hasAntitrippingSupportRegion ;
        sh:hasValue nltl:bowRegion ;
        sh:minCount 1
    ] .

<urn:nltl:stress-shape:LengthAngleQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:FrameSpanQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:SpacingQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
