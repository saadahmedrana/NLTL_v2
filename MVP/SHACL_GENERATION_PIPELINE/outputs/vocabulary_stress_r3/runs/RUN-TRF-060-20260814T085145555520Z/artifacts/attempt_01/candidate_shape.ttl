@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:AreaCm2QuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:AreaM2QuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M2> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:LengthMQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:ForceKNQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:TorqueMNmQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:StressMPaQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:DimensionlessQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:TableLookupCaseShape>
    a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:webFrameTable4Dash8GammaFactor ;
        sh:node <urn:nltl:stress-shape:DimensionlessQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The table lookup case must provide one dimensionless Table 4-8 gamma factor."
    ] ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable4Dash8 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The lookup case must reference Traficom Table 4-8."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:class nltl:evidenceArtifact ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The table lookup case must provide one selection evidence artifact."
    ] .

<urn:nltl:stress-shape:TRF060Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:webFrameIceLoad ;
        sh:node <urn:nltl:stress-shape:ForceKNQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameSpan ;
        sh:node <urn:nltl:stress-shape:LengthMQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameFreeFlangeArea ;
        sh:node <urn:nltl:stress-shape:AreaCm2QuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameWebArea ;
        sh:node <urn:nltl:stress-shape:AreaCm2QuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:actualWebFrameCrossSectionalArea ;
        sh:node <urn:nltl:stress-shape:AreaCm2QuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:requiredShearArea ;
        sh:node <urn:nltl:stress-shape:AreaCm2QuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:node <urn:nltl:stress-shape:AreaM2QuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:node <urn:nltl:stress-shape:StressMPaQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:webFrameMaximumIceLoadBendingMoment ;
        sh:node <urn:nltl:stress-shape:TorqueMNmQuantityShape> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:hasTableLookupCase ;
        sh:node <urn:nltl:stress-shape:TableLookupCaseShape> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "One Table 4-8 lookup case is required for the web-frame calculation."
    ] ;

    sh:sparql [
        sh:message "The web-frame bending moment and actual area must satisfy M = 0.193*F*L and A_a = A_f + A_w within a relative tolerance of 1e-6."
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:webFrameIceLoad ?fNode ;
                      nltl:webFrameSpan ?lNode ;
                      nltl:webFrameMaximumIceLoadBendingMoment ?mNode ;
                      nltl:webFrameFreeFlangeArea ?afNode ;
                      nltl:webFrameWebArea ?awNode ;
                      nltl:actualWebFrameCrossSectionalArea ?aaNode .

                ?fNode qudt:numericValue ?f .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?afNode qudt:numericValue ?af .
                ?awNode qudt:numericValue ?aw .
                ?aaNode qudt:numericValue ?aa .

                BIND ((0.193 * (?f / 1000.0) * ?l) AS ?expectedM)
                BIND ((?af + ?aw) AS ?expectedAa)

                FILTER (
                    ?f <= 0.0 ||
                    ?l <= 0.0 ||
                    ?m < 0.0 ||
                    ?aa < 0.0 ||
                    ABS(?m - ?expectedM) > (1e-6 * (ABS(?expectedM) + 1e-12)) ||
                    ABS(?aa - ?expectedAa) > (1e-6 * (ABS(?expectedAa) + 1e-12))
                )
            }
        """
    ] ;

    sh:sparql [
        sh:message "The section modulus must satisfy the specified web-frame formula within a relative tolerance of 1e-6."
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:webFrameIceLoad ?fNode ;
                      nltl:webFrameSpan ?lNode ;
                      nltl:webFrameMaximumIceLoadBendingMoment ?mNode ;
                      nltl:yieldStrength ?syNode ;
                      nltl:requiredShearArea ?aNode ;
                      nltl:actualWebFrameCrossSectionalArea ?aaNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:hasTableLookupCase ?case .

                ?fNode qudt:numericValue ?f .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?syNode qudt:numericValue ?sy .
                ?aNode qudt:numericValue ?a .
                ?aaNode qudt:numericValue ?aa .
                ?zNode qudt:numericValue ?z .
                ?case nltl:webFrameTable4Dash8GammaFactor ?gammaNode .
                ?gammaNode qudt:numericValue ?gamma .

                BIND ((0.193 * (?f / 1000.0) * ?l) AS ?expectedM)
                BIND ((?gamma * ?a / ?aa) AS ?ratio)
                BIND (((?expectedM / ?sy) * (?expectedM / ?sy) / (1.0 - (?ratio * ?ratio))) * 1000000000000.0 AS ?expectedZSquared)
                BIND ((?z * ?z) AS ?actualZSquared)

                FILTER (
                    ?f <= 0.0 ||
                    ?l <= 0.0 ||
                    ?sy <= 0.0 ||
                    ?aa <= 0.0 ||
                    ?a < 0.0 ||
                    ?gamma < 0.0 ||
                    ?ratio >= 1.0 ||
                    ?z < 0.0 ||
                    ABS(?actualZSquared - ?expectedZSquared) >
                    (1e-6 * (ABS(?expectedZSquared) + 1e-12))
                )
            }
        """
    ] .
