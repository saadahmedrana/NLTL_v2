@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:SidePropellerStrengtheningEnvelopeShape
    a sh:NodeShape ;
    sh:class nltl:sidePropellerStrengtheningEnvelope ;
    sh:property [
        sh:path nltl:strengtheningForwardExtent ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 1.5 ;
            sh:maxInclusive 1.5
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] ;
    sh:property [
        sh:path nltl:strengtheningAftExtent ;
        sh:class qudt:QuantityValue ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:property [
            sh:path qudt:numericValue ;
            sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 1.5 ;
            sh:maxInclusive 1.5
        ] ;
        sh:property [
            sh:path qudt:unit ;
            sh:hasValue <http://qudt.org/vocab/unit/M> ;
            sh:minCount 1 ;
            sh:maxCount 1
        ]
    ] .

nltl:TRF063ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 2 ;
                sh:maxInclusive 2
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
                sh:node nltl:SidePropellerStrengtheningEnvelopeShape ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerCount ;
                sh:datatype xsd:integer ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:minInclusive 3 ;
                sh:maxInclusive 3
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerStrengtheningEnvelope ;
                sh:node nltl:SidePropellerStrengtheningEnvelopeShape ;
                sh:minCount 1
            ]
        ]
    ) .
