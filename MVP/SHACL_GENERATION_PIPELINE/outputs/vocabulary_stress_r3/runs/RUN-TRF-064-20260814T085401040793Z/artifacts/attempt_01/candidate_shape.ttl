@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix stress: <urn:nltl:stress-shape:> .

stress:TRF064ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The detached-strut applicability value must be recorded as exactly one boolean."
    ] ;
    sh:or (
        stress:TRF064DetachedStrutBranch
        stress:TRF064PlatedBossingBranch
    ) .

stress:TRF064DetachedStrutBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:hasValue true
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:minCount 1 ;
        sh:class nltl:detachedStrutStructure ;
        sh:node stress:TRF064DetachedStrutShape ;
        sh:message "A detached strut must have design, strength, and hull-attachment evidence."
    ] .

stress:TRF064DetachedStrutShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutDesignEvidence
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutStrengthEvidence
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:class nltl:strutHullAttachmentEvidence
    ] .

stress:TRF064PlatedBossingBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:hasValue false
    ] ;
    sh:property [
        sh:path nltl:hasDetachedStrut ;
        sh:maxCount 0
    ] ;
    sh:property [
        sh:path nltl:hasSidePropellerShafting ;
        sh:node stress:TRF064SideShaftingShape ;
        sh:message "Each represented side-propeller shafting assembly must be enclosed within plated bossing."
    ] ;
    sh:property [
        sh:path nltl:hasSternTube ;
        sh:node stress:TRF064SternTubeShape ;
        sh:message "Each represented side-propeller stern tube must be enclosed within plated bossing."
    ] .

stress:TRF064SideShaftingShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure
    ] .

stress:TRF064SternTubeShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:minCount 1 ;
        sh:class nltl:platedBossingStructure
    ] .
