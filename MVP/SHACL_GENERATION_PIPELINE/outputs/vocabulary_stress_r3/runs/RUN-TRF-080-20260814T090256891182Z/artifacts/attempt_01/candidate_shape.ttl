@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF-080-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceLoadCycleCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "The ship must provide the number of ice load cycles (Nice)." ;
    ] ;
    sh:property [
        sh:path nltl:propellerBladeCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "The ship must provide the number of propeller blades (Z)." ;
    ] ;
    sh:property [
        sh:path nltl:effectiveIceLoadCycleCount ;
        sh:node <urn:nltl:stress-shape:TRF-080-QuantityValueShape> ;
        sh:minCount 1 ;
        sh:message "The effective ice load cycle count must be provided as a unitless quantity." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The effective ice load cycle count must equal Nice multiplied by the number of propeller blades, within a relative tolerance of 1e-6 and an absolute fallback of 1e-9." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                       nltl:propellerBladeCount ?blades ;
                       nltl:effectiveIceLoadCycleCount ?quantity .
                ?quantity qudt:numericValue ?actual ;
                          qudt:unit qudt:UNITLESS .
                BIND(
                    xsd:decimal(?nice) * xsd:decimal(?blades)
                    AS ?expected
                )
                FILTER(
                    ABS(xsd:decimal(?actual) - ?expected)
                    >
                    (0.000001 * ABS(?expected) + 0.000000001)
                )
            }
        """ ;
    ] .

<urn:nltl:stress-shape:TRF-080-QuantityValueShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The effective ice load cycle count quantity must have one decimal numeric value." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:UNITLESS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The effective ice load cycle count must use the unitless unit." ;
    ] .
