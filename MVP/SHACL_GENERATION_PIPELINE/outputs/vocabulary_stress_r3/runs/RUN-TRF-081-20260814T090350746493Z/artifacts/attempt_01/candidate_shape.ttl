@prefix gen: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue unit:KiloN ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

gen:TRF081Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:forwardBladeForce ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Forward blade force must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:backwardBladeForce ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Backward blade force must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:hydrodynamicBollardThrust ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Hydrodynamic bollard thrust must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:forwardIceThrust ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Forward ice thrust must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:backwardIceThrust ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Backward ice thrust must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:forwardPropellerShaftDesignThrust ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Forward propeller shaft design thrust must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:backwardPropellerShaftDesignThrust ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Backward propeller shaft design thrust must be provided as a single force quantity in kN."
    ] ;

    sh:property [
        sh:path nltl:propellerShaftDesignThrust ;
        sh:node gen:ForceQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Propeller shaft design thrust must be provided as a single force quantity in kN."
    ] ;

    sh:sparql [
        sh:message "Ice thrust and propeller shaft design thrust formulas must conform within a relative tolerance of 1e-6, with an absolute fallback near zero." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:forwardBladeForce ?ffNode ;
                      nltl:backwardBladeForce ?fbNode ;
                      nltl:hydrodynamicBollardThrust ?tNode ;
                      nltl:forwardIceThrust ?tfNode ;
                      nltl:backwardIceThrust ?tbNode ;
                      nltl:forwardPropellerShaftDesignThrust ?forwardDesignNode ;
                      nltl:backwardPropellerShaftDesignThrust ?backwardDesignNode ;
                      nltl:propellerShaftDesignThrust ?designNode .

                ?ffNode qudt:numericValue ?ff .
                ?fbNode qudt:numericValue ?fb .
                ?tNode qudt:numericValue ?t .
                ?tfNode qudt:numericValue ?tf .
                ?tbNode qudt:numericValue ?tb .
                ?forwardDesignNode qudt:numericValue ?forwardDesign .
                ?backwardDesignNode qudt:numericValue ?backwardDesign .
                ?designNode qudt:numericValue ?design .

                BIND (1.1 * ?ff AS ?expectedTf)
                BIND (1.1 * ?fb AS ?expectedTb)
                BIND (?t + 2.2 * ?expectedTf AS ?expectedForwardDesign)
                BIND (1.5 * ?expectedTb AS ?expectedBackwardDesign)
                BIND (
                    IF(
                        ?expectedForwardDesign >= ?expectedBackwardDesign,
                        ?expectedForwardDesign,
                        ?expectedBackwardDesign
                    )
                    AS ?expectedDesign
                )

                FILTER (
                    ABS(?tf - ?expectedTf) >
                        0.000001 * IF(ABS(?expectedTf) > 1, ABS(?expectedTf), 1)
                    ||
                    ABS(?tb - ?expectedTb) >
                        0.000001 * IF(ABS(?expectedTb) > 1, ABS(?expectedTb), 1)
                    ||
                    ABS(?forwardDesign - ?expectedForwardDesign) >
                        0.000001 * IF(ABS(?expectedForwardDesign) > 1, ABS(?expectedForwardDesign), 1)
                    ||
                    ABS(?backwardDesign - ?expectedBackwardDesign) >
                        0.000001 * IF(ABS(?expectedBackwardDesign) > 1, ABS(?expectedBackwardDesign), 1)
                    ||
                    ABS(?design - ?expectedDesign) >
                        0.000001 * IF(ABS(?expectedDesign) > 1, ABS(?expectedDesign), 1)
                )
            }
        """
    ] .
