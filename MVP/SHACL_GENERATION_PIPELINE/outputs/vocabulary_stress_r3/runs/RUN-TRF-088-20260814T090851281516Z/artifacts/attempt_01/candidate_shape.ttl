@prefix gen: <urn:nltl:stress-shape:> .
@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TorqueQuantityShape a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque quantity must have one decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue qudt:KiloN-M ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque must use the kN*m unit."
    ] .

gen:TableLookupCaseShape a sh:NodeShape ;
    sh:class nltl:tableLookupCase ;
    sh:property [
        sh:path nltl:tableReference ;
        sh:hasValue nltl:traficomTable6Dash10 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The unknown maximum torque must select the cited TRAFICOM Table 6-10 reference."
    ] ;
    sh:property [
        sh:path nltl:lookupSelectionEvidence ;
        sh:node [
            sh:class nltl:evidenceArtifact
        ] ;
        sh:minCount 1 ;
        sh:message "The table lookup case must identify lookup selection evidence."
    ] .

gen:TRF088Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:maximumEngineTorqueKnown ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Maximum engine torque known status is required to select the applicable branch."
    ] ;
    sh:property [
        sh:path nltl:maximumEngineTorque ;
        sh:node gen:TorqueQuantityShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must provide its maximum engine torque quantity."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:maximumEngineTorqueKnown ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:maximumEngineTorqueKnown ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasTableLookupCase ;
                sh:node gen:TableLookupCaseShape ;
                sh:minCount 1 ;
                sh:message "When maximum engine torque is unknown, a Table 6-10 lookup case is required."
            ]
        ]
    ) .
