@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

nltl:TRF091Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasIceMillingSequenceCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceMillingSequenceCase ;
        sh:minCount 1 ;
        sh:message "The ship shall identify a case in which the propeller is milling an ice block."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:loadCase ;
        sh:minCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path nltl:loadCasePurpose ;
                sh:nodeKind sh:IRI ;
                sh:class nltl:loadCasePurposeValue ;
                sh:in ( nltl:propulsionLineStrengthEvaluationPurpose ) ;
                sh:minCount 1 ;
                sh:message "The propulsion load case shall be designated for propulsion line strength evaluation and not for stalling analysis."
            ]
        ] ;
        sh:message "The ship shall identify a propulsion load case used for the required strength evaluation."
    ] .
