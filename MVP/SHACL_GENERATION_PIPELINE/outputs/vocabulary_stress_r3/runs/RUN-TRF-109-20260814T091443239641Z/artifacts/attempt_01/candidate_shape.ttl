@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF_109_Shape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fatigueFactorRho ;
        sh:node [
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:UNITLESS ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
    ] ;
    sh:sparql [
        sh:message "When fatigue factor rho is represented, ice load cycle count must be present." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:fatigueFactorRho ?rho .
                FILTER NOT EXISTS {
                    $this nltl:iceLoadCycleCount ?nice .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "The ice load cycle count used for calculating fatigue factor rho must be between 5000000 and 100000000 inclusive." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:fatigueFactorRho ?rho .
                $this nltl:iceLoadCycleCount ?nice .
                FILTER (
                    datatype(?nice) != xsd:integer
                    || ?nice < 5000000
                    || ?nice > 100000000
                )
            }
        """
    ] .
