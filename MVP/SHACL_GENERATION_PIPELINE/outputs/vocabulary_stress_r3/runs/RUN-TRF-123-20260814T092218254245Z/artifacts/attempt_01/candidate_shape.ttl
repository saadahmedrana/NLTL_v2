@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF123-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:yieldStrength ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-YieldStrengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:hasOccasionalForceLoadCase ;
        sh:minCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-OccasionalForceLoadCaseShape>
    ] ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-PropellerShaftLineComponentShape>
    ] .

<urn:nltl:stress-shape:TRF123-YieldStrengthQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:TRF123-OccasionalForceLoadCaseShape>
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ]
        [
            sh:property [
                sh:path nltl:propellerBladeExcludedFromOccasionalForceScope ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path nltl:occasionalForceCaseAssessedComponent ;
                sh:minCount 1 ;
                sh:node <urn:nltl:stress-shape:TRF123-AssessedComponentShape>
            ]
        ]
    ) ;
    sh:property [
        sh:path nltl:componentYieldSafetyFactor ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-SafetyFactorQuantityShape>
    ] ;
    sh:sparql [
        sh:message "For an applicable occasional-force load case, component stress multiplied by the safety factor must not exceed the component material yield strength." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerBladeExcludedFromOccasionalForceScope false ;
                      nltl:componentYieldSafetyFactor [
                          qudt:numericValue ?factor ;
                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS>
                      ] ;
                      nltl:occasionalForceCaseAssessedComponent ?component .
                ?component nltl:occasionalForceComponentStress [
                    qudt:numericValue ?stress ;
                    qudt:unit <http://qudt.org/vocab/unit/MegaPA>
                ] ;
                nltl:hasMaterialProperties ?properties .
                ?properties nltl:componentMaterialYieldStrength [
                    qudt:numericValue ?yield ;
                    qudt:unit <http://qudt.org/vocab/unit/MegaPA>
                ] .
                FILTER (?stress * ?factor > ?yield)
            }
        """
    ] .

<urn:nltl:stress-shape:TRF123-SafetyFactorQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:TRF123-AssessedComponentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:materialYieldStrength ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-MaterialYieldStrengthQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:occasionalForceComponentStress ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-StressQuantityShape>
    ] ;
    sh:property [
        sh:path nltl:hasMaterialProperties ;
        sh:minCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-MaterialPropertiesShape>
    ] .

<urn:nltl:stress-shape:TRF123-PropellerShaftLineComponentShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:materialYieldStrength ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-MaterialYieldStrengthQuantityShape>
    ] .

<urn:nltl:stress-shape:TRF123-MaterialPropertiesShape>
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:componentMaterialYieldStrength ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node <urn:nltl:stress-shape:TRF123-MaterialYieldStrengthQuantityShape>
    ] .

<urn:nltl:stress-shape:TRF123-MaterialYieldStrengthQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:nltl:stress-shape:TRF123-StressQuantityShape>
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .
