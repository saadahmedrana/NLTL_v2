@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<nltl:TRF126Shape> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:propulsionEngineReversedForAstern ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The propulsion engine astern-reversal applicability value must be recorded as a single boolean."
    ] ;
    sh:property [
        sh:path nltl:airReceiverConsecutiveStartCapacity ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:message "The air receiver consecutive-start capacity must be recorded."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:minInclusive 12 ;
                sh:message "When the propulsion engine must be reversed for astern movement, the air receiver capacity must provide at least 12 consecutive starts."
            ]
        ]
        [
            sh:property [
                sh:path nltl:propulsionEngineReversedForAstern ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:airReceiverConsecutiveStartCapacity ;
                sh:minInclusive 6 ;
                sh:message "When the propulsion engine does not have to be reversed for astern movement, the air receiver capacity must provide at least 6 consecutive starts."
            ]
        ]
    ) .
