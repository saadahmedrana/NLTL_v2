@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF-127-ShipShape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:airReceiverServesAdditionalPurpose ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must state whether its air receivers serve purposes other than starting the propulsion engine."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:airReceiverServesAdditionalPurpose ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:airReceiverServesAdditionalPurpose ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:additionalPurposeRequiredAirCapacity ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:airReceiverCapacity ;
                sh:minCount 1 ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:M3 ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ]
        ]
    ) ;
    sh:sparql [
        sh:message "When air receivers serve an additional purpose, their air receiver capacity must be at least the required capacity for that purpose." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT ?this
            WHERE {
                ?this nltl:airReceiverServesAdditionalPurpose true ;
                      nltl:additionalPurposeRequiredAirCapacity ?requiredCapacity ;
                      nltl:airReceiverCapacity ?receiverCapacity .
                ?requiredCapacity qudt:numericValue ?requiredValue .
                ?receiverCapacity qudt:numericValue ?receiverValue .
                FILTER (?receiverValue < ?requiredValue)
            }
        """
    ] .
