@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix stress: <urn:nltl:stress-shape:> .

stress:TRF131Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:ballastWaterCoolingArrangement ;
        sh:datatype xsd:string ;
        sh:message "A ballast water cooling arrangement must be represented as a string when provided."
    ] ;
    sh:property [
        sh:path nltl:substituteArrangementStatus ;
        sh:datatype xsd:boolean ;
        sh:message "The substitute arrangement status must be boolean when provided."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ballast water cooling arrangement cannot be accepted as a substitute for an inlet chest." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl-benchmark/vocab#>
            SELECT $this
            WHERE {
                $this nltl:ballastWaterCoolingArrangement ?arrangement ;
                      nltl:substituteArrangementStatus true .
            }
        """
    ] .
