@prefix nltl: <https://w3id.org/nltl-benchmark/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:stress-shape:TRF-133-Shape>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:nodeKind sh:IRI ;
        sh:in (
            nltl:iceClassIaSuper
            nltl:iceClassIa
            nltl:iceClassIb
            nltl:iceClassIc
            nltl:iceClassIi
            nltl:iceClassIii
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship must have one permitted Finnish-Swedish ice class."
    ] ;
    sh:property [
        sh:path nltl:hasIceClassDraughtMarking ;
        sh:node [
            sh:class nltl:iceClassDraughtMarking ;
            sh:property [
                sh:path nltl:draughtMarkAftOffset ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "540"^^xsd:decimal ;
                        sh:maxInclusive "540"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The ice class draught mark must be 540 mm abaft its applicable reference point."
            ] ;
            sh:property [
                sh:path nltl:draughtMarkAftReferencePoint ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:loadLineRingCentreReference
                    nltl:timberLoadLineVerticalReference
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The draught mark must reference the load line ring centre or, if applicable, the timber load line vertical reference."
            ] ;
            sh:property [
                sh:path nltl:letterDimensionsEqualLoadLineMark ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The dimensions of the letters must equal those used in the load line mark."
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must have an ice class draught marking."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangle ;
        sh:node [
            sh:class nltl:hullStructure ;
            sh:property [
                sh:path nltl:markingPlateThickness ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "5"^^xsd:decimal ;
                        sh:maxInclusive "8"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The marking plate thickness must be between 5 mm and 8 mm."
            ] ;
            sh:property [
                sh:path nltl:markingWeldedToShipSide ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The marks and figures must be welded to the ship's side."
            ] ;
            sh:property [
                sh:path nltl:reflectingMarkingColour ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:redReflectingMarkingColour
                    nltl:yellowReflectingMarkingColour
                ) ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The marks and figures must have a red or yellow reflecting colour."
            ] ;
            sh:property [
                sh:path nltl:markingPlainlyVisibleInIceConditions ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The marks and figures must be plainly visible in ice conditions."
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must have the required warning triangle hull marking."
    ] ;
    sh:property [
        sh:path nltl:hasWarningTriangleMarking ;
        sh:node [
            sh:class nltl:warningTriangleMarking ;
            sh:property [
                sh:path nltl:verticalOffsetAboveSummerFreshWaterLoadLine ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "1000"^^xsd:decimal ;
                        sh:maxInclusive "1000"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The upper edge of the warning triangle must be 1000 mm above the summer fresh water load line."
            ] ;
            sh:property [
                sh:path nltl:warningTriangleSideLength ;
                sh:node [
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minInclusive "300"^^xsd:decimal ;
                        sh:maxInclusive "300"^^xsd:decimal ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:hasValue unit:MilliM ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ] ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "Each side of the warning triangle must be 300 mm long."
            ] ;
            sh:property [
                sh:path nltl:markingAtOrBelowDeckLine ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The warning triangle must not be higher than the deck line."
            ]
        ] ;
        sh:minCount 1 ;
        sh:message "The ship must have the required warning triangle marking."
    ] .
