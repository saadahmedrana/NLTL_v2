{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NLTL bulk RDF evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_id", "items"],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "variant_id", "requirement_ids", "shape_file", "data_file"],
        "properties": {
          "case_id": {"type": "string"},
          "variant_id": {"type": "string"},
          "case_level": {"type": "string"},
          "requirement_ids": {"type": "array", "items": {"type": "string"}},
          "shape_file": {"type": "string"},
          "data_file": {"type": "string"},
          "expected_conforms": {"type": ["boolean", "null"]}
        }
      }
    }
  }
}

