@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix req: <http://example.com/powertrain-requirements#> .
@prefix ssp: <https://w3id.org/mtl-requirements/ssp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
# Master ship based on Annex I Sample Ship #1 from the Finnish-Swedish / TRAFICOM powering example.
# Goal: a rich baseline individual that can be mutated into pass/fail rule-specific test ships later.

ssp:iceShip a ssp:System ;
    ssp:iceClass "IA Super" ;
    ssp:propellerType "CP" ;
    ssp:hasComponent ssp:Hull001 , ssp:Engine001 , ssp:MainPropeller , ssp:Rudder001 ;
    ssp:hasVariable
        ssp:waterlineAngle,
        ssp:stemRake,
        ssp:bowRake,
        ssp:shipLength,
        ssp:maxBreadth,
        ssp:draught,
        ssp:bowLength,
        ssp:parallelMidshipLength,
        ssp:bowWaterlineArea,
        ssp:numberOfPropellers,
        ssp:minimumEnginePowerCalc,
        ssp:contractionDate,
        ssp:regulatoryVersion,
        ssp:forwardDraught,
        ssp:aftDraught,
        ssp:midshipsDraught,
        ssp:displacement,
        ssp:levelIceThickness,
        ssp:serviceSpeed,
        ssp:loadArea,
        ssp:frameSpacing,
        ssp:brashIceThickness,
        ssp:cMuCoefficient,
        ssp:KeValue,
        ssp:ltb2Term,
        ssp:nominalIcePressure,
        ssp:kFactor,
        ssp:cdFactor,
        ssp:cpFactorBow,
        ssp:cpFactorMidbody,
        ssp:cpFactorStern,
        ssp:seaInletLocation,
        ssp:strainerPlateAreaRatio .

ssp:Hull001 a ssp:Hull ;
    ssn:isPropertyOf ssp:iceShip .

ssp:HullSub001 a ssp:HullSection ;
    ssn:isPropertyOf ssp:Hull001 .

ssp:Engine001 a ssp:Engine ;
    ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariable
        ssp:EngineMinPower,
        ssp:engineRequiresReversal,
        ssp:airReceiverCapacity,
        ssp:airCompressorChargeTime.

ssp:MainPropeller a ssp:Propeller ;
    ssn:isPropertyOf ssp:iceShip .

ssp:Rudder001 a ssp:Rudder ;
    ssn:isPropertyOf ssp:iceShip .

ssp:Rudder001 ssp:hasVariable
    ssp:rudderServiceSpeed,
    ssp:hasIceKnife,
    ssp:hasRudderStoppers,
    ssp:hasHydraulicReliefValves .

# -----------------------------
# Core powering geometry from Annex I Sample Ship #1
# -----------------------------
ssp:waterlineAngle ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 24.0 .

ssp:stemRake ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 90.0 .

ssp:bowRake ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 30.0 .

ssp:shipLength ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 150.0 .

ssp:maxBreadth ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 25.0 .

ssp:draught ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 9.0 .

ssp:bowLength ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 45.0 .

ssp:parallelMidshipLength ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 70.0 .

ssp:bowWaterlineArea ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 500.0 .

ssp:propellerDiameter ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 5.0 .

ssp:numberOfPropellers ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 1 .

ssp:propellerIsOpenType ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue true .

ssp:propellerPitch07Bollard ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 4.5 .

ssp:EngineMinPower ssn:isPropertyOf ssp:Engine001 ;
    ssp:hasVariableValue 2500.0 .

ssp:minimumEnginePowerCalc ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 2500.0 .

# -----------------------------
# Applicability / metadata
# -----------------------------
ssp:contractionDate ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue "2022-01-01"^^xsd:date .

ssp:regulatoryVersion ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue "2021" .

# -----------------------------
# Waterlines and draughts
# -----------------------------
ssp:UIWL ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 10.0 .

ssp:LIWL ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 8.0 .

ssp:forwardDraught ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 9.0 .

ssp:aftDraught ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 9.0 .

ssp:midshipsDraught ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 9.0 .

ssp:displacement ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 20000.0 .

ssp:levelIceThickness ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 1.0 .

# -----------------------------
# Section 3 / 4 supporting values
# -----------------------------
ssp:HullSpeed ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 19.0 .

# Keep service speed below 18 to avoid triggering the advisory upper-bow strengthening shape,
# while still keeping HullSpeed compliant for the 20-knot IA Super requirement.
ssp:serviceSpeed ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 17.0 .

ssp:iceLoadMaxHeight ssn:isPropertyOf ssp:Hull001 , ssp:HullSub001 ;
    ssp:hasVariableValue 0.30 .

ssp:loadArea ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 1.5 .

ssp:frameSpacing ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 0.8 .

ssp:loadDistribution ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.625 .

ssp:IceResistance ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 9940.790366227585 .

ssp:brashIceThickness ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 1.0 .

ssp:cMuCoefficient ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 0.40 .

ssp:KeValue ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 1.60 .

ssp:ltb2Term ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 20.0 .

ssp:nominalIcePressure ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 4.0 .

ssp:kFactor ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 12.521980674 .

ssp:cdFactor ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 0.5 .

ssp:cpFactorBow ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 0.7 .

ssp:cpFactorMidbody ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 0.7 .

ssp:cpFactorStern ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 0.5 .

ssp:caFactor ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.5 .

ssp:hullRegion ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue "UnknownRegion" .

ssp:framingType ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue "Transverse" .

ssp:designIcePressure ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.5 .

ssp:icePressure ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.5 .

ssp:yieldStress ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 235.0 .

ssp:stringerSpan ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 2.0 .

ssp:boundaryConditionFactor ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 1.0 .

ssp:stringerSectionModulus ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 4825.531915 .

ssp:stringerShearArea ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 25.074199241 .

ssp:iceBeltUpperExtension ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.6 .

ssp:iceBeltLowerExtension ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 1.2 .

ssp:shellPlateThickness ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 25.0 .

ssp:framingExtensionAboveUIWL ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 1.2 .

ssp:framingExtensionBelowLIWL ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 2.0 .

ssp:transverseFrameSectionModulus ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 5500.0 .

ssp:transverseFrameShearArea ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 30.0 .

ssp:frameWebThickness ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 10.0 .

ssp:webFrameSpacing ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 2.0 .

ssp:webFrameShearArea ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 120.0 .

ssp:webFrameSectionModulus ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 10000.0 .

ssp:stemPlateThickness ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 28.0 .

ssp:stemFloorSpacing ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.5 .

ssp:abrasionCorrosionIncrement ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 2.0 .

# -----------------------------
# Propeller / shaft / fatigue / dynamic placeholders
# -----------------------------
ssp:BackwardShipForce ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1500.0 .

ssp:ForwardShipForce ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1600.0 .

ssp:BackwardIceThrust ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1400.0 .

ssp:ForwardIceThrust ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1450.0 .

ssp:forwardResponseThrust ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1300.0 .

ssp:backwardResponseThrust ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1250.0 .

ssp:PropellerTorque ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 210.0 .

ssp:PeakPropellerTorque ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 260.0 .

ssp:maxSpindleTorque ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 180.0 .

ssp:niceLoadCycles ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 100000 .

ssp:designIceBlockThickness ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1.75 .

ssp:designIceBlockThicknessThruster ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1.17 .

ssp:propellerHighestPoint ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 1.5 .

ssp:propellerHullClearance ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 0.5 .

ssp:bladeFailureForce ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 350.0 .

ssp:bladeFailureSpindleTorque ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 120.0 .

ssp:bladeRootChord ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 0.8 .

ssp:referenceStrength2 ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 260.0 .

ssp:bladeStress ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 180.0 .

ssp:meanFatigueStrength ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 140.0 .

ssp:equivalentFatigueStress ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 120.0 .

ssp:characteristicFatigueStrength ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 200.0 .


# -----------------------------
# Rudder / steering / machinery
# -----------------------------
ssp:rudderServiceSpeed ssn:isPropertyOf ssp:Rudder001 ;
    ssp:hasVariableValue 20.0 .

ssp:hasIceKnife ssn:isPropertyOf ssp:Rudder001 ;
    ssp:hasVariableValue false .

ssp:hasRudderStoppers ssn:isPropertyOf ssp:Rudder001 ;
    ssp:hasVariableValue true .

ssp:hasHydraulicReliefValves ssn:isPropertyOf ssp:Rudder001 ;
    ssp:hasVariableValue true .

ssp:engineRequiresReversal ssn:isPropertyOf ssp:Engine001 ;
    ssp:hasVariableValue true .

ssp:airReceiverCapacity ssn:isPropertyOf ssp:Engine001 ;
    ssp:hasVariableValue 12 .

ssp:airCompressorChargeTime ssn:isPropertyOf ssp:Engine001 ;
    ssp:hasVariableValue 40.0 .

ssp:seaInletLocation ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue true .

ssp:strainerPlateAreaRatio ssn:isPropertyOf ssp:iceShip ;
    ssp:hasVariableValue 2.0 .

ssp:longitudinalFrameSectionModulus ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 5200.0 .

ssp:longitudinalFrameShearArea ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 28.0 .

ssp:propellerCentrelineDepth ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 2.5 .

# =============================
# master ship v3 extensionsss
# =============================

ssp:Hull001 ssp:hasVariable
    ssp:UIWL,
    ssp:LIWL,
    ssp:HullSpeed,
    ssp:iceLoadMaxHeight,
    ssp:loadDistribution,
    ssp:IceResistance,
    ssp:caFactor,
    ssp:hullRegion,
    ssp:framingType,
    ssp:designIcePressure,
    ssp:icePressure,
    ssp:yieldStress,
    ssp:stringerSpan,
    ssp:boundaryConditionFactor,
    ssp:stringerSectionModulus,
    ssp:stringerShearArea,
    ssp:iceBeltUpperExtension,
    ssp:iceBeltLowerExtension,
    ssp:shellPlateThickness,
    ssp:framingExtensionAboveUIWL,
    ssp:framingExtensionBelowLIWL,
    ssp:transverseFrameSectionModulus,
    ssp:transverseFrameShearArea,
    ssp:frameWebThickness,
    ssp:frameWebHeight,
    ssp:webFrameSpacing,
    ssp:webFrameIceLoad,
    ssp:webFrameShearArea,
    ssp:webFrameSectionModulus,
    ssp:stemPlateThickness,
    ssp:stemFloorSpacing,
    ssp:abrasionCorrosionIncrement,
    ssp:longitudinalFrameSectionModulus,
    ssp:longitudinalFrameShearArea .

ssp:MainPropeller ssp:hasVariable
    ssp:propellerDiameter,
    ssp:propellerIsOpenType,
    ssp:propellerPitch07Bollard,
    ssp:BackwardShipForce,
    ssp:ForwardShipForce,
    ssp:BackwardIceThrust,
    ssp:ForwardIceThrust,
    ssp:forwardResponseThrust,
    ssp:backwardResponseThrust,
    ssp:PropellerTorque,
    ssp:PeakPropellerTorque,
    ssp:maxSpindleTorque,
    ssp:niceLoadCycles,
    ssp:designIceBlockThickness,
    ssp:designIceBlockThicknessThruster,
    ssp:propellerHighestPoint,
    ssp:propellerHullClearance,
    ssp:propellerCentrelineDepth,
    ssp:bladeFailureForce,
    ssp:bladeFailureSpindleTorque,
    ssp:bladeRootChord,
    ssp:bladeRootThickness,
    ssp:bladeRootRadius,
    ssp:bladeYieldStrength,
    ssp:bladeUltimateTensileStrength,
    ssp:referenceStrength2,
    ssp:bladeStress,
    ssp:meanFatigueStrength,
    ssp:equivalentFatigueStress,
    ssp:characteristicFatigueStrength .


ssp:frameWebHeight ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 450.0 .

ssp:webFrameIceLoad ssn:isPropertyOf ssp:Hull001 ;
    ssp:hasVariableValue 0.9 .

ssp:bladeRootThickness ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 0.12 .

ssp:bladeRootRadius ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 0.65 .

ssp:bladeYieldStrength ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 250.0 .

ssp:bladeUltimateTensileStrength ssn:isPropertyOf ssp:MainPropeller ;
    ssp:hasVariableValue 620.0 .

req:MasterPhysicalTestReq a req:PhysicalTestRequirement ;
    req:hasVerificationStatus req:PassedStatus ;
    req:appliesTo ssp:iceShip .

req:MasterEngineOutputReq a req:StaticRequirement ;
    req:hasVerificationStatus req:PassedStatus ;
    req:appliesTo ssp:Engine001 .

req:MasterIceResistanceReq a req:ComplexRequirement ;
    req:hasVerificationStatus req:PassedStatus ;
    req:appliesTo ssp:Hull001 .

req:MasterDynamicTorqueReq a req:DynamicRequirement ;
    req:hasVerificationStatus req:PassedStatus ;
    req:appliesTo ssp:MainPropeller .
req:PassedStatus a req:RequirementStatus .
req:PendingStatus a req:RequirementStatus .
req:FailedStatus a req:RequirementStatus .
req:PhysicalTestRequirement a rdfs:Class .
req:StaticRequirement a rdfs:Class .
req:ComplexRequirement a rdfs:Class .
req:DynamicRequirement a rdfs:Class .
req:RequirementStatus a rdfs:Class .