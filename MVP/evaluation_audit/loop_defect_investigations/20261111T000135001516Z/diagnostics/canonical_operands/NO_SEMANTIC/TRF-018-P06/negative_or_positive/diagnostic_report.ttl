@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P06/ship> ;
            sh:resultMessage "iceClass must be one of IA Super, IA, IB, or IC." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceClassValue> ;
                    sh:in ( <https://w3id.org/nltl/vocab#iceClassIaSuper> <https://w3id.org/nltl/vocab#iceClassIa> <https://w3id.org/nltl/vocab#iceClassIb> <https://w3id.org/nltl/vocab#iceClassIc> ) ;
                    sh:maxCount 1 ;
                    sh:message "iceClass must be one of IA Super, IA, IB, or IC." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ;
            sh:value <https://w3id.org/nltl/vocab#iceClassIi> ] .

