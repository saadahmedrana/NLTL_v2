@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F02/ship> ;
            sh:resultMessage "propellerBladeCount is required as a single integer input." ;
            sh:resultPath <https://w3id.org/nltl/vocab#propellerBladeCount> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:message "propellerBladeCount is required as a single integer input." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#propellerBladeCount> ] ] .

