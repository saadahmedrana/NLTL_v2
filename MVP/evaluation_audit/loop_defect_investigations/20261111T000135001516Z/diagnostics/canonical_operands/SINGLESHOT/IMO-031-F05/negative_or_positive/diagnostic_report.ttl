@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-031-F05/ship> ;
            sh:resultMessage "An exposed-structure material record is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#exposedStructureMaterial> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "An exposed-structure material record is required." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#exposedStructureMaterial> ] ] .

