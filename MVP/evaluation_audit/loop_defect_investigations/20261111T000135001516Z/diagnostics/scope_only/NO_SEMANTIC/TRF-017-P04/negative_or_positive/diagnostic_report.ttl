@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ;
            sh:resultMessage "The maximum continuous rating power shall equal the propulsion machinery continuous output when no output restriction applies, or the restricted propulsion output when a restriction applies." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The maximum continuous rating power shall equal the propulsion machinery continuous output when no output restriction applies, or the restricted propulsion output when a restriction applies." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                       nltl:maximumContinuousRatingPower ?maximumPower .
                ?maximumPower qudt:numericValue ?maximumValue ;
                              qudt:unit unit:KiloW .
                {
                    $this nltl:propulsionOutputRestrictionApplies ?restriction ; nltl:maximumContinuousRatingPower ?maximumPower .
?maximumPower qudt:numericValue ?maximumValue ; qudt:unit unit:KiloW .
FILTER (?restriction = true)
                    $this nltl:restrictedPropulsionOutput ?comparisonPower .
                    ?comparisonPower qudt:numericValue ?comparisonValue ;
                                     qudt:unit unit:KiloW .
                    FILTER (?maximumValue != ?comparisonValue)
                }
                UNION
                {
                    $this nltl:propulsionOutputRestrictionApplies ?restriction ; nltl:maximumContinuousRatingPower ?maximumPower .
?maximumPower qudt:numericValue ?maximumValue ; qudt:unit unit:KiloW .
FILTER (?restriction = false)
                    $this nltl:propulsionMachineryContinuousOutput ?comparisonPower .
                    ?comparisonPower qudt:numericValue ?comparisonValue ;
                                     qudt:unit unit:KiloW .
                    FILTER (?maximumValue != ?comparisonValue)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF017Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-P04/ship> ] .

