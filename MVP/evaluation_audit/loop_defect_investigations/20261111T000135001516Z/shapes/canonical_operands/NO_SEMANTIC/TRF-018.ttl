_:ne4e504835fc0450a87a7d499696f258db14 <http://www.w3.org/ns/shacl#message> "maximumContinuousRatingPower must be at least calculatedRequiredPower and at least 1000 kW for IA, IB, or IC, or at least 2800 kW for IA Super." .
_:ne4e504835fc0450a87a7d499696f258db14 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:calculatedRequiredPower ?calculatedNode ;
                      nltl:maximumContinuousRatingPower ?maximumNode .
                ?calculatedNode qudt:numericValue ?calculatedPower .
                ?maximumNode qudt:numericValue ?maximumPower .
                FILTER (
                    (?ice IN (
                        nltl:iceClassIa,
                        nltl:iceClassIb,
                        nltl:iceClassIc
                    ) &&
                    (?maximumPower < ?calculatedPower || ?maximumPower < 1000))
                    ||
                    (?ice = nltl:iceClassIaSuper &&
                    (?maximumPower < ?calculatedPower || ?maximumPower < 2800))
                )
            }
        """ .
