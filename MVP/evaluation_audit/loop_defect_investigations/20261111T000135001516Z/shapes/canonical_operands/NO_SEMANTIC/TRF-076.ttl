_:n7abb52b1f22c4aac940e54d1382ee9c4b11 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:n7abb52b1f22c4aac940e54d1382ee9c4b12 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
_:n7abb52b1f22c4aac940e54d1382ee9c4b12 <http://www.w3.org/ns/shacl#message> "CP and FP propellers must cover load cases 1 through 4; an FP reversing propeller must also cover load case 5." .
_:n7abb52b1f22c4aac940e54d1382ee9c4b12 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propellerType ?type .
                FILTER (?type = "CP" || ?type = "FP")
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case1 .
                        ?case1 nltl:propellerBladeLoadCaseNumber ?number1 .
                        FILTER (?number1 = 1)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case2 .
                        ?case2 nltl:propellerBladeLoadCaseNumber ?number2 .
                        FILTER (?number2 = 2)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case3 .
                        ?case3 nltl:propellerBladeLoadCaseNumber ?number3 .
                        FILTER (?number3 = 3)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:hasPropellerBladeLoadCase ?case4 .
                        ?case4 nltl:propellerBladeLoadCaseNumber ?number4 .
                        FILTER (?number4 = 4)
                    }
                    ||
                    (
                        ?type = "FP"
                        &&
                        EXISTS {
                            $this nltl:propellerReversingCapability true
                        }
                        &&
                        NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case5 .
                            ?case5 nltl:propellerBladeLoadCaseNumber ?number5 .
                            FILTER (?number5 = 5)
                        }
                    )
                )
            }
        """ .
_:n7abb52b1f22c4aac940e54d1382ee9c4b2 <http://www.w3.org/ns/shacl#class> <https://w3id.org/nltl/vocab#propellerBladeLoadCase> .
_:n7abb52b1f22c4aac940e54d1382ee9c4b2 <http://www.w3.org/ns/shacl#message> "Each linked propeller blade load case must be a typed load case with exactly one integer case number." .
