_:n732ab8cbfcf245f4bf704fd2bea430a4b6 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:n732ab8cbfcf245f4bf704fd2bea430a4b6 <http://www.w3.org/ns/shacl#path> <http://qudt.org/schema/qudt/unit> .
_:n732ab8cbfcf245f4bf704fd2bea430a4b7 <http://www.w3.org/ns/shacl#message> "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero." .
_:n732ab8cbfcf245f4bf704fd2bea430a4b7 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?iceCycles ;
                      nltl:propellerBladeCount ?bladeCount ;
                      nltl:effectiveIceLoadCycleCount ?resultNode .
                ?resultNode qudt:numericValue ?actual .

                BIND ((?iceCycles * ?bladeCount) AS ?expected)
                BIND (
                    IF(
                        ABS(?expected) < 0.001,
                        0.000001,
                        0.000001 * ABS(?expected)
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?actual - ?expected) > ?tolerance)
            }
        """ .
