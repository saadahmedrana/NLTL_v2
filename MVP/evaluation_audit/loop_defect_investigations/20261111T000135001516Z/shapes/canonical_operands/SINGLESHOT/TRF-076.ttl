_:n473113c0665b401cb71b38ec95359b55b10 <http://www.w3.org/ns/shacl#hasValue> "FP"^^<http://www.w3.org/2001/XMLSchema#string> .
_:n473113c0665b401cb71b38ec95359b55b10 <http://www.w3.org/ns/shacl#path> <https://w3id.org/nltl/vocab#propellerType> .
_:n473113c0665b401cb71b38ec95359b55b11 <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#boolean> .
_:n473113c0665b401cb71b38ec95359b55b11 <http://www.w3.org/ns/shacl#hasValue> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
_:n473113c0665b401cb71b38ec95359b55b11 <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:n473113c0665b401cb71b38ec95359b55b11 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:n473113c0665b401cb71b38ec95359b55b11 <http://www.w3.org/ns/shacl#path> <https://w3id.org/nltl/vocab#propellerReversingCapability> .
_:n473113c0665b401cb71b38ec95359b55b12 <http://www.w3.org/ns/shacl#message> "A reversing FP propeller must have propeller blade load cases 1, 2, 3, 4, and 5." .
_:n473113c0665b401cb71b38ec95359b55b12 <http://www.w3.org/ns/shacl#select> """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:propellerType "FP" .
                        $this nltl:propellerReversingCapability true .
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case1 .
                            ?case1 nltl:propellerBladeLoadCaseNumber ?number1 .
                            FILTER (?number1 >= 1 && ?number1 <= 1)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case2 .
                            ?case2 nltl:propellerBladeLoadCaseNumber ?number2 .
                            FILTER (?number2 >= 2 && ?number2 <= 2)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case3 .
                            ?case3 nltl:propellerBladeLoadCaseNumber ?number3 .
                            FILTER (?number3 >= 3 && ?number3 <= 3)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case4 .
                            ?case4 nltl:propellerBladeLoadCaseNumber ?number4 .
                            FILTER (?number4 >= 4 && ?number4 <= 4)
                        }
                        FILTER NOT EXISTS {
                            $this nltl:hasPropellerBladeLoadCase ?case5 .
                            ?case5 nltl:propellerBladeLoadCaseNumber ?number5 .
                            FILTER (?number5 >= 5 && ?number5 <= 5)
                        }
                    }
                """ .
