_:n2b5ecf0767604b4b809784c0aa4220d7b6 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:n2b5ecf0767604b4b809784c0aa4220d7b6 <http://www.w3.org/ns/shacl#path> <http://qudt.org/schema/qudt/unit> .
_:n2b5ecf0767604b4b809784c0aa4220d7b7 <http://www.w3.org/ns/shacl#message> "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6 and an absolute fallback of 1e-7." .
_:n2b5ecf0767604b4b809784c0aa4220d7b7 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?nice ;
                      nltl:propellerBladeCount ?blades ;
                      nltl:effectiveIceLoadCycleCount ?quantity .
                ?quantity qudt:numericValue ?actual ;
                          qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                BIND ((?nice * ?blades) AS ?expected)
                FILTER (
                    ABS(?actual - ?expected) >
                    ((0.000001 * ABS(?expected)) + 0.0000001)
                )
            }
        """ .
