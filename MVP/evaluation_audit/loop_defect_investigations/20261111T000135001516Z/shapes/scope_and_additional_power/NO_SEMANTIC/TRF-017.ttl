_:nb77a0da38fd141f4a38cd29200986e57b7 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:nb77a0da38fd141f4a38cd29200986e57b8 <http://www.w3.org/ns/shacl#message> "The maximum continuous rating power shall equal the propulsion machinery continuous output when no output restriction applies, or the restricted propulsion output when a restriction applies." .
_:nb77a0da38fd141f4a38cd29200986e57b8 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                       nltl:maximumContinuousRatingPower ?maximumPower .
                ?maximumPower qudt:numericValue ?maximumValue ;
                              qudt:unit unit:KiloW .
                {
                    $this nltl:propulsionOutputRestrictionApplies ?restriction ; nltl:maximumContinuousRatingPower ?maximumPower .
?maximumPower qudt:numericValue ?maximumValue ; qudt:unit unit:KiloW .
FILTER (?restriction = true)
                    $this nltl:restrictedPropulsionOutput ?comparisonPower .
                    ?comparisonPower qudt:numericValue ?comparisonValue ;
                                     qudt:unit unit:KiloW .
                    OPTIONAL { $this nltl:additionalPropulsionPower ?additionalPower . ?additionalPower qudt:numericValue ?additionalValue ; qudt:unit unit:KiloW . }
BIND((?comparisonValue + COALESCE(?additionalValue,0)) AS ?expectedComparison)
FILTER (?maximumValue != ?expectedComparison)
                }
                UNION
                {
                    $this nltl:propulsionOutputRestrictionApplies ?restriction ; nltl:maximumContinuousRatingPower ?maximumPower .
?maximumPower qudt:numericValue ?maximumValue ; qudt:unit unit:KiloW .
FILTER (?restriction = false)
                    $this nltl:propulsionMachineryContinuousOutput ?comparisonPower .
                    ?comparisonPower qudt:numericValue ?comparisonValue ;
                                     qudt:unit unit:KiloW .
                    OPTIONAL { $this nltl:additionalPropulsionPower ?additionalPower . ?additionalPower qudt:numericValue ?additionalValue ; qudt:unit unit:KiloW . }
BIND((?comparisonValue + COALESCE(?additionalValue,0)) AS ?expectedComparison)
FILTER (?maximumValue != ?expectedComparison)
                }
            }
        """ .
