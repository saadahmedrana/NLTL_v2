_:n9b94b7716f72473b911a0d9742e33c0eb7 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:n9b94b7716f72473b911a0d9742e33c0eb8 <http://www.w3.org/ns/shacl#message> "The maximum continuous rating power shall equal the propulsion machinery continuous output when no output restriction applies, or the restricted propulsion output when a restriction applies." .
_:n9b94b7716f72473b911a0d9742e33c0eb8 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:propulsionOutputRestrictionApplies ?restriction ;
                       nltl:maximumContinuousRatingPower ?maximumPower .
                ?maximumPower qudt:numericValue ?maximumValue ;
                              qudt:unit unit:KiloW .
                {
                    $this nltl:propulsionOutputRestrictionApplies ?restriction ; nltl:maximumContinuousRatingPower ?maximumPower .
?maximumPower qudt:numericValue ?maximumValue ; qudt:unit unit:KiloW .
FILTER (?restriction = true)
                    $this nltl:restrictedPropulsionOutput ?comparisonPower .
                    ?comparisonPower qudt:numericValue ?comparisonValue ;
                                     qudt:unit unit:KiloW .
                    FILTER (?maximumValue != ?comparisonValue)
                }
                UNION
                {
                    $this nltl:propulsionOutputRestrictionApplies ?restriction ; nltl:maximumContinuousRatingPower ?maximumPower .
?maximumPower qudt:numericValue ?maximumValue ; qudt:unit unit:KiloW .
FILTER (?restriction = false)
                    $this nltl:propulsionMachineryContinuousOutput ?comparisonPower .
                    ?comparisonPower qudt:numericValue ?comparisonValue ;
                                     qudt:unit unit:KiloW .
                    FILTER (?maximumValue != ?comparisonValue)
                }
            }
        """ .
_:n9b94b7716f72473b911a0d9742e33c0eb9 <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#boolean> .
_:n9b94b7716f72473b911a0d9742e33c0eb9 <http://www.w3.org/ns/shacl#hasValue> "false"^^<http://www.w3.org/2001/XMLSchema#boolean> .
_:n9b94b7716f72473b911a0d9742e33c0eb9 <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:n9b94b7716f72473b911a0d9742e33c0eb9 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:n9b94b7716f72473b911a0d9742e33c0eb9 <http://www.w3.org/ns/shacl#path> <https://w3id.org/nltl/vocab#propulsionOutputRestrictionApplies> .
