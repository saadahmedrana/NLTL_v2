_:nc1c345fb5e7d47be86cebc03bbef7ee6b11 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
_:nc1c345fb5e7d47be86cebc03bbef7ee6b11 <http://www.w3.org/ns/shacl#message> "The upper ice waterline displacement must equal a waterline case displacement and must not be less than any linked case displacement." .
_:nc1c345fb5e7d47be86cebc03bbef7ee6b11 <http://www.w3.org/ns/shacl#select> """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?duiNode .
                ?duiNode qudt:numericValue ?duiValue .

FILTER NOT EXISTS {
                $this nltl:hasUpperIceWaterlineCase ?case .
                ?case nltl:waterlineCaseDisplacement ?caseDisplacement .
                ?caseDisplacement qudt:numericValue ?caseValue .
                FILTER (?caseValue = ?duiValue)

                FILTER NOT EXISTS {
                    $this nltl:hasUpperIceWaterlineCase ?otherCase .
                    ?otherCase nltl:waterlineCaseDisplacement ?otherDisplacement .
                    ?otherDisplacement qudt:numericValue ?otherValue .
                    FILTER (?otherValue > ?duiValue)
                }

}
            }
""" .
