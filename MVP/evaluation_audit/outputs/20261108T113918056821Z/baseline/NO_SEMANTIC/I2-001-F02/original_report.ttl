@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ;
            sh:resultMessage "UR I2 Rev.4 applicability must be true for ships contracted for construction on or after 1 January 2021 and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "UR I2 Rev.4 applicability must be true for ships contracted for construction on or after 1 January 2021 and false otherwise." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date ;
                      nltl:urI2RevisionApplicability ?applicability .
                FILTER (
                    (
                        (
                            YEAR(?date) > 2021 ||
                            (YEAR(?date) = 2021 && MONTH(?date) > 1) ||
                            (YEAR(?date) = 2021 && MONTH(?date) = 1 && DAY(?date) >= 1)
                        ) &&
                        ?applicability != true
                    ) ||
                    (
                        (
                            YEAR(?date) < 2021 ||
                            (YEAR(?date) = 2021 && MONTH(?date) < 1) ||
                            (YEAR(?date) = 2021 && MONTH(?date) = 1 && DAY(?date) < 1)
                        ) &&
                        ?applicability != false
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-001> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-001-F02/ship> ] .

