@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/DEG>']" ;
                            sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ;
                    sh:resultMessage "The boundary point must have a shell inclination angle of exactly 7 degrees." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#shellInclinationAngle> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The boundary point must have a shell inclination angle of exactly 7 degrees." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:maxInclusive 7.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 7.0 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#shellInclinationAngle> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ;
            sh:resultMessage "The ship must identify its bottom/lower-region boundary point." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasBottomRegionLowerRegionBoundaryPoint> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify its bottom/lower-region boundary point." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#hullBoundaryPoint> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The boundary point must have a shell inclination angle of exactly 7 degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 7.0 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#shellInclinationAngle> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasBottomRegionLowerRegionBoundaryPoint> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ] .

