@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Line load must be supplied as a single kN/m quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#lineLoad> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Line load must be supplied as a single kN/m quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN-PER-M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#lineLoad> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Load patch height must be supplied as a single metre quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Load patch height must be supplied as a single metre quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchHeight> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/bowCase> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/bowCase>-><https://w3id.org/nltl/vocab#glancingImpactPressure>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#glancingImpactPressure> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#glancingImpactPressure> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Each bow subregion calculation case must contain the declared shape coefficient, line-load, and pressure results." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasBowSubregionCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#bowSubregionCalculationCase> ;
                    sh:message "Each bow subregion calculation case must contain the declared shape coefficient, line-load, and pressure results." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#glancingImpactLineLoad> ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#glancingImpactPressure> ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#bowShapeCoefficient> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasBowSubregionCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Total glancing impact force must be supplied as a single kN quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#totalGlancingImpactForce> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Total glancing impact force must be supplied as a single kN quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#totalGlancingImpactForce> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Local ice pressure must be supplied as a single MPa quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#localIcePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Local ice pressure must be supplied as a single MPa quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#localIcePressure> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Shape coefficient must be supplied as a single dimensionless quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#shapeCoefficient> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Shape coefficient must be supplied as a single dimensionless quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#shapeCoefficient> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Average ice pressure must be supplied as a single MPa quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#averageIcePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure must be supplied as a single MPa quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#averageIcePressure> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F04/ship> ;
            sh:resultMessage "Load patch length must be supplied as a single metre quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchLength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Load patch length must be supplied as a single metre quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchLength> ] ] .

