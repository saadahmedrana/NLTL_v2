@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:I2_011_ApplicableShape> , <urn:nltl:generated-shape:I2_011_BulbousBowAbsentShape> , <urn:nltl:generated-shape:I2_011_NonPolarClassShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_011_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F03/ship> ] .

