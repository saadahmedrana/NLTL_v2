@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F08/ship> ;
            sh:resultMessage "The ship must provide table lookup inputs for the non-bow ice load determination." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasTableLookupCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#tableLookupCase> ;
                    sh:message "The ship must provide table lookup inputs for the non-bow ice load determination." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:maxCount 1 ;
                                    sh:message "Each table lookup case must provide the load patch dimension class factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#loadPatchDimensionClassFactor> ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each table lookup case must provide the crushing failure class factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#crushingFailureClassFactor> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasTableLookupCase> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-017-F08/ship> ;
            sh:resultMessage "The ship must provide a non-bow ice load calculation case with required externally computed results." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasNonBowIceLoadCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#nonBowIceLoadCalculationCase> ;
                    sh:message "The ship must provide a non-bow ice load calculation case with required externally computed results." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:maxCount 1 ;
                                    sh:message "The non-bow calculation case must provide the externally computed ship displacement factor as a dimensionless quantity." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#shipDisplacementFactor> ],
                                [ sh:maxCount 1 ;
                                    sh:message "The non-bow calculation case must provide the externally computed non-bow ice force." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#nonBowIceForce> ],
                                [ sh:maxCount 1 ;
                                    sh:message "The non-bow calculation case must provide the externally computed non-bow ice line load." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M-PER-M2> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#nonBowIceLineLoad> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasNonBowIceLoadCalculationCase> ] ] .

