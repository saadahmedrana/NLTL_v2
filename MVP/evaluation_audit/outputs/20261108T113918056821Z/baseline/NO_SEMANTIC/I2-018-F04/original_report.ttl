                    sh:resultPath <https://w3id.org/nltl/vocab#localizedStructuralMemberCategory> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#bottomStructureFrameCategory> <https://w3id.org/nltl/vocab#longitudinallyFramedPlatingCategory> <https://w3id.org/nltl/vocab#stringerSideLongitudinalOrWebFrameCategory> <https://w3id.org/nltl/vocab#transverseFrameWithLoadDistributingStringersCategory> <https://w3id.org/nltl/vocab#transverseFrameWithoutLoadDistributingStringersCategory> <https://w3id.org/nltl/vocab#transverselyFramedPlatingCategory> ) ;
                            sh:maxCount 1 ;
