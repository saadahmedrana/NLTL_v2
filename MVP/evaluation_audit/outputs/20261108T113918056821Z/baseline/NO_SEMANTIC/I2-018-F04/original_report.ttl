                            sh:path <https://w3id.org/nltl/vocab#localizedStructuralMemberCategory> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-018-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_018_PeakLookupCaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPeakPressureFactorLookupCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#peakPressureFactorLookupCase> ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_018_PeakLookupCaseShape> ;
