@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Load patch height input is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Load patch height input is required in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchHeight> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Peak pressure factor input is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#peakPressureFactor> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Peak pressure factor input is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#peakPressureFactor> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Average ice pressure input is required in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#averageIcePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure input is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#averageIcePressure> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Frame span input is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameSpan> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame span input is required in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#frameSpan> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "Yield strength input is required in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#yieldStrength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength input is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#yieldStrength> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/member> ;
                            sh:resultMessage "Selected hull area factor input is required." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#selectedHullAreaFactor> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:message "Selected hull area factor input is required." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#selectedHullAreaFactor> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/plating> ;
                    sh:resultMessage "Each plating item must identify its supporting structural member." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each plating item must identify its supporting structural member." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:message "Selected hull area factor input is required." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#selectedHullAreaFactor> ],
                                        [ sh:maxCount 1 ;
                                            sh:message "Frame spacing input is required in metres." ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#frameSpacing> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/ship> ;
            sh:resultMessage "At least one plating item with its readiness inputs and external result is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPlating> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "At least one plating item with its readiness inputs and external result is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#plating> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Externally calculated net plate thickness is required in millimetres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#iceLoadRequiredNetPlateThickness> ],
                                [ sh:message "Each plating item must identify its supporting structural member." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:message "Selected hull area factor input is required." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#selectedHullAreaFactor> ],
                                                [ sh:maxCount 1 ;
                                                    sh:message "Frame spacing input is required in metres." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#frameSpacing> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ],
                                [ sh:maxCount 1 ;
                                    sh:message "Framing angle omega input is required in degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasPlating> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F04/plating> ] .

