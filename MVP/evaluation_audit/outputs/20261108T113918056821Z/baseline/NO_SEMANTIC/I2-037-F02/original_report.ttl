@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member>-><https://w3id.org/nltl/vocab#memberCapacity>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#memberCapacity> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#memberCapacity> ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase>-><https://w3id.org/nltl/vocab#combinedShearBendingEffect>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#combinedShearBendingEffect> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#combinedShearBendingEffect> ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase>-><https://w3id.org/nltl/vocab#loadPatchApplicationLocation>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchApplicationLocation> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:string ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#loadPatchApplicationLocation> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#loadCase> ; sh:property [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#combinedShearBendingEffect> ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadPatchApplicationLocation> ] ]. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMemberLoadCase> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class <https://w3id.org/nltl/vocab#loadCase> ;
                                    sh:property [ sh:datatype xsd:string ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#combinedShearBendingEffect> ],
                                        [ sh:datatype xsd:string ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#loadPatchApplicationLocation> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#hasStructuralMemberLoadCase> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/loadcase> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ; sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#memberCapacity> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#loadCase> ; sh:property [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#combinedShearBendingEffect> ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadPatchApplicationLocation> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasStructuralMemberLoadCase> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class <https://w3id.org/nltl/vocab#loadCase> ;
                                            sh:property [ sh:datatype xsd:string ;
                                                    sh:minCount 1 ;
                                                    sh:path <https://w3id.org/nltl/vocab#loadPatchApplicationLocation> ],
                                                [ sh:datatype xsd:string ;
                                                    sh:minCount 1 ;
                                                    sh:path <https://w3id.org/nltl/vocab#combinedShearBendingEffect> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMemberLoadCase> ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#memberCapacity> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/ship>-><https://w3id.org/nltl/vocab#hasIceLoadPatchDesignCase>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasIceLoadPatchDesignCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#iceLoadPatchDesignCase> ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#memberCapacityMinimizationConfirmed> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasIceLoadPatchDesignCase> ] ] .

