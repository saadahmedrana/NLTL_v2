@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F04/member> ;
                    sh:resultMessage "Each structural member shall provide one flange outstand result." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#flangeOutstand> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each structural member shall provide one flange outstand result." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:LengthQuantityShape> ;
                            sh:path <https://w3id.org/nltl/vocab#flangeOutstand> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F04/ship> ;
            sh:resultMessage "The ship shall identify structural members with the required readiness inputs and externally computed result." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify structural members with the required readiness inputs and externally computed result." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F04/member> ] .

