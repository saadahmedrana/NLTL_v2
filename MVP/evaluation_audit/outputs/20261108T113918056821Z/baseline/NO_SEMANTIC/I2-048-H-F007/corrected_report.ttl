@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F007/case> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F007/case>-><https://w3id.org/nltl/vocab#steelStrengthCategory>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#steelStrengthCategory> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#steelStrengthCategoryValue> ;
                            sh:in ( <https://w3id.org/nltl/vocab#normalStrengthSteelCategory> <https://w3id.org/nltl/vocab#highTensileSteelCategory> ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#steelStrengthCategory> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F007/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_048_CaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
                    sh:node <urn:nltl:generated-shape:I2_048_CaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F007/case> ] .

