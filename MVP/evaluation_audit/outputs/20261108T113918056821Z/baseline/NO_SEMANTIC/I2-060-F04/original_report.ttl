@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F04/member> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F04/member> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#memberInWayOfCutout> ] ] , [ sh:property [ sh:class <https://w3id.org/nltl/vocab#cutout> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#hasCutout> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#memberInWayOfCutout> ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2_060_StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F04/member> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_060_StructuralMemberShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                    sh:node <urn:nltl:generated-shape:I2_060_StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-060-F04/member> ] .

