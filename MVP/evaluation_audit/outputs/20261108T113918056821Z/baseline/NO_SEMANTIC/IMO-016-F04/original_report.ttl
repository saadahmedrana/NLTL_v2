@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:string ; sh:in ( Literal(\"English\") Literal(\"French\") Literal(\"Spanish\") ) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#certificateLanguage> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"A certificate language other than English, French, or Spanish requires an approved translation.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#approvedTranslationPresent> ], [ sh:datatype xsd:string ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#certificateLanguage> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_016_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F04/ship>-><https://w3id.org/nltl/vocab#hasPolarShipCertificate>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPolarShipCertificate> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#polarShipCertificateForm> ;
                            sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#appendixIPolarShipCertificateModel> ;
                                    sh:maxCount 1 ;
                                    sh:message "The Polar Ship Certificate shall use the Appendix I model." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#certificateFormModel> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasPolarShipCertificate> ] ] .

