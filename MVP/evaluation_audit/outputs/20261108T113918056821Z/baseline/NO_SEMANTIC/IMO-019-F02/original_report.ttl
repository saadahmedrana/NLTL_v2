@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F02/ship> ;
            sh:resultMessage """Node <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F02/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The low-air-temperature applicability indicator must be false for the non-applicable branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipOperatesInLowAirTemperature> ] ] , [ sh:property [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The Polar Service Temperature must be specified as a single Celsius quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#polarServiceTemperature> ], [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The lowest MDLT must be specified as a single Celsius quantity.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#lowestMdlt> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("Systems and equipment required by the Code must be fully functional at the Polar Service Temperature.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#requiredSystemsFunctionalAtPst> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The low-air-temperature applicability indicator must be true for the applicable branch.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipOperatesInLowAirTemperature> ] ; sh:sparql [ sh:message Literal("The Polar Service Temperature must be at least 10 degrees Celsius below the lowest MDLT.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:polarServiceTemperature ?pstQuantity ;
                              nltl:lowestMdlt ?mdltQuantity .
                        ?pstQuantity qudt:numericValue ?pstValue .
                        ?mdltQuantity qudt:numericValue ?mdltValue .
                        FILTER (?pstValue > (?mdltValue - 10))
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO019Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-019-F02/ship> ] .

