@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ;
            sh:resultMessage "Selected vertical damage position must be between the keel and 120% of upper ice waterline draught." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Selected vertical damage position must be between the keel and 120% of upper ice waterline draught." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            SELECT $this
            WHERE {
                $this nltl:selectedVerticalDamagePosition ?positionNode ;
                      nltl:upperIceWaterlineDraught ?draughtNode .

                ?positionNode qudt:numericValue ?position .
                ?draughtNode qudt:numericValue ?draught .

                FILTER (
                    ?position < "0"^^xsd:decimal
                    ||
                    ?position > ("1.20"^^xsd:decimal * ?draught)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-038> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-F04/ship> ] .

