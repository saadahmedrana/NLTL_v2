@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#machinerySeawaterSupply> ] ] , [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceIngestionPreventionPresent> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#alternateFunctionalityArrangementApprovalStatus> ] ] ) ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#machinerySeawaterSupply> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_045_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-045-F04/ship> ;
            sh:resultMessage "machinerySeawaterSupply must be provided to determine whether the alternative-path requirement applies." ;
            sh:resultPath <https://w3id.org/nltl/vocab#machinerySeawaterSupply> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:message "machinerySeawaterSupply must be provided to determine whether the alternative-path requirement applies." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#machinerySeawaterSupply> ] ] .

