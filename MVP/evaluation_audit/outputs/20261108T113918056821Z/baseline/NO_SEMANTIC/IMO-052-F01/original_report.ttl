@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/access1> ;
                    sh:resultMessage "Each required access item must have associated ice or snow removal or prevention means." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasIceOrSnowRemovalOrPreventionMeans> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceSnowRemovalOrPreventionMeans> ;
                            sh:message "Each required access item must have associated ice or snow removal or prevention means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#hasIceOrSnowRemovalOrPreventionMeans> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class <https://w3id.org/nltl/vocab#iceSnowRemovalOrPreventionMeans> ; sh:message Literal(\"Each required access item must have associated ice or snow removal or prevention means.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <https://w3id.org/nltl/vocab#hasIceOrSnowRemovalOrPreventionMeans> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasRequiredAccessItem> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#requiredAccessItem> ;
                    sh:node [ sh:property [ sh:class <https://w3id.org/nltl/vocab#iceSnowRemovalOrPreventionMeans> ;
                                    sh:message "Each required access item must have associated ice or snow removal or prevention means." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path <https://w3id.org/nltl/vocab#hasIceOrSnowRemovalOrPreventionMeans> ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasRequiredAccessItem> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/access1> ] .

