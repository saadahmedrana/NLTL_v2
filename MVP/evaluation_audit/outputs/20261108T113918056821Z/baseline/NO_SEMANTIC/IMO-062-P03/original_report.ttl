            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n0fab0c8bd8e6458fad3f9b8ad11e1c3bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-P03/ship> ;
            sh:resultMessage "The ship shall record ice and snow mitigation coverage." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceSnowMitigationCoverage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n0fab0c8bd8e6458fad3f9b8ad11e1c3bb1 ] .

