@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-065-F08/ship> ;
            sh:resultMessage "The survival support duration must be provided in days." ;
            sh:resultPath <https://w3id.org/nltl/vocab#survivalSupportDuration> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The survival support duration must be provided in days." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DAY> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#survivalSupportDuration> ] ] .

