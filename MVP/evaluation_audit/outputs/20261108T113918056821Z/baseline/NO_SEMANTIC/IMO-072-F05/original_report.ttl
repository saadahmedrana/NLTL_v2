@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#extendedDarknessOperation> ], [ sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each lifeboat searchlight must be suitable for continuous use.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#searchlightContinuousUseSuitabilityStatus> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasAssignedSearchlight> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasLifeboat> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#extendedDarknessOperation> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_072_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-072-F05/ship> ] .

