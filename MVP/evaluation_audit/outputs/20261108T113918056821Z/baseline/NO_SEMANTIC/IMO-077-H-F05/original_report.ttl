@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship>-><https://w3id.org/nltl/vocab#additionalEquipmentCarriedInSurvivalCraft>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#additionalEquipmentCarriedInSurvivalCraft> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#additionalEquipmentCarriedInSurvivalCraft> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO_077_ApplicableShape> , <urn:nltl:generated-shape:IMO_077_NotApplicableShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_077_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-077-H-F05/ship> ] .

