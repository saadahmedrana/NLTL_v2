@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F02/ship> ;
            sh:resultMessage "For a planned or actual latitude over 80 degrees, the ship shall have at least one GNSS compass or equivalent connected to both main and emergency power." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a planned or actual latitude over 80 degrees, the ship shall have at least one GNSS compass or equivalent connected to both main and emergency power." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:plannedOrActualLatitude ?latitudeNode .
    ?latitudeNode qudt:numericValue ?latitude .
    FILTER (?latitude > "80"^^xsd:decimal)
    FILTER (
        NOT EXISTS {
            $this nltl:gnssCompassOrEquivalentCount ?count .
            FILTER (?count >= 1)
        }
        ||
        NOT EXISTS {
            $this nltl:connectedToMainPower ?mainPower .
        }
        ||
        NOT EXISTS {
            $this nltl:connectedToEmergencyPower ?emergencyPower .
        }
    )
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-087-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F02/ship> ] .

