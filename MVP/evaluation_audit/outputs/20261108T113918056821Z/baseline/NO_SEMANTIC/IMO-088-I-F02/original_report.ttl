@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F02/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F02/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#operatesOnlyInContinuousDaylight> ] ] , [ sh:message Literal(\"A ship not operating solely in continuous daylight must provide either the required searchlights and coverage or approved alternative visual ice-detection means.\") ; sh:or ( [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"At least two bridge-controlled rotatable narrow-beam searchlights are required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#bridgeControlledRotatableNarrowBeamSearchlightCount> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Searchlights must provide coverage over an arc of at least 360 degrees.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"360\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#searchlightCoverageArc> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Approved alternative visual ice-detection means are required when the searchlight alternative is not demonstrated.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <https://w3id.org/nltl/vocab#alternateVisualIceDetectionMeansApprovalStatus> ] ] ) ; sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#operatesOnlyInContinuousDaylight> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_088_StaticShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-088-I-F02/ship> ] .

