@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ;
            sh:resultMessage "For clean or segregated ballast discharge, the paragraph 1.1.1 oil-discharge prohibition must be marked not applicable." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For clean or segregated ballast discharge, the paragraph 1.1.1 oil-discharge prohibition must be marked not applicable." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:dischargedMaterialClassification ?material .
                FILTER (
                    ?material = nltl:cleanBallastMaterial
                    || ?material = nltl:segregatedBallastMaterial
                )
                FILTER (
                    NOT EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?flag
                    }
                    ||
                    EXISTS {
                        $this nltl:polarCodeOilDischargeParagraph1Point1Point1Applicable ?flag .
                        FILTER (!sameTerm(?flag, "false"^^xsd:boolean))
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-106-PolarOilDischargeExceptionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-106-L-F01/ship> ] .

