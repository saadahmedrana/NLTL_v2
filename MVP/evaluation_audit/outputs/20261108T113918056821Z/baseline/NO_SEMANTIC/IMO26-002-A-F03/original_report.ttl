@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:FishingVesselBranch> , <urn:nltl:generated-shape:PleasureYachtBranch> , <urn:nltl:generated-shape:CargoShipBranch> , <urn:nltl:generated-shape:NonApplicableBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:Chapter9Dash1ApplicabilityShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-002-A-F03/ship> ;
            sh:resultMessage "Ship type is required to determine Chapter 9-1 applicability." ;
            sh:resultPath <https://w3id.org/nltl/vocab#shipType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "Ship type is required to determine Chapter 9-1 applicability." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shipType> ] ] .

