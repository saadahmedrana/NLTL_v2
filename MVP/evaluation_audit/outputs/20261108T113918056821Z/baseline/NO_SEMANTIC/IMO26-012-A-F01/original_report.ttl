@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/heading1> ;
                    sh:resultMessage "Each represented non-magnetic heading means must identify an independent heading means." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#independentFromHeadingMeans> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#nonMagneticHeadingMeans> ;
                            sh:message "Each represented non-magnetic heading means must identify an independent heading means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#independentFromHeadingMeans> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/ship> ;
            sh:resultMessage "Represented non-magnetic heading means must satisfy the required topology constraints." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasNonMagneticHeadingMeans> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Represented non-magnetic heading means must satisfy the required topology constraints." ;
                    sh:node <urn:nltl:generated-shape:NonMagneticHeadingMeansShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasNonMagneticHeadingMeans> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F01/heading1> ] .

