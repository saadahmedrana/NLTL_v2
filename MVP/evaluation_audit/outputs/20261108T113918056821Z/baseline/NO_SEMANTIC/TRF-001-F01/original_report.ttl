@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne58ea04096694375a38fd13dc6a00ef0b8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne58ea04096694375a38fd13dc6a00ef0b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne58ea04096694375a38fd13dc6a00ef0b8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne58ea04096694375a38fd13dc6a00ef0b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "Ships contracted for construction on or after 2021-07-05 shall identify the 2021 Ice Class Regulations as the applicable edition." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Ships contracted for construction on or after 2021-07-05 shall identify the 2021 Ice Class Regulations as the applicable edition." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (?date >= "2021-07-05"^^xsd:date)
                FILTER NOT EXISTS {
                    $this nltl:applicableIceClassRegulationEdition
                        nltl:iceClassRegulationEdition2021 .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF001ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ] .

_:ne58ea04096694375a38fd13dc6a00ef0b8 sh:hasValue <https://w3id.org/nltl/vocab#iceClassSection1Point8Provision2021> ;
    sh:message "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> .

_:ne58ea04096694375a38fd13dc6a00ef0b9 sh:hasValue <https://w3id.org/nltl/vocab#iceClassDraughtChapter2Provision2021> ;
    sh:message "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> .

