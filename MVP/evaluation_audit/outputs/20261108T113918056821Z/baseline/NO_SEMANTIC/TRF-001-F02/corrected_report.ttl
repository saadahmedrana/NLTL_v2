@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "The construction contract date is required to determine which regulatory edition applies." ;
            sh:resultPath <https://w3id.org/nltl/vocab#constructionContractDate> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:date ;
                    sh:message "The construction contract date is required to determine which regulatory edition applies." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#constructionContractDate> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:message Literal(\"A construction contract date on or after 2021-07-05 establishes applicability of the 2021 Ice Class Regulations.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionContractDate> ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:message Literal(\"A construction contract date before 2021-07-05 establishes non-applicability of the 2021 Ice Class Regulations under this date rule.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#constructionContractDate> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF001ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F02/ship> ] .

