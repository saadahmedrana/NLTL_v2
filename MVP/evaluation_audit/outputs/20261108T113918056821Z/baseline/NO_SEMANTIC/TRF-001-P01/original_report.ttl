@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne4197a2e88254f12bd265ded05690888b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne4197a2e88254f12bd265ded05690888b8 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne4197a2e88254f12bd265ded05690888b9 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-P01/ship> ;
            sh:resultMessage "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne4197a2e88254f12bd265ded05690888b8 ] .

_:ne4197a2e88254f12bd265ded05690888b8 sh:hasValue <https://w3id.org/nltl/vocab#iceClassSection1Point8Provision2021> ;
    sh:message "The 2021 section 1.8 Ice Classes provision applies to every ship." ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> .

_:ne4197a2e88254f12bd265ded05690888b9 sh:hasValue <https://w3id.org/nltl/vocab#iceClassDraughtChapter2Provision2021> ;
    sh:message "The 2021 chapter 2 Ice Class Draught provision applies to every ship." ;
