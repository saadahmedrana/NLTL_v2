@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ;
            sh:resultMessage "For an IA or IA Super ship constructed before 1 September 2003, the applicable 2017 Ice Class Regulation method, delivery date, assessment date, and twenty-year deadline evidence must conform to TRF-009." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "For an IA or IA Super ship constructed before 1 September 2003, the applicable 2017 Ice Class Regulation method, delivery date, assessment date, and twenty-year deadline evidence must conform to TRF-009." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:iceClass ?ice ;
                      nltl:constructionStageDate ?stage .

                FILTER (
                    ?ice IN (
                        nltl:iceClassIaSuper,
                        nltl:iceClassIa
                    )
                )
                FILTER (datatype(?stage) = xsd:date)
                FILTER (
                    YEAR(?stage) < 2003 ||
                    (
                        YEAR(?stage) = 2003 &&
                        (
                            MONTH(?stage) < 9 ||
                            (MONTH(?stage) = 9 && DAY(?stage) < 1)
                        )
                    )
                )

                FILTER (
                    NOT EXISTS {
                        $this nltl:deliveryDate ?delivery .
                        FILTER (datatype(?delivery) = xsd:date)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:assessmentDate ?assessment .
                        FILTER (datatype(?assessment) = xsd:date)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:engineOutputComplianceMethod ?method .
                        FILTER (
                            ?method IN (
                                nltl:traficom2017Section3Point2Point2Method,
                                nltl:traficom2017Section3Point2Point4Method
                            )
                        )
                    }
                    ||
                    EXISTS {
                        $this nltl:deliveryDate ?delivery ;
                              nltl:assessmentDate ?assessment .
                        FILTER (datatype(?delivery) = xsd:date)
                        FILTER (datatype(?assessment) = xsd:date)
                        FILTER (
                            YEAR(?assessment) > YEAR(?delivery) + 20 ||
                            (
                                YEAR(?assessment) = YEAR(?delivery) + 20 &&
                                (
                                    MONTH(?assessment) > 1 ||
                                    (MONTH(?assessment) = 1 && DAY(?assessment) > 1)
                                )
                            )
                        )
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF009_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-009-F03/ship> ] .

