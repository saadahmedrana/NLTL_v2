@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F04/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-015-F04/ship>-><https://w3id.org/nltl/vocab#intendedRouteSeaWaterSalinity>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#intendedRouteSeaWaterSalinity> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:SalinityQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#intendedRouteSeaWaterSalinity> ] ] .

