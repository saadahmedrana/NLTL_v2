@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/required> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/required>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/KiloW>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/KiloW> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/ship> ;
            sh:resultMessage "calculatedRequiredPower must be a single decimal power quantity in kW." ;
            sh:resultPath <https://w3id.org/nltl/vocab#calculatedRequiredPower> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                    sh:maxCount 1 ;
                    sh:message "calculatedRequiredPower must be a single decimal power quantity in kW." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/KiloW> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#calculatedRequiredPower> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/required> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/mcr> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/mcr>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/KiloW>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/KiloW> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/ship> ;
            sh:resultMessage "maximumContinuousRatingPower must be a single decimal power quantity in kW." ;
            sh:resultPath <https://w3id.org/nltl/vocab#maximumContinuousRatingPower> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                    sh:maxCount 1 ;
                    sh:message "maximumContinuousRatingPower must be a single decimal power quantity in kW." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/KiloW> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#maximumContinuousRatingPower> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-018-P01/mcr> ] .

