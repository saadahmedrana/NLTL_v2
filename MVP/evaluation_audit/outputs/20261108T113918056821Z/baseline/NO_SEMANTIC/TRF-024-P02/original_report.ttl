@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ;
            sh:resultMessage "For a ship retaining ice class IA or IA Super with construction started before 1 September 2003, construction-stage, delivery, and assessment dates must be valid dates, and assessment must occur no later than 1 January in the year twenty years after delivery." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a ship retaining ice class IA or IA Super with construction started before 1 September 2003, construction-stage, delivery, and assessment dates must be valid dates, and assessment must occur no later than 1 January in the year twenty years after delivery." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceClass ?ice .
    FILTER (
        ?ice IN (
            nltl:iceClassIa,
            nltl:iceClassIaSuper
        )
    )

    {
        FILTER NOT EXISTS {
            $this nltl:constructionStageDate ?constructionDate .
            FILTER (datatype(?constructionDate) = xsd:date)
        }
    }
    UNION
    {
        $this nltl:constructionStageDate ?constructionDate .
        FILTER (datatype(?constructionDate) != xsd:date)
    }
    UNION
    {
        FILTER NOT EXISTS {
            $this nltl:deliveryDate ?deliveryDate .
            FILTER (datatype(?deliveryDate) = xsd:date)
        }
    }
    UNION
    {
        $this nltl:deliveryDate ?deliveryDate .
        FILTER (datatype(?deliveryDate) != xsd:date)
    }
    UNION
    {
        FILTER NOT EXISTS {
            $this nltl:assessmentDate ?assessmentDate .
            FILTER (datatype(?assessmentDate) = xsd:date)
        }
    }
    UNION
    {
        $this nltl:assessmentDate ?assessmentDate .
        FILTER (datatype(?assessmentDate) != xsd:date)
    }
    UNION
    {
        $this nltl:constructionStageDate ?constructionDate .
        $this nltl:deliveryDate ?deliveryDate .
        $this nltl:assessmentDate ?assessmentDate .
        FILTER (datatype(?constructionDate) = xsd:date)
        FILTER (datatype(?deliveryDate) = xsd:date)
        FILTER (datatype(?assessmentDate) = xsd:date)
        FILTER (?constructionDate < "2003-09-01"^^xsd:date)
        FILTER (
            YEAR(?assessmentDate) > YEAR(?deliveryDate) + 20
            ||
            (
                YEAR(?assessmentDate) = YEAR(?deliveryDate) + 20
                &&
                (
                    MONTH(?assessmentDate) > 1
                    ||
                    (
                        MONTH(?assessmentDate) = 1
                        &&
                        DAY(?assessmentDate) > 1
                    )
                )
            )
        )
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-024> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-024-P02/ship> ] .

