@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P07/ship> ;
            sh:resultMessage """Node <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P07/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("2003-09-01", datatype=xsd:date) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#constructionStageDate> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#iceClassDraught> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#shipBreadth> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#shipLength> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#clampedHullGeometryTerm> ] ; sh:sparql [ sh:message Literal("For applicable IA or IA Super ships, clampedHullGeometryTerm must equal the clamped value of ((shipLength * iceClassDraught) / shipBreadth^2)^3, using relative tolerance 1e-6 with a small absolute fallback near zero.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:shipLength ?lengthNode ;
                              nltl:iceClassDraught ?draughtNode ;
                              nltl:shipBreadth ?breadthNode ;
                              nltl:clampedHullGeometryTerm ?resultNode .
                        ?lengthNode qudt:numericValue ?length .
                        ?draughtNode qudt:numericValue ?draught .
                        ?breadthNode qudt:numericValue ?breadth .
                        ?resultNode qudt:numericValue ?reported .
                        BIND((((?length * ?draught) / (?breadth * ?breadth)) *
                              ((?length * ?draught) / (?breadth * ?breadth)) *
                              ((?length * ?draught) / (?breadth * ?breadth))) AS ?raw)
                        BIND(IF(?raw < 5, 5, IF(?raw > 20, 20, ?raw)) AS ?expected)
                        FILTER (
                            ABS(?reported - ?expected) >
                            ((0.000001 * ABS(?expected)) + 0.000000001)
                        )
                    }
                ") ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("2003-09-01", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionStageDate> ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF027Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P07/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P07/ship> ;
            sh:resultMessage "Value nltl:iceClassIb not in list ['<https://w3id.org/nltl/vocab#iceClassIa>', '<https://w3id.org/nltl/vocab#iceClassIaSuper>']" ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#iceClassIa> <https://w3id.org/nltl/vocab#iceClassIaSuper> ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ;
            sh:value <https://w3id.org/nltl/vocab#iceClassIb> ] .

