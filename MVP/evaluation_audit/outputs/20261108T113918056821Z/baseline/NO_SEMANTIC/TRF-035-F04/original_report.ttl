@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/M>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ship> ;
            sh:resultMessage "The ship must provide its rule length as a metre-valued quantity." ;
            sh:resultPath <https://w3id.org/nltl/vocab#ruleLength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide its rule length as a metre-valued quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:nodeKind sh:BlankNodeOrIRI ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#ruleLength> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F04/ruleLength> ] .

