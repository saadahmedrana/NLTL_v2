@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-041-F08/plating> ;
            sh:resultMessage "The plating framing orientation must identify transverse or longitudinal framing." ;
            sh:resultPath <https://w3id.org/nltl/vocab#platingFramingOrientation> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#platingFramingOrientationValue> ;
                    sh:in ( <https://w3id.org/nltl/vocab#transverseFramingOrientation> <https://w3id.org/nltl/vocab#longitudinalFramingOrientation> ) ;
                    sh:maxCount 1 ;
                    sh:message "The plating framing orientation must identify transverse or longitudinal framing." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#platingFramingOrientation> ] ] .

