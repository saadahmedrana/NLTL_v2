@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F02/upperEnd> ;
                    sh:resultMessage "The upper frame end shall be attached to a deck, tank boundary plating, or ice stringer." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The upper frame end shall be attached to a deck, tank boundary plating, or ice stringer." ;
                            sh:minCount 1 ;
                            sh:node [ sh:or ( [ sh:class <https://w3id.org/nltl/vocab#deckStructure> ] [ sh:class <https://w3id.org/nltl/vocab#tankBoundaryPlating> ] [ sh:class <https://w3id.org/nltl/vocab#iceStringer> ] ) ] ;
                            sh:path <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F02/frame> ;
            sh:resultMessage "A frame shall have an upper end whose attached supporting structure is eligible under the requirement." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasUpperEnd> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#frameEnd> ;
                    sh:message "A frame shall have an upper end whose attached supporting structure is eligible under the requirement." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:message "The upper frame end shall be attached to a deck, tank boundary plating, or ice stringer." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:or ( [ ] [ ] [ ] ) ] ;
                                    sh:path <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasUpperEnd> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F02/upperEnd> ] .

