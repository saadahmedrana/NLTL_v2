@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P01/lowerEnd> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
                    sh:minCount 1 ;
                    sh:or ( [ sh:class <https://w3id.org/nltl/vocab#deckStructure> ] [ sh:class <https://w3id.org/nltl/vocab#tankBoundaryPlating> ] [ sh:class <https://w3id.org/nltl/vocab#tankTop> ] [ sh:class <https://w3id.org/nltl/vocab#iceStringer> ] ) ;
                    sh:path <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ] ] .

