@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F02/attachmentRecord> ;
            sh:resultMessage "The frame attachment shall specify a double continuous weld." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameShellWeldType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#weldTypeValue> ;
                    sh:hasValue <https://w3id.org/nltl/vocab#doubleContinuousWeld> ;
                    sh:maxCount 1 ;
                    sh:message "The frame attachment shall specify a double continuous weld." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#frameShellWeldType> ] ] .

