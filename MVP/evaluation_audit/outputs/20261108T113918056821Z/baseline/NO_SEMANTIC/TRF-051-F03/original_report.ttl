@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F03/hullStructure> ;
            sh:resultMessage "Frame profile type is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameProfileType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#frameProfileTypeValue> ;
                    sh:maxCount 1 ;
                    sh:message "Frame profile type is required." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#frameProfileType> ] ] .

