@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F05/lookup> ;
                    sh:resultMessage "The table lookup case must reference TRAFICOM Table 4-8." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#tableReference> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#tableReferenceValue> ;
                            sh:hasValue <https://w3id.org/nltl/vocab#traficomTable4Dash8> ;
                            sh:maxCount 1 ;
                            sh:message "The table lookup case must reference TRAFICOM Table 4-8." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#tableReference> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#tableLookupCase> ; sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:message Literal(\"The table lookup case must include evidence for the table selection.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#lookupSelectionEvidence> ], [ sh:class <https://w3id.org/nltl/vocab#tableReferenceValue> ; sh:hasValue <https://w3id.org/nltl/vocab#traficomTable4Dash8> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The table lookup case must reference TRAFICOM Table 4-8.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#tableReference> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The table lookup case must provide the selected dimensionless gamma factor.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#webFrameTable4Dash8GammaFactor> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasTableLookupCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#tableLookupCase> ;
                            sh:property [ sh:class <https://w3id.org/nltl/vocab#tableReferenceValue> ;
                                    sh:hasValue <https://w3id.org/nltl/vocab#traficomTable4Dash8> ;
                                    sh:maxCount 1 ;
                                    sh:message "The table lookup case must reference TRAFICOM Table 4-8." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#tableReference> ],
                                [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                    sh:message "The table lookup case must include evidence for the table selection." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#lookupSelectionEvidence> ],
                                [ sh:maxCount 1 ;
                                    sh:message "The table lookup case must provide the selected dimensionless gamma factor." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#webFrameTable4Dash8GammaFactor> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasTableLookupCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F05/lookup> ] .

