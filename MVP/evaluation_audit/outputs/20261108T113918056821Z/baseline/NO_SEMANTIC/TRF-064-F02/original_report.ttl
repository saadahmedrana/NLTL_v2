@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The detached-strut applicability value must be false for the plated-bossing case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#detachedStrut> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class <https://w3id.org/nltl/vocab#platedBossingStructure> ; sh:message Literal(\"Each side-propeller shafting assembly must be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#enclosedByPlatedBossing> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasSidePropellerShafting> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class <https://w3id.org/nltl/vocab#platedBossingStructure> ; sh:message Literal(\"Each side-propeller stern tube must be enclosed within plated bossing.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#enclosedByPlatedBossing> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasSternTube> ] ] , [ sh:property [ sh:class <https://w3id.org/nltl/vocab#detachedStrutStructure> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:class <https://w3id.org/nltl/vocab#strutDesignEvidence> ; sh:message Literal(\"Detached struts require design evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#hasStrutDesignEvidence> ], [ sh:class <https://w3id.org/nltl/vocab#strutHullAttachmentEvidence> ; sh:message Literal(\"Detached struts require hull-attachment evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#hasStrutHullAttachmentEvidence> ], [ sh:class <https://w3id.org/nltl/vocab#strutStrengthEvidence> ; sh:message Literal(\"Detached struts require strength evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#hasStrutStrengthEvidence> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasDetachedStrut> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The detached-strut applicability value must be true when detached struts are used.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#detachedStrut> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF064ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-064-F02/ship> ] .

