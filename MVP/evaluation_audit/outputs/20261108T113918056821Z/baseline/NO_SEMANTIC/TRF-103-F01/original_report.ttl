@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-F01/bladeFailureSpindleTorqueFactorValue> ;
                    sh:resultMessage "The blade failure spindle torque factor used for the requirement shall be at least 0.3." ;
                    sh:resultPath <http://qudt.org/schema/qudt/numericValue> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:message "The blade failure spindle torque factor used for the requirement shall be at least 0.3." ;
                            sh:minCount 1 ;
                            sh:minInclusive 0.3 ;
                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ;
                    sh:value 0.29 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The blade failure spindle torque factor used for the requirement shall be at least 0.3.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.3\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladeFailureSpindleTorqueFactor> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "The blade failure spindle torque factor used for the requirement shall be at least 0.3." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 0.3 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#bladeFailureSpindleTorqueFactor> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-103-F01/bladeFailureSpindleTorqueFactorValue> ] .

