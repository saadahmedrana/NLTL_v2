@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ;
                    sh:resultMessage "The framing member support condition must be fixed when continuity, a connection bracket, or demonstrated rotational restraint establishes fixity; otherwise it must be simple support." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2_026_StructuralMemberShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ;
                    sh:resultMessage "Each structural member must identify at least one member support." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasMemberSupport> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each structural member must identify at least one member support." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2_026_MemberSupportShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasMemberSupport> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_026_StructuralMemberShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2_026_StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ] .

