@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/ship> ;
            sh:resultMessage "The ship must identify the structural member to which the local-frame calculation applies." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                    sh:message "The ship must identify the structural member to which the local-frame calculation applies." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc>-><https://w3id.org/nltl/vocab#interpolationUpperEndpoint>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#interpolationUpperEndpoint> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#interpolationPoint> ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape> ;
                            sh:path <https://w3id.org/nltl/vocab#interpolationUpperEndpoint> ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/member> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/member>-><https://w3id.org/nltl/vocab#webHeight>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#webHeight> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-030-QuantityLengthMmShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#webHeight> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-030-StructuralMemberOperandsShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#sectionCalculationCaseStructuralMember> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-030-StructuralMemberOperandsShape> ;
                            sh:path <https://w3id.org/nltl/vocab#sectionCalculationCaseStructuralMember> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/member> ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc>-><https://w3id.org/nltl/vocab#interpolationLowerEndpoint>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#interpolationLowerEndpoint> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#interpolationPoint> ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-030-InterpolationPointShape> ;
                            sh:path <https://w3id.org/nltl/vocab#interpolationLowerEndpoint> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/ship> ;
            sh:resultMessage "The ship must provide a calculation case containing the required external calculation inputs and results." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                    sh:message "The ship must provide a calculation case containing the required external calculation inputs and results." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-030-CalculationCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-F03/calc> ] .

