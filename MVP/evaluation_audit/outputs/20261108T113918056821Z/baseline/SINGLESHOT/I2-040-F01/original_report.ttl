@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/ship> ;
            sh:resultMessage "The ship shall provide exactly one yield-strength quantity in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#yieldStrength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one yield-strength quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_040_YieldStrengthQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#yieldStrength> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/member> ;
                    sh:resultMessage "The structural member shall identify whether it is a flat-bar, bulb, tee, or angle section." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#structuralSectionType> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#flatBarStructuralSection> <https://w3id.org/nltl/vocab#bulbSection> <https://w3id.org/nltl/vocab#teeSection> <https://w3id.org/nltl/vocab#angleSection> ) ;
                            sh:message "The structural member shall identify whether it is a flat-bar, bulb, tee, or angle section." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#structuralSectionType> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/ship> ;
            sh:resultMessage "Each represented structural member shall contain the required local-web-buckling readiness inputs and section classification." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member shall contain the required local-web-buckling readiness inputs and section classification." ;
                    sh:node <urn:nltl:generated-shape:I2_040_StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F01/member> ] .

