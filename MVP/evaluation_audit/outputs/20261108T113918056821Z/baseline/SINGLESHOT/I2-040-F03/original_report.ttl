@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F03/member> ;
                    sh:resultMessage "The structural member shall provide exactly one web-height quantity in mm." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#webHeight> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The structural member shall provide exactly one web-height quantity in mm." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2_040_WebHeightQuantityShape> ;
                            sh:path <https://w3id.org/nltl/vocab#webHeight> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F03/ship> ;
            sh:resultMessage "Each represented structural member shall contain the required local-web-buckling readiness inputs and section classification." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "Each represented structural member shall contain the required local-web-buckling readiness inputs and section classification." ;
                    sh:node <urn:nltl:generated-shape:I2_040_StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F03/member> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F03/ship> ;
            sh:resultMessage "The ship shall provide exactly one yield-strength quantity in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#yieldStrength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one yield-strength quantity in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_040_YieldStrengthQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#yieldStrength> ] ] .

