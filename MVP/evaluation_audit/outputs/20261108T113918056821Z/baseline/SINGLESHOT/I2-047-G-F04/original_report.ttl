@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F04/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-g/I2-047-F04/ship>-><https://w3id.org/nltl/vocab#steelRenewalRequired>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#steelRenewalRequired> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#steelRenewalRequired> ] ] .

