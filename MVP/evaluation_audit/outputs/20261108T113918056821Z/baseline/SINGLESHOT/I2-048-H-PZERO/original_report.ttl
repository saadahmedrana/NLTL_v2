@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-PZERO/ship> ;
            sh:resultMessage "The ship must have exactly one supported Polar Class." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#polarClassValue> ;
                    sh:in ( <https://w3id.org/nltl/vocab#polarClassPc1> <https://w3id.org/nltl/vocab#polarClassPc2> <https://w3id.org/nltl/vocab#polarClassPc3> <https://w3id.org/nltl/vocab#polarClassPc4> <https://w3id.org/nltl/vocab#polarClassPc5> <https://w3id.org/nltl/vocab#polarClassPc6> <https://w3id.org/nltl/vocab#polarClassPc7> ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have exactly one supported Polar Class." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#polarClass> ] ] .

