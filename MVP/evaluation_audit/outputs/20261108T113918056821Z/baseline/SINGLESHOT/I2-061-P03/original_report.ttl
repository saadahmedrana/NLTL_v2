@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
                    sh:resultMessage "A calculation case governed by I2.4, I2.6, or I2.7 shall use the prescribed analytical procedure rather than direct calculation." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#calculationMethod> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#prescribedAnalyticalProcedure> ) ;
                            sh:maxCount 1 ;
                            sh:message "A calculation case governed by I2.4, I2.6, or I2.7 shall use the prescribed analytical procedure rather than direct calculation." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ;
                    sh:value <https://w3id.org/nltl/vocab#directCalculationMethodValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure>-><https://w3id.org/nltl/vocab#thickness>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#thickness> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:I2-061-ThicknessQuantityShape> ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path <https://w3id.org/nltl/vocab#thickness> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-HullStructureShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#calculationCaseAssessedHullStructure> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#hullStructure> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-061-HullStructureShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#calculationCaseAssessedHullStructure> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-061-CalculationCaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                    sh:node <urn:nltl:generated-shape:I2-061-CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-P03/case> ] .

