@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F03/ship> ;
            sh:resultMessage "A ship shall declare a permitted design ice condition for this rule." ;
            sh:resultPath <https://w3id.org/nltl/vocab#designIceCondition> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#openWaterIceCondition> <https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> ) ;
                    sh:message "A ship shall declare a permitted design ice condition for this rule." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#designIceCondition> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F03/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#openWaterIceCondition> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#designIceCondition> ], [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryC> ) ; sh:message Literal(\"A ship designed for open water shall have Polar Code category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#designIceCondition> ], [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryC> ) ; sh:message Literal(\"A ship designed for ice conditions less severe than categories A and B shall have Polar Code category C.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO003ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-003-F03/ship> ] .

