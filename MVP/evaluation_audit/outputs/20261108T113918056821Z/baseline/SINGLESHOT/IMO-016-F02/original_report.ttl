@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ;
                    sh:resultMessage "The Polar Ship Certificate shall use the Appendix I model." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#certificateFormModel> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <https://w3id.org/nltl/vocab#appendixIPolarShipCertificateModel> ;
                            sh:maxCount 1 ;
                            sh:message "The Polar Ship Certificate shall use the Appendix I model." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#certificateFormModel> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#appendixIPolarShipCertificateModel> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The Polar Ship Certificate shall use the Appendix I model.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#certificateFormModel> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPolarShipCertificate> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#polarShipCertificateForm> ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#appendixIPolarShipCertificateModel> ;
                                    sh:maxCount 1 ;
                                    sh:message "The Polar Ship Certificate shall use the Appendix I model." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#certificateFormModel> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasPolarShipCertificate> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/certificate> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-F02/ship> ;
            sh:resultMessage "The certificate language must be recorded." ;
            sh:resultPath <https://w3id.org/nltl/vocab#certificateLanguage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The certificate language must be recorded." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#certificateLanguage> ] ] .

