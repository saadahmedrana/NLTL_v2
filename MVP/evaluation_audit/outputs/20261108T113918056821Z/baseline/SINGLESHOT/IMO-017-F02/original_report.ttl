@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/ship> ;
            sh:resultMessage "The applicable SOLAS certificate schedule is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasSolasCertificateSchedule> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#solasCertificateSchedule> ;
                    sh:message "The applicable SOLAS certificate schedule is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO-017-SolasScheduleShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasSolasCertificateSchedule> ] ] .

