@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-P04/ship> ;
            sh:resultMessage "A ship category of Category A or Category B is required to establish applicability." ;
            sh:resultPath <https://w3id.org/nltl/vocab#shipCategory> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:InConstraintComponent ;
            sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryA> <https://w3id.org/nltl/vocab#polarShipCategoryB> ) ;
                    sh:message "A ship category of Category A or Category B is required to establish applicability." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ;
            sh:value <https://w3id.org/nltl/vocab#polarShipCategoryC> ] .

