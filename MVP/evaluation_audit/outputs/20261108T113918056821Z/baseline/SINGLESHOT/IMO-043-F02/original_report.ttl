@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hazardProtectionCoverage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n98e55db5233c49299d21cc4fd7d1b8f2b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hazardProtectionCoverage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n98e55db5233c49299d21cc4fd7d1b8f2b1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall have hazard protection evidence." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasHazardProtectionEvidence> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                            sh:message "Each machinery installation shall have hazard protection evidence." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#hasHazardProtectionEvidence> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class <https://w3id.org/nltl/vocab#associatedEquipmentItem> ; sh:path <https://w3id.org/nltl/vocab#hasAssociatedEquipment> ], [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:message Literal(\"Each machinery installation shall have hazard protection evidence.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#hasHazardProtectionEvidence> ], [ sh:in ( <https://w3id.org/nltl/vocab#iceAccretionHazard> <https://w3id.org/nltl/vocab#snowAccumulationHazard> <https://w3id.org/nltl/vocab#seawaterIceIngestionHazard> <https://w3id.org/nltl/vocab#liquidFreezingOrViscosityIncreaseHazard> <https://w3id.org/nltl/vocab#seawaterIntakeTemperatureHazard> <https://w3id.org/nltl/vocab#snowIngestionHazard> ) ; sh:message Literal(\"Each applicable hazard shall be one of the permitted Polar Code hazards.\") ; sh:path <https://w3id.org/nltl/vocab#hasApplicableHazard> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasMachineryInstallation> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#iceAccretionHazard> <https://w3id.org/nltl/vocab#snowAccumulationHazard> <https://w3id.org/nltl/vocab#seawaterIceIngestionHazard> <https://w3id.org/nltl/vocab#liquidFreezingOrViscosityIncreaseHazard> <https://w3id.org/nltl/vocab#seawaterIntakeTemperatureHazard> <https://w3id.org/nltl/vocab#snowIngestionHazard> ) ;
                                    sh:message "Each applicable hazard shall be one of the permitted Polar Code hazards." ;
                                    sh:path <https://w3id.org/nltl/vocab#hasApplicableHazard> ],
                                [ sh:class <https://w3id.org/nltl/vocab#associatedEquipmentItem> ;
                                    sh:path <https://w3id.org/nltl/vocab#hasAssociatedEquipment> ],
                                [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                    sh:message "Each machinery installation shall have hazard protection evidence." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#hasHazardProtectionEvidence> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasMachineryInstallation> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F02/mainMachinery> ] .

_:n98e55db5233c49299d21cc4fd7d1b8f2b1 sh:datatype xsd:boolean ;
