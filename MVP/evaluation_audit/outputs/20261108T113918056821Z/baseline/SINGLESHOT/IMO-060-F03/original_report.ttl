@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "The independent sea suction applicability value is required and must be a single boolean." ;
            sh:resultPath <https://w3id.org/nltl/vocab#independentSeaSuctionUsed> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The independent sea suction applicability value is required and must be a single boolean." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#independentSeaSuctionUsed> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO_060_ApplicableBranch> , <urn:nltl:generated-shape:IMO_060_SeparateSystemNotApplicableBranch> , <urn:nltl:generated-shape:IMO_060_IndependentSuctionNotApplicableBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_060_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-F03/ship> ] .

