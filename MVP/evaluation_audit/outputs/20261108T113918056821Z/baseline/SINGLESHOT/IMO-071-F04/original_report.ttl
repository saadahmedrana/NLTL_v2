@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F04/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F04/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#immersionSuitRequired> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#insulatedImmersionSuit> ; sh:message Literal(\"Where immersion suits are required, the immersion suit type must be insulated.\") ; sh:path <https://w3id.org/nltl/vocab#immersionSuitTypeClassification> ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#immersionSuitRequired> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_071_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F04/ship> ] .

