@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ;
                    sh:resultMessage "Each non-magnetic heading means shall identify an independent heading means." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#independentFromHeadingMeans> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#nonMagneticHeadingMeans> ;
                            sh:message "Each non-magnetic heading means shall identify an independent heading means." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#independentFromHeadingMeans> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic means to determine and display heading." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasNonMagneticHeadingMeans> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:n404737c3267e4b73bb81e0b32b5e1624b1 ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/heading1> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "The ship shall have at least two non-magnetic means to determine and display heading." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasNonMagneticHeadingMeans> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n404737c3267e4b73bb81e0b32b5e1624b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ;
            sh:resultMessage "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means belonging to the same ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each non-magnetic heading means shall be independent from another distinct non-magnetic heading means belonging to the same ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasNonMagneticHeadingMeans ?means .
                FILTER NOT EXISTS {
                    ?means nltl:independentFromHeadingMeans ?otherMeans .
                    FILTER (?otherMeans != ?means)
                    $this nltl:hasNonMagneticHeadingMeans ?otherMeans .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_086_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/ship> ] .

_:n404737c3267e4b73bb81e0b32b5e1624b1 sh:class <https://w3id.org/nltl/vocab#nonMagneticHeadingMeans> ;
    sh:message "The ship shall have at least two non-magnetic means to determine and display heading." ;
    sh:minCount 2 ;
    sh:node <urn:nltl:generated-shape:IMO_086_HeadingMeansShape> ;
    sh:nodeKind sh:IRI ;
    sh:path <https://w3id.org/nltl/vocab#hasNonMagneticHeadingMeans> .

