@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F01/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:integer ; sh:message Literal(\"Ships proceeding over 80 degrees require at least one GNSS compass or equivalent.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#gnssCompassOrEquivalentCount> ], [ sh:message Literal(\"The required GNSS compass or equivalent must be connected to the ship's emergency power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#benchmarkEntity> ] ; sh:path <https://w3id.org/nltl/vocab#connectedToEmergencyPower> ], [ sh:message Literal(\"The required GNSS compass or equivalent must be connected to the ship's main power.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#benchmarkEntity> ] ; sh:path <https://w3id.org/nltl/vocab#connectedToMainPower> ], [ sh:node [ sh:property [ sh:minExclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ; sh:path <https://w3id.org/nltl/vocab#plannedOrActualLatitude> ] ] , [ sh:property [ sh:node [ sh:property [ sh:maxInclusive Literal(\"80\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ; sh:path <https://w3id.org/nltl/vocab#plannedOrActualLatitude> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_087_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-087-I-F01/ship> ] .

