@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall provide voice or data communications with relevant rescue coordination centres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#rescueCoordinationCentreVoiceOrData> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne63ddf6ffa724b08a1eaf651674af2beb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath <https://w3id.org/nltl/vocab#searchAndRescueCommunicationCapability> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:ne63ddf6ffa724b08a1eaf651674af2beb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall provide voice or data communications with relevant rescue coordination centres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#rescueCoordinationCentreVoiceOrData> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne63ddf6ffa724b08a1eaf651674af2beb2 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F04/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath <https://w3id.org/nltl/vocab#searchAndRescueCommunicationCapability> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:ne63ddf6ffa724b08a1eaf651674af2beb1 ] .

_:ne63ddf6ffa724b08a1eaf651674af2beb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#searchAndRescueCommunicationCapability> .

_:ne63ddf6ffa724b08a1eaf651674af2beb2 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall provide voice or data communications with relevant rescue coordination centres." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#rescueCoordinationCentreVoiceOrData> .

