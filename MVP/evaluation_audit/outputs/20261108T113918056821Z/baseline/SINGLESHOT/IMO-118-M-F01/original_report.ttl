@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ;
            sh:resultMessage "For an applicable ship constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with paragraph 4.2.1.3 is explicitly true." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For an applicable ship constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with paragraph 4.2.1.3 is explicitly true." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    ?this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus true
                }
                FILTER NOT EXISTS {
                    ?this nltl:sewageDischargeToSea false
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-118> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-118-M-F01/ship> ] .

