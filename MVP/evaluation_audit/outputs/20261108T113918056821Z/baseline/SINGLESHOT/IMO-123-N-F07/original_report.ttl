@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F07/distanceToNearestLandIceShelfOrFastIceValue> ;
                            sh:resultMessage "Value is not >= Literal(\"12.0\", datatype=xsd:decimal)" ;
                            sh:resultPath <http://qudt.org/schema/qudt/numericValue> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 12.0 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ;
                            sh:value 11.99 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F07/distanceRecord> ;
                    sh:resultMessage "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#distanceToNearestLandIceShelfOrFastIce> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO123NearestIceDistanceQuantityShape> ;
                            sh:path <https://w3id.org/nltl/vocab#distanceToNearestLandIceShelfOrFastIce> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F07/distanceToNearestLandIceShelfOrFastIceValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F07/ship> ;
            sh:resultMessage "A discharge-distance record with both required distances must be provided." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasDischargeDistanceRecord> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#dischargeDistanceRecords> ;
                    sh:message "A discharge-distance record with both required distances must be provided." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO123DischargeDistanceRecordShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasDischargeDistanceRecord> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F07/distanceRecord> ] .

