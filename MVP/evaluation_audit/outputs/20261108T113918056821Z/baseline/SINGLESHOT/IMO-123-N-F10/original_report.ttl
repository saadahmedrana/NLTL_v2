@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#distanceToAreaWithIceConcentrationGreaterThanOneTenth> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge-distance record must record the distance from an area with ice concentration greater than one tenth." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO123IceConcentrationDistanceQuantityShape> ;
                            sh:path <https://w3id.org/nltl/vocab#distanceToAreaWithIceConcentrationGreaterThanOneTenth> ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ;
                    sh:resultMessage "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#distanceToNearestLandIceShelfOrFastIce> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The discharge distance must be at least 12 nautical miles from the nearest land, ice shelf, or fast ice." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO123NearestIceDistanceQuantityShape> ;
                            sh:path <https://w3id.org/nltl/vocab#distanceToNearestLandIceShelfOrFastIce> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/ship> ;
            sh:resultMessage "A discharge-distance record with both required distances must be provided." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasDischargeDistanceRecord> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#dischargeDistanceRecords> ;
                    sh:message "A discharge-distance record with both required distances must be provided." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:IMO123DischargeDistanceRecordShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasDischargeDistanceRecord> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-123-N-F10/distanceRecord> ] .

