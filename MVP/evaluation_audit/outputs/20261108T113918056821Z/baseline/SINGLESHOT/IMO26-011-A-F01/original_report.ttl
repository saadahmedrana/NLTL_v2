@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-011-A-F01/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2025-12-31\", datatype=xsd:date) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#constructionDate> ], [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryA> <https://w3id.org/nltl/vocab#polarShipCategoryB> ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ] , [ sh:message Literal(\"Category A or B ships constructed on or after 2026-01-01 shall have enclosed bridge wings, approved bridge-wing protection design, or administration-approved equivalent protection.\") ; sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#bridgeWingsEnclosed> ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#bridgeWingProtectionDesignStatus> ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#administrationApprovedEquivalentBridgeWingProtectionPresent> ] ] ) ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2026-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionDate> ], [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryA> <https://w3id.org/nltl/vocab#polarShipCategoryB> ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
