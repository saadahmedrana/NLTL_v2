@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:TRF006BeforeCohortShape> , <urn:nltl:generated-shape:TRF006ApplicableCohortShape> , <urn:nltl:generated-shape:TRF006AfterCohortShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF006Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-006-F03/ship> ] .

