            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n2d5fcb8bd6834c339820428ec7920984b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F03/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameShellWeldType> ;
            sh:resultSeverity sh:Violation ;
