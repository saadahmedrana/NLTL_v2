@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Each frame attachment record shall be linked from a frame by frameAttachment." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each frame attachment record shall be linked from a frame by frameAttachment." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?frame nltl:frameAttachment $this .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_050_FrameAttachmentRecordShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#shellPlateButtCrossing> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Scalloping is not allowed when the frame attachment does not cross a shell plate butt.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#scallopingPresent> ], [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#shellPlateButtCrossing> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_050_FrameAttachmentRecordShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/frame> ;
            sh:resultMessage "Each frame attachment record shall state whether a shell plate butt is crossed." ;
            sh:resultPath <https://w3id.org/nltl/vocab#shellPlateButtCrossing> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each frame attachment record shall state whether a shell plate butt is crossed." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shellPlateButtCrossing> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameShellWeldType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n75c8f287d83d46c0af7de8c291b75cb1b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-050-F05/attachmentRecord> ;
            sh:resultMessage "Each frame attachment record shall specify a double continuous weld." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameShellWeldType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n75c8f287d83d46c0af7de8c291b75cb1b1 ] .

_:n75c8f287d83d46c0af7de8c291b75cb1b1 sh:class <https://w3id.org/nltl/vocab#weldTypeValue> ;
    sh:hasValue <https://w3id.org/nltl/vocab#doubleContinuousWeld> ;
    sh:maxCount 1 ;
    sh:message "Each frame attachment record shall specify a double continuous weld." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#frameShellWeldType> .

