            sh:resultMessage "Each ice stringer must specify one section modulus in cm^3." ;
            sh:resultPath <https://w3id.org/nltl/vocab#sectionModulus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one section modulus in cm^3." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/CentiM3> ;
