                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/yieldStrengthValue> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/yieldStrengthValue>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/MegaPA> ;
                            sh:maxCount 1 ;
