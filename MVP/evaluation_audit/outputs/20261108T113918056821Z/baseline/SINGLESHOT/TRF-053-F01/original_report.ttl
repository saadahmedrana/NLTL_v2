            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one yield strength in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#yieldStrength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#yieldStrength> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/yieldStrengthValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ;
            sh:resultMessage "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas, using a relative tolerance of 1e-6 plus an absolute fallback of 1e-12 for calculated decimal results." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Design line load, section modulus, and required shear area must satisfy the declared ice-stringer formulas, using a relative tolerance of 1e-6 plus an absolute fallback of 1e-12 for calculated decimal results." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:icePressure ?pNode ;
                      nltl:designIceLoadHeight ?hNode ;
                      nltl:span ?lNode ;
                      nltl:frameMomentFactorM ?mNode ;
                      nltl:yieldStrength ?sigmaNode ;
                      nltl:designLineLoad ?lineNode ;
                      nltl:sectionModulus ?zNode ;
                      nltl:requiredShearArea ?aNode .

                ?pNode qudt:numericValue ?p .
                ?hNode qudt:numericValue ?h .
                ?lNode qudt:numericValue ?l .
                ?mNode qudt:numericValue ?m .
                ?sigmaNode qudt:numericValue ?sigma .
                ?lineNode qudt:numericValue ?line .
                ?zNode qudt:numericValue ?z .
                ?aNode qudt:numericValue ?a .

                BIND((?p * ?h) AS ?product)
                BIND(IF(?product < 0.15, 0.15, ?product) AS ?expectedLine)
                BIND((0.9 * 1.8 * ?expectedLine * ?l * ?l /
                      (?m * ?sigma) * 1000000) AS ?expectedZ)
                BIND((1.7320508075688772 * 0.9 * 1.8 * 1.2 * ?expectedLine * ?l /
                      (2 * ?sigma) * 10000) AS ?expectedA)

                FILTER(
                    ABS(?line - ?expectedLine) >
                    (0.000001 * ABS(?expectedLine) + 0.000000000001)
                    ||
                    ABS(?z - ?expectedZ) >
                    (0.000001 * ABS(?expectedZ) + 0.000000000001)
                    ||
                    ABS(?a - ?expectedA) >
                    (0.000001 * ABS(?expectedA) + 0.000000000001)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF053IceStringerShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F01/iceStringer> ] .

