@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#abreastOfHatch> ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#servesAsIceStringer> ] ] , [ sh:node <urn:nltl:generated-shape:TRF055ApplicableShape> ; sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#abreastOfHatch> ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#servesAsIceStringer> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF055Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F02/narrowDeckStrip> ] .

