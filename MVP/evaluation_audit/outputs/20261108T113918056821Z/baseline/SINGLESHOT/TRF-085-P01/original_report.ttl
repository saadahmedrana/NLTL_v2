@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "A ship must state whether the bollard propeller speed is known." ;
            sh:resultPath <https://w3id.org/nltl/vocab#bollardPropellerSpeedKnown> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "A ship must state whether the bollard propeller speed is known." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#bollardPropellerSpeedKnown> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#bollardPropellerSpeedKnown> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The known bollard propeller speed at MCR must be provided in revolutions per minute.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#propellerRotationalSpeedAtMaximumContinuousRatingBollard> ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#bollardPropellerSpeedKnown> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The Table 6-9 bollard propeller speed at MCR must be provided in revolutions per minute.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/REV-PER-MIN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#propellerRotationalSpeedAtMaximumContinuousRatingBollard> ], [ sh:message Literal(\"When the bollard propeller speed is not known, a Table 6-9 lookup case is required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF085LookupCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasTableLookupCase> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF085Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/ship> ] .

