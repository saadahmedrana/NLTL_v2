@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/ship>-><https://w3id.org/nltl/vocab#iceClass>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/triangle> ;
                    sh:resultMessage "Value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/blue> not in list ['<https://w3id.org/nltl/vocab#yellowReflectingMarkingColour>', '<https://w3id.org/nltl/vocab#redReflectingMarkingColour>']" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#reflectingMarkingColour> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                    sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#redReflectingMarkingColour> <https://w3id.org/nltl/vocab#yellowReflectingMarkingColour> ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#reflectingMarkingColour> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/blue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF133WarningTriangleMarkingShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasWarningTriangleMarking> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF133WarningTriangleMarkingShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasWarningTriangleMarking> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F03/triangle> ] .

