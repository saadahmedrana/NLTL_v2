@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F04/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F04/ship>-><https://w3id.org/nltl/vocab#iceClass>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F04/triangle> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F04/triangle>-><https://w3id.org/nltl/vocab#markingWeldedToShipSide> does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#markingWeldedToShipSide> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#markingWeldedToShipSide> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF133WarningTriangleMarkingShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasWarningTriangleMarking> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF133WarningTriangleMarkingShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasWarningTriangleMarking> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F04/triangle> ] .

