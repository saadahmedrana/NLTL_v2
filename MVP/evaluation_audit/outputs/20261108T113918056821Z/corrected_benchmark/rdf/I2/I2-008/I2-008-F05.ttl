@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-008-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:glancingImpactPressure ex:glancingImpactPressure ;
    nltl:hasBowSubregionCalculationCase ex:bowCase ;
    nltl:polarClass ex:polarClass .

ex:bowCase a nltl:bowSubregionCalculationCase ;
    nltl:bowShapeCoefficient ex:bowShapeCoefficient ;
    nltl:glancingImpactLineLoad ex:glancingImpactLineLoad ;
    nltl:totalGlancingImpactForce ex:totalGlancingImpactForce .

ex:bowShapeCoefficient a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:UNITLESS .

ex:glancingImpactLineLoad a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:MegaN-M-PER-M2 .

ex:glancingImpactPressure a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MegaPA .

ex:polarClass a nltl:polarClassValue .

ex:totalGlancingImpactForce a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:KiloN .

