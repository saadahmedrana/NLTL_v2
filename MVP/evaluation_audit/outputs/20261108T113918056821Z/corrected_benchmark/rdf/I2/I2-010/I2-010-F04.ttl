@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bowDesignForceMethod "I2.3.2.1(iii)"^^xsd:string ;
    nltl:bowVerticalSideStatus true ;
    nltl:normalFrameAngle ex:beta ;
    nltl:polarClass nltl:polarClassPc7 ;
    nltl:verticalSidedBowForm true .

ex:beta a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DEG .

