@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPlating ex:plating .

ex:averageIcePressure a qudt:QuantityValue ;
    qudt:numericValue 1.5 ;
    qudt:unit unit:MegaPA .

ex:frameSpacing a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:M .

ex:frameSpan a qudt:QuantityValue ;
    qudt:numericValue 2.5 ;
    qudt:unit unit:M .

ex:loadPatchHeight a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:member a nltl:structuralMember ;
    nltl:frameSpacing ex:frameSpacing ;
    nltl:frameSpan ex:frameSpan ;
    nltl:selectedHullAreaFactor ex:selectedHullAreaFactor ;
    nltl:yieldStrength ex:yieldStrength .

ex:omega a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:DEG .

ex:peakPressureFactor a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

ex:plating a nltl:plating ;
    nltl:averageIcePressure ex:averageIcePressure ;
    nltl:framingAngleOmega ex:omega ;
    nltl:loadPatchHeight ex:loadPatchHeight ;
    nltl:peakPressureFactor ex:peakPressureFactor ;
    nltl:platingSupportedByStructuralMember ex:member .

ex:selectedHullAreaFactor a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:yieldStrength a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

