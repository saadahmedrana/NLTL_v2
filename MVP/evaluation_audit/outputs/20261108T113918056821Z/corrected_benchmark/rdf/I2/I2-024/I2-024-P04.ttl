@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:lowerEndpoint a nltl:interpolationPoint .

ex:ship a nltl:ship ;
    nltl:hasObliquePlatingInterpolationCase ex:case .

ex:upperEndpoint a nltl:interpolationPoint .

ex:case a nltl:calculationCase,
        nltl:obliquePlatingInterpolationCase ;
    nltl:framingAngle ex:framingAngle .

ex:framingAngle a qudt:QuantityValue ;
    qudt:numericValue 70.0 ;
    qudt:unit unit:DEG .

