@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-a/I2-037-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:loadcase a nltl:loadCase ;
    nltl:memberCapacityMinimizationConfirmed true .

ex:member a nltl:structuralMember,
        nltl:webFrame ;
    nltl:hasStructuralMemberLoadCase ex:loadcase .

