@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-i/I2-051-I-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCalculationCase ex:calculation ;
    nltl:upperIceWaterlineLengthLUI ex:lui .

ex:calculation a nltl:calculationCase ;
    nltl:designVerticalIceShearForce ex:fi ;
    nltl:hullGirderLongitudinalPositionFromAft ex:x ;
    nltl:longitudinalDistributionFactor ex:cf ;
    nltl:shearForceDirection nltl:positiveShearForce .

ex:cf a qudt:QuantityValue ;
    qudt:numericValue 0.5000000000000001 ;
    qudt:unit unit:UNITLESS .

ex:fi a qudt:QuantityValue ;
    qudt:numericValue 2500.0000000000005 ;
    qudt:unit unit:KiloN .

ex:lui a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:M .

ex:x a qudt:QuantityValue ;
    qudt:numericValue 75.0 ;
    qudt:unit unit:M .

