@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCalculationCase ex:calculation .

ex:calculation a nltl:calculationCase ;
    nltl:calculationMethod nltl:nonlinearCalculationMethodValue ;
    nltl:fractureMargin ex:fractureMargin ;
    nltl:majorBucklingMargin ex:majorBucklingMargin ;
    nltl:minorPermanentDeformationAssessmentSatisfied true ;
    nltl:nonlinearAnalysisAcceptanceEvidence ex:evidence ;
    nltl:permanentOutOfPlaneDeformation ex:permanentOutOfPlaneDeformation ;
    nltl:relevantStructuralDimension ex:relevantStructuralDimension ;
    nltl:yieldingMargin ex:yieldingMargin .

ex:evidence a nltl:evidenceArtifact .

ex:fractureMargin a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

ex:majorBucklingMargin a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

ex:permanentOutOfPlaneDeformation a qudt:QuantityValue ;
    qudt:numericValue 0.002 ;
    qudt:unit unit:MilliM .

ex:relevantStructuralDimension a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MilliM .

ex:yieldingMargin a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

