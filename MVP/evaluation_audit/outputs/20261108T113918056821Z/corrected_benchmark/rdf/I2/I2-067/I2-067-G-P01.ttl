@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-067-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:structuralConnection ex:connection1 .

ex:connection1 a nltl:benchmarkEntity ;
    nltl:strengthContinuityStatus true .

