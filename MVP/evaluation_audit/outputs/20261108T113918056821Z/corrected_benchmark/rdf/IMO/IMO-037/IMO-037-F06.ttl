@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-037-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:hasLoadingConditionCase ex:LC1 ;
    nltl:hasLoadingConditionResultEvidence ex:LC1Evidence ;
    nltl:shipCategory nltl:polarShipCategoryA .

ex:LC1 a nltl:loadingConditionCase ;
    nltl:alternativeInstrumentApplicable false ;
    nltl:loadingConditionIdentifier "LC1"^^xsd:string ;
    nltl:residualStabilityFactorSI ex:residualStabilityFactorSIValue .

ex:LC1Evidence a nltl:evidenceArtifact .

ex:residualStabilityFactorSIValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

