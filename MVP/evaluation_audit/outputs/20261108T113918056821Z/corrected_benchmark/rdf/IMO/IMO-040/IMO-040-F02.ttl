@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-040-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasRelevantHatchOrDoor ex:door1,
        ex:hatch1 ;
    nltl:iceAccretionLikely true .

ex:door1 a nltl:relevantHatchOrDoorItem ;
    nltl:relevantHatchOrDoor "door1"^^xsd:string .

ex:hatch1 a nltl:relevantHatchOrDoorItem ;
    nltl:hasIceOrSnowRemovalOrPreventionMeans ex:hatch1Means ;
    nltl:relevantHatchOrDoor "hatch1"^^xsd:string .

ex:hatch1Means a nltl:iceSnowRemovalOrPreventionMeans .

