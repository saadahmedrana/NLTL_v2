@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    nltl:approvingAuthority "manufacturer"^^xsd:string ;
    nltl:exposedMachineryOrFoundationMaterial "exposed machinery/foundation material"^^xsd:string ;
    nltl:materialApprovalStatus nltl:evidenceStateApproved ;
    nltl:polarServiceTemperature ex:polarServiceTemperatureValue .

ex:polarServiceTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue -30.0 ;
    qudt:unit unit:DEG_C .

