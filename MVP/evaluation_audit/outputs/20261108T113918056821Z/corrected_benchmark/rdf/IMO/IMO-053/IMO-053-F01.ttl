@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-053-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasExtinguishingMedium ex:medium1 .

ex:medium1 a nltl:extinguishingMediumItem ;
    nltl:intendedOperationCompatibilityStatus false .

