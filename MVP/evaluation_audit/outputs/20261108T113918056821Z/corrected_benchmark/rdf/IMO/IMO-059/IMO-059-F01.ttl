@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-059-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasFirefighterOutfit ex:outfit1 .

ex:outfit1 a nltl:firefighterOutfitItem ;
    nltl:hasStorageLocation ex:outfit1Store .

ex:outfit1ColdClass a nltl:storageTemperatureClassValue .

ex:outfit1Store a nltl:physicalStorageLocation ;
    nltl:storageTemperatureClass ex:outfit1ColdClass .

