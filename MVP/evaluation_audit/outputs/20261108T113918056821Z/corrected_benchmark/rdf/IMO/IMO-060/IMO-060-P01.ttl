@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-060-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:fixedWaterSystemSeparateFromMainFirePumps true ;
    nltl:independentSeaSuctionUsed true ;
    nltl:seaSuctionIceClearingCapability true .

