@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPersonOnBoardMember ex:person1 .

ex:person1 a nltl:personOnBoardMember ;
    nltl:hasPersonalSurvivalEquipmentAssignment ex:person1Assignment1 .

ex:person1Assignment1 a nltl:personalSurvivalEquipmentAssignment ;
    nltl:assignedPersonalSurvivalEquipment ex:person1Equipment1 .

ex:person1Equipment1 a nltl:personalSurvivalEquipment ;
    nltl:sizeCompatibilityStatus false .

