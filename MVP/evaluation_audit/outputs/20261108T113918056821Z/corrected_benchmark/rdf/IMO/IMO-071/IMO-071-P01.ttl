@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:immersionSuitRequired true ;
    nltl:immersionSuitTypeClassification nltl:insulatedImmersionSuit .

