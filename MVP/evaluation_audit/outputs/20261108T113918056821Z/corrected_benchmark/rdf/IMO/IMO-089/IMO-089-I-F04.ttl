@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:colregSternLightArcComplianceStatus false ;
    nltl:icebreakerEscortOperation true ;
    nltl:lightVisibleFromAstern true ;
    nltl:manuallyInitiatedFlashingRedStoppedLightPresent true ;
    nltl:visibilityRange ex:visibilityRangeValue .

ex:visibilityRangeValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:MI_N .

