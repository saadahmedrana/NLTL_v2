@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-P06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:aggregateOilFuelCapacity ex:aggregateOilFuelCapacityValue ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:individualOilFuelTankCapacity ex:individualOilFuelTankCapacityValue ;
    nltl:oilFuelTankOuterShellSeparation ex:oilFuelTankOuterShellSeparationValue ;
    nltl:shipCategory nltl:polarShipCategoryC .

ex:aggregateOilFuelCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 599.0 ;
    qudt:unit unit:M3 .

ex:individualOilFuelTankCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 31.0 ;
    qudt:unit unit:M3 .

ex:oilFuelTankOuterShellSeparationValue a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

