@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:contaminatedByOtherGarbage false ;
    nltl:foodWasteComminutedOrGround true ;
    nltl:requiredScreenOpening ex:requiredScreenOpeningValue .

ex:requiredScreenOpeningValue a qudt:QuantityValue ;
    qudt:numericValue 25.0 ;
    qudt:unit unit:MilliM .

