@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-P09/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:engagedInTrade false ;
    nltl:grossTonnage ex:grossTonnageValue ;
    nltl:lengthOverall ex:lengthOverallValue ;
    nltl:polarCodeChapter11Dash1Applicable false ;
    nltl:shipOperatesInPolarWaters false ;
    nltl:shipType "fishing_vessel"^^xsd:string .

ex:grossTonnageValue a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:UNITLESS .

ex:lengthOverallValue a qudt:QuantityValue ;
    qudt:numericValue 30.0 ;
    qudt:unit unit:M .

