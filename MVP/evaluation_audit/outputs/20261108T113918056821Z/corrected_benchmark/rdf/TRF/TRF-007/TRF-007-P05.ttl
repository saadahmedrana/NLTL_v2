@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:assessmentDate "2025-01-01"^^xsd:date ;
    nltl:constructionStageDate "2003-09-01"^^xsd:date ;
    nltl:deliveryDate "2000-06-01"^^xsd:date ;
    nltl:iceClass nltl:iceClassIa .

