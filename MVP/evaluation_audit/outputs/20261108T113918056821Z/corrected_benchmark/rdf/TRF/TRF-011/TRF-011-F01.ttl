@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-011-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasIntendedIceOperatingWaterline ex:intendedLine1,
        ex:intendedLine2 ;
    nltl:hasUpperIceWaterline ex:upperIceWaterline .

ex:i1Point1 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:i1X1 ;
    nltl:verticalCoordinate ex:i1Z1 .

ex:i1Point2 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:i1X2 ;
    nltl:verticalCoordinate ex:i1Z2 .

ex:i1X1 a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

ex:i1X2 a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

ex:i1Z1 a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:i1Z2 a qudt:QuantityValue ;
    qudt:numericValue 4.5 ;
    qudt:unit unit:M .

ex:i2Point1 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:i2X1 ;
    nltl:verticalCoordinate ex:i2Z1 .

ex:i2Point2 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:i2X2 ;
    nltl:verticalCoordinate ex:i2Z2 .

ex:i2X1 a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

ex:i2X2 a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

ex:i2Z1 a qudt:QuantityValue ;
    qudt:numericValue 4.2 ;
    qudt:unit unit:M .

ex:i2Z2 a qudt:QuantityValue ;
    qudt:numericValue 4.3 ;
    qudt:unit unit:M .

ex:intendedLine1 a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint ex:i1Point1,
        ex:i1Point2 .

ex:intendedLine2 a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint ex:i2Point1,
        ex:i2Point2 .

ex:upperIceWaterline a nltl:iceWaterline ;
    nltl:hasWaterlineProfilePoint ex:upperPoint1,
        ex:upperPoint2 .

ex:upperPoint1 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:upperX1 ;
    nltl:verticalCoordinate ex:upperZ1 .

ex:upperPoint2 a nltl:waterlineProfilePoint ;
    nltl:longitudinalPosition ex:upperX2 ;
    nltl:verticalCoordinate ex:upperZ2 .

ex:upperX1 a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

ex:upperX2 a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

ex:upperZ1 a qudt:QuantityValue ;
    qudt:numericValue 4.1 ;
    qudt:unit unit:M .

ex:upperZ2 a qudt:QuantityValue ;
    qudt:numericValue 4.5 ;
    qudt:unit unit:M .

