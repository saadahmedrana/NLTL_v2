@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasLowerIceWaterline ex:lowerIceWaterline ;
    nltl:maximumIceClassDraughtAft ex:maximumIceClassDraughtAft ;
    nltl:maximumIceClassDraughtFore ex:maximumIceClassDraughtFore ;
    nltl:minimumIceClassDraughtAft ex:minimumIceClassDraughtAft ;
    nltl:minimumIceClassDraughtFore ex:minimumIceClassDraughtFore ;
    nltl:operatingAftDraught ex:operatingAftDraught ;
    nltl:operatingForeDraught ex:operatingForeDraught ;
    nltl:shipIceStrengthened false .

ex:upperIceWaterline a nltl:iceWaterline .

ex:lowerIceWaterline a nltl:iceWaterline .

ex:maximumIceClassDraughtAft a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

ex:maximumIceClassDraughtFore a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

ex:minimumIceClassDraughtAft a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:minimumIceClassDraughtFore a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:operatingAftDraught a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:operatingForeDraught a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

