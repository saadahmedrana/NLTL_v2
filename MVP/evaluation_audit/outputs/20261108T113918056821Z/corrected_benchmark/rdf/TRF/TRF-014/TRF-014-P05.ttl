@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:assessmentDate "2026-01-01"^^xsd:date ;
    nltl:constructionDate "2010-01-01"^^xsd:date ;
    nltl:hasClassCertificate ex:certificate ;
    nltl:hasIceDraughtRestrictionDocument ex:restrictionDocument ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:summerLoadLineFreshWaterDraught ex:summer ;
    nltl:upperIceWaterlineDraught ex:uiwl .

ex:cert_maximumIceClassDraughtAft a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

ex:cert_maximumIceClassDraughtAmidships a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

ex:cert_maximumIceClassDraughtFore a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

ex:cert_minimumIceClassDraughtAft a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:cert_minimumIceClassDraughtAmidships a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:cert_minimumIceClassDraughtFore a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:certificate a nltl:classCertificate ;
    nltl:maximumIceClassDraughtAft ex:cert_maximumIceClassDraughtAft ;
    nltl:maximumIceClassDraughtAmidships ex:cert_maximumIceClassDraughtAmidships ;
    nltl:maximumIceClassDraughtFore ex:cert_maximumIceClassDraughtFore ;
    nltl:minimumIceClassDraughtAft ex:cert_minimumIceClassDraughtAft ;
    nltl:minimumIceClassDraughtAmidships ex:cert_minimumIceClassDraughtAmidships ;
    nltl:minimumIceClassDraughtFore ex:cert_minimumIceClassDraughtFore .

ex:restrictionDocument a nltl:iceDraughtRestrictionDocument ;
    nltl:readilyAvailableToMaster true ;
    nltl:retainedOnBoard true .

ex:summer a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

ex:uiwl a qudt:QuantityValue ;
    qudt:numericValue 6.0 ;
    qudt:unit unit:M .

