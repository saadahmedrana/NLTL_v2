@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceClassFactorCp ex:iceClassFactorCp ;
    nltl:iceLoadAreaFactorCa ex:iceLoadAreaFactorCa ;
    nltl:icePressure ex:icePressure ;
    nltl:nominalIcePressureP0 ex:nominalIcePressureP0 ;
    nltl:shipSizeEngineOutputCoefficientA ex:shipSizeEngineOutputCoefficientA ;
    nltl:shipSizeEngineOutputCoefficientB ex:shipSizeEngineOutputCoefficientB ;
    nltl:shipSizeEngineOutputCoefficientK ex:shipSizeEngineOutputCoefficientK ;
    nltl:shipSizeEngineOutputFactorCd ex:shipSizeEngineOutputFactorCd .

ex:iceClassFactorCp a qudt:QuantityValue ;
    qudt:numericValue 0.75 ;
    qudt:unit unit:UNITLESS .

ex:iceLoadAreaFactorCa a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:UNITLESS .

ex:icePressure a qudt:QuantityValue ;
    qudt:numericValue 2.0999999999999996 ;
    qudt:unit unit:MegaPA .

ex:nominalIcePressureP0 a qudt:QuantityValue ;
    qudt:numericValue 5.6 ;
    qudt:unit unit:MegaPA .

ex:shipSizeEngineOutputCoefficientA a qudt:QuantityValue ;
    qudt:numericValue 30.0 ;
    qudt:unit unit:UNITLESS .

ex:shipSizeEngineOutputCoefficientB a qudt:QuantityValue ;
    qudt:numericValue 230.0 ;
    qudt:unit unit:UNITLESS .

ex:shipSizeEngineOutputCoefficientK a qudt:QuantityValue ;
    qudt:numericValue 25.666666666666668 ;
    qudt:unit unit:UNITLESS .

ex:shipSizeEngineOutputFactorCd a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

