@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-040-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceClass nltl:iceClassIb ;
    nltl:openWaterServiceSpeed ex:openWaterServiceSpeedValue ;
    nltl:sidescuttleInIceBelt false ;
    nltl:weatherDeckBelowIceBeltUpperLimit false .

ex:openWaterServiceSpeedValue a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:KN .

