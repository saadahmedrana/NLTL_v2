@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame,
        nltl:longitudinalFrame ;
    nltl:effectiveAttachmentConfirmed true ;
    nltl:hasSupportingBulkhead ex:bulkhead ;
    nltl:hasSupportingWebFrame ex:webFrame ;
    nltl:withinIceStrengthenedArea true .

ex:bulkhead a nltl:bulkhead .

ex:webFrame a nltl:supportingStructure .

