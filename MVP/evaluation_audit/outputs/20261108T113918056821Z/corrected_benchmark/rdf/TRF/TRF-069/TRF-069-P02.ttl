@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-069-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:fixedPitchPropellerReversalLoadIncluded true ;
    nltl:iceClass nltl:iceClassIi ;
    nltl:maximumIceTorque ex:maximumIceTorqueValue ;
    nltl:normalOperationalConditions true ;
    nltl:normalServiceLifePropellerIceLoadCondition true ;
    nltl:pitchType "fixed"^^xsd:string ;
    nltl:propellerType "open"^^xsd:string ;
    nltl:radialIceEntryOutsideLoadModel true ;
    nltl:stoppedPropellerDraggingOutsideLoadModel true .

ex:maximumIceTorqueValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN-M .

