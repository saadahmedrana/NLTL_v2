@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-079-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceLoadCycleCoefficientK2 ex:iceLoadCycleCoefficientK2Value ;
    nltl:propellerDiameter ex:propellerDiameterValue ;
    nltl:propellerImmersionFunction ex:propellerImmersionFunctionValue ;
    nltl:propellerShaftCentrelineDepth ex:propellerShaftCentrelineDepthValue .

ex:iceLoadCycleCoefficientK2Value a qudt:QuantityValue ;
    qudt:numericValue 1.3 ;
    qudt:unit unit:UNITLESS .

ex:propellerDiameterValue a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:propellerImmersionFunctionValue a qudt:QuantityValue ;
    qudt:numericValue -0.5 ;
    qudt:unit unit:UNITLESS .

ex:propellerShaftCentrelineDepthValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

