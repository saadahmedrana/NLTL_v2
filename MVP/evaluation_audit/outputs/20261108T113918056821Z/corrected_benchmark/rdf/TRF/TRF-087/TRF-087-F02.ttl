@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-087-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:inertiaRatioIeIt ex:inertiaRatioIeItValue .

ex:inertiaRatioIeItValue a qudt:QuantityValue ;
    qudt:numericValue 1.2 ;
    qudt:unit unit:UNITLESS .

