@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:approvedSpindleTorqueStressAnalysis ex:analysis ;
    nltl:maximumSpindleTorque ex:maximumSpindleTorqueValue .

ex:analysis a nltl:evidenceArtifact .

ex:maximumSpindleTorqueValue a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:KiloN-M .

