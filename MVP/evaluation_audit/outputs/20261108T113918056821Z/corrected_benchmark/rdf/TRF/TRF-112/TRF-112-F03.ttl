@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPropellerShaftLineComponent ex:component ;
    nltl:hasPropulsionLoadCase ex:loadCase .

ex:bendingYieldSafetyFactorValue a qudt:QuantityValue ;
    qudt:numericValue 0.9 ;
    qudt:unit unit:UNITLESS .

ex:bladeFailureUltimateLoadValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:combinedAxialBendingTorsionLoadValue a qudt:QuantityValue ;
    qudt:numericValue 600.0 ;
    qudt:unit unit:KiloN .

ex:component a nltl:propellerShaftLineComponent ;
    nltl:bendingYieldSafetyFactor ex:bendingYieldSafetyFactorValue ;
    nltl:torsionalYieldSafetyFactor ex:torsionalYieldSafetyFactorValue .

ex:loadCase a nltl:loadCase ;
    nltl:bladeFailureUltimateLoad ex:bladeFailureUltimateLoadValue ;
    nltl:combinedAxialBendingTorsionLoad ex:combinedAxialBendingTorsionLoadValue ;
    nltl:shaftLineLoadCaseType nltl:bladeFailureLoadCase .

ex:torsionalYieldSafetyFactorValue a qudt:QuantityValue ;
    qudt:numericValue 0.9 ;
    qudt:unit unit:UNITLESS .

