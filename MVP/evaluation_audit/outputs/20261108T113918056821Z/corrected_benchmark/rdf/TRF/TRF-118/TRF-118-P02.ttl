@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:componentMaterialYieldStrength ex:componentMaterialYieldStrengthValue ;
    nltl:hasFactoredExtremeLoadOperabilityAssessment ex:assessment ;
    nltl:localStressConcentration ex:localStressConcentrationValue ;
    nltl:nominalVonMisesStress ex:nominalVonMisesStressValue ;
    nltl:thrusterExtremeLoad ex:thrusterExtremeLoadValue ;
    nltl:yieldSafetyFactor ex:yieldSafetyFactorValue .

ex:assessedFactoredExtremeLoadValue a qudt:QuantityValue ;
    qudt:numericValue 1300.0 ;
    qudt:unit unit:KiloN .

ex:assessment a nltl:factoredExtremeLoadOperabilityAssessment ;
    nltl:assessedFactoredExtremeLoad ex:assessedFactoredExtremeLoadValue ;
    nltl:assessedThrusterComponent ex:component ;
    nltl:assessmentOperabilityMaintained true ;
    nltl:assessmentRepairRequired false .

ex:component a nltl:shipComponent .

ex:componentMaterialYieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:MegaPA .

ex:localStressConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:nominalVonMisesStressValue a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:MegaPA .

ex:thrusterExtremeLoadValue a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:KiloN .

ex:yieldSafetyFactorValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

