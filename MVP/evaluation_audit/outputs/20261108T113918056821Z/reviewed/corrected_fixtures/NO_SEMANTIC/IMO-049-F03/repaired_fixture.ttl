@prefix ns1: <http://qudt.org/schema/qudt/> .
@prefix ns2: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> a ns2:ship ;
    ns2:hasComponent <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendage> ;
    ns2:shipCategory ns2:polarShipCategoryC ;
    ns2:shipIceStrengthened true .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendage> a ns2:machineryComponent ;
    ns2:hasApprovalRecord <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendageApproval> ;
    ns2:machineryComponentType "other appendage"^^xsd:string .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendageApproval> a ns2:approvalRecord ;
    ns2:approvalStandard "acceptable standard adequate for operating ice type and concentration"^^xsd:string ;
    ns2:approvingAuthority "Administration"^^xsd:string ;
    ns2:operatingIceConcentration <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/operatingIceConcentrationValue> ;
    ns2:operatingIceType "medium first-year ice"^^xsd:string ;
    ns2:scantlingApprovalStatus ns2:evidenceStateApproved .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/operatingIceConcentrationValue> a ns1:QuantityValue ;
    ns1:numericValue 0.7 ;
    ns1:unit <http://qudt.org/vocab/unit/UNITLESS> .

