@prefix ns1: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/ship> a ns1:ship ;
    ns1:hasComponent <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/propeller> ;
    ns1:shipCategory ns1:polarShipCategoryA ;
    ns1:shipIceStrengthened true .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/propeller> a ns1:machineryComponent ;
    ns1:hasApprovalRecord <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/propellerApproval> ;
    ns1:machineryComponentType "propeller blade"^^xsd:string .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/propellerApproval> a ns1:approvalRecord ;
    ns1:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    ns1:approvingAuthority "Administration"^^xsd:string ;
    ns1:scantlingApprovalStatus ns1:evidenceStateApproved .

