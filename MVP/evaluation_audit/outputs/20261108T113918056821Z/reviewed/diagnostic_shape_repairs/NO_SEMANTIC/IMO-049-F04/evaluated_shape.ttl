@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO049ShipShape> a sh:NodeShape ;
    sh:or ( <urn:nltl:generated-shape:IMO049CategoryABShape> <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCShape> ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
            sh:minCount 1 ;
            sh:path ( <https://w3id.org/nltl/vocab#hasComponent> <https://w3id.org/nltl/vocab#machineryComponentType> ) ] ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltl:generated-shape:IMO049CategoryABApprovalShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ;
            sh:message "The scantling approval record must have approved status." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#scantlingApprovalStatus> ],
        [ sh:datatype xsd:string ;
            sh:in ( "Administration"^^xsd:string "recognized organization accepted by the Administration"^^xsd:string ) ;
            sh:message "The approval must be by the Administration or a recognized organization accepted by the Administration." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvingAuthority> ],
        [ sh:datatype xsd:string ;
            sh:in ( "standard acceptable to the Organization"^^xsd:string "another standard offering an equivalent level of safety"^^xsd:string ) ;
            sh:message "The approval must use an Organization-acceptable standard or an equivalent-safety standard." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvalStandard> ] .

<urn:nltl:generated-shape:IMO049CategoryABComponentShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#approvalRecord> ;
            sh:message "Each applicable machinery component must have approval evidence for its scantling." ;
            sh:minCount 1 ;
            sh:node <urn:nltl:generated-shape:IMO049CategoryABApprovalShape> ;
            sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] .

<urn:nltl:generated-shape:IMO049CategoryABShape> a sh:NodeShape ;
    sh:property [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryA> <https://w3id.org/nltl/vocab#polarShipCategoryB> ) ;
            sh:message "The ship category must be Category A or Category B for this approval branch." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
        [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
            sh:node <urn:nltl:generated-shape:IMO049CategoryABComponentShape> ;
            sh:path <https://w3id.org/nltl/vocab#hasComponent> ] .

<urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCApprovalShape> a sh:NodeShape ;
    sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ;
            sh:message "The scantling approval record must have approved status." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#scantlingApprovalStatus> ],
        [ sh:datatype xsd:string ;
            sh:in ( "Administration"^^xsd:string "recognized organization accepted by the Administration"^^xsd:string ) ;
            sh:message "The approval must be by the Administration or a recognized organization accepted by the Administration." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvingAuthority> ],
        [ sh:datatype xsd:string ;
            sh:hasValue "acceptable standard adequate for operating ice type and concentration"^^xsd:string ;
            sh:message "The approval must use an acceptable standard adequate for the operating ice type and concentration." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvalStandard> ],
        [ sh:datatype xsd:string ;
            sh:message "Ice-strengthened Category C approval evidence must state the operating ice type." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#operatingIceType> ],
        [ sh:maxCount 1 ;
            sh:message "Ice-strengthened Category C approval evidence must state the operating ice concentration as a unitless quantity." ;
            sh:minCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:path <https://w3id.org/nltl/vocab#operatingIceConcentration> ] .

<urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCComponentShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#approvalRecord> ;
            sh:message "Each applicable ice-strengthened Category C machinery component must have approval evidence for its scantling." ;
            sh:minCount 1 ;
            sh:node <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCApprovalShape> ;
            sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] .

<urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
            sh:node <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCComponentShape> ;
            sh:path <https://w3id.org/nltl/vocab#hasComponent> ],
        [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ;
            sh:message "The ship category must be Category C for the ice-strengthened Category C approval branch." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue true ;
            sh:message "A Category C ship must be recorded as ice-strengthened for this approval branch." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ] .

