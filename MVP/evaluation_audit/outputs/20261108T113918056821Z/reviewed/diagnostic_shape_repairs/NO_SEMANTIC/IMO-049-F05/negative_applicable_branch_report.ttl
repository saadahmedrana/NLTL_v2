@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/propellerApproval> ;
                                    sh:resultMessage "The scantling approval record must have approved status." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#scantlingApprovalStatus> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ;
                                            sh:message "The scantling approval record must have approved status." ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#scantlingApprovalStatus> ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/propeller> ;
                            sh:resultMessage "Each applicable machinery component must have approval evidence for its scantling." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasApprovalRecord> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#approvalRecord> ;
                                    sh:message "Each applicable machinery component must have approval evidence for its scantling." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:IMO049CategoryABApprovalShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/propellerApproval> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/ship> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049CategoryABComponentShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
                            sh:node <urn:nltl:generated-shape:IMO049CategoryABComponentShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/propeller> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049CategoryABShape>. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO049ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/ship> ] .

