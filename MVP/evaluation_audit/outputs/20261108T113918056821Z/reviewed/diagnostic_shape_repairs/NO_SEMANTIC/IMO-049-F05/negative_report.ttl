    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO049CategoryABShape> , <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO049ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F05/ship> ] .

