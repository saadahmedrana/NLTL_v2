@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendageApproval> ;
                                    sh:resultMessage "Ice-strengthened category C approval evidence must identify a standard adequate for the operating ice type and concentration." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvalStandard> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:hasValue "acceptable standard adequate for operating ice type and concentration"^^xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:message "Ice-strengthened category C approval evidence must identify a standard adequate for the operating ice type and concentration." ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#approvalStandard> ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendage> ;
                            sh:resultMessage "Each applicable ice-strengthened category C machinery component must have qualified approved scantling evidence." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasApprovalRecord> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each applicable ice-strengthened category C machinery component must have qualified approved scantling evidence." ;
                                    sh:minCount 1 ;
                                    sh:node <https://w3id.org/nltl/vocab#IMO049_CApprovalRecordShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendageApproval> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ;
                    sh:resultMessage "Value does not conform to Shape <https://w3id.org/nltl/vocab#IMO049_CComponentShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <https://w3id.org/nltl/vocab#IMO049_CComponentShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/appendage> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ], [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ], [ sh:node <https://w3id.org/nltl/vocab#IMO049_CComponentShape> ; sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ]. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape <https://w3id.org/nltl/vocab#IMO049_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F03/ship> ] .

