@prefix ns1: <https://w3id.org/nltl/vocab#> .
@prefix ns2: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> a ns1:ship ;
    ns1:hasComponent <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendage> ;
    ns1:shipCategory ns1:polarShipCategoryC ;
    ns1:shipIceStrengthened true .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendage> a ns1:machineryComponent ;
    ns1:hasApprovalRecord <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendageApproval> ;
    ns1:machineryComponentType "other appendage"^^xsd:string .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendageApproval> a ns1:approvalRecord ;
    ns1:approvalStandard "acceptable standard adequate for operating ice type and concentration"^^xsd:string ;
    ns1:approvingAuthority "Administration"^^xsd:string ;
    ns1:operatingIceConcentration <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/operatingIceConcentrationValue> ;
    ns1:operatingIceType "medium first-year ice"^^xsd:string ;
    ns1:scantlingApprovalStatus ns1:evidenceStateApproved .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/operatingIceConcentrationValue> a ns2:QuantityValue ;
    ns2:numericValue 0.7 ;
    ns2:unit <http://qudt.org/vocab/unit/UNITLESS> .

