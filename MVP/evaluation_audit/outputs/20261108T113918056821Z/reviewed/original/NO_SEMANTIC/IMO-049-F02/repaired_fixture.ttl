@prefix ns1: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F02/ship> a ns1:ship ;
    ns1:hasComponent <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F02/steering> ;
    ns1:shipCategory ns1:polarShipCategoryB ;
    ns1:shipIceStrengthened true .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F02/steering> a ns1:machineryComponent ;
    ns1:hasApprovalRecord <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F02/steeringApproval> ;
    ns1:machineryComponentType "steering equipment"^^xsd:string .

<https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F02/steeringApproval> a ns1:approvalRecord ;
    ns1:approvalStandard "standard acceptable to the Organization"^^xsd:string ;
    ns1:approvingAuthority "Administration"^^xsd:string ;
    ns1:scantlingApprovalStatus ns1:evidenceStateApproved .

