@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "Both the 2021 section 1.8 Ice Classes provision and chapter 2 Ice Class Draught provision must apply." ;
            sh:resultPath <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceClassRegulatoryProvisionValue> ;
                    sh:in ( <https://w3id.org/nltl/vocab#iceClassSection1Point8Provision2021> <https://w3id.org/nltl/vocab#iceClassDraughtChapter2Provision2021> ) ;
                    sh:maxCount 2 ;
                    sh:message "Both the 2021 section 1.8 Ice Classes provision and chapter 2 Ice Class Draught provision must apply." ;
                    sh:minCount 2 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#applicableIceClassRegulatoryProvision> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ;
            sh:resultMessage "The 2021 Ice Class Regulations must be identified for ships contracted for construction on or after 5 July 2021, and must not be identified for ships contracted before that date." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The 2021 Ice Class Regulations must be identified for ships contracted for construction on or after 5 July 2021, and must not be identified for ships contracted before that date." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:constructionContractDate ?date .
                FILTER (
                    (
                        ?date >= "2021-07-05"^^xsd:date
                        && NOT EXISTS {
                            $this nltl:applicableIceClassRegulationEdition
                                nltl:iceClassRegulationEdition2021 .
                        }
                    )
                    ||
                    (
                        ?date < "2021-07-05"^^xsd:date
                        && EXISTS {
                            $this nltl:applicableIceClassRegulationEdition
                                nltl:iceClassRegulationEdition2021 .
                        }
                    )
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF001ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-001-F01/ship> ] .

