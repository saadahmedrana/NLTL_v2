@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2_048_ShipShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#polarClassValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#polarClassPc1> <https://w3id.org/nltl/vocab#polarClassPc2> <https://w3id.org/nltl/vocab#polarClassPc3> <https://w3id.org/nltl/vocab#polarClassPc4> <https://w3id.org/nltl/vocab#polarClassPc5> <https://w3id.org/nltl/vocab#polarClassPc6> <https://w3id.org/nltl/vocab#polarClassPc7> ) ;
            sh:maxCount 1 ;
            sh:message "The ship must have exactly one supported Polar Class." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#polarClass> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
            sh:node <urn:nltl:generated-shape:I2_048_CaseShape> ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ] ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltl:generated-shape:I2_048_CaseShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#plating> ;
            sh:maxCount 1 ;
            sh:message "Each steel-grade requirement case must identify exactly one assessed plating." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#steelGradeRequirementCasePlating> ],
        [ sh:class <https://w3id.org/nltl/vocab#tableReferenceValue> ;
            sh:hasValue <https://w3id.org/nltl/vocab#iacsUrI2Table8> ;
            sh:maxCount 1 ;
            sh:message "Each steel-grade requirement case must reference IACS UR I2 Table 8." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#tableReference> ],
        [ sh:maxCount 1 ;
            sh:message "Each case must provide one as-built plate thickness in millimetres." ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#asBuiltPlateThickness> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelMaterialClassValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#steelMaterialClassOne> <https://w3id.org/nltl/vocab#steelMaterialClassTwo> <https://w3id.org/nltl/vocab#steelMaterialClassThree> ) ;
            sh:maxCount 1 ;
            sh:message "Each case must specify one supported steel material class." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#steelMaterialClass> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelStrengthCategoryValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#normalStrengthSteelCategory> <https://w3id.org/nltl/vocab#highTensileSteelCategory> ) ;
            sh:maxCount 1 ;
            sh:message "Each case must specify one supported steel strength category." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#steelStrengthCategory> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelGradeValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#steelGradeAh> <https://w3id.org/nltl/vocab#steelGradeB> <https://w3id.org/nltl/vocab#steelGradeD> <https://w3id.org/nltl/vocab#steelGradeDh> <https://w3id.org/nltl/vocab#steelGradeE> <https://w3id.org/nltl/vocab#steelGradeEh> <https://w3id.org/nltl/vocab#steelGradeFh> ) ;
            sh:maxCount 1 ;
            sh:message "Each case must provide exactly one actual hull structural steel grade." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#actualHullStructuralSteelGrade> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelGradeValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#steelGradeAh> <https://w3id.org/nltl/vocab#steelGradeB> <https://w3id.org/nltl/vocab#steelGradeD> <https://w3id.org/nltl/vocab#steelGradeDh> <https://w3id.org/nltl/vocab#steelGradeE> <https://w3id.org/nltl/vocab#steelGradeEh> <https://w3id.org/nltl/vocab#steelGradeFh> ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#requiredHullStructuralSteelGrade> ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The required grade must be the Table 8 grade selected by Polar Class, thickness, material class and strength category; the actual grade must be at least that grade within the same strength category, and non-applicable combinations must have no required grade." ;
            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship a nltl:ship ;
                      nltl:polarClass ?pc ;
                      nltl:hasSteelGradeRequirementCase $this .
                $this nltl:asBuiltPlateThickness ?thicknessNode ;
                      nltl:steelMaterialClass ?material ;
                      nltl:steelStrengthCategory ?strength ;
                      nltl:actualHullStructuralSteelGrade ?actual .
                ?thicknessNode qudt:numericValue ?thickness .
                BIND(
                    IF(?thickness <= 10, 1,
                    IF(?thickness <= 15, 2,
                    IF(?thickness <= 20, 3,
                    IF(?thickness <= 25, 4,
                    IF(?thickness <= 30, 5,
                    IF(?thickness <= 35, 6,
                    IF(?thickness <= 40, 7,
                    IF(?thickness <= 45, 8,
                    IF(?thickness <= 50, 9, 0)))))))))
                    AS ?band
                )
                BIND((?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3)) AS ?pc13)
                BIND((?pc IN (nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3, nltl:polarClassPc4, nltl:polarClassPc5)) AS ?pc15)
                BIND((?pc IN (nltl:polarClassPc4, nltl:polarClassPc5)) AS ?pc45)
                BIND((?pc IN (nltl:polarClassPc6, nltl:polarClassPc7)) AS ?pc67)

                BIND(
                    IF(
                        (
                            ?strength = nltl:normalStrengthSteelCategory &&
                            (
                                (?band = 1 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo)) ||
                                (?band >= 2 && ?band <= 4 && ?pc67 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo)) ||
                                (?band >= 5 && ?band <= 6 && ?pc67 && ?material = nltl:steelMaterialClassOne)
                            )
                        ),
                        nltl:steelGradeB,
                        IF(
                            (
                                ?strength = nltl:normalStrengthSteelCategory &&
                                (
                                    (?band >= 2 && ?band <= 4 && ?pc15 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo)) ||
                                    (?band >= 5 && ?band <= 8 && ?pc15 && ?material = nltl:steelMaterialClassTwo) ||
                                    (?band >= 5 && ?band <= 8 && ?pc67 && ?material = nltl:steelMaterialClassTwo) ||
                                    (?band = 9 && ?pc67 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo))
                                )
                            ),
                            nltl:steelGradeD,
                            IF(
                                (
                                    ?strength = nltl:normalStrengthSteelCategory &&
                                    (
                                        (?band = 1 && ?material = nltl:steelMaterialClassThree && ?pc15) ||
                                        (?band >= 2 && ?band <= 4 && ?material = nltl:steelMaterialClassThree && ?pc15) ||
                                        (?band >= 5 && ?band <= 8 && ?material IN (nltl:steelMaterialClassTwo, nltl:steelMaterialClassThree) && ?pc15) ||
                                        (?band >= 5 && ?band <= 8 && ?material = nltl:steelMaterialClassThree && ?pc67) ||
                                        (?band = 9 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) && ?pc15) ||
                                        (?band = 9 && ?material = nltl:steelMaterialClassThree && ?pc67)
                                    )
                                ),
                                nltl:steelGradeE,
                                IF(
                                    (
                                        ?strength = nltl:highTensileSteelCategory &&
                                        (
                                            (?band >= 1 && ?band <= 4 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo)) ||
                                            (?band = 1 && ?material = nltl:steelMaterialClassThree && ?pc67) ||
                                            (?band >= 5 && ?band <= 9 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) && ?pc67)
                                        )
                                    ),
                                    nltl:steelGradeAh,
                                    IF(
                                        (
                                            ?strength = nltl:highTensileSteelCategory &&
                                            (
                                                (?band >= 2 && ?band <= 4 && ?pc15 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo)) ||
                                                (?band >= 2 && ?band <= 4 && ?pc67 && ?material = nltl:steelMaterialClassThree) ||
                                                (?band >= 5 && ?band <= 8 && ?pc15 && ?material = nltl:steelMaterialClassOne) ||
                                                (?band >= 5 && ?band <= 8 && ?pc15 && ?material = nltl:steelMaterialClassTwo) ||
                                                (?band = 9 && ?pc15 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo))
                                            )
                                        ),
                                        nltl:steelGradeDh,
                                        IF(
                                            (
                                                ?strength = nltl:highTensileSteelCategory &&
                                                (
                                                    (?band >= 1 && ?band <= 4 && ?material = nltl:steelMaterialClassThree && ?pc15) ||
                                                    (?band >= 5 && ?band <= 8 && ?material = nltl:steelMaterialClassTwo && ?pc15) ||
                                                    (?band >= 5 && ?band <= 8 && ?material = nltl:steelMaterialClassThree) ||
                                                    (?band = 9 && ?pc15 && ?material IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo)) ||
                                                    (?band = 9 && ?pc67 && ?material = nltl:steelMaterialClassThree)
                                                )
                                            ),
                                            nltl:steelGradeEh,
                                            IF(
                                                (
                                                    ?strength = nltl:highTensileSteelCategory &&
                                                    ?material = nltl:steelMaterialClassThree &&
                                                    (
                                                        (?band >= 7 && ?band <= 8 && ?pc13) ||
                                                        (?band = 9 && (?pc13 || ?pc45))
                                                    )
                                                ),
                                                nltl:steelGradeFh,
                                                nltl:benchmarkEntity
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                    AS ?expected
                )

                OPTIONAL {
                    $this nltl:requiredHullStructuralSteelGrade ?required .
                }

                OPTIONAL {
                    ?actual nltl:steelGradeOrderRank ?actualRank .
                }

                FILTER(
                    ?expected = nltl:benchmarkEntity ||
                    !BOUND(?required) ||
                    ?required != ?expected ||
                    !BOUND(?actualRank) ||
                    EXISTS {
                        ?required nltl:steelGradeOrderRank ?requiredRank .
                        FILTER(?actualRank < ?requiredRank)
                    } ||
                    (
                        ?strength = nltl:normalStrengthSteelCategory &&
                        ?actual NOT IN (
                            nltl:steelGradeB,
                            nltl:steelGradeD,
                            nltl:steelGradeE
                        )
                    ) ||
                    (
                        ?strength = nltl:highTensileSteelCategory &&
                        ?actual NOT IN (
                            nltl:steelGradeAh,
                            nltl:steelGradeDh,
                            nltl:steelGradeEh,
                            nltl:steelGradeFh
                        )
                    )
                )
            }
        """ ] .

