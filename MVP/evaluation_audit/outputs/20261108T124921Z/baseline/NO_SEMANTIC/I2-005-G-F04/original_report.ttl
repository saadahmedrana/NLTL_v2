@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/ship> ;
            sh:resultMessage "The ship must identify its bottom/lower-region boundary point." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasBottomRegionLowerRegionBoundaryPoint> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must identify its bottom/lower-region boundary point." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#hullBoundaryPoint> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "The boundary point must have a shell inclination angle of exactly 7 degrees." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 7.0 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#shellInclinationAngle> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasBottomRegionLowerRegionBoundaryPoint> ] ] .

