@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup>-><https://w3id.org/nltl/vocab#flexuralFailureClassFactor>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#flexuralFailureClassFactor> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#flexuralFailureClassFactor> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-015-TableLookupShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasFailureClassFactorLookupCase> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-015-TableLookupShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasFailureClassFactorLookupCase> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/factorLookup> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-015-BowCaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasBowSubregionCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2-015-BowCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasBowSubregionCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/bowCase> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F05/ship>-><https://w3id.org/nltl/vocab#betaIPrime>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#betaIPrime> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#betaIPrime> ] ] .

