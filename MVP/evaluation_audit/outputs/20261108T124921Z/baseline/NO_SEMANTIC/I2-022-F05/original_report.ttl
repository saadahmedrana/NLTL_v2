@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/ship> ;
            sh:resultMessage "The ship shall provide exactly one yield strength in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#yieldStrength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one yield strength in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_022_PressureQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#yieldStrength> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/ship> ;
            sh:resultMessage "The ship shall provide exactly one load patch height in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_022_LengthQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchHeight> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/ship> ;
            sh:resultMessage "The ship shall provide exactly one average ice pressure in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#averageIcePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one average ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_022_PressureQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#averageIcePressure> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/plating> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/plating> must conform to one or more shapes in [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#bowIntermediateBottomHullArea> <https://w3id.org/nltl/vocab#midbodyBottomHullArea> <https://w3id.org/nltl/vocab#sternBottomHullArea> ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#platingHullAreaClassification> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide the externally calculated net plate thickness in millimetres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_LengthMillimetreQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#iceLoadRequiredNetPlateThickness> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_ApplicableAngleQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_DimensionlessQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#selectedHullAreaFactor> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_LengthQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#frameSpacing> ] ] ; sh:path <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ] ] , [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_NonApplicableAngleQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#plating> ;
                            sh:or ( [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#bowIntermediateBottomHullArea> <https://w3id.org/nltl/vocab#midbodyBottomHullArea> <https://w3id.org/nltl/vocab#sternBottomHullArea> ) ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#platingHullAreaClassification> ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide the externally calculated net plate thickness in millimetres." ;
                                                sh:minCount 1 ;
                                                sh:node <urn:nltl:generated-shape:I2_022_LengthMillimetreQuantityShape> ;
                                                sh:path <https://w3id.org/nltl/vocab#iceLoadRequiredNetPlateThickness> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node <urn:nltl:generated-shape:I2_022_ApplicableAngleQuantityShape> ;
                                                sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node <urn:nltl:generated-shape:I2_022_NonApplicableAngleQuantityShape> ;
                                                sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/plating> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#plating> ; sh:or ( [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#bowIntermediateBottomHullArea> <https://w3id.org/nltl/vocab#midbodyBottomHullArea> <https://w3id.org/nltl/vocab#sternBottomHullArea> ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#platingHullAreaClassification> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Applicable plating shall provide the externally calculated net plate thickness in millimetres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_LengthMillimetreQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#iceLoadRequiredNetPlateThickness> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_ApplicableAngleQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_DimensionlessQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#selectedHullAreaFactor> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_LengthQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#frameSpacing> ] ] ; sh:path <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ] ] [ sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:I2_022_NonApplicableAngleQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ] ] ) ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPlating> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#plating> ;
                            sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path <https://w3id.org/nltl/vocab#platingSupportedByStructuralMember> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node <urn:nltl:generated-shape:I2_022_ApplicableAngleQuantityShape> ;
                                                sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ],
                                            [ sh:in [ ] ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#platingHullAreaClassification> ],
                                            [ sh:maxCount 1 ;
                                                sh:message "Applicable plating shall provide the externally calculated net plate thickness in millimetres." ;
                                                sh:minCount 1 ;
                                                sh:node <urn:nltl:generated-shape:I2_022_LengthMillimetreQuantityShape> ;
                                                sh:path <https://w3id.org/nltl/vocab#iceLoadRequiredNetPlateThickness> ] ] [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node <urn:nltl:generated-shape:I2_022_NonApplicableAngleQuantityShape> ;
                                                sh:path <https://w3id.org/nltl/vocab#framingAngleOmega> ] ] ) ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasPlating> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/plating> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-022-F05/ship> ;
            sh:resultMessage "The ship shall provide exactly one peak pressure factor." ;
            sh:resultPath <https://w3id.org/nltl/vocab#peakPressureFactor> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall provide exactly one peak pressure factor." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_022_DimensionlessQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#peakPressureFactor> ] ] .

