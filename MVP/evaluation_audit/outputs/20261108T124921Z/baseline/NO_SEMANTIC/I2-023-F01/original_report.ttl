@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/ship> ;
            sh:resultMessage "Peak pressure factor input is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#peakPressureFactor> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Peak pressure factor input is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#peakPressureFactor> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/ship> ;
            sh:resultMessage "Load patch height input is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Load patch height input is required in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchHeight> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/ship> ;
            sh:resultMessage "Average ice pressure input is required in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#averageIcePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Average ice pressure input is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#averageIcePressure> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/ship> ;
            sh:resultMessage "Frame span input is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameSpan> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Frame span input is required in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#frameSpan> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-023-F01/ship> ;
            sh:resultMessage "Yield strength input is required in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#yieldStrength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Yield strength input is required in MPa." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#yieldStrength> ] ] .

