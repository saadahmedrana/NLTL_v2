@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member>-><https://w3id.org/nltl/vocab#frameSupportCondition>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#frameSupportCondition> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#fixedFrameSupport> <https://w3id.org/nltl/vocab#simpleFrameSupport> ) ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#frameSupportCondition> ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member>-><https://w3id.org/nltl/vocab#hasMemberSupport>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasMemberSupport> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#memberSupport> ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-026-MemberSupportShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasMemberSupport> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-026-StructuralMemberShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStructuralMember> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#structuralMember> ;
                    sh:node <urn:nltl:generated-shape:I2-026-StructuralMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasStructuralMember> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F04/member> ] .

