@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T007/case> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T007/case>-><https://w3id.org/nltl/vocab#asBuiltPlateThickness>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#asBuiltPlateThickness> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#asBuiltPlateThickness> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T007/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_048_CaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
                    sh:node <urn:nltl:generated-shape:I2_048_CaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-T007/case> ] .

