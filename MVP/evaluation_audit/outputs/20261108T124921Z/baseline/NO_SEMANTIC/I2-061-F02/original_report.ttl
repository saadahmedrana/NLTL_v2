@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "The calculation case must use the prescribed analytical procedure and must not use direct calculation as an alternative." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#calculationMethod> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <https://w3id.org/nltl/vocab#prescribedAnalyticalProcedure> ;
                            sh:maxCount 1 ;
                            sh:message "The calculation case must use the prescribed analytical procedure and must not use direct calculation as an alternative." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/structure> ;
                            sh:resultMessage "The assessed hull structure must provide its thickness as a quantity value." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#thickness> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:message "The assessed hull structure must provide its thickness as a quantity value." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:ThicknessQuantityShape> ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path <https://w3id.org/nltl/vocab#thickness> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ;
                    sh:resultMessage "The calculation case must identify its assessed hull structure." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#calculationCaseAssessedHullStructure> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#hullStructure> ;
                            sh:message "The calculation case must identify its assessed hull structure." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:AssessedHullStructureShape> ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#calculationCaseAssessedHullStructure> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/structure> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/ship> ;
            sh:resultMessage "The ship must identify a calculation case for the prescribed hull-structure procedure." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                    sh:message "The ship must identify a calculation case for the prescribed hull-structure procedure." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:CalculationCaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-a/I2-061-F02/case> ] .

