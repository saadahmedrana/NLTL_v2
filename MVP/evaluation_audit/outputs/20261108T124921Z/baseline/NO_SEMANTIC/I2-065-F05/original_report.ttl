@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ;
            sh:resultMessage "A ship with a nonlinear calculation case must provide fracture, major buckling, and yielding margins." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A ship with a nonlinear calculation case must provide fracture, major buckling, and yielding margins." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS { $this nltl:fractureMargin ?fractureMargin }
                    || NOT EXISTS { $this nltl:majorBucklingMargin ?majorBucklingMargin }
                    || NOT EXISTS { $this nltl:yieldingMargin ?yieldingMargin }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_065_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/calculation> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/calculation> must conform to one or more shapes in [ sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ], [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                            sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ],
                                            [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ],
                                            [ sh:minCount 1 ;
                                                sh:node [ sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ],
                                            [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ; sh:or ( [ sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ], [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] ) ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                            sh:or ( [ sh:property [ sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ],
                                            [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                                sh:minCount 1 ;
