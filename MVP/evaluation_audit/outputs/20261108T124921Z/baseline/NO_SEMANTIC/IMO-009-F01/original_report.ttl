@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ;
            sh:resultMessage "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10, with dimensionless quantity values." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For bergy waters, land-origin ice concentration must be less than 1/10 and total ice concentration must not exceed 1/10, with dimensionless quantity values." ;
                    sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
    $this nltl:iceCondition ?condition .
    FILTER (STR(?condition) = "bergy waters")
    FILTER NOT EXISTS {
        $this nltl:landOriginIceConcentration ?landConcentration .
        ?landConcentration a qudt:QuantityValue ;
            qudt:numericValue ?landValue ;
            qudt:unit unit:UNITLESS .
        FILTER (datatype(?landValue) = xsd:decimal)
        FILTER (?landValue < 1)

        $this nltl:totalIceConcentration ?totalConcentration .
        ?totalConcentration a qudt:QuantityValue ;
            qudt:numericValue ?totalValue ;
            qudt:unit unit:UNITLESS .
        FILTER (datatype(?totalValue) = xsd:decimal)
        FILTER (?totalValue <= 1)
    }
}
""" ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-009-BergyWaters> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F01/ship> ] .

