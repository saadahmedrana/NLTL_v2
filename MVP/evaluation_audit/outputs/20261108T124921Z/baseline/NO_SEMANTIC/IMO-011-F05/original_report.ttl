@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:decimal ; sh:minInclusive Literal(\"10\", datatype=xsd:integer) ; sh:path ( <https://w3id.org/nltl/vocab#dataPeriod> <http://qudt.org/schema/qudt/numericValue> ) ] ] , [ sh:property [ sh:datatype xsd:decimal ; sh:maxExclusive Literal(\"10\", datatype=xsd:integer) ; sh:path ( <https://w3id.org/nltl/vocab#dataPeriod> <http://qudt.org/schema/qudt/numericValue> ) ], [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"When the data period is shorter than 10 years, the dataset approval status must be Approved.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#administrationDatasetApprovalStatus> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_011_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F05/ship> ] .

