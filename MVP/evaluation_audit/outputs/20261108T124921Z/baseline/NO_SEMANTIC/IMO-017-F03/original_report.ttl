@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate supplement shall be present." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarCertificateSupplementPresent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nc52cf7bf07ff4a48a70a80d19f1260ffb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate supplement shall be present." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarCertificateSupplementPresent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc52cf7bf07ff4a48a70a80d19f1260ffb4 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/supplement> ;
            sh:resultMessage "The Polar Certificate supplement shall contain required equipment records." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasRequiredEquipmentRecords> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#requiredEquipmentRecords> ;
                    sh:message "The Polar Certificate supplement shall contain required equipment records." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#hasRequiredEquipmentRecords> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F03/ship> ;
            sh:resultMessage "The Polar Ship Certificate shall include a supplement." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPolarCertificateSupplement> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#polarCertificateSupplement> ;
                    sh:message "The Polar Ship Certificate shall include a supplement." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#hasPolarCertificateSupplement> ] ] .

_:nc52cf7bf07ff4a48a70a80d19f1260ffb4 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The Polar Ship Certificate supplement shall be present." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#polarCertificateSupplementPresent> .

