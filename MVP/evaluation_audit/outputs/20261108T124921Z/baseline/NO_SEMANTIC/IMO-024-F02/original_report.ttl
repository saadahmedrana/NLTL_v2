@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F02/ship> ;
            sh:resultMessage "The ship's PWOM must include or reference specific polar-water incident procedures." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarIncidentProcedurePresent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nf2b92fb32ba04b9abefd782022744735b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-024-F02/ship> ;
            sh:resultMessage "The ship's PWOM must include or reference specific polar-water incident procedures." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarIncidentProcedurePresent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf2b92fb32ba04b9abefd782022744735b1 ] .

_:nf2b92fb32ba04b9abefd782022744735b1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship's PWOM must include or reference specific polar-water incident procedures." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#polarIncidentProcedurePresent> .

