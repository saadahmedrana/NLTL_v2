            sh:sourceShape _:n7f36266042f44ed291d38e5deed61b32b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F04/ship> ;
            sh:resultMessage "The PWOM icing allowance values must match the stability calculation values." ;
