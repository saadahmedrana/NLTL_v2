            sh:resultMessage "The stability calculation icing allowance values must match the PWOM values." ;
            sh:resultPath <https://w3id.org/nltl/vocab#stabilityCalculationIcingAllowanceValues> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:equals <https://w3id.org/nltl/vocab#polarWaterOperationalManualIcingAllowanceValues> ;
                    sh:maxCount 1 ;
                    sh:message "The stability calculation icing allowance values must match the PWOM values." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#stabilityCalculationIcingAllowanceValues> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F04/ship> ;
            sh:resultMessage "The PWOM must state that icing allowance information is present." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarWaterOperationalManualIcingAllowanceInformationPresent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n7f36266042f44ed291d38e5deed61b32b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F04/ship> ;
            sh:resultMessage "A stability calculation record must be linked." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStabilityCalculationRecord> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#documentRecord> ;
                    sh:message "A stability calculation record must be linked." ;
