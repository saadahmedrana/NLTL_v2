@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ;
                    sh:resultMessage "Each machinery installation shall have hazard protection evidence." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasHazardProtectionEvidence> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each machinery installation shall have hazard protection evidence." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ] ;
                            sh:path <https://w3id.org/nltl/vocab#hasHazardProtectionEvidence> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO043MachineryInstallationShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasMachineryInstallation> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO043MachineryInstallationShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasMachineryInstallation> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/mainMachinery> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hazardProtectionCoverage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n71d42d70053b4f3281e738b7658b4bdfb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F05/ship> ;
            sh:resultMessage "The ship shall record hazard protection coverage." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hazardProtectionCoverage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n71d42d70053b4f3281e738b7658b4bdfb1 ] .

_:n71d42d70053b4f3281e738b7658b4bdfb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship shall record hazard protection coverage." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#hazardProtectionCoverage> .

