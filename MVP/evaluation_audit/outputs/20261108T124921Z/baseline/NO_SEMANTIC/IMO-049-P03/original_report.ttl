@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO049CategoryABShape> , <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO049ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-P03/ship> ;
            sh:resultMessage "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
            sh:resultPath <https://w3id.org/nltl/vocab#machineryComponentType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#machineryComponentType> ] ] .

