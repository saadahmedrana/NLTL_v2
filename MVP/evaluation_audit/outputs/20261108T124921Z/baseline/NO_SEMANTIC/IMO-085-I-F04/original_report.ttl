@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F04/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F04/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ] , [ sh:property [ sh:maxExclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionDate> ] ] , [ sh:and ( [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryA> <https://w3id.org/nltl/vocab#polarShipCategoryB> ) ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ] [ sh:property [ sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionDate> ] ] [ sh:or ( [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Bridge wings must be enclosed for an applicable Category A or B ship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#bridgeWingsEnclosed> ] ] [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Bridge wing protection design status must be approved for an applicable Category A or B ship.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#bridgeWingProtectionDesignStatus> ] ] ) ] ) ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO085BridgeWingProtectionShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-085-I-F04/ship> ] .

