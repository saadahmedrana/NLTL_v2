            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n6a77002368c54df984b237f61eef4cf3b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F03/ship> ;
            sh:resultMessage "The voyage plan must address every identified intended-voyage hazard." ;
