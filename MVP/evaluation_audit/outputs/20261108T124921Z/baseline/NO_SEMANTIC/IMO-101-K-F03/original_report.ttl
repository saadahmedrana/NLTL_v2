@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#voyagePlanningTopicCoverage> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:n3af7c3f636284b45925f3a9cdcf16ce5b3 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ;
                    sh:resultMessage "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#voyagePlanningTopicCoverage> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:n3af7c3f636284b45925f3a9cdcf16ce5b3 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/ship> ;
            sh:resultMessage "The ship must have a polar-route planning record." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPolarRoutePlan> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#polarRoutePlan> ;
                    sh:message "The ship must have a polar-route planning record." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#voyagePlanningTopicCoverage> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasPolarRoutePlan> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-F03/routePlan> ] .

_:n3af7c3f636284b45925f3a9cdcf16ce5b3 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The polar-route planning record must have voyage-planning topic coverage exactly true." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#voyagePlanningTopicCoverage> .

