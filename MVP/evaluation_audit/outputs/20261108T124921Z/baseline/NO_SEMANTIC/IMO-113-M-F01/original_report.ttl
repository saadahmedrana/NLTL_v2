@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F01/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:message Literal(\"The ship's polar-water applicability must be recorded as false when polar operation does not apply.\") ; sh:path <https://w3id.org/nltl/vocab#shipOperatesInPolarWaters> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Polar operation must be taken into account in the applicable Cargo Record Book.\") ; sh:path <https://w3id.org/nltl/vocab#cargoRecordBookPolarCoverage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Polar operation must be taken into account in the applicable Manual.\") ; sh:path <https://w3id.org/nltl/vocab#manualPolarCoverage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Polar operation must be taken into account in the applicable noxious liquid substance or marine pollution emergency plan.\") ; sh:path <https://w3id.org/nltl/vocab#noxiousLiquidSubstanceEmergencyPlanPolarCoverage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The ship's polar-water applicability must be recorded as true when this conditional requirement applies.\") ; sh:path <https://w3id.org/nltl/vocab#shipOperatesInPolarWaters> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-113> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-F01/ship> ] .

