@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P03/ship> ;
            sh:resultMessage "The ship's operating area must be recorded as Arctic_waters." ;
            sh:resultPath <https://w3id.org/nltl/vocab#operatingArea> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "Arctic_waters"^^xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship's operating area must be recorded as Arctic_waters." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#operatingArea> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P03/ship> ;
            sh:resultMessage "Food waste discharge to sea must be recorded as true for this applicable rule." ;
            sh:resultPath <https://w3id.org/nltl/vocab#foodWasteDischargeToSea> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "Food waste discharge to sea must be recorded as true for this applicable rule." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#foodWasteDischargeToSea> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P03/ship>-><https://w3id.org/nltl/vocab#arcticWaters> does not contain a value in the set: ['Literal(\"Arctic_waters\", datatype=xsd:string)']" ;
            sh:resultPath <https://w3id.org/nltl/vocab#arcticWaters> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:hasValue "Arctic_waters"^^xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#arcticWaters> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P03/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-120-N-P03/ship>-><https://w3id.org/nltl/vocab#iceConcentration>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceConcentration> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#iceConcentration> ] ] .

