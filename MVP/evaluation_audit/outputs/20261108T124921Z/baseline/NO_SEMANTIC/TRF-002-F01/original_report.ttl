@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> must conform to one or more shapes in [ sh:property [ sh:maxExclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionContractDate> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#iceClassRegulationEdition2017> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ships contracted from 1 January 2019 through 4 July 2021 must identify the 2017 Ice Class Regulations as the applicable edition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#applicableIceClassRegulationEdition> ], [ sh:maxExclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:minInclusive Literal(\"2019-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionContractDate> ] ] , [ sh:property [ sh:minInclusive Literal(\"2021-07-05\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionContractDate> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF002Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-a/TRF-002-F01/ship> ] .

