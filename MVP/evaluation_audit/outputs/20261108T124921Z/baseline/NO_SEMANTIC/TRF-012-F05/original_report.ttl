@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F05/intendedPoint> ;
                            sh:resultMessage "Each waterline profile point must have a longitudinal position." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#longitudinalPosition> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:message "Each waterline profile point must have a longitudinal position." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:TRF012LengthQuantityShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#longitudinalPosition> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F05/intendedLine> ;
                    sh:resultMessage "Each represented ice waterline must contain at least one waterline profile point." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasWaterlineProfilePoint> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#waterlineProfilePoint> ;
                            sh:message "Each represented ice waterline must contain at least one waterline profile point." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF012WaterlineProfilePointShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasWaterlineProfilePoint> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F05/intendedPoint> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F05/ship> ;
            sh:resultMessage "The ship must represent at least one intended ice-operating waterline with profile points." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasIntendedIceOperatingWaterline> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceWaterline> ;
                    sh:message "The ship must represent at least one intended ice-operating waterline with profile points." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF012IceWaterlineShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasIntendedIceOperatingWaterline> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-012-F05/intendedLine> ] .

