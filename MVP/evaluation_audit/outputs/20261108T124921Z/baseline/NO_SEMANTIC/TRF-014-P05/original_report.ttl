@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship>-><https://w3id.org/nltl/vocab#retainedOnBoard>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#retainedOnBoard> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8dca617f702248e4b8de48dd78514295b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship>-><https://w3id.org/nltl/vocab#retainedOnBoard> does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath <https://w3id.org/nltl/vocab#retainedOnBoard> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8dca617f702248e4b8de48dd78514295b13 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "The applicable ice-class marking condition, including the assessment-date and dry-docking-date rule, is not satisfied." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The applicable ice-class marking condition, including the assessment-date and dry-docking-date rule, is not satisfied." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:constructionDate ?constructionDate ;
                      nltl:assessmentDate ?assessmentDate ;
                      nltl:summerLoadLineFreshWaterDraught/qudt:numericValue ?summerDraught ;
                      nltl:upperIceWaterlineDraught/qudt:numericValue ?uiwlDraught ;
                      nltl:hasClassCertificate/nltl:maximumIceClassDraughtAmidships/qudt:numericValue ?maximumAmidships .

                OPTIONAL { $this nltl:warningTrianglePresent ?warningTriangle . }
                OPTIONAL { $this nltl:iceClassDraughtMarkPresent ?markPresent . }
                OPTIONAL { $this nltl:iceClassDraughtMarkDraughtAmidships/qudt:numericValue ?markDraught . }
                OPTIONAL { $this nltl:firstScheduledDryDockingDate ?dryDockingDate . }

                BIND(
                    (
                        (
                            ?constructionDate >= "2007-07-01"^^xsd:date &&
                            ?summerDraught > ?uiwlDraught &&
                            ?warningTriangle = true &&
                            ?markPresent = true &&
                            ?markDraught = ?maximumAmidships
                        )
                        ||
                        (
                            ?constructionDate < "2007-07-01"^^xsd:date &&
                            ?warningTriangle = true &&
                            ?markPresent = true &&
                            ?markDraught = ?maximumAmidships
                        )
                        ||
                        (
                            ?constructionDate < "2007-07-01"^^xsd:date &&
                            (
                                ?warningTriangle != true ||
                                ?markPresent != true ||
                                ?markDraught != ?maximumAmidships
                            ) &&
                            BOUND(?dryDockingDate) &&
                            (
                                ?dryDockingDate > ?assessmentDate ||
                                (
                                    ?dryDockingDate <= ?assessmentDate &&
                                    ?warningTriangle = true &&
                                    ?markPresent = true &&
                                    ?markDraught = ?maximumAmidships
                                )
                            )
                        )
                    )
                    AS ?validBranch
                )
                FILTER (?validBranch = false)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF014ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship>-><https://w3id.org/nltl/vocab#readilyAvailableToMaster> does not contain a value in the set: ['Literal(\"true\" = True, datatype=xsd:boolean)']" ;
            sh:resultPath <https://w3id.org/nltl/vocab#readilyAvailableToMaster> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n8dca617f702248e4b8de48dd78514295b14 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-014-P05/ship>-><https://w3id.org/nltl/vocab#readilyAvailableToMaster>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#readilyAvailableToMaster> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n8dca617f702248e4b8de48dd78514295b14 ] .

_:n8dca617f702248e4b8de48dd78514295b13 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#retainedOnBoard> .

_:n8dca617f702248e4b8de48dd78514295b14 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#readilyAvailableToMaster> .

