@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P03/ship> must conform to one or more shapes in [ sh:node <urn:nltl:generated-shape:TRF020ApplicableShape> ] , [ sh:node <urn:nltl:generated-shape:TRF020NonApplicableShape> ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF020Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-P03/ship> ] .

