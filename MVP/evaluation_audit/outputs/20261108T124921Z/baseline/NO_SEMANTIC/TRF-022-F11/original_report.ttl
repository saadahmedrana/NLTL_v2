@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F11/flareAngle> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F11/flareAngle>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/DEG>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F11/ship> ;
            sh:resultMessage "The externally computed flare angle result is required as a degree-valued quantity." ;
            sh:resultPath <https://w3id.org/nltl/vocab#flareAngle> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The externally computed flare angle result is required as a degree-valued quantity." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DEG> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#flareAngle> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F11/flareAngle> ] .

