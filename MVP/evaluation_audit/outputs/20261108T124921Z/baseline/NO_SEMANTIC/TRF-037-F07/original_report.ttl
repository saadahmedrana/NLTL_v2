@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F07/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F07/ship>-><https://w3id.org/nltl/vocab#iceClassFactorCp>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClassFactorCp> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#iceClassFactorCp> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F07/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-037-F07/ship>-><https://w3id.org/nltl/vocab#hasDirectAnalysisCase>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#iceLoadAreaFactorCa> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ] ] .

