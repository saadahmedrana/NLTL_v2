@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ;
                    sh:resultMessage "Each framing ice-strengthening termination case must provide a single extension quantity in millimetres." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#extensionBeyondAdjacentDeckOrTankBoundary> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "Each framing ice-strengthening termination case must provide a single extension quantity in millimetres." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#extensionBeyondAdjacentDeckOrTankBoundary> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF-043-TerminationCaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasFramingIceStrengtheningTerminationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF-043-TerminationCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasFramingIceStrengtheningTerminationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-F04/terminationCase> ] .

