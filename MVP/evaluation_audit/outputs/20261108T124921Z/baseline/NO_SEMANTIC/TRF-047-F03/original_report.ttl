            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n891eeab08b8c440f9dd0e8fb3011446bb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F03/lowerEnd> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n891eeab08b8c440f9dd0e8fb3011446bb3 ] .

