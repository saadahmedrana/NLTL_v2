[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/frame> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
