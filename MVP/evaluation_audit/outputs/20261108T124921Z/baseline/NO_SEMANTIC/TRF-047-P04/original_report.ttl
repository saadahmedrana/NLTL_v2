            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf9efa3d9c15044bf8cb4ebb1acd3a1e8b3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/adjacentMainFrame> ;
            sh:resultMessage "A frame shall identify its strengthened part." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasStrengthenedPart> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#frameStrengthenedPart> ;
                    sh:message "A frame shall identify its strengthened part." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#hasStrengthenedPart> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P04/lowerEnd> ;
            sh:resultMessage "The lower end shall be attached to a deck, tank boundary plating, tank top, or ice stringer." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasAttachedSupportingStructure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nf9efa3d9c15044bf8cb4ebb1acd3a1e8b3 ] .

