@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#passesThroughSupportingStructure> ] ] , [ sh:property [ sh:datatype xsd:integer ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"2\", datatype=xsd:integer) ; sh:message Literal(\"Both sides of a frame web plate passing through a supporting structure must be connected.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#webPlateConnectionSideCount> ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#passesThroughSupportingStructure> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-ThroughStructureFrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Each frame must state whether it passes through a supporting structure." ;
            sh:resultPath <https://w3id.org/nltl/vocab#passesThroughSupportingStructure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each frame must state whether it passes through a supporting structure." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#passesThroughSupportingStructure> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#withinIceStrengthenedArea> ] ] , [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#withinIceStrengthenedArea> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"A frame in the ice-strengthened area must provide its web thickness.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-LengthQuantityShape> ; sh:path <https://w3id.org/nltl/vocab#frameWebThickness> ], [ sh:message Literal(\"A frame in the ice-strengthened area must be effectively attached to its supporting structures.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-049-AttachmentShape> ; sh:path <https://w3id.org/nltl/vocab#hasFrameAttachment> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-049-FrameShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-049-P05/frame> ] .

