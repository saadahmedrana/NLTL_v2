@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-051-F05/hullStructure> ;
            sh:resultMessage "Corrosion and abrasion addition is required in millimetres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#corrosionAbrasionAddition> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Corrosion and abrasion addition is required in millimetres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#corrosionAbrasionAddition> ] ] .

