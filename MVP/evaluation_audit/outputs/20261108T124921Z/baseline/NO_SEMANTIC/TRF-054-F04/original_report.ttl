@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ;
            sh:resultMessage "stringerSpan is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#stringerSpan> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "stringerSpan is required in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantity> ;
                    sh:path <https://w3id.org/nltl/vocab#stringerSpan> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F04/iceStringer> ;
            sh:resultMessage "distanceToAdjacentIceStringer is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#distanceToAdjacentIceStringer> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "distanceToAdjacentIceStringer is required in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantity> ;
                    sh:path <https://w3id.org/nltl/vocab#distanceToAdjacentIceStringer> ] ] .

