@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "distanceToAdjacentIceStringer is required in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#distanceToAdjacentIceStringer> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "distanceToAdjacentIceStringer is required in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantity> ;
                    sh:path <https://w3id.org/nltl/vocab#distanceToAdjacentIceStringer> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/UNITLESS>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/iceStringer> ;
            sh:resultMessage "outsideIceBeltFactor is required as a dimensionless quantity." ;
            sh:resultPath <https://w3id.org/nltl/vocab#outsideIceBeltFactor> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "outsideIceBeltFactor is required as a dimensionless quantity." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:DimensionlessQuantity> ;
                    sh:path <https://w3id.org/nltl/vocab#outsideIceBeltFactor> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-054-F05/outsideIceBeltFactorValue> ] .

