@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F01/ship> must conform to one or more shapes in [ sh:property [ sh:class <https://w3id.org/nltl/vocab#rudderProtectionArrangement> ; sh:message Literal(\"A ship with ice class IA shall have a rudder protection arrangement suitable for absorbing the specified loads.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <https://w3id.org/nltl/vocab#hasRudderProtectionArrangement> ], [ sh:hasValue <https://w3id.org/nltl/vocab#iceClassIa> ; sh:path <https://w3id.org/nltl/vocab#iceClass> ] ] , [ sh:property [ sh:class <https://w3id.org/nltl/vocab#rudderProtectionArrangement> ; sh:message Literal(\"A ship with ice class IA Super shall have a rudder protection arrangement suitable for absorbing the specified loads.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path <https://w3id.org/nltl/vocab#hasRudderProtectionArrangement> ], [ sh:hasValue <https://w3id.org/nltl/vocab#iceClassIaSuper> ; sh:path <https://w3id.org/nltl/vocab#iceClass> ] ] , [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#iceClassIb> <https://w3id.org/nltl/vocab#iceClassIc> <https://w3id.org/nltl/vocab#iceClassIi> <https://w3id.org/nltl/vocab#iceClassIii> ) ; sh:path <https://w3id.org/nltl/vocab#iceClass> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-067> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-067-F01/ship> ] .

