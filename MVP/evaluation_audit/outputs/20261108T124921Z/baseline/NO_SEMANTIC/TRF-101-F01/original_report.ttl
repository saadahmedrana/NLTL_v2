@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "The calculated blade reference strength or ultimate load does not match the required formula." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The calculated blade reference strength or ultimate load does not match the required formula." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:bladeChordLengthAtWeakestSection/qudt:numericValue ?c ;
                      nltl:bladeMaximumThicknessAtWeakestSection/qudt:numericValue ?t ;
                      nltl:bladeCylindricalRootRadius/qudt:numericValue ?r ;
                      nltl:bladeMinimumYieldStrength/qudt:numericValue ?yield ;
                      nltl:bladeUltimateTensileStrength/qudt:numericValue ?ultimate ;
                      nltl:bladeReferenceStrength1/qudt:numericValue ?reference ;
                      nltl:bladeFailureUltimateLoad/qudt:numericValue ?load ;
                      nltl:propellerDiameter/qudt:numericValue ?diameter .
                BIND ((0.6 * ?yield) + (0.4 * ?ultimate) AS ?expectedReference)
                BIND (300 * ?c * ?t * ?t * ?expectedReference /
                      (0.8 * ?diameter - 2 * ?r) AS ?expectedLoad)
                BIND ((1e-6 * ABS(?expectedReference)) + 1e-9 AS ?referenceTolerance)
                BIND ((1e-6 * ABS(?expectedLoad)) + 1e-9 AS ?loadTolerance)
                FILTER (
                    (0.8 * ?diameter - 2 * ?r <= 0) ||
                    (?reference - ?expectedReference > ?referenceTolerance) ||
                    (?expectedReference - ?reference > ?referenceTolerance) ||
                    (?load - ?expectedLoad > ?loadTolerance) ||
                    (?expectedLoad - ?load > ?loadTolerance)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-101-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship>-><https://w3id.org/nltl/vocab#hasLoadCase>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#bladeFailureLoadWeakestDirectionConfirmed> ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:maxInclusive 0.8 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 0.8 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#bladeFailureLoadApplicationRadiusRatio> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasLoadCase> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-F01/ship>-><https://w3id.org/nltl/vocab#bladeFailureStatus>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladeFailureStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#bladeFailureStatus> ] ] .

