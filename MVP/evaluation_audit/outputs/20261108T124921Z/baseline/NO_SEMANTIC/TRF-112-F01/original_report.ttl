@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ;
                    sh:resultMessage "The blade-failure load case shall provide the externally calculated combined axial, bending, and torsion load." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#combinedAxialBendingTorsionLoad> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The blade-failure load case shall provide the externally calculated combined axial, bending, and torsion load." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF112ForceQuantityShape> ;
                            sh:path <https://w3id.org/nltl/vocab#combinedAxialBendingTorsionLoad> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ;
            sh:resultMessage "The ship shall provide the applicable blade-failure propulsion load case and its required load inputs." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPropulsionLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall provide the applicable blade-failure propulsion load case and its required load inputs." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF112LoadCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasPropulsionLoadCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ] .

