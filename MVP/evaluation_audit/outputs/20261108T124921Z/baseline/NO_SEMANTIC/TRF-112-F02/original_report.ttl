@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/component> ;
                    sh:resultMessage "The propeller shaft line component shall have a bending yield safety factor of at least 1.0." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#bendingYieldSafetyFactor> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:message "The propeller shaft line component shall have a bending yield safety factor of at least 1.0." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:TRF112BendingSafetyFactorValueShape> ;
                            sh:path <https://w3id.org/nltl/vocab#bendingYieldSafetyFactor> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/ship> ;
            sh:resultMessage "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPropellerShaftLineComponent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF112ShaftComponentShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasPropellerShaftLineComponent> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F02/component> ] .

