@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must record the propeller blade orientation causing the maximum component load." ;
            sh:resultPath <https://w3id.org/nltl/vocab#propellerBladeOrientation> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the propeller blade orientation causing the maximum component load." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#propellerBladeOrientation> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must provide evidence for the thruster blade-loss design." ;
            sh:resultPath <https://w3id.org/nltl/vocab#thrusterBladeLossDesignEvidence> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide evidence for the thruster blade-loss design." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ] ;
                    sh:path <https://w3id.org/nltl/vocab#thrusterBladeLossDesignEvidence> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must record the plastic-bending design condition for blade loss." ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladePlasticBending> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must record the plastic-bending design condition for blade loss." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#bladePlasticBending> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F01/ship> ;
            sh:resultMessage "The ship must provide a load case confirming the maximum component load blade orientation." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a load case confirming the maximum component load blade orientation." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:message "Each load case must confirm the maximum component load blade orientation." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#maximumComponentLoadBladeOrientationConfirmed> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasLoadCase> ] ] .

