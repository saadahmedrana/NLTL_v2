@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ;
                    sh:resultMessage "Node nltl:nonHemisphericalContactGeometry must conform to one or more shapes in [ sh:hasValue <https://w3id.org/nltl/vocab#hemisphericalContactGeometry> ] , [ sh:hasValue <https://w3id.org/nltl/vocab#nonHemisphericalContactGeometry> ; sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#contactGeometryCorrespondenceEvidence> ] ]" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#contactGeometryClassification> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:or ( [ sh:hasValue <https://w3id.org/nltl/vocab#hemisphericalContactGeometry> ] [ sh:hasValue <https://w3id.org/nltl/vocab#nonHemisphericalContactGeometry> ;
                                        sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#contactGeometryCorrespondenceEvidence> ] ] ) ;
                            sh:path <https://w3id.org/nltl/vocab#contactGeometryClassification> ] ;
                    sh:value <https://w3id.org/nltl/vocab#nonHemisphericalContactGeometry> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody>-><https://w3id.org/nltl/vocab#thrusterResistanceCapacity>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#thrusterResistanceCapacity> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#thrusterResistanceCapacity> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#thrusterResistanceCapacity> ] ]. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#thrusterImpactCaseAppliesToBody> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#thrusterBody> ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/unit> ],
                                                        [ sh:datatype xsd:decimal ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#thrusterResistanceCapacity> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#thrusterImpactCaseAppliesToBody> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/thrusterBody> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#thrusterIceImpactLoadedAreaEvidence> ], [ sh:class <https://w3id.org/nltl/vocab#thrusterBody> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#thrusterResistanceCapacity> ] ] ; sh:path <https://w3id.org/nltl/vocab#thrusterImpactCaseAppliesToBody> ], [ sh:hasValue <https://w3id.org/nltl/vocab#traficomTable6Dash16Reference> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#impactLoadCaseTableReference> ], [ sh:hasValue <https://w3id.org/nltl/vocab#traficomTable6Dash3Reference> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#designIceBlockTableReference> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/KN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#iceOperatingSpeed> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#thrusterIceImpactDemand> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#thrusterIceImpactLoad> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:or ( [ sh:hasValue <https://w3id.org/nltl/vocab#hemisphericalContactGeometry> ] [ sh:hasValue <https://w3id.org/nltl/vocab#nonHemisphericalContactGeometry> ; sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#contactGeometryCorrespondenceEvidence> ] ] ) ; sh:path <https://w3id.org/nltl/vocab#contactGeometryClassification> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasThrusterIceImpactLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#thrusterIceImpactLoadCase> ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#traficomTable6Dash3Reference> ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#designIceBlockTableReference> ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#thrusterIceImpactLoad> ],
                                [ sh:class <https://w3id.org/nltl/vocab#thrusterBody> ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#thrusterResistanceCapacity> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#thrusterImpactCaseAppliesToBody> ],
                                [ sh:hasValue <https://w3id.org/nltl/vocab#traficomTable6Dash16Reference> ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#impactLoadCaseTableReference> ],
                                [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#thrusterIceImpactLoadedAreaEvidence> ],
                                [ sh:minCount 1 ;
                                    sh:or ( [ sh:hasValue <https://w3id.org/nltl/vocab#hemisphericalContactGeometry> ] [ sh:hasValue <https://w3id.org/nltl/vocab#nonHemisphericalContactGeometry> ;
                                                sh:property [ ] ] ) ;
                                    sh:path <https://w3id.org/nltl/vocab#contactGeometryClassification> ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#thrusterIceImpactDemand> ],
                                [ sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#iceOperatingSpeed> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasThrusterIceImpactLoadCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/impact> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ;
            sh:resultMessage "A non-hemispherical contact geometry requires an equivalent impact sphere radius on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A non-hemispherical contact geometry requires an equivalent impact sphere radius on the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasThrusterIceImpactLoadCase ?case .
                ?case nltl:contactGeometryClassification nltl:nonHemisphericalContactGeometry .
                FILTER NOT EXISTS {
                    $this nltl:equivalentImpactSphereRadius ?radius .
                    ?radius qudt:numericValue ?value .
                    ?radius qudt:unit <http://qudt.org/vocab/unit/M> .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-114-ship> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-114-F02/ship> ] .

