@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/component> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/component>-><https://w3id.org/nltl/vocab#hasMaterialProperties>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasMaterialProperties> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:minCount 1 ;
                                    sh:node [ sh:class <https://w3id.org/nltl/vocab#materialProperties> ;
                                            sh:property [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                    sh:maxCount 1 ;
                                                    sh:message "The component material properties must provide material yield strength in MPa." ;
                                                    sh:minCount 1 ;
                                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                                    sh:maxCount 1 ;
                                                                    sh:minCount 1 ;
                                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                                [ sh:datatype xsd:decimal ;
                                                                    sh:maxCount 1 ;
                                                                    sh:minCount 1 ;
                                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#componentMaterialYieldStrength> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/assessment> ;
                    sh:resultMessage "Each assessment must identify its assessed thruster component." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#assessedThrusterComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "Each assessment must identify its assessed thruster component." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:class <https://w3id.org/nltl/vocab#materialProperties> ;
                                                    sh:property [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                            sh:maxCount 1 ;
                                                            sh:message "The component material properties must provide material yield strength in MPa." ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path <https://w3id.org/nltl/vocab#componentMaterialYieldStrength> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#assessedThrusterComponent> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/ship> ;
            sh:resultMessage "The ship must provide a factored extreme-load operability assessment for the assessed thruster components." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasFactoredExtremeLoadOperabilityAssessment> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a factored extreme-load operability assessment for the assessed thruster components." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#factoredExtremeLoadOperabilityAssessment> ;
                            sh:property [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must confirm that operability is maintained." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#assessmentOperabilityMaintained> ],
                                [ sh:message "Each assessment must identify its assessed thruster component." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#assessedThrusterComponent> ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue false ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must confirm that no repair is required." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#assessmentRepairRequired> ],
                                [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:maxCount 1 ;
                                    sh:message "Each assessment must provide the externally assessed factored extreme load in kN." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#assessedFactoredExtremeLoad> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasFactoredExtremeLoadOperabilityAssessment> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-118-P02/assessment> ] .

