@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase>-><https://w3id.org/nltl/vocab#componentYieldSafetyFactor>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#componentYieldSafetyFactor> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#componentYieldSafetyFactor> ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "The occasional force load case must document that propeller blades are excluded from its scope." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#propellerBladeExcludedFromOccasionalForceScope> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:hasValue true ;
                            sh:maxCount 1 ;
                            sh:message "The occasional force load case must document that propeller blades are excluded from its scope." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#propellerBladeExcludedFromOccasionalForceScope> ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component> ;
                            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component>-><https://w3id.org/nltl/vocab#occasionalForceComponentStress>" ;
                            sh:resultPath <https://w3id.org/nltl/vocab#occasionalForceComponentStress> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#occasionalForceComponentStress> ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ;
                    sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#occasionalForceComponentStress> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#materialProperties> ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#componentMaterialYieldStrength> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ] ]. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#occasionalForceCaseAssessedComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
                                    sh:property [ sh:minCount 1 ;
                                            sh:node [ sh:class <https://w3id.org/nltl/vocab#materialProperties> ;
                                                    sh:property [ sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:node [ ] ;
                                                            sh:path <https://w3id.org/nltl/vocab#componentMaterialYieldStrength> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                    sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#occasionalForceComponentStress> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#occasionalForceCaseAssessedComponent> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/component> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#occasionalForceLoadCase> ; sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("The occasional force load case must document that propeller blades are excluded from its scope.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#propellerBladeExcludedFromOccasionalForceScope> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#componentYieldSafetyFactor> ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#occasionalForceComponentStress> ], [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <https://w3id.org/nltl/vocab#materialProperties> ; sh:property [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#componentMaterialYieldStrength> ] ] ; sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ] ] ; sh:path <https://w3id.org/nltl/vocab#occasionalForceCaseAssessedComponent> ] ; sh:sparql [ sh:message Literal("The externally calculated occasional-force component stress, including the safety factor, must not exceed the component material yield strength.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:occasionalForceCaseAssessedComponent ?component .
                        ?component nltl:hasMaterialProperties ?materialProperties .
                        $this nltl:occasionalForceComponentStress ?stressQuantity .
                        ?stressQuantity qudt:numericValue ?stress .
                        $this nltl:componentYieldSafetyFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factor .
                        ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
                        ?yieldQuantity qudt:numericValue ?yield .
                        FILTER (?stress * ?factor > ?yield)
                    }
                ") ] ]. See details for more information.""" ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasOccasionalForceLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class <https://w3id.org/nltl/vocab#occasionalForceLoadCase> ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
                                            sh:property [ sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#hasMaterialProperties> ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#occasionalForceComponentStress> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#occasionalForceCaseAssessedComponent> ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#componentYieldSafetyFactor> ],
                                [ sh:datatype xsd:boolean ;
                                    sh:hasValue true ;
                                    sh:maxCount 1 ;
                                    sh:message "The occasional force load case must document that propeller blades are excluded from its scope." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#propellerBladeExcludedFromOccasionalForceScope> ] ;
                            sh:sparql [ sh:message "The externally calculated occasional-force component stress, including the safety factor, must not exceed the component material yield strength." ;
                                    sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX qudt: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:occasionalForceCaseAssessedComponent ?component .
                        ?component nltl:hasMaterialProperties ?materialProperties .
                        $this nltl:occasionalForceComponentStress ?stressQuantity .
                        ?stressQuantity qudt:numericValue ?stress .
                        $this nltl:componentYieldSafetyFactor ?factorQuantity .
                        ?factorQuantity qudt:numericValue ?factor .
                        ?materialProperties nltl:componentMaterialYieldStrength ?yieldQuantity .
                        ?yieldQuantity qudt:numericValue ?yield .
                        FILTER (?stress * ?factor > ?yield)
                    }
                """ ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasOccasionalForceLoadCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-123-F01/loadCase> ] .

