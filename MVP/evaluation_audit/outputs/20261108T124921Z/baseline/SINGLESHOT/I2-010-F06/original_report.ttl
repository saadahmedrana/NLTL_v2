@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-d/I2-010-F06/ship> ;
            sh:resultMessage "The ship must have Polar Class PC6 or PC7 for this design ice-force applicability rule." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#polarClassPc6> <https://w3id.org/nltl/vocab#polarClassPc7> ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have Polar Class PC6 or PC7 for this design ice-force applicability rule." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#polarClass> ] ] .

