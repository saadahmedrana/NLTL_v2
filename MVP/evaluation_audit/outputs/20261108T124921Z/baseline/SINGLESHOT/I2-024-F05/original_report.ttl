@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case>-><https://w3id.org/nltl/vocab#interpolationUpperEndpoint>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#interpolationUpperEndpoint> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:I2-024-InterpolationPointShape> ;
                            sh:path <https://w3id.org/nltl/vocab#interpolationUpperEndpoint> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2-024-ObliqueCaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasObliquePlatingInterpolationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:I2-024-ObliqueCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasObliquePlatingInterpolationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/case> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/upperEndpoint> ;
            sh:resultMessage "The calculation case must provide transverse framing net plate thickness in millimetres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#transverseFramingNetPlateThickness> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3b325fbf019c4185b0caec2edadb6a9eb24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/lowerEndpoint> ;
            sh:resultMessage "The calculation case must provide transverse framing net plate thickness in millimetres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#transverseFramingNetPlateThickness> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3b325fbf019c4185b0caec2edadb6a9eb24 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/lowerEndpoint> ;
            sh:resultMessage "The calculation case must provide longitudinal framing net plate thickness in millimetres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#longitudinalFramingNetPlateThickness> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3b325fbf019c4185b0caec2edadb6a9eb20 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-b/I2-024-F05/upperEndpoint> ;
            sh:resultMessage "The calculation case must provide longitudinal framing net plate thickness in millimetres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#longitudinalFramingNetPlateThickness> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n3b325fbf019c4185b0caec2edadb6a9eb20 ] .

