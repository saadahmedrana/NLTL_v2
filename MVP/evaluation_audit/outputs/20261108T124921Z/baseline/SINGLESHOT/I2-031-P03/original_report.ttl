@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P03/ship> ;
            sh:resultMessage "The ship must identify the frame profile type." ;
            sh:resultPath <https://w3id.org/nltl/vocab#frameProfileType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype <https://w3id.org/nltl/vocab#frameProfileTypeValue> ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the frame profile type." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#frameProfileType> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P03/ship> ;
            sh:resultMessage "The ship must provide the patch load in kN." ;
            sh:resultPath <https://w3id.org/nltl/vocab#patchLoad> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the patch load in kN." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:I2_031_KiloNewtonQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#patchLoad> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-f/I2-031-P03/ship> ;
            sh:resultMessage "The ship must identify the plastic collapse mechanism used to define plastic strength." ;
            sh:resultPath <https://w3id.org/nltl/vocab#plasticCollapseMechanism> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship must identify the plastic collapse mechanism used to define plastic strength." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#plasticCollapseMechanism> ] ] .

