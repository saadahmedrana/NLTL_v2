@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/bendingCase> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/bendingCase>-><https://w3id.org/nltl/vocab#caseHullGirderLongitudinalPositionFromAft>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#caseHullGirderLongitudinalPositionFromAft> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#caseHullGirderLongitudinalPositionFromAft> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/ship> ;
            sh:resultMessage "The ship must provide a hull girder bending moment calculation case." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasHullGirderBendingMomentCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a hull girder bending moment calculation case." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#hullGirderBendingMomentCalculationCase> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#caseBendingMomentDistributionFactor> ],
                                [ sh:maxCount 1 ;
                                    sh:message "Each hull girder bending moment calculation case must provide an externally computed design vertical ice bending moment in meganewton-metres." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaN-M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#caseDesignVerticalIceBendingMoment> ],
                                [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#caseHullGirderLongitudinalPositionFromAft> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasHullGirderBendingMomentCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/bendingCase> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/bendingCase> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/bendingCase>-><https://w3id.org/nltl/vocab#hasInterpolationPoint>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasInterpolationPoint> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ sh:class <https://w3id.org/nltl/vocab#interpolationPoint> ;
                                    sh:property [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#interpolationPointResult> ],
                                        [ sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                                            sh:maxCount 1 ;
                                                            sh:minCount 1 ;
                                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                            sh:path <https://w3id.org/nltl/vocab#interpolationPointCoordinate> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#hasInterpolationPoint> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/ship> ;
            sh:resultMessage "The ship must provide a calculation case with interpolation data for the externally computed result." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide a calculation case with interpolation data for the externally computed result." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ sh:class <https://w3id.org/nltl/vocab#interpolationPoint> ;
                                            sh:property [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#interpolationPointResult> ],
                                                [ sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:node [ ] ;
                                                    sh:path <https://w3id.org/nltl/vocab#interpolationPointCoordinate> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#hasInterpolationPoint> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-054-I-F04/bendingCase> ] .

