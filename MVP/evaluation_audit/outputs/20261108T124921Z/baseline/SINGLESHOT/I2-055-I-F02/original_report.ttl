@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/permissibleStress> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/permissibleStress>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/MegaPA> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/ship> ;
            sh:resultMessage "A single permissible stress in MPa is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#permissibleStress> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A single permissible stress in MPa is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#permissibleStress> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/permissibleStress> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/ship> ;
            sh:resultMessage "The Table 9 strength criteria must be satisfied." ;
            sh:resultPath <https://w3id.org/nltl/vocab#strengthCriterionStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The Table 9 strength criteria must be satisfied." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#strengthCriterionStatus> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/designStress> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/designStress>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/MegaPA> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/ship> ;
            sh:resultMessage "A single design stress in MPa is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#designStress> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "A single design stress in MPa is required." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#designStress> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-055-I-F02/designStress> ] .

