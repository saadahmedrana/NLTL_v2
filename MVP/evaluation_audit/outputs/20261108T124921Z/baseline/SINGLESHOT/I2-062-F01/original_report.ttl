@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F01/ship> ;
            sh:resultMessage "The ship must record that direct calculation was used when it has a load carrying stringer or web frame forming part of a grillage system." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship must record that direct calculation was used when it has a load carrying stringer or web frame forming part of a grillage system." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:hasStructuralMember ?member .
                ?member a ?memberType ;
                        nltl:partOfGrillageSystem ?grillage .
                ?grillage a nltl:grillageSystem .
                FILTER (
                    ?memberType IN (
                        nltl:loadCarryingStringer,
                        nltl:webFrame
                    )
                )
                FILTER NOT EXISTS {
                    $this nltl:directCalculationUsed ?used .
                    FILTER (?used = true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_062_ComplexReadiness> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F01/ship> ] .

