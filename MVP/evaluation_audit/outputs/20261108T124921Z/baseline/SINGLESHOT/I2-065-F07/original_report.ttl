@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "A nonlinear calculation case requires valid dimensionless fracture, major buckling, and yielding margins on the ship." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A nonlinear calculation case requires valid dimensionless fracture, major buckling, and yielding margins on the ship." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:hasCalculationCase ?case .
                ?case nltl:calculationMethod nltl:nonlinearCalculationMethodValue .
                FILTER (
                    NOT EXISTS {
                        $this nltl:fractureMargin ?fracture .
                        ?fracture qudt:numericValue ?fractureValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (DATATYPE(?fractureValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:majorBucklingMargin ?buckling .
                        ?buckling qudt:numericValue ?bucklingValue ;
                                  qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (DATATYPE(?bucklingValue) = xsd:decimal)
                    }
                    ||
                    NOT EXISTS {
                        $this nltl:yieldingMargin ?yielding .
                        ?yielding qudt:numericValue ?yieldingValue ;
                                 qudt:unit <http://qudt.org/vocab/unit/UNITLESS> .
                        FILTER (DATATYPE(?yieldingValue) = xsd:decimal)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2-065-Readiness> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> must conform to one or more shapes in [ sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ], [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#prescribedAnalyticalProcedure> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ]" ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:OrConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                            sh:or ( [ sh:property [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ],
                                            [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ],
                                            [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ],
                                            [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                                        sh:property [ ],
                                                            [ ] ] ;
                                                sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#prescribedAnalyticalProcedure> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] ) ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ; sh:or ( [ sh:property [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ], [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#prescribedAnalyticalProcedure> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] ) ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                            sh:or ( [ sh:property [ sh:datatype xsd:boolean ;
                                                sh:hasValue true ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#minorPermanentDeformationAssessmentSatisfied> ],
                                            [ sh:class <https://w3id.org/nltl/vocab#evidenceArtifact> ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#nonlinearAnalysisAcceptanceEvidence> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path <https://w3id.org/nltl/vocab#permanentOutOfPlaneDeformation> ],
                                            [ sh:hasValue <https://w3id.org/nltl/vocab#nonlinearCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path <https://w3id.org/nltl/vocab#relevantStructuralDimension> ],
                                            [ sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:node [ ] ;
                                                sh:path <https://w3id.org/nltl/vocab#permanentLateralDeformation> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#directCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#linearCalculationMethodValue> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#prescribedAnalyticalProcedure> ;
                                                sh:maxCount 1 ;
                                                sh:minCount 1 ;
                                                sh:path <https://w3id.org/nltl/vocab#calculationMethod> ] ] ) ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-065-F07/calculation> ] .

