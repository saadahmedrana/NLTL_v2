@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-010-F01/maximumExpectedRescueTimeValue> ;
                    sh:resultMessage "Maximum expected rescue time must be at least 5 days." ;
                    sh:resultPath <http://qudt.org/schema/qudt/numericValue> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:message "Maximum expected rescue time must be at least 5 days." ;
                            sh:minCount 1 ;
                            sh:minInclusive 5.0 ;
                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ;
                    sh:value 4.99 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-010-F01/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Maximum expected rescue time must be at least 5 days.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"5\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/DAY> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#maximumExpectedRescueTime> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DAY> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "Maximum expected rescue time must be at least 5 days." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 5.0 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#maximumExpectedRescueTime> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-010-F01/maximumExpectedRescueTimeValue> ] .

