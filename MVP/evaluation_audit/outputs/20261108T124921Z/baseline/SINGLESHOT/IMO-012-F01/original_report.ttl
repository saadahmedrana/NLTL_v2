@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ;
            sh:resultMessage "polarServiceTemperature must be at least 10 degrees Celsius below lowestMdlt." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "polarServiceTemperature must be at least 10 degrees Celsius below lowestMdlt." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:lowestMdlt ?lowestQuantity ;
                      nltl:polarServiceTemperature ?pstQuantity .
                ?lowestQuantity qudt:numericValue ?lowest ;
                                qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                ?pstQuantity qudt:numericValue ?pst ;
                              qudt:unit <http://qudt.org/vocab/unit/DEG_C> .
                FILTER (
                    DATATYPE(?lowest) = xsd:decimal &&
                    DATATYPE(?pst) = xsd:decimal &&
                    ?pst > (?lowest - 10)
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_012_PolarServiceTemperatureShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-012-F01/ship> ] .

