@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ;
            sh:resultMessage "If ice operation is applicable, the ship must record ice-safety monitoring, escort requirements, and both independent and escorted operating limits." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-030> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F05/ship> ] .

