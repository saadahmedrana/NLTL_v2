@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "The ship shall document ice and snow mitigation coverage." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceSnowMitigationCoverage> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:in ( true ) ;
                    sh:message "The ship shall document ice and snow mitigation coverage." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#iceSnowMitigationCoverage> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "The exposed escape route shall be accessible." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#escapeRouteAccessibleStatus> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The exposed escape route shall be accessible." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#escapeRouteAccessibleStatus> ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ;
                    sh:resultMessage "The exposed escape route shall be safe." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#escapeRouteSafeStatus> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:boolean ;
                            sh:in ( true ) ;
                            sh:message "The exposed escape route shall be safe." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#escapeRouteSafeStatus> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO_062_ExposedEscapeRouteShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasExposedEscapeRoute> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO_062_ExposedEscapeRouteShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasExposedEscapeRoute> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-062-F04/route1> ] .

