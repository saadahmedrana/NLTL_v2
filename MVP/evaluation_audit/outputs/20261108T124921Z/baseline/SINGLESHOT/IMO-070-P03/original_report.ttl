@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ;
            sh:resultMessage "A passenger ship must record that the assigned survival equipment is properly sized." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "A passenger ship must record that the assigned survival equipment is properly sized." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this WHERE {
                $this a nltl:passengerShip .
                {
                    FILTER NOT EXISTS {
                        $this nltl:sizeCompatibilityStatus ?status .
                    }
                }
                UNION
                {
                    $this nltl:sizeCompatibilityStatus ?status .
                    FILTER (?status != true)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-070> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-P03/ship> ] .

