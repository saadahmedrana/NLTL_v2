@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath <https://w3id.org/nltl/vocab#searchAndRescueCommunicationCapability> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n703eb5d7545c4eef948954d6abaa573bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall declare search and rescue communication capability." ;
            sh:resultPath <https://w3id.org/nltl/vocab#searchAndRescueCommunicationCapability> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n703eb5d7545c4eef948954d6abaa573bb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The supported aircraft voice frequencies shall include 123.1 MHz." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The supported aircraft voice frequencies shall include 123.1 MHz." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this nltl:supportedAircraftVoiceFrequency ?quantity .
                    ?quantity qudt:numericValue ?value ;
                              qudt:unit unit:MegaHZ .
                    FILTER(?value = 123.1)
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_095_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-095-J-F01/ship> ;
            sh:resultMessage "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
            sh:resultPath <https://w3id.org/nltl/vocab#supportedAircraftVoiceFrequency> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship shall support aircraft voice communications on both 121.5 MHz and 123.1 MHz." ;
                    sh:minCount 2 ;
                    sh:node <urn:nltl:generated-shape:IMO_095_FrequencyQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#supportedAircraftVoiceFrequency> ] ] .

_:n703eb5d7545c4eef948954d6abaa573bb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:message "The ship shall declare search and rescue communication capability." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#searchAndRescueCommunicationCapability> .

