@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "Each assigned duty's relevant PWOM procedure or equipment must be represented in the crew member's familiarization records." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "Each assigned duty's relevant PWOM procedure or equipment must be represented in the crew member's familiarization records." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this a nltl:ship .
                $this nltl:hasCrewMemberInventory ?crew .
                ?crew nltl:hasAssignedDuty ?duty .
                ?duty nltl:hasRelevantPolarWaterOperationalManualItem ?item .
                FILTER NOT EXISTS {
                    ?crew nltl:hasFamiliarizationRecord ?record .
                    ?record nltl:familiarizationRecordItem ?item .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-104-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarWaterOperationalManualFamiliarizationStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nfac049c2dc0f47c88aa9cc3d22aa300cb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "The ship must record completed PWOM familiarization status." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarWaterOperationalManualFamiliarizationStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:nfac049c2dc0f47c88aa9cc3d22aa300cb1 ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ;
                    sh:resultMessage "Each crew member must have a PWOM familiarization record." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasFamiliarizationRecord> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "Each crew member must have a PWOM familiarization record." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:IMO-104-FamiliarizationRecordShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasFamiliarizationRecord> ] ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/item1> ;
                                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/item1>-><https://w3id.org/nltl/vocab#relevantPolarWaterOperationalManualProcedureOrEquipment>" ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#relevantPolarWaterOperationalManualProcedureOrEquipment> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#relevantPolarWaterOperationalManualProcedureOrEquipment> ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/duty1> ;
                            sh:resultMessage "Each represented assigned duty must identify its relevant PWOM procedure or equipment." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasRelevantPolarWaterOperationalManualItem> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each represented assigned duty must identify its relevant PWOM procedure or equipment." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:IMO-104-ManualItemShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#hasRelevantPolarWaterOperationalManualItem> ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/item1> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-104-AssignedDutyShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasAssignedDuty> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-104-AssignedDutyShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasAssignedDuty> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/duty1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO-104-CrewMemberShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCrewMemberInventory> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:IMO-104-CrewMemberShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasCrewMemberInventory> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F02/crew1> ] .

_:nfac049c2dc0f47c88aa9cc3d22aa300cb1 sh:datatype xsd:boolean ;
    sh:hasValue true ;
    sh:maxCount 1 ;
    sh:message "The ship must record completed PWOM familiarization status." ;
    sh:minCount 1 ;
    sh:path <https://w3id.org/nltl/vocab#polarWaterOperationalManualFamiliarizationStatus> .

