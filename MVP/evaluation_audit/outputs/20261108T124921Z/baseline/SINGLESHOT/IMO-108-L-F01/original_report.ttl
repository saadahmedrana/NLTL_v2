@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> must conform to one or more shapes in [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryC> ) ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ] , [ sh:property [ sh:datatype xsd:date ; sh:maxExclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionDate> ] ] , [ sh:property [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minInclusive Literal(\"600\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ; sh:path <https://w3id.org/nltl/vocab#aggregateOilFuelCapacity> ] ] , [ sh:property [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal(\"30\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ; sh:path <https://w3id.org/nltl/vocab#individualOilFuelTankCapacity> ] ] , [ sh:property [ sh:datatype xsd:date ; sh:minInclusive Literal(\"2017-01-01\", datatype=xsd:date) ; sh:path <https://w3id.org/nltl/vocab#constructionDate> ], [ sh:in ( <https://w3id.org/nltl/vocab#polarShipCategoryA> <https://w3id.org/nltl/vocab#polarShipCategoryB> ) ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ], [ sh:message Literal(\"Applicable oil fuel tanks must be separated from the outer shell by at least 0.76 metres.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"0.76\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/M> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#oilFuelTankOuterShellSeparation> ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxExclusive Literal(\"600\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ; sh:path <https://w3id.org/nltl/vocab#aggregateOilFuelCapacity> ], [ sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:minExclusive Literal(\"30\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ; sh:path <https://w3id.org/nltl/vocab#individualOilFuelTankCapacity> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO108Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-108-L-F01/ship> ] .

