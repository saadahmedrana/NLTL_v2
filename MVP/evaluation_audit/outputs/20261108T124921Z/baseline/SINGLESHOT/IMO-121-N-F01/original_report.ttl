@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F01/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Food waste discharged to sea must not be contaminated by other garbage.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#contaminatedByOtherGarbage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Food waste discharged to sea must be comminuted or ground.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#foodWasteComminutedOrGround> ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#foodWasteDischargeToSea> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The screen opening for food waste discharged to sea must be no greater than 25 mm.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxInclusive Literal(\"25\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#requiredScreenOpening> ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#foodWasteDischargeToSea> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_121_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-121-N-F01/ship> ] .

