@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F01/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipOperatesInPolarWaters> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"Garbage placards shall include polar operation coverage when the ship operates in polar waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#garbagePlacardPolarCoverage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The Garbage Management Plan shall include polar operation coverage when the ship operates in polar waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#garbageManagementPlanPolarCoverage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The Garbage Record Book shall include polar operation coverage when the ship operates in polar waters.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#garbageRecordBookPolarCoverage> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipOperatesInPolarWaters> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-125> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F01/ship> ] .

