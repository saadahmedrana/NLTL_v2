@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ;
            sh:resultMessage "Each ship must state whether it operates in polar waters." ;
            sh:resultPath <https://w3id.org/nltl/vocab#shipOperatesInPolarWaters> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Each ship must state whether it operates in polar waters." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shipOperatesInPolarWaters> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO26_016_NonPolarBranch> , <urn:nltl:generated-shape:IMO26_016_FishingVesselBranch> , <urn:nltl:generated-shape:IMO26_016_PleasureYachtBranch> , <urn:nltl:generated-shape:IMO26_016_CargoShipBranch>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO26_016_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-016-B-F03/ship> ] .

