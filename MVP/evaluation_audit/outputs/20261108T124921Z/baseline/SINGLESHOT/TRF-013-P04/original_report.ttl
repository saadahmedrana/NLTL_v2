@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-P04/ship> ;
            sh:resultMessage "The ship shall identify that it is ice-strengthened when the ice-condition rule applies." ;
            sh:resultPath <https://w3id.org/nltl/vocab#shipIceStrengthened> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall identify that it is ice-strengthened when the ice-condition rule applies." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-P04/ship> ;
            sh:resultMessage "An ice class is required for an ice-strengthened ship." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceClassValue> ;
                    sh:maxCount 1 ;
                    sh:message "An ice class is required for an ice-strengthened ship." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-P04/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-013-P04/ship>-><https://w3id.org/nltl/vocab#hasUpperIceWaterline>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasUpperIceWaterline> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceWaterline> ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasUpperIceWaterline> ] ] .

