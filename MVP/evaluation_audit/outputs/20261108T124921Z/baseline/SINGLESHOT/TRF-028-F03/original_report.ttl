@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The ship's approval status for the alternative Ke or RCH determination must be true." ;
            sh:resultPath <https://w3id.org/nltl/vocab#approvalStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:hasValue true ;
                    sh:maxCount 1 ;
                    sh:message "The ship's approval status for the alternative Ke or RCH determination must be true." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#approvalStatus> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F03/ship> ;
            sh:resultMessage "The ship must provide evidence for an alternative calculation or model-test determination." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasEvidence> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide evidence for an alternative calculation or model-test determination." ;
                    sh:minCount 1 ;
                    sh:node [ sh:or ( [ sh:class <https://w3id.org/nltl/vocab#alternativeCalculationEvidence> ] [ sh:class <https://w3id.org/nltl/vocab#modelTestEvidence> ] ) ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasEvidence> ] ] .

