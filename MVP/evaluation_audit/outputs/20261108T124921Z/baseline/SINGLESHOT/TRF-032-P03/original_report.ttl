@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P03/ship> ;
            sh:resultMessage """Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P03/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("true" = True, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceStrengtheningStatus> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal("false" = False, datatype=xsd:boolean) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceStrengtheningStatus> ] ; sh:sparql [ sh:message Literal("When the ship is not ice strengthened and the regulation-derived scantling is less than the classification-society requirement, the selected design scantling must use the classification-society requirement.") ; sh:select Literal("
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this
WHERE {
    $this nltl:iceStrengtheningStatus false ;
          nltl:regulationRequiredScantling ?regulation ;
          nltl:classificationSocietyRequiredScantling ?classification .
    ?regulation qudt:numericValue ?regulationValue .
    ?classification qudt:numericValue ?classificationValue .
    FILTER (?regulationValue < ?classificationValue)
    FILTER NOT EXISTS {
        $this nltl:selectedDesignScantling ?selected .
        ?selected qudt:numericValue ?selectedValue .
        FILTER (?selectedValue = ?classificationValue)
    }
}
") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF032_Static> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P03/ship> ;
            sh:resultMessage "Ice strengthening status is required to determine applicability of the scantling rule." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceStrengtheningStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Ice strengthening status is required to determine applicability of the scantling rule." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#iceStrengtheningStatus> ] ] .

