@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "The ship's rule length shall equal the rule length used by the classification society." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The ship's rule length shall equal the rule length used by the classification society." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?ruleLengthQuantity .
                ?ruleLengthQuantity qudt:numericValue ?ruleLengthValue .
                $this nltl:classificationSocietyRuleLength ?societyRuleLengthQuantity .
                ?societyRuleLengthQuantity qudt:numericValue ?societyRuleLengthValue .
                FILTER (?ruleLengthValue != ?societyRuleLengthValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-035-ShipRuleLengthShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/societyRuleLength> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/societyRuleLength>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/M>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "The ship shall have one classification-society rule length quantity expressed in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#classificationSocietyRuleLength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall have one classification-society rule length quantity expressed in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#classificationSocietyRuleLength> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/societyRuleLength> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ruleLength> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ruleLength>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/M>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "The ship shall have one rule length quantity expressed in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#ruleLength> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship shall have one rule length quantity expressed in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#ruleLength> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ruleLength> ] .

