            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one required shear area in cm^2." ;
            sh:resultPath <https://w3id.org/nltl/vocab#requiredShearArea> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one required shear area in cm^2." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/CentiM2> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#requiredShearArea> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/requiredShearAreaValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/yieldStrengthValue> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/yieldStrengthValue>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
