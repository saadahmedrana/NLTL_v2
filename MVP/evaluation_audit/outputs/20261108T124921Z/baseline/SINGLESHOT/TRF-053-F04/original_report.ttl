                    sh:path <https://w3id.org/nltl/vocab#icePressure> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/icePressureValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one span in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#span> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one span in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#span> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/designIceLoadHeightValue> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/designIceLoadHeightValue>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/M>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/iceStringer> ;
            sh:resultMessage "Each ice stringer must specify one design ice load height in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#designIceLoadHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Each ice stringer must specify one design ice load height in metres." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
