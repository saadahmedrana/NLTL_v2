                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/schema/qudt/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#frameMomentFactorM> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/frameMomentFactorMValue> ],
        [ a sh:ValidationResult ;
