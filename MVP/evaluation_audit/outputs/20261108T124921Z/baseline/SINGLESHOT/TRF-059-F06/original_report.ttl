@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F06/webFrame> ;
            sh:resultMessage "The web frame shear distribution factor f13 must equal 1.1." ;
            sh:resultPath <https://w3id.org/nltl/vocab#webFrameShearDistributionFactorF13> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The web frame shear distribution factor f13 must equal 1.1." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 1.1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#webFrameShearDistributionFactorF13> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F06/requiredShearAreaValue> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F06/requiredShearAreaValue>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/CentiM2>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F06/webFrame> ;
            sh:resultMessage "Required shear area is required in cm2." ;
            sh:resultPath <https://w3id.org/nltl/vocab#requiredShearArea> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "Required shear area is required in cm2." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/CentiM2> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#requiredShearArea> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-059-F06/requiredShearAreaValue> ] .

