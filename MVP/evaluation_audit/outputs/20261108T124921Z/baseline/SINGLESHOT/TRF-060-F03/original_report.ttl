@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F03/lookup> ;
                    sh:resultMessage "The externally selected Table 4-8 gamma factor with a dimensionless numeric value is required." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#webFrameTable4Dash8GammaFactor> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:maxCount 1 ;
                            sh:message "The externally selected Table 4-8 gamma factor with a dimensionless numeric value is required." ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#webFrameTable4Dash8GammaFactor> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F03/ship> ;
            sh:resultMessage "A table lookup case for the cited Table 4-8 selection is required." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasTableLookupCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#tableLookupCase> ;
                    sh:message "A table lookup case for the cited Table 4-8 selection is required." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-060-TableLookupCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasTableLookupCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-060-F03/lookup> ] .

