@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-078-F01/ship> ;
            sh:resultMessage "A ship must have a Table 6-6 ice-class lookup case." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasTableLookupCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:QualifiedMinCountConstraintComponent ;
            sh:sourceShape [ sh:message "A ship must have a Table 6-6 ice-class lookup case." ;
                    sh:node <urn:nltl:generated-shape:LookupCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasTableLookupCase> ;
                    sh:qualifiedMinCount 1 ;
                    sh:qualifiedValueShape <urn:nltl:generated-shape:Table6Dash6CaseShape> ] ] .

