@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "The ship shall identify the load sequence used for propeller ice-block milling." ;
            sh:resultPath <https://w3id.org/nltl/vocab#propellerIceMillingLoadSequence> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:message "The ship shall identify the load sequence used for propeller ice-block milling." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#propellerIceMillingLoadSequence> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/milling> ;
            sh:resultMessage "The ship shall identify a propeller ice-milling load-sequence case." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasIceMillingSequenceCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceMillingSequenceCase> ;
                    sh:message "The ship shall identify a propeller ice-milling load-sequence case." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasIceMillingSequenceCase> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-091-P01/ship> ;
            sh:resultMessage "The ship shall identify a propulsion load case using the ice-milling load sequence." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPropulsionLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#loadCase> ;
                    sh:message "The ship shall identify a propulsion load case using the ice-milling load sequence." ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#propulsionLineStrengthEvaluationPurpose> ;
                                    sh:maxCount 1 ;
                                    sh:message "The propulsion load case shall be designated for propulsion-line strength evaluation and not for propulsion-system stalling analysis." ;
                                    sh:minCount 1 ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path <https://w3id.org/nltl/vocab#loadCasePurpose> ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasPropulsionLoadCase> ] ] .

