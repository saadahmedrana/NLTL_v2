@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship>-><https://w3id.org/nltl/vocab#bladeFailureStatus>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladeFailureStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#bladeFailureStatus> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship>-><https://w3id.org/nltl/vocab#bladeTipOffset>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladeTipOffset> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/M> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#bladeTipOffset> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship>-><https://w3id.org/nltl/vocab#bladeReferenceStrength1>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladeReferenceStrength1> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#bladeReferenceStrength1> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-101-P02/ship>-><https://w3id.org/nltl/vocab#bladeCylindricalRootRadius>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#bladeCylindricalRootRadius> ;
            sh:resultSeverity sh:Violation ;
