@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/torsionalYieldSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.0\", datatype=xsd:decimal)" ;
                            sh:resultPath <http://qudt.org/schema/qudt/numericValue> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.0 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ;
                            sh:value 0.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ;
                    sh:resultMessage "The externally calculated torsional yield safety factor shall be at least 1.0." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#torsionalYieldSafetyFactor> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The externally calculated torsional yield safety factor shall be at least 1.0." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#torsionalYieldSafetyFactor> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/torsionalYieldSafetyFactorValue> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/bendingYieldSafetyFactorValue> ;
                            sh:resultMessage "Value is not >= Literal(\"1.0\", datatype=xsd:decimal)" ;
                            sh:resultPath <http://qudt.org/schema/qudt/numericValue> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 1.0 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ;
                            sh:value 0.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ;
                    sh:resultMessage "The externally calculated bending yield safety factor shall be at least 1.0." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#bendingYieldSafetyFactor> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The externally calculated bending yield safety factor shall be at least 1.0." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 1.0 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#bendingYieldSafetyFactor> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/bendingYieldSafetyFactorValue> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/ship> ;
            sh:resultMessage "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPropellerShaftLineComponent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#propellerShaftLineComponent> ;
                    sh:message "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF112ComponentShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasPropellerShaftLineComponent> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F03/component> ] .

