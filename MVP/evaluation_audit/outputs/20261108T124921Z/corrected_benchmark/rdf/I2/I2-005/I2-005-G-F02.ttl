@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasBottomRegionLowerRegionBoundaryPoint ex:boundaryPoint .

ex:boundaryPoint a nltl:hullBoundaryPoint ;
    nltl:shellInclinationAngle ex:inclination .

ex:inclination a qudt:QuantityValue ;
    qudt:numericValue 7.1 ;
    qudt:unit unit:DEG .

