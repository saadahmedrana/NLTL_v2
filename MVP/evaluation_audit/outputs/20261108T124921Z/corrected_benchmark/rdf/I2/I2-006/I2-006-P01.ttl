@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:aftSectionDesignBasis "Bow and Bow Intermediate"^^xsd:string ;
    nltl:asternIceOperationIntent true ;
    nltl:hullAreaRequirementSet "Bow and Bow Intermediate hull area requirements"^^xsd:string .

