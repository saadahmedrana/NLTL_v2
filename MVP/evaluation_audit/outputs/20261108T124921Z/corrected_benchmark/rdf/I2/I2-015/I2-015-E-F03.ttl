@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-e/I2-015-E-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasBowSubregionCalculationCase ex:bowCase ;
    nltl:upperIceWaterlineLengthLUI ex:lui .

ex:betaPrime a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:UNITLESS .

ex:bowCase a nltl:bowSubregionCalculationCase ;
    nltl:betaIPrime ex:betaPrime ;
    nltl:bowFormApplicabilityClassification nltl:i231vBowFormApplicability ;
    nltl:bowShapeCoefficient ex:fa ;
    nltl:bowSubregionMidLengthPosition ex:x ;
    nltl:hasFailureClassFactorLookupCase ex:factorLookup .

ex:cfc a qudt:QuantityValue ;
    qudt:numericValue 3.1 ;
    qudt:unit unit:UNITLESS .

ex:cff a qudt:QuantityValue ;
    qudt:numericValue 9.0 ;
    qudt:unit unit:UNITLESS .

ex:fa a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:UNITLESS .

ex:factorLookup a nltl:tableLookupCase ;
    nltl:crushingFailureClassFactor ex:cfc ;
    nltl:flexuralFailureClassFactor ex:cff .

ex:lui a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:M .

ex:x a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:M .

