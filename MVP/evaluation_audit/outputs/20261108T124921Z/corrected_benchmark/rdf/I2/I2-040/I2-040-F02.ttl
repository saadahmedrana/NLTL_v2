@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-b/I2-040-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:member a nltl:structuralMember ;
    nltl:netWebThickness ex:netWebThickness ;
    nltl:structuralSectionType nltl:teeSection ;
    nltl:yieldStrength ex:yieldStrength .

ex:netWebThickness a qudt:QuantityValue ;
    qudt:numericValue 0.01 ;
    qudt:unit unit:MilliM .

ex:yieldStrength a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

