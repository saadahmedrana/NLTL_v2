@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-b/I2-043-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:flangeOutstand a qudt:QuantityValue ;
    qudt:numericValue 0.05 ;
    qudt:unit unit:MilliM .

ex:member a nltl:structuralMember ;
    nltl:flangeOutstand ex:flangeOutstand ;
    nltl:netFlangeThickness ex:netFlangeThickness .

ex:netFlangeThickness a qudt:QuantityValue ;
    qudt:numericValue 0.012 ;
    qudt:unit unit:MilliM .

