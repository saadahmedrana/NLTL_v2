@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasInternalIceStrengthenedStructure ex:internalStructure1 ;
    nltl:polarClass nltl:polarClassPc3 ;
    nltl:polarClassRequirementsApplicable true .

ex:internalStructure1 a nltl:internalIceStrengthenedStructure .

