@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasInternalIceStrengthenedStructure ex:internalStructure1 ;
    nltl:polarClass nltl:polarClassPc3 ;
    nltl:polarClassRequirementsApplicable false,
        true .

ex:addition1 a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MilliM .

ex:internalStructure1 a nltl:internalIceStrengthenedStructure ;
    nltl:internalStructureCorrosionAbrasionAddition ex:addition1 .

