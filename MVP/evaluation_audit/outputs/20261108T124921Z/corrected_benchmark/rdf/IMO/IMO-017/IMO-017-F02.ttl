@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:endorsementDates "2028-07-01"^^xsd:date ;
    nltl:hasPolarCertificateSupplement ex:supplement ;
    nltl:hasPolarShipCertificate ex:certificate ;
    nltl:polarCertificateSupplementPresent true ;
    nltl:polarCertificateValidityDates "2030-01-01"^^xsd:date ;
    nltl:surveyDates "2028-06-01"^^xsd:date .

ex:solasSchedule a nltl:solasCertificateSchedule .

ex:certificate a nltl:polarShipCertificateForm .

ex:requiredEquipment a nltl:requiredEquipmentRecords .

ex:supplement a nltl:polarCertificateSupplement ;
    nltl:hasRequiredEquipmentRecords ex:requiredEquipment .

