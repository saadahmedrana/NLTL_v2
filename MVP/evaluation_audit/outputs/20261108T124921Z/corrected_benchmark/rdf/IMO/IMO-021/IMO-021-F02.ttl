@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:assessedAbandonment true ;
    nltl:assessedAdditionalHazards true ;
    nltl:assessedCodeHazards true ;
    nltl:assessedHighLatitude true ;
    nltl:assessedIceOperation false ;
    nltl:assessedLowAirTemperature ex:assessedLowAirTemperatureValue ;
    nltl:operationalAssessmentPresent true .

ex:assessedLowAirTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue -20.0 ;
    qudt:unit unit:DEG_C .

