@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-030-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:escortRequirementsPresent true ;
    nltl:iceOperationApplicable true ;
    nltl:iceSafetyMonitoringProcedurePresent true ;
    nltl:independentOperationLimits "independent-operation limitations"^^xsd:string .

