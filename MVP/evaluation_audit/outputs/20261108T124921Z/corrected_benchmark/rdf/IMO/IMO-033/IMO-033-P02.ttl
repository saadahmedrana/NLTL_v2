@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-033-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:continuousSurfaceProjectedArea ex:continuousSurfaceProjectedAreaValue ;
    nltl:continuousSurfaceStaticMoment ex:continuousSurfaceStaticMomentValue ;
    nltl:deckIcingAllowance ex:deckIcingAllowanceValue ;
    nltl:discontinuousSurfaceProjectedArea ex:discontinuousSurfaceProjectedAreaValue ;
    nltl:discontinuousSurfaceStaticMoment ex:discontinuousSurfaceStaticMomentValue ;
    nltl:iceAccretionLikely true ;
    nltl:sideIcingAllowance ex:sideIcingAllowanceValue .

ex:continuousSurfaceProjectedAreaValue a qudt:QuantityValue ;
    qudt:numericValue 37.25 ;
    qudt:unit unit:M2 .

ex:continuousSurfaceStaticMomentValue a qudt:QuantityValue ;
    qudt:numericValue 81.5 ;
    qudt:unit unit:KiloN-M .

ex:deckIcingAllowanceValue a qudt:QuantityValue ;
    qudt:numericValue 30.0 ;
    qudt:unit unit:KiloGM-PER-M2 .

ex:discontinuousSurfaceProjectedAreaValue a qudt:QuantityValue ;
    qudt:numericValue 39.112500000000004 ;
    qudt:unit unit:M2 .

ex:discontinuousSurfaceStaticMomentValue a qudt:QuantityValue ;
    qudt:numericValue 89.65 ;
    qudt:unit unit:KiloN-M .

ex:sideIcingAllowanceValue a qudt:QuantityValue ;
    qudt:numericValue 7.5 ;
    qudt:unit unit:KiloGM-PER-M2 .

