@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-051-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasLocalControlItem ex:control1,
        ex:control2 .

ex:control1 a nltl:localControlItem ;
    nltl:continuouslyAccessible true ;
    nltl:freezingSnowIceProtectionPresent true .

ex:control2 a nltl:localControlItem ;
    nltl:continuouslyAccessible true ;
    nltl:freezingSnowIceProtectionPresent true .

