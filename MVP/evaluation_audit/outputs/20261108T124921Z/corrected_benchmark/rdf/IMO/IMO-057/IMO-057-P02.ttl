@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:emergency .

ex:emergency a nltl:emergencyFirePump ;
    nltl:hasContainingCompartment ex:emergencyCompartment .

ex:emergencyCompartment a nltl:compartment ;
    nltl:maintainedTemperature ex:emergencyMaintainedTemperatureValue .

ex:emergencyMaintainedTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:DEG_C .

