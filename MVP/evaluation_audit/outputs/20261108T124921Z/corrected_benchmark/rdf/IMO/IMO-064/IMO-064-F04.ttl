@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:anticipatedWind "anticipated wind"^^xsd:string ;
    nltl:assignedThermalProtection true ;
    nltl:immersionPotential true ;
    nltl:intendedVoyage "polar voyage"^^xsd:string ;
    nltl:personOnBoard 10 ;
    nltl:thermalProtectionApprovalStatus nltl:evidenceStateApproved .

