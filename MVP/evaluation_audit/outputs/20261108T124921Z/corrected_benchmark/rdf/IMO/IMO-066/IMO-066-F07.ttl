@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-066-F07/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasProtectedItem ex:protectedItem1,
        ex:protectedItem2,
        ex:protectedItem3,
        ex:protectedItem4,
        ex:protectedItem5,
        ex:protectedItem6 ;
    nltl:shipExposedToIceAccretion true .

ex:iceSnowMeans1 a nltl:iceSnowRemovalOrPreventionMeans .

ex:iceSnowMeans2 a nltl:iceSnowRemovalOrPreventionMeans .

ex:iceSnowMeans3 a nltl:iceSnowRemovalOrPreventionMeans .

ex:iceSnowMeans4 a nltl:iceSnowRemovalOrPreventionMeans .

ex:iceSnowMeans5 a nltl:iceSnowRemovalOrPreventionMeans .

ex:protectedItem1 a nltl:protectedItem ;
    nltl:hasIceSnowRemovalOrPreventionMeans ex:iceSnowMeans1 ;
    nltl:protectedItemCategory nltl:escapeRouteProtectedItem .

ex:protectedItem2 a nltl:protectedItem ;
    nltl:hasIceSnowRemovalOrPreventionMeans ex:iceSnowMeans2 ;
    nltl:protectedItemCategory nltl:musterStationProtectedItem .

ex:protectedItem3 a nltl:protectedItem ;
    nltl:hasIceSnowRemovalOrPreventionMeans ex:iceSnowMeans3 ;
    nltl:protectedItemCategory nltl:embarkationAreaProtectedItem .

ex:protectedItem4 a nltl:protectedItem ;
    nltl:hasIceSnowRemovalOrPreventionMeans ex:iceSnowMeans4 ;
    nltl:protectedItemCategory nltl:survivalCraftProtectedItem .

ex:protectedItem5 a nltl:protectedItem ;
    nltl:hasIceSnowRemovalOrPreventionMeans ex:iceSnowMeans5 ;
    nltl:protectedItemCategory nltl:launchingApplianceProtectedItem .

ex:protectedItem6 a nltl:protectedItem ;
    nltl:protectedItemCategory nltl:survivalCraftAccessProtectedItem .

