@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-h/IMO-078-H-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCrewMemberInventory ex:crew1,
        ex:crew2 ;
    nltl:hasPassenger ex:passenger1,
        ex:passenger2 .

ex:crew1 a nltl:crewMember ;
    nltl:personalAndGroupSurvivalEquipmentTrainingCompleted true .

ex:crew2 a nltl:crewMember ;
    nltl:personalAndGroupSurvivalEquipmentTrainingCompleted true .

ex:passenger1 a nltl:passenger ;
    nltl:personalSurvivalEquipmentInstructionCompleted true .

ex:passenger2 a nltl:passenger ;
    nltl:personalSurvivalEquipmentInstructionCompleted true .

