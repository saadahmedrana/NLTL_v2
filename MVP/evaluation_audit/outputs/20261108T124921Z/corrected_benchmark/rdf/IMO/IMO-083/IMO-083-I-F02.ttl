@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasRequiredNavigationOrCommunicationAntenna ex:antenna1,
        ex:antenna2 ;
    nltl:iceAccretionLikely true .

ex:antenna1 a nltl:navigationOrCommunicationAntenna ;
    nltl:antennaIceAccumulationPreventionPresent true .

ex:antenna2 a nltl:navigationOrCommunicationAntenna ;
    nltl:antennaIceAccumulationPreventionPresent false .

