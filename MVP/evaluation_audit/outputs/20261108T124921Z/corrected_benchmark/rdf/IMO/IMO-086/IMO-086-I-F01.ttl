@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-086-I-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasNonMagneticHeadingMeans ex:heading1 .

ex:heading1 a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToEmergencyPower ex:emergencyPowerSource ;
    nltl:connectedToMainPower ex:mainPowerSource .

