@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:colregSternLightArcComplianceStatus true ;
    nltl:icebreakerEscortOperation true ;
    nltl:lightVisibleFromAstern true ;
    nltl:manuallyInitiatedFlashingRedStoppedLightPresent true .

