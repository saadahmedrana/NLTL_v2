@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasOtherSurvivalCraft ex:other1 ;
    nltl:shipOperatesInLowAirTemperature true .

ex:onscene1 a nltl:onSceneCommunicationDevice .

ex:other1 a nltl:otherSurvivalCraft ;
    nltl:hasOnSceneCommunicationDevice ex:onscene1 .

