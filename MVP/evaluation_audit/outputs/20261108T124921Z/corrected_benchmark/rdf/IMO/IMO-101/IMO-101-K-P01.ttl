@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-101-K-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPolarRoutePlan ex:routePlan .

ex:routePlan a nltl:polarRoutePlan ;
    nltl:voyagePlanningTopicCoverage true .

