@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P18/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasCrewMemberInventory ex:crew ;
    nltl:iceConditionClassification nltl:openWaterIceCondition ;
    nltl:polarTrainingShipTypeClassification nltl:otherShipPolarTrainingType .

ex:crew a nltl:crewMember ;
    nltl:polarTrainingCrewRoleClassification nltl:officerInChargeOfNavigationalWatchPolarTrainingRole ;
    nltl:requiredTrainingLevel nltl:polarTrainingNotApplicable .

