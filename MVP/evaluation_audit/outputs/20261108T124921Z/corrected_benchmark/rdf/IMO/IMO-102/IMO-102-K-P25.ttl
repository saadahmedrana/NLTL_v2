@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-102-K-P25/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCrewMemberInventory ex:crew ;
    nltl:iceConditionClassification nltl:otherWatersIceCondition ;
    nltl:polarTrainingShipTypeClassification nltl:otherShipPolarTrainingType .

ex:crew a nltl:crewMember ;
    nltl:hasCrewTrainingRecord ex:trainingRecord ;
    nltl:hasPolarTrainingRecord ex:trainingRecord ;
    nltl:polarTrainingCrewRoleClassification nltl:masterPolarTrainingRole ;
    nltl:requiredTrainingLevel nltl:advancedPolarTrainingLevel .

ex:trainingRecord a nltl:polarTrainingRecord ;
    nltl:stcwQualificationValid true ;
    nltl:trainingRecordLevel nltl:advancedPolarTrainingLevel .

