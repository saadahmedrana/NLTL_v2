@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCrewMemberInventory ex:crew1 .

ex:crew1 a nltl:crewMember ;
    nltl:hasAssignedDuty ex:duty1 ;
    nltl:hasFamiliarizationRecord ex:record1 .

ex:duty1 a nltl:assignedDuty ;
    nltl:hasRelevantPolarWaterOperationalManualItem ex:item1 .

ex:item1 a nltl:polarWaterOperationalManualItem .

ex:otherItem1 a nltl:polarWaterOperationalManualItem ;
    nltl:polarWaterOperationalManualFamiliarizationStatus true .

ex:record1 a nltl:familiarizationRecord ;
    nltl:familiarizationRecordItem ex:otherItem1 .

