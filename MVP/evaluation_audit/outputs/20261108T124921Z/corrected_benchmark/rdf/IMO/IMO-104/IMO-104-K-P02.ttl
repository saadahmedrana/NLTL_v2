@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-104-K-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCrewMemberInventory ex:crew1,
        ex:crew2 .

ex:crew1 a nltl:crewMember ;
    nltl:hasAssignedDuty ex:duty1 ;
    nltl:hasFamiliarizationRecord ex:record1 .

ex:crew2 a nltl:crewMember ;
    nltl:hasAssignedDuty ex:duty2 ;
    nltl:hasFamiliarizationRecord ex:record2 .

ex:duty1 a nltl:assignedDuty ;
    nltl:hasRelevantPolarWaterOperationalManualItem ex:item1 .

ex:duty2 a nltl:assignedDuty ;
    nltl:hasRelevantPolarWaterOperationalManualItem ex:item2 .

ex:record1 a nltl:familiarizationRecord ;
    nltl:familiarizationRecordItem ex:item1 .

ex:record2 a nltl:familiarizationRecord ;
    nltl:familiarizationRecordItem ex:item2 .

ex:item1 a nltl:polarWaterOperationalManualItem ;
    nltl:polarWaterOperationalManualFamiliarizationStatus true .

ex:item2 a nltl:polarWaterOperationalManualItem ;
    nltl:polarWaterOperationalManualFamiliarizationStatus true .

