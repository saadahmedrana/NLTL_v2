@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-107-L-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:manualPolarCoverage false ;
    nltl:oilRecordBookPolarCoverage false ;
    nltl:polarOperationCoverage false ;
    nltl:pollutionEmergencyPlanPolarCoverage false ;
    nltl:shipOperatesInPolarWaters false .

