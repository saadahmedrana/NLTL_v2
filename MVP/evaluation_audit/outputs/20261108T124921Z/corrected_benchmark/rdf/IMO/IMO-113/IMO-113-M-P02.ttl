@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-113-M-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:cargoRecordBookPolarCoverage false ;
    nltl:manualPolarCoverage false ;
    nltl:noxiousLiquidSubstanceEmergencyPlanPolarCoverage false ;
    nltl:polarOperationCoverage false ;
    nltl:shipOperatesInPolarWaters false .

