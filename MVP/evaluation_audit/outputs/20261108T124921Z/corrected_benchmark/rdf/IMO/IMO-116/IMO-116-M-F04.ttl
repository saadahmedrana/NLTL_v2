@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-116-M-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:distanceFromAreaWithIceConcentrationAboveOneTenth ex:distanceFromAreaWithIceConcentrationAboveOneTenthValue ;
    nltl:marpolAnnexIvRegulation11Point1Point1ComplianceStatus true ;
    nltl:nearbyIceConcentration ex:nearbyIceConcentrationValue ;
    nltl:notComminutedOrDisinfected true ;
    nltl:sewageDischargeType "not comminuted"^^xsd:string .

ex:distanceFromAreaWithIceConcentrationAboveOneTenthValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MI_N .

ex:nearbyIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:UNITLESS .

