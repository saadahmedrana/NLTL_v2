@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasDischargeDistanceRecord ex:distanceRecord ;
    nltl:marpolAnnexIvRegulation11Point1Point2DischargeComplianceStatus false ;
    nltl:marpolAnnexIvRegulation9Point1Point1Or9Point2Point1CertificationStatus nltl:evidenceStateRejected ;
    nltl:marpolCertificationStatus nltl:evidenceStateRejected ;
    nltl:marpolDischargeStatus false ;
    nltl:sewageDischargeUsesTreatmentPlant false ;
    nltl:sewageTreatmentPlantApprovalStatus nltl:evidenceStateRejected .

ex:distanceRecord a nltl:dischargeDistanceRecords ;
    nltl:distanceToAreaWithIceConcentrationGreaterThanOneTenth ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue ;
    nltl:distanceToNearestLandIceShelfOrFastIce ex:distanceToNearestLandIceShelfOrFastIceValue .

ex:distanceToAreaWithIceConcentrationGreaterThanOneTenthValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MI_N .

ex:distanceToNearestLandIceShelfOrFastIceValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:MI_N .

