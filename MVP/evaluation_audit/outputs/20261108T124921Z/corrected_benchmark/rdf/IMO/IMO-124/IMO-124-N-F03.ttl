@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-124-N-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:antarcticArea "Antarctic area"^^xsd:string ;
    nltl:distanceToNearestFastIce ex:distanceToNearestFastIceValue ;
    nltl:foodWasteDischargeOntoIce false ;
    nltl:marpolAnnexVRegulation6Point1DischargeOccurs true ;
    nltl:nearbyIceConcentration ex:nearbyIceConcentrationValue ;
    nltl:operatingArea "Antarctic area"^^xsd:string .

ex:distanceToNearestFastIceValue a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MI_N .

ex:nearbyIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:UNITLESS .

