@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-007-A-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationApprovedEquivalentDepthSoundingDevicePresent false ;
    nltl:constructionDate "2026-01-01"^^xsd:date ;
    nltl:echoSoundingDeviceCount 0 ;
    nltl:independentEchoSoundingDeviceCount 2 ;
    nltl:independentTransducerCount 0 ;
    nltl:shipIceStrengthened true .

