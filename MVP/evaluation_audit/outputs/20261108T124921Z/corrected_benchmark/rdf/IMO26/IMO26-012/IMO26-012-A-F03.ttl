@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-012-A-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:grossTonnage ex:grossTonnageValue ;
    nltl:hasNonMagneticHeadingMeans ex:heading1,
        ex:heading2 .

ex:grossTonnageValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:UNITLESS .

ex:heading1 a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToMainPower ex:mainPowerSource ;
    nltl:independentFromHeadingMeans ex:heading2 .

ex:heading2 a nltl:nonMagneticHeadingMeans ;
    nltl:connectedToMainPower ex:mainPowerSource ;
    nltl:independentFromHeadingMeans ex:heading1 .

