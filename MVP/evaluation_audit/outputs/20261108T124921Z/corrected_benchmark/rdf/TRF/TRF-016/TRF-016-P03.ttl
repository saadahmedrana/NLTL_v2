@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-b/TRF-016-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:draughtAmidships ex:amid ;
    nltl:forwardDraught ex:forward ;
    nltl:hasBallastTank ex:ballastTank ;
    nltl:hasLowerIceWaterline ex:lower ;
    nltl:hasUpperIceWaterline ex:upper ;
    nltl:levelIceThickness ex:hi ;
    nltl:navigatingInIce true ;
    nltl:propellerHighestPointSubmerged true .

ex:amid a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:ballastTank a nltl:ballastTank ;
    nltl:freezingPreventionPresent false ;
    nltl:situatedAboveLowerIceWaterline true ;
    nltl:usedToReachLowerIceWaterline false .

ex:dui a qudt:QuantityValue ;
    qudt:numericValue 5000.0 ;
    qudt:unit unit:TON_Metric .

ex:forward a qudt:QuantityValue ;
    qudt:numericValue 2.6 ;
    qudt:unit unit:M .

ex:hi a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:M .

ex:liwlAmid a qudt:QuantityValue ;
    qudt:numericValue 3.8 ;
    qudt:unit unit:M .

ex:lower a nltl:iceWaterline ;
    nltl:liwlDraughtAmidships ex:liwlAmid .

ex:upper a nltl:iceWaterline ;
    nltl:displacementAtUpperIceWaterline ex:dui .

