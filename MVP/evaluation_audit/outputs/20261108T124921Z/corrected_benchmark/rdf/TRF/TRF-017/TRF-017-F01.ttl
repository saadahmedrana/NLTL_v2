@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-017-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:additionalPropulsionPower ex:additional ;
    nltl:maximumContinuousRatingPower ex:total ;
    nltl:propulsionMachineryContinuousOutput ex:continuous ;
    nltl:propulsionOutputRestrictionApplies false .

ex:additional a qudt:QuantityValue ;
    qudt:numericValue 800.0 ;
    qudt:unit unit:KiloW .

ex:continuous a qudt:QuantityValue ;
    qudt:numericValue 5000.0 ;
    qudt:unit unit:KiloW .

ex:total a qudt:QuantityValue ;
    qudt:numericValue 5000.0 ;
    qudt:unit unit:KiloW .

