@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-020-F08/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:brashIceChannelResistanceAtUpperIceWaterline ex:brashIceChannelResistanceAtUpperIceWaterline ;
    nltl:constructionStageDate "2021-01-01"^^xsd:date ;
    nltl:engineOutputCoefficientKe ex:engineOutputCoefficientKe ;
    nltl:hasLowerIceWaterline ex:lower ;
    nltl:hasUpperIceWaterline ex:upper ;
    nltl:iceClass nltl:iceClassIaSuper ;
    nltl:propellerCount 1 ;
    nltl:propellerDiameter ex:propellerDiameter ;
    nltl:propellerPitchControlType nltl:controllablePitch ;
    nltl:propulsionSystemType nltl:conventionalPropulsionSystem .

ex:brashIceChannelResistanceAtLowerIceWaterline a qudt:QuantityValue ;
    qudt:numericValue 110000.0 ;
    qudt:unit unit:N .

ex:brashIceChannelResistanceAtUpperIceWaterline a qudt:QuantityValue ;
    qudt:numericValue 125000.0 ;
    qudt:unit unit:N .

ex:engineOutputCoefficientKe a qudt:QuantityValue ;
    qudt:numericValue 2.03 ;
    qudt:unit unit:UNITLESS .

ex:lower a nltl:iceWaterline ;
    nltl:brashIceChannelResistanceAtLowerIceWaterline ex:brashIceChannelResistanceAtLowerIceWaterline ;
    nltl:minimumRequiredPowerAtLowerIceWaterline ex:minimumRequiredPowerAtLowerIceWaterline .

ex:minimumRequiredPowerAtLowerIceWaterline a qudt:QuantityValue ;
    qudt:numericValue 6200.0 ;
    qudt:unit unit:KiloW .

ex:minimumRequiredPowerAtUpperIceWaterline a qudt:QuantityValue ;
    qudt:numericValue 7400.0 ;
    qudt:unit unit:KiloW .

ex:propellerDiameter a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:upper a nltl:iceWaterline ;
    nltl:minimumRequiredPowerAtUpperIceWaterline ex:minimumRequiredPowerAtUpperIceWaterline ;
    nltl:upperIceWaterlineBreadth ex:upperIceWaterlineBreadth ;
    nltl:upperIceWaterlineLength ex:upperIceWaterlineLength .

ex:upperIceWaterlineBreadth a qudt:QuantityValue ;
    qudt:numericValue 25.0 ;
    qudt:unit unit:M .

ex:upperIceWaterlineLength a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:M .

