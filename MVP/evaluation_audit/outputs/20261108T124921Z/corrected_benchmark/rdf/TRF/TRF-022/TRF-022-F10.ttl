@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-022-F10/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bowRakeAtQuarterBreadth ex:bowRakeAtQuarterBreadth ;
    nltl:coefficientC3 ex:coefficientC3 ;
    nltl:coefficientC4 ex:coefficientC4 ;
    nltl:coefficientC5 ex:coefficientC5 ;
    nltl:coefficientF1 ex:coefficientF1 ;
    nltl:coefficientF2 ex:coefficientF2 ;
    nltl:coefficientF3 ex:coefficientF3 ;
    nltl:coefficientF4 ex:coefficientF4 ;
    nltl:coefficientG1 ex:coefficientG1 ;
    nltl:coefficientG2 ex:coefficientG2 ;
    nltl:coefficientG3 ex:coefficientG3 ;
    nltl:flareAngle ex:flareAngle ;
    nltl:iceClassDraught ex:iceClassDraught ;
    nltl:shipBreadth ex:shipBreadth ;
    nltl:shipLength ex:shipLength ;
    nltl:waterlineAngleAtQuarterBreadth ex:waterlineAngleAtQuarterBreadth .

ex:bowRakeAtQuarterBreadth a qudt:QuantityValue ;
    qudt:numericValue 30.0 ;
    qudt:unit unit:DEG .

ex:coefficientC3 a qudt:QuantityValue ;
    qudt:numericValue 845.0 ;
    qudt:unit nltl:kilogramPerSquareMetreSquareSecondUnit .

ex:coefficientC4 a qudt:QuantityValue ;
    qudt:numericValue 42.0 ;
    qudt:unit nltl:kilogramPerSquareMetreSquareSecondUnit .

ex:coefficientC5 a qudt:QuantityValue ;
    qudt:numericValue 825.0 ;
    qudt:unit nltl:kilogramPerSquareSecondUnit .

ex:coefficientF1 a qudt:QuantityValue ;
    qudt:numericValue 23.0 ;
    qudt:unit unit:N-PER-M2 .

ex:coefficientF2 a qudt:QuantityValue ;
    qudt:numericValue 45.8 ;
    qudt:unit unit:N-PER-M .

ex:coefficientF3 a qudt:QuantityValue ;
    qudt:numericValue 14.7 ;
    qudt:unit unit:N-PER-M .

ex:coefficientF4 a qudt:QuantityValue ;
    qudt:numericValue 29.0 ;
    qudt:unit unit:N-PER-M2 .

ex:coefficientG1 a qudt:QuantityValue ;
    qudt:numericValue 1530.0 ;
    qudt:unit unit:N .

ex:coefficientG2 a qudt:QuantityValue ;
    qudt:numericValue 170.0 ;
    qudt:unit unit:N-PER-M .

ex:coefficientG3 a qudt:QuantityValue ;
    qudt:numericValue 400.0 ;
    qudt:unit nltl:newtonPerMetreToPowerOnePointFiveUnit .

ex:flareAngle a qudt:QuantityValue ;
    qudt:numericValue 54.83574359157963 ;
    qudt:unit unit:DEG .

ex:iceClassDraught a qudt:QuantityValue ;
    qudt:numericValue 9.0 ;
    qudt:unit unit:M .

ex:shipBreadth a qudt:QuantityValue ;
    qudt:numericValue 25.0 ;
    qudt:unit unit:M .

ex:shipLength a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:M .

ex:waterlineAngleAtQuarterBreadth a qudt:QuantityValue ;
    qudt:numericValue 24.0 ;
    qudt:unit unit:DEG .

