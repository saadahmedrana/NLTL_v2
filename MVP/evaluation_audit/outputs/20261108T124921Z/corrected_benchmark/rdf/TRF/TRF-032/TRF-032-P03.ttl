@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-032-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:classificationSocietyRequiredScantling ex:societyScantling ;
    nltl:regulationRequiredScantling ex:regulationScantling ;
    nltl:selectedDesignScantling ex:selectedScantling .

ex:regulationScantling a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit ex:scantlingUnit .

ex:selectedScantling a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit ex:scantlingUnit .

ex:societyScantling a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit ex:scantlingUnit .

