@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-042-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:plating a nltl:plating ;
    nltl:designIceLoadHeight ex:designIceLoadHeightValue ;
    nltl:longitudinalPlatingFactorF2 ex:longitudinalPlatingFactorF2Value ;
    nltl:spacing ex:spacingValue .

ex:designIceLoadHeightValue a qudt:QuantityValue ;
    qudt:numericValue 0.72 ;
    qudt:unit unit:M .

ex:longitudinalPlatingFactorF2Value a qudt:QuantityValue ;
    qudt:numericValue 0.9199999999999999 ;
    qudt:unit unit:UNITLESS .

ex:spacingValue a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:M .

