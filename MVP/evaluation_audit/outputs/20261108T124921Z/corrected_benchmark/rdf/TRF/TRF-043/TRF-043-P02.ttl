@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-043-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasFramingIceStrengtheningTerminationCase ex:terminationCase .

ex:boundary a nltl:tankTop .

ex:extensionBeyondAdjacentDeckOrTankBoundaryValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:MilliM .

ex:terminationCase a nltl:framingIceStrengtheningTerminationCase ;
    nltl:extensionBeyondAdjacentDeckOrTankBoundary ex:extensionBeyondAdjacentDeckOrTankBoundaryValue ;
    nltl:iceStrengtheningTerminationAtAdjacentBoundaryPermitted true ;
    nltl:terminationAdjacentBoundary ex:boundary .

