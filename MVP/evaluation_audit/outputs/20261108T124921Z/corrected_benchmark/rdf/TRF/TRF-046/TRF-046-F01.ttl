@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-046-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:frame a nltl:frame,
        nltl:mainFrame,
        nltl:transverseFrame ;
    nltl:hasStrengthenedPart ex:strengthenedPart ;
    nltl:hasUpperEnd ex:upperEnd .

ex:strengthenedPart a nltl:frameStrengthenedPart .

