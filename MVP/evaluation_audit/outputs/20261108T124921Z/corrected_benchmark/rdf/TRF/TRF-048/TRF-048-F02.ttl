@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-048-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:longitudinalFrame a nltl:longitudinalFrame ;
    nltl:designIceLoadHeight ex:designIceLoadHeightValue ;
    nltl:frameBoundaryConditionType nltl:continuousBeamWithBracketsFrameCondition ;
    nltl:frameMomentFactorM ex:frameMomentFactorMValue ;
    nltl:icePressure ex:icePressureValue ;
    nltl:longitudinalFrameLoadDistributionFactorF4 ex:longitudinalFrameLoadDistributionFactorF4Value ;
    nltl:requiredShearArea ex:requiredShearAreaValue ;
    nltl:sectionModulus ex:sectionModulusValue ;
    nltl:significantlyDifferentBoundaryConditions false ;
    nltl:spacing ex:spacingValue ;
    nltl:span ex:spanValue ;
    nltl:yieldStrength ex:yieldStrengthValue .

ex:designIceLoadHeightValue a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

ex:frameMomentFactorMValue a qudt:QuantityValue ;
    qudt:numericValue 13.3 ;
    qudt:unit unit:UNITLESS .

ex:icePressureValue a qudt:QuantityValue ;
    qudt:numericValue 1.1 ;
    qudt:unit unit:MegaPA .

ex:longitudinalFrameLoadDistributionFactorF4Value a qudt:QuantityValue ;
    qudt:numericValue 0.1 ;
    qudt:unit unit:UNITLESS .

ex:requiredShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 82.74485785639473 ;
    qudt:unit unit:CentiM2 .

ex:sectionModulusValue a qudt:QuantityValue ;
    qudt:numericValue 291.013437849944 ;
    qudt:unit unit:CentiM3 .

ex:spacingValue a qudt:QuantityValue ;
    qudt:numericValue 0.6 ;
    qudt:unit unit:M .

ex:spanValue a qudt:QuantityValue ;
    qudt:numericValue 3.5 ;
    qudt:unit unit:M .

ex:yieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

