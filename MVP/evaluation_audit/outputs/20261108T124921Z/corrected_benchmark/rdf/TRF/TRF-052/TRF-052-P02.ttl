@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-052-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame ;
    nltl:antitrippingSupportSpacing ex:antitrippingSupportSpacingValue ;
    nltl:equivalentSupportStatusByDirectCalculation false ;
    nltl:frameAsymmetrical false ;
    nltl:frameSpan ex:frameSpanValue ;
    nltl:frameWebAngleToShell ex:frameWebAngleToShellValue ;
    nltl:hasAntitrippingSupportRegion nltl:bowRegion,
        nltl:midbodyRegion,
        nltl:sternRegion ;
    nltl:iceClass nltl:iceClassIaSuper .

ex:antitrippingSupportSpacingValue a qudt:QuantityValue ;
    qudt:numericValue 1300.0 ;
    qudt:unit unit:MilliM .

ex:frameSpanValue a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:M .

ex:frameWebAngleToShellValue a qudt:QuantityValue ;
    qudt:numericValue 89.0 ;
    qudt:unit unit:DEG .

