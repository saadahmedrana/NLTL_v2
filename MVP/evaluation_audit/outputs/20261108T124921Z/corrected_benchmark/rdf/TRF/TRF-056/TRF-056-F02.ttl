@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-056-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasWeatherdeckHatch ex:hatch ;
    nltl:shipBreadth ex:shipBreadthValue .

ex:fittingEvidence a nltl:hatchFittingDesignEvidence .

ex:hatch a nltl:weatherdeckHatch ;
    nltl:hasHatchFittingDesignEvidence ex:fittingEvidence ;
    nltl:hatchOpeningLength ex:hatchOpeningLengthValue ;
    nltl:shipSideDeflection ex:shipSideDeflectionValue .

ex:hatchOpeningLengthValue a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:M .

ex:shipBreadthValue a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:M .

ex:shipSideDeflectionValue a qudt:QuantityValue ;
    qudt:numericValue 0.02 ;
    qudt:unit unit:M .

