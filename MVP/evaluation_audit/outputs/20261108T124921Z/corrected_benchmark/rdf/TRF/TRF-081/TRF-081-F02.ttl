@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-081-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:backwardBladeForce ex:backwardBladeForceValue ;
    nltl:backwardIceThrust ex:backwardIceThrustValue ;
    nltl:backwardPropellerShaftDesignThrust ex:backwardPropellerShaftDesignThrustValue ;
    nltl:forwardBladeForce ex:forwardBladeForceValue ;
    nltl:forwardPropellerShaftDesignThrust ex:forwardPropellerShaftDesignThrustValue ;
    nltl:hydrodynamicBollardThrust ex:hydrodynamicBollardThrustValue ;
    nltl:propellerShaftDesignThrust ex:propellerShaftDesignThrustValue .

ex:backwardBladeForceValue a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:KiloN .

ex:backwardIceThrustValue a qudt:QuantityValue ;
    qudt:numericValue 132.0 ;
    qudt:unit unit:KiloN .

ex:backwardPropellerShaftDesignThrustValue a qudt:QuantityValue ;
    qudt:numericValue 198.0 ;
    qudt:unit unit:KiloN .

ex:forwardBladeForceValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

ex:forwardPropellerShaftDesignThrustValue a qudt:QuantityValue ;
    qudt:numericValue 292.00000000000006 ;
    qudt:unit unit:KiloN .

ex:hydrodynamicBollardThrustValue a qudt:QuantityValue ;
    qudt:numericValue 50.0 ;
    qudt:unit unit:KiloN .

ex:propellerShaftDesignThrustValue a qudt:QuantityValue ;
    qudt:numericValue 292.00000000000006 ;
    qudt:unit unit:KiloN .

