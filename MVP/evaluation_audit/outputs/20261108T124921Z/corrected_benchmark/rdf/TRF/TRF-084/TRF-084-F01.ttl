@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-084-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:pitchValueKnown false ;
    nltl:propellerPitchAtMcrBollard ex:propellerPitchAtMcrBollardValue ;
    nltl:propellerPitchAtMcrFreeRunning ex:propellerPitchAtMcrFreeRunningValue ;
    nltl:propellerType "CP"^^xsd:string .

ex:propellerPitchAtMcrBollardValue a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:M .

ex:propellerPitchAtMcrFreeRunningValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

