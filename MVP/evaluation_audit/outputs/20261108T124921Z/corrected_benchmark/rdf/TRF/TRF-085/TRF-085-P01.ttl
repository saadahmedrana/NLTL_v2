@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-085-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:propellerDiameter ex:propellerDiameterValue ;
    nltl:propellerRotationalSpeedAtMaximumContinuousRatingBollard ex:propellerRotationalSpeedAtMaximumContinuousRatingBollardValue .

ex:propellerDiameterValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:propellerRotationalSpeedAtMaximumContinuousRatingBollardValue a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:REV-PER-MIN .

