@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-104-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:pyramidStrengthPrinciple "blade loss shall not significantly damage other shaft-line components"^^xsd:string .

