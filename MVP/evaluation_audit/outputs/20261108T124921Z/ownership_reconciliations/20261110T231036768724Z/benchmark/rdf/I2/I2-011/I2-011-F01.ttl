@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-d/I2-011-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bowDesignForce ex:design ;
    nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ex:fiii ;
    nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ex:fiv ;
    nltl:bulbousBowPresent true ;
    nltl:loadPatchAspectRatio ex:ar ;
    nltl:polarClass nltl:polarClassPc6 ;
    nltl:shapeCoefficient ex:fa .

ex:ar a qudt:QuantityValue ;
    qudt:numericValue 1.3 ;
    qudt:unit unit:UNITLESS .

ex:design a qudt:QuantityValue ;
    qudt:numericValue 5000.0 ;
    qudt:unit unit:KiloN .

ex:fa a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:UNITLESS .

ex:fiii a qudt:QuantityValue ;
    qudt:numericValue 4.0 ;
    qudt:unit unit:MegaN .

ex:fiv a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:MegaN .

