@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-f/I2-026-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:member a nltl:framingMember,
        nltl:structuralMember ;
    nltl:continuousThroughSupport false ;
    nltl:hasMemberSupport ex:support ;
    nltl:terminatesWithinIceStrengthenedArea false .

ex:support a nltl:memberSupport ;
    nltl:connectionBracketPresent false ;
    nltl:demonstratedRotationalRestraint false ;
    nltl:frameSupportCondition nltl:fixedFrameSupport .

