@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-a/I2-029-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCalculationCase ex:case .

ex:case a nltl:calculationCase ;
    nltl:attachedShellPlatingExcludedFromShearArea true ;
    nltl:attachedShellPlatingIncludedInSectionModulus false ;
    nltl:flangeMaterialIncludedInShearArea false ;
    nltl:sectionCalculationCaseStructuralMember ex:member .

ex:member a nltl:structuralMember ;
    nltl:flangeFitted true .

