@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-f/I2-030-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCalculationCase ex:calc .

ex:afn a qudt:QuantityValue ;
    qudt:numericValue 60.0 ;
    qudt:unit unit:CentiM2 .

ex:bw a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:MilliM .

ex:hfc a qudt:QuantityValue ;
    qudt:numericValue 330.0 ;
    qudt:unit unit:MilliM .

ex:hiCoord a qudt:QuantityValue ;
    qudt:numericValue 70.0 ;
    qudt:unit unit:UNITLESS .

ex:hiResult a qudt:QuantityValue ;
    qudt:numericValue 520.0 ;
    qudt:unit unit:CentiM3 .

ex:hw a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:MilliM .

ex:loCoord a qudt:QuantityValue ;
    qudt:numericValue 20.0 ;
    qudt:unit unit:UNITLESS .

ex:loResult a qudt:QuantityValue ;
    qudt:numericValue 450.0 ;
    qudt:unit unit:CentiM3 .

ex:lower a nltl:interpolationPoint ;
    nltl:interpolationPointCoordinate ex:loCoord ;
    nltl:interpolationPointResult ex:loResult .

ex:member a nltl:structuralMember ;
    nltl:frameSpacing ex:spacing ;
    nltl:hasLocalFrameSectionCalculationCase ex:calc ;
    nltl:localFrameFlangeCentreHeight ex:hfc ;
    nltl:netAttachedShellPlateThickness ex:tpn ;
    nltl:netEffectivePlasticSectionModulus ex:zp ;
    nltl:netLocalFrameFlangeArea ex:afn ;
    nltl:netWebThickness ex:twn ;
    nltl:webAngleToShellPlate ex:phi ;
    nltl:webHeight ex:hw ;
    nltl:webToFlangeCentreDistance ex:bw .

ex:omega a qudt:QuantityValue ;
    qudt:numericValue 45.0 ;
    qudt:unit unit:DEG .

ex:phi a qudt:QuantityValue ;
    qudt:numericValue 90.0 ;
    qudt:unit unit:DEG .

ex:plating a nltl:plating ;
    nltl:framingAngleOmega ex:omega .

ex:spacing a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:tpn a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

ex:twn a qudt:QuantityValue ;
    qudt:numericValue 12.0 ;
    qudt:unit unit:MilliM .

ex:upper a nltl:interpolationPoint ;
    nltl:interpolationPointCoordinate ex:hiCoord ;
    nltl:interpolationPointResult ex:hiResult .

ex:zna a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:MilliM .

ex:zp a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:CentiM3 .

ex:calc a nltl:calculationCase,
        nltl:localFrameSectionCalculationCase ;
    nltl:interpolationLowerEndpoint ex:lower ;
    nltl:interpolationUpperEndpoint ex:upper ;
    nltl:plasticNeutralAxisHeight ex:zna ;
    nltl:sectionCalculationCasePlating ex:plating ;
    nltl:sectionCalculationCaseStructuralMember ex:member .

