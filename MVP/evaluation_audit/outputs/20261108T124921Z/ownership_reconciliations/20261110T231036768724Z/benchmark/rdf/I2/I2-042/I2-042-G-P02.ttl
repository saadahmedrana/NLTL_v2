@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-g/I2-042-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:bf a qudt:QuantityValue ;
    qudt:numericValue 55.0 ;
    qudt:unit unit:MilliM .

ex:member a nltl:structuralMember ;
    nltl:flangeWidth ex:bf ;
    nltl:netWebThickness ex:twn .

ex:twn a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:MilliM .

