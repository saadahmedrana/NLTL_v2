@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-062-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasStructuralMember ex:member .

ex:grillage a nltl:grillageSystem .

ex:member a nltl:structuralMember,
        nltl:webFrame ;
    nltl:directCalculationUsed false ;
    nltl:partOfGrillageSystem ex:grillage .

