@prefix ex: <https://w3id.org/nltl/benchmark/i2-batch-c/I2-064-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasCalculationCase ex:calculation ;
    nltl:hasStructuralMember ex:member .

ex:calculation a nltl:calculationCase ;
    nltl:calculationMethod nltl:linearCalculationMethodValue .

ex:flange a nltl:structuralMemberFlange ;
    nltl:nominalFlangeVonMisesStress ex:nominalFlangeVonMisesStress .

ex:member a nltl:hullStructure,
        nltl:structuralMember ;
    nltl:bucklingCriteriaSatisfied true ;
    nltl:hasStructuralMemberFlange ex:flange ;
    nltl:hasStructuralMemberWeb ex:web ;
    nltl:yieldStrength ex:yieldStrength .

ex:nominalFlangeVonMisesStress a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:MegaPA .

ex:web a nltl:structuralMemberWeb .

ex:yieldStrength a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

