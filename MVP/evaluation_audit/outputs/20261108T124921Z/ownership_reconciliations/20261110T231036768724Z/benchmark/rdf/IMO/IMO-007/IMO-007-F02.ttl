@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:iceConditionClassification nltl:openWaterIceCondition ;
    nltl:iceOfLandOriginPresent true ;
    nltl:seaIceConcentration ex:seaIceConcentrationValue .

ex:seaIceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:UNITLESS .

