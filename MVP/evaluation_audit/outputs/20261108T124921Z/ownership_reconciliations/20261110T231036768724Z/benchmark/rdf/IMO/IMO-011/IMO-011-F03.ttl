@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:dataPeriod ex:dataPeriodValue ;
    nltl:hasDailyLowTemperatureObservation ex:obs1 .

ex:dailyLowTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue -25.0 ;
    qudt:unit unit:DEG_C .

ex:dataPeriodValue a qudt:QuantityValue ;
    qudt:numericValue 10.0 ;
    qudt:unit unit:YR .

ex:obs1 a nltl:dailyLowTemperatureObservation ;
    nltl:dailyLowTemperature ex:dailyLowTemperatureValue ;
    nltl:dailyTemperatureObservationDate "2025-01-15"^^xsd:date .

