@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-016-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPolarShipCertificate ex:certificate .

ex:certificate a nltl:polarShipCertificateForm ;
    nltl:approvedTranslationPresent true ;
    nltl:certificateFormModel nltl:appendixIPolarShipCertificateModel ;
    nltl:certificateLanguage "German"^^xsd:string .

