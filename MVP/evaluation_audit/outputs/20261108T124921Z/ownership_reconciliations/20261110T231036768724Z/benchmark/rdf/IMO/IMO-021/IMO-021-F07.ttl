@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-021-F07/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:assessedAbandonment true ;
    nltl:assessedAdditionalHazards true ;
    nltl:assessedCodeHazards true ;
    nltl:assessedHighLatitude true ;
    nltl:assessedIceOperation true ;
    nltl:operationalAssessmentPresent true .

