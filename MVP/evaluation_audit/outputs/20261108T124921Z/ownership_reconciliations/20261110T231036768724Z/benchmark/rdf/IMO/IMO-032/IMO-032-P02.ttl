@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-032-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasApprovalRecord ex:approvalRecord ;
    nltl:shipCategory nltl:polarShipCategoryB ;
    nltl:shipIceStrengthened true .

ex:approvalRecord a nltl:approvalRecord ;
    nltl:approvalStandard "another standard offering an equivalent level of safety"^^xsd:string ;
    nltl:approvingAuthority "recognized organization accepted by the Administration"^^xsd:string ;
    nltl:scantlingApprovalStatus nltl:evidenceStateApproved .

