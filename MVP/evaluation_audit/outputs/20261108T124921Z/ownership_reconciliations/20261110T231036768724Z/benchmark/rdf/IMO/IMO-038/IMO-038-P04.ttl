@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-038-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:damageCenterForwardOfMaxBreadth false ;
    nltl:longitudinalDamageExtent ex:longitudinalDamageExtentValue ;
    nltl:selectedVerticalDamagePosition ex:selectedVerticalDamagePositionValue ;
    nltl:transversePenetration ex:transversePenetrationValue ;
    nltl:upperIceWaterlineDraught ex:upperIceWaterlineDraughtValue ;
    nltl:upperIceWaterlineLength ex:upperIceWaterlineLengthValue ;
    nltl:verticalDamageExtent ex:verticalDamageExtentValue .

ex:longitudinalDamageExtentValue a qudt:QuantityValue ;
    qudt:numericValue 4.5 ;
    qudt:unit unit:M .

ex:selectedVerticalDamagePositionValue a qudt:QuantityValue ;
    qudt:numericValue 3.0 ;
    qudt:unit unit:M .

ex:transversePenetrationValue a qudt:QuantityValue ;
    qudt:numericValue 760.0 ;
    qudt:unit unit:MilliM .

ex:upperIceWaterlineDraughtValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:M .

ex:upperIceWaterlineLengthValue a qudt:QuantityValue ;
    qudt:numericValue 300.0 ;
    qudt:unit unit:M .

ex:verticalDamageExtentValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

