@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-043-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasMachineryInstallation ex:auxMachinery,
        ex:mainMachinery .

ex:auxMachinery a nltl:machineryInstallationItem ;
    nltl:hasApplicableHazard nltl:iceAccretionHazard,
        nltl:liquidFreezingOrViscosityIncreaseHazard,
        nltl:seawaterIceIngestionHazard,
        nltl:seawaterIntakeTemperatureHazard,
        nltl:snowAccumulationHazard ;
    nltl:hasAssociatedEquipment ex:auxMachineryEquipment ;
    nltl:hasHazardProtectionEvidence ex:auxMachineryEvidence ;
    nltl:machineryInstallation "auxMachinery"^^xsd:string .

ex:auxMachineryEquipment a nltl:associatedEquipmentItem .

ex:auxMachineryEvidence a nltl:evidenceArtifact ;
    nltl:hazardProtectionCoverage true .

ex:mainMachinery a nltl:machineryInstallationItem ;
    nltl:hasApplicableHazard nltl:iceAccretionHazard,
        nltl:liquidFreezingOrViscosityIncreaseHazard,
        nltl:seawaterIceIngestionHazard,
        nltl:seawaterIntakeTemperatureHazard,
        nltl:snowAccumulationHazard,
        nltl:snowIngestionHazard ;
    nltl:hasAssociatedEquipment ex:mainMachineryEquipment ;
    nltl:hasHazardProtectionEvidence ex:mainMachineryEvidence ;
    nltl:machineryInstallation "mainMachinery"^^xsd:string .

ex:mainMachineryEquipment a nltl:associatedEquipmentItem .

ex:mainMachineryEvidence a nltl:evidenceArtifact ;
    nltl:hazardProtectionCoverage true .

