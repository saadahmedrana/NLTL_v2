@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:ship a nltl:ship ;
    nltl:hasIceOrSnowRemovalOrPreventionMeans ex:access1Means ;
    nltl:hasRequiredAccessItem ex:access1 .

ex:access1 a nltl:requiredAccessItem .

ex:access1Means a nltl:iceSnowRemovalOrPreventionMeans .

