@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:continuouslyAccessible true ;
    nltl:iceAccretionProtectionPresent true ;
    nltl:valveExposed true ;
    nltl:valveType "pressure"^^xsd:string .

