@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-055-P04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:continuouslyAccessible false ;
    nltl:iceAccretionProtectionPresent false ;
    nltl:valveExposed false ;
    nltl:valveType "isolating"^^xsd:string .

