@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-057-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasComponent ex:fire .

ex:fire a nltl:firePump ;
    nltl:hasContainingCompartment ex:fireCompartment .

ex:fireCompartment a nltl:compartment ;
    nltl:maintainedTemperature ex:fireMaintainedTemperatureValue .

ex:fireMaintainedTemperatureValue a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:K .

