@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-058-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasExposedFireMainSection ex:section1 .

ex:section1 a nltl:exposedFireMainSectionItem ;
    nltl:drainageMeansPresent true ;
    nltl:isolationCapability true .

