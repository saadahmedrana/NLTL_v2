@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-070-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:passengerShip,
        nltl:ship ;
    nltl:hasPersonOnBoardMember ex:person1,
        ex:person2 .

ex:person1 a nltl:personOnBoardMember ;
    nltl:hasPersonalSurvivalEquipmentAssignment ex:person1Assignment1 .

ex:person1Assignment1 a nltl:personalSurvivalEquipmentAssignment ;
    nltl:assignedPersonalSurvivalEquipment ex:person1Equipment1 .

ex:person1Equipment1 a nltl:immersionSuitEquipment ;
    nltl:sizeCompatibilityStatus true .

ex:person2 a nltl:personOnBoardMember ;
    nltl:hasPersonalSurvivalEquipmentAssignment ex:person2Assignment1 .

ex:person2Assignment1 a nltl:personalSurvivalEquipmentAssignment ;
    nltl:assignedPersonalSurvivalEquipment ex:person2Equipment1 .

ex:person2Equipment1 a nltl:thermalProtectiveAidEquipment ;
    nltl:sizeCompatibilityStatus false .

