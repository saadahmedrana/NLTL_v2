@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-081-I-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:echoSoundingDeviceCount 0 ;
    nltl:independentEchoSoundingDeviceCount 2 ;
    nltl:independentTransducerCount 0 .

