@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-097-J-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasRequiredRescueBoatOrLifeboat ex:craft1 ;
    nltl:hasSurvivalCraft ex:craft1 ;
    nltl:shipOperatesInLowAirTemperature true .

ex:distress1 a nltl:shipToShoreDistressAlertDevice .

ex:location1 a nltl:locationSignalDevice .

ex:onscene1 a nltl:onSceneCommunicationDevice .

ex:craft1 a nltl:survivalCraft ;
    nltl:survivalCraftHasLocationSignalDevice ex:location1 ;
    nltl:survivalCraftHasOnSceneCommunicationDevice ex:onscene1 ;
    nltl:survivalCraftHasShipToShoreDistressAlertDevice ex:distress1 .

