@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-100-K-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:identifiedIntendedVoyageHazard "ice"^^xsd:string ;
    nltl:voyagePlanHazardCoverage true ;
    nltl:voyagePlanPresent false .

