@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-k/IMO-103-K-F05/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationPermissionStatus true ;
    nltl:advancedPolarTrainingStatus true ;
    nltl:alternateQualifiedPersonUsed true ;
    nltl:designatedOfficerBasicTrainingStatus true ;
    nltl:iceConcentration ex:iceConcentrationValue ;
    nltl:iceCondition "other waters"^^xsd:string ;
    nltl:restComplianceStatus true ;
    nltl:shipType "passenger ship"^^xsd:string ;
    nltl:stcwCodeSectionAIi2ComplianceStatus true ;
    nltl:stcwConventionRegulationIi2ComplianceStatus true ;
    nltl:watchCoverageStatus false .

ex:iceConcentrationValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

