@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-l/IMO-111-L-P06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:individualTankCapacity ex:individualTankCapacityValue ;
    nltl:shipCategory nltl:polarShipCategoryC ;
    nltl:tankOuterShellSeparation ex:tankOuterShellSeparationValue ;
    nltl:tankType "oil residue tank"^^xsd:string .

ex:individualTankCapacityValue a qudt:QuantityValue ;
    qudt:numericValue 31.0 ;
    qudt:unit unit:M3 .

ex:tankOuterShellSeparationValue a qudt:QuantityValue ;
    qudt:numericValue 0.0 ;
    qudt:unit unit:M .

