@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-114-M-P06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:administrationCarriageApprovalStatus nltl:evidenceStateRejected ;
    nltl:applicableCertificatePolarOperationEntryPresent false ;
    nltl:cargoTankType "2"^^xsd:string ;
    nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank true ;
    nltl:constructionDate "2017-01-01"^^xsd:date ;
    nltl:shipCategory nltl:polarShipCategoryA .

