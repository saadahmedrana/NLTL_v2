@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:garbageManagementPlanPolarCoverage true ;
    nltl:garbagePlacardPolarCoverage false ;
    nltl:garbageRecordBookPolarCoverage true ;
    nltl:polarOperationCoverage true ;
    nltl:shipOperatesInPolarWaters true .

