@prefix ex: <https://w3id.org/nltl/benchmark/imo-batch-n/IMO-125-N-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:garbageManagementPlanPolarCoverage false ;
    nltl:garbagePlacardPolarCoverage false ;
    nltl:garbageRecordBookPolarCoverage false ;
    nltl:polarOperationCoverage false ;
    nltl:shipOperatesInPolarWaters false .

