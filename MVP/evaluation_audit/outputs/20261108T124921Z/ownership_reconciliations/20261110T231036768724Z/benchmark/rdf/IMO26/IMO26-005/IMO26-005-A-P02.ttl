@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-a/IMO26-005-A-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:headingOrPositionSystem "heading_reference"^^xsd:string,
        "position_fixing"^^xsd:string ;
    nltl:intendedAreaSuitabilityApprovalStatus nltl:evidenceStateApproved .

