@prefix ex: <https://w3id.org/nltl/benchmark/imo26-batch-b/IMO26-017-B-P01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:intendedVoyageHazard "ice"^^xsd:string,
        "remoteness"^^xsd:string ;
    nltl:polarCodeChapter11Dash1Applicable true ;
    nltl:voyagePlanCoverage true ;
    nltl:voyagePlanPresent true .

