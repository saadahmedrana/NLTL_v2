@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-023-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:applicableIceClassRegulationEdition nltl:iceClassRuleEdition1985 ;
    nltl:iceClass nltl:iceClassIc ;
    nltl:maximumContinuousRatingPower ex:mcr ;
    nltl:requiredPowerUnder1985Rules ex:legacyRequired .

ex:legacyRequired a qudt:QuantityValue ;
    qudt:numericValue 700.0 ;
    qudt:unit unit:KiloW .

ex:mcr a qudt:QuantityValue ;
    qudt:numericValue 740.0 ;
    qudt:unit unit:KiloW .

