@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-027-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:clampedHullGeometryTerm ex:clampedHullGeometryTerm ;
    nltl:constructionStageDate "1995-01-01"^^xsd:date ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:iceClassDraught ex:iceClassDraught ;
    nltl:shipBreadth ex:shipBreadth ;
    nltl:shipLength ex:shipLength .

ex:clampedHullGeometryTerm a qudt:QuantityValue ;
    qudt:numericValue 5.0 ;
    qudt:unit unit:UNITLESS .

ex:iceClassDraught a qudt:QuantityValue ;
    qudt:numericValue 9.0 ;
    qudt:unit unit:M .

ex:shipBreadth a qudt:QuantityValue ;
    qudt:numericValue 25.0 ;
    qudt:unit unit:M .

ex:shipLength a qudt:QuantityValue ;
    qudt:numericValue 118.74832963032617 ;
    qudt:unit unit:M .

