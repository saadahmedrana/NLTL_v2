@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-c/TRF-028-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:calculationEvidence a nltl:alternativeCalculationEvidence .

ex:ship a nltl:ship ;
    nltl:approvalRevocationStatus nltl:evidenceStateApproved ;
    nltl:approvalStatus true .

