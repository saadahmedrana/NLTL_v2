@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-031-F06/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:beamTheoryUsed false ;
    nltl:combinedBendingShearStress ex:combinedStress ;
    nltl:vonMisesYieldCriterion "von Mises yield criterion"^^xsd:string ;
    nltl:yieldShearStress ex:yieldShear .

ex:combinedStress a qudt:QuantityValue ;
    qudt:numericValue 200.0 ;
    qudt:unit unit:MegaPA .

ex:yieldShear a qudt:QuantityValue ;
    qudt:numericValue 135.67731325956206 ;
    qudt:unit unit:MegaPA .

