@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-034-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:member a nltl:iceStringer ;
    nltl:hasEffectiveMemberCrossSection ex:effectiveSection .

ex:ship a nltl:ship .

ex:effectiveSection a nltl:effectiveMemberCrossSection ;
    nltl:memberNormalToPlating true ;
    nltl:shearArea ex:shearArea .

ex:shearArea a qudt:QuantityValue ;
    qudt:numericValue 0.02 ;
    qudt:unit unit:M2 .

