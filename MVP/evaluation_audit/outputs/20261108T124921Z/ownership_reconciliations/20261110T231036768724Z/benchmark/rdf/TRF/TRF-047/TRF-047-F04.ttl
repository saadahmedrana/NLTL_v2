@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:frame a nltl:frame,
        nltl:intermediateIceFrame,
        nltl:transverseFrame ;
    nltl:hasHorizontalConnectionMember ex:horizontalMember ;
    nltl:hasLowerEnd ex:lowerEnd ;
    nltl:hasStrengthenedPart ex:strengthenedPart ;
    nltl:hasTerminationBelowSupportingStructure ex:support .

ex:adjacentMainFrame a nltl:mainFrame ;
    nltl:mainFrameBelowIceBeltStrengthened false .

ex:horizontalMember a nltl:horizontalConnectionMember ;
    nltl:connectsToAdjacentMainFrame ex:adjacentMainFrame ;
    nltl:sameScantlingsAsMainFrame true .

ex:strengthenedPart a nltl:frameStrengthenedPart .

ex:support a nltl:tankTop ;
    nltl:supportingStructureAtOrBelowIceBeltLowerLimit true .

