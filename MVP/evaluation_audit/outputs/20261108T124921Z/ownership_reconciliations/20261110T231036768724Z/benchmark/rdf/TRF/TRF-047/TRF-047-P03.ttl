@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-e/TRF-047-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

ex:frame a nltl:frame,
        nltl:mainFrame,
        nltl:transverseFrame ;
    nltl:hasAttachedSupportingStructure ex:support ;
    nltl:hasLowerEnd ex:lowerEnd ;
    nltl:hasStrengthenedPart ex:strengthenedPart .

ex:strengthenedPart a nltl:frameStrengthenedPart .

ex:support a nltl:iceStringer .

