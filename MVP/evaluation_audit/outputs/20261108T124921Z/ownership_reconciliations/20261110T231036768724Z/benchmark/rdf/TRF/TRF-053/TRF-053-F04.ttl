@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-053-F04/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:iceStringer a nltl:iceStringer ;
    nltl:designIceLoadHeight ex:designIceLoadHeightValue ;
    nltl:designLineLoad ex:designLineLoadValue ;
    nltl:frameMomentFactorM ex:frameMomentFactorMValue ;
    nltl:icePressure ex:icePressureValue ;
    nltl:requiredShearArea ex:requiredShearAreaValue ;
    nltl:sectionModulus ex:sectionModulusValue ;
    nltl:yieldStrength ex:yieldStrengthValue .

ex:designIceLoadHeightValue a qudt:QuantityValue ;
    qudt:numericValue 0.35 ;
    qudt:unit unit:M .

ex:designLineLoadValue a qudt:QuantityValue ;
    qudt:numericValue 279.99999999999994 ;
    qudt:unit unit:KiloN-PER-M .

ex:frameMomentFactorMValue a qudt:QuantityValue ;
    qudt:numericValue 13.3 ;
    qudt:unit unit:UNITLESS .

ex:icePressureValue a qudt:QuantityValue ;
    qudt:numericValue 0.8 ;
    qudt:unit unit:MegaPA .

ex:requiredShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 60.178078441014335 ;
    qudt:unit unit:CentiM2 .

ex:sectionModulusValue a qudt:QuantityValue ;
    qudt:numericValue 1306.1590145576706 ;
    qudt:unit unit:CentiM3 .

ex:yieldStrengthValue a qudt:QuantityValue ;
    qudt:numericValue 235.0 ;
    qudt:unit unit:MegaPA .

