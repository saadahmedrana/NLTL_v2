@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-055-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:narrowDeckStrip a nltl:narrowDeckStrip ;
    nltl:abreastOfHatch true ;
    nltl:actualSectionModulus ex:actualSectionModulusValue ;
    nltl:actualShearArea ex:actualShearAreaValue ;
    nltl:permittedReducedLineLoad ex:permittedReducedLineLoadValue ;
    nltl:reducedLineLoadApprovedByClassificationSociety true ;
    nltl:requiredSectionModulus ex:requiredSectionModulusValue ;
    nltl:requiredShearArea ex:requiredShearAreaValue ;
    nltl:servesAsIceStringer true ;
    nltl:veryLongHatchOpening true .

ex:actualSectionModulusValue a qudt:QuantityValue ;
    qudt:numericValue 1200.0 ;
    qudt:unit unit:CentiM3 .

ex:actualShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 150.0 ;
    qudt:unit unit:CentiM2 .

ex:permittedReducedLineLoadValue a qudt:QuantityValue ;
    qudt:numericValue 99.0 ;
    qudt:unit unit:KiloN-PER-M .

ex:requiredSectionModulusValue a qudt:QuantityValue ;
    qudt:numericValue 1000.0 ;
    qudt:unit unit:CentiM3 .

ex:requiredShearAreaValue a qudt:QuantityValue ;
    qudt:numericValue 120.0 ;
    qudt:unit unit:CentiM2 .

