@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-057-P03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:webFrame a nltl:webFrame ;
    nltl:iceLoadHeight ex:iceLoadHeightValue ;
    nltl:icePressure ex:icePressureValue ;
    nltl:webFrameIceLoad ex:webFrameIceLoadValue ;
    nltl:webFrameSpacing ex:webFrameSpacingValue .

ex:iceLoadHeightValue a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

ex:icePressureValue a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:MegaPA .

ex:webFrameIceLoadValue a qudt:QuantityValue ;
    qudt:numericValue 540.0 ;
    qudt:unit unit:KiloN .

ex:webFrameSpacingValue a qudt:QuantityValue ;
    qudt:numericValue 2.0 ;
    qudt:unit unit:M .

