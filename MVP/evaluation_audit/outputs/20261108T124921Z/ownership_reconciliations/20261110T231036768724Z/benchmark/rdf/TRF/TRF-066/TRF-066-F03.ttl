@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasRudderProtectionArrangement ex:arrangement ;
    nltl:iceClass nltl:iceClassIa ;
    nltl:iceKnifePracticable true .

ex:arrangement a nltl:rudderProtectionArrangement .

