@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-074-F03/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:ballastConditionPropellerTopDepth ex:ballastConditionPropellerTopDepthValue ;
    nltl:iceClass nltl:iceClassIb ;
    nltl:requiredPropellerSubmersionDepthHi ex:requiredPropellerSubmersionDepthHiValue .

ex:ballastConditionPropellerTopDepthValue a qudt:QuantityValue ;
    qudt:numericValue 0.5 ;
    qudt:unit unit:M .

ex:requiredPropellerSubmersionDepthHiValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

