@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-077-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:loadSpectrumShapeParameter ex:loadSpectrumShapeParameterValue ;
    nltl:maximumBladeIceLoad ex:maximumBladeIceLoadValue ;
    nltl:propellerType "ducted"^^xsd:string .

ex:loadSpectrumShapeParameterValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:UNITLESS .

ex:maximumBladeIceLoadValue a qudt:QuantityValue ;
    qudt:numericValue 100.0 ;
    qudt:unit unit:KiloN .

