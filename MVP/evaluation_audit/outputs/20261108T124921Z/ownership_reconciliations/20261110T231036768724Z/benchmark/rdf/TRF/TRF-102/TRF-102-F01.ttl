@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-h/TRF-102-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:bladeExpandedAreaRatio ex:bladeExpandedAreaRatioValue ;
    nltl:bladeFailureSpindleTorque ex:bladeFailureSpindleTorqueValue ;
    nltl:bladeFailureSpindleTorqueFactor ex:bladeFailureSpindleTorqueFactorValue ;
    nltl:extremeIceForce ex:extremeIceForceValue ;
    nltl:leadingEdgeChordPortionAtZeroPointEightRadius ex:leadingEdgeChordPortionAtZeroPointEightRadiusValue ;
    nltl:maximumSpindleTorque ex:maximumSpindleTorqueValue ;
    nltl:propellerBladeCount 4 ;
    nltl:trailingEdgeChordPortionAtZeroPointEightRadius ex:trailingEdgeChordPortionAtZeroPointEightRadiusValue .

ex:bladeExpandedAreaRatioValue a qudt:QuantityValue ;
    qudt:numericValue 0.45 ;
    qudt:unit unit:UNITLESS .

ex:bladeFailureSpindleTorqueFactorValue a qudt:QuantityValue ;
    qudt:numericValue 0.6362125 ;
    qudt:unit unit:UNITLESS .

ex:bladeFailureSpindleTorqueValue a qudt:QuantityValue ;
    qudt:numericValue 105.43187499999999 ;
    qudt:unit unit:KiloN-M .

ex:extremeIceForceValue a qudt:QuantityValue ;
    qudt:numericValue 500.0 ;
    qudt:unit unit:KiloN .

ex:leadingEdgeChordPortionAtZeroPointEightRadiusValue a qudt:QuantityValue ;
    qudt:numericValue 0.3 ;
    qudt:unit unit:M .

ex:maximumSpindleTorqueValue a qudt:QuantityValue ;
    qudt:numericValue 105.43187499999999 ;
    qudt:unit unit:KiloN-M .

ex:trailingEdgeChordPortionAtZeroPointEightRadiusValue a qudt:QuantityValue ;
    qudt:numericValue 0.25 ;
    qudt:unit unit:M .

