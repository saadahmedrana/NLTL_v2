@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-111-F01/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:hasPropellerShaftLineComponent ex:component ;
    nltl:hasPropulsionLoadCase ex:loadCase .

ex:component a nltl:propellerShaftLineComponent ;
    nltl:componentYieldSafetyFactor ex:componentYieldSafetyFactorValue ;
    nltl:fatigueSafetyFactor ex:fatigueSafetyFactorValue .

ex:componentYieldSafetyFactorValue a qudt:QuantityValue ;
    qudt:numericValue 1.3 ;
    qudt:unit unit:UNITLESS .

ex:fatigueSafetyFactorValue a qudt:QuantityValue ;
    qudt:numericValue 1.5 ;
    qudt:unit unit:UNITLESS .

ex:loadCase a nltl:loadCase ;
    nltl:shaftLineLoadCaseType nltl:extremeOperationalLoadCase .

