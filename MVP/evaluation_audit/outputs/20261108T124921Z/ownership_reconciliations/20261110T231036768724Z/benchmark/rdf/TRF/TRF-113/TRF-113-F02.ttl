@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-113-F02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:maximumComponentLoadBladeOrientationConfirmed false ;
    nltl:thrusterBladeLossDesignEvidence ex:bladeLossEvidence .

ex:bladeLossEvidence a nltl:evidenceArtifact .

