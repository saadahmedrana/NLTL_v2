@prefix ex: <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-116-P02/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ship a nltl:ship ;
    nltl:designIceThickness ex:designIceThicknessValue ;
    nltl:equivalentImpactSphereRadius ex:equivalentImpactSphereRadiusValue ;
    nltl:nonHemisphericalImpactContactArea ex:nonHemisphericalImpactContactAreaValue ;
    nltl:propellerHubOrThrusterEndCapImpact true .

ex:designIceThicknessValue a qudt:QuantityValue ;
    qudt:numericValue 1.0 ;
    qudt:unit unit:M .

ex:equivalentImpactSphereRadiusValue a qudt:QuantityValue ;
    qudt:numericValue 0.9999999994286667 ;
    qudt:unit unit:M .

ex:nonHemisphericalImpactContactAreaValue a qudt:QuantityValue ;
    qudt:numericValue 3.14159265 ;
    qudt:unit unit:M2 .

