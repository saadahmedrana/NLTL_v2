@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F02/ship> ;
            sh:resultMessage "The ship must provide the load patch height in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-m> ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchHeight> ] ] .

