@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F08/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F08/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ], [ sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ], [ sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:TRF-030-DirectAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-030-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F08/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F08/ship> ;
            sh:resultMessage "The ship must state whether load length was determined from the structural arrangement." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "The ship must state whether load length was determined from the structural arrangement." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ] .

