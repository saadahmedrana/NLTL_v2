@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/icePressure> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/icePressure>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The ship must provide the externally determined ice pressure in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#icePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must provide the externally determined ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF-030-QuantityValue-MPa> ;
                    sh:path <https://w3id.org/nltl/vocab#icePressure> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/icePressure> ] .

