@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
                    sh:resultMessage "The level ice thickness and design ice load height must match the Table 4-1 values for the ship's ice class." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint _:n042a309f4d4d46f6b90116f611d6cc8eb15 ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:TRF036_ParameterSetShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/ship> ;
            sh:resultMessage "The ship must provide an ice-class design parameter set." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasIceClassDesignParameterSet> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceClassDesignParameterSet> ;
                    sh:message "The ship must provide an ice-class design parameter set." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF036_ParameterSetShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasIceClassDesignParameterSet> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ;
            sh:resultMessage "The level ice thickness and design ice load height must match the Table 4-1 values for the ship's ice class." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint _:n042a309f4d4d46f6b90116f611d6cc8eb15 ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF036_ParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F02/designParameters> ] .

_:n042a309f4d4d46f6b90116f611d6cc8eb15 a sh:SPARQLConstraint ;
    sh:message "The level ice thickness and design ice load height must match the Table 4-1 values for the ship's ice class." ;
    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                ?ship nltl:hasIceClassDesignParameterSet $this ;
                       nltl:iceClass ?class .
                $this nltl:levelIceThickness ?hiQuantity ;
                      nltl:designIceLoadHeight ?hQuantity .
                ?hiQuantity qudt:numericValue ?hi ;
                            qudt:unit unit:M .
                ?hQuantity qudt:numericValue ?h ;
                           qudt:unit unit:M .
                FILTER (
                    (?class = nltl:iceClassIaSuper &&
                     (?hi > 1.0 || ?h != 0.35)) ||
                    (?class = nltl:iceClassIa &&
                     (?hi > 0.8 || ?h != 0.30)) ||
                    (?class = nltl:iceClassIb &&
                     (?hi > 0.6 || ?h != 0.25)) ||
                    (?class = nltl:iceClassIc &&
                     (?hi > 0.4 || ?h != 0.22))
                )
            }
        """ .

