@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> must conform to one or more shapes in [ sh:property [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ; sh:message Literal(\"At least several direct analysis cases are required, including vertical and horizontal load positions.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:DirectAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ] , [ sh:property [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ; sh:message Literal(\"When load length is not determined from the arrangement, several paired load-length and ca analysis cases are required.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:ArrangementDependentAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF030ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/icePressure> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/icePressure>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/vocab/unit/MegaPA>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/MegaPA> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/ship> ;
            sh:resultMessage "The ship must provide the ice pressure input in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#icePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the ice pressure input in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:PressureQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#icePressure> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F13/icePressure> ] .

