@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-P02/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-P02/ship> must conform to one or more shapes in [ sh:property [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ; sh:message Literal(\"At least several direct analysis cases are required, including vertical and horizontal load positions.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:DirectAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ] , [ sh:property [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ; sh:message Literal(\"When load length is not determined from the arrangement, several paired load-length and ca analysis cases are required.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:ArrangementDependentAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF030ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-P02/ship> ] .

