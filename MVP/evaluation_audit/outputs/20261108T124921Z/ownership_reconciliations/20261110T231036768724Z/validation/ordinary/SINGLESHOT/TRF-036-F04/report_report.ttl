@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F04/ship> ;
            sh:resultMessage "The ship must identify an ice-class design parameter set." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasIceClassDesignParameterSet> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#iceClassDesignParameterSet> ;
                    sh:message "The ship must identify an ice-class design parameter set." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasIceClassDesignParameterSet> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F04/designParameters> ;
            sh:resultMessage "The ice class, level ice thickness, and design ice load height must conform to Table 4-1." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IceClassDesignParameterSetShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F04/designParameters> ] .

