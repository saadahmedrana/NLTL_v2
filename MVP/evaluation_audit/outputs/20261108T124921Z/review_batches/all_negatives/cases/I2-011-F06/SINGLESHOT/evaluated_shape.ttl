@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix q: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2-011> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:polarClass ;
        sh:minCount 1 ;
        sh:in (
            nltl:polarClassPc1
            nltl:polarClassPc2
            nltl:polarClassPc3
            nltl:polarClassPc4
            nltl:polarClassPc5
            nltl:polarClassPc6
            nltl:polarClassPc7
        ) ;
        sh:message "A ship must have a canonical Polar Class value to determine applicability." ;
    ] ;
    sh:property [
        sh:path nltl:bulbousBowPresent ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:message "A ship must state whether it is equipped with a bulbous bow to determine applicability." ;
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:polarClass ;
                sh:in (
                    nltl:polarClassPc6
                    nltl:polarClassPc7
                )
            ] ;
            sh:property [
                sh:path nltl:bulbousBowPresent ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/MegaN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:shapeCoefficient ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:loadPatchAspectRatio ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1 ;
                        sh:minInclusive "1.3"^^xsd:decimal ;
                        sh:maxInclusive "1.3"^^xsd:decimal
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:property [
                sh:path nltl:bowDesignForce ;
                sh:minCount 1 ;
                sh:node [
                    sh:property [
                        sh:path q:numericValue ;
                        sh:datatype xsd:decimal ;
                        sh:minCount 1
                    ] ;
                    sh:property [
                        sh:path q:unit ;
                        sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                        sh:minCount 1 ;
                        sh:maxCount 1
                    ]
                ]
            ] ;
            sh:sparql [
                sh:message "For an applicable PC6 or PC7 ship with a bulbous bow, the bow design force must correspond to the force determined under I2.3.2.1(iv), within a relative tolerance of 1e-6 with a small absolute fallback, and must not be less than the I2.3.2.1(iii) force." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX q: <http://qudt.org/schema/qudt/>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

                    SELECT $this
                    WHERE {
                        $this nltl:polarClass ?pc ;
                              nltl:bulbousBowPresent true ;
                              nltl:bowDesignForce ?result ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIii ?partIii ;
                              nltl:bowDesignForceMethodI2Point3Point2Point1PartIv ?partIv .

                        FILTER (
                            ?pc = nltl:polarClassPc6 ||
                            ?pc = nltl:polarClassPc7
                        )

                        ?result q:numericValue ?resultValue ;
                                q:unit <http://qudt.org/vocab/unit/KiloN> .
                        ?partIii q:numericValue ?partIiiValue ;
                                 q:unit <http://qudt.org/vocab/unit/MegaN> .
                        ?partIv q:numericValue ?partIvValue ;
                                q:unit <http://qudt.org/vocab/unit/MegaN> .

                        BIND (?partIvValue * 1000 AS ?expectedValue)
                        FILTER (
                            ?resultValue < ?partIiiValue * 1000 ||
                            ABS(?resultValue - ?expectedValue) >
                                (ABS(?expectedValue) * 0.000001 + 0.000001)
                        )
                    }
                """
            ]
        ]
        [
            sh:or (
                [
                    sh:property [
                        sh:path nltl:bulbousBowPresent ;
                        sh:hasValue false
                    ]
                ]
                [
                    sh:property [
                        sh:path nltl:polarClass ;
                        sh:in (
                            nltl:polarClassPc1
                            nltl:polarClassPc2
                            nltl:polarClassPc3
                            nltl:polarClassPc4
                            nltl:polarClassPc5
                        )
                    ]
                ]
            )
        ]
    ) .

<urn:nltl:generated-shape:I2-011-quantity-value> a sh:NodeShape ;
    sh:property [
        sh:path q:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1
    ] .
