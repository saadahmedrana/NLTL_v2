@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#polarClassRequirementsApplicable> ], [ sh:in ( <https://w3id.org/nltl/vocab#polarClassPc1> <https://w3id.org/nltl/vocab#polarClassPc2> <https://w3id.org/nltl/vocab#polarClassPc3> <https://w3id.org/nltl/vocab#polarClassPc4> <https://w3id.org/nltl/vocab#polarClassPc5> <https://w3id.org/nltl/vocab#polarClassPc6> <https://w3id.org/nltl/vocab#polarClassPc7> ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An applicable Polar Class ship must have one valid polarClass value.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#polarClass> ], [ sh:node <urn:nltl:generated-shape:I2_046_InternalStructureShape> ; sh:path <https://w3id.org/nltl/vocab#hasInternalIceStrengthenedStructure> ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#polarClassRequirementsApplicable> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_046_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-046-F03/ship> ] .

