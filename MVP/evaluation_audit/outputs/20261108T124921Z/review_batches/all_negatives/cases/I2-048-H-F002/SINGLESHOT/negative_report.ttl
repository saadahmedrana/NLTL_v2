@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F002/case> ;
                    sh:resultMessage "Each steel-grade requirement case must identify exactly one assessed plating." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#steelGradeRequirementCasePlating> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#plating> ;
                            sh:maxCount 1 ;
                            sh:message "Each steel-grade requirement case must identify exactly one assessed plating." ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path <https://w3id.org/nltl/vocab#steelGradeRequirementCasePlating> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F002/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_048_CaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
                    sh:node <urn:nltl:generated-shape:I2_048_CaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F002/case> ] .

