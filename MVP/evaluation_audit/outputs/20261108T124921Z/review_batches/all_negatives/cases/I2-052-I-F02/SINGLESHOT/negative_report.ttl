@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/ship> ;
            sh:resultMessage "The ship must provide the externally determined interpolated value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#interpolatedValue> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must provide the externally determined interpolated value." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#interpolatedValue> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ;
                    sh:resultMessage "Each calculation case must identify an upper interpolation endpoint." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#interpolationUpperEndpoint> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#interpolationPoint> ;
                            sh:message "Each calculation case must identify an upper interpolation endpoint." ;
                            sh:minCount 1 ;
                            sh:node <urn:nltl:generated-shape:InterpolationPointShape> ;
                            sh:path <https://w3id.org/nltl/vocab#interpolationUpperEndpoint> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/ship> ;
            sh:resultMessage "The ship must provide a calculation case for the linear interpolation determination." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasCalculationCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#calculationCase> ;
                    sh:message "The ship must provide a calculation case for the linear interpolation determination." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:CalculationCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasCalculationCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-i/I2-052-I-F02/calculation> ] .

