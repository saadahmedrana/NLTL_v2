@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ice of land origin must be absent for open water.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceOfLandOriginPresent> ], [ sh:hasValue <https://w3id.org/nltl/vocab#openWaterIceCondition> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's ice condition classification must identify open water for the open-water branch.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceConditionClassification> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:maxExclusive Literal(\"1\", datatype=xsd:decimal) ; sh:message Literal(\"Sea ice concentration must be less than 1 for open water.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/schema/qudt/UNITLESS> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Sea ice concentration must use the unitless unit.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#seaIceConcentration> ] ] , [ sh:property [ sh:in ( <https://w3id.org/nltl/vocab#iceConditionLessSevereThanCategoryAAndB> <https://w3id.org/nltl/vocab#iceFreeIceCondition> <https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> <https://w3id.org/nltl/vocab#thinFirstYearIceWithPossibleOldIceInclusions> <https://w3id.org/nltl/vocab#otherWatersIceCondition> ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The ship's ice condition classification must identify a permitted non-open-water condition.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceConditionClassification> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_007_OpenWaterShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-007-F02/ship> ] .

