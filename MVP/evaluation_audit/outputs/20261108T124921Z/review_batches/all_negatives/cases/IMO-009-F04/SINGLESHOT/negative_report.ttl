@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ;
            sh:resultMessage """Node <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue Literal("bergy waters", datatype=xsd:string) ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#iceCondition> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For bergy waters, land-origin ice concentration must be less than 1/10.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxExclusive Literal("1", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#landOriginIceConcentration> ], [ sh:maxCount Literal("1", datatype=xsd:integer) ; sh:message Literal("For bergy waters, total ice concentration must not exceed 1/10.") ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:maxInclusive Literal("1", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ; sh:maxCount Literal("1", datatype=xsd:integer) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#totalIceConcentration> ] ] , [ sh:sparql [ sh:message Literal("The non-bergy-waters applicability branch cannot be used when the ice condition is bergy waters.") ; sh:select Literal("
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                    SELECT $this
                    WHERE {
                        $this nltl:iceCondition ?condition .
                        FILTER (?condition = "bergy waters"^^xsd:string)
                    }
                ") ] ]""" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_009_BergyWatersShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-009-F04/ship> ] .

