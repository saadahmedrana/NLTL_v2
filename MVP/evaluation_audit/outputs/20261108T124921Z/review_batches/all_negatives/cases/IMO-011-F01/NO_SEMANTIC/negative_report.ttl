@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ;
                    sh:resultMessage "Each daily low-temperature observation must have exactly one calendar date." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#dailyTemperatureObservationDate> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:date ;
                            sh:maxCount 1 ;
                            sh:message "Each daily low-temperature observation must have exactly one calendar date." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#dailyTemperatureObservationDate> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/ship> ;
            sh:resultMessage "The ship must provide dated daily low-temperature observations." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasDailyLowTemperatureObservation> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#dailyLowTemperatureObservation> ;
                    sh:message "The ship must provide dated daily low-temperature observations." ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <https://w3id.org/nltl/vocab#dailyLowTemperatureObservation> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:message "Each daily low-temperature observation must carry one daily low temperature in degrees Celsius." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#dailyLowTemperature> ],
                                [ sh:datatype xsd:date ;
                                    sh:maxCount 1 ;
                                    sh:message "Each daily low-temperature observation must have exactly one calendar date." ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#dailyTemperatureObservationDate> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasDailyLowTemperatureObservation> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F01/obs1> ] .

