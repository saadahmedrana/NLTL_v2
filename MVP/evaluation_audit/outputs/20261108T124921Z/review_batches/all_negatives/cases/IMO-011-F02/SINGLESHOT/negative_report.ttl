@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ;
                    sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1>-><https://w3id.org/nltl/vocab#dailyLowTemperature>" ;
                    sh:resultPath <https://w3id.org/nltl/vocab#dailyLowTemperature> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#dailyLowTemperature> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:class <https://w3id.org/nltl/vocab#dailyLowTemperatureObservation> ; sh:property [ sh:datatype xsd:date ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#dailyTemperatureObservationDate> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#dailyLowTemperature> ] ]. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasDailyLowTemperatureObservation> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node [ sh:class <https://w3id.org/nltl/vocab#dailyLowTemperatureObservation> ;
                            sh:property [ sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                                [ sh:hasValue <http://qudt.org/vocab/unit/DEG_C> ;
                                                    sh:maxCount 1 ;
                                                    sh:minCount 1 ;
                                                    sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                                    sh:path <https://w3id.org/nltl/vocab#dailyLowTemperature> ],
                                [ sh:datatype xsd:date ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <https://w3id.org/nltl/vocab#dailyTemperatureObservationDate> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#hasDailyLowTemperatureObservation> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-011-F02/obs1> ] .

