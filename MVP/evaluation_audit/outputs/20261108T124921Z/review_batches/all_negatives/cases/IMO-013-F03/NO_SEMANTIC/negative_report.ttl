@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ;
            sh:resultMessage "The ship's low-air-temperature classification must be true when lowest MDLT is below -10 deg C and false otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_013_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-013-F03/ship>-><https://w3id.org/nltl/vocab#shipOperatesInLowAirTemperature>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#shipOperatesInLowAirTemperature> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shipOperatesInLowAirTemperature> ] ] .

