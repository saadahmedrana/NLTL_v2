@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F04/supplement> ;
            sh:resultMessage "The Polar Certificate supplement shall contain required equipment records." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasRequiredEquipmentRecords> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#requiredEquipmentRecords> ;
                    sh:message "The Polar Certificate supplement shall contain required equipment records." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#hasRequiredEquipmentRecords> ] ] .

