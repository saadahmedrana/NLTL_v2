@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-b/IMO-017-F06/ship> ;
            sh:resultMessage "The ship shall have a Polar Ship Certificate." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPolarShipCertificate> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#polarShipCertificateForm> ;
                    sh:message "The ship shall have a Polar Ship Certificate." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#hasPolarShipCertificate> ] ] .

