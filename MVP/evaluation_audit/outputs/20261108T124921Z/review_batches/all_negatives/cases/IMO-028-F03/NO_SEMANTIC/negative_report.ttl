@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Ice-strengthened ships must include prolonged-ice-entrapment life-support and integrity procedures in the PWOM.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#prolongedEntrapmentProcedurePresent> ], [ sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ] ] , [ sh:property [ sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_028_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-c/IMO-028-F03/ship>-><https://w3id.org/nltl/vocab#shipIceStrengthened>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#shipIceStrengthened> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ] ] .

