@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO_030> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ]
        ]
        [
            sh:property [
                sh:path nltl:iceOperationApplicable ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceSafetyMonitoringProcedurePresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operations are applicable, an ice-safety monitoring procedure must be present."
            ] ;
            sh:property [
                sh:path nltl:escortRequirementsPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "When ice operations are applicable, applicable escort or icebreaker-assistance requirements must be included."
            ] ;
            sh:property [
                sh:path nltl:independentOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When ice operations are applicable, independent-operation limitations must be included."
            ] ;
            sh:property [
                sh:path nltl:escortedOperationLimits ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:message "When ice operations are applicable, escorted-operation limitations must be included."
            ]
        ]
    ) .
