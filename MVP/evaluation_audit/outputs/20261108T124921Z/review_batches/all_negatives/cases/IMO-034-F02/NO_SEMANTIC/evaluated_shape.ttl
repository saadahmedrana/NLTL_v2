@prefix gs: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gs:IMO_034_Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:xone (
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false
            ] ;
            sh:message "Ice accretion must be recorded as not likely when the conditional ice-removal requirements do not apply."
        ]
        [
            sh:property [
                sh:path nltl:iceAccretionLikely ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:iceAccretionMinimizationDesignPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:requiredIceRemovalMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:administrationRequiredIceRemovalMeans ;
                sh:datatype xsd:string ;
                sh:minCount 1
            ] ;
            sh:message "When ice accretion is likely, the ship must have an ice-accretion minimization design and required ice-removal means, including the Administration-required means."
        ]
    ) .
