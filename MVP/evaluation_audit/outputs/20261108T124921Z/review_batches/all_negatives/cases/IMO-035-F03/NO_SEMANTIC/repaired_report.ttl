                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#stabilityCalculationIcingAllowanceValues> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F03/ship> ;
            sh:resultMessage "The PWOM must state that icing allowance information is present." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarWaterOperationalManualIcingAllowanceInformationPresent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape _:n301b2307761d43ca8b00ec6dfe6d583cb3 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F03/ship> ;
            sh:resultMessage "The PWOM icing allowance values must match the stability calculation values." ;
            sh:resultPath <https://w3id.org/nltl/vocab#polarWaterOperationalManualIcingAllowanceValues> ;
            sh:resultSeverity sh:Violation ;
