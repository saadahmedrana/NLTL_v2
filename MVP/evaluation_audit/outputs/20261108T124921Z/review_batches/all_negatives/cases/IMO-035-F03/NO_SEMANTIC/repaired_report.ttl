        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-d/IMO-035-F03/ship> ;
            sh:resultMessage "The stability calculation icing allowance values must match the PWOM values." ;
            sh:resultPath <https://w3id.org/nltl/vocab#stabilityCalculationIcingAllowanceValues> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
