@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F01/ship> ;
            sh:resultMessage "If a hatch or door is hydraulically operated, hydraulic-fluid freezing or excessive-viscosity control must be present." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-041> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-041-F01/ship> ] .

