@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-041> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue "hydraulic"
            ] ;
            sh:property [
                sh:path nltl:hydraulicFluidFreezingOrViscosityControlPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:hasValue true
            ]
        ]
        [
            sh:property [
                sh:path nltl:openingActuationType ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:sparql [
                sh:message "Opening actuation type must be non-hydraulic when hydraulic-fluid protection is not provided." ;
                sh:select """
                    PREFIX nltl: <https://w3id.org/nltl/vocab#>
                    SELECT $this
                    WHERE {
                        $this nltl:openingActuationType ?openingType .
                        FILTER (?openingType = "hydraulic")
                    }
                """
            ]
        ]
    ) ;
    sh:message "If a hatch or door is hydraulically operated, hydraulic-fluid freezing or excessive-viscosity control must be present." .
