@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-048-F03/ship> ;
            sh:resultMessage "The exposed machinery or foundation material must have approved material evidence." ;
            sh:resultPath <https://w3id.org/nltl/vocab#materialApprovalStatus> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#evidenceState> ;
                    sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ;
                    sh:message "The exposed machinery or foundation material must have approved material evidence." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#materialApprovalStatus> ] ] .

