@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO_060_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The fixed water system separation applicability value is required and must be a single boolean."
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The independent sea suction applicability value is required and must be a single boolean."
    ] ;
    sh:property [
        sh:path nltl:seaSuctionIceClearingCapability ;
        sh:datatype xsd:boolean ;
    ] ;
    sh:or (
        gen:IMO_060_ApplicableBranch
        gen:IMO_060_SeparateSystemNotApplicableBranch
        gen:IMO_060_IndependentSuctionNotApplicableBranch
    ) .

gen:IMO_060_ApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:seaSuctionIceClearingCapability ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue true ;
        sh:message "When the separate fixed water system uses an independent sea suction, the sea suction must be capable of being cleared of ice accumulation."
    ] .

gen:IMO_060_SeparateSystemNotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:hasValue false ;
    ] .

gen:IMO_060_IndependentSuctionNotApplicableBranch
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:fixedWaterSystemSeparateFromMainFirePumps ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path nltl:independentSeaSuctionUsed ;
        sh:hasValue false ;
    ] .
