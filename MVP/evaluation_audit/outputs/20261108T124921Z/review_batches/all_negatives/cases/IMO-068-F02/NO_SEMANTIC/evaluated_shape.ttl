@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-068> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipOperatesInIceCoveredWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The ship's operation in ice-covered waters must be recorded as a boolean."
    ] ;
    sh:property [
        sh:path nltl:directEvacuationOntoIceApplicable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Whether direct evacuation onto ice is applicable must be recorded as a boolean."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipOperatesInIceCoveredWaters ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:safeEvacuationMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved
            ]
        ]
        [
            sh:property [
                sh:path nltl:directEvacuationOntoIceApplicable ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:safeEvacuationMeansPresent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:survivalEquipmentDeploymentApprovalStatus ;
                sh:minCount 1 ;
                sh:hasValue nltl:evidenceStateApproved
            ]
        ]
        [
            sh:property [
                sh:path nltl:shipOperatesInIceCoveredWaters ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:directEvacuationOntoIceApplicable ;
                sh:hasValue false
            ]
        ]
    ) .
