@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F03/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Immersion-suit applicability must be recorded as false when insulated immersion suits are not required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#immersionSuitRequired> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Immersion-suit applicability must be recorded as true when insulated immersion suits are required.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#immersionSuitRequired> ], [ sh:hasValue <https://w3id.org/nltl/vocab#insulatedImmersionSuit> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Where immersion suits are required, the immersion suit type must be insulated.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#immersionSuitTypeClassification> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-071> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-071-F03/ship> ] .

