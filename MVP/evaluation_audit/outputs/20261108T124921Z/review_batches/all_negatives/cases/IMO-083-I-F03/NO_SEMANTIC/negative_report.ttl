@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ;
            sh:resultMessage "Ice-accretion applicability must be recorded as one boolean value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceAccretionLikely> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:message "Ice-accretion applicability must be recorded as one boolean value." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#iceAccretionLikely> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO_083_NotApplicableShape> , <urn:nltl:generated-shape:IMO_083_ApplicableShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_083_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-083-I-F03/ship> ] .

