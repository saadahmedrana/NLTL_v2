@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F01/ship> must conform to one or more shapes in [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"An icebreaker-escorted ship shall have a manually initiated flashing red stopped light.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#manuallyInitiatedFlashingRedStoppedLightPresent> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The stopped light shall be visible from astern.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#lightVisibleFromAstern> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The stopped light visibility arcs shall conform to the applicable stern-light specifications.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#colregSternLightArcComplianceStatus> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#icebreakerEscortOperation> ], [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"The stopped light shall have a visibility range of at least two nautical miles.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:minInclusive Literal(\"2\", datatype=xsd:decimal) ; sh:path <http://qudt.org/schema/qudt/numericValue> ], [ sh:hasValue <http://qudt.org/vocab/unit/MI_N> ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <http://qudt.org/schema/qudt/unit> ] ] ; sh:path <https://w3id.org/nltl/vocab#visibilityRange> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#icebreakerEscortOperation> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO_089_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-i/IMO-089-I-F01/ship> ] .

