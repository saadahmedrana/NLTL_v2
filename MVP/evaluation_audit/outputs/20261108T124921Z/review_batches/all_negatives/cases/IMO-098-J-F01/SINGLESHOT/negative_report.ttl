@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F01/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO098ApplicableShape> , <urn:nltl:generated-shape:IMO098NotApplicableShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO098ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-j/IMO-098-J-F01/ship> ] .

