@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:IMO107ShipPolarOperationCoverageShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        gen:IMO107PolarOperationNotApplicableShape
        gen:IMO107PolarOperationApplicableShape
    ) .

gen:IMO107PolarOperationNotApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue false ;
        sh:message "The ship's polar-water applicability must be recorded as false when the polar-operation coverage rule is not applicable."
    ] .

gen:IMO107PolarOperationApplicableShape
    a sh:NodeShape ;
    sh:property [
        sh:path nltl:shipOperatesInPolarWaters ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "The ship's polar-water applicability must be recorded as true when the polar-operation coverage rule applies."
    ] ;
    sh:property [
        sh:path nltl:oilRecordBookPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Polar operation must be covered in the applicable Oil Record Book."
    ] ;
    sh:property [
        sh:path nltl:manualPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Polar operation must be covered in the applicable manuals."
    ] ;
    sh:property [
        sh:path nltl:pollutionEmergencyPlanPolarCoverage ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:message "Polar operation must be covered in the applicable oil or marine pollution emergency plan."
    ] .
