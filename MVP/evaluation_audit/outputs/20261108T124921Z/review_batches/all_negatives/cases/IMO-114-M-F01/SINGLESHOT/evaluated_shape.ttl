@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-114> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( nltl:polarShipCategoryA nltl:polarShipCategoryB nltl:polarShipCategoryC ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:cargoTankType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:administrationCarriageApprovalStatus ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:evidenceState ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path nltl:applicableCertificatePolarOperationEntryPresent ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        sh:message "Category A or B ships constructed on or after 2017-01-01 carrying the specified NLS in cargo tanks of type 3 require Administration approval and a corresponding certificate entry." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category ;
                      nltl:constructionDate ?constructionDate ;
                      nltl:carriedNoxiousLiquidSubstanceRequiresType3Tank ?requiresType3 ;
                      nltl:cargoTankType ?cargoTankType .

                FILTER (
                    ?category IN (nltl:polarShipCategoryA, nltl:polarShipCategoryB)
                    && ?constructionDate >= "2017-01-01"^^xsd:date
                    && ?requiresType3 = true
                    && ?cargoTankType = "3"
                )

                FILTER NOT EXISTS {
                    $this nltl:administrationCarriageApprovalStatus nltl:evidenceStateApproved .
                }

                FILTER NOT EXISTS {
                    $this nltl:applicableCertificatePolarOperationEntryPresent true .
                }
            }
        """
    ]
.
