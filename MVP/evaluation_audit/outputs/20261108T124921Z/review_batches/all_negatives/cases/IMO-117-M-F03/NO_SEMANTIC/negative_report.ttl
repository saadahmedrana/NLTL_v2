@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/ship> must conform to one or more shapes in <urn:nltl:generated-shape:IMO117ApplicableShape> , <urn:nltl:generated-shape:IMO117NonApplicableShape>" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO117ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/ship> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/distanceToNearestLandIceShelfOrFastIceValue> ;
                    sh:resultMessage "A discharge distance shall use nautical miles." ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nfe313a72cc274baf80295d77ea35157bb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/distanceRecord> ;
            sh:resultMessage "The discharge distance record shall record the distance to the nearest land, ice shelf, or fast ice." ;
            sh:resultPath <https://w3id.org/nltl/vocab#distanceToNearestLandIceShelfOrFastIce> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                    sh:maxCount 1 ;
                    sh:message "The discharge distance record shall record the distance to the nearest land, ice shelf, or fast ice." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:DistanceQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#distanceToNearestLandIceShelfOrFastIce> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/distanceToNearestLandIceShelfOrFastIceValue> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ;
                    sh:resultMessage "A discharge distance shall use nautical miles." ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:nfe313a72cc274baf80295d77ea35157bb2 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/distanceRecord> ;
            sh:resultMessage "The discharge distance record shall record the distance to an area with ice concentration greater than one tenth." ;
            sh:resultPath <https://w3id.org/nltl/vocab#distanceToAreaWithIceConcentrationGreaterThanOneTenth> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                    sh:maxCount 1 ;
                    sh:message "The discharge distance record shall record the distance to an area with ice concentration greater than one tenth." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:DistanceQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#distanceToAreaWithIceConcentrationGreaterThanOneTenth> ] ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-117-M-F03/distanceToAreaWithIceConcentrationGreaterThanOneTenthValue> ] .

_:nfe313a72cc274baf80295d77ea35157bb2 sh:hasValue <http://qudt.org/schema/qudt/MI_N> ;
    sh:maxCount 1 ;
    sh:message "A discharge distance shall use nautical miles." ;
    sh:minCount 1 ;
    sh:path <http://qudt.org/schema/qudt/unit> .

