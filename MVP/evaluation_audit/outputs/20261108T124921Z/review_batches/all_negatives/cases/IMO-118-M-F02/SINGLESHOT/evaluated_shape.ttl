@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-118> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:constructionDate ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:message "A construction date is required to determine applicability of the sewage discharge rule."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:shipCategory ;
                sh:nodeKind sh:IRI ;
                sh:in (
                    nltl:polarShipCategoryA
                    nltl:polarShipCategoryB
                ) ;
                sh:minCount 1
            ]
        ]
        [
            sh:class nltl:passengerShip
        ]
    ) ;
    sh:sparql [
        sh:message "For an applicable ship constructed on or after 1 January 2017, sewage discharge to sea must be false unless compliance with paragraph 4.2.1.3 is explicitly true." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
                ?this nltl:constructionDate ?date .
                FILTER (?date >= "2017-01-01"^^xsd:date)
                FILTER NOT EXISTS {
                    ?this nltl:polarCodeSewageParagraph4Point2Point1Point3ComplianceStatus true
                }
                FILTER NOT EXISTS {
                    ?this nltl:sewageDischargeToSea false
                }
            }
        """
    ] .
