@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ;
            sh:resultMessage "For a Category A or B ship operating for an extended period in ice concentration exceeding 1/10 and discharging sewage, an approved sewage treatment plant and Administration approval are required." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "For a Category A or B ship operating for an extended period in ice concentration exceeding 1/10 and discharging sewage, an approved sewage treatment plant and Administration approval are required." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT $this
            WHERE {
                $this nltl:shipCategory ?category .
                FILTER (?category IN (
                    nltl:polarShipCategoryA,
                    nltl:polarShipCategoryB
                )) .

                $this nltl:iceConcentration ?iceQuantity .
                ?iceQuantity qudt:numericValue ?iceValue ;
                              qudt:unit unit:UNITLESS .
                FILTER (?iceValue > 1) .

                $this nltl:extendedPeriodOperation true ;
                      nltl:sewageDischargeOccurs true .

                FILTER NOT EXISTS {
                    $this nltl:approvedSewageTreatmentPlantUsed true ;
                          nltl:administrationDischargeApprovalStatus nltl:evidenceStateApproved .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-119> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-m/IMO-119-M-F01/ship> ] .

