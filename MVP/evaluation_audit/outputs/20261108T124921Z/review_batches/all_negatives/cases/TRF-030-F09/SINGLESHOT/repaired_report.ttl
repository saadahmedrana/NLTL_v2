@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> must conform to one or more shapes in [ sh:property [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ; sh:message Literal(\"At least several direct analysis cases are required, including vertical and horizontal load positions.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:DirectAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ] , [ sh:property [ sh:class <https://w3id.org/nltl/vocab#directAnalysisCase> ; sh:message Literal(\"When load length is not determined from the arrangement, several paired load-length and ca analysis cases are required.\") ; sh:minCount Literal(\"2\", datatype=xsd:integer) ; sh:node <urn:nltl:generated-shape:ArrangementDependentAnalysisCaseShape> ; sh:path <https://w3id.org/nltl/vocab#hasDirectAnalysisCase> ], [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#loadLengthDeterminedFromArrangement> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF030ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> ;
            sh:resultMessage "The ship must provide the externally determined applied ice pressure in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#appliedIcePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the externally determined applied ice pressure in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:PressureQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#appliedIcePressure> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> ;
            sh:resultMessage "The ship must provide the load patch height in metres." ;
            sh:resultPath <https://w3id.org/nltl/vocab#loadPatchHeight> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the load patch height in metres." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:LengthQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#loadPatchHeight> ] ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-030-F09/ship> ;
            sh:resultMessage "The ship must provide the ice pressure input in MPa." ;
            sh:resultPath <https://w3id.org/nltl/vocab#icePressure> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:message "The ship must provide the ice pressure input in MPa." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:PressureQuantityShape> ;
                    sh:path <https://w3id.org/nltl/vocab#icePressure> ] ] .

