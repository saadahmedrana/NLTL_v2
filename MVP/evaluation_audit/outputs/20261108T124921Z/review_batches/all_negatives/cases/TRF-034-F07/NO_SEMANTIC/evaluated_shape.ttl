@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-034> a sh:NodeShape ;
    sh:targetClass nltl:effectiveMemberCrossSection ;
    sh:property [
        sh:path [ sh:inversePath nltl:hasEffectiveMemberCrossSection ] ;
        sh:class nltl:hullStructure ;
        sh:minCount 1 ;
        sh:message "The effective member cross section must be linked to a hull structure."
    ] ;
    sh:property [
        sh:path nltl:sectionModulus ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/CentiM3> ;
                sh:maxCount 1 ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The effective member cross section must provide one section modulus value in cubic centimetres."
    ] ;
    sh:property [
        sh:path nltl:shearArea ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node [
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:maxCount 1 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/M2> ;
                sh:maxCount 1 ;
                sh:minCount 1
            ]
        ] ;
        sh:message "The effective member cross section must provide one shear area value in square metres."
    ] ;
    sh:or (
        [
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasEffectiveMemberCrossSection ]
                    nltl:memberNormalToPlating
                ) ;
                sh:datatype xsd:boolean ;
                sh:hasValue true ;
                sh:maxCount 1 ;
                sh:minCount 1
            ]
        ]
        [
            sh:property [
                sh:path (
                    [ sh:inversePath nltl:hasEffectiveMemberCrossSection ]
                    nltl:memberNormalToPlating
                ) ;
                sh:datatype xsd:boolean ;
                sh:hasValue false ;
                sh:maxCount 1 ;
                sh:minCount 1
            ] ;
            sh:property [
                sh:path nltl:hasClassificationSocietySectionPropertyCalculationEvidence ;
                sh:class nltl:evidenceArtifact ;
                sh:minCount 1 ;
                sh:message "Classification society section-property calculation evidence is required when the member is not normal to the plating."
            ]
        ]
    )
.
