@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-036-F06/ship> ;
            sh:resultMessage "The ship must have one applicable ice class from Table 4-1." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#iceClassIaSuper> <https://w3id.org/nltl/vocab#iceClassIa> <https://w3id.org/nltl/vocab#iceClassIb> <https://w3id.org/nltl/vocab#iceClassIc> ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one applicable ice class from Table 4-1." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ] .

