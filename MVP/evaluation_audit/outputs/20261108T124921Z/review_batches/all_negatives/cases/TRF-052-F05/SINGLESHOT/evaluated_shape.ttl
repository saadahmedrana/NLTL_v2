@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-052-FrameSupportShape>
    a sh:NodeShape ;
    sh:targetClass nltl:frame ;
    sh:property [
        sh:path nltl:frameAsymmetrical ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Frame asymmetry status is required to determine tripping-support applicability."
    ] ;
    sh:property [
        sh:path nltl:frameWebAngleToShell ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:DEG ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame web angle to shell is required in degrees."
    ] ;
    sh:property [
        sh:path nltl:frameSpan ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            a sh:NodeShape ;
            sh:class qudt:QuantityValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue unit:M ;
                sh:minCount 1 ;
                sh:maxCount 1
            ]
        ] ;
        sh:message "Frame span is required in metres."
    ] ;
    sh:property [
        sh:path nltl:iceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ice class is required to determine the applicable support region."
    ] ;
    sh:property [
        sh:path nltl:equivalentSupportStatusByDirectCalculation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An applicable frame requires antitripping support spacing not exceeding 1300 mm, unless equivalent support is demonstrated by direct calculation." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentSupportStatusByDirectCalculation true
                    }
                )
                {
                    $this nltl:frameAsymmetrical true
                }
                UNION
                {
                    $this nltl:frameWebAngleToShell ?angleNode .
                    ?angleNode qudt:numericValue ?angle .
                    ?angleNode qudt:unit unit:DEG .
                    FILTER (?angle < 90)
                }
                FILTER NOT EXISTS {
                    $this nltl:antitrippingSupportSpacing ?spacingNode .
                    ?spacingNode qudt:numericValue ?spacing .
                    ?spacingNode qudt:unit unit:MilliM .
                    FILTER (?spacing <= 1300)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For frames with spans greater than 4 m, antitripping support must cover the bow, midbody, and stern regions." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentSupportStatusByDirectCalculation true
                    }
                )
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                ?spanNode qudt:unit unit:M .
                FILTER (?span > 4)
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                    }
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:sternRegion
                    }
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For frames with spans of 4 m or less, the applicable ice-class region coverage is required." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>
            PREFIX sh: <http://www.w3.org/ns/shacl#>
            PREFIX unit: <http://qudt.org/vocab/unit/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this
            WHERE {
                FILTER (
                    NOT EXISTS {
                        $this nltl:equivalentSupportStatusByDirectCalculation true
                    }
                )
                $this nltl:frameSpan ?spanNode .
                ?spanNode qudt:numericValue ?span .
                ?spanNode qudt:unit unit:M .
                FILTER (?span <= 4)
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIaSuper .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIa .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIa .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:midbodyRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIb .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
                UNION
                {
                    $this nltl:iceClass nltl:iceClassIc .
                    FILTER NOT EXISTS {
                        $this nltl:hasAntitrippingSupportRegion nltl:bowRegion
                    }
                }
            }
        """
    ] .
