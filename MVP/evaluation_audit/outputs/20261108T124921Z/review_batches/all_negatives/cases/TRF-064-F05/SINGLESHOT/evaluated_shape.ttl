@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF064ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:detachedStrut ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A detached-strut applicability value must be recorded." 
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:hasValue true
            ] ;
            sh:property [
                sh:path nltl:hasDetachedStrut ;
                sh:class nltl:detachedStrutStructure ;
                sh:minCount 1 ;
                sh:node gen:TRF064DetachedStrutShape ;
                sh:message "Detached struts require design, strength, and hull-attachment evidence."
            ]
        ]
        [
            sh:property [
                sh:path nltl:detachedStrut ;
                sh:hasValue false
            ] ;
            sh:property [
                sh:path nltl:hasSidePropellerShafting ;
                sh:node gen:TRF064EnclosedComponentShape ;
                sh:message "Side-propeller shafting must be enclosed within plated bossing when detached struts are not used."
            ] ;
            sh:property [
                sh:path nltl:hasSternTube ;
                sh:node gen:TRF064EnclosedComponentShape ;
                sh:message "Side-propeller stern tubes must be enclosed within plated bossing when detached struts are not used."
            ]
        ]
    ) .

gen:TRF064EnclosedComponentShape a sh:NodeShape ;
    sh:property [
        sh:path nltl:enclosedByPlatedBossing ;
        sh:class nltl:platedBossingStructure ;
        sh:minCount 1 ;
        sh:message "The component must be enclosed within a plated bossing."
    ] .

gen:TRF064DetachedStrutShape a sh:NodeShape ;
    sh:class nltl:detachedStrutStructure ;
    sh:property [
        sh:path nltl:hasStrutDesignEvidence ;
        sh:class nltl:strutDesignEvidence ;
        sh:minCount 1 ;
        sh:message "Detached struts require design evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutHullAttachmentEvidence ;
        sh:class nltl:strutHullAttachmentEvidence ;
        sh:minCount 1 ;
        sh:message "Detached struts require hull-attachment evidence."
    ] ;
    sh:property [
        sh:path nltl:hasStrutStrengthEvidence ;
        sh:class nltl:strutStrengthEvidence ;
        sh:minCount 1 ;
        sh:message "Detached struts require strength evidence."
    ] .
