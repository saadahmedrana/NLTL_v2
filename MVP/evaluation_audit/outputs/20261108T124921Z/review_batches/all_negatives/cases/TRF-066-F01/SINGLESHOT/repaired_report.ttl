@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-f/TRF-066-F01/ship> ;
            sh:resultMessage "The ship must have one valid ice class." ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
            sh:sourceShape [ sh:datatype <https://w3id.org/nltl/vocab#iceClassValue> ;
                    sh:in ( <https://w3id.org/nltl/vocab#iceClassIaSuper> <https://w3id.org/nltl/vocab#iceClassIa> <https://w3id.org/nltl/vocab#iceClassIb> <https://w3id.org/nltl/vocab#iceClassIc> <https://w3id.org/nltl/vocab#iceClassIi> <https://w3id.org/nltl/vocab#iceClassIii> ) ;
                    sh:maxCount 1 ;
                    sh:message "The ship must have one valid ice class." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ;
            sh:value <https://w3id.org/nltl/vocab#iceClassIa> ] .

