@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/case> ;
                    sh:resultMessage "Each propeller blade load case must link to exactly one propeller blade." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#propellerBladeLoadCaseBlade> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#propellerBlade> ;
                            sh:maxCount 1 ;
                            sh:message "Each propeller blade load case must link to exactly one propeller blade." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#propellerBladeLoadCaseBlade> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:TRF075LoadCaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPropellerBladeLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:node <urn:nltl:generated-shape:TRF075LoadCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasPropellerBladeLoadCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-075-F03/case> ] .

