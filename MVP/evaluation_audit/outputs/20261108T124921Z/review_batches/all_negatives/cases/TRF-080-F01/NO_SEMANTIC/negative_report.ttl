@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue> ;
                    sh:resultMessage "Node <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue>-><http://qudt.org/schema/qudt/unit> does not contain a value in the set: ['<http://qudt.org/schema/qudt/UNITLESS>']" ;
                    sh:resultPath <http://qudt.org/schema/qudt/unit> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/schema/qudt/UNITLESS> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "effectiveIceLoadCycleCount is required as a unitless quantity value." ;
            sh:resultPath <https://w3id.org/nltl/vocab#effectiveIceLoadCycleCount> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "effectiveIceLoadCycleCount is required as a unitless quantity value." ;
                    sh:minCount 1 ;
                    sh:node [ sh:property [ sh:hasValue <http://qudt.org/schema/qudt/UNITLESS> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#effectiveIceLoadCycleCount> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/effectiveIceLoadCycleCountValue> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ;
            sh:resultMessage "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "effectiveIceLoadCycleCount must equal iceLoadCycleCount multiplied by propellerBladeCount within a relative tolerance of 1e-6, with an absolute tolerance of 1e-6 near zero." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:iceLoadCycleCount ?iceCycles ;
                      nltl:propellerBladeCount ?bladeCount ;
                      nltl:effectiveIceLoadCycleCount ?resultNode .
                ?resultNode qudt:numericValue ?actual .

                BIND ((?iceCycles * ?bladeCount) AS ?expected)
                BIND (
                    IF(
                        ABS(?expected) < 0.001,
                        0.000001,
                        0.000001 * ABS(?expected)
                    )
                    AS ?tolerance
                )
                FILTER (ABS(?actual - ?expected) > ?tolerance)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF_080_StaticCalculationShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-g/TRF-080-F01/ship> ] .

