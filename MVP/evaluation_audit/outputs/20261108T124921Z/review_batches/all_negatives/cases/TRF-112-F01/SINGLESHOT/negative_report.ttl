@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ;
                    sh:resultMessage "The blade-failure load case shall provide the externally calculated combined axial, bending, and torsion load in kN." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#combinedAxialBendingTorsionLoad> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape [ sh:message "The blade-failure load case shall provide the externally calculated combined axial, bending, and torsion load in kN." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                                        [ sh:hasValue <http://qudt.org/vocab/unit/KiloN> ;
                                            sh:maxCount 1 ;
                                            sh:minCount 1 ;
                                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
                            sh:path <https://w3id.org/nltl/vocab#combinedAxialBendingTorsionLoad> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/ship> ;
            sh:resultMessage "The ship shall identify an applicable propulsion load case for the total blade-failure load." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasPropulsionLoadCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#loadCase> ;
                    sh:message "The ship shall identify an applicable propulsion load case for the total blade-failure load." ;
                    sh:minCount 1 ;
                    sh:node <urn:nltl:generated-shape:TRF112LoadCaseShape> ;
                    sh:path <https://w3id.org/nltl/vocab#hasPropulsionLoadCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-112-F01/loadCase> ] .

