@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:TRF112Shape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasPropellerShaftLineComponent ;
        sh:minCount 1 ;
        sh:node gen:TRF112ShaftComponentShape ;
        sh:message "The ship shall identify a propeller shaft line component with bending and torsional yield safety factors."
    ] ;
    sh:property [
        sh:path nltl:hasPropulsionLoadCase ;
        sh:minCount 1 ;
        sh:node gen:TRF112LoadCaseShape ;
        sh:message "The ship shall provide the applicable blade-failure propulsion load case and its required load inputs."
    ] .

gen:TRF112ShaftComponentShape
    a sh:NodeShape ;
    sh:class nltl:propellerShaftLineComponent ;
    sh:property [
        sh:path nltl:bendingYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF112BendingSafetyFactorValueShape ;
        sh:message "The propeller shaft line component shall have a bending yield safety factor of at least 1.0."
    ] ;
    sh:property [
        sh:path nltl:torsionalYieldSafetyFactor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF112TorsionalSafetyFactorValueShape ;
        sh:message "The propeller shaft line component shall have a torsional yield safety factor of at least 1.0."
    ] .

gen:TRF112LoadCaseShape
    a sh:NodeShape ;
    sh:class nltl:loadCase ;
    sh:property [
        sh:path nltl:shaftLineLoadCaseType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue nltl:bladeFailureLoadCase ;
        sh:message "The load case shall be explicitly identified as the total blade-failure load case."
    ] ;
    sh:property [
        sh:path nltl:bladeFailureUltimateLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF112ForceQuantityShape ;
        sh:message "The blade-failure load case shall provide the externally calculated ultimate load."
    ] ;
    sh:property [
        sh:path nltl:combinedAxialBendingTorsionLoad ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node gen:TRF112ForceQuantityShape ;
        sh:message "The blade-failure load case shall provide the externally calculated combined axial, bending, and torsion load."
    ] .

gen:TRF112ForceQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloN>
    ] .

gen:TRF112BendingSafetyFactorValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .

gen:TRF112TorsionalSafetyFactorValueShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue <http://qudt.org/vocab/unit/UNITLESS>
    ] .
