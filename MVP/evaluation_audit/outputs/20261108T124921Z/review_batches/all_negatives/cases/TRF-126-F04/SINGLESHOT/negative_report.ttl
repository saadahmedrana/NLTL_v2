@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F04/ship> ;
            sh:resultMessage "The propulsion astern-reversal state must be recorded, with at least 12 consecutive starts when reversal is required or at least 6 otherwise." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-126> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-126-F04/ship> ] .

