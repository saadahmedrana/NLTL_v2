@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-131-F02/ship> ;
            sh:resultMessage "The ship must have an inlet chest; a ballast-water cooling arrangement cannot replace it." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#inletChest> ;
                    sh:message "The ship must have an inlet chest; a ballast-water cooling arrangement cannot replace it." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] .

