@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F13/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/traficom-batch-j/TRF-133-F13/ship>-><https://w3id.org/nltl/vocab#iceClass>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#iceClass> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:in ( <https://w3id.org/nltl/vocab#iceClassIa> <https://w3id.org/nltl/vocab#iceClassIaSuper> <https://w3id.org/nltl/vocab#iceClassIb> <https://w3id.org/nltl/vocab#iceClassIc> <https://w3id.org/nltl/vocab#iceClassIi> <https://w3id.org/nltl/vocab#iceClassIii> ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#iceClass> ] ] .

