            "query": "\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n            PREFIX unit: <http://qudt.org/vocab/unit/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n            SELECT $this\n            WHERE {\n                $this nltl:ordinaryFrameScantlingsUsed true .\n                FILTER NOT EXISTS {\n                    $this nltl:span ?spanQuantity .\n                    ?spanQuantity qudt:numericValue ?spanValue ;\n                                   qudt:unit unit:M .\n                    $this nltl:frameSpanWithinIceStrengtheningZone ?iceQuantity .\n                    ?iceQuantity qudt:numericValue ?iceValue ;\n                                  qudt:unit unit:M .\n                    FILTER(\n                        datatype(?spanValue) = xsd:decimal &&\n                        datatype(?iceValue) = xsd:decimal &&\n                        ?spanValue > 0 &&\n                        ?iceValue < (?spanValue * 0.15)\n                    )\n                }\n            }\n        ",
