    sh:node _:n6ee03feccbbe4180bb4daea7ec8d2c9cb3 ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

[] rdf:first [ sh:property [ sh:datatype xsd:boolean ;
                    sh:hasValue false ;
                    sh:message "The astern ice operation intent must be explicitly recorded as false when the conditional design rule is not applicable." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#asternIceOperationIntent> ] ] ;
