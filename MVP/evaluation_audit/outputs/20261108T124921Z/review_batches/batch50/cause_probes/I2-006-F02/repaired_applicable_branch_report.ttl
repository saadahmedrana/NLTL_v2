@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ;
                    sh:resultMessage "For astern operation in ice regions, the aft section design basis must use the Bow and Bow Intermediate hull area requirements." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#aftSectionDesignBasis> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                            sh:message "For astern operation in ice regions, the aft section design basis must use the Bow and Bow Intermediate hull area requirements." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#aftSectionDesignBasis> ] ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ;
                    sh:resultMessage "For astern operation in ice regions, the applicable hull area requirement set must be the Bow and Bow Intermediate hull area requirements." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hullAreaRequirementSet> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:datatype xsd:string ;
                            sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                            sh:message "For astern operation in ice regions, the applicable hull area requirement set must be the Bow and Bow Intermediate hull area requirements." ;
                            sh:minCount 1 ;
                            sh:path <https://w3id.org/nltl/vocab#hullAreaRequirementSet> ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:message Literal(\"The astern ice operation intent must be explicitly recorded as true when the conditional design rule applies.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#asternIceOperationIntent> ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Bow and Bow Intermediate hull area requirements\") ; sh:message Literal(\"For astern operation in ice regions, the aft section design basis must use the Bow and Bow Intermediate hull area requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#aftSectionDesignBasis> ], [ sh:datatype xsd:string ; sh:hasValue Literal(\"Bow and Bow Intermediate hull area requirements\") ; sh:message Literal(\"For astern operation in ice regions, the applicable hull area requirement set must be the Bow and Bow Intermediate hull area requirements.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#hullAreaRequirementSet> ] ]. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:I2_006_ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-c/I2-006-F02/ship> ] .

