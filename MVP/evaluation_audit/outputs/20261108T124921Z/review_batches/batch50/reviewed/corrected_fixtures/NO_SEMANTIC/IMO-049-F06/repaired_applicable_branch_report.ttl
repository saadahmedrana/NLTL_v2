_:n3fa9e0be5d89446f843c925e94da1487b17 sh:datatype xsd:string ;
    sh:in _:N0351f80d47584910a4fcdf8426322b4a ;
    sh:message "The approval must use an Organization-acceptable standard or an equivalent-safety standard." ;
    sh:minCount 1 ;
