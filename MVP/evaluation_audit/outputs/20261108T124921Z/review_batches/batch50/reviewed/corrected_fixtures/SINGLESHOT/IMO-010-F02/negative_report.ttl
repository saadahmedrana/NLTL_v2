@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-010-F02/ship> ;
            sh:resultMessage "Less than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-010-F02/ship>-><https://w3id.org/nltl/vocab#maximumExpectedRescueTime>" ;
            sh:resultPath <https://w3id.org/nltl/vocab#maximumExpectedRescueTime> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:node [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
                            sh:property [ sh:hasValue <http://qudt.org/vocab/unit/DAY> ;
                                    sh:maxCount 1 ;
                                    sh:minCount 1 ;
                                    sh:path <http://qudt.org/schema/qudt/unit> ],
                                [ sh:datatype xsd:decimal ;
                                    sh:maxCount 1 ;
                                    sh:message "Maximum expected rescue time must be at least 5 days." ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 5.0 ;
                                    sh:path <http://qudt.org/schema/qudt/numericValue> ] ] ;
                    sh:path <https://w3id.org/nltl/vocab#maximumExpectedRescueTime> ] ] .

