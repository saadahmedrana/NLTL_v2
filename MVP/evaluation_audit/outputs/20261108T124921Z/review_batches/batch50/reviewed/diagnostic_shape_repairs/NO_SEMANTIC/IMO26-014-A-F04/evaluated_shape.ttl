@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO26-014-Ship>
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:path nltl:operatesOnlyInContinuousDaylight ;
            sh:datatype xsd:boolean ;
            sh:hasValue true ;
            sh:minCount 1
        ]
        [
            sh:path nltl:operatesOnlyInContinuousDaylight ;
            sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:minCount 1
        ]
        [
            sh:path nltl:visualIceDetectionIlluminationMeansCount ;
            sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:minInclusive 2
        ]
    ) ;
    sh:message "A ship not operating solely in continuous daylight must have at least two means of illumination for visual ice detection." .
