_:n8b68d7b2b51f4e1fb826a68fcfb779c2b13 <http://www.w3.org/ns/shacl#path> <http://qudt.org/schema/qudt/unit> .
_:n8b68d7b2b51f4e1fb826a68fcfb779c2b14 <http://www.w3.org/ns/shacl#select> "\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n            SELECT $this\n            WHERE {\n                $this nltl:iceClass ?ice ;\n                      nltl:calculatedRequiredPower ?calculatedNode ;\n                      nltl:maximumContinuousRatingPower ?maximumNode .\n                ?calculatedNode qudt:numericValue ?calculatedPower .\n                ?maximumNode qudt:numericValue ?maximumPower .\n                FILTER (\n                    (?ice IN (\n                        nltl:iceClassIa,\n                        nltl:iceClassIb,\n                        nltl:iceClassIc\n                    ) &&\n                    (?maximumPower < ?calculatedPower || ?maximumPower < 1000))\n                    ||\n                    (?ice = nltl:iceClassIaSuper &&\n                    (?maximumPower < ?calculatedPower || ?maximumPower < 2800))\n                )\n            }\n        " .
