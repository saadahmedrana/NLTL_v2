_:n738a690a6bee4a7e9b51fce25ff748b3b1 <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#IRI> .
_:n738a690a6bee4a7e9b51fce25ff748b3b14 <http://www.w3.org/ns/shacl#select> "\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n            SELECT $this\n            WHERE {\n                $this nltl:iceClass ?ice ;\n                      nltl:calculatedRequiredPower ?calculatedNode ;\n                      nltl:maximumContinuousRatingPower ?maximumNode .\n                ?calculatedNode qudt:numericValue ?calculatedPower .\n                ?maximumNode qudt:numericValue ?maximumPower .\n                FILTER (\n                    (?ice IN (\n                        nltl:iceClassIa,\n                        nltl:iceClassIb,\n                        nltl:iceClassIc\n                    ) &&\n                    (?maximumPower < ?calculatedPower || ?maximumPower < 1000))\n                    ||\n                    (?ice = nltl:iceClassIaSuper &&\n                    (?maximumPower < ?calculatedPower || ?maximumPower < 2800))\n                )\n            }\n        " .
