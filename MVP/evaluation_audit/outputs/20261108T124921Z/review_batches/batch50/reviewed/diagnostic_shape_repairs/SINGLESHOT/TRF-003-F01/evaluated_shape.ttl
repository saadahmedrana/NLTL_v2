@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:TRF-003> a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2012-01-01"^^xsd:date ;
                sh:maxExclusive "2019-01-01"^^xsd:date ;
                sh:message "A construction contract date from 1 January 2012 up to but not including 1 January 2019 is required to establish applicability."
            ] ;
            sh:property [
                sh:path nltl:applicableIceClassRegulationEdition ;
                sh:nodeKind sh:IRI ;
                sh:hasValue nltl:iceClassRegulationEdition2010 ;
                sh:minCount 1 ;
                sh:message "Ships contracted during the applicable period shall identify the 2010 Ice Class Regulations."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:maxExclusive "2012-01-01"^^xsd:date ;
                sh:message "A construction contract date before 1 January 2012 is outside the stated applicability period."
            ]
        ]
        [
            sh:property [
                sh:path nltl:constructionContractDate ;
                sh:datatype xsd:date ;
                sh:minCount 1 ;
                sh:minInclusive "2019-01-01"^^xsd:date ;
                sh:message "A construction contract date on or after 1 January 2019 is outside the stated applicability period."
            ]
        ]
    ) .
