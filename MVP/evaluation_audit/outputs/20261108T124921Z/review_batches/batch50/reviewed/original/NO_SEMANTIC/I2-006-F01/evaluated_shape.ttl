@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_006_ShipShape a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:or (
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue false ;
                sh:message "The astern ice operation intent must be explicitly recorded as false when the conditional design rule is not applicable."
            ]
        ]
        [
            sh:property [
                sh:path nltl:asternIceOperationIntent ;
                sh:datatype xsd:boolean ;
                sh:minCount 1 ;
                sh:hasValue true ;
                sh:message "The astern ice operation intent must be explicitly recorded as true when the conditional design rule applies."
            ] ;
            sh:property [
                sh:path nltl:aftSectionDesignBasis ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "For astern operation in ice regions, the aft section design basis must use the Bow and Bow Intermediate hull area requirements."
            ] ;
            sh:property [
                sh:path nltl:hullAreaRequirementSet ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:hasValue "Bow and Bow Intermediate hull area requirements" ;
                sh:message "For astern operation in ice regions, the applicable hull area requirement set must be the Bow and Bow Intermediate hull area requirements."
            ]
        ]
    ) .
