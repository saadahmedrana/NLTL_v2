@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:IMO-001-ShipShape> a sh:NodeShape ;
    sh:property [ sh:class nltl:iceConditionValue ;
            sh:message "A ship must provide its design ice condition to determine applicability of the Category A rule." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path nltl:designIceCondition ] ;
    sh:sparql [ sh:message "When the design ice condition is at least medium first-year ice with possible old-ice inclusions, the ship category must be Category A and must not include another category." ;
            sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            SELECT $this
            WHERE {
                $this nltl:designIceCondition
                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions .
                FILTER (
                    NOT EXISTS {
                        $this nltl:shipCategory nltl:polarShipCategoryA .
                    }
                    ||
                    EXISTS {
                        $this nltl:shipCategory ?category .
                        FILTER (?category != nltl:polarShipCategoryA)
                    }
                )
            }
        """ ] ;
    sh:targetClass nltl:ship .

