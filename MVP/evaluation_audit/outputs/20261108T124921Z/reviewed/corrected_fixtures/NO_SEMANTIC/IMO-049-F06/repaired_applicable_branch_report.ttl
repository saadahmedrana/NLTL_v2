_:nd6efdd09a85342b0837c55cf509943fbb17 sh:datatype xsd:string ;
    sh:in _:Nbdbeeba6835f475da5187f3664340902 ;
    sh:message "The approval must use an Organization-acceptable standard or an equivalent-safety standard." ;
    sh:minCount 1 ;
