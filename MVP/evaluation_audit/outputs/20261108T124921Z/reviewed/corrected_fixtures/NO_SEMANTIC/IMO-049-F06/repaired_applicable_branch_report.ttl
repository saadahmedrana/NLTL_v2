                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                                    sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb17 ;
                                    sh:value "standard acceptable to the Organization"^^xsd:string ],
                                [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/propellerApproval> ;
                                    sh:resultMessage "The approval must be by the Administration or a recognized organization accepted by the Administration." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvingAuthority> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                                    sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb14 ;
                                    sh:value "Administration"^^xsd:string ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/propeller> ;
                            sh:resultMessage "Each applicable machinery component must have approval evidence for its scantling." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasApprovalRecord> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb11 ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/propellerApproval> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049CategoryABComponentShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb7 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/propeller> ],
                [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaftApproval> ;
                                    sh:resultMessage "The approval must use an Organization-acceptable standard or an equivalent-safety standard." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvalStandard> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                                    sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb17 ;
                                    sh:value "standard acceptable to the Organization"^^xsd:string ],
                                [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaftApproval> ;
                                    sh:resultMessage "The approval must be by the Administration or a recognized organization accepted by the Administration." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvingAuthority> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                                    sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb14 ;
                                    sh:value "Administration"^^xsd:string ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaft> ;
                            sh:resultMessage "Each applicable machinery component must have approval evidence for its scantling." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasApprovalRecord> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb11 ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaftApproval> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049CategoryABComponentShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:nd6efdd09a85342b0837c55cf509943fbb7 ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaft> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049CategoryABShape>. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO049ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
            sh:resultMessage "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
            sh:resultPath <https://w3id.org/nltl/vocab#machineryComponentType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#machineryComponentType> ] ] .

_:N2cdc96af42724c5cb2ddbc746ec68071 rdf:first "recognized organization accepted by the Administration" ;
    rdf:rest () .

_:N6d98818e82ae48a0bb21970a15eb5a27 rdf:first "Administration" ;
    rdf:rest _:N2cdc96af42724c5cb2ddbc746ec68071 .

_:Nbdbeeba6835f475da5187f3664340902 rdf:first "standard acceptable to the Organization" ;
