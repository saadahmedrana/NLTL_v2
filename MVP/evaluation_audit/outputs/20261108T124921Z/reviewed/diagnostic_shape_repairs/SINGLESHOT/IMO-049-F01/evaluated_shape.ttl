@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/nltl/vocab#IMO049_Shape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryA> ;
                        sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
                    [ sh:node <https://w3id.org/nltl/vocab#IMO049_ABComponentShape> ;
                        sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryB> ;
                        sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
                    [ sh:node <https://w3id.org/nltl/vocab#IMO049_ABComponentShape> ;
                        sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ;
                        sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
                    [ sh:datatype xsd:boolean ;
                        sh:hasValue true ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ],
                    [ sh:node <https://w3id.org/nltl/vocab#IMO049_CComponentShape> ;
                        sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ;
                        sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
                    [ sh:datatype xsd:boolean ;
                        sh:hasValue false ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#shipCategory> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ( <https://w3id.org/nltl/vocab#hasComponent> <https://w3id.org/nltl/vocab#machineryComponentType> ) ] ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<https://w3id.org/nltl/vocab#IMO049_ABApprovalRecordShape> a sh:NodeShape ;
    sh:node <https://w3id.org/nltl/vocab#IMO049_ApprovalRecordShape> ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "Administration"^^xsd:string "recognized organization accepted by the Administration"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "Category A or B approval evidence must identify an authorized approving authority." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvingAuthority> ],
        [ sh:datatype xsd:string ;
            sh:in ( "standard acceptable to the Organization"^^xsd:string "another standard offering an equivalent level of safety"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "Category A or B approval evidence must identify an acceptable or equivalent-safety standard." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvalStandard> ] .

<https://w3id.org/nltl/vocab#IMO049_CApprovalRecordShape> a sh:NodeShape ;
    sh:node <https://w3id.org/nltl/vocab#IMO049_ApprovalRecordShape> ;
    sh:property [ sh:datatype xsd:string ;
            sh:hasValue "acceptable standard adequate for operating ice type and concentration"^^xsd:string ;
            sh:maxCount 1 ;
            sh:message "Ice-strengthened category C approval evidence must identify a standard adequate for the operating ice type and concentration." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvalStandard> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Ice-strengthened category C approval evidence must specify the operating ice type." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#operatingIceType> ],
        [ sh:maxCount 1 ;
            sh:message "Ice-strengthened category C approval evidence must specify the operating ice concentration." ;
            sh:minCount 1 ;
            sh:node <https://w3id.org/nltl/vocab#IMO049_IceConcentrationShape> ;
            sh:path <https://w3id.org/nltl/vocab#operatingIceConcentration> ],
        [ sh:datatype xsd:string ;
            sh:in ( "Administration"^^xsd:string "recognized organization accepted by the Administration"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "Ice-strengthened category C approval evidence must identify an authorized approving authority." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#approvingAuthority> ] .

<https://w3id.org/nltl/vocab#IMO049_CComponentShape> a sh:NodeShape ;
    sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
    sh:property [ sh:message "Each applicable ice-strengthened category C machinery component must have qualified approved scantling evidence." ;
            sh:minCount 1 ;
            sh:node <https://w3id.org/nltl/vocab#IMO049_CApprovalRecordShape> ;
            sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] .

<https://w3id.org/nltl/vocab#IMO049_IceConcentrationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://qudt.org/schema/qudt/numericValue> ],
        [ sh:hasValue <http://qudt.org/vocab/unit/UNITLESS> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <http://qudt.org/schema/qudt/unit> ] .

<https://w3id.org/nltl/vocab#IMO049_ABComponentShape> a sh:NodeShape ;
    sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
    sh:property [ sh:message "Each applicable category A or B machinery component must have an approved scantling approval record." ;
            sh:minCount 1 ;
            sh:node <https://w3id.org/nltl/vocab#IMO049_ABApprovalRecordShape> ;
            sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] .

<https://w3id.org/nltl/vocab#IMO049_ApprovalRecordShape> a sh:NodeShape ;
    sh:class <https://w3id.org/nltl/vocab#approvalRecord> ;
    sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#evidenceStateApproved> ;
            sh:maxCount 1 ;
            sh:message "Each applicable scantling approval record must have approved status." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/nltl/vocab#scantlingApprovalStatus> ] .

