@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/ship> ;
            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/ship> must conform to one or more shapes in [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryA> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ], [ sh:node <https://w3id.org/nltl/vocab#IMO049_ABComponentShape> ; sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] , [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryB> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ], [ sh:node <https://w3id.org/nltl/vocab#IMO049_ABComponentShape> ; sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"true\" = True, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ], [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ], [ sh:node <https://w3id.org/nltl/vocab#IMO049_CComponentShape> ; sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ] , [ sh:property [ sh:datatype xsd:boolean ; sh:hasValue Literal(\"false\" = False, datatype=xsd:boolean) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path <https://w3id.org/nltl/vocab#shipIceStrengthened> ], [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryC> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <https://w3id.org/nltl/vocab#IMO049_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F01/ship> ] .

