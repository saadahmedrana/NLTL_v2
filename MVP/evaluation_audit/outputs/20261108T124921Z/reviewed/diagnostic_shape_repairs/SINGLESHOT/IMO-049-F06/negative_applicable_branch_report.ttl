@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaftApproval> ;
                                    sh:resultMessage "Category A or B approval evidence must identify an authorized approving authority." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvingAuthority> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:in ( "Administration"^^xsd:string "recognized organization accepted by the Administration"^^xsd:string ) ;
                                            sh:maxCount 1 ;
                                            sh:message "Category A or B approval evidence must identify an authorized approving authority." ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#approvingAuthority> ] ;
                                    sh:value "manufacturer"^^xsd:string ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaft> ;
                            sh:resultMessage "Each applicable category A or B machinery component must have an approved scantling approval record." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasApprovalRecord> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:message "Each applicable category A or B machinery component must have an approved scantling approval record." ;
                                    sh:minCount 1 ;
                                    sh:node <https://w3id.org/nltl/vocab#IMO049_ABApprovalRecordShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaftApproval> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
                    sh:resultMessage "Value does not conform to Shape <https://w3id.org/nltl/vocab#IMO049_ABComponentShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:node <https://w3id.org/nltl/vocab#IMO049_ABComponentShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/shaft> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
            sh:resultMessage "Value does not conform to Shape [ sh:property [ sh:hasValue <https://w3id.org/nltl/vocab#polarShipCategoryA> ; sh:path <https://w3id.org/nltl/vocab#shipCategory> ], [ sh:node <https://w3id.org/nltl/vocab#IMO049_ABComponentShape> ; sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ]. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape <https://w3id.org/nltl/vocab#IMO049_Shape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship> ;
            sh:resultMessage "More than 1 values on <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F06/ship>->( <https://w3id.org/nltl/vocab#hasComponent> <https://w3id.org/nltl/vocab#machineryComponentType> )" ;
            sh:resultPath ( <https://w3id.org/nltl/vocab#hasComponent> <https://w3id.org/nltl/vocab#machineryComponentType> ) ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path ( <https://w3id.org/nltl/vocab#hasComponent> <https://w3id.org/nltl/vocab#machineryComponentType> ) ] ] .

