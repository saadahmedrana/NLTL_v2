@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> ;
            sh:resultMessage "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
            sh:resultPath <https://w3id.org/nltl/vocab#machineryComponentType> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:datatype xsd:string ;
                    sh:message "The ship must identify the machinery component type relevant to the scantling approval assessment." ;
                    sh:minCount 1 ;
                    sh:path <https://w3id.org/nltl/vocab#machineryComponentType> ] ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:detail [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendageApproval> ;
                                    sh:resultMessage "Ice-strengthened Category C approval evidence must state the operating ice type." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#operatingIceType> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:message "Ice-strengthened Category C approval evidence must state the operating ice type." ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#operatingIceType> ] ],
                                [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendageApproval> ;
                                    sh:resultMessage "The approval must be by the Administration or a recognized organization accepted by the Administration." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvingAuthority> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:InConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:in ( "Administration" "recognized organization accepted by the Administration" ) ;
                                            sh:message "The approval must be by the Administration or a recognized organization accepted by the Administration." ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#approvingAuthority> ] ;
                                    sh:value "Administration"^^xsd:string ],
                                [ a sh:ValidationResult ;
                                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendageApproval> ;
                                    sh:resultMessage "The approval must use an acceptable standard adequate for the operating ice type and concentration." ;
                                    sh:resultPath <https://w3id.org/nltl/vocab#approvalStandard> ;
                                    sh:resultSeverity sh:Violation ;
                                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                                    sh:sourceShape [ sh:datatype xsd:string ;
                                            sh:hasValue "acceptable standard adequate for operating ice type and concentration" ;
                                            sh:message "The approval must use an acceptable standard adequate for the operating ice type and concentration." ;
                                            sh:minCount 1 ;
                                            sh:path <https://w3id.org/nltl/vocab#approvalStandard> ] ] ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendage> ;
                            sh:resultMessage "Each applicable ice-strengthened Category C machinery component must have approval evidence for its scantling." ;
                            sh:resultPath <https://w3id.org/nltl/vocab#hasApprovalRecord> ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#approvalRecord> ;
                                    sh:message "Each applicable ice-strengthened Category C machinery component must have approval evidence for its scantling." ;
                                    sh:minCount 1 ;
                                    sh:node <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCApprovalShape> ;
                                    sh:path <https://w3id.org/nltl/vocab#hasApprovalRecord> ] ;
                            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendageApproval> ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> ;
                    sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCComponentShape>. See details for more information." ;
                    sh:resultPath <https://w3id.org/nltl/vocab#hasComponent> ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#shipComponent> ;
                            sh:node <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCComponentShape> ;
                            sh:path <https://w3id.org/nltl/vocab#hasComponent> ] ;
                    sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/appendage> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:IMO049IceStrengthenedCategoryCShape>. See details for more information." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO049ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-e/IMO-049-F04/ship> ] .

