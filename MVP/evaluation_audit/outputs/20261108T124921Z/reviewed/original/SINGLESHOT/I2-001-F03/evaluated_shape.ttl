@prefix gen: <urn:nltl:generated-shape:> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gen:I2_001_UR_I2_RevisionApplicabilityShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:minInclusive "2021-01-01"^^xsd:date ;
                        sh:path nltl:constructionContractDate ],
                    [ sh:hasValue true ;
                        sh:path nltl:urI2RevisionApplicability ] ] [ sh:property [ sh:maxExclusive "2021-01-01"^^xsd:date ;
                        sh:path nltl:constructionContractDate ],
                    [ sh:hasValue false ;
                        sh:path nltl:urI2RevisionApplicability ] ] ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "Each ship must provide one construction contract date to determine UR I2 Rev.4 applicability." ;
            sh:minCount 1 ;
            sh:path nltl:constructionContractDate ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "Each ship must provide one UR I2 Rev.4 applicability value." ;
            sh:minCount 1 ;
            sh:path nltl:urI2RevisionApplicability ] ;
    sh:targetClass nltl:ship .

