@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:nltl:generated-shape:I2_048_ShipShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#polarClassValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#polarClassPc1> <https://w3id.org/nltl/vocab#polarClassPc2> <https://w3id.org/nltl/vocab#polarClassPc3> <https://w3id.org/nltl/vocab#polarClassPc4> <https://w3id.org/nltl/vocab#polarClassPc5> <https://w3id.org/nltl/vocab#polarClassPc6> <https://w3id.org/nltl/vocab#polarClassPc7> ) ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#polarClass> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
            sh:node <urn:nltl:generated-shape:I2_048_CaseShape> ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ] ;
    sh:targetClass <https://w3id.org/nltl/vocab#ship> .

<urn:nltl:generated-shape:I2_048_CaseShape> a sh:NodeShape ;
    sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
    sh:property [ sh:class <https://w3id.org/nltl/vocab#plating> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#steelGradeRequirementCasePlating> ],
        [ sh:class <https://w3id.org/nltl/vocab#tableReferenceValue> ;
            sh:hasValue <https://w3id.org/nltl/vocab#iacsUrI2Table8> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#tableReference> ],
        [ sh:class <http://qudt.org/schema/qudt/QuantityValue> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#asBuiltPlateThickness> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelMaterialClassValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#steelMaterialClassOne> <https://w3id.org/nltl/vocab#steelMaterialClassTwo> <https://w3id.org/nltl/vocab#steelMaterialClassThree> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#steelMaterialClass> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelStrengthCategoryValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#normalStrengthSteelCategory> <https://w3id.org/nltl/vocab#highTensileSteelCategory> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#steelStrengthCategory> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelGradeValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#steelGradeAh> <https://w3id.org/nltl/vocab#steelGradeB> <https://w3id.org/nltl/vocab#steelGradeD> <https://w3id.org/nltl/vocab#steelGradeDh> <https://w3id.org/nltl/vocab#steelGradeE> <https://w3id.org/nltl/vocab#steelGradeEh> <https://w3id.org/nltl/vocab#steelGradeFh> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#actualHullStructuralSteelGrade> ],
        [ sh:class <https://w3id.org/nltl/vocab#steelGradeValue> ;
            sh:in ( <https://w3id.org/nltl/vocab#steelGradeAh> <https://w3id.org/nltl/vocab#steelGradeB> <https://w3id.org/nltl/vocab#steelGradeD> <https://w3id.org/nltl/vocab#steelGradeDh> <https://w3id.org/nltl/vocab#steelGradeE> <https://w3id.org/nltl/vocab#steelGradeEh> <https://w3id.org/nltl/vocab#steelGradeFh> ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/nltl/vocab#requiredHullStructuralSteelGrade> ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The required Table 8 grade is missing, incorrectly selected, or the actual grade is below the required rank for the applicable Polar Class, thickness, material class, and strength category." ;
            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  {
    ?ship nltl:hasSteelGradeRequirementCase $this ;
          nltl:polarClass ?pc .
    $this nltl:asBuiltPlateThickness ?q ;
          nltl:steelMaterialClass ?m ;
          nltl:steelStrengthCategory ?s ;
          nltl:actualHullStructuralSteelGrade ?a ;
          nltl:requiredHullStructuralSteelGrade ?r ;
          nltl:tableReference nltl:iacsUrI2Table8 .
    ?q qudt:numericValue ?t .
    ?a nltl:steelGradeOrderRank ?arank .
    ?r nltl:steelGradeOrderRank ?rrank .
    FILTER (
      (
        ?t > 0 && ?t <= 10 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?r = nltl:steelGradeAh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeEh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeAh
          )
        )
      ) ||
      (
        ?t > 10 && ?t <= 35 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeDh
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeAh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeEh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeDh
          )
        )
      ) ||
      (
        ?t > 35 && ?t <= 45 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeDh
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeAh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3
            ) &&
            ?r = nltl:steelGradeFh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc4, nltl:polarClassPc5,
              nltl:polarClassPc6, nltl:polarClassPc7
            ) &&
            ?r = nltl:steelGradeEh
          )
        )
      ) ||
      (
        ?t > 45 && ?t <= 50 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeEh
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeDh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeFh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeEh
          )
        )
      )
    )
    FILTER(?arank >= ?rrank)
  }
  UNION
  {
    ?ship nltl:hasSteelGradeRequirementCase $this ;
          nltl:polarClass ?pc .
    $this nltl:asBuiltPlateThickness ?q ;
          nltl:steelMaterialClass nltl:steelMaterialClassThree ;
          nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
          nltl:actualHullStructuralSteelGrade ?a ;
          nltl:tableReference nltl:iacsUrI2Table8 .
    ?q qudt:numericValue ?t .
    FILTER(?t > 35 && ?t <= 50)
    FILTER(?pc IN (
      nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
      nltl:polarClassPc4, nltl:polarClassPc5
    ))
    FILTER NOT EXISTS {
      $this nltl:requiredHullStructuralSteelGrade ?r
    }
  }
}
""" ] .

