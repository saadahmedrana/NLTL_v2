@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/case> ;
                    sh:resultMessage "The required Table 8 grade is missing, incorrectly selected, or the actual grade is below the required rank for the applicable Polar Class, thickness, material class, and strength category." ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraint [ a sh:SPARQLConstraint ;
                            sh:message "The required Table 8 grade is missing, incorrectly selected, or the actual grade is below the required rank for the applicable Polar Class, thickness, material class, and strength category." ;
                            sh:select """
PREFIX nltl: <https://w3id.org/nltl/vocab#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT $this
WHERE {
  {
    ?ship nltl:hasSteelGradeRequirementCase $this ;
          nltl:polarClass ?pc .
    $this nltl:asBuiltPlateThickness ?q ;
          nltl:steelMaterialClass ?m ;
          nltl:steelStrengthCategory ?s ;
          nltl:actualHullStructuralSteelGrade ?a ;
          nltl:requiredHullStructuralSteelGrade ?r ;
          nltl:tableReference nltl:iacsUrI2Table8 .
    ?q qudt:numericValue ?t .
    ?a nltl:steelGradeOrderRank ?arank .
    ?r nltl:steelGradeOrderRank ?rrank .
    FILTER (
      (
        ?t > 0 && ?t <= 10 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?r = nltl:steelGradeAh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeEh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeAh
          )
        )
      ) ||
      (
        ?t > 10 && ?t <= 35 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeDh
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeAh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeEh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeDh
          )
        )
      ) ||
      (
        ?t > 35 && ?t <= 45 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeB
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc4, nltl:polarClassPc5, nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeDh
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeAh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3
            ) &&
            ?r = nltl:steelGradeFh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc4, nltl:polarClassPc5,
              nltl:polarClassPc6, nltl:polarClassPc7
            ) &&
            ?r = nltl:steelGradeEh
          )
        )
      ) ||
      (
        ?t > 45 && ?t <= 50 &&
        (
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeD
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:normalStrengthSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeE
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeEh
          ) ||
          (
            ?m IN (nltl:steelMaterialClassOne, nltl:steelMaterialClassTwo) &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeDh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (
              nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
              nltl:polarClassPc4, nltl:polarClassPc5
            ) &&
            ?r = nltl:steelGradeFh
          ) ||
          (
            ?m = nltl:steelMaterialClassThree &&
            ?s = nltl:highTensileSteelCategory &&
            ?pc IN (nltl:polarClassPc6, nltl:polarClassPc7) &&
            ?r = nltl:steelGradeEh
          )
        )
      )
    )
    FILTER(?arank >= ?rrank)
  }
  UNION
  {
    ?ship nltl:hasSteelGradeRequirementCase $this ;
          nltl:polarClass ?pc .
    $this nltl:asBuiltPlateThickness ?q ;
          nltl:steelMaterialClass nltl:steelMaterialClassThree ;
          nltl:steelStrengthCategory nltl:normalStrengthSteelCategory ;
          nltl:actualHullStructuralSteelGrade ?a ;
          nltl:tableReference nltl:iacsUrI2Table8 .
    ?q qudt:numericValue ?t .
    FILTER(?t > 35 && ?t <= 50)
    FILTER(?pc IN (
      nltl:polarClassPc1, nltl:polarClassPc2, nltl:polarClassPc3,
      nltl:polarClassPc4, nltl:polarClassPc5
    ))
    FILTER NOT EXISTS {
      $this nltl:requiredHullStructuralSteelGrade ?r
    }
  }
}
""" ] ;
                    sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                    sh:sourceShape <urn:nltl:generated-shape:I2_048_CaseShape> ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/case> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/ship> ;
            sh:resultMessage "Value does not conform to Shape <urn:nltl:generated-shape:I2_048_CaseShape>. See details for more information." ;
            sh:resultPath <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class <https://w3id.org/nltl/vocab#steelGradeRequirementCase> ;
                    sh:node <urn:nltl:generated-shape:I2_048_CaseShape> ;
                    sh:nodeKind sh:IRI ;
                    sh:path <https://w3id.org/nltl/vocab#hasSteelGradeRequirementCase> ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-h/I2-048-H-F013/case> ] .

