@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/ship> ;
            sh:resultMessage "Each required access must have an associated ice or snow removal or prevention means." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "Each required access must have an associated ice or snow removal or prevention means." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>

            SELECT $this
            WHERE {
                $this nltl:hasRequiredAccessItem ?requiredAccessItem .
                FILTER NOT EXISTS {
                    $this nltl:hasEquipmentItem ?equipmentItem .
                    ?equipmentItem nltl:hasIceOrSnowRemovalOrPreventionMeans ?means .
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-052-ShipShape> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-f/IMO-052-F01/ship> ] .

