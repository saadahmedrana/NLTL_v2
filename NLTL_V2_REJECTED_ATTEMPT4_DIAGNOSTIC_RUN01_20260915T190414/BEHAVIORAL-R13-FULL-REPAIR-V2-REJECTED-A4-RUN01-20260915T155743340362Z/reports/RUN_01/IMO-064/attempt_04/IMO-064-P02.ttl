@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-P02/ship> ;
            sh:resultMessage "The approved thermal-protection adequacy evidence must be ship-specific and cover the ship's intended voyage, anticipated cold and wind, and applicable polar-water immersion." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The approved thermal-protection adequacy evidence must be ship-specific and cover the ship's intended voyage, anticipated cold and wind, and applicable polar-water immersion." ;
                    sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

            SELECT $this
            WHERE {
                $this nltl:thermalProtectionApprovalStatus nltl:evidenceStateApproved ;
                      nltl:intendedVoyage ?shipVoyage ;
                      nltl:anticipatedCold ?shipCold ;
                      nltl:anticipatedWind ?shipWind ;
                      nltl:immersionPotential ?shipImmersion .

                FILTER NOT EXISTS {
                    ?evidence a rdf:Statement ;
                              rdf:subject $this ;
                              rdf:predicate nltl:thermalProtectionApprovalStatus ;
                              rdf:object nltl:evidenceStateApproved ;
                              nltl:intendedVoyage ?evidenceVoyage ;
                              nltl:anticipatedCold ?evidenceCold ;
                              nltl:anticipatedWind ?evidenceWind ;
                              nltl:immersionPotential ?evidenceImmersion .

                    FILTER (
                        ?evidenceVoyage = ?shipVoyage &&
                        ?evidenceCold = ?shipCold &&
                        ?evidenceWind = ?shipWind &&
                        ?evidenceImmersion = ?shipImmersion
                    )
                }
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:IMO-064> ;
            sh:value <https://w3id.org/nltl/benchmark/imo-batch-g/IMO-064-P02/ship> ] .

