@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-120-F02/thrusterBody> ;
            sh:resultMessage "Node ex:thrusterBody must conform to one or more shapes in [ sh:message Literal(\"Each represented thruster body must have a natural-frequency calculation case.\") ; sh:property [ sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each represented thruster body must provide ship attachment stiffness in kilonewtons per metre.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:KiloN-PER-M ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:unit ] ] ; sh:path nltl:shipAttachmentStiffness ], [ sh:message Literal(\"Each represented thruster body must have a longitudinal natural-frequency calculation case.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ sh:class nltl:calculationCase ; sh:property [ sh:in ( nltl:longitudinalDirection nltl:transverseDirection ) ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:message Literal(\"Each natural-frequency calculation case must identify a longitudinal or transverse vibration direction.\") ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:vibrationDirection ] ] ; sh:path nltl:hasNaturalFrequencyCalculationCase ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:property [ sh:hasValue nltl:longitudinalDirection ; sh:path nltl:vibrationDirection ] ] ], [ sh:message Literal(\"Each represented thruster body must have a transverse natural-frequency calculation case.\") ; sh:path nltl:hasNaturalFrequencyCalculationCase ; sh:qualifiedMinCount Literal(\"1\", datatype=xsd:integer) ; sh:qualifiedValueShape [ sh:class nltl:calculationCase ; sh:property [ sh:hasValue nltl:transverseDirection ; sh:maxCount Literal(\"1\", datatype=xsd:integer) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path nltl:vibrationDirection ] ] ] ] , [ sh:property [ sh:maxCount Literal(\"0\", datatype=xsd:integer) ; sh:path nltl:hasNaturalFrequencyCalculationCase ] ]" ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape <urn:nltl:generated-shape:TRF-120-ThrusterBodyShape> ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-i/TRF-120-F02/thrusterBody> ] .

