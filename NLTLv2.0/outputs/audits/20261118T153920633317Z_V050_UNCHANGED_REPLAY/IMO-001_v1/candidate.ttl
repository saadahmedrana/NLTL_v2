@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

nltl:IMO001ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:property [
        sh:path nltl:designIceCondition ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:iceConditionValue ;
        sh:in (
            nltl:mediumFirstYearIceWithPossibleOldIceInclusions
        ) ;
        sh:minCount 1 ;
        sh:message "designIceCondition must be supplied and must use the canonical controlled value mediumFirstYearIceWithPossibleOldIceInclusions." ;
    ] ;

    sh:property [
        sh:path nltl:shipCategory ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:polarShipCategoryValue ;
        sh:message "shipCategory values must be IRIs of type polarShipCategoryValue." ;
    ] ;

    sh:sparql [
        sh:message "When designIceCondition is mediumFirstYearIceWithPossibleOldIceInclusions, shipCategory must be the canonical value polarShipCategoryA and must not contain another category value." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#designIceCondition>
                      <https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> .
                {
                    FILTER NOT EXISTS {
                        $this <https://w3id.org/nltl/vocab#shipCategory>
                              <https://w3id.org/nltl/vocab#polarShipCategoryA> .
                    }
                }
                UNION
                {
                    $this <https://w3id.org/nltl/vocab#shipCategory> ?category .
                    FILTER (
                        ?category !=
                        <https://w3id.org/nltl/vocab#polarShipCategoryA>
                    )
                }
            }
        """ ;
        sh:severity sh:Violation ;
    ] .
