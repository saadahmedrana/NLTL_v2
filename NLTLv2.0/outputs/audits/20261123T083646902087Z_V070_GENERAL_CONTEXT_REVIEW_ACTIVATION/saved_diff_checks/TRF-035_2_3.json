  "diff": "--- v2\n+++ v3\n@@ -1,5 +1,4 @@\n @prefix sh: <http://www.w3.org/ns/shacl#> .\n-@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n @prefix qudt: <http://qudt.org/schema/qudt/> .\n @prefix unit: <http://qudt.org/vocab/unit/> .\n @prefix nltl: <https://w3id.org/nltl/vocab#> .\n@@ -7,13 +6,7 @@\n [\n     a sh:NodeShape ;\n     sh:targetClass nltl:ship ;\n-    sh:property [\n-        sh:path nltl:classificationSociety ;\n-        sh:minCount 1 ;\n-        sh:maxCount 1 ;\n-        sh:datatype xsd:string ;\n-        sh:message \"TRF-035 clause 4.1.1: the ship's rule length is the rule length used by the classification society.\"@en\n-    ] ;\n+\n     sh:or (\n         [\n             sh:property [\n@@ -23,12 +16,6 @@\n                 sh:node [\n                     a sh:NodeShape ;\n                     sh:class qudt:QuantityValue ;\n-                    sh:property [\n-                        sh:path qudt:value ;\n-                        sh:minCount 1 ;\n-                        sh:maxCount 1 ;\n-                        sh:datatype xsd:decimal\n-                    ] ;\n                     sh:property [\n                         sh:path qudt:unit ;\n                         sh:minCount 1 ;\n@@ -47,12 +34,6 @@\n                     a sh:NodeShape ;\n                     sh:class qudt:QuantityValue ;\n                     sh:property [\n-                        sh:path qudt:value ;\n-                        sh:minCount 1 ;\n-                        sh:maxCount 1 ;\n-                        sh:datatype xsd:decimal\n-                    ] ;\n-                    sh:property [\n                         sh:path qudt:unit ;\n                         sh:minCount 1 ;\n                         sh:maxCount 1 ;\n@@ -62,5 +43,6 @@\n             ]\n         ]\n     ) ;\n-    sh:message \"TRF-035 clause 4.1.1: a ship rule length shall be represented as a metre-valued QUDT QuantityValue. The supplied mappings leave unresolved whether the canonical representation uses ruleLength or classificationSocietyRuleLength.\"@en\n+\n+    sh:message \"TRF-035 clause 4.1.1: L shall be represented as the ship's classification-society rule length, using one of the evidenced rule-length properties and a QUDT QuantityValue with unit metre.\"@en\n ] .\n",
