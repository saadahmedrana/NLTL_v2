{
  "every_candidate_preserved": true,
  "inventory_glob": "candidate_*.ttl",
  "include_last_rejected": true,
  "required_fields": [
    "version",
    "path",
    "sha256",
    "candidate_status",
    "findings_path_or_explicit_unavailable_reason",
    "run_terminal_reason",
    "operational_failure_reference"
  ],
  "selected_nltl": "First accepted=true history row if run status ACCEPTED and all integrity checks remain valid; otherwise NO_VERDICT",
  "external_scores_used_for_selection": false,
  "final_attempt_leniency": false,
  "fallback_acceptance": false,
  "human_review_arm": false,
  "diagnostics_label": "REJECTED_CANDIDATE_DIAGNOSTICS",
  "dispatch_closure_required_before_evaluation": true
}
