
            SELECT DISTINCT $this
            WHERE {
                {
                    SELECT ?focus ?resultValue (MAX(?caseValue) AS ?maximumCaseValue)
                    WHERE {
                        ?focus
                            <https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> ?resultQuantity ;
                            <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?case .

                        ?resultQuantity
                            <http://qudt.org/schema/qudt/numericValue> ?resultValue ;
                            <http://qudt.org/schema/qudt/unit>
                                <http://qudt.org/vocab/unit/KiloTON_Metric> .

                        ?case
                            <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?caseQuantity .

                        ?caseQuantity
                            <http://qudt.org/schema/qudt/numericValue> ?caseValue ;
                            <http://qudt.org/schema/qudt/unit>
                                <http://qudt.org/vocab/unit/KiloTON_Metric> .
                    }
                    GROUP BY ?focus ?resultValue
                }
                FILTER (?focus = $this)
                FILTER (?resultValue != ?maximumCaseValue)
            }
        