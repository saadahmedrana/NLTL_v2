@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:CanonicalKiloTonneQuantityShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A represented displacement quantity must have a canonical xsd:decimal numericValue."@en
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloTON_Metric> ;
        sh:minCount 1 ;
        sh:message "A represented displacement quantity must use the canonical kilotonne unit."@en
    ] .

nltl:UpperIceWaterlineShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:class nltl:upperIceWaterlineCase ;
        sh:nodeKind sh:IRI ;
        sh:node nltl:UpperIceWaterlineCaseShape ;
        sh:message "An upper ice waterline case must be an upperIceWaterlineCase resource."@en
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:class qudt:QuantityValue ;
        sh:node nltl:CanonicalKiloTonneQuantityShape ;
        sh:message "The upper ice waterline displacement must be represented as a canonical kilotonne quantity."@en
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes."@en ;
        sh:select """
            SELECT $this ?result
            WHERE {
                $this <https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> ?result .
                ?result <http://qudt.org/schema/qudt/numericValue> ?resultValue ;
                        <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/KiloTON_Metric> .

                $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?case .
                ?case <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?caseQuantity .
                ?caseQuantity <http://qudt.org/schema/qudt/numericValue> ?caseValue ;
                              <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/KiloTON_Metric> .

                FILTER (
                    ?caseValue > ?resultValue
                    ||
                    NOT EXISTS {
                        $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?equalCase .
                        ?equalCase <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?equalQuantity .
                        ?equalQuantity <http://qudt.org/schema/qudt/numericValue> ?equalValue ;
                                       <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?equalValue = ?resultValue)
                    }
                )
            }
        """
    ] .

nltl:UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:upperIceWaterlineCase ;
    sh:property [
        sh:path nltl:waterlineCaseDisplacement ;
        sh:class qudt:QuantityValue ;
        sh:node nltl:CanonicalKiloTonneQuantityShape ;
        sh:message "A waterline case displacement must be represented as a canonical kilotonne quantity."@en
    ] .

