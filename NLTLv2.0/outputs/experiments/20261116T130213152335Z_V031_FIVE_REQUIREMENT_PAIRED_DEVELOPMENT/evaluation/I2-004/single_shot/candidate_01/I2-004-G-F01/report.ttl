@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes."@en ;
                    sh:select """
            SELECT $this ?result
            WHERE {
                $this <https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> ?result .
                ?result <http://qudt.org/schema/qudt/numericValue> ?resultValue ;
                        <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/KiloTON_Metric> .

                $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?case .
                ?case <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?caseQuantity .
                ?caseQuantity <http://qudt.org/schema/qudt/numericValue> ?caseValue ;
                              <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/KiloTON_Metric> .

                FILTER (
                    ?caseValue > ?resultValue
                    ||
                    NOT EXISTS {
                        $this <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?equalCase .
                        ?equalCase <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?equalQuantity .
                        ?equalQuantity <http://qudt.org/schema/qudt/numericValue> ?equalValue ;
                                       <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?equalValue = ?resultValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:UpperIceWaterlineShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

