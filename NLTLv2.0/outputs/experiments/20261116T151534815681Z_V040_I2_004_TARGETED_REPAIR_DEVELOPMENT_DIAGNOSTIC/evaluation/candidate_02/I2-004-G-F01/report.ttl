@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest represented waterline case displacement, with all quantities expressed in canonical kilotonnes." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "The upper ice waterline displacement must equal the greatest represented waterline case displacement, with all quantities expressed in canonical kilotonnes." ;
                    sh:select """
            SELECT DISTINCT $this
            WHERE {
                {
                    SELECT ?this ?focus ?resultValue (MAX(?caseValue) AS ?maximumCaseValue)
                    WHERE {
                        ?focus
                            <https://w3id.org/nltl/vocab#upperIceWaterlineDisplacement> ?resultQuantity ;
                            <https://w3id.org/nltl/vocab#hasUpperIceWaterlineCase> ?case .

                        ?resultQuantity
                            <http://qudt.org/schema/qudt/numericValue> ?resultValue ;
                            <http://qudt.org/schema/qudt/unit>
                                <http://qudt.org/vocab/unit/KiloTON_Metric> .

                        ?case
                            <https://w3id.org/nltl/vocab#waterlineCaseDisplacement> ?caseQuantity .

                        ?caseQuantity
                            <http://qudt.org/schema/qudt/numericValue> ?caseValue ;
                            <http://qudt.org/schema/qudt/unit>
                                <http://qudt.org/vocab/unit/KiloTON_Metric> .
                    }
                    GROUP BY ?this ?focus ?resultValue
                }
                FILTER (?focus = $this)
                FILTER (?resultValue != ?maximumCaseValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipUpperIceWaterlineDisplacementShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

