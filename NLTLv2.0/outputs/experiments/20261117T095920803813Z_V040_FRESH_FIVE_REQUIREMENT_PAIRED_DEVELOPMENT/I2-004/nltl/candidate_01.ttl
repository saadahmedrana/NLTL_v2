@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:QuantityValueShape
    a sh:NodeShape ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:message "A represented displacement quantity must have a canonical decimal numeric value."
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:hasValue <http://qudt.org/vocab/unit/KiloTON_Metric> ;
        sh:minCount 1 ;
        sh:message "A represented displacement quantity must use the canonical kilotonne unit."
    ] .

nltl:UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:targetClass nltl:upperIceWaterlineCase ;
    sh:property [
        sh:path nltl:waterlineCaseDisplacement ;
        sh:class qudt:QuantityValue ;
        sh:node nltl:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "Each represented upper ice waterline case must have a waterline case displacement in canonical kilotonnes."
    ] .

nltl:ShipUpperIceWaterlineShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:class nltl:upperIceWaterlineCase ;
        sh:minCount 1 ;
        sh:message "A ship subject to the represented upper ice waterline calculation must have at least one represented upper ice waterline case."
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:class qudt:QuantityValue ;
        sh:node nltl:QuantityValueShape ;
        sh:minCount 1 ;
        sh:message "The ship displacement DUI must be represented as a canonical kilotonne quantity."
    ] ;
    sh:sparql [
        sh:message "The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes." ;
        sh:select """
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?result .
                ?result qudt:numericValue ?resultValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?case .
                        ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?caseValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?caseValue = ?resultValue)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
                        ?greaterQuantity qudt:numericValue ?greaterValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?greaterValue > ?resultValue)
                    }
                )
            }
        """ ;
    ] .
