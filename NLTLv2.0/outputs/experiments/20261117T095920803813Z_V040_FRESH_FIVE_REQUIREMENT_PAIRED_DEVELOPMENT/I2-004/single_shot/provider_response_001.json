{
  "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix shape: <urn:nltl:shape:I2-004:> .\n\nshape:QuantityValue a sh:NodeShape ;\n    sh:nodeKind sh:IRI ;\n    sh:class qudt:QuantityValue ;\n    sh:property [\n        sh:path qudt:numericValue ;\n        sh:datatype xsd:decimal ;\n        sh:minCount 1\n    ] ;\n    sh:property [\n        sh:path qudt:unit ;\n        sh:hasValue <http://qudt.org/vocab/unit/KiloTON_Metric> ;\n        sh:minCount 1\n    ] .\n\nshape:UpperIceWaterlineCase a sh:NodeShape ;\n    sh:nodeKind sh:IRI ;\n    sh:class nltl:upperIceWaterlineCase ;\n    sh:property [\n        sh:path nltl:waterlineCaseDisplacement ;\n        sh:node shape:QuantityValue ;\n        sh:minCount 1\n    ] .\n\nshape:Ship a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property [\n        sh:path nltl:hasUpperIceWaterlineCase ;\n        sh:node shape:UpperIceWaterlineCase ;\n        sh:minCount 1\n    ] ;\n    sh:property [\n        sh:path nltl:upperIceWaterlineDisplacement ;\n        sh:node shape:QuantityValue ;\n        sh:minCount 1\n    ] ;\n    sh:sparql [\n        sh:message \"The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes, as required by I2.1.2.2.\" ;\n        sh:severity sh:Violation ;\n        sh:select \"\"\"\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n\n            SELECT $this\n            WHERE {\n                $this nltl:upperIceWaterlineDisplacement ?result .\n                ?result qudt:numericValue ?resultValue .\n\n                FILTER NOT EXISTS {\n                    $this nltl:hasUpperIceWaterlineCase ?case .\n                    ?case nltl:waterlineCaseDisplacement ?operand .\n                    ?operand qudt:numericValue ?operandValue .\n                    FILTER (?resultValue < ?operandValue)\n                }\n\n                FILTER NOT EXISTS {\n                    $this nltl:hasUpperIceWaterlineCase ?caseWithMaximum .\n                    ?caseWithMaximum nltl:waterlineCaseDisplacement ?maximumOperand .\n                    ?maximumOperand qudt:numericValue ?maximumValue .\n                    FILTER (?resultValue = ?maximumValue)\n                }\n            }\n        \"\"\"\n    ] .\n<END_SHACL>",
