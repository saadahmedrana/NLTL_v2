            "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n\nnltl:IMO001ShipShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n\n    sh:property [\n        sh:path nltl:designIceCondition ;\n        sh:nodeKind sh:IRI ;\n        sh:class nltl:iceConditionValue ;\n        sh:minCount 1 ;\n        sh:in ( nltl:mediumFirstYearIceWithPossibleOldIceInclusions ) ;\n        sh:message \"designIceCondition must be supplied as an IRI of type iceConditionValue and must use the canonical controlled value mediumFirstYearIceWithPossibleOldIceInclusions.\" ;\n    ] ;\n\n    sh:property [\n        sh:path nltl:shipCategory ;\n        sh:nodeKind sh:IRI ;\n        sh:class nltl:polarShipCategoryValue ;\n        sh:message \"shipCategory values must be IRIs of type polarShipCategoryValue.\" ;\n    ] ;\n\n    sh:sparql [\n        sh:message \"When designIceCondition is mediumFirstYearIceWithPossibleOldIceInclusions, shipCategory must include the canonical value polarShipCategoryA.\" ;\n        sh:select \"\"\"\n            SELECT $this\n            WHERE {\n                $this <https://w3id.org/nltl/vocab#designIceCondition>\n                      <https://w3id.org/nltl/vocab#mediumFirstYearIceWithPossibleOldIceInclusions> .\n                FILTER NOT EXISTS {\n                    $this <https://w3id.org/nltl/vocab#shipCategory>\n                          <https://w3id.org/nltl/vocab#polarShipCategoryA> .\n                }\n            }\n        \"\"\" ;\n        sh:severity sh:Violation ;\n    ] .\n<END_SHACL>"
