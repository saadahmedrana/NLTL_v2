            "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n\nnltl:IMO001Shape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property [\n        sh:path nltl:designIceCondition ;\n        sh:nodeKind sh:IRI ;\n        sh:class nltl:iceConditionValue ;\n        sh:minCount 1 ;\n        sh:in (\n            nltl:mediumFirstYearIceWithPossibleOldIceInclusions\n        ) ;\n        sh:message \"A ship must supply the canonical design ice condition selector; the applicable selector is medium first-year ice with possible old-ice inclusions (IMO Polar Code, Introduction 2.1).\" ;\n    ] ;\n    sh:property [\n        sh:path nltl:shipCategory ;\n        sh:nodeKind sh:IRI ;\n        sh:class nltl:polarShipCategoryValue ;\n    ] ;\n    sh:sparql [\n        a sh:SPARQLConstraint ;\n        sh:select \"\"\"\n            SELECT $this\n            WHERE {\n                $this nltl:designIceCondition\n                    nltl:mediumFirstYearIceWithPossibleOldIceInclusions .\n                FILTER NOT EXISTS {\n                    $this nltl:shipCategory\n                        nltl:polarShipCategoryA .\n                }\n            }\n        \"\"\" ;\n        sh:message \"When designIceCondition is mediumFirstYearIceWithPossibleOldIceInclusions, shipCategory must include polarShipCategoryA (IMO Polar Code, Introduction 2.1).\" ;\n    ] .\n<END_SHACL>"
          }
