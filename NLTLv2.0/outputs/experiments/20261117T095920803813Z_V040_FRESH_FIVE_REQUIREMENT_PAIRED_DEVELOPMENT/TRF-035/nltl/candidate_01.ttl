@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:CanonicalMetreQuantityShape
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:hasValue unit:M ;
    ] .

nltl:ClassificationSocietyRuleLengthShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classificationSocietyRuleLength ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:node nltl:CanonicalMetreQuantityShape ;
    ] ;
    sh:property [
        sh:path nltl:ruleLength ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class qudt:QuantityValue ;
        sh:node nltl:CanonicalMetreQuantityShape ;
    ] ;
    sh:sparql [
        sh:message "ruleLength must equal classificationSocietyRuleLength as canonical metre QuantityValues." ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#ruleLength> ?result ;
                      <https://w3id.org/nltl/vocab#classificationSocietyRuleLength> ?operand .

                ?result
                    <http://qudt.org/schema/qudt/numericValue> ?resultValue ;
                    <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .

                ?operand
                    <http://qudt.org/schema/qudt/numericValue> ?operandValue ;
                    <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .

                FILTER (?resultValue != ?operandValue)
            }
        """ ;
    ] .

