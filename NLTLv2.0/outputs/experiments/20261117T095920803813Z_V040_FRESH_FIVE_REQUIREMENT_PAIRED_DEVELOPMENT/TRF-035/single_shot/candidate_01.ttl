@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:TRF035ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classificationSocietyRuleLength ;
        sh:minCount 1 ;
        sh:node nltl:TRF035LengthQuantityShape
    ] ;
    sh:property [
        sh:path nltl:ruleLength ;
        sh:minCount 1 ;
        sh:node nltl:TRF035LengthQuantityShape
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ruleLength must equal classificationSocietyRuleLength in canonical metres."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?result .
                ?result qudt:numericValue ?resultValue .

                $this nltl:classificationSocietyRuleLength ?operand .
                ?operand qudt:numericValue ?operandValue .

                FILTER (?resultValue != ?operandValue)
            }
        """
    ] .

nltl:TRF035LengthQuantityShape
    a sh:NodeShape ;
    sh:class qudt:QuantityValue ;
    sh:property [
        sh:path qudt:numericValue ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:hasValue unit:M
    ] .
