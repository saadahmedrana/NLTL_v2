@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ;
            sh:resultMessage "The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "The upper ice waterline displacement must equal the greatest represented waterline case displacement, in canonical kilotonnes." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?result .
                ?result qudt:numericValue ?resultValue ;
                        qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                FILTER (
                    NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?case .
                        ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                        ?caseQuantity qudt:numericValue ?caseValue ;
                                      qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?caseValue = ?resultValue)
                    }
                    ||
                    EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .
                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .
                        ?greaterQuantity qudt:numericValue ?greaterValue ;
                                         qudt:unit <http://qudt.org/vocab/unit/KiloTON_Metric> .
                        FILTER (?greaterValue > ?resultValue)
                    }
                )
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ShipUpperIceWaterlineShape ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F01/ship> ] .

