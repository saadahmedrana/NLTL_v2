@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ;
                    sh:resultMessage "A represented displacement quantity must use the canonical kilotonne unit." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape [ sh:hasValue <http://qudt.org/vocab/unit/KiloTON_Metric> ;
                            sh:message "A represented displacement quantity must use the canonical kilotonne unit." ;
                            sh:minCount 1 ;
                            sh:path qudt:unit ] ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "The ship displacement DUI must be represented as a canonical kilotonne quantity." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:message "The ship displacement DUI must be represented as a canonical kilotonne quantity." ;
                    sh:minCount 1 ;
                    sh:node nltl:QuantityValueShape ;
                    sh:path nltl:upperIceWaterlineDisplacement ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ] .

