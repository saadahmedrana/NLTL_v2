@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG." ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraint [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG." ;
                                    sh:select """
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        """ ] ;
                            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                            sh:sourceShape [ a sh:NodeShape ;
                                    sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:hasValue 7.0 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:DEG ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ;
                                    sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG." ;
                                            sh:select """
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        """ ] ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination>->qudt:unit does not contain a value in the set: ['qudt:DEG']" ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:hasValue qudt:DEG ;
                                    sh:minCount 1 ;
                                    sh:path qudt:unit ] ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:hasValue 7.0 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ;
                    sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:hasValue Literal("7", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:DEG ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ; sh:sparql [ sh:message Literal("The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG.") ; sh:select Literal("
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        ") ] ]. See details for more information.""" ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:hasValue 7.0 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue qudt:DEG ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ;
                                    sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG." ;
                                            sh:select """
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        """ ] ] ;
                            sh:path nltl:shellInclinationAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/ship> ;
            sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class nltl:hullBoundaryPoint ; sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:hasValue Literal("7", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue qudt:DEG ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ; sh:sparql [ sh:message Literal("The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG.") ; sh:select Literal("
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        ") ] ] ; sh:path nltl:shellInclinationAngle ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:class nltl:hullBoundaryPoint ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:hasValue 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue qudt:DEG ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ;
                                            sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG." ;
                                                    sh:select """
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        """ ] ] ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F03/boundaryPoint> ] .

