@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F04/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:hasBottomRegionLowerRegionBoundaryPoint" ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:class nltl:hullBoundaryPoint ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class qudt:QuantityValue ;
                                            sh:property [ sh:hasValue qudt:DEG ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:hasValue 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ] ;
                                            sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit qudt:DEG." ;
                                                    sh:select """
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unit .
                                    FILTER (?unit != qudt:DEG)
                                }
                            }
                        """ ] ] ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ] .

