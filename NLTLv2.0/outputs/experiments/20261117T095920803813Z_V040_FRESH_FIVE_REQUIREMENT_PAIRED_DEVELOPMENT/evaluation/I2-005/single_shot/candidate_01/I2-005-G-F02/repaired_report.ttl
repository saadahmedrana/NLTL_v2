@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
                            sh:resultMessage "Node <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination>->qudt:numericValue does not contain a value in the set: ['Literal(\"7\", datatype=xsd:decimal)']" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:hasValue 7.0 ;
                                    sh:minCount 1 ;
                                    sh:path qudt:numericValue ] ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ;
                    sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:hasValue Literal(\"7\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path qudt:unit ] ]. See details for more information." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:class qudt:QuantityValue ;
                            sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:property [ sh:hasValue unit:DEG ;
                                            sh:minCount 1 ;
                                            sh:nodeKind sh:IRI ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:hasValue 7.0 ;
                                            sh:minCount 1 ;
                                            sh:path qudt:numericValue ] ] ;
                            sh:nodeKind sh:IRI ;
                            sh:path nltl:shellInclinationAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/ship> ;
            sh:resultMessage "Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:property [ sh:class qudt:QuantityValue ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:property [ sh:datatype xsd:decimal ; sh:hasValue Literal(\"7\", datatype=xsd:decimal) ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:minCount Literal(\"1\", datatype=xsd:integer) ; sh:nodeKind sh:IRI ; sh:path qudt:unit ] ] ; sh:nodeKind sh:IRI ; sh:path nltl:shellInclinationAngle ] ]. See details for more information." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullBoundaryPoint ;
                    sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ sh:class qudt:QuantityValue ;
                                    sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:hasValue 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:DEG ;
                                                    sh:minCount 1 ;
                                                    sh:nodeKind sh:IRI ;
                                                    sh:path qudt:unit ] ] ;
                                    sh:nodeKind sh:IRI ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ] .

