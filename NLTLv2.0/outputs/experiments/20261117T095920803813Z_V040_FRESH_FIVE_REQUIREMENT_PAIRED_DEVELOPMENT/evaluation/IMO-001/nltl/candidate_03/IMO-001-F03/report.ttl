@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/imo-batch-a/IMO-001-F03/ship> ;
            sh:resultMessage "designIceCondition must be supplied as an IRI of type iceConditionValue and must be the canonical mediumFirstYearIceWithPossibleOldIceInclusions value." ;
            sh:resultPath nltl:designIceCondition ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class nltl:iceConditionValue ;
                    sh:in ( nltl:mediumFirstYearIceWithPossibleOldIceInclusions ) ;
                    sh:message "designIceCondition must be supplied as an IRI of type iceConditionValue and must be the canonical mediumFirstYearIceWithPossibleOldIceInclusions value." ;
                    sh:minCount 1 ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:designIceCondition ] ] .

