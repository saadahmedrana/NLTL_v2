@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "ruleLength must equal classificationSocietyRuleLength as canonical metre QuantityValues." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ sh:message "ruleLength must equal classificationSocietyRuleLength as canonical metre QuantityValues." ;
                    sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/nltl/vocab#ruleLength> ?result ;
                      <https://w3id.org/nltl/vocab#classificationSocietyRuleLength> ?operand .

                ?result
                    <http://qudt.org/schema/qudt/numericValue> ?resultValue ;
                    <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .

                ?operand
                    <http://qudt.org/schema/qudt/numericValue> ?operandValue ;
                    <http://qudt.org/schema/qudt/unit> <http://qudt.org/vocab/unit/M> .

                FILTER (?resultValue != ?operandValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:ClassificationSocietyRuleLengthShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ] .

