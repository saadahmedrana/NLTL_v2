@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F02/ship> ;
            sh:resultMessage "Less than 1 values on ex:ship->nltl:classificationSocietyRuleLength" ;
            sh:resultPath nltl:classificationSocietyRuleLength ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape [ sh:class qudt:QuantityValue ;
                    sh:minCount 1 ;
                    sh:node nltl:CanonicalMetreQuantityShape ;
                    sh:nodeKind sh:IRI ;
                    sh:path nltl:classificationSocietyRuleLength ] ] .

