@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ;
            sh:resultMessage "ruleLength must equal classificationSocietyRuleLength in canonical metres." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraint [ a sh:SPARQLConstraint ;
                    sh:message "ruleLength must equal classificationSocietyRuleLength in canonical metres."@en ;
                    sh:select """
            SELECT $this
            WHERE {
                $this nltl:ruleLength ?result .
                ?result qudt:numericValue ?resultValue .

                $this nltl:classificationSocietyRuleLength ?operand .
                ?operand qudt:numericValue ?operandValue .

                FILTER (?resultValue != ?operandValue)
            }
        """ ] ;
            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
            sh:sourceShape nltl:TRF035ShipShape ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-F01/ship> ] .

