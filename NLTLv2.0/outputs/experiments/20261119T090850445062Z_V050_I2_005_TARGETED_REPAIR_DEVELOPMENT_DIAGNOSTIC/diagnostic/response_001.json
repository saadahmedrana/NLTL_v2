{
  "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix unit: <http://qudt.org/vocab/unit/> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\nnltl:ShipBottomLowerRegionBoundaryShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property [\n        sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ;\n        sh:minCount 1 ;\n        sh:node [\n            a sh:NodeShape ;\n            sh:class nltl:hullBoundaryPoint ;\n            sh:property [\n                sh:path nltl:shellInclinationAngle ;\n                sh:minCount 1 ;\n                sh:node [\n                    a sh:NodeShape ;\n                    sh:class qudt:QuantityValue ;\n                    sh:property [\n                        sh:path qudt:numericValue ;\n                        sh:minCount 1 ;\n                        sh:datatype xsd:decimal ;\n                        sh:minInclusive \"7\"^^xsd:decimal ;\n                        sh:maxInclusive \"7\"^^xsd:decimal\n                    ] ;\n                    sh:property [\n                        sh:path qudt:unit ;\n                        sh:minCount 1 ;\n                        sh:hasValue unit:DEG\n                    ] ;\n                    sh:sparql [\n                        sh:message \"The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG.\" ;\n                        sh:select \"\"\"\n                            PREFIX qudt: <http://qudt.org/schema/qudt/>\n                            PREFIX unit: <http://qudt.org/vocab/unit/>\n                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n                            SELECT $this\n                            WHERE {\n                                {\n                                    $this qudt:numericValue ?value .\n                                    FILTER (?value != \"7\"^^xsd:decimal)\n                                }\n                                UNION\n                                {\n                                    $this qudt:unit ?unitValue .\n                                    FILTER (?unitValue != unit:DEG)\n                                }\n                            }\n                        \"\"\"\n                    ]\n                ]\n            ]\n        ]\n    ] .\n<END_SHACL>",
