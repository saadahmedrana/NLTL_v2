@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/inclination> ;
                            sh:resultMessage "The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG." ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraint [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG." ;
                                    sh:select """
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX unit: <http://qudt.org/vocab/unit/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unitValue .
                                    FILTER (?unitValue != unit:DEG)
                                }
                            }
                        """ ] ;
                            sh:sourceConstraintComponent sh:SPARQLConstraintComponent ;
                            sh:sourceShape [ a sh:NodeShape ;
                                    sh:class qudt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:maxInclusive 7.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 7.0 ;
                                            sh:path qudt:numericValue ],
                                        [ sh:hasValue unit:DEG ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ] ;
                                    sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG." ;
                                            sh:select """
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX unit: <http://qudt.org/vocab/unit/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unitValue .
                                    FILTER (?unitValue != unit:DEG)
                                }
                            }
                        """ ] ] ;
                            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/inclination> ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/inclination> ;
                            sh:resultMessage "Value is not >= Literal(\"7\", datatype=xsd:decimal)" ;
                            sh:resultPath qudt:numericValue ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
                            sh:sourceShape [ sh:datatype xsd:decimal ;
                                    sh:maxInclusive 7.0 ;
                                    sh:minCount 1 ;
                                    sh:minInclusive 7.0 ;
                                    sh:path qudt:numericValue ] ;
                            sh:value 6.9 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/boundaryPoint> ;
                    sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("7", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("7", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ; sh:sparql [ sh:message Literal("The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG.") ; sh:select Literal("
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX unit: <http://qudt.org/vocab/unit/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unitValue .
                                    FILTER (?unitValue != unit:DEG)
                                }
                            }
                        ") ] ]. See details for more information.""" ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:minCount 1 ;
                            sh:node [ a sh:NodeShape ;
                                    sh:class qudt:QuantityValue ;
                                    sh:property [ sh:hasValue unit:DEG ;
                                            sh:minCount 1 ;
                                            sh:path qudt:unit ],
                                        [ sh:datatype xsd:decimal ;
                                            sh:maxInclusive 7.0 ;
                                            sh:minCount 1 ;
                                            sh:minInclusive 7.0 ;
                                            sh:path qudt:numericValue ] ;
                                    sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG." ;
                                            sh:select """
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX unit: <http://qudt.org/vocab/unit/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unitValue .
                                    FILTER (?unitValue != unit:DEG)
                                }
                            }
                        """ ] ] ;
                            sh:path nltl:shellInclinationAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/ship> ;
            sh:resultMessage """Value does not conform to Shape [ rdf:type sh:NodeShape ; sh:class nltl:hullBoundaryPoint ; sh:property [ sh:minCount Literal("1", datatype=xsd:integer) ; sh:node [ rdf:type sh:NodeShape ; sh:class qudt:QuantityValue ; sh:property [ sh:datatype xsd:decimal ; sh:maxInclusive Literal("7", datatype=xsd:decimal) ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:minInclusive Literal("7", datatype=xsd:decimal) ; sh:path qudt:numericValue ], [ sh:hasValue unit:DEG ; sh:minCount Literal("1", datatype=xsd:integer) ; sh:path qudt:unit ] ; sh:sparql [ sh:message Literal("The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG.") ; sh:select Literal("
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX unit: <http://qudt.org/vocab/unit/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unitValue .
                                    FILTER (?unitValue != unit:DEG)
                                }
                            }
                        ") ] ] ; sh:path nltl:shellInclinationAngle ] ]. See details for more information.""" ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:minCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:class nltl:hullBoundaryPoint ;
                            sh:property [ sh:minCount 1 ;
                                    sh:node [ a sh:NodeShape ;
                                            sh:class qudt:QuantityValue ;
                                            sh:property [ sh:datatype xsd:decimal ;
                                                    sh:maxInclusive 7.0 ;
                                                    sh:minCount 1 ;
                                                    sh:minInclusive 7.0 ;
                                                    sh:path qudt:numericValue ],
                                                [ sh:hasValue unit:DEG ;
                                                    sh:minCount 1 ;
                                                    sh:path qudt:unit ] ;
                                            sh:sparql [ sh:message "The shell inclination angle quantity must have numericValue exactly 7 and unit http://qudt.org/vocab/unit/DEG." ;
                                                    sh:select """
                            PREFIX qudt: <http://qudt.org/schema/qudt/>
                            PREFIX unit: <http://qudt.org/vocab/unit/>
                            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
                            SELECT $this
                            WHERE {
                                {
                                    $this qudt:numericValue ?value .
                                    FILTER (?value != "7"^^xsd:decimal)
                                }
                                UNION
                                {
                                    $this qudt:unit ?unitValue .
                                    FILTER (?unitValue != unit:DEG)
                                }
                            }
                        """ ] ] ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F01/boundaryPoint> ] .

