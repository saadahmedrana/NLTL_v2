{
  "resources": {
    "schema": "schema/Schema_for_NLTL.ttl",
    "registry": "schema/term_registry.json",
    "contracts": "data/contracts/requirement_term_index.json",
    "requirements": "data/requirements/requirements.json",
    "examples": "data/examples/few_shot_pairs.jsonl",
    "enumeration_obligations": "data/contracts/enumeration_obligations.json",
    "controlled_value_registry": "schema/controlled_value_registry.json",
    "preflight_profiles": "data/contracts/development_preflight_profiles.json",
    "locked_representation_context": "schema/locked_representation_context.jsonld",
    "development_witness_contracts": "data/contracts/development_witness_contracts.json",
    "constraint_change_policy": "data/contracts/constraint_change_policy.json"
  },
  "model": "gpt-5.6-luna-2026-07-09",
  "generation_max_tokens": 16000,
  "review_max_tokens": 4000,
  "review_format_retries": 1,
  "review_max_issues": 12,
  "fresh_regeneration": false,
  "maximum_candidate_attempts": 6,
  "network_enabled": false,
  "semantic_review": true,
  "auxiliary_format_retries": "Reviewer-only; do not create candidates. Every code revision consumes a candidate attempt.",
  "attempt_definition": "Initial candidate plus all candidate revisions; at most six. No hidden syntax/code retries.",
  "witness_policy": "Schema runtime probe plus source/locked-contract-authored synthetic finite arithmetic and branch witnesses. No evaluation inputs; passing is not proof.",
  "output_policy": "New outputs/experiments/<experiment_id>; destination must not exist.",
  "method": "offline",
  "stagnation": {
    "enabled": false,
    "repeated_failure_set_limit": 3,
    "unchanged_candidate_limit": 2,
    "oscillation_limit": 1,
    "policy": "Detection/reporting always enabled. Stopping disabled by default; maximum candidate attempts unchanged."
  },
  "execution_failure_policy": {
    "candidate_query_errors": "Repair within configured attempt budget",
    "infrastructure_integrity_conflict": "STOP_DISPATCH",
    "timeout_resource_uncertain": "STOP_WITHOUT_ATTRIBUTION_OR_AUTOMATIC_RETRY"
  }
}
