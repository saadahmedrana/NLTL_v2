            "logprobs": [],
            "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix unit: <http://qudt.org/vocab/unit/> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\nnltl:QuantityValueShape\n    a sh:NodeShape ;\n    sh:class qudt:QuantityValue ;\n    sh:property [\n        sh:path qudt:value ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:datatype xsd:decimal ;\n        sh:message \"The displacement quantity value must be represented by exactly one xsd:decimal value.\"\n    ] ;\n    sh:property [\n        sh:path qudt:unit ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:hasValue unit:KiloTON_Metric ;\n        sh:message \"The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt).\"\n    ] .\n\nnltl:UpperIceWaterlineCaseShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:upperIceWaterlineCase ;\n    sh:property [\n        sh:path nltl:waterlineCaseDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:class qudt:QuantityValue ;\n        sh:node nltl:QuantityValueShape ;\n        sh:message \"Each upper ice waterline case must have exactly one displacement quantity in kt.\"\n    ] .\n\nnltl:ShipUpperIceWaterlineDisplacementShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property [\n        sh:path nltl:hasUpperIceWaterlineCase ;\n        sh:minCount 1 ;\n        sh:class nltl:upperIceWaterlineCase ;\n        sh:node nltl:UpperIceWaterlineCaseShape ;\n        sh:message \"The ship must identify at least one upper ice waterline case.\"\n    ] ;\n    sh:property [\n        sh:path nltl:upperIceWaterlineDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:class qudt:QuantityValue ;\n        sh:node nltl:QuantityValueShape ;\n        sh:message \"The ship must have exactly one upper ice waterline displacement quantity in kt.\"\n    ] ;\n    sh:sparql [\n        a sh:SPARQLConstraint ;\n        sh:message \"The ship displacement must be the displacement of a linked upper ice waterline case having the greatest displacement.\" ;\n        sh:select \"\"\"\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n            SELECT $this\n            WHERE {\n                $this nltl:upperIceWaterlineDisplacement ?shipQuantity .\n                ?shipQuantity qudt:value ?shipDisplacement .\n\n                FILTER (\n                    NOT EXISTS {\n                        $this nltl:hasUpperIceWaterlineCase ?equalCase .\n                        ?equalCase nltl:waterlineCaseDisplacement ?equalQuantity .\n                        ?equalQuantity qudt:value ?equalDisplacement .\n                        FILTER (\n                            xsd:decimal(str(?equalDisplacement)) =\n                            xsd:decimal(str(?shipDisplacement))\n                        )\n                    }\n                    ||\n                    EXISTS {\n                        $this nltl:hasUpperIceWaterlineCase ?greaterCase .\n                        ?greaterCase nltl:waterlineCaseDisplacement ?greaterQuantity .\n                        ?greaterQuantity qudt:value ?greaterDisplacement .\n                        FILTER (\n                            xsd:decimal(str(?greaterDisplacement)) >\n                            xsd:decimal(str(?shipDisplacement))\n                        )\n                    }\n                )\n            }\n        \"\"\"\n    ] .\n<END_SHACL>"
          }
