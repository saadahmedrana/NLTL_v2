@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2_004_QuantityValueShape
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path qudt:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "The displacement quantity value must be exactly one xsd:decimal value." ;
    ] ;
    sh:property [
        sh:path qudt:unit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue qudt:KiloTON_Metric ;
        sh:message "The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt)." ;
    ] .

nltl:I2_004_UpperIceWaterlineCaseShape
    a sh:NodeShape ;
    sh:class nltl:upperIceWaterlineCase ;
    sh:property [
        sh:path nltl:waterlineCaseDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_004_QuantityValueShape ;
        sh:message "Each upper ice waterline case must have exactly one displacement in kt." ;
    ] .

nltl:I2_004_ShipShape
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:hasUpperIceWaterlineCase ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class nltl:upperIceWaterlineCase ;
        sh:node nltl:I2_004_UpperIceWaterlineCaseShape ;
        sh:message "A ship must have at least one upper ice waterline case." ;
    ] ;
    sh:property [
        sh:path nltl:upperIceWaterlineDisplacement ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node nltl:I2_004_QuantityValueShape ;
        sh:message "The ship must have exactly one upper ice waterline displacement in kt." ;
    ] ;
    sh:sparql [
        sh:message "The ship displacement DUI must equal the displacement of the waterline case having the greatest displacement." ;
        sh:select """
            PREFIX nltl: <https://w3id.org/nltl/vocab#>
            PREFIX qudt: <http://qudt.org/schema/qudt/>

            SELECT $this
            WHERE {
                $this nltl:upperIceWaterlineDisplacement ?shipQuantity .
                ?shipQuantity qudt:value ?shipDisplacement .

                {
                    $this nltl:hasUpperIceWaterlineCase ?case .
                    ?case nltl:waterlineCaseDisplacement ?caseQuantity .
                    ?caseQuantity qudt:value ?caseDisplacement .
                    FILTER (?caseDisplacement > ?shipDisplacement)
                }
                UNION
                {
                    FILTER NOT EXISTS {
                        $this nltl:hasUpperIceWaterlineCase ?equalCase .
                        ?equalCase nltl:waterlineCaseDisplacement ?equalQuantity .
                        ?equalQuantity qudt:value ?equalDisplacement .
                        FILTER (?equalDisplacement = ?shipDisplacement)
                    }
                }
            }
        """ ;
    ] .
