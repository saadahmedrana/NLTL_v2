        "content": [
          {
            "type": "output_text",
            "annotations": [],
            "logprobs": [],
            "text": "<BEGIN_SHACL>\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\nnltl:I2_004_QuantityValueShape\n    a sh:NodeShape ;\n    sh:nodeKind sh:BlankNodeOrIRI ;\n    sh:property [\n        sh:path qudt:value ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:datatype xsd:decimal ;\n        sh:message \"The displacement quantity value must be exactly one xsd:decimal value.\" ;\n    ] ;\n    sh:property [\n        sh:path qudt:unit ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:hasValue qudt:KiloTON_Metric ;\n        sh:message \"The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt).\" ;\n    ] .\n\nnltl:I2_004_UpperIceWaterlineCaseShape\n    a sh:NodeShape ;\n    sh:class nltl:upperIceWaterlineCase ;\n    sh:property [\n        sh:path nltl:waterlineCaseDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:node nltl:I2_004_QuantityValueShape ;\n        sh:message \"Each upper ice waterline case must have exactly one displacement in kt.\" ;\n    ] .\n\nnltl:I2_004_ShipShape\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property [\n        sh:path nltl:hasUpperIceWaterlineCase ;\n        sh:minCount 1 ;\n        sh:nodeKind sh:IRI ;\n        sh:class nltl:upperIceWaterlineCase ;\n        sh:node nltl:I2_004_UpperIceWaterlineCaseShape ;\n        sh:message \"A ship must have at least one upper ice waterline case.\" ;\n    ] ;\n    sh:property [\n        sh:path nltl:upperIceWaterlineDisplacement ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:node nltl:I2_004_QuantityValueShape ;\n        sh:message \"The ship must have exactly one upper ice waterline displacement in kt.\" ;\n    ] ;\n    sh:sparql [\n        sh:message \"The ship displacement DUI must equal the displacement of the waterline case having the greatest displacement.\" ;\n        sh:select \"\"\"\n            PREFIX nltl: <https://w3id.org/nltl/vocab#>\n            PREFIX qudt: <http://qudt.org/schema/qudt/>\n\n            SELECT $this\n            WHERE {\n                $this nltl:upperIceWaterlineDisplacement ?shipQuantity .\n                ?shipQuantity qudt:value ?shipDisplacement .\n\n                {\n                    $this nltl:hasUpperIceWaterlineCase ?case .\n                    ?case nltl:waterlineCaseDisplacement ?caseQuantity .\n                    ?caseQuantity qudt:value ?caseDisplacement .\n                    FILTER (?caseDisplacement > ?shipDisplacement)\n                }\n                UNION\n                {\n                    FILTER NOT EXISTS {\n                        $this nltl:hasUpperIceWaterlineCase ?equalCase .\n                        ?equalCase nltl:waterlineCaseDisplacement ?equalQuantity .\n                        ?equalQuantity qudt:value ?equalDisplacement .\n                        FILTER (?equalDisplacement = ?shipDisplacement)\n                    }\n                }\n            }\n        \"\"\" ;\n    ] .\n<END_SHACL>"
          }
        ],
