@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

[
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;
    sh:property [
        sh:path nltl:classificationSociety ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TRF-035 clause 4.1.1: the ship's rule length is the rule length used by the classification society."@en
    ] ;
    sh:or (
        [
            sh:property [
                sh:path nltl:ruleLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:value ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:classificationSocietyRuleLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:value ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:datatype xsd:decimal
                    ] ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
    ) ;
    sh:message "TRF-035 clause 4.1.1: a ship rule length shall be represented as a metre-valued QUDT QuantityValue. The supplied mappings leave unresolved whether the canonical representation uses ruleLength or classificationSocietyRuleLength."@en
] .
