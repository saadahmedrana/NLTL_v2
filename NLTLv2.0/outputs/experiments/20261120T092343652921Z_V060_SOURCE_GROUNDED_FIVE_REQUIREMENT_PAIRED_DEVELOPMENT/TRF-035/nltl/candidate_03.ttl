@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix nltl: <https://w3id.org/nltl/vocab#> .

[
    a sh:NodeShape ;
    sh:targetClass nltl:ship ;

    sh:or (
        [
            sh:property [
                sh:path nltl:ruleLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
        [
            sh:property [
                sh:path nltl:classificationSocietyRuleLength ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node [
                    a sh:NodeShape ;
                    sh:class qudt:QuantityValue ;
                    sh:property [
                        sh:path qudt:unit ;
                        sh:minCount 1 ;
                        sh:maxCount 1 ;
                        sh:hasValue unit:M
                    ]
                ]
            ]
        ]
    ) ;

    sh:message "TRF-035 clause 4.1.1: L shall be represented as the ship's classification-society rule length, using one of the evidenced rule-length properties and a QUDT QuantityValue with unit metre."@en
] .
