  "text": "<BEGIN_SHACL>\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix unit: <http://qudt.org/vocab/unit/> .\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n\n[\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n    sh:property [\n        sh:path nltl:classificationSociety ;\n        sh:minCount 1 ;\n        sh:maxCount 1 ;\n        sh:datatype xsd:string ;\n        sh:message \"TRF-035 clause 4.1.1: the ship's rule length is the rule length used by the classification society.\"@en\n    ] ;\n    sh:or (\n        [\n            sh:property [\n                sh:path nltl:ruleLength ;\n                sh:minCount 1 ;\n                sh:maxCount 1 ;\n                sh:node [\n                    a sh:NodeShape ;\n                    sh:class qudt:QuantityValue ;\n                    sh:property [\n                        sh:path qudt:value ;\n                        sh:minCount 1 ;\n                        sh:maxCount 1 ;\n                        sh:datatype xsd:decimal\n                    ] ;\n                    sh:property [\n                        sh:path qudt:unit ;\n                        sh:minCount 1 ;\n                        sh:maxCount 1 ;\n                        sh:hasValue unit:M\n                    ]\n                ]\n            ]\n        ]\n        [\n            sh:property [\n                sh:path nltl:classificationSocietyRuleLength ;\n                sh:minCount 1 ;\n                sh:maxCount 1 ;\n                sh:node [\n                    a sh:NodeShape ;\n                    sh:class qudt:QuantityValue ;\n                    sh:property [\n                        sh:path qudt:value ;\n                        sh:minCount 1 ;\n                        sh:maxCount 1 ;\n                        sh:datatype xsd:decimal\n                    ] ;\n                    sh:property [\n                        sh:path qudt:unit ;\n  