  "text": "<BEGIN_SHACL>\n@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix qudt: <http://qudt.org/schema/qudt/> .\n@prefix unit: <http://qudt.org/vocab/unit/> .\n@prefix nltl: <https://w3id.org/nltl/vocab#> .\n\n[\n    a sh:NodeShape ;\n    sh:targetClass nltl:ship ;\n\n    sh:or (\n        [\n            sh:property [\n                sh:path nltl:ruleLength ;\n                sh:minCount 1 ;\n                sh:maxCount 1 ;\n                sh:node [\n                    a sh:NodeShape ;\n                    sh:class qudt:QuantityValue ;\n                    sh:property [\n                        sh:path qudt:unit ;\n                        sh:minCount 1 ;\n                        sh:maxCount 1 ;\n                        sh:hasValue unit:M\n                    ]\n                ]\n            ]\n        ]\n        [\n            sh:property [\n                sh:path nltl:classificationSocietyRuleLength ;\n                sh:minCount 1 ;\n                sh:maxCount 1 ;\n                sh:node [\n                    a sh:NodeShape ;\n                    sh:class qudt:QuantityValue ;\n                    sh:property [\n                        sh:path qudt:unit ;\n                        sh:minCount 1 ;\n                        sh:maxCount 1 ;\n                        sh:hasValue unit:M\n                    ]\n                ]\n            ]\n        ]\n    ) ;\n\n    sh:message \"TRF-035 clause 4.1.1: L shall be represented as the ship's classification-society rule length, using one of the evidenced rule-length properties and a QUDT QuantityValue with unit metre.\"@en\n] .\n<END_SHACL>",
