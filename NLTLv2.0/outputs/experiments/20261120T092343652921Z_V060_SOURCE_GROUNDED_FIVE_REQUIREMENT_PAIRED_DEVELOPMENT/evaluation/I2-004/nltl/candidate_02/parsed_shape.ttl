@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:ShipUpperIceWaterlineDisplacementShape a sh:NodeShape ;
    sh:property [ sh:class nltl:upperIceWaterlineCase ;
            sh:message "The ship must identify at least one upper ice waterline case." ;
            sh:minCount 1 ;
            sh:node nltl:UpperIceWaterlineCaseShape ;
            sh:path nltl:hasUpperIceWaterlineCase ],
        [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:message "The ship must have exactly one upper ice waterline displacement quantity." ;
            sh:minCount 1 ;
            sh:node nltl:QuantityValueShape ;
            sh:path nltl:upperIceWaterlineDisplacement ] ;
    sh:targetClass nltl:ship .

nltl:UpperIceWaterlineCaseShape a sh:NodeShape ;
    sh:property [ sh:class qudt:QuantityValue ;
            sh:maxCount 1 ;
            sh:message "Each upper ice waterline case must have exactly one displacement quantity." ;
            sh:minCount 1 ;
            sh:node nltl:QuantityValueShape ;
            sh:path nltl:waterlineCaseDisplacement ] ;
    sh:targetClass nltl:upperIceWaterlineCase .

nltl:QuantityValueShape a sh:NodeShape ;
    sh:class qudt:QuantityValue .

