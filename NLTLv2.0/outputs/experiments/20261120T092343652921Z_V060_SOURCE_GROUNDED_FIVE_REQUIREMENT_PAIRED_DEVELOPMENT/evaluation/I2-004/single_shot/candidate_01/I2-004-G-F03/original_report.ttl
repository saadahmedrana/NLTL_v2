@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ;
                    sh:resultMessage "The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt)." ;
                    sh:resultPath qudt:unit ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                    sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb2 ],
                [ a sh:ValidationResult ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ;
                    sh:resultMessage "The displacement quantity value must be exactly one xsd:decimal value." ;
                    sh:resultPath qudt:value ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                    sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb1 ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "The ship must have exactly one upper ice waterline displacement in kt." ;
            sh:resultPath nltl:upperIceWaterlineDisplacement ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:maxCount 1 ;
                    sh:message "The ship must have exactly one upper ice waterline displacement in kt." ;
                    sh:minCount 1 ;
                    sh:node nltl:I2_004_QuantityValueShape ;
                    sh:path nltl:upperIceWaterlineDisplacement ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/selectedDui> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp2> ;
                            sh:resultMessage "The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt)." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb2 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp2> ;
                            sh:resultMessage "The displacement quantity value must be exactly one xsd:decimal value." ;
                            sh:resultPath qudt:value ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb1 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase2> ;
                    sh:resultMessage "Each upper ice waterline case must have exactly one displacement in kt." ;
                    sh:resultPath nltl:waterlineCaseDisplacement ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp2> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "A ship must have at least one upper ice waterline case." ;
            sh:resultPath nltl:hasUpperIceWaterlineCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb4 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase2> ],
        [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp1> ;
                            sh:resultMessage "The displacement quantity value must be exactly one xsd:decimal value." ;
                            sh:resultPath qudt:value ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb1 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp1> ;
                            sh:resultMessage "The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt)." ;
                            sh:resultPath qudt:unit ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb2 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase1> ;
                    sh:resultMessage "Each upper ice waterline case must have exactly one displacement in kt." ;
                    sh:resultPath nltl:waterlineCaseDisplacement ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb3 ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/caseDisp1> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/ship> ;
            sh:resultMessage "A ship must have at least one upper ice waterline case." ;
            sh:resultPath nltl:hasUpperIceWaterlineCase ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape _:ne4804f281f7d41a8a67bad690462b0adb4 ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-004-F03/waterlineCase1> ] .

_:ne4804f281f7d41a8a67bad690462b0adb3 sh:maxCount 1 ;
    sh:message "Each upper ice waterline case must have exactly one displacement in kt." ;
    sh:minCount 1 ;
    sh:node nltl:I2_004_QuantityValueShape ;
    sh:path nltl:waterlineCaseDisplacement .

_:ne4804f281f7d41a8a67bad690462b0adb4 sh:class nltl:upperIceWaterlineCase ;
    sh:message "A ship must have at least one upper ice waterline case." ;
    sh:minCount 1 ;
    sh:node nltl:I2_004_UpperIceWaterlineCaseShape ;
    sh:nodeKind sh:IRI ;
    sh:path nltl:hasUpperIceWaterlineCase .

_:ne4804f281f7d41a8a67bad690462b0adb1 sh:datatype xsd:decimal ;
    sh:maxCount 1 ;
    sh:message "The displacement quantity value must be exactly one xsd:decimal value." ;
    sh:minCount 1 ;
    sh:path qudt:value .

_:ne4804f281f7d41a8a67bad690462b0adb2 sh:hasValue qudt:KiloTON_Metric ;
    sh:maxCount 1 ;
    sh:message "The displacement quantity must use http://qudt.org/vocab/unit/KiloTON_Metric (kt)." ;
    sh:minCount 1 ;
    sh:path qudt:unit .

