@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qdt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:detail [ a sh:ValidationResult ;
                    sh:detail [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
                            sh:resultMessage "The shell inclination angle at the bottom/lower region boundary point must be 7 degrees." ;
                            sh:resultPath qdt:value ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
                            sh:sourceShape _:n59a57303ad0d4c12bc47de3a7dd86dbfb5 ],
                        [ a sh:ValidationResult ;
                            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ;
                            sh:resultMessage "The shell inclination angle at the bottom/lower region boundary point must be 7 degrees." ;
                            sh:resultPath qdt:value ;
                            sh:resultSeverity sh:Violation ;
                            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
                            sh:sourceShape _:n59a57303ad0d4c12bc47de3a7dd86dbfb5 ] ;
                    sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ;
                    sh:resultMessage "The bottom/lower region boundary point must specify the shell inclination angle." ;
                    sh:resultPath nltl:shellInclinationAngle ;
                    sh:resultSeverity sh:Violation ;
                    sh:sourceConstraintComponent sh:NodeConstraintComponent ;
                    sh:sourceShape [ sh:message "The bottom/lower region boundary point must specify the shell inclination angle." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qdt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:hasValue 7.0 ;
                                            sh:message "The shell inclination angle at the bottom/lower region boundary point must be 7 degrees." ;
                                            sh:minCount 1 ;
                                            sh:path qdt:value ],
                                        [ sh:hasValue qudt-unit:DEG ;
                                            sh:message "The shell inclination angle must use the canonical degree unit." ;
                                            sh:minCount 1 ;
                                            sh:path qdt:unit ] ] ;
                            sh:path nltl:shellInclinationAngle ] ;
                    sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/inclination> ] ;
            sh:focusNode <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/ship> ;
            sh:resultMessage "The ship must have a bottom/lower region boundary point where the shell is inclined 7 degrees from horizontal." ;
            sh:resultPath nltl:hasBottomRegionLowerRegionBoundaryPoint ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:NodeConstraintComponent ;
            sh:sourceShape [ sh:class nltl:hullBoundaryPoint ;
                    sh:message "The ship must have a bottom/lower region boundary point where the shell is inclined 7 degrees from horizontal." ;
                    sh:minCount 1 ;
                    sh:node [ sh:message "The linked resource must be a hull boundary point with a shell inclination angle of 7 degrees." ;
                            sh:property [ sh:message "The bottom/lower region boundary point must specify the shell inclination angle." ;
                                    sh:minCount 1 ;
                                    sh:node [ sh:class qdt:QuantityValue ;
                                            sh:property [ sh:hasValue qudt-unit:DEG ;
                                                    sh:message "The shell inclination angle must use the canonical degree unit." ;
                                                    sh:minCount 1 ;
                                                    sh:path qdt:unit ],
                                                [ sh:datatype xsd:decimal ;
                                                    sh:hasValue 7.0 ;
                                                    sh:message "The shell inclination angle at the bottom/lower region boundary point must be 7 degrees." ;
                                                    sh:minCount 1 ;
                                                    sh:path qdt:value ] ] ;
                                    sh:path nltl:shellInclinationAngle ] ] ;
                    sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
            sh:value <https://w3id.org/nltl/benchmark/i2-batch-g/I2-005-F02/boundaryPoint> ] .

_:n59a57303ad0d4c12bc47de3a7dd86dbfb5 sh:datatype xsd:decimal ;
    sh:hasValue 7.0 ;
    sh:message "The shell inclination angle at the bottom/lower region boundary point must be 7 degrees." ;
    sh:minCount 1 ;
    sh:path qdt:value .

