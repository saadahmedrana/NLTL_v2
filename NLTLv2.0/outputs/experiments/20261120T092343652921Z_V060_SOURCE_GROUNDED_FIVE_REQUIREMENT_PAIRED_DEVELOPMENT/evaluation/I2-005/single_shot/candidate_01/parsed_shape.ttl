@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qdt: <http://qudt.org/schema/qudt/> .
@prefix qudt-unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nltl:I2_005_ShipShape a sh:NodeShape ;
    sh:property [ sh:class nltl:hullBoundaryPoint ;
            sh:message "The ship must have a bottom/lower region boundary point where the shell is inclined 7 degrees from horizontal." ;
            sh:minCount 1 ;
            sh:node [ sh:message "The linked resource must be a hull boundary point with a shell inclination angle of 7 degrees." ;
                    sh:property [ sh:message "The bottom/lower region boundary point must specify the shell inclination angle." ;
                            sh:minCount 1 ;
                            sh:node [ sh:class qdt:QuantityValue ;
                                    sh:property [ sh:datatype xsd:decimal ;
                                            sh:hasValue 7.0 ;
                                            sh:message "The shell inclination angle at the bottom/lower region boundary point must be 7 degrees." ;
                                            sh:minCount 1 ;
                                            sh:path qdt:value ],
                                        [ sh:hasValue qudt-unit:DEG ;
                                            sh:message "The shell inclination angle must use the canonical degree unit." ;
                                            sh:minCount 1 ;
                                            sh:path qdt:unit ] ] ;
                            sh:path nltl:shellInclinationAngle ] ] ;
            sh:path nltl:hasBottomRegionLowerRegionBoundaryPoint ] ;
    sh:targetClass nltl:ship .

