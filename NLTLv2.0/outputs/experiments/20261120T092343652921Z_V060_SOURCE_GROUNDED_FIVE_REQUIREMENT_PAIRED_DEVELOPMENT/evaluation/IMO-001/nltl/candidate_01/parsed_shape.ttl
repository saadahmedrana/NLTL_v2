@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vocab:IMO-001-CategoryAShipShape a sh:NodeShape ;
    sh:description "Representation constraints for a ship described by IMO Polar Code Introduction 2.1. Applicability is not targeted here because the source definition does not bind an owner instance or provide an applicability condition."@en ;
    sh:name "Category A ship representation"@en ;
    sh:property [ a sh:PropertyShape ;
            sh:class vocab:polarShipCategoryValue ;
            sh:hasValue vocab:polarShipCategoryA ;
            sh:message "A Category A ship representation must have shipCategory equal to Category A."@en ;
            sh:minCount 1 ;
            sh:path vocab:shipCategory ],
        [ a sh:PropertyShape ;
            sh:class vocab:iceConditionValue ;
            sh:hasValue vocab:mediumFirstYearIceWithPossibleOldIceInclusions ;
            sh:message "A Category A ship representation must have designIceCondition equal to medium first-year ice with possible old-ice inclusions."@en ;
            sh:minCount 1 ;
            sh:path vocab:designIceCondition ] .

