@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://w3id.org/nltl/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vocab:CategoryAShipRepresentationShape a sh:NodeShape ;
    sh:property [ sh:class vocab:polarShipCategoryValue ;
            sh:hasValue vocab:polarShipCategoryA ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vocab:shipCategory ],
        [ sh:class vocab:iceConditionValue ;
            sh:hasValue vocab:mediumFirstYearIceWithPossibleOldIceInclusions ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path vocab:designIceCondition ] .

