@prefix nltl: <https://w3id.org/nltl/vocab#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-P02/ship> ;
            sh:resultMessage "TRF-035 clause 4.1.1: a ship rule length shall be represented as a metre-valued QUDT QuantityValue. The supplied mappings leave unresolved whether the canonical representation uses ruleLength or classificationSocietyRuleLength."@en ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:OrConstraintComponent ;
            sh:sourceShape [ a sh:NodeShape ;
                    sh:message "TRF-035 clause 4.1.1: a ship rule length shall be represented as a metre-valued QUDT QuantityValue. The supplied mappings leave unresolved whether the canonical representation uses ruleLength or classificationSocietyRuleLength."@en ;
                    sh:or ( [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ a sh:NodeShape ;
                                                sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:ruleLength ] ] [ sh:property [ sh:maxCount 1 ;
                                        sh:minCount 1 ;
                                        sh:node [ a sh:NodeShape ;
                                                sh:class qudt:QuantityValue ;
                                                sh:property [ ],
                                                    [ ] ] ;
                                        sh:path nltl:classificationSocietyRuleLength ] ] ) ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:message "TRF-035 clause 4.1.1: the ship's rule length is the rule length used by the classification society."@en ;
                            sh:minCount 1 ;
                            sh:path nltl:classificationSociety ] ;
                    sh:targetClass nltl:ship ] ;
            sh:value <https://w3id.org/nltl/benchmark/traficom-batch-d/TRF-035-P02/ship> ] .

